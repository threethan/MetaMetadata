e_name": "migrated_image.png", "id": "411744019692527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_289081701536992_3508510998296264704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZTbDL8KrS4Q7kNvwFWZR76&_nc_oc=Adqq1ldbnqjL-pMcBa0wUhwm_2wkdRT7NJHXUbFj6s7O66FtYw1RbvWDfXBCCGborI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXrluViETEnKvGcDcBdUBaVZhqya44pfbli3wKKR50RQ&oe=6B1037E3"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=081PBIMr-OwQ7kNvwHu_ZsG&_nc_oc=AdrZA0ejvidRdEzLWB8sy3G0Ncej9hAb0LQ6FYdKMPhnGgaXOoq3F3HRkJUqqMCPb-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_C14wWgwEk3JoqkWTy3Ko9NNaphAvbUDjbZlT-sAQhg&oe=6B106B46"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ay2LyJ-PM8Q7kNvwG_2PKs&_nc_oc=AdpNyMX1VEJXhov_I73sZkPblEXcVlccASS2r6B7m-MANHURmivGDjiicE6kvKWGWWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVt_fwfUX6zOUUppL3dS88im6lB7KKP4EdUbxytLRq_dg&oe=6B104C86"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vuDgmOBmCAQ7kNvwHIapns&_nc_oc=Ado3vzDsjiciOMxRDk7r6TUlOcB-n7Lssf6XqL-19zkGZbJHY9BqERQNjdiCBO-Y9rI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbjaQSVfkUcWlisDWsyRgUkkhBi1txK8tduB9KrIEmOg&oe=6B103480"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "suppor
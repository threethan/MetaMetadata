c=igwCvMcwA3AQ7kNvwFqCIk7&_nc_oc=AdqxFHh9Zu_bRNpo1IC-nAjyXh6A6mEcs0qvSpWnjL8VugvWTwGP7qkbACrvmA-_5us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjtZkycK0_l-ccr9lJNebneVITX6O81HcNoUoLoD6QJg&oe=6A7B3E63"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT4vAyZ3taYQ7kNvwE6iJrd&_nc_oc=AdoJ8x0F5jUqKF7d3wIZJmWMVTt3wCuTyEHx8qzLPzsPaChricbIMr4guqNcsnTGpcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiRcgNl79hvyK__bSpSMaWpS5u1lBPaCeNPVTmRwXx_Q&oe=6A7B3986"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2k7t9TtrJIQ7kNvwFsRZnC&_nc_oc=AdrjeklApY70pVWd2e4sOiV6Z4cdAb37yF86Xfy3hoGin5jk88UGPR6z0xUaGx2DHNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKnbYzq7oTUplGBjIPgMrRuXYmooa3mO2g5eabRU0GaA&oe=6A7B1AC6"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bE_bVfkx9QQ7kNvwF4F4X2&_nc_oc=AdobQzSa7PK8UDj0orZ1ZYo6bikLYFGd5-31EFoO-yB2euatXv7Y47fKsN_wprd3B48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN90HTgo2acQ-eozLFChcuNZz93g4FHIJ4PL-fQhG8FA&oe=6A7B3B00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_nc_cat
c_ohc=sKmzsmqDqe8Q7kNvwGyVtUy&_nc_oc=Adpww-tXxdtmxRbAcnR3sHikcVmBy2kbEXaPZ6SShK6Jmgr9gowDZajp3YE7ERG0SL8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrTpZRvjWzLTUE8JfjKJnPAzC-lNr1DXQdP88_0sk3sQ&oe=6AA41CE3"}, {"file_name": "migrated_image.png", "id": "2905155546227966", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162680_792407794257234_4366628464556507136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QpyF-Dc9DAQ7kNvwGlNrnE&_nc_oc=Adrytyim2akIHQJ39Zr8jp0QlaXGlj584eKJO2hh40pNDgK5iJ6MEZuAkJRQcwSS6eE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoi_tdvz0FVJfrukZb7Ulglco5QImQEOrTgSiDioIKrQ&oe=6AA41806"}, {"file_name": "migrated_image.png", "id": "642589573193888", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162810_1390764774311350_2285142954769121280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNZSg0721jIQ7kNvwELdVCt&_nc_oc=AdqJ3uwl7Sn99Ed5CB5dXdEoYSy5MfRcEm7E_Xa4Hs5kVRTM_rrNYiHoTlcYiovxGg0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbauSP2U3C-H9-iRrhE-gtzWZzWekwdY1ZxRfjBNs45g&oe=6AA3F946"}, {"file_name": "migrated_image.png", "id": "552565832036791", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162700_1864451723803223_9012485783956750336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBCIa-94z_sQ7kNvwHCZAXU&_nc_oc=Adp7UReSiCBssWUYnRGheD2qPtaJSLe8PV3BWKe8upLvAM4W95kEC6-Z2nihrtFoY80&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILsk6fPJAnQCBJbusCRSKcY5ufJn_ntck89jdk3McPCg&oe=6AA41980"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ace Academy: Black Flight", "keywords": ["war", "plane", "combat", "black", "flight"], "long_description": "Experience unmatched gameplay, graphics and narrative as you climb into the cockpit of the most aggressive WWI dogfighting game on mobile. You will fly with real squadrons, over actual historical locations, as you ascend the ranks to become a World War One Ace. You will fight for King and Country from the shores of England and Belgium to Flanders and the Western Front.\n\nUnlock, upgrade and customize the leading aircraft of WWI as you attack airships, rail lines, convoys, and enemy bombers. Test your abilities as you go head to head with top German Jastas in Fokker and Albatross fighters.\nExperience a rich historical narrative, based on accurate WWI people, locations and events. Discover the major battles and theatres that made WWI one of the most gruelling wars ever fought!", "short_description": "Ace Academy: Black Flight will pin you to your seat as you experience WWI dogfighting like never before.\n\nEpic aerial combat in stunning visual environments\n\nFully customizeable aircraft, including enhanced performance, weaponry and paint schemes\n\nNarrative-driven experience with accurate historical timelines and worlds to explore"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blackflightgame.com/privacy/", "developer_terms_of_service_url": "https://www.blackflightgame.com/tos/", "publisher_name": "Illumination Games", "support_website_url": null, "website_url": "https://www.blackflightgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "621173349108773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162693_100844157170301_8835602903105273856_n.png?stp=dst-png_s360x360&_
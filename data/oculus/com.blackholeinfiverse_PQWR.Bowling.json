2"}, {"file_name": "HighresScreenshot00005-2560x1440.png", "id": "1438295717174242", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824303_1438295720507575_8122123736362930056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9br6fMvn9IQ7kNvwFtOOC3&_nc_oc=AdlGmfFlUF9lSJLKIyLThnVJj_sd2oSIh1IzRd5mk_WK4r1UVCy-vA0kMGrmQW5Ybwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsSxRqbTu56jRjZqeQ6HcqE1mmCNscPzfmmq3MQGlvF5w&oe=699846C7"}, {"file_name": "HighresScreenshot00014-2560x1440.png", "id": "1613675732633966", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_1613675735967299_7156388022013950104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_dQumTZ248Q7kNvwHnzhOd&_nc_oc=AdnYD10LRoighR4OodGf7-fAqAULLEBd-tz0ULvZe9XmJbWfpiE1QjE4oVHirBm93s4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftn_6uQZI016pVz-3OEhTxTElvrDcuN6VOC-gOr9yLItQ&oe=69986A17"}, {"file_name": "HighresScreenshot00018-2560x1440.png", "id": "522344124296571", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_522344127629904_9036298876522017400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=om0dZSXt8OEQ7kNvwFW3Pp_&_nc_oc=AdkdhmvcqcumY3XmrxccI0P97vPd_DpWf9xyqefwYutRdrH4Oms_h-MNDDs1vNDiZ38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKY1h2nbH9n9rfi1HccPtVqNFNASqA7V-kYgJwbZ1Jkw&oe=69985013"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Star", "keywords": ["Bowling", "BowlingStar", "Sports"], "long_description": "Welcome to Bowling Star, a spine-chilling VR bowling game like no other. Immerse yourself in dark, haunting alleys where eerie whispers guide your throws and mysterious figures lurk beyond the pins.\n\nDesigned exclusively for virtual reality, Bowling Star combines realistic bowling physics with a thrilling horror atmosphere. Compete against AI or test your nerve in solo mode while navigating ghostly environments, flickering lights, and dynamic soundscapes.\n\n\ud83c\udfb3 Features:\n\nHyper-realistic bowling mechanics\n\nImmersive horror-themed environments\n\nMultiple eerie lanes and challenging levels\n\nDynamic lighting and spatial audio for full VR immersion\n\nDesigned for comfort and smooth locomotion\n\nCan you handle the tension of a perfect game when the shadows are watching? Grab your headset, take your stance, and become the next Bowling Star.", "short_description": "Step into the eerie lanes of Bowling Star, a horror-themed VR bowling experience where every strike echoes in the shadows. Precision meets paranormal!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/Bowling_star/blob/main/Bowling_star", "developer_terms_of_service_url": null, "publisher_name": "BlackHole Infiverse Studio", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31281921828057864"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_1245534240561457_7061772998681883031_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN6_sWs0uhEQ7kNvwFdIxHU&_nc_oc=Adl_WcnhVLmnUQtO5xteNHUVnjMJpi84wEKTQDGpqNe0XtVB0B2O-ljh2_3Ob1PAbUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvfYQwkYZ-p-RUcoMuYKK27Tev6x_PQ0WXIuqQ5oFWWlQ&oe=6998511D"
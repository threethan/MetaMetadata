nt-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_1843282679854060_2962256415709083124_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McNMyjnK0vsQ7kNvwHV2hd3&_nc_oc=Ado12E0HvlmW4wq4-3zXAWdCmsHdJKEcks8e5wNj4XRaWHKpkack2FEZ4ra9qDtnIRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiPCLDnKfiFVqDGGcqAKtBu7Rs7QuPEbRFv2bJX8Hetg&oe=6A69FC02"}, {"file_name": "HighresScreenshot00005-2560x1440.png", "id": "1438295717174242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824303_1438295720507575_8122123736362930056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOf3K6fD1d8Q7kNvwHM-GyA&_nc_oc=AdqeV-49vR-3VUjpfyn50QLc3vERucQXpl-IsEPjxWqUZ3N3tSyf0o1l6uOwe5JIvyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWIHUOh8Zg_AcMyXV_ZBxFHS-AUSKcEH2DSKYv6--i5Q&oe=6A69E547"}, {"file_name": "HighresScreenshot00014-2560x1440.png", "id": "1613675732633966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1613675735967299_7156388022013950104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB7C6H6iOxYQ7kNvwEVewjA&_nc_oc=AdpaWXMPzGhZtL3X3gTok8MNa_4F_1OY31D7P2pFhi_rgTgbiM24yZbRvJto6SorLDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaiRZVVsK6imOUDef5lWqjhCpUmShu7QJI_Dw1AVge0A&oe=6A6A0897"}, {"file_name": "HighresScreenshot00018-2560x1440.png", "id": "522344124296571", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_522344127629904_9036298876522017400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fcTx6DRW5MQ7kNvwGs8EA3&_nc_oc=AdrNkbs7hZLTV0gFjZYs2SUnNmEjilOsbgkbTw4o_PXLctY1bo2i_x7gBiRUiIIsFRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9HS91zUViCpSyhtxnAEqE-b3Wy8wG34Oo62ZISBhPZA&oe=6A69EE93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Star", "keywords": ["Bowling", "BowlingStar", "Sports"], "long_description": "Welcome to Bowling Star, a spine-chilling VR bowling game like no other. Immerse yourself in dark, haunting alleys where eerie whispers guide your throws and mysterious figures lurk beyond the pins.\n\nDesigned exclusively for virtual reality, Bowling Star combines realistic bowling physics with a thrilling horror atmosphere. Compete against AI or test your nerve in solo mode while navigating ghostly environments, flickering lights, and dynamic soundscapes.\n\n\ud83c\udfb3 Features:\n\nHyper-realistic bowling mechanics\n\nImmersive horror-themed environments\n\nMultiple eerie lanes and challenging levels\n\nDynamic lighting and spatial audio for full VR immersion\n\nDesigned for comfort and smooth locomotion\n\nCan you handle the tension of a perfect game when the shadows are watching? Grab your headset, take your stance, and become the next Bowling Star.", "short_description": "Step into the eerie lanes of Bowling Star, a horror-themed VR bowling experience where every strike echoes in the shadows. Precision meets paranormal!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/Bowling_star/blob/main/Bowling_star", "developer_terms_of_service_url": null, "publisher_name": "BlackHole Infiverse Studio", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31281921828057864"}, "review_messages": []}]}, "cover_square_im
nt-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_1843282679854060_2962256415709083124_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCEWCmaIjCUQ7kNvwE_U3mo&_nc_oc=AdoPYqpUekmK5OHL_YM32wUHbTk-GcmI2AESbYMq54P6BOwpFQSpcWaooDJXJtTA0qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81RrTG6jrMMNJd4ZG820kACiY15_YSwiD9xN95KJhBwA&oe=6A3BD782"}, {"file_name": "HighresScreenshot00005-2560x1440.png", "id": "1438295717174242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824303_1438295720507575_8122123736362930056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPwgv0iANfkQ7kNvwGG0fk6&_nc_oc=AdphMkrS5cAJjZZWxN9Kyt0No-XnriBDv8syoMdx-zmEBaxt8QOJlk1_a_eMqqyNXhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gKrzlCCed0oYdItbHVK4JfOdjQ6EFyjnCwzvDhK2ZBg&oe=6A3BF907"}, {"file_name": "HighresScreenshot00014-2560x1440.png", "id": "1613675732633966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1613675735967299_7156388022013950104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_YIxP_02D4Q7kNvwGik1v2&_nc_oc=AdrKqwygt-MvzflbdnydHN8iJ5PXnWjIZ8B1LkIbvDoR5zIAsJvjx8a2NZVudKjHvXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hYVQp74KHTcRiPtMpx5Sk0ch1CgCbJ8jFV4BV9QjOQw&oe=6A3BE417"}, {"file_name": "HighresScreenshot00018-2560x1440.png", "id": "522344124296571", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_522344127629904_9036298876522017400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCxwOUPM8VMQ7kNvwEgp_YO&_nc_oc=AdpOejUwFWtmQVJsHjW8A2uL9TYETnUSc7HCd2tF4MM4sOzKRmfQmovMhj8pdwLizuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u6AtZ3K1ZFllthV12En4Fco09Bhv1Q7Xe06pO8SLEyg&oe=6A3C0253"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Star", "keywords": ["Bowling", "BowlingStar", "Sports"], "long_description": "Welcome to Bowling Star, a spine-chilling VR bowling game like no other. Immerse yourself in dark, haunting alleys where eerie whispers guide your throws and mysterious figures lurk beyond the pins.\n\nDesigned exclusively for virtual reality, Bowling Star combines realistic bowling physics with a thrilling horror atmosphere. Compete against AI or test your nerve in solo mode while navigating ghostly environments, flickering lights, and dynamic soundscapes.\n\n\ud83c\udfb3 Features:\n\nHyper-realistic bowling mechanics\n\nImmersive horror-themed environments\n\nMultiple eerie lanes and challenging levels\n\nDynamic lighting and spatial audio for full VR immersion\n\nDesigned for comfort and smooth locomotion\n\nCan you handle the tension of a perfect game when the shadows are watching? Grab your headset, take your stance, and become the next Bowling Star.", "short_description": "Step into the eerie lanes of Bowling Star, a horror-themed VR bowling experience where every strike echoes in the shadows. Precision meets paranormal!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/Bowling_star/blob/main/Bowling_star", "developer_terms_of_service_url": null, "publisher_name": "BlackHole Infiverse Studio", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31281921828057864"}, "review_messages": []}]}, "cover_square_im
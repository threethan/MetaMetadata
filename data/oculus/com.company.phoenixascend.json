eMTAdwN8NUsw&oe=6ACA54AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAYX4brA4yIQ7kNvwEThiLg&_nc_oc=AdrhMf2xRR4GVtGVKcsnZnykTPV5-Vuq5qMpa2kRnaMiR4o4EGgfffIjY4HYFGfxoPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdMD5XlPQoDuAJjQmbnywr5usHgAMTtAZOD7tMWiB3aA&oe=6ACA5EE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXXC6ESr2vgQ7kNvwFBgXhR&_nc_oc=AdpWobXLfh-RaUgPHVofTv6K4F5o3bxBhSU2ySXw4MMsli74ID034r228WdegkiiMP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzjfKdIxsCnzH8flGzS5Mgsnf3GgUNhBzEr-An-l7eDw&oe=6ACA5D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2unw48yPlU4Q7kNvwEMe1nx&_nc_oc=AdqXx6m7yidl9Iy0_aOTBjcmtgvSeLLmzhtZZ-nMqqe30whbye713V4q6fr1TMRgD8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFWPhAGiXJYbkLHf_l4_7leuepJc0afrls2lEd65xIPQ&oe=6ACA7A58"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g-MoczPvqoQ7kNvwH7xGbw&_nc_oc=AdprAFJN4FrihH2VQVH3NBGEzBtTch3X1PlbhtipQTlX56gB5pZUPzQ05jI_BiP71Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcODDCw1b3fFW_kJEojgm9qaCKr_6BWTv0CeQZcu-XrA&oe=6ACA5EA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCBIIlLqXsYQ7kNvwEQNlA_&_nc_oc=AdoSuCFaqZXexqGBG0af2n1F6HEa2SC7LTFnC0ffSYGe8yNtiLWPGHfRTbeasT6X2eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5g1Wf4UZreklGYOnVRzsaEODgQeKRelueDe5XQncYAQ&oe=6ACA54D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfs2P4caJMMQ7kNvwEAkAT6&_nc_oc=AdrGj8twSOWNm7jUVA5eJ-RIdslG0lOd3BGWXPYz7n5C6ITy72xds12vwQyUqT2Fz9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHDW9Ohpyywnclz3BgRyZjhEqlUyp1q3-yZuM1pE5hZg&oe=6ACA60A6"}, {"file_name": "stair_generator_vr_25
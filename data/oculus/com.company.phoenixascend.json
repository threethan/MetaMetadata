fxUgsrenC_kg&oe=6AB3EB2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frwibVQo1nAQ7kNvwEeNMJE&_nc_oc=AdqqDYegQdEWNR7sViUAw9jGG6QZOAoCtMaRfi8j8ho_HgPcD73JjcafrwGV924vji8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK812uF2352UQgEzO5___Art4jl6im7yDasE6e3NMXAng&oe=6AB3F564"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNRQQlRK_WkQ7kNvwE0YqMQ&_nc_oc=AdpYyUyn1kPsPvIQYYqrhsGElSiOt9geSxsxk5NDSjTfi476fvjPbK7s67n_uLj74ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv-02d34I0Ua6Er1aOQ0WQjhCMb2UWzq3pGGSa0uuwnw&oe=6AB3F3E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njj8HATCKe8Q7kNvwGU6cEJ&_nc_oc=AdoKlvcLOvKflpfpbd2dtYCGpg6lJdHdB90aKIdf6avtI2DUvn6f3TQPDg1olq_qikE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOjhdS58jBjlRXqJme_b-JKGexKUoyynhwrs1lYQTuyg&oe=6AB3D898"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjLVYRPMzUsQ7kNvwFnj5lx&_nc_oc=AdqPm6EauEyNj_udqB9OdDI9NRraBXFfptuHrZ6UDMnzFRzAFvjp4Dy00JwXio0HYEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf6sczArpsdtxmBSZOGheQ71-JdhOu7Q9T87mrzgxRIQ&oe=6AB3F521"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1sZRz4eItMQ7kNvwFwV83z&_nc_oc=AdrFTZakazeDi7K6Wu6wlZ0ZFjOyjKex8lLX5US_msDG5ZO0BQzO0vCKAAI7Js4I22M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsGI1N3fCl19zQYc-jvy9FY4ufw5-sx_Kyqkk6PsfA5Q&oe=6AB3EB59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UAmU144jegQ7kNvwGFCPQH&_nc_oc=Adrkxh4cADthKaAA4Qlex7_lb-9QEZ179hTMUy0X1gdhiZ8VPgXkRQxECbt1TB1pIQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkbWK_Tvkzn7d_jC5AUTh2fi3VS4F0Lz571zTa4I1b9w&oe=6AB3F726"}, {"file_name": "stair_generator_vr_25
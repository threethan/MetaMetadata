less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7I5L8NkzX8Q7kNvwFc5jNU&_nc_oc=Adp1A1F9gwhxcIPBsTLY478GDc8iFM3Oyd5PHnUwbFLTy_zswMHgj_dWK-nyc1Big-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvv7ESSNt9rgnfujWh23buZXmNaJUd_TXBic4Xc7facg&oe=6B0DC96E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZJV_ztcMaQQ7kNvwEJjeJP&_nc_oc=AdovxC1HwYro9sDIlUeNQQJrwCspUhbvuhoQQMkH9gr9-HLmFkcAvsgSVMI1jon4tG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZRdGysK63js3uT1tdZLl7bflLbbkIKBVhi2z3QWMnmQ&oe=6B0D9B64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1VaH8ZaLVQQ7kNvwGZMnKA&_nc_oc=AdplbQh0M5GxBwT8flK4RYXy01WpUzxUAQkHS7omENVb1L49WDUKd_8MMGcmksZPYpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7jDpH1cCVpfp2hde51riej7u3uhDJVNJ3GBpQpFa1Mg&oe=6B0D99E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzkAOdTSzTkQ7kNvwFsWB6l&_nc_oc=Adq-kydRTEJ5Yaz7Rtj8SE3KHvJm5QJCdL_KU6EuWMHXAvH1Ko0jJmQWYUp2kQihdP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBbuttFpKMjNydVsiMk09XOA6IgCrkCZtboZW--NmoOA&oe=6B0DB6D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXXXMyQJTMQQ7kNvwHRXuiF&_nc_oc=AdqFQMPjabeiejTOVXz1p1EAs4QHrUMqIjeYyGU8Q9hBKJJ2vzHIXV1ZcFjtHDD_5XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWF7Qlg6g15dziqW9DGEZUBV19ZOu1uMurwVtzheh1ow&oe=6B0D9B21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iPUczciRbgQ7kNvwEckPZa&_nc_oc=Adpm5H3JtzuSBVgTCIoNJBmmd7jnEpE8zx6EEQ8inv1fWkzO6nMm4uX0fR-bXDWTWtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFRVk69s2ASGWdQZtzOkuoS3W_Nfode6JSDMsmqoDLYQ&oe=6B0DC999"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.57
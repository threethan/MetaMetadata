less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZbKXGuUx9QQ7kNvwENvTCx&_nc_oc=AdrS54FLtK8aQ95ByiIzntZ8rIVbLhG5h9MQ6OR_8YLZ_7CeeF2puYTy_8EHfYMxaTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUg7mIf47cwdvZ_cIzRopckpsExwHVnDMOqjObHBocOw&oe=6B05A82E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gojMM40pupcQ7kNvwHobN1L&_nc_oc=Adpnxu0SPFmtVc_O1jaz_YtMBXKqenY71j12AdMHdoVEJnJfxGRixbhcyViUbnXagu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMe9fGXQLxSQJ6gTcStzPa87BdnA5Fe1nX4vvMEFGdoA&oe=6B05B264"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WIlRD5GfkIQ7kNvwHiGjQ2&_nc_oc=Ado7avfOXCoRBMoS-GieI2Bhl_EvS1wgFObSlts8972-0b9Ayb9ponGhkSdAUP0sMVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvaQCG_BGrcmUSyYuJDY5Hn8QdGjkIWOTUKQgzwpFCTA&oe=6B05B0E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKzzf_oi0YQ7kNvwEhf3Hi&_nc_oc=AdraBApXEYCpMbBPti8CXT1lAqmNKcz1L7XywxSqWPfEOlK87p0IFosnZJtAjnHGMpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe8I3wnM0UDHnb5VSr1WVydWjjHl2hOlkjR8Pfp5Lueg&oe=6B05CDD8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfAXXTTTA-MQ7kNvwFZIsGC&_nc_oc=AdrldHSpRtJrlW40HbQ3t5Ibll3QuxPd4iQ3R-93OaKHnYUmRZ-JXIWCUc7vPwWGAQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6smtwkE8cXJ9jR9c43rpopL3-l9EhpalZNUcxMC24jQ&oe=6B05B221"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfKHwXSe0M0Q7kNvwEnrAMQ&_nc_oc=AdrpwftACZn9kfE6xDN1ALe9Jc1jXj8fwdWGsuLmw0cRtnKcniW-kAfT04f4DWMRZks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp4efCMmXUkwKhzYnq-_ApYO_D5rYkMAIBjUz8wZDB7A&oe=6B05A859"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
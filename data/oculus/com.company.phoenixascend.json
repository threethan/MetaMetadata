8s1-PrEvOBhQ&oe=6AEC9BAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1XCTt9k_2cQ7kNvwGF8QPk&_nc_oc=AdpG9-QAxSFLCz86JcFd9bAaEi7aHcWnMaTJbVRVvDtqUxPycqCvHzei0pZ-Fswadzc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHlrsbx-56MMCZjrWGsNTWOydG64rKEOJ3wJfjLClAZg&oe=6AECA5E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3BAIuxICG0Q7kNvwFx2Kle&_nc_oc=AdomyczZFYASQJqvw57KZ6lv2n4OlZsGw8T6vuOO6YrSh2Dv3tQoqXWgRsLAjP1IIK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU7t4x2oAtdd8HINukQmcS57OIEe7qejmkd83DDo3ngg&oe=6AECA467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J1aFq5g01IQ7kNvwEp0F0w&_nc_oc=AdqHPG2AnDkg4EvRZUCbLWUsHzgKvwEJAA7LtIzXlcmyIGGC3YnsOH3NUVx4vbeKGVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMGrB-apkmbYoeVV5nV3owCbAvX4GHKbC69ECA42LHeQ&oe=6AEC8918"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP8VC6Z9aRAQ7kNvwEppnTm&_nc_oc=AdrU-6LmOh9i6HxGOWKpXOJ_sWIZguEn0MeiZ8lWh26hHU7U1K0-6UrrJ7O3rhadPxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREgqsT9PlStwtiq-ws0RXi-spSN696P90XPAg4oXbpIg&oe=6AECA5A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfDGMAj_A8sQ7kNvwEnIZM4&_nc_oc=Adr3OY7UpJ6UIR0padR8PE8d7lmQpEWM_2fOn6621Jk73fuDi7vRVgWyp9YLTFUUNvk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu3tJzcuQ68e0cSF9rrbnBQRXFA8lNWrgYjK_aC7Cayw&oe=6AEC9BD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYQr9-xHriQQ7kNvwF-mLVp&_nc_oc=AdrnnCD4KRq269iiwRn7KOcjRC6zVCAOW_TDR5xGAd59wBCGp7tLhamJ-NaED0a2QOw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaIweDo-QMM_eAhWuNL-DNUTNPnUR2znzA0EYbjAJWpw&oe=6AECA7A6"}, {"file_name": "stair_generator_vr_25
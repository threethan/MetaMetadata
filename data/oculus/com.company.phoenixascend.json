NhKv8VrHRxvw&oe=6A6CBA2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJVfUltksbsQ7kNvwF5qJeV&_nc_oc=Adpt_ZQaGWqntkMNA2ZkQMBJxnE0VH536bMb2h6hp5apedMBA3KJJCQMlr2JMH2Wwfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD15nUsj4P7wgoh3OUagaoUgNf8WlObe4M0kmbTd1oxLg&oe=6A6C8C24"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inzDOrBV-xEQ7kNvwH9jBfF&_nc_oc=Adr6QeYLbNTbkscQyDb4gucOUnkI8sogqCYqN_VxDpzHC1eYD1LpeXYzdHwWSpHcGME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtftJEYhWH91zDqRD3Fo1aBstShBhT_xE00ypEMhcMHQ&oe=6A6C8AA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ32Xr9mk-gQ7kNvwGTZAmB&_nc_oc=Adr97sE1-W9wiz-oNePZeP1tLEJW8J12fKHX-b3dxezNllfEFCTcGcj266fmtPeP3oE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA28pvqBFSgHBYJygNyXOIZe0IHM8XLaTI_8BC6z9O1BQ&oe=6A6CA798"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVnHzctACrUQ7kNvwHUHlYN&_nc_oc=AdpNOjyU32BiGH29FJoYfVNadHr1pGNlWduw4pvsO3PqV3IN6dreRV4j7KH7eeR9MLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjxn6ArkYAHE2Xkzcwj0wd0lpgwuObkI-2zNksJiUprA&oe=6A6C8BE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtNjHM3vMIQ7kNvwE9nUoS&_nc_oc=AdoNN_WuTd85h8pUBag2AAMatWqx5__7h7FmZ-8rujSG-bR9FUf0DdrR37DUTdjvt7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkiYngRhZGnDHxlcLngsyO4KUQWYkkWTokX0xUjRkcgg&oe=6A6CBA59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKMzPHDHjQUQ7kNvwGLEb-D&_nc_oc=Adr4BiXT5v6ToMgi3kFK3FDV0hMAsCyHP81oVqrt1x4g3DvBhjJ6r6BO3bdEnLM2lQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9vNK3FSiUjsjejGldqLvXUolnHI38G9DFKPqfKDgk7A&oe=6A6C8DE6"}, {"file_name": "stair_generator_vr_25
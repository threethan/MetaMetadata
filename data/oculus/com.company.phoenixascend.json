vw4xsi5rhS6A&oe=6AD38F2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TaSCdFBBdsQ7kNvwGqlc2D&_nc_oc=AdqQe3kliMytUQT8ezJYxZmiNXcJe5iMcKpjzZ_uPGstbj96tohB5BTpgdOb0pRd42I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0JL6MO2QV7YiJieIXy-e6M76-cKIjMsmJCmSmsd_AjA&oe=6AD39964"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37Jq1H_2gZIQ7kNvwGHuo0m&_nc_oc=AdrOP8KgNIG0_EFr_yfen_cmmKRtjRze7w85AdU9TeGUAPgT7UtJToDhMfz7AGrQ8sE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOACdtgtFfzl_MaW9-NZgk-D8DsG_BviCwehm-DUZF56Q&oe=6AD397E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CNfr03JCDkQ7kNvwGHI1SR&_nc_oc=AdpwOcgBP1RfY7mgSSH-oZzb1g2fVlHkUd53xjfmJIwD9EqU022zpXkcjI9d2F0XDnQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH31GqUzqg6vQTZ_tlgrZeO23xOwMzFw8NaV17Qr6CsA&oe=6AD3B4D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oze1_v_Z-M8Q7kNvwFaLkVw&_nc_oc=AdrjFhLbkWIVy95AEmhDPSLeYncH-XdtzeCfSb1BOBdM-ctVIrpCZFoyKvDkQ2f5o3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGUFZyIGtiRBb3Y0Mw63pPk0W-8HE1J4DEosnl-ga1zQ&oe=6AD39921"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKlZVUsDqL4Q7kNvwGFrXls&_nc_oc=AdpveX4BOnG0mk0JMwzaTVfhZAvIS3s8Bw5dxa-WSHgPWrGY2nKsm0Bql3YpIIQXjgk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNue2gQHypGaow8Bw8zwkJa6RiStPJEOEe-74Nk5mBNjw&oe=6AD38F59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-fxQRcOUeAQ7kNvwE61zV-&_nc_oc=Adr5HcLEZ7ScEgN07hZllBLPjRI20Om9ROUwm54wwSoxUlVpdh0pbc6bIHhZBs4H4oY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONMDJpHWMjFGUabE3xmDCusLxK_KKlx7fVYWsLq64-JA&oe=6AD39B26"}, {"file_name": "stair_generator_vr_25
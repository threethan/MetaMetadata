less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Zf5mgup8MQ7kNvwHFpsi2&_nc_oc=AdqYY25WZBe8Hz5xEJjEvVWoPvnyh_qWfkyUsm26ubX5kLMbhnqy8rABwSD2JnS1lSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCAzi76U32ulI1EQnmJY9dlgteQAbk3gjrErwYKpaG_w&oe=6B106C6E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZJV_ztcMaQQ7kNvwGBsZk4&_nc_oc=Adq7Yo8PT9M6WldWu066LKmQpdYhE0nbj7On5GFVS3iymg0PcwSZbwjCZGmz4rnna2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTmB9AaigR29GR6PgIJ4pTVdQb8BGsOKhvdeX7asXLQA&oe=6B103E64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1VaH8ZaLVQQ7kNvwECBFuC&_nc_oc=Adqus7Ty_l4mMUkQp2vII2qt-6SBxepsHJjhMrlLOB5atMqH9fFGvVMD6C2kCLtnfUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVq1GL3lfMqCyWyRkhyAurH76bzAH6HmoHOmCc4ETtFhQ&oe=6B103CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKsT55tzSQMQ7kNvwHocb_F&_nc_oc=AdpH9z1Sq8LlWQ5LkHYBmNId33LSJa5s80jgZq2CJMT_06VZS4MoHrpOcwMam7v05vg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBPL2stlpicDPDZkkAu-TUMwiuwqal8YwloCXWiJ66Rg&oe=6B1059D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNoLfEQ_on8Q7kNvwF8rhon&_nc_oc=AdrrN1LzwPY-f0ravVvhYxy7CDs_fxOYaGy64TOQ3sAabKPbDEGOPpVdKb0M0PdR-iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWycNAIWLrCdhkhXY2BPmqGP5BqZ5X68dJoR0AN3x3Dvw&oe=6B103E21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtsMbS-SfQQ7kNvwEEtRuR&_nc_oc=Adr8YmfaXQhjZ9pTNbWPcpCM7TTHYGLOyrVlLhGh5zzxa_9i-jXosQyYP895ZEQIQPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_WnpboMc2GZnBDJMs-WxaMYwepqmtVSUGVTf887Mcdw&oe=6B106C99"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
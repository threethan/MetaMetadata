p2llglvaQvWQ&oe=6A97226E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ABpelK0qZwQ7kNvwGXOgw4&_nc_oc=AdryIBQWiNpnpWjOpn67KnHpPCJweKj200wHU9RB71RL6P1Rzh8iwd0-KwwfkxsGNGg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEz50rJrUVImH_zmMTYWhyG1E_mTd0Az3151OV_Bqe8A&oe=6A972CA4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxwK07dIfoQQ7kNvwEw4ZG3&_nc_oc=AdpT1LpQCsTY0b4QAF-sSf-Jul_zrLUiDjNZbIEiB-KFBDuEFrUZzrdgNkj4MjS8FyA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjVLLh6gOvPCpIPR5R9m3f3rWfdYqk9fBF2La9pneEMw&oe=6A972B27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0t6K0xXlmwQ7kNvwGvKlz5&_nc_oc=Adqat4wqSQ4vS6QTQ4TFX0yw9Q1-bjyPeLIXRLum60ZTE7nnF_8TVajJWVFAWsT3iiM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF45w2JR4WQfLIfiQid8E6vvP7NhgiaWUNT0ilBmSaTEw&oe=6A974818"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePkryO73NlEQ7kNvwElbUZf&_nc_oc=AdpUH5NA55kncDVsLHjmqv8jjgkvljTXOFxa1p6cgJK7TMbw4V13ndoxlrYNg-hSHp8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR4DOVaOf2ULw0oxzUg6XheUOhIEed7lc-BXMfF2rH2A&oe=6A972C61"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBiPP7O48zcQ7kNvwFPt1XS&_nc_oc=AdpfR5Fqe_pmACp3wRga6sQG3RBbATRSzFq7f1MaP2X0SKTlKIIYbZ6VHUbhyCVpP9A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoYrs2gakZa8RLT1EBRljf5ZLY9o8agE11Ucox0M2PJQ&oe=6A972299"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1DPIMrdjoQ7kNvwEXeeN7&_nc_oc=Adq0ia5Dg5IF7bycM4tB1AFK2ALB4Js6ZDBv-nnhOyEVz5rVTDtAQUGZFEr9pyjMahE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmi46y_4cXEtC4HqK8W-9wQch6J__38Vlyy5zzWxxT_g&oe=6A972E66"}, {"file_name": "stair_generator_vr_25
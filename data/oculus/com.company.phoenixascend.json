R2lwvDXiTSZw&oe=6AC6602E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYTcwA3fSdcQ7kNvwF9ol4e&_nc_oc=AdrQ2CF-9yksONY6OuEknJupc-8-vtRJHFWHBgbIA9Wgx9oISaAt4Jw4BUshwbBYPwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNypbcL8vdExNnpRPMjsdshtD9t51_CeEwjaTPXMfkXQQ&oe=6AC66A64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TobhMIkDEiYQ7kNvwGuy6HR&_nc_oc=Adow6FJ7BskzRIg6EQju2YeVtw6JB919AVtk-A4Mz855C57kd4J3v9Zj0vHVfLQYHq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcRYjIdRQ14XGeqaLBOc6eEAgVDLVNsAxcQRAgpZsQ_A&oe=6AC668E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSmmZkMED64Q7kNvwFiiXzs&_nc_oc=AdqM4_jyf6fEeXJXupN6vn4sKcAsWbeXQ7zni_Rn061xBw6x2hBSMkDZ6ThO_y8zHR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGXLX4bsKhfjvyVI-GvDYQrpL8niuVzO_jAUsfW3nO1A&oe=6AC64D98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6XOy3kcJ-wQ7kNvwFHSmBg&_nc_oc=Adpzk3AwH8ri7U0EAWM452W1MyhuCwq6ctoiZfGG3YRUaPR5I5gYAcrIK1HCHd6dRLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKCHZav_KBsWk7CRpsK66raGgrKQj9TsreaViTpVDseg&oe=6AC66A21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H9Ot7Ip0pQQ7kNvwG8bZHL&_nc_oc=AdqW2bO3VhlZUjYK2k1CYKsc5y9S4DrfFjMk_U26Xmq_3IrDTAp3tc5ordmRCtsFiEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgEoA_N1lpvKkclXzTGQsoa85d0ya5KTnzreIAwW8faA&oe=6AC66059"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iGnMoLJu7gQ7kNvwFSwEdT&_nc_oc=Adpcs4zZr-mj45c0bOCWYpctTZpiPu7Q0jJyfZRo9hA7WMnSdOww5h7Kq3fYG6jP7l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1qs-Qnfb5RTYeuNFgJKklp67uTHzDk-ljHLQQcX8m7w&oe=6AC66C26"}, {"file_name": "stair_generator_vr_25
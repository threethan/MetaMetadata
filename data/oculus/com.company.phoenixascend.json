_SvktJPFdqhg&oe=6ADCC9AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpCGPqmJWuYQ7kNvwH9fUlo&_nc_oc=AdqFAZkQivVkIZF3TjzTVpi77bQGydtmJzep3BavAlWz7pq82CoslQwyy-gv43bMesc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFhmNU9t5Mp6cqP1rKZGTwwr4TmFAgk3fZGsyjZdQpKA&oe=6ADCD3E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cCUevXfuvAQ7kNvwGC91Kv&_nc_oc=AdoskkeFSy2rIL9oe-qfhgonctZfOEEIgxDVd53c362j34aq8Dq-21K-5t9od5eBp2o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9BI72yrMM4MDB7UWYzkwXh_-d8qP9kmxQPaH3BhlEKw&oe=6ADCD267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5bycu3VV4kQ7kNvwG_holj&_nc_oc=AdqyCfiy9a28odC-OlNT9tYS0nzqC6BHHdM77ImYGNomF3uszXmoDQTNm3xvDOaGdqI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVSkdMf1Xizsd42RD-yTtl4sjfzEZekCEUo4gTYotGHQ&oe=6ADCB718"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLC5UdMaSPIQ7kNvwHFH575&_nc_oc=AdrPW1T2R9sW0cqNBc_I97Qaslp4SQFPklpYwIzCAOJ0jreQABfC3QnmqXcovaiFG7Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGxyKYPIzGg94z4EZzn1Z6oYo11KZX8TcbUQ7zFHPfvw&oe=6ADCD3A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hnDZH74o0wQ7kNvwFNTv8b&_nc_oc=AdrLGh-Ms4quX4GxGyC0yOs_NfQ3WvfoHG5JlW2O5YIWFHHWS1elzxcpGj4zJVQhsB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS7oyfoFhkVPXizagzqAoIFlfqEqhg5EInsYt-635IcA&oe=6ADCC9D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-9daS1hM_sQ7kNvwEr4w6U&_nc_oc=AdqkodnR5PPBbKJYQeWP6n13LRvXJ0DZMYMG9_Rpyf0vFOMdOhcRM9t9P2YE8VMkcGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaNv0vcQIQd4--pJTFCu5Ywp1ecvCSv9Mvd13ZQlbt6Q&oe=6ADCD5A6"}, {"file_name": "stair_generator_vr_25
IPjZVian8_Zw&oe=6AAC022E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q6z9hsdYn4Q7kNvwF6u6O2&_nc_oc=Adow87NRLp3iFK2c4CI4ROI_WgK7MAf6MB-j2WQMm9e9TFxwNwER-ht3phx2utL5iFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8Rf3ryWFEya99_GjJJqkkZcQ3NirqtNKiq9WFk2nYhw&oe=6AAC0C64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEBIR2i-E-wQ7kNvwFnAYyy&_nc_oc=Adp_HsuGKTLBZmlMdpsSjC-6gssjCD0wfD8CFvz8KrtmlUSzu66yuvfpXaIfDA_DSDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnszApIJYsPbMlsNnYbUdr3PoGj3Ff2xMCLKgKo2voyw&oe=6AAC0AE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyaU5wjr5tEQ7kNvwELDEFr&_nc_oc=Adpf5mPf_ZjG1As3rb3Ugj7iPzoGe-D1RIAwOz0Fo_Oba-8hVTCOIq-BizcE4AecxGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr_4zFmx7qyjijEGZx3Ufe12PvbXqRwrE3fI6OJT1SNQ&oe=6AABEF98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBuR9YoLhqEQ7kNvwHgsvXX&_nc_oc=AdoqXWtONOiY3vmWOA6xvnnC8XO7K6bs5QZ0t_eNs4UI_dd1fgFuzbm0HpIZkqI-M_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfU-gAKwNnXfaefBhcwwZ9JBdqQvvi4ZfFKoWbcGsUjw&oe=6AAC0C21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVb92pXktSAQ7kNvwGFS8PM&_nc_oc=AdqdD8vnqRi39LjWHI-D551E5jUAekQAZc4w_ujpmZM6DVMQiKsn5xZSsZ3yyno27eM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdv2sytxOOj47vEYJox8qi2G7chdUrjnX7R_hfW38YpQ&oe=6AAC0259"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mT6OeB36xEQ7kNvwFQGTZX&_nc_oc=Adqxw238BxqTKjM-9DPvZIqpCRcOdd-5LlyVI7c3tXcltZ_IEinKHxSNrGzjEGp7YNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiK26ctonMcWPAWo3a9jgHhIEcJWI1IpnD1hwabcNi8w&oe=6AAC0E26"}, {"file_name": "stair_generator_vr_25
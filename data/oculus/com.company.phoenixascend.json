_nc_ohc=J6hTgEX2aPYQ7kNvwEbSUr5&_nc_oc=AdqtnzAKt7nqhgy_tAvwAU4lTXdELZaJkQxYfZ_0MEMqv68RNTRobHzPA3r_B5AMDiM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmNOYqoCTqfkelJghBV3ShPlaNtoV6Z0CzN9NUJf86kQ&oe=6A97225C"}, {"file_name": "photo_5091760635552402523_y_2560x1440.png", "id": "1752636759241679", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499311582_1752636762575012_9039755887472421870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y81QswHACZ0Q7kNvwHn6IGN&_nc_oc=Adotzm8HO3RZXFULxKeTh7fnOu-Oq1YzLC3uaZHdz9Qpfg0fxlzkYiIxOc3RmEwAIZ4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn8gCUlm5AyXgojzs3nQVR1MydNTozr8aiLhqye_vbOg&oe=6A9749D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "1361493259258597", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623295_1361493262591930_175340482431356220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZmmx1Zcp04Q7kNvwHE9kou&_nc_oc=AdrJlG4aAXbLDzs0ZVwwB8OlNEc2NpZ4dGyHMw5bWuoZ2_sDiX1qcztrHMAQfn4Bi_4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOovHSX7dFHkCv2_uippsxrdQvDgDfCG9uMz8znlaCeg&oe=6A97306F"}, "display_name": "\u0413\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u043b\u0435\u0441\u0442\u043d\u0438\u0446 VR", "keywords": ["\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440", "\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0430", "\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e"], "long_description": "\u0427\u0442\u043e\u0431\u044b \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c \u0448\u0438\u0440\u0438\u043d\u0443 \u0438 \u0432\u044b\u0441\u043e\u0442\u0443 \u043f\u0440\u043e\u0451\u043c\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0443. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u044d\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0432 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c \u0443\u043a\u0430\u0436\u0438\u0442\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b: \u0448\u0438\u0440\u0438\u043d\u0443 \u0438 \u0433\u043b\u0443\u0431\u0438\u043d\u0443 \u0441\u0442\u0443\u043f\u0435\u043d\u0435\u0439, \u0442\u0438\u043f \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u044b (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f \u043f\u0440\u044f\u043c\u0430\u044f \u043f\u043e\u0434 \u0443\u0433\u043b\u043e\u043c, \u043d\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0435\u0449\u0451 \u0434\u0432\u0430 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430) \u0438 \u043f\u0440\u043e\u0447\u0438\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u043e\u043a\u043d\u0435. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u2014 \u0438 \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0434 \u0432\u0430\u043c\u0438 \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0412\u043e\u0437\u044c\u043c\u0438\u0442\u0435 \u0435\u0451 \u0438 \u00ab\u043f\u0440\u0438\u043c\u0435\u0440\u044c\u0442\u0435\u00bb \u043a \u0441\u0442\u0435\u043d\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u0446\u0435\u043d\u0438\u0442\u044c, \u043a\u0430\u043a \u043e\u043d\u0430 \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0441\u044f \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435. \u0415\u0441\u043b\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u0430\u0441 \u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442, \u0432\u044b \u0432 \u043b\u044e\u0431\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0438 \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442.", "short_description": "\u042d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u043b\u0435\u0441\u0442\u043d\u0438\u0446 \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043c\u043e\u0447\u044c \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043e\u043c\u0430 \u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "1969133970438577", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620860_1969133973771910_3163990891936266629_n.png?_nc_cat=111&c
AX7kDPbadKUg&oe=6ABA82AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3TeC_hyfwAQ7kNvwEPnu2g&_nc_oc=AdqTlBghcg5r_bM1hqoX4lOeoFIBsfL1WXFyn47r7gA3o4AZhGGnbiPtMuQUZxvC8lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfhTu3Az27mY1h8XTCuHXEJj5mbZfM9JN93kp2n77gFA&oe=6ABA8CE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1PKO9oNl6gQ7kNvwFZt4vu&_nc_oc=AdpTeKgT5h7jEf3ER8H99EvU073WIgJaku4QRrS6_aoFskaA3Y_9g_Ug5N7o7yOvxyE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7y7rbnmE2MS2qxsXaF-My2DG5KuqDTzEntQSlfiQDUQ&oe=6ABA8B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxTfivgS_SkQ7kNvwHse8kN&_nc_oc=Adq6gJYdFLNGc3ThSb8OgxWbqx-2Uy26L-iiZArzIuFKXN5dUqoWwaZgTs5HZS12ucA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8uGCueQtESVolsH8Q7a7EMpKjFdHFANL2fRt30F3mhQ&oe=6ABA7018"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1apaZq7wYQ7kNvwGwM0-M&_nc_oc=AdqblemLPne0a7P4ru_cWRnMzAC7hXhh-9tcyIbSrj6ajFfI4ipDhAim5ael0JutHrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyCllsA4NX1oSZ00oMemVHj6cfiPknrcC8D5JIcxk5Jw&oe=6ABA8CA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uhaD0ax91QQ7kNvwEAyzdy&_nc_oc=Ado1y3h2m6F-KqqhHyyK13MCWJBpO0iJe-owt7EVrsE3cmpM9WjFeNVH9wLC0mwriQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpPu8OKaHioVx-7rnu6Dtv-jRaYLBGPBYe196aFA0aMQ&oe=6ABA82D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It8sB15m2yUQ7kNvwG1ZO1f&_nc_oc=Adp9SXBQAT5qPKkZMd1J9CbQUXtnjIKmujhBTIF3L1YoGWLoWMMoEydB6adX__YtJSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz9wFh6HKTxG4O6nRUqwyCdSkJ54z_BtH2kyrWtnB_IQ&oe=6ABA8EA6"}, {"file_name": "stair_generator_vr_25
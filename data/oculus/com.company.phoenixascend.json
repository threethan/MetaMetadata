KP7iL-5OIc6Q&oe=6AD23DAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TaSCdFBBdsQ7kNvwH3yhEj&_nc_oc=AdoT2vjEY1Pjg8ZPQfmPSAK8cxbz6SwI_Cwv60zqeAeJEK2X1CU7UZgp9_vUbDqnJGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJzCzJH32I78MWmiZi5X5FogJuRbYb1gUK7-3P2yyhIQ&oe=6AD247E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37Jq1H_2gZIQ7kNvwHWW6k2&_nc_oc=AdqNObz_NSAdPz6z_bA_SJAi2wehXZNVGTXcE8yKUq8kzdLBsg5MSUYa3f4h15BPgOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLjI3DXHMLTja20RJGwWnK6ChljvGXcLuJVc_pEMTJzg&oe=6AD24667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oC_obqoltcQ7kNvwEZJ9a0&_nc_oc=AdpdXEBjLgY8UXyMcYj5XH9T-WKIbZv1EeKysr8ldDpd1WWFdizmfmTJAEk0jUsL-oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMENIPpIARr8_zUupIWmB0K79IdGbNWaz9oIfZ-rn-GqQ&oe=6AD22B18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oze1_v_Z-M8Q7kNvwFycxNF&_nc_oc=AdoRwnXtG9FQ3BvgHn4eLv2i79l3MBWz90_zyUwMFkk0cU769gWvpORaJ9f5w-0629Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU6vToCi60zJuwwq9kOFISjZ_R-yLbQD8WiIArUvCuhA&oe=6AD247A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPEOGA1uSaMQ7kNvwHPCR-J&_nc_oc=AdqTD4-U6yM2W5rkZd3t0JvtBM2yYIkyoOCrSWasCvXOmNDpRJ70KYTeM1MmSchiuvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN721BLa-bgkUb0D81w2zgkxYHsQ9Cf6o_99TRKhD-fgg&oe=6AD23DD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-fxQRcOUeAQ7kNvwFpThbA&_nc_oc=Adovr70QlwaFFuMM9rEFRyq09JJXD5tSgGcRkYX32uO6swI3kOnNWQaqBNTS0VlDXco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjLNpqEVbwEd30IelOPvqF8OypzhD9Y1bh7SKtyRk-zA&oe=6AD249A6"}, {"file_name": "stair_generator_vr_25
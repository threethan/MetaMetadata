l7847obgCT_Q&oe=6A68C5AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C5_vhniPQ4Q7kNvwEo815c&_nc_oc=AdoCDTadgL-j0akUQo2w_iN-jCkM0sfgnB-9CywF1WVbfRSbvkGwC7m843Gaf8S8YgI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAECLqToQck1BY9uQ7q-0MPHvBT3345UB7wzLfKZeQzNQ&oe=6A6897A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72Jw3gDZhDMQ7kNvwE8S3F3&_nc_oc=Adp0jRgNWHZbzFkCarBSMxiYlK9rhZ7GuFa5f9UZvpKqDFDpDD25x8QNugJgSrmTAhY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyBpHw09gz0zZ1HNo9hZtfKsUwzF18nVZWKgPT6IGq9g&oe=6A689627"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwKXr3S3dfEQ7kNvwHyHNyP&_nc_oc=AdqH_UPVKMcNTmzpwQtb7PSf_WQIVucgaAs7ia-qEqo8kO_0p-dGDb_kOTl-hhp_7AQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1v9bZFKOv-tj99_wAZsHpA6WGXRJwZ5N23-3AbfOSDQ&oe=6A68B318"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF_g6sPNQo4Q7kNvwF6Lu62&_nc_oc=Adoa6ounVuY4o6lITi5sFkCoMrYdGOSPz7tZJX7I_FbEuEtOrvMPqnVyP2CfSNg_N_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwO4tqXaq1QYOw0MyX962iZjru8822pcY_qVjBe98SMg&oe=6A689761"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no9_UkDQDPwQ7kNvwFY_vkz&_nc_oc=AdruGr_bGdf2616IDcsl-zSdBo-Kx1gb5otrvxGc6z6QrM6bwEWLPNlMooc5AU6ih-4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVMOl5SDr0ZOXRqIKWqBG58j7WJQCkj_OBwr1coTL0xQ&oe=6A68C5D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYlj8QFTjW0Q7kNvwEVC0p0&_nc_oc=AdrygGFEcD1wmZdJ61ik7qZ482cXS2rCl3BeXHFvGMWiBXr2bPhCj8tvZ-PcvI-IUN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY42EEGPXgM6AUQ1FrR-pOTBmUMTPa0GV_LSw6aUxkZQ&oe=6A689966"}, {"file_name": "stair_generator_vr_25
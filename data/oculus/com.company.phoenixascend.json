less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drI7Tz5lfLAQ7kNvwGgxMIe&_nc_oc=AdoiyWEokC_g17N_PYt8BulqkUyABACNPkX9iIHppeRqOcuviGI_fenJ85ETmxCMASw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzfxquALHifQO5gXJiNlMdztEwHW5UtMWBFmRbngbu0Q&oe=6B00622E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxq045T7f8Q7kNvwFybgqM&_nc_oc=AdoDQ8fNdfN8JzIrBog-PDpQ7aosJIjDhs2IQ8dVatAPiLhTDXsTT5FihzLGlVVLZ0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo7bVcwSjKgAdR8AWx6_VfM7Ml3b4dK2ONwx9nWNdydA&oe=6B006C64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOXxDJhB7CoQ7kNvwGmW3lE&_nc_oc=AdotE4LvpBfQDC6OWc38fP3shNVNPglCFvf4SJjejtLUyOg1JW4aki7SHcE4TEuphxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2oMl9scBZyw7K72XzFSbo508-9NWCHhQO8ekwmb_JaA&oe=6B006AE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhHmKh7M3cIQ7kNvwEt5r0u&_nc_oc=AdrkRBDOlcBCX9HFGZxNZ-jorIznjDQELclraRMOF_nWvHBdndcxIsazjtqjELdTHIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRixzMIzYCwreKkqhlTnFxsk6ozIDIhLJ9HvZiIdy6O0w&oe=6B0087D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFMZg6ft9iMQ7kNvwFy9kqq&_nc_oc=AdokM1f57gTwpvmmkopmwtOUENQpIeMJLHLgq4bZnxc5vyYZLXN7OpeGtvQ_FFqIwd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5uXyu0mbYhrAzj9eBQ7JOSY9hDQGQWNKyz5mZVzYSqA&oe=6B006C21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLQSk8IS46YQ7kNvwHhDWT-&_nc_oc=AdqxtzrROlIavt0iGiYfGIRnLrDHjG7FO8H92sSRNIfyzvB1iP6x-MCdXGknX3HJ2-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0gwHGh8Ytpv3smRNsbdwYsGSBSM8iTpeHUsrNddUo4w&oe=6B006259"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
1ejaIZlMDbyQ&oe=6AEB4A2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1XCTt9k_2cQ7kNvwGW9eFM&_nc_oc=Adq5NUuq6gRMPbCrqdjdKWobVa0IFK_dWLstJ8mnGLXHMyDq9TNfmyZDhW4mvtFXgdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQiUP55kzYPS7pq12SiExMi51GBvE9xyJdArRbTUOOVQ&oe=6AEB5464"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3BAIuxICG0Q7kNvwExTjaQ&_nc_oc=Adp4_lbrO6rq_aWAkP5_gP9tEh9SUg039RdeZsMA3APRcptvNJdzzrqUx1162vxn9ig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeFc-UBI6BJp39Fk_obJWdxa-LwQcviWFDXNSdofVMSw&oe=6AEB52E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J1aFq5g01IQ7kNvwFx9H_n&_nc_oc=AdqwKCmgjNgx4z1fyFrSuNIPzuMNVmF07h7NSitHX4GlGjGUxLgMs2xAn0p5wBRrbiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIDkesWuaYPDkkJlUzZosxvrpIEWHtCZw6bQ-QC_wstA&oe=6AEB3798"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUt3RTNh2QcQ7kNvwEltBds&_nc_oc=AdrqFYyoPXxNWdtmEecGLRrxnKiv4JyK1Rh8GPeD8h6hTpv_dPk91ZCJzq_ZovdYPpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTlRzXQb7BrgTOkbyQljZrITQ5E2eDu8gO-axw3--S_A&oe=6AEB5421"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfDGMAj_A8sQ7kNvwGz1N26&_nc_oc=AdrqHena7R-FIJagcFCMURy7MaDxJZzER7TJOq4_uDb1GUmMzQKOyb2OZQTrFtUGalY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9_c7COhGZ2eg1d0ZhHbTzZ6Gl2eMo50owskwJW0v0rQ&oe=6AEB4A59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWwVGxvvfO0Q7kNvwEDGGqy&_nc_oc=AdpK2OpBn8vrGvNlwekBGg0GwlSDgW9Z4EY6gFy3b6JuRXdicZ6GIM1BLYhbUOsaKfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxOwb7LaqJQhedpchgXyBYxnvvFnc0UioW3sWPieEDjQ&oe=6AEB5626"}, {"file_name": "stair_generator_vr_25
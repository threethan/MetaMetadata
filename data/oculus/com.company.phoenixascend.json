3kDJ0Hj5xTDw&oe=6A75F4AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDSe_ThGZn8Q7kNvwGatHSS&_nc_oc=AdoZPveXsG5cO8D9wsV_ssjus7Zd2_qaW_sJLck2v0GiXsrTucD_UqJswlt78_4xTMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrG1uSYeZ1Y1LMNjsow--rcm_LUhmE7cJyU68vuxedLA&oe=6A75C6A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3cl71X8RVsQ7kNvwEkm1XU&_nc_oc=AdooSyMqAfbI7l4ANX2guLiprh1UK5azrH38mORTU8voU-TwUDGAw7l7Du5CeDyOMtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmhNLm3nsGVMdnh40YSPSX31WIrg6TgXhoNCVs1p-eSg&oe=6A75C527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAgqGCZzawsQ7kNvwEBZfvj&_nc_oc=AdoTF5fzKvhhdRXwpQJReiZ25sEO0N6GVQ71o2Rwi0ciaA88rDlczpYWCpMFlxK4iKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET2ocDPOSGyUbMPJLHs4Y8v09SzweRPuf0-55wNV3JGw&oe=6A75E218"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyaTFbs-ctkQ7kNvwGWDQDJ&_nc_oc=AdrEtYu87KX3l3qeFnCZxbeAwxfZlpeCk-jM5s7zC-Nu5AZGp2BrD_vr1Em6yZFSWNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpEilh1klmX0Z2x9D9my4-bFwiqDYIQLCwzfnx2UFviw&oe=6A75C661"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8PXA73MpOAQ7kNvwFIys3W&_nc_oc=Adr_TM3CChugxuKGJi-a2rMtH9sYHEyjVf6HxYrAxFrOHztXDmjU4-9xnCbZ2IxnhCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmmJvAn3qSoydDMVG7RBOhIJRXuMAHXANiE9hg78xZeA&oe=6A75F4D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfNAPc0Iil4Q7kNvwH-eI6I&_nc_oc=Adoqf2lxkZIxQ28nE7fh_muRjPQ7_7j9xolUeWoi-A7Vh-Ea53-DXvj5EeSs9W0D028&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB0FK3J8JVbIIpKcImsnmGo7qQNolKiahl48U3q0yGVA&oe=6A75C866"}, {"file_name": "stair_generator_vr_25
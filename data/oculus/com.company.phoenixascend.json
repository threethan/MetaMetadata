tEdPkc1f8ULQ&oe=6AA024AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZXigl-X_xIQ7kNvwFltqQ_&_nc_oc=AdqjaKNgIIQE766MmeXHYRybOZzLKrwVP7zN6yWU2yX2G0gkIt9N7yPQbtNvy0Df2hI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfoK_W9kq8ZgZzsKaj9XlfpVKbBA61mn92i9MusxpXyA&oe=6AA02EE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHPQP6t2vcgQ7kNvwE9WHeZ&_nc_oc=AdrQne5q__PjggGNqrt3BjMIKtCwlVEyvFXzoBJh-rXUSGn6hyrmUb0UVMZdda1W5P8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-kSIvGpTGP_f_VqdAmEyXQYZeax-Ikcse_jQQJi-Adw&oe=6AA02D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rknpAyllzJcQ7kNvwFWr5q4&_nc_oc=Adro2b3z9rC3uO8j0DPz7dr35Us5VgyoUM5ceRyV3UKOfcYGxYImSZX_Q3muIDwkETs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxR0QjJ1hgv93cEIW2hG9rmCuaeyoz_oEGHVnzfbbP7g&oe=6AA01218"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYW-X7tKUP8Q7kNvwEwLIRy&_nc_oc=AdoUMa_7J12yL1FZHfmxZkZtGu_UdSQ_yL0Yw-9f4kVZ8lVRhvRtP6hv89TAbNNO8Ok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYhcl_lq98tF8rfNnYQDrM0olxtaSdQ2aCTSkjt6dhlQ&oe=6AA02EA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_MH5vsHT3IQ7kNvwEae_yV&_nc_oc=Adq_xxj3HNt9DUFxe-SavTVMrKVN4ATUMl6WlQt7bpfi5VoZQ0YX9JRnCyvedMpd57U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAiUBsdRwPYwf_YVF-reUOd59IIXvz_MF3pcwJKIVIEQ&oe=6AA024D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OR8lyj8h_wQ7kNvwF0wtx_&_nc_oc=Adr9IihWpAcJ9OzKUiI_kmFDvRqKGE-h2NyE4pIpmjoEsnvvww9aZiiTLIqOQL2RS5U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDxExTYRHjOdprlbsvRXBnRoXRqLQvPgH03tndYHcQ6g&oe=6A9FF866"}, {"file_name": "stair_generator_vr_25
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-Gf7rSKrGUQ7kNvwFtcO76&_nc_oc=AdrCwetoteS2jquFg7VCHb79JHlorvdxT0GdOk6UoU7vKJZq_RylRVBVRxncAfHSOes&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfMbUAPM8bU4F6VflmtAxpxOshd8eSLuVekvTKLZ7krw&oe=6AFB1C2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuc_0LXy3fkQ7kNvwGzfJvv&_nc_oc=Adqz7hnuxLJMU1KmjwMqpTJbfCKYLRdd_5xBB-K9F4Ije2rtk8P3sUXTFMv1hCkr850&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFVJ4xZplA01B4Miy05xLnlAZo218qmnUyoK-UA9a2qw&oe=6AFB2664"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTIf6YrvCNoQ7kNvwGBigvr&_nc_oc=Adoh665q5bA8wPmmSyBguPQNZz6cLvzOqNCsPVfoL8ISaijRwWS4SjXTXAEhXvh3vws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsjVJeGc9F1u_nTMnuG-_BGAUEj9MChk5u2rNVKA3AgQ&oe=6AFB24E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aX1DB_ZTQ0Q7kNvwHKaual&_nc_oc=AdqVIyUGHNvMptYQJBfnPLvSL5pxerYCaTMwT6J3MpQORBz2JkDwee97QqKvFI-jLDY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-kFWL7WPgg_JyuWxc3vf3Gkwcp3w1RSMK6CNwQM2NVQ&oe=6AFB41D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAptPyGrxgEQ7kNvwG6ByNu&_nc_oc=AdqZji6tbdXJrvYU9OA6KkPUKMQWZ2HzfFNjdjRva-HHrdcCGU_JPOjTOjfrzCVPoVo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSPIXs1L4Q1le0FIjh4NJO-wpTiULjezgjLiOo4lG5Vw&oe=6AFB2621"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHP-KmyUZwYQ7kNvwFOIavA&_nc_oc=AdrNWz5LejpyrlSwuts9zYTIIkzwmDyE3FdlTPU79z_QW5IhaJ21G-WDfjGclr_NPE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB2Li832uqWiZDPV0vOEpSHQ084vvHuLXeZsX0ZJXuLA&oe=6AFB1C59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.57
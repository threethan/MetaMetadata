fAOcTcMo5-tg&oe=6AAAB0AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q6z9hsdYn4Q7kNvwG803zz&_nc_oc=AdphdMJu4_w9v3C04Kv7ewScgAeEGDHm52VzQ9gS0ZRD3Z0yl-Ri9AN_9Y23HAFpZp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFFUG5wGEPDpoTPVIkLebmgKiiWyV716Geji3m6_KCtw&oe=6AAABAE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEBIR2i-E-wQ7kNvwH3JCEC&_nc_oc=AdrJp1_Sfvqns1SRXDL0dOJOdtH6guQ06KDHx-DOLPhQ7KxRIZAzYWWxDgVIzGgNuBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINSd9Th0Q5H24o8BUpPKszSEWrL-9PYFbW4lqobgJWhA&oe=6AAAB967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jszZKyslE50Q7kNvwFFeLRW&_nc_oc=AdpWtVpDsSyoGlV9ah3bh-l5K6RnTuAvoMO-kkkfAA7Gj0wKJl2mChriIJMru9TtMMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiAHZ9ID1BU48B-bgEfXeMcE7HoUDuvnQXK6RafhrGFQ&oe=6AAA9E18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBuR9YoLhqEQ7kNvwEFEi-2&_nc_oc=Adp0cX538fwLwezkucOoHMVHu6DXY1YBA899BzvuflpjwGRkCqK9Hsxwbnlg__-C26Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyXMyegV6HWbaAPOvuldnN-7VQnAZwmcB10fvS0Dapkw&oe=6AAABAA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sht8p_sJ5skQ7kNvwFtZosM&_nc_oc=AdpepW6_hqYyo4h4sAzjKbNeNgdjfxrZHhCzCjrP_a6Ok0wT4r3WILANhY_Ach8wIA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1Cr0BM9aCHV4cfAAOf6wtlS1S3Jtv0c8SYV0_Mvzirw&oe=6AAAB0D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mT6OeB36xEQ7kNvwGxH1BN&_nc_oc=AdpYeP1MOz4qg3dRazO4crSvB6V52A55eE9QwcZwxj_QrEUEDVNi7OH41C-fI34v7mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmj-64iSIhYa4NPM5gpWDPPHUzRyNseJAUyxfiJikOBQ&oe=6AAABCA6"}, {"file_name": "stair_generator_vr_25
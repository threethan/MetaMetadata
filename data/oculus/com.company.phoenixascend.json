6oH41S_lS0YQ&oe=6AA56AAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwuiOfinZkcQ7kNvwF_fMRg&_nc_oc=Adrn0guAfeu3VdyS9tlv-gEfjwoTRabxhAGDG45kysWqhtQf-2wdW3k7EZKoLHE8Wak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVWqnmRYbE8ON11zzI-ZJBZzFMYAFpE-7xMWRZbvU5gQ&oe=6AA574E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju121Nfvh7EQ7kNvwGQr74K&_nc_oc=AdpQmx9JbD7if9YMCi_u6dVepLj2dkPWQi0EqheeGwm60DExWnxkO68NNOD8uxuOg4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZNkfoB_xhE7RDjaoixgAJtPwxv1zAdXp9eHz3ahfyBg&oe=6AA57367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpZuv20QUa4Q7kNvwFUa_Px&_nc_oc=AdouZguOaOBcvM2vJGHcp03inQnmeXrn0mVb6T8rgDAhkTutOfwPTvPBy7YBuTsZoHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx0LE_H_zRcNejNoWCW27YBSdI3VWsbmzDuoHjIfxmEw&oe=6AA55818"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-maEzb5pAsQ7kNvwGlA6iX&_nc_oc=AdohfoS3kmqFPLiLobgd4jXMRFF6tlf1Ok8Oc6BA8E-uBKPiw0kiNw7KahS_XvzdwfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuWJKqKOdma_U7Oblpepjw0s0wq4kIsHC5bzjyFKeU6A&oe=6AA574A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPNRCaIC3BgQ7kNvwHe9m88&_nc_oc=AdqR4s7o1S2vG-xO6Zu4F6QPfNou2C9ZaVZ_LTb3rhH4yc8wwnLPCDJuGXVEkSKckXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrVt_KFroYX3oBu0ujKgbRqaoq1KZp2IC8a6u5ANuJ_Q&oe=6AA56AD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsIGE6HA4KIQ7kNvwH_2z-7&_nc_oc=AdqHsLlz3gNrvOqwM0rkFROnYf5PK1LR6KP9nQyTPOhtAqVREfl45hwOZUGCHV1TDc0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE1sX_W1wJ_t8AwPALnflHhLDUPF0_0OkH-TUTEU02VQ&oe=6AA576A6"}, {"file_name": "stair_generator_vr_25
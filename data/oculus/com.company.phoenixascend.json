oSlqHK-zaHog&oe=6AB7DFAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV7xErPoWcMQ7kNvwHe3-8Z&_nc_oc=AdqG3u9sXWdkuuvLnKR_aL4uHFgmXixWCuUp54RuwhiK30pV5xpCKwX71uAb_9YnSWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPmcy_SC-sh8v2vzh94EkXL72BE-4ZZswhQNLTPZYpuw&oe=6AB7E9E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJmOKcgTxSYQ7kNvwGmdgwf&_nc_oc=AdqthoOnuPspJgpIbQ9awwLC8gd2NNVU-mVnBpJieZcOykPyqf3AiVPuLx-S7HrZG3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL8VuOqs9AsIEcoX8Vr84hVhTNjlFNN_1qbzcqMAT1ew&oe=6AB7E867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxTfivgS_SkQ7kNvwEqE3Yz&_nc_oc=AdonqgpT777Bd00imKQwkj8VLnEfQV8KYEjh1gT10weC08V70fvPYH4giXyNjEHSrVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlnP2EriyNhM9al5ir_EQJ216x-O0yEQJqZdGhLZdaIw&oe=6AB7CD18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKnMpd9zUQQ7kNvwHip1Cx&_nc_oc=AdoucAvpgplsvJO38m7TxE-6NrCJHlnxOD8mHGJlHIhqQiPtrilEmLM9sc-QBDy0DTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe5wfZD1wQ81mnueg7hGjVAGP3K1dYHuUkhFCjwvLcbw&oe=6AB7E9A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uhaD0ax91QQ7kNvwGV5N4P&_nc_oc=Adodzt9MPLftE9TlQETfgC_tB5BggZ9aRLV6WysmZfj0jUJ0HACo2HJrxiqlVpcvwPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyVUyExgTp2kr8gwuiufjiekJHf3V5H5m5islnPD9bFw&oe=6AB7DFD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wosBG6AKGUQ7kNvwFfFPE8&_nc_oc=AdrbTILa0iIrLyP1dfG2OD-R1qS94dAA8yFn2qd7ZhlqT9JGIKzB0J6B8KxG48W2sA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfmLnwhaTrZTXkO68OJbV9OUSTZ3B3tv4HFYLnG6cq4w&oe=6AB7EBA6"}, {"file_name": "stair_generator_vr_25
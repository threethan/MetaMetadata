kLeZFH5_QL9Q&oe=6A7EF6EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNu2dvaPKVcQ7kNvwHW99Ew&_nc_oc=Adr127YtDrRgCS47xlmwFwDE-iPHn1TOOldlrBg7aQR4UtQvjsFB5UwGQ3CdleFPEEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOjeYmpwr9fsZLS48u93Ies_-vBJDzLAfeSraquCX46Q&oe=6A7F0124"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s6bEtqj24UQ7kNvwGynWWT&_nc_oc=AdoneTV6_cibmcai0hgHqNbuyQiM6o2hbhVSuM3Hgolx4_DSng1YLbqnjai0S3lj-DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVF0CEV65-hd5wXXPgkkxlqwOg2A58OjgcOkMXQWy3bA&oe=6A7EFFA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGCC3XdSwRQQ7kNvwF-23rV&_nc_oc=Adp2w6nqnF8lYPxN-zJ5OJ0oBE_tFBBaaBpvwKHdgyWFkMpJigYRJy5VODyAvqP8FRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9mZdzVFaZl9KO7HUBBfGV-2tZe_gwQAlfmfmhc6my7g&oe=6A7F1C98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LmImrcx5jIQ7kNvwGK_SMZ&_nc_oc=Adqe4Wv8OvPiLmmZhNrmqJPcsOrxaIm-td2p4q4bODwWPrjL7X4mh0WgMUtwz66jY9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlAUNcSvt5tQ-H-s8ROYwHsWhHqa1m0i1Sj_l5L-dbHg&oe=6A7F00E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF9lvPGhqaYQ7kNvwE_rx1s&_nc_oc=Adq9j2xFehegongMYnlDsu4UDBn4ZhC9f4h2F5fgMvez7uBV2W1NOQ5-TmVxOTtVXsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrHnd0rYBsdYGs25aE4UOXpr62sOKr-ruwJMwGdyrDzQ&oe=6A7EF719"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25-ywn_I6fMQ7kNvwGr-qsG&_nc_oc=AdrJPH3jeS8SGlX-Y6fSp40-MmvpPnpHHqB1BAl9GNYbjjsQpYzIefojAWT462v7dgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSz_UYvjXtbmfPmmGJYdke_U1NJVfDBlWhHC7Ez-SgNQ&oe=6A7F02E6"}, {"file_name": "stair_generator_vr_25
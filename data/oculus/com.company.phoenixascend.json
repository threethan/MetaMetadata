muM4vbkL-vEQ&oe=6A67742E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C5_vhniPQ4Q7kNvwH6VxqO&_nc_oc=AdpVIzQH136k3aAgiKwSAqZM_o3PV8oDc5Ii-cgbWKsjyHjrwT6cvju0CmnmzHaX0is&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf5g6sV-KJ5Ghzew0ocQCfbxOlljsuLTkwJL0rXFcRxA&oe=6A674624"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72Jw3gDZhDMQ7kNvwHn6b1M&_nc_oc=Adr95fEZrBJZWA5MyquURuaV7hp42Sg580fdgVhOdHmpmJk4gUKNpCKU3Qaodhk_g2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyId1s793j_BE-NOuoeeYHubIg-01eFZtSA-NNlWF-MA&oe=6A677CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5AWj9tohHgQ7kNvwELxCs8&_nc_oc=AdrPX9K9a4N0Gvllzn75029smhGOJxYhVHRP1609LGECK4T4PMkhU1kafNW5KuxFKp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmO8mXV1Q2_ZzzLnQ54baxnV2t4FShunUXPTgVKNmrQg&oe=6A676198"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF_g6sPNQo4Q7kNvwHJP0Zg&_nc_oc=AdrYSYdblJxaCuvKcTvzzjevHnfWZCAOoX7uOQb1lF00ZnZVfkY5t7qWU90f4fFX-8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXIgkv82ymrP5COF1YiSGRLRQDSgLxHg9u7sprNtRLXA&oe=6A6745E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1hLnFouZJoQ7kNvwGdYYj7&_nc_oc=AdoJzz3ZbquBCpDWteWtTEb32z8q8vcIeD_-0F2GpBhBCiPcnUhANv6FOWqD2Jm4UBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDueu8IMo811piv3H2XZI2bQP0174Y-5wbKqXcvt_pnyA&oe=6A677459"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYlj8QFTjW0Q7kNvwFn_Ayu&_nc_oc=AdoEGlutTK68_mCgKVeFhYZSjc7IpqLuiZ42Y4iROUl895S7EfvK4JSMCVFz-nZ2SBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvQWk_B1eJ1Ilcij1Fol5I8kWcBByJb-4SUWdbKiGGTQ&oe=6A6747E6"}, {"file_name": "stair_generator_vr_25
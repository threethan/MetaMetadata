fov4RW9g_ybg&oe=6A9ED32E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZXigl-X_xIQ7kNvwFicfzY&_nc_oc=AdpK8Bm9qUNt-gcYGU9BCiiVxNTAZTTSMalYL2rIzoLR-NbWzW7YF_kAzWm_0FQCboA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi6FibmuUBeG5Suvf3PYOmvty3rZRWPdL5HLEJv7Kxig&oe=6A9EDD64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHPQP6t2vcgQ7kNvwGn2_cx&_nc_oc=AdqApAYt8mXE3MDOA17RfgromXbXMLnPeAxE-ULpx4BkaNSfgOGdo7fxhLqafKry0L4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4lMovQ5QEhDyVONwiVtCK8kvEyPuedV7qZonkPGcS_w&oe=6A9EDBE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK-aXt_3rSIQ7kNvwG9rUg_&_nc_oc=Adoyf3Tgmcm9Ivd8wNjnj567d3WyutgQKMi69-gqVHqlfsuvEpNm2q720IVo2dapVGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY7s2nIe4sTiA3pqR17aK1JuwWkLUSytuMKUTRYRoDxw&oe=6A9EC098"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYW-X7tKUP8Q7kNvwH0D2of&_nc_oc=AdrfELlhAjK9KSw5hz-qCX9bCLzGvnU8320tC2Amx-aDVdcCTIdzJyvd7ecLZmXg1gA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAFNfCML523xJp7ni9EupRSoLKDXj0A0kLEqrc91Ap2Q&oe=6A9EDD21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt6Gca0yyUgQ7kNvwGsxqrB&_nc_oc=AdqvewsPHcqPhwd2J5jr1WkElkZJNsEIMjkxfLP7uMDeFiibEv39Q9KVCuoV51uUhW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9A_R-4jkAftiG7kxif8KRgxfUaoL9Vmg4qW0o1ndJDg&oe=6A9ED359"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OR8lyj8h_wQ7kNvwGJcZS-&_nc_oc=AdrUEcZE-QHe-wXXcwrrrYd-NGd8RNKwQHQ92g43-5iXas_SuYn2sWq7DalAebDXTdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID6yuOQPwagrwzECGQgQi3AuCauFhtMuOYf_dCJkKyag&oe=6A9EDF26"}, {"file_name": "stair_generator_vr_25
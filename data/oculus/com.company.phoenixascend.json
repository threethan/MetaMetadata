rYoVkQipedig&oe=6A983BAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ABpelK0qZwQ7kNvwGTlgwL&_nc_oc=Ado9pYTmWRF1JPAQ-2KlFlcyQIOKYDzpjNTfqPmyQ4e7OPW9XgJr8VLM6QMGvq4Qia0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_vhv4w_88J3_h17rwSHjRdOE2EyPmxXuWtEgpFEoHEA&oe=6A9845E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxwK07dIfoQQ7kNvwGpm39M&_nc_oc=Adqyen5G6zcIOyHKFmBd6le2K0_G23NTtDuEzcLSaXhSz6fgt-vHM8NtRyyysTAuvL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ8nQ0RiPrYk6XDdioB-I8ZcqB5CykfgkuasX6o5sM7A&oe=6A984467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2-q_4MhclsQ7kNvwHRTpcl&_nc_oc=AdoRuxKfjTRY0F9mpBjs1jP9hKzTbVf_OnArOLGW37SIiJy6o0M4YPOBEuDw0o7Wl5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2hce10hAW4QJhzLWJNnq_MirSUCcm9tMXAlaVYVtjPg&oe=6A986158"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePkryO73NlEQ7kNvwGfADmo&_nc_oc=AdoHne5UpuazqfM0xnsEpiYdrVGhEEPpXqrS208-IBa-W1oyHyxWEWMvUD6skxMBlyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrzokaJxAVWZle2SixHKqp5LKl7C6kXct1nD0jY2hsHA&oe=6A9845A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trZyfA6IofUQ7kNvwEhJ0s_&_nc_oc=AdojB9FWI-APtx5_CBwy5FvUHsK9zE6GiNRDJsbuVuHpmHIiPzHjcw_oXDV3re6lfl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVZe9_gNvnXLHJWUNvLVYb2epfSaMYP9jCgXyCBQo_WQ&oe=6A983BD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1DPIMrdjoQ7kNvwHQpdvn&_nc_oc=AdopqwEiqUIY56-hXcQgFR1Y-3eeIbc_myPdplLt8ievRCQU2wJSeRFpG9AmJK5D1_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVwBVanlMw5UdZJ5PNJx1hb-9Zq4_Yaq1SKbcPmpm6Qg&oe=6A9847A6"}, {"file_name": "stair_generator_vr_25
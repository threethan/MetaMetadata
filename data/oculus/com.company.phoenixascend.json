Rt_-eLIjxAJg&oe=6ACBA62E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAYX4brA4yIQ7kNvwF27dzw&_nc_oc=AdpOSFnEJBOVOvHCRFT7K4jtGE6oukfWIbuWuZ9S1AP2OX2goPqpEsSL6AuXbKPPTzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-xwihAc8WGPOx_PkK0XcaWhnBnFJUz_cFABKEjcXMdg&oe=6ACBB064"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXXC6ESr2vgQ7kNvwHJDWmC&_nc_oc=Adp9Xq0IY7c656J7wC1NjbX2ySDiqwjHDLU515xNuMM8XPtxbzek57VLuHa0gN45-tA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf5n1H2Z2UxcMr_Sxx8E2LU-pst_GC-wHXF8brQVZa-Q&oe=6ACBAEE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri_h30Ipz80Q7kNvwFHVLKW&_nc_oc=AdoTBA4MZ2e4-mvVszvzCLzrhYJECssxKJivIkuzQGDtBs82Xe6FnSkMnLu_GLSuZrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNavQCGoEyfUqZhqix3bsJPENgEo4eNtZDqWQh_5BKPQQ&oe=6ACB9398"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g-MoczPvqoQ7kNvwG4X6ep&_nc_oc=Adp4dp7il7gbas4bzAc8woN9HETX82p6kvhjKkvbCzfYMCq9nuVUayS8KWbW55uIETM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMReVAFh6sv78c2lwf7yvN_rW3os97DGoz3afG3FIt4yw&oe=6ACBB021"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGblUP1_cgQQ7kNvwG95__P&_nc_oc=AdpwBnv73wsWnwH8PIY7qpRsk1ZXL0yfHdT9SOZLRZGvknlCoQi-EQD5vH9VXJv1yzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5anwyqNMNpxdutP_hx6sHrmFS2jA_u9rqXVYrQvY4sA&oe=6ACBA659"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfs2P4caJMMQ7kNvwGBkDiQ&_nc_oc=AdoJr67DUHFT1HP2oc63qb4RJ6USfdkYeu_abjqHnQAIBCAP3oVxC9wtE9CZYDNe6PU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhnZ8XfCRVKSY_XEmSiq7dcQX9F1NC4T6-MEnQvp3GzA&oe=6ACBB226"}, {"file_name": "stair_generator_vr_25
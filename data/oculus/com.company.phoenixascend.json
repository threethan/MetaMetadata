less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-Gf7rSKrGUQ7kNvwGEkS9B&_nc_oc=Adpkx4ClZ9KTbH0FwfGSNAhrW2yfI-DYB3SPZABOdoL5UUMEBJvd5KHyPnt_yNJC4Ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyjdhBYA7FAGQ8i2ugPxb5ivMIazqojofQPqG0RrEW6w&oe=6AFDBF2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxq045T7f8Q7kNvwHEWR-q&_nc_oc=AdroUlgikRH5npUgl-aU8IL_alJ2mPnUhnQaPOoYpph6PCwMmo3IWeESlbU_NyqNB_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-qooSfNaQYu9XbMEAItK6iQyVks9iFI3-SQ96zLng1Q&oe=6AFDC964"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOXxDJhB7CoQ7kNvwHpk0WR&_nc_oc=AdpSybKhLZxUEBWssmoNBGhpO7tVyGZ1kvUgLFKCUTkXt9RNLf3c2yo7grg6s1kc05A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrpAwL6ycdDPDalLuMTbi5GA4w9kES0B10XWjEx4Bfug&oe=6AFDC7E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aX1DB_ZTQ0Q7kNvwEPw8W1&_nc_oc=AdoycqzhgmKP11kHFhjXWlut0IImytUrjSBM44lF8oBfryRFfXPiJjyDRHDTwL8Xfpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfy1YL1msYNk2ePaLll0m_BRXhyiOyyhD_4Yd9vzGZZg&oe=6AFDAC98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkPZcxcaoMYQ7kNvwHzHSXx&_nc_oc=AdqlQFeiEy6HGxfSjX0sGStyX-ezxt7wWygg-LjTu7MdQZo8zKWNu0_gi8zneTnb7bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGcxD3OXBP_jt8EKXYMrEtpRsLwsNeO5yUhbaBrkKCZA&oe=6AFDC921"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHP-KmyUZwYQ7kNvwFM4OtB&_nc_oc=Ado121K4iQul2c4MpJrBDhWKMivKwHGfk54rKpq3MPC2g6s_x7qOItH8GSiXJ965JBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLo2B0gjdxk5jVs8k9p07J2Nr58C21pbwYqyFPP2IBUg&oe=6AFDBF59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.57
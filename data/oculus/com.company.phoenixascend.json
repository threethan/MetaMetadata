AilR9Fd7Cv6g&oe=6AC26BAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJy8mCZQVDwQ7kNvwGBZypt&_nc_oc=Adogz6_e2JOcJl6QlXWDEys3dES5jBX5XDiV0UcuPRUs0gX7ehcxLXUs05Zl5Q8WErM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ-9KWHsZmxD01rT7BDEnxjxhNKiMIMlE-k2T_6QR_dg&oe=6AC275E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCAjpSgoJA0Q7kNvwGijQCh&_nc_oc=AdqXKnvOqDEXnRkkNy-hd9fXgWBjxjzL7cdJ1ieShcguCNeScHRs3JgfktAC-yl1m-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9PyT0ZZNYM63tyHS45yb0JJMSFFz9F7pNQIRqZjNxBg&oe=6AC27467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meGpoLKPYWAQ7kNvwGnsHab&_nc_oc=AdpjzOXAE2uvHbtehHrJNlAArhjGYaYLVO8j7Y0n66xFXRUSl8qD8ZwUSn3Cxs_7WWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCzJ_M626N1I75L0zuSO1KmRLCy_cv1ds7Nc2_qTqXTg&oe=6AC25918"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vsi6ZqKyV8Q7kNvwEwaSGK&_nc_oc=AdoY5IafVEEZCpFp7fl957kFUYlq9PEq9y55il2P22o5FaxUuSbT_YG7-_W2nhzvCdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3aBiX3hsOMdLdplhk0lgnCqVoRnJsgoWRF2aFx5V4TA&oe=6AC275A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTOLmdh5gIEQ7kNvwGDx-A6&_nc_oc=AdoUem7RYEiP9biV0KHlV_q4cDkQ2iTrbBGOxkBV8035JSSXp37QzO_GXpiwHZJ3nLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtpHvpaMiTCQWEd83viEFNjzBujzBP2_ago8JlvrQZWw&oe=6AC26BD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZngwtovb_oQ7kNvwEVQ6E7&_nc_oc=Ado-jgtOtNH8C7loHA_951RqWGt5TmVrJGLGB5EHq2s5bP84rZetY6xAtUSMkQP7Ebw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdD9nNydXOq0VG2kUbT_RRHZy8WK4FtWr0JzSUDCZ8gw&oe=6AC277A6"}, {"file_name": "stair_generator_vr_25
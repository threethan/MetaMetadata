3lvAIsbqg-mQ&oe=6AE3612E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20qVP4xTMoQ7kNvwHrMKH2&_nc_oc=AdoSFFq6ZJlWl-gXMlB8gC_gFU1YTpVYBcyDzJT7oK75AR30TjhPYlBz_bhZEIu3ivY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJuvr-BNembigws7DLOqtkF7JUL3fkdbC14pyliFfQ2Q&oe=6AE36B64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMsGRPVVWmUQ7kNvwEF5xkk&_nc_oc=AdotCojHMZCrSkFavRMK5o_VIMja7ABRBygBECNvWzLcfhHw4iJqWkGRsRvegjhwZ6I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIZB9i9ESFgzYfFyy8GZOItiA2bngLJSkwx4-fWxiqyg&oe=6AE369E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oV-hUngKagQ7kNvwGqvpvt&_nc_oc=AdossjqAefLnf2FEL8nxx7eF-oMFTH_9H1pEJpk6pjra1NIZ0i57rZp8dCjPuVQ6pT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy9hQCP5eR1FhjdNcUvkub6RNLE3_B5Xue86aiyKktsA&oe=6AE34E98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBLBWtuUtfAQ7kNvwGPKac9&_nc_oc=AdoDaHW7QFK5C3ZolvW_ckXl37zHzjUVqS0keCTpidhjbRnga2JHXrn4PTAzZ-szAeU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBguV9cxoDXdF0FL4g3vhq7uCdce3Yk9gty34h0N-oFQ&oe=6AE36B21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLaurARejY8Q7kNvwE1u9yY&_nc_oc=Adq6-AZlYyQP1oJZDhicu0GuqI6LqoFQiBKR2SYNZEQotKj_y4VLUQnNN8Pysvha8iY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpx3bfAEXJqbGpRJaZtq6dngX_YDaBc6avUQgjN6hVIw&oe=6AE36159"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DC-IUZ5SLgQ7kNvwH_7yE3&_nc_oc=Adr_pnADhE6T741D0O5Pmdwidenl7Xjv5IDtDSlVDuRdEt9znq495sPxLSXxmg2BFHY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7V7HsXTsrP8yFmTJANeCbf7Bnn3OcHmwa6UeA__3PXg&oe=6AE36D26"}, {"file_name": "stair_generator_vr_25
7tX5HxkDhojg&oe=6A916BEE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K39PwVeO4EQ7kNvwGcZm57&_nc_oc=AdqAHdIXktppfvkMNIeIYitCYWN7Ly8kHtIuAyl_8AB8lqGsiYq2Kw5aJGu-1HFK5gc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhBK3PpyvwmwPRvtPgzWewkdus0zji0hAXd6x2I_4uhQ&oe=6A917624"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5kp_JDi1oQ7kNvwFlQA5B&_nc_oc=Adp-we4Gqrm70v6c9xM08VbVA02hwLSqMENjP-hHxxkf9b8MKVqR3f9-0WaNKDPuj8g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs7vuYqq9BCUpjOcoFQPc6uzpR4L4HxV-vwfrboM3JXA&oe=6A9174A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxvAhX3ouKIQ7kNvwE6WdDs&_nc_oc=AdoagDPaNls86801Y0o8BlBHAWWHZfonGqllpM1wCwIjzvgydvdIv4TA7jgbip0yefc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWUKYtkOYi1s1uJzoOLgTO8SbKETmevwwO94jd3zRYOQ&oe=6A915958"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgL1STa00fsQ7kNvwG0Ksg-&_nc_oc=Adq2Er91extisrutktLwbP6bqlGwwVzByMPz0N8fWuPO70LP4-SD-PWFdiKinZSKdeQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMQW4LeHjYrRBmD5FkPxggXH5E71evkj3eYeAb5CpeuA&oe=6A9175E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIK055s8xGwQ7kNvwGCemfz&_nc_oc=AdouGFHMbqx0TnzHRzxHCAtMfi3xyC6BXnIUAR4jjnUzMIT7NAUpG7vGnup7vbHHJBM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEylUcNsTmqkuodYXDY-RlaBSyYgKEMG3QGR8pHoTEWog&oe=6A916C19"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GZGEVvgP8wQ7kNvwGN8i31&_nc_oc=Adqpz89sLXrTaNdiOdy4c4xLno-ezh7TU1BT3kYJQ3Z_D0wZ1VbDsiHqTjagk8KFXNw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpoAMndVhU2WcXjKqzXMEFG51MADa-pON50HnJYvLxYw&oe=6A9177E6"}, {"file_name": "stair_generator_vr_25
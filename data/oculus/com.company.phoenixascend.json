2sCCHAXP4sY8cHTu_sX1RYqQ&oe=6A8D776E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKaYa0fhBEUQ7kNvwFv3WAv&_nc_oc=AdoY-Y75xo2Zb6vxQCYVpPRmcINP_LPB8aXkqZbTeJXvAd5g5-DYLEz5Ft8CflIzaqM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6AF10MSB4dDKJ0YNNewpAjc8aY__LnmyS5CXNaS04lw&oe=6A8D81A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h034g5LaTnMQ7kNvwF1TKLq&_nc_oc=Adqb5TlQ3UONVNh5r0fKYy2qHABhzOQZPbU2ACugDpbY6YcgejOfLUPOhnyeLZq3VM8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaLQVsARk6y9UyCOyevA4Qu2U8fKi_hYSIkUzkxUqX_g&oe=6A8D8027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS8Xwf7AGnMQ7kNvwFYnRhY&_nc_oc=AdqDi__sSZVAElVehTnmCMs1YDfHaLDeyeEQd-d0j3UEFl36cY4YLlmYGJrmgRJFcAU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSSb1QN-KEM3aDphpkeQqvp8cRWiFxyDwU2TI9Gl2d2Q&oe=6A8D9D18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBxp3vmu3YQQ7kNvwGxyLT4&_nc_oc=Adq5b68vNcbT24fvoZfgxFZUffR8A4TBxgpyX3Cmrw1zoRw5qzzLPXIcBDhr3OGV0bk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh3gAnjl4ehnDTn_YpXrlj1Nj1isfLnVNVha7suCFHPQ&oe=6A8D8161"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_9_EyXdGkcQ7kNvwFatm1x&_nc_oc=AdqcFat2mrsoxZY75yD8qhLyFP1IndDmJO2fpTZtkFb3ZRb_yR6WjFnVHrGHGXpm7Sc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5SEWAZTsmlW0GP5qu1W0FV5AP1UXEjMpS-PRpBH9aUA&oe=6A8D7799"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cnz1nuqJf4Q7kNvwGvLnkJ&_nc_oc=AdoZAosHlwlcXgg-Xi87EQsLk3GTxbKaEOWIidtPLeq5YqUxOIj7vX9C7MaZpIH3hmo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu8Rzam3c3d18JbZQGFYTGzRPwoEBI5iwCR_zynvtF8A&oe=6A8D8366"}, {"file_name"
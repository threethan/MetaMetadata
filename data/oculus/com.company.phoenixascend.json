MeV4XTeiLVJQ&oe=6ACF9AAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-db0tXVJYwQ7kNvwFA3Z8P&_nc_oc=Adp0ZSRP1s3XB9fu9BBmaWEW1glrgnfoXX0ZNNTD8zG_2T3qj0rTfMKQqUxgwqMREfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcqKKtBHUj3n0q8LnCHjoBPwaamY8EctyLIxXsu7lIgg&oe=6ACFA4E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oJb53oFhtgQ7kNvwFeeg9J&_nc_oc=AdpU_CoVwISU2VsbTbc5OlkQjF-PNTG0JuKW8z0n4nIbdiZkGsbJkB3txlBq7gfuWCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnpo5CMyJUB9vXSW3RoWxsIALRMacKTMNtZNUDJpYUww&oe=6ACFA367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oC_obqoltcQ7kNvwGsT4ph&_nc_oc=Adpm47mZJGGrKA6s36gZ8_otZYYaIspQLm6bTOTd0LracouAdNVb68i9r9mrlI61_KY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZNpfJCJBpYIXEhxI4nmqlerTsbVgQwRnBdR3qsS--iw&oe=6ACF8818"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XzMdZbw1ioQ7kNvwGWzFO-&_nc_oc=AdpOS7YUwruMkwxYAAAcGiHJXrMUykjHkocUQ9adt2_F1uBW-FYYQ9rTpggssPJ5a6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-o3yGRE08TVOfdrKvWxkkVFWxCk--2JOyh1wSU-0kFA&oe=6ACFA4A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPEOGA1uSaMQ7kNvwFipByl&_nc_oc=AdqhpyFKOakAsMNGBIGA5A9yl0kfOVBrpVjaZYay5gGwlkQKCySyHIr8ckv783_CN74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2tMIybUkeE1vWzHVltT6r7KHjduQaXJfahAZdHAJvig&oe=6ACF9AD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3y7h_yJbZQQ7kNvwFbUT9c&_nc_oc=AdpVjS9T4TZFMMLXaWHDOozCjQ_kAdtRo0cfqT40AoWjmPQSEj_1dHXYgjoYX-O-EeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQJ7ZR6uUPQSQi0atQ2ih14zsS9HwKCXR1vIZX4mrnlg&oe=6ACFA6A6"}, {"file_name": "stair_generator_vr_25
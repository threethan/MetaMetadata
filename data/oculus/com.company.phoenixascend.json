KFNYhOyC6QzA&oe=6A82EB6E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QhxLixe3iAQ7kNvwFKf7od&_nc_oc=Adq0zYdMs-k1Wx-lqzYmIPPPYgYdwrTi4MDLCxg1nhJQjRKyEco8r6zPVZZGOfz1t1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkjQ4R14s1L8yp4VZU071XQ4na2zNCLBsmoXxAu02JMA&oe=6A82F5A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2kqgkf1ftgQ7kNvwENDKGD&_nc_oc=AdqatfmZP4KXUpq8GAWWnKNyhIh8ZC-b9195KQ2MPU3KJyTHOybjbhxIwBOzHBqQ6Bs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTY1aPQq0stXYEvEB_kXsAirnoL77tTuuCGxbYLzh22w&oe=6A82F427"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDH2sPxVt0EQ7kNvwGDuKdv&_nc_oc=AdrfTrADaak_ClAwKxRywKRK6DKxeUxWgnrYsGZv9-lyvJ26gRSptQLbYulKu2jJLLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED0wFRuZhIEh6PDBsOhS-AQ7nH4CiknB8YRRel1D_Omw&oe=6A831118"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuC4S-dUgeIQ7kNvwGRfPBB&_nc_oc=Adrk7Kz5YFc8IaQfbJWWVD7Ag-Sg0UaAhtGfd53RG7Qisxgj89wl6n4k9WXuzOwmbms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwbb9guo1SU0UvK8XyKKWa39F-wWg6mtwP0YhxbRlkvw&oe=6A82F561"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmup64vZ83UQ7kNvwFUOIYW&_nc_oc=Adpc0fdg5srU1jgmosJlB_rFBbHVZD4idnvQ_CcGjJL7iCS89coEWrEot4drJy-bEts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs78e7zs0iUG_I5mJtJznMtrsnwuLbAilSM4kv9-oqzA&oe=6A82EB99"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwcMKdCpV74Q7kNvwHMwdbS&_nc_oc=AdoSbb_XUO-NC2qXYsU9HFCDfEUIZQfJ_iAwiWzTdFs5oqSm3syfuaL4FW9TWNPP_1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-2spQ_xZRIr1TLYRShNWABevVfEFWCGDFhUl0c6ajQ&oe=6A82F766"}, {"file_name": "stair_generator_vr_25
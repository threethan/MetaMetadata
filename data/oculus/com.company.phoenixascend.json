ijtO3E123Udg&oe=6ACCF7AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAYX4brA4yIQ7kNvwGwH_JO&_nc_oc=AdpKAbROmEm99QvO73NO87Vh4eodvwkszT9oK2SozYQLBo2uOXJu0KK4YtNSqDXE5ZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW1xj7rFbF0WkFAz0KCyLLqRF4SlXY3r7QDeqJc6LQFg&oe=6ACD01E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXXC6ESr2vgQ7kNvwGKfcl2&_nc_oc=Adp38nBVAL0P9o8XizHLjcm6O4246MkaZnRlttI5aHhYoHzx_7OBcHWl7v9Xmw7j4xY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObZ6cglOPL66G0qSQoEIcMOZH04UF7vYx1MAQ0HhUOVA&oe=6ACD0067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri_h30Ipz80Q7kNvwFabYg1&_nc_oc=AdojEn_GpJf9znUlrtArs-m0GHXqC1R9vioETehFOsgFcC2ZBT56zQ8yDeieYXn5Jhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPucQa9TphXZRk-WnkE1_TdxwtusxCRJnvuxlxfJgE_pg&oe=6ACCE518"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XzMdZbw1ioQ7kNvwGfXXmI&_nc_oc=AdpAdN-YHI4V54_Xv4CZAKpHwtPVNVWzT5sytKHab-WiAMpsBCy78EJOr5aiS8lvaDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe6ME0DG3_uIj-pWSRWNGPI-6rUSAMrv7gGKmykR0RCw&oe=6ACD01A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGblUP1_cgQQ7kNvwFomedk&_nc_oc=AdroU5uS7ISJFzyZHWE0dtyU22Yej6YZ3dU5Eb43Abu3sYaY9cHTKKeQT8sL9oe-QRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAiwGgALmmqKlZ2V41eq1gc0DEz1X4xTW1q5xv1iRZow&oe=6ACCF7D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3y7h_yJbZQQ7kNvwGDdOFV&_nc_oc=AdqgunBSkTsEqr__dilSEdHfqMRqgm8ngpfrqrPiEBh-fEEVgITSvlvWLHZVUtEoevo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Heo5LwDghwwNuM0nyUKoOqJPw6a5wDcJpoRto071aQ&oe=6ACD03A6"}, {"file_name": "stair_generator_vr_25
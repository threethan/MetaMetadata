Pud0ElFCVn6g&oe=6A6F5D2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwIy01NsUDsQ7kNvwETqDuS&_nc_oc=Adrz3Ldj5u_iwcpw0E7imPUGTEcEXtSgfFKLBseZJRw0B-F5lZPoqLSJkk2MvxYPF_g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXmVbdgVUa52Nc0iwqPU_EpT-ZGtku9W-SCBx8eFmvDg&oe=6A6F2F24"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fpCfzj3XoEQ7kNvwHSbEi4&_nc_oc=Adqq7lPj8dyG7sJDjxZOwHKpv6eiZCxSs1MptUVQzZkqoXDYPda8S3MrAKSt9ThST1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANPTYdPNhk6SC9zqOP-KkS3dojAsc7kJ89aSAB-YlLCQ&oe=6A6F2DA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ32Xr9mk-gQ7kNvwEZqHxy&_nc_oc=AdploJwJ076XJvpk61np19lWIhh9pHNNz2JYekLQYsvdBiC0rF6lwXeH2sOU3eQCyUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvpaiuWqjgx9JdeZKvVoRa6iqVPzYtlJuuiAZCORMjaw&oe=6A6F4A98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AFexgcMtQQQ7kNvwFicPaN&_nc_oc=Adp1Otj9Sbnapoh499OhXwH1QEJ0KkrCLPSSbBFxJZTeffhbNRxHOAy3PEBB2FOQgYg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDknVkb0bIgygvHGy0ZlVkBxj631a9oO4aDCgd-KTIGrA&oe=6A6F2EE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtNjHM3vMIQ7kNvwE8h92n&_nc_oc=Adpjp7-0G7foNnAYIRMX8kRvJm3ICC91g2pa3zwCSvVVOo7cHOjN8zpYZEzJArTi1vk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeyQTWx6hv64dsRXJQvFerT7XZtaXwJY38ML-qp0UUjQ&oe=6A6F5D59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfor9l7PCj4Q7kNvwHlH6M1&_nc_oc=AdrwaUhCZHhaVeCKl5PQTgX-GFrZiE8WnOIs3gusS59BhZ0zNTcGuGC2nw469S-6RlI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyTziptWrIHCiwwdSKT51apqaJAWASvOwDMoeDBzDbPw&oe=6A6F30E6"}, {"file_name": "stair_generator_vr_25
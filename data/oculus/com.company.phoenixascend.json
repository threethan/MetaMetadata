DD-QqClZacYu-JtXupoKx9Yw&oe=6A858E6E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QhxLixe3iAQ7kNvwEu5-Vg&_nc_oc=Adr7C0sM3LIMOW1vf1zupyXinpwJ_us3xHDPRkXPwNMICG6FdOk2MbO8Z4dQ6nrFRAs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYa8tUDN2mQeDAJtFEs0U98_MledsG2FmajpFxAQgHvg&oe=6A8598A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2kqgkf1ftgQ7kNvwEOKsF5&_nc_oc=AdorpYsNIgHzH2N4_sJ9t90oDQbKxkC74EdEEsXoPMGeXVQq4Lo3UloIbWBzjHe9Yks&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCaTaaUIPFOBXSHuMVpsMPX7fgXVh9Hxzpr3nLCKwhjQ&oe=6A859727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmiSXMNgzvUQ7kNvwGpBsHf&_nc_oc=AdqsWZRTKCUG-C6f8BSqUXm523qS0sKTOzO-5PXeOLZhOaYl67D3pentmXwXRpGutRM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPYmAT5q06i1SS5vpXOTdAmz9lib62Ml48w-xwhWSICg&oe=6A857BD8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ANOhB3vHSwQ7kNvwH3DQ4Q&_nc_oc=Adr5uEZNGnEkr7jCyGN3ojP1zUZafkK_2HaeQdu7TpNqUmOzHv1zoelcdRkzgH-hQHA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSI0LW2wMOkQLaCfQdNRfhS7w2nLempoaMf8UQYpg9xQ&oe=6A859861"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifbo_B166WsQ7kNvwGb2Z6z&_nc_oc=AdrOjxwzEJP4RmrcuhVDcIbztyTKeWEK6U5rpepqm1qzxKOg-AZAaq0Uu05rLdbOIcg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVZxiCmwFD780nmDY6jvNbru0wh3H_MvFtTuL_KjvQUQ&oe=6A858E99"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgSWg2X0Ge0Q7kNvwH3YnjZ&_nc_oc=AdruJzRZxLd4kT7pHssV8ONvFkqVeuGUC3tkZc-YZV8U02WNFp-wMfzidtc9Vu3qweY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHumsPJJI8EcmFSCu0Fn6iNP_uZnXRYEwG6_giK3B-a6g&oe=6A859A66"}, {"file_name"
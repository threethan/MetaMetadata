9UnF37z96KRg&oe=6AF8792E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVOEr98jbQkQ7kNvwFcDKjp&_nc_oc=AdrQ_PH7j6q1Y3RHlvI_vHISaNQpkA5vXhDKtxlxsqgV7mXNfFq-jHPFOZYbkvQwDsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVY-OC7kVMgHmH47gfe4PorRJyldHQ2imda3hu6QYRLw&oe=6AF88364"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWF8Z8lugs0Q7kNvwGL891Y&_nc_oc=AdomBXzxCsTK15ditz8inoeTwwjYp2oLtkDYMWAJZdxsnpbLSnLiRt0oKQ2lOykLImk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvcN16U_mZ922QkWZ56-3yt753mwjyAoosxR8Aw5bzow&oe=6AF881E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUvF3AUSIqAQ7kNvwGeKleG&_nc_oc=Adrfl2NtkC6rEDPwwYNkQ84Z_lwDejDPU99Ef92uZgoUnxKnyRRG8H_06ygXx4NJ_7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLVVUV385G13M5Nm_Wai_IW1-tYubxM7gD2gc_YtSiWA&oe=6AF89ED8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAptPyGrxgEQ7kNvwG9-dGK&_nc_oc=AdqgZ88uKTvGztFgmmD5445WzHsM79FTCpnDmWRpvvf6wKj3mjI3mWDuoo5psqCa4dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEsKr9802C6RdtCPTyFBukYQt7xVkbZ7c2FX3ovGuB4w&oe=6AF88321"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCtbS0iirNwQ7kNvwFucoec&_nc_oc=Adp_p6Pn1rVm4DZAuvXLZJnNkUGwdn_W-giRhnUHKbW9A11ALN5EQCPSk1TSffwU_nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbZzMiJ8k6HLlOji48B8OHPqCAjS_TO7ZRNSPSoslaZg&oe=6AF87959"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD2Z0R4ouu8Q7kNvwHQhpiO&_nc_oc=Adqkc1ximJmKuo_uguwIMIem0f75LPC15De9qLYUhB8-F8t-cL2dolvEseixFdNOBLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlVtLJEuuXrFtlI-PEjuL7M7YsIe6J0OTvgTYKsHr7qQ&oe=6AF88526"}, {"file_name": "stair_generator_vr_25
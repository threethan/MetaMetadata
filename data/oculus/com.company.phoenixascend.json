OVsZsUnvee6w&oe=6AD0EC2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-db0tXVJYwQ7kNvwHdmIOo&_nc_oc=AdquucasXhqRHqO3ycfnqXA7i6hyI96SLkH8LaqhgcmE0fAQu-ReHl8VqFKxeGW7LGY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgYeaugzU6D_CtkI0e37ijBgUmS4STXyHIjyzEnJtiUA&oe=6AD0F664"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oJb53oFhtgQ7kNvwEUz1ZD&_nc_oc=AdqesquFOHC1z-0KnbhFX1dKfB5Y9e6O8KUb-FuDY1FGBMHCqG0XT25Z8A9mgbuyZac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6rVxMvnCUs7QwWGePJ5O9b2_FCFuw7KKWGD7pnBsYqw&oe=6AD0F4E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oC_obqoltcQ7kNvwGKeazp&_nc_oc=AdoDHaCmBqNT_KvnmG03ddtzpvyem1wLzGbTX7cevGPIE4XyJJhDfqK6XY6cYW388kA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO39jPsnHUQ5oUBbwQKYRvLvy7mU-nh_IbVzQTO4Gqm2g&oe=6AD0D998"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oze1_v_Z-M8Q7kNvwExEBpW&_nc_oc=Adr-FJqlxqtK2LADWyhv-_Rqz8jZw7ARX0D1dGL9H38yUHspyWWH6KWI11HK9DIZ6Y0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvhmqAjkMBRb_2lj9na_tfICaEeBnHdiwlyLC0evJbtA&oe=6AD0F621"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPEOGA1uSaMQ7kNvwEEj6G-&_nc_oc=Adq-c8AlBfdQZIOUaCtsj7z8o--y4RxyJPG-9KRKNMdIuPbq0CbuBwUTjRvIZm377AE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONVCsAFdh5_c3dfLCraDDvpS4FJ5intYpayke6VSI9Lg&oe=6AD0EC59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-fxQRcOUeAQ7kNvwEJdLhB&_nc_oc=AdqjvK3pxYUuqk2NPH5v5FhdY2cO5-KNutv8GHEOFHSkXotVAhy7EvWUH47IgozTEQQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME6YGMKyZV89v3fgl7TsWpZieQaH0LJjaf0QFfr1mFyg&oe=6AD0F826"}, {"file_name": "stair_generator_vr_25
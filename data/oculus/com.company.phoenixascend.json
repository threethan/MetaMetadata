DP8uuM-LqKwA&oe=6AA2C7AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwuiOfinZkcQ7kNvwGGLI4k&_nc_oc=AdoWUKgzIyR0ifhcDUvctVLR2fv6IacTcTQhsv6hSsdqCJPpmfTGCl2_wDWUMHULQgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Dt3KEPBdD85CJw_ayISNseRnQ7v4p1qkVv2myC567Q&oe=6AA2D1E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju121Nfvh7EQ7kNvwHilnCN&_nc_oc=Adq-l1x-I-8Cwph8PwamijDdsUIlgWMFkg5AVxNBV4nhZGMfYBD7PuDlxQLMd7Kk_sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIaHigrX6LlDewm1V00mSxl-vMmRKm1Nkv31UV2sm8cg&oe=6AA2D067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rknpAyllzJcQ7kNvwEkla4E&_nc_oc=Ado54MyY7ToELjDtr7vBq3g_EX2sYRGUW9LxbrP3yBo7wj1ml_EtCa-JcJGEe7oA3MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUYf5jLm4JHQ-ynfSUQWV6sAJqmhn3rgj5FvjHqo-j5A&oe=6AA2B518"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc2z08-f7bMQ7kNvwGeuRHZ&_nc_oc=AdqExwNh7YtSObhu-xk4jPsjO3-4d1R4xmVcybOViWdNQPUxfK0LKMtbJOfT-OH30GM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-K3z1PmGuPXeCvp2csTKGYRqCMilXbtXXNO26wQRLhg&oe=6AA2D1A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_MH5vsHT3IQ7kNvwH4ovqI&_nc_oc=AdqEaoOv_kTOny0PGvB0XEPfzuRdAUvXp5H03A7U69_Ho6X6oQAgcuBqAxcXkh_uiV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_1jtHL8ImATPCAPhm8f1SHX2skwJ7MIHE--4NV8PuWg&oe=6AA2C7D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18nQ65KcVFEQ7kNvwE1BEzq&_nc_oc=AdrnJxbxKK-smt_fykqCMVuarheTJGWh-o1tHx0OfhUn8FDT3oQYZA_LJxfaAcEbBgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIJ0F7-6-0ZTSsF5AlgbkJWydgqTTZ-F2jvNiAaFG_Rg&oe=6AA29B66"}, {"file_name": "stair_generator_vr_25
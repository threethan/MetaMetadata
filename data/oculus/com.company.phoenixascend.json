t9zeKvSivYdQ&oe=6AE4B2AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20qVP4xTMoQ7kNvwEN6T2z&_nc_oc=Adr02oRBFWkshthFjJfypb9qHZPJaRKvET_gLlHIC6Ex-FYABQjty_9KrJa3fmCdy74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAM44xklvFoy1XobYi-ieo6s_5P0d6xbyyh7e0_v2Tkg&oe=6AE4BCE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMsGRPVVWmUQ7kNvwFUlhVO&_nc_oc=AdrCDXGM6Ig3P0b9sYrv0yxL3h5zo0RBb5qfWGneQEB9U13ZdQdA-431gyyK-ZM9GkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVfeDX4g8UgJO01YVUNgceKtMx6hukZU6zTS16ZiRmog&oe=6AE4BB67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oV-hUngKagQ7kNvwHNOHLZ&_nc_oc=Adp5d1Myr6AZbvLsxjyofirkKJ66NuH31E1J2L5SfjJ0WytlbO0yXPvftYHasbnp-Aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz--wwA5odoCYRfEkNBd0cB6fGER5PDw4KMoA_NYs6lg&oe=6AE4A018"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg_Ut1ZacpYQ7kNvwFbI0Cj&_nc_oc=Adp145G9CKdwN5c58FP35gd6oo2jAGLKCZAtkG-6PISoy7hJlrL8KbKpmeCPP-PzD8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOROvApOUF-Bqy-uvM1jneQyrgu-Kblk9zUPAa7qBvzSA&oe=6AE4BCA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLaurARejY8Q7kNvwEm2f4V&_nc_oc=Ado1_xreEJUztiwoIiub2nhoE_NOEgVE59lY0B-U4dLcl3LjSC8Nhva5RKvxcwuwVJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIOUnYKfHCTcDmJz0VaC7c4RT-5L1ZAv29rB7rli3mhA&oe=6AE4B2D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bckokxO__xwQ7kNvwHub1Ny&_nc_oc=Adr9n0xo_zORHwo6WAxFliVZ6RUxCpTqHvN2CxLHsKrG6uoQakZGjwt2l8yM3xmgVXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT--xUrNhQ2Zgi4DBGl0KDuZGh-nuaSQPB3eZSWwnL9A&oe=6AE4BEA6"}, {"file_name": "stair_generator_vr_25
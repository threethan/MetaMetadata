JNDgipytWSLw&oe=6A8982EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fZrjZAZvvoQ7kNvwFEOGbV&_nc_oc=AdpBnUbrM30HjrH8RIGs8H8I3KUwjCmKe1ITh9Qy7Bz4fr1Q1Fspa5q6gpyP-nAif7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuv86Z3MV1PcWeL0TK5s4--rtJlJU1ZDHlLrhU9PPG9g&oe=6A898D24"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH3NDsBVVHUQ7kNvwFjH39u&_nc_oc=AdpUSHY-M0yZJJfXAYPt5UuMh8sohgHzHld254y_1OFq7ciZl9bC_ugiq7mS78Ewu8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-HxGe5TSgIeWgmnSSbgqrtbgPwmrPJS8wzvlcEc7pPA&oe=6A898BA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48SKvAPLngMQ7kNvwG8PgGn&_nc_oc=AdoVqtxbToUnrAZFGL2wvgwy_uH2iKTPtLsNc6vjXK4_Ci2FUpHm4atq0cWPlEDa5P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiJ1cVIEy6Lh8EpQxj7vDvZBigcVzSK13G_B7Jg05r0A&oe=6A897058"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndkeL4iLNcYQ7kNvwEAnCJd&_nc_oc=AdrLeOvdcPVam1iFgobwNzTfUIKEr-9YI6EWJeHlbKMSgiD-KoBSIQi2WBezw-YObO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtL8wV7v1bfXR8q0tzNL_GbMiAytCdJ5xrOnFK4CEp4Q&oe=6A898CE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu_0KePg700Q7kNvwFsQr9y&_nc_oc=Adp8MlbyKX-sQm2KJ7jEbXdyi81LW1IVQX7N6ia71ASR2eZCCLvuO4OHftiBxvDYP38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiwb_dHv0cj1y1ClaOasvaVhtInMm6TcJCdDOLRmtE6w&oe=6A898319"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ytsJuazzT8Q7kNvwFxZbaz&_nc_oc=AdoMfivLmvqcIMDtvh-AMbXWgr_eBAiBe5Ego5GGSXDJdBlw78iyWxUk97HHhJJH8XA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF39jvZs-aXHcTmzZwriNgTHij2NWB5hhbcfQHY8qSMvg&oe=6A898EE6"}, {"file_name": "stair_generator_vr_25
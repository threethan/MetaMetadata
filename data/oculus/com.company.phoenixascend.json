SL4Q0wnCQ6UQ&oe=6A770DEE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFN6qhzEh88Q7kNvwEIWr_D&_nc_oc=Adq_AIhHDZ0n30VHiJcSvK6-PW8ILQuzZ5S3ZQMcYChWeTmUEO8uajbRm4nRvVV2wfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaXXdmEtPe-fjSiDEHO9f8hquW4dznQPZ7LNAKVNinEQ&oe=6A771824"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9rpptlw__oQ7kNvwFZkMCM&_nc_oc=Ado327heEQWWMshDjPogoCQximSo17yODrVW1NZT9sAEUHoTWktVKsZhdwL7l4fKLCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Hb4jqYxoCqk4rrKvUXWQeIVkE7c197mX0_nfT4LABA&oe=6A7716A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAgqGCZzawsQ7kNvwHEczgH&_nc_oc=AdrKx9I41P9Li-HEaB7qptAz3Of2xoQditkaXPjgPGXG2gfRJrY0YM264Ks_1_0kYwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvXUBq8fUkx0QNhR0gLrAs2_Y7nMILmbtR2azFqwivjg&oe=6A773398"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyaTFbs-ctkQ7kNvwGYfSg1&_nc_oc=AdoSgo4fjQisNYJ83uxebQ7RMgAbFqg0NZTx38-ILHKDrQ4js4NmsJu5TuVmrKuYwUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZRTjanGz_xyW7tfYQAcpBxfEOh271N-guop_IgTBTMg&oe=6A7717E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8PXA73MpOAQ7kNvwF3EAc5&_nc_oc=AdqsbWc67n9io6ZC5Inii8kNpHknxha2Ca3x-SrO42auLgq1Mddcr551Ap4qWnxYTRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqMRWzGDuUhytqNp3oCQmnWh7GUNhJK-RQxlUz9Om7hw&oe=6A770E19"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfNAPc0Iil4Q7kNvwHVP-B2&_nc_oc=Adp_bZiLEXW6GfVLtUpByeO8UYlgiggaZEmQR7z44chW9TEl1cJETWFuTanz5JzaJbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDTQ40DxJ9WgEnE71iA5YtJTEDe-_5sK_xsJinflL1IA&oe=6A7719E6"}, {"file_name": "stair_generator_vr_25
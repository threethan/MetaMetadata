/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF0ier46ZQgQ7kNvwHrqboW&_nc_oc=AdoZswHJDjMumsx6zktzXqq5UH4oEzR35DHHITKZMvMoC4OTfCUFOXfhFXBawXngDZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtW3N78uY6nbRruTYLbv8eFVBgdzQG5npPynwibIa0bw&oe=6A60CA18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stair-generator-vr.tilda.ws/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ph0enix Ascend", "support_website_url": "https://stair-generator-vr.tilda.ws/", "website_url": "https://stair-generator-vr.tilda.ws/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
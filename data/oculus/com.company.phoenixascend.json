JpIRigi7oR4kW3tlBZIFfuig&oe=6A8EC8EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K39PwVeO4EQ7kNvwHPiwDy&_nc_oc=AdpD3f-VA901boFBWT9u8eQyONSvhRYOwfYb5xmUjAhXXxC728wQUM-nZWoiIQ2TW9k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlw0c8p9ELwezMuDJOHWiEiU8_lfqCiVD9Rwlf00MO6A&oe=6A8ED324"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5kp_JDi1oQ7kNvwHzr3yV&_nc_oc=AdoypLjgcU7ptEXtd0no2MhrzRYui3JqY9M0PQDFgGLK_Eq5aVsZfGkfxmaUI7GItAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbTXhEQmRvkLrzTvNRipqM2BrMBa9uOkSIVqKdsu_zpQ&oe=6A8ED1A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS8Xwf7AGnMQ7kNvwEf1j8x&_nc_oc=AdoSI3_YFsR1uG8yR4TcNeBs92FPe1m_Q3a77fjKg3RVXBUgm_u9-Z9FNmrrmOF1deQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECV7wmOO1AxhsizPl0W7Pp49Obf8oGFhi2zjNiEqW48Q&oe=6A8EEE98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBxp3vmu3YQQ7kNvwFqiq8i&_nc_oc=Adq4ln31-ov6TKSXyotWht8MzK8rPPIfeU4IjqIOdkguP1YeR9nYSc6cOAWri1_1s9E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsbCefpOeGjHo2Fz2WLqcIGqZMg-aWzqNHyCKeGhUIvg&oe=6A8ED2E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_9_EyXdGkcQ7kNvwHWyrPx&_nc_oc=AdoSuxFYIhCew6G5EBVHI_vo2pHkcFv0tlRLiFS9zj9Xo3tRjW8S_yGHFaJGExgU818&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbthJi5VQSDv68Ru-dhSIBYwJh2wDIdUUJQWL7RS4SaQ&oe=6A8EC919"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cnz1nuqJf4Q7kNvwEi59Th&_nc_oc=Adrxrdx9emJpOFaTqbCMRqlDyYkwf_L2S-hp6LY3mVMbr60FTGY9IiSBHSTbc5D_tC4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV8EIc4YVJhdrDXJhZCiiERz8spdhoBF6kku8RiOEDzg&oe=6A8ED4E6"}, {"file_name"
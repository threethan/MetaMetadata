vvGSgrDRtXPQ&oe=6AE755AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb_he6i0U0AQ7kNvwHR0iEC&_nc_oc=AdqoJJc6yrWtEqnXE_p424vHWosRflwGu2SDMuaIG_MXvpPcE2pEvLhLFgUOWS588Vs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5EZbPlJKC9JDUqi-nbO5pyECXVRqMuP-u7965yReGiQ&oe=6AE75FE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nSYIsnjlQgQ7kNvwGcGM-D&_nc_oc=AdpoJMZIH2JpYsuaRJbMscCTIIhtaeJkPQblbh5lw2QRAKggTafAZSRN6SwK09tbrCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShF8cpFQ3FY8gX1ZhNyb-yBdSf16pCa3N7QPix7YOnlw&oe=6AE75E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-Me32zD9nwQ7kNvwFm4hyv&_nc_oc=Adr1R-ihmbXY7WQtVhdhN8jeEceXnSPFJfz_iGa6UfMxbKa9UjlihYqRDUc83oeIHXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3fNbwMkwea91Zj6BMw4eCpdjfZim69HbrDRB_tXCI_w&oe=6AE74318"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg_Ut1ZacpYQ7kNvwGTugA2&_nc_oc=AdrvdY58xfq0zDFnOsw14VFL4ipazHAw6Bpi1BmQTsUmKBJF8RJOPOhnLDmiV0KO28E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdSfolO13CAzi2Ip_A0bSD1o1IbNsLF9OCI6V6x-cZOA&oe=6AE75FA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiBtzG_L9dcQ7kNvwFOnX_o&_nc_oc=AdqazVgJRKpe7FTRpU1PF2EG23NoqcbSj7rSneND0RkenhoiEQ0Lb7YAlubWYnHGdMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbFOIuBKLm3ty8IWSvmJ7Blgf-2UCUDQg13hnJJVBOag&oe=6AE755D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bckokxO__xwQ7kNvwFuLHIj&_nc_oc=AdrGVJgUWz13OEfnmPGEwY7xoFR3Yh_Ed5QETnqSCI9v9sita42649z-PvBdb6v2SoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh_Xje5QODCLD5MEiY6xdY-GrmvVwe694fnt8VhafIxw&oe=6AE761A6"}, {"file_name": "stair_generator_vr_25
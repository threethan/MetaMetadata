bFpKD1C61LbQ&oe=6AB299AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frwibVQo1nAQ7kNvwGMBPC7&_nc_oc=AdoonoPefyWyQUD98d3KDMXOzM3I2a2tHKNXmf26MB2slmvU6qe-RFjwAR0uSNZMNAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdYGSPzjjOiT63OTSWObk1FqhsSI4DLmBb39K9_hywlw&oe=6AB2A3E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNRQQlRK_WkQ7kNvwF8Uc3t&_nc_oc=Adp45PsTa9ddkvyS1pJ5woPCYWGClMBmJKLPJpxMrBz21Yppt6p5vPY8l84LYQgwVds&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlctan5xFKask8lnZvx1p7RCvCuh_nSP4k4b-35lNQXg&oe=6AB2A267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIziFnGovwQQ7kNvwEfZu5A&_nc_oc=AdrczLaSMFRXoO8pFp9L2TZ-KlLg8fwK0mr1vH2LyvLH--4K4giO9WOcD0bRU8c0bps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMU-jQQkjh_TPJVr1EtTp7foG9dogKhfzzXT_oxHt3sA&oe=6AB28718"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjLVYRPMzUsQ7kNvwElfc4L&_nc_oc=AdqqjLGP8xA0r4JrJi2RJ2wHImIhhiiT84EX-5I0zXlvQK6h-QFrP7It1dJkBEa_PUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0qytIXZ7oqnFhEJoF6NntwXh295fM_3wYdlnqdnqFAQ&oe=6AB2A3A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHHWcCIy78AQ7kNvwFa4HUU&_nc_oc=Adr4XWeiLEHeGuZFxO1IUbuS2zb31ZcMfjQiHqHkDcaWWl7xQmJ72o5uKILWGKEacTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiqMMoUtR47yo-THvBtKDZT1XMiDBI8jLkfTjMJ4gzBA&oe=6AB299D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UAmU144jegQ7kNvwHnCUN6&_nc_oc=AdqnFGcXd4Psx7Z7qC7CB6lL0Fx2td2FIcHcMR1CIy_qdn_dWR6faRX7IziNiOJLRFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfMmtHH-891bqpciY5cgD-ByY2ooaEOXiVUcSkqDB_fQ&oe=6AB2A5A6"}, {"file_name": "stair_generator_vr_25
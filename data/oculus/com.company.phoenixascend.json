gdZ3umIe666A&oe=6A72002E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwIy01NsUDsQ7kNvwEPOKQq&_nc_oc=Ado8S-yhQ6vGrm8da7KduUjqIfMgtMUWKsy4jdEeg466ZKvG0X6p_5Q6JWkT_X8ri0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgneFXRwJ8Ia2Pjctnn7hy_IOgC0_c8l40cYsnADy4Dg&oe=6A71D224"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fpCfzj3XoEQ7kNvwGZdxX-&_nc_oc=AdopYdpSxoVDDqRp_P3_NBgV4dbFnQ3of6-PoKSa8kEAICBB1nEdymbZJtpyWQIbIiw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPd-lgLa0Pr1rHxp-jz5yz6HClvgZl62_4VWxZVn7jjA&oe=6A71D0A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbRA_Du-ArgQ7kNvwG9H32M&_nc_oc=AdqpNM2F1V2iI-Qr3N_UGpFtDLUVkJKV-LZ56Trbm_mBGoviTgMLPkF-M2Gm-x5IYQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8zkR3_a6R4Mw8_mgzH-ojouNFTZ0AgwaX6OmJ6crpIw&oe=6A71ED98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_-xSqMzUngQ7kNvwF6LWt9&_nc_oc=AdqxtOqlqYdaWjek9bDcO9MjZEdzqiF3lZsDEN77JMoz6nhZDDjTEhFZHwODHqDbrZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNMO1wFh-3DdVjJZxvycEqYbObtJA_kKMpaPCl6a16Ig&oe=6A71D1E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPz4oq0mrNoQ7kNvwF-F86z&_nc_oc=AdpgVX5JrFsJwL04AnRh8GAnAe_Rqvf4IWfHunX0TuwsWId3sFAhJJyDaeb8dMKXzW0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDYSnKIX8xANSgShhh55X5dE5nAnY2VZ30Dq0hsTQdzg&oe=6A720059"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3crDC4a3uNsQ7kNvwHveG05&_nc_oc=AdqaEO58TyK4yaEVFkAyfrWkM61RTKV8aC0o-xcKl31btJDQ7M4GMyhg_yOYqvAUjFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQXf7N4kVN6gb8WGhiTROjmmNZ1aULbInnu5vrLp0VHQ&oe=6A71D3E6"}, {"file_name": "stair_generator_vr_25
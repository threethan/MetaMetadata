R2u6R0bn9uxQ&oe=6AB68E2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV7xErPoWcMQ7kNvwGe-Eyk&_nc_oc=AdpxgUxWb_5Y8rxaTh5jtNOJmVh3hVGNiDFFTauFNAGj9Dol1CBv4xUzsSfm22fkD10&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBgpbLUBHHVvfOeNG7z5nBjUkJC9GrWbsCN1myvTBo3A&oe=6AB69864"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJmOKcgTxSYQ7kNvwEPfuJk&_nc_oc=AdpVbuyGnEmkzq6FKjxUUgME-RoEpwJeDYCZXJhBd2Fo-DpJB-iRiEM12I58vWs2LPo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kZMrhuzzrwQs7D0mXXNzIA9SgYWcd6KnjPs28VGAew&oe=6AB696E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njj8HATCKe8Q7kNvwFHH70d&_nc_oc=AdqyDspsViaDnVu0sjJQPXlo8fAglrf8GjnWeEYdDEMbQFCyvChekXEdF54kU9rFmRE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiGlCrGgkeLxniNIdBstpgqjO7m6JmO9ItmsrC0X7FKg&oe=6AB67B98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKnMpd9zUQQ7kNvwFsEloT&_nc_oc=AdoLEfThN1pvNHetcInoKUQA3fiEUsLkF6ZKLoUYtPp56V_2yGJFehLbWyC2T144Khg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtgc551hhYUceaauS8u3NCXQwBBMvEx20TmxGuU0Umng&oe=6AB69821"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1sZRz4eItMQ7kNvwEkN9vg&_nc_oc=Adol38k1Wk1PTZ31rf4_AVTq7YpQr1fm6yFkQrnVxFCrVDkkXQWtAOUGbTsDwJ8kxgY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaE2kcylqdwxbQdtMoWoCUaFQJa3-7EZLoLCk8PeAodw&oe=6AB68E59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wosBG6AKGUQ7kNvwERuORQ&_nc_oc=Adphx5YJZPEr-y_H9SevzMzQYgLQXQgyIgyYkuhpu8ZTipnbFDwH85kVil2y0WAThQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFqGi3hjBY0Y94tJb6lj68GpX9FaEYGYWblx2vFl0lJA&oe=6AB69A26"}, {"file_name": "stair_generator_vr_25
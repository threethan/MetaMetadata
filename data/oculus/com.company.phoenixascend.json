ItNVGLCgmfyg&oe=6ADE1B2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtlSNDw2MLUQ7kNvwF_JqzS&_nc_oc=AdqqdVgvT_Aca6V0ALizWhffWFuuU5vJ_phXLb6w9o7sG2qIlcMsmC27R8qlGg4fIjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHmro0w9-Dmkrz4h0ZGv0mNIgeLFaBPRbpg41Kh5G_qQ&oe=6ADE2564"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VkeLy9lcsMQ7kNvwFche1X&_nc_oc=AdrJ65-oJtmoWI3LREWFs8fvwQ9fIYzdujzg-V6ekhbu0T83NeqmDKOWCAazANrRbAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHqFnfaFX4mZf1-vjIoDsHFzMkhlPkwyww2pp9RFeClw&oe=6ADE23E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5bycu3VV4kQ7kNvwHpDBHs&_nc_oc=AdqfcHZ7Yva1_MbBO-sPkLEIzoZG7OUX1LxgymYfY1MSBDsuJiekmXq8ifPAvTpRQaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa2jdU0KUxf79DFGTCUQYA7Yxxd506yT1esQFxs3BoNQ&oe=6ADE0898"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLC5UdMaSPIQ7kNvwE8Qy6x&_nc_oc=AdoxpxXakIT6e56gZKiZwC5YiDvC6yUNqs2R8q3dVY1YRucnJ-1KUsZiZlbp-s8jvjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD832g7i5IL9vFFRN3Acfaq9bF1S2fQgWavYK4EkrqWw&oe=6ADE2521"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hnDZH74o0wQ7kNvwH6oN0J&_nc_oc=Adp3eVENiRtePjpOlv3lUMYT3s7is3MPpzSKJq9-UZ1l88aoPTnppsuSTvmFvsZgWDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVOKtT6V_g8tb8zeGwRLRyDl5yE8hf4Dj0K90uvOA1Fg&oe=6ADE1B59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-9daS1hM_sQ7kNvwE1Zlih&_nc_oc=AdohFfp9pbrShMIwiZRxXW42cg1tcyed1Wu7vjH3A8TF0xVNYtAGewNnf7iHkN3q36c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrqPcNFifr8QdpHRATOpXLyUTJ3h7AxPmTpyNBdyiapg&oe=6ADE2726"}, {"file_name": "stair_generator_vr_25
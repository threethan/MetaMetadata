less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drI7Tz5lfLAQ7kNvwH9WoXC&_nc_oc=AdqwLW8lPPEkp0CPjDoIKOGE3yjKae76vC8huS9UcyezGIb2Qj_tQbgzbSBW7zgu19s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRluBVI6cI5gwPWpyFGUDTe6ffZ4WnoDvZY8ttER_dDZw&oe=6AFF10AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxq045T7f8Q7kNvwFSBssf&_nc_oc=AdrMrHBOK0Uq-1H1ewYH1B0I3cVY_L90Lz9XGOVTc8DMeT_k975R4rBl2pTZ2WMVn8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKcViidGHNpUyrZP5-n-kZhv2oUZJSKmhrWY-ggczhlQ&oe=6AFF1AE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOXxDJhB7CoQ7kNvwG9te5_&_nc_oc=Adriq0ToVrbIq8TaT8Gzje4zn09EWJwO-gJdRakQ8Rg8w14Zs0MnjD9iLtnyZ_Kccw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9mkublk1Fni7w2fYYzhkbDzNlXGtFv6YiBneyCwwcMw&oe=6AFF1967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhHmKh7M3cIQ7kNvwFhjjPE&_nc_oc=AdohDtRXFy8zBl-f-yXw7rgfgYRQ9hrPUI_UR5LRBXgZlF5ladaufm9GgMld-wKD39o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQopIDgZPv93rFhjw7uJYNw7UfJypPdieFmO6-7f62uaw&oe=6AFEFE18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkPZcxcaoMYQ7kNvwGmxvLY&_nc_oc=AdpX5xiVH16_rAIuLQ9wQSbGZnRYK0zVRwTCuCxv0s4-qJ1v94aECTGNjIvU-Rz-xEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR12nQWNDmDlCoX8vZ9AWW9wjakNrHzJr3rIQ9jmX-rhA&oe=6AFF1AA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLQSk8IS46YQ7kNvwHj-7_D&_nc_oc=AdoywTjYJ5y3wvCuKG-L9zWMstJEKTfrR5u2stTENXhJXkpJ3SnRp3ZQWf697GfQrLs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHCbGd8ATCUQ42kFFEhVPxRauDQYLvPh92qBxceabUyg&oe=6AFF10D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.57
p62P0j1lMnhg&oe=6A901A6E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K39PwVeO4EQ7kNvwFKSc81&_nc_oc=Adon7-85ZuorRzDYhdazu_L4Vqs9MfdAmaMb-G-5K8or0-aAQiNB8lvi1AmrP0fTQ_Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcZ0XiJV9V25wz0IEu_ZDUE3P1UbLadYxu31sETosTBw&oe=6A9024A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5kp_JDi1oQ7kNvwGuWhHV&_nc_oc=AdpK8mysa2zlvFL6OnAVbFh9VPy6jSrA_2JDuGPP1_dFLq3p7CC4HVEnkMfoP12BLPA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWqjS8QYVMianZI854d0G7jDn6I6YiaA9AUhb7cTA6sA&oe=6A902327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxvAhX3ouKIQ7kNvwF-vcGo&_nc_oc=AdrBunHiLGMf7iAs81z3pzvLuQnY6sij1EbUXGOf515hC5OWuQkkDb5Q0CwKxdYi7Rg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvUxOmZinkhZkOnm26tuS5g3Qtrn366tZvEPZ7EfFU9g&oe=6A904018"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBxp3vmu3YQQ7kNvwGKNWui&_nc_oc=AdoSfFC5BY0sEnIicF2IBFrs3z-jB3fIqqHXN3dV_6pHCJvD9MAibzt-mbwxmwkzOB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH59bvtksjLtdgZNk80xbuBHu5aY_feyetUDf-MoP1gTg&oe=6A902461"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIK055s8xGwQ7kNvwFbpGo5&_nc_oc=AdorAK1dqGVNBT2ETVd3rV5CcoNj4q6txyhHr5WEDQhoYHzPZW_7fH2B52fkFUhjIvc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH009sRXgaXNw8ElvKPTaNcbvCfxkbF_3kcjczMH7q4qQ&oe=6A901A99"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cnz1nuqJf4Q7kNvwGNAfov&_nc_oc=AdpVSBzXXfziiPEdFnt0k1ggdLxkm0EARCB2FD-sfvzdA97HlCqXF7bW0YXSOUf9f8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmb_NL4PYOl4f5vVJEhlcF4oAwOCxgR0g1jG4ozQ7szg&oe=6A902666"}, {"file_name": "stair_generator_vr_25
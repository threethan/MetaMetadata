qjQ6i5CA5Rag&oe=6AC11A2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbIYd3EF5YoQ7kNvwGrymWO&_nc_oc=AdrYgyLjqT8Ksi3yEorCFasbNomnimoYXy6-__kfqOL6kb-dDD_qV1C08yGNEnoHQZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM63aG2cdcEZQ3c-dy0VTca-zfy2v47l1OZ0YgHAT19Hg&oe=6AC12464"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=776lALizsngQ7kNvwH_-_2n&_nc_oc=AdqWE7qZFppA84PTxrOItbttgLRdpxFVN-KsEt5y282jilsCm7aDiWGa3zbsRrfQYs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVDi-b_0sIXMJFn1hpn1nVieXbvA5f6wZLfq9ouRBWlw&oe=6AC122E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meGpoLKPYWAQ7kNvwHn4RIk&_nc_oc=AdrLtjuFjLNBB1A-jLXq0L_cx3GmWANhNmpDwlZIvaCfrwoVYTZAR1HOakgMTOCUPPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgcsWdTCbGDixADsiXiQw2bftJw8v4KOIQgDU-bHFTlA&oe=6AC10798"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vsi6ZqKyV8Q7kNvwHBl8iK&_nc_oc=Adpe6Qy8UR_Xo1GC3TUXBDkL4WkX7gbo01r0YLly6IZr1lI9NAmZzyj414xWF4V3M-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmqXpjkDAEKySNKni2oK9EWv64FqwmZ0qfsnVaOc3KcQ&oe=6AC12421"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTOLmdh5gIEQ7kNvwHfpuTs&_nc_oc=AdoJq0lorNHnG6z4smMEPbWyzaWClrk4tBvO9arCxmWW9LGivTyW18mkdgDCRdtRxcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKr30Awo-JwB1aS-DPICkVlgrX6aYqRWipTKWR9jeXYg&oe=6AC11A59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZngwtovb_oQ7kNvwFR1SrD&_nc_oc=Ado7DKUpliM1dptFfx9Df_GzhyDzQC4XNU6aCfcmSxTC06G42dTX95V_0h70Cg6cdzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmZobT67wehv-P5mpTOESd3X4kHA8OdBrlTz_F767CCA&oe=6AC12626"}, {"file_name": "stair_generator_vr_25
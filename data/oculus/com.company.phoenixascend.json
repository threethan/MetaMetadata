GCyY6j73AJAw&oe=6A95D0EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ysTDVaqguEQ7kNvwHMJpms&_nc_oc=AdpNKTKeP3tDak7Hxbr-AGZyyVXTB3XRqjwYxsAa-_12RwdJa_2eezaeLa0AYY0Oow8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPf-GHXDF9UjovgzSoVR98KfCMHpficbnMOrLQRLEA9w&oe=6A95DB24"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VastHYoYZ6QQ7kNvwHMRB6y&_nc_oc=AdolNIHag5T0HtB16r2H7gjH5YQnD2Fe2KCYruGUw8uqxIyHZ5q32wFv9V9qTNrIWP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0yzY8vGmgAxgRyb67Lji_rBUSlrtUBdLCtzGN41DceQ&oe=6A95D9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0t6K0xXlmwQ7kNvwE9VOwZ&_nc_oc=AdrBizMwdF2OcGkNuers4OW6hBQgWxQkue-jkt9gtppO_5xkVuF8PItryUoZfdBNEu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPiNY7vCuWgg_6G_yBXQ3Ek4_MuSecC1_62RE-UTF9Mw&oe=6A95BE58"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePkryO73NlEQ7kNvwGYyEkQ&_nc_oc=Adpkayc45H1X52JeSeGUEjos18fzIV0Gk7o167InES23eOW1Y5J-H0LhbKgb-LrDcYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRo05BwcmGffyiGjrLqhrKknF9Gv05H2-RY_x2OeqTtA&oe=6A95DAE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBiPP7O48zcQ7kNvwHPvEfo&_nc_oc=AdpsTJ1XgVABC86RWpwhcyREOub0UJ_H7jPB5wJNqU3oZ5WiT3GAs34O3vfScCxalp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7zGC2IfPEMFBNpWQTEupcRP3xtfCOFohk874bSj-VRg&oe=6A95D119"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1DPIMrdjoQ7kNvwHOPSD3&_nc_oc=Adpjlkzz2s7syr_dyU8ROXs1d9RVcqFxDQemLwGK2YbZfwm0vZcaYIpAWtUvhbye2wA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBNPl95O3W7ebEKmoaoKPMaSNsJuEHT0fEMXBmbIr19A&oe=6A95DCE6"}, {"file_name": "stair_generator_vr_25
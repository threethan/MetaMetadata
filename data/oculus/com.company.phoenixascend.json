RhBAiMPbRVcg&oe=6A6A172E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C5_vhniPQ4Q7kNvwFgGueg&_nc_oc=Ado2sFpM6v_yCtOqntfyiUcq_fEOEvWye8k4-vJ22Bp7r0VxaVoJOCpZmnMMLZk-Cow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfHqIQdS9Pgc_qDL2i0ED03SnVMBy0TOAlqFNTg2Mjgw&oe=6A69E924"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72Jw3gDZhDMQ7kNvwE0Ud0t&_nc_oc=Adrffou6DTifikKxgTT15b5FYf4XBN1DDOps6cYjdpm0mLJr4SUgm-Cw5y8rcM0umC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL1CQEMpK4bzPibwDI_tqxvybdoGLvqoS68Z3j1GLrDQ&oe=6A69E7A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwKXr3S3dfEQ7kNvwE1uRi8&_nc_oc=Adq3RWg1TrRVsUmcCNyXm0xSoBykll9riWiHKbrKozOqc0UhOmT-_BzQrX8sk4QHT0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFmhtMn8kuGdityIQbhUIf2HorXYIo3-z5_GEeAKPXEQ&oe=6A6A0498"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVnHzctACrUQ7kNvwHzvEiG&_nc_oc=Adpo1rKcQhMbRzxNucNAxnHoBoqDRU4rWDKZ6jSBitF8OhJ7ItrZyJRpPQuTeDNchVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7kfzYa4vf1_9fCQBAgW0LVs2OSq6KTsvRT6N_pBU14Q&oe=6A69E8E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no9_UkDQDPwQ7kNvwEC7kBc&_nc_oc=AdqUlqkTe-mzBSroU0oqML3gQ0_4jNJCMRCq8Yid0uC85oxgmqj2Q-mPMKDYw958qfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBoVlExBGZKPi4W9v8NCkdazW6KErmRbJb__MJt-fmRQ&oe=6A6A1759"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKMzPHDHjQUQ7kNvwGFt5OD&_nc_oc=Ado1q4RZHjXigRdZrYJZOTY4yDwWPDs-n1cBsTs9uHtyAJaNvbNUDefqwjaSu13iMHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw5DMHYa1CcN7fHTnIFSGYDIrdrwFMF0WyFCz9XnPiLg&oe=6A69EAE6"}, {"file_name": "stair_generator_vr_25
YiTYgKSvLv4A&oe=6A80486E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNu2dvaPKVcQ7kNvwGXk_8S&_nc_oc=AdouAe9JJ5FiniDUvJe-HtGVdO7ShD-GASIeA9SHfoxMcYkycP9tAhjM3mHrq_Cipb0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvcG-TuDBnZ06GOdVan1OGS0-lVZrUYJN7dcOSY2-hBg&oe=6A8052A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s6bEtqj24UQ7kNvwE4jTVE&_nc_oc=Adp70JJbIttNqjVUYid42VN2yg9bTvA53oVDLu_35-a22rX-ZdYoJW1mZWBHktqNeSU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG3vsN6zQEbF6mGO9AZIpXXcvX1UQet8DmjoYv9GfrLA&oe=6A805127"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDH2sPxVt0EQ7kNvwHujc2Y&_nc_oc=AdplPq8Pyy-8G_OK8pWm8ZNmf4D8VpmoQRMaebR4z20Aw8OTU-iiowjzpgvqiQ4-PbU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE07Ldwq0IqzArP20JMivKlSMM9r45oAZdTbQSKyB9fnQ&oe=6A806E18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LmImrcx5jIQ7kNvwEmZ76d&_nc_oc=AdpGDGLDuDS2xaw08oaCxfrISkYcCqbsR3ipM33tAi4o5GDn02e6bvxfcP-izgGWLB0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsXGqccrgqTr39nhjsNXWbzNA7wZRd5fATsdsAf8uj-Q&oe=6A805261"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmup64vZ83UQ7kNvwGQEbzm&_nc_oc=AdpCNbhOIjtOIq_SOQUUpEbHx_jvli7HTkNuzyL6YSwVKdNTcBmUPxetMNzc-hK3GKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEigyws9-1gah7knFz9CFmj9NuQVX9HOL5R93nKz0xMQg&oe=6A804899"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25-ywn_I6fMQ7kNvwEq6m4a&_nc_oc=AdruFgjp4LoAPoGJZAXoNjqv7EXy5n6Qbb0N4G9EGm4ytvgrrO1KwylScmwFl6HrVK8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjHOVbzfE98GwTfMSNFTmXWjRM-Wp_ApZHb7HgYjkcNg&oe=6A805466"}, {"file_name": "stair_generator_vr_25
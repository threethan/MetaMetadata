axEBfG9dnsfA&oe=6AE8A72E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb_he6i0U0AQ7kNvwEuzeN_&_nc_oc=AdrlIlet-WhHqfA6MyBvrhVwSDYKp5ufBzS4ibttJKSSXk0jF3P07hXSVc1UuAYBFw0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGkEb3c46cCX7LxGjW0abzXhfiXsUXqsPYL-mXMjpB5w&oe=6AE8B164"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nSYIsnjlQgQ7kNvwH3cHmo&_nc_oc=Adrm7PWImRWR0InyBZa4_5fGI-cv0SDpVr5XnJzXjjLirn7F7381gHaT7nRvuLSKSns&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBoHhzajqnYm7n83jtxJSdmUXQ9eVYxYheWk91_vNYsg&oe=6AE8AFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-Me32zD9nwQ7kNvwFFrFLs&_nc_oc=AdrCKcrrYHebg3ubW4Bdwszp0iD4Iur2uBR2y_dEI8VKOAGP9e0886398LUFcLFEHJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvYNCayc73dckMAgEC0inZYJFssx1WklMV18LhvxVgdA&oe=6AE89498"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUt3RTNh2QcQ7kNvwHg5mNK&_nc_oc=Adol9M_F5cGI0fXCOZAVCDZOBO1oeNkPgWcQEgJgMvpHV-sBLk-g97AVIUlD-i_oNg0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXuXPo8jKIx22u3aSHMFF1pr_UsgfJpXW5ynRJudVQCg&oe=6AE8B121"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiBtzG_L9dcQ7kNvwEmUoX8&_nc_oc=AdqwCsoll6Yqrt-aRvXiL6G7dtPGcSS5lwUTO2zGqTOQpgXLnUz1vTehTdtWuJmerg0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST1zddnZDticBWhN5tus2oCu4ABaeLD0_ID2VS0z2Wyg&oe=6AE8A759"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWwVGxvvfO0Q7kNvwEQnCl0&_nc_oc=Adrkcjukmt-iR88SP7pqcJ4Ow1ODeZZa1tIA6nJfgnI2eclB_8l4dpBom5hR3Ps7izI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY6iSybQFLhhUz1PPGqRz1VTb83ujJIyeRC_DqBlgBDw&oe=6AE8B326"}, {"file_name": "stair_generator_vr_25
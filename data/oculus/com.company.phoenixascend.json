such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stair-generator-vr.tilda.ws/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ph0enix Ascend", "support_website_url": "https://stair-generator-vr.tilda.ws/", "website_url": "https://stair-generator-vr.tilda.ws/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1222521980940469"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1009248291714420"}]}, "baseline_offer": {"id": "1009248291714420"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784305860, "status": "PUBLISHED", "id": "1009248291714420"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1231891756670158", "version": "1.0.0"}, "id": "4552334024901038", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1222521974273803", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1231891756670158"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4552334024901038"}]}, "change_log": "\"This application is a simple, easy-to-use staircase generator that is accessible to anyone, yet highly effective for construction and home planning. \\nAll you need to do is measure the height and width of the opening where the staircase will go, input those values into the settings, fine-tune the other parameters, and you can preview the staircase instantly. \\nDesigned for professional use, the app features a clean, minimalist style that won't distract you from the task at hand.\"", "created_date": 1783361589, "id": "1231891756670158", "version": "1.0.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
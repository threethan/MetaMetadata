7HUVeQsuFhCw&oe=6AF484AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8aU3GhXE6oQ7kNvwFikZ1K&_nc_oc=AdpfLd_u454ODgAbt1n_KLUAHfIl-25vxM5DXwEUAR3Dfz7EIO2s7nDqavrkp3VikfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-JTU0NL05ofDjMU_wez486FqxIWS9x9eBUEDwh-Moag&oe=6AF48EE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1MQzJ2kmTMQ7kNvwGIoRWG&_nc_oc=AdpIDob5gVHIoYKVvNxNbLJ63fskaF_If_isQbhsKMRlO888OhzGDG74MjxG6HHmOps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThikf_n-8OHXEFAte7vfpY82DOIiKpXEw7vifQ6ThS2w&oe=6AF48D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IUsziC7bE4Q7kNvwF0ypNS&_nc_oc=Adqzl-zc1urIbTwxyPzcTxIY9sA_sViciWB0WmnRZaqZs4DJ365WtBdvoo4Zo5WeiZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrHjRNfDuUZ6ztvp4dSkxb9avsUqtmmUt33d-ttQnv6w&oe=6AF47218"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTp9dnq8kaYQ7kNvwHF746W&_nc_oc=Adrm5u0jhf7cnV5bBq6PwmJBRnlSQC2gthlJU5smEnUj5l7hDCVfwkYHX4uGmpZ8rts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTvdzP4Y1fhBm7E_lZGa4_HymA0qAE6ThG0zEcpSPrMg&oe=6AF48EA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtHRvsYEh2AQ7kNvwFzAKpW&_nc_oc=Adrzb3U0c22t4uzwGB9nljTHxKiFTmShL_MY8fZseWqUi34ckoOiUpbHEFKs-ZhpQy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEIH7xriHaMUsl6SB0EJm1t06i5zkfgatt81klVPoljA&oe=6AF484D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSYqtr3Spm4Q7kNvwGb2LYd&_nc_oc=AdrCUJ9AgR1MPDBMNVflYBJZ9B9re9pqYuXMSzmChNqEQu_geE3ZwUL7GR7_vowr0Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS57RujsylxP21QBwCh8nVlsKLGvOGfw4nNEJfixd0kTQ&oe=6AF490A6"}, {"file_name": "stair_generator_vr_25
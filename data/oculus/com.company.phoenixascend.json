KvrUsLVMnQ-w&oe=6AC3BD2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJy8mCZQVDwQ7kNvwG7qgw9&_nc_oc=AdqprmZvQbc3MYz7jL1T97E6dAZxrVkMTAouz9e7NvUI-uZTgqRmoXbjsVcrom-8cFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSM3Eewk1F36LD9CuPS2kDFg04ZgB4kaXtkg4JQNxgVQ&oe=6AC3C764"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCAjpSgoJA0Q7kNvwE95FCs&_nc_oc=Adp9UGZzGI2RuLQz0LWpMfpKiJsxf0M2y3Yflw1VVuTHM1AG7JX_jv6023VPmwwN0Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW15CtOArODywDwbklbFQl6RP3mSi9PxJWC04bb9GHEw&oe=6AC3C5E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSmmZkMED64Q7kNvwHmQH3d&_nc_oc=AdrMdLNhLx38CoAVPVhgHFRC557v_-VLUoR05inO68R3LYmgICT2Sy5wQYSg4OcAGyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS7ziv0fyf7qGBobVyfDorgc05cvk3cTl3Q5hlGZdN0w&oe=6AC3AA98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vsi6ZqKyV8Q7kNvwFczSy6&_nc_oc=Adpa20aoeF_98omSQb6yPhgECE7iXUxyzXR0cmvChrEtGzr_uFPQAgZdBHXN3J_2uQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhGkQpXbOUIfOqQlgPBTXc9m9dQkMxW21FTDTvhGs8bA&oe=6AC3C721"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H9Ot7Ip0pQQ7kNvwGsd7Mh&_nc_oc=AdpVKbRMerh-2nbEDmY7HgZAftdlMWzqkRy9OvurUKvD_B2vdwPKa91zRvgXIuunZ_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3X-RF4ruMgdHcxdYKlVju8c90VW3lRxuksVAPjMegrg&oe=6AC3BD59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZngwtovb_oQ7kNvwHAZFE3&_nc_oc=Adps-aNjDVo9UyQSp5QFhCECiE9OotI1CK47636Xg-8AN-IpPaxImOApDR2cGlBNIJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIG7bxFmbxEOSDoTYjUijaRoLjqVSOHgBu2ECRDWbd-Q&oe=6AC3C926"}, {"file_name": "stair_generator_vr_25
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZbKXGuUx9QQ7kNvwEzQxwi&_nc_oc=AdrG2j4R73kRcDeEiakKYT0RE77MkJTu52JnOZ40zFq57Q59YaAXy-RimiPIoDxjjvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFcF0-oTAFEWfJdNIa-ZYrTslmINO0hbjc1Sq06xtvvA&oe=6B0456AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkQM0tOmOLUQ7kNvwEjb9aN&_nc_oc=AdrNFhGSpzreMcElBspxyEzEBzHg5voistwRKvoTLnOuZVIJW6mOAoN3dKhCq2AL8sU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDiSOLrT-B0kGRP7iIfe9lrh4wYxCg9I0lnD5mYD7Xsg&oe=6B0460E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOmVwpDQdpAQ7kNvwG_cBUh&_nc_oc=Adp7dGbcIe-xwqTlFS3Qorehne_DntcaenAWP33Em3utEUJlsiebYs2HR5PnaXYSoOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcJyEm-MqoiUHs3UT2v02gwXaoe-Ao4VLEZSxQzXNIVg&oe=6B045F67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKzzf_oi0YQ7kNvwGNgOtO&_nc_oc=AdoOE1YDACsOBqW23sPY5QppPTArvdgUTgs4XabIbloW3_aQfmNTOUgjTptIPtwIuyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF1gaIOxcJGZI12wbKnDOfu9DgvrrkXJRP6LoUwuh9ZA&oe=6B047C58"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfAXXTTTA-MQ7kNvwEQdmpd&_nc_oc=Adp_a-_B4T2G-mxMVtey7_IjippCCiTSt8fArBYUMp-YnGbSaARQDEuxa2Dne4dmT40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiVwovZ7bxaVMnjQfB8_SUKmLPpj6Q_VAJ7jVsC8WGHg&oe=6B0460A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfKHwXSe0M0Q7kNvwH8cjyN&_nc_oc=Adpj_wP2NZz03H7SyFJMPM6sjKqM_KN_KnpcFn8hYuzKn5Rz5NsowvhEcvYbUqH3FgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz59bfxDXaZp5cshZsXS5vzv-bFbMFDFV7o_6nzBg3dA&oe=6B0456D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
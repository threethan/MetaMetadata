XZH8_m-dLcIw&oe=6A9ADEAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTN2OjudQUkQ7kNvwHAMkTt&_nc_oc=AdoU01yt2Lo_O1JqgUlR8HliJL_N6VKdhXgmICE0H3kvwrmtypoX-AfpCrKuNPhiVMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxWAEsF692RO1U8OmHIrO_c4C-YKIwq-xG95sODIXnUg&oe=6A9AE8E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0CeTmRuLywQ7kNvwG3OIF8&_nc_oc=AdrOkYjeZUzrnakuaO5CUTU5BobPu7N9hGx6EHEZCUPwuYGAZ1I6xsD8BOsrHPJubVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4ggq7Gn5ZfuqYDJ8YUe52EGWYHbnuLYV6GaigoUADAQ&oe=6A9AE767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2-q_4MhclsQ7kNvwGFXmF6&_nc_oc=Adrd7P0OC_QJowOOc1efRGfmaxBH4N80nCk2ZE05QzCCQ8WMjOydmSKjPSoE865VTjQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKOIVYQinDwanaTbWf46dK3UqG857nUh--V_FS2nDy3A&oe=6A9ACC18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niq2dD17mIQ7kNvwHtzKP4&_nc_oc=AdqZT1jnsdDi1S9ZSh1hjVs-Lk1Gn8SoSLip-i8sjboqb41_xx5ZKmGlB8kAGzuTASY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH77-5G33tMVQlaV6kIn0E2NF8jSoOcVS0vZofodHwQQ&oe=6A9AE8A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trZyfA6IofUQ7kNvwElCUOq&_nc_oc=AdrH5Wyjo2xsdl4f6bhUbsm6ua4cz-yDq549qr9E6-vexaPY1Ph3mxKiDsbP5KnPOi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdBHI8045eyN9Ktn7i5g8pmkJqeWMIl9ShUgOqiGV1-w&oe=6A9ADED9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqT6Ps4urngQ7kNvwFP9BP0&_nc_oc=AdquywI_t-XBM4BYsbBOmxPbCiAQ2bkWXH4YgTS8P0grv8OCdrpnbGpyr3Q85Sandzc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC161fFE4faOFNYxa1wZQo7tCOqnCo7ksz0Dw3zcZScg&oe=6A9AEAA6"}, {"file_name": "stair_generator_vr_25
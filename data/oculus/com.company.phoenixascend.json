K-INAkuN1MYQ&oe=6AF3332E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8aU3GhXE6oQ7kNvwEYWpqT&_nc_oc=AdrJeTDYx0jCRs7TBP-Qm7rMLbxO6hiqdsUSPXxaKu1xb4fCTR7yDiUxhlNXJB0kWcc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoNwn2EgJTld6r5hpPCQmVJm7HgL14-2yL_ZWUMtgb1g&oe=6AF33D64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1MQzJ2kmTMQ7kNvwEIpqUO&_nc_oc=AdoiHjer5mvUw9FPrZJB58dLonjSk1djbPVBl5r4IPy3U09x2D1RHp9lu2RWwt3E8-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH1aSx9PEL1MiFYcYcscHopTfGFYYAtnZyCMsZ4mMDww&oe=6AF33BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IUsziC7bE4Q7kNvwFtk1nL&_nc_oc=Adq9i26owioSMoQeyforVCUUMXC82XBdPNnwVdyWcrxJQgNPRYwGGOPjhucFI5FG_bY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTUPCjFNPlLxZEWfDs5ybCz5aFRmbnA0fCCInAlVljdQ&oe=6AF358D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mAhgn6MiysQ7kNvwGZtDgz&_nc_oc=AdquX6Xqnki8gLEPimcJovo83u7ApbZ2g3hZulO_RKyM7npdoYAQsoAzjc5V0g0us64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQslwaQKAqJ-PR4W8H-c0jX956fUMvecWVwcSykWhqRNw&oe=6AF33D21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtHRvsYEh2AQ7kNvwHJRUxR&_nc_oc=AdqhaYyCqiR4ZCLpqDZtKGUOGqbJ36xImbeAuoSxEx9CUNarG-zpghNu16FtzqvcQ5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdxNRf9FMXUFwQiB_IH7VFSMaNVJhPTy4Q4hSmQkB9_A&oe=6AF33359"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgO5gaWRy8oQ7kNvwH-gwqG&_nc_oc=AdqAWRjdXjjCVmQdn3yI8SWTfwIxs7WyaamVJKnGroxwzpQm5nkjxemO8_SKWDqzhHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyjGQltOKNqmh_jwvvYQAZFfz3zkNMlPcuW8uNLq3_ag&oe=6AF33F26"}, {"file_name": "stair_generator_vr_25
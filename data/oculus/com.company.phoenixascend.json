k55OFDIKvdsQ&oe=6A79B0EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFN6qhzEh88Q7kNvwHq_8Ll&_nc_oc=Ado_JO96f-WH4BI2lWNLH0tj0ckn83GYWRPx22GqtdIGVo-tSx1XUrpbeK54JM2bs_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFef7FfJK7dOHCeB_a_Ms-vicfeE7tdT_qUTV62mOboZQ&oe=6A79BB24"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9rpptlw__oQ7kNvwGav26c&_nc_oc=AdpOjiznTigSANtoYfrWHT4HYTcB_TFXOSpKvfSkXfdcyjHye67h62LoJR4yTkj1iZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-K4I-D-1inrThl2frxfPxaPhk5_C9HTyCzQhQigr5gg&oe=6A79B9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKYgPuaY228Q7kNvwGf00SG&_nc_oc=AdqnkOw4nvR8yYnGTKeer1imMJwCf8jH8MWYDYU3OMsht900SO9Ll_zfrK8nTx_bKXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUcazJ2cJmsMdtWV5PzRhxM4SempGkCSoA8FEIzwUwyg&oe=6A79D698"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqCbYmssgVQQ7kNvwHq0Mmg&_nc_oc=AdpaUD1g0rcGY58hUOeT9BwySGOEn2u0PGZpzc9vLZYfuIOf1lmWaQDEePJD6cQ67wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcAm_2dve_nOT0O8unXRIRvsJF3aPonkGa8s3qz_Tq3Q&oe=6A79BAE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_gfmtpO1AYQ7kNvwHVUV5y&_nc_oc=AdpOUeZAo3MF1GLSd3et2UB2e38nzTexjUfuTaesVOCmiRZouR1qSXsaF4TREHIr1aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8CIOcyi_J6-po4H2ZKSiceoCX8pVCghuDL8T-idgkqQ&oe=6A79B119"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv1eBruxFtkQ7kNvwH0GQU4&_nc_oc=Adp73XClvjhamEphYkPyPpqPZYdnfcJB3PXNSwJNjcs3qmMj6jKvocWkflPEfV0vQsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu-ONDiJScofNzHN8FkictSEEPnsIhjS4LsbdmU_0h5g&oe=6A79BCE6"}, {"file_name": "stair_generator_vr_25
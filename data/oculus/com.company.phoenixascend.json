less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7I5L8NkzX8Q7kNvwGMGFdE&_nc_oc=Adq5KNV9ErOTtkDaXFzGoAwsufTl5FSsV9Mn6E2jOOXxZZI_l90NUQOw7M7Kxadg-xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQFR_CYyqTvW3_HaFrGH0CB7W4rbrMW4Iw7NBxv1OV_A&oe=6B0C77EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0tje5obG2MQ7kNvwEzkSuv&_nc_oc=Ado7QwC8Ph1-oB4xXB5JBZtNcIR1He7VJaBIQ80n6zqpc91j5qTI0YFiRooD5TSJ2pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGnDw8HhPwhDmLjD4Ccq-8ShmNN6OxDcv0MgFxt511VA&oe=6B0C8224"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnoqfVRhDGkQ7kNvwH4Zb1m&_nc_oc=AdoVYhYd0ZnQ7n4h6ttWdgRlk5AdgTGACpxqYG_2dxncw7NTNKzYH-eI4bN6pf8B2rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmr6P4ZduIv3-AXWTYz_i9GJ8WgerduYK18qh2YnZW7w&oe=6B0C80A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzkAOdTSzTkQ7kNvwFQsluF&_nc_oc=Adop0JKNOdHJ9SUqcTa9VszBMsvt-cc5q0KxIYO95MONlLbPeCDz2kt1BMIkXkJw8ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRm5sjog4F_RBCEh2iwbh6bAgKeoLL0jbKb6PLef1ky2w&oe=6B0C6558"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXXXMyQJTMQQ7kNvwHFcqKn&_nc_oc=AdomodNejIGyohyANwgpMdnz0fWC2Q-DTYie-QW3QKbWzY9-wO1Ov0u91pQsV9T9eac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAMfYTBcnbKErYpPQzC8ZdHTJ6-hd4LX1v-TAZchvA3Q&oe=6B0C81E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iPUczciRbgQ7kNvwGP3dFl&_nc_oc=Adr7eB8jzYsPYE546xZ1b9Hd9kMWDaWafj2k0KGhkcIt48l0BZfJ7jjEh7OzvXhWUcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSZc1X9aRRdAyhZrZknJW6eQfWdWcmolxHQWrU_609Gw&oe=6B0C7819"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
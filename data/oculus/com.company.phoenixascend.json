gj-ghcUdfHow&oe=6AE0BE2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtlSNDw2MLUQ7kNvwFjIwnZ&_nc_oc=AdrFsmOTFfhey1uscdlNmADrYmIqSw2FeUNmgQVbtx_b7KTmi9u2N6PtRM1z7Go38kE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO41_Qt2XEhATA7A6BdEwUi-Va_HlV5rW9DaIt3ceiS-A&oe=6AE0C864"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VkeLy9lcsMQ7kNvwHxKQdj&_nc_oc=AdrilmArkIwYVTXUQaeYnBg_Sg7x2PdIQvaaam3UxlVGYsAbc1SomsdNzijL3tucJG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHL8w4glroKblBqtOq4svQvHn7u8g_iyINGoHmyYzClA&oe=6AE0C6E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRET2sgcZuoQ7kNvwEw6tAP&_nc_oc=AdrtE4g_CTvT9IoDkWygmFaqWeQzV1nCfp8JTyzMShB2tGGr51Cdc5F7zK6twy2z9qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD6kInIfAGMI52UapEDRAjJzSotBJQDXTXWcvJP_yMsQ&oe=6AE0AB98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBLBWtuUtfAQ7kNvwGOSxUP&_nc_oc=Adq8iO5xdJ9yNdj4J4g022suYPS2_5_ojpRLyc65_RHfInLmNJrWcDZtMbhil-wGJlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGrKX0ttPTHoq0c_z8U2IutGJYPREGSxq_NF1MSj13pA&oe=6AE0C821"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq5WZXuwevsQ7kNvwGbe0f_&_nc_oc=AdrlQLzz0TisswLltd-cpsXruBIu-rmN-L3q4EtJZFv4XLnKGlWf5iw8_jqMwvQHSS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHf2b27Reu2e1w7oAdaLEwBPx3CVSyH0FrdEFgDax2Lg&oe=6AE0BE59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DC-IUZ5SLgQ7kNvwEhYn_z&_nc_oc=AdqXa8CpjVN64WFQomA10ldpW8P1-sJHte6Q_SO_wxcgK_TRx2MDgtfB7R2p9R8EZac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGEH0IXdbuY3OTbiq746xBq9bhHIAGfPXfOqAWW_UEBA&oe=6AE0CA26"}, {"file_name": "stair_generator_vr_25
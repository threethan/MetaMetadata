ZcvfLaWKP2Nw&oe=6A998D2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ABpelK0qZwQ7kNvwHi6-HD&_nc_oc=AdriuAEZEFiLvOoNuDefVEqS5C7JhniUZkjudDATYJ5qJl-n7_ymhAvJjwpS0lgF7ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkoX72onZly5aT8xhmO33S83lDP1qtbTLIxQvhxV4eDw&oe=6A999764"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxwK07dIfoQQ7kNvwEJjYhf&_nc_oc=AdrjWx8wmMT1WEmod3Yc-f7QSAnSsywTe9Z31dZYt-JAKe6ajVmkI0c3SSLuEv2XPFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQDn7P14zMRY6xFTtJIHqjHesH4K5Cr53rnZ0OeXW_QQ&oe=6A9995E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2-q_4MhclsQ7kNvwGOTdD3&_nc_oc=AdoE4-_ohwx2Ke7_h26hOYlXmKlp3v-tviuFwpmYgJhPyKKzuzUX5JcxSJN_I1sHhzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVn1nkfcYetdbulyH92Uz4zbjonGQTMLoTWwzuZIf6wg&oe=6A997A98"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niq2dD17mIQ7kNvwGwyV5e&_nc_oc=Adrg3MLwaOo_SxX5qzUfz7AxZ0AxqsQGTG1bf5hocLJaGjMDB2t51jJTpUb5ZLB1vAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqQoC47sYyzXlhXUjMAFX2MCnkufegH-VcOZ7F0lBqCw&oe=6A999721"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trZyfA6IofUQ7kNvwFOiDAv&_nc_oc=AdrOQ_Qjz_BGGCNEJpOSBR9W3EOUmbx3uirJsOwvy2b3GXSHZhYokKlrk8McvuGdyqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX69QodQiBz6sx5foEVUCQGDTE0R_-vQAzcxqsXjvtXQ&oe=6A998D59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqT6Ps4urngQ7kNvwFDrwGa&_nc_oc=Adpzkz8bBPOOd_6-xdxLjjHdM-4Z7zmYYZhsd12DK06r89uE8EyflLw6N7JQmjgCP0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRPptf_9YB1BjgmBo9BFno037yGQw9v-2PBtzL1pyALg&oe=6A999926"}, {"file_name": "stair_generator_vr_25
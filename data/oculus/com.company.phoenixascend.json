-ac1rJ2DrQCA&oe=6AE6042E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb_he6i0U0AQ7kNvwFiJEzb&_nc_oc=AdpiZqhlVo3UGUhnVdRUURGayjI7JGWXJe_gttTHyKhCogbFCfq2BTORl5wXz0kxl10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs-GaAa7pRBLVEjpOJf4dbgU_V35TBAsB8xe-TgdZiHw&oe=6AE60E64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nSYIsnjlQgQ7kNvwH2d4D_&_nc_oc=AdpaJ3QHnsKP9TuVLfnYsG6ovO4u-DX2s-cmcFw-wxlGhoRulwZpP32MShVROQK39Y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIMxfq7BzKHYztDzP_IYR2J0jhR_fBuodH2JfkZOhVrw&oe=6AE60CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oV-hUngKagQ7kNvwHrfG2m&_nc_oc=AdqKo31C4_4DcJ2x7aJI-QNzqy13bF1z-rzZ4UvE_ekDdbjg6K0H9yL5-02x2YQHMHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlYD9QEL8P9mItJweoetASO_VYgVjg2D-Ygmjz0nvgsA&oe=6AE5F198"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg_Ut1ZacpYQ7kNvwHgxcH3&_nc_oc=AdoL9i1Hnfbg_Y_n1QE7kcZ9xoauep47VfTfWPycOSYPMFBX_AeFvSvLBF-gwuExuJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf40x0Lhnj6kIY-nQzCZXVKpFRMHmkySkjX8LpwiDn2w&oe=6AE60E21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLaurARejY8Q7kNvwGH0vzz&_nc_oc=AdpIsiDxyObbgIofe7NQw2jtt8CPxAU4aZVU9SrEWLhZWV1z8Y2_gkX4rt3u4rvoYCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc_pz5P5TiVmDN7XQLP9olR04K35OYkVtMMIe1gdlY9Q&oe=6AE60459"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bckokxO__xwQ7kNvwFdyutn&_nc_oc=AdoLW1mUHLweK-TwMGiwROjyVXmsQb1z4-iJCo3MIlRvaOfVNR15G2msBs0pSTtDr_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7IJ3VWfW_m-emJJcynMnHBlqy2sFp8FQdX3SfwNWMoA&oe=6AE61026"}, {"file_name": "stair_generator_vr_25
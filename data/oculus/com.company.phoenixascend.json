E2W02qo8FISQ&oe=6A8C25EE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKaYa0fhBEUQ7kNvwEQ_33T&_nc_oc=AdqnzwW8O7Qgmj6wuSQMFsuxf8v_iQiJ2o1GnPd-OJeOAKX25t0uHDFek9q8CyqoN4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Vp0-XHvHncKdKJKwhPR98vr5EgHLaDM91T_22lAaBg&oe=6A8C3024"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h034g5LaTnMQ7kNvwHEuCU5&_nc_oc=AdrWHZNUHH6qNSN-mElGOscDoVEmSElE0rNXgPR_niJ8MDczuqsbbA4D5e8F6RPwI_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNdaPPH01d5-12NLLg72C85Rh1YZHpUV24jMN-af9GAA&oe=6A8C2EA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS8Xwf7AGnMQ7kNvwGBS6MV&_nc_oc=AdoppYcOujYrvyV5zTKz7H7sfRhG5fajIbU-Bh5scd1Zc54PNIuqji47H3Qft4coMMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgAs8XMjN1pijWzZM2wl5m650lxsaC1067ACqSWF90JQ&oe=6A8C1358"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndkeL4iLNcYQ7kNvwGQgZ21&_nc_oc=AdpvRkttHMusaTjMstDbbgq-fbT7TUOtj9Y8jwSk38Orlte_pwPCJZu3PoXX2V8CeoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFXQQKD4IXPaF-eezSQPOlk_6zbG0ZtU01Vi2_2Jpghw&oe=6A8C2FE1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_9_EyXdGkcQ7kNvwHMy57v&_nc_oc=AdoNUmuBB9dpDFPU1xPgedX5jcmKxyp3B01mXOJF_7ENLVxKeNS8Lomtp36fl4qJUt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSbhvqlUIc2xOks1qZSM7bS78_m2vGGst5rfEu1BIcuw&oe=6A8C2619"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ytsJuazzT8Q7kNvwHcgG19&_nc_oc=AdoR-q46JTd-IawHNMjSqLqc9Zk5rHP5X2ZP4iN0s2T4hEO53nAvvMYMKMMvMTChW8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGcXB85a6hBsJsj4yu8HI4kTefqPJJXWsb2dqkzCdk0A&oe=6A8C31E6"}, {"file_name": "stair_generator_vr_25
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FC7M6eSQTEQ7kNvwHUWUw0&_nc_oc=Adr3pezXoOk1I6ZhKBJCG8X6O-rWnl7kqwVH7eTst7SpdHwOdDTMltMU4OGc_C5X5PQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ__yaauxmL8iz5jMHWzgb_c7pmE4YVfDHyiPfFTLDrpw&oe=6B06F9AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gojMM40pupcQ7kNvwGVuGEW&_nc_oc=AdrtA0l1mBJogHKxtQIZMKWetLkT2usoSqWcpIbjtlYHWKQaVGk15f3T6vDVug39pdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhbtiVVdVf-ARzrNZSiaI-etNpBV0eAcg41kAs0xZ1Sg&oe=6B0703E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WIlRD5GfkIQ7kNvwGUF1Ym&_nc_oc=Adp-MlBFIoTBkVmrYOyGP50SBPENzBRrI2Xnd4Vd2Jem9nMUAhDu4x-4cSpHK-y8D1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVHVjqZ1HUguI0Q8zPGPsNMI7tTzupzGN6_mq_j4Rchg&oe=6B070267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCnKXyY4j-YQ7kNvwF4kcNv&_nc_oc=AdrlHFlIlMj0Nli-cZpcWTqD1VnIv1e-5_-keVXCghC4Ba-OTzxHU-_ffchrzadXxS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-KJYCNi2YQPymR7ht9P-9MmgrSxFLL5merFSHhE5A_g&oe=6B071F58"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfAXXTTTA-MQ7kNvwGfvluN&_nc_oc=AdqdgGMBo8b8X3Yjx8-wPsSfc-f5Im5Uj5VglziJGspebxJthBL50bDLTqDNDpDcmBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYFejzwe5MlZuqSm8ItBFoYqlOfS6ZSL1_YGwJrdYI7Q&oe=6B0703A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdvtdnDQdFoQ7kNvwE0zBjt&_nc_oc=Adrb8duFK2JXWKerhQASsTKPB0mEkEFY42qXH82lEj5hcQPSqWlau04ohJoKsC6Z1Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCeUoT3Pf4T9ld0HsmkIvt0WaWs4dCMR_2y4CkOcpK9A&oe=6B06F9D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
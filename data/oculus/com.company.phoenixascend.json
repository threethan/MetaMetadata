B_38IOH-5M1Q&oe=6AB1482E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U55JWZzgOmgQ7kNvwEdc9l7&_nc_oc=Adorljq30KLvXD73yPT02E-AmW96HHedn6cNH4z3IBbOdDV-ojXA9H7_0ceINuueJdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2txWjkasluaBenE011tnxnXF3VMZesIEdDus2BnDKAA&oe=6AB15264"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsPfg1iSAnQQ7kNvwGJYXZm&_nc_oc=Ado_QmfXKrOSR8RbTj9DSpavwXEkpv1PtOBsPXdPgpMDZkuvYkMRZMbvy5EzUdWBRi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Eh8ef417aFWXTwcLkK2csXn0ybj8h3Ut55gM2bs3yA&oe=6AB150E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIziFnGovwQQ7kNvwH87Ayx&_nc_oc=AdoSbBcQuI6D7WPXsK_586d3LT3CBR6SDoZK_AAyY7gN-CbMB47pyhwipXKS2yMSkvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-iceum8t8KsZzCA4JaCFzqcTH2zpWJU8ZqpFEPHVn-g&oe=6AB13598"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjLVYRPMzUsQ7kNvwH_Bcxg&_nc_oc=Adqgrub7uvRdf0XCfkcy_dgMJgaEFsadf7a2MuytkDsiQ4nOpjtgUUZdh8Qwe70fpGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfWRpNzbWQcNtGoznPavW743QFjnnhXfeTJvhUSv3pGw&oe=6AB15221"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHHWcCIy78AQ7kNvwF1l0AB&_nc_oc=AdpwQ1NKxY3ANrULY5kp3h9sJNMRMzs8oKhSXavTY7yEQAdZtNdLcAj9K1LyxZ8zhLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbpPq1vmdDaIKnVIP_deDw6Qm6srQn50AezjyM1Xm6wg&oe=6AB14859"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UAmU144jegQ7kNvwGaPg3e&_nc_oc=Adrh6TZBIH3j9YimOfS-dxlwGrStx_G-SVDNWYVcEsESUjU-V9MTxjz4dHp7OKooIFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH0mvObq3K8LDWCyHpp--7E0JmlMU5Yqsls1atVSghPA&oe=6AB15426"}, {"file_name": "stair_generator_vr_25
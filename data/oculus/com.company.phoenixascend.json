YFF0x3Xrsceg&oe=6AC9032E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYTcwA3fSdcQ7kNvwGE18dW&_nc_oc=AdpK9N41eLdCpn1bWSoQMw5EA4838ecmIwe5RsFFklH8Ky5nZGAI-GAd5HOTxbvMm5s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP5Ov76DEabsVBwz8QoC6N39-cT3e8Xv8HOi5Ug-9_YQ&oe=6AC90D64"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TobhMIkDEiYQ7kNvwGWJXH1&_nc_oc=Adp0a8FpCc36MOVZLImA8kDC7HUo0NJErT5JB40ZwfGl3OP30Kfs1XcwmxH4D5nhiWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPALUfw116i-lpxuA1OzHc0xMy4bT1cdL7cyBDtjdyjsw&oe=6AC90BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2unw48yPlU4Q7kNvwHmvlBV&_nc_oc=Adrc6miOadVZvKOPq1PzuyFFy0XKpkiitE-ZBBI-DuHFJLTf34smEC1cdl6c-7aKA2g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlP9WV3iiMppuG1ngybbMrrHwWZ2wo6tbponUE318WuA&oe=6AC8F098"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g-MoczPvqoQ7kNvwHEVNkL&_nc_oc=AdpKN94sZ2Rw3PYzyzXdlkuSc07ss75qmO5Bv3_1xqd6sbHHymMbPYpL4lJJo-CkhSI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKuOQQ1VcpvuxdPyveFGidBZrEen9rXdNtGHoT1M-8Eg&oe=6AC90D21"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCBIIlLqXsYQ7kNvwGBEUB5&_nc_oc=AdplKooaZH1TRh8RgWMW7TQ_GUH9uAeuzOowBhmHdJwVvUmOTEgsFibdok5x48E0O5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqDPlkynwe5elBCP2DOpG3hQu4hVQowVTkNrm4HlwThA&oe=6AC90359"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfs2P4caJMMQ7kNvwG9QC48&_nc_oc=AdrrWC3t-IIPmYgzXQP5rff9V51a5fhi4nL6sS4HnQ7N_ufW975q5q-v0Mo9W2fW2Ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7AzzTZRVw_0Mb4nNl0holI1yYlxhDzw-ccvtRCyMYpA&oe=6AC90F26"}, {"file_name": "stair_generator_vr_25
Qgkrpf3vvGnQ&oe=6A74A32E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDSe_ThGZn8Q7kNvwGV2T3z&_nc_oc=AdqNAZmnu1DIht2eO0LtFb19odvzn7fHrsHHlT2U3-XVJQfK-pU1knLewFLLyn9dBo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrCXakvfeLFBQyx65REY1w0__ReioZ0A4jfGcpdYC3sA&oe=6A747524"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3cl71X8RVsQ7kNvwFN5C8o&_nc_oc=Adr57mmtoyfRAlyZP5KjHUv1jd1wnCqyRsJjlUr9YkCSpx222pPuJwiy2yMIUCD3b2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPHsm8cGx2J6ET_d9wvlp7RUotptLAREu75gFdUhkdWg&oe=6A7473A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAgqGCZzawsQ7kNvwFZRebR&_nc_oc=AdoM4MO7WKOSAuIG58CLXLgAyqYdvE5LP4vh31fIueiEOtAnMb3Mi5S_46SrqftDIMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTeSGi1EsvVkE4HMrpFqRIYA2j-F3QDmAlxCZkGmMHfw&oe=6A749098"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_-xSqMzUngQ7kNvwGgxcKc&_nc_oc=AdpBQtTk1HOWIU5L1uTavyBoSUyVwSY_-JGtLsT6c2FTHypSs-jrJ2DXvBwXia3L0Bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ9fJrDFL79b9Eo2a0DE2RKH-RoWpTTESc4Ovqncp_aw&oe=6A7474E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8PXA73MpOAQ7kNvwFbzBnh&_nc_oc=Adq731ZrHuB7AATbZOEBMRKVYJVjCy6RC0VveZ4ChHNNos3R9HrnQDU_8sdx3dg8DiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF9jsFOADxd7XB9r17bkEOWS0jwjxLhehSFu6hfOyMfQ&oe=6A74A359"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3crDC4a3uNsQ7kNvwHaPzVd&_nc_oc=AdqRAfFg8WThxj2Z6A-DAJaTnye_jZX23jvG3KkL24gDDdMX1pPkcE9opdMd8NHRy74&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4oEglLAksHWZBrEJyUfXNC6n7YxGRr0tdGO8PP4wHgw&oe=6A7476E6"}, {"file_name": "stair_generator_vr_25
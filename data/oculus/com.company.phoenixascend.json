less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Zf5mgup8MQ7kNvwG9IoUr&_nc_oc=AdpLN4b3xPzVxf3Z1IRmkbhfPtsHQtH9eFb6erGhLYsJ_cKHmvdGVNHmRrNPZk-jsmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbIp7b39FxU08pL4gRQ9A0jrgJOK0FH-u0_bc1PExWiQ&oe=6B0F1AEE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZJV_ztcMaQQ7kNvwG5uZ2g&_nc_oc=Adp0ii8s0GrXxY2zVs22tXa1IpnEsOJep1nOvolhWUr6SWcqP68M4C1zXfUoroTOeys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJUjOz5wREEpggTSWPq9smpUxo9axkJC0P27euD8ei1w&oe=6B0EECE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1VaH8ZaLVQQ7kNvwHRARkH&_nc_oc=AdoiAM6XyQdlLOyLPoLk648-xFJ43pzuyN7Kx3dVldOoxHdMXfHsKDNkBg2SlztMNuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUN-tyY1GM4kpjfXnsMbs0NFEo7VbFMxZRkPgMtaUk0KQ&oe=6B0EEB67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKsT55tzSQMQ7kNvwGtMAfY&_nc_oc=AdoAbkNpUyq5YrVLtBO5BLid9jiyVMoR7z0IBdgdsf-u4mNwvSMJciGs09nBZyLCUqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhVczk-WfgpfvL6NJw4NQdIN5Gh2YEM4vo-3TvosYaoA&oe=6B0F0858"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXXXMyQJTMQQ7kNvwFo5ZSj&_nc_oc=AdqzkB7NIOhV48ibGMWOL7uuIr20rg2jyW9_f5OWWdcTWFdmH30ZVub8sfjXWJyZusU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUn931m-BUKGATc3g9RtUJuaP9eI872tsmmvnIwJ1CvMg&oe=6B0EECA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtsMbS-SfQQ7kNvwFJU6ih&_nc_oc=AdqzN2XU-8DeVbBRdUfeROFmRLoTGMZinZAqI3vAlQRH-jnlDzG3FDMcfbN_Uz9axXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX20Lz9Sr7DnfIl6SyMA-gQ8vWi8vnLXr9a-NGGnFaKTw&oe=6B0F1B19"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
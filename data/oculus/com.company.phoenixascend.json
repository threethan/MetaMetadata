QPv9GPL9r3LA&oe=6AB53CAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frwibVQo1nAQ7kNvwFyHhtZ&_nc_oc=AdqJE4xEhB__84Q_5XYfDoC_p_Cya2WTPg12V6pDJkZSD9y1renDak2FQLT5dKY4lmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqt_4l0YsA4a8PySvIwMV4we6f-52J-L6G_y7hXfreAQ&oe=6AB546E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNRQQlRK_WkQ7kNvwHGB7pl&_nc_oc=AdoIkfIKMZbgeZsSJe2WaJH02z9_rb3pD8LeFhsyGO_xDWdZiaDQuJxLtdG6naaFvB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFsnvtnD8xmdnYf1Ies4nxboDnjWNFqrwj8n1HitTErg&oe=6AB54567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njj8HATCKe8Q7kNvwG1nyaa&_nc_oc=AdqHwmcBTf6pTWJfwri2HM3ms6fE2TDAl0ditFba4E5WN7rz0Pkf0WM3QnZsUf319z8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID_idyF2dEtmy6TY8rfdS5dIwOX-b0Jtq8tYzPbbSmcg&oe=6AB52A18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKnMpd9zUQQ7kNvwFWGTfA&_nc_oc=Adrggojdc1Vek4WNz6-T0Kw5Dko_7n194MG5qb-uPybKlTnK1SBFQr2YPNttHxt0FgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeV0VgLJMcRIbFOt-ZXd26ZyR2u9AxaLbvNOcayIvEaw&oe=6AB546A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1sZRz4eItMQ7kNvwEQIWjl&_nc_oc=Adqw2sBBN75QJcbe-AXyr-PVvamhX0_mjwKO8ztW5QKgxMjCCt6mPLm9UTkQahDgXLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8nKUSI1ZSNGypN-cowiXgOfxNGpqw_5SBn1llqbU3Jg&oe=6AB53CD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wosBG6AKGUQ7kNvwEZSy39&_nc_oc=Adpd1g8TImyHwLOdbZu28NQdyqPPpiNEVjcujf1tnEmIR70q11-S-Q1tPgAOyS7mD0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvSHoHZNHQF_Mwu5nYIUb8ZMuu2igRQ6DqsNv7e_jfpA&oe=6AB548A6"}, {"file_name": "stair_generator_vr_25
7fq6h059BJnA&oe=6A6DD36E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJVfUltksbsQ7kNvwF_kiEM&_nc_oc=AdqyhunZ-EOxIyByxprAJIciA8iU17LiiMqJYcJ9yqp8tgqSbe5W82ZCgb_tsil0Pbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTkxha0P0iNKm04hMdc_caYWeu7yw2ic8of5bCFq6wjg&oe=6A6DDDA4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inzDOrBV-xEQ7kNvwElZXOz&_nc_oc=Adq3lvuz-BdqfErx5Ux5FS8YnQsHa_QwFLQY1fJ1iYTa2eXjmnBLVB6av_49xXf6ntI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0rSVlp5SVZ_YZStLHlks9bwW8kHkIWjIj9rAzbKmJZw&oe=6A6DDC27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ32Xr9mk-gQ7kNvwHPppER&_nc_oc=AdqZstZo6uuXa3bj78qykpLpYuRuwZuUmCJNNtUsdZoh6NrYbU-ZX9SwWgLXdBo6f-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQRrmjszzuX8AhpHi5RJSBPX8IkDElDRoqtgd3Qc-c2w&oe=6A6DF918"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AFexgcMtQQQ7kNvwHuF8lw&_nc_oc=AdrXewQgP-cqSf1MNZF_hc18afm1b3qEnVaFFHSAYTJuNuTwPEgzkfqTU36BYKGPW6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBdKTkaSW_MPTsrRzacTJYrNmaZMtXo_-rkuMvVqmZBg&oe=6A6DDD61"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtNjHM3vMIQ7kNvwFs8ifp&_nc_oc=Ador_UxqYxPPZsdOaPzpZmM2YV2_i7ROMbDw23rXn6erD2eHca9gI-YsGZOiPVZbnsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2u3Dl6j1Rw6Myrtn5c0CQeYf-jnJZQbqCkl7aB3aftA&oe=6A6DD399"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfor9l7PCj4Q7kNvwG4-Smj&_nc_oc=AdrrEYVM92vJhsqCbpXOb-KdZKh2Dah49UGPtAvToaBZ2iHLSc5RWjYnc1403RuWPeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_sq2uVDzAV8I33LNkkcLjd-ey205yufBtmfus3IfKrw&oe=6A6DDF66"}, {"file_name": "stair_generator_vr_25
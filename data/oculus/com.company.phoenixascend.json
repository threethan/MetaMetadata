6aIOUYpfTaDw&oe=6AC7B1AE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYTcwA3fSdcQ7kNvwG65X0_&_nc_oc=AdqETSb5a4zNtJkGnbtOM5vqXLkcjqe9ySzUuLDOlEWlcPJm5h81WIuYLVU5phJcegs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFw8LIqmjyxSE0uyuIanbcjLR3GIea_-lWABxFAkOcg&oe=6AC7BBE4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TobhMIkDEiYQ7kNvwH-W2nB&_nc_oc=AdqsGnM-aT-HwENClZyIxxIFPIB0I6sY472X--4yN6QRzmqrP2dxvuiwAIMb-1wvSJ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaUfn5qEGLdfAf3Qbgqwflyj5Cm-ib_Bht0lTtbwmMkw&oe=6AC7BA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2unw48yPlU4Q7kNvwEQtVkG&_nc_oc=AdpEd07_1uDV9nef-HOv7wVqjDJGLUUs1FJO4S6zQFW_-AECyMfNlkXHGKacVDVenV8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-1x39P3X5UTNAiuIFWQ19NuZraJeWQNYxUnKAt_DAQA&oe=6AC79F18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6XOy3kcJ-wQ7kNvwFlzmdw&_nc_oc=AdpuuDDVGheOJoQRUPzJPCDy7G9LAqDBstzl9o7xCYyFJISULrfcIsBEU-n-nFVMxZo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnSRqyLIOCcebjpxkU_tGWXt_9ZjHKQrbn9fMngypMEQ&oe=6AC7BBA1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCBIIlLqXsYQ7kNvwF9utY4&_nc_oc=AdoATUx-qF5jY9q3kzxQi5ZpmQJdb4Or9JKO_p3HeKvMGT3BFFYmFOcsjvMyc9DOFZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMALsOo61dw9b90uVJKeZdqyoCU6Nxom0bpah3Y-gLkOA&oe=6AC7B1D9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iGnMoLJu7gQ7kNvwGODltT&_nc_oc=Adr4TPiJx5P7bX85Wf7zY_Rk3Z9sCQMGDEqBLSwgYmmeP74sk61XYcXAH711GKvBnVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSZ3sBOCf_yTgHnhqifKwgDMVT4OT0pbVY5GcBvAxZrQ&oe=6AC7BDA6"}, {"file_name": "stair_generator_vr_25
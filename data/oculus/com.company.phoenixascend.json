less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FC7M6eSQTEQ7kNvwEi063p&_nc_oc=Ado0_D18bSlYl6SOrEYNB93L_oX9hQv3-ClfC0oQWQFuJZ-OW-FRWzaLrEgie-D7-Mg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmEtZrOwke7OTrRa75aw9gfZs2FfyuZtGu3K3fPBGK-A&oe=6B084B2E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gojMM40pupcQ7kNvwE548nA&_nc_oc=AdrvS_H6HQxq7wji6CTwp-xqJs-gY-mVIlMTr_g-QbebYyJBpG33xiRzF-4Dxdaa8NI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDD33SqgWxrcUge0qQ7nLvrwPDukcxD1VXwDHx5QBGRQ&oe=6B085564"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WIlRD5GfkIQ7kNvwFAy8Fn&_nc_oc=AdrWsJEzeWmM57TzHISUANQA8VR3zVS5mTHM8C9cfoyH82N3LspMn08Bd0TKTn7-eko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROmLG4emd4jalMwda1x7PYTYiUVIabsYr9YtRDNK9f7A&oe=6B0853E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCnKXyY4j-YQ7kNvwEn_Is2&_nc_oc=AdoIN8BJJUj2wGEFCAolpV9-5gMPCCIL2MUDvkgGglGxhLrWZvRWJ8xinMs7kdAa3x8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Q__xntyUuoGpLLzzsbjD-z6l8hhexBF6XQezoNOqqQ&oe=6B0870D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG6QQXyE3ugQ7kNvwEOAAkS&_nc_oc=AdqeMt_M-YFHWiJ6Km4iGJI3oMz6kq7hYgezAsQcX1zFvnL2vYSWOzAGyK_k0XtV-dE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNinXRkRc48U9sMLwf55x98EhrDvkplwIzoiU2utdQgA&oe=6B085521"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdvtdnDQdFoQ7kNvwGbOuE9&_nc_oc=AdoMWnznei1zpv9xe3DnkblTION98U50-q796kX2pmwfjzdMBzWsNkCdZEjt4ewMHmY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCpTYlwXSyTquyKVRxF9q4dyDUJo4aYrpl57XwBqHbGA&oe=6B084B59"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.57
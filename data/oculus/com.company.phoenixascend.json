cdr0D_y6X_uw&oe=6AE20FAE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20qVP4xTMoQ7kNvwFl9kZE&_nc_oc=AdoKiyqvZH7so4dlk0uB-u3ni7eA8ru_cWCc_5rI6svkrP4wWoKpXkrFO_6S67eOaig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn49eiqwyYMVfGhz0zRLHoQ1XTNRAgctt6MCobHtgyVw&oe=6AE219E4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMsGRPVVWmUQ7kNvwF7YXEa&_nc_oc=Adolgl_2ZispHbgmRO4L5Xkjj5KjXMcx3LEywV2pv6ZtFdXuzW_vaAluhVf7vf-2eRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRqNxBgP9Ochrxl2AVG-w38sXhpDHYdS_nDdSHtxnIfw&oe=6AE21867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRET2sgcZuoQ7kNvwH2MWMq&_nc_oc=AdpXePh41vrhU87QdSy7_DoA-0M0qoJacRqOrpkDcJKE8aBk2zZB_2Hj9yvwCVAhkB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy5T0WT38rgLmKbGg_i3anrvQmzVcr0T8a02_AP7SjKg&oe=6AE1FD18"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBLBWtuUtfAQ7kNvwGsr-Hw&_nc_oc=Adp8SI_Cpzo-rBhBvHQ1TQ4t6X6uNhw783tqABdCEbDF5ZK70LHkkRy02rqP3-DK4qs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaXJIg9Il3nAuilPg0j55qXUemCJMRHQHAiBNQ-b7dng&oe=6AE219A1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq5WZXuwevsQ7kNvwFZJ1yM&_nc_oc=AdqS9UPdssaFPnNkpPoZ3a8DyL93Us2jlQ58vX6qtmBeiL9BEPhbeYf_npLsZX0DecY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQX8KWkxsFKc7GF2cqWU86vRfcQ7Msi-Op6cWAoAQYlA&oe=6AE20FD9"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DC-IUZ5SLgQ7kNvwHqjoXZ&_nc_oc=Adojjzhlzq018V77MKiJ7PdGCbRBBBw3br3WLjK1kRzpBbiGLYunskCH2slfEOy0dFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpu42uReK8IMALJ1kjOcNBeg7336EWBwp4_E4ZthDlFA&oe=6AE21BA6"}, {"file_name": "stair_generator_vr_25
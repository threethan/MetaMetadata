less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7I5L8NkzX8Q7kNvwGyQnY3&_nc_oc=AdqUTfEpCJM8U4K6lk2bZXlrNgy-BsovlGSOK3sfHh47YI8Qn0CBpNRzQFo7Zt67urg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCaz-IJ5XgrEKOMHeYdZnnW8BsHG5oSiurYjkhb8dHEw&oe=6B0B266E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0tje5obG2MQ7kNvwEJXUEB&_nc_oc=Adovl6YhiCU7Az_pQOTfabUXN1hGJeBOlqNM_87JKWheln5OR_fWeFtHyCtF_jYvBTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS780uE0sr5hvNtu-c2Mm-xg9jcSBFMCkzi-cGuKSfPyA&oe=6B0B30A4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnoqfVRhDGkQ7kNvwHveZgb&_nc_oc=AdqZt_kULYJuFCghl16b-BD-_kGaVsTk_4k7Cn9Xk3zYYz_K22pYHDGGh21df0nkBXg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDlunpV8yvlVymDLR1u-tqmigB_fd_vuokziMMY-Dyvw&oe=6B0B2F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzkAOdTSzTkQ7kNvwGXDDjw&_nc_oc=Adon5j-szsdwldf0eOK5v-c_RagOfoQh7wcPS-exNmsb2e7umfW0ymvNwORB_sGVfCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoFatwvnmeVj2Xm6lmkubCE2LdD2ZQxErZJI73thp28A&oe=6B0B13D8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG6QQXyE3ugQ7kNvwFAeI4U&_nc_oc=Ado1t9R15vTMo8QG6xbpiagkrkjd-SwPSVzkEhjnb7hXYwgeEaP0K091ifpc62OSQbw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB3N1_tIM_P4X22Bg2dsBkbdORJ6CLbuUvngA8H6gdwg&oe=6B0B3061"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iPUczciRbgQ7kNvwGCZ1eZ&_nc_oc=Adq1_MMzeu09SlERY_wSmr1HodKl-JNlSEK_esJd6lfjo-hn6tsXOEvT-EE9fEybhps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1bEvoLA0QRvjTnuFjZnREthPSPd1M5au-K68sqkACTw&oe=6B0B2699"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.57
yJSjc3Awrbyg&oe=6A843CEE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QhxLixe3iAQ7kNvwHdMWaw&_nc_oc=Adr3zNlH06hNpizdRsV871MRP5qffef8d0MRias8GgDggxg1d9LstSDdFBUmaaYIHLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgsCOblkAJ1_WDUMUB69zNJw7UaXR6NsXTfRQcVP4xYg&oe=6A844724"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2kqgkf1ftgQ7kNvwEgB-Yg&_nc_oc=AdrYD5aRspkDWANiujSnrIRbpgT4bHzc97CYYaSkwr60RqnyDsTMwp4xfllxNB54Vsc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8zUbZUtCSgZHOTckwAiIgmIWaAMxiM9yl-g2oMgaYYw&oe=6A8445A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmiSXMNgzvUQ7kNvwGkqhcs&_nc_oc=Adr7WcSOfS8bC1MOSsOMP88SgW6BJHIQfIAE_KSFaDNgp4WAFqZ9FGxp8_50G5yYHso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe0XeNOgOtRBqERRztbn75N5ypJTqYW2E_od2zZrlAag&oe=6A846298"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuC4S-dUgeIQ7kNvwEt1qbc&_nc_oc=Adq-9jbUtWee_dvVwdk-C8KU6u3Umse5EMUELiLjaDYwY2K4gduCwd5mxCjnR9JaRgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAEJvdxn1le3dHjQQwlzTPKSo35xo3Wx1odq37gP-r5w&oe=6A8446E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifbo_B166WsQ7kNvwGbWXiA&_nc_oc=Adq8NAqnmxqfy7FoECLmbdJlE4HLbrG55NWkPe4kBh02hZ8EHhVYewdpxxg-3Xgvj5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPsE44dcj4QnpWo0VzEe6whDjVgl5Fx-LaRbgMm3y3_Q&oe=6A843D19"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwcMKdCpV74Q7kNvwEkIFRz&_nc_oc=AdqWusBfdX8gaLjieaXHsgoKZt-xcbqEWkd0XSz6j9t0FDMd54bLNcy5M3myq6exWp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwMCSNF5Or7owiJ1VlKP_fufral8SskA4KTQzaQ6f4Hg&oe=6A8448E6"}, {"file_name": "stair_generator_vr_25
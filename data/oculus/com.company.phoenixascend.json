hn1uiRKzTPeA&oe=6A7B026E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czReCVJw3IcQ7kNvwHYxMrt&_nc_oc=AdpA-OL1dnNlFm0rWd_PwEKsQqtjLqWKpbS-F4AGGjzbMIR5Er7X6RGp9QJMKtKRU1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKJu2vscRjFQFKOVc3oKQyzI7Ja6t_MX_GrfNY_4Ysmg&oe=6A7B0CA4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVTt3qixH8kQ7kNvwG7oir7&_nc_oc=AdpMHJacd0GECCA3NMPza72UDQnN5b8OZMGiPPZZkmffajxiMRjuzEM2psH6GuJSWTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq08VQhV9istTkKCFZMau8h7cvz7awarg93H5lcnwE-Q&oe=6A7B0B27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKYgPuaY228Q7kNvwHZCeW9&_nc_oc=Adq7Nsw6l5qdHEF3q_dyTMspQGt_MibQIhjO6D5PAVa4P2UfmgzO8tXHVSzAfwOEBT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD7OUQ-iNYOxs-9DCw9kURo3er3Mkgi0JvAiY4BkMeAQ&oe=6A7B2818"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqCbYmssgVQQ7kNvwFnYT7A&_nc_oc=AdryVlh8Mg0JEG4y-XjyUL9elOVtsYZUi0DjOIUs9XvmgJOnFKhkpVV8idzWcTGCFoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhoRgbbZq3uPF_78umYbf8j-YxvvoqbBNpdf79ldZpFw&oe=6A7B0C61"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_gfmtpO1AYQ7kNvwH-MS0u&_nc_oc=AdpzRETJBbCJ0e-veHY1qeSKFNHNlHKuHa6C9IBD6vwUIaFWqYPK-La9N3ftBWKyYP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiBrkPB83hBpwb2gHe6R9CXfl8lW2ZBavdvHY5RQUw_g&oe=6A7B0299"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv1eBruxFtkQ7kNvwH39swf&_nc_oc=AdreelNsTbQNFaOi1SBUwAgXtdTaObBIrYWGgU2Fp8E3kV9c8vTQtBdrMg9KAh3xPQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbM35pTBICU79dlWVMgLtRoXjynee9SwR70azXBkayVA&oe=6A7B0E66"}, {"file_name": "stair_generator_vr_25
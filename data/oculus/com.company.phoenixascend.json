svaUigU7dFVA&oe=6A940EEE"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ysTDVaqguEQ7kNvwFZzE5P&_nc_oc=AdpEGaOnu5AgRk_h6MqKckh0BlEUwmz34sZJMRKn1ktFEY3-WLRAq9x2zmQqkTR0HQs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7P-acXxs_S0s0u61kODf8SU9LPOyvNKRaD8K-DgH8bA&oe=6A941924"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VastHYoYZ6QQ7kNvwFWqWTn&_nc_oc=AdqVn-xY_YNDKE48AmWq-4kPaM_pSjGznMfzaS6w-GhCZJ2jH-qxxJdxQGFSNtjQ7RM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt-JJU_pIClWG9qB0b9dL1gOoixSFErSS8y-y0iGzIPQ&oe=6A9417A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0t6K0xXlmwQ7kNvwE3sut0&_nc_oc=Adq7HQ2rgdVFCcVrfbDyti2EfU8QI9kX_VUwES7DljLHounBRZNZqt1boLgEPJco10A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoVrFNMtaanLN_8iU7RgF94G5upCR6RkDSKqqoQubLOg&oe=6A93FC58"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgL1STa00fsQ7kNvwGXVL68&_nc_oc=AdpZtBpWEhx-WgY0DcrygcxzY0mIqrwuZKmnZ9Sd89YveT1HvTwbGL-hNm5waTeaeCs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnjynPrAnniQyrmh1zOyfnl0CKJAuSJPYG3pl9K9W8Zw&oe=6A9418E1"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBiPP7O48zcQ7kNvwHdTAFC&_nc_oc=AdoD5IGJs-NsuuUc2RWC1zVnNPY5o6ae_jq1rb_aRpeP8zEsdSqqkf8yLZYyEr2DVbs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXDL9i5Yb4zafQA3vYtC0AazOQjtSyiCzzBkT975UcNQ&oe=6A940F19"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GZGEVvgP8wQ7kNvwGQytFM&_nc_oc=Adq5QbYEkwveN0_1ADZtTFqA9_PMfT-vNoK-_5iaiLlS16A31gLB2MlfTRk9UhBVaBs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIBzDEc0q3e6g3eRIf7hvOW55_dNL5clhyk3AaZb6X7A&oe=6A941AE6"}, {"file_name": "stair_generator_vr_25
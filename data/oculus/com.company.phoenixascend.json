w4y1RtzPupJw&oe=6A88316E"}, {"file_name": "photo_5091760635552402527_y_2560x1440.png", "id": "2076197376616272", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619672_2076197379949605_1087349814318764390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fZrjZAZvvoQ7kNvwE025Xe&_nc_oc=AdoTkA_lb-Kha_5L8uqAxWyMf4iY-x0gTdoouCTRxW37R4qZzoS2eIQzyEFDzmpuHE8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgtWmHDZwKoS-QmmL6dW2WWjV4GMMP1o9YHU-2hztm-w&oe=6A883BA4"}, {"file_name": "photo_5091760635552402525_y_2560x1440.png", "id": "28519828204285370", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622285_28519828214285369_1088319508019192050_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH3NDsBVVHUQ7kNvwEJ3BgJ&_nc_oc=AdqrGEMSM9KzjD54PTkwUS72ccplcGrLAMp9EMHSdyy-9R_Gk1RrsmXaKohJLHR2IvA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE34x9hvncf27jvNfgx4AYoROxEQ8Cc7NkQJoW4t0O_zQ&oe=6A883A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stair_generator_vr_2560x1440_title_only.png", "id": "885596524620728", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619672_885596527954061_6868997211986433191_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48SKvAPLngMQ7kNvwGG0fzt&_nc_oc=Ado5nTqkLxnVtw9vw7lhsWW1kNK2PRTF38YESLUhn87xK_8fwJqMvLQkmhD9vwaB9Ic&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOvBlMhipOLHLF98Fes6VqseaxTY8Qr-DUNDulBBxVow&oe=6A881ED8"}, "display_name": "Stair Generator VR", "keywords": ["generator", "stair", "construction", "ladder"], "long_description": "Using the app is simple: just measure the width and height of the opening where you want to place the staircase, and enter those dimensions into the application. Then specify other parameters\u2014such as step width, tread depth, and staircase type (the default is a standard straight angled flight, but two additional styles are available)\u2014along with other fine\u2011tuning options in the dedicated settings panel. Tap the generate button, and the staircase will appear in mixed reality right before your eyes. Grab it and hold it against the wall to see how it fits into your space. Not happy with the result? No problem\u2014you can tweak any setting and regenerate a new version at any time.", "short_description": "This app is a simple and convenient mixed-reality staircase generator that can help with home planning and construction."}, {"images": {"nodes": [{"file_name": "stair_generator_vr_3000x900_title_only.png", "id": "2592513977885429", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619808_2592513981218762_4968721126324708930_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ANOhB3vHSwQ7kNvwHsM-5a&_nc_oc=AdpM-Iy60_coEejj9yETKLFC6ySs0KTxZNteXbrYgHf3tF_pmYqSQNnMbBwT1n81RkI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg2DU_1HOafrB_I47xllv0GJ-70DLVDXJCTLqYLnw_Hg&oe=6A883B61"}, {"file_name": "stair_vr_app_icon_512x512.png", "id": "2149252839266448", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619808_2149252842599781_4754249076677587729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu_0KePg700Q7kNvwH5_OzX&_nc_oc=Adq8di34KM4sr4YVb98PgnuVlCZ2NijKB_qXaTqj6_2TYEeVhK7lzN7ZygekMiAfodw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjuDbnRA3XONvrb9XduDhllDEKd1rUC7GYg_X9gYwFjQ&oe=6A883199"}, {"file_name": "stair_generator_vr_1440x1440_title_only.png", "id": "1694386571863177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499623314_1694386575196510_7075524280348811805_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgSWg2X0Ge0Q7kNvwEOeDMg&_nc_oc=Ado2RZGbXwAG2WgVUS9HuXJ1ag4BXPK6ojZj-GFZAoALXFvkt3pdhTMTaLCIWH3Gz9o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqzTnJej4KVeiwd-HK6M6xfNkgaXwc9mjKEVUChCIoeA&oe=6A883D66"}, {"file_name": "stair_generator_vr_25
0_Af1YCMw7COUVyYI7xYcPTn-Y5ORY0XHj32Gm7U1Xs8eTQQ&oe=69D26D8D"}, {"file_name": "castus-2560-1440.png", "id": "1717440331750351", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_1717440335083684_5376050658441774585_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LstGDmcy230Q7kNvwHrlNzR&_nc_oc=AdqR5QyB0qzL4mxxwDlmJcHnSSRWyM5AjK9kjXkR37TJfui3uyvnW1NURxtDasH7kKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZS617sOlT0KSiWFrDOslQoTqCTImKu_w7wiUUG_hE6g&oe=69D248EA"}, {"file_name": "Screenshot-Migrated-2019.08.02-14.53.14-0.png", "id": "2437942039833480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_2437942043166813_181131347501598417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7CWAUaNlewQ7kNvwHnYRhH&_nc_oc=AdqrzRt6kzW4NJaWbwSnVHCDhLCY3JQvPPuWeuXCdQzwrHXnPvD-TYprc64IeigS110&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04CWEALCABlu1S16CyXshnB71LQv8qGyLppE98h57LGQ&oe=69D24FEB"}, {"file_name": "cat-2560-1440.png", "id": "3497004610375554", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_3497004613708887_7371022396966060147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpk61tg_eYgQ7kNvwFgSX_P&_nc_oc=AdqTuKC_nXI_QVrkEscRWXUCmv9gHOJxAf4PuaWjca5dog0YDAvGJDWJoAx_2pYTwHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_qNS59KVHaVtIO_8lWVaSQ2Fk1Nwh67st-q-sqSXmTQ&oe=69D27235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "137980498083530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974831_137980501416863_2883196694555030565_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVlrw45b_qkQ7kNvwH1LX4-&_nc_oc=Adr4bTvn3VWgAjmQWwJFGT9HZ9mfjK4XJibpXJgBYQ4_0DqO4cayEFl4AwPAu2aDTts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qc3MY_110Dnlo0lOQtAnUm8jkO1brJQQIxZtHaf0gxg&oe=69D24E55"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "craft", "explore"], "long_description": "Create sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun.\n\nDiscover thousands of amazing creations in the interactive gallery then remix them however you want! When you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made.\n \nUnleash your creativity by building with SculptrVR\u2019s intuitive and fun creation tools. Then destroy it all with rockets!\n \nAdd mind-boggling detail with SculptrVR's voxel tech and 10,000X zoom.\n\nExport everything you\u2019ve made to FBX or OBJ  for 3D printing or sharing online!\n\nProcedurally generate landscapes, then delve underground, but be careful not to delve too deep!\n\nThere\u2019s a million ways to have fun in SculptrVR and in your world, anything is possible.\n\n---\nFor tips, tutorial videos and support visit https://www.sculptrvr.com/.\n", "short_description": "Now supported on Meta Quest 3 Headsets with updated graphics!\n\nCreate sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun!\n\nSculptrVR makes it easy to create, explore, and share incredible sculptures with friends. SculptrVR's 10,000x zoom enables massive creations with tiny details. With SculptrVR\u2019s intuitive and powerful tools, you can make anything!"}]}, "developer_name": "SculptrVR, Inc.", "developer_privacy_policy_url": "https://www.greensky.games/privacy-policy-greensky", "developer_terms_of_service_url": null, "publisher_name": "SculptrVR, Inc.", "support_website_url": null, "website_url": "https://www.greensky.games/sculptrvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
hc=asHuPIkLFBgQ7kNvwHm-i8f&_nc_oc=AdrXbbcl0GhqA8IJCaTC7r_AaiUOtp0o3EUzCKYyZ6xIEn6Dq9DzNs_sBKOGEod8-d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLIt2IXk9HQUV8VR5qvtY8IeOz9IiK7Aq6w7PQBPRx8w&oe=6B05AEAA"}, {"file_name": "Screenshot-Migrated-2019.08.02-14.53.14-0.png", "id": "2437942039833480", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_2437942043166813_181131347501598417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU8memZDfqsQ7kNvwFoO_BO&_nc_oc=AdrljV-kjpoBELe2TQssIObAyW7-qJnbTHSCUmcAQs9PiCk2G2m4yNDSITcjTgBdRUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLwJLQMu2azy_lXOjlDGQ1jXQI6nh922o4T6IQRqDGiA&oe=6B05B5AB"}, {"file_name": "cat-2560-1440.png", "id": "3497004610375554", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031381_3497004613708887_7371022396966060147_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5j3I4e9NEMQ7kNvwEF7brs&_nc_oc=AdrfVM-F0Cvp5N43Aum4jd_kHcs-s5mYvfG-9We33m8jld5mWMLta-H1BBoAuYKnYj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5oVpRH9bwO-X8XWTkTdPw9mlI3MZx-W5aKm1-mALOwA&oe=6B05D7F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "137980498083530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974831_137980501416863_2883196694555030565_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIO-WKsgqoUQ7kNvwGuN7Wp&_nc_oc=AdrdLMMkJuvX-lBuZhAdgnKoqxeMTdYQ8QnEJaYUeywaluTmfdQX2Y4aim9Z582OWRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSodkVMalrSVouNIUMb2S07kttu7P01SGyVoXTzsulPjw&oe=6B05B415"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "craft", "explore"], "long_description": "Create sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun.\n\nDiscover thousands of amazing creations in the interactive gallery then remix them however you want! When you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made.\n \nUnleash your creativity by building with SculptrVR\u2019s intuitive and fun creation tools. Then destroy it all with rockets!\n \nAdd mind-boggling detail with SculptrVR's voxel tech and 10,000X zoom.\n\nExport everything you\u2019ve made to FBX or OBJ  for 3D printing or sharing online!\n\nProcedurally generate landscapes, then delve underground, but be careful not to delve too deep!\n\nThere\u2019s a million ways to have fun in SculptrVR and in your world, anything is possible.\n\n---\nFor tips, tutorial videos and support visit https://www.sculptrvr.com/.\n", "short_description": "Now supported on Meta Quest 3 Headsets with updated graphics!\n\nCreate sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun!\n\nSculptrVR makes it easy to create, explore, and share incredible sculptures with friends. SculptrVR's 10,000x zoom enables massive creations with tiny details. With SculptrVR\u2019s intuitive and powerful tools, you can make anything!"}]}, "developer_name": "Greensky Games", "developer_privacy_policy_url": "https://www.greensky.games/privacy-policy-greensky", "developer_terms_of_service_url": null, "publisher_name": "Greensky Games", "support_website_url": null, "website_url": "https://www.greensky.games/sculptrvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_conne
nc_ss=7f20f&oh=00_AQTMDXd5ryUOar4Ngt3Kd8NPZlVHkXivquJ_n1OJLgwNMQ&oe=6B05D685"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "build", "flying"], "long_description": "Create smooth, polygonal, and cubey sculptures and worlds of any size. SculptrVR's 10,000x zoom enables massive creations with tiny details! SculptrVR gives you almost unlimited space so your imagination is totally free!\n\nSculptrVR\u2019s intuitive and fun tools let your imagination turn into real creations.\n\nGet a better view of your sculpted landscapes by Hang gliding through them.\n\nJoin an online game with 4 friends (cross platform with Go and Rift!) to build massive monuments together or have a sculpt-off!\n\nWhen you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made. You can also browse the gallery with hundreds of creations!\n\nCreations made in SculptrVR can be exported to OBJ or FBX formats for 3D printing or sharing online!\n\nIn your world, anything is possible.", "short_description": "SculptrVR's 10,000x zoom enables massive creations with tiny details. SculptrVR makes it easy to create, explore, and share incredible sculptures with friends. With SculptrVR\u2019s intuitive tools, but powerful tools, you can make anything!"}]}, "developer_name": "SculptrVR, Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "SculptrVR, Inc.", "support_website_url": null, "website_url": "http://www.sculptrvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
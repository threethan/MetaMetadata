hc=p2-BjyfTMKgQ7kNvwF7XCcL&_nc_oc=AdqDT560v8PvGGfAiHq7esdv76RHIbkYL8wiECv7LP2-BS9zFyLuOZE8xQPMqssNlfw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwBeRUn3nAIhvy7-WSR1Rw9x9dOsgs_JoHwcoKfNgFmQ&oe=6B0B2CEA"}, {"file_name": "Screenshot-Migrated-2019.08.02-14.53.14-0.png", "id": "2437942039833480", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031440_2437942043166813_181131347501598417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk2g-IsLNHYQ7kNvwGrEGcZ&_nc_oc=AdrvquZkestqQvzSua_Rc2RtegQtgyIEdpky-Ox5imL5GQ3mdCQMrGqpZwNntdDp_h0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHScJBzJxtkeMIFgcDujsiEpBXhDfgAmgQaWXp7aJDog&oe=6B0B33EB"}, {"file_name": "cat-2560-1440.png", "id": "3497004610375554", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031381_3497004613708887_7371022396966060147_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cem9woGwddcQ7kNvwGvA1tG&_nc_oc=AdrknTePt3Hyh3L3mGB-t-mkLb-uR2YdKnH01o1mo1KrJb_6RxRmV3REQILRzciv9cA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvIaClupIYkIFnSTXgDo3tS1MrjJCjhD047ZpAI6Be7A&oe=6B0B1DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "137980498083530", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974831_137980501416863_2883196694555030565_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cljob_9MbLwQ7kNvwG3Lix8&_nc_oc=AdrnRHUmLzeWans2oFx1Y6zPdTC0aOdpa0MhVv5uY5epL4Z138X6jesIH8w8o8b9Vg0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThktd30FUQgaO3V95-PF0-4gimbUGEQ-QWPFXH5FTz3Q&oe=6B0B3255"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "craft", "explore"], "long_description": "Create sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun.\n\nDiscover thousands of amazing creations in the interactive gallery then remix them however you want! When you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made.\n \nUnleash your creativity by building with SculptrVR\u2019s intuitive and fun creation tools. Then destroy it all with rockets!\n \nAdd mind-boggling detail with SculptrVR's voxel tech and 10,000X zoom.\n\nExport everything you\u2019ve made to FBX or OBJ  for 3D printing or sharing online!\n\nProcedurally generate landscapes, then delve underground, but be careful not to delve too deep!\n\nThere\u2019s a million ways to have fun in SculptrVR and in your world, anything is possible.\n\n---\nFor tips, tutorial videos and support visit https://www.sculptrvr.com/.\n", "short_description": "Now supported on Meta Quest 3 Headsets with updated graphics!\n\nCreate sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun!\n\nSculptrVR makes it easy to create, explore, and share incredible sculptures with friends. SculptrVR's 10,000x zoom enables massive creations with tiny details. With SculptrVR\u2019s intuitive and powerful tools, you can make anything!"}]}, "developer_name": "Greensky Games", "developer_privacy_policy_url": "https://www.greensky.games/privacy-policy-greensky", "developer_terms_of_service_url": null, "publisher_name": "Greensky Games", "support_website_url": null, "website_url": "https://www.greensky.games/sculptrvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_conne
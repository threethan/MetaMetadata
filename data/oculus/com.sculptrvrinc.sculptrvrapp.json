FdkqtjjxAQ-kzcfeZiWvkd2HT9fxSq9jyfkJq-PmQ&oe=6A859914"}, {"file_name": "migrated_image.png", "id": "737007190162948", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031643_531116590960659_8229262887957299200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3g3SYV7WzAQ7kNvwHKSO8a&_nc_oc=AdrrnxkZVNVRtKUr50-NKKTwa2KR9psGyJACWd_SprizQ0j-YzWt51-stxF4zC3ZOYE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzJtIOSTi_DzJjStFJmhLAa_wQ0Pa0q-ghPeg5WIeCZw&oe=6A8587F7"}, {"file_name": "migrated_image.png", "id": "214361113141235", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982569_668287380312017_2193958780440412160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x5Nne7ax0AQ7kNvwHiYgJr&_nc_oc=Adoey4QJ1uFOowLBAtZySYke3791XOixxOs04N2gDqv6jqi_OBwVIvGMnqLoZWIFy_0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpsGCBRUroimuAhCwqM9KZvgWZVXd2kXx5xr3iqIX9bA&oe=6A85AB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jGuwD7", "id": "1196089487254813", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974807_1196089490588146_1334756332426756096_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntTKhq_XzbgQ7kNvwFBWzgn&_nc_oc=AdppN2DdQGfd9Rfeeh_k3iaqkU9AAbQrtbLi31oRFhg7w4bEYNAz1DrHgxR5yKuAeP8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT2w1t2dJR-iawf6z0oJ1C7mriwULCtHGJkF4C53sZKg&oe=6A858485"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "build", "flying"], "long_description": "Create smooth, polygonal, and cubey sculptures and worlds of any size. SculptrVR's 10,000x zoom enables massive creations with tiny details! SculptrVR gives you almost unlimited space so your imagination is totally free!\n\nSculptrVR\u2019s intuitive and fun tools let your imagination turn into real creations.\n\nGet a better view of your sculpted landscapes by Hang gliding through them.\n\nJoin an online game with 4 friends (cross platform with Go and Rift!) to build massive monuments together or have a sculpt-off!\n\nWhen you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made. You can also browse the gallery with hundreds of creations!\n\nCreations made in SculptrVR can be exported to OBJ or FBX formats for 3D printing or sharing online!\n\nIn your world, anything is possible.", "short_description": "SculptrVR's 10,000x zoom enables massive creations with tiny details. SculptrVR makes it easy to create, explore, and share incredible sculptures with friends. With SculptrVR\u2019s intuitive tools, but powerful tools, you can make anything!"}]}, "developer_name": "SculptrVR, Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "SculptrVR, Inc.", "support_website_url": null, "website_url": "http://www.sculptrvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "358248065824597"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "4213370125563605"}, {"status": "PUBLISHED", "id": "2121486061719037"}, {"status": "PUBLISHED", "id": "1100979841551064"}, {"status": "PENDING", "id": "3546470832301022"}, {"status": "PUBLISHED", "id": "402569567460909"}, {"status": "PUBLISHED", "id
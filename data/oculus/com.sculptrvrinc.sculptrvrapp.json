e_name": "Screenshot-Migrated-2019.08.02-14.53.14-0.png", "id": "2437942039833480", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_2437942043166813_181131347501598417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R34oqiJ7becQ7kNvwHmdrsE&_nc_oc=AdpV1ABF2NrhvplW06BtMpANLo8ieX-R-8Tva36ey1TkMocJwJzNoYnZEGOS7XOPGM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yDa9VygqkRPXtRQ45d6TbQrCz-wQLY2H2Wm_l7dCi5w&oe=6A1DADAB"}, {"file_name": "cat-2560-1440.png", "id": "3497004610375554", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031381_3497004613708887_7371022396966060147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hco39N47VKcQ7kNvwEuwbfZ&_nc_oc=AdqgI4T-IvNTJ0JFLQp8rKYaqTyOdvr_f5U8-g_DDSc9t7PQpOpszTNBixZCrtas1gg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ryOvXpiSjzrydl_8RbdtSAYhl2hOQqvRTcfRJTYZH9w&oe=6A1D97B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "137980498083530", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974831_137980501416863_2883196694555030565_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4bXsympHj0Q7kNvwGcpiKJ&_nc_oc=AdqRxrguZTF_p-Yo9ouROAG_XMWWetuH48nKfzLpeW26BB5AbL97nMWJ9xxuAVOh3yg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G2UCLUB6z90tnJfloVzLqBYQRRCHamCdM4XPo8Maapg&oe=6A1DAC15"}, "display_name": "SculptrVR", "keywords": ["sculpt", "art", "create", "craft", "explore"], "long_description": "Create sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun.\n\nDiscover thousands of amazing creations in the interactive gallery then remix them however you want! When you're happy with your creation, you can upload to the SculptrVR content gallery and let others see the incredible things you've made.\n \nUnleash your creativity by building with SculptrVR\u2019s intuitive and fun creation tools. Then destroy it all with rockets!\n \nAdd mind-boggling detail with SculptrVR's voxel tech and 10,000X zoom.\n\nExport everything you\u2019ve made to FBX or OBJ  for 3D printing or sharing online!\n\nProcedurally generate landscapes, then delve underground, but be careful not to delve too deep!\n\nThere\u2019s a million ways to have fun in SculptrVR and in your world, anything is possible.\n\n---\nFor tips, tutorial videos and support visit https://www.sculptrvr.com/.\n", "short_description": "Now supported on Meta Quest 3 Headsets with updated graphics!\n\nCreate sprawling, brilliant worlds and explore them with your friends! Invite your friends to an online game, then race to the finish with hang-gliders, or switch to climbing mode for even more fun!\n\nSculptrVR makes it easy to create, explore, and share incredible sculptures with friends. SculptrVR's 10,000x zoom enables massive creations with tiny details. With SculptrVR\u2019s intuitive and powerful tools, you can make anything!"}]}, "developer_name": "Greensky Games", "developer_privacy_policy_url": "https://www.greensky.games/privacy-policy-greensky", "developer_terms_of_service_url": null, "publisher_name": "Greensky Games", "support_website_url": null, "website_url": "https://www.greensky.games/sculptrvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mod
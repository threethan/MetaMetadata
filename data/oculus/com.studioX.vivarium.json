OM10ARm0AOEWnCpL5aj16zZZ5mWX5y3jN_qc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMrEYz-zAxNVYurM3FXAPtQzaLWsIHrLYUCDD9XwD1YA&oe=6AFB41F4"}, {"file_name": "6.png", "id": "2642462632773688", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392165_2642462636107021_5118513567920907891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2sgfdgYq8wQ7kNvwHHl8yT&_nc_oc=AdqnHqDyrjF8RToK6bpVk67CQ9VSXbCycJLVe9SWePxvPbP_xn_-k9V5xGyQGPe0CgM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTonIFxvWBGeBRKygDDScP6pSaxXBq_ypA98Bsa_dqlWg&oe=6AFB314A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "[2] MarketAsset_2560_1440_Origin_Global.png", "id": "627680196259217", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75411988_627680199592550_5702450325759006192_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3FWNaWrxk8Q7kNvwHbZ8tI&_nc_oc=AdqSiFWyqLzSJdQloWtQbJgENU_sc4wdcGYK4C29iVgt-l7mTDQAYD77RhCcAk745l0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaPkhwvB-W8aub652F11kbORyrcasPZCbS_-hRv7X15w&oe=6AFB4AE7"}, "display_name": "Vivarium", "keywords": ["vivarium", "pet", "nature", "simulation", "relaxation"], "long_description": "Vivarium is your new virtual space to enjoy raising pets and growing plants while designing the most creative vivariums.\n\nYou might have seen hobbyists making a vivarium and decorating their rooms with their creations. Now you can experience this beautiful hobby and relax at home while interacting with realistic pets and plants in your room in either virtual or mixed reality.\n\n# Design and create your different ecosystems\n\nSelect a glass tank and combine soil, rocks, wood, and mosses to create a nice environment for your pets and plants.\nAdd decoration items to give your vivarium its own narrative.\n\n# Look after your plants and pets\n\nTake good care of your vivarium by watering your plants and feeding your pets. \nYou will also need to manage other elements to maintain your vivarium in good condition.\nMake sure to interact with your pets and show them some love.\n\n# Display and share your creations\n\nSet your created vivariums in your virtual lobby gallery or in your room in mixed reality to appreciate their beauty.\nShare them with others to exchange ideas for future designs.\n\n# Immerse in nature\n\nExpand your vivarium in your room in mixed reality to feel like you are inside of it.\nObserve your pets and plants from up close.\n\n# Challenge yourself\n\nEarn extra rewards by challenging yourself in our mission mode.\n\n# Collect all plants and animals\n\nObtain all the different plants and animals and learn more about them to unlock some additional rewards.", "short_description": "Create unique ecosystems where you can raise virtual pets and grow plants in the most aesthetic ways. \nA game designed to immerse and connect with nature from your room in virtual or mixed reality."}]}, "developer_name": "DoubleMe_StudioX", "developer_privacy_policy_url": "https://www.vivariumxr.com/privacy-policy", "developer_terms_of_service_url": "https://www.vivariumxr.com/terms-of-servic", "publisher_name": "DoubleMe", "support_website_url": "https://vivariumxr.zendesk.com/hc/en-us", "website_url": "https://www.vivariumxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ko", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "
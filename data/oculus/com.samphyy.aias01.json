R2BgizbX3Kz8i5TDS8VrvO7I26FNThZmhE6hbg&oe=6B0C5A83"}, {"file_name": "practice-debrief.png", "id": "3914410622030878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628108_3914410625364211_1366108204425255068_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHyqMNiRWVEQ7kNvwHJH05h&_nc_oc=Adp4u7pcqVIEFJ1IlszOIfSoRKAJ9bZgxTcjVEy9PoS-9vAJ0gm7ZZEoaeFxcz_qcLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRn1NypRokD_UvyCwjWGsETmJnCQVPFl0cA0VCzpZ197g&oe=6B0C6D9F"}, {"file_name": "mentor-room.png", "id": "2655098261583818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626808_2655098264917151_8755739067161173757_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hePWn0ID2acQ7kNvwEQ2dLk&_nc_oc=AdrCxh8OdKSDGSM2RZx10RkVIy6CMBDJvelyd_dVtlHzaKGrjgBSs8EK2U_xKbiZB6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUn63FxEWtnDyqHD5wuCkWP9acNAMMTz9kT12RgtKW0g&oe=6B0C58F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AI Adoption Strategy VR", "keywords": [], "long_description": "Which AI idea should your business try first?\n\nLead an AI pilot recommendation at a fictional retailer. You have $50,000 and 12 weeks. Choose a business priority, then hear three department heads adapt proposals for staff training, customer messages and stock planning.\n\nAsk questions in your own words, interrupt to clarify and compare the case facts. Explain what you would test, who would lead it and how you would judge success. Respond to a new problem, then reflect with an AI mentor in a separate room.\n\nSave your decision brief and reopen it in the headset. Resume an unfinished round without using another round. Emailing your brief is optional; updates require a separate opt-in.\n\nIncludes one free practice round. Optional packs contain three rounds for US$9.99; local prices and availability vary. Meta displays the price before purchase. Each round includes up to 40 AI replies and 100 voice recordings. Introductions and interrupted AI work count. At the limit, your answers remain available to review and save. Rounds do not automatically expire.\n\nSingle player, English, Quest controllers. Internet and microphone access are required for AI conversations. AI replies may be mistaken; use fictional details. Designed for adult managers. This is decision practice, not a validated business plan, assessment or certificate.", "short_description": "Practise leading an AI pilot decision at a fictional retail business. Question three department heads, weigh their ideas against your priority, respond to a new problem, and reflect with an AI mentor. Save a decision brief to review in your headset."}]}, "developer_name": "Samphy Y", "developer_privacy_policy_url": "https://upskillsxr.com/ai-adoption-strategy-vr/store-privacy/", "developer_terms_of_service_url": null, "publisher_name": "UpskillsXR", "support_website_url": null, "website_url": "https://upskillsxr.com/ai-adoption-strategy-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1361122120427533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1816741532865797_6998613107165584788_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z_J1y8-cxIQ7kNvwFY_E
Xi4_PH0S54Fn0RpZP6KFvGKhgu5EWgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftEZbjdxWYZFdJpngVLtGJv-Xeco5vwANm5Xnj1Jm7UmA&oe=69A838AD"}, {"file_name": "38984452_434174639555943_5931260977128327457_n.png", "id": "1662721491285500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391954_1662721494618833_6317984228120137017_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRh7H7Yp4JcQ7kNvwForne2&_nc_oc=Adld_I2vsG0Vxe_bm4QU8nwO8k0Jb2i_QfontP4vwB7XIpiO2Ch7gNjB8_YgZ0fgNxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsICX8-0xZbPoL7fIFZvyqD02Vvqpd0M7jG7c9igVTJOQ&oe=69A83C2C"}, {"file_name": "39035466_413756788228457_4949149780036679302_n.png", "id": "1147884459878558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393567_1147884463211891_3159215924621621505_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EOle1gr4kEQ7kNvwHlXm-g&_nc_oc=Adk5fFxDtSr-quelvqppBN0JPnaYblVXWv1gCexuovPbGCm6WqJMifhHzdVw_2mI7_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvAaFIMRa63M1phxQi3xFsmgX3O-7qO90dZnqXvPjlwlw&oe=69A81F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpyVR", "keywords": [], "long_description": "Immerse yourself in the ultimate Gorilla Tag fan experience! This game brings high-energy, physics-based movement to VR, letting you run, jump, and climb using only your arms. Explore diverse maps, unlock unique cosmetics, and challenge yourself in thrilling tag-based game modes. Whether you're evading capture or hunting down your friends, every match is a heart-pounding test of skill. With frequent updates and a vibrant community, there's always something new to discover. Get ready to go wild\u2014play now!", "short_description": "Swing, climb, and jump in this fast-paced Gorilla Tag fan game! With unique maps, fun cosmetics, and intense tag-based gameplay, experience VR movement like never before. Play with friends, customize your look, and master the art of locomotion. Can you escape the tagger or become the ultimate hunter? Join now and start climbing!"}]}, "developer_name": "JackkTUMZ", "developer_privacy_policy_url": "https://sites.google.com/view/kjasndjhasndjhkandh/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "JackkTUMZ", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpywebsite/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9516177201779317"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "666192469165699"}]}, "baseline_offer": {"id": "666192469165699"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740780000, "status": "PUBLISHED", "id": "666192469165699"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9989746704422362", "version": "0.025"}, "id": "1955599531595455", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9433651530031885", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9989746704422362"}, "release_status": "RELEASED"}, "binary_release_ch
scdn.com&_nc_ss=7f20f&oh=00_AQSbIx6_QhJxip0FNyuBjK2wlsApFGFqATvtahRabE2low&oe=6AF9DA2F"}, {"file_name": "Screenshot2FIX.png", "id": "2754925121376552", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820354_2754925124709885_3250450474262613534_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujJPIbEeKUIQ7kNvwEt2YOR&_nc_oc=Adpk1H2YnRS8ul8BTqb-bGkNGmzEm8CHbYWfmjZHTboLam-xE2jjKpaLq8wYQMnAzvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOu2kV0mzV2SuY6nrJYwHfJeUcH9ThRwhXMPbgNOBTRQ&oe=6AF9B97D"}, {"file_name": "Screenshot3FIX.png", "id": "1065442458543001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820548_1065442461876334_6943403853314628570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsvQI-K_kpIQ7kNvwGRxU9n&_nc_oc=AdqAJn54iSLAO9_Ir2Oe86e2WdG4_ImWI7J-e_jWaNwpPbJCKYHqJc92RZaT2hAsFsI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTStu7lQMLt3RUbNVlGVZr33iP_MtyCTP7VdXA_1LiyeA&oe=6AF9E274"}, {"file_name": "Screenshot4FIX.png", "id": "1405136393941466", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819385_1405136397274799_1610333248887086585_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HXvuqpBf-oQ7kNvwEygqSX&_nc_oc=AdpBX6z38nz0Do_k15pvkRclUWuyFSeWZegv-F3wJnYAprhSiiN6oyO9e8dTWxSHQdk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAHVbKAxR8b-pPRWkMfhYcXpKnU3BO8v6sTgkUy7vVJw&oe=6AF9C5BD"}, {"file_name": "Screenshot5FIX.png", "id": "1281608553590251", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822489_1281608556923584_2760389045949516955_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaLfZTHuyn8Q7kNvwEpKDUA&_nc_oc=Adr8UplRXiliLtl96I0wPlluZDBXG4jE0ebM5PuAR0mVl_wtVxicij-rF4Nj9eaYe6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyOqIYrgQ60t0AUiV6LYriouX4MuWaTpCd1N0vH8FdiQ&oe=6AF9E861"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimpellTag", "keywords": [], "long_description": "SimpellTag is a fast, fun, and deceptively simple game of tag designed to keep you on your toes. With minimalist visuals and smooth controls, SimpellTag strips the classic playground game down to its core \u2014 speed, strategy, and survival.\n\nWhether you're chasing or being chased, every second counts. Quick reflexes and clever movement are the key to staying ahead. The rules are simple: don't get tagged. But mastering the game takes skill, timing, and nerves of steel.\n\nPerfect for quick sessions or extended play, SimpellTag is easy to pick up and hard to put down. Whether you\u2019re playing solo or with friends (if multiplayer is supported), each round is a fresh test of agility and focus.", "short_description": "SimpellTag is a fast-paced, minimalist tag game where speed, strategy, and reflexes rule. Chase, dodge, and outsmart opponents in quick, thrilling rounds of tag with a simple yet addictive twist.\n\n"}]}, "developer_name": "Barkin", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-for-simpelltag/home", "developer_terms_of_service_url": null, "publisher_name": "Barkin", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1dS_Vjn8-Ey4srl7exP6cAzksLTusJ82UDA9_xMfktyU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9612229328881606"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": 
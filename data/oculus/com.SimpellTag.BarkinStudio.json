scdn.com&_nc_ss=7f20f&oh=00_Af-h_enmT_zNL3laVIyLqEzfHhaMwx3cHauH0Q0cYUb3og&oe=6A2C302F"}, {"file_name": "Screenshot2FIX.png", "id": "2754925121376552", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820354_2754925124709885_3250450474262613534_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYqaqVxYiyQQ7kNvwFVlxUq&_nc_oc=Adr94SdeTuCNHRZLbPWNXoPiwmKPRqdE2beZBGbNUEqWSWhGO8pFOkf51GHh0i1qAPA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VGkxueEYpJaPvZKDR_jhcxA85ispuhEWuDGNT7JOSAw&oe=6A2C0F7D"}, {"file_name": "Screenshot3FIX.png", "id": "1065442458543001", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820548_1065442461876334_6943403853314628570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjAjw-X43JQQ7kNvwEsbtFs&_nc_oc=AdpfPzVokBvUGea-KLAFnw6vbgA1vcjOy4fBAp3kJSj7u0arf30gVctFzXnnSEfABJY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hkwp8qNF6zDaMtBNV-x0Xpv9vkykXTCb7gakUbDc7Mw&oe=6A2C0034"}, {"file_name": "Screenshot4FIX.png", "id": "1405136393941466", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819385_1405136397274799_1610333248887086585_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOCsAbGw5_YQ7kNvwFJ7Tol&_nc_oc=AdpYbW6kJlrEZ9iO0CjN-3TH7JRmR0dXOALCW9r4vJqgYwitwLNBL4FovfkLq4ejOsQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tTho_k09CYo-jrNWde3EWVNM8McaAR9NxsCTtD73w1A&oe=6A2C1BBD"}, {"file_name": "Screenshot5FIX.png", "id": "1281608553590251", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822489_1281608556923584_2760389045949516955_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXdoiZpum5QQ7kNvwFNIijK&_nc_oc=AdpjIvlaQMqKnvw6VKMdOWs_rwOutrnNvi_FdmSODaQZuVmfeFfkJro4wpo4fl15oWo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YAeKy_ealsT4xffQe3b81sUjqXgHyBeG7v9F2yzlQDQ&oe=6A2C0621"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimpellTag", "keywords": [], "long_description": "SimpellTag is a fast, fun, and deceptively simple game of tag designed to keep you on your toes. With minimalist visuals and smooth controls, SimpellTag strips the classic playground game down to its core \u2014 speed, strategy, and survival.\n\nWhether you're chasing or being chased, every second counts. Quick reflexes and clever movement are the key to staying ahead. The rules are simple: don't get tagged. But mastering the game takes skill, timing, and nerves of steel.\n\nPerfect for quick sessions or extended play, SimpellTag is easy to pick up and hard to put down. Whether you\u2019re playing solo or with friends (if multiplayer is supported), each round is a fresh test of agility and focus.", "short_description": "SimpellTag is a fast-paced, minimalist tag game where speed, strategy, and reflexes rule. Chase, dodge, and outsmart opponents in quick, thrilling rounds of tag with a simple yet addictive twist.\n\n"}]}, "developer_name": "Barkin", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-for-simpelltag/home", "developer_terms_of_service_url": null, "publisher_name": "Barkin", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1dS_Vjn8-Ey4srl7exP6cAzksLTusJ82UDA9_xMfktyU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9612229328881606"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": 
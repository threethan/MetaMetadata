scdn.com&_nc_ss=7f20f&oh=00_AQPea2sNPMQE01-LF6LwKJ7fGR0lw-hZ9iMhD5whw5dMBg&oe=6ACBB5AF"}, {"file_name": "Screenshot2FIX.png", "id": "2754925121376552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820354_2754925124709885_3250450474262613534_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LubEnD-39IwQ7kNvwGloAWx&_nc_oc=AdqdpCZlik_zQo3Cd1nFAwZoxIk_6P-F20DdGokv_ZNzoCP3Ew1D5yZ79X7lrltADtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNss9Ehj1979P89LgAl_DKm7DRqmwxusWs9ChAiKX2EkQ&oe=6ACB94FD"}, {"file_name": "Screenshot3FIX.png", "id": "1065442458543001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820548_1065442461876334_6943403853314628570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHauS03aWBgQ7kNvwFXbHOC&_nc_oc=AdpT-aKT-MZFt_0KhscKQT5d8wcZu9XMmB58lNLb87m7yJbXZWNKd32gMcJLgvjrgR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ2LBfFiwkk-Ll-SKxwmQSWT5aIWM10_EdCMKU1DY9OQ&oe=6ACBBDF4"}, {"file_name": "Screenshot4FIX.png", "id": "1405136393941466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819385_1405136397274799_1610333248887086585_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfGM0MURXMQ7kNvwETYQp9&_nc_oc=Adp50rI2-5L8UQoHf1XJPQq4eo7Cu0jDnTZ3TTmEjDLEGzJ1Nafw66uy8bDaPS1OwBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN820MB8fw-0MiIW-witfPuR0-eCsULR4na0QJAUJ8YJA&oe=6ACBA13D"}, {"file_name": "Screenshot5FIX.png", "id": "1281608553590251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822489_1281608556923584_2760389045949516955_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnRQbWpNfcoQ7kNvwG90VEt&_nc_oc=AdoQqFaaM4cX2FME2ZAsAlejJSMqEC4sntEDlCe0f4eMFBFlkF9b9Zx3igrrBx748jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz3_4pibRbLEafXRs-AK5mRP1TLFZDtxRF6FIMQcygXA&oe=6ACBC3E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimpellTag", "keywords": [], "long_description": "SimpellTag is a fast, fun, and deceptively simple game of tag designed to keep you on your toes. With minimalist visuals and smooth controls, SimpellTag strips the classic playground game down to its core \u2014 speed, strategy, and survival.\n\nWhether you're chasing or being chased, every second counts. Quick reflexes and clever movement are the key to staying ahead. The rules are simple: don't get tagged. But mastering the game takes skill, timing, and nerves of steel.\n\nPerfect for quick sessions or extended play, SimpellTag is easy to pick up and hard to put down. Whether you\u2019re playing solo or with friends (if multiplayer is supported), each round is a fresh test of agility and focus.", "short_description": "SimpellTag is a fast-paced, minimalist tag game where speed, strategy, and reflexes rule. Chase, dodge, and outsmart opponents in quick, thrilling rounds of tag with a simple yet addictive twist.\n\n"}]}, "developer_name": "Barkin", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-for-simpelltag/home", "developer_terms_of_service_url": null, "publisher_name": "Barkin", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1dS_Vjn8-Ey4srl7exP6cAzksLTusJ82UDA9_xMfktyU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9612229328881606"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": 
pN1U7Q2rPWf5iVYdmBhJstYl5KTTFynMxmxWcrPPeVMy2eWvV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ZoOhuQGk61-wXteYckYNUmTaw0nCOWUVNlhgI9H6zA&oe=6B007FE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimpellTag", "keywords": [], "long_description": "SimpellTag is a fast, fun, and deceptively simple game of tag designed to keep you on your toes. With minimalist visuals and smooth controls, SimpellTag strips the classic playground game down to its core \u2014 speed, strategy, and survival.\n\nWhether you're chasing or being chased, every second counts. Quick reflexes and clever movement are the key to staying ahead. The rules are simple: don't get tagged. But mastering the game takes skill, timing, and nerves of steel.\n\nPerfect for quick sessions or extended play, SimpellTag is easy to pick up and hard to put down. Whether you\u2019re playing solo or with friends (if multiplayer is supported), each round is a fresh test of agility and focus.", "short_description": "SimpellTag is a fast-paced, minimalist tag game where speed, strategy, and reflexes rule. Chase, dodge, and outsmart opponents in quick, thrilling rounds of tag with a simple yet addictive twist.\n\n"}]}, "developer_name": "Barkin", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-for-simpelltag/home", "developer_terms_of_service_url": null, "publisher_name": "Barkin", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1dS_Vjn8-Ey4srl7exP6cAzksLTusJ82UDA9_xMfktyU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
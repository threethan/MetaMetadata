575347_194901916709561_4369382863725734210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGG3LpQ7oFYQ7kNvwHgc0xB&_nc_oc=AdrCgOtCmalzg9xWlCTLEB5sqJs6KdoiQeeeY_q0oqy555Diy7VO05_8bG7P77Gm5uM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLntsbz-WmepmqMrp7tyEFx8GKZZYQXa4rVhcC8qb-7A&oe=69C14976"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SebL148VS9sQ7kNvwHAxFZV&_nc_oc=AdpQzKmSk6thVLjo0baPyNRJ-DUW6QmM2hNlL5RvAsmkBdZmh0YqO5HqP5hdiUniY7c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwr47WXEkXT_ElvTVvxdOIDL8x7HnXOamarxV8qZmxh5A&oe=69C12A74"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ9p6Ht1NOAQ7kNvwHl3Eft&_nc_oc=AdpNybaM-IRu8bBSMkWnYKO2ugoJVe_AbhQ-Vn54ldiqiNIqekJEoMyYXrhXycAbqM4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmCApa05JrdC3LElGLM7OVytR06ECT0VdTbwYo163ZrA&oe=69C12F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj2j9p2Bb6wQ7kNvwHlapo_&_nc_oc=Adr6Nlkn64VHkQBzQldYlw2NnhF-PAzhqWptxaLKuqNGh6tz-JXd0WnOo5mY5qVSm3s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMxVHnj4zC3PoJ9IsDH__Phav6gSYtyJ4_xOA-GHlhYQ&oe=69C140D3"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974740_2272291159825403_6909993192740119185_n.png?s
0a&_nc_ohc=JM5wLlVjkScQ7kNvwHic9f0&_nc_oc=AdktIx7V-JXp2WEfGfwWZgKapW9Pyazob6ciqvpDenYEEJUVDesdjdywRfaqnB9UPh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvA0oS8nmKSyhUmGjCRJrIefYeU_5l6N3V7-HJK9B2PHw&oe=69A44876"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC85PMHvk-oQ7kNvwHfs_Au&_nc_oc=AdnDLAR0yy2qrW_-XUI-reZdReiDMtLGbTHCfW4ha3X4FssziVFmGiKGJjgPr5afQRA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsr3-9iawiV3vZ2pef6_csjsYXiLUimiKVsoZpOEFiK9w&oe=69A42974"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bOvgwS7EtMQ7kNvwH7rWNp&_nc_oc=Adnp2kk4yNFMK8h2FOj9Jxr7uhQuXaJAVzpxxYlPvT9_DMPeKw2ro5l6w5AqfDATpWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvV7sn3DcmPmzXYCuOnwLIGWwvQe4o7dWQhTcX9E0Elg&oe=69A42E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1RLumn9xo4Q7kNvwH1O_qY&_nc_oc=AdnjfDQtXbjsgEs29KwWZ1Qfou0lPwY-yfmqbNBQAPnW0xvCWaVisx-JRmKHT6voPFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfswbM-qdO_vFhM1rgRQ6viHyMeGXv6PQZnqVFH6ndDVKw&oe=69A43FD3"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974740_2272291159825403_6909993192740119185_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbpdWI5sKZ4Q7kNvwHX22Y6&_nc_oc=AdmMWjyIomt2z7qcFfQjvEO
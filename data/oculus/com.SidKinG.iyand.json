_sid=6e7a0a&_nc_ohc=JM5wLlVjkScQ7kNvwFEBEt7&_nc_oc=AdkgnZrMFWDqnHCk7jlM336CdbRN3KZX_tdYL5SKT9ZVmUHYp1Peg3COHr-bcF-zJ5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYwhUl3J1Z9bNVc__xSqASW8HrtWE70iaWUslaxR0eng&oe=69A6EB76"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC85PMHvk-oQ7kNvwFzltQH&_nc_oc=AdnGXdRxcrhgIZ5Xl9r-ahR590HjDXa0BKC978xQFrZx718f-7nYRnVpWs8dvDKBk0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVvpsMI6zG5N9bQVCqfU85ubnsAMuvEe90tA7SBuRXsw&oe=69A6CC74"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD8AkpVl6UkQ7kNvwGzSN9Q&_nc_oc=AdlbO56heaK_Pbl-22LYd1Vo7L975nKRZ5o3J6kIVapwz46I-zjK67yn9qTbF8xe54Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afunv4XPXwFpKCp2jrYChjXr7SvWJ0ZsA-xrUicnYC3ZLA&oe=69A6D172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1RLumn9xo4Q7kNvwEKbwQM&_nc_oc=Adl6yUEp_3aOQkxfNkN4_oQwOeuSkOpCPewPz6qugSNyDQNLiVb2XvOh7D_cXTCRZdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsa93FSVmjD_VIdGyeTshzgVGg90AhNJEL6BuS-AlPlQg&oe=69A6E2D3"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974740_2272291159825403_6909993192740119185_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbpdWI5sKZ4Q7kNvwEPpKlF&_nc_oc=AdnuY_tlPpTWbJ
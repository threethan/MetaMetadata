0a&_nc_ohc=dhTdvBpKKu4Q7kNvwEvJlGv&_nc_oc=AdkwNElaJ1kmkkFF3DsisOge0cYjShzv834Uku0mwL8CotKHGsrVGYMBm3jlOwoE_og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftHtXjgRWdUs1D4LvTX0dcmuNKz-rYxC2v8cBk2bXBr0g&oe=699C5F76"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MkuHj6ttfMQ7kNvwFw-JzO&_nc_oc=AdnlwceTeXOEUeDoPK9uBFr6-1l9wR3HiJbF1QmAa-XwolSQ9475Vs0RfgO8Gpy4ZCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuvWW0Dzw9lg9U9aWvKYop0Ei4gkDgnxTBcqPMZLYgscA&oe=699C4074"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LcrnUogrDgQ7kNvwH6wVVs&_nc_oc=AdknHUpyl6PhMDxEog7ib1sc62-37VS19ojK7EC9NzPMONpzNJpwvMqzvYASSMUfgMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvMtNBOe81vFszArayTHg54PP00HwKgEb3FE8VG6x653Q&oe=699C4572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0Dm0uc2QowQ7kNvwGh3Jjk&_nc_oc=Adl1jt9brhweLfm8vrbNa4QIalWCL5RV1daWx7LXT2ReUL5ubYNbK9VpIKmmNJB12p4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv0x8ZDtXa_coPxnjdVzNva2BvAULVbdAo9Pboz-XRazg&oe=699C56D3"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974740_2272291159825403_6909993192740119185_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QONuB5Owcw4Q7kNvwE8XxB-&_nc_oc=Adm1eeH3jCTzfPU-q_nEb4y
w5-1.oculuscdn.com/v/t64.5771-25/57575347_194901916709561_4369382863725734210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kpqKDKL_cwQ7kNvwEDzMb-&_nc_oc=AdrtNfM7A4VsqjA6mgg_j2W8oiipGx3XAzi5KuV3gkDp7cdnbxQDK88k7-ug89RNwxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4wvdW0PCODk5n-KtagTSehRhpn2AKePYzx29cemQcGA&oe=6A8AC6B6"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkVUywMk__4Q7kNvwEyzU9o&_nc_oc=AdoA_fDKXmDCxMv7D6OlCOOH6vKiqIIIcJV5YBR8ajfNr4CqAqR3Ib0m1xv6xvMURDQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHItrbwFA__0VkkBdFLZg8MPhme0GpeGabsKXacc8PHaA&oe=6A8ADFF4"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5dNmrbz62EQ7kNvwGhzOKB&_nc_oc=AdpNg3rxfdw_WZSuIE-x84RTTAPWYGG-mB-F6x5WoB3mD2nuqm2CkBFXfdF_u1-nEqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5-Qy-IfU6p6Ntb-btILoRAOTirJ4eQAxTHOLWiu4Diw&oe=6A8AE4F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3eF2EEcLSkQ7kNvwGhHI5O&_nc_oc=AdrsJ4w4PSh30AvuEXQWPp2Vwhe9sc6bNQzYsxE0SOg3SRsUQmzQnAVCG6gtSKbzU08&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnMd94PfqXBFAAycqsWj5kh4RAHpwL-3Y2D_5rh5QYvQ&oe=6A8AF653"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38
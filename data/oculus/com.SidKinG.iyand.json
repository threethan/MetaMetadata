d3-2.oculuscdn.com/v/t64.5771-25/57575347_194901916709561_4369382863725734210_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7yLJ4FsRTAQ7kNvwFXNCTM&_nc_oc=Adqn-gQUzNESzLVgZ05y7aOa0SrYIvRG9EytUSUVKjfgTCjsaGILBLR6g_lvfDSeicM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO06VFi7CQppX5pV-yGhEwOCh9sOUgcMGwP4dZ2lo8Kvw&oe=6AC25DF6"}, {"file_name": "SS 6.png", "id": "2197528600634624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2197528603967957_7988230609053349225_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvN6KDwXZKQQ7kNvwEKkPwB&_nc_oc=AdoYrDQdPk2_6NPBhgg5Mino__m7eAD7B7wA2b4N9sXQ3VQIWV_Zl8jLt-OzIjAMlak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNba_xc1p56o66W0tAaGxhW-JNBSRaws9d9PITeztOc4w&oe=6AC27734"}, {"file_name": "SS 3.png", "id": "246141424576074", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931327_246141427909407_6276687811146681097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuG2sgQXRKgQ7kNvwGu76Ui&_nc_oc=AdrdrfhHjpy7Mc13ahMr_ZME6KokAdhSVDi02jD8RYpC0Th7LhBg-5NEjoLLaK8assc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5KVFl7rU6ADH2FK3gPBX43FKqA6dE8oSxQTphicB9fg&oe=6AC27C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster - Cover.png", "id": "1497330271070248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982723_1497330274403581_1010539024953878920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKd4rDI8rgIQ7kNvwFWzP_V&_nc_oc=AdqNrDBbTkO2Am3mIhMzYBRX-GWTFz0EWf1eK4gdwnMYbxfhQTdI0kkoq7X4NcGmc2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6Dke8o0rP4bHap_N9coYpxuYkPHLMw70tbQjAjOrxPg&oe=6AC25553"}, "display_name": "If You Are Not Dumb", "keywords": ["mr", "mixed", "reality", "puzzling", "places"], "long_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\n\nand many more!!\n\nA game also supports mixed reality! \n\nGive it a try! You will love the puzzles.. or at least you will realise that you are dumb (:\n\nTUK", "short_description": "What if a puzzle looks simple BUT you end up feeling dumb!!\n\nIf You Are Not Dumb is a funny and quirky puzzle game.\n\nA game gives you situation based puzzles. A few objects to interact with and One instruction to follow!\n\nEach puzzle has its own logic.\n\nSituations are like -\n- Hide from the eyes, but eyes are everywhere\n- Extinguish fire when there is not water around you\n- Type BOX but without any keyboard!\nand many more!!\n\nGive it a try! \nTUK"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26753851527539537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38
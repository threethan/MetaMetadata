board?\n- Where can you hide from the eyes that see everything?\n- Sunset?? But where is the sun??\n\nAre you smart enough to solve all puzzles in a game?\n\nStill not sure about a game?\n\nReasons to NOT play this game\n- You are dumb\n- and you are sure about that\n\nReasons to play this game\n- There is not such VR game\n\nReady to test your dumb levels??"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1splZFw2pxh7oXEIZ2IEvGiGT4-rrTjDIGOP53sAiOiA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kishor Berde", "support_website_url": null, "website_url": "http://www.kishorberde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256638233543896"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1194682002847937"}, {"status": "PUBLISHED", "id": "2215940418885642"}, {"status": "PUBLISHED", "id": "2832262510294648"}, {"status": "PUBLISHED", "id": "1340909667116067"}, {"status": "PUBLISHED", "id": "1160251899021584"}, {"status": "PUBLISHED", "id": "1155400696226220"}, {"status": "PUBLISHED", "id": "1246318036417114"}, {"status": "PUBLISHED", "id": "925058826135987"}, {"status": "PUBLISHED", "id": "689503079360410"}, {"status": "PUBLISHED", "id": "3811654359063840"}, {"status": "PUBLISHED", "id": "163440279992139"}, {"status": "PENDING", "id": "1979848425724283"}]}, "baseline_off
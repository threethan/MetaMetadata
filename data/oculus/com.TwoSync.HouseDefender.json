coming monsters, walk freely around the whole space, take cover behind your furniture and protect your home! With House Defender you scan your environment in a blink of an eye and transform your surroundings into a completely different world in just a few minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://2sync.io/housedefender-info/", "developer_terms_of_service_url": "https://2sync.io/housedefender-info/", "publisher_name": "2Sync", "support_website_url": null, "website_url": "https://2sync.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "550081603130092"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1687996372292081"}, {"status": "PUBLISHED", "id": "27307082425650881"}, {"status": "PUBLISHED", "id": "1023173967065551"}, {"status": "PUBLISHED", "id": "888399130394004"}, {"status": "PUBLISHED", "id": "1175785970472538"}, {"status": "PUBLISHED", "id": "1286815975709061"}, {"status": "PUBLISHED", "id": "612512965036668"}, {"status": "PUBLISHED", "id": "940084491345125"}, {"status": "PUBLISHED", "id": "433584086211710"}, {"status": "PENDING", "id": "740742850472598"}, {"status": "PUBLISHED", "id": "329263896054788"}, {"status": "PUBLISHED", "id": "483835516542511"}, {"status": "PUBLISHED", "id": "2401125593390300"}, {"status": "PENDING", "id": "452450216357546"}, {"status": "PENDING", "id": "397344465684093"}, {"status": "PENDING", "id": "564696498291366"}]}, "baseline_offer": {"id": "433584086211710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1687996372292081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28192175887098719", "version": "3.0"}, "id": "952908725262450", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4963491577060478", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28192175887098719"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "952908725262450"}]}, "change_log": "- Hotfix: review panel closes game\n\n- New room scan: faster and more accurate, with better detection of your walls and furniture. \n\n- Reworked graphics: new lighting and more atmosphere in every wave. \n\n- New user interface: cleaner and quicker to navigate. \n\n- Faster start: fewer steps from launching the game to your first shot. \n\n- Sync your rooms: scan a room once and reuse it in Elven Arrows on the same Meta account. Asks for your consent first, and your rooms are stored in the EU. \n\n- Optional usage data: help us decide what to improve next. No account data, no IP address, and you can change it any time in Settings. \n\n- Stability fixes and polish throughout.", "created_date": 1789233075, "id": "28192175887098719", "version": "3.0", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"
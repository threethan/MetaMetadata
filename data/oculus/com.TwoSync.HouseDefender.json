oikE7EaRQWUlyHoZOay7EzKYCPwLkrFgHsPH6NeCjf4mThA8gLfJ_42gCGgpDTk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnYtabX9EqUr5mR-9h60FoXyogTCZttizpWjDHF3br9g&oe=6AA149B4"}, {"file_name": "Screenshot-3.png", "id": "579337661448505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031633_579337664781838_2302408592298151700_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqLtRIWtjFsQ7kNvwHHktEh&_nc_oc=AdpSp9JcTkyNyKDp24BKc7pnbzBb_QpnXHi7DOjCmNxJHGvBk4Q4_Arhs3HQCaNeMSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBbTTPxoGNmQ_r4k5fKgoBHKrrmk7_4VmRkE5XuN2hFQ&oe=6AA173EC"}, {"file_name": "Screenshot-4.png", "id": "446456401891707", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031367_446456405225040_4250019461371644870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4nQkj5XhWoQ7kNvwHtOR9C&_nc_oc=AdpiPIs3BtfluhQg4iUBOj2Uo6hEc6vHd3ZoYmCPMOeKj6CcKV6lMlEssyd2w8UooUY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuJhJboEEH9R85Z41jqoj3-jsbA7sYaGtEJ0XxMtvttw&oe=6AA17218"}, {"file_name": "Screenshot-5.png", "id": "483678121360260", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75593946_483678124693593_908879886942153661_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boH3v5zw6DsQ7kNvwHGdJJN&_nc_oc=Adp69ApC2B2YL3SGg_dmkhABaKfg6DNeWot4hxwpn6-6MoPEHq2J-2k-dCDezg4X4oU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyNd6BX0_mNebNQiEqYaR4CGfK6qLF4x4WmJsEKvdm6Q&oe=6AA14BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1741151056453595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036641_1741151063120261_1830140025688276344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvGRsn8SUMwQ7kNvwF_t5dd&_nc_oc=Adr97t8udPqEBemiP7DRo0H8-2JhrKZGl9NgCpb5NAbkH-b_5mAGl6PGOPvYeSjjH8Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITRU250ySz6LstjAkHhMVDxygYvJKZGDKhJ0ZZ1L9ldg&oe=6AA177B1"}, "display_name": "House Defender: Mixed Reality", "keywords": ["Defender", "Multiplayer", "Colocated", "Reality", "Adaptive"], "long_description": "# **\ud83d\udee1\ufe0f DEFEND YOUR HOME IN HOUSE DEFENDER**\n\nWelcome to **House Defender**, an auto-adaptive Mixed Reality game that turns your whole room into a free-roam playspace. Defend your walls from incoming monsters, walk freely around your space, take cover behind your furniture, and protect your home! Invite your friends to join in co-located or remote multiplayer - together, you are the last line of defense until dawn brings reinforcements.\n\n{1003399788755774}\n###\n## **\ud83d\udd2e TRANSFORM YOUR SURROUNDINGS INTO A PLAYSPACE**\n\nHouse Defender scans your room the moment you start. The game builds itself around your real walls and furniture, so no two homes play the same.\n\n{1810503556979280}\n\nThen your surroundings morph into the center of an enchanted, mystical forest. A wooden fence traces your real walls and marks the boundary you have to defend. Every wall and every object becomes part of your adventure.\n\n{955594050141634}\n###\n## **\ud83c\udf10 Multiplayer game**\n\n- **Co-Located Fun**: Defend your own room against monsters together with 3 friends in the same physical space.\n- **Remote Fun**: Virtually connect physical rooms and team up against monsters in the village square.\n- **PvP Mode**: Prefer competition over cooperation? Take cover behind your furniture and battle each other in a fully virtual world, co-located or remotely.\n###\n\n**Key Features:**\n\n- \ud83c\udfe0 **Room Adaptation and Transformation**\n- \ud83d\udc65 **Multiplayer**\n- \ud83d\udc7e **Updated Scenes, Power-Ups & Monsters**\n- \ud83c\udff9 **PvP and PvE Options**\n###\n\n**More from 2Sync:** \n\n-  Mixed Snow Worlds\n-  The Last Galaxy\n-  Elven Arrows\n\nFind more: **games.2Sync.io**", "short_description": "\ud83d\udee1\ufe0f Welcome to House Defender, an immersive Mixed Reality game that transforms your whole environment into a free roam VR playspace. Turn your surroundings into a village square under attack; defend your walls from incoming monsters, walk freely around your space, take cover behind your furniture, and protect your home! Invite friends to join in co-located or remote multiplayer gameplay or engage in PvP battles. Together, fend off the night & beat the highscore or stand alone against the night!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://2sync.io/housedefender-info/", "developer_terms_of_service_url": "https://2sync.io/housedefender-info/", "publisher_name": "2Sync", "support_website_url": null, "website_url": "https://games.2sync.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26737391869243802"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974910_558717967110447_3970654458799432800_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZht713e-pcQ7kNvwFwi1t3&_nc_oc=AdqkRjGHb2kIwZBJp-MVOzCMAZryJsqZMIg0Ucrhrfn6xEn9J8EarCkmFyUExG5AAMk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAJ_k6BKTLuSCbN4UjjsjGAfj2-3CwRyJNh4rjXiKRag&oe=6AA1637B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
6_jP&_nc_oc=Ado2FNlOZiUw9ShZMPZsGghRZxgdCjN1_7jMNOhuzU6mP9d0f5wZo91WL8AiqDns4RE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO625mIyaiHtJI3-_hOWWO74B4MScLrognGpVCI551lAw&oe=6AC7BD74"}, {"file_name": "Screenshot-3.png", "id": "579337661448505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031633_579337664781838_2302408592298151700_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGQGGXOwdHsQ7kNvwFl8-SU&_nc_oc=AdrBMB9XdXBe0jbZe6lgNr3DwiYTGLa4ETF1isPWKC6eTaQtiU9xt2EmlbmWVtwT2Ic&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaoZFoc8e3GAYZDsVRlQWZgP0YWJijl7K5aInIQRaIrA&oe=6AC7AF6C"}, {"file_name": "Screenshot-4.png", "id": "446456401891707", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031367_446456405225040_4250019461371644870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIxzV0AFabIQ7kNvwHLg-S_&_nc_oc=Adq4wyxBqGKMvcG_AiwFVnfFF_tOK3yTD_Kd6FUYGYgySDXOnmp1tFgAVadDh9Gq3YA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZkShwegB3bsaQHohtXWOfZvws-TwlMSRshha6sNuh2g&oe=6AC7AD98"}, {"file_name": "Screenshot-5.png", "id": "483678121360260", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75593946_483678124693593_908879886942153661_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLe6smz48tAQ7kNvwHOG9uK&_nc_oc=AdroFBNmzVDXuYoM5l1OVmDyb6WkmrMUSZIBpUmu7kkqE8qgzPdzFkupVxTZV-hCRhk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPrcPRMHV42H7KrouOelWLUfmZ9dW46pJ7YJJql0TgLw&oe=6AC7BF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HouseDefender_Thumbnail_v3.png", "id": "28925052737081235", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825415_28925052760414566_8250949761662714144_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWIgXr3cH2kQ7kNvwHoflZ_&_nc_oc=AdoxBQelWVN95b36zGKEm-c9JIsCooFAcCoi6CwJa6HdrhKt0wVZaUiQMUPghBmJmFc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrKblZdua8zyonPtwyPv3Meb9p709y-0yjPjEZ4RpE-g&oe=6AC7C8C8"}, "display_name": "House Defender: Mixed Reality", "keywords": ["Defender", "social", "scan", "wave", "multiplayer"], "long_description": "# **\ud83d\udee1\ufe0f DEFEND YOUR HOME IN HOUSE DEFENDER**\n\nWelcome to **House Defender**, an auto-adaptive Mixed Reality game that turns your whole room into a free-roam playspace. Defend your walls from incoming monsters, walk freely around your space, take cover behind your furniture, and protect your home! Invite your friends to join in co-located or remote multiplayer - together, you are the last line of defense until dawn brings reinforcements.\n\n{1003399788755774}\n###\n## **\ud83d\udd2e TRANSFORM YOUR SURROUNDINGS INTO A PLAYSPACE**\n\nHouse Defender scans your room the moment you start. The game builds itself around your real walls and furniture, so no two homes play the same.\n\n{1810503556979280}\n\nThen your surroundings morph into the center of an enchanted, mystical forest. A wooden fence traces your real walls and marks the boundary you have to defend. Every wall and every object becomes part of your adventure.\n\n{955594050141634}\n###\n## **\ud83c\udf10 Multiplayer game**\n\n- **Co-Located Fun**: Defend your own room against monsters together with 3 friends in the same physical space.\n- **Remote Fun**: Virtually connect physical rooms and team up against monsters in the village square.\n- **PvP Mode**: Prefer competition over cooperation? Take cover behind your furniture and battle each other in a fully virtual world, co-located or remotely.\n###\n\n**Key Features:**\n\n- \ud83c\udfe0 **Room Adaptation and Transformation**\n- \ud83d\udc65 **Multiplayer**\n- \ud83d\udc7e **Updated Scenes, Power-Ups & Monsters**\n- \ud83c\udff9 **PvP and PvE Options**\n###\n\n**More from 2Sync:** \n\n-  Mixed Snow Worlds\n-  The Last Galaxy\n-  Elven Arrows\n\nFind more: **games.2Sync.io**", "short_description": "\ud83d\udee1\ufe0f House Defender is an auto-adaptive Mixed Reality game that transforms your whole room into a free-roam playspace. Your surroundings become the heart of an enchanted forest: defend your walls from incoming monsters, walk freely around your space, take cover behind your real furniture, and protect your home! Invite up to 3 friends in co-located or remote multiplayer, or settle it in PvP. Hold the night together and climb the leaderboard, or face it alone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://2sync.io/housedefender-info/", "developer_terms_of_service_url": "https://2sync.io/housedefender-info/", "publisher_name": "2Sync", "support_website_url": null, "website_url": "https://games.2sync.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28355204630795843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_1440855001225340_4091804876840780470_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to6tMhY-UhwQ7kNvwEOjd-i&_nc_oc=AdqGaLNR-SN_j0jsLEBJDB8o0RC4HFGDqflZRCRvcrQ5OpCkYLm_XVFvSu77icP8Sd0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdt4NfmlC0oTljCPUU1bn5Il92lTBxVXxHIxBOH177sQ&oe=6AC7C789"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
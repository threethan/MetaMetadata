0", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825462_1370416114883523_5871775338386117265_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deEjYqq7mOAQ7kNvwGhL3Sy&_nc_oc=AdoQ3YJ5in5aZ-LdLeIgkwdQSDUlityMhZTGv2nlJmoCCbUPlLwiJY0ayaKKJt5HpFw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXt1YwAi7ZOmBELTfIr5jNXmlv9JEYA_BY9jeQOzKzBA&oe=6AF9CC8A"}, "display_name": "Trivia Master Quiz", "keywords": ["Trivia", "Quiz", "Knowledge", "Entertainment"], "long_description": "Welcome to Trivia Master Quiz, the ultimate app for trivia enthusiasts! Challenge your brain with hundreds of exciting questions across a wide range of categories such as history, science, entertainment, sports, and more. Whether you're playing solo or competing against friends, Trivia Master Quiz is the perfect way to test your knowledge and improve your trivia skills. With regular updates, fresh challenges, and a user-friendly interface, you'll always have something new to explore. Compete for the top spot on the leaderboard and prove that you\u2019re the ultimate trivia master!\n", "short_description": "Test your knowledge and become the ultimate trivia master with challenging questions from various categories!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
ls. With regular updates, fresh challenges, and a user-friendly interface, you'll always have something new to explore. Compete for the top spot on the leaderboard and prove that you\u2019re the ultimate trivia master!\n", "short_description": "Test your knowledge and become the ultimate trivia master with challenging questions from various categories!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28843057291956695"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_2735781620152654_9057964283668841194_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66jGnwMEV0QQ7kNvwG1ReLy&_nc_oc=Adq42d21viW2bSLqzbic_wPoqOUIsp_xPLvsrJKcYhat0m-pTdIw-ouhwpZsmdTqMvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcVpTQR9NgQIhIzgGg2nj_SeEsZLJVlMvim9Q2wkYbng&oe=6ACE3C79"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trivia Master Quiz", "platform": "ANDROID_6DOF", "context_category":
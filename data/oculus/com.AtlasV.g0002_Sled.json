c_sid=6e7a0a&_nc_ohc=5z4SYGy6mHAQ7kNvwFuGg9_&_nc_oc=AdmMUJsHE33TzpjE7vdeefpvil_3YFOP4o2C2aC7TvwMYm8j3hjViY4ySk55e7vot6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv2E4Mw0DIwUOev7bpHZ6kbmIFg-e0et8Tf7hcHPaso5A&oe=69A43ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR9snFu5M5QQ7kNvwFSZIyO&_nc_oc=Adljum--WmWYFWx4iKkSkzskqryHNdkayPAdGOmuSzbiDMy-3ojKpI8kOtEnw0hemhA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuph18pAjVF3AKrHQmppE0aQpOnDU3r0pwYIqKDpsreqg&oe=69A41881"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1u3muvTimii6xMPxnK5I2MxLCsxQ__XVp_7KeisPS0x4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25723872687251568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1380238286784316_8499167186787287680_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPQ-qUINKyIQ7kNvwGX-pmd&_nc_oc=AdnewnH91CmodnNhltIPNlrcopaLTU9l5ORPejSyoZwHuWXve2EE05ZtmeoQCYagkrw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs64qh0zCd2P0FjHaWs_nvtV5opEQWC5X45Xj26RH47Pg&oe=69A44010"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GO SLED", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1769160900, "lastRevision": {"nodes": [{"id": "25197715909867251", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application
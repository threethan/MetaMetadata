1136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5viuj2xc00Q7kNvwHIXBCG&_nc_oc=AdlmB6mSCzWI3rataMswZ9m3m--j-W96Yarhkd4iPcewW1_X_BIZ_NZVm6uzZcehQx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXgfNz4IsCzDNIZQ8-5ALdal2zzXd0rJY8MTBC_8B7gw&oe=69B410DC"}, {"file_name": "Still 4.png", "id": "4137999043121259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_4137999046454592_7821921244203548677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsO-KaThUv4Q7kNvwGxngoy&_nc_oc=AdkeJOPGyc0iBjT4JFPdv1wAvoYHe69UhIkDsRDGn7Uxoh1rDxXTZp2wLhXNldaImfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxje7KRBXCeoVbD0XYlVW_Y1tmzfgcbRhhD_eyi6vAXYw&oe=69B410D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgqXl0cbpBcQ7kNvwHpUz4-&_nc_oc=AdklRLkfM-oOeSys1UhTzb-ryQYM98rD0f_mhAALTVMt6FoGJYRe2Cuvo5CBBpLfq3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxY_f07jhudE-3QWsI99tDQs0bIZ3vvE9-GSvEo4_Zw6w&oe=69B3EA81"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1u3muvTimii6xMPxnK5I2MxLCsxQ__XVp_7KeisPS0x4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25723872687251568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1380238286784316_8499167186787287680_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGyy5SMjN3gQ7kNvwGdeTcK&_nc_oc=AdnMBbqtXahh5ztzHg1vRKif2nF7hax98ygJGAilWwz_hw_WgPXGAiJ7SBgfmjji-T4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKBhFEwNva2uCJJk8i2tF1L0ndqn5u5NHs97PtzPFsfA&oe=69B41210"}, "is_concept": fal
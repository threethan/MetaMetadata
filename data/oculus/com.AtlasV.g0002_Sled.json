tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxpz_mIDJSPhgSNE_-zJqxF_FE2akSHaFuzakdN61L9A&oe=6AAFDF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLa_0MjIsG0Q7kNvwG1qwFz&_nc_oc=Adpj31XNjdIHTRFjEoibXdWzZyGaqqQjx0TvUnYdHadOsjDR3i0hsT5NOpJdFGUbQiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMjDBRUU2jx7tUw2f7CylEzOjwoKGfUqZ26lgYmRROxQ&oe=6AAFF141"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https:/
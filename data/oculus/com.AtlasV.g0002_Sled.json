331D"}, {"file_name": "Still 5.png", "id": "892356749956453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_892356753289786_5126782951051959018_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvveApUe7ZAQ7kNvwFdIXAs&_nc_oc=AdpNPnrNF_FhgZAuLPz_jUpO-fTv3PzG3CytOTqh5r4aK1Vp3eNZ4U2zq8Z9aPoe8AM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6_DWjynXL0TspL-YDya7jD1XOshLNR_GrvN89XVwxiA&oe=6B030B08"}, {"file_name": "Still 3.png", "id": "4275073879479018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819845_4275073882812351_798253898859181136_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9NDRXzz3-UQ7kNvwHK4jFS&_nc_oc=AdrxL_uhijT0KWQlabAZJBs8kkibxNv0qT94EbIEZ3pV9c98naZclwhP_VVkNuxZ68I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7TNXuy9u9CA3PVRvUeVTWVxgL234iNDOGHk0HKfwwXw&oe=6B03261C"}, {"file_name": "Still 4.png", "id": "4137999043121259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821719_4137999046454592_7821921244203548677_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK2ijlrqWtEQ7kNvwFD6RAq&_nc_oc=AdpOnOOokozd8AwiaJb3XcODmtxlazY7RofGSwxJU6TzhmFXAjt1Ad2rpYM78QuuNjc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzvayqCr1IJe4Skvu6GwuX5vUT2bfTOnnQLd-1uQsI5w&oe=6B032610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h1elj40Lh4Q7kNvwHF2A-B&_nc_oc=AdoYHHu69glRaoJO7iUQjFoDNHfrHOhrJI6VKt3MtJVK1HL0n1nEPhIozucC9ZsxH5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJgWnUvUOPM1uXx1zfAziQgh3avGa-5s8tSweLLsPo-A&oe=6B033801"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure!! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1u3muvTimii6xMPxnK5I2MxLCsxQ__XVp_7KeisPS0x4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
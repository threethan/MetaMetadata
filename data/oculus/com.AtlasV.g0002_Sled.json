scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeZIrfGqW4987-IMDk69AeVSaI8ER0otPIVrYDMlm9nw&oe=6A4FBF08"}, {"file_name": "Still 3.png", "id": "4275073879479018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_4275073882812351_798253898859181136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3iAP9rmPzcQ7kNvwGd1ckA&_nc_oc=AdoRWW3s9lU3i1TyMjTWFFS3xwPiRZMHru6TMNoalXSe8JUyZ9zY7VFMCtCsU48fgTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-UbjyR9rTzQFKzY-YKArIC_qLjoix_-Bebsk7mjIGNA&oe=6A4FA1DC"}, {"file_name": "Still 4.png", "id": "4137999043121259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821719_4137999046454592_7821921244203548677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHss2-l05X0Q7kNvwFMG9Qg&_nc_oc=AdriT1ClV76tDxu1UNZKizQ_a1Ci_E2UEiWiks0GSVjyH0mqLVoGNJIYOabeGMN6EDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFkA0VRH48GRojEtKg0yTfJN1OFyB8UgxjZMNYwXzYmw&oe=6A4FA1D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twh5NLJt9GEQ7kNvwFLmf1A&_nc_oc=Adr8GkHKcwVr9a-PZ8M4qYx51S-kMdLHcOme0RpEzNzfDa_v1ydEbNRtUQn9Dz4S8go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEhu1Q0sduqL4fmxozmbbFEw-4W-NxBu0RaCrUz-j8JQ&oe=6A4FB3C1"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure!! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1u3muvTimii6xMPxnK5I2MxLCsxQ__XVp_7KeisPS0x4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26695663883405772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_1380238286784316_8499167186787287680_n.png?stp=dst-png_s360x360&_n
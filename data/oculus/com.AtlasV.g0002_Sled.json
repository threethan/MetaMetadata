E19D"}, {"file_name": "Still 5.png", "id": "892356749956453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_892356753289786_5126782951051959018_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvveApUe7ZAQ7kNvwH1dlWh&_nc_oc=AdqmTPjSdqFO94hH35h10CmS23I2tpkjEZ_pfdO64C8-askPr202nQyPY0pn9MWfyNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVpSN9ZK9Cl6OUFLdpa15ul0hBAgArUL8RB4ertA4VwA&oe=6B01B988"}, {"file_name": "Still 3.png", "id": "4275073879479018", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_4275073882812351_798253898859181136_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9NDRXzz3-UQ7kNvwHhmcoP&_nc_oc=Adp8HEMvZ693TkzWTP4FtoFdkpQCo4QzkGN6y9-Y2ENd-5IJtH8dHWp0VTmb6ZAlr7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-6oRemwCzx0THJTt3UWTnyNr9F1KPVqEWmt2WaSyFzA&oe=6B01D49C"}, {"file_name": "Still 4.png", "id": "4137999043121259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_4137999046454592_7821921244203548677_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhflaE9S8-oQ7kNvwEIybuz&_nc_oc=Adogw0sAlZv6AVQ0p7mwFKRlSYnI4Qg2-44QPnJy6ZwSVRAkwF-MvHnwtOvuCwx1MDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-bxFX__U_xdJA-WbURQ4XWOO_0wphDssay0Dlfhzk-A&oe=6B01D490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1584536842700271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1584536849366937_1561324889580182229_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZQR3WeySwIQ7kNvwFlE18z&_nc_oc=Adp7fcJ_sVlRboNVKCRGCG9d5UtFIgc2rG_pYcyrtAeW-RwlQlN-MaCt5b7IdRw3RI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgbZW4qspC-RsjymU7ojs2I8ZnMuaFHLF4YNU-M7MDbg&oe=6B01E681"}, "display_name": "GO SLED", "keywords": ["snow", "simulator", "hard", "fast", "easy"], "long_description": "# Welcome to GO SLED, the ultimate VR snow-sliding adventure! \ud83d\udef7 \n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground. \u2744\ufe0f\n\n{1182643857181499}\n\n**\ud83c\udfd4\ufe0f Explore the mountain**\n\nIt's a generated map! You can go down as much as you want and the mountain never ends.\n\n**\ud83d\udcb0 Collect gold coins**\n\nGrab coins along the way to upgrade your stamina, letting you ride longer, faster, and reach places you couldn\u2019t before.\n\n**\ud83d\udcaa Move to go further**\n\nThe more you move, the better you get. Master your rhythm, improve your control, and beat your own distance records.\n\n{3861200294179911}\n\n**Ready to hit the mountain?**\n\n# GO SLED and see how far you can go! \ud83c\udfd4\ufe0f\ud83d\udef7\u2744\ufe0f", "short_description": "Welcome to GO SLED, the ultimate snow-sliding adventure!! \u2744\ufe0f\ud83d\udd25\n\nUse your own arms to push, steer, and balance as you glide across snowy slopes. Feel the speed, carve through the mountain, and choose your path as you explore a huge winter playground! \ud83e\udd76"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1u3muvTimii6xMPxnK5I2MxLCsxQ__XVp_7KeisPS0x4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
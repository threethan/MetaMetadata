m/v/t64.5771-25/39031311_1585179185734649_6259788170056223684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z9Xc9NbOrsQ7kNvwFAkxyd&_nc_oc=AdlThDiMT-e7K8HaBWU4weSwiGbPWiBB5UQF8zs_3na3y29KoOHCetCj0NlniqeKWI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvr_ruL7iGL8lYs22kG0wOdAOmDN58CTknWqSHBi7kKzA&oe=699EDE1C"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-D.png", "id": "1040820731103519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031520_1040820734436852_2630175888948368127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXGTk52AFRUQ7kNvwH2CS5R&_nc_oc=AdmKzbYocAYd--eCJ4_LmhG58fKmzawa7AZuz5OxXhGsXtSdeTuLNjHBW0Z77dApWSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftfByo-grfUjXJfJ8HzorvQvfTDkMQ3JVjbGDk5r24MSg&oe=699ED717"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-C.png", "id": "464293093314221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001716_464293103314220_7458247761058935610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVC84_WV3N4Q7kNvwHy8xOu&_nc_oc=AdkcujQ_atF-V8gQ3ks884dB8ETdeuW93tIzHIkmoAi_N8ylg7sANThTD5AMFvQhSV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftCRUhMOrgrnUvhslkxY_o3r8T9mSpe6e3JWFXgLNUQ0w&oe=699EDE6A"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-E.png", "id": "1170006480764312", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031554_1170006484097645_9020323073914640105_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JhSqVboeqAQ7kNvwEWkz_S&_nc_oc=Adnoq8gigJ4XgBkL0fRSXDkcaCFUba2IBOKEokYfyvlKYlSPK8uGNfFN4EPMaGYpkqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs1sKtXAEkZTpbCY6STQIgc7nZY9ks_woTlPlW5nSn2RA&oe=699EFB0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-HIS-Launch-Meta-CoverLandscape-2560x1440.png", "id": "1056491915969020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982508_1056491919302353_928230977686461611_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IIUhiCFWjMQ7kNvwGEw7T1&_nc_oc=AdmcdUi1P99NHO1eS3GJEhhvAUhOAMJdn9ktMmVFLAitwQ8PlGbu4bIBCItv2gPw4x8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMJsq33h3zPP3wqYrScteR3HMNcFSpBKjTboZhEjjOVg&oe=699EFB52"}, "display_name": "Home Invasion", "keywords": ["horror", "zombie", "mixed", "reality", "shoot"], "long_description": "**Home Invasion is a standalone version of the Drop Dead: The Cabin experience. If you already own The Cabin, there\u2019s no need to purchase Home Invasion, as it offers the same mixed reality gameplay.**\n\nImmerse yourself in the award-winning Home Invasion Mixed Reality Experience, where you'll be plunged into a heart-racing, adrenaline-fueled scenario that will test your wits and survival instincts like never before. Prepare to defend yourself as relentless waves of zombies and terrifying monsters break through your walls, crash through windows, and invade your real-world environment.\n\n{515675507961457}\n\n# Unmatched Realism:\n\nThe power of mixed reality technology makes you feel like you're truly trapped in your house with hordes of Zombies breaching walls and windows.\n\n{1017209083427396}\n\n# Unpredictable Zombie Invasion in Your Home:\n\nFace off against zombie home invaders who will stop at nothing to terrorise and eliminate you. Choose a difficulty level and see how long you can last against an unstoppable, and escalating invasion.\n\n\n{872071455055210}\n\n# Innovative Gameplay + Weapons:\n\nA variety of weapons can be used to defend yourself from the horde, from common household items such as plates, pans, and bottles to more advanced weapons like fully automatic firearms earn more as you progress through the waves.\n\n{964802888743704}\n\n# Spectacular Graphics:\n\nHome Invasion showcases cutting-edge graphics that blur the lines between reality and the virtual world, ensuring an unforgettable and spine-chilling experience.\n", "short_description": "Immerse yourself in the award-winning Home Invasion Mixed Reality Experience, where you'll be plunged into a heart-racing, adrenaline-fueled scenario that will test your wits and survival instincts like never before. Prepare to defend yourself as relentless waves of zombies and terrifying monsters break through your walls, crash through windows, and invade your real-world environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy/", "developer_terms_of_service_url": "https://soulassembly.com/terms-of-service/", "publisher_name": "Soul Assembly", "support_website_url": null, "website_url": "https://soulassembly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "de", "fr", "es", "it", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "7984334071631068"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1421656499596312"}, {"status": "PUBLISHED", "id": "1422537186152462"}, {"status": "PUBLISHED", "id": "840083595018961"}, {"status": "PUBLISHED", "id": "1306124671235561"}, {"status": "PUBLISHED", "id": "680222565017307"}, {"status": "PUBLISHED", "id": "4122248741433783"}, {"status": "PUBLISHED", "id": "954809616268466"}, {"status": "PUBLISHED", "id": "1098309694980566"}, {"status": "PUBLISHED", "id": "447867051175609"}]}, "baseline_offer": {"id": "447867051175609"}, "is_approved": true, "firstOffer": {
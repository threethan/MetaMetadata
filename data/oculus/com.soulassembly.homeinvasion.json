m/v/t64.5771-25/39031311_1585179185734649_6259788170056223684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdlKy7hJ9M4Q7kNvwE0NXQk&_nc_oc=Admp4bdXlsOqMC1ncfsTZHUrMIGN7H6jUGfZlBHlAdWMpzZgx8c0nK-yzHArwsZE0bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afskaj4Gu7DEd0WL5bZxaTuCOMURkl72ZB-JNgePp07hoA&oe=6999981C"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-D.png", "id": "1040820731103519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031520_1040820734436852_2630175888948368127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBeqDeIF8goQ7kNvwGbbiUF&_nc_oc=AdkodXZw8SKvPfWLWWjfEUtdAzWVmdGWJ_hYm4sjcSJPSyUesEuTdHI2bW2GYQ7aslE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQJ6LthLLq33Y_x48yCNEJUf6Bxu16Es-RdSl_T8-gzg&oe=69999117"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-C.png", "id": "464293093314221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001716_464293103314220_7458247761058935610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvstGPQA_eAQ7kNvwG4vRg7&_nc_oc=Admz-Y2t7HoWjRPk8l2vz4t_MB6mUAJ1zwJkPbk_iSuewndeaQW7A5z6GKh8nlozEuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjtM1ylE0oO1J2PPpYM2BG8j4RNomLUQJOA6qDZah3XA&oe=6999986A"}, {"file_name": "SA-HIS-Launch-Meta-Screenshot-2560x1440-E.png", "id": "1170006480764312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031554_1170006484097645_9020323073914640105_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh46ypuRrL8Q7kNvwGpTxDY&_nc_oc=Adncknq_at5W54zddMn4hV2nRCYRP1muKj5XD_Mj8VNjOSw99kVYq3orrqEpiYanBuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGqpuWqhubg9x2gn6QE2PfjTwcuamX6aGp9a7OMCWwpg&oe=6999B50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-HIS-Launch-Meta-CoverLandscape-2560x1440.png", "id": "1056491915969020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982508_1056491919302353_928230977686461611_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wANh0eVxVZQQ7kNvwEAvYDq&_nc_oc=AdmA8xPJkav3ErQcT6lFl3Muow76kRgiCzE1v0Q8b5g4ZHSVxscGlRUszgYiwKRadjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3pgL7Cj0iVoOJLZStG95lHQwZpXTKaKB0mZKvIZAQqA&oe=6999B552"}, "display_name": "Home Invasion", "keywords": ["horror", "zombie", "mixed", "reality", "shoot"], "long_description": "**Home Invasion is a standalone version of the Drop Dead: The Cabin experience. If you already own The Cabin, there\u2019s no need to purchase Home Invasion, as it offers the same mixed reality gameplay.**\n\nImmerse yourself in the award-winning Home Invasion Mixed Reality Experience, where you'll be plunged into a heart-racing, adrenaline-fueled scenario that will test your wits and survival instincts like never before. Prepare to defend yourself as relentless waves of zombies and terrifying monsters break through your walls, crash through windows, and invade your real-world environment.\n\n{515675507961457}\n\n# Unmatched Realism:\n\nThe power of mixed reality technology makes you feel like you're truly trapped in your house with hordes of Zombies breaching walls and windows.\n\n{1017209083427396}\n\n# Unpredictable Zombie Invasion in Your Home:\n\nFace off against zombie home invaders who will stop at nothing to terrorise and eliminate you. Choose a difficulty level and see how long you can last against an unstoppable, and escalating invasion.\n\n\n{872071455055210}\n\n# Innovative Gameplay + Weapons:\n\nA variety of weapons can be used to defend yourself from the horde, from common household items such as plates, pans, and bottles to more advanced weapons like fully automatic firearms earn more as you progress through the waves.\n\n{964802888743704}\n\n# Spectacular Graphics:\n\nHome Invasion showcases cutting-edge graphics that blur the lines between reality and the virtual world, ensuring an unforgettable and spine-chilling experience.\n", "short_description": "Immerse yourself in the award-winning Home Invasion Mixed Reality Experience, where you'll be plunged into a heart-racing, adrenaline-fueled scenario that will test your wits and survival instincts like never before. Prepare to defend yourself as relentless waves of zombies and terrifying monsters break through your walls, crash through windows, and invade your real-world environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy/", "developer_terms_of_service_url": "https://soulassembly.com/terms-of-service/", "publisher_name": "Soul Assembly", "support_website_url": null, "website_url": "https://soulassembly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "de", "fr", "es", "it", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "7984334071631068"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1421656499596312"}, {"status": "PUBLISHED", "id": "1422537186152462"}, {"status": "PUBLISHED", "id": "840083595018961"}, {"status": "PUBLISHED", "id": "1306124671235561"}, {"status": "PUBLISHED", "id": "680222565017307"}, {"status": "PUBLISHED", "id": "4122248741433783"}, {"status": "PUBLISHED", "id": "954809616268466"}, {"status": "PUBLISHED", "id": "1098309694980566"}, {"status": "PUBLISHED", "id": "447867051175609"}]}, "baseline_offer": {"id": "447867051175609"}, "is_approved": true, "firstOffer": {
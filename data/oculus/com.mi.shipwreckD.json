_AQQfzkmNlJWk87HOFh8OkuxMaq1k5f8TQEYqf9Veo1UW6A&oe=6B032084"}, {"file_name": "09_fish_school.png", "id": "979989987906306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604375581_979989991239639_6319776894855722114_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo0eTPJLF4cQ7kNvwF8CyeP&_nc_oc=AdrKFWuG4AcQbPBNzoLbDRcsxSLg0rWHavaxKv19mfWltu4UAlsv1GOEVCcH2hI0Ljs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsW6iK-W0wx_MSFZ5Hlz7ABtaqcb22FNBn_DWIwj6p4A&oe=6B032146"}, {"file_name": "12_dive_boat.png", "id": "2084170168899067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_2084170172232400_708890952565725936_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dx7qkrq6oMQ7kNvwFRY0O3&_nc_oc=Adr3vI8zVIw-ciyKGrJzjwKoEofpz3PsYUnDVs--iTnc8YfmI9tis2hqNQCNL9YcWsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQB9K75lH7NVoVqs9rL6Uq0iGFvbWz-Mcs_1B2ORBVug&oe=6B030D6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shipwreck_Discovery_1.0_Trailer_cover_keyart.png", "id": "1342412147852835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595121610_1342412151186168_6426847029309576908_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Kp2xfKQ98Q7kNvwHP3LHv&_nc_oc=Adpp80IcF-2mTgiBbOdgmT5bKlT-6fcMHtWs4JyvZhhCgfwgTGO9IEcvuN6sSg2zVig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-5q6LF9jLKiDoqCd0y0tKCdTX3IbU-_gIsWEoVDEEdw&oe=6B031845"}, "display_name": "Shipwreck Discovery", "keywords": ["Underwater", "Exploration", "Immersive", "Atmoshperic", "Casual"], "long_description": "Lionfish are invaders, and they are eating real reefs. One lionfish on a small patch reef cut native young-fish recruitment by about 79% in five weeks (Albins and Hixon, 2008). In Shipwreck Discovery you get in the water and fight back.\n\nEvery level starts murky and overrun with 70 to 100 lionfish. Spear them and drop them in the ZooKeeper tube; fill it for a 100 ReefCoin reward and spend it on better gear. Burn algae off the hull with the laser cleaner. Pull trash off the sand and plant coral that grows in real time across your visits.\n\nNew in 1.0: race the BlackTip scooter in Scooter Run on the SS United States, and dive her \"Her Last Voyage\" museum route with narration and history photos. Follow the treasure map and sweep the sand with a metal detector. Cut turtles and other animals free of ghost nets with your dive knife. Swim with your own arm strokes.\n\nScan the animals you meet into your Aquapedia, narrated by marine scientist Dr. Steve Gittings. Watch the reef respond: clearer water, safer corals and fish coming back. Each new wreck unlocks as the last one thrives.\n\nMade by Lionfish Central, a marine science nonprofit. A portion of every purchase supports its work.", "short_description": "Dive real shipwrecks off Destin, Florida. Every level starts with 70 to 100 invasive lionfish. Spear them, burn algae off the hulls, race a scooter around the SS United States, cut trapped animals free and grow coral that keeps growing between dives. Guided by marine scientist Dr. Steve Gittings. Single-player VR."}]}, "developer_name": "Shipwreck Discovery", "developer_privacy_policy_url": "https://shipwreckdiscovery.com/privacy-policy/", "developer_terms_of_service_url": "https://shipwreckdiscovery.com/terms-of-service/", "publisher_name": "Scott Gonnello & Ian Mclennan", "support_website_url": "https://shipwreckdiscovery.com/survey/", "website_url": "https://shipwreckdiscovery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
eck Discovery Cover-new.png", "id": "806467051885124", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_806467055218457_2675308940995680782_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwIgzTHcsgMQ7kNvwF9dROM&_nc_oc=Adqluva_R2lK5WRGtik_ufXWnhG1vCQg0B6cCyujdOhTXBUVcOOJXCGv2m2se2ZqBho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_5kPdaBJzoiFtepIoWnqeRdWwRXi0KpIPqSNmD_P09w&oe=6AEA106D"}]}, "id": "906551902179172", "locale": "en_US", "screenshots": [{"file_name": "Brannon Dylan.png", "id": "1275724401396898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1275724404730231_6179352531544884538_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_duFIag3KcQ7kNvwHh_2rB&_nc_oc=AdodkXGJ9cL9HYVfFu23HHKVZTL_Mij5dG67u5SEifvKovCnTEJPWAPdzr26n1PQPRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdj3Z_VbZl_drA0YygDJp34tUi3eVzkm1NUzhRnSXwHg&oe=6AEA0E4D"}, {"file_name": "Big Dawg.png", "id": "1637432580611941", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596139439_1637432587278607_5217679876757287266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfbn1An-i4QQ7kNvwG20LC7&_nc_oc=Adpkw6O4cn8BK5Se2adtNK6n5YLmluyoBuax-YuFWVj_UdU3V_eau9GearuxT7xT_4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ501M-NfbyYR-9JLM6AKtwEZ1JI991u7cz4DCL8UFhVw&oe=6AE9EC11"}, {"file_name": "Atlantis 1.png", "id": "1565448491384132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308330_1565448498050798_3052226001836431765_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCChOj7uCHAQ7kNvwEUZEWH&_nc_oc=AdpG5z1RMVRaTnoQUFzJ3Rl5fblV8BkoNb-g3kEWk5_H_ZCkXiocTSHvb69AwQoqkqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBkwF1UeHcHbggoica1a21WbllOo1jnxCjDcge7Jb_gg&oe=6AE9F632"}, {"file_name": "Atlantis 2.png", "id": "1624378338893515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1624378342226848_2767482109128636871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzFK95-HV4Q7kNvwEcIBR3&_nc_oc=AdqWoiuqvnPpWTcecdGflIumw-mnql2TvQiKU2MAGLRzXC6kOrKz1AXMQ0zg2yvYt0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcy7dBTVU8bJxUAbHFkcmP388WhrPt1KSQv7kjKo_cdg&oe=6AEA04EF"}, {"file_name": "Shipwreck Discovery Samples MV Brannon.png", "id": "2229043504527722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_2229043507861055_5072757831850558380_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwCw3kFG5hgQ7kNvwFk79Wx&_nc_oc=AdrwzLVejy5eIjOSVAQ0eoDHGk6qrwvd0fjBGNJeTBXSsXE90sBVkECs6RN65uIBCgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbSiZcRyYUzFuvfbBOcNZfz4F9MsJ3A1ggOKHX3f0nTg&oe=6AEA027D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Shipwreck Discovery Cover-new.png", "id": "2144925642713198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2144925646046531_7173866982319123348_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTwJDHBiK3gQ7kNvwG1z2fY&_nc_oc=AdqqpoSz1NpY_YwWKI35TIs5DWzaJzzZdTdFiWmCNwj_23B-sKcIEPH0o5k9w9V2Px8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0vmRjASWaElrCUAdMOosfT8qyog5AM0wYE1M9h1TRPQ&oe=6AEA0E92"}, "display_name": "Shipwreck Discovery", "keywords": ["diving", "shipwreck", "simulator", "educational", "casual"], "long_description": "**Explore Real Shipwrecks in Immersive VR**\n\nDescend into the ocean and explore full-scale, real-world shipwrecks brought to life in stunning VR. Shipwreck Discovery lets you experience the thrill, mystery, and beauty of underwater exploration without tanks, training, or risk. Every site is recreated with meticulous detail, allowing you to swim through towering hulls, narrow passages, and open seascapes exactly as they exist in the real world.\n\n **Discover, Learn, and Uncover Hidden Stories**\n\nMove at your own pace as you identify wreck features, reveal their history, and scan marine life to unlock videos and insights that deepen your understanding of the ocean environment. Dynamic conditions\u2014visibility, currents, hazards, and surface waves\u2014ensure each dive feels unique, whether you want a calm, meditative dive or a challenging, skill-testing environment.\n\n**Dr. Steve Gittings, The Voice of Shipwreck Discovery**\n\nYour journey is narrated by world-renowned marine scientist Dr. Steve Gittings, whose expert commentary transforms each discovery into an engaging lesson in ecology, history, and conservation. Learn how wrecks evolve over time, how marine species inhabit them, and why these underwater landmarks matter.\n\n**For Divers and Explorers Alike**\n\nWhether you're preparing to dive this shipwreck in Destin, Florida for situational awareness or an explorer seeking a memorable VR adventure, Shipwreck Discovery delivers an exciting and immersive dive into the hidden world beneath the waves.\n{26337235402562744}\n{1473396051027504}\n{1233735025494662}\n{1238990201687804}\n{3345158942306321}\n{1095158496101430}\n{1093914602900161}\n{1412201300097311}\n{1647709646258335}\n{1738922180820514}", "short_description": "Legendary Ocean Explorer and Marine Scientist Dr. Steve Gittings is your in-game guide as you explore beneath the waves, turning every wreck into an expedition. \n\nDiscover full-scale, real-world shipwrecks in stunning VR and experience the thrill that, until now, only divers could feel. Descend onto the wrecks,  scan the fish and marine life, get stung by lionfish and more.  A unique blend of exploration, realism, and underwater adventure. The closest thing to diving without getting wet! "}]}, "developer_name": "Shipwreck Discovery", "developer_privacy_policy_url": "https://shipwreckdiscovery.com/privacy-policy/", "developer_terms_of_service_url": "https://shipwreckdiscovery.com/terms-of-service/", "publisher_name": "Scott Gonnello & Ian Mclennan", "support_website_url": "https://shipwreckdiscovery.com/survey/", "website_url": "https://shipwreckdiscovery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34636250909322172"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3069730433220247"}, {"status": "PUBLISHED", "id": "949767944108675"}]}, "baseline_offer": {"id": "949767944108675"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "3069730433220247"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39870404955906715", "version": "1.1.20"}, "id": "1504061977373097", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32767209856226296", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39870404955906715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1504061977373097"}]}, "change_log": null, "created_date": 1793221456, "id": "39870404955906715", "version": "1.1.20", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "
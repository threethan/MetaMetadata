3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiSV8F_lPY4i8tI3HA3-LbOa3TYTfqt05vzYnnkshp_Q&oe=6B030EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Shipwreck Discovery Cover-new.png", "id": "2144925642713198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_2144925646046531_7173866982319123348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_Ibe6TBCosQ7kNvwE29XHE&_nc_oc=AdpSmNr1OVvqjCJIAZfX96uqD8uTyiJ4L25pl7oW0D5a7hnYNiKsomPRMCRrKHO6rgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrZBogYJHS3QP-Aav9EFFSEN0WyqlbsOpZMf1s1Uy67g&oe=6B031B12"}, "display_name": "Shipwreck Discovery", "keywords": ["diving", "shipwreck", "simulator", "educational", "casual"], "long_description": "**Explore Real Shipwrecks in Immersive VR**\n\nDescend into the ocean and explore full-scale, real-world shipwrecks brought to life in stunning VR. Shipwreck Discovery lets you experience the thrill, mystery, and beauty of underwater exploration without tanks, training, or risk. Every site is recreated with meticulous detail, allowing you to swim through towering hulls, narrow passages, and open seascapes exactly as they exist in the real world.\n\n **Discover, Learn, and Uncover Hidden Stories**\n\nMove at your own pace as you identify wreck features, reveal their history, and scan marine life to unlock videos and insights that deepen your understanding of the ocean environment. Dynamic conditions\u2014visibility, currents, hazards, and surface waves\u2014ensure each dive feels unique, whether you want a calm, meditative dive or a challenging, skill-testing environment.\n\n**Dr. Steve Gittings, The Voice of Shipwreck Discovery**\n\nYour journey is narrated by world-renowned marine scientist Dr. Steve Gittings, whose expert commentary transforms each discovery into an engaging lesson in ecology, history, and conservation. Learn how wrecks evolve over time, how marine species inhabit them, and why these underwater landmarks matter.\n\n**For Divers and Explorers Alike**\n\nWhether you're preparing to dive this shipwreck in Destin, Florida for situational awareness or an explorer seeking a memorable VR adventure, Shipwreck Discovery delivers an exciting and immersive dive into the hidden world beneath the waves.\n{26337235402562744}\n{1473396051027504}\n{1233735025494662}\n{1238990201687804}\n{3345158942306321}\n{1095158496101430}\n{1093914602900161}\n{1412201300097311}\n{1647709646258335}\n{1738922180820514}", "short_description": "Legendary Ocean Explorer and Marine Scientist Dr. Steve Gittings is your in-game guide as you explore beneath the waves, turning every wreck into an expedition. \n\nDiscover full-scale, real-world shipwrecks in stunning VR and experience the thrill that, until now, only divers could feel. Descend onto the wrecks,  scan the fish and marine life, get stung by lionfish and more.  A unique blend of exploration, realism, and underwater adventure. The closest thing to diving without getting wet! "}]}, "developer_name": "Shipwreck Discovery", "developer_privacy_policy_url": "https://shipwreckdiscovery.com/privacy-policy/", "developer_terms_of_service_url": "https://shipwreckdiscovery.com/terms-of-service/", "publisher_name": "Scott Gonnello & Ian Mclennan", "support_website_url": "https://shipwreckdiscovery.com/survey/", "website_url": "https://shipwreckdiscovery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34636250909322172"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3069730433220247"}, {"status": "PUBLISHED", "id": "949767944108675"}]}, "baseline_offer": {"id": "949767944108675"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "3069730433220247"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40381124334834772", "version": "1.1.22"}, "id": "1504061977373097", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32767209856226296", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40381124334834772"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1504061977373097"}]}, "change_log": "Version 1.1.22\n- When something stings or bites you, the edges of your view flash red.\n- Touching a lionfish always stings, even in a crowd or while you swim.\n- A hit pushes you away from what hit you, not up or down.\n- When you black out, your view fades all the way to black, and stays closed for a moment on the boat.\n- Nothing can hurt you while you're being brought back to the boat.\n- Laser cleaner: fires exactly where its scanner points, and cleaned algae no longer grows back.\n- Treasure map: sits in your hand the way you pinch it, and your glove, wrist and watch stay with it.\n- Reef Fortune slot machine: the lever pulls every time, goes all the way down, and your hand stays visible.\n- Aquapedia: opening your first fish card no longer stutters.\n- Dive computer: the wrist screen always shows your last tap.\n- A swim stroke needs a real pull, so letting your arms settle back no longer drifts you around.\n- Trips between the boat and the wrecks pause less while the next dive loads.\n- Pressing Return to Dive Boat twice no longer gets in the way of the trip back.", "created_date": 1794865877, "id": "40381124334834772", "version": "1.1.22", "version_code": 217, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32767209856226296", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40381124334834772"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1504061977373097"}]}, "change_log": null, "created_date": 1793478990, "id": "39951833857763824", "version": "1.1.21", "version_code": 216, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32767209856226296", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40381124334834772"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1504061977373097"}]}, "change_log": null, "created_date": 1793221456, "id": "39870404955906715", "version": "1.1.20", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "Andro
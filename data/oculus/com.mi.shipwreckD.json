/491831279_2084170172232400_708890952565725936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kIl-jdyvAMQ7kNvwHYnvtC&_nc_oc=AdrbgMvMN2agC_hSWj_Umkal_tG2YPKDniIRG0srC6lMDBNgO99Gt7XMRJAcPZVeL9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMvnooJDVfThOBv8e-VOq5LiKmBZ121XVGRdznGCbaDw&oe=6AEA00EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shipwreck_Discovery_1.0_Trailer_cover_keyart.png", "id": "1342412147852835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595121610_1342412151186168_6426847029309576908_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDPagBEbb1QQ7kNvwHBCeTu&_nc_oc=AdpcrVp3EyRTcaJLYjy1Erhuycr54g9nwhpPsO0PSnUnhg9sxlEeuAkN5FdCS6EBp9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZYrP60odP6NUgYaLeFmOxFaa1KkmmfYL0Bd8B4qmCqw&oe=6AEA0BC5"}, "display_name": "Shipwreck Discovery", "keywords": ["Underwater", "Exploration", "Immersive", "Atmoshperic", "Casual"], "long_description": "Lionfish are invaders, and they are eating real reefs. One lionfish on a small patch reef cut native young-fish recruitment by about 79% in five weeks (Albins and Hixon, 2008). In Shipwreck Discovery you get in the water and fight back.\n\nEvery level starts murky and overrun with 70 to 100 lionfish. Spear them and drop them in the ZooKeeper tube; fill it for a 100 ReefCoin reward and spend it on better gear. Burn algae off the hull with the laser cleaner. Pull trash off the sand and plant coral that grows in real time across your visits.\n\nNew in 1.0: race the BlackTip scooter in Scooter Run on the SS United States, and dive her \"Her Last Voyage\" museum route with narration and history photos. Follow the treasure map and sweep the sand with a metal detector. Cut turtles and other animals free of ghost nets with your dive knife. Swim with your own arm strokes.\n\nScan the animals you meet into your Aquapedia, narrated by marine scientist Dr. Steve Gittings. Watch the reef respond: clearer water, safer corals and fish coming back. Each new wreck unlocks as the last one thrives.\n\nMade by Lionfish Central, a marine science nonprofit. A portion of every purchase supports its work.", "short_description": "Dive real shipwrecks off Destin, Florida. Every level starts with 70 to 100 invasive lionfish. Spear them, burn algae off the hulls, race a scooter around the SS United States, cut trapped animals free and grow coral that keeps growing between dives. Guided by marine scientist Dr. Steve Gittings. Single-player VR."}]}, "developer_name": "Shipwreck Discovery", "developer_privacy_policy_url": "https://shipwreckdiscovery.com/privacy-policy/", "developer_terms_of_service_url": "https://shipwreckdiscovery.com/terms-of-service/", "publisher_name": "Scott Gonnello & Ian Mclennan", "support_website_url": "https://shipwreckdiscovery.com/survey/", "website_url": "https://shipwreckdiscovery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39871677055779505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303679_1464554865200846_7584669522072113669_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTL3CodhAwwQ7kNvwHE7hju&_nc_oc=AdrnLYpFD7Na7cXCwFBrOuLvpZ7GREGLpMuB30IwQj1NwLJOdX5w6gIcD1HPVth493k&_nc_zt=3&_nc_
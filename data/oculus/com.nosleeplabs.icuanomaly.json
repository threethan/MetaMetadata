rTBFI8rGPiqglcX1sGAT0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfYrlw3e61snbm7i3VQV2aznVRu7vWACuXgQsUpwcdCA&oe=6B104B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (256 x 256 px) (1080 x 1080 px) (150 x 150 px) (1920 x 1080 px) (2560 x 1440 px) (1).png", "id": "1733006554917214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313058_1733006558250547_8741079368625479987_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VrbhkGg33UQ7kNvwEPUR78&_nc_oc=Adr2G6U1IOguu6fni2Qig4aksI0Zftc3HXLW2XeSpZb5mXgJYPSH6FsVOjdC0xJMCZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtyyqbFvcKgTFqdeVJmoZ3wkmotf4jIM8zk2itRIDx4g&oe=6B103E31"}, "display_name": "ICU Anomaly VR", "keywords": ["horror", "psychological", "anomaly", "hospital", "puzzle"], "long_description": "Wake up in an abandoned hospital with one way out: the elevator.\n\nICU Anomaly is a psychological horror game about paying attention, now in VR. Every floor looks almost exactly like the last. Explore it, then make your call in the elevator: press the buttons with your own hands. If everything is as it should be, go up. If something is wrong, go down. Get it wrong and you're sent all the way back to the first floor.\n\nReach floor 13 to escape.\n\nTHE RULES\n- Floor 1 is always safe.\n- No anomaly? Go up. Something's wrong? Go down.\n- Music changing isn't an anomaly. But listen closely.\n- Run from Lucy. If she wants to play, DO NOT!\n\nFEATURES\n- 31 anomalies to find, from subtle changes you'll walk right past to things you'll wish you hadn't seen\n- An unsettling abandoned ICU, built for VR\n- Press the elevator buttons by hand or with a laser pointer\n- Comfort options: standing or seated play, snap or smooth turning, comfort vignette\n- A distorted original soundtrack\n- 19 achievements to unlock", "short_description": "Trapped in an abandoned hospital, your only way out is the elevator. Search every floor for anomalies: if nothing's wrong, ride up; if something's off, go down. One mistake sends you back to floor 1. Reach floor 13 to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nosleeplabsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "No Sleep Labs", "support_website_url": "https://nosleeplabsgames.com/", "website_url": "https://nosleeplabsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1519312417927982"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_1431391118656261_4431530004647910225_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGTOpzLgY5cQ7kNvwFrDQ2Q&_nc_oc=Adq_Uqv96TZ9MxiZFcn1NRPchE5RmHrkYcal50_4i-4aXKc09AA26AKESH2HLFSy82Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVS2Ict0duV89R6iVM0MY3bVZMdopWqDEyKySFogZwdag&oe=6B103DA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ICU Anomaly VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1793037060, "lastRevision"
f&oh=00_Af3QDEr-xzo_8h7jvjrCGklgbGU336qaHlW3UKyt43qKUw&oe=69DBB423"}, {"file_name": "Screenshot 5.png", "id": "899750905715350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821989_899750909048683_1934815370492167068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj3HW1jcqo4Q7kNvwGKx7Cw&_nc_oc=Ado2Vu52steLHKddexyK995HUSg38_cwsNf-E1NoqTJmHf56Paks4k33gIh9G6l317w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k9zQoQI2A47Hz-nW4d-YBjYBLzCmnMI-NbicCZZmuGA&oe=69DB8FB3"}, {"file_name": "Screenshot 2.png", "id": "1529489141638231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821674_1529489144971564_6483053598704446142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iquctdogh_wQ7kNvwGgU1Qk&_nc_oc=AdpVAVjOmodQnmaRgBega5vDYDAWJezNWTZmzwIqphNMNuISghOTNCZY9F5c14RENno&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qtQdXWrMXxcx8nIF0ofRNlaXJGAcLhjcZkF3z604sJA&oe=69DB89A0"}, {"file_name": "Screenshot 4.png", "id": "1174750018169551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1174750021502884_1730276541789178362_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jm3w5acBD8Q7kNvwEkKLce&_nc_oc=AdqZX_tuWfz6WkX-L-rzuPXb2Q5WzT7UG5sVz5DKeJ_5KgFRXzAgpqeYGDotX8weAIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pFSYU4VXW-ZnfPXD1CBSC_kn16T_DPormz5OEE-5gkA&oe=69DBA097"}, {"file_name": "Screenshot 3.png", "id": "818511904332481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_818511910999147_3177788816015121403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1i9wbZC7_oQ7kNvwHnJBhl&_nc_oc=AdpHx49Qo92WQe7ni1VLeztxa-KH4spp07bRhpxyAlu3VBtgDPDla9OWQUvgdPrK7LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZUtPiaHBIApxX-87Hdm3U3zXlzeDAhHhenGPaW4KSvg&oe=69DB842F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Places_Demo_Meta_StoreAssets_Landscape.png", "id": "1924651155124598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1924651158457931_613320767560168596_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBw5pPn8t_IQ7kNvwE2Vput&_nc_oc=Adq09xvwQRtw0NZcbKfVfStkidVoVszQMnfDCFyvGbCWVcc7aH2bYUgMbnrtPZUKtMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L-XClEHJzS0EEYnepUuxD7IgeacQ1LxCGkbGHuJiVxA&oe=69DB7C68"}, "display_name": "Places", "keywords": ["design", "collaboration", "review", "spatial"], "long_description": "This is a demo showcase of Places, a platform built for professional teams designing real-world spaces and products. \n\nFrom store layouts and packaging to facility planning and merchandising, Places shows how teams can visualize, test, and align ideas before anything is built.\n\nTraditional tools like CAD, PowerPoint, or screenshots make it hard for non-technical stakeholders to understand true scale and flow. With Places, everyone can step inside the same virtual environment, explore designs at life size, and make decisions as if they were there together. \n\nThis leads to a more streamlined communication with internal and external stakeholders, less rework and a faster time to market.\n\nWhether you\u2019re designing the perfect store, testing a new product packaging, or walking stakeholders through a facility plan, Places brings clarity and confidence to every stage of the process.\n\nKey Features\nReal-time multi-user collaboration\nGrab, move, interact with just hands, like you do in real life\nRealistic physics and lighting\nFrame-based A/B testing\nHeatmapping for consumer insight\nPresentation mode to walk executives through your ideas\nEnterprise-grade security (SOC 2 Type II)\n\n\nPlaces transforms how organizations design the physical world: faster alignment, smarter decisions, and fewer expensive mistakes.\n", "short_description": "Places is a platform for teams designing real-world spaces and products. It lets stakeholders step into life-size virtual environments to explore layouts, test ideas, arrange products and align faster. With real-time collaboration, realistic physiscs and hand interactions, heatmaps, and enterprise security, Places helps organizations make smarter decisions with fewer costly revisions."}]}, "developer_name": "Shapes Corp.", "developer_privacy_policy_url": "https://www.shapesxr.com/privacy", "developer_terms_of_service_url": "https://www.shapesxr.com/terms", "publisher_name": "Shapes Corp.", "support_website_url": null, "website_url": "https://www.shapesxr.com/places", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "24984636514565617"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_876545911566764_2783708564593862808_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9vfZCCRZtQQ7kNvwHWvrtw&_nc_oc=AdpOeeOkZIHnBKBphwIWzyCkyms6NKtpTZuVhBQe8E7uqU_v6ryF3_h_dSzhn2WLP1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u-egxcCLCvQAS7jHvzjBDDxNoCoQXCI-8Wnp3V2Ax3Q&oe=69DB9DEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Places", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_n
0a&_nc_ohc=AcB3Yr8KmEcQ7kNvwHlRmBe&_nc_oc=AdoHKEITfch_nRRt2bPex1IC9tfLl1faOabwTxm0DUGcIhX0oUXkflcG2JcWpvDW-cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVJC70pg8gzJId4QsiLGBfTHSEEDccPyjIUnT_4lyDpg&oe=6B0085D7"}, {"file_name": "Screenshot 3.png", "id": "818511904332481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_818511910999147_3177788816015121403_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tRg4WRAgpoQ7kNvwHOVUqa&_nc_oc=AdoIIwqTpIiBNCVxtl4HAR30BlAx1C76pwwwB31Lr8xOjcsGkFiZFc3ntcSDl-fu-_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMztiB3WRXN0jisER9IqSMhUtIZ7BzVxBx18m7Pk_rxw&oe=6B00696F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Places_Demo_Meta_StoreAssets_Landscape.png", "id": "1924651155124598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1924651158457931_613320767560168596_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtP7pMM-JlkQ7kNvwHnJeo-&_nc_oc=Adp0QvCV4kVsk-z1h2z1tyAmVkqXXgyvSUy-64xBufAw4E807OqWLHDcBJ6PWOUidPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo4CTzt2NH1vezLFR1Hm-URH9aFNDnCgB8z_wXbFLzbw&oe=6B0061A8"}, "display_name": "Places", "keywords": ["design", "collaboration", "review", "spatial"], "long_description": "This is a demo showcase of Places, a platform built for professional teams designing real-world spaces and products. \n\nFrom store layouts and packaging to facility planning and merchandising, Places shows how teams can visualize, test, and align ideas before anything is built.\n\nTraditional tools like CAD, PowerPoint, or screenshots make it hard for non-technical stakeholders to understand true scale and flow. With Places, everyone can step inside the same virtual environment, explore designs at life size, and make decisions as if they were there together. \n\nThis leads to a more streamlined communication with internal and external stakeholders, less rework and a faster time to market.\n\nWhether you\u2019re designing the perfect store, testing a new product packaging, or walking stakeholders through a facility plan, Places brings clarity and confidence to every stage of the process.\n\nKey Features\nReal-time multi-user collaboration\nGrab, move, interact with just hands, like you do in real life\nRealistic physics and lighting\nFrame-based A/B testing\nHeatmapping for consumer insight\nPresentation mode to walk executives through your ideas\nEnterprise-grade security (SOC 2 Type II)\n\n\nPlaces transforms how organizations design the physical world: faster alignment, smarter decisions, and fewer expensive mistakes.\n", "short_description": "Places is a platform for teams designing real-world spaces and products. It lets stakeholders step into life-size virtual environments to explore layouts, test ideas, arrange products and align faster. With real-time collaboration, realistic physiscs and hand interactions, heatmaps, and enterprise security, Places helps organizations make smarter decisions with fewer costly revisions."}]}, "developer_name": "Shapes Corp.", "developer_privacy_policy_url": "https://www.shapesxr.com/privacy", "developer_terms_of_service_url": "https://www.shapesxr.com/terms", "publisher_name": "Shapes Corp.", "support_website_url": null, "website_url": "https://www.shapesxr.com/places", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITT
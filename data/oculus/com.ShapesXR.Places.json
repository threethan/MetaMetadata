7560168596_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBw5pPn8t_IQ7kNvwE2Vput&_nc_oc=Adq09xvwQRtw0NZcbKfVfStkidVoVszQMnfDCFyvGbCWVcc7aH2bYUgMbnrtPZUKtMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L-XClEHJzS0EEYnepUuxD7IgeacQ1LxCGkbGHuJiVxA&oe=69DB7C68"}, "display_name": "Places", "keywords": ["design", "collaboration", "review", "spatial"], "long_description": "This is a demo showcase of Places, a platform built for professional teams designing real-world spaces and products. \n\nFrom store layouts and packaging to facility planning and merchandising, Places shows how teams can visualize, test, and align ideas before anything is built.\n\nTraditional tools like CAD, PowerPoint, or screenshots make it hard for non-technical stakeholders to understand true scale and flow. With Places, everyone can step inside the same virtual environment, explore designs at life size, and make decisions as if they were there together. \n\nThis leads to a more streamlined communication with internal and external stakeholders, less rework and a faster time to market.\n\nWhether you\u2019re designing the perfect store, testing a new product packaging, or walking stakeholders through a facility plan, Places brings clarity and confidence to every stage of the process.\n\nKey Features\nReal-time multi-user collaboration\nGrab, move, interact with just hands, like you do in real life\nRealistic physics and lighting\nFrame-based A/B testing\nHeatmapping for consumer insight\nPresentation mode to walk executives through your ideas\nEnterprise-grade security (SOC 2 Type II)\n\n\nPlaces transforms how organizations design the physical world: faster alignment, smarter decisions, and fewer expensive mistakes.\n", "short_description": "Places is a platform for teams designing real-world spaces and products. It lets stakeholders step into life-size virtual environments to explore layouts, test ideas, arrange products and align faster. With real-time collaboration, realistic physiscs and hand interactions, heatmaps, and enterprise security, Places helps organizations make smarter decisions with fewer costly revisions."}]}, "developer_name": "Shapes Corp.", "developer_privacy_policy_url": "https://www.shapesxr.com/privacy", "developer_terms_of_service_url": "https://www.shapesxr.com/terms", "publisher_name": "Shapes Corp.", "support_website_url": null, "website_url": "https://www.shapesxr.com/places", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "24984636514565617"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1592817371968730"}]}, "baseline_offer": {"id": "1592817371968730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775117520, "status": "PUBLISHED", "id": "1592817371968730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26038615575834367", "version": "5.4.1"}, "id": "824093307091752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24984636414565627", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "260386155758
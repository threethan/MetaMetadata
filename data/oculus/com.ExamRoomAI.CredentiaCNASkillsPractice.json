ailer": null, "video_trailer_thumbnail": {"file_name": "01-Cover image-new.png", "id": "1703416144254099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293658_1703416150920765_4867301661048984871_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yovEUbqSu8wQ7kNvwHvzTOC&_nc_oc=Adpye8-f-oGPHtI49ZvhOAkirrYlPqUpJKJPb4WTD7Se0SIitgAuCB4reUyHpFmj0dU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXTVP5qr651-taZFkrzdA0Dt6ylRLtTAahyr0FyhKJHQ&oe=6B1042F6"}, "display_name": "Credentia CNA Skills Practice", "keywords": ["CNA", "Healthcare", "Training", "Simulation", "Nursing"], "long_description": "Credentia CNA Skills Practice is an XR training application built for Certified Nursing Assistant students. Practice clinical skills with virtual equipment overlaid in your physical space, guided step-by-step with hand tracking and speech recognition for patient communication.\n\n**Features**:\n\n- 23 CNA skills covering patient care procedures\n- Hand tracking and controller support\n- Speech recognition for patient communication steps\n- Automated skill demonstrations\n- Progress saving and session tracking\n- Easy access via QR code or token\n- Passthrough; train in your own environment\n\nDesigned for nursing education programs to supplement hands-on clinical training.", "short_description": "Practice Certified Nursing Assistant(CNA)  skills in XR. Step-by-step guided procedures with hand tracking and speech recognition."}]}, "developer_name": "ExamRoom.AI", "developer_privacy_policy_url": "https://credentia.com/about-us/privacy-policy/", "developer_terms_of_service_url": "https://credentia.com/about-us/terms-and-conditions/", "publisher_name": "ExamRoom.AI", "support_website_url": "https://help.credentia.com/en", "website_url": "https://credentia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154762497722594"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1021792543766640"}]}, "baseline_offer": {"id": "1021792543766640"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783518420, "status": "PUBLISHED", "id": "1021792543766640"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1450757928123048", "version": "1.2.0"}, "id": "1000651502363673", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154762491055928", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450757928123048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000651502363673"}]}, "change_log": "What's New\n\nThis update brings a fully redesigned controls tutorial, along with on-screen keyboard and stability improvements.\n\nRedesigned Controls Tutorial\n\n- New marble pillars, numbered in order, with clearer instructions at each one.\n- A checklist shows which interactions you have tried, grouped by pillar.\n- New controller station that explains the buttons and vibration before you use them elsewhere.\n- Finish the tutorial once every item on the checklist is complete.\n\nOn-Screen Keyboard\n\n- Stays out of your way and only moves when you turn or step away.\n- Better position and angle in skills and at the end of a session.\n- Fixed typing issues with some characters and the text cursor.\n\nStability & Performance\n\n- Sessions now end automatically when the skill is complete, so the wrist menu no longer shows an End Session button there.\n- Improved reliability when leaving and returning to a session.\n- Upgraded to the latest engine and Meta XR runtime for better performance and device compatibility.", "created_date": 1795539651, "id": "1450757928123048", "version": "1.2.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154762491055928", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450757928123048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000651502363673"}]}, "change_log": "What's New\n\nThis update focuses on a smoother, more comfortable training experience, with a redesigned menu and a range of visual and stability improvements.\n\nRedesigned Wrist Menu\n- Rebuilt for a steadier, less jittery panel that always faces you.\n- New lock button to switch between a fixed menu and one that follows your hand.\n- Full support when using controllers, not just hand tracking.\n- Added a grab sound and smoother motion, with more reliable buttons.\n\nVisual & Scene Improvements\n- Added water draining effects when emptying basins, bedpans, and cups in the cleaning skills.\n- Smoother hand-washing water animation during wetting and rinsing.\n- Added a wall clock near the sink and bedside so you can keep track of time.\n- Clearer wording on the in-room reminder signs.\n- Range-of-motion arm movements now line up more precisely with the on-screen guides.\n\nStability & Performance\n- Fixed several issues that could leave the wrist menu unresponsive during a skill.\n- Improved reliability of touch interactions and hand tracking.\n- Resolved a rare error during the hand-washing faucet steps.\n- Upgraded to the latest engine and Meta XR runtime for better performance and device compatibility.", "created_date": 1793364857, "id": "1394806623718179", "version": "1.1.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154762491055928", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450757928123048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000651502363673"}]}, "change_log": "Fixed bugs and optimized the app.", "created_date": 1784636676, "id": "1211590792039764", "version": "1.0.1", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154762491055928", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450757928123048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000651502363673"}]}, "change_log": null, "created_date": 1783355890, "id": "1189228144276029", "version": "1.0.0", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1154762491055928", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450757928123048"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000651502363673"}]}, "change_log": null, "created_date": 1783354458, "id": "1189196594279184", "version": "1.0.0", "version_code": 5, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
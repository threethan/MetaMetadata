2743_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHLWJOkQ96AQ7kNvwG_Qta6&_nc_oc=Ado36Kp_1XAXqbYmBtp6kTznaNyFtjGkCRn9O1DC7Ll60Cp7_80d2OJrbF_NESnJKM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l8jkoEK9Qr9OeTwqAcRkW1RCqp_VvJnYzYIT6w05WKA&oe=6A2EA1F7"}, "display_name": "Firefighting Simulator VR", "keywords": ["Simulation", "FireFighting", "FireFighter", "Sandbox"], "long_description": "\ud83d\ude92 Firefighting Simulator is a VR sandbox simulation game where You play a brave firefighter in a bustling city.\n\n> Race through urban streets in your fire truck\n> Respond to emergency calls\n> Rescue injured civilians\n> Stop the fire using powerful hoses\n> Hire Co-Firefighters \n\nEvery mission is a test of courage, speed, and teamwork in an immersive open world. ", "short_description": "You play as a firefighter in a large town, driving through the city, rescuing citizens and stop the fire using hoses. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25896121790027067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
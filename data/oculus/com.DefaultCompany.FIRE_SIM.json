23592743_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKRHVjeRlfQQ7kNvwE3J9uO&_nc_oc=AdkHcpFfcpJhE7gXx8j9kXwRiysawJmaKbu6htdz7AqbbEy_o9IGabhSsuOFz9Ho63s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfutIZfRm68i0SB2HlEk2J19scje1WFqkMBQiakUMY3VVA&oe=699EEE77"}, "display_name": "Firefighting Simulator VR", "keywords": ["Simulation", "FireFighting", "FireFighter", "Sandbox"], "long_description": "\ud83d\ude92 Firefighting Simulator is a VR sandbox simulation game where You play a brave firefighter in a bustling city.\n\n> Race through urban streets in your fire truck\n> Respond to emergency calls\n> Rescue injured civilians\n> Stop the fire using powerful hoses\n> Hire Co-Firefighters \n\nEvery mission is a test of courage, speed, and teamwork in an immersive open world. ", "short_description": "You play as a firefighter in a large town, driving through the city, rescuing citizens and stop the fire using hoses. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/FirefightingSimulatorVR.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24203297735976156"}, "review_messages": []}]}, "cover
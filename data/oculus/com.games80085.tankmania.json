=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0LwDK252tj1vADaG7-I4lfK6fbwmcfB38yN0fvT3mrw&oe=6AE48A8D"}, {"file_name": "s3.png", "id": "3478838945735431", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982499_3478838952402097_4593587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAnZ6oHRiHUQ7kNvwHyu1ek&_nc_oc=AdqbSMalcHS9Z6rbO0K1JMPVILIARjmtPgcEzh_dptEHZCdEJ65iLW7ze3w4xCEHK4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXBDr-FjzYAkqW7KPhSDSug8aTKbtTn7hFGOdLsiX9sA&oe=6AE49B48"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36nWz7WRi8EQ7kNvwGBgXMI&_nc_oc=AdpVhp8pykt9HwUxZ_WSidUHrc5e0FXmw0Hvro3QPkZDpVPXP4bcy0cfEgdTVwfQ4pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtPkeC44UpJb2VyiG-OV4jZyTy0jBqohiPSW-tgrN5pg&oe=6AE489D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iqSQku3iG8Q7kNvwHUwEws&_nc_oc=Adp2woxL_aNcBHU3qgO1Q4BtCzBZP6_dw3zVfG3QFCi2oZiUjD5BsMvXPreT4I4dOnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO162n0Zsf8tFQ4cbYALZuB-hf0-QotQ41b9K39WL1JOQ&oe=6AE48BB5"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpB7DAU8XrkQ7kNvwEa_6B-&_nc_oc=AdqhHaHdu4CNwITbrvznFZailpAyyFxNFRKrvNNvDdKEM4iM0Kmzo9g6rZIEtDKZg9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQUqq6dJHtQDtIsl4gqKrpHIaujkNEaCjhDt9_TnkjRg&oe=6AE4AFE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_catego
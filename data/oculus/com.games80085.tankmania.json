=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYlFw_oG6-6QfRMQlPaCTSdnPL65eEfU02MhSa8wdgIw&oe=6AE1E78D"}, {"file_name": "s3.png", "id": "3478838945735431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982499_3478838952402097_4593587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAnZ6oHRiHUQ7kNvwHxATVI&_nc_oc=AdqZSx-7YwiBMpChJb4omFI5wqavT2gOOYR4NYS6L-_hZqR389EFL0cTm8t9avj2kYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQeIPO0z5L1WG_HDvxFSrH9ecPGT0zunV1RRta46TSWQ&oe=6AE1F848"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36nWz7WRi8EQ7kNvwG3uwQf&_nc_oc=AdogmBidtAniX4mjpGaqgi-_xYjs-cndlGCtDJjEI_ULOcP5Oh5K1SyKEUIs-Y6EHxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2gFStE_6wj8alH-q3oLryA22fGSoAEGhLhpHRNlEIiQ&oe=6AE1E6D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CHkcpoClC0Q7kNvwH5SAlm&_nc_oc=Adr6hwv9TpHETcJRqzkb_ELgryjelfp3uBot6tJq3hYx5HzGAjCD4v3upCRuUROZyyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKACkXiC5FEJHuQABTWDlentitVwuqWYIZ1wbK42wuOQ&oe=6AE1E8B5"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-D8OlQB_lQQ7kNvwGZ-B99&_nc_oc=AdqogvYYUmwMuMELMcztQILYyF-tW2y9NMftTQqzoYkxzbiK_mb9Utg8QrP-9_Qbi84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3nmFhDLUV-MWj1DEUWqpgehgvI5yz4tDKyLCYk9G4Tw&oe=6AE20CE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_catego
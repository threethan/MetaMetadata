 Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12ykNXPRzEVhlu67miST7jyFW_-RbDFoD/edit?usp=sharing&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": null, "website_url": "https://80085.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "7129200817090602"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1975665619480734"}]}, "baseline_offer": {"id": "1975665619480734"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1696268180, "status": "PUBLISHED", "id": "1975665619480734"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7626431630700849", "version": "0.1.8"}, "id": "1559750464430591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
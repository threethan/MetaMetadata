=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa8nkqytHLuZ8J4wvmxYB4X1gIO3XTE4P4aPArJabhDg&oe=6AE0960D"}, {"file_name": "s3.png", "id": "3478838945735431", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982499_3478838952402097_4593587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF1rcBxHc2MQ7kNvwHbgqoQ&_nc_oc=AdrDdqDEvAAKJDL6a-j41zu7AVedY-CtddrPs4OQf9CEoAA_9dQuM8ygM1eQDhQvRbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIuJIvKkwPKPicbD-FmoxtVgVMUDxjCKq3-iqesix6XA&oe=6AE0A6C8"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5xIrYQl74oQ7kNvwHOxFEn&_nc_oc=AdqEEGK-0ZwxKy_rzmHh8vcjD0wyB4KlUxWx2IHL9FBFhH9xrxlSnYzToO40SIe_Djw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiRj0SztHlEMnMHvO09bFqYD-lCARxg5ME_ksRazyF_w&oe=6AE09551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CHkcpoClC0Q7kNvwG9lCzj&_nc_oc=AdpFvrZLFgoBFRlnXm0ZeL5y6iJWMp0teW4eVvb8RlmrMdSBm49MYISvqTrEi9bGpKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY_G8HUwIdPfvfUbgoT3o3aakJYysJsNJdrzjRZJ9gcQ&oe=6AE09735"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-D8OlQB_lQQ7kNvwGlnYVq&_nc_oc=AdqiCjkcPo_SncKKKP9TheksSe047jfXiU-rHk8Gpu5NmvMCi1FFNgkUvw0K4m-Ovr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeZU2cTnUoG55A0GuyZ-lGgMVDgFICabE1yjSwXgLM3A&oe=6AE0BB69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_catego
bnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMBH75AM_xUQ7kNvwE1l9eR&_nc_oc=AdrBirDjeJokVkwqXNbAQ1ODWLxnWl7oC2EXYsaMfI2YFpEu-P_L1l6BQEEcI8buJF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKAA6gyaVEyP9zz06MII-2MfHP0rEu2VhtMOQOo_UDrw&oe=6ACE5A75"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12ykNXPRzEVhlu67miST7jyFW_-RbDFoD/edit?usp=sharing&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": null, "website_url": "https://80085.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
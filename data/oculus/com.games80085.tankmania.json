JKVxo4gG6w&oe=6AF74888"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uwt2B25BB2YQ7kNvwGK2lLC&_nc_oc=Adp-HOQjSchlK8ZDviO38jEnIlAu3-XYvLv_yJSJZGI03X5VVaPj-hcoGrcLAYMv0cE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_YgO6KdvYql0YkZgCvHzncn8c81oiXvuL0EIoTbLz_w&oe=6AF73711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N9EBNDGvt4Q7kNvwEjKxpk&_nc_oc=Adok9N69fY2NDazmrb4EcoNAqZrzJRBVEHEahU0afC7kHXjZFA-Ntmiywv8ohHuBFoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSusJB6Fa19SGuAJToDrnD4y4D965egnJrMQa0-encdLw&oe=6AF738F5"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12ykNXPRzEVhlu67miST7jyFW_-RbDFoD/edit?usp=sh
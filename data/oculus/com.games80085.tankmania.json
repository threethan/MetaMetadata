=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLGZvMaWOwZStIJj7hoDGVBQnhUr8eXWqtg5-x6wwisA&oe=6AE3390D"}, {"file_name": "s3.png", "id": "3478838945735431", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982499_3478838952402097_4593587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAnZ6oHRiHUQ7kNvwFd6l4J&_nc_oc=AdrvCmeFrlk-Q3DrTGgcH8fMVWxJepvRFMDqDAz3r7jrFBxdKL2A4u3RPpXzCfOBeTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOkT0c0WmuaH9AmKfW6XCgfH7fzMs0uPQmuSn2iJcyWQ&oe=6AE349C8"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36nWz7WRi8EQ7kNvwFRcIYt&_nc_oc=AdrzWvl8WHa59ve_7y0IgmW_8Sc3Y0-NuP3Sd8yuPcHQWzGbzAeJrRCfRD9aL-1fdIQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3bwHu3LP7hkUMKAiqk1lsnDQRKUCY6jQthbBOzTAxLw&oe=6AE33851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CHkcpoClC0Q7kNvwEa_YHA&_nc_oc=AdoQiSMjUI6JqfVQ1qko8RX7Wg_38hR755ePeVQIc2s9APdTlRL8iMDgQFgIsftd9ZM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoN4mj7L3fJ6kQ5szZ9eV9YTAeP5Z43AxcMYd7H4MB6A&oe=6AE33A35"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-D8OlQB_lQQ7kNvwGT3VZO&_nc_oc=AdrNIES6GyulYa0x3XQpldX9BWZr6-3aonPOgYTcKty6dgrAyAjFXB9L4r99icf95x4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLiruuK2L19LaUaJSfrjj1nT68QirlIFtXPr8d2N6fpw&oe=6AE35E69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_catego
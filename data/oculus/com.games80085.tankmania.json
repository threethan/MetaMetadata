93587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dleYpwl7jVIQ7kNvwESXTaT&_nc_oc=AdqK_NXOl37cc-X6d5ts3jQfwE2hSVF0SM4RjSMZTKNIl-FRuunzQ46u-4ZXIdYVaEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoZw314NWPCh2HxgzPtc3HaVHjX4v0rblXmGf79bjPKA&oe=6ACE6A08"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ei7AsUI0gkQ7kNvwGpFDte&_nc_oc=AdrpFN2BNQVwHE9YWE19yjmyTNgOmlnKQxBnn8XLiz9-AI1KSSYTUh34UaTW-gyU3aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ5wVmiKgXV4v_TF5svKxFfkSH0hLL0kATAfNssMSCyw&oe=6ACE5891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMBH75AM_xUQ7kNvwE1l9eR&_nc_oc=AdrBirDjeJokVkwqXNbAQ1ODWLxnWl7oC2EXYsaMfI2YFpEu-P_L1l6BQEEcI8buJF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKAA6gyaVEyP9zz06MII-2MfHP0rEu2VhtMOQOo_UDrw&oe=6ACE5A75"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4msG-3oxSvEQ7kNvwHc3Z3c&_nc_oc=AdqeNcQ3pXw2NB28VW9MuxFqd-Xhx9h47vCPzRoPSwUeBdMod661Vmocs-Z-QlmcUdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMW7fnkR71zG_dhITiR-uUXgTl0hNEs6-JH_kR6zFTTg&oe=6ACE4669"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1696268180, "last
=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPm-ot2WBb6wt41d6LEdr6ZSSyH1a7N7maQW4enI6sCA&oe=6AE8B74D"}, {"file_name": "s3.png", "id": "3478838945735431", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982499_3478838952402097_4593587004034495625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYIQKbWTYrQQ7kNvwFOFqIY&_nc_oc=AdozXKiPJawp3NHMRlhNU7qBQeglsm60yVjDWfDcKuhrF5HHpE2SCnW3NCu6RVwpbp8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzlEvdAxx8HeSy1g9O8w9jivxvaLpusuBepC7AfoqslQ&oe=6AE88FC8"}, {"file_name": "s2.png", "id": "3368525480063462", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974504_3368525483396795_4784661771253645667_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A484XKygH6oQ7kNvwFt6Je9&_nc_oc=Adox8damIml1M-jO-ab7rKDHORuTG0syFQrwNMJAExKA3fGS_kdkN4jdL5N03iQRxlw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBTXjFdNNxcflP3aASCsTshhdl54MXMSqnSTujtURgLQ&oe=6AE8B691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TM_cover1440.png", "id": "281619591097155", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974909_281619594430488_3594653744430024813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEGreqLuDs8Q7kNvwEkPJBT&_nc_oc=AdqsiVDGGhC7JDQiPmlzrGMdv1yr_zOXVto2iUs0GZrgxXC7gLjyOd1tX8i4XTw2_rI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHyIuYlbt5QZrog1GsaxUH1wCCr6UQ91o3XysHewy-OQ&oe=6AE8B875"}, "display_name": "Tank Mania", "keywords": [], "long_description": "Relive the classic nostalgia of Tank game in an entirely new dimension with our captivating VR experience! Immerse yourself in the heart-pounding action as you take control of a powerful tank and defend your territory against relentless enemies. With stunning virtual reality graphics and intuitive controls, you'll feel like you're truly inside the game. Strategize, blast through obstacles, and outmaneuver your foes across a variety of challenging levels. Compete with friends or team up in multiplayer mode for an exhilarating tank battle like never before. Get ready to embark on an epic VR adventure with Tank Mania!", "short_description": "Experience the legendary Tank game like never before in our immersive VR reincarnation! Step into the virtual battlefield and command your tank against hordes of evil tanks. Save your Headquarter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/tank-mania/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/tank-mania/", "website_url": "https://80085.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29241300408787326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570289_3455043558076473_8410829555058201542_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5LebRjheIEQ7kNvwG69HAx&_nc_oc=Adpu7oaMxlqvr5Cd9oSgvuWT-Q88fLjVpr2lmUmtzHN6ec3L0dgwdnZItX7QWvpb_gw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2MywIibId02z7j6ZMYAleQEemLMiFz-7cKWx7BOpquQ&oe=6AE8A469"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tank Mania", "platform": "ANDROID_6DOF", "context_category": {"context_catego
a&_nc_ohc=9l7_wEPslQQQ7kNvwElmwW1&_nc_oc=Adp_xuryHajvHStju6n5xUzjTxtaQyJUoq2MEEfkMWwyUKGUTlNdXYss8D8HiW-qAvk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM71TrhHeimmIJDFVqLNQGYNQRibpDJ5LDhMynE7WOVA&oe=6AAE95E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_Breathedge_Landscape_2560x1440_rev.png", "id": "707115611531757", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974696_707115621531756_849882076632584654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HqtWFdZWmYQ7kNvwEwsmP9&_nc_oc=Ado7pQbJ6DiGKbLAZevsLiF5YbhRbpntQ15Zkmk62olLQLkrYvYKZlF6xmAAgZJseQM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi7Vh0G5QaO4TP2jFZhNc4p3B_JFYsEkomdXSrxDXZ9Q&oe=6AAE9F62"}, "display_name": "Breathedge: Cosmic Cluck", "keywords": ["survival", "space", "astronaut", "spaceship", "universe"], "long_description": "In Breathedge: Cosmic Cluck you\u2019ll be able to:\n\n- Come back home.\n\n- Listen to an in-depth commentary on anything from a crazy Chicken.\n\n- Craft a versatile multitool that makes it so convenient to throw garbage at enemies and pull yourself to asteroids and shipwrecks... you've always dreamed of a grappling hook, haven\u2019t you?\n\n- Explore outer space and collect all the garbage that has been dumped into it by humankind... and an evil, very EVIL corporation.\n\n- Visit the space farms of an athlete, a hippie, and a criminal mastermind.\n\n- Fight a boss whose appearance you couldn't possibly have a clue about... well okay, you could, you just refused to believe it.\n\n- Save the UNIVERSE... okay, just the farm, but oh man, what a salvation it'll be!\n\nJoin the Man in his space adventure and your virtual reality will become much more real than ever before.", "short_description": "Survive in outer space! Breathedge: Cosmic Cluck is a Retro-Futuristic Adventure with a talking Chickens your main companion.\n\nFill your pockets with junk, build the Universal Survival Tool, blast the monitors off enemy robots, explore abandoned farms, and help Grandfather fight the Evil Corporation. You don't want to be cut out of the will, do you?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypetraindigital.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HypeTrain Digital", "support_website_url": null, "website_url": "https://www.hypetraindigital.com/games/breathedge", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6905900992842562"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1702442154123370"}, {"status": "PUBLISHED", "id": "2330451147430920"}, {"status": "PUBLISHED", "id": "869772106230369"}, {"status": "PUBLISHED", "id": "1289845333168210"}, {"status": "PUBLISHED", "id": "790620686668424"}, {"status": "PUBLISHED", "id": "668686946137470"}, {"status": "PUBLISHED", "id": "1998342420651678"}, {"status": "PUBLISHED", "id": "1136874418074626"}, {"status": "PUBLISHED", "id": "1267278671263913"}, {"status": "PUBLISHED", "id": "833060188796896"}, {"status": "PENDING", "id": "932159601379059"}, {"status": "PUBLISHED", "id": "1202141850747207"}, {"status": "PUBLISHED", "id": "773929574591398"}, {"status": "PUBLISHED", "id": "1553095721929044"}, {"status": "PUBLISHED", "id": "305285485864607"}]}, "baseline_offer": {"
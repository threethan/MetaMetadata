g", "id": "302184836178740", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031363_302184839512073_8129902417389180982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebrn1yai_K0Q7kNvwGoC7nv&_nc_oc=AdlDfaOjXQVqugYPW8h-XOlmk0LYPl4o46Wep_VY5IZc5Q5k-ss6r9J2iV2ugZ3lr64&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfywwJOoTMV2p1bdb0adUV3TuvUrfqvCASrVqUDrXAxQEA&oe=69AAE163"}]}, "id": "1623680238170140", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "2586233171551895", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974891_2586233174885228_2415123033204980837_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLfSgsHrrSwQ7kNvwEqPtTN&_nc_oc=AdnDO-GHQdA-oFgww1Z0wLogqllhFtqqOjMNtko_pJIIa7_hE7YSSQ_LMmbCzVkycAk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5Tp_rI-dz27Ir9e1Kg-WvX7xOz48lnFHSfKt2qttA9A&oe=69AAB642"}, {"file_name": "Screen2.png", "id": "1483694128847202", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982686_1483694132180535_4793446981319234993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRgutKhtK6UQ7kNvwGrjDWd&_nc_oc=AdkfbIFLUldIEwvfxRhXbgjM5AQjGLUn0yI_d8QIu_VB7qkw6g_WTWT7UQnbB52oxGw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-u4kHByFa4IlaYzme4gUVHYS5iJnV0sy8FC_sgmJYkQ&oe=69AAC732"}, {"file_name": "Screen3.png", "id": "946994853447418", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001669_946994856780751_1223935063235236959_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0sFWUlKJ5MQ7kNvwHcxls0&_nc_oc=Admvauht4TnJfo6fmX1gCRkqECGwqcqZwi2S1J7CaQBSsagUWwDRRu93wuyLRe_aAbg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDsR3PDIEX1SFYIq6HtfYlrz1mQ8m9hbooBUCM7c6gVA&oe=69AAB473"}, {"file_name": "Screen4.png", "id": "3556688497878419", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003251_3556688504545085_937334966672341151_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFYsBWmlT8AQ7kNvwGMIx2_&_nc_oc=Adn0ujTvlAiN9kBtDFXEIbFMHXX4-U7FGPYf0r2xYcjzC1Rxn_Y0lrQfSQY-Rw1cFGU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAbnBTT9ODC-afOr-XivKD4M4LmvKaXF_bH2so9uXecQ&oe=69AAB29D"}, {"file_name": "Screen5.png", "id": "391894503462293", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_391894510128959_2781007855999020995_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dArjYcmtKGIQ7kNvwH2b5zl&_nc_oc=Adkci2UFvxk0_u-h53BJbRmsqsyXHGtrIUJIX40sjDCFQwDhP6xp0_rZTiXstiLt-WU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzchF17vfkN6F0x62EOEV1GPBRimTJCqNS3140TCukyzw&oe=69AADE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "456594630143086", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031314_456594633476419_4881022021396404714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0VjHUK-hKEQ7kNvwEIaBew&_nc_oc=Adl0HnIQ76rC1qjfbOAQAHaTNLqzUSqU6Rt751Z10ynz9sKbsvC9WOiB9FVRguHTrGo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkeC1jdpg00dLWNDfAfIUMD1ED8SyTJhUIWXpCGn3-Cw&oe=69AAE2E5"}, "display_name": "Breathedge: Cosmic Cluck", "keywords": ["survival", "space", "astronaut", "spaceship", "universe"], "long_description": "An Adventure Spin-Off in the Breathedge Universe! In Breathedge: Cosmic Cluck you\u2019ll be able to:\n\n- Come back home.\n\n- Listen to an in-depth commentary on anything from a crazy Chicken.\n\n- Craft a versatile multitool that makes it so convenient to throw garbage at enemies and pull yourself to asteroids and shipwrecks... you've always dreamed of a grappling hook, haven\u2019t you?\n\n- Explore outer space and collect all the garbage that has been dumped into it by humankind... and an evil, very EVIL corporation.\n\n- Visit the space farms of an athlete, a hippie, and a criminal mastermind.\n\n- Fight a boss whose appearance you couldn't possibly have a clue about... well okay, you could, you just refused to believe it.\n\n- Save the UNIVERSE... okay, just the farm, but oh man, what a salvation it'll be!\n\nJoin the Man in his space adventure and your virtual reality will become much more real than ever before.", "short_description": "An Adventure Spin-Off in the Breathedge Universe! Breathedge: Cosmic Cluck is a Retro-Futuristic Adventure with a talking Chicken your main companion.\n\nFill your pockets with junk, build the Universal Survival Tool, blast the monitors off enemy robots, explore abandoned farms, and help Grandfather fight the Evil Corporation. You don't want to be cut out of the will, do you?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypetraindigital.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HypeTrain Digital", "support_website_url": null, "website_url": "https://www.hypetraindigital.com/games/breathedge", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7258748120891179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031502_1247126510005452_1721020429993810019_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfM2I5S20z8Q7kNvwH-b7Gk&_nc_oc=AdlGQfyanxx3LTqmH6LVuxBlwraRyU96EOJDCKREGD8bxwfdJrKCQlDDfmdSF0G5IZA&_nc_
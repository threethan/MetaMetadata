_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4Luc0Y26TlP9FMuU2RVsDjSwRkTtFIWyQ1Mj7x0qOCg&oe=69A56C9D"}, {"file_name": "Screen5.png", "id": "391894503462293", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_391894510128959_2781007855999020995_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1MZcZPINQsQ7kNvwFLY-sS&_nc_oc=AdlxNKTOJdOwmXJe0E04R1TPyE6fd9TJ5UVA5f5R3Kk22FO0tszmTCkgbgk8OI4olnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afslm256MEAC9o4yODAb_8y5VJMIfF3YlmhwPxAXOrpgEA&oe=69A59864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "456594630143086", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_456594633476419_4881022021396404714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOzAh8hCnLUQ7kNvwEbK_Am&_nc_oc=Adn6-PJZt0NO-TjkJYLJ1_hG6ZiZjY8Ou74NXNWJVGV24pv7Un9gRaAQRegXaREAcO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuU6HRWt6ByBIfpE5qUhf_e7N1rKJE9iTEYbxGisDICjw&oe=69A59CE5"}, "display_name": "Breathedge: Cosmic Cluck", "keywords": ["survival", "space", "astronaut", "spaceship", "universe"], "long_description": "An Adventure Spin-Off in the Breathedge Universe! In Breathedge: Cosmic Cluck you\u2019ll be able to:\n\n- Come back home.\n\n- Listen to an in-depth commentary on anything from a crazy Chicken.\n\n- Craft a versatile multitool that makes it so convenient to throw garbage at enemies and pull yourself to asteroids and shipwrecks... you've always dreamed of a grappling hook, haven\u2019t you?\n\n- Explore outer space and collect all the garbage that has been dumped into it by humankind... and an evil, very EVIL corporation.\n\n- Visit the space farms of an athlete, a hippie, and a criminal mastermind.\n\n- Fight a boss whose appearance you couldn't possibly have a clue about... well okay, you could, you just refused to believe it.\n\n- Save the UNIVERSE... okay, just the farm, but oh man, what a salvation it'll be!\n\nJoin the Man in his space adventure and your virtual reality will become much more real than ever before.", "short_description": "An Adventure Spin-Off in the Breathedge Universe! Breathedge: Cosmic Cluck is a Retro-Futuristic Adventure with a talking Chicken your main companion.\n\nFill your pockets with junk, build the Universal Survival Tool, blast the monitors off enemy robots, explore abandoned farms, and help Grandfather fight the Evil Corporation. You don't want to be cut out of the will, do you?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypetraindigital.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HypeTrain Digital", "support_website_url": null, "website_url": "https://www.hypetraindigital.com/games/breathedge", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7258748120891179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031502_1247126510005452_1721020429993810019_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmbwKusAMz8Q7kNvwFDIrEt&_nc_oc=Adl6gD3mXGTPN7fqd4an5ft7BLHtFAeTOicpnwW1V7Jhj3gssoXHpEZ5vXFMYI81JpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft14ex8yF_OqKMa3VyGpSG5nBfTftbgTwEtu2kqXrQG-g&oe=69A577B9"}, "is_concept": false, "is_test": false, "is_trial_o
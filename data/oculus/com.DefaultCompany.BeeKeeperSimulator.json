culuscdn.com/v/t64.5771-25/75507165_909667004193186_1109218916126115083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppEyINwSOQQQ7kNvwG1xPam&_nc_oc=Adpqn1xFtmg8ApnwZ5ELGa4WvSD0G5gx7P1efcEqBrzMtLzNlDtHnkq-VB2ebibFm1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH84zD2A60sBPnfWZ0pvLfM_n0slvjzpfj5T0CsVBaJ1A&oe=6A92C29A"}, {"file_name": "5.png", "id": "1565434680942787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031399_1565434684276120_4829750350024504502_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ocTGc_e1coQ7kNvwHRWMhc&_nc_oc=AdryKdzze9SnjXC0-Ls5DLs16j7I3Yoy09nfCxYXla9sSyIJFynVqp7XHB9EcsuGfeA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkyedRHjkdMFugo9ce7JCVnbXUKUMa2J_1Umuy9s_l2g&oe=6A92DC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeekeepingSimulator_CoverImageSafeAreaTemplateLandscape.png", "id": "246941428467884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035399_246941431801217_3791878372050825096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J75xKNjl1LIQ7kNvwG9Yi5Q&_nc_oc=Adqlb30fO5BHQpMNn6UhtZJUwcf0L1Mq61ABv-ORwqjqyLpDmbONRIfUio27f-CCvxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZO5OhdKqXClupPFIeHDeKvUDPSISNzaHFiQcsddAgyg&oe=6A92BEB3"}, "display_name": "BEEKEEPING SIMULATOR", "keywords": [], "long_description": "Welcome to the virtual reality BEEKEEPING SIMULATOR game! \n\nIn this immersive experience, you will step into the shoes of a beekeeper and embark on a journey to a lush bee farm teeming with buzzing bees. Your mission is to manage and care for the bees to ensure a successful harvest of honey.\n\nInspect the hives, collect honey and beeswax, and tend to the needs of the bees. Utilize tools and equipment to maintain the hives, protect the bees from threats, and promote their well-being.\n\nAs you progress through the game, you will face challenges such as controlling swarms, managing resources, and dealing with factors that can impact the health of the bees.\n\nImmerse yourself in the world of beekeeping and experience the joys and challenges of nurturing these vital pollinators in this realistic and educational virtual reality simulator game. Are you ready to become a master beekeeper? Let's get started!", "short_description": "Immerse yourself in the world of beekeeping and experience the joys and challenges of nurturing these vital pollinators in this realistic and educational virtual reality simulator game.\n\nInspect the hives, collect honey and beeswax, and tend to the needs of the bees. Maintain the hives, protect the bees from threats, and promote their well-being.\n\nAre you ready to become a master beekeeper? Let's get started!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bendisgames.com/beekeeping_simulator_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BENDIS Games", "support_website_url": "https://www.bendisgames.com/", "website_url": "https://www.bendisgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7341306535927685"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "2436126980213428"}, {"status": "PUBLISHED", "id": "27549356978036224"}, {"status": "PUBLISHED", "id": "1502899638046726"}, {"status": "PUBLI
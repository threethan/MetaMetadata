n_US", "screenshots": [{"file_name": "1.png", "id": "855750333708133", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499296119_855750337041466_4257580484102334040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUKXgmDBMswQ7kNvwGoBpDN&_nc_oc=AdrUiAB72kOziGl0AoCE_aggUlxkTRhQwoeT-KmbdyPUbpU87PB2XHzeKCmg7zm8mW4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGET-bsPPJFlkR8NijHmjpQpKIq-jGTdxLBnXa5XccmDQ&oe=6A973E32"}, {"file_name": "2.png", "id": "1563578208208817", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619836_1563578211542150_5586125073649547991_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HvWAqGJS_0Q7kNvwFWE3WM&_nc_oc=AdptIMXqX1kXZkPwF_I1o1v4dI9i9OrmXEUV1ZsZrcnQEZ_scE8hcQJRSPv6T3DO1aw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcEXxfAmY_LpLHnPj6Yp0034evsAd-7iTJnSjcHZ4JFw&oe=6A975200"}, {"file_name": "4.png", "id": "957109856855994", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617762_957109860189327_1095343448437736737_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glkvMmp3zWcQ7kNvwHN6eKo&_nc_oc=Adp9bEaVeWp4KkFvbrqe73IPdDOpAMB_TBGuk7S0MDGjLo6HlpeyfQYnPnL2jd7Z4vM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKSOa6-fHjHvpJXBH-onb5ZFjcc966yr3ovrzfANLXbw&oe=6A973B86"}, {"file_name": "3.png", "id": "3251141935052242", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499312310_3251141938385575_1584287310296096410_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxAFEE4EjpUQ7kNvwFoKV0L&_nc_oc=AdqiPjGRjmbxLPtmzrWllJJQO9iFy60tb3hPdt-KtS2aTKL8X7878HINtmCy8fTwqyw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSerlk6fqpKZyp3pcHG5vcb8wCVMheluL2IxukHcGBJA&oe=6A972EAD"}, {"file_name": "5.png", "id": "1698712391089542", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618277_1698712394422875_820298157895286684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bw2Oiz5PAcQ7kNvwHUYvQZ&_nc_oc=AdpGqvc_YgLWuJIzVMPdT7QaxYRP3r2lXD8uF36dB8nVvY1SrmleJJBxDlGqVkNq8WM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKaVsPeh4EbGj8izYOaY1FmhcCOIUObZ-RZ4XJ9wQaWA&oe=6A97485C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf Pro", "keywords": ["Golf", "Game"], "long_description": "**\u26f3 Golf Pro VR \u2014 Your Stress-Free Virtual Driving Range**\n\nTired of waiting your turn or fumbling through complicated menus? Golf Pro VR strips golf down to what actually matters: pick up your club, take your swing, and feel every shot. No lobbies, no limits, no pressure \u2014 just smooth, satisfying gameplay from the moment you put on your headset.\nNo pressure. No limits. Just swing and play.\n\n**\ud83c\udfaf Why You'll Love It**\n\n- Realistic Ball Physics \u2014 Natural flight, spin, and swing response that actually feels like golf\n- Unlimited Shots \u2014 A free sandbox range with no shot counters, no cooldowns, no interruptions\n- Runs Great Everywhere \u2014 Optimized for smooth performance on Quest 2, Quest 3, and Quest Pro\n- Instant Start \u2014 No tutorials to sit through \u2014 you're swinging within seconds of launching\n- Immersive, Clutter-Free Environment \u2014 A clean course setting designed to keep you focused and comfortable during longer sessions\n\n**\ud83c\udfcc\ufe0f Built for Practice, Not Pressure**\n\nWhether you're a total beginner or a real-world golfer working on your swing, Golf Pro VR is a judgment-free space to experiment:\n\n**Your Practice Space**\n\nGolf Pro VR is your personal driving range in virtual reality.\n\n- Learn timing, aim, and follow-through at your own pace\n- Repeat the same shot as many times as you want\n- No scorekeeping, no opponents, no rounds to finish \u2014 just you and the range\n\n**Step in. Swing easy. Play Golf Pro VR.**", "short_description": "Golf Pro \u2013 The most immersive VR golf experience.\nStep into real golf gameplay, hit unlimited shots, and play like a pro in stunning virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elegant-cascaron-d1d814.netlify.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VJVerse Studios", "support_website_url": null, "website_url": "https://elegant-cascaron-d1d814.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38634227352892626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617831_1508642923581978_6642746022726047034_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWrtkIeiFYsQ7kNvwFtmpxL&_nc_oc=AdpUEJma9JvtISacUNoInJLXy6HAcyOSzHP3OWy8fTbMW7CFllDIMkc4TJAnHtwLy04&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEja70D8PVujivAUJNQCFXeZazEe3I8XiLJ3NFWm9edIQ&oe=6A973807"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Golf Pro", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1767413280, "lastRevision": {"nodes": [{"id": "33696365926678818", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "33696365826678828", "is_first_party": false, "enables_in_app_ads": false, "is_concept"
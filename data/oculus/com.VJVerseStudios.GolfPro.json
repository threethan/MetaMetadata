culuscdn.com/v/t64.5771-25/499312310_3251141938385575_1584287310296096410_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxAFEE4EjpUQ7kNvwFoKV0L&_nc_oc=AdqiPjGRjmbxLPtmzrWllJJQO9iFy60tb3hPdt-KtS2aTKL8X7878HINtmCy8fTwqyw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSerlk6fqpKZyp3pcHG5vcb8wCVMheluL2IxukHcGBJA&oe=6A972EAD"}, {"file_name": "5.png", "id": "1698712391089542", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618277_1698712394422875_820298157895286684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bw2Oiz5PAcQ7kNvwHUYvQZ&_nc_oc=AdpGqvc_YgLWuJIzVMPdT7QaxYRP3r2lXD8uF36dB8nVvY1SrmleJJBxDlGqVkNq8WM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKaVsPeh4EbGj8izYOaY1FmhcCOIUObZ-RZ4XJ9wQaWA&oe=6A97485C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf Pro", "keywords": ["Golf"], "long_description": "Enter a new dimension of golf in virtual reality.\nGolf Pro delivers a refined, immersive golf experience designed to feel authentic, fluid, and deeply engaging \u2014 all from one dynamic location with unlimited shots.\n\nBuilt for realism and smooth performance, every swing is responsive, every shot feels intentional, and every session pulls you deeper into the game. Precision physics, natural motion handling, and carefully tuned gameplay combine to create a golf experience that feels grounded, rewarding, and replayable.\n\n\u26f3 Core Experience\n\n\u2022 Unlimited shots from a single immersive position\n\u2022 Realistic swing response and ball behavior\n\u2022 Clean, modern environments with depth and scale\n\u2022 Natural pacing designed for long, focused sessions\n\n\ud83c\udfae Gameplay Focus\n\nGolf Pro is crafted for players who want the true feeling of golf in VR \u2014 not simplified practice, but real shot execution, control, and satisfaction. Step in, line up your shot, and play freely without interruptions or limits.\n\n\ud83c\udf0d Designed for VR\n\n\u2022 Optimized for smooth Meta Quest performance\n\u2022 Intuitive controls with low learning curve\n\u2022 Minimal menus, maximum immersion\n\nWhether you\u2019re chasing perfect shots or simply enjoying the rhythm of the game, Golf Pro offers a pure, uninterrupted golf experience built for virtual reality.\n\n\u26f3 Step in. Swing free. Play Golf Pro.", "short_description": "Golf Pro \u2013 The most immersive VR golf experience.\nStep into real golf gameplay, hit unlimited shots, and play like a pro in stunning virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gentle-taiyaki-16f703.netlify.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VJVerse Studios", "support_website_url": null, "website_url": "https://gentle-taiyaki-16f703.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33696365890012155"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1771490640873787"}, {"status": "PUBLISHED", "id": "970318539327279"}, {"status": "PUBLISHED", "id": "1691884295464691"}, {"status": "CANCELLED", "id": "1324082739701859"}, {"status": "PUBLISHED", "id": "614753248400050"}, {"status": "PUBLISHED", "id": "1998005154263409"}]}, "baseline_offer": {"id": "1771490640873787"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786415880, "status": "PUBLISHED", "id": "1771490640873787"
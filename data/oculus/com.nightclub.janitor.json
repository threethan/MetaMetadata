5_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK4pTPs5nK8Q7kNvwGrsLr8&_nc_oc=AdrP-Hyn897d4lwUj7PF2EBpOjdU8vLMRuuA_6C8zDfqou14eCO7cmLFDO_syn1289k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUbLatC4fDHJ2AqbEcZc65KTRZFuyAJuQz7bqw1-TW2Q&oe=6B0D9D23"}, {"file_name": "01_restroom_cleanup.png", "id": "1631020512106847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/618722728_1631020515440180_3340787697193448266_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6vcVWlFiesQ7kNvwGJwt2V&_nc_oc=AdpN1WnsW73bkRggFcQ4poWjLnzCieY51Ggf1Cj0Nbv60UCNDX6eX9d-1GAEVh0HTAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3FqHDMRWqd5KPeZMmUKauh1k74QJxuwsY1ZuZ7e8Bew&oe=6B0D9C30"}, {"file_name": "03_dancefloor_freeze.png", "id": "5588818128009429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613063873_5588818131342762_4434986940720254032_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al8_XNQso-wQ7kNvwGwuUjV&_nc_oc=AdrOIpztOVAsyYrpKVzuo2Asrr3aqiFbM2365GOW3Z6b_WiDm8bNWsLHK73vOGbgE0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlkxKEmXLVhxJ8yzyQhoQ04FzQ26qsKNd48eBhpCq0QQ&oe=6B0DC502"}, {"file_name": "05_lockdown.png", "id": "1013548351813245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673652249_1013548355146578_4946784631555447817_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCjdXr6fHIoQ7kNvwH5iD_u&_nc_oc=AdrENcGp5P-rco4hlq-pyrgVbiIsFvybAK7t6kOJIi7gky74Eivf0fr70ZX_Ov7C11w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7epsDrfOqkqEsRmMeq5sX863qRul_YsHxytbVa5FKOQ&oe=6B0DC110"}, {"file_name": "02_stage_gig.png", "id": "1455319336028832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_1455319339362165_3264177699738261701_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUMZWkUu6BcQ7kNvwF8recx&_nc_oc=AdqB5Qs7BLNRBa-73ER7u8FVHfQ6TuV7yf41e_TKnJIAemz69K2vbPxNrurprvV_Zpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj4Gosc7TJdNi4xVWTQbZfmZHdROOfnNkIjAHSTM3p9A&oe=6B0DD07C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Job Simulator: NightClub Janitor", "keywords": ["nightclub", "job", "cleaning", "janitor", "simulator"], "long_description": "Welcome to the night shift. \ud83e\uddf9\n\nA VR job simulator and physics sandbox. You're the janitor at the city's wildest club. Clean up after the party, earn cash and climb the ranks, or turn the whole club into your playground. Your shift, your rules.\n\n\ud83e\uddfd SATISFYING CLEANING Mop spills, scrape gum, vacuum crumbs, roll over graffiti, plunge toilets, fix burst pipes and put out fires. Every tool has weight, sound and a clear before and after.\n\n\ud83e\uddf0 TOOL BELT & JANITOR CART Carry more than one tool. Holster your gear on your belt, push your cart to the job, and call your last tool back to your hand.\n\n\ud83c\udfc6 BEAT THE SHIFT Every night brings jobs from the boss and a mess you can actually finish. Get the club spotless before closing time for a top grade, tips and bonus cash.\n\n\ud83d\ude08 CHAOS HAS CONSEQUENCES Tired of cleaning? Unlock a flamethrower, gravity gun, freeze gun, nunchucks and more. Freeze the guests, start a brawl, grab the cash... but every prank raises your heat. Push too far and the boss, security, police and SWAT come for you. Hide in the janitor room until it blows over.\n\n\ud83d\udd90\ufe0f EVERYTHING IS GRABBABLE Full physics hands. Pick up, throw, swing, break and juggle almost anything in the club. Shove guests, high-five them, or send them flying.\n\n\ud83e\udea9 TAKE OVER THE CLUB Play a set at the DJ booth, rock the crowd on stage, shoot pool, throw darts, go bowling, test your punch on the boxing machine, feed the shark, and score trash shots into the bin.\n\n", "short_description": "Clean the wildest nightclub in VR, or wreck it. A physics sandbox janitor simulator: mop, scrub and earn cash, then grab the freeze gun when the boss isn't looking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426493913886203"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1490981659581482"}]}, "baseline_offer": {"id": "1490981659581482"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794963720, "status": "PUBLISHED", "id": "1490981659581482"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1427159997152928", "version": "0.2"}, "id": "1562820372553116", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1426493907219537", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1427159997152928"}, "release_status": "RE
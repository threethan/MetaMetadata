28314_1455319339362165_3264177699738261701_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUMZWkUu6BcQ7kNvwF8recx&_nc_oc=AdqB5Qs7BLNRBa-73ER7u8FVHfQ6TuV7yf41e_TKnJIAemz69K2vbPxNrurprvV_Zpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj4Gosc7TJdNi4xVWTQbZfmZHdROOfnNkIjAHSTM3p9A&oe=6B0DD07C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Job Simulator: NightClub Janitor", "keywords": ["nightclub", "job", "cleaning", "janitor", "simulator"], "long_description": "Welcome to the night shift. \ud83e\uddf9\n\nA VR job simulator and physics sandbox. You're the janitor at the city's wildest club. Clean up after the party, earn cash and climb the ranks, or turn the whole club into your playground. Your shift, your rules.\n\n\ud83e\uddfd SATISFYING CLEANING Mop spills, scrape gum, vacuum crumbs, roll over graffiti, plunge toilets, fix burst pipes and put out fires. Every tool has weight, sound and a clear before and after.\n\n\ud83e\uddf0 TOOL BELT & JANITOR CART Carry more than one tool. Holster your gear on your belt, push your cart to the job, and call your last tool back to your hand.\n\n\ud83c\udfc6 BEAT THE SHIFT Every night brings jobs from the boss and a mess you can actually finish. Get the club spotless before closing time for a top grade, tips and bonus cash.\n\n\ud83d\ude08 CHAOS HAS CONSEQUENCES Tired of cleaning? Unlock a flamethrower, gravity gun, freeze gun, nunchucks and more. Freeze the guests, start a brawl, grab the cash... but every prank raises your heat. Push too far and the boss, security, police and SWAT come for you. Hide in the janitor room until it blows over.\n\n\ud83d\udd90\ufe0f EVERYTHING IS GRABBABLE Full physics hands. Pick up, throw, swing, break and juggle almost anything in the club. Shove guests, high-five them, or send them flying.\n\n\ud83e\udea9 TAKE OVER THE CLUB Play a set at the DJ booth, rock the crowd on stage, shoot pool, throw darts, go bowling, test your punch on the boxing machine, feed the shark, and score trash shots into the bin.\n\n", "short_description": "Clean the wildest nightclub in VR, or wreck it. A physics sandbox janitor simulator: mop, scrub and earn cash, then grab the freeze gun when the boss isn't looking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426493913886203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_1027774186352332_8994042100188669598_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U1S0FMU7BQQ7kNvwFP6AIH&_nc_oc=Adr-Dwnp7iTE5Q7OvcUiC7jcy9Fnzw7tFk-NYMdi8-j1koZCMpaOKkRqpqkRF0CWn10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTxu8240Y9LBpH8cpJIJDgrcQyHukmnwzLpgsEwXGdig&oe=6B0DC8B2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Job Simulator: NightClub Janitor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
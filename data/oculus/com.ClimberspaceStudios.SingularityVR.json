1698509124551625", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1698509127884958_3462372611220339303_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4n8QugY9HMQ7kNvwExEqj-&_nc_oc=AdpxmSRR2xjF85WgoSSeCZgs8WmO4JWcWvTi3asPDULAG5V2ymC91Zc8rsY3eJ1a3sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTHkSUm-DowKfOVi3EqbtgyKUpGrhGSeUb8cDkzSdpug&oe=6ADE202C"}, {"file_name": "86d4207caecc4bbba54c2c06e00924ae.png", "id": "1350772766999423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310651_1350772770332756_3815968784629696392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPW3Pcw51F4Q7kNvwEXqdlE&_nc_oc=AdoKDIGy7n7DLFjE6coYKc_mr6sKVLoCZAO4KJJkoMCUNNgiZjVjcDtKWWW5cBweMUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcWc_hKNZBdxFmVlmFJ6JyiZ5txSeZrDQG8zUMn3FVdw&oe=6ADE082F"}, {"file_name": "b4d1876b8461495ba3309ffd05162fd9.png", "id": "1338667031556771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596068480_1338667034890104_7059448834119857994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkiXBy9SFRwQ7kNvwGGm5_1&_nc_oc=AdolggWOuaqll2TKTPjWyzp8BwFCUdSIRjRNXmf8876COPzdi8LJP-AiwzWfoUJGQB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT1yOGa7TIAF4fukg0HKnFKc9v6bYUsO3jd8Ty69nJ4g&oe=6ADE25C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SGVRTrailerCover.png", "id": "1489970458990826", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314641_1489970465657492_5101885299613120494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVxjFKyb5rAQ7kNvwEE37C4&_nc_oc=AdrF5YK1t2YZEmQkkHQyEn2axhuljMcW5RkQGbaHhYKzCWyPkE480Lhezg8oaxUuRS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9ngbKsOlU0BesXgGF3hiESmGPt8oXLsUV-EjQ3TQIUA&oe=6ADE20DD"}, "display_name": "Singularity VR", "keywords": ["SGVR", "SingularityVR", "ClimberspaceStudios", "singularity"], "long_description": "\nExplore the Singularity.\n\nDeveloped by Yoda's Gaming Galaxy and Climberspace Studios, Singularity VR is a virtual reality experience designed to push the boundaries of immersive gaming. Whether you are stepping into a virtual world for the first time or you are a seasoned VR veteran, this game delivers a gripping, unforgettable experience built from the ground up for modern VR hardware.\n\nWe wanted to create something that feels as incredible to play as it looks. Through a passionate collaboration between our two studios, we have crafted a world that responds to your every move, drawing you deeper into the gameplay with every session.\n\nKey Features:\n\nBuilt for Immersion: Experience fluid controls, stunning visuals, and a world designed entirely around the unique strengths of virtual reality.\n\nA True Collaboration: Brought to life by the combined creative vision and technical expertise of Yoda's Gaming Galaxy and Climberspace Studios.\n\nEngaging Gameplay: Engage in competitive movement-based combat, or if you prefer a more relaxed pace, enjoy the atmosphere of Sector 1. Explore the vastness of space to experience true", "short_description": "Step into the Singularity, a collaborative VR experience built for immersion and exploration. Master unique movement mechanics, engage in competitive combat, or drift through the silence of space in stunning Zero-Gravity. Whether you are battling for victory or chilling in Sector 1, your journey into the Singularity awaits. Discover the next step in VR gaming today!"}]}, "developer_name": "Yoda's Gaming Galaxy", "developer_privacy_policy_url": "https://climberspacestudios.vercel.app/singularityvr", "developer_terms_of_service_url": "https://climberspacestudios.vercel.app/tos", "publisher_name": "Climberspace Studios", "support_website_url": "https://climberspacestudios.vercel.app/support", "website_url": "https://climberspacestudios.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035
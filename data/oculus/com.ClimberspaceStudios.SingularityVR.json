https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310651_1350772770332756_3815968784629696392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ7BMFA9FykQ7kNvwHaSAw1&_nc_oc=AdqnrpkHNVwuzZBZfm06wuu8asInIaSHhlGTJswq53jDzhQcfPJn2_rbzunHBVpkjKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeEtF_1Vn-lK-f-J6DHLvLQbxk6cIyB7WEyTzU_8U5Vg&oe=6A9C1D2F"}, {"file_name": "b4d1876b8461495ba3309ffd05162fd9.png", "id": "1338667031556771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/596068480_1338667034890104_7059448834119857994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuFgmD5sZdoQ7kNvwFrgrep&_nc_oc=Adrxa0eVl8VqegvRBfsrNrkCFt7-cYV7aAvKNciJvFZDn4Et0MsJOz8TeQEufALXbPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmmRWAAuynR_jiG2WXpoFVwgO0TiRcw6K-DHaSeQHzjg&oe=6A9C3AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SGVRTrailerCover.png", "id": "1489970458990826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_1489970465657492_5101885299613120494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcxy985OGIEQ7kNvwHNcpQD&_nc_oc=Adpwh_cXJuK74O9Zu1vmFdhnPjEE-zGLNo1ptLPyEQTHu72sr3QcHgfwHBiBp2IecZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEsxA19eEW-8T45PzazbLKKNd7raK1busFMjCL74Vfug&oe=6A9C35DD"}, "display_name": "Singularity VR", "keywords": ["SGVR", "SingularityVR", "ClimberspaceStudios", "singularity"], "long_description": "\nExplore the Singularity.\n\nDeveloped by Yoda's Gaming Galaxy and Climberspace Studios, Singularity VR is a virtual reality experience designed to push the boundaries of immersive gaming. Whether you are stepping into a virtual world for the first time or you are a seasoned VR veteran, this game delivers a gripping, unforgettable experience built from the ground up for modern VR hardware.\n\nWe wanted to create something that feels as incredible to play as it looks. Through a passionate collaboration between our two studios, we have crafted a world that responds to your every move, drawing you deeper into the gameplay with every session.\n\nKey Features:\n\nBuilt for Immersion: Experience fluid controls, stunning visuals, and a world designed entirely around the unique strengths of virtual reality.\n\nA True Collaboration: Brought to life by the combined creative vision and technical expertise of Yoda's Gaming Galaxy and Climberspace Studios.\n\nEngaging Gameplay: Engage in competitive movement-based combat, or if you prefer a more relaxed pace, enjoy the atmosphere of Sector 1. Explore the vastness of space to experience true", "short_description": "Step into the Singularity, a collaborative VR experience built for immersion and exploration. Master unique movement mechanics, engage in competitive combat, or drift through the silence of space in stunning Zero-Gravity. Whether you are battling for victory or chilling in Sector 1, your journey into the Singularity awaits. Discover the next step in VR gaming today!"}]}, "developer_name": "Yoda's Gaming Galaxy", "developer_privacy_policy_url": "https://climberspacestudios.vercel.app/singularityvr", "developer_terms_of_service_url": "https://climberspacestudios.vercel.app/tos", "publisher_name": "Climberspace Studios", "support_website_url": "https://climberspacestudios.vercel.app/support", "website_url": "https://climberspacestudios.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], 
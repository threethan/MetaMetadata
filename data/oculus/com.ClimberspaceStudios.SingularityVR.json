https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310651_1350772770332756_3815968784629696392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRXsUASb_HQQ7kNvwG-oSrh&_nc_oc=AdqUwvxuweLX3pLpuajF25ZWFZg789RBJv7RbGaZzju-e1R3isQRPxR2rH9joRXBJow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPScWh0FPqpt3FKOc6ab58q8gNAQHdW5KWWMwWO_X5l8Q&oe=6ACCE4AF"}, {"file_name": "b4d1876b8461495ba3309ffd05162fd9.png", "id": "1338667031556771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596068480_1338667034890104_7059448834119857994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mysL7TiLwKkQ7kNvwGRMO2o&_nc_oc=Adon_CZo_dqHMLHCvydND9E2yVIevz-1Hri7Ps_gaLXft_MJHLNcYr7O3nVPZQkn40s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXyR_P5Yw0p6mTdFqvKO1Y3TRhKBMpFaGNYRaYBTuDTA&oe=6ACD0240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SGVRTrailerCover.png", "id": "1489970458990826", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314641_1489970465657492_5101885299613120494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSogpVUobCcQ7kNvwEu14ai&_nc_oc=AdpiYHXsDA10FL8rNFBu2gZICokwE8mQkmOuQ-IrMNNqcteiaxPFn_mGlsmFZIORhXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvbeeCul4YKLpLrRPVD2L-2yUv9m7iNSIfTJIMp1ObLQ&oe=6ACCFD5D"}, "display_name": "Singularity VR", "keywords": ["SGVR", "SingularityVR", "ClimberspaceStudios", "singularity"], "long_description": "\nExplore the Singularity.\n\nDeveloped by Yoda's Gaming Galaxy and Climberspace Studios, Singularity VR is a virtual reality experience designed to push the boundaries of immersive gaming. Whether you are stepping into a virtual world for the first time or you are a seasoned VR veteran, this game delivers a gripping, unforgettable experience built from the ground up for modern VR hardware.\n\nWe wanted to create something that feels as incredible to play as it looks. Through a passionate collaboration between our two studios, we have crafted a world that responds to your every move, drawing you deeper into the gameplay with every session.\n\nKey Features:\n\nBuilt for Immersion: Experience fluid controls, stunning visuals, and a world designed entirely around the unique strengths of virtual reality.\n\nA True Collaboration: Brought to life by the combined creative vision and technical expertise of Yoda's Gaming Galaxy and Climberspace Studios.\n\nEngaging Gameplay: Engage in competitive movement-based combat, or if you prefer a more relaxed pace, enjoy the atmosphere of Sector 1. Explore the vastness of space to experience true", "short_description": "Step into the Singularity, a collaborative VR experience built for immersion and exploration. Master unique movement mechanics, engage in competitive combat, or drift through the silence of space in stunning Zero-Gravity. Whether you are battling for victory or chilling in Sector 1, your journey into the Singularity awaits. Discover the next step in VR gaming today!"}]}, "developer_name": "Yoda's Gaming Galaxy", "developer_privacy_policy_url": "https://climberspacestudios.vercel.app/singularityvr", "developer_terms_of_service_url": "https://climberspacestudios.vercel.app/tos", "publisher_name": "Climberspace Studios", "support_website_url": "https://climberspacestudios.vercel.app/support", "website_url": "https://climberspacestudios.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], 
mibk3Ih3SgPOC1AJ4NLv1DFXbg&oe=6AEE0A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sgvrbanner (1).png", "id": "3317516878637114", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_3317516881970447_6993684243039772033_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxhMPDYk61QQ7kNvwF1N8VR&_nc_oc=AdovL3fE3YGLDd-toCvWCrDUDA1AbGkzGTtvIVUQ6PBlvo5Wfgi8ROmaevjNQnSvhII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM0qveM_ZMyOdi6q9ZV1q0jCKfQ6_UV05uM13qf2Iejg&oe=6AEDF481"}, "display_name": "Singularity VR", "keywords": ["SGVR", "SingularityVR", "ClimberspaceStudios", "singularity"], "long_description": "\nExplore the Singularity.\n\nDeveloped by Yoda's Gaming Galaxy and Climberspace Studios, Singularity VR is a virtual reality experience designed to push the boundaries of immersive gaming. Whether you are stepping into a virtual world for the first time or you are a seasoned VR veteran, this game delivers a gripping, unforgettable experience built from the ground up for modern VR hardware.\n\nWe wanted to create something that feels as incredible to play as it looks. Through a passionate collaboration between our two studios, we have crafted a world that responds to your every move, drawing you deeper into the gameplay with every session.\n\nKey Features:\n\nBuilt for Immersion: Experience fluid controls, stunning visuals, and a world designed entirely around the unique strengths of virtual reality.\n\nA True Collaboration: Brought to life by the combined creative vision and technical expertise of Yoda's Gaming Galaxy and Climberspace Studios.\n\nEngaging Gameplay: Engage in competitive movement-based combat, or if you prefer a more relaxed pace, enjoy the atmosphere of Sector 1. Explore the vastness of space to experience true", "short_description": "Step into the Singularity, a collaborative VR experience built for immersion and exploration. Master unique movement mechanics, engage in competitive combat, or drift through the silence of space in stunning Zero-Gravity. Whether you are battling for victory or chilling in Sector 1, your journey into the Singularity awaits. Discover the next step in VR gaming today!"}]}, "developer_name": "Yoda's Gaming Galaxy", "developer_privacy_policy_url": "https://climberspacestudios.vercel.app/singularityvr", "developer_terms_of_service_url": "https://climberspacestudios.vercel.app/tos", "publisher_name": "Climberspace Studios", "support_website_url": "https://climberspacestudios.vercel.app/support", "website_url": "https://climberspacestudios.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1765281484799969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2907461446293690_3976479455648889863_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9VeBQOYWcgQ7kNvwHRijiN&_nc_oc=AdpbWrXkWZAunfgB0syQFsVow7cYk63_RQxYTdjLyF7q8XRKXg-I1whKy5VnpjliDa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF4A017G8aqsDyPBTqXdASHXg87Zrr58Wsy02ZvwOrTw&oe=6AEDD666"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Singularity VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": 
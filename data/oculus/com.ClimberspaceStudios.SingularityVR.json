1698509124551625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1698509127884958_3462372611220339303_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h17Bc_gK3oQ7kNvwHzWgXE&_nc_oc=Adqg4Ib_b3WED7VwBdaabLrOY4iGyT4WOS56G1NkQrodwvGH7F67VIGk6bsuaEl8f4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl2Jpr-glb7ngKs9j-mALRbRYMlJb0XsACEBqxO-S6eQ&oe=6AE75AAC"}, {"file_name": "86d4207caecc4bbba54c2c06e00924ae.png", "id": "1350772766999423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310651_1350772770332756_3815968784629696392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zCEoEn4E60Q7kNvwHHMZ68&_nc_oc=AdpgYq94MBo5Ap9K4hxu51KST-Sg3JDrxRGJJPYEB7Mgu5_qXLjlluIhc7vubbwJ5to&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe2p4kD1XLppkKybQfGDFbf9ptewtxDZlRr3Ac6q8C5A&oe=6AE742AF"}, {"file_name": "b4d1876b8461495ba3309ffd05162fd9.png", "id": "1338667031556771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1338667034890104_7059448834119857994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEFUg5jyd84Q7kNvwF6i3Wv&_nc_oc=AdrU8CxxcTugDf_TZqVLCyJAcbQqK3ckLbvUlw51gLqzhgQzqlt9FyfEKXfl4ZcrZnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl-XXjyqutBO5RYQrlvvP01pyvM9ZuFv2s4Hln7CDPyg&oe=6AE76040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SGVRTrailerCover.png", "id": "1489970458990826", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_1489970465657492_5101885299613120494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vzgz3h_IfGYQ7kNvwFkmu1C&_nc_oc=AdpxRR5ISEXnZQZ9wpyWlIpovieSkZn5XRExinBl6qb3Roub12602ucQPWtCe31oIrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTf7SwP1DCfbJiy3fCEFyRShXOCDZTRBXq9N4-4k3Aog&oe=6AE75B5D"}, "display_name": "Singularity VR", "keywords": ["SGVR", "SingularityVR", "ClimberspaceStudios", "singularity"], "long_description": "\nExplore the Singularity.\n\nDeveloped by Yoda's Gaming Galaxy and Climberspace Studios, Singularity VR is a virtual reality experience designed to push the boundaries of immersive gaming. Whether you are stepping into a virtual world for the first time or you are a seasoned VR veteran, this game delivers a gripping, unforgettable experience built from the ground up for modern VR hardware.\n\nWe wanted to create something that feels as incredible to play as it looks. Through a passionate collaboration between our two studios, we have crafted a world that responds to your every move, drawing you deeper into the gameplay with every session.\n\nKey Features:\n\nBuilt for Immersion: Experience fluid controls, stunning visuals, and a world designed entirely around the unique strengths of virtual reality.\n\nA True Collaboration: Brought to life by the combined creative vision and technical expertise of Yoda's Gaming Galaxy and Climberspace Studios.\n\nEngaging Gameplay: Engage in competitive movement-based combat, or if you prefer a more relaxed pace, enjoy the atmosphere of Sector 1. Explore the vastness of space to experience true", "short_description": "Step into the Singularity, a collaborative VR experience built for immersion and exploration. Master unique movement mechanics, engage in competitive combat, or drift through the silence of space in stunning Zero-Gravity. Whether you are battling for victory or chilling in Sector 1, your journey into the Singularity awaits. Discover the next step in VR gaming today!"}]}, "developer_name": "Yoda's Gaming Galaxy", "developer_privacy_policy_url": "https://climberspacestudios.vercel.app/singularityvr", "developer_terms_of_service_url": "https://climberspacestudios.vercel.app/tos", "publisher_name": "Climberspace Studios", "support_website_url": "https://climberspacestudios.vercel.app/support", "website_url": "https://climberspacestudios.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035
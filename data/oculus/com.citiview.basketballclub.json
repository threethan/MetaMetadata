1-7&_nc_sid=6e7a0a&_nc_ohc=nHdtVgZha_8Q7kNvwFXPEW9&_nc_oc=Adp5qPdZs4S7F0juzQTdjEkunOb1eWNRsjhcD_K0WqKlDxkUJZDwbYL-LeHHjwI0zI0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0XETgw_BNNe7uEjUv_cB7svNo7XnQgUcU-wwRodmiSg&oe=6AF08122"}, {"file_name": "screenshot_4_2560x1440.png", "id": "2533302183801878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_2533302187135211_2114368046006720111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p096jJK0S1YQ7kNvwEy3uvA&_nc_oc=AdouVPv0JdseXY43_ZxIfxOZVcPUAKGN8hAJONZIAG0jDSBP8mWKj0iAEnBPoBr0awc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQksrpWYEWBDWJcWVP0gcw_ui7QNr8yLRQw8aK7IRjLFg&oe=6AF0AB6B"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1907522487324599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1907522490657932_3784061602503206596_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5xdfsIozScQ7kNvwHqQnKm&_nc_oc=AdpNwuJxF90k3yC04mliLD0GgSZHVyex4_tLOUPH2lmYIUD9PbE7-3tMPtqk_WmkJJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlayswQy8XIyEaQfESAFxfZueOs3rsQS7ysNU3E3XlKg&oe=6AF08AFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Basketball Club", "keywords": ["basketball", "hoops", "sports", "arcade", "court"], "long_description": "Your own basketball club, and nobody else is booked in.\n\nA full-size hardwood court sits under a gabled steel roof, with afternoon sun coming through the clerestory windows and laying stripes across the boards. Real glass backboards. Real ten-foot rims. Painted lines measured off the rule book, bleachers down one side, banners in the rafters, and a members lounge behind the baseline.\n\nSHOOTING THAT JUST WORKS\nThere is no shoot button. Pick up a ball, make the motion, and it releases itself at the top of your swing - exactly where a real shooter lets go. Backspin comes off your hand. The ball is a proper size seven with pebbled leather, and it bounces, rattles the rim and rings off the glass like the real thing. Five minutes in you stop thinking about the controller.\n\nFOUR WAYS TO PLAY\nFREE SHOOT - no clock. Twenty balls on the carts, both baskets live, shoot until you feel like stopping.\nSHOOTOUT - sixty seconds. Twos inside the arc, threes outside, one number to beat.\nTHREE POINT - five racks around the arc, four balls on each, and the last ball on every rack is worth double.\nAROUND THE WORLD - seven spots, in order. Make one to move on. Your fastest lap is kept.\n\nScores, the clock and your personal best hang over the backboard where a shot clock goes, so you never look away from the rim. Pick a track from the in-game menu and shoot to it.\n\nStanding or roomscale. Pick it up for five minutes or an hour.", "short_description": "Step onto a full-size hardwood court in your own private basketball club. Pick up a ball, make the shooting motion, and it leaves your hand by itself at the top of the swing - no button to press, no timing to learn. Shoot around all day, or take on the 60-second shootout, the five-rack three-point contest and around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/basketballclub/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/basketballclub/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
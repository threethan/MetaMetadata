8382_128397395817231_4481716845080667972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEi8PhPp4SsQ7kNvwFRSh4S&_nc_oc=AdrthYXmCiSBs14wbo2l1gqcrS-88xHq9N4vZfqeaJ-TeFBPkFLBeM1Ta98oY-uDiPA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HG3Yf_T92k-H1EAGrpMMAbksM3c91fRoIFQohqFY8EQ&oe=69F203CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Tourviewer", "keywords": [], "long_description": "VR Tourviewer can handle tours exported with HTML5 output from Pano2VR. \nBrowse the featured tours, add your own online URLs or show tours stored locally on your device for offline use.\n\nSupported features: monoscopic and stereoscopic tours, hotspot navigation, image and video overlays, surround sound and 360 panorama videos. Skins and scripts aren't supported. As extra feature, you can easily add falling leaves, snow or rain to your panoramas for an even more immersive experience!\n\nA version without watermarks or a customized/white label version is available from https://www.vrtourviewer.com\n\nDeveloped by 3DV - The Netherlands. \nNote that 3DV is not affiliated with Garden Gnome, the creator of Pano2VR.", "short_description": "Use VR Tourviewer to experience virtual reality tours created with Pano2VR, online and offline."}]}, "developer_name": "Ruud van Reenen - 3DV", "developer_privacy_policy_url": "https://www.vrtourviewer.com/privacy-policy-vr-tourviewer/", "developer_terms_of_service_url": "https://www.vrtourviewer.com/terms-of-service/", "publisher_name": "3DV Netherlands", "support_website_url": "https://www.vrtourviewer.com/knowledge-base/", "website_url": "http://www.vrtourviewer.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "UTILITY"], "has
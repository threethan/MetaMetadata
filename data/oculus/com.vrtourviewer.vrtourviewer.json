2_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9-lp0DVKxUQ7kNvwGCVKlI&_nc_oc=AdmMe9NGoqM4u3E4HjbhNZuDW0SSrbGXPGV2gpusQQA_-lAgNfRI767HRdJTucO1K70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuMJBqaTi72x66AYRKsn5PdjOXSVWs4BVJ_q1n8c7veEQ&oe=699B00CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Tourviewer", "keywords": [], "long_description": "VR Tourviewer can handle tours exported with HTML5 output from Pano2VR. \nBrowse the featured tours, add your own online URLs or show tours stored locally on your device for offline use.\n\nSupported features: monoscopic and stereoscopic tours, hotspot navigation, image and video overlays, surround sound and 360 panorama videos. Skins and scripts aren't supported. As extra feature, you can easily add falling leaves, snow or rain to your panoramas for an even more immersive experience!\n\nA version without watermarks or a customized/white label version is available from https://www.vrtourviewer.com\n\nDeveloped by 3DV - The Netherlands. \nNote that 3DV is not affiliated with Garden Gnome, the creator of Pano2VR.", "short_description": "Use VR Tourviewer to experience virtual reality tours created with Pano2VR, online and offline."}]}, "developer_name": "Ruud van Reenen - 3DV", "developer_privacy_policy_url": "https://www.vrtourviewer.com/privacy-policy-vr-tourviewer/", "developer_terms_of_service_url": "https://www.vrtourviewer.com/terms-of-service/", "publisher_name": "3DV Netherlands", "support_website_url": "https://www.vrtourviewer.com/knowledge-base/", "website_url": "http://www.vrtourviewer.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED
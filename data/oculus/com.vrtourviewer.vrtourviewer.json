.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vVpKA0XtyEQ7kNvwH3qXz9&_nc_oc=Adq_X4IjcqNug-F-kHPDZ17xho_21S0TQJQywgXasNYvpszLOv7DIk370dg-vmObEp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpsDZ_qLc_x2KfxhrdcAnAvRbWUp7eQHwyjob4p8onBA&oe=6AFDDEAD"}, {"file_name": "Screenshot-Menu-01.png", "id": "128397392483898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75488382_128397395817231_4481716845080667972_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Heh3iXwfU5MQ7kNvwFsUb5c&_nc_oc=AdqykMgseWaPFaVhMRvjMQTD6NUohkbF6-29YKspZF513-hD0kUMnAsPTYTqZSnEkpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvjj1kB2PB4z9hShLLBfZ3V82HhQLW_spnTTp5Wt7iaQ&oe=6AFDDC8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Tourviewer", "keywords": [], "long_description": "VR Tourviewer can handle tours exported with HTML5 output from Pano2VR. \nBrowse the featured tours, add your own online URLs or show tours stored locally on your device for offline use.\n\nSupported features: monoscopic and stereoscopic tours, hotspot navigation, image and video overlays, surround sound and 360 panorama videos. Skins and scripts aren't supported. As extra feature, you can easily add falling leaves, snow or rain to your panoramas for an even more immersive experience!\n\nA version without watermarks or a customized/white label version is available from https://www.vrtourviewer.com\n\nDeveloped by 3DV - The Netherlands. \nNote that 3DV is not affiliated with Garden Gnome, the creator of Pano2VR.", "short_description": "Use VR Tourviewer to experience virtual reality tours created with Pano2VR, online and offline."}]}, "developer_name": "Ruud van Reenen - 3DV", "developer_privacy_policy_url": "https://www.vrtourviewer.com/privacy-policy-vr-tourviewer/", "developer_terms_of_service_url": "https://www.vrtourviewer.com/terms-of-service/", "publisher_name": "3DV Netherlands"
=7f20f&oh=00_AQSr1zXPliP2zEJFhGzBqw7IyxbCIRAxACdWTdk8Rx-X1A&oe=6B031B01"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfYm2mOpt3MQ7kNvwFeW-z8&_nc_oc=AdrighhO9dwyzHeRI1lRgPbMVD5OXkK1ShvJ6SZjsSQeZV3XRcBpxn26lBckpV6uG1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7wA9ZnmX5fQevRDvCfUspDCtdboTKc3fKPH3J0KPuug&oe=6B033428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmKUe46DIJcQ7kNvwExDlg8&_nc_oc=Adp3MC4uXyI5ctjxwIWQ3I5Tvpl3FDKPw7N1AbXQnQEjDGzsRZz566yRRurSF0PGWQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9aDWBx-FPBaSlRzNhmM_VffpkkxOpVWvpobOnSW-o8g&oe=6B032939"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
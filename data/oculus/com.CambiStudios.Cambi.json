2300342807475802654_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emMudF1O2gQQ7kNvwEfGSIf&_nc_oc=AdmO-HABkqR_Ub4Pz8_NDYQ3bu60h_6nvpiOEnBqU1xWsR1B2eP4B2gtLlr8DVHOWrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB2anjcRMVPVHNKIbWhUrj22zx85HqeDgKXcJl0gDwHw&oe=69AD7C79"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cambivr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cambi Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/cambivr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
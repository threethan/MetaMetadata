&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqHr53RXg98Q7kNvwH1b7Uj&_nc_oc=AdoZ15IK2AOJ2MeWSuqmMk1yB8SeJNi-ljFc1MMnWZBPNjYRiF_nib2JiXbbxEyP8Kg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtt2jme8Eud-E20mRdWTKnFg9JWLFmN_tcKttiQMB1Gw&oe=6B0B3C41"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVOrwX_QipgQ7kNvwGk-9oA&_nc_oc=AdoHMiaxgrSsCAF3muHKb1IghA39YxgHKG4AzmeHycGa-t2K4GLyC3RnMEOCwTeOkkk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnCzmZhI0GDra6RNw17ORiqp0n2DNrMMRZvGVWKDc8oA&oe=6B0B1D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV25I6_c9ekQ7kNvwF5SFNQ&_nc_oc=AdqvZPRSw2wvylO9QjZe9ylrhDsLOxc5nM2oz6q5AUIbrmC0oURfp5lBZp0Xq2hR-OE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4gVq1FWfvytOaJRHEBzrIN9Ov6xhVm7pa4DVOe6MDJA&oe=6B0B1239"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cambivr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cambi Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/cambivr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8559918250797756"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974759_872590945074579_2311212587367415140_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu1Cchv4h1oQ7kNvwHf5eFJ&_nc_oc=Adrqnb1xNyXInrzBfrt6g7UL7S94ocNvLXIGOa2vyNfhTHd9lxfnHW6pSOmEJ0qGvu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSk0TlrGCvJ52cTLXukaORrgbyxoqHsH0xFChEOh2LXXQ&oe=6B0B389A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cambi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Adventure", "id": "2691890
41"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoAD_UfIPFIQ7kNvwEptUN2&_nc_oc=AdrxTcL5bGQ5TiR_pffs8s5GkrFg96b0zNl7ATuVJNmfSpEHMjZqX6unMj3xkgZBUW4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGemTUTezxu214Tr8Z72F63FoNljLH-8xxbYuk2KXA_SQ&oe=6A8D6E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=namT-u584rYQ7kNvwECHMRS&_nc_oc=AdqIyn2RfT5D3frpK4bAlGskmYA2hcFrkttSzmtVJSQh2X56tP3twS_RWPibTTGxREI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLFYjOPN-R83QedHHf1yWCNFBQQGC1eQ3ZOJ54YUFAKg&oe=6A8D9B79"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cambivr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name
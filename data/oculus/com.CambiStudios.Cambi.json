=7f20f&oh=00_AQR68K7S6ZF7Gh3s2DjRRFB6EPD6FuLGevAH29F1u-2uQQ&oe=6AFB3201"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A2v2ZOrd5QQ7kNvwH5rxto&_nc_oc=AdoB_4y3EALCZJt-Oe2qsWeUR1kOpEYEciAo7LzobJj1_LEZZnjr1lhYLIaKD6xZPDg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTew2kizFSDqXNLN8QGUfwml7T0LBeuD2MZEZ-Um9LGOw&oe=6AFB4B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jz_OPv97LBAQ7kNvwHYA49l&_nc_oc=Adp9JFkNqI3vc5IT6GViT1nCoaUUn0W0CuYsBWpn9ER1aoVmz0O-plx52q6R1YBXDXc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmj9tZxTeGNU_-9BTnUOuQR1IpqpHNldKYtoeKYKlHyg&oe=6AFB4039"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
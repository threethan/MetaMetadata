61_949618227216539_8210851363421039503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N58jAiQdwJgQ7kNvwFmuZS7&_nc_oc=Adq53HVuS7QKmwotOTVBB3t1PJrVOr0E6KXyEskcM6kMntMfSl5raeuudTZP9DCDsX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3VLQEXTcO9ezyH_bAhAg-VKbT65reE_xlNeyZcNicItA&oe=69F0C3E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgVj0wx1dT4Q7kNvwHIjNp2&_nc_oc=AdpbN5HGTBHnAWbUw5YVaIzrfhnU6mv2KVxTfAsrleJv_k5SYvlOk3KVRJkkLRweeAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af38b9PzxItIh_hlLBcsLAieASYL9yqV-LFM25UGhF28ZQ&oe=69F0B8F9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cambivr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cambi Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/cambivr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
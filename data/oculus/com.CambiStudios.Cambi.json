=7f20f&oh=00_AQRZPVqUfKr1hh1yOKJHJKwXGEoHD4vJElIHEZ7DyxxFOQ&oe=6AFF2681"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cSMATw5KrQQ7kNvwHIPt7G&_nc_oc=Adqvj5n5iMnsR9nHPu-4OfvrLjeTaCspoKymuf7qdvclpD1vhhcL7LdOoT-GAYsqtcw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz3HDCQrjT0t7IqhITk5gsUfgTQ2ysFv78AGV-r4y2uQ&oe=6AFF0768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQmnS4EDsP4Q7kNvwHBl2jz&_nc_oc=AdoXFFNZ2n--KvfGTN8Eee6mXI8m0k4Je_tzI-h4Nsl1aoR-XJgZERg3-GBe__IVDjQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfAvr-6yRagy02CdGUaLbPjo8aQki-h7Ji149UhPeC5Q&oe=6AFF34B9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
=7f20f&oh=00_AQS_kzot5fXuVPs2lLBoMWq0eZLo4ck51E1WMbJm9OGmIQ&oe=6B09B281"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVOrwX_QipgQ7kNvwEObSvq&_nc_oc=Adr_6zKPtZd_PuFkUMRncrzNGAtw-qUzwUdrLs_TXtjnyxFpo5zLk9SZC5cB74VC0X0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0IT_UClEdiVYHocSWP5c4wzpZ6Sy9vi9pBixFtiSt2w&oe=6B09CBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV25I6_c9ekQ7kNvwGbONhz&_nc_oc=AdocKaBwyBgnbJMQyYA_z71EAtLv4A1mGUjpyt4x74dktMzHfYZfYadFzOi__gnNJvw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD7_jsL-e5v3Zjj9oz9Tpg_QShlI8f5aih9LPN_mwQAw&oe=6B09C0B9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
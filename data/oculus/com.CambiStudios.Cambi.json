61_949618227216539_8210851363421039503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE494-g_kPEQ7kNvwF9jfsg&_nc_oc=AdlRJbYT61bL4E7PNlE2GfKCjBSB8lovCuIMWU1_Vahi0LvPY8CkkC6oKXmK8at75Ys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNwTR2vGBUQ0lRxC6PE9Br_WTsMxepuZfF6EFCa1reYw&oe=69A44CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyru0TvTwgYQ7kNvwG6_Lvg&_nc_oc=Adk14clfawTLbtHeCMdSUjxYs-EJEJPRICthZk--W-71ueJ4IV52pRj8m8y93CarDBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6NmxObM3o4PMbb3fsA5zimQaaaHOgXFkLU40djE4NeA&oe=69A441F9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_url": "https://sites.google.com/view/cambivr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cambi Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/cambivr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
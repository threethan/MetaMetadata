=7f30f&oh=00_AQW6bofzTC4U2p0s3jOXvGBra_J9PbScK9WqB9uc6ofZPQ&oe=6B0EF881"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw4xmm3nxAkQ7kNvwGow__L&_nc_oc=Ado0rydS5-b9H4E2gQt4cPniYO5myUAIqjY0XRy18tNstVa1vA_ey1_Hv2PCUQk5eMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWL_d8sQQ4eGdhu5WkAjx6Xyc5W8eLmAL1vFadLpPcoKw&oe=6B0F11A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZw9xqXqtkIQ7kNvwEDUqRU&_nc_oc=Adp083g7FA5EXkbg2r4uS7OhX4EVCYajbJ1Cr802wGbvCtJhHs7b3-pr6RolXN-_Lv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuojgHV3jgLHTyfTIh6KwBGs7w1uhXSqvmgtJUG4cG7A&oe=6B0F06B9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
=7f20f&oh=00_AQQa0s9mZraJZYLyDkoLX7R0sSoJBPi0CIoIchZ2rjegfA&oe=6B070F81"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buVywt1QtOIQ7kNvwH7-uAJ&_nc_oc=AdpkT_bLGFIe-jrCP3WbKAyE5yw2LBSjURw4U4OVtnHT8V5htaBAzKd9kzX53a2ywf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG4sFYDlANvOeokNN4QBuggnjuKgKiPQW2lq-7NSyNaA&oe=6B06F068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLQFWej3-HMQ7kNvwHTtWoo&_nc_oc=AdrxQ7LMue67A_eBlAUsSNNIVrGT8XGhuahHGpL0HHRN0UfcwuaTYJ_CE9XNZgvlMMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr1HFUBJjiqsq1Xxm7FMA1cM8AcxHUvh_h8Vmv1VnUGw&oe=6B071DB9"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
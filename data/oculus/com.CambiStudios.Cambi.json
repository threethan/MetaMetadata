=7f20f&oh=00_AQQck9acEDNLUPODsnRYr5Rf2XJdnhxxfAvAZKbVXelOUA&oe=6B007801"}, {"file_name": "Screenshot 2024-12-14 163004 (1).png", "id": "949618223883206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282161_949618227216539_8210851363421039503_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfYm2mOpt3MQ7kNvwH9fi1t&_nc_oc=AdoAh0GSEvM5ZFi__FxSEwxVDESxuHMBVL0mk9URYn-rR7eS76ut1_ZFQU_ytj0n1iE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9t74X0pOLuBKCxRG7kTGWMaMLz1gUQIYz7l7ey1amNQ&oe=6B0058E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-12-14 150642 (1) (1).png", "id": "887619309844877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/428899349_887619313178210_2300342807475802654_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQmnS4EDsP4Q7kNvwHgkZqN&_nc_oc=AdqGo5M4AU0h6d8VblRKPTMVyI3AB3wmyNa1CZxHLK2VAH8kIe3jHDzyHS-VFOrOjwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKLyXWxJAhkY2yMSTlHuTUUj2iemc96yJHgp5M8940rw&oe=6B008639"}, "display_name": "Cambi", "keywords": [], "long_description": "Cambi is a cartoony horror VR game set in a creepy, colorful world. Explore eerie environments, solve puzzles, and avoid terrifying creatures that stalk you. With its fast-paced gameplay and spooky atmosphere, Cambi combines the fun of GorillaTag movement-based VR with thrilling moments of horror. Can you survive the horrors lurking around every corner?\n\n\n\n", "short_description": "Cambi is a thrilling, cartoony horror VR game that puts a spooky twist on the classic Gorilla Tag movment. Run, jump, and run with your friends in a hauntingly fun environment filled with eerie surprises. Navigate through creepy, cartoonish landscapes as you avoid terrifying creatures, Are you fast enough to escape the horrors lurking around every corner? Play Cambi and find out!"}]}, "developer_name": "Cambi Studios", "developer_privacy_policy_
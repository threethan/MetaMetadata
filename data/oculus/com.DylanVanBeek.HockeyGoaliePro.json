2G69TzNR40kxZCYTcUJ6MV68H1po1mkMwcSzO_p6HcQ&oe=6A985FAE"}, {"file_name": "HockeyIce.png", "id": "1759883564638028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618948_1759883571304694_8161486630264059356_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=palA0I3qxV0Q7kNvwFuNgw9&_nc_oc=Adoly0hBU0B4smO7qARanhdKckJafQ_q4ZWdX-gStVn5RVzdxynhP61hIyt5hWwiBaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9agFz82bBXka6pddsJ0w4xwEiJZq36Q2cZmEaKIBemg&oe=6A98510A"}, {"file_name": "HockeyMultiPeopleMixedReality.png", "id": "1098558668796105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619131_1098558675462771_3562837339126268177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRADH4fSicMQ7kNvwEonXns&_nc_oc=Adp8AzzcTICV49MstZqnnuiBuTpn-mur8Vek6Tist-k7jMSSsM8I6E6tu-L_qDQAG6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKntDCrTQzn-StFpfVZFUEaqlBDHhJ7cm_r3XttWY8hZQ&oe=6A985847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Cover Image.png", "id": "9943522329059063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_9943522335725729_1856700708677810822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrAbL2_AuzAQ7kNvwER2FVS&_nc_oc=AdqgFV1UpPNSJXWrnmDqBVym84SZRGBCiizHAJBSLpcf9xteo3Fvis6eQUA0nOtk_bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaaOIQzrS_dtFMPY6Lxdm3oCekdhowDvMESjOKJYVWdg&oe=6A986427"}, "display_name": "Hockey Goalie Pro", "keywords": ["Hockey", "Sports", "Goalie", "Sim", "ice"], "long_description": "**\ud83c\udfd1Become a pro goalkeeper using the best VR Mixed Reality Hockey game on Meta Quest!\ud83c\udfd1** Improve your fitness, reaction time and health as you climb up the ranks and become a Hockey Goalie Pro!\n\n\n**\ud83d\udc51 Rise through the Ranks**\n\nWatch as your space is transformed into various Hockey Stadiums with Mixed Reality environments. Complete Challenges as you guard the goal and improve your rank!\n\n{1606629710024374}\n\n**\ud83e\udd4a Fitness**\n\nImprove your reaction time and your health as a Hockey Goalie in VR with Hand tracking and predictive reaction technology for close-to-real life experience!\n\n{2136692136754244}\n\n**\ud83c\udfd2 Upgrade your Gear**\n\nSpend some time browsing the shop to customise and upgrade your gear and access new areas.\n\n\n{1231816687869118}", "short_description": "Bring the stadium to you and transform your backyard, room or field into a roaring arena as you partake in the most realistic Mixed Reality Hockey Goalie experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1kyYf4FSDKiWmfvurtg_5Djh0k6ZO8JyhohL3DE6dyt0/", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://www.youtube.com/@DylanVanBeek", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24056358263989539"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1597387188729812"}, {"status": "PUBLISHED", "id": "1172895954977874"}, {"status": "PUBLISHED", "id": "1343737237645006"}]}, "baseline_offer": {"id": "1343737237645006"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1597387188729812"}]}, "liveChannel": {
QN2ivAWxAZBfBW4l17vrz1U6pgALp_6z36YRGFMC8euEA&oe=6AD3980A"}, {"file_name": "HockeyStadiumScreenshot.png", "id": "1853504105518903", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618279_1853504108852236_424636594449690890_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OCuHiq1f_0Q7kNvwHimpTo&_nc_oc=Adph68yWnrNVw7UirMhA5JkYPBTmbye7Fc3pkYtzb83-iZE9EYyqIE9LpKnN3yUVfho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF7R6v7YOGK9KBZcSpp_Na3uutiS38WYuXXt4Y1QqTGA&oe=6AD3A0A6"}, {"file_name": "Shop.png", "id": "2279307485948417", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619404_2279307489281750_3703655862660559528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDjfbJshZY0Q7kNvwHX9JNM&_nc_oc=AdpAEhILmwJYZ49byrD14hIvrvHLsj7_HEj96xaAFtG9CNNYpryGKq9LHGXP5_5VWnY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpSaWuBHeFz3GOW13d9nA7b1c4kh6ALDxUSsyPICVXxw&oe=6AD3B42F"}, {"file_name": "HockeyMultiPeopleMixedReality.png", "id": "1098558668796105", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619131_1098558675462771_3562837339126268177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLoUHy09mewQ7kNvwFXZVwJ&_nc_oc=AdqTq-7w8gsGNnCQzWo5F4VNau1PVmM0SeOML2esc1QURYk4WL6ISvqNUeYL0PgACSQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ1t0-owHKPYhWUSYRHUwYQuj6vFC32vXKK65h4LBIVQ&oe=6AD3ABC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Cover Image.png", "id": "9943522329059063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622325_9943522335725729_1856700708677810822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEMO8AE5NcUQ7kNvwGkJ9iq&_nc_oc=AdrOi1mZFJ5IRlaX9NJsKS544j6NI2DLTBE9_x838_E2yO0Zl1TCYHj4DVQ8nZ2lTX4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMN7qw3-OnZ2fLoDJH2vnHf_DDUtzlPJxWsFI_LRAJHQ&oe=6AD3B7A7"}, "display_name": "Hockey Goalie Pro", "keywords": ["Hockey", "Sports", "Goalie", "Sim", "ice"], "long_description": "**\ud83c\udfd1Become a pro goalkeeper using the best VR Mixed Reality Hockey game on Meta Quest!\ud83c\udfd1** Improve your fitness, reaction time and health as you climb up the ranks and become a Hockey Goalie Pro! Supporting both controller and hand tracking for optimised training!\n\n\n**\ud83d\udc51 Rise through the Ranks**\n\nWatch as your space is transformed into various Hockey Stadiums with Mixed Reality environments. Complete Challenges as you guard the goal and improve your rank!\n\n{1606629710024374}\n\n**\ud83e\udd4a Fitness**\n\nImprove your reaction time and your health as a Hockey Goalie in VR with BOTH Hand tracking or controller support and predictive reaction technology for close-to-real life experience!\n\n{2136692136754244}\n\n**\ud83c\udfd2 Upgrade your Gear**\n\nSpend some time browsing the shop to customise and upgrade your gear and access new areas.\n\n\n{1231816687869118}", "short_description": "Bring the stadium to you and transform your backyard, room or field into a roaring arena as you partake in the most realistic Mixed Reality Hockey Goalie experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1kyYf4FSDKiWmfvurtg_5Djh0k6ZO8JyhohL3DE6dyt0/", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://www.youtube.com/@DylanVanBeek", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUC
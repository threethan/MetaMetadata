_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6mtOPyaURAQ7kNvwFelo_4&_nc_oc=AdneeFB-x5Wgp9K-tn98pZNOj_VglE5URt7tfEIydVdieIRu0ezBx_Vnl8GkdlLYs9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXonuC3TRh2SmRu98fhhkimyHAAFpngDV9AImtJE8yig&oe=69A6D79C"}, {"file_name": "vvr2_topiary.png", "id": "309300464465148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_309300467798481_7124195197241332063_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERa5Jvg9BHQQ7kNvwF9l2RJ&_nc_oc=AdlsJ6NeNfnGxdCnFhHuJvhFZQKfkrSYoWwrZdDQIZcxk1nIvGM19uhJZCFXEQCMcss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWWlKL4VaXgjevS1bpUWoKRCyCgq4JF9hlJykSAKgSZQ&oe=69A6CAB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VVR2_Landscape_pink.png", "id": "1300347197124357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_1300347200457690_6713516443300692446_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB2eQSqiV64Q7kNvwHOnAfj&_nc_oc=Adnov-GBWoCcgA01cUKZsv0B0SWbcf1gIVY2Cy5SH5OcqfVURw3xirgdk5RB2Egpip4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshAdHrstsjzgGFuHve51TC2grcslcGOngcGVl2Do3DhA&oe=69A6E1A5"}, "display_name": "Virtual Virtual Reality 2", "keywords": [], "long_description": "When a metaverse shuts down, what happens to the avatars left behind?\n\nIn this darkly funny action/adventure game, pilot your mech body through the chaos of a dying metaverse, rescuing abandoned avatars along the way. Each new avatar-roommate brings unique tools to aid your escape back to meatspace!\n\nDo you have what it takes to overcome the digital destruction and interpersonal drama before you\u2019re logged off for good?\n\n\u2022 Run, jump and boost your Chaz mech across treacherous server-scapes.\n\u2022 Fly VR headset spaceships to capture other avatars.\n\u2022 Use your trusty dog-puppet to charm the data deleters into doing your bidding.\n\u2022 Vacuum up debris from the metaverse to use as fuel and ammo.\n\u2022 Slow time with CPGoo to dodge laser attacks.\n\u2022 Hookshot and pull yourself up through the clouds toward corporate HQ.\n\u2022 Take a rhythmic break in Scottsdale\u2019s ASMR Spa.\n\u2022 Achieve self-actualization as an artichoke whispers at you.", "short_description": "When a metaverse shuts down, what happens to the avatars left behind?\n\nIn this darkly funny action/adventure game, pilot your mech body through the chaos of a dying metaverse, rescuing abandoned avatars along the way. Each new avatar-roommate brings unique tools to aid your escape back to meatspace!\n\nDo you have what it takes to overcome the digital destruction and interpersonal drama before you\u2019re logged off for good?"}]}, "developer_name": "Tender Claws", "developer_privacy_policy_url": "https://tenderclaws.info/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tender Claws", "support_website_url": null, "website_url": "https://tenderclaws.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1311706512639514"}}]}, "scheduled_offers": {"count": 28, "nodes": [{"status": "PUBLISHED", "id": "914157148040487"}, {"status": "PUBLISHED", "id": "2081005862656231"}, {"status": "PUBLISHED", "id": "1598609098166096"}, {"status": "PUBLISHED", "id": "1117856723435226"}, {"status": "PUBLISHED", "id": "1413693659719453"}, {"status": 
cdn.com/v/t64.5771-25/491820441_1472679677627660_2297506365742905072_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtQaCS0dIOYQ7kNvwHIaqUd&_nc_oc=AdrWCCcP8BUB0asDf2QEHlP5JYKsYG5AEWrMJkstjMyiAVYJs3fimwxfzhLtiOSUtkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq9OvptCC9oMyhYQzQkUyrL7Wdvp9d39yqTCOdCWBS7w&oe=6AA02149"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skytail", "keywords": [], "long_description": "Skytail is a heartwarming action-adventure that sweeps you into the open skies of a vibrant fantasy world. Soar on the back of your dragon-like companion, wielding powerful telekinetic abilities on a timeless journey to restore what was lost.\n\nBetween the thrilling airborne battles, explore an archipelago of serene floating islands where you can master new abilities, overcome trials, and tend to your Skytail companion.\n\nFeatures:\nIntuitive telekinetic combat: grab, crush, rip, launch and collide airborne foes.\n Seamless dragon-back flight through a magical realm.\n A tale of companionship in the clouds, forged through flight, care and courage.", "short_description": "Skytail is a heartwarming action-adventure that sweeps you into the open skies of a vibrant fantasy world. Soar on the back of your dragon-like companion, wielding powerful telekinetic abilities on a timeless journey to restore what was lost.\n\nBetween the thrilling airborne battles, explore an archipelago of serene floating islands where you can master new abilities, overcome trials, and tend to your Skytail companion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "https://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "26
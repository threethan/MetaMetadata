_nc_ohc=YD78lFFLd68Q7kNvwGbl25V&_nc_oc=AdoYBh1nGNnoFcCTNct5h0QLF-buy2AkEA_irvXUk_KvcdcBpQ2LtN03Abd3HeQ2l3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XHmvpAcW6OA_dC2Qi7HAl4Mg4b8JYlYDrrc_dY0FJ3Q&oe=69E39AC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skytail", "keywords": [], "long_description": "Skytail is a heartwarming action-adventure that sweeps you into the open skies of a vibrant fantasy world. Soar on the back of your dragon-like companion, wielding powerful telekinetic abilities on a timeless journey to restore what was lost.\n\nBetween the thrilling airborne battles, explore an archipelago of serene floating islands where you can master new abilities, overcome trials, and tend to your Skytail companion.\n\nFeatures:\nIntuitive telekinetic combat: grab, crush, rip, launch and collide airborne foes.\n Seamless dragon-back flight through a magical realm.\n A tale of companionship in the clouds, forged through flight, care and courage.", "short_description": "Skytail is a heartwarming action-adventure that sweeps you into the open skies of a vibrant fantasy world. Soar on the back of your dragon-like companion, wielding powerful telekinetic abilities on a timeless journey to restore what was lost.\n\nBetween the thrilling airborne battles, explore an archipelago of serene floating islands where you can master new abilities, overcome trials, and tend to your Skytail companion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "https://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": nu
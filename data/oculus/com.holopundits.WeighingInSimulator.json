l3-3.oculuscdn.com/v/t64.5771-25/38974819_1213116426504744_149786579003433466_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9yOG3ly1uMQ7kNvwE1ZcoQ&_nc_oc=AdoPVMr7KkR9ICySGdN2uq6Y4qreejiB0vBJx4VvflhHi5ZihGS-IReNLqVH6HLFXes&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0f_e-3Bd-oHIGZXE0yh5pLKPYKmI960VF55HREFUOV0w&oe=69F1F069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1454314151950044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75250457_1454314155283377_2855003024336709006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2FATtZi49EQ7kNvwG5LylR&_nc_oc=AdponWM203jVLoRQRdGtwx3y_-I9e3ZfWAHDK6D5E3u5MzndO4VjiD3vYJhhfcB2bX4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fmECOJw9Ds3pXHrNX5ME9Sy3iJuKwl9_eLy1QN_1NsA&oe=69F1F474"}, "display_name": "Weighing-In Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "This VR simulation teaches the essential skill of measuring and recording the weight of ambulatory clients. The tutorial includes preparation, proper technique for using a scale, and documentation. By the end of this tutorial, participants will be able to: \n- Remember the steps and protocols for measuring and recording weight. \n- Understand the importance of accurate weight measurement for patient health and care planning. \n- Apply the correct techniques to measure and record weight safely and accurately. \n- Analyze any factors that may affect weight measurement and take appropriate actions. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n-Create accurate and reliable documentation for patient records. ", "short_description": "Learn to accurately measure and record the weight of ambulatory clients, ensuring proper documentation and care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms
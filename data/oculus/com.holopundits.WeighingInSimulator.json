n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbLkU-5zAsEQ7kNvwGHp5Xk&_nc_oc=AdmaBQAM5wpH3bIHM5aBSAZ1jA17n7NdQ862Bkj7DR4tmsppEN8ckAkvukGhLtVkDqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftv9GvjBeMG5WmTb8cwgdG6p482tHfBDUqSaVUrxHd3Vg&oe=69A427E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1454314151950044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75250457_1454314155283377_2855003024336709006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LokVgI0G0ukQ7kNvwEFv3NH&_nc_oc=AdlonQDz8Il8UTMTYJNVSRDZkPDIQioH6fJIqw9EXeQOPxNtNKvEqdBgxkC8Wt-k6Wc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv0klodl5dSWLoQyIMy7At04NRCAJ6T6-7VRsio5KsSoA&oe=69A42BF4"}, "display_name": "Weighing-In Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "This VR simulation teaches the essential skill of measuring and recording the weight of ambulatory clients. The tutorial includes preparation, proper technique for using a scale, and documentation. By the end of this tutorial, participants will be able to: \n- Remember the steps and protocols for measuring and recording weight. \n- Understand the importance of accurate weight measurement for patient health and care planning. \n- Apply the correct techniques to measure and record weight safely and accurately. \n- Analyze any factors that may affect weight measurement and take appropriate actions. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n-Create accurate and reliable documentation for patient records. ", "short_description": "Learn to accurately measure and record the weight of ambulatory clients, ensuring proper documentation and care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "h
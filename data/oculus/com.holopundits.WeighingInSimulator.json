n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4zdngz_SIcQ7kNvwEu-SrI&_nc_oc=AdkrnSQrbV7hrThkPyXa7kX37yuccx-7-IAEELIflNNAEW_f359kfkHXf14Jx-Uy1Lw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvVXfTsHT7PjOzXChyvh597GgZnp2BA1fTKbd4l90IUOA&oe=69A184E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1454314151950044", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75250457_1454314155283377_2855003024336709006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LokVgI0G0ukQ7kNvwGGo4LR&_nc_oc=Adka3Fz9-JS96rWh6aN7ujjl-u8NqRdWoGIRo-9G3U77a41zWBbrcJwLljX3V_cL3bg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv_Hs2Tjd9d0oQb_y5x1kpFAu-vePNFonoD3Xrjd0H8JQ&oe=69A188F4"}, "display_name": "Weighing-In Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "This VR simulation teaches the essential skill of measuring and recording the weight of ambulatory clients. The tutorial includes preparation, proper technique for using a scale, and documentation. By the end of this tutorial, participants will be able to: \n- Remember the steps and protocols for measuring and recording weight. \n- Understand the importance of accurate weight measurement for patient health and care planning. \n- Apply the correct techniques to measure and record weight safely and accurately. \n- Analyze any factors that may affect weight measurement and take appropriate actions. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n-Create accurate and reliable documentation for patient records. ", "short_description": "Learn to accurately measure and record the weight of ambulatory clients, ensuring proper documentation and care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "h
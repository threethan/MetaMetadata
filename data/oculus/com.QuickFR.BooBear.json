.png", "id": "1614767582452619", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036679_1614767585785952_3082846567463823927_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZCDC8plENYQ7kNvwHqFJpG&_nc_oc=AdlDOoiTdi4YEcPnmSMyabOwU34BSrL5j89a2zCZx7VfHkrWV_iEUGKqAHSOsJlN164&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsg1icgNjiFtH8gAJjbH5JPHoG914cAV8esseqUcs5SmA&oe=69A45059"}, {"file_name": "New Project (18).png", "id": "1479208339661070", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031509_1479208342994403_2902750829609000604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnQY-a5s49wQ7kNvwFojFn_&_nc_oc=AdlZbQ-DVWbDd-Aw3mz2FWyZM1B-F-AtwGlgtHLY4DLGzNdUtYycDLKVleunXcxgL54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuZqLgdPi26bwjwjjcT-AcHLqn_wFlo0DCkmVNSLW6rTA&oe=69A4254D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 image for boo bear.png", "id": "1102056664247668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031619_1102056667581001_9068597179507398780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLXriKLNZ0IQ7kNvwE2HntQ&_nc_oc=Adl6N2ycdIkFPzT9-dCu0GnwB5WP_rrMrSzjrE-voF35X6Ay_U3_7T0s8-ZbOesTO3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv1jdEd9V12aYyFwmKY_qxzydIKnQWHMIfwI9D-HF_CuQ&oe=69A4417A"}, "display_name": "Boo Bear VR", "keywords": ["Horror"], "long_description": "Boo Bear is a super scary and exciting horror game where you explore all kinds of different places. Each place is a level, and every level has its own tricky puzzle that you need to solve to move on. But be careful\u2014there are creepy monsters hiding everywhere, waiting to jump out and scare you. The game makes you think hard to figure out the puzzles while also keeping an eye out for the monsters. It\u2019s full of surprises, spooky challenges, and lots of fun. If you like games that keep you on the edge of your seat, Boo Bear is the perfect game to try!", "short_description": "Boo Bear is a super creepy horror game where you go through different places, and each place is a level. Every level has its own puzzle to solve, but watch out! There are all kinds of scary monsters hiding and creeping around. You have to be smart and figure out how to beat the puzzles while staying away from the monsters. It\u2019s spooky and really fun!"}]}, "developer_name": "QuickFR", "developer_privacy_policy_url": "https://sites.google.com/view/quickdevelopment/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QuickFR", "support_website_url": null, "website_url": "https://sites.google.com/view/quickdevelopment/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8656568254396660"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9504204392966371", "version": "1.4.5"}, "id": "1088104349443911", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8592223547497798", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9504204392966371"}, "release_status": "RELEASE
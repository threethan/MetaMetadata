f&oh=00_AQGk3S7lC7NswOyPp12iYSCmadmLnb0KjRZ1w9cNh1zCmw&oe=6A8D8233"}, {"file_name": "New Project (17).png", "id": "1766213467486532", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974882_1766213470819865_2578591497782929666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIXmWuf3Rv4Q7kNvwHAr-yJ&_nc_oc=AdoavCQN81CVsTmrCchGRnbI4sqOCKfl3a40VVM8u_E4fnjxDkHKdW9gYIriq8b1vek&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHqWReykhWPwFCPZ7CvicEYumIhs8RFPqhhTZcg4bM_A&oe=6A8D93DF"}, {"file_name": "New Project (20).png", "id": "588818196932893", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75485573_588818200266226_3310359005935946506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wik6BwqQ2wQ7kNvwGbb7KE&_nc_oc=Adrk482iLiBkBIwYTpdUzb8MrZxVCorq-k2L_rslgpBNDOqdEyjdGJeOdrVVc-6XutA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXHROJXp2nigWfCwCxZEUCye7l29i2QX5yY1iwht7ow&oe=6A8D8B0D"}, {"file_name": "New Project (19).png", "id": "1614767582452619", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036679_1614767585785952_3082846567463823927_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHzYkyXMDukQ7kNvwE09Qdp&_nc_oc=Adqz9526i1BM_nosRomqoNYP7Or02bkwoINUgloCUBYYO4Hv85N6tz2YSeQ72pCrlQA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTWoxlL_DMvpNpVZRGfliYgboHsyiHUofnVcKbSUfyog&oe=6A8D7199"}, {"file_name": "New Project (18).png", "id": "1479208339661070", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031509_1479208342994403_2902750829609000604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRrtC8Box74Q7kNvwHqnRx3&_nc_oc=AdqhtKonAFrWububG9rhSBdsMhKsijVCC8CSBT3u79FpMFD4xMu1RcudKEaHTuHJMJs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr0pM694zovHDRqTifdxMYiBEFJQ-lqppNpKWFvOO47A&oe=6A8D7ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 image for boo bear.png", "id": "1102056664247668", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031619_1102056667581001_9068597179507398780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6QW_zKKmzQQ7kNvwHV24ib&_nc_oc=Adq7mhsV6lz62YgzxpU841lrm9Nwc1_zceInTmLpRLAm7d6biX3Ce0c6IUqW7EJnu9I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMjdHyWeJA-n-lq09PDt51oboPQc4pRJD0REsSggxG4g&oe=6A8D9AFA"}, "display_name": "Boo Bear VR", "keywords": ["Horror"], "long_description": "Boo Bear is a super scary and exciting horror game where you explore all kinds of different places. Each place is a level, and every level has its own tricky puzzle that you need to solve to move on. But be careful\u2014there are creepy monsters hiding everywhere, waiting to jump out and scare you. The game makes you think hard to figure out the puzzles while also keeping an eye out for the monsters. It\u2019s full of surprises, spooky challenges, and lots of fun. If you like games that keep you on the edge of your seat, Boo Bear is the perfect game to try!", "short_description": "Boo Bear is a super creepy horror game where you go through different places, and each place is a level. Every level has its own puzzle to solve, but watch out! There are all kinds of scary monsters hiding and creeping around. You have to be smart and figure out how to beat the puzzles while staying away from the monsters. It\u2019s spooky and really fun!"}]}, "developer_name": "QuickFR", "developer_privacy_policy_url": "https://sites.google.com/view/quickdevelopment/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QuickFR", "support_website_url": null, "website_url": "https://sites.google.com/view/quickdevelopment/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
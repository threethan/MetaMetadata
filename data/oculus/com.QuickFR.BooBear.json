t=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD62z3wkBfEQ7kNvwFKijZn&_nc_oc=Adoxfnuxc6-Hkv-R1SJGfC25rzR7T7mh1CktsnCEsgaxqSUGF3VkgJgvmrTjRWNBzHA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ucGly-82_vn55gLrfEYm7SYpow2MKbqutOLsz8CHBjA&oe=69F209FA"}, "display_name": "Boo Bear VR", "keywords": ["Horror"], "long_description": "Boo Bear is a super scary and exciting horror game where you explore all kinds of different places. Each place is a level, and every level has its own tricky puzzle that you need to solve to move on. But be careful\u2014there are creepy monsters hiding everywhere, waiting to jump out and scare you. The game makes you think hard to figure out the puzzles while also keeping an eye out for the monsters. It\u2019s full of surprises, spooky challenges, and lots of fun. If you like games that keep you on the edge of your seat, Boo Bear is the perfect game to try!", "short_description": "Boo Bear is a super creepy horror game where you go through different places, and each place is a level. Every level has its own puzzle to solve, but watch out! There are all kinds of scary monsters hiding and creeping around. You have to be smart and figure out how to beat the puzzles while staying away from the monsters. It\u2019s spooky and really fun!"}]}, "developer_name": "QuickFR", "developer_privacy_policy_url": "https://sites.google.com/view/quickdevelopment/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QuickFR", "support_website_url": null, "website_url": "https://sites.google.com/view/quickdevelopment/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
tWyDDf_yJkIERNqgDjg7Kg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlx4rj0Eynk3Hj9CsoAWP3BQ6wmQhP-rB8_-Uypg9LYA&oe=6B05AF8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 image for boo bear.png", "id": "1102056664247668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031619_1102056667581001_9068597179507398780_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhlr0AfqfyIQ7kNvwE13yvU&_nc_oc=Adp_dATyXli_FBsWjT6Vm5yxrWn5YT1wSyFPjq-pDN_OieuzZANkKR8BdP0ZiKMzNFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNUD-p8EU5Az5CIBIWsSu6CSdGHZ5h1d-W6U2GpjdfXw&oe=6B05CBBA"}, "display_name": "Boo Bear VR", "keywords": ["Horror"], "long_description": "Boo Bear is a super scary and exciting horror game where you explore all kinds of different places. Each place is a level, and every level has its own tricky puzzle that you need to solve to move on. But be careful\u2014there are creepy monsters hiding everywhere, waiting to jump out and scare you. The game makes you think hard to figure out the puzzles while also keeping an eye out for the monsters. It\u2019s full of surprises, spooky challenges, and lots of fun. If you like games that keep you on the edge of your seat, Boo Bear is the perfect game to try!", "short_description": "Boo Bear is a super creepy horror game where you go through different places, and each place is a level. Every level has its own puzzle to solve, but watch out! There are all kinds of scary monsters hiding and creeping around. You have to be smart and figure out how to beat the puzzles while staying away from the monsters. It\u2019s spooky and really fun!"}]}, "developer_name": "QuickFR", "developer_privacy_policy_url": "https://sites.google.com/view/quickdevelopment/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QuickFR", "support_website_url": null, "website_url": "https://sites.google.com/view/quickdevelopment/home", 
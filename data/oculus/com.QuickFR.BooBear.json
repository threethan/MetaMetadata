jWgdnedjta1TmWwLemsem4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpnqwc7L3kXi3nmoVP9CuU7I8DJxFg1w-eA04zGsYsBg&oe=6B09A40D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 image for boo bear.png", "id": "1102056664247668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031619_1102056667581001_9068597179507398780_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsu88fC3T34Q7kNvwGO8g1r&_nc_oc=Adp36TUFfidsXq7uLq3MnMkivYZu33ItJPnSTQ-rOp2qllEItiFrq62hOD001UIvX8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE2hun4TLhO7LhTDmo2ZCrhe5nP4XCU5lBT4-XqciFwQ&oe=6B09C03A"}, "display_name": "Boo Bear VR", "keywords": ["Horror"], "long_description": "Boo Bear is a super scary and exciting horror game where you explore all kinds of different places. Each place is a level, and every level has its own tricky puzzle that you need to solve to move on. But be careful\u2014there are creepy monsters hiding everywhere, waiting to jump out and scare you. The game makes you think hard to figure out the puzzles while also keeping an eye out for the monsters. It\u2019s full of surprises, spooky challenges, and lots of fun. If you like games that keep you on the edge of your seat, Boo Bear is the perfect game to try!", "short_description": "Boo Bear is a super creepy horror game where you go through different places, and each place is a level. Every level has its own puzzle to solve, but watch out! There are all kinds of scary monsters hiding and creeping around. You have to be smart and figure out how to beat the puzzles while staying away from the monsters. It\u2019s spooky and really fun!"}]}, "developer_name": "QuickFR", "developer_privacy_policy_url": "https://sites.google.com/view/quickdevelopment/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QuickFR", "support_website_url": null, "website_url": "https://sites.google.com/view/quickdevelopment/home", 
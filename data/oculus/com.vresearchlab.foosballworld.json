.com&_nc_ss=7f20f&oh=00_AQSlh_IFL7dkiP2uo36wLF0TuygeJRPjuRqtyYxQiB_ZFA&oe=6B085B4F"}, {"file_name": "Foosball-Trailer-1-April-2023_Moment-3.png", "id": "588075349945445", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974890_588075353278778_5594232029709874296_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DomZb_iQ4Q7kNvwEdhX9h&_nc_oc=AdoZMf8PTriuInyxVJq7LnGzQwhIB-he7IvuKztHKA4QnVwHoz-1oM-PVfFesOnXe24&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9Je0AixOLauxCKY4T3g_k807c3DGnn_dSN6BjdVflAw&oe=6B083FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Foosball-Trailer-1-April-2023_Moment2.png", "id": "4369869513153746", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982663_4369869516487079_8187932738661300002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qGGyXpqn7sQ7kNvwFwifq9&_nc_oc=AdoXPeeBMvypduAx02yLV-nB4DsaV77VHdx5zvbqrWZgalu5jYfz7uBMHuPlG7vqa68&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSTyXqZCAyBHA403FaCIT4XjxHxyol_GhjBFIPq23xKA&oe=6B086BE2"}, "display_name": "Foosball World", "keywords": [], "long_description": "Are you ready to take your love for foosball to the next level? Introducing the ultimate foosball experience in virtual reality!\n\nStep into a fully immersive world where you can play foosball like never before. With realistic physics, you'll feel like you're actually standing at a foosball table, ready to take on the computer-controlled opponents.\n\nExperience the thrill of the game as you control your virtual players with precision and finesse, using intuitive hand movements to pass, shoot, and score. With a variety of single-player game modes to choose from, including classic one-on-one matches and intense timed matches, you'll never run out of fun and excitement.\n\nChallenge yourself to beat increasingly difficult AI opponents or perfect your skills with training drills designed to help you master every aspect of the game. Whether you're a seasoned foosball player or just looking for a new way to have fun, this virtual reality foosball game is sure to become your go-to source of entertainment. So what are you waiting for? Step up to the table and let the games begin!", "short_description": "This classic tabletop game has been brought to life in virtual reality. Compete against the computer in a fast-paced match, where you'll need to use your hand-eye coordination and strategic thinking to score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://www.vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1761655397565508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974890_732722215257138_9078428516719306175_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEGVT_MLB20Q7kNvwHnFdlz&_nc_oc=AdrRBssDKU29Fu7g41RPZqb7XX4RlzvqjoOSIzZqX_9nen5SmRF5rSqA4x_J4qTwo8g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHq3OXjkR9LrKnTT-VjKQcja7b3Q-8nH9GdAVM0kcCRA&oe=6B085DC7"}, "is_concept": false, "is_test": fals
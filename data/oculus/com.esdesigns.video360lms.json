jj98Q7kNvwHQGhgg&_nc_oc=Adohg1C_0CobRb1LDFFwvihE3DvXKwELSjLIWlFONkXbGxwmz6tftXONsInIVLn4YNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiv9WYUXFTUqI9m4vKylrK_I8Z_JYdFoAymtQs9XaPJQ&oe=6A81A149"}, {"file_name": "screenshot-3-163227.png", "id": "1669157827508677", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312470_1669157830842010_1418518268136301550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEZLKA99LkkQ7kNvwFPyQzi&_nc_oc=AdoREDE5uoa_XwAwrQy_1T7eh2i-QDmk0kNMdx8qrhxqqwELAdBl1x4AqjH8saNZ8CQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElWwDXmIWAexoYzkQqY0OGexUb_9RKeZz-GOdfTwtCnw&oe=6A81A432"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vantura", "keywords": ["Education", "Training", "360video", "Learning", "Nursing"], "long_description": "**See the real thing, from the inside.**\n\nVantura is how your class watches the 360 videos your own instructors made. Your program films its real spaces, its simulation lab, its clinic, its shop floor, its field site, and Vantura delivers them to the headset you are wearing right now.\n\n**Simple to start.**\nOpen the app and it shows a short pairing code. Enter that code at your class web portal from any phone or laptop, and the headset signs itself in. Your class library downloads over Wi-Fi and is ready whenever class is.\n\n**Built to play, not to buffer.**\nBecause your videos live on the headset, playback is smooth and seeking is instant. There is no waiting on the network in the middle of a lesson, and a weak classroom connection does not stop the class.\n\n**Made for real classrooms.**\nLook around a space in full 360. Move between lessons with a simple point-and-select menu that works with hand tracking alone, no controllers needed.\n\n**For instructors and programs.**\nFaculty upload through a straightforward web portal, organize videos by class, and share a join code with students. There is nothing to sideload and no device-management system to buy. Vantura runs on the consumer Quest headsets your school already owns.\n\nVantura is free to install. Instructors manage classes and content through a subscription on the Vantura web portal. Learn more at https://esdesigns.org/#/vantura.\n\n*Works on Meta Quest 3 and Quest 3S. Quest Pro supported.*", "short_description": "Vantura brings your school's own 360 videos to the headset. Pair the headset once with a short code and the lessons your instructor filmed download for smooth, offline playback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://esdesigns.org/#/privacy", "developer_terms_of_service_url": "https://vr.esdesigns.org/terms", "publisher_name": "ES Designs", "support_website_url": null, "website_url": "https://esdesigns.org/#/vantura", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1276472292209117"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308050_1786836162629719_6321385645013429842_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZszE5mzHS4Q7kNvwEj6pOY&_nc_oc=AdoEO7AbMIZ4tSAst6HleGBY8fzqWVcUXSzTJSt6lqZ3tEu5g3cQqsma8k5Tfz87IxQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwARAPv7QWk8MvP7GCARmdGPkVtu8KJoL-3l8seLBm-A&oe=6A81BA00"}, "is_concept": false, "is_test": fals
/t64.5771-25/38974792_694854412583862_5239133744116613156_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbdyjUtot_kQ7kNvwEfAr9W&_nc_oc=AdoLMnBpov_6P42n0d1HzOA2QaOaLNyJm5zwju0jobDc7VYtrKppPO6VVdj2ZV3T-3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCnPAwv5XSrjHsvvCj3aGv-iC7FFJO9pr4ni-DZWwrZw&oe=6AFF27AC"}, "display_name": "DinoPlanet", "keywords": [], "long_description": "Come with me on a Safari across 170 million years of Dinosaur History. On your tour of your personal Dinosaur zoo you will see more than a dozen dinosaurs and other extinct animals in their true jaw dropping scale. Talk to your guide to hear about each of these incredible animals. As you explore your zoo you will be able to unlock exhibits for your museum and collect eggs to found your very own dinosaur petting zoo.", "short_description": "Come with me on a Safari across 170 million years of Dinosaur History. On your tour of your personal Dinosaur zoo you will see more than a dozen dinosaurs and other extinct animals in their true jaw dropping scale. Talk to your guide to hear about each of these incredible animals. As you explore your zoo you will be able to unlock exhibits for your museum and collect eggs to found your very own dinosaur petting zoo."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.berell.net/terms-and-conditions/", "developer_terms_of_service_url": "http://www.berell.net/terms-and-conditions/", "publisher_name": "Berell LLC", "support_website_url": null, "website_url": "http://berell.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
zOs_Q&oe=6A86F6EC"}, "display_name": "DinoPlanet", "keywords": [], "long_description": "Come with me on a Safari across 170 million years of Dinosaur History. On your tour of your personal Dinosaur zoo you will see more than a dozen dinosaurs and other extinct animals in their true jaw dropping scale. Talk to your guide to hear about each of these incredible animals. As you explore your zoo you will be able to unlock exhibits for your museum and collect eggs to found your very own dinosaur petting zoo.", "short_description": "Come with me on a Safari across 170 million years of Dinosaur History. On your tour of your personal Dinosaur zoo you will see more than a dozen dinosaurs and other extinct animals in their true jaw dropping scale. Talk to your guide to hear about each of these incredible animals. As you explore your zoo you will be able to unlock exhibits for your museum and collect eggs to found your very own dinosaur petting zoo."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.berell.net/terms-and-conditions/", "developer_terms_of_service_url": "http://www.berell.net/terms-and-conditions/", "publisher_name": "Berell LLC", "support_website_url": null, "website_url": "http://berell.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7786540658135314"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3
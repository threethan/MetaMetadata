_ohc=c9hK1ymbBsIQ7kNvwHqezhd&_nc_oc=Adq0vj5lpZ9olMdOxEXwt2EyQLwssNtLoyP_r5ucTwqyZroEMlK2gDLX9rNpmWGB0Sw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyOS5-FFvQnYnZJsAGXIaV6Nq2P-Vw4sdQLV4edzzdzg&oe=6A9AF215"}, {"file_name": "PDP_screenshot 3.png", "id": "2890978447814413", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422370_2890978451147746_5354799878650684127_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DTIuLBQn1IQ7kNvwHXCont&_nc_oc=AdrOjmvu6NZeodMPfxoUqwaAVX7zmGDmq4f2ZXl6DQaCVDowPBlyHjS0V1KKSxIzoAc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFhRDMOO_0Nh0QBiygOZjH2PdIHmAIvnLcdP7Isae_QA&oe=6A9AF501"}, {"file_name": "PDP_screenshot 4.png", "id": "925061788301183", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392879_925061794967849_6153618265932835287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b7vBt5IrWQQ7kNvwGYzIpj&_nc_oc=Adrk2iugC6ez7AX950DJda3vl_JdE0wp110xoPYNVzFvCJ_X_lb5E9UPaX-66ZQeWqM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0AbEo9VHmYVAYexcv9VV80iKSQT94Ch0FoBsA1Z9XnQ&oe=6A9AF02D"}, {"file_name": "PDP_screenshot 5.png", "id": "242831764147620", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982658_242831767480953_7709159676039824957_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoVEQ_7nE70Q7kNvwHqKcvK&_nc_oc=Adoco4bv4bUOhYat4FLSDOW1c68D5Wb6bJDyOb4F4YozxBsuJSNLLGRMPmYaxaGgFPI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpBoI06Amz9n8UsqZuiU8ph7zHldYvBVVn0KeohwhL5Q&oe=6A9ADF6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phusicos VR", "keywords": [], "long_description": "PHUSICOS-VR takes you to sites around Europe where various nature-based solutions can be used to mitigate natural hazards, including floods, agricultural run-off, rock falls and avalanches. Nature-based solutions are sustainable, green solutions which increase safety while also promoting biodiversity and provide other co-benefits compared to more traditional civil engineering measures. This is becoming increasingly important in a climate adaptation perspective.\n\nThis game currently shows a diverse range of nature-based solutions in Norway, Italy, France and Spain, and is designed so that additional examples can be added in the future. Our ambition is to educate and inspire our users about nature-based solutions, and to empower politicians, planning authorities and other decision-makers to help make these sustainable solutions a preferred choice for managing natural hazards.", "short_description": "Learn how nature-based solutions are used to mitigate natural hazards at sites around Europe."}]}, "developer_name": "Phusicos", "developer_privacy_policy_url": "https://docs.google.com/document/d/1cDBNKAGQz1AfBMiCEC485hCdsDTJMr4tu4HAP7xKFfY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Phusicos", "support_website_url": null, "website_url": "http://phusicos.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "996439500958466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568684_149048917223826_7898211479413664086_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4vHaqSO7KQQ7kNvwF8SCyB&_nc_oc=Adr6qSIpwDUG2PmHAHKUZ
_ohc=YcGRH-j2a8QQ7kNvwE_SFFC&_nc_oc=Adp6js_fp8a7oM4oUrcL4gKz76Ijqx_ok9MYZGF2Ew0yrBYhmS7dT85-G8kOjWNSk6Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOotQIvBSifKg1VaOiBmxYcn7Zh96OC80OfVl5MqtEKRQ&oe=6AD3A295"}, {"file_name": "PDP_screenshot 3.png", "id": "2890978447814413", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422370_2890978451147746_5354799878650684127_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x88i7b3ncAQ7kNvwEfuJuU&_nc_oc=Adpp4F6uNz2edOVtBHI-HxuWA1TI_XRI0ErVnDM_onDctFNbXBIascJzy9X937JiV74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU1MJ8WUKTftRuokn6SJWqB2pbKKaLEWlj4KG3bCkOQg&oe=6AD3A581"}, {"file_name": "PDP_screenshot 4.png", "id": "925061788301183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75392879_925061794967849_6153618265932835287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d_DKa1cgNEQ7kNvwGA8b30&_nc_oc=AdqiPhtvYBxUOBmv19A6et-xKAOrlzSOw22pb3s80Z6uE4q8HxCszXjDUDQo5ITQOMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6FNAiUBsmFwsEjx2bGcRA9xLV7SVcvqgbcZ5A5zXljA&oe=6AD3A0AD"}, {"file_name": "PDP_screenshot 5.png", "id": "242831764147620", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982658_242831767480953_7709159676039824957_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pug1LB6geQQ7kNvwFSy14j&_nc_oc=AdpUKA2svbOPE-qBa7LNNtwPc2NBvZauyiQeG1cWgeJMvS2Rw0lfkV3DdYZetbCOzac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKIRxVPYjZZpWY3mqEwmzK26xjaU9sdnGoiY8iqE7lhQ&oe=6AD38FEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phusicos VR", "keywords": [], "long_description": "PHUSICOS-VR takes you to sites around Europe where various nature-based solutions can be used to mitigate natural hazards, including floods, agricultural run-off, rock falls and avalanches. Nature-based solutions are sustainable, green solutions which increase safety while also promoting biodiversity and provide other co-benefits compared to more traditional civil engineering measures. This is becoming increasingly important in a climate adaptation perspective.\n\nThis game currently shows a diverse range of nature-based solutions in Norway, Italy, France and Spain, and is designed so that additional examples can be added in the future. Our ambition is to educate and inspire our users about nature-based solutions, and to empower politicians, planning authorities and other decision-makers to help make these sustainable solutions a preferred choice for managing natural hazards.", "short_description": "Learn how nature-based solutions are used to mitigate natural hazards at sites around Europe."}]}, "developer_name": "Phusicos", "developer_privacy_policy_url": "https://docs.google.com/document/d/1cDBNKAGQz1AfBMiCEC485hCdsDTJMr4tu4HAP7xKFfY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Phusicos", "support_website_url": null, "website_url": "http://phusicos.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "996439500958466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568684_149048917223826_7898211479413664086_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w78e5de4AKIQ7kNvwFrSXoU&_nc_oc=AdpzA8xiKpLiNg5VmwfZ7
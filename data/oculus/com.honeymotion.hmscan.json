"}, {"file_name": "screenshot_4.png", "id": "1440604537541657", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593801605_1440604540874990_7971516803828253711_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHzoRbxxV1oQ7kNvwFrZv06&_nc_oc=Adp8ixxiHnuFw4O_ZEnwOK6b84urdSD2Ie9V8B3CI7Ou7HhTbLSBc8nzR95AljCbdws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqFvBlw2M-tzseKE--gjz0FrkwnLDSPQtQDh4-_OmYsw&oe=6B0B13FA"}, {"file_name": "screenshot_5.png", "id": "2381760762570575", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620655_2381760765903908_1821661328726615444_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUhruxWsDOMQ7kNvwFC2Wu_&_nc_oc=AdrH-TIVZZZxZv7KDww7Xc7bc_M0rC54ch859F2WeSbdPSENwP9g9bxXGxoPQPs-xv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkpbHT5_KiBPfRC6m-ZuA6frb6uNIVXNyYH5rG9u1PGA&oe=6B0B3887"}, {"file_name": "screenshot_2.png", "id": "1594277538682804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593895988_1594277542016137_231601455427143471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a7Q4tujQUMQ7kNvwGFYUZe&_nc_oc=AdqF6yEvkjdhA0DukyOT5iy4V4CMDMc-qQNJUiKH5zskO51QC16hCdRBYLpBl9hQemY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhuDAy9xvNgaIDxb9kwbWyoTgGLQwbahHWPD3r_XWkXg&oe=6B0B1294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HMScan", "keywords": [], "long_description": "HMScan turns the things around you into 3D assets for your games.\n\nPut on your headset, place a box around an object and walk around it. A dome of squares fills with your photos as you go, so you always know what is left. When you finish, HMScan builds your model on the headset.\n\n- Guided capture, made for first-time scanners\n- Stereo Fusion and AI Processing build your model\n- Gaussian splats for the most lifelike look\n- Clean-up tools: remove the base, fill holes, make it solid, smooth it, wrap the texture\n- Export GLB, OBJ, PLY and STEP, with sizes for Roblox and mobile games\n- Export Gaussian splats as PLY and SPLAT files\n\nEverything happens on your headset. Your scans stay yours.\n\nWorks best with small, matte objects and good light. Very shiny, dark or see-through objects are harder. You must be 18 or older to use this app. Only scan people who have agreed.", "short_description": "Scan real objects into game-ready 3D models, right on your Quest 3. No PC, no account, no cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hmscan.com/privacy/", "developer_terms_of_service_url": "https://hmscan.com/terms/", "publisher_name": "Honey Motion LLC", "support_website_url": "https://hmscan.com/support/", "website_url": "https://hmscan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1431272930065459"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159441897033964"}]}, "baseline_offer": {"id": "1159441897033964"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794260040, "status": "PUBLISHED", "id": "1159441897033964"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431359763390109", "version": "1.0"}, "id": "1125145070255489", "channel_name": "LIVE"}]}, "is_f
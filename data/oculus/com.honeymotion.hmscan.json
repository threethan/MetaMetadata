"}, {"file_name": "screenshot_4.png", "id": "1440604537541657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593801605_1440604540874990_7971516803828253711_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN5VJBOjNcsQ7kNvwEfM65I&_nc_oc=AdrkVmVy8bHYtta0c4uY3OHgVwxFDa63tl_oWn6lWHg50-NWnf3g0K9-MAvTfkkGwY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTmRRC_z7Lj-gr2SRw-KKjo7b5uLsuJokBberFM05bdA&oe=6B0F087A"}, {"file_name": "screenshot_5.png", "id": "2381760762570575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620655_2381760765903908_1821661328726615444_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1Tev6_5A_gQ7kNvwGx3Jds&_nc_oc=Adq8H6qX3OXB1FAwkpnwRm5QXnzkrEE_B0uMvwSFTR_kxjPVnleK64dWsD8JjIEBEY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWEi8ieX8wOgIRIlLz2AFVz5z2djFh1j7DZCemvbHKSUQ&oe=6B0EF4C7"}, {"file_name": "screenshot_2.png", "id": "1594277538682804", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593895988_1594277542016137_231601455427143471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Rp9BeI5sIQ7kNvwH7OdLP&_nc_oc=AdpL233oCI1NCqthMYE0gwh7rMKL9jEYp8mnm6ou0OvworZFkRQcpTHKitUoZD6vG6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqtxDajf6QHPhk3V1RXIzl6RfejgoacP_VXuLb3mkeVQ&oe=6B0F0714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HMScan", "keywords": [], "long_description": "HMScan turns the things around you into 3D assets for your games.\n\nPut on your headset, place a box around an object and walk around it. A dome of squares fills with your photos as you go, so you always know what is left. When you finish, HMScan builds your model on the headset.\n\n- Guided capture, made for first-time scanners\n- Stereo Fusion and AI Processing build your model\n- Gaussian splats for the most lifelike look\n- Clean-up tools: remove the base, fill holes, make it solid, smooth it, wrap the texture\n- Export GLB, OBJ, PLY and STEP, with sizes for Roblox and mobile games\n- Export Gaussian splats as PLY and SPLAT files\n\nEverything happens on your headset. Your scans stay yours.\n\nWorks best with small, matte objects and good light. Very shiny, dark or see-through objects are harder. You must be 18 or older to use this app. Only scan people who have agreed.", "short_description": "Scan real objects into game-ready 3D models, right on your Quest 3. No PC, no account, no cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hmscan.com/privacy/", "developer_terms_of_service_url": "https://hmscan.com/terms/", "publisher_name": "Honey Motion LLC", "support_website_url": "https://hmscan.com/support/", "website_url": "https://hmscan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1431272930065459"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159441897033964"}]}, "baseline_offer": {"id": "1159441897033964"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794260040, "status": "PUBLISHED", "id": "1159441897033964"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431359763390109", "version": "1.0"}, "id": "1125145070255489", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1431272926732126", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431359763390109"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1125145070255489"}]}, "change_log": "Version 2.0\n- Guided capture: walk one way round, with the box set in front of you and on-screen hints for every button.\n- New editing tools: Outline, brushes, Inflate, Pinch, Move, Clone, Smart wrap and 3D print export.\n- Versions and Archive: go back to any earlier version; archived scans can be restored.\n- Measurements in inches.\n- Faster, smoother processing.", "created_date": 1795619159, "id": "1469547142904704", "version": "2.0", "version_code": 600, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1431272926732126", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431359763390109"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1125145070255489"}]}, "change_log": null, "created_date": 1793920733, "id": "1431359763390109", "version": "1.0", "version_code": 150, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
93801605_1440604540874990_7971516803828253711_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1kITVhEHKsQ7kNvwEeLMsR&_nc_oc=AdomRZx88U2B4hRS2MO2wTs-vUZqBep8mEyWmS7Gw3yhH6OxFZuQgJfoZ6k29p-3_U0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0SkNg04F6TBTQHfc4AhxMhwFofEt0228A-RyDB4U0Kg&oe=6B01D97A"}, {"file_name": "screenshot_5.png", "id": "2381760762570575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620655_2381760765903908_1821661328726615444_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpliEd7gnL4Q7kNvwFhCriF&_nc_oc=AdpTyzb52DITqwrvqoegoNMdWIBlean4_UMRaCdQg_yVWZpMVSIpq_S8pYlNG1qlnhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPswrvKQQz-aj4Hzfa4FI5hPkzV0UCejlYlKPqHy3J6A&oe=6B01C5C7"}, {"file_name": "screenshot_2.png", "id": "1594277538682804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593895988_1594277542016137_231601455427143471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36qSzJeNxOQQ7kNvwHMn6Fr&_nc_oc=AdqtVS9TIkCfXHkZezHYTwxEcQn87kbwMn20rBaSG825uJmwPkmlLmK0bz0pm9X4gEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4rUFw0tMa7pzY-u6EgFGCheE47i5kB7eBWyTGV2w52Q&oe=6B01D814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HMScan", "keywords": [], "long_description": "HMScan turns the things around you into 3D assets for your games.\n\nPut on your headset, place a box around an object and walk around it. A dome of squares fills with your photos as you go, so you always know what is left. When you finish, HMScan builds your model on the headset.\n\n- Guided capture, made for first-time scanners\n- Stereo Fusion and AI Processing build your model\n- Gaussian splats for the most lifelike look\n- Clean-up tools: remove the base, fill holes, make it solid, smooth it, wrap the texture\n- Export GLB, OBJ, PLY and STEP, with sizes for Roblox and mobile games\n- Export Gaussian splats as PLY and SPLAT files\n\nEverything happens on your headset. Your scans stay yours.\n\nWorks best with small, matte objects and good light. Very shiny, dark or see-through objects are harder. You must be 18 or older to use this app. Only scan people who have agreed.", "short_description": "Scan real objects into game-ready 3D models, right on your Quest 3. No PC, no account, no cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hmscan.com/privacy/", "developer_terms_of_service_url": "https://hmscan.com/terms/", "publisher_name": "Honey Motion LLC", "support_website_url": "https://hmscan.com/support/", "website_url": "https://hmscan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1431272930065459"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159441897033964"}]}, "baseline_offer": {"id": "1159441897033964"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794260040, "status": "PUBLISHED", "id": "1159441897033964"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431359763390109", "version": "1.0"}, "id": "1125145070255489", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
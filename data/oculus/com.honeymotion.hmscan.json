&_nc_ss=7f20f&oh=00_AQQh_2NsN3UhCewBn-ITIowwvBV0I-xxszuL5_O0YiIqmA&oe=6AFDE4FA"}, {"file_name": "screenshot_5.png", "id": "2381760762570575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_2381760765903908_1821661328726615444_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG7hEEdNpOMQ7kNvwG4fmbR&_nc_oc=Adojz6PK_gIbX85vCv2UE4edT4no17VtqN6RrAwjiSGdqD_VdB_pRrsI4wYBFjkw1AU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3RCorO7TBZzR3Ln6rgewsytWegEwZp8xnH78oJT7QQw&oe=6AFDD147"}, {"file_name": "screenshot_2.png", "id": "1594277538682804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593895988_1594277542016137_231601455427143471_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DRMILwmh7kQ7kNvwHwzwZQ&_nc_oc=AdqJN3JZYK8guxRcnCzkG12bb5bnhP1I0afsVsGNAnvqgN6GeYX_Cv2FBCS_19-gS-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT77jOxXFbqV_M-azOeY9fJSdNVpvkEhXS3K22NCQQMVQ&oe=6AFDE394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HMScan", "keywords": [], "long_description": "HMScan turns the things around you into 3D assets for your games.\n\nPut on your headset, place a box around an object and walk around it. A dome of squares fills with your photos as you go, so you always know what is left. When you finish, HMScan builds your model on the headset.\n\n- Guided capture, made for first-time scanners\n- Stereo Fusion and AI Processing build your model\n- Gaussian splats for the most lifelike look\n- Clean-up tools: remove the base, fill holes, make it solid, smooth it, wrap the texture\n- Export GLB, OBJ, PLY and STEP, with sizes for Roblox and mobile games\n- Export Gaussian splats as PLY and SPLAT files\n\nEverything happens on your headset. Your scans stay yours.\n\nWorks best with small, matte objects and good light. Very shiny, dark or see-through objects are harder. You must be 18 or older to use this app. Only scan people who have agreed.", "short_description": "Scan real objects into game-ready 3D models, right on your Quest 3. No PC, no account, no cloud."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hmscan.com/privacy/", "developer_terms_of_service_url": "https://hmscan.com/terms/", "publisher_name": "Honey Motion LLC", "support_website_url": "https://hmscan.com/support/", "website_url": "https://hmscan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1431272930065459"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1690016762636177_6399214093207927327_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gJse-72sHQQ7kNvwHkAxnO&_nc_oc=Adpgm2wD7WSquZrIVPuGwuWbDOV1G7m-a7L66s2khhu6epQjCFTkhX76xGQeyQQ87tI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVic_tnRfk-YXN1Y8-e4Wik1JPwOopTb5LvvPYIicpVg&oe=6AFDC43B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HMScan", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1794260040, "lastRevision": {"nodes": [{"id": "1431272936732125", "release_type": "SCHEDULED", "administration_status"
t=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEs3tI8_lcZNvh5BvdLx2OXJoq84c2adQbOBsOlq_XlA&oe=6AF485BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "947896674218576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820619_947896677551909_1800020938662699060_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYFa6ht0z8YQ7kNvwFo7zRG&_nc_oc=AdrOoh7GdtNzK7tzBjwfbUFObkatYsOn-rk8cdvwkF0h4BR9Uv9n89yD-hdhTTOb74E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa_Vrmk7woF5K6SFafbfnXQmlmXPIc5W3iFSJgaHXZbA&oe=6AF483B0"}, "display_name": "Core Defender", "keywords": [], "long_description": "# DEFEND THE CORE. FIGHT FOR YOUR GALAXY.\nWelcome to **Core Defender**, a thrilling, immersive VR action-defense experience built from the ground up for Meta Quest.\n\nThe energy core is all that stands between your galaxy and total annihilation. As the appointed Core Defender, it\u2019s your job to hold the line. Waves of ruthless enemies are coming, and they won\u2019t stop until the core is destroyed. Do you have what it takes to survive?\n# HIGH-STAKES, ACTION-PACKED GAMEPLAY\nYour mission is clear: **defend the core at all costs**. Step into a fully immersive sci-fi battlefield and take on enemies in combat. Every second counts as you fend off swarms of drones, demons, and otherworldly creatures that adapt and evolve with every wave.\n\nUse your reflexes, aim, and combat instincts to destroy incoming threats while constantly scanning for weaknesses in your defenses.\n# UPGRADES, ABILITIES & CUSTOMIZATION\nVictory doesn\u2019t just come from fast hands, it comes from evolving your strategy. In *Core Defender*, you\u2019ll unlock:\n* **An arsenal of sci-fi weaponry** \u2013 From energy rifles to high-impact explosives.\n* **Tactical structures** \u2013 Auto-turrets, rocket launchers, and more.\n* **Game-changing power-ups** \u2013 Double Damage, Rapid Fire, and others.\n\n# INFINITY MODE\n\nThink you\u2019ve mastered the battlefield? Step into **Infinity Mode**, where the pressure never stops.\n\nWith each round, enemies become faster, smarter, and deadlier. There's no escape, only survival.", "short_description": "Defend your galaxy\u2019s last hope in this VR sci-fi tower defense shooter! In Core Defender, protect the energy core against waves of relentless enemies. Build turrets, unlock upgrades, and unleash power-ups as you adapt your strategy to survive the onslaught. With every wave more intense than the last, the question is simple: how long can you hold the line?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrightstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "VRight Studio", "support_website_url": null, "website_url": "https://vrightstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31571691732476832"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1459487855342732"}]}, "baseline_offer": {"id": "1459487855342732"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760652000, "status": "PUBLISHED", "id": "1459487855342732"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36208327848813174", "version": "0.4"}, "id": "42
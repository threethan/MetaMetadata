8_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhqdURRgIbUQ7kNvwEzkyp5&_nc_oc=Adl0Ah_mpl_4wzW2Qt_CLngO_53lhjxhWAjyF4YgV0xcdzHXpO6c9SfIBcFpmgLBeDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAe--HwbgHNaH1_z-xaGRD6X3lYqMZAtIHL4HYGPdCZg&oe=6999B7A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gravity League Cover Landscape.png", "id": "1219139702355137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003243_1219139705688470_1876740721875008590_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKUXgyzc8cQ7kNvwE9rzra&_nc_oc=Adk2epl1vAcX2VEKYEw-HU787jZVGYadtQ-ordDKFoOg3NlX0C8dSyPW8VgvCLQbeq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0epp-NJukcjTb7ugN3IgE-BDehPxF_J4xMX2KmhozZw&oe=6999B6C6"}, "display_name": "Gravity League", "keywords": [], "long_description": "Welcome to Gravity League - a brand new ball game!\n\nThe rules are simple - 2 players, 1 ball, no gravity - the first player to get 7 points is the winner!\n\nCompete with the best of the best and make your way to the top of the league to become a Gravity legend!\n\nUpgrade your gear in the Gravity store to enhance your abilities on the field - new gloves, balls and stadiums are waiting to be discovered.\n\n*** Early bird specials - \n- Launch discounted price!\n- Get 5,000 Gravity Coins on purchase!\n\nTo be the best, you have to beat the best.\n\nOnline League coming soon!", "short_description": "Welcome to Gravity League - a brand new ball game!\n\nThe rules are simple - 2 players, 1 ball, no gravity - the first player to get 7 points is the winner!\n\nCompete with the best of the best and make your way to the top of the league to become a Gravity legend!\n\n*** Early bird specials - \n- Launch discounted price!\n- Get 5,000 Gravity Coins on purchase!\n\nTo be the best, you have to beat the best.\n\nOnline League coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blue-duck-studios.com/privacy-policy", "developer_te
-y-3nX5Zc_iLadcraQp5fg&oe=6A282CE3"}, {"file_name": "IMG-20250822-WA0014.png", "id": "742497501999788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618240_742497505333121_5872223927047901981_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0m0Nva3Ou4Q7kNvwGCLm_-&_nc_oc=Adq7ZzDAkUQP_7Q9-ZLI2ESPrmzoxuXsSZIBuqb9qo1BGZphpRVaV67iSzcFLjCtwlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NdNoeoqxhQ0y1zeLRtHIxa_hXN873u3gXHhBeYeoywQ&oe=6A281997"}, {"file_name": "IMG-20250822-WA0017.png", "id": "553332881138102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620669_553332884471435_7231746051978870861_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1218BaFc41cQ7kNvwEZ9E2o&_nc_oc=AdrukG2Gz8gnmNR2gtJkZ4gqo5rkCFKwJw1VaZl_IFwI7Drux9BW-oIVpbaJCXvC20M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MfbvfgxAJQDm-sZwKgYhfA3fru54zzbFfGRmo9_5GEQ&oe=6A2831A3"}, {"file_name": "IMG-20250822-WA0018.png", "id": "1877822752795235", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303938_1877822756128568_1810385507539907092_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uABeBfm2ouAQ7kNvwEUOCxj&_nc_oc=AdpHHTqZN0fHMRwz16EDjd7bKxr4aNma3OugqZ0NlU0MN_EceEEI65f5hwVhNUwqZN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sOJMAnetI8dFEZ4KoEG0ZdhulmFzenlcolzsfu0TXZQ&oe=6A283114"}, {"file_name": "IMG-20250822-WA0015.png", "id": "1545681193071172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617687_1545681196404505_4420497999656796303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmpVAtqX6k4Q7kNvwFfHPuU&_nc_oc=AdrcyurTi1_UwMVbxD5QdhaAgTAa2ykJMFGGNF7RDlFi3L9Yw24YsTw8htbfsGMQYic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SprUex0aTTtbQ9SCYMzAArKaBsbihnWVT5dx4FfuW-Q&oe=6A28209A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Share", "keywords": ["filetransfer", "localfilesharing", "FTPserver", "WebDAVserver", "offlinefileshare"], "long_description": "# Simple File Share for Quest  \n**Wireless File Transfer via FTP & WebDAV \u2013 No Cables Needed!**  \n\nTired of using USB cables to transfer files? **Simple File Share** lets you wirelessly access and manage your Quest files using **FTP** or **WebDAV**\u2014no extra apps needed on your PC or phone!  \n\n## \ud83d\udd39 Key Features  \n\u2705 **Dual Protocol Support** \u2013 Choose between **FTP** (for broad compatibility) or **WebDAV** (for better security & performance)  \n\u2705 **No Extra Apps Needed** \u2013 Connect using any FTP client (FileZilla, WinSCP) or WebDAV browser (Windows Explorer, macOS Finder)  \n\u2705 **Secure Access** \u2013 Password-protected to keep your files private  \n\u2705 **Full Storage Control** \u2013 Upload, download, rename, and organize files effortlessly  \n\u2705 **Works Offline** \u2013 No internet required; operates entirely on your local WiFi network  \n\n## \u26a1 How It Works  \n1. **Launch Simple File Share** on your Quest  \n2. **Start the Server** (FTP or WebDAV)  \n3. **Connect from Any Device** (PC, phone, tablet) using the provided address  \n4. **Log In & Transfer Files** \u2013 No cables, no hassle!  \n\n## \ud83d\udee1\ufe0f Privacy & Security  \n\ud83d\udd12 **Local Network Only** \u2013 No cloud uploads, no internet exposure  \n\ud83d\uded1 **Runs Only When Active** \u2013 No background processes when closed  \n\ud83d\ude80 **Fast & Lightweight** \u2013 No bloated software\u2014just simple, efficient transfers  \n\n## \ud83d\udccc Why Choose Simple File Share?  \n\u2714 **More Flexible** than HTTP-only solutions (supports FTP & WebDAV)  \n\u2714 **More Secure** than ad-hoc wireless transfer apps  \n\u2714 **Works ", "short_description": "Transfer files instantly between devices over FTP or WebDAV\u2014no internet or cable needed. Share photos, videos, and documents on same network."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/simple-file-share-privacy-policy/90c7b80b-690b-4063-b31f-ecfdeead22b2/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kalki Arts", "support_website_url": null, "website_url": "https://kalkiarts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25238891342367211"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2490932404658590"}, {"status": "PUBLISHED", "id": "3835739710067392"}, {"status": "PUBLISHED", "id": "1405795884177387"}, {"status": "PUBLISHED", "id": "25991991000394740"}, {"status": "PUBLISHED", "id": "1686739038953512"}, {"status": "PUBLISHED", "id": "883300007538299"}, {"status": "PUBLISHED", "id": "1043213337835658"}, {"status": "PUBLISHED", "id": "863477089343490"}, {"status": "PUBLISHED", "id": "2260831927725134"}, {"status": "PUBLISHED", "id": "3402443703229005"}]}, "baseline_offer": {"id": "1043213337835658"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "2490932404658590"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25369870255935985", "version": "1.0.2"}, "id": "505191779322817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugyL5uiJNnkQ7kNvwHEuncH&_nc_oc=AdmVmoLfzw-1oP-09O4j82CkgPxss2rSjUeBFqfkj8iCaDyCnO7A3KjLmLga2d-Xqmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8iW3uBhu1QJuB-0oad2IJSGXXV4ji_L40d5CWRI2NDQ&oe=69BFE4E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pCU2Rp-HiYQ7kNvwHWXfsP&_nc_oc=AdlzAwvsK-9xf83ACc8eEAFDR_Yc008BDS6tkvbSvojmKosFF7As3fMKSneB2yVOWUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwosZ8S_sTkxOOLIPEgxYN8LOA0SH6wffiVLk4znX8uWw&oe=69BFF9E9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
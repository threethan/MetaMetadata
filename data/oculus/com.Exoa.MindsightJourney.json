cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtxORUUQYPkQ7kNvwFTuzi9&_nc_oc=AdlUL4DkEcZvhZrFQNryAnQ_c5QnxtYfZ_YqVzs03bYPyTSFBB7Fi1RgFKpbtmcEZag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBC9VZ2-AhiCXo7Rz9jF2I5Sw1xEN9Y6gxTm_uIoAWYg&oe=69A829E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMxupmWsadwQ7kNvwHHnOHz&_nc_oc=AdnEYVhuebGkmBlUKm8SBdtUGaO7-wA65C2cgBUVtTyMHQYj0pJnIDzdf8wgn2Sk_NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfteVXWfL5b1DpsOUsd85HUcD4qo1njrmcNaipIOL6cYvQ&oe=69A83EE9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
, {"file_name": "Screenshot2.png", "id": "1324971295289035", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41QqrJ1_lssQ7kNvwEsVJjy&_nc_oc=AdqA2xyLUmVX_L9MpIEfgq98bSXOqOVwN86gGK5JRs52Im1MKn2ZDJaAy4ZLlQQ8Jzk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6vvgoeCcM2z7ysHnUdvpibpdS_PTeAWBvF3DlNDBUrg&oe=6A92CC50"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbhhDrop1KMQ7kNvwEBs_q8&_nc_oc=AdrKknJ4bN6j_IHSvHcBoP2zntDTfasxN-HPOz6J6oLYu3nwHDKVmFbZhm0Wi1SIVPg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4-z80ai5gGYv3HmQxwkfQNMzwjoqVzkJjjP2XGYlkMg&oe=6A92D4E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0swhsJwzF64Q7kNvwH_sNjd&_nc_oc=Adq9K0usMcrXZwX2-sjOkyQHlxIKmOcBOf3hmvDR2OSySBPlZCqkdiuEYdqy7VoAr9w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbJcFxVEa82kkFkyQj71JL6WrH9UfKAyztaO83j7Zddg&oe=6A92B1A9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozi5G0wFbGcQ7kNvwEh6CbI&_nc_oc=Adparg9cTnF8LK5vDJK4SPkewGMzmUUmqsg2DIaJSLiArBM_M9i_XtLhCyJk1Ul2ZUM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0_nbUYJpLpRqwEXcP8E7CRVm5wpoLxq2YGotGuGRlvg&oe=6A92C6BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey",
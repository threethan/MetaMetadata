cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugyL5uiJNnkQ7kNvwGDJmz3&_nc_oc=AdkIHq14ckGtiA1asfkuYeKwfSzvvdmB5Y3SqSmz_y46zN7r2cUxvwg7eA-TPmHfeAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxX_D-BnsP4xuH3MWgvW18K0JlMoz9qi0dZWLfspI7Rg&oe=69BE9362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pCU2Rp-HiYQ7kNvwGr0haI&_nc_oc=AdljFZbDwnG5OIidGeMqBLDCFMnujMBM1QE0qT7y8PrToJ2r9oYx-Rz10mZwpAeZow4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwdk72tOyFpvfDYvbjmU3VAR84qlPMis6Pch9w1tjXxfQ&oe=69BEA869"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
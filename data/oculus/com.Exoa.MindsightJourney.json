cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_G7FNXpnA8Q7kNvwFPrYJY&_nc_oc=AdnJBX4ll04avmokn_B7dJtHKVTPB5TQ-qLTh4DoLtOwfCgjpoOeXE0TEFJmu78t-oI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZAEDbqY153d7DJyTgCoAHxqC_JxrIKj8xzkkT5gRsiA&oe=69BBF062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAu_cnEnJvsQ7kNvwHUv8Sa&_nc_oc=Adn1A41ln4UrkYn1Lahq961x1-otacGjBfusBIR5Hu3kPEXrxtXPracWGZI-M37JMKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEUcarNTpGA9S5zL7F5XmchR-hGsmnnjZa7gfbc2l-2w&oe=69BC0569"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
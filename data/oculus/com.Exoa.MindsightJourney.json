-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSR6W1G8WGEQ7kNvwFt5xyz&_nc_oc=AdkAjtRCf-BCqqRxVcdavn2335_sJxYBK3nrNtpR2tZGowMn3uj6dPEtnwLIotuURqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsLG95--1gkWxjTnxCzG-tBI86pIHvEeHOSg5eBeYYr9A&oe=69984F50"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FulH5d67ZWAQ7kNvwEGe60f&_nc_oc=AdnU6R8hbY-BYUguJrjCfshyTrhGh-GZuJyTPRBueUgJ6480rupa26m_tLWsJIdtDZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvctYbl4FUepz6rm8ia-c7HgFA6FU5hKeeHsrbSy8rUTQ&oe=699857E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjCKM1F8LNYQ7kNvwGt0DWW&_nc_oc=AdnR_u3lv0y_eL1843FhsJO6TKDHK5E9L23mXiatkrvAqfSk21U6OvZi5qGXlmBnnMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvF6KkwKRrF14QsNCT46I-zmIkD0QIgykwsd92uDs1MLw&oe=69986CE9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix7Qqs1j4YgQ7kNvwGjfzyg&_nc_oc=AdlZTB1y_3xbi0rd4kzSJzAPScDd2mRZ3xHxNDyhCGXI4JJY8yS4EX2h8Fy-vQzLYCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuMQ8LptGRAvyUbTn2SP-XVeonS8nOTVuqgIPxDCDlkKw&oe=699849BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514
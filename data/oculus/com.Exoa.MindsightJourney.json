, {"file_name": "Screenshot2.png", "id": "1324971295289035", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKV8Lm7jt4Q7kNvwE7gJUA&_nc_oc=AdpanCoNP64SYCQLKz6_rP48XQPw9F2XAMXIi9UEVxFSO_kvC7fM8cWY_5m2TULSnbE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8AsA7lWktSS0W4cXe4FSgFRoAdqSQEwclKNciG6iDEg&oe=6A689C50"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6H-RynAOu4Q7kNvwHr4bgW&_nc_oc=Adrwb4U5qef5Fh6HHbQfXPbbF0OUdrKUJZkP5djSnNALJbRshXGJ5rmuRF-ymzP4bHM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlW_TWaUMKB3tvyKTo5a68KDj8QntjWTkMlRxm5doiig&oe=6A68A4E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i4eb_dQ5nQQ7kNvwE8jv4M&_nc_oc=AdqToyc9bdGy5xCvei_-T50s4XlF1BKDohLsOOZ2F7GN0x71Pq8lj9TAoXency-DJk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ9_1j4HaKrf6-lzneEKzV5NCd0-OBQt11k1vQR20tag&oe=6A68B9E9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH95r_Tg0wkQ7kNvwEt9Ne6&_nc_oc=AdoIlP_9vKLe7kwrYu7DVpK_D2n8iVrx_OQB93NwHGTPkiSmzfFs_-tKuZX4kwhavKg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNQetXlpdJ1UthWD1XGOLObbDBwoC3TlvcrBfKmpAF7A&oe=6A6896BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey",
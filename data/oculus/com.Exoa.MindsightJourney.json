cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JtFeGmXCq0Q7kNvwGD2ilI&_nc_oc=AdkDpocoHzIHqHJHNSyRO9BrCiQ9y5HN5d9ETQuAl8zniCqRDMUOs6GpwILJ7fmFgD0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCyaa9FCLMP7CB2W4xzCX8s7391Ynor91TshQhTu5rZg&oe=69AC1E62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nQB_k3EO_EQ7kNvwHJKPuo&_nc_oc=AdlltWkLMGyeNvW2LI9tw7UeU1RZXXMGrj5-8WBG38H_eB3jDSJg65eIf83Pk0Y-K2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXWCpDQEGuERp8NAv8_XNI1IzSjbXTyvVyhVk3p3FN1A&oe=69AC3369"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
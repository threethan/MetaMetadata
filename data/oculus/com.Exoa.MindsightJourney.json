-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w-ahQwekUgQ7kNvwGNTnro&_nc_oc=Adka9Rl6CXRjM_y1brpsaLVquq3k1PDc_6ZgL7wkSmM5ge2ZGcchhktMCRF-RB1cnEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuY6DnBfyU5CctZ9AC3hdVKt07v2Kw1xwxMKRA7ppSBdg&oe=69A42CD0"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqAlrV_F8QQ7kNvwGYTI76&_nc_oc=Adln99gnKP9LkJe2M-5265ovBoca4iRJRAoi71DCzwz2tY7qZB-RRgmVpuRIuzEjqzw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKXbR7RDeR_TxzABNeBmWqVZfM7zkw_HkK5ll1vs3-MQ&oe=69A43562"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR_oL37VAA4Q7kNvwFn4jem&_nc_oc=AdnKxIGvhnfZCHTH0OrqKrgFOWUB4ahXDBmssY0omupDsxh0tNHvOKxaOl5d0i7g8QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftTWFeceTyw2vwZFnA0Z2PwxOUFw1mpht-C3-NEwpfKlQ&oe=69A44A69"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Pl5mv8a59oQ7kNvwGy8F4T&_nc_oc=AdloHyA9QhUbX5AD-0PFSOI7m_xTm9zv76S3-pjoKKC9XguJwGyTmt5iBWcUY9NphE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftisvKdEDsAkvvCQB8tf3Q3ZDmQXnKuLa_3iBObp9HVFw&oe=69A4273B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514
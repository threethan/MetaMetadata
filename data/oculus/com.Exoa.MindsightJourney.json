, {"file_name": "Screenshot2.png", "id": "1324971295289035", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWRvUcao6x8Q7kNvwGI9HhO&_nc_oc=AdrgdNbBClPQBf7-fyFzf1wnsi3aWPccYmuD8w0xp5WK9DJR2hqR6kxgN9nHe1nMOBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_VurfjN7N5-Fvkgue4LgaqPCHeLfPKJAu0WVFJWQoyQ&oe=6A0C5350"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_pkWvPFylkQ7kNvwHnTZM3&_nc_oc=AdocLPyLeVLy8QSDqesTO-oOtM76GAYj8vT8WGRmsf32UacKodXjU83h0zhNI_RqfrU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MS0j-Ikw8JnvsxRrH0DfMNbbLNMTmN9j9HvR91auKuQ&oe=6A0C5BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUPplcS8BD0Q7kNvwHJy4XS&_nc_oc=Adp5wtHX0XlR5vg7_TBTgLM5nwtQ6BDFPc4VGaz-8z3qf0Tz2aEU3bBfV-b8mlWCG6g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tuoVRERfLjxyL8uFSkAfD6W6miYSTf1m7qTXKlu2EQg&oe=6A0C70E9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPbI1-GVGVUQ7kNvwG5aDOl&_nc_oc=Adp1sKxu0BYawsnzly0Qfm2S1iKRhktimJceH6ThG-gxgY7t45z0i9C8JtbEHj1U1yc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gvCmjtmSazFJOKKS-4FWGzVZ8noX0dl6jwIrmJGnb8w&oe=6A0C85FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey",
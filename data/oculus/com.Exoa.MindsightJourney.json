id": "1324971295289035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VicS6yrlrycQ7kNvwFHyGj0&_nc_oc=Adms5cVu2khjj0uGvoQVVoW_hzKPMKTdOvcdjCD6WHWa6fSCh_o_LzdW1qpwz8Jh76Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfycZqNDRrThbWrM54EnL3KZFWIN2bSyj9hluxjZc0pjDQ&oe=69BE8AD0"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugyL5uiJNnkQ7kNvwGDJmz3&_nc_oc=AdkIHq14ckGtiA1asfkuYeKwfSzvvdmB5Y3SqSmz_y46zN7r2cUxvwg7eA-TPmHfeAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxX_D-BnsP4xuH3MWgvW18K0JlMoz9qi0dZWLfspI7Rg&oe=69BE9362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pCU2Rp-HiYQ7kNvwGr0haI&_nc_oc=AdljFZbDwnG5OIidGeMqBLDCFMnujMBM1QE0qT7y8PrToJ2r9oYx-Rz10mZwpAeZow4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwdk72tOyFpvfDYvbjmU3VAR84qlPMis6Pch9w1tjXxfQ&oe=69BEA869"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6QctbxL5EcQ7kNvwFVr92_&_nc_oc=Adnl2_Q9XAbs3oHhzu0rT_LUz0pleDAgZR1kJG_oavCE_BZvG56S5-TN2AKZg-X-YFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrLKAwSyNiN2Pya_vaasMjtaVMQqJTPJgpNz0Zag_pXw&oe=69BE853B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey", "platform": "ANDROID_6DOF", "context_category": {"c
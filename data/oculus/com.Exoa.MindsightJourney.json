id": "1324971295289035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0bqW3syPO4Q7kNvwFUJ9P9&_nc_oc=Adm-AUtdd8j47Ahq5ANL1kSXUlvXp7x2jAeYKM-S1CxHoSLpbxYBHDgw7EB1jhndZfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkBvXQFyy_SA-G6VtLkMugqPN7zrEbhAvZ5AWvnOHbWQ&oe=69B6A1D0"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=495fWJhw03IQ7kNvwETZthm&_nc_oc=AdnoNn0Oi2TYQo1iNdLPza6MLsSVGwqQD29ymyV9RPxtcdjAoQNKOSQTgz4DRQFmq7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBhF92Mq4_3loBbwaFDRsFy-m3MMFe0g2WvJvFvc3GVw&oe=69B6AA62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMjeYUJrdboQ7kNvwFY9UEF&_nc_oc=AdlRQd0abN2P5acDEKn4c0D4LwdTXaT1ojwWSsGSxJDF56L_q2H-ZBN7WjLESaZSimw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3EZ3_DeLFPo3BscD_0vlXPM3XTOLHQyP6KgdGE19Amg&oe=69B6BF69"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyYVMxpH4TUQ7kNvwH1wGTF&_nc_oc=AdnaTq2F8OXRZCV7wAdxzVKjOL3OFX8AACUXryVqAmey900bPxOvPH_Nf-y_iuiFWTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxsBnNw9-vFQOIvQswiSG8xXsCogfFLCnt4MwLl6zB9w&oe=69B69C3B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey", "platform": "ANDROID_6DOF", "context_category": {"c
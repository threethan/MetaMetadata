cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaCIlEkXq3gQ7kNvwGsWqGx&_nc_oc=AdmB3zn58jS2_si-wEDD_9vlC6ewZ3V_6aqiVs3esooHf3qlQnh-7Nlz7qs3YbKsowc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweLFdJk2X4m6WLh4wp-veJnGz_WTkG-6VjmigpPVwMjw&oe=69AEC162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VijsLyXcZLIQ7kNvwEqp2Qs&_nc_oc=AdnaaXQDkJYCYCOsoWwgZxL6urOoheifPb62Hfhd-4xW9glJNWkvM9xrpCUqqa41QQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZJ8eOSj8m3oA6LIrBqRAHLApCXvpD-m0x9qNHglNxcA&oe=69AED669"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "
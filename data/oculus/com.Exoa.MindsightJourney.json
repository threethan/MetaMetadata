, {"file_name": "Screenshot2.png", "id": "1324971295289035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nNyBVrJaG8Q7kNvwFR13zT&_nc_oc=Adp1H14k3H6kxOPgV_wR3B76xcgGVr4VYBYhfnkrRm2BfVe1NyIi0PKKa6xXxPZhw48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t07B6iyEgdhJW7Tfj0Ypkl206dPAKW434CqWLKfE8_Q&oe=6A380D10"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLl5Ctt_kwYQ7kNvwHDEyta&_nc_oc=Adozs2P9BkSl8AQjKSjYmXxAsc-0ie8sKT1ul_OolrXt8tqEix9X8-UpqdoBJJshCnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9irUMyw2VpEXg71Ek4a1xxjfTyfsYx5iBz7cUE5e7ssg&oe=6A3815A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuwekAY5yrIQ7kNvwHRkV9q&_nc_oc=AdpwWKxiGm5ivYqIJDermG7rfXneP_tWX96ZyonV86NCTiBBI2FQosbPgDExSrrKAZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dC-bElQQQB7Mj75gtt-2UVj18Gz_CsIdyLMWBACiVEg&oe=6A37F269"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLaW8A5hwfAQ7kNvwHjnivZ&_nc_oc=AdoatnE8hiLVtKFV7qQgwJ477Rbhg21Ve35oTHaodXgd7SCXttV0Nn0KngheP1z4pC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0GBuqKymkQpWfcenSzEO1XVjY8PDT0j-j8jeJ6oOR9w&oe=6A38077B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey",
-25/473391898_1324971298622368_2223007151819181626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w-ahQwekUgQ7kNvwF0cA4d&_nc_oc=Adknr3iEQ50NqNYpGXNFZUM2S4_siFXK1KW8V2xYn8g9c8OL-oQy-DCdffLyjFI6PH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXh2rmB1uCP0_mKuhSJf78askAVgcSdi7jLmn6qEzoDA&oe=69A2DB50"}, {"file_name": "Screenshot6.png", "id": "613959067924810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397281_613959071258143_7232644835587931213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqAlrV_F8QQ7kNvwGMe-f9&_nc_oc=AdnzMky5tWXm81RMY-w1KGdHcdkG1SGZ0iDV15cpQzb_w_AOuFrNPievdR9_-WG6nnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMCntkuhX7XUMVuHSb_cin4pb3UObm4lMyoKIMbdca_g&oe=69A2E3E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview_oculus2.png", "id": "1582856378874568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473401050_1582856382207901_7017840185617272738_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR_oL37VAA4Q7kNvwGXMJNC&_nc_oc=AdksclBq5_e0PRqZlvwujWxl4PMHarOC1vkR3OIRjjWBRNJAzqzP5bkw_rttR9D1NRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afst2oErRCwfkjkhhqN_pahQuk616RgNHKjY-XQ3mSmBdA&oe=69A2F8E9"}, "display_name": "Mindsight Journey", "keywords": ["mindsight", "blind", "visually", "impaired", "meditation"], "long_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before pressing on the START button. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres. You can use the CTRL key of your keyboard to move forward in the playlist.\nKeep smiling during the experience, remember that the more your smile and laugh, the quicker it will happen.\nHave a wonderful journey!", "short_description": "The goal of Mindsight Journey is to open your vision without eyes, also called mindsight or \u201cthird eye\u201d. Each module has an instruction button, make sure your listen to each instruction before starting any module. A playlist of Hemi-Sync meditations is playing on the background to help you relax and synchronize your brain hemispheres.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindsight.exoa.dev/privacy", "developer_terms_of_service_url": "https://mindsight.exoa.dev/terms", "publisher_name": "Exoa", "support_website_url": "https://mindsight.exoa.dev/contact/", "website_url": "https://mindsight.exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33078494551798322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393856_3476751572466431_2293201901414565954_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Pl5mv8a59oQ7kNvwED0VXc&_nc_oc=AdlqwDN_6vruxHQVNhVHg9WbPP2ukDkSEMleo95BY0KfAXhw41-1kFuH0dXv1EYQoE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxzOPEdPXf3LLP1fInDenvSCSxAfqvXJmPYuYdkbafIA&oe=69A2D5BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindsight Journey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514
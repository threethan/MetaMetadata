974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK2ftZjjVT0Q7kNvwEvnWMv&_nc_oc=AdkSI_Wn1DZEc9nS9isO57lMYJl2O6GnWWifJAWI-0m7mZlLlnLBdZ7OquM8_blctBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxB9QCwOCRLli1iwV3xZ4_pUayju0broEu1ZmqsQ3_3JA&oe=69BA8952"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY_L2-IhK-AQ7kNvwGPElDX&_nc_oc=AdlhraeeQ0E3SogxJP2OehCKz2qINfExT1K4pDBhMOCn5RZI6-W2Srxn9L55yuUAVqg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwahtFaFmaPCoy3pwm7BdMWIJdG3G55UxONgY2dZQ-QAA&oe=69BAA807"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dqfr0dXbLnIQ7kNvwFSHv9B&_nc_oc=AdkTxNTuDCiH-oVF43DkpzREnCIKP493SKfRuQXU9t_mo-ymLQOSRuJjbkS6IbhXlfk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgcCFyzp4kzmbB6XB906a514frnXJ588kiBxbsNN7cNQ&oe=69BA8E57"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7p1mLCtsRYQ7kNvwFthxZh&_nc_oc=AdmNBsxPeajJR1q8UiQvnEUUlavogH47ru3WPUvv4BzHcwoI8uWrnrnf6Pwdmpo12nY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmgYSz7H4zvb6QwBXl3XGFmfAOigegYEW1GARMIP--YQ&oe=69BA8519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcTF8F7umnwQ7kNvwEUvjq2&_nc_oc=AdkUYzyL_tM2sEm2TT1H4Z03guyaj7YCEtmJ8_RW_5FJ2QU4dykQxlkxBSzjIKxVmUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp896eZeLBlWy_DpncgBda4wJXL6tGWYbZFpFBWt8FRA&oe=69BAAE1B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
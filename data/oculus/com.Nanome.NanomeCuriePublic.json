974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQFFY8bQfMwQ7kNvwHovSD4&_nc_oc=Adlb1F_w7_0LWIUNR6Dy5AjY61wNmG4XvA1ZE2S3rwu7ym6YsYd0gnLqYUn6y0bUbrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2evd10xrAs2PCxKCMP2lgDzzjaCdgNfHeXJUbTG8afw&oe=69AD5A52"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwKybdhQqT4Q7kNvwGYxk7M&_nc_oc=AdndwDl7RwqBRk79Sfw0rJl6GtB4VcHI2cRKmg7j4cp7lb1HjbKQv7y0iNV_vQOP02s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8vjRRKK11ou01VYhryh-xZ_yi-sBAAVtxcFHylVVeWw&oe=69AD7907"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBquCzahmV0Q7kNvwEFFsAl&_nc_oc=AdlH9zN1Aiv-AFIqDdYdfvCTBBigf0nNWycYX4TttK4iZakshW1aVRRMh0q6xuCKfKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFQ_pBGFNfIFXmcCjaiKYv-B6BI-DF6DL4ru2eAEue1A&oe=69AD5F57"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYuiee3IVfQQ7kNvwEfoTd_&_nc_oc=Adn3-SmPa85ojXZfOCKyISG2c3vIIeXpZcF1JW8qkq8KBGo9eQSGyCv0MrZ2WwXXnEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1IxvsJdJM1xUnphnkBNIBWcs_JFcPyo-btUXoaUF2jw&oe=69AD5619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcY664JYNpQQ7kNvwFI7t_0&_nc_oc=AdmHV2WvJtsjZx_Bguvv_MgBcVIfN5aGUzYIvfPO89IUcueD3cbAbuQdqeUdVYPheEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBFZFIghm4mawAX2i6DIh7_z_i7NSoNEH6Gv_UOKZX0g&oe=69AD7F1B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
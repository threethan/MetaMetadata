974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxa3OU019UgQ7kNvwF5xroQ&_nc_oc=AdmjLGeEE0J29HjBOh9lYRyvKFWGWBHFky_P3Ctm4d13SQhmXJTMVBMlBj7ULiC5UMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBEPpqb52ID5dY5AggD_T853ISKnS39-MF_quvjObGwg&oe=69A81452"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHtDv6IGfsoQ7kNvwH8OGCb&_nc_oc=AdkaiUOuVpnjsloyzm_UGQFdAgRTT1G-0-XQCLnWU3-X2YeH_eUcwyEHhG2Ikz8CGcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsQukDXUMopuxODy5X8blGL1P8B3Bz4DOf0TOeCkIDN9g&oe=69A83307"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N2921m5_-kQ7kNvwFVm4gl&_nc_oc=Adm-r28ZQW403IxG8l6CRTODPzFxNmQCKfgjDqhkX7k0GLB9zDklP9n10aSAOEZjTz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgptvHC61vZG558WBYI0po2VU8EOeM9uddNEtPk5NQvQ&oe=69A81957"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_hGJ0q7g7oQ7kNvwFeYYun&_nc_oc=AdlH3Nu6oOt23c3xPFcn4aCB-_ZXD6ZEAFgoIqlf05sQo4L6i9mqRryz1gxobTnMXi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQ-Ix_xpXzaDSF0zgpKAbYnYrXtp0V03sMQKg_yzlKwA&oe=69A81019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBe-W-YmIIQ7kNvwH4_xZy&_nc_oc=AdlPa8i_nSmB7tk44EseJ9_BdDb-30CnjTAZ-1_PtYBQlPSMAgZLb57vrhDmLRQBD74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftdkmmHhgi-NaEvaQBU-XyE8ATB26BwdrMfY1ObU3SGKw&oe=69A8391B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
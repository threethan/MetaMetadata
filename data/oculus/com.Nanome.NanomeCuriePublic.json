974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4L5ZTSn2dYQ7kNvwGqP78g&_nc_oc=AdmgMaytfsAMaCpFQTj4_tM6axYJbAocH-q217c67FgipFwD7iKj8eez5cFnu0RFio8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRulAoRuVNb7LlltNgNGMXtFx5x9_v_-LOJJ-h2agxUw&oe=69BFCF52"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUCNO_ReKIoQ7kNvwEL_UTh&_nc_oc=AdmSrBCFRi601kLs-kUUG9Wi_icDRDAUInVJIvFWld5SYdAqiXfzLlvMDZZjF6FlE5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGV-8MF-3VgKmBn--mQN-yonowkXxzCKv75nmYMj8Qbg&oe=69BFEE07"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtRF7xUbiAEQ7kNvwHvhjqw&_nc_oc=AdmexU1GME2o-zNw_1wnk-tv2RDQLa4_AYXx7h5o_XsJobsoCdZLOy8GWcOva8SSt_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvJ4Y-Go2mV9Dih711Ta7b3cXw3HzbK3f9-AsD-UGTqw&oe=69BFD457"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q1f1hspjDIQ7kNvwHccYc2&_nc_oc=AdmPZYVHXXnStjL_ZIf-J529IENrEUw5ssM2Uu2ICFMQWkU5gZhkfkJocAgTcbajRPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3fIRWwvue3GOz-aSEF7jh0_K1sOCNKcSZBVUlpzGT3Q&oe=69BFCB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD_qsMrkqFUQ7kNvwHsisJE&_nc_oc=AdlWmi-fg434xJaJlwDyeG4XLZbe_9co7LTyStu77UYWEbWcJjM8ckXeiD9mVR1N4PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuyrcSOGwx1piszpPBsHFdQ1l5YcwSMYuNdk7Vjk1pSQ&oe=69BFF41B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
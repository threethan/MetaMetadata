974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8NnwLiq338Q7kNvwGOZaMO&_nc_oc=Adkrcc8s8T1DDUKIInn8x31qYjBOoT_RVb-c1w1NadMe8EDyE-rCWKWCzKCCQhsDXNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaSn9i7nSrj4Dt0TtxXsvZheHrEcThegE2i66xKDZbkQ&oe=69AFFD52"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iexru5s4KxgQ7kNvwFaucvD&_nc_oc=AdkWNf88VlXWazcdUtFUJAwJytXTO_asPnHG_qudLZYyQNDa-sAlvRhB06F5zNCbOzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuYl7Rk_1ELoO1n-5wWWmfbj99wVLJJ7akpQpmP-wSnA&oe=69B01C07"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1TNk2isZdAQ7kNvwF3-CUa&_nc_oc=AdkEzGTat0lTRLncXItSPbdttYk_wtptn80ogSF5rT2W8sruhZ3JPgZy4CFNKhket98&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoWANVuG5qYYtc1ov2yu9zFPZs9Ae0W3M0u_DTVnMOrw&oe=69B00257"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYuiee3IVfQQ7kNvwENq9tK&_nc_oc=AdmA5P7LoK-3Uf7lCMEH5JgrqQyTqPceC1WgUmOYMui7a0DMk-RXIT4HyvAC2Rs7PPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm7VFcaQZ29q-bOPvPtQBjt1mu6p265TY6L5hP4HmMwA&oe=69AFF919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKsritx3T0AQ7kNvwHvDiXR&_nc_oc=Adk5XsotxtilZHLRM5tex0EIpdfXXLz-02U3DhsP783FQ3scROblyD1JwS0IgzabCL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymmDAgcWHN6Vfpe8e8wPzPv0UkB5Rm1kbkWqGOCm5EHg&oe=69B0221B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbB0xR274BUQ7kNvwEmlFzc&_nc_oc=AdmloLxps941ehHU-tYZUqzF0zMKBufuEuYJSb7QwwKE0VHOcDnn0iMJF6D1iny6id8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfMtHl7i_pwmQAODMTY_LuKfelMT5yBDLsKVdV6YhFrw&oe=69B3F1D2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dFLHqeUnSAQ7kNvwFYriu9&_nc_oc=Adk8IQaTqKoIDfaGDiXWWVR_Nrr4rGfC2uITFRX2-sCugBBTgoYja52klleMJw8uqJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAlwyhvALDDWea18Ae0ukudnD_31CyLCXm1_VJ8r-h2g&oe=69B41087"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdeDphCN8O8Q7kNvwGcuLyg&_nc_oc=AdkxZouU9YMqyDEEbkG_urfJQEntwNMFcHxLhfiQ-dU6ohPCg5qmTTdsvOeJB2iHtrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwElqIyeBBRD3Sc80STYO2kx20e-K-MNJnhjJVsB6KgDQ&oe=69B3F6D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yee4JB1EvkkQ7kNvwFmNfYH&_nc_oc=AdkHsNcwK9dQnAMeINp0NlVOqVYl5oHhv58-erGGJkdWQkMONcrQYBWBStR-HxDyOd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXhrVuXzLbivYpjdWBHS2QuxN-GZ5MABy6Ih17xgkkNw&oe=69B3ED99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLOXCmJFrRwQ7kNvwEeFzvj&_nc_oc=Adl1fmPKReCd0WBwC3IMmRrFv0dfQzXLxt8wdaCHh7M_ZaEVehlQtdpFj8oKXnw8nJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWv55dmKweNtXXoUMhll2SPq2HSkUyTa2rRLOBW5B0Wg&oe=69B4169B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
4", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79c1BSUwugQ7kNvwFwOEu-&_nc_oc=AdmxrzSyXkKQ4g6IF4WzCSYFbbm1DtVxElDRX8Bck0Y36gDpAI3BsK78tWMG3boi_J0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsfWRtA7Caak8UJA9eRFVIw1wq0Anmfk0mnLhiQU5ESeg&oe=69A57152"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taaK982i-RIQ7kNvwHCQVk2&_nc_oc=AdmTUlO8S93LHQMkfOdlLIe1LP7pIlP6MHQwwNB1UlxBJBa8HTReXv2QaPpr4vbW4bs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftFtgkbPj6iKvLLAqRcEGHFyZTSznKvR-MU0AFjTUYMZA&oe=69A59007"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdas0GL9BjUQ7kNvwGqG3Bm&_nc_oc=Adn2V_L2u8fmGsXrcH4D3Be3oPZ2cP-odciig2KECQItMgfMvJKYLPDFq8q_sfkFfes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvha1AfAnFvoUAxVPcUrB7VzX21swh4U8A46vac1pVDcQ&oe=69A57657"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_hGJ0q7g7oQ7kNvwEE9gqq&_nc_oc=AdmcFpXnnXDZehb5lUZIhealX6ij13eARden3pG7p4nuPYsXNEcW-S00jX5waqRc_KE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvItPcmhDexKJHvnQpRKMFqxdjRQpAsg1jt1O8fI5Bc6A&oe=69A56D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3_84zcvUUcQ7kNvwEqnpyT&_nc_oc=AdmWNcHv_sfz-dTV9iV2G8uQ_s-MTX_8M5wGQE_XjU3-a-SZQsFqreCzlQbgBjbjM0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfunHSg0ntvuESu8ZQSn08j3u8WgQV3pB4s9WF1-04WexQ&oe=69A5961B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id
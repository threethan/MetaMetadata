3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro-Gunvk_xsQ7kNvwFiTKJ-&_nc_oc=AdmB5MQZMaD3PwwJK8v-3_K3SjoVz8uwTSfQAR9ULUzQCj1SLcgiT3yitQtsf0jQqIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsnalfg3sun_kWwXV7sRco8kZkL7Nv7PjKDzee7B4mM4Q&oe=69A2CE52"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHOCPREAuXoQ7kNvwHnD9kS&_nc_oc=AdmjmudCmJcgnqvQ2pHGgm4g9LhPRzuJxw22uhVZvSuO0TtSrZb7DijZ9zVqDPYGuf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afug1uj3QqdAGva4uGLpodOI8pPVYoZqDGfK7LRRmKYc8w&oe=69A2ED07"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdas0GL9BjUQ7kNvwFbX9Xh&_nc_oc=AdkPF5Q5nogZ82VRoDkxST4xBEaD-p4g7GuovbsmHf5bTjqG1tD8VYd_RZ95VeVMJTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvhcl_fWBu6hOUKL6opjafULEjVq_ne0QmkQ-gvK9hvfg&oe=69A2D357"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmEg8TjAs8Q7kNvwGTZwBR&_nc_oc=AdmqkC4FIriR3ewJ3n-LH--3JySVI0KBUVuwY2-AAvbunq25n459RWbDetUuqhHuA4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftr5tTBMoETeMkMB3gmmvW8JiK1CpAPUlElkMUkepwpjA&oe=69A2CA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3_84zcvUUcQ7kNvwFZf15q&_nc_oc=AdmERiPHFG5wOQ_82UzODWbey7CkDU-B8RnJmaMvboo5DcDA2I6nGjCeo40PSPf0hKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAu76HWq6SSsjG4ybFXsGx7eCKgmtiNX-zP-cjePh1jQ&oe=69A2F31B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/terms", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "ex
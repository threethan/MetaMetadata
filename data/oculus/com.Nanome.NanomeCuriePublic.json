5-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwOk_K5FqewQ7kNvwHu4Xgy&_nc_oc=AdlOztMT6zokx0ooKCkGpTr1rJ1-tZNj0lqK3L04bOkU65SPFOSUG6xk5B-IyaroYao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhQNtm4-9UKyD9_18QAykzgfUUG77vipeJ1ms4lAXiHw&oe=699C36D2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gaf5OWsEaUQ7kNvwGcSbK_&_nc_oc=AdmlvguNeCzOXsxfVQAm_5s8LS696kPbjw8wEbJO3SWB3NVnhDMiwzWOl_Mc2YZHtyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftGAhomRwbOaiicpQcOvtDnHrVDVEagMXRv4r9ieCH2aQ&oe=699C5587"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmZktHk9tHoQ7kNvwG2EbeM&_nc_oc=AdkhzMQn0n_mNY2UQuteK5ZPw_vF7Oepmh4K2NTCHw1xsw9-y_x9UcCxQZxSoFEqmOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvT6MMM-bya_I5CZqcYNG-bEfjDGPxrw6VC2FGoPpu1CA&oe=699C3BD7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEx2OaXMxgoQ7kNvwGpNCfX&_nc_oc=AdllzpB5-dtWPiqXBifPE19OONU1s4G4--GNkQdQ9jH4ZsoqSdS7naeJQVngqtQX1vI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4-Xm7De2EHYuCevBAod1OFHcpzv9v1h_bbayMMG2zJw&oe=699C3299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXvHZ_sXEosQ7kNvwGwSI68&_nc_oc=AdkNSEv2IKzHyeJl7-reOSW4HeLML2if9drB03dGamrMfrV5v9bM0S04SD8Z093x-9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afud6GsnxgLoieJyK75le_cXqxVCXcw0712rN4QjIB8F1g&oe=699C5B9B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/terms", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "ex
3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY_wfQjXY-4Q7kNvwGiZ3MY&_nc_oc=AdnJDtFxbYs8TT54AhvZ_rm-In-XRX6gmhmIPh3XkGGnX4c8rafL6fdyDmJHR-46-g8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afujs1EIkZaeZHwj3wnZzq3T2XS49X-BbeOYDUOyja_r0A&oe=699993D2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuWLCwrGCcQ7kNvwHuQXdy&_nc_oc=Adm3T22_daI5USdCbPETC6gUKq8Dx4Jk9fju1VR_V-b-ooRR0NCpkLhiekosffdI0Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBQtjPfOhAD13Uk-JepcBOR1CG2f52VcBc3TD0bh2yBw&oe=6999B287"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LqAvUwjFLkQ7kNvwGuzJ9b&_nc_oc=Admrhsp66ZfCx7hBt9Z11MlkdckolDRCaPx_TSLeNyZStO9WduttCeo6bFBsXL3nIhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0FJDo2htjdqJJtPuxPgOu2XeznWGLWeMtghXLZqCWrw&oe=699998D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEx2OaXMxgoQ7kNvwEEg8Qf&_nc_oc=Adknbjbx6nO6M_-XlHu6-GN7sChCIzYnCdKz0ikrn7h1mgONxtqdlF8Tf1EppQU13PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXgqjY1_2T5qn3XBAXU-W9tR8VI-cKKiDhvuxP7ETH8A&oe=69998F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dZy9jQFwmcQ7kNvwF4ujiw&_nc_oc=AdltVNKpSgs0x4h_yi0n242MsV1o4EQtzy_Z8OHJz34Fl4r4dN9bmSIx--0T3ghtn3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHtpwxa9iQZBF2SEZwy14c-UM1RTujr7FdllFtL2_zlg&oe=6999B89B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/terms", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "ex
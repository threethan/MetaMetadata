3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79c1BSUwugQ7kNvwFnmBxP&_nc_oc=Admmax7YiEz6cIz0IL6gziz3LGkXExYuLlY5QeBOW-LZiTcjFR7rG-NulSTwYr4syEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR84iO8SZV2sVWGluYIQz4NPH4-0m1TMaOp4Vx4OyA2w&oe=69A6C2D2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taaK982i-RIQ7kNvwH5LNrh&_nc_oc=AdkyKAbXy6oNisfa7AwjN_burgGTSql11E4p-jBcDtnW_3byqDJNaoTeXavKpPgh-T0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8Ypdh0XqI9O5eV72PwiY4YreQ5TmKy5TxmVXUBU9xMQ&oe=69A6E187"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N2921m5_-kQ7kNvwGvmbZU&_nc_oc=AdkrHCrj0rW0N9Jh2ODq9Q3WTYLA_orGlSC99iar71VyEbXwrTspbWAhpiRm7qVcbnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssWStK3cUNejxL2Dyk3GbCvIPkeGi4JcRbq7ed8omFFg&oe=69A6C7D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_hGJ0q7g7oQ7kNvwHdgJsb&_nc_oc=AdlI_tzR08eHdlj6NCBICjtqIYnDOr6r-91Em-_ezn6s9g_Or3ulh13kJYcZfnjOaEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDgDRzwY19v06vk0-viD5sbcHkB5xAdBwvaTP6z8AvRA&oe=69A6BE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBe-W-YmIIQ7kNvwECFtGM&_nc_oc=AdkhMgXsaUiHZZ07rhkAqnCXJ0vodICJJfPkcZxHCfiGKxFMhLhe_TILnHF8Lx9DRf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9TzHtxUyLHbYEVz3YRUrjRcGa6L5ZBrUOAy31lg-ygA&oe=69A6E79B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/terms", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "ex
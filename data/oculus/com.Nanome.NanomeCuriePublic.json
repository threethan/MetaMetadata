4", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro-Gunvk_xsQ7kNvwFu9EcR&_nc_oc=Adkp6Hvr549X6UnUGvhn07nNUsExdkRtGWa0OkBZvGIb9LjZ30IJKw-3hFu8NFKGlTM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftht2nZKsiTNUyU7R_V88jt5vsI_FBz1PVv-yB7NxSM0g&oe=69A17CD2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHOCPREAuXoQ7kNvwFzco4G&_nc_oc=AdnM24WCAXGsFIMoQAZbd4wP4HujkmWg_Ki-B04LXRABnkJkPPcFKqM3XW9ScP34FLA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvpj8pRDoQVr1rmo43xAS4qawa3N04C8cywjFoH5WuiiQ&oe=69A19B87"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atJufTqsMBwQ7kNvwEyC4_c&_nc_oc=Adn3EkFFFT2HaO9A7-03QcRPxxPdjs4cf2Wb7OAWnlD7H2sp90m9DvBIgenwrOr3vdI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvy5qJ8yqPJ7xpfx7SD07UNIjyuJ7xf-FcpVu4179YzKw&oe=69A181D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmEg8TjAs8Q7kNvwFXAFzr&_nc_oc=AdmaRgreroRHHiahCIi8evUbNCCj-OKOBWzL81WcV6DpneLU8-ciSfZ6u8FEIbdFmaM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsa_xeGJMknwcAFaHVVYa3PALVfyXqT-lJZ9AzGTcBEFQ&oe=69A17899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkDJwRJt5fYQ7kNvwGks_5K&_nc_oc=AdmY-Q8RaQU-J0pvtSG5oHzE8wcGfvtv0BClUIyztTMiFA-CJqqZQMdnAQ0GoLmMsGA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft2cv3ZWc26_Q9gqCTiAeZGIgS7Nnbn1bW6q5eH_KKnBw&oe=69A1A19B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id
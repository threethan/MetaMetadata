974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxa3OU019UgQ7kNvwGMboSz&_nc_oc=AdkJPTaxhdpLkHLmXckRZygcldl47YoyPnXYz02nkyW1Vx7QIb6kxDq3EOtgCYkO8CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjC74G1g95Fwkqp-55sJnm-YijUD8EhWhCd52wcq731w&oe=69A965D2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHtDv6IGfsoQ7kNvwENEANO&_nc_oc=AdlQF560gqkvWivlqUp1WgGbCCWh8YhalGItdH-tZ3C65YeHpT4KJjG5hZwIT7ozduE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvgRYYFwVhWlan2uvNkv8wsH3cPBj1CU7N164odysjkTQ&oe=69A98487"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N2921m5_-kQ7kNvwH-SQLA&_nc_oc=AdkhlYnGvCuMdyN8VraAmTNRTmxPBtYpl-clUm0bn8UOqL1EWF3nVpDj-M4kHaWtVwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvhjeg2WQRW_iiLToNB1Q26aOCZfUWO6SQ6ysgAMh3Q7Q&oe=69A96AD7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OURYMFem-z4Q7kNvwE4pMf0&_nc_oc=Adl6oednRH1QQ1hHe1qa72al8JWmZl_zn2yn8NJRlJUZM9AYoNJx46hLpUG_S8VEXys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftGo79U5BUx-Wpp0wTFyuGqTTTGqKWJTK_2FEiX6Vgo-g&oe=69A96199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBe-W-YmIIQ7kNvwHgX-nb&_nc_oc=Adln67mkgs1zovzmd2Bj_ZBEaeIxyqkETNc4FsaDevwMK_sgzXT2q3H4hOQX6dv5Ztk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuoX5x6kBEUtbedtD5-hUbXMjTCFjm14o4jS0VdTzdtkg&oe=69A98A9B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
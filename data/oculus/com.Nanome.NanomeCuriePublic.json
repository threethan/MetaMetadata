974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgqL_dA1LKwQ7kNvwHvZnUZ&_nc_oc=AdkURyNe_lsUFBaxtee5RI4xqez0YjMA76NC7y5puJQshcejr1Br8BVuS80wxpRnfmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLqv09LArWNHM3qLc2eXXl9jEbllCEFZq2BNCDaS_YCg&oe=69BE7DD2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSQg3SLu7YEQ7kNvwHh2j56&_nc_oc=AdkK-V9gaRfSMddcQFrGsTqe_vAmxewTy2sYBSefmheuffZso2Wi5R5YaRhCjw0MGSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw73Im68nILwpZM2Nbm1SLXLkPC8Wb8HhfMalGWgf0T1w&oe=69BE9C87"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtRF7xUbiAEQ7kNvwH2l8c8&_nc_oc=AdkBXTeja8Ks-m2LJOf83_TKBvmyzoHgF89TJfUOlL0hyH0FR45pkHpO43Ix9dEQGG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybNK4JM9LJKoczTEsc-gO7OTtgP_zd7mgyckT9isNE5w&oe=69BE82D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q1f1hspjDIQ7kNvwHvGNOl&_nc_oc=AdmWccWXimT3yCABD6zvgmaRx7heJeR94IUu_r9sqMWA9qIjU9mPyIu0efTdnv00TWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeL4brYNd8YoyqhZyAFyQ3LytzAV-35uhv1EF6zUWccA&oe=69BE7999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD_qsMrkqFUQ7kNvwHnoL5m&_nc_oc=AdnwNJFPRwj9p6bMfzNnGy7kO7GcLdkG4r6Ti6fGxFqDHkBMcStAqI6mbKZLguz5oUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWgtsgewP6n38yKm9rJMfbe3LA8fbJyjDTA_uCYZAFEg&oe=69BEA29B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
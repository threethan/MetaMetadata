4", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79c1BSUwugQ7kNvwEDZYQQ&_nc_oc=AdlsSgKEMGlmp0Phwsf_JyqefOLWJLhoPk-EtLp9CjZN-qNIrI7zwdNgHCC22Pe5wyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfutVISFtTnh3rQROSfHO1UFEMtbFILNn7nOKCwg4H6tKQ&oe=69A41FD2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taaK982i-RIQ7kNvwHWD_C2&_nc_oc=AdktD9qdIsmgASSMiuWm3KfmFeI2poDmz6OmKgBX4Mzy0Y7rA-uOgc0-XAosDyNcVX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsUyNrXNqjI1A1hGLMzknF7L46STxhJqmvoMAH9liUmFQ&oe=69A43E87"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdas0GL9BjUQ7kNvwEUcm1j&_nc_oc=Adlgc8M6t_HJtphdZix93mV8H91XczgNwcxX0alherlmlknbyatOcuuskuj8logY0HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsn7K7ldKz1p1VzB6PBrk4X2QR3oGv6BY8IQsfS-Nh74Q&oe=69A424D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmEg8TjAs8Q7kNvwHyPH8U&_nc_oc=AdmRdMVtY81m6DU4JJcvsSUzHYCmzJVkGDp-6dszO_a2SE5n0RN9_f_xELdervq_ZB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsBfYVf-1anW8l4rmpF4mji-Yu56MMbprqlWwKvy_QQJg&oe=69A453D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3_84zcvUUcQ7kNvwGBcFhl&_nc_oc=Adlqq3MstMCiGMlt-ua4Fj6HzJ_1j7h965pwtL15I1IaQz_8BC-KdT01J5fp1EhHnd0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftwlN_i7mjQ8eiIZ0K7v4kYNFm39T4-1mFUS_BZmDAn2w&oe=69A4449B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id
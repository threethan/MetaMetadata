974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQFFY8bQfMwQ7kNvwGIjcgW&_nc_oc=Adms6Z1gK7mpeMPFlvfYgzQqKxXWAQ3Za-z-dq2FmruHJQe2yFQ3K_9Y4_NgTj7SZgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyswMqDV02cRWwVAah2NduVXYWbO3VT0AizBWZ3DwJTw&oe=69AEABD2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwKybdhQqT4Q7kNvwHma0Kj&_nc_oc=AdmjJOCre1D3TP-D3gH7oi9jE9ZsZAy1_KXNxYyB4ch12AhqGObjiTpqkAFEM2P2OYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8acq3EqzchhmEwj7npxNevIfMPRlNAPr0Nl7eZISStw&oe=69AECA87"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1TNk2isZdAQ7kNvwFC0jhh&_nc_oc=AdnMvjyrOOP825ibHHj0b27l_rlr2tTzJFTAkEz9eiojc4b6oERN2fmB77B8f83nta4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWMNrGniGVvVd-PD6DGDyUTmmvpmYeSHR9IhIhoyd_3w&oe=69AEB0D7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYuiee3IVfQQ7kNvwFWypld&_nc_oc=AdmUvvT32Rs6dCxiOc4Pbf4pFofYGhZzXrffPAeLhLnLn_haOIBqi6Vp1izClb2GX9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrOV5AyIJ-fyhU5PI5RSkSlrY-EujuFbuhLEt7pEByvg&oe=69AEA799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKsritx3T0AQ7kNvwEss0Mx&_nc_oc=Adl1jdaTOr-YtRDezptBbbngpjiBZ_BCHVVLMI7TH3ywMX3oOrLhak-663CjDf_tnZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwmk9x4TnlW83B4PZ9PBa35wz_sTPhwrWsCEAxMel9ifA&oe=69AED09B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
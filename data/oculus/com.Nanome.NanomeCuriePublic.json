5-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY_wfQjXY-4Q7kNvwG2-WzY&_nc_oc=AdlsmeLO6zvHUT2XqU7z7hZutFgPBli7-FKNXnrjWjbvUZBD-n4NLtq0pMMHQsfetok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvjIW7R3zZcstBtGhzCFK89yG-j8U6p8wY2v5d19685YQ&oe=699AE552"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPuWLCwrGCcQ7kNvwG2TT7f&_nc_oc=Adm7h9HEEAsp2BPDAVF_1Z_LTYtYO6AZjjczyW_6h5vtTAIrTkXemjnX7QF25KUxyjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuP7h-5bbsZIFyUDMvelVqUnA0FQviIJv-Y3eOEKU7tbQ&oe=699B0407"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmZktHk9tHoQ7kNvwEGJtbh&_nc_oc=AdmjQIwTHLLC7Nhuh5h-jTLkOJ8EuAPeBgKZACULEOFwq7knU3Rh9b9aeJXGrruNZMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTAgqVgasq-ENTm8c-efJQ3ujPi0m7ZzScmCuqjz6aJw&oe=699AEA57"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEx2OaXMxgoQ7kNvwG7s8ev&_nc_oc=AdmYoqw1ygbO0lLQIbaFKFG0KP9Y_J5M22kiV6SLUvEncZdcJTknBlRTI7f8mJBuYP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4NXLYDT1FriuZerDiXQUh8eTuRDZcR8biBbV90Kj7Yg&oe=699AE119"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXvHZ_sXEosQ7kNvwHlSQAp&_nc_oc=AdmfERUUAUUAwadRH0mXNi5wKMY-VwaP7mtSNJix3N-V8REhXqy4pF9sdbuc2tGu-CQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfszKiZ5fpyPRZ7xfEDlRgHt4OkQXHS4dfXVHAlEg0BMJg&oe=699B0A1B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/terms", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "ex
oe=6A144D02"}, {"file_name": "38974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dqtpbvkYJUQ7kNvwHf2grf&_nc_oc=Adp2aCXxhXn2Nsn_fCuwp7IQa8b-GqmUlTQk8kowenU2GLEZegtxynyK-hkJ2BEabxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KuelpV0s_B3BuW8NZc-RCQFx8wacc6K07ySUiPyrNXg&oe=6A146792"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4dZ-_-XWmkQ7kNvwGfOnUX&_nc_oc=Adrriqu7hzuvmAgQ-FUtE_Osd-JTjyXOc81xmAbEkxcgDhXU3070AfFEUB75MoJm2ZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DMHYDlc5kY996hfjoGb7Ev4Xedok0p-0LXezOTXCA8g&oe=6A144E07"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-kAXPIwTosQ7kNvwErYkfM&_nc_oc=AdqFa6uBXpUW1h9Vqlm_c7eaKC7hsp5w5DB-O-WZNcA4M3oVYzvVCKMlbZ2oFFP3dlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i-Cm97OfDLsleEdcbNc3ZyU4i5s_cEIrRIXEsBs0utw&oe=6A146C97"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks7uKFGU3EkQ7kNvwHu8dVs&_nc_oc=AdoePHGH9i3Re7mP8P2N5YJA6CdNuBRKZ-6g7G0CA17wdExJpiBPCVU5z9rIJk98p0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qfMAe5Zz6_NSd0gDNLptqruQPQp76_a9KPSY49S6ohA&oe=6A146359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELcu21ywATgQ7kNvwExWFnO&_nc_oc=Adpn0rjf8b_1-zoqTEshtfFdtWTHbChrLPODeb9QYv19kTB96bRZgr5zMYebmnW3mhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aWLFzkFLoJhQ0uzR0-cePjiOi0e_FmEA5m_TrUn__bQ&oe=6A14541B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "6464101413693277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982640_523760319665111_3584164198869309747_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFZfQsWUf8EQ7kNvwFy9ylI&_nc_oc=AdoeUhg3JwhLYib6HZLXRRLMvHCpSMc3UGv0tOfBEgkoULqLnxpe6LJL7Wk89fbEEvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AHIT89MjlHctmn0QYh9vjr5AhErBtSrJkW7lVwxRlDw&oe=6A147136"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nanome AppLab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1615490085, "lastRevision": {"nodes": [{"id": "1386164121738162", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3077598929010226", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "438210556664794"}, "
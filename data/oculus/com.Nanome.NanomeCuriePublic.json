4", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro-Gunvk_xsQ7kNvwFUEeSE&_nc_oc=AdkV6kQGTO6Azp9U2FeCL0BuD0lTtpgG30HP2nufk5Lwno_j1tqtW0Tx4qxf5DEOjsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuDj9io62xmYwp1IUzkcGJ2m-TkJbYpyaZ2yRWdYOzvQ&oe=69A02B52"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHOCPREAuXoQ7kNvwEKwLi6&_nc_oc=AdkJpZ3UNcUsjpKZb-kW-K7b8ypK9qd95GUJwX9qeeybQknS7SfD6D9w8EW_-lVw8nA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afthp7zl0qvrIufwoBsjsUNVMVIwnBvzRZG63zOP8BCVQg&oe=69A04A07"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atJufTqsMBwQ7kNvwGay3NJ&_nc_oc=AdnbrHTOSudQ0Aotiz12WPMweMPQK4xRJFv9a8n8h6-UCXgm4k5NetpdjV2VmJ2Tk0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKgXQhQyfPpLFq0eObsJcEX033osIlC0sjY3I0qe-sfg&oe=69A03057"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96_zZohEV2AQ7kNvwGSQGUO&_nc_oc=AdnBKrD5xche9dKWWNN223p8NuT9PCivkh6XCbvNke6DVMmuhkVeR5BIGEZ8DbALpls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsW87kx8lbgTQTODKAhaiqKQ2s0ixRnn8qi5aamxRRfBg&oe=69A02719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkDJwRJt5fYQ7kNvwFZ7qhX&_nc_oc=AdkuB1o6H7aqy0EsdS9LcG-DwYY_j16en60x0bdyWcvayHEKPVuGr32Aw_hyr4VOfVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteXXD22NJtpqGNHyWc2KKJ0KAwpLgacLa-1KS8ZvBpmQ&oe=69A0501B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id
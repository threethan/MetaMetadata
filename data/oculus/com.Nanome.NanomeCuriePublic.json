974780_319715168680246_7435113333163819008_n.png", "id": "457448248758134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_457448252091467_1589982611613142413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgqL_dA1LKwQ7kNvwFVga26&_nc_oc=AdkDCPsKyr1VFo_QyN3VutBtq0Pksc_zOm4dkYHzck6iD3QBToeGeE0LL-2EGFOQ1jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwrYCmXmeNOV1rOcL2g1zXwmAYGpWzvmZ1aaTcdkYawg&oe=69BBDAD2"}, {"file_name": "38974865_371971200055542_7577817383964770304_n.png", "id": "3945223065496044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_3945223068829377_427371867794574959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSQg3SLu7YEQ7kNvwEh4o1S&_nc_oc=AdkNalgjxjVtaRBXfchUvRk25CQKFyqKVGfjhVh4I61Ld2m29khrMI92IIkSnW0P8io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIoKD7e_G48J9jsFaKGJ1mGDfPm_RF0DmW37lksTbBRw&oe=69BBF987"}, {"file_name": "39031611_519811271880688_7977073532301475840_n.png", "id": "276878813865129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_276878817198462_2194890393792401770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dqfr0dXbLnIQ7kNvwEF60_d&_nc_oc=Adlz08ECWVorQ4aX8c0sM0n42CTrmz1ZYXxSbLDo_tS1TjRSWfhFQ7RLdUS_a_ePOK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyB-SzINm5uxdvVUaUe8lgbc-JzroRQSGqlbbNwVbwl7g&oe=69BBDFD7"}, {"file_name": "38974505_254799885401780_413407507231277056_n.png", "id": "858208675013264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_858208678346597_8610615376986062604_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7p1mLCtsRYQ7kNvwHOuNDC&_nc_oc=Adm0od2yMsSqk07WQ56U6AT2IMPKhpAlwh9KbOAyHyDUvb8vHAUMGB1GPvRvBquuwiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdUan8EdiSHraYeDHFyXktIBxgkLRH61-EKE5I-xDjvA&oe=69BBD699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "431449088107326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001687_431449091440659_5707369122895378827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcTF8F7umnwQ7kNvwFPSc0-&_nc_oc=AdmZedn94sHag1_QAM1vutGUDOGOVJRJzFZxFwmjmPTGxtCY1I5eXDXM5qeJVCB_e7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxmMAXaizdOPKskAgNkVeNqMlbLd2M4HOUW-YImiEypA&oe=69BBFF9B"}, "display_name": "Nanome AppLab", "keywords": [], "long_description": "Nanome - Your Home for Nanoscale Design\nImagine a future where chemistry and the molecules are no longer difficult to understand. Nanome enables you to build your own molecular structures or explore the intricacies of a DNA strand or understand what medicine looks like at the molecular level. \nFeatures:\n\u2022Import molecular structures from RCSB Protein Databank, Pubchem and Drugbank.\n\u2022Manipulate molecular structures by literally reaching out and grabbing, rotating, or enlarging your molecule.\n\u2022See Atoms, Residues, Chains, or Proteins as Stick, Wire, Ball & Stick, or Van der Waals.\n\u2022Measure distance and angles between atoms.\n\u2022Mutate amino acids and cycle through rotamer conformations.\n\u2022Build with any element from the periodic table.\n\u2022Minimization simulations.\n\u2022Duplicate or Split any selected area of your structure to modify or export independently.\n\u2022Private & public multi-user support including 2D mode\nIn-app camera to capture and export images.", "short_description": "Manipulate chemicals and proteins with your hands, explore chemistry and molecules from a whole new perspective, collaborate with others, learn and create like never before.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nanome.ai/downloads/Nanome-Privacy.pdf", "developer_terms_of_service_url": "https://nanome.ai/terms", "publisher_name": "Nanome Inc.", "support_website_url": "https://nanome.ai/", "website_url": "https://nanome.ai/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
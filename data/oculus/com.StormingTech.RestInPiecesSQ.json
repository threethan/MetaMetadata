yJaIVPdBCTVuGA&oe=6B106557"}, {"file_name": "RIPQUEST_SH_5.png", "id": "442978300126077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462209_442978306792743_3736395449627464566_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPaHEOgboBgQ7kNvwGZPcRO&_nc_oc=Ado3Yy6OBEeZWJGinfewyz5SFG8T7ag6gpxsPB9n7MUtp1mSSTI8WWzkrmGzcM2XXrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-SjXgn55DLLLb9pQnCy0njEKxZYR4_h3LrJtE5ebFFA&oe=6B103A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "422496642363038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269160_422496645696371_1016278584632775295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95WePjRXlaYQ7kNvwFNseDk&_nc_oc=AdpitQHov_K3UXOtkjGI8syaWG8lSycZu7NfXsGz84WsgwiMbCQL_YFbvb651jj656U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFyMUtJDDJT100h-s2byiNozgKyitfKly7Xoxu37Xqhg&oe=6B103A6A"}, "display_name": "Rest In Pieces", "keywords": [], "long_description": "Life as we know doens\u2019t exist, hordes of undead and demons have emerged and now rule the earth. The human race was forced to live in underground shelters in order to survive. To take what used to be theirs, humanity gathered forces and established small specialised teams to eliminate the threat. This action was called Project Rest in Pieces, aka R.I.P .\n\nNow it\u2019s up to you, to save what remains...\n\nMAIN FEATURES\n\n- 20 Weapons to choose from and upgrade their stats and skins\n- Melee combat from knife to Katana\n- Customizable Locomotion and Dual Weapon Mechanics\n- Snap and Smooth Turning\n- Blood & Gore Dismemberments\n- 3 Mission type Levels + 3 Horde Levels for unlimited play\n- Multiplatform Global Scoreboards to compete with other players\n- 6 Specialized Perks to use in combat\n- 8 Agents to choose, with leveling system\n- 34 Avatars for prestige\n- PickUp items to boost your efficiency\n- Training level with Tutorial guidance\n- 5 Difficulty levels per Mission\n- AAA Quality Graphics and SFX", "short_description": "Welcome to Rest In Pieces , control AI driven Agents in the battle against hordes of demons. Show your skills on the battlefield and on Global Leaderboards in this singleplayer Horror Survival VR Shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.storming-tech.com/privacy-policy", "developer_terms_of_service_url": "http://www.storming-tech.com/eula", "publisher_name": "Storming Tech", "support_website_url": null, "website_url": "http://www.storming-tech.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1278186389348981"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1348974230523865"}, {"status": "PUBLISHED", "id": "1023268597202876"}, {"status": "PUBLISHED", "id": "2018404205441502"}, {"status": "PUBLISHED", "id": "3907869319522417"}, {"status": "PUBLISHED", "id": "1488411403027928"}, {"status": "PUBLISHED", "id": "1592322238659731"}, {"status": "PUBLISHED", "id": "912769541168512"}, {"status": "PUBLISHED", "id": "1415574480139514"}, {"status": "PUBLISHED", "id": "1207578867878928"}, {"status": "PUBLISHED", "id": "1147832653937122"}, {"status": "PUBLISHE
941995086035521_8804462788577604412_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHXYpcz96dsQ7kNvwFii9Ib&_nc_oc=AdoYfsdOPXstpoinwr6qlIwoqb7acmI8bhZxLibOIVcdKeL2r7xtWwnO2iALdeBFXNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ999q9nf5A39fRw8rXOECdUZKPuMXgEKPU4qVu0f8GCw&oe=6B0B2BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "422496642363038", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269160_422496645696371_1016278584632775295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPcekZkpKe8Q7kNvwERdCFt&_nc_oc=Adp3Pbb2M2y5ewkk55U7HGzDgEMe1ssQLCAUz0TL7YQ5bheJhT7F0n3QcIF61LefOVM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQM5xIFkNRqK-53__u7xZb-HYMz9NcfsudXvM922xIpuw&oe=6B0B2CAA"}, "display_name": "Rest In Pieces", "keywords": [], "long_description": "Life as we know doens\u2019t exist, hordes of undead and demons have emerged and now rule the earth. The human race was forced to live in underground shelters in order to survive. To take what used to be theirs, humanity gathered forces and established small specialised teams to eliminate the threat. This action was called Project Rest in Pieces, aka R.I.P .\n\nNow it\u2019s up to you, to save what remains...\n\nMAIN FEATURES\n\n- 20 Weapons to choose from and upgrade their stats and skins\n- Melee combat from knife to Katana\n- Customizable Locomotion and Dual Weapon Mechanics\n- Snap and Smooth Turning\n- Blood & Gore Dismemberments\n- 3 Mission type Levels + 3 Horde Levels for unlimited play\n- Multiplatform Global Scoreboards to compete with other players\n- 6 Specialized Perks to use in combat\n- 8 Agents to choose, with leveling system\n- 34 Avatars for prestige\n- PickUp items to boost your efficiency\n- Training level with Tutorial guidance\n- 5 Difficulty levels per Mission\n- AAA Quality Graphics and SFX", "short_description": "Welcome to Rest In Pieces , control AI driven Agents in the battle against hordes of demons. Show your skills on the battlefield and on Global Leaderboards in this singleplayer Horror Survival VR Shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stormingtech.wixsite.com/website/privacy-policy", "developer_terms_of_service_url": "https://stormingtech.wixsite.com/website/eula", "publisher_name": "Storming Tech", "support_website_url": null, "website_url": "https://stormingtech.wixsite.com/website", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7199236420139384"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75435286_1244115082649603_1137516809298081306_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gy9_-5dtkgQ7kNvwEU9tpy&_nc_oc=Adq75GF0-pvFGEmqhaQJeqC_QIy3vNLmfaq9vcOrvY8casaVOhe5iDvnd6VM4SRnGSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJ5EAbaNGWFTKevfVCtN4vkcaWspOTt1P2bYNxzddBIg&oe=6B0B3BBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rest In Pieces", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topic
R-w80r5YqprT6rzaVhV51v4Pvbq4DIVw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu0zg3roYxWlLtH5uPWQtbvRWUa0xfqsiiKbCirVTHCBQ&oe=69A190FB"}, {"file_name": "Screen_2.png", "id": "316108407255809", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75210886_316108410589142_4282773429336314561_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pNnRpfeIDcQ7kNvwFdqrxJ&_nc_oc=AdlGzi9SrMnHEy3JYXNmLeN-q6vUl5LZWXwxhrlBmoVJGa5ixvqMV1_B0hf9MFUPfXc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv2Gkh0gIuvm0cslSjoCh7AUVF-KxbemWWz82PbXUiWgg&oe=69A17A97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "328193905850922", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75540509_328193909184255_8316465121614427618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy_UK13wnAoQ7kNvwElstX4&_nc_oc=Adl90ESvelj16ybc9QqQLQ-ta22xqg5QKY-spkVb9lk3BUcW4XIMFHbND29Ha-Tfe8Y&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu9iGLS89KcyAmmq2Wls80Laos_GUNWA3cpIHjK0-Dltg&oe=69A1A2AB"}, "display_name": "Squadron One", "keywords": [], "long_description": "Squadron One is the free spaceship arcade dogfighting game designed for VR that you've been waiting for.\n\nJoin with friends or meet new friends at the command table. Collect power-ups and outwit your friends to win the crown and celebrate with fireworks.\n\nGame Modes\nMultiplayer deathmatch\nMissions\nPractice against AI\nBasic Training\nChill Mode\nYou can use manual controls or the controller thumbsticks.\n\nBuy ships or earn in-game credits by winning matches. There are two playable ships now and more are on the way. All ships are equally balanced.\n\nTired of battle? Chill out to relaxing music in Free Roam.\n\nNew features are added regularly. Come check it out!", "short_description": "Squadron One is the multiplayer arcade dogfighting space combat experience built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unitedcommand.com/p
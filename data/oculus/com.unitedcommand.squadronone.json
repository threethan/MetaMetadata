6_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dWA-UAmvhIQ7kNvwEYx2kV&_nc_oc=AdoVku1qhrlZ_OCeGYObKvlKgD6nsMUsStKBlwyw73L--zNRkHRy1bulcW9jiqxLRDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwT8PfmUCLXEDEjBS27TUllWlGWU_6Ut6A8yFcSHeb5A&oe=6A6B467B"}, {"file_name": "Screen_2.png", "id": "316108407255809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210886_316108410589142_4282773429336314561_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTwM883LkN8Q7kNvwGh2pMy&_nc_oc=AdpMpnb_3E7drILuXyNI9S6dmJflqr2LXvrkcoQbWMT7PjNOFHsj3LrMdEOAohyqRWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBZ2cLUmzNPteOCG2haRBID8UJh2JQJERfrmbmg2KPkg&oe=6A6B6857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "328193905850922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540509_328193909184255_8316465121614427618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvvxj85qgT0Q7kNvwG-AADE&_nc_oc=AdpChuYmVUZ39-zvKqdimgUl8yKjyi_i35pOzpSotVhD66LYg41FEHtZF8W2fDUHFb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYSB8pt_-fZFMXqLres5ACE8035JMW__MxE8vWF2_TvQ&oe=6A6B582B"}, "display_name": "Squadron One", "keywords": [], "long_description": "Squadron One is the free spaceship arcade dogfighting game designed for VR that you've been waiting for.\n\nJoin with friends or meet new friends at the command table. Collect power-ups and outwit your friends to win the crown and celebrate with fireworks.\n\nGame Modes\nMultiplayer deathmatch\nMissions\nPractice against AI\nBasic Training\nChill Mode\nYou can use manual controls or the controller thumbsticks.\n\nBuy ships or earn in-game credits by winning matches. There are two playable ships now and more are on the way. All ships are equally balanced.\n\nTired of battle? Chill out to relaxing music in Free Roam.\n\nNew features are added regularly. Come check it out!", "short_description": "Squadron One is the multiplayer arcade dogfighting space combat experience built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unitedcommand.com/privacy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "United Command", "support_website_url": null, "website_url": "https://unitedcommand.com/sq1/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "FIGHTING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34397482043176023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_377949777296854_3585128939970708233_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO1tTG3w_TgQ7kNvwHEt_1S&_nc_oc=AdoeS1yXto7GtrPB8jT6rrXDC94gvpHN5RAqQ7rDaIfxmZ9ND-EBSeM-3GDTdP_oJX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5EOeVLMx7n2s9VugZuy70DjVwGAzPFnl3ocRQf8dEqw&oe=6A6B41D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squadron One", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1627430299, "lastRevision": {"node
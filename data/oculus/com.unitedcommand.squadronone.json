6_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5-4IGiB-MEQ7kNvwHEpCEo&_nc_oc=AdoSKYkIFIpY6_X2dW4C1hktqEuGfNF1pTcyGsf5dxZsrbQx_cmHtnhW_0J6oyc7hpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tUKJczpjSiwnkNtz3z9H6cM2yCYprvW5Z-KUQGEAISw&oe=6A2020FB"}, {"file_name": "Screen_2.png", "id": "316108407255809", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210886_316108410589142_4282773429336314561_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REkjilqvgb4Q7kNvwEX90kP&_nc_oc=AdrOy_dhik0ZEp1IoKu_7p9B-86zlfzlLHogg1EBLKA35nLh9AjD7GsyxRzSw0EWsLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QtDnysxhTM4vLvHRbq-hQdjOPtWziUu83VFY3SCCVug&oe=6A2042D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "328193905850922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75540509_328193909184255_8316465121614427618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnbJCJ1Bvy8Q7kNvwFekWje&_nc_oc=AdqCedwhzRsHeQWWB3bXi71M4dyjUY1NCLlpF6IyMF72k5cjqDIqZuW7E_FXBca9cg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79nUPASWJ-yjg2s3mectVpEbHzdNlK8mZIHD4kocoUlg&oe=6A2032AB"}, "display_name": "Squadron One", "keywords": [], "long_description": "Squadron One is the free spaceship arcade dogfighting game designed for VR that you've been waiting for.\n\nJoin with friends or meet new friends at the command table. Collect power-ups and outwit your friends to win the crown and celebrate with fireworks.\n\nGame Modes\nMultiplayer deathmatch\nMissions\nPractice against AI\nBasic Training\nChill Mode\nYou can use manual controls or the controller thumbsticks.\n\nBuy ships or earn in-game credits by winning matches. There are two playable ships now and more are on the way. All ships are equally balanced.\n\nTired of battle? Chill out to relaxing music in Free Roam.\n\nNew features are added regularly. Come check it out!", "short_description": "Squadron One is the multiplayer arcade dogfighting space combat experience built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unitedcommand.com/privacy-vr.html", "developer_terms_of_service_url": null, "publisher_name": "United Command", "support_website_url": null, "website_url": "https://unitedcommand.com/sq1/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "FIGHTING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34397482043176023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630198_377949777296854_3585128939970708233_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYyxhL-F6OQQ7kNvwHqAo6k&_nc_oc=Adq8gdMiQAXUEqL5-7uZRpgaBqO5wez7PnRhZplNQadIbhdkFA5_xZB4vj-TJ_7Mkuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t7meJLJpgZDRR8FFqxZqkq063ObwDa55DZVYIxr4qXA&oe=6A201C53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squadron One", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1627430299, "lastRevision": {"node
v_NyPtDdqDR5EflwaAp7zpItUPAxSow0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPQkakwmUIzDf6AXaL_sxEgGuAYi9wXXVq01aL8mq3Ig&oe=699D9C7B"}, {"file_name": "Screen_2.png", "id": "316108407255809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210886_316108410589142_4282773429336314561_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQOSAVkHeQsQ7kNvwG2oS0E&_nc_oc=AdmqNE0uCzwbLhAMQQGgEXnZvq0u0vgSzSFnDTMjs64aD7ue7gBBkRgdLhKNN5y0Lxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-pwRNiXYJBYc-9EX3gNOfSECxt7GKV13DwB2X6lfx2Q&oe=699D8617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "328193905850922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540509_328193909184255_8316465121614427618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxiZ-TqJrU8Q7kNvwFdOiok&_nc_oc=Adk03otSlCo1ZkEQfKZHFWXS2_4eCzort_L5Pjuji1NVJNXs5merNlRkfjNuK27CPrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfhA13EpDnkFBokH6IUg1dQM4o08hhoRkkFFIIYM9wHw&oe=699DAE2B"}, "display_name": "Squadron One", "keywords": [], "long_description": "Squadron One is the free spaceship arcade dogfighting game designed for VR that you've been waiting for.\n\nJoin with friends or meet new friends at the command table. Collect power-ups and outwit your friends to win the crown and celebrate with fireworks.\n\nGame Modes\nMultiplayer deathmatch\nMissions\nPractice against AI\nBasic Training\nChill Mode\nYou can use manual controls or the controller thumbsticks.\n\nBuy ships or earn in-game credits by winning matches. There are two playable ships now and more are on the way. All ships are equally balanced.\n\nTired of battle? Chill out to relaxing music in Free Roam.\n\nNew features are added regularly. Come check it out!", "short_description": "Squadron One is the multiplayer arcade dogfighting space combat experience built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unitedcommand.com/p
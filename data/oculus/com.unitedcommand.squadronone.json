fnpi6h9lY1Foo8X8vhPTqUs87qLvSYEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3vX7D_vWUSz9ID8DW1DyBJY3xeTJFQFB8GAbOntnnSw&oe=699EEDFB"}, {"file_name": "Screen_2.png", "id": "316108407255809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210886_316108410589142_4282773429336314561_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQOSAVkHeQsQ7kNvwFswd3b&_nc_oc=AdnYOX98etoqBUxVU2Lkks3UEn1Zp9Aet9DSpgEiPNLUpUx3An9bTCn7_DWX1byxuhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsX8yeFb3KeidL0Ah0s-jHVSMjqHPzTx8PSil17DVrA5Q&oe=699ED797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "328193905850922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540509_328193909184255_8316465121614427618_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxiZ-TqJrU8Q7kNvwHBg0w8&_nc_oc=AdlzrNQ3utWV6DHSbJEPnvLbsHFDKMC9YlLHJkCIa8jYP8FhfltrOwDmiL828_sEg90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvfLI39kyxwkJM4S-SVRcMhRInrr0zaycLg5OVBpDIZ1g&oe=699EFFAB"}, "display_name": "Squadron One", "keywords": [], "long_description": "Squadron One is the free spaceship arcade dogfighting game designed for VR that you've been waiting for.\n\nJoin with friends or meet new friends at the command table. Collect power-ups and outwit your friends to win the crown and celebrate with fireworks.\n\nGame Modes\nMultiplayer deathmatch\nMissions\nPractice against AI\nBasic Training\nChill Mode\nYou can use manual controls or the controller thumbsticks.\n\nBuy ships or earn in-game credits by winning matches. There are two playable ships now and more are on the way. All ships are equally balanced.\n\nTired of battle? Chill out to relaxing music in Free Roam.\n\nNew features are added regularly. Come check it out!", "short_description": "Squadron One is the multiplayer arcade dogfighting space combat experience built for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unitedcommand.com/p
Hp5Mu0Q3KRwTRtSwgX4vBcw&oe=69A997A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1VnvbJoefoQ7kNvwGkzXtn&_nc_oc=AdnktcliJmyo2c9CqhUhHjFeaarF3R6KXEKnTfOumnU20VF_kQLCnvlRMxu62beeAww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEKvsWJGng2M-O4BSMBfeJxreRFAga0Bsp4Aos3p2MnA&oe=69A98424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7fWWmw0arwQ7kNvwEl4PY7&_nc_oc=AdneqRc8n_kNcuVsXY2U1cr4jC__n43gsrYJNU5e5KFCrTDnrQA53YYbmeYFZLeHOZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuI_k3PKfA--ha_HQN2QC0rkNg8Od18erUtVhDgEu0r6w&oe=69A98791"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio", "developer_privacy_policy_url": "https://lyravr.com/pr
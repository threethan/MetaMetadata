n.com&_nc_ss=7f20f&oh=00_Af9wk3xs-n17tUJAlKpv4ivrJJJuiTu3-6PZtatmnvBwbQ&oe=6A3FE2A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_CDOfs63cIQ7kNvwGQHMfl&_nc_oc=AdqI4RrexklNxsMQIeS2SbJk08mWSbgyTUzQX37MCjBP9tREEvB3dSMat2sHu4ZReog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pIzQYSFFGcacxEJK2LcrS-lsSGGRGLqo3M96Ip2PSDQ&oe=6A3FCF24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7UFjTEJRFsQ7kNvwGK3_1r&_nc_oc=Adr2WFClmCvwYTNfI1WD7xORPqmKRyahTRICqOcfLPXumsZMHS8IPoDsLSXIvYUzSLU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91WGKFgSfBxhxUSn6CWsWDNpHWtFsF0i5N2y65pAuxGg&oe=6A3FD291"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_AQFt-F60C5-PDbN5j8oj90AGamH8dWTakmaJDMEMzpzLPQ&oe=6A734D29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPSzRZ_EVC0Q7kNvwFvyfFi&_nc_oc=AdohKkjb61-AVLEWwhlzaHVaXJL3Evm15kSZlh1EAvjc2vfhVL_Nj4gw8VY3zoIWYkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4O4HZMfWfjwjMqSv9TiRFjFJWw_vrHB54pxlPs3Lm0g&oe=6A7339A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioWHr5yErSkQ7kNvwHsrl5_&_nc_oc=Ado29aGrM9fEkhScOBTbS16IVXPgqXR8_LiK3rSCzObiTdCCmxgoVZ-IC_QiHDvk4y8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaqcmCzRy4bxw8KZJwsbFCHpp-z7Gt2Oe9v9Y5WDRqPg&oe=6A733D11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7a30f&oh=00_Af0nfnL_CdYz-BDp09AHf9rNNgJVZG0efTEgN83_wTS6Xw&oe=69E0F6A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K80RCA7taoQ7kNvwG6z8hj&_nc_oc=Adp4A-vhluvExp5-C19_R9e3TcXqFg9pgJvyC9GqTbZKoLsNsqDwjR00URgyL1Pr5Bw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vYKero1iasn9FXLw17zxUJ-dqzTqW5sPQTKGYLUqrWw&oe=69E0E324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clkPFDtcHHMQ7kNvwGkX2-P&_nc_oc=AdqJbRvV-JnUBkrhFU6RIeU6zuZAcMgvyuoZJhy8IBe4cyg6ZOUt7HN8aU9s0dNyqKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jla9cwBYjJl-_lpIniDliLiyFcjyHUh8wiBFhEYENUg&oe=69E0E691"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
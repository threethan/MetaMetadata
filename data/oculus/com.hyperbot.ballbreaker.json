n.com&_nc_ss=7f20f&oh=00_AQAM2ANYLkSELDu_nv3x1-jb_S6NWpuUas0PajNA9_yUAw&oe=6A53A929"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwiTBLjXrUMQ7kNvwEnZmSS&_nc_oc=AdpsZaIxRKx5CMNhRoXskV_-_NVCGeYrCGPrxu0GFcknQ0-TrH-PqSsqMRs1EQDP1pU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgRDJFS5X3GblgLglk-tqTvLabDhiIIRSnT-zjfIqacA&oe=6A5395A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DbOXdLq4jAQ7kNvwGP81Kh&_nc_oc=Adr9qn8YzUcld7hwtyrQFzoIaCPWf-3jQcfB-xh-0MSXB7R4UIY0af7lxXWkTdaiFsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaj4i4JpNM_juNgT_Yw5DChZl8xSbrsOxNLB2_UPlVTw&oe=6A539911"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_AQP1M_zeHRWOUnqngcm9o9HSCHI0AkDMZLa4lTG1IeBe3w&oe=6ADCC529"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyjfdElCSEQQ7kNvwELmd08&_nc_oc=AdqNgk8s-4_QSVSYVwiqTdsUidunuFkBHGk-2hqHQgQgozAQV_c6HP1uFtgu87-yBR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxfxLyvKtjJu8cIaVp8Pv7IumjBnjpaHxRJW1iZ_8r1Q&oe=6ADCB1A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-Dr9RDbGcQ7kNvwHdvwwX&_nc_oc=Ado2Soda3eQZozY7L5b1DM2zXwjD1EX2yoG2j7lrshMY33XWpSh0dluWAHWIALl0Zg4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8iryGOuBd3EVYmXENY4XkI7e35MwaB7wzxcpOa0BULw&oe=6ADCB511"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
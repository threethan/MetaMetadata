n.com&_nc_ss=7f20f&oh=00_AQFoup-gm29tdrwkE7F7P75fXSmWlrfRAVHx87LL793nAg&oe=6A916769"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bT1xhiJ0TQQ7kNvwGvHMRv&_nc_oc=AdpUaHlRTRCW8VWMVe5jE7M-OHsDrPniTZPQbXdebtn6DJb06mPNwmQzZaQDbZVJTdc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmnBuutkB8BeevwM2nkVIO9S5e2NxemG5EFz6X_uuW5Q&oe=6A918C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ42PNiyqJQQ7kNvwHVeSyV&_nc_oc=AdpPagaZE3O1ZaxF-N4i4BKMdF-GKpbESO81KUcUgQbSFX4vNfill9HhDq1KuyRze-0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwnJDsZENB-T3w0lh1bZrk6WhkSJ3nY1GLpUI7Ghh28w&oe=6A918F91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
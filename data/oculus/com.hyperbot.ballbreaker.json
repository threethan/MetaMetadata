n.com&_nc_ss=7f20f&oh=00_AQMNSqFujbx_tZuUllBbpDzZNdE96orAKwx0GjFRw2uFKw&oe=6AD23929"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJL3Z5rFi1YQ7kNvwGpOPuQ&_nc_oc=AdpI1zndJ8pO6Fto7ACDpDam0AicmYkylLBucF4rs6U7pXqh01tg-YZotkJqBMaLAF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHVAA47REXukpPqvIJy7lMrJwbQ8uDC-jhnsLRYkA_zQ&oe=6AD225A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc5Us17DNnQQ7kNvwE-nSDr&_nc_oc=AdqREAqjMfOwh1Plz1v1DXdMsinfxB9b-cGq0tG4V4NooVaYtd6x_mlB7rdRYEiquUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJf2fH6OfMF2kibjDW6MuHhb8aiJdOZDL2ZtnRgrZ3Ag&oe=6AD22911"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
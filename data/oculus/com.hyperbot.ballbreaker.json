n.com&_nc_ss=7f20f&oh=00_Af6qwhBDyGB7hDKU6UNnGu_x0GQiuKG-XIEIzgrvPORxGA&oe=6A15B2A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUgxxDoNS7kQ7kNvwHk3oaJ&_nc_oc=AdqMqkaHMK3JjdV4HtEapNeJ2vWEHD4AQtmUUNIQdIkwgKv_hns0__ovP83CXheg2WM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hf-auooJOdZ4w3SEKX2f5CzYKLiwfaTir38V_Ri-5aA&oe=6A159F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywXKVVFlVpcQ7kNvwFninX0&_nc_oc=AdoAdgD1zgTtEFp-omQ_OcW2xyDIb-vIVCcbZX0Gg9oIgfiJ7TgJoe-Md-QDJNWXV_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r8NE6fTTGeFgqWZ_Xje9CHjPqxpwH-Zc-0T615R6UqA&oe=6A15A291"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_AQAXS_p5cPL5sduCVRwOL_5IkSo4w8seddDVRVayhGETSQ&oe=6A637B29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDFZY5XhcmYQ7kNvwHMiGgo&_nc_oc=AdrsHM0hxD3t-9SCdPiI00h6_Ht6U0DrfM7iXhAxeE41OXmLRA_-klUMSnOMZastDvY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuEcS-9lNjNrJS8esXrq9ysFEhYhc6h03kEOj4sGLZhA&oe=6A6367A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImPzUUr_wN8Q7kNvwHpctaz&_nc_oc=Adp0bRE5iC_l1syN49zLxD1PFtd0n7IDhI9vGKATsEsESpbwLGjdEKrxlzS3Wa7YOGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSmjyVVzFEDg0kif6aJHgrduuMkaCEpSdhgVWXJ-7wyQ&oe=6A636B11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
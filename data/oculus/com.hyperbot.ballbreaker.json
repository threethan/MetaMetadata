n.com&_nc_ss=7f20f&oh=00_Af6KANN_NPazvwIgAabv-TBYKjE0vkBq6FG4c6DNgDaIXg&oe=6A170429"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUgxxDoNS7kQ7kNvwH4rNEf&_nc_oc=AdojtKgsnanETNRZ5LwCBe_3aMjj36FcsBct8gUz5tu4zBsKRnseLa_PaoJqofEsmZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JMlkJ8CeVkALaNtuav-492LyK0kXcTcChYYsM5Ba-sg&oe=6A16F0A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BemnyjSB0J8Q7kNvwFhh-9S&_nc_oc=Adqs5mKR3k196Ik3kN71ZpcklVP9qSwvZAy8LBG0KxDNZj6XpOee0W37pdaKuQt8z2I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ghBH567PhZLk9EijGm9Tluks4Mg7R3bwslu_rT1NYUw&oe=6A16F411"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
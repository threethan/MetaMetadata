982565964_3525472919364829184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRFNmLcIpZMQ7kNvwHx329S&_nc_oc=AdlS26x1KZYCodRY0x6teGPo-DrNEKDwwg064h23NUlOeh9H1Mhj7vPbv6Bs_sbYOEg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz74GDra6GYbPsMw_TEgFIXo6_3dpviUsArIz_GvnFXpQ&oe=69AABEFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boba Pop", "keywords": ["casual", "bobapop", "indie", "brickbreaker", "simple"], "long_description": "Boba Pop is an addictive brick breaker inspired by the delicious Taiwanese sweet treats shaved ice and boba tea.\n\nPlay between two distinct immersive flavors, Mango and Chocolate, and shoot boba from a straw using your motion controller to break down progressively harder cubes of jelly with a satisfying pop!\n\nFeatures:\n-Your very own charming but silent assistant, Boba Bob\n-Random progression as you play to keep the action fresh\n-5 awesome power-ups\n-Global Leader-board\n-An assortment of Jelly Cubes", "short_description": "Boba Pop is an addictive brick breaker inspired by the delicious Taiwanese sweet treats shaved ice and boba tea."}]}, "developer_name": "Hyperbot Studio", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "LyraVR Inc.", "support_website_url": null, "website_url": "http://bobapopgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3072904412932194"}}]}, "scheduled_offers": {"count": 3
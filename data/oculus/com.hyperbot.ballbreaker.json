n.com&_nc_ss=7a30f&oh=00_AfzLS1kZr94s3t_aDQ0hmuj71d1Z7GBIa6i8iRx9GMe_6A&oe=69CBDEA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4y0mlVS8B4Q7kNvwFD_93-&_nc_oc=Ado1QYWdCP4j138A3FMKOeu5NhgVRBXdu_ENUOTyanfOmZJkxq91eaAfzyebWQ51VIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFeqPlq5msGvU6wcSffs41MtJeTQxlX9pFhF5w4UaYSw&oe=69CBCB24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcrd5xOhUVwQ7kNvwFyYW0K&_nc_oc=Adr-PbyeoeY8Uo5JGEQdTiVoQef-fYS3Ksj5R-yevE11VqGXu5cJSKwHnbgZa1b9F5Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypmrkiOZUG6NnCgfIdRIK3XfGJOiqejjRUPIP8_L_GNw&oe=69CBCE91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
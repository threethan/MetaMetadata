n.com&_nc_ss=7f20f&oh=00_Af3OLOb2eyyWhesNaBL_cor-LZfKOJn2G9hvzxWceSJz7w&oe=69F4BD29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DijkXTbMzAQ7kNvwF7hS8M&_nc_oc=Adrf_KNa8uWrH2jC-MA7gZ6PzVaa0HgL5cdZ8VG5WdERJq9TI5QaXdm7-uqtwvgk8WQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10db2jgu-rjVOdzXQyv6poBrWE1GqkW98WpVJR7bXVyg&oe=69F4A9A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VklMR0RI_qAQ7kNvwE3oerD&_nc_oc=Adoq159M8y0eOOZmGZcOudZR8_ubLil9C5sjRaQZz1Xdl93OUMwdiQVs9vRMDrNQCoQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XrNGBC4BlYLVjlbznF1B4-kZFDo5CNeWjJ6fEUuOKAg&oe=69F4AD11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
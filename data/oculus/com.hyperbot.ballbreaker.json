15", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974440_744876982565964_3525472919364829184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUQ-DfOMumYQ7kNvwH5Nq85&_nc_oc=AdotE388DE9FKZP_wTYGkbx2mMmWmY-yWRvu3FypmvxaGWkiou69FW0P-vRz8u-_v1Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRPlu0f_1_Ekkw8nChvwEyVz-oAO1RVQ0nrm0NjlWlCg&oe=69C3CB7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boba Pop", "keywords": ["casual", "bobapop", "indie", "brickbreaker", "simple"], "long_description": "Boba Pop is an addictive brick breaker inspired by the delicious Taiwanese sweet treats shaved ice and boba tea.\n\nPlay between two distinct immersive flavors, Mango and Chocolate, and shoot boba from a straw using your motion controller to break down progressively harder cubes of jelly with a satisfying pop!\n\nFeatures:\n-Your very own charming but silent assistant, Boba Bob\n-Random progression as you play to keep the action fresh\n-5 awesome power-ups\n-Global Leader-board\n-An assortment of Jelly Cubes", "short_description": "Boba Pop is an addictive brick breaker inspired by the delicious Taiwanese sweet treats shaved ice and boba tea."}]}, "developer_name": "Hyperbot Studio", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "LyraVR Inc.", "support_website_url": null, "website_url": "http://bobapopgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mo
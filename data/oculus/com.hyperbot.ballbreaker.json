n.com&_nc_ss=7f20f&oh=00_AQEb9_B750U2IbvYfWEiruCAsU5yap10P8vBAt2lfiaWoQ&oe=6A7741A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWDa0cZCPAYQ7kNvwFLXLZt&_nc_oc=AdrOcEd_f-lANw78jIm1AkeAy-chuudk54u0OFQP8OwipMsSId5jgfxIkfsBQuX6bj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCCS9wud_j5EwfPMC5yUcBwZn3JUgdXVauv8MkjYbntA&oe=6A772E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3VAoQbcz6gQ7kNvwHSErDR&_nc_oc=AdqFPvERCQukMI1j8JYY3qmUwZ_6-U6pMsrS8aPZFKaqvLnpmlwMlfuGa-pcYOK1KfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbdFW3NjJjSzWh97yqktxz3bdHKMD8XP-ObXorIzuBMQ&oe=6A773191"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_AQG5Ct5faJKkJHzV3K20DOBuWI9FoFJ3u_nCFEJ5O69skA&oe=6A8ACFE9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25BJZanP1vQQ7kNvwHLngZ1&_nc_oc=AdpAW3AU5MTCXvxtaTpTEKI9K_TISPUAMhqMOz11F05OUqUtCLajTJlpijJ8LCQ8UX8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM-FLu_zZnMm2eDb_pYTIA1O2SJ_iZa22B3CV7Kxt-ug&oe=6A8AF4A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLluxjuI8z4Q7kNvwH_gMLr&_nc_oc=AdpYY-SvoM5OKn1FCRPPLoOHlQs_bNwpztIRwcgSFrcaz322hzkcpNp-lbVKgr2sKeE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdbm-J0_SD8D_bBvqFGG_SuCRRMQSef9mb9lIFv7Wd5w&oe=6A8ABFD1"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
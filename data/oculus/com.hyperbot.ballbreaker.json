n.com&_nc_ss=7f20f&oh=00_AQTWC90WE1yiyGIfrKyiOKtV7juoZLMVZEM8_MXQpH4c_w&oe=6AF1DD29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU32i3l7el0Q7kNvwEwsmat&_nc_oc=Adp1x3VaktmRxbC0NsEAtlGioJYSUOXpA7wF50t3oZ-d6gPVZ11VzkDTOY7x31rP2ZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuFcUMNOWTB-NzFnbPAWlTbekkRxOdObpeUCgT6kz_Lw&oe=6AF201E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RztNOWrdMYsQ7kNvwFJ4xFY&_nc_oc=AdretRlcdAKfc-U5cJHGDTMqKu4D2ETQ19bv8M9H_6x-vZ3CN_ehywyVEoCHllchHCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoxq7rW9O21NYWWdt7vaW3OTomxYInCKw2xOSzeLEkeg&oe=6AF20551"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
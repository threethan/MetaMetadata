n.com&_nc_ss=7f20f&oh=00_AQNWO50GPjJu9wDY9FXg_iZOWaWegsaWBVuQIMgICtzong&oe=6AE35CA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg6UBQaZi98Q7kNvwEUm4wf&_nc_oc=Adp9TZHcQ1m454jHRd3Wl1yfPLIWSCG4bU9YB9kzR_AZCmM_caOcV0fMxIefrP3qN_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmBWXqfk6HVWmMGVb0_ccr5gxs8fngfyesvYCYLMwbw&oe=6AE34924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBXP1snS7gEQ7kNvwGcnaQ1&_nc_oc=AdpT99lltc3DVX-7P_z3codCp8L0LEplEKH5JubcPvfVKD-8qCiMaxS8TODImwc0fAE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVCVbJo5EGa61TucEaM-msNacVvvFA5nMmZBCvzbfbzA&oe=6AE34C91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
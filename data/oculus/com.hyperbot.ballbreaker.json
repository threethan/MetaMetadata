n.com&_nc_ss=7f20f&oh=00_AQEwDiV7k_zLX-o4Ah6mNG_Qq-9YZZQn_pfpA83xOPjdkg&oe=6A9015E9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bT1xhiJ0TQQ7kNvwE-2eY2&_nc_oc=Adrv_1z3hx_YY5JhJUfJl-3Ql20DlyCtm94o-UJLPpv0hTBFwkTh1FdK42NDwMuV5_8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG74tlHXROxgQxEFG2YYzSwVK_h1amYBIS1Ef9-XKdhrg&oe=6A903AA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK62HYoTQEQQ7kNvwGzR7t2&_nc_oc=Adqe0afFpGqGQoNYi9F6veyLKGsGk6dx1of7AaL7DFC9jKofSqOPjtk7-dn0ojZNPjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyFvgpU3T7w-YgKp0QnBvn7cd0GH8oB8Dk7GQsi49wgA&oe=6A903E11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
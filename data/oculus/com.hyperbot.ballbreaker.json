n.com&_nc_ss=7f20f&oh=00_AQL94aDeKABVeNL1PuSCFHnHy3pL-92TtGXLzqrdQn6aLQ&oe=6AA80929"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX0piWmcG60Q7kNvwFsBamj&_nc_oc=AdqsAFa03zx3w0jBDUb8qKJt4qeDe7QgIn0RS7RdZOR46nKgi7temV3Lh0beiJh5WU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIRPfI_HjZIsnv8cjavyBNkPVeChvxf4kkQ1DU11HcOw&oe=6AA7F5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCnMiKT_g1AQ7kNvwGtSsss&_nc_oc=Adp_6MWxeiPgy2KsO1kXs5Hu9Y9S28HrI7QQ8Xudy3nRh5g17SN869fS3tcXg8mDWKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoUJstWp-PcISUSz42o3bUVcNuIaS7YSB_ve7i1iHytQ&oe=6AA7F911"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
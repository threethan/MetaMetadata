n.com&_nc_ss=7f20f&oh=00_AQF6P_3i3IdaxZwZIJIy-9tKXD1JqNLVlcy7j3vBxLTCcg&oe=6A7F2AA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODqlKCC8GNUQ7kNvwGtDK8s&_nc_oc=AdoEQvQcPsehNAZo__U66t53EC3EUAjm56moCFzA6scejxMxhd7ZUVa39VJK4amFsK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxMQ-2N9NvawXBEnRVIe7Dz4P_zBeA03MgmO-GQXz7Cg&oe=6A7F1724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpBAUPDrtHcQ7kNvwGW0sM9&_nc_oc=AdqV1M2VZ8lCJiQJ3Ma8VI3DhATvrapRF355QoXs0tBjFocxFLehVwQydVE7JQsePxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERbOmuomdvo5vStILcWM_Un96NZmKfdm3QSkbLGlqkSA&oe=6A7F1A91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
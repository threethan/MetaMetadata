wpdHRR0DOVrRmaE58RugUwA&oe=69C11A69"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXCSY6ipUB0Q7kNvwGxQp4F&_nc_oc=AdrTNV539dZbSShcvPZWwqL1rw5kuFG8h7veyvqfXxuqFSULgaMlUzQFOQ53LrXIIDY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzINRPUuuGLLuudxs-JzoOxlLZ-D8xhatfdfs8BpFbAqA&oe=69C13F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eU8z71FbS0Q7kNvwHBN2W2&_nc_oc=AdoWqUBsslhuywPr-CEkcihY6i3IkUdKXaOJZmco-wi_DPGMMqHGo0XAf2qj3usxT5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiR2yQ20eQI4Qix_Q6jX3gFMLxBhAwgLL8ZqyHl9AmTA&oe=69C14291"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio", "developer_privacy_policy_url": "https://lyravr.com/pr
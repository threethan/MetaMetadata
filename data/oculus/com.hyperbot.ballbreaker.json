n.com&_nc_ss=7f20f&oh=00_AQC2w3AAgWqIX--ZE3rg6atWz1RvtQfDy4MvhsZD5p1iaA&oe=6A4A6EA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vs6zkgJC0MQQ7kNvwHeyhhD&_nc_oc=AdpkbF7rggNcTnDEs1USMG1T56VdBTUmNAzdoXavR5_SPIzuQQpLv351ZVgj9SE9zj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJu75jw_zEhIhOJg7Tnnxv0S0SqshCZXjcAGkSQEmXQA&oe=6A4A5B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgy__8iN0O8Q7kNvwExFhmV&_nc_oc=AdqqsITVa0YY_aBTtlflB5TGPzatP4GArsE3Yu9g5gM9-lgSqNQb8KtxTnE-7wUL_G4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb-0ZQBB_lV96PXv5ZMzez07SeXLmQX1IUDoOz6JzjMA&oe=6A4A5E91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_Af9dDFPm41Giz5IYEKO_xqCU4Ahv99_UK1CroLjStBCMqQ&oe=6A2827A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnr8il5gP6gQ7kNvwGjBZmm&_nc_oc=AdoSHiv8FKYEkX0EN6McyHMVG7Q0sIFsjj9iATY1m6-Lmjdgn3UItlMVzvRyPAvYD9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tPWJMiXm3jOaJRMZ8GiZLq_GUNE9z8lL6c05Z-PYTtQ&oe=6A281424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqhCCXvsWe8Q7kNvwFHD7Gt&_nc_oc=Adp3DvOyRa7hpwoMP117ptiaTAea-36W4U9lwMLF-UAmiaP62AOIx2nv1WvEToe9K3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WzEmHswUKnA03wAszvUcDuxfGCH5ykw8ktvbVYyVbaw&oe=6A281791"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
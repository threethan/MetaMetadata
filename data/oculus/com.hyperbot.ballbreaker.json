n.com&_nc_ss=7a30f&oh=00_Af0x2W9BXr0pqhELFyeA60OpukYCpnVmy9dUsDUpeTZsuQ&oe=69E399A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K80RCA7taoQ7kNvwE9e2iN&_nc_oc=AdpqwspYRFzFQTqPMVGx9dD2za2A3lqiavA9Ypv7K6ukQTog_Ah4Z7Kbgni0lQNdc5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HC018JoLXkYw8dMogSm0TEINduBNfKQwmHjrNotTFuA&oe=69E38624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMLMpd4oz4AQ7kNvwGS-K6W&_nc_oc=AdrwRER6mcI-BNLj9mzuEBB8ZZtm-ckDPhrJPktdonZVRduscwFjYqdLwuXvobddKuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19Tyro9Rua9Zbhe8yLzi9nxXbAiPu7yJMh7nCpG5-4zg&oe=69E38991"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
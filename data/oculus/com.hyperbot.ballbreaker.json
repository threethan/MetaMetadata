n.com&_nc_ss=7f20f&oh=00_AQOpr2fYvRhrcDlSKyEjM7gOBR5e76cV5YqyjRLmzLV4fg&oe=6AE0B9A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4BNyyc4p0MQ7kNvwEY4beJ&_nc_oc=AdrxoW6rUeX1aU6zvOouJPP-6uX4N-txj_sJMHXUXS9lAI6Sr1UtxuR1taUaiLtpN2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7io852hZqCeq7LuZ5UNVVExYsNcXVl1qa106CsJ0JQw&oe=6AE0A624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBXP1snS7gEQ7kNvwFw0QXF&_nc_oc=Ado11EtWDgqT2okGWr6x7TYRcllqWcNpsimAKbvGQqDwhYLRoJ6SoD-0HA0WUMbl1CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBOT892V9eKeu4WINbNPhDUajKj21sH8qhxtVgesgHiQ&oe=6AE0A991"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
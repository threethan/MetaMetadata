n.com&_nc_ss=7f20f&oh=00_AQGe-Ynvk1wZOe1GUvxxKE7MjmVvWtXodnWb6u8R9Si1UA&oe=6A882CE9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utuXxUbec18Q7kNvwG9ziVM&_nc_oc=Ado_mhvnIkd_U837pjXUCGEme6gIgWmiUhpDHGRFte7H9edlWHxu2DJmkz9YnXEp4MU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGardvoDJUnKexo1cG_yAV1sV7VxEDb7MFd2UDNZAQEwQ&oe=6A8851A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHSqS99QECoQ7kNvwGKSYCH&_nc_oc=AdowQlocAmc23cWvACB5yLftxpq9e08OK8sv8nou2xX7v7yDDyucWcp2YShEDy4W70M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6TVoWK5sv1Ddq3dHwpTPc5KMjAafOOgqx3BIqB8c_5Q&oe=6A881CD1"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
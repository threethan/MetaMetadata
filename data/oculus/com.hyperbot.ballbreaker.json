n.com&_nc_ss=7f20f&oh=00_AQMDJ3yE-QL55lVE0W7uS6JBqtDFyckKgfiggQAfJIb0sw&oe=6AE5FFA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48jax3zNqEkQ7kNvwE4wfjR&_nc_oc=AdpXRGiu2nh0Nplzgroel1kffIm40-_PWhY9r09cOKlMWS_dR1EiWZ69Osw_37usMjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPChKwMTHDHo_bqZ0cGNOL4Eq5gWU7VsVmxVMyqpThDrA&oe=6AE5EC24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcflpeowZeIQ7kNvwFXqztb&_nc_oc=AdpyNyZRbGTC-fCkEa_J4uId4EgWiV7bWocSceSGuXmcNnhXHNfTL_NdoMIK17e0jxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfWZR-fsPeakjCHi4DLckBfaX5RyAxObP2k4tWGXCmTA&oe=6AE5EF91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
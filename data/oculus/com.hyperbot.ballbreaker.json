n.com&_nc_ss=7f20f&oh=00_Af32wHnvuKKqyUxWtfqD8AdS7gfAYPXPqwn6p6zlow9XOw&oe=69F60EA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DijkXTbMzAQ7kNvwF56thC&_nc_oc=Adph9w7zj82RPotE0G4D2hXkB0F9TpWZHfreqkU0HW1S8pwUzRx_3hLXt1cccqpfv7Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hs1zj-VpOsF84LwW8ysU0R3a8Ynow9bqEXOl3l3CIQA&oe=69F5FB24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VklMR0RI_qAQ7kNvwFYRnW8&_nc_oc=Adq4VD1irbMY-5ywqbLAqzJDZjDbAJpTe35aJELAlM-zfUXeTRG3FLILcK5tAUUxAXk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23tu57I054fz5NRNvywYj7iMEwsgXwIq-7nAM6tezCcg&oe=69F5FE91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7a30f&oh=00_Afws7jZwm5fB1g8lnE2EkBPvHEUv6yIRzKDesKRFnNJv-g&oe=69CA8D29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4y0mlVS8B4Q7kNvwHi2XVg&_nc_oc=AdpcbXhUJimJ47Pw4Q2WIz4SPMXNgLRgER1tI1infDM3WNfxb82K0AkqLRIVUTiAZec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCJgNiYfX6X_IHVBPbgedZcr9opEgDutW34bCHHWkdAA&oe=69CA79A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vc1zqYhnsUQ7kNvwFSUNRm&_nc_oc=AdqRPbi_0L5lAL0QJ51TgBCvHHjmroh3kgJhaGeJ_k-LsXBzVljC4M2W5RcWCHKjAas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUdiH0aSyMeXUXl6ExAqzAX3sIOm5NereN99bTxRS7Ag&oe=69CA7D11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7a30f&oh=00_Af0XAOp9_Lyp2JtWVxAs1LjpiZL35WRnw7WOP_WFKC97XA&oe=69EE25A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5kWA1O1kgMQ7kNvwF81bcD&_nc_oc=AdrcK4UKlPsXgfIPFHNc_7UHLvXdZgvLEDCiR-uv78XYX4j0pFQdJi9CMnmeJO3Oi8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PFw4RstaKMe_gqqiACTA8Sya9r4RpSAym9-IYEwmzIw&oe=69EE1224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H87thny_hY8Q7kNvwE52D4m&_nc_oc=Ado7qH7VUcxf4IWLL3FN0XrcINpJwNl9wBVDCOtHcvbYciLEezLjEhbzaa0mfIJKgjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NwokP-K6ogkSXmEQCwlKah_Th9YcuoYGAqtIsINk0Xg&oe=69EE1591"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
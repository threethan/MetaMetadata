n.com&_nc_ss=7f20f&oh=00_AQFCGyjxJ_gTVmEFgERJYYyap3CfLE0qkpQAxlkwM3PHuA&oe=6A897E69"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utuXxUbec18Q7kNvwHy46oG&_nc_oc=AdrspK_ve6upXSkZz0DmPK4l10LnOseQPQYmtsN2ht9D6KjKA-AlAN3Jxbh8dv-fqwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR_sBKwV2vu0NRQajyhFQ0ktwvHZi4WdwEuNTb4cxTvA&oe=6A89A324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLluxjuI8z4Q7kNvwHYdbhH&_nc_oc=AdoObZLGe1GooQQIdELZ_tj0EhsGnplh2HlB00Gr34cU4TsH9nHKqeWjInc-OCgrPe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwIfDg1GJGBIBxr_FjwOz-arGoDWxm-5Ila3UgXnTdUA&oe=6A89A691"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
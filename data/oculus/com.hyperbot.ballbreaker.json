-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYqQliA5mGKVM-zPOCcti7O0-kXo2QKZwnQtr7twuvkA&oe=6A8EC469"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bT1xhiJ0TQQ7kNvwES9ks5&_nc_oc=AdqWuaG6NKQeHAHUvpi8te0COLFarIGUym1UYK4BZ3JLkVxdFwbamPHNtlIM9VAhHIM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNl7wxX76BmTx-CvxPumCnJjApuKmUpNjSEAYpNLk8jQ&oe=6A8EE924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK62HYoTQEQQ7kNvwGN9lqt&_nc_oc=AdpWRY_MDZDtC8xKcDhLd0z9hbdvi8FloY5QQI6X69rEgrKILu4QMyoyeEmkuxmAsn0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHgnhMHP7TQsY6WyJHWnADsKlME96lbqHqmZ9C80UdkA&oe=6A8EEC91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name":
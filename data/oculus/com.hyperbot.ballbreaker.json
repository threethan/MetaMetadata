n.com&_nc_ss=7f20f&oh=00_AQDK5-4WPQNMV9CdpOjjebFP3aW7iqzSIm8BqYOAN9yVNQ&oe=6A510629"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M0Hwd5hpHAQ7kNvwErCQXC&_nc_oc=AdquON5vO_3T7dFbVJYCxb279QbPWfadtJDhlB4EmDcd1L77qNRFBuzPD8FEOpfm8-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGzFtmsIiuZ4tE6NUU7p490Bcgu6e4-4fgj2ueDguwUQ&oe=6A50F2A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEaSiWYlLs4Q7kNvwHrDSwz&_nc_oc=Ado1ohsm-xWpNHcjdtXvwGkwI1ICsKrTk-pzfEtK6tv0a6cAO-uzMJfUiUEeUSPo7Ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiB8hUVeQz6i-N1c488AxZ698lQBXxmnOdP2lTvoiNdA&oe=6A50F611"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_Af32tjoGROrYRrbPBqH6frEoYeEs2KHxkcAaMrDUj1iVaA&oe=69EF7729"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5kWA1O1kgMQ7kNvwHPhbu7&_nc_oc=AdorA2fEr3oajHInXioOG-LnDtpp3tqxwaEdL5-Qc2m-8mx9-oXKEclcMHPCyK9NzRM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c2R50jA5SuKH0JxHvPC1_fLQhCUb_aNd-33qBrw8ynQ&oe=69EF63A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaMoR8NhQgkQ7kNvwFUXDs3&_nc_oc=AdodhZhZnSiaEv6tWASOErYMGZ9a9rhExhM2H4HFyVRZ7-uIX-0191BARuHp5XrP6Qo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t5Qdobz22W7cwcdGJNPl9uFj1DnytkdCoCRnMAvlQmQ&oe=69EF6711"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
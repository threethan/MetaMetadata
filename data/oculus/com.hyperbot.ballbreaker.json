n.com&_nc_ss=7a30f&oh=00_Af2RKgTZQin3ag0NcBlu8iw1I2KR-GFE1Gdt_XTuzhZqyQ&oe=69D3C7A9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfvcitlI3BUQ7kNvwE0bDXM&_nc_oc=AdoZ-vbyrmvKsWeaV-RE8cXmMUceDaEoxJjdhugYw2s6PFJRDrnD13uvWm04CDgFqng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A9lySwkjLSc5V8DG22grF0kZYT6O3rkct506EfyBXpw&oe=69D3B424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea1llPWi_I4Q7kNvwHjLFoM&_nc_oc=AdoOLcOGKRJyUCBmT_vrUmPJpl4l4yVOu_so1rykii1-j33YeTIUnhQq9NGewuqv4go&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21xMTIESxZwIMxBGtWdcX4nfnWZxZU94201foAF1zdCw&oe=69D3B791"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
n.com&_nc_ss=7f20f&oh=00_AQLsfvnRAZ7AxAtw0X19Tf0MoqXILAzR3SvKIynv3H9_MQ&oe=6A9ADA29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRLzmFTOUCIQ7kNvwE7lPI6&_nc_oc=Ado_yC9q0YWWPWtCRtKO2-RJtNyLTJvCnbLAXAprQ6Im0McefySBOybpl01YEuhflvM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOwcfS3zacJgkwXH_g5-tMfpli5q1_3nezAa2aAVoiDQ&oe=6A9AC6A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3r4MdKqmu4Q7kNvwFwHRRl&_nc_oc=Adr75KsEOpOHmvfRcR0oeIJ-K_Ta9Pzpso6OKdEvRVqF9Sv1AfIKmNhnknNJSLWRRZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo5yuRoHWpaPcOFYxYxKSappIHBHHguq3n0KaAvI7H_g&oe=6A9ACA11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
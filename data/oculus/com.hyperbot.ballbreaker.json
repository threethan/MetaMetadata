n.com&_nc_ss=7f20f&oh=00_AQS4sn-YRBUWEDV9HNxQRNvZLtloBLk721paTJO0497H_Q&oe=6AF32EA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU32i3l7el0Q7kNvwHl1yrY&_nc_oc=AdrYkpLkCY1egzg1iNo0BkTBDrmroTpTnwhIvgsmAXMimeWce3RZgd9HWl9SsvxZiV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdhxCz9s7JhNJHkZeswUM-gEcti7pNyMu5QjINrFsF9Q&oe=6AF35364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RztNOWrdMYsQ7kNvwGO4HLj&_nc_oc=Ado_oTrZlyny0payHVkWnm6f8N8q13qdidZRPhbgSbYfNRJH5l31TQAfRpGL131Cm9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJa_GxH5l4cR-HePYIg5cF9dRTSAub3lfBiNpAJijY4A&oe=6AF356D1"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
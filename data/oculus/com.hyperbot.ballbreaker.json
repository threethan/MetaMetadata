mI9REftHWbLlo0YWyUa6qog&oe=69BC0CA9"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wvZa5wkKOMQ7kNvwH552fP&_nc_oc=Adlgc5QccbCoqcgJ09PZCFD9NTydq15nJoaIMj0buBhklSd7UKa60NqnecDK8b0Ia-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwq-nqTFx0ctpSzSV16p6gMT4N97KoHqHbDaQwXSuzuqg&oe=69BBF924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2o9m7BKKdcQ7kNvwEyGQ9a&_nc_oc=AdmVWy7Q2_-0mDMcFAtqnCpFcCX221i4g4Pz-gqoEToBBbBoZpq5WoEFLJm3iWkzktU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwtjSe4Cp4FqAVhV6j_B2yWvK34T1QB-KVlZvL2BIsLzg&oe=69BBFC91"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio", "developer_privacy_policy_url": "https://lyravr.com/pr
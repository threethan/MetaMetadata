n.com&_nc_ss=7f20f&oh=00_AQEHMeln1kQTI-oImwWWfXV224Qu_8N-SvBbhluCM_4MKQ&oe=6A86DB69"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utuXxUbec18Q7kNvwFjNwMc&_nc_oc=AdqWMn6NVbUTDuw7HWszoh2rA6FVpEK9dgEc2Hi9DjPXLh3_xOEcx1am2O0ja4lx9dc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldu_c4A5l-OSEy8PnTEqB7gwa0zhDQkSGzgXRY6c6nw&oe=6A870024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHSqS99QECoQ7kNvwGLLkiL&_nc_oc=Adql4XvokrCE592cP0zceSKbbvBQkcL-vzpv_c4pWkETjlaV97H-W_aC4EIrHJjXWl0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsFyme8m6JizQuooSVOT0oaUQyvNAkug5h4AbLkVMItA&oe=6A870391"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
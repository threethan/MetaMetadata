n.com&_nc_ss=7f20f&oh=00_AQJi-LPKK-wSqUID20VpipgNrkc-bR03LGMTrJHyqqMe0Q&oe=6AAAAC29"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsW3for6wq4Q7kNvwHbYDNG&_nc_oc=AdqdcVUYiP7jQGDi-OT3mXuxmOvT9re9lEYPLS9GDJgBq7eb7HpZaH8-5JsPmKX0kEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw4CArWfIOkLT0uAS_ULESvgqhF7ij72NoeQDxlL56lg&oe=6AAA98A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJcUp6T-pD8Q7kNvwEXtPEl&_nc_oc=AdovTpBnZ1U1d6aqsZRwGVXCwF2MRUdJkyuOed_jW83IWUOXe9_shDIr3fkdAyo_4_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWnYLEjLNnHIdGd3DbD5H70IBrF1ASMk5X5YdHjUSbCw&oe=6AAA9C11"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
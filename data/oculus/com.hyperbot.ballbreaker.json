n.com&_nc_ss=7f20f&oh=00_AQFc9svKPwzYwT3-67PpQrcK1cl7qD_u3h3IMjqcxc_aaA&oe=6A843869"}, {"file_name": "boba-pop-screenshot-005.png", "id": "683176026731094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974622_683176030064427_8438804740268394615_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0rjTOX9tjEQ7kNvwHmuDZo&_nc_oc=Adqygx1lgjoDBvRfMaxvNMA1aFIBecnCuBgas94fnxky7eyIHSdkq5Vz3Qe8wKUJlZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcfL8cys5-PEivpaxCWYNZ_nGBoxx_rbbGqhB1gNjlog&oe=6A845D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boba-pop-landscape.png", "id": "159615030525044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_159615033858377_1754774821685852298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhwlB5jUDbwQ7kNvwG2OfAX&_nc_oc=AdpjhhJSwqeKy3qj10COC5n8FBWfiuRsMvQn5KlkIA286LSEyKgrdULd3JGisDoXBu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhQxojpnw3igXFdjpVgSJWS00FGS1Ej-QrgD6a4eev3A&oe=6A846091"}, "display_name": "Boba Pop", "keywords": [], "long_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!\n\nFeatures:\n- Easy to pick up and hours of fun!\n- Compete for high score on the global and friends leaderboards\n- See how long you can last in endless levels!\n- Discover all of the awesome power-ups\n- Play distinct levels inspired by Taiwanese boba tea and shaved ice\n- Cute original art and catchy music", "short_description": "Boba Pop is the juiciest jelly poppin' VR game! Aim your straw and bounce boba balls to burst the jelly cubes. Find the angle that hits the sweet spot, pop power-ups for explosive chain reactions, but whatever you do, clear the jellies before they overwhelm you!"}]}, "developer_name": "HyperBot Studio"
kNvwEtzq3T&_nc_oc=Adp01eCnhC17IeSuxnLNfXlHM8GBKECQ3I18osCc3KOE9sIqUaiKTqNQPij5ZVMmFng&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcsGDp94imraJRriD1dh1yGIvlBJ9QHa27SLTeZvksNQ&oe=6AFB28F7"}, {"file_name": "screenshot-4-chase.png", "id": "1450789486987500", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1450789490320833_6096854100104812169_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9HcyjxZ_R0Q7kNvwGWcxpt&_nc_oc=AdrKAXcHwRa60QZbrBwYzDvXS2SmiDhwt9DTkuUeaZ5ANVRzg5ZiXaEgEn2_2e9m01g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlDYj5_cwQrNoDl3Bjv_WDC-DEtRWFmC3ebsq1zGpQvQ&oe=6AFB376E"}, {"file_name": "screenshot-5-flightline.png", "id": "2323877085034316", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/613039514_2323877088367649_2231516184545010407_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kd8adU9HP4Q7kNvwGWR5AI&_nc_oc=Adqfk7s7QNMmYuC2I3wRUJaUvdc61SttPW0G4EbF7x1LEjfgoEsoLxx8-Dw9rH0Kmj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRbO_HGq8S2yhwiXa8wjWafo9Vm5VheJJFpGWCmv0OEg&oe=6AFB1ADE"}, {"file_name": "screenshot-2-vietnam.png", "id": "1783568659569651", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/613030050_1783568662902984_6756202339235455110_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ek6nEg-BLIQ7kNvwHFUcHi&_nc_oc=Adqj5_NLXCxLL-uUsJ3cPMEYA86GTwHlqK2s5SpZLFVCSUUmsBV6FmwqymJBILWScTM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp8e7_gThr3EConnRUkudYMUaMSYYbXGB1a79lv3GOhQ&oe=6AFB1DA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Harper's Air Combat", "keywords": [], "long_description": "It's 1990, and Harper Software has a new flight sim. Strap in.\n\n \nHARPER'S AIR COMBAT puts you in the cockpit for one-on-one dogfights across the jet age, rendered in the chunky VGA palette of the\nclassic PC flight sims, but all around you in VR.\n \n THREE WARS, THREE MATCHUPS\n \u2022 1951, MiG Alley, Korea: F-80C Shooting Star vs MiG-15. The MiG is faster. You have to be better.\n \u2022 1967, Route Pack Six, Vietnam: F-4E Phantom II vs MiG-21, among towering tropical clouds.\n \u2022 1990, Fulda Gap, Germany: F-16C Fighting Falcon vs MiG-29, all-aspect missiles on both sides.\n \nFLY WITH YOUR HANDS\n  \nReach out and take the stick and throttle in the cockpit. Squeeze to grab, squeeze again to let go. Prefer thumb sticks? They work too.\n  \nGear, flaps and speed brake are on the left stick.\n \n  REAL FLIGHT PHYSICS, ARCADE PUNCH\n  \nEvery jet flies on JSBSim, the open-source flight dynamics engine used in serious simulators, tuned so the fight stays fast. Pull too\n \nhard and you'll feel the buffet. Lose your energy and the MiG will be on your six.\n \n  \nCLOUDS ARE COVER\n  \nDuck into a cumulus to break a missile lock, or watch your bandit vanish into one and guess where he'll come out. Heat seekers can't\nsee through cloud, and neither can you.\n \n  \nGUNS, MISSILES AND FLARES\n  \nSix .50 Cals, the M61 Vulcan, Sidewinders and their Soviet counterparts. Dump flares, jink, and get your tail out of the gun sight.\n", "short_description": "Jet-age dogfights in the style of a 1990 PC flight sim. Grab the stick and throttle and fight MiGs over Korea, Vietnam and the Fulda\nGap in three decades of fighters, with real flight physics, chunky pixel-art cockpits and clouds to hide in."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/aircombat/privacy", "developer_terms_of_service_url": null, "publisher_name": "Harper Software", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
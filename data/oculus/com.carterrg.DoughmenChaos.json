f&oh=00_Af4gdweYjH9DODku59czs5fYwNcTz1l-u2qwD1GcNvQieg&oe=6A105D0B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re5F5B2kb6YQ7kNvwHIj-OJ&_nc_oc=AdoAp5j7lbMUXfsD_glEHAIewUAvvkFyltFQ1Ga5skGR-QTaGOH7KL7SjOB9ZJZf_ag&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f4b3ZB_SnX2WKoi24jOMRKOWdpp1jDoo8mYF-tFEsaA&oe=6A106B7B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3odaF4g4x28Q7kNvwE00TEv&_nc_oc=Adq2Dn8VJhsR3U4uBbdl6PDkmaAySHmLi2FPrdLE95sfNmR4q4ggp1MCNO6Uf0CIZhU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uXQv788LUt6Xg9tt7nB132PFqh1eeMbloojASLZ2r0w&oe=6A104ACD"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQQNgyCCJiYQ7kNvwGnTnZk&_nc_oc=AdotBv6zwgtmY1IZm2Sitsj5WK0mX4CCB6NQ6sEd8HsDjUVym689TY1zKH0_8u9IP2c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hEH4UC_c_dT4zquSDl4N3JrDU7csNLzsge0rxBigPRw&oe=6A104DCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwWD2Nu5wogQ7kNvwGqNpkX&_nc_oc=AdqdIO4HAEcnCoQ3D3stcMlj1-Q5jQaOcn7iXoAlboKIEDv-JJbc2UZyp7sO-DULIio&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sEIElg063ZQb8c3dgQRzJ5bVqAieJ4JCkPiQTSF7gjQ&oe=6A105C37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
f&oh=00_AQEah8MHwuytUD_ClxlQLTaFxXv22E65qVKtjLGgkAdYbA&oe=6A896ECB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U-mmnp0tVIQ7kNvwFPfhlx&_nc_oc=AdqeValIMV3Gn_CVr7-tYniT9TH4Lw2va-ZolIO4mRPpniJBhsXnQQDdH06apHMCNoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVq02UpuvWEZpFuZj4BD-ubaWpbsZFB_AlJuLYUhujow&oe=6A897D3B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIPRzZfcRAYQ7kNvwEzgmw0&_nc_oc=AdoyGpcy66UOsC4xRXEDR1Tnw0vcvMi57Z0XQGxOhp0YLdGqxg77mV9zKrzVEcxq468&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGEVEqUVhIZ03Lvyu7jXpHgZytDz4nrCdjz6c6WvQ5A&oe=6A8994CD"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmFeRQKFbJQQ7kNvwGz1Qe8&_nc_oc=AdqIJSqmP-L73PAJj6g-ZeyGi0PlOGccXwDT4UCPprQSilc-e9AH2uGmwbi5xMTNw8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGXFGT05zBKJ6TT-GvFigm1sQBqjeONAKPq1IeMqYi0g&oe=6A8997CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aimqajHApy0Q7kNvwHJnH8G&_nc_oc=Adp6fapS5pY3VC_AVWxxMHKsI9s2DNC8ELjLrYJTe8qzEPstntheo4_55YALGYaMQlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHILw1kuwGBJqzeeLrf8AS7w90CpvlqXrhCY1nSQPNyLg&oe=6A89A637"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
uu8ytN0Fzr_aF3qnAQ&oe=69C1430B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8kwtCWDBpYQ7kNvwGwlg5v&_nc_oc=AdpzWgrOUht0M6pYwa-aDEpWwGfQb0xBarj4cHscXaQUz8ibEM5mzFSuC17V0K7TaU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtmHca4cFs_tHpagZ8QbJYFLbq4Ey5CTNJT7O64KVWEw&oe=69C1517B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzH5DP-hwFMQ7kNvwFc2r75&_nc_oc=AdrV2lAKBI7eR4mh5e19YE5ok6Xjz8n0SE9qKTBITEuZhDntVcnAGwvnjZzcRa44l5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfztQDc_ODcRF31B51JJzoj460GkSkDMAyDnKg_Jaa-vcg&oe=69C130CD"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE7Od-EL_CEQ7kNvwG-Vd3z&_nc_oc=AdqeJ8TKvLw_Gswn8GX1g37PbrrKTb4jasOEpPejDxBlg5823V9lbSdLc95o4Rmz0yg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_BKgir4vio8KsblUV5-KJGpz9dnxED-16ybsHADOTgw&oe=69C133CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNZVcEs0DuMQ7kNvwEAm247&_nc_oc=AdoIw5uaKJ2cv7wdwnq3K6qg-Wict8w7nhb5HgXeHoBpBC7CQG2MUt9CMHpsuJnSKxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh8d12r8ckVeoCTbjFdlUTYJRhmyyrnyf-LBCke-JKeg&oe=69C14237"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781
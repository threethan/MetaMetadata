f&oh=00_AQNdK6UnHGWyem_JyAHe-tpJhEwFVJcVvfHWwJhPsZ--sg&oe=6AC4FA8B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFzRUZNrdGMQ7kNvwFdXok7&_nc_oc=Adqr5fHbPnU59HpoYfomsRK8ybxLsEJthPgHONgpnxzIoV8R2_ERCv5AaF9yOolHpoc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkZ3EeN-kMtqLbimmpi6aTmigZNBijlHZpqLI0txZELA&oe=6AC508FB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWDrz9H9jhoQ7kNvwFxwevs&_nc_oc=Adq6MDoAZYcY7U-ikdwNDNePznF15piKht01KOkHf4139PEulxuRomqxjS5T7I_Mz-A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCnJDlqfidbTlzSaItdiCiUBcb6DVvvSj7KGtuwHpcZg&oe=6AC5208D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6IJDjs_H5sQ7kNvwGZCkCo&_nc_oc=AdpZWAQrry_qp-GpMz9waR1zUraru-4pZHVSnfhLioMFy8gCSwa15eygLOULKp-VVd4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKjmcWIFOBK5WOKNzgIWP3rTCrsI7rgNWRMHUSin7mlQ&oe=6AC5238E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80ow8gIUJgYQ7kNvwHmy_R5&_nc_oc=Adppv498iJ1gopa7kITPBb9FkV8kKATkl_iQHw4paKLBiMQ6_MRXjPeSoMB3PTQtxjw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBOSPIgyBRSCYqXo4eXNjCH6Tqsh9dR3u-P-mKlFVwZw&oe=6AC4F9B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
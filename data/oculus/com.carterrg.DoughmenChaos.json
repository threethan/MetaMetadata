62_954394302764726_3261018761592972758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rugb5NLfI8AQ7kNvwG67XjN&_nc_oc=AdqgC2IL3ZC3hOyPQMaJUpSw0N_XTAShHIn-SkTQegsod-4usxMRpaF-w_1OCw7qpCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYKJlXi7EH8OOs2xzAs9VRy4yd67Bha0gfkLLyEnTIzA&oe=6B0840E0"}, {"file_name": "screenshot5.png", "id": "805984288083909", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974473_805984291417242_3135669706304415658_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx8Dk82Hgw4Q7kNvwGjOuUi&_nc_oc=Adodluon8zrNzygr7esg_Uutee2eb-fGvA0xts9Qdad4FTE6X6-Zvq0OuIOz1W32A2U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiv0KxlBoGfvrCISAX_KM1czcdJ8DEMUo7f3j0uu82-w&oe=6B08715A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doughmen Chaos", "keywords": [], "long_description": "Doughmen Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Doughmen Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Doughmen Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "supp
66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eeaukm7n6MQ7kNvwHSwbSJ&_nc_oc=AdpxQPbyog9grrFBH-xaq1gwuO5Z_fjtp7EH1lew7Mi1vcWIRBoZecSKc2d1JygE_LI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzGmqueAMNAeJO2Fs5kUZUAZyaSwedkBQJTmAfCHfVqQ&oe=6AFB404B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9hw7WfC7oUQ7kNvwGltS_w&_nc_oc=AdoMF025jtsgFhF91QBzy6sMQTPZ57VwM7z_f4BIbTChdt636eqYJ2sbiekLKrvskrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROwQ2HVTLHKtv7gYyEc2nTbvfgVUe21Bn_eYyFGGBkQg&oe=6AFB167B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_AjDb17MOYQ7kNvwE8NLpF&_nc_oc=AdqfL8T-1KwpkOhj6oAhgDZeoi_Q1lolzxgiW-w17uYr7UMHRzqh3lKqLwdcdyyRtEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCXh91ihEA6hySumczKUPHbwZ7f1elJc6pBIsN-sF55A&oe=6AFB2E0D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWEZVt9yKN8Q7kNvwGsC6b0&_nc_oc=AdpZ7g4Hr2gY4xdZp-cAOOgByiD4pRrxszA5ZW3IO-fgjCg_cPuq2shlHA4MEgXvAjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRsX-nbOwv4xYcEDhSg_BiJKHwspqdqqTBFkgIByko9Q&oe=6AFB310E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWzNRRZWT6IQ7kNvwHXAcKd&_nc_oc=AdpQIfSAZXJNyRkxi9u5MVUaYbdmCJ4L_RKvOhg7MTb6EtTFaq4ioE0QtZRD5VpivrQ&
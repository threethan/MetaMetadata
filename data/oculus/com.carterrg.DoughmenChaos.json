-3iA85nvNFHmybHxbg&oe=69B2C28B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEpe6KRybg8Q7kNvwE2_ufr&_nc_oc=Adk071CbYVGeMWWWWZJ5v9ATp8Y7VqHfaV7nce8dqe3tw1AIrKC19fAt7el1B_Z3lgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-1bkl4C8AK9kecc-lURecSV9k-xY7B4EcnuxhAlkRSQ&oe=69B2D0FB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNplV5zt0SsQ7kNvwGYd529&_nc_oc=AdmWwON03oJhzCZU2-8Ovwsw6uKJo870WaE8-08nxwnNEvkI4DQQJ6-r1J4Zj3beKeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnnjSOBaQfYbIf7KVHx48UUTzLcSmhxZcUFn3GOiLguQ&oe=69B2B04D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3UCM3jEOOEQ7kNvwHSqdNM&_nc_oc=Admfx6ekmFodiiRGyjWqWBKuQ6cFmd5B548SdmqYDnMW7Wk92H3HrcZjmAVayI9MKxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvIYZXTGMrz8Q8cY7IVjksMhTXubvLkNS7uwyELxqQPg&oe=69B2B34E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIiLkUuoo4gQ7kNvwHOaWDL&_nc_oc=Adm8y5VovCgnqImEYqxnrqX7SrEiH7sZTJKKvFvf1HSuIq-awoZLRHrhTn8rz8zhwc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzz6h83SNrza8lVgGOWPSj8-t6NsNiSJ4aQT4l60zHWIQ&oe=69B2C1B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781
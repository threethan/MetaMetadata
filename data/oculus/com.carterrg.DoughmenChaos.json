_ss=7f20f&oh=00_AQFCjJ1O8a-UldcK3AgSJqyrjy_GOPfglICOZcibVYJwUg&oe=6A7DC98B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESqg7PRj4x0Q7kNvwFnVjq6&_nc_oc=AdroYMZgDk5oK3LIjA-fUhmvfBnEcKPW4TFm-HBDFqfyaE4FpfWrKfAMYmvZQMLO4ZA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEanwIfLaLSl0g-KSpgT9QhKG_7vinD7hUCkmmobrf3TA&oe=6A7D9FBB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dttgaalYz40Q7kNvwHrv27V&_nc_oc=AdpI6wcqbVfZA04wFydsIeHN5NfWXFsfRpzkTO6JovjaNtixml-L4bvpPfovdk_-S0Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR3pDmp3vOpflwqr2rvaYzUWf0w9iQ5J1WtRzRxG_28A&oe=6A7DB74D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNMJskjnxIQQ7kNvwHQz89y&_nc_oc=AdrBfdUAnqi4Wx6FGwXVGle7Yd-em_dNei_lSSVO8SaXzNfjGHn1-44stSWiQp2oonU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKG9X9-8S2FTxcQHLXVuIoImB8cfKrDaFNVn6l6KV-ew&oe=6A7DBA4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tYfYywkLfIQ7kNvwHP1kSb&_nc_oc=Adpcs7LoIuDj50tkr09i9L0Rp2LPXQkwtvMS-Kj_rD-8TBfEjSIH3QG35YBMKVB3UsI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN2Mh53H26z9i4kNTdq7JbOc4k5BblW2BHt875p0b70Q&oe=6A7DC8B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
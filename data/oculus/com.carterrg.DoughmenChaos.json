66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmSwFpz4QlAQ7kNvwGOMygH&_nc_oc=AdpRP70fvplOpgd_ssOyLlUqWPv4KlG7pIVyUqPuU0LKWCMcn3dGHT7lo2u3sVleFg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEFpM24l9dvVb4qyurXjI5iV03ZtuQ0qwcQM8LSLBMPQ&oe=6B01D7CB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wKfocFTGAsQ7kNvwGzOV0x&_nc_oc=AdrZohEYCQ_fVYnE0381nZj6JClBvK1jzaYZ8rZ9bYgDWkq10stbE6f4C-geTSocbJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRARVjHj9hNaULXtfiODrZhjsYzt-mrNGhqy37ivapjQ&oe=6B01E63B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTUXz3xzzccQ7kNvwHdVjEJ&_nc_oc=Adqj6wCo-M_pfe6izLBp6AOBJlsQ7-HNEr6JrDhQgcrvRtFn8Pdq-AMXtn7AR9RZxP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDXMN1XJll5NVdd4WDX_PBCT0kaG7RQ1YxRjl9fCOU7g&oe=6B01C58D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9bsOKBZg0AQ7kNvwHHtFdk&_nc_oc=AdosJidI-3ubXy6SplP1x2f_1JSNxY5dnWzqy7Fl0vTOyab4tPHXLeXLKXSN8EwrJag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHaT7aeCqkVyod_cuY4DcsyBNSn-E0t0ecQYVbjIvkZQ&oe=6B01C88E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYJvF2kVGqwQ7kNvwHdvnxJ&_nc_oc=Adq_nAiVpk2tfbfRk0h4i9KE-b_nM1cAv7Co3qOb5AZAIGQG65HgBgJRp-vUKJ6UiuE&
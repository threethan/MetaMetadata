66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wYigs_s-P0Q7kNvwHczA6F&_nc_oc=AdoLGPOE7nQoTZeMdjFsAoT5GnWS7vvmAq6zQkFg-KWIRq6dharLU_ZGsz97YsPnbcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvmzsUMmpOjlvedkWZmxY3r62G7x44t9KIIH0aQy4ndg&oe=6B0C63CB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrz4rsKYGN0Q7kNvwE2HLOZ&_nc_oc=AdrSRUhyvfoSyYVwHtvlcXyD2z6Y72nJRva6RlIQtofoY1DBX_YUwXq34jdQXyrQTig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0OWX0vK6XqgT0ir6tBmtgKYm8-i_3b6OYAVMe_cucPQ&oe=6B0C723B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMt9jhSPex0Q7kNvwGObjjT&_nc_oc=AdpbqUUNZLAt9WlkkKeWWiZdg592tsILqfbISAhkSCoyfUloI-z2uGd_mICFtp3cMxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRM9fSFG6B7UlsoYuLXAgwnSB37r8BaIBcwk7DQ5W9gHA&oe=6B0C518D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlQrFNzL5hwQ7kNvwEkvcy1&_nc_oc=AdpAhH8XV_YC2a4-KT79RAOZ6cg2bvd9_7HjTk-CSG8cw5MOfpzy5RjEAkEcl1mGOAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1ryBPwZudL1e5_oOhmMQZ34_Pe7Dno9fePhvPrZDxPQ&oe=6B0C548E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmI3H--YBHoQ7kNvwGN8Kff&_nc_oc=AdpQEnmwozVlKBxik6-8nWvBXEFtzz0jUDC-5Rt0qAnyOMqrdsV2CEMnejhLpNQSAnA&
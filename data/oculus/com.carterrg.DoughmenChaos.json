66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9wsJYCJxMEQ7kNvwFnwbJ6&_nc_oc=AdpC_V6D7X3QKNXdiys1z0TWMnYi1rtRXlFgs-E6l1eYO0n8w0zaamNgeArTMDWrQG8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrXBRHR7Oj-KFvg7MaZEBFOY3SBwi7RtX_N2PJXpDtTA&oe=6B086F4B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8f-YyJlGPQQ7kNvwHMKOCn&_nc_oc=AdqzF3OooN5zl-aBMDLKCDCmzF4u2Pn2z_K2gKci5xOxCGjwThPvyME-p3YltGS0rto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLeObPZQzKk90L_5-3ui7vp0uGJV1OXitZIobm3yKaMw&oe=6B08457B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bTjqqnRAcgQ7kNvwHJdZW8&_nc_oc=AdrSI6C08dOAMS4vLSfw6G8lBWhSTpIza5A4iwoPOJiasQ0UALRlg9R33-tXS0Ti3vw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfjdbjUS4wMtuW8WoXak_hszOcbZBnAvcrS6jrJdg5YQ&oe=6B085D0D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGmQDiUdW_cQ7kNvwHoxZP-&_nc_oc=Adou81BxiZWx29bSYhM_oUn7C43xs9Ce8Jc6y71EfHaVTIOKrhTSZMjLFiXiqCRUBDE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBvpKSuBZFfML0ozaC0n5d-Ghsmz_mBKXoxuLPAAtwvA&oe=6B08600E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HvHLHGydYYQ7kNvwGE4aAb&_nc_oc=AdoSZFT7a_jssofzfOALNznhdxdl9XrJmuM5ESBoUxjWTRb92l2pQMk1a_kNwK7zw14&
62_954394302764726_3261018761592972758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di3gHrAmy38Q7kNvwG6YKir&_nc_oc=AdrQhS1s06Q_PwhpyWbyY7FMCpuoWNx9ntoE5oaTUYJDrbPjlUj0u7Fb4ncFyCFzpQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpFZAwZX3B-tL6ynsiVfX7QmrqViaINWqLqu_LrAJY4Q&oe=6B05D620"}, {"file_name": "screenshot5.png", "id": "805984288083909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974473_805984291417242_3135669706304415658_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z_gv91fcmoQ7kNvwFRdoqq&_nc_oc=AdoL1W0W2Mydh_OH-wUmZ-ZcuCfcRdU9mZKPjOFiHQmLn7cFgtt03_ys1sUA2P3_8xc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHGjhy04zGjf7bCTZrqsM_61zqM-pafkxqnL6iRS6LhQ&oe=6B05CE5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doughmen Chaos", "keywords": [], "long_description": "Doughmen Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Doughmen Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Doughmen Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "supp
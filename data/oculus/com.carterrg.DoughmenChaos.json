f&oh=00_AfyfOfnGXYImZWwpBh4vOjGgACQnyR8e2KBJgbXltzstkQ&oe=69C3E60B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCG4267wVNwQ7kNvwHnuE9g&_nc_oc=Adrza5UqkkcmmjieT_m7EJkPiDrR1ifDfEdfwCIUvdKi6NxGBA75h8PiC3mY0YdR3cs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrsfkknEzPkiOFIP_Gi_4XcRXcYAqhp8kNQyddp3IAFg&oe=69C3BC3B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzH5DP-hwFMQ7kNvwGQz-2y&_nc_oc=AdrCJKiRlk0ZEIXJ-apSiSZddSDxHkw8gDgvWl_c234C-YdvNxEhIrd07iVeJFlVEww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoIyFiZM2GmYuK031B7xXeoSw5pCYo5FtcE4_ViSWzUA&oe=69C3D3CD"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaWG4cJXfPwQ7kNvwG8gFT8&_nc_oc=AdqFZyOAxJbrUM-yjUUdbuf9N2QjikFF00Kkc9y59axbfHeNAbKHnXQt8QSy5I1SW3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuqBzNsXleOW8Le1Nkbc4BDtsMWZpTCn_8TJf3JbDuIw&oe=69C3D6CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNZVcEs0DuMQ7kNvwHgZpnc&_nc_oc=AdrbXmG5-ZsUk5VWZr8hyaVQeFlGbBP9OSEULpIcy4QcwXcnnxcEZvBj9NPF3H9TBeA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCt_bax_l4MoVEyrCMS5dpbA-gd2StrKtfcdrUdJiNGA&oe=69C3E537"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
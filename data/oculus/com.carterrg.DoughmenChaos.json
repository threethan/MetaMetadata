f&oh=00_Af4eBOn5qGB0Oy_tvIxFKZZhTUgkGhajErrQhmq5zWbodw&oe=6A09C58B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE-M0HH_tU0Q7kNvwFtMnrj&_nc_oc=AdqPJ-qJ1_ra8gpmFOeENZVzMKoXLY2mHVMwkeLi6bX46smmbLyJw2A-fnnjiAn2CrU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4in-OrCCz3CABH-jKJWvtVFmW17JHLFcqNb69IFkzZrQ&oe=6A09D3FB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfHmIUURTxEQ7kNvwGAj0uE&_nc_oc=AdoGVP_337rp6Y-Ph9f4OCJYoS89iGey9c5mlW6PQDkUUYg59s6TPrCG0vFTWJgMWU4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41QUr0c7ISSWp8E25CqUnT0tqj0v14hb1pMod-4E7LeA&oe=6A09B34D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4hTQbCGEQgQ7kNvwHnOZ-V&_nc_oc=Adqc5a6bj1MUgdaml1E5-78ohyYpmiVLsfFiGXCUamR39bzyMpz2aURFpA64FBYB2r8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AkwAD06t9kCPRY3UtQUep8OPToB3w1gk2epKIFBB2rg&oe=6A09B64E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPK_8HLxyroQ7kNvwEy2vWs&_nc_oc=Adrhg3v93rtj9A3MCBuabNyhaCSPfSyS5OXlf65tNaZVlnYjyZ1MVu6d55vYsDye1wU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zq-C4zTm-gs-1f7dJD_UpvW2m31pC6ZAuXJb1KBnMdw&oe=6A09C4B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
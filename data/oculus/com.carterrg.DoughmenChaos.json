66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENZVj0G4ijwQ7kNvwFbbQC6&_nc_oc=AdrFrL5WmgaC9vViD2GmztEHDDxW9MsG1E0U-QIGC534la6ctGBHckxvTi6oO4fvKjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8DfXZFCNuOqAxlStKESu_70ihgmosADrt8ZciZYNBiw&oe=6B03294B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Wols-MoF5wQ7kNvwFNRdM4&_nc_oc=AdpcsGHQxT58-K_wT998PpihZ2UHvWUOfArMtw8dfh0khqHh58TzNy2Zlxoy1k6Exgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwAHq2TqVtkrcW6eCkQgh6pMy9oTpyRF4npCgXh0FFsQ&oe=6B0337BB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTUXz3xzzccQ7kNvwGyT6jg&_nc_oc=AdpfJEnd5qbgv-eV5tH58zZfodsfOE4NPR-3vsw_gCADJszk2jkz7IlqxB4WN-fDvC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm1zCVTqUmulu4bdU4Xu4LwY8PTjeFOqIHkZ6m5BMeJw&oe=6B03170D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRTyOMGyo94Q7kNvwFTDam4&_nc_oc=AdqPUpu2oH7ZfPvik0mR71E57VUgrj20rqsZPHNaN78T7cH19IHL_oYvWwZd4vw_QNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRfE3L-CyucvV7KYe2lz0TQlyI3qdQOgTg8vBxhh1WBQ&oe=6B031A0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYJvF2kVGqwQ7kNvwFyyd-o&_nc_oc=AdrBdgnXRd0tZ8D6ts33PIpfI_arcwZZ_u5I4xNtP1a2bA53zVTvGcamwEpUDGU8SBM&
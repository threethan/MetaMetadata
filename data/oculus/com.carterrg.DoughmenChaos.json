62_954394302764726_3261018761592972758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOxq-3w5_rkQ7kNvwFhtBI7&_nc_oc=AdrdWaVZza5kpHMIB4N-zkw76ViRFDDxt7s2GZBTsD0ORKd9XWevILY47D95-zZZgX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfCFDM-lFlz1G1prJYY8UbMvaSWTu74hdgFm3nMRh8yA&oe=6B033320"}, {"file_name": "screenshot5.png", "id": "805984288083909", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974473_805984291417242_3135669706304415658_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjJTV8CWCOYQ7kNvwHUmENT&_nc_oc=Adpgjc9gQWIDc7yNj7VsRFYmhFmpfLlRaI1PorNfbcIODt_3vDlC1r8R88HXHynDix0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe-e7oBj4bHN-a3dYQHC2REGEOedd1pbFP4VcqpCmLYw&oe=6B032B5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doughmen Chaos", "keywords": [], "long_description": "Doughmen Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Doughmen Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Doughmen Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "supp
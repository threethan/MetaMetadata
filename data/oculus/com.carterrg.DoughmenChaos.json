66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmSwFpz4QlAQ7kNvwFJlT0m&_nc_oc=AdqhSosYxHOqrljpWHIW7bqpY3X3Jbp64TnVfzXsKm22faQC8bSltjxNmkA_9O3hAro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN1ihsPACXBiDy6LcWqj7I-OFz4FK1JElppwiXlJV4Kg&oe=6AFF34CB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wKfocFTGAsQ7kNvwHr5a5S&_nc_oc=Adq9XCfEWh2aRcZvhsmmoYxpWz-AlIubh7NNvjLkPXwVHo7GjYo6qCTfq_sxP6TrGS4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAUz_vRQIDZ-QuZP8RrM1xyQruzvygKZq6JCRaAAcG9A&oe=6AFF0AFB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9je9Uiz4ZgQ7kNvwFTgNBx&_nc_oc=AdpiCiZki1QytgpJpb_2XdVj7P4OG27bsi3x1659ugw0V27M3QnTeS4l_UHYnK2vR1Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf6ZSaBWh6dByyzUF4E30Y-_h3mKas7q6K8WQOoweDJg&oe=6AFF228D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9bsOKBZg0AQ7kNvwEuG0Qr&_nc_oc=Ado34jyPAW79CJRLXGuJU98Ze00PXap5iXCGJRn1pgWI-UScoP6XXujbMee-qCMunC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2VSlHK4D1ldq9-WSu4ULYn3vzxM9jdfcBZfGz9Hem5A&oe=6AFF258E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_vPwdmzEcgQ7kNvwFQCU0F&_nc_oc=AdqQOW8C0iiaXbv0lpqjbNgqD4ClhDh9qcq99Xhs0VjQmG4Q-_EdEgc35bcVjMW5cS8&
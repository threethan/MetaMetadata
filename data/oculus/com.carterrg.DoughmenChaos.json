66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wYigs_s-P0Q7kNvwENAAqP&_nc_oc=AdqLdp-e7sUmqUgxhgIl4xjzRloh6MqLG1U7EVQxeSamBxE92sLYw8oWluWckmN9ioo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6ELXKfjfmAqa6zzzbFHGtgGNzHTyV4PkpPaEpUu6swQ&oe=6B0DB54B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrz4rsKYGN0Q7kNvwGM-iee&_nc_oc=AdpCLbrFJqZsDg9mvv3j_RwfdgF_zlfv47gTsluVl6oAZ_3MRUjTRi1ylJ2I8qqbW38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJNslK_ObDB5j5Z5TSUjdwRudoq6gbko05jprmzr4aVQ&oe=6B0DC3BB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzFBncLVK_UQ7kNvwEXmiGX&_nc_oc=AdqszbjDtyhQbDoVdWmwM1WkYHq9DFCSL2OloQJRQT3Hy2KJphmxJ1TXIxPvnkVx9R4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqoFoRC2MIAlDEO-TxjHWXiykKzNqS9ETJ2dQhoUsBVg&oe=6B0DA30D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlQrFNzL5hwQ7kNvwE04N3B&_nc_oc=Adq2ViQiG_3eyOy6fEDnY64g22FBrxhgKN1kA0PKaufzO4-3Ic4sOD-z6r4PMPSWTBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMfNozjx6UugTkrSjQo7f_DLGwYsWZfNl_hFeSpSiXeQ&oe=6B0DA60E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STVJ3mV5lJMQ7kNvwHnjwyB&_nc_oc=AdqIDJqzRtp3nm0awhKNgqmOBGMoUitIvWw_VA1ZMgqSGvb7wKoNOebFffuRpTDjDp0&
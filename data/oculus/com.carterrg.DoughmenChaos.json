66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9wsJYCJxMEQ7kNvwG6LvjJ&_nc_oc=AdqWv01QEXL-9tM43HndAj_iKv0GTvX9rmOmlyvAWuo3z7oofHEMGax-gxL2GfZFuVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNvOULjJAu_pNtWMItzgL7T97y-X0JEoB9vk3sItoNWw&oe=6B09C0CB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8f-YyJlGPQQ7kNvwGqkWLp&_nc_oc=Adrp4Sb4VCqS3Pr4GxMPaSTCoGoffANbzFY8eRTXsXKzQNZAM98fEwLWhi7aCNVESjk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRi8_dTasYTMJSE8mKP_Q5WpJmQ7BaUKiFklJOvpsstw&oe=6B09CF3B"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMt9jhSPex0Q7kNvwGncuQR&_nc_oc=Adp0xChNwniHPGFLCiAXjA3lvIzzoD1wfoQEfG7XNpEPFtrJfHaX2r-SQXtZJPcdUzc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWgnU5MVJ5BIejk4U-fu0GQ-dW9WyYqqDEZden22om1g&oe=6B09AE8D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGmQDiUdW_cQ7kNvwHPgzz_&_nc_oc=Adrsx2-iO2nz5y4EzI_yV0UTSSE46Qar8tcRERlso6Wxo5XUVqGz2EOgzCvfUPXI7Mo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDA98TWg8VlvjzGa-IkoB354ROeRp6a92o20NRqulung&oe=6B09B18E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmI3H--YBHoQ7kNvwFbj79p&_nc_oc=AdrLnjUwbg2JbMjSgxR9-D9Gk1sAYe6BLK53hGwskFtKbenodCBxvRkr4FY9ArJBmDA&
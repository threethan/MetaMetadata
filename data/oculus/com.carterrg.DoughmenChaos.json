f&oh=00_Af_S6Jx_IUDQK0KS79dtSf7vsRR-7-rII4N2zFOqCcT2cg&oe=6A2C0C8B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea1mt1qT4cwQ7kNvwHrSLHk&_nc_oc=AdqZlyRi336ats5nAbK4lql6Ld7gz4nLiyBYpms7DYdPqYsTNITrATx90TAgiE5EBiY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gezjV_XjbpvZmQt-0zuA5BL4HE-4-u3gO9xVvhBn8IQ&oe=6A2C1AFB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1f9HL-PsZAQ7kNvwF3Xjgo&_nc_oc=Adr2FhTWpZXRaUDrRDUnP0c1qE18wkDv55M18yrmNVGJ28Rb4K_ribyHt-mhBt6QwiI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BtuI_aaMF0jjatvxXCqS8roftjLTSpl4S3-2saNCqJg&oe=6A2C328D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFqNeXqQRjsQ7kNvwGkDqON&_nc_oc=AdoeJ4bsSL90-alaTYGGMEwIKf8_Q5dt_Q0GlMLiMKkqqH9O-zwYN7xurlS-fo0nx8Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tcufTsB-Q2I1TvKcm_ihiUChXbm9UAoS6jfov11eIig&oe=6A2C358E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Ln3A-G8nYQ7kNvwEP2dA_&_nc_oc=Adr25gNhORJB6iSXRdgR0tqUn2NXmS_r6yTVrek-3iMScalkzkoUdMlmFzPLBo_rkCM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89RSz5cWUiEObfY_AXgIoQg1fJEBdRSg8-shfyhYEBqw&oe=6A2C0BB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
62_954394302764726_3261018761592972758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOxq-3w5_rkQ7kNvwFKCJ_o&_nc_oc=AdpipTDXiJncx-A-Pwl7XlyriL70cIBWYfzHZCCXr01mrIzFbwliR92uEB1Ylw4Tyaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3vilrBk43e8ALU5gWQgoqdALaXL5594wu8IqMvs97Aw&oe=6B01E1A0"}, {"file_name": "screenshot5.png", "id": "805984288083909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974473_805984291417242_3135669706304415658_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjJTV8CWCOYQ7kNvwFuPtmy&_nc_oc=AdpmauGDIsBtvRZXPwaZYUH9XvnZCDBek2X6MNDes-WNCwSO2_6hH_18NXEPVKWV6fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7r8xYPfBIBaB0KVZ1_DsxGb7FN_ZUTlx2Q8eKdkDUhg&oe=6B01D9DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doughmen Chaos", "keywords": [], "long_description": "Doughmen Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Doughmen Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Doughmen Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "supp
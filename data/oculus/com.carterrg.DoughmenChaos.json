66_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eeaukm7n6MQ7kNvwGo525D&_nc_oc=AdqfK5WF-riRU8sdOIaGcaGLTclI2Oy2UT--0uWBlYPqNpPv9JTMTAXWEgi6-AB3IMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1uvFItLlA2T0YBXwvbFXP9RXPw9zy97NqL7w5oukEgQ&oe=6AFC91CB"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9hw7WfC7oUQ7kNvwGKt7dt&_nc_oc=AdrUCjYmJQBk14mfnH8iiCv8deJgZdUaMjT-l2FAGPWJz0i8SQCU41xw3Ch2sdNqAY8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5JGZuHzpug1D-29mwFvL9iKLkV_YUclt9oH_ZZY7bcg&oe=6AFC67FB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_AjDb17MOYQ7kNvwGoG4dH&_nc_oc=AdqEMxqU5_GsUpgF2p6i7t8ia9y0gXE9FcaWQxDtBykt6OyE1z38eAEhFyLsP5RhGM4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ojhmtVXnaZUrrGZHv6S6Y9NnSUK25fEx9KJo0JzsZA&oe=6AFC7F8D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWEZVt9yKN8Q7kNvwEBwACw&_nc_oc=AdphJzlYdGdsEsNgByIZjbm5IEwvLT8jZVg297Jw5NndTYH4p69KAoJ1PL1MFLAJs9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvwr2VGNnyoVFvFZpyskCAPLIPZvPkXhmllEsUAQ1kZQ&oe=6AFC828E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWzNRRZWT6IQ7kNvwFhu8Wc&_nc_oc=Ado7uSag0iUH2SRqtWlp7-gjnT1pMq9Oqinxwg0nExy5LrVwH1Z7Kv6y4AphXrpUPdk&
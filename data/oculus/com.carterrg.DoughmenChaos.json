f&oh=00_AQGS-C_XxdnF8wdPg70S1pQGTsl8WYuGktoSnFOLxjmUdQ&oe=6A709A8B"}, {"file_name": "screenshot3.png", "id": "396412289936143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031622_396412293269476_8012940564495795378_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjvf5GaEOzIQ7kNvwE2OQs3&_nc_oc=AdpwVGl27T_ecA_sHqIpwJZxAqgbRIgA44QPDVytSBd9viRgKO1LTSUOnRvQ1DkjHds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZjxvK_NfuE5bTXeWFZ-08MhxR8_IQun4_DVKwlmKXaQ&oe=6A70A8FB"}, {"file_name": "screenshot4.png", "id": "1151547606187823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1151547609521156_8037475940253601127_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30mHkCzwTpYQ7kNvwH4lRqt&_nc_oc=AdoFBxRQt8rV-Xcu8h3KCywGC6SEJ3lIENyrEqXltkHdG51IH-eMf66Dv8b9dMArJ5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJDr4oW5Nl5DQvkdpxcIxuXE1VBHg0jvT1TXxgnFHsJA&oe=6A70884D"}, {"file_name": "screenshot5.png", "id": "8047926998572997", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75641341_8047927011906329_2398288013327553192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdGYMsMIAaIQ7kNvwGujfeF&_nc_oc=AdrPrpQSaRzs0fIy8eQNaNrhEjRRqPzB0Qv-7lMgGqII-g_ZXIhTRTPsS3TQLNLBolo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETPz-e22FfAAr-DgFl0G9txbJ05GUmY-UjnUX_R4Eo_A&oe=6A708B4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beast Chaos", "keywords": [], "long_description": "Beast Chaos invites players into an expansive virtual reality realm where they embark on adventures with friends. Using hand movements, players explore a diverse map filled with mysteries and challenges. Beyond exploration, the game offers customization options for character cosmetics and adrenaline-pumping game modes like \"Rising Lava.\" Whether scaling mountains or navigating urban landscapes, the world promises endless excitement. In addition to individual challenges, players can connect and compete in a vibrant community, enhancing the social experience. With its immersive gameplay and diverse activities, \"Beast Chaos\" delivers an unforgettable VR gaming experience.", "short_description": "Beast Chaos Is a vr game where u explore a big map with ur friends, Move with your hands, Buy cosmetics, And play gamemodes such as rising lava!"}]}, "developer_name": "carterrg", "developer_privacy_policy_url": "https://superleoparon.wixsite.com/doughmenchaos/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "carterrg", "support_website_url": null, "website_url": "https://superleoparon.wixsite.com/doughmenchaos", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7439072929540716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974683_449369041007683_1447699825252327409_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqjTFW79ynoQ7kNvwGaMjc4&_nc_oc=AdrFX0fJb3ZtPo5ppNEH5cfwx5ffivMc8drg0vhKQigf8Kp1Ry0t1hiEQdBeolyXzdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn0rOx63C_Qu7QiCmYxlvoyEA52lGv3m54CZmvA4WB7w&oe=6A7099B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beast Chaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
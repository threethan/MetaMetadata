0f&oh=00_AQQlcb8jEdDuTiLfpgnFd7yUX-tcqe_oGDB-KKMrB7zaLw&oe=6AFDD7B5"}]}, "id": "1090291126919918", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "1977794439574759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1977794442908092_7913440143557333494_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvsol6QUzs8Q7kNvwF2dM23&_nc_oc=AdopqVLDthpdhMHd_v8fMYO1FNuwkvpUavj16RJjtQjSj6RNZNfps8-Ts14GaKFF42Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNlh_mggipHGU4EjqDf7hecZmcBxvtEVB9DpDdP63SUA&oe=6AFDBCA2"}, {"file_name": "screenshot3.png", "id": "943980734834817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_943980738168150_4675339553270056683_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsvV1MxjaBsQ7kNvwEM2MMy&_nc_oc=AdodcDIFadIodKTwvyFgA_9O6gWWcuT5HoDJVwS5UPtDApxOlw_2RX7LD0DBfdEa4n4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTUasUMM5J_JD3PnyfUjjmHgZY2UMa0zZ-9JlSmV8qhQ&oe=6AFDE3A2"}, {"file_name": "extrascreenshot.png", "id": "1612682293821860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_1612682297155193_2427186004918828301_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOF6hB07Q7cQ7kNvwE-w7MB&_nc_oc=AdowfhO1AN8WhF1w3MqUnG9exTtENFCIzPc0QXUgRjARfijyrh0WvwaSzt1CYvpaPxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Il1pLRxKdOQA82Rkf4HydQCyefelpVupPbRKHg6UUA&oe=6AFDAF41"}, {"file_name": "extrascreenshot2.png", "id": "1100890195833587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1100890199166920_1914206438573649905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VQMJJ3TtN8Q7kNvwFnUj_I&_nc_oc=AdoCi2oUGZH0EegbBVRuGmMpKVZNgBz4FW-KrJsFwZSCj4101EJa6iTmbfKtbfG5iEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AAN_5aLlDUyQL1a5_ZGXjpWcafyLYWw7rXNmf_iaRg&oe=6AFDBD43"}, {"file_name": "screenshot1.png", "id": "1878779380199730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1878779383533063_3398222135293640705_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELYyB1FhG0cQ7kNvwFjm_VV&_nc_oc=AdoaCyXF3yl6CF-0RKRkCiQBaiZDYWw4gOuK27t4WZn-QsgJKb5AvT4BOsJPsawgYeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwh6Ma5qZ4-EiaBxViDHzKpHd-euqGMlOgjoFb0ipMMw&oe=6AFDD543"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChronoMonki's", "keywords": ["Multiplayer", "Action"], "long_description": "Welcome to ChronoMonki's, a competitive tag game featuring a unique locomotion system where your arms are your legs and you run with other monkes.\n\nThis game was primarily made because of all the cheaters, bloating, and other issues that pushed Gorilla Tag away from its original concept. As well as stripping out all the extra nonsense added to Gorilla Tag, this game features quality-of-life additions to make the gameplay more fun while staying the same straightforward tag game you love.\n\nFeatures include:\n- A Radio System: Choose from a wide selection of songs across multiple genres to lock in while running from other monkis.\n- A Ranking System: A competitive ranking system to prove to everyone else that YOU are the greatest monki.\n\nSo what are you waiting for? Jump in, run from the monkis (or tag them, if you swing that way), and enjoy the game we all used to know and love.", "short_description": "This is a game that uses a special locomotion primarily involving your hands... just like a monki! swing run, tag and rank up to show everyone that you are the best monki!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Nylonnn", "support_website_url": null, "website_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325866340613447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1616765090460966_9149138172615749181_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nM4HCKhUVcQ7kNvwGru58t&_nc_oc=AdpZcV8EjcHNpoEHKav3w15-H7WxrO7uBRIO9YNltxUOPRMXYQFTtYRBVGCydckfvhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe-JQlr1yZTGqd2PSwWAIYWcCuCxXqpOIQf-wm6NmEUQ&oe=6AFDD200"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChronoMonki's", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1789755960, "lastRevision": {"nodes": [{"id": "1296585070208241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1296585056874909", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397248665106924"}, "iarc_email": null, "msrp": null, 
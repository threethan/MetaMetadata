5A643"}, {"file_name": "screenshot1.png", "id": "1878779380199730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1878779383533063_3398222135293640705_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLlgA3DJHGoQ7kNvwGOffOF&_nc_oc=AdqjsZI1ITsLOzDv_Ixn5OA7kTlsptLNfexT7myIBpgWOl1uAuvgcd6jmv2P-XD7ujk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjE_FRG89VrgalWwfu5xBZEurOG7PP7HFdoyQ2iMQ41Q&oe=6B05BE43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChronoMonki's", "keywords": ["Multiplayer", "Action"], "long_description": "Welcome to ChronoMonki's, a competitive tag game featuring a unique locomotion system where your arms are your legs and you run with other monkes.\n\nThis game was primarily made because of all the cheaters, bloating, and other issues that pushed Gorilla Tag away from its original concept. As well as stripping out all the extra nonsense added to Gorilla Tag, this game features quality-of-life additions to make the gameplay more fun while staying the same straightforward tag game you love.\n\nFeatures include:\n- A Radio System: Choose from a wide selection of songs across multiple genres to lock in while running from other monkis.\n- A Ranking System: A competitive ranking system to prove to everyone else that YOU are the greatest monki.\n\nSo what are you waiting for? Jump in, run from the monkis (or tag them, if you swing that way), and enjoy the game we all used to know and love.", "short_description": "This is a game that uses a special locomotion primarily involving your hands... just like a monki! swing run, tag and rank up to show everyone that you are the best monki!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Nylonnn", "support_website_url": null, "website_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325866340613447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1616765090460966_9149138172615749181_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLUrcG4E0z4Q7kNvwE7n1Hi&_nc_oc=AdoyTe1FrA-2bauiSf7jX75P6pu5Huw-I0JD3lHMdy9Nod7R7Gu9eD31SPxtgPQODNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw_wbF781Ws2Kzqj-cIW8jhi_SR01aVUEcR77IfsxEcA&oe=6B05BB00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChronoMonki's", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1789755960, "lastRevision": {"nodes": [{"id": "1296585070208241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1296585056874909", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397248665106924"}, "iarc_email": null, "msrp": null, 
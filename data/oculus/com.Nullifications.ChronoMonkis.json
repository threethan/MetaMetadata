0f&oh=00_AQTqHV_2hvYop6M-LBSTaDePntD0U3G9rQztKCrA-bsE6Q&oe=6B01CC35"}]}, "id": "1090291126919918", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "1977794439574759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_1977794442908092_7913440143557333494_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJQ063Ed8lAQ7kNvwHRIyEE&_nc_oc=Adr3btVKrw6EQqrL46wNMft965cyMMirgWeAkhxyQDp4cgGREwg59kjjHlakPpe2448&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBaLqmb2fBDvNAasd8XZqDrd-kWkUpAegtja5y9h3Z5A&oe=6B01E962"}, {"file_name": "screenshot3.png", "id": "943980734834817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_943980738168150_4675339553270056683_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4LT92Oi5KgQ7kNvwE2SW1T&_nc_oc=AdqlTSx9y5Hq6ytMaB4rlhc-xD19Y8jrTBwaUCtOdrXzrm4YnSTS8V0DIzFKXxwDRDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkAgAiXQwNpdE5g53xTXY7cXz1iKwR87JD6F-EKP6nDg&oe=6B01D822"}, {"file_name": "extrascreenshot.png", "id": "1612682293821860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831569_1612682297155193_2427186004918828301_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzbotcuIzmEQ7kNvwEzxT3Y&_nc_oc=Adp1E0__PKfOroorlRAp83s4iqo1PG0YzyMlHlLjzl1SJdbkR0Ff5gSVg2E5Z4EN1Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_7PeCeu7eJLbLJPi1xWiFsc_j03x5Bx3uukqESYI7g&oe=6B01DC01"}, {"file_name": "extrascreenshot2.png", "id": "1100890195833587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1100890199166920_1914206438573649905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4K6oZGbUzkQ7kNvwGlHSa_&_nc_oc=Adqc6jV4xhfXXzWU2X_9Q2ZVshgff-QtR0qXuZzFUpYFl0mc1LLCXTx7d3bG2I8q75Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFfhExhWIHwkzFp1dtu4KigZXEirnGOxOa2TB1iE7ySg&oe=6B01EA03"}, {"file_name": "screenshot1.png", "id": "1878779380199730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1878779383533063_3398222135293640705_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvcxFHbhAUMQ7kNvwHjo6FY&_nc_oc=Ado8VNJRJ79IpxEPPk1evSRrAQHqpeuIc7X9WlwNnkHheO-afTdVwPBrDSnYqEjvqxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT75vy_9ViHCLvJSGU6deR3yTuBc2BZpH4WuxFckRNVgQ&oe=6B01C9C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChronoMonki's", "keywords": ["Multiplayer", "Action"], "long_description": "Welcome to ChronoMonki's, a competitive tag game featuring a unique locomotion system where your arms are your legs and you run with other monkes.\n\nThis game was primarily made because of all the cheaters, bloating, and other issues that pushed Gorilla Tag away from its original concept. As well as stripping out all the extra nonsense added to Gorilla Tag, this game features quality-of-life additions to make the gameplay more fun while staying the same straightforward tag game you love.\n\nFeatures include:\n- A Radio System: Choose from a wide selection of songs across multiple genres to lock in while running from other monkis.\n- A Ranking System: A competitive ranking system to prove to everyone else that YOU are the greatest monki.\n\nSo what are you waiting for? Jump in, run from the monkis (or tag them, if you swing that way), and enjoy the game we all used to know and love.", "short_description": "This is a game that uses a special locomotion primarily involving your hands... just like a monki! swing run, tag and rank up to show everyone that you are the best monki!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Nylonnn", "support_website_url": null, "website_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325866340613447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1616765090460966_9149138172615749181_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLBqWOJQqcMQ7kNvwFLwn3W&_nc_oc=Adqe735vr0eJCHmSKOFGS7oWoTk2SLQGs9Y7wdxyjcKg-SidtBP_4xWObhbKlOAa2ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8pVHvu6CM7KkZkQogN4DsKCVnbSV6BwMRhmCSrhHZNg&oe=6B01C680"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChronoMonki's", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1789755960, "lastRevision": {"nodes": [{"id": "1296585070208241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1296585056874909", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397248665106924"}, "iarc_email": null, "msrp": null, 
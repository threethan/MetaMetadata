ydQCyefelpVupPbRKHg6UUA&oe=6AFDAF41"}, {"file_name": "extrascreenshot2.png", "id": "1100890195833587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1100890199166920_1914206438573649905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VQMJJ3TtN8Q7kNvwFnUj_I&_nc_oc=AdoCi2oUGZH0EegbBVRuGmMpKVZNgBz4FW-KrJsFwZSCj4101EJa6iTmbfKtbfG5iEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AAN_5aLlDUyQL1a5_ZGXjpWcafyLYWw7rXNmf_iaRg&oe=6AFDBD43"}, {"file_name": "screenshot1.png", "id": "1878779380199730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1878779383533063_3398222135293640705_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELYyB1FhG0cQ7kNvwFjm_VV&_nc_oc=AdoaCyXF3yl6CF-0RKRkCiQBaiZDYWw4gOuK27t4WZn-QsgJKb5AvT4BOsJPsawgYeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwh6Ma5qZ4-EiaBxViDHzKpHd-euqGMlOgjoFb0ipMMw&oe=6AFDD543"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChronoMonki's", "keywords": ["Multiplayer", "Action"], "long_description": "Welcome to ChronoMonki's, the ultimate physics-based VR playground where your hands are your feet! Master a unique arm-based locomotion system that requires momentum, timing, and skill to navigate vibrant environments. No joysticks, no teleporting\u2014just pure, physical movement that lets you run, jump, and swing like a real primate.\n\n# CORE FEATURES: \n\n- Unique Physics Locomotion: Use your hands to push off surfaces, climb massive obstacles, and swing through the air with complete control.\n\n- Intense Tag Action: Chase your friends or flee from the infected monki in fast-paced, high-stakes multiplayer lobbies.\n\n- Competitive Ranked System: Push your parkour and tag skills to the limit, climb the leaderboards, and prove to the community that you are the absolute best monki around.\n\n- Social Playgrounds: Hang out, chat with other players using real-time voice chat, and practice your movement techniques in casual lobbies.\n\n\n_*Do you have the speed and agility to dominate the trees? Drop in, start swinging, and claim your crown!*_", "short_description": "This is a game that uses a special locomotino primarily involving your hands... just like a monki! swing run, tag and rank up to show everyone that you are the best monki!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Nylonnn", "support_website_url": null, "website_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1306289835904431"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4388345648083183"}]}, "baseline_offer": {"id": "4388345648083183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789755960, "status": "PUBLISHED", "id": "4388345648083183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1424854504047963", "version": "6."}, "id": "1611154867275428", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__t
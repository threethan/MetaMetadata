0f&oh=00_AQTEHLobZyVuAvNClwqr515jg8rzZ_SRT_uM2bsI2w6uVg&oe=6AFC8635"}]}, "id": "1090291126919918", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "1977794439574759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1977794442908092_7913440143557333494_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvsol6QUzs8Q7kNvwFROXul&_nc_oc=Adp1M7Oq025AhAvny2M4ODwqgbpg3hhC6OEvwpMlTMaKl7-7X6w4bQwxtt-sUd0-96o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFbNPeH26XF5l7O4a4q7oHihN983Y0kBHSCq7iC8K1-g&oe=6AFC6B22"}, {"file_name": "screenshot3.png", "id": "943980734834817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_943980738168150_4675339553270056683_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsvV1MxjaBsQ7kNvwGEyKgp&_nc_oc=Adr4m4RoS6HEBlX21bR6uBOQwmW499UBoBlS5Tl29RAlf9_uFjGN7jI9O-UykdeN6_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOE9v3SG7aGzn7wpqTGg263G6Vi0-6hnZnwstIsEVa-Q&oe=6AFC9222"}, {"file_name": "extrascreenshot.png", "id": "1612682293821860", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1612682297155193_2427186004918828301_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtcToif4mbAQ7kNvwHptNL5&_nc_oc=Adoq0Qq-7Fz4oseLAC1edlWflqe4WuHU-xEoP5iV_TkGuHjADPXT_Ia2mISxS_s4_Vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB29LiK6k5QbccrSCRODtfMtyFnQAvLcd80RYpIDdd2g&oe=6AFC9601"}, {"file_name": "extrascreenshot2.png", "id": "1100890195833587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604317775_1100890199166920_1914206438573649905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9H9-ZaRgfMQ7kNvwHN83Yc&_nc_oc=AdoDneWFT0bz2OKIOhLdrP88vytvGdSrGq9m5QLLZykFgQdp-rECcN65fSR9A1XvOCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGwX9-pkjLqojDSJj-ID3o3ogThe958nb29w5ZcQT-Sg&oe=6AFC6BC3"}, {"file_name": "screenshot1.png", "id": "1878779380199730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1878779383533063_3398222135293640705_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELYyB1FhG0cQ7kNvwEaoS6E&_nc_oc=AdpmgWowqv2cwB7vpi9l3bbsxL_eTOdUIgtgKOQ1pLdRSWcKMQYhpUj4e3sBeDRfQjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9-uNgfIQl8wntedcwA-ZuPOC5bP5-8Dv_0AgYYv7Xsg&oe=6AFC83C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChronoMonki's", "keywords": ["Multiplayer", "Action"], "long_description": "Welcome to ChronoMonki's, a competitive tag game featuring a unique locomotion system where your arms are your legs and you run with other monkes.\n\nThis game was primarily made because of all the cheaters, bloating, and other issues that pushed Gorilla Tag away from its original concept. As well as stripping out all the extra nonsense added to Gorilla Tag, this game features quality-of-life additions to make the gameplay more fun while staying the same straightforward tag game you love.\n\nFeatures include:\n- A Radio System: Choose from a wide selection of songs across multiple genres to lock in while running from other monkis.\n- A Ranking System: A competitive ranking system to prove to everyone else that YOU are the greatest monki.\n\nSo what are you waiting for? Jump in, run from the monkis (or tag them, if you swing that way), and enjoy the game we all used to know and love.", "short_description": "This is a game that uses a special locomotion primarily involving your hands... just like a monki! swing run, tag and rank up to show everyone that you are the best monki!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Nylonnn", "support_website_url": null, "website_url": "https://github.com/BTrack-monke/ChronoMonkis-PrivacyPolicy/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325866340613447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1616765090460966_9149138172615749181_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nM4HCKhUVcQ7kNvwHJ2hET&_nc_oc=AdpRj-3lanOnvuFqqGGq6CNlbVbH7grT0seFLWIs5bvlB92-k0bdr82Gc2J8jxiqcPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXHNT8f97Q806stZbxTNeHfxim8KGN_BFJijJ67iAruw&oe=6AFC8080"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChronoMonki's", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1789755960, "lastRevision": {"nodes": [{"id": "1296585070208241", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1296585056874909", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397248665106924"}, "iarc_email": null, "msrp": null, 
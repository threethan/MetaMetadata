403288627", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522394_1240702562607165_630979630_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65b3Wd5L3nsQ7kNvwEAJmEd&_nc_oc=AdopktukkGjRFxWmyohOlVaUWg5xqZ_f_hPXyqUWW8Pa-PNavRaOQ3DmJLLK4lHYNCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GVwsB2Bgc-leo8Eq6i7x3uKUV0KcD1jxjoxrhd17LnQ&oe=69D26562"}, {"file_name": "migrated_image.png", "id": "205144453915885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727799_620593151451413_529184515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KjLKG_kHWoQ7kNvwHZlXhj&_nc_oc=AdosAd-tjyes1mrzu2PKrQQDv9eEKl-Xtj5W5X8T8r-ptPUAS_Xh8M_EF6PL8y70qhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QxZaYmfO0k9gOnfUdtWlIxf0kApXhsAlFMnTTFYSF9g&oe=69D27974"}, {"file_name": "migrated_image.png", "id": "149767689613337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386361_1131317420260850_1095194219_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaVqk2vJ2zEQ7kNvwGYrO0L&_nc_oc=AdpnA6_GOYUXDTcqvkdQqClz2NijKWVCfWrImuEP3kaiIKd20YS71pMitNQ3mWXwoEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZT1MRAbqhtpiZx0SFQMO0H48idTRvLhXAS0Ujf7k6tQ&oe=69D262C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Smashing the Battle", "keywords": ["action", "arcade"], "long_description": "Smashing the Battle is a hack and slash action game, in which you take control of two unique heroines to destroy an army of robots who have taken over the construction site. \n\nSqueeze between bullets, avoid hazards, take down swarms of enemies with powerful special attack!\n\nOn top of sixty regular stages, there are also additional stages geared toward hard-core action fans \u2014 so come and test out your skills!\n\n* Story mode is excluded on this platform.\n\n\u25a0 Two Distinct Playstyle\nEach heroine features a unique gameplay, so the stories will unfold with refreshing, brand new challenges.\n\n\u25a0 Hack-and-slash / Shoot \u2018em Up Hybrid\nSome enemies can unleash devastating attack, filling the whole screen with explosives to dodge. You must evade and squeeze between the shots to destroy the enemy!\n\n\u25a0Fan-art From Various Artists\nThe fan-arts drawn by many talented artists during the production have been added to the game as bonus content. Enjoy unlocking them by playing optional challenges!", "short_description": "Smashing the Battle is a hack and slash action game, in which you take control of two unique heroines to destroy an army of robots who have taken over the construction site. Squeeze between bullets, avoid hazards, take down swarms of enemies with powerful special attack! On top of sixty regular stages, there are also additional stages geared toward hard-core action fans \u2014 so come and test out your skills! * Story mode is excluded on this platform."}]}, "developer_name": null, "developer_privacy_policy_url": "http://g-hangun.com/StudioHG/", "developer_terms_of_service_url": "http://g-hangun.com/StudioHG/", "publisher_name": "Studio HG", "support_website_url": null, "website_url": "http://g-hangun.com/StudioHG/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de", "fr", "ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "521992862437703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410244_1012359628881734_523877906_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_
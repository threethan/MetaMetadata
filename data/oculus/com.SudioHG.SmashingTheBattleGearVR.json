403288627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522394_1240702562607165_630979630_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM3-v0jc-gwQ7kNvwHVncfz&_nc_oc=Adrw7_Qs99dJvPLQ2m-GFxkHZO5teOhPUUcOYRwcikVFNbe8N3-_whFC1WfEPzlcN1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPAoyha3M956Ug2ri22zafqKduCd_btEqNOTsJd27pQ&oe=6AF46F62"}, {"file_name": "migrated_image.png", "id": "205144453915885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727799_620593151451413_529184515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTEhAF6pna8Q7kNvwF3WNIR&_nc_oc=AdomSRFivFBg09RDodbJlKjjWZGbVRict7p8ugIn46cDc08igcHi3Uu8Vr4CPWEidsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNJmzM_iQgoEIznjJ4aZMbBvh-5KbJ90Yx7CN4AL-_Uw&oe=6AF48374"}, {"file_name": "migrated_image.png", "id": "149767689613337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386361_1131317420260850_1095194219_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd5Z58_tiC8Q7kNvwEfwTCP&_nc_oc=AdpQUF8jqjb9QDg_a5GyxiEQvQX_mm47n9hdA17MOWE3OrPZzryAv5Gv4ske1HcinCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIdVviob3HrYHFOVJtoJ_rlcYtrCvCPY2jUkeJ_6mDlA&oe=6AF4A501"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Smashing the Battle", "keywords": ["action", "arcade"], "long_description": "Smashing the Battle is a hack and slash action game, in which you take control of two unique heroines to destroy an army of robots who have taken over the construction site. \n\nSqueeze between bullets, avoid hazards, take down swarms of enemies with powerful special attack!\n\nOn top of sixty regular stages, there are also additional stages geared toward hard-core action fans \u2014 so come and test out your skills!\n\n* Story mode is excluded on this platform.\n\n\u25a0 Two Distinct Playstyle\nEach heroine features a unique gameplay, so the stories will unfold with refreshing, brand new challenges.\n\n\u25a0 Hack-and-slash / Shoot \u2018em Up Hybrid\nSome enemies can unleash devastating attack, filling the whole screen with explosives to dodge. You must evade and squeeze between the shots to destroy the enemy!\n\n\u25a0Fan-art From Various Artists\nThe fan-arts drawn by many talented artists during the production have been added to the game as bonus content. Enjoy unlocking them by playing optional challenges!", "short_description": "Smashing the Battle is a hack and slash action game, in which you take control of two unique heroines to destroy an army of robots who have taken over the construction site. Squeeze between bullets, avoid hazards, take down swarms of enemies with powerful special attack! On top of sixty regular stages, there are also additional stages geared toward hard-core action fans \u2014 so come and test out your skills! * Story mode is excluded on this platform."}]}, "developer_name": null, "developer_privacy_policy_url": "http://g-hangun.com/StudioHG/", "developer_terms_of_service_url": "http://g-hangun.com/StudioHG/", "publisher_name": "Studio HG", "support_website_url": null, "website_url": "http://g-hangun.com/StudioHG/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de", "fr", "ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "521992862437703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410244_1012359628881734_523877906_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLYXkS39OmoQ7kNvwEk3ZBW&_nc_oc=AdpzgYbP4UGdzy9tiqOU0qhTUP6EN1VE0K9xGDTZG4wX7SSRV_GuA__K4bYbJsZ3gCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALYBmfR8G1qhJ4PFdv8DlTyNzW5Zf4caOlY6O-UWMzow&oe=6A54FB47"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbfWqBN14zAQ7kNvwFfHEXZ&_nc_oc=Ado7Ev8ZtVwH3K4Dypi3oZDqzkhuFWsKKFoNuGXD4kld0v6iJjwVChxovtV55sccjyA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWKCGWHkfLzxUdtcZhzN1WZ-etqAPzrXAuJFfJzBHXqg&oe=6A5500B9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFkMltKpV6wQ7kNvwHixg8F&_nc_oc=Ado9xKPu1MEXemJ6bp5fod_AO7LN46tWELC9SxmmG5FehrJe0Op4d9iJesToxWiaZyQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBY9gPh7Kk9nSXjBHiShCte7ai0YFzlnA67o6QlYHauA&oe=6A54E5CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m5WpqcJ5qAQ7kNvwEqBIgS&_nc_oc=AdrAMcoXPjDLiUKDAD8AirLV0dkomQCTS7UhJDTUgNuR6BDcdHRC81cbA7X9keVP99w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7RNyhOEThj5Y9zxXKYB6aAt6EfnB61o9UJOAUv53_Iw&oe=6A54F01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exm5f4dYhRAQ7kNvwGVX8B4&_nc_oc=AdrU6HJbA9vLStOFmZtOABbic-XH8DI6CIyTRT8UJeGrMMcaMbZt7GTOMlqK-oPsNQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEtB4K4Yb0V4SAFI7YGzewT3wJpNSyYeb6BLhIMI1qmg&oe=6A55008D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll133N_8wVcQ7kNvwGwCt_z&_nc_oc=AdoROpmtJUbmsZsSi_Mg6eXdK-2qIUY58_OtccJAS4niKeYKsoqhZZKfWnw0LVSqkbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbgIA94KUnzlyepaFxlTS5xMBOkRPm7hrRNzHu4bYkgw&oe=6A68C1C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn29qSw_6WcQ7kNvwHkC1X8&_nc_oc=AdquieZvs7pg22FUi5X0FmJdRdwc5dx3qtqu_TU-U_6I2r16IHGEkJiYCUT2kuyS4Ak&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWx0NOjF3UpOZNi45jdjmkDoM3uo_zWNWINGBJfCJdtQ&oe=6A688EF9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-NSswMm8lgQ7kNvwHgazTl&_nc_oc=Adp02HMV8Io1b14nN53si8IMxJ4cZ3oyzsBqlUILvypdi9kZAWMv3oBKfdSnkwmbeEs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZAzr4r8sXCZYryjE-_V9ngBeLR4HAQ92B94I8RlwJlg&oe=6A68AC4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEYwe1d0URgQ7kNvwFLsO02&_nc_oc=Adp3Q40qncXKZcP3ESez8d4t_aZUa0H13ZrXoDHjhQaXSIWWdRkVIVKVhu3nD0RQVAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4hLePa8QeX4uxXmc5qBtJHtM7aGIXNMrO3uXLESZ1HQ&oe=6A68B69F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpLGuHgg0G0Q7kNvwE__4fx&_nc_oc=AdpICnkRcACoeiTlJmjW6iaNah5Zys6h91WoMk4TJryncs_-3oH16EA9gsH97sUeQig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSE7ayLU-P41M7vBJMXNOCSZSA6JfCkU3xGsXoQtQtHA&oe=6A688ECD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
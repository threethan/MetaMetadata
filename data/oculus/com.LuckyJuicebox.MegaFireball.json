.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIiJortphDcQ7kNvwH_3jGO&_nc_oc=Adrf4siFf1La__5fhWsIBr5Ifg9jFqh-G8_y3m13UVbywBvby-IVrIcjeHAIFGS_8yQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_-3gSNMX5CfJopGycJaRGETYJhIVH9fMbzoe2eClzdw&oe=69DA5FC7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP1IEyTuTD8Q7kNvwHz3Jzl&_nc_oc=Adp1JGY3iIRyoNSbjtyGcF16EJeu9HToQ6P12j9LoP7RXWcWSjo54DHvdpZzqlxh8A4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MyRg1HtpO6x1beJ0d8625ahaSig9FD2q8hxDNF0WTdA&oe=69DA2CF9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-gpBd4wEFYQ7kNvwEjRZp9&_nc_oc=AdoKor8dy1I9d8QwHw6PGOsJ8I0IRv0XtBLXZQ3oL9dKojgNgOSGe-OykeTCRvU81nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rOlX_CXh1LcpZdkCWUVkO5vffagrfgm9WmpARt8iRgg&oe=69DA4A4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llFTHhqKu8wQ7kNvwFF7j13&_nc_oc=AdqrCq1IAIVnqDImqD1xbrPpf8C3SXiV34-6jkIcjSEkjZOgmZnGD7p8w6veHiGMcy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hmF7_0MhJFnQQnSNCVVHFxF6ItcgJohBt4RIOFHdBRA&oe=69DA549F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nbiyDW6W0MQ7kNvwE7LrL-&_nc_oc=AdrXsQ0FycG6oo2JxzeKUMf671JIh8DeiNYr-O7OaUqoFa5h-11gCiVKcJWf_CObFPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_R9fbLSdgX8XslPWvm2jywiOpnam_YjmnONQxpWxC0Q&oe=69DA2CCD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXxvEj9-CUMQ7kNvwFbYEoY&_nc_oc=Adqr2MKoyjFSWtiKDz590Dv8jfSdbVd2sfNZ9IIQeIbmT8DlpL4l87c7Zn11G-gXAH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiX_WKO8jrAWxmQuutG7dW-PYNOWqeomqILi3IqJ47KA&oe=6AF32F47"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng454nRyHWsQ7kNvwHTfcT1&_nc_oc=AdpRvHPyJ73WSvJ8FM0KZX-GXc7eqV35-bzcZ8Z-K_x-0Bh9LUgGWdUCAeWyrT4Fdqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_Kivfn7PSLgwIQiDhtWhvVI7ICNF9f3CncfmZti4KMg&oe=6AF334B9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHc572zNvp8Q7kNvwH0885l&_nc_oc=AdrudD9gFO4oZ2fkHzt6zs0Iq6_zSTQIO60DlsuPuiZgyCdpqoSQDUlBRBJ85Nh4OZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv3g1MyqBRoKSdmYM1t3IHuIFigOX7cgen5rPYRDIWxg&oe=6AF3520A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpG-nin51SAQ7kNvwGe3zrB&_nc_oc=Adp1UsIT2kuEVSiVLPA3BIfBZpRXA8jT719kxMlqG_qO6fgOEuoZcLaHH03P4kONbq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc-atuSGUKR0ee0bNVKha5iDv2Lo--q346iB-Nw8zraA&oe=6AF3241F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfUUBwC0qJoQ7kNvwEreA6b&_nc_oc=AdqKL8Q7Wl7ervf1NYVlVmzum3eiBitCzoPaoKWFYptoh3g0sulKm0L6NSmoVRvuC7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOGh0c6VvEXQLhpV71zLqSCQ6AacE4rhxXEJcqpub_Eg&oe=6AF3348D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
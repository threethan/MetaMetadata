.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNaVxJ-F58IQ7kNvwG_0_Zm&_nc_oc=AdpeiUD3-kYsXSFqn5JGA6KPYnZrUDi9cLbTuDaLITYBNZMaeOs74IeSIJ9BrSD3fRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_QK6M9uDwcOmJjs4Jwl9Xg4AdFSXh-U0lO-p0qoSQMQ&oe=6A5F8747"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oelFLqrD6fcQ7kNvwEkbDiA&_nc_oc=AdoTeleQtBM6XHQZEX2S06BS0V_OB5rBw4nlagGp3rFLleWAtyyOkjOZvfNoiHdmWrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHfQLEyNXS3L4rwztINSzdII13Ol6HS8KYMBQ60qFMHg&oe=6A5F8CB9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-0OCfx451MQ7kNvwFFanll&_nc_oc=AdqCrSPnG-nIuaRuQyyWun2rIg_E_HkQBu_Oq9Mn-n0lIy73IDY0kxOTzUkTfPNhVyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4bmns6WwCPlAjvUiOWxo9Tn7_vdftWHHOprJtdYQ-hQ&oe=6A5F71CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC7SwVYM_z4Q7kNvwF7E1x1&_nc_oc=Ado2_k-YZULMjOzUxGbs5y6v3WAlZ8vpgrqulny-rBJwFGImiVXV7LilP55SIF-jXxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHhaEjgiYqM-0pcgItZ_WRDNTXG_wb_B2KiC_WzQdALg&oe=6A5F7C1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PwQ-WSrovEQ7kNvwER4_Hw&_nc_oc=Adpa5yYLexmLYqKniQdnVNzGuLLtqsOgRA6_D-vhuKKyeZ4iGVBo-Xyk7Bf5c5cAVX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFSWGkk0vngEMAlfuOiYFk7rA5JX29FV5A06AuDh4Axw&oe=6A5F8C8D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfS3r3q9z6QQ7kNvwGMLuMz&_nc_oc=AdpdlBp-sSMHdI49TzBgVFXV-PqLSKnD753Nm-uNkhULvcc4dW3vPLV2uAvFSeN2-xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUi39n9HFGCWRjuNRGSLEYr2Zioz6_a5h-73WkQsrZCQ&oe=6AF1DDC7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xa-TDqDrdQQ7kNvwHS4I9C&_nc_oc=Adr65yDi96BtwGImh8yfa8uzghKxLuiwiWF8zjlZJTz194C67YDzO0sS9_DO-dmDIjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCfCvD2EIRpUUbADWp_SeUrSUSJi9NNufX5YLXNArqGQ&oe=6AF1E339"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHc572zNvp8Q7kNvwGOn-d9&_nc_oc=AdoNzVTAgmtToDPeUyzUckS6tH056eVEl77q4kHRhCVP5w-isng7eK_3C9NGb8ITM_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYyl8FdW_B8Wd9xSXmkJGkhpbfTAHhTiQd0Xsjtd2cJg&oe=6AF2008A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpG-nin51SAQ7kNvwHFvc1S&_nc_oc=Adri83hDcP_Gke84QNohPfkkMO5B4B2Y7yE2lmvQAILu_72gYnZX4XXX0gQj2byjAdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1mfj1e8t0kIbko_hX9EUD5RZED7HQ3nw7gOF_du3O2A&oe=6AF1D29F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfUUBwC0qJoQ7kNvwFnoFDg&_nc_oc=AdpkS8qHTxi-i6tQDAU9lBNDRtIgJM_UkTRJJzoCuRm4gWrEhMTkrv9Qnl_wNl430gM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA05pi-0FjUArmIAqHNOPsaR6OedLeEgPs4qBZ7kHXfw&oe=6AF1E30D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
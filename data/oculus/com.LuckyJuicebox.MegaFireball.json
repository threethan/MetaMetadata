.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6MRxF3XOeEQ7kNvwFhHepB&_nc_oc=Adp4HBT-s79y7xThrYPhWI4kxoyFmjCV5nD3ky4o_O9dC-tcBNh255cJByAzHL1FezE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUN-67pico1Vz6eo0TVd2D0uH68V3vYUU9QJkOC9sidw&oe=6ADCC5C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hyov899XxJ4Q7kNvwESJ1Ce&_nc_oc=AdpSow6Gc_G86qev-dcCHPocqa_HPETXUwS0BBAfCZO8alit7u442Q-pKxC-gKYLSk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzGaH3dSoNKXRuTTlK4fKo7_YUM57JZ8F6Ragiy3jvsg&oe=6ADCCB39"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgCpRIbtezoQ7kNvwF-pA0T&_nc_oc=AdqdCZsnrpvR0FyPizkl7bD0juQkWDvk1Tok0eBCku2IkU8SyjXxy0B6WfKZtmPnRps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6YFHTUZsLCzCE0Pskp2Js7J1kkZkmSG8r2P11-jNpFA&oe=6ADCB04A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8cC6Z0etdAQ7kNvwFKJMAV&_nc_oc=AdqkkwLYuULgcgmIXMhmRroniHkTim_ettVIgUQJvBzdM_sQCrcl_gDBCSfg4jgRT68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkJZce7ZNF3JdgXpBA4xIUHgEeTFJ4pxpD6JrvfkQFQw&oe=6ADCBA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DxzWEpcplEQ7kNvwGDfcbg&_nc_oc=AdqR_XJ7iijcKpQQWTFja_Hquvm2I5VziPQJ86_Qs27_8f_N9FTQffoQWyVI1_jkEYk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-HamGEO97qVbU_qMWCRj6Me_jdtoX7KrpLPcZ9eJ5Vw&oe=6ADCCB0D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
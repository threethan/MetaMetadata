.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK3yDAcncZoQ7kNvwFCckKc&_nc_oc=Adq8JyruW4EzYq1SAMESJIHqxH8S3Aexo1NBDEL90gboFG_N08_yja3imz8JBMOAJJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFb4pQ957fycv-7kfavmn5ZqYQfhfHjB-eLsrGLPkQIA&oe=69C26C87"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=labx1oRKauwQ7kNvwG62Z60&_nc_oc=AdpHIbT1i0TwT6K-yUGyP1llxPg2aiyQsQLYJ9mbYD78TDh66zXUIr0X5iC42w9rKdk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbAKJ-09HvcF1N9qFd_HMlsEqNLnfFvOe86L_gWio8SA&oe=69C271F9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYXRMycRmhEQ7kNvwELGFGC&_nc_oc=AdqcA7cerX4ZNQ_EGmndVbx-PWnSdBNSnP4pulGODgWZnaAaB7w0wx_QYvNs0t8SvzE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzj3bKvubsikXlpx8ayQd1zfJhDnrYNLMRs-bqRku8J5g&oe=69C28F4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwBERCWydsoQ7kNvwFZCDgn&_nc_oc=Adp2fRAymXJN00PgBgc8ZoXl-FHApBu_9NPSPW7GRul8BrOIfNgqeU2R8LRW01hEM_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCQs9i4ecNW4c_i60_HzHkpj4NT6J__bBkzAzXBvY7lQ&oe=69C2999F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPIkpowmxR0Q7kNvwFCGuu7&_nc_oc=AdoZNcQNL_mmtrAVd3LD0tKWhCZw8vN8Zm9z5hfYEiX9QGbWotALcoPTb0-FwxyBQg8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV1JNnMqfM9YJoprjGeoFj3oCpx9a2He5RSm4rAJZVsA&oe=69C271CD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t-He6HaSx0Q7kNvwE6-zpd&_nc_oc=AdppbqTogsGEEJ59NUOLrs-_2DIMSpMqWnD3reQRmqTQE874_zBBmWC3QONWrvko0vM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgVKR6Q7PdBiYXVjkHalOjdMGRY6z5Ip90rwG9k9y4zQ&oe=6A882D87"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7buOX0lx9a8Q7kNvwGsDqNE&_nc_oc=Adq2Lh-L2J9z-8onHS1AuFlOG4R3GnlHb3haE1leMCbE2WS8sGAdKbcYqG60k7FtSZM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJEUGZnDonnEDpP5pRlnFW-seoIU77uo6NtYGDfscLew&oe=6A8832F9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEmP0T8LWmQQ7kNvwFvmGrr&_nc_oc=AdoHPGlZ9FvNtIf_Ajaypz-1vAlyMTOhB8GO8G4UzUkffdfwBYpjAy39SMi8N5hsIbM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEekBIs32xkOAVjT6aTu3apyCw9nCv5erys2ZUkqqu7Vw&oe=6A88504A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvrYNL7tu7MQ7kNvwHsbs3W&_nc_oc=AdqlAZVpUHUXrZlVvLnM8g-2BcyEKJ2GlfWrVe3G7AqI4jquSHCDoUGWhzlcr-_ZuYY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGGDGBmwADRibsLa0TaSfm7Xuv3dskrpOR3qXkqUAeJA&oe=6A88225F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA380XcQ9V4Q7kNvwFeieCn&_nc_oc=AdoyeJC4k_3E7mAsnKM5bwlvZ5lgHrJEF7b5yhc3PmH-XDbrV0Y-NpmiobOuZnUPjs8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7QZs9X-ot71sLCA98I_S95OTJBjf7FVGLIfcuirO29Q&oe=6A8832CD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
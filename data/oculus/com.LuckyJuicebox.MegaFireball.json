.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJPFjh7aqgIQ7kNvwGd0by5&_nc_oc=Adr4Wv9g7wiEIsgL2nZXF4kn8JONtiVlzL-h4rmyqKgCOd8YV_UdIfcUjnVkyaH7_yE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvzJVe1MVnleK9QkojZOfZUoLHvxtpUbZG-vzSCjmh4g&oe=6AE9F4C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pomf4rypi4Q7kNvwENAq1W&_nc_oc=AdqEIKKEnfpNmd5-NVdGicaTZ-CHvu3gUyH_BXoSS8SViAy0Xg1HfJBDOgRpih-HJtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU4TH_mcVjDqwhJDPoE7o58OmLZoSW85uL-IViHlvY7w&oe=6AE9FA39"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_q1P_xk3UQQ7kNvwGfqO9B&_nc_oc=Adou-1LuEHJ9wH4-59U-E_vAxT72IAohkBD4zVe2A4MKozegjPEgzFV2xYBUBPhHrN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLrITmn6IpXs6RwEJ4lrFI2FaHEDR_drinhiHqMVDtkg&oe=6AE9DF4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD2wIJqzf_8Q7kNvwHqFgk-&_nc_oc=AdrX5oaQUXjFNbiUTGzCDcb474jiBG4MdNmaU0ILUfoYj6yTYTQhyBy6HiauYAyaGpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp3Q57CiiZSyRPAh_y8CRfN1ySPQQgz6b7HFi9yVbD7g&oe=6AE9E99F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p8Z1qX2n84Q7kNvwETvK8c&_nc_oc=Adosr1V3L7naTS-gTqia82P1GW-4xVMzEM_IiuhtaCY_XYbNBvhnBWkKAoxycl6r6s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVCB2T5OCOtt18n8NZXvVF8l6zics9Rp_U2uBao7bObg&oe=6AE9FA0D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
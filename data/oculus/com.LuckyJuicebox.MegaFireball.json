.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxvm_PZ1lCoQ7kNvwH7TlB6&_nc_oc=AdpmuKI9m1uglE-iFU3vmW7TZEYdTke9cu_nwvDAnEpnZAXgHIzrPmskGk4eEvzdG00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RTI6baYSIvYycr8ly9fdiI7pFKKu5ddiVDIHT9flSgQ&oe=69D39007"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1HT17ke-B0Q7kNvwELyBxz&_nc_oc=Adr_NrZMJto58AooTrP6ElRa3Zbtg5VhiSe-_bIwJbYXJl19I_B4hRZTJSmvwvgwEkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aGsW2no9O5KMMrpN_Eo76lH2Ch5ZY-fbwlo9gdIdOaQ&oe=69D39579"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWB5a1TyTFsQ7kNvwFGq4-q&_nc_oc=AdqVUEtTodoY_exWjLGGbHM9qAe3xeWo_pB3egziZ3LRVsd13A-Spjvcuv_QMkSQAGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wuz8FleQZqthA8OK3L-sEXMMVMx2u8oCtHvGGSLdlmA&oe=69D3B2CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8-GR9Ic8VkQ7kNvwFTKQIN&_nc_oc=AdpJbpteVDgCWeoTd9VoCTEEQbbLiM9mNpZ-ws3n-HQmbEYRfeZwcNEkt70_qqTMg4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K2OXgNhP7d71A0dWtejExTo4IU1bSUmiNSaqUrVGkqg&oe=69D3BD1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4xPxQr93cQ7kNvwFioFI-&_nc_oc=AdppkMIzJpaU3PkqQxswzhjKu5hpWNlbp38fM4d_lqLs9v4e47G5Spjld-nHCjstnJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27JXGYR2Ubn2VJrHk--jSUaoUfZ97R_gfQYSW7Ikbj2Q&oe=69D3954D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
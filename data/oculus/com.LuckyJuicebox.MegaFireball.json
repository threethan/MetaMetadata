.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hfMTeSEurgQ7kNvwGUNmTV&_nc_oc=AdpjJk2OUMxdoSazNAK_m70qKIel5tAxwm7otj77-bAEcczqyFCk5dIJEyu9PagjCYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-QKwab-NIClsw-zux4Sl03pgytPSoWDXT_Vtz3-_0fA&oe=6ACE4547"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrHNsw-TotkQ7kNvwHM-oxb&_nc_oc=Adp8N_z_aMsUClup5j_7Wgjxuyt4uLREdz0UqCM_XfhqjervUIjOgjwunKwRPofn__s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb47W7NtHNz2Y65BF-s4yeqyXn3BAounmOV8izLAVLzQ&oe=6ACE4AB9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbYwtB31Yl0Q7kNvwGq7F3J&_nc_oc=Adq1njUjmbd-I1_X0-lXwAojmCA72ax9Fd7gELnNAvoI3zHPXS77rBnvyyqpY4hyB-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ0R4SE7cSQhs-iVEqxY0RrF6pzGgL-W1mclsdwf0Ltg&oe=6ACE680A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqAuj5vwp8UQ7kNvwEylAw0&_nc_oc=AdqDbQ77ubnVYbPClvZcb4zKaNq7qoJUW9ujAiWYckLjdbGpt6uBuOtl8kdpo9i-J-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNaIwg0yX53L3B4bbIjWSmmWSKxHn708TI2aMBnvRn4A&oe=6ACE3A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLemhT4gDUcQ7kNvwFI_V7Z&_nc_oc=AdoxzvH0HHfuGxkaVhIoSdXHVs1LkHv9Tk0xLrqudqX49-zCfN-vINOpGuXme68avcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-HoK2oN1jiEddqj2eA9QODspA1_R1-LYPO_hmjblYHg&oe=6ACE4A8D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
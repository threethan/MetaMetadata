.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twsENwrgdZUQ7kNvwFypVmT&_nc_oc=AdpgJCOElsdGg1opbAyb97MtbIipKHmUGpVC3mbVOykYPelYg2CnlVAwRYb7kRr_Pag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrUS1XVd9EHAKDOy6ooSrM47XbisLEW-cMU8pzSZu7WQ&oe=6A6F5947"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO4d1-ckQLAQ7kNvwFCTEBo&_nc_oc=Adq_hl6pi1Tzzr1SBheuSp9xx3LvsBeYDHm20eD5Ff9VzvkC9eZz40W48itWo8TMWso&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3gKP3M0-4jFyiwfDKHPfNxEI_jB-1yv9L1Zl9e6tW8w&oe=6A6F5EB9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcNhVHBJcWQQ7kNvwE6xaKy&_nc_oc=AdqucR5FdLnZCpzdOKADKnyqUR4sIA3XFULgxxnHae-H3CwSicBo96Do24h3dR-tDFw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCquvuKdC9wN4zGWtUBoI6IL_J8v7UlLP8Z1ahyU90Fsg&oe=6A6F43CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huI7P2Bcx6gQ7kNvwFdsmg3&_nc_oc=Adp7hVAHorqXfLuXSDfffOYftTLnzse1b4lNmo_bnx7d6KGUz3oIrosEu8FawHTkENw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj7BZkLkq2t_PO5CkhU4QdS9l_BqmxDv4i8tPBO9NJSw&oe=6A6F4E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ML42_8_SsYQ7kNvwEUY1_6&_nc_oc=AdqG0aF5m7vhBuNRRKPGA7iwHQp1V1LDEnFq2LheCK2hpqKDGI9XchnF1B93Z4IVrXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPqjphwayjhQNnzvQojLodnjDJ5C57CTWJtzS22OYM_Q&oe=6A6F5E8D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
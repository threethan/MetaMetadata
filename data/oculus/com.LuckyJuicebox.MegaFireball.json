7&_nc_sid=6e7a0a&_nc_ohc=zEe5sn7N_70Q7kNvwE6o9On&_nc_oc=AdkN0qm-hGGcq_gpAhziLILpum_4NdT6oVQgHrL5q3GjtqorgydKtTtsThFQIZZhiEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuSPf6HgxMeXkBrozxDY93RI6H3QKXH5tji3aKMLvsfMA&oe=69A96007"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BR-1eNdGkcQ7kNvwF5Wkb5&_nc_oc=AdnUcdnEDcWX1F4LIE5ANr9fKkhVGoJeaiUw90hT9l_H8mQR4dwtc1m6sXvMXiwm5gM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuxdBFMgvzbySnAbMRrFnpcTmUNE0Djvfh_XtddDocCRw&oe=69A96579"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e3wjTYfqOIQ7kNvwEEbVNb&_nc_oc=AdkX5AaR1oQ4g9XNVuckZvLW9TQfUXd14PgeAYIHqA6VL2owNXXQVghrIFPOVwcT5r4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfstZKT-Zs3EkeWQ_PaIUwfNSL66eRgs5sTSr_anXv9DbA&oe=69A982CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFhbgtHiU_oQ7kNvwEAGrCT&_nc_oc=Adlu-GevNYKQnTRc35d7nsSDdIKajl6JCZdJJ_bU0iK1j2vHpFsKpFaFHnNsF1MYemQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEhEveeFwh5WMOnIT75hpb7VmvzRu6Fhwx0HnYbHjjfw&oe=69A98D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAWAVLPKV48Q7kNvwFV4Yk8&_nc_oc=AdmCbX2MJTBOU1HiTo7lr-pm6sAp1-EAR3n01ijLrtAaPEhAC8iewcBiQFUN_AvYiv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvN1YrZqGo_zb91xWXKGpiJCNoxV-Vbp9vGwROhftFTqA&oe=69A9654D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
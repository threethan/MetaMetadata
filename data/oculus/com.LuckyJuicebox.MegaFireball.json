.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXxvEj9-CUMQ7kNvwFUA-zY&_nc_oc=AdrRJNdi8f126R1jVQ1N1gYRVdKPVorJG-jWLXDK_5BQKkb6h8DruX2MeNM17gHyefA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOu0l4ylINcSNbLb1GQKwNvREGZHyMHF-BdPaOkPLg_w&oe=6AF480C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng454nRyHWsQ7kNvwGTjENj&_nc_oc=Ado8xmyXVzxKHmqwHhAZ-iOD5YQ26T6w1C1-6f16gNAV-Z8kl9iYIhHXDwGl-B1neyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmCFZHu2-gDQ-5Eeaa6Enc8KCCr4jQsQK_iFZJAaFDMA&oe=6AF48639"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHc572zNvp8Q7kNvwG9syp3&_nc_oc=AdpYf9DvxgAg8R1uWsP5bb5Z1ivyY0pUh4ZWHtejLBDHp6-a0fdpQUgJnd_dlr1EI4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX2oR6EFii7Uf5nl_1zbh2o1nCFblLHaKdCatiTfktYQ&oe=6AF4A38A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpG-nin51SAQ7kNvwGP-xsS&_nc_oc=AdqsBYS-7y414tkJUVxaztBTD1f6751Jt9lPG-2mSencI-gMowjidQjwo616yaOeYdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhb8g_GKmL3qdOuE_jjyeA4qm0QSFNdZu0ekG2iQeJxA&oe=6AF4759F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wnxdea0ALUQ7kNvwHAnGNy&_nc_oc=Adpu9sU0tnI3qgQ9FBpXRo7A1E2BBAvFjNtvYyMc5DVBagPR_2omLmek8YvHCjEUAmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrqw8-IKHjeKtu_ixNZCzvVjQVFmr8UqZCK8QHqqHf1A&oe=6AF4860D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
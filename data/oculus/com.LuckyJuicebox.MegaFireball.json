.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLYXkS39OmoQ7kNvwH2aaKg&_nc_oc=AdowAGa3tk2pcrqu8mfi-_EiBKIG_HTxVtYNnfXVvkw-0y8e2Jt0aptVX3o7YAGI4Ow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf-OHWL_gLFuj4RZm2Bd3T2TlzT5WSY9pyWYC1nQ3rnw&oe=6A564CC7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbfWqBN14zAQ7kNvwFkIbPi&_nc_oc=AdoU62kEsv_5YSA7boEaUNyKBvr_hyMouBltyuyF1jyl-OvOLYK_Qix-4Hl-yZ5BkSI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8i2WB_MZavrEK_OH7fwZ99zwCeCzaops51rV-0YwBdA&oe=6A565239"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFkMltKpV6wQ7kNvwEYMPjO&_nc_oc=Adrchtc7w9eIenXE_NtRzdAMUWoK7cBfhKbNkRJahzOYxE3oaBsFBYZbuZ2vjyhXPQo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUYCqLvjkUnR6XXiq4dX6j8UwLfw0mnKcEziWwyl2mhg&oe=6A56374A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m5WpqcJ5qAQ7kNvwHNGUjc&_nc_oc=AdpD1Ov0HqLM0xipNcrjJM_qoP4Ncp_8ENNR5V2jpui9ATUhzvYgq-3LBYp3VzW1PXs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmjTDA92skUzPo2ObqRcj2pyHKFquTcxpvFJ8HnE03JQ&oe=6A56419F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnLmcyOunD4Q7kNvwHTuQ2-&_nc_oc=AdqeTlZsZsTeFi0Q_KgKH1RM4ZoYxHe32LGJ7SNVMuKANqbixAJ1NpruzX6K26TpedQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSRDX4GocRR5f97CwrGF8hcIvX-0OxOlEnJPipXUNE5Q&oe=6A56520D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
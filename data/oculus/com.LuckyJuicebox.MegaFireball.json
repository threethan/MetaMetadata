.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRVlCFP8ELoQ7kNvwHJLDkT&_nc_oc=AdqE-bJio7jWlzCQPE-B33KXK2Js20xiMBkjSAPQMddnh_E3w7Y0cRho5X0_GcepAtA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MwlD-rawNiGcgGSUY9fpPJ5fVVvEMVribxIfCEFdOCQ&oe=6A4134C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6o-ScXXIp0Q7kNvwF1r4u8&_nc_oc=Adrz8q_OqUAjIK7xcvKivun2aLhsvHokDFbJw62ZGeWYdNrhQy-xjwCL3N85Qgo5Puc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-zliUNoGaekZe-Xz7_a3eVvmYWobcxeYkXZRV4YWBYA&oe=6A413A39"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJXMiKlZqvIQ7kNvwFZo62M&_nc_oc=AdrUBZ2AMArIBsefT8PncOV4godE00Y2ISpVEjUpDjqc0Cy7OPXPKrTp5r7BCpEYsqA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af820lFesU1yVAZLSE8NCCh1x4T-APkoh7p26Gk1CKUpyw&oe=6A411F4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tf2cDvi67sQ7kNvwEz6sCC&_nc_oc=AdoPH5C1DMzthL1B-gu5kDLKR2PBB9HlVJzRKmK8ac2DELp73UvPHabIv00-quICaJw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RE9z5wc43zz7wA3fPntjxDREHqPgF96rh8iDT3fvNyA&oe=6A41299F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0msc_gu75XwQ7kNvwG0QzNT&_nc_oc=AdpWqAOufhaMKcUUuAhHCninIxv1R2PoitG2F6Mtdoio5GDWA-yKxdOHXeysmyfAj7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QkfTLu9lqy_afkispvcrfa_2nOoIhm1OtpJ6D7hElLQ&oe=6A413A0D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yyx7g0Lw9QQ7kNvwEid2S5&_nc_oc=AdpfOLPZo_csfbPJc7JXhEclvOREzGSsl41YLbLkhiqXpsLDo8MnjvdG5caX4cv1u4w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy96WYsFzDiXWZpuWaFTdwvmTUiI4L1gsjxmLPqqXu23A&oe=69C7B287"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNUDa_2aLR4Q7kNvwGqb3dc&_nc_oc=Adpkho_67RV4Wvjzu6AFaGB1vpzLocFT8tLGaTTXNEb7Y5UcIgkKaF2NVpFbEuJhpig&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVHpJkWAwvakzpXPG3kJ-Ed2bryeONKfmC21ghO5XD0Q&oe=69C7B7F9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Szz9lGFMCkQQ7kNvwG165_R&_nc_oc=AdqBtng65BDBx0ztQPnt1brxrk0AJcDuHo7l0hae9_nPZdWGrsIfdugBfUs5JPOaF9U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8xCCMPzYGaLsmjOqdNoxnEwi_FLVHo1m1P-sjbRAroQ&oe=69C7D54A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEbHSXfkjiUQ7kNvwG8sWTX&_nc_oc=AdreLHExRWvLvpRiRqtX6WwVRy7UUSlthID_3vtPBUC31ERIAU3ZfgehuKwbgNAOJ0Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOrsdMFoKoVf1LDuVVPxt2zpP9ROD2EdY47ZBs-W7aQA&oe=69C7DF9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKM9ZdDfcM8Q7kNvwGSdbuL&_nc_oc=Adrgx95WPjVe24H4ihO-UKeFvSZgPLa7zDWiRm0t7d4-lc2f8DPPcnDe2HJILk0DoRo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdHZYNmuiYB6hEurAI_LIF0gZeL-OBIeopT_E62t01nw&oe=69C7B7CD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
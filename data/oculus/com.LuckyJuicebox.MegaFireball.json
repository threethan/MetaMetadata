.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myncye7iPg8Q7kNvwH1DwuD&_nc_oc=Adrudk9ZoIdbAOYTuzqWaowcOA1eBrrIdhmFL913peaWBaWELUdat4KUy1OVoCApAYc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ySzTYyAOaLT065hQ5MBye2exDDTkAEmH2Mthl2oLgeA&oe=6A32B447"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpHxiHZXGlQQ7kNvwFNAUYT&_nc_oc=Adq8RgsC4rJORiyA_KMg_ZUMQu4i_Zx6hyHsyQfyFlKQQcKbOu_LdgWvUwhTOJDx-v4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O6gs5BOhJRNuyk7TJqb0x9DGFtQjH7fjWxjdMPe70pw&oe=6A32B9B9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Vb2y5LrFYQ7kNvwG8xRBS&_nc_oc=Adpg-7OcgQemwW9jxnm-EGp8rhOLTiVjvguyH5UN2P1oqPVWELkJFmQfhL0PhuxBsJY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bR8b8sQ_yp7sl0jhfyIRgRAk4dRraqENx5nt-WdGSYA&oe=6A329ECA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MimiGG7ISUUQ7kNvwFFf7Pk&_nc_oc=Adrhk2E8VLTIIRniU8QJ0PaIjyAmpmACA-Hexb9-YZ2tlFmT-PU7AE__rw2nk7eNpxE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LY5vhTiMiapIWCFusb_KrvD-20nHQSzaFwl2jRc8zaQ&oe=6A32A91F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHJ2Lrz3ynYQ7kNvwEMzD2i&_nc_oc=Adr7CpqaXnpubMqnQWZLt07TP5MLO7QFOUs44ACH6Idd5cvhiPykCigM-I5mhayQXCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DVagIls84KDL1rMEEffln4nmyhgvI37PHTGF5ImGFMg&oe=6A32B98D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
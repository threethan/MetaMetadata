.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxvm_PZ1lCoQ7kNvwHs6NTn&_nc_oc=Adrody4PiiZnkEk_NfqveRoDJDZHAWt-MF8jrehDMIBEKycPBcLJExEdVnBmtfV4_Mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22xP30ylIYYwwaGD5dt38YFwB3efWBye_2CtBYjd6lJA&oe=69D4E187"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1HT17ke-B0Q7kNvwFJMaIP&_nc_oc=AdpgnLrll0rrhnWJ_wnbRtX-NGfumcbx-il_isAySPUAvLs6fZuhpgL_rjGCtW8fJZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vTH1EUczra0f5boUGW-jJyDLxJX9f8vMy1gO51Di--A&oe=69D4E6F9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDAzfeMLOK4Q7kNvwGp6wIF&_nc_oc=AdqRPQ9UeXu9OZDEtFd-6JLRGs__dJj-9EKpjMhuZptsXUKFPIrfAdpdvbvmCkeVsu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B67IpCHVGSC3fkO5eBawzIQXYoX3o1Q9GO4L8QU0PXw&oe=69D5044A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-1fLNNillMQ7kNvwG8IqU3&_nc_oc=Adr4r91o3wLqP9QRM6aYsRKEeG5Pzz4oAjVip2mv_yFCqVVF-NeAEJaaBZm_4kvf7Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DFAc1Oi7ZkEm3Mc45yufBYjM0c_UEiWDCLpCWG0nMog&oe=69D50E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4xPxQr93cQ7kNvwHOUvYx&_nc_oc=Ado8cV6dfhSCW2Gzs3ZQO0RJV2ARcF9lW7f1fGJwy2kqTwOlfaMg7fBHBHSjGIC11fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T3SQDFhMEzNGup53f1_2fMCt_7HNQojDB3SFThXon2w&oe=69D4E6CD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
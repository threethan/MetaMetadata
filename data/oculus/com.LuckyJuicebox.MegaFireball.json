.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u3Ko3mazDwQ7kNvwEDp_B4&_nc_oc=AdrfxhfllpERPPoakOvSLLlEkn8OIeizKV2eumxEhKF7saKxjLQbYpN_wgd9MUfCXSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFc8tbCUoqzsHUDT1UkhGNzcWgfl9FWD_b7K47YI5-xg&oe=6ACA50C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuMBO3KEeb8Q7kNvwGw-wBV&_nc_oc=AdoLVq0hrUQt1Kq0GbOHLwWVvgDZ_BKq_H4ssDl0Nzfe6arAB3PrmRCTgns83kyqhY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtFmELmjX62W0xHX1yHDHsNQDu9oQTa-FErQmXnod52A&oe=6ACA5639"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CJyyOUG1CUQ7kNvwF4u5p5&_nc_oc=Ado5NTVnn7c0KQipljQGMCZRyY9xnLnDpVS4UR83ekMkjMT6JxyJIR9wSJuDFZMNrbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBwPEW9qR0nQmJLd88ZhTb-2IMuonzete352MF7JtaJw&oe=6ACA738A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED_855kzVy0Q7kNvwEd0s5Y&_nc_oc=AdqEdQgYBJKi3lhQZjMQrkdmaN1uQJCC1gBYDbe8-PlsBPHZK9gfSut_8m4sGImxKQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzne4Pv8C6FarJA8rEmtYzGw05Ci7mTTpeGJPkJxgyMw&oe=6ACA459F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzcc7zvxS9EQ7kNvwE00RE0&_nc_oc=AdqoeqfjG7PsI7F8NOn2kYLbBMPUyQgeL-RiSykNCs7V96lDTn8ZjR70ZUdRztTHSTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN53aU6OA84JfYUqX4H_wW3WU2SrYd_9DH4Mi1eWorkaA&oe=6ACA560D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
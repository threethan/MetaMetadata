.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa50em-SpmIQ7kNvwGLFCIV&_nc_oc=AdpkuQzEtPMRddkj1yLP45x2j0t0y8s9zKbfryM4sxGyOZ4yz8JonEVud8nU1__U_uA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_elHphSErlhVKcow8OkdsdFq5ZbH2z64HebZzh50LdQ&oe=6A1704C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXiQXFYfRdIQ7kNvwE9e7Rw&_nc_oc=Adry8daii23A-VfTcE62-q-7YErOayB0-pmT9zDGnAKmdK-ItpbTrA-GjX-KeWANqNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NNDiMLWIgdcRzLFoSCXSNqIxO7-dHTRoH11TbTnHA4Q&oe=6A170A39"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvZYlbKUI30Q7kNvwHDJ4it&_nc_oc=Ado0L5bper7YuNqgMkaZj_cChbMDUTu5JzzsFgLDS5ECGMWzDwEPU3XCQdQp_BQI064&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DvAhM6vxKLEtqHjmMRM3BPaak-Ycbn3dZN6Me4cpQXw&oe=6A16EF4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjKLJpz5lWkQ7kNvwEo5MdH&_nc_oc=Adq1srZJZf47Low3gfu6kxxuyS55zMf49pRwkf8bDhc3a74a01jYtEWVFvOb03VBb7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6okX0PCHj3TjgjFi4H2XcCSVznj47gDiKPtqiVpFRGBw&oe=6A16F99F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncl3I3C-1o8Q7kNvwGeznDI&_nc_oc=AdpsmoLjh2iDtbkR1JMjo2jcwb4lDap1wV7bwZRwYNn3OuZX5DWOTxc4adjLd2iodzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b__n4LwF8JkXnx-OPnXED203GuN3VGY5DLhHpmE6Iqw&oe=6A170A0D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwBj1kANtf0Q7kNvwHLz3xq&_nc_oc=AdrMFWJbx3ZmlfrvIVJRYckuJCu4_Q5fahqhc134zU3sJEUfv2T4B1TsIA5Ns4kTtRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbAFKHQn7Z_xyVB7sx7F9IfK1FjtSulKf2vIYBv_r1Eg&oe=6A734DC7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JdzKuzu5acQ7kNvwFBSzhz&_nc_oc=AdrskJioOBr9Kij15kHvL2jnQeMyfnMbk6ruwTDQIh0282wN6hSjOd8EMC7-6eAwimU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG7lmuaW6aPVYiKDOeC4Xgun3k23jQtvf20e5B07JzKw&oe=6A735339"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atLHsrdYKz4Q7kNvwFtRM7a&_nc_oc=AdpdkSROfPVC1bNHsiLA9vOFYuFY-V15gf-z-Sa7UuVQ-yvc4eX-uAr90a9uK3j_3t8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8GK95R2B7xrZcSKyDpwMr3fM-JNLwilG3nLmkPtwUHQ&oe=6A73384A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTenLFIdvocQ7kNvwHAixMg&_nc_oc=AdqC8WUe8rc116Dbbp1KAFsRZAvRBEh78U9zQpI-F39uHc8OTfR0BPL9ENdXa9iPOkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDDL7TkuY7-BqVW8ZDfCjvONit76ZO9HdKvEcPo8D2IQ&oe=6A73429F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QduzN0pThiAQ7kNvwGHMqKm&_nc_oc=AdqoCDbIZUUyHYPz14AsGdHoJMstsAyx7rD9e5zO7ePdOoDrt_MIrFxYU1MPHSEaCc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFihjQT--31zY9lqfNuPs1DZ2BcHLw4wGgLwtavYsOdkw&oe=6A73530D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
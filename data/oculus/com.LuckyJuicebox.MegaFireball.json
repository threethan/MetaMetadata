.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUZdEZ0oL80Q7kNvwGpriUo&_nc_oc=Adq5Vm49P5TqI17D994BIrgHX95tR-49D_EXCrkS0gMj9CJTuucMXWq1DfSA3P83AHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A6SYNIBzxNCr2bMnBoFQ0c4VDxC2sxnO-ni5CoQiBhg&oe=69DE5447"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSH4igGQutUQ7kNvwHcCeSx&_nc_oc=AdqFk6OUSAokeVyYqipeOE89gc11eLAM2_XGrEJj4HTj8tZd-UGwWG--dwkv2SASjCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IhETCUtL7Did2WZicVNKELWKJ-hfLd3_FF5i7srs7kg&oe=69DE2179"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzrOWn_cD10Q7kNvwFCvfNj&_nc_oc=AdqBS1OdH2Kidei3vpHreZmiBb_r3RyqOVOzEWgBbhK59EXqi42X6jNAxdN4yDEUQvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kTQjYyUpLgu8HQxpjjNRj6wpTu-Y6JoSTYSCS93PwJQ&oe=69DE3ECA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZo1Z3g1nCgQ7kNvwHDl6zl&_nc_oc=Adpw62FKcTdO_otZWBC742jUdDAVFCiuQhIgUww599oJrePoRs-2s5Bn95PN-tCp9z0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R9dcWP17bIs_ew5yQXU1Ljau_lItUiesdUzLy1Sy8Pg&oe=69DE491F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ookGUDl6TnIQ7kNvwEcelWq&_nc_oc=AdqmQk6s8WomKJZTfoyr4fOcbSFLAjYIgv8r7eNWyqwZGszqwIYCAJ32dMKlufZ8QsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XzMJDp2m2GcLwt1N_eCUZwaZaGJ2D-V9gBtusD69ocw&oe=69DE214D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
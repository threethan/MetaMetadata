.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV8UEibmmdgQ7kNvwEBND7e&_nc_oc=Adppery1S3qR3eyq3LKGJ34xBrJCbbl-pzSatj_2nSPqpyz4EvDSxI06tjN7q_0oSbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy-xWFsKaHBNjMJfzogeQ4hs_1Fn7VEISYF5LsUf308Q&oe=6A92B987"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeCxps0xCOoQ7kNvwHe3Uce&_nc_oc=AdqzRavq3VFhoT_IFM54syummsms7zhjPBe-Mqqxi-HCkjqRijMIaPYxWxjywivxZPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8H5v8L4FH5xmZjh0YWVtlFXrO0HafTXwkWq3CyktBXA&oe=6A92BEF9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auF9bZIZdtQQ7kNvwF2Dbw6&_nc_oc=AdocUOhcKsdPR6iT3QdeiKPESnBiDFj8IQJTd-wz0i1PXKWb3OidOVqlKIVLwt3m4oE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAbsQyeNXQDnEB9VPa_MlVUHTmfzD4czLiCQu87RCmwg&oe=6A92DC4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZLv7-8e8qkQ7kNvwEhihfm&_nc_oc=AdoBNVV6ytiYUwPoxxx1rZnbJghqWd1wfcRExgZQa-aXrX4J5h8xGUupVghK2gEu3FM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbR0tp3k-4TlNJAZgzoR9OIZFLZ5ictNcpr9pJztRpzw&oe=6A92AE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU_fhg3UqOQQ7kNvwGoyI8E&_nc_oc=Ado8M01pXgwOs_quSeLvbQEgQE8eJf2EC157w95BWJdllIiQt3M5Fr9K--P5jFcHn-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs9BjhFggst9emsNgzxjGvjxVBkSGEcCyPuK2mTZ-8yw&oe=6A92BECD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
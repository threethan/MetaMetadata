hTfPMl-qGkNhKF4GJYltwglg&oe=69A02587"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljqCX0olWWYQ7kNvwGsOabL&_nc_oc=AdnHc1WEnQUatvb3la5R5LO9HTlrKuuXQLMNW2TnSOF7wbh7EVK4F7W4V-xYoxk8-68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftD6O_M_0pPGE91OU4Gj-vWzseUUnx3POx9dY2gKk5ezQ&oe=69A02AF9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tIK793S10MQ7kNvwEZ4cGC&_nc_oc=AdmoGF4z3LzAJKK8aTsvaQQac_LIfPZ_JDKahx6AuN_dnww8HfAo8FpHkxn4KHCnmy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLSlWz6zD_KjjsqEPIR8KCl5lO9xGmvQ9V2IvXUWx_hg&oe=69A0484A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSy5nHFN0AIQ7kNvwEb7z93&_nc_oc=AdkEiiWSpZM9GC81Q0wjvHe66zorNbsvccPMDIWHJt007jl05Z0oy1RW8HcP5xvgcKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdgWwYeBABIsb5PW-1GUfKiMQ3QMx97qMxfKjoEOVotw&oe=69A0529F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYWieyuux8wQ7kNvwHZWbnx&_nc_oc=AdkW6GQkX7XM5pnK97HzzjpTJLf2U6wR0p5udI9rwCGTj9bUvLlp4nHKiQ2DS5K7RBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-N0j7Bmdg4phGhW96wwodt_aXuqRUhKuOsdy9jIkPTQ&oe=69A02ACD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_U
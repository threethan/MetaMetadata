.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9TRWlfptN8Q7kNvwGL5oTX&_nc_oc=AdpKENDa0HqOcGgyUD8CzAUa7gY9WDOpT2BWZkz9KwrdyldPvX2MrP0X9D-ghyaI5SU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYad9BRfbo9qnciHLoV2Ce58RJZwnfAb9DKwAc_wYrvA&oe=69CFD3C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-3_pWEkATgQ7kNvwELKCIu&_nc_oc=AdpfO00z0VKd2tqH7a37ppeohFuLt2O6D2EAdq9myCLUuuILMMA4PxNQKl3wFljddWk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZNDIFlcaPNfh4yGFBJrEVXJv1WxlibdwqxZiEx1AlDg&oe=69CFA0F9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvfis0_XhsEQ7kNvwFCdpJw&_nc_oc=AdqEZqt4BrmK5tJkOsh2r-ra0neV__FSMcL-HBieH69FeV69odSm_YUTXovNqnEhoa8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVEwBlWhyrPwVYrEfKSW1ql4McCAeK3u_HaSNFq11vaw&oe=69CFBE4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-uDCz7VY-MQ7kNvwGOg75w&_nc_oc=AdqqEIXgTpp6625eNLGuwqnVp3NnlH02WwdffWJ78dzon7N4ywd_njZfb461KB1shWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzgw9Ukg8vlYLRKfwkF2JAqLW9YcZnFMAahuH48585oeg&oe=69CFC89F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6poHQ2jvlIQ7kNvwG15Iyz&_nc_oc=AdrMJEZwYRrWqxsM5-fpBDQcEfuvLkuPlDXxwxcA3cmRFtuvaB5Df55jhV-WvrvdCps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTCwVwMzL0Lwz-Orim9Na1DjZZGc0Pq-gEYHxebJgVTA&oe=69CFA0CD"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
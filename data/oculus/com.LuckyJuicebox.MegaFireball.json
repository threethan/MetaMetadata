.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6j-FKx372sQ7kNvwGCCIEG&_nc_oc=AdpNTjC3pHN_KGO41G7lKZrQCw1UEv4Ks6YkEna0hQtj0iAnPw-BMPKw42iG4-0-tKw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTRDDO65-QeypFNpWg_95a2gFetq_vb8jkogXCbHJt5Q&oe=6AAD4FC7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUTER__5xC8Q7kNvwFON_es&_nc_oc=AdqqthvBuVQwrVHh1gT3n1Pu5w5pnabXiYSwmP4YqLQeW6LnfT_x133-sh9YzJ8-jnY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzzru3Gb1HDapsFMqvcNUzOAO_VuQSaaYvOH1E9Ei9Dg&oe=6AAD5539"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2KKPVkx5xkQ7kNvwHyaR9y&_nc_oc=Adqlcopgo_VJNRmosj8FpGj8OCp9rYNoAcAwP4UGS3O_dBYvCHi7ZoBVjHAFt42xV6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINUVGHGTBHtdZk0rR65jUiCDicmE3IUJ7lGmZo5Zc-Iw&oe=6AAD3A4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoxWW_KIIRYQ7kNvwHZIItl&_nc_oc=AdoKG0TnGjIKugAnRO5CbWWkrwKqJxL5H6oc2bZh0gl-ADc25XCV21wERG0XgL4Ay6s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_vduoBEi4Ij_-iqJbxYi_kCzNVe2Pr5VJjGfOZgE5Yw&oe=6AAD449F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbCpOA8ECPQQ7kNvwGaZT9V&_nc_oc=Adrciv60Our8RladWWT6xaq0Ip_IKJCV_6y2TgZQZcXHstt1c2A5xI8TeHpLtNKqmxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1ixbujxrhR90Fv421Yr4pq0R-UR1jT5okoO7sQrW50w&oe=6AAD550D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
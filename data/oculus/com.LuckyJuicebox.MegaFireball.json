.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exo7vUw5M6oQ7kNvwGvGqCq&_nc_oc=Adp4HFlvvUnIDTI8sLXc6E7ws5-Z7Dwj0d7drMIkAkBoh8hW_8TV7TNQrlYM8CxiQFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jFHmvCDpZ6jyutjWWCwpyV6kXld05gYrc6uHY6dmOEA&oe=6A47CC47"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1hWMWqj5SoQ7kNvwHJdgSX&_nc_oc=Adoklqa5rzF6nN41vONCEXYc1kfCD6Eit-LxfAdhOfRCkwp_zp0lzen1IaYVzhPBGSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d0bFbYMNjzPkPFAkanQzy5JVWKFa1sREtBPMNJ-mBrA&oe=6A47D1B9"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyJq515qhO4Q7kNvwGpTRnz&_nc_oc=AdoII2aAyYchQe3fy8mbKj8EA5XvwDxE1KGC0zfVZmkTRTt3F3cF1_VLbAbV6Dp7cd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vbyxS__IXpq7FlqQYXgAkgoBz2SxvPwXd2KwuEdPezA&oe=6A47B6CA"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXLx5wjzSjUQ7kNvwEgzDs_&_nc_oc=AdqFcuGxPQi581HUr8WllBAW_f3aDXZHtkEEkeH4H9LUJMvCg8WAlaxsh1psLfpo-6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XcEvDdjJtMWNOw-T2i8YBWUyDRy1wGkgyq9s4q11OkA&oe=6A47C11F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePnE44sB8MMQ7kNvwGTaERP&_nc_oc=AdodNnIQRyCVuqiQe-4nnd_gAlLIk3oTUWDwWdFHhytG8zib_4v5T1dpbGg5IGwUExI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ddh2MRjvPpOSHXWrqNiZ-ENaGlXNUax1qdpWZliUHxA&oe=6A47D18D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
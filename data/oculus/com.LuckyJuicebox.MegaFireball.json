.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xl5eRIypiAEQ7kNvwFghaKB&_nc_oc=Adqo1MNRfLNKHJCMuc4HO8_VhMxCW0B16FiX99c5KtSoHgCKBKgrzxH8HAb3k4SXJqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgytaJ4rg5_2sr92i4KEdy0FT25xYvXugE2ZXIhLOwhQ&oe=6AC267C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeSXUIM-3q4Q7kNvwGu0PPC&_nc_oc=Ado9ijFy95qlxHk6hb7hRv80sloEdRCPHJn8zk9aO0pDirdqnb9nHTkL7uVipo3p7TE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMurvw-0YYl_5Pzw9DEDVqo9YblzP3XxaTOlnaE7Umt9A&oe=6AC26D39"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY1RH7NivkkQ7kNvwG_i_2N&_nc_oc=AdpJr3b3dQSwhug-l5SOdjPvJ-iAb1YBEbfMSman4FYiBY28v27qT9wkGSlA4doxa6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1Us65sC9TGq-BnsyEf4wkPPgnKUmLUK7JN0xehgrw8g&oe=6AC2524A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMUlUqJb41IQ7kNvwFfuVCh&_nc_oc=AdqnIWNmT_Jx-o7OY1DHVS3ZN3lfJFk0Lootsfi3wK-6UQI4TJNF2ETjxXox7EuBqQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxubVJPUwZwwsAP67b9nx7DssAMKTEY3YuEvCF1U0Stg&oe=6AC25C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYLN9avwd4wQ7kNvwGWWTQP&_nc_oc=Adqo65LbxGMrkLyj0OnLj4GyzECIL4mkChLnoYPV72POx6GPcRzzNe6oC5FMVCTln7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrQJqNoKEYU0RsZuxh1g09d2zFWGjSYwctr1uBYqZJqg&oe=6AC26D0D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
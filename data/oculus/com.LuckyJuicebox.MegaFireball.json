.com/v/t64.5771-25/39035398_244063665460391_1875690423852693327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4buinysZhDUQ7kNvwHpr1h8&_nc_oc=AdpiyexGqt6mHkGsNowdN4TNzTVCRgPazxi-fmmIqgXSVGiBOvKkAyqyeMeH0Y8tOoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTqm_BFlhiFUBCd9p4KTIVkCFSVWAYcLoKHFizwD5VJw&oe=6A4BC0C7"}, {"file_name": "megafireball-screenshot5.png", "id": "454191083694208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036604_454191087027541_1520264469949419060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuA9FsXylXQQ7kNvwHVUtEy&_nc_oc=Adr504E5dWtXY4LxKmpP5ztOwVbfrw5RgAXwhvmNGBszfXQ7b_M0dnqGWmqb0t6QMRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaeZ6YfhLEXRvIF1TwIdoyvJQd9EdmywrA9QWss_MlPg&oe=6A4BC639"}, {"file_name": "megafireball-screenshot2.png", "id": "808615271128686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031550_808615274462019_725203892941569946_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFgnmzuOCJIQ7kNvwH5c7qv&_nc_oc=Adq7RVudLYuK-yXhf6UyfVyP1po5AbPf6jnFlfJo8rO8zuyeGyszforujuL2ezHnWhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCukYNbQnbhuzWuL-lwTP022Vmlf9zWGRO4jjWDeMpLDQ&oe=6A4BAB4A"}, {"file_name": "megafireball-screenshot3.png", "id": "1573013316829533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001672_1573013320162866_4797529111027989710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81tFiDWoblwQ7kNvwEeUHpn&_nc_oc=AdqphqvqWEAd_QL2bt4wEloOJxoqk8fLpxnExisrGgoraGMK15vpeH99FltKVsH2FFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkqU-t0GbrjNxScQNPZK_83TuQS4h4BRhVinZveJUpSg&oe=6A4BB59F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mega-fireball-meta-thumbnail.png", "id": "297548626627266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_297548629960599_7897722605495133285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CWqz-8FgyMQ7kNvwGW3__T&_nc_oc=Adp0O8UBdCICZYE4_6uHdAglNpUSOs0cHp5bnyC2xgXo1LSdnpYb_rguoVfKKU3Lg6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAowG1MkF058vsmpICh797e1OO-Wa1qWTNHiO7obS5rIQ&oe=6A4BC60D"}, "display_name": "Mega Fireball (Beta)", "keywords": ["passthrough", "mixed", "fireball", "soccer"], "long_description": "**Free for a limited time during Open Beta!**\n\nMega Fireball is the only mixed-reality game that turns your entire place into a playable space!\n\n**Mixed Reality Local Multiplayer**\n\nGrab a friend with a Quest device and play together in the same room or go solo against the AI in single-player mode. Slap, shoot, and smash the ball into the goal before your opponent to win! \n\n**Single Player**\n\nTake on our AI with several challenging tiers, practice up rookie, they know how to get around any room in your house!\n\n**One Goal, Many Shots**\n\nThere\u2019s only one net, but plenty of referees, fireguys, power-ups that\u2019ll get in your way! Fireguys will spread fire anywhere they touch including the ball! That\u2019s cool, you know why? Because fireballs score double points my friend! \n\n**ADVANCED MODE**\n\nQuit the button mashing and use your controllers (or head) to punch balls into the goal. Or use your left trigger to shoot water balloons at your opponent. Whatever it takes to win!", "short_description": "**Free for a limited time during Open Beta!**\n\nSlap, shoot, and smash your way to victory"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
mBxvACjhnk5soZd6RkvuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVI_pVXz6TNF1en5MX-YuMmdgeLPKRX0x4WZ54Bmh4QBA&oe=6B0F1780"}, {"file_name": "Screenshots_5.png", "id": "3220046074830049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392103_3220046078163382_5658649937183667976_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBVspHM-bZQQ7kNvwGsGZ89&_nc_oc=AdowBS63guMN1lTuumyu0kzegLsC-Ot7XfHafd92yoKSfefa1mdD-fCvL-7AtBTVOaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWzZCHQI2Pp4fbyiYqf2WIoq0x1x3ebghWHL9S_2Y25KA&oe=6B0F0931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1879494485920118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473401380_1879494489253451_1125130068514957902_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWwMQkCiBZkQ7kNvwHpidEz&_nc_oc=Adp3LXW-P8YFemtBUiWvlbruZL9qovSnKt8XXjB6f964J-j5_6SQ_53_AwgXyQdyPdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-50xga3dcssM3AYLWheMWFRDiRP70fAz6aQdm7PZMvw&oe=6B0EEC58"}, "display_name": "Alien Slash", "keywords": ["fight", "action", "combat", "blade", "alien"], "long_description": "In the VR game \"Alien Slash\" you are thrust into a city under siege by extraterrestrial forces. As the chosen hero, your mission is clear - infiltrate the city, confront the alien threat head-on, and liberate the city from their grasp. Engage in intense battles on the straight battlefield, where survival is your top priority.Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!", "short_description": "Built exclusively for VR, colli
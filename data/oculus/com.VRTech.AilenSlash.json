f_b0XAZcoLkdB_Oiq96hwA-FD5zbz7NM74MQcaxp-Lks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWKIch8BfXtB8Jxo8GordIWfvzZoMJol0gKxzQlBg7NQ&oe=6AB13671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1879494485920118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473401380_1879494489253451_1125130068514957902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7vjmk8aMuEQ7kNvwEwI4Wb&_nc_oc=Ado2W_2sxCSoaH_8oV5oQIfibHpkrCXaFhElan8B8G1YWd58MmGijqjRSOZnhcuO03I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgfJ9-f3VewosZJvI8AXWF3Jeh0z7hmRdUJ0DBvtm79A&oe=6AB151D8"}, "display_name": "Alien Slash", "keywords": ["fight", "action", "combat", "blade", "alien"], "long_description": "In the VR game \"Alien Slash\" you are thrust into a city under siege by extraterrestrial forces. As the chosen hero, your mission is clear - infiltrate the city, confront the alien threat head-on, and liberate the city from their grasp. Engage in intense battles on the straight battlefield, where survival is your top priority.Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!", "short_description": "Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_servi
1_1125130068514957902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVFgd9xNNhcQ7kNvwGn_Irs&_nc_oc=Adre0mILNnKEc59Ca7GPV7SW4B2_fK7BNrR82opUU2NWP1QWO0bnnyX3CixpWOFDJjA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTzipRZAPozBt2WZbvHnrrrRkJkYGhbvp5lEu33YT0Iw&oe=69CBB498"}, "display_name": "Alien Slash", "keywords": ["fight", "action", "combat", "blade", "alien"], "long_description": "In the VR game \"Alien Slash\" you are thrust into a city under siege by extraterrestrial forces. As the chosen hero, your mission is clear - infiltrate the city, confront the alien threat head-on, and liberate the city from their grasp. Engage in intense battles on the straight battlefield, where survival is your top priority.Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!", "short_description": "Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_
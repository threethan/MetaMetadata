f&oh=00_Af2xysCocNUy1zMzlkEi_848IWDFt7ryIrZzpa-m9b-TLA&oe=69D39D98"}, "display_name": "Alien Slash", "keywords": ["fight", "action", "combat", "blade", "alien"], "long_description": "In the VR game \"Alien Slash\" you are thrust into a city under siege by extraterrestrial forces. As the chosen hero, your mission is clear - infiltrate the city, confront the alien threat head-on, and liberate the city from their grasp. Engage in intense battles on the straight battlefield, where survival is your top priority.Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!", "short_description": "Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Alien Slash, the combat is limited only by your own creativity. Be the powerful warrior you always dreamed of becoming!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
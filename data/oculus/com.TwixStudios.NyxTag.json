n.com/v/t64.5771-25/499620429_1634521001573341_6842404647820002729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAgtkH_Jm1QQ7kNvwF4yLal&_nc_oc=AdoIhq7ZRtcluQ-ATkhDNPlO50FIeonehPeKmh2LHYTwlg8aG2FJHZFtjLGf45DJrMM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjMe-B06opljCBCZApmDepBgBH8AkZTQEp1Zj3KsvxQw&oe=6AA9660F"}, {"file_name": "CE34ADA6-A833-4029-8087-23E9D110C005_FULL_2560x1440.png", "id": "1014375137636842", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620429_1014375140970175_7360778837754376932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16lqIp8V1UsQ7kNvwHJbfMy&_nc_oc=AdrrgUJoWtzG5yzS0tHK8BeAn0bI8q9Gmmknz9TxA6ko8gXVw6kaqjmhLZMsHyuqWf0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSEpYFqSIn5HLowy4CFzvmKFlFoS0C8PbSBUosev-0Sg&oe=6AA95D43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nyx Taggers", "keywords": ["gorilla", "tag", "multiplayer", "competitive", "vr"], "long_description": "Welcome to Nyx Tag!\n\nNyx Tag is a competitive multiplayer VR tag game inspired by Gorilla Tag, featuring skill-based progression, cosmetic rewards, and an active community.\n\nFeatures\n\n\u2022 Competitive MMR ranking system\n\u2022 Running MMR progression\n\u2022 Unlockable rank cosmetics\n\u2022 Public and private lobbies\n\u2022 Discord account linking\n\u2022 Exclusive Discord rewards\n\u2022 Smooth Gorilla-style locomotion\n\nWhether you're climbing the leaderboard or just playing with friends, every match helps you progress toward your next rank.\n\nJoin the community, improve your skills, and become one of the top Nyx players.", "short_description": "Compete in fast-paced Gorilla Tag-style multiplayer! Earn MMR by tagging opponents, climb the competitive ranks, unlock cosmetics, and link your Discord account for exclusive rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adlerembrey.github.io/nyx-tag/privacy.html", "developer_terms_of_service_u
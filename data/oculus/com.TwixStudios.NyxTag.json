_q4m9RCFAP_ZOeplF2tWb4UgjH_zbb8NS71s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Fsj4C3u2r6Q7s-iZC0qxzLUUm7Zl6C1ewftylQM9wQ&oe=6B099EC3"}, {"file_name": "920A177D-9F6B-4942-AF4F-D4A4CEA640A3_FULL_2560x1440.png", "id": "1634520998240008", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620429_1634521001573341_6842404647820002729_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6TCOzS6YxgQ7kNvwHk5yvk&_nc_oc=AdpWbPMkqkfPNaOmI0GqFjMkxJBHmTJ4orBE9vig0TE0GHXghTWDLjtsPO9J86piqQg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbuAz4IZPVD9MpRyltrjgPPe17jQtdNxQX4CWu2kCqRg&oe=6B09A38F"}, {"file_name": "CE34ADA6-A833-4029-8087-23E9D110C005_FULL_2560x1440.png", "id": "1014375137636842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620429_1014375140970175_7360778837754376932_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpFGb7BNnIsQ7kNvwGaBO14&_nc_oc=Adphi_zxdQXijx0EbeaRKe-i4jnK-HmbwRRugBc9Vpgd_-tqpwcmTxaMaoaxjyVafFQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcUT94_oEHH1RcVQYglBKiWimddDVIa0fnhfoVaRnR-Q&oe=6B099AC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nyx Taggers", "keywords": ["gorilla", "tag", "multiplayer", "competitive", "vr"], "long_description": "Welcome to Nyx Tag!\n\nNyx Tag is a competitive multiplayer VR tag game inspired by Gorilla Tag, featuring skill-based progression, cosmetic rewards, and an active community.\n\nFeatures\n\n\u2022 Competitive MMR ranking system\n\u2022 Running MMR progression\n\u2022 Unlockable rank cosmetics\n\u2022 Public and private lobbies\n\u2022 Discord account linking\n\u2022 Exclusive Discord rewards\n\u2022 Smooth Gorilla-style locomotion\n\nWhether you're climbing the leaderboard or just playing with friends, every match helps you progress toward your next rank.\n\nJoin the community, improve your skills, and become one of the top Nyx players.", "short_description": "Compete in fast-paced Gorilla Tag-style multiplayer! Earn MMR by tagging opponents, climb the competitive ranks, unlock cosmetics, and link your Discord account for exclusive rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adlerembrey.github.io/nyx-tag/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Twix Studios", "support_website_url": "https://adlerembrey.github.io/nyx-tag/support.html", "website_url": "https://adlerembrey.github.io/nyx-tag/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2019850611966223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310734_1448986410321289_5231928195052000232_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzQGCCAikc0Q7kNvwGDbhWG&_nc_oc=Adojba5zIokbpnozbY9MKQToulDhVK792HsB0BtIrx7NUkcfWMu8EKWpa2mbiG_GmDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTzRunVsl2S47xxmBkp6SAPLtyc-3ezpX6Vt-Hwj1zJQ&oe=6B09ACB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nyx Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480
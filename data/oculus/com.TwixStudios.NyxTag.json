64.5771-25/499620429_1634521001573341_6842404647820002729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvxzJIsuprYQ7kNvwHjCc_N&_nc_oc=AdpGBUHlwE-On3VvzB09eqCwAF1NDPuIFEFV7A1df9d-INkYJ-jt3leB7HflF09Kn2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1XgxahYcTiE-DT2ljQT64WB-1dVwBK2XKqu0PARTlZA&oe=6ADF738F"}, {"file_name": "CE34ADA6-A833-4029-8087-23E9D110C005_FULL_2560x1440.png", "id": "1014375137636842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_1014375140970175_7360778837754376932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0mY7crFfT4Q7kNvwFzj6gh&_nc_oc=AdoSYRekTOeghG8ljh6Dsrey0bYBCIrOLMuPgsCEFOG1K3CkuPm9N2M-P3UBElEG5Aw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGdW2JxVxc6kc040kh8hhSEmaU1A5hXTIUPVYB4jMtjA&oe=6ADF6AC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nyx Taggers", "keywords": ["gorilla", "tag", "multiplayer", "competitive", "vr"], "long_description": "Welcome to Nyx Tag!\n\nNyx Tag is a competitive multiplayer VR tag game inspired by Gorilla Tag, featuring skill-based progression, cosmetic rewards, and an active community.\n\nFeatures\n\n\u2022 Competitive MMR ranking system\n\u2022 Running MMR progression\n\u2022 Unlockable rank cosmetics\n\u2022 Public and private lobbies\n\u2022 Discord account linking\n\u2022 Exclusive Discord rewards\n\u2022 Smooth Gorilla-style locomotion\n\nWhether you're climbing the leaderboard or just playing with friends, every match helps you progress toward your next rank.\n\nJoin the community, improve your skills, and become one of the top Nyx players.", "short_description": "Compete in fast-paced Gorilla Tag-style multiplayer! Earn MMR by tagging opponents, climb the competitive ranks, unlock cosmetics, and link your Discord account for exclusive rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adlerembrey.github.io/nyx-tag/privacy.html", "developer_terms_of_service_url": null, "
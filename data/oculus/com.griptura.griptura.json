scdn.com&_nc_ss=7f20f&oh=00_AQFuTv62NBbwYtAJTVlsH2LVeu6wwq1qVApuganG7BkZXQ&oe=6A84498B"}, {"file_name": "griptura_4K_25.04.2025_18-08-37.png", "id": "1735633344038243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820325_1735633350704909_2845436273459404048_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9HU_IjBSMEQ7kNvwG4fxGR&_nc_oc=AdrteJARfGnxBPLsC3bTFFYqad1yILxeWJHlO4Ar8jS_MczQyrLGmPfpHeu39uX7d-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv_ZiZoBkEht8p6x4mOED1PQpg0ZGCO6c24xpAt6Vkuw&oe=6A84458E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Griptura", "keywords": ["gorillatagfangame", "fanngame", "fangame", "openworld", "funn"], "long_description": "Griptura is an open-world experience inspired by Gorilla Tag, but cranked up with a fresh twist. Built for fun, movement, and exploration, Griptura throws you into a huge environment where creativity meets chaos.\n\nWhether you're scaling cliffs, swinging through treetops, or just goofing off with friends, Griptura is all about freedom. There's no set path\u2014just you, your grip, and a world waiting to be explored. It\u2019s cool, it\u2019s fast-paced, and it\u2019s got that addictive flow that keeps you coming back.\n\nMade for fans, by a fan\u2014with love for the community and a vision for what Gorilla Tag-style games can become.", "short_description": "Griptura is an open-world Gorilla Tag fan game packed with fun, freedom, and style. Explore, climb, and vibe your way through a massive map with friends!"}]}, "developer_name": "Keeekz", "developer_privacy_policy_url": "https://sites.google.com/view/griptura/homepage", "developer_terms_of_service_url": null, "publisher_name": "griptura", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vRGZyi8WC6KDxjxZjeMZAE9SUdEkIz_ZHq2LhfQb7E6IlKxs8sB4CjKkJYh8KQR4Dkr9N6mXrnbfzbZ/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
d3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soJz6T1E3usQ7kNvwHVe9VW&_nc_oc=AdmQbGCteITH4yIcyd_T6J5KMcJBuekbP8nYGMF1tU8MxulWf7LdxZooj-truCKu474&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-k9eSs6UYbkRkgffr4NUDQ1JzKqbqqfLIbXLwmPthpQ&oe=69B53B7E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2xKPIoXcz4Q7kNvwH4TCcx&_nc_oc=AdmUFEype4Cr0mPXJldsbzmHjdV1hZBNImJWifpD0kAmM8oy3fdp8TWXF8qJLWVafRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz83cAWuxGTFu-9zce0Yg_djJpSgu9VpuXQSEkcLu4oKw&oe=69B550D5"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgjKm_RdCcIQ7kNvwEuAw3K&_nc_oc=AdlFTljoD92XL09JtNwtk_ekJbYu9cc7XYvoGFPtDRISTw2htZmQmDVcr-lsGIYhUuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuEQwo7c-EW0FD3lKn14fj83OIk9V9Ln8q4Ip3cEOEvw&oe=69B56D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SSfDstZZ80Q7kNvwEvLz22&_nc_oc=AdlAypy_ZoQC9vurOOQxpPxGWPh7HJskMAEIttDToXb6rUKYZA0N0ke-cHig6w0CfVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFutai3630-c3s6HnFCQv844ACyQRVHNQXp17IVAzY1Q&oe=69B54C3E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscripti
42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe75uX0wBgcQ7kNvwHB6yOD&_nc_oc=AdrJOTD0-DKR-aWDA91_57NpcgC8F8iHNunhdcJDEAYdgXyDrqBeFAgenTpiCxfxcmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTNNHwXmfIew3N12EOU3yqNGZAUCPwotJMhsgtILgxZg&oe=6B046D1A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8PJGiQ2_vsQ7kNvwF77z5_&_nc_oc=AdqTj3XeKz3Hc8BjEuBbNIfjxpeLhURRbP2OQ_xRt21Dae5A5ORrAcBvOJDKc3kgpkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc1JRnSjlXCjqVWyH8YHGOhe_2mp3QZ1L1zNYW3JcFAQ&oe=6B0488FE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-4Fg83kAQQ7kNvwGx0elO&_nc_oc=Adq6TI4uAAt8Wmw5reN5lVR-8vfwEkKGaHTUiYL_fzEXBx8JwMTA-EdukQkvEpkjYVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrc_S6mXWmRAewgs5pI5tv2a9-vo6C3csSbFOjBB8riQ&oe=6B046615"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGxLOxPfxZoQ7kNvwE-UJOr&_nc_oc=AdpV71UtKIpJZJ39qHpbDkzNpjBQmigsQpyeLX_veJai9WuGh3lXJMetEyLVWARuLZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGNYEOcMPAb1d51GN3j9HUZOPX16ZtiGIREm6vh_pbvw&oe=6B048290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3kbQSwPoUsQ7kNvwGKEhws&_nc_oc=Ado1bOjEKhvHUfgMoDgthfhpxW3W8myLTTKbHI303LqHx7T6N7rk3OZnMiOmfyer90s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHyBsLS1GFcXi2F1hOxCRWXeZoH_sPLyw41XIf1Qurw&oe=6B04617E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
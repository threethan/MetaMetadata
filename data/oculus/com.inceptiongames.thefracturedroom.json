42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rTHG7Vc9BUQ7kNvwGA0Cy6&_nc_oc=Adowllmk4LX2vvdYHykmI2LDd-V48KjqojnRrB4rsnqdxaU2KkGSCSelGHCMIfoUwGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYq5g8IKWnseBdtTODncTItk2GAM9-rAL36M005WqEYg&oe=6AFB329A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwSu5_kcp-4Q7kNvwHjJ9Ew&_nc_oc=AdoANIpvHHsBGmtvd6yr6pRUaXTtOA_9HIVE1Hwj3oBgIgtH1tz5fm5bxagIHyJNIiU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1K7gxz7eAdVLVE35Daa1FpLmif1abVPib-667TqdZdQ&oe=6AFB163E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuj3C44AZoMQ7kNvwGH2utd&_nc_oc=Adps_11bI7Zzv1JPGIDk9SskxTYyxH4U5eStvt-FQoeCJ76dJHOGZKSpqKiH1kEuStY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK3lE6nQpdc9k4fI4L2vs8ybK7myZWDbdwgrDfviQMkw&oe=6AFB2B95"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEdiZxW4vHUQ7kNvwHrK6yA&_nc_oc=Adrgfozs_-KINCH4-Q6C5o5aaBObqvYVohmes8UTFmbOL88wqUpVOj2qbe4MpS6pvx0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYW__DYws88VrQ3hqJPjG_hFFjL47zZHEOORLB98YSag&oe=6AFB4810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTS6Qv7Y8yUQ7kNvwGUXfZi&_nc_oc=AdrD5rGvoWyKB850mLipZL5-U6fQgrl5gjoCOytKx3uqj_jkTmbE22eCC9HjsDUyup8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmS2TwB5CLxvzIPCb7zbh0kyJOzwlddcOWk2VXRZIJug&oe=6AFB26FE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
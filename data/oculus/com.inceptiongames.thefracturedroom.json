c_ss=7f20f&oh=00_AQMwtM7NDpaibBDfVKJ_o6Rkmy7gyeIquUSWQl4C56-miA&oe=6ACD0E1A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op24wnOn24sQ7kNvwEgpyhG&_nc_oc=AdqLvEoO0eqhL3lf9GfiHzAYDcTNFpPcgAaef7f-FDdEpRMUrNGP1wWxiOnzTzgUI30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrxL0iWreSspObd-Cs9y-LYYpwffm8tR9k_jHxi5GUeA&oe=6ACCF1BE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MClT0LzF5mgQ7kNvwG6mhRi&_nc_oc=AdpMfmak9zBrdoFdGm0EcIaasqBlRYZnAnuMHE6j16tHQ7YVhhrLSmIi-4ZOMUzzo10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZGin_AB0zlRIoir-ZM5FsvGAmFD42fxpcsvA_fJ4c7Q&oe=6ACD0715"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cZfE5od6qsQ7kNvwHQETIr&_nc_oc=AdqgXP2R6PZ_dLfUkt_xPBdOCbHqJkMOU34d1xb9RTIJnm6AWKPujcDbSoTLWuvWXHs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQFjbND_UNwrHGp5LQpyor9eks28JxkZNdr7r0379GuA&oe=6ACCEB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LafzB6FVmVoQ7kNvwFlc-Nk&_nc_oc=AdrMiOc6UEk3hZt_DooFrtb3igThY2YjrxZXq9TqkKK9qvmg-8UFf0-pevBRzVDEn24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRv0J3g24IMUgML6dZRzicaEEr5QvYt7riLZFIwaTx7A&oe=6ACD027E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags":
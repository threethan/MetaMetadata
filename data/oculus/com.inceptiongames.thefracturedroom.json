42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ4OPB5BNQoQ7kNvwGRd-ys&_nc_oc=AdpSFBAYlZqBHQlVmk49K2w7DfYehMe7jTRdpFLnkIUAx6tQpQu0RR8msKScXZCFmwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZy8_oNsTMPj5LboVEiGqYekrcvSLoQNUOgv19y7I60A&oe=6B07101A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLPadoFIs0UQ7kNvwG6-9oc&_nc_oc=Adqe8qSdOkuUv3vyM8Blgtl19dmH18Nc7IMOPpC1Hy8JCVSfaFzc3yZUwQY5OGlfxE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKsRh51e7iRa1Iscnq34TJ8cs6YBZ1pzwt3DYpmUSghg&oe=6B06F3BE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVpF_v4tg_YQ7kNvwH1YyzD&_nc_oc=AdpQYEQg_TeMjxtdKh6TVYJpaxyRmFv9fhZIMcN5F30c7Hp7EPFmFWN8RmZxF1d0eWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF2-wDFsdrq4GCTYr892uzJv7sFCyxXUMbqxkVVLOpnQ&oe=6B070915"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NWrlrKNG5wQ7kNvwGdR-PI&_nc_oc=AdrWEfNvLg8xOyA42mVqQir4DJO5kiWnk6Ra6FEaxx5zdYSZakov0yweatZqocq-BW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK_CS1rVzufM9I9dRcOn3IOwoZB2_QMWdIZQ4Q37C2PA&oe=6B072590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3kbQSwPoUsQ7kNvwENOTHz&_nc_oc=Ado9WCD2qX8bYHILvfl3uQ6Z-wNkK5JVbkscASEndHOSaVAZzIKK3KrwyNIZaA0NPsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4WysN3Gji2UhvYYpWJTxfowhMaTWOTMjeVnH5Jl-YKQ&oe=6B07047E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe75uX0wBgcQ7kNvwF4rmHU&_nc_oc=Adp1HfylVvv0Ohz0aNtBpQ0CVJfmNRtB-2RWlb_3zm2MC7wELUwHLojSFuCKVtf9bWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaIqvrewd6wI3GfNgG6D03BJIPZiFuRMTg87n4Bof4ig&oe=6B031B9A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8PJGiQ2_vsQ7kNvwEhOY5f&_nc_oc=AdrEYNzPXHUcfI3ibYvnciDUkgqFhBKNcd3sMxXgH_ReFB4NeacnlYpsA3v7yE0GAi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0mzSk1aHRaBp_B8QZi0ubijFt-p1BVbkkWZoNDCvVJg&oe=6B03377E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-4Fg83kAQQ7kNvwHpsXAc&_nc_oc=AdpVjK0sFWM7cT8EtOronpiylOYaqLBI3Uc7qr6cD4wY510IY72O64PM_eGdr_kuSzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4iVJ67mKlPLhsIleXl8ZbiVatFhXj-cQAE9MmXmqJZA&oe=6B031495"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGxLOxPfxZoQ7kNvwEaALRK&_nc_oc=Adq1gWiFuwwRxa8TA5feQvkwyG90YAmWObZ8hEgecKNEPPfCu4QF15CK4Hv8AZiACHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjnmn2KB01A1FU-q4ka0VmHV_ElGak4r1VLWwxPbzXSg&oe=6B033110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeePI02Qh4gQ7kNvwHbf2TU&_nc_oc=AdqUF5lAMMAK5zDi9d3dHToj55bjwSm6iD3E89fzvgAZYc4FR5fAbW3WWmjI-P1WD_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv4KWj48ik5QCQTwdud0L1kaFX1FHTki9amA0LvKkBlQ&oe=6B030FFE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
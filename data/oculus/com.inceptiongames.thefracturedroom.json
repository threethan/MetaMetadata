ng?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDpesz7t0YoQ7kNvwHiNnye&_nc_oc=AdkiBveJsqBIqCXQoAnQFQYE6CgWrWVMiQIkmB2yv4b5ylallTQH9cmRe9yHMIkQx4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkfCkNE2ekHfLpLslA53X65YDteVfO-z3hUTYQJsaGzw&oe=69A2C67E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeBX34AquV4Q7kNvwFk8_OP&_nc_oc=AdnXtb0HAd70sKch0B53dhoO57MK_oq5psxHqiH2gyIgG516Q-4TCDDbYUDVVkYQLqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7igAcHGAIo2vMO62wi5GBpvau6C4rUaTyOAjlyFIrTg&oe=69A2DBD5"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-SbHg06oCYQ7kNvwGMB3rv&_nc_oc=Adlc5H8RZqGRXiaBZcJNejuW0uMr63Mc8byOBDMBAVFzwmdPk1Qsu-94C8mO1v4a9vQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3crQxdtCHGlZI3HHGtrUyM_eb4nzC_J98uqOGhpTKxg&oe=69A2F850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CROcx8HOAC0Q7kNvwEvKXKa&_nc_oc=AdkmavYX9P18dV0myKg7ssiVt9AzgRAlYO2luM1L4SRbWVjrDY0F-IJUc4GferwYSyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFdDNXnXRpTJzq5iAx_jdyxYFnYXGKJE9_LiPCeF1A3w&oe=69A2D73E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
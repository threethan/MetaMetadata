42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe75uX0wBgcQ7kNvwHil1Eh&_nc_oc=Adq4jJmfnijSc09sglLByQ4AOW2_fA_EpR7MTgg4TmcmW87_2Kmu-LkmPTYxw2y8oJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-OPiDPGabE_Ll4imfUZRATjRP_Eo9hrDyYAW6-TQyHA&oe=6B05BE9A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8PJGiQ2_vsQ7kNvwFDff64&_nc_oc=AdowQZgtwF1qzcSHBrG17HJC64v1YICGgaI2aQoWK2rT6QB7_vQ0h2djPo-0hzrtDeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDjgg27B6Pma3Qyi0zxX8JI8Q8ZM7aO9h-Txtflnt8Mw&oe=6B05A23E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-4Fg83kAQQ7kNvwHC88GY&_nc_oc=Adpd8uVKyi3CcCBxHJ50x6GxrKoQNqPCMnPX9U1Jx0vrNEG8ZQbxhlHBk9MgpyDNpJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4iVUFJT5bW5MYZoxlNZyRCw5IkxDol05skLSpDxui5w&oe=6B05B795"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NWrlrKNG5wQ7kNvwERqULs&_nc_oc=Adoe0Q7Lr6R_Mk2jfzhvA2rokxvLwpWEycv9Z7HJfu790od4wSWkE5Y_QnAkJ7qK8M8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOugWgrcOC3WZmKG6IuyH_iFxZLz1wGhFQ9axGqcqtYw&oe=6B05D410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3kbQSwPoUsQ7kNvwF7amOY&_nc_oc=Adr4eZ96NryVhSP7zShWOpDQ9YUHfhLfA_mGZEluDJwGo8H5hOyflVV4MiAGDeq2ifo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY0cp71yG65JxO_3DZLMey808giMqRpf0OfHY6rLjklQ&oe=6B05B2FE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
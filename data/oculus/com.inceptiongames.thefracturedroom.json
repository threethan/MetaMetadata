42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vyScb4os1UQ7kNvwEcFDNF&_nc_oc=Adohwt7pTugJbCSDC2LngzXY13J0Z-ureYHXAie_Gb1v6pjSVjh_IzBB0_bL5fpCRmw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUBFRel9-QmOoYxlhLZJjpvVBsiDjVbWrI-dRD6tVfJw&oe=6AFF271A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7YnmNmbsV0Q7kNvwFslt20&_nc_oc=AdpaVtIWfvarSnuyIp7Bm3YaXtZhdnhr3QvmYC0WKs7tFoVlpZab3IMcsdDx40yUxOc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3UM7GC8s5gyFP5ykxZUhcNPffGDatSoTMiL9aKHryoQ&oe=6AFF0ABE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAuupiEHlcsQ7kNvwHWRrTm&_nc_oc=AdreCfYxqRiFNdNyKDwTXdaKJORlJ1nvhHdfXOHPocpu8uwH5o_mZ39urf0jR9YnQAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDQVUeZXYvXhyeWkAKOXY06u62YsUBzLf4vy3TYyDamw&oe=6AFF2015"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUtRQsJu8QEQ7kNvwEXSDL2&_nc_oc=AdpdxkMXQOXIBQlzU6Emc-XnNIRXHuysGZT-7vmjFgBhYwjfFq72qCFZa0u4xLnoYSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDGXBxmlRhVwI2ts27kHlACAdag641cLWO0HrHix0FWw&oe=6AFF0450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-c87OtpZ9UQ7kNvwHJEGT2&_nc_oc=AdpmOvpazwh-ruMZlSNW25Bvya-db6QwfRiTKL_nlgNojNpFvmFl8aap9YrBUFnh9-o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMl0wvP40W0wtn5366uVSsaLV7wmpTJ9efJgpA9186iw&oe=6AFF1B7E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rTHG7Vc9BUQ7kNvwHg4mxe&_nc_oc=AdpkpCfPq0Hg1cq5edYVyLZyMBjWEzb8z0KXBq9X87kIMq8nINM5WZ2HccynksNKIdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPanM_y0qjgzwC5398CdlqQBSOnT9JvtbYXwpOabk_-w&oe=6AFDD59A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwSu5_kcp-4Q7kNvwG8cjnE&_nc_oc=AdqgR3V0a1YXbpsxah9HVo1G3tBpjWstxb9YxZP2h8z0FvkaeMPeTM1MltefHqY-Tlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Bia4vKoIvP01iaEmqbTjd7x9-bn0gPUNkbSIB2jVWw&oe=6AFDB93E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuj3C44AZoMQ7kNvwHBCaVF&_nc_oc=AdoUUdMbGnjmwIdtvh-haP5q5gsJxOU08t3s27RLREkdKl4SK0hfKsyLFR26IcDM14g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS700CfYragul1kSLtVxAVCwrxEEE6cjayRjMEVnpgYcQ&oe=6AFDCE95"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUtRQsJu8QEQ7kNvwHIUFR9&_nc_oc=AdrIVbzZnlybirl1tM0Jd42lNthtyxORtTG98xwqTPBXspB9THH0u2b59-amf3rvVQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgE_XJe6drTGC8uV65x-3D6PeH3x9fihzYgxO6IqnX2Q&oe=6AFDB2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-c87OtpZ9UQ7kNvwE6EbcN&_nc_oc=AdqOFML8RhidPha0usAa_Tr20SPjquyUTgqxpfguK62bpmfO66bOdU3nx2pFU_4pLE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9aizsVh4DJR9KTetEP1MdNWn8l8uYRL2spvNx9jULgg&oe=6AFDC9FE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
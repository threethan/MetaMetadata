ng?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDpesz7t0YoQ7kNvwG_FTK4&_nc_oc=AdklsvxN0JfJYaDui8_xS9uafRs3c965mbhmQb8l-K19zUVOMTvo-GYo0P_4MIun2o0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftK0hiMI15HSWPdjs9V3VdlhSciKltyvYm2t915JOdBaQ&oe=69A417FE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeBX34AquV4Q7kNvwF1G1AK&_nc_oc=Adn65rg-yFGYPpzKqx6nBWbU5AiI5pIkBUgPHkL8TjOYP1Ueu6nASef_lvRPKNQF9mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afum0DgQMpHFqj9M8yleVsFE1vzULPV4zAB7sfXz989ytQ&oe=69A42D55"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-SbHg06oCYQ7kNvwFpkQuH&_nc_oc=AdllFcv3zJPN65ZZdM35uUhXH87xgh452Z8AMyz0vRFOepyH-BH8IOcdoi3FCFgCu7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfviA3-aeHASz-UhD64k_EpawkZOG6sgwgAYNaHVl4Gcbg&oe=69A449D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bgD9rri3mYQ7kNvwH58oxd&_nc_oc=AdlBScgytMc6lbklOPe4aRf2itN9rLoKu6Op1I2ZjoFrr6uKtF4SEyir25pyGTUUDAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvwfpfslPSDHRoCMcNGRLyCzvq8cj9R90v0ItxxXGT4UA&oe=69A428BE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
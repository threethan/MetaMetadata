d5-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jzNStL-1x0Q7kNvwFn0d8j&_nc_oc=AdmiWZmEo5raeZsmCViSSEQW3X46u75KCPc38sGN4YWP7yh6wFkTEe20sGZj4fXPswk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz32XCnQt-5r9mQXLrtVcM1WVWKaIMLDAIBGeSq_Jq_dQ&oe=69B7DE7E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyUzfFQaW3QQ7kNvwGs4kfn&_nc_oc=AdnsCEHU_t1povZmhe1FLPCVoNFiX29kKeu23L7pMXLtcebkxCgTDDh4u_9UKF_4NUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTXCkqV5MPdJnJAfjMNyIGhKWEFCbg5L80mVOXK4ZD6Q&oe=69B7F3D5"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgjKm_RdCcIQ7kNvwFKld2G&_nc_oc=Adkqtlf-KG-gz0XTXjQHY2W9h50sSo3UTTumFGCFidt3jx1landjR1sQXW8PRKV2k7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmVNDBgJci60kdad60e4cp3yqkPD0NL4xwTfN_NjNMUw&oe=69B81050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d3dLDza8Y8Q7kNvwFMjif7&_nc_oc=AdkyLS65xdLmRTn0yrZpMXXQvQVMfjslmIbopl9Ox7-oIXzRpuaEMzg5OdqTPgxHdvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdsPNTEpN8o4YD3c-UWvv_1P5XGRkAD5SK7bUCQiMofg&oe=69B7EF3E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscripti
42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ4OPB5BNQoQ7kNvwHKYTEa&_nc_oc=Adr643iNduN1uFoiBWYXx5btZ_Ph42q8ZpynrB8Wj6ba9GTT3U-Gil83dXRi0_Gcm00&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzsFCabJ3hGf_063_DrLR4imHnDzEfo2PCuPfOMo1mDg&oe=6B09B31A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLPadoFIs0UQ7kNvwHROaQs&_nc_oc=Adr42-hB4YcYdf9GMV4n9cVgDWkWufQFz3Y5uzza7E_GZzg2nHYTfCy1VSLMHF5x7as&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuUEtJwjUY0oNecbqCRo6yJhpmK5-3dYNU9xz30WpDHw&oe=6B09CEFE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVpF_v4tg_YQ7kNvwFrwo3D&_nc_oc=AdqBZTZU78uAH9-gnZKW6HxDJnasRVMz-RrWyHGK9oG9ISk27poY1Vr8P09Omdj5IuI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2QWi3BVXXzgzxgRliqeAgYsnE5-BgRn4-H23rDj-_QA&oe=6B09AC15"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1ke2-zaiMEQ7kNvwFtrt4i&_nc_oc=Adr12D3f_juPmWnZKbxlQ_6qkpD1dG-ysPrAdqbzCESZ3ZTViFryekWEEHOm97PB1oo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQkoJvKkPm5srinB7DT9flpM9-dwCB41jToKqAeLHh6w&oe=6B09C890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVgzAbNNGDMQ7kNvwF_4kxU&_nc_oc=AdoWtJ6P5iF8C02DHNCN3gPlPTyUX-Yb-G6wsaM8l09okQP3oPkdVKVKwkB8EXixrNc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsfC64N2ABBzruOgfC_t-Y6JpO_nLsRCag0jBXpi5BFA&oe=6B09A77E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
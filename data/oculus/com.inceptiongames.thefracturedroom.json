42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rTHG7Vc9BUQ7kNvwFiwEF2&_nc_oc=AdqjQAMGBH5P6wIzZ7JkW0bDvlB8x5w2zX3ha4yOaZg_SIaiHBsqpndvSa0j1NZ2iGc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROYYGK9hxhgn0a0JpDsb6oiiuTQHfI32Q9ZgHsRgI_jA&oe=6AFC841A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwSu5_kcp-4Q7kNvwGUmch1&_nc_oc=AdooQ2MpJrBQY0MEzFHhaTHyRgwp01yLu8uPqkGPF588VRVZVSEr6-PcLKahVumGUrE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjtYm4pHzuIR8izzHQO4am5jzbn9Vamxv8XTCFG_spwg&oe=6AFC67BE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuj3C44AZoMQ7kNvwE1Tlz-&_nc_oc=AdpEmgfOgtT-nPo3_ppu5Qf-D7_pHs-k6E1R3FkK5RRhfSr0qOurUWoLapwNTzACrws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs9ySVpv9jGAHV9mkqWkdLIdq62JkHJ18qQED9x6p9-g&oe=6AFC7D15"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEdiZxW4vHUQ7kNvwHvGGsY&_nc_oc=AdpzPbSlQ2pi75l3cDw9UHvvl9J3q8qvxpLJNC-p3nhe6wJ_L-aQ_0bsVo3DP2ojeeU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDWiozHGr8Yar0uOkAtW8yRbirOQ5ktLJlWTfDkA6EOw&oe=6AFC6150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-c87OtpZ9UQ7kNvwGMQfVJ&_nc_oc=Adq1NQojd8tSaKa7MNnhUGy-x-NTitF1bdWhu_gjd7Knz3gR9aPLWQMWSXR6KdN7i2A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWik9sRy1CHX3Uh1p32S9kXrwSCdnluJowLratAQtkkg&oe=6AFC787E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
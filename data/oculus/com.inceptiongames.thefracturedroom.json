c_ss=7f20f&oh=00_AQNwbmTTg7BKWxG6Y-AGS4FWK6_kxkqRAQqf1UV9VgqEZg&oe=6ADF4ADA"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc_FTKRilv8Q7kNvwGiGkND&_nc_oc=Adpnz1DMUQ5iK_7vU-xXssNkA_xDMe_8t-acSYA1ODMRmWy4FORUaToqQNEJgkS6sz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd9WxRVmul3R1NUzulln7g9YIIe10TND4KDjJj4ftCLw&oe=6ADF66BE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPNDn7LhvygQ7kNvwGnt0IR&_nc_oc=AdpdUbiAKrL4evgXF71t5B2wuovlAqJmgbl0uB-rkImbpL5f0nG1m12Iuyj46FbusHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh3-WnLma1oynz6RMcRq9n3clKJSkBGEUBrJsZSO_e4Q&oe=6ADF43D5"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Am0FQBthyTsQ7kNvwHmf6N-&_nc_oc=AdqpicUEv316VlcqPB53GrJChQ-Ibt8LbUh4_Z7Q_3KdVS_Zj4uPITHTmkd9akmVx-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhzaeLRZp7bPlZSbNaVwj4ICBEKijuzCGYLZPHipIbEA&oe=6ADF6050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fBKUeBiO2gQ7kNvwEKeh9_&_nc_oc=AdrcL4aLJzgkX98Wl5Kz3j4ezl2s55RTaDqyRyADgJY7FbtxnWCFlusy7SQjtDUZS3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_2PtWcw53TcocwDswgB8-bJd7w8V4G_9BFiKpvDZpKA&oe=6ADF777E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags":
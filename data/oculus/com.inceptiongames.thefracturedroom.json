m&_nc_ss=7f20f&oh=00_AQIE2g7MAnlECBF5PDPjjdRrEzxnOD85plv4IXMVSIm-Ig&oe=6AA93D5A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R4Tk4NtiLIQ7kNvwFu2nWH&_nc_oc=AdoK3sDS9RckfvuP-A6ycbyUjaybxgu6bJnDqyOakdLLj4AL7478w2hAbnoqNQz3G5c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSJvlErzrxALkAaM9OGDzJ_tokqlx924YkA6PzMfUysA&oe=6AA9593E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R0aXR-OYWIQ7kNvwEal7U3&_nc_oc=AdqERLXUr4omrYP3kIH4H2HG8V2fjbT0vIIqvM0JMsYdmCaTadNi_gpf-cFGagxpb88&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvpRwXoFyjB0aEUYYPPZJdoqH4mBpI5TdrJ8l4dISGqQ&oe=6AA93655"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmDhX0F1YOMQ7kNvwF-2hSk&_nc_oc=AdoPQwNbRC0G7Z9nJo_YY-9wgw0MAPqbmrHWCK7nKkAeorwJoT0e2FeLSMGxvxWajSg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1HQnTZD-O2yrS2gaw5Wt9vCdEEP3Eh04JPtzsfzr1Rw&oe=6AA952D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT1MuronFLgQ7kNvwHlqRv6&_nc_oc=AdpLIHv0M09MBoQmAhBQKRm7yj0Mz5WBWO6Z-GSuD5BUk5Op8BPanL6swOuOZuf6myw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGHfN9OuX2ZNslkBYVJKTGeL9sZkDHQs74xHBxjkV0Rg&oe=6AA969FE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfor
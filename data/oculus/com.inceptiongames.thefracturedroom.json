c_ss=7f20f&oh=00_AQOwcRItp1x8ysoXLLCxzZoM6eZajI92HTbCyjtcHEjUtQ&oe=6AC5251A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj8rzrzX-zMQ7kNvwG97FeM&_nc_oc=Adpt0NFmtACEZH_4igvf7UVTgtqOLztLf3m565W7Yp59godt5bX1rxygMAw9xbW5cOk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf_cYYY1V3-zt5L2BAR1mKAJGCLVi_KfBFSZKc2Bi4vg&oe=6AC508BE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjwBM8V44jMQ7kNvwGqXgbG&_nc_oc=AdpTCXL9AyXdcuSUKym2M6bkQM4AIKQjNZH747lQsIz65NPusQmgAorYB0r3uivZoz4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO83AzFpwLVYSXkoDD-MH79p7ZDn7q_IM607Umq5sXFLg&oe=6AC51E15"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIBfra02vGMQ7kNvwFvQpnc&_nc_oc=Adrjn2wJ_B6xiG-Xx18h8QM5q4rilHv2KkVY6CiQ7Mc-jOc5qNrp_M7DL1WYlRy-q34&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1fdNvFe2B3tfZ-QbAz6r2Yfhi5vERYT7DI_nq3ug0IQ&oe=6AC50250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zcizw21CBtoQ7kNvwE9CfUn&_nc_oc=Ado0lW3Sk9WnhXIMzNY9M5iSinug0qyID4moTR9xm0hsjPN-8DLCM7Xfo69y4MgThkQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP47kM9lG1d4PXc8pw6anO85cwHtfwXkVCAn5NAHZkZ8Q&oe=6AC5197E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags":
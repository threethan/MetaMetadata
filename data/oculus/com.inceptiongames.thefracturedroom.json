42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vyScb4os1UQ7kNvwHBC2y2&_nc_oc=Adrk0ITRWzLN827R82zONED0ppr3nxdZ-8R0L2KLJ5py95djfxHYWK-3nOHLyKUPQ_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2aguk4Q8plkdg56BjjnvgyOj3Y-o_WDHlplsA9kYUyQ&oe=6B00789A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7YnmNmbsV0Q7kNvwEUV9-k&_nc_oc=AdpllYx2WVh6reFAeXPSSIi2woQWX0GkE4bih-VlAihiugR0mpJRN7x3tUCUuQFHYzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlyc5ymkGhPnboiV2UDbYowZCLv_SZYE8uLpPzbyDHhA&oe=6B005C3E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAuupiEHlcsQ7kNvwGgGY59&_nc_oc=Adrr8IdDZ3vIn46sRIgEmldbnmHZkBOHHyYFA0IEpXe0BBomIwi213FwOfB4KCgtIUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxUbXSyrzI7W7_IMRuCAgF1TkgpPFefkN4Ziu_PaV5Bw&oe=6B007195"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUtRQsJu8QEQ7kNvwELva1B&_nc_oc=Ado71uVpCnWyu65DUH_LHPSglF8KGLccPE24JqAaoP8Tbd6sK7p0brb1jqulNMc3YAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPlg6gmvOKokAwHFadzBzA3sF6WB9_M_X4biNvgC7xIQ&oe=6B0055D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeePI02Qh4gQ7kNvwE2C-7m&_nc_oc=AdpXBXODjd46EMT3Byqmg_ITbKme0YW2aherImhkwZCqNRp02nqrC1oCmbH065ysSIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbHW0Q9Dgjx8OW9_fcmQ7BRFBg8ObR3wnZqZo3_5IFyQ&oe=6B006CFE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
42463659300_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vyScb4os1UQ7kNvwELEzfU&_nc_oc=AdokuBddqKGkE3uahCSRP76HtvysccvY-HdeXgQNXC9Mv-ZMcY0DBEuNkdNvZv92XK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW8jjUYdsgb9FazF3-vhEmmQ8ImFY7lzwtp0kjYRZMcw&oe=6B01CA1A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7YnmNmbsV0Q7kNvwF8-LM-&_nc_oc=AdpSGVgspUtPyGC_2YPitDfN7atEFSy2xtSRWvyVy8jNw7YKA0L9B45-Nmp_FwsAD88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe_yRgPnMm0HDsl2uRHtmDTNe8Trq-p2y2FWN2hjzjHg&oe=6B01E5FE"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAuupiEHlcsQ7kNvwFU55lU&_nc_oc=Ado65VkOQPXJjTf6pyHasEPlhQVAnD7G3ho18VlSCxmDwERJou8eKeVvMYYZjYadxHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF-1Lg7tXbocFSElULKi3jMpxmH8NhMuEvTXP3vanhaA&oe=6B01C315"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGxLOxPfxZoQ7kNvwEw-Lw-&_nc_oc=AdrGCoGOtqueIKdhIaNZWfF8ZUv7uf15GFTM8u_UrY8ZEwmbTxi-8RtH_XigW_-wZ6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeJ_d0uTsbY1Hoxm_z9uHQISULIwfr701lvzcwKMXrow&oe=6B01DF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeePI02Qh4gQ7kNvwFGzhqq&_nc_oc=AdoH6XhUPNCxwHMRDGXyZ4vkuinvovW08F2HrfB2FAPRrN3LcLV60X0z_7r6NyeooB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5o5fnpcQM-lrIOGuKre7lVRXMo0a4QCIE_-ZSyD6etA&oe=6B01BE7E"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]
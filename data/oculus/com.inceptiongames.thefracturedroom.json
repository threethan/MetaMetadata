m&_nc_ss=7f20f&oh=00_AQJk--aH-8h6YGANNkYKN_2uQO4UjYMr6ddqeSgBr0NyAw&oe=6AA3F75A"}, {"file_name": "flCT48Nu.png", "id": "269180398885752", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MSXfJYMDNcQ7kNvwGXzvPS&_nc_oc=AdoZwri7FcF6s6kBbWqILVB3CiXxuaQx23e_jEWQ1aIBCpSV3JNlo9zth_7tfpnH2ac&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5fKPdpTypB4b30ovHrsYIQ7otA6D8jFztIuWEK7CITw&oe=6AA4133E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuXxUi6NBIoQ7kNvwG55RN0&_nc_oc=Ado95ffVOvd6MjxOb_3t4BB1ivQzclA4mW_xFL5MnN5u6og7uV_a03ATN3ko29KlQew&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxmIAmYB5ue7pTl1fzwYkax3E1b545m6Gf0fE1Rky2vQ&oe=6AA3F055"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nChaeHaKegwQ7kNvwESIu09&_nc_oc=Adqq3Zhixmai6KmR1G-BEXGTU5Gx-nFJAIHZJn_c9qHMRPsYJxIqNuSyOQCwFfSBLuk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItTcRkVk-O6PQTaej_rzHoewj8DnZ1Bj7_FCGyJt4T0g&oe=6AA40CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmObPzn0SscQ7kNvwGF9st3&_nc_oc=Adq2fMNYVDLeOCT0vSCtvlP0oaV7b9PILNHQ5s86gvfKK6E5dR4B4IRlz8204s1BJHs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqoesjGRHAnYWsHHwCQzhFqByeEfcpC703r7qCAe5ToQ&oe=6AA423FE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfor
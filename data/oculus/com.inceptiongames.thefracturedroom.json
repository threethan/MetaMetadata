ng?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOjzeAmoN2IQ7kNvwGfmXeT&_nc_oc=Adk1b-I_zlrgK1wCZtqLeL26QuCiEsITiieZ3npl6uSfZ3E57eAKBNKJIDUw6dr9LSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvb7J2AH-tMUIhyVplPOS3f6fPLvVEx_Q-alBhK5d3uWw&oe=6999C43E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjGMe6SXbLsQ7kNvwEjHoPn&_nc_oc=AdnvOGXCjZYACI1oayE17m8dwhyNI_vL00iCGccYShsJXDbdm6MDyi2QVGtUpGURkxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjHE0-md6-k8aAzxrC_XFpxeUjn8eendSJmN43xS9R0A&oe=6999A155"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97EnvgTZmP8Q7kNvwFFnYlV&_nc_oc=Admdk43xjaq5Qv2ebxNqnNjeWiXE3KKuQGZGsspbIT9-wni09Aqz_dkFbtws819qdrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfueQDgu-Uqq0uLnN9IOlH-PzppwbMqUJa3S4TUW3u1GnA&oe=6999BDD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwk8ugrWLaoQ7kNvwE8cJkw&_nc_oc=AdkCZ7AWihsaWyWHV5lRjNSs-MzElQNA6t86w16qMXD2M57Ep47sXDMhQskVICFPhU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfsJ0jKqFfckiAxQ13LqeUboyw_joUVMJFcBbiYiE2WA&oe=69999CBE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
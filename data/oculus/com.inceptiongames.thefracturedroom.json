d5-1.oculuscdn.com/v/t64.5771-25/75367594_269180402219085_5071484112901127514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFYuXfCxIOMQ7kNvwHbljBc&_nc_oc=Adljv5agOJ5iGyF7aqlQfIDaW67PKUpBZOxo2GpkAaDh7-6266xUPM2UWm3R_Icq6Lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4mYApCHVWGXMRn-bBCawEdTZ0lBCgH5qW-yKm5hF1xg&oe=69AC393E"}, {"file_name": "eQp2qtTj.png", "id": "975283083908945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974456_975283087242278_4518198590339120124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYrJQdvcli0Q7kNvwHIDL_-&_nc_oc=AdleSj2_tAqnQBz8kwvgxnLx-AIk8ZcZq6_IQ87gwXhNyMj2R78PJ3rWbiJUNqP8Eos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJui-H3anGeladBEtf8SWDD_iBFYoeVD2nejmI191Zvw&oe=69AC1655"}, {"file_name": "O0IiarAI.png", "id": "1259275031359351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_1259275034692684_4550966857737375769_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LKtLD5uvVwQ7kNvwGMZr5V&_nc_oc=AdlBboSE2LqHnb-k2Ua1JtCm4-lS8tYXRc0hDxvgii0HzJQqKbH1U71zW7Soz12LW8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4-g3DSIebGVqY9aCjW0n6Q-Zv52kp4wNAkKpco9Yo1A&oe=69AC32D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_014_0005.png", "id": "206354922201907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_206354925535240_8286586925914863711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up8RUh3R9_oQ7kNvwG7IBO_&_nc_oc=AdlXRDtdgwcH-f8zs2ZyGbmbisRDYwmYbnGdZ9X3nMTIEQ2o17Eq4FsRGaNmq38Hyx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZEwXO0Y0_-xvlSTpakG2r0maA0PYZm7WNa7eu2BMagg&oe=69AC11BE"}, "display_name": "The Fractured Room", "keywords": [], "long_description": "Welcome to \"The Fractured Room,\" an exhilarating escape game designed exclusively for Meta Quest. Step into the enigmatic confines of a hotel room, where reality is fractured, and anomalies await your discovery. Engage in a mind-bending experience as you solve intricate puzzles, untangle the web of anomalies, and piece together the haunting story that unfolds within the room's confines.\n\nTest your wits with a variety of challenging puzzles, each meticulously crafted to provide a unique blend of entertainment and mental stimulation. As you delve deeper into the narrative, strange occurrences and anomalies will keep you on the edge of your seat, questioning the very fabric of reality.\n\n\ud83d\udd75\ufe0f\u200d\u2642\ufe0f Uncover the secrets that lie beneath the surface and race against the clock to escape the fractured room before it's too late. Every decision you make and every puzzle you solve brings you one step closer to unraveling the truth. Can you escape the clutches of the anomalies and unveil the mysteries hidden within the walls of this surreal hotel room?\n\nThe Fractured Room delivers a captivating escape experience, pushing the boundaries of virtual reality gaming. Are you ready to embark on a journey filled with suspense, intrigue, and mind-bending challenges? Immerse yourself in the adventure and redefine your escape game expectations on Meta Quest!", "short_description": "Immerse yourself in The Fractured Room, the ultimate Meta Quest escape game! Unleash your puzzle-solving skills as you navigate a hotel room plagued by mysterious anomalies. Can you uncover the truth behind the fractures and escape before time runs out? Your thrilling adventure begins now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-the-fractured-room/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "http://www.inceptiongames.hu/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscripti
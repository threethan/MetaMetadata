ereza", "keywords": [], "long_description": "Guereza is a fun game to meet new people and you can meet the owner very easily. The game also has a discord server that you can chat with people and have know everything about the game so you can stay updated. Guereza also has a map that has different places like Horror, Mall, Zero Gravity, and more!", "short_description": "Guereza is a fun Multiplayer and Entertaining game to play with friends or you can even make new friends in the game. There are fun activities in the game you can do with your friends. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/guereza-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Jester", "support_website_url": null, "website_url": "https://sites.google.com/view/guerezavr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7832265133506250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031427_338409352164018_5249644914511101761_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk4Po7fkD2AQ7kNvwFOOvV7&_nc_oc=Adrh0ONZvm2xDHlnqZzPRZ1GAQF6RwI86seJJO-NOGMAUyY5g5lk-w5RP7VNOUrY1d8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXmU065T5ca5rDIOI991CcJ0dAy4TPb3iVVD-ZNYpZNg&oe=6AAEA372"}, "is_concept": false, "is_test": false, "is_trial
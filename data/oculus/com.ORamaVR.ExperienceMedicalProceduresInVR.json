perience emergency medicine scenarios. Test your psychomotor/cognitive skills and measure your performance with a real-time analytics report.\n\n", "short_description": "A virtual training environment that offers opportunities to learn medical procedures, including a knee operation, surgical cuts and tears, and emergency medicine scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oramavr.com/wordpress/wp-content/uploads/2023/03/ORamaVR-SA-Privacy-Policy-NEW-16062022-FV.pdf", "developer_terms_of_service_url": "https://oramavr.com/wordpress/wp-content/uploads/2023/03/ORamaVR-MAGES_APP_EULA_EMPinVR.pdf", "publisher_name": "ORamaVR", "support_website_url": "https://oramavr.com/support/", "website_url": "https://oramavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "221997584104134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530711_622217442800436_7531261345173566466_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J0GozBUj7sQ7kNvwFRA_45&_nc_oc=AdoIMeqo7IdjLhR8fxNseR4RM0qXC3Opcg6RCKf2IaCjl8QWtMJ2m_-ASqU_IQiMloI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfm9oMghsqiygxCk21HAfGrp9FWr96NRYBQ06s18Y2yQ&oe=6ADE1953"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
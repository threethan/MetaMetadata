5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFnZ5zmvOgoQ7kNvwGAKkpE&_nc_oc=AdrV1UrIw9p0jYv6fCWccyzTiuuCUVgmuOqvNnXMk5L-G1mAd9i-9Ue6ScfIkhA9yN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaAH8x9GBNFIRJZdmvdC4xd7qLITcHuB1tGgMbkNwi3Q&oe=6B070571"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEhoeIvUUYkQ7kNvwG8hDa2&_nc_oc=AdqMIwb9CuP_tG-sqTNBn1KSVbxAidh1iuCARduCSDcmhe4ImoKuIDQAP41gIlT8Qrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaZgu-gl9Je5R83H0v9QLqYS31xstuzpKbd6bSQhP5ng&oe=6B070D9F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDbYQLvfsWoQ7kNvwH_LPDc&_nc_oc=Adr5Vcc-3pkP1nAMWbu76ShsiuaQcxVrUa5uHmuTLryQD9sQPleqTeSWh81msJQdQvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLn3sL94RFRlP3vBuYnKLb_dn4C5aW0KCYcP0CnV91Lw&oe=6B07280F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oczasua8xTsQ7kNvwHd_eeH&_nc_oc=AdpOlNE3QHtZoNBftnxfaGzRDS5fIscDhKAoUbyhJLdULYQ0WHMzmJmZHWJm9FK5Tm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDtf9twS-F20ivDuAqu9ehlH6dBlsc6794nWtsuXPsaQ&oe=6B071407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxNv8oDd84YQ7kNvwFnWT2C&_nc_oc=Ado09NCIQ3NOE6u_OK7OXkbcFfptUdUvsQYMpKNhsUZ0EqlcuRt7v7vXI4Zh8bsTFcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7f9nlOTGx1lUCbOrE8EFPmRYEngiarfuxIB3H2kSZ0g&oe=6B0716C6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
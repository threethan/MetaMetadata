5744875", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j29-4lto1oUQ7kNvwGlkupN&_nc_oc=Adqag9BsCP-o-diwN40RV22V97Qb96ti8AEWbOLTuXZ5PFlwZIZd0jMzD7atdlXV40c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu-z_fx8d1qpYpWOCAHbNBpbdA8Y3Af6uP8aBKSV9Uxg&oe=6AFC7971"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQwnxr2yvXEQ7kNvwF0Cjp7&_nc_oc=AdqUx3_hKELTM148YNMGXjy8wrCvs0pmWBOQb0-DnlQ9k6A7nPAAjNYg1oM4Dxvfx78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTb-ODvKVX3VaYzoHiUgKofsZZn5G3EwPDkE1v8LkUuA&oe=6AFC819F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax_oHU4aBNsQ7kNvwFckgHJ&_nc_oc=AdoMF3BzcR86pPpSu483vj8qArpgToiye61x28bu_r6JgKo6m0altsYWT9SJ068oGn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmmSBZPj18HWAc1LIsFxq2lqYwSIejwx9pOQE_pYYIGQ&oe=6AFC63CF"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK1OCA6d_c8Q7kNvwHCT3Jj&_nc_oc=AdpTYEfNujrsd7jViMXbaSaO8gTEdW6laz5ug3F-qxoIXW1vd9iPTli3hfsEocJqRcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS6h6Neb4_HgKypR2ZoTM8WCASKcbF8Mt_V4Ex6Q0Cag&oe=6AFC8807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6JZx6tBCXoQ7kNvwHhim4d&_nc_oc=AdqTuAAHwfl1SGSrialzJIWy_3xoMeGK0uVdU5j3MWDvU_HtE1K3uqMDOTpUsxzVZUw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEUMKiVI_1BGSicIuhLeYDKWkT8N-3ij1P04L71HpHmQ&oe=6AFC8AC6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
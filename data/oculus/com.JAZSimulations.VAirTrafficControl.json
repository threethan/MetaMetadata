5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFnZ5zmvOgoQ7kNvwGi82hc&_nc_oc=AdozB-U0VnmdeY6c4kItElycyU1NYxeIFLgHEm4VAa3Stl9DdMeiBfkQV3m5pOAeaNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9xPQ5gmwm95beAsrtY_RNxJV9ENxbE-s9RFKU4zldFQ&oe=6B046271"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEhoeIvUUYkQ7kNvwE2FVvT&_nc_oc=AdpfgNtyAYVbek4o3v-qKtCj8SO4WLP6klwsmKRTcrGY_AvL3kzonGzf4Mk2EJWAw-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWASlwWJtxQI1NH9ftz4aKmc93hDlfgbwZK9TkEhfXDw&oe=6B046A9F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDbYQLvfsWoQ7kNvwHyt09t&_nc_oc=Ado2p8dr-oBZP_2e99y19VmNYesaAudascmjY_Rwoasoot8GXjMln3ByxpE_PxJUbVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScdjKje-IfBdudiIJqplD4KwKD71A0zOvkKaFoxH3vdQ&oe=6B04850F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gXn03WPNgAQ7kNvwGMRIsz&_nc_oc=AdqeEMwH8Fro0n4f2WRsYYgmQWf7LgaXpzkiMixgSgrtQNgOideEUfS7-0HvdSPaX2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCx36Us1J8IDSLttmViphtKMhImCxoaIbnB-AHXj1k0w&oe=6B047107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVDuqmuMrp8Q7kNvwGY06NC&_nc_oc=Adph4rKNUpowcHcneSADl8LH-XcNcbU9-knFooFh4RIDgT1Jn_FvE1e82MyNZ_9Zd9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ9JLRy3MP5vcMFPL9XMCznIZsKfefRHt0Per8I-w5BQ&oe=6B0473C6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
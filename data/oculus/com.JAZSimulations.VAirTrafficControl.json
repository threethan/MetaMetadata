5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFnZ5zmvOgoQ7kNvwExmJji&_nc_oc=AdrzSM_FBwWP41Okw7cp4oajJBIyfrySa5_0G97_iZ7h5dcIUPFq2dQ5mroxO-7bmyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV18NMJSOELBGdcmCJxgpkuzzw60xGVVvPhv0BhIuyAQ&oe=6B05B3F1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEhoeIvUUYkQ7kNvwHqVwt8&_nc_oc=Adrh9D4sQMH7PKJghmEWPtazssHCNfGiD5AsJ3i6eCYiW-bLhK06hcp3hz_PsC9A53Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXcMiWdGW3QPBH2NKgG4_jC-91i5CXhvthQ_jDZcllTQ&oe=6B05BC1F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDbYQLvfsWoQ7kNvwErdfTf&_nc_oc=AdqyoeJhrfLWITgPhhLIjSU4T6ptNflcNkpmUpZgRxv-rzkrXg0tictJ06-m_tTjEcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5DRizMnJ76c4PIazkFspX0FYa2A_BqHWJVfRetFP0hg&oe=6B05D68F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oczasua8xTsQ7kNvwF3oIcj&_nc_oc=AdrLTk5bZTLsBe-pCwC2sJHLb1QUJf9KliBAxP2i4E7Cu4DREw-CXiCCYSOqwRz85gs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKYRVswqw-S4_y1N3fiH5BavM23LoMFOotmCB6qhtjag&oe=6B05C287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxNv8oDd84YQ7kNvwEH5jwH&_nc_oc=AdqrF51l4OAG2KdM15t9N6Qs_2II-3JYVdiChFMvT2lhmEPaAJRV0Gz3M7iOexr1DIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgJ6vnzW0fzY6VAOdjwjWV1cqoDsk59W44eS9Q9oU6HA&oe=6B05C546"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
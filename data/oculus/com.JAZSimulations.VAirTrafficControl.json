5744875", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sjp8REAL-MQ7kNvwFMiE7v&_nc_oc=Ado4NM6ZhbRXX8SvtookTWAG7v_jEsgmgQVKVsxZqRC07cqbTEYpPfdgAGuvMGz9xC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNvVb6BhVEXTXD80HcFeI25rifdQNWfMapUFzSVoH4eQ&oe=6B0310F1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1TSER0BLjEQ7kNvwGKi3fl&_nc_oc=Adpw9ZVhyKRylGI9JqRY-sgp9Ln9xzxtd5BNx6tiK3UK96TWkgnQecyTrT3lDKeAg9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkfKPg8lWG_rComqxUPfWQguozijrQz4n9hc9HjV_rJw&oe=6B03191F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPUAVyVilRgQ7kNvwE0AAyu&_nc_oc=Adp92fTB4_b1_Vz2XsQjUuthPDAGt3UPOAOXkEstadgWwxBK327wxrP6mKU2TLw662k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_JnilHSheirwwHEvsrPNHAdE_YpfLVfPg9KNUKapGWQ&oe=6B03338F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gXn03WPNgAQ7kNvwFRniwu&_nc_oc=Adq4tUMRvnyeOzp2Q06i2k0Cy4j4CvciOmas0qx4M13dElgcIhr2Nn4bSIAnRTgao0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTIhGR_P1RjVvITABA5dUHdR6q9aiLfbQut0Emvhi12Q&oe=6B031F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVDuqmuMrp8Q7kNvwE79xti&_nc_oc=AdqMI9yb_eoY4B8u1J6nnohoKHTpeX6virrJ8tp5QJCAmTrDbVZ9QQ6EPIvx6FCbM8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXlTIbxaXmICTo8zNEYn5kwSqDz9zbleNaoKEklQpXEw&oe=6B032246"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
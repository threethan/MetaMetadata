5744875", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Zdmero3QEQ7kNvwETD9Oo&_nc_oc=Adq5i3HN2zmQc1TuJSbCnzTQSRA5OlLmMO5BNm-b277bQqG1_SymmD-fRFHI-3t1OCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-8mpbM7XbyolQHmcadD9tBE8gwYACG4hQRwvBAX-XJg&oe=6B0856F1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRE1VC0NgtgQ7kNvwEDRn5r&_nc_oc=AdoZXuZh6Pzs-BW5AG7cc-9qov5dCSE_yPIF3n_P4-fGavtZc84EymI3PLViUemZzXI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxJi351fPPdhY5vYxHKv9BCuVE1-IeNS_f2K4DQ3uBRg&oe=6B085F1F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXuvBPF6VHkQ7kNvwGmU100&_nc_oc=AdqsIiUcAsysfus2Uipa0VsXIgJ3mAZdEOo7zK3oLxIwybYNi2pcJsf5FvF2r1lQP9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1xEjXAkjux7y1FehxUR4egXLc7mt_BnbC8wTUoRWRgg&oe=6B08414F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oczasua8xTsQ7kNvwGZ6R7q&_nc_oc=AdrPUbjtbOwGXkO9rKUGpuOOY70WCXc3-w37MRzu4Hgh-p0-G0JU6VET8EvftT7iVJA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5JPJt14LfnwZnx0_Ij-OxOWBKqjswCFRni6tZNa993w&oe=6B086587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxNv8oDd84YQ7kNvwH2nlu6&_nc_oc=AdqkvDEkxkus1TjwgxmmBT_VGR2ymR1xgESR6cAeQstpIFmO6U11ljDjsROk0DcfAU0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWcsoW0KQBNyc6_QjTlLLXYZyv-j5yS4G4KrcrKdbwhg&oe=6B086846"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxyqzBRu__8Q7kNvwGOi3AY&_nc_oc=AdrPEgji4kiNQCC-SHeKPSM0XMfj8p_h96MSv5lbzwEiQhRpfkmz0_1CuN37nDb-sls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVSeOMqw3fiq2Ih4h59NZF6OWzO_-0zHV4W-6A_erQpQ&oe=6B0C83B1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngfoHus2ZA0Q7kNvwFjtP2Q&_nc_oc=AdrcMZQbTuvHWMW0Zy9_F1Cj0AtYfdzqHxu02N118HpMfJ35ZcKIJGf4jmvF598PYzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN7q67FebY-sKBZroqBJsUGbV7an91R165ync2Id2W8w&oe=6B0C539F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhDLrvIpyy8Q7kNvwHll2GQ&_nc_oc=Adp9ZYYH3St-W96Xy6p7V45Dob7tTWyfJZ5yy5t6olTOThowqj8Py5JUwGM2XG7R3jQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXb96-Mrba7miV7RzJluJpIldtRJpHHjZrfqMDX6vIfg&oe=6B0C6E0F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdQTZRG_cegQ7kNvwHrVW-e&_nc_oc=AdruLi2jAtuSB5Kep4L8zrtfvjb8sAJD0yHkCh0Z9wlVihmmjycWNiYdE3xPdQGWPa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw1WkqmX1zzCggdw4g73u_XOW5lxrl1C-y__DKDYHyew&oe=6B0C5A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39W230-OM-MQ7kNvwHU_wh8&_nc_oc=AdrucKZ7UUGKKVYQcU4gvcOlPQ57rUyVTtJcaodafvbkhjOUTJnr5Smxja1AhM-JAsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXXtczdb7F9P4--Cc-L06jBo4JUqse4yAc140-O3Bwlw&oe=6B0C5CC6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
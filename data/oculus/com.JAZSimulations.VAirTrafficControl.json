5744875", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFWxY6QpQr4Q7kNvwFHyp2h&_nc_oc=AdrWebH_pDhZXuzFXmuEjNWHy7OllnbhpVsj_GGu4Yv8tvq-K_LHhjfP1TqT4EPM6IA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo0lRqYymVRkGZ8UbDqpCM3geOpIZf0Q6V2JyQt4UfeQ&oe=6AFB27F1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39_ztl8DOQQQ7kNvwHYGYvI&_nc_oc=AdrpEt7ECgIax3HYB8fvYvCH05hJHhroq5ThsS96glkmAtH3C2zkYy6xnec51Hivjxg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSdQwg4l-2aHcyerEgFAx76nTq4lVXkO8Db4tojWRaTA&oe=6AFB301F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn5BmE5uI5UQ7kNvwHOLL2o&_nc_oc=AdrG7Au3p5K8KFakncJYuDrLpmxMLtR_X2PjPIRMfvSxvXzaDBAVJ86jvleshd2eA0Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTovirSn5qoDNoYxRgJYpzBv6i_zu-iMBjHM0TqlzVTOg&oe=6AFB4A8F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK1OCA6d_c8Q7kNvwEMR7TK&_nc_oc=AdoozAc4-srVZIxm8IvCxKsV2n5Qa7aM7WXthwLkTl2KONI_GECvHb8R5iVrKayMbi8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8oneSQrh6bYLVfAxgOe3xvKBRfBO8wJjabKerZ7AKfg&oe=6AFB3687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6JZx6tBCXoQ7kNvwFNUCWF&_nc_oc=AdoGlR0Rot_7BkxQnKBQkQFLjmNSutcGAHIW-CwyxN4J52PxX-F-wAn98l-vG5DTjYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd-ZNwjbIu2rZHnwoapjKeyGeNJEL-8iiZ-fEESwdBLg&oe=6AFB3946"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
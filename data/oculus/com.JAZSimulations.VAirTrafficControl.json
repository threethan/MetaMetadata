5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sjp8REAL-MQ7kNvwFpgbv8&_nc_oc=AdrdkElNbqWacbKJJtaazpxwJfLpaGvee9oqwODkFDjP1N3F5eHYmE27_Z3XnNH_3ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb4AsROP-IAoPzCJUDCXyx2_RxVH3EGEYIOvC9OpgKPg&oe=6B006DF1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1TSER0BLjEQ7kNvwFApwxQ&_nc_oc=AdpUKEGg0bslfSlotROApyEVtPeBIkDhrDngIj5dWQt8hYLa25SeaeDydOSTYD9yr8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS15KfaUm6CJ77p5miNQgL69byhN2zCriQPFhP6szWPpg&oe=6B00761F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPUAVyVilRgQ7kNvwHDJxpz&_nc_oc=Adq7HczDmFPq39CFKj_v4zCbPrFRIr71CUsyqdNS1b63eRDHLqhCtP-PkU8eQ0AuyGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEDYKDvaU-vwUyoAX0wiGO0HDwK3zC_wwc8yYQ1x3RkA&oe=6B00584F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSVz4dYF4Q4Q7kNvwHUP0jg&_nc_oc=AdoVWqsVxltwWzCG39yTLmJG9T7Sgnb971j_W7D5qCoFnRHYiN39KuYuLPL-CFomchY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvxfGsmVzpcM4XiqcgljH8OEYJI6Mm2yzP22JDiMQxjg&oe=6B007C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D551WQfjaNQQ7kNvwFBcHKE&_nc_oc=AdqBNlJB23rwC7tHW-Mov48nv7Uzh7ohHbWxRJSKAh9VO31wwbsz0VVgRvE2nUBpjgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6iwMl0fAyA4e647Fav4RVnQohFRMrDe2n-qGUkzzY3w&oe=6B007F46"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
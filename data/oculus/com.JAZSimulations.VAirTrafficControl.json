5744875", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Zdmero3QEQ7kNvwFN5Mst&_nc_oc=Adpya1EUsnsShxgLlQKK8CIww4aSSal99XBWMNfMGI45vL0me-qRYGibEYbpEfCmb1Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZz_2VV-57CPHlw1Q0JU0n0ODRM_rk50Tw-3A-k2D8bg&oe=6B09A871"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRE1VC0NgtgQ7kNvwEUdzFF&_nc_oc=AdqfgF8tbFokHSvvO0xKNVPivkEP0Q-yBgemk_EaM-GjaBTOMJfHJ2SvBmLGpvJLJoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuzLBvfEj_9wtpQVuxPl9gvIxNn1nC43DrjG4QQ1dulA&oe=6B09B09F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXuvBPF6VHkQ7kNvwF0W36y&_nc_oc=AdrbqxFMdySr1Sx-y19fnuPFi5iWjqwdkZl5vH6cqiggF-qxcRPFTkqCIEv0OE52OxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKetEwiTc-C-j6KKFa8olQEj_iKwdG6ymg8jZx2jUiNw&oe=6B09CB0F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdQTZRG_cegQ7kNvwFH3Y7V&_nc_oc=Adr4chqvJirzhBWJ4YsucjkAb-Uwk_iYnG6lBycb6_3T7v0BT0NsArU9xYOAyVBP8ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRDmEu7S_SpXD4g7KKQ4hGxYfvwaGhzgYEk5vIAeo0qg&oe=6B09B707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39W230-OM-MQ7kNvwHxtLza&_nc_oc=AdqEOPYQAEAfXAA1sNTNCk9yk1iDLVN39nslFNrxWZwe98alfFfZ9s_-sT-igYqn2UQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0sqUD_kuOTRq_ivEjzknlZmbCFx2HSW_F1XGWM_oU-w&oe=6B09B9C6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
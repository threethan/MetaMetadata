5744875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j29-4lto1oUQ7kNvwGDlSeE&_nc_oc=AdrU3ccuevLRpxJsllhNTJLP9Gig7QcW6kCz0rVQLPMdDY_Ej8-TWfgW8ZhpanHJy70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0hHSU_ZKy_IcQTFKi8GdEYpQV97W4hgvMOA7FfiHn7w&oe=6AFDCAF1"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQwnxr2yvXEQ7kNvwHu9Ggp&_nc_oc=AdqR8ZcWvcujfuh30EBKt8MwsCG3D-QuL0AGLx_ewE3seHEEbbkzozJEaNVnxGb_jsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgK9qhXGdu6X_Ij0rgMwGH9dxkz4AmqDbnteozA2hutg&oe=6AFDD31F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax_oHU4aBNsQ7kNvwGQYm91&_nc_oc=AdrqdFTHJzkk8mj8FFYNUFrGj0hQTx25xQRb3OvIw0EyC4DZG1fxq0bivcxcMGEyEIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnFhiLICDyzNw64ME0IgIqkKq6rhEsoc5wNbyaICNNCg&oe=6AFDB54F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSVz4dYF4Q4Q7kNvwHTJqZg&_nc_oc=Adq80hbGOxwBReo_6goIRbGBl-knP_yXeNpAOBm19M28L9Ir8CxzwFFwJ2nYp01GxMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHWYJRfARlu_2tauL11MAMAfC9Ul9XXdUv_P5RFU-w-g&oe=6AFDD987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D551WQfjaNQQ7kNvwGPVT77&_nc_oc=Adp6wcmhnKcTecNHxinBsDcV-dE7ms8yxTZ5QtCow2jk_KIJoL-l3dqs9EAh92cafTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCeI0QSsiuiVZAp-gBF84nDHcxkm3UL_3UBKyTL1V4sg&oe=6AFDDC46"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
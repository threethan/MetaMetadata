5744875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1654432359078208_2456423935098885740_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxyqzBRu__8Q7kNvwHNiyrG&_nc_oc=Ado7KbbPst-vtq-N5AI0Y04ygCgWBVEmrGZgnZ15jooahT8ICakvwPVYO_yfxm1NaLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCCh7n93ohyQl0jPSfbqnywpTIHVPu_EVTpKDFy5BIaQ&oe=6B0EEE71"}, {"file_name": "v-air_screenshot_05.png", "id": "4258965054374592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310726_4258965057707925_4980731664458777545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngfoHus2ZA0Q7kNvwG_21r3&_nc_oc=AdqeVEUqkjQa87capeiMSKZdjFBReqw-qidnZ6V4wlxsFbswgQd-oQFiilZiY4fG10o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUw2pH54ssN0T6GA_wm9UzgCO9xcvnmEhNoWuXUABzqFw&oe=6B0EF69F"}, {"file_name": "v-air_screenshot_04.png", "id": "1252888539507922", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308131_1252888542841255_6342865489303567026_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwNxZhs3nV8Q7kNvwEZqGIF&_nc_oc=AdrxBZaW3FrQtDQ51pIXS0mOYdOpyIutX2QleSwkwgHMBcU2Q04yTgokKQA4JsdfHGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTrRPr0ytustZ6IXP_1_MtFNz7lCxjKTRVAnLgQnHQMg&oe=6B0F110F"}, {"file_name": "v-air_screenshot_03.png", "id": "1603292237668834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1603292241002167_4385772303054165036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4ppGo6CmS8Q7kNvwGY-l3v&_nc_oc=AdrE_Gcby8fzj1CB5TH8B-SLbG2g49_ga-qMGA5OtCrNkBTNkWX4xk6RBWOp1y6z1H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdzRUzOAGSevTtpbZXFOmC1uUq0FYkh4XN4Br6i3_4oA&oe=6B0EFD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v-air_apron_quest.png", "id": "1574514186944599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1574514190277932_9084435520991355324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqDhCQyMsx4Q7kNvwEN9e-p&_nc_oc=AdpuuM4fCZQ6Epc88NpfHLfi2XSPrA2HgvtfnoVpVyz0dfrpE63MljJWeyP3P7-4Rxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVahLFy_gsCG-foaYl_KdUCaqujnILz_F3gzaQ0eFQyCg&oe=6B0EFFC6"}, "display_name": "V-Air Traffic Control", "keywords": ["flight", "simulator", "realistic", "airport", "aiplane"], "long_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nManage takeoffs, landings, and visual aircraft within the traffic circuits. To support decision-making, the control tower is equipped with radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls. Every decision matters: know when to change the active runway, maintain safe aircraft separation, organize traffic flow, and handle increasingly challenging situations.\n\nWith dynamic weather and lighting systems, V-Air offers an immersive, realistic, and intuitive experience, even for players unfamiliar with aviation phraseology, making it perfect for both aviation enthusiasts and those experiencing the intense routine of an air traffic control tower for the first time.\n", "short_description": "V-Air is a virtual reality air traffic control simulator where you take on the role of an air traffic controller inside the control tower of a regional airport. With dynamic weather and lighting, it delivers an immersive, realistic, and intuitive experience.\n\nUsing radar displays, airport view cameras, binoculars, wind indicators, and runway lighting controls, manage takeoffs, landings, and visual aircraft within the traffic circuits."}]}, "developer_name": null, "developer_privacy_policy_ur
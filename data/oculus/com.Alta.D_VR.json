tl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOSdzlXGC2oE6FJ17K4D2mAPy8zbskrt9BwBAgeT92Gw&oe=69C669F7"}, {"file_name": "Reave_Screenshot3.png", "id": "598161033045423", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391728_598161039712089_1530803605652831628_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBPM8zf5_goQ7kNvwEjyrqv&_nc_oc=AdrL7RFXDx7BR_Sft7FZsBIzr9T1ZjBRr3EDrC2i3yyPsPEUrIqeH_cBRGIl5CZYgws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOQYhCT7tg8-2AMBoST-M8gGS9MGN3RITtAZhzRKN5uA&oe=69C68FA5"}, {"file_name": "Reave_Screenshot4.png", "id": "2014378969039032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393107_2014378972372365_6518918714313535960_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ6guZ_xbZgQ7kNvwFoDrPf&_nc_oc=AdrNnWJQsQ6h8iP1Qd1BrTcvm8EEr_Zkrrk-glf0g9ckXW9QOpyygELNWDLMIKxD6k8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4NxCMhivLuoW69kqh1lC7zgKFuS8kH9Ia0ufcBNHZcg&oe=69C695D2"}, {"file_name": "Reave_Screenshot5.png", "id": "666857839057461", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391720_666857845724127_5018520403597665526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rcyr0G3jJccQ7kNvwE8mtys&_nc_oc=AdpPbRt7FRyiutNNwX6yvS8f4rHKpUqFgJnX70r9i_kJjpEtIkIrk40igM9xzXmzWxo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxepNjf8Xn0WQFuQRwtnFLoy2XNjdQiCUNqJPttZSnUMw&oe=69C662CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Reave_NameReveal_Thumbnail_4K.png", "id": "1894121084456324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391749_1894121087789657_5104494200341817448_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezL7BGCRPYoQ7kNvwHS8_7w&_nc_oc=AdoF_YeTnApZAiG2tVUMdF4ts42EKChlK8P2QOxJxxQjWYb6Vr2hVStO-RV8lIRDFCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUVnmZOC2n8lqKEVkzzF9miftsdfEsbsrGGEEz84e1XA&oe=69C6915A"}, "display_name": "Reave", "keywords": ["melee", "extraction", "free", "fantasy", "loot"], "long_description": "**REAVE is a brutal, dark fantasy PvPvE extraction game built for VR.**\n\nEnter the depths alone or with allies, face off against terrifying monsters and rival players, and fight your way back to the surface with your loot\u2026 if you survive.\n{1163833372313646}\nREAVE drops you into **treacherous dungeons** where death waits in the shadows. Navigate the Fallen Bastion, a place now inhabited by monstrous horrors, ruthless foes, and unpredictable encounters. Every run is a high-stakes raid where extraction is the only escape, and betrayal is always a threat.\n{2465875663827326}\n**Face off against players and creatures in tense VR combat,** scavenge powerful gear and loot, then fight to extract with your spoils\u2026 or die trying.\n\nEnter alone or form a three-player party, but remember: **trust is fleeting in REAVE.**\nYou may need allies to take down terrifying bosses or survive elite enemy encounters, but the deeper you go, the more tempting betrayal becomes. Will you forge alliances or backstab your companions for loot and glory?\n\n**Every decision matters. Every choice could be your last.**\n{24156453257361974}\nBefore you descend, **you\u2019ll gather in the Encampment**, a bustling social space above ground.\nTrade with NPCs, make skill tree choices, grab quests, and connect with other players. Show off your loot, form teams, or scout rivals.\n{693082657144941}\n**Master immersive VR combat, choose your own path, and adapt to survive.** Every choice you make strengthens your character, or seals your fate in the depths of the Fallen Bastion.", "short_description": "Venture into the dungeons alone or with others, battling creatures and rival players in high-stakes raids. Slay what lurks in the dark, uncover lost treasures, and fight to escape with your spoils. But beware\u2026 you\u2019re not the only one seeking fortune in the dark. Trust is fleeting, and betrayal is always an option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playreave.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alta", "support_website_url": "https://discord.gg/Reave", "website_url": "https://altavr.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24807448492288586"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1507974337076942"}]}, "baseline_offer": {"id": "1507974337076942"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764871200, "status": "PUBLISHED", "id": "1507974337076942"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25948336708199753", "version": "reave-0.0.15.26450"}, "id": "602472298163326", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5961656013961118", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25948336708199753"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774020626, "id": "26047667924933297", "v
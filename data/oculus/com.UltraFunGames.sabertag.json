_AQGd6lJlA2-n4UEDGyL42tgCd5V7KqIuSXX9Oq6WzERiPA&oe=6A92DD8E"}, {"file_name": "SABER_TAG_16_9_1.png", "id": "3409808592500196", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823905_3409808595833529_8661768386357044471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKq9H-IkTz8Q7kNvwEEzKVX&_nc_oc=AdpAZi-fiMUrd0_DtqmddFeRULs1yKhFqPMTX9YthcDocf8vEHl3kYzNoGH_fIEgw1E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdMawcZMTkp62sXs0zYhiKLZgS_1VnN0-Nxp61W1mQlw&oe=6A92D39F"}, {"file_name": "SABER_TAG_16_9_3.png", "id": "27041608242122013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820387_27041608272122010_7962547080590402436_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qimn5jAkARMQ7kNvwGBjInX&_nc_oc=Ado2wy7mA4l43Y9zb17PuMgz-dotT2sc9nNS0MLBFanVxGB1SmD-M4eqz2V_tjBD_Ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2j8DagMusKu23fuXyXcGX1aljdyrKpqozb1v0Gu2b9w&oe=6A92B696"}, {"file_name": "SABER_TAG_16_9_2.png", "id": "1402660048294482", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830467_1402660054961148_7265098711813766544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnc6vXIMwCgQ7kNvwG1wsS8&_nc_oc=AdrJMdnG8wnOq9zWrKw2ViOC5CHlmFJu1Yy5lkVV9Qgsyc7tdNk6VK7lAHMBGJrpnvg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY-NF5fc4HgfXqMC401AvLmQsbHU3ykTkI9FkBpeAoZw&oe=6A92DDCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (1).png", "id": "964185279701708", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821568_964185286368374_266341210004574788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVSnhEfdosUQ7kNvwEh8tpX&_nc_oc=AdrUiD31jFW9Pzzwj4UayahN0H2Y2M2RkXX3pGDIl53u2SAyy81DbMyrbGsYNyeH2d8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxMisq4V0jWiESbeZn7ug3EgT5lpGvJm_noAxtxkvEBQ&oe=6A92B9E9"}, "display_name": "SABER TAG", "keywords": ["tag", "running", "saber", "scifi", "jumping"], "long_description": "SABER TAG is a high-energy VR multiplayer experience inspired by classic tag and infection-style gameplay.\n\nMove through a futuristic arena using full physical locomotion \u2014 run in place to sprint and jump in real life to leap across the environment. No joystick movement required. Your real movement controls your character.\n\nPlayers chase and evade each other using glowing plasma sabers in intense sci-fi arenas. When a player is tagged, the infection spreads and the hunt continues until everyone is caught.\n\nFast rounds, constant movement, and competitive chaos make every match exciting.\n\nFeatures:\n\n\u2022 Infection-style tag gameplay\n\u2022 Plasma saber combat in a sci-fi environment\n\u2022 Physical locomotion \u2014 run and jump in real life to move\n\u2022 Fast and chaotic multiplayer rounds\n\u2022 Global leaderboards to track top players\n\u2022 Simple to learn, difficult to master\n\nPerfect for players who enjoy active VR experiences, social chaos, and competitive movement-based gameplay.", "short_description": "Fast-paced sci-fi tag in VR. Run, jump, and chase players with plasma sabers in a physical locomotion arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
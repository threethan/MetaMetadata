_AQB6NYEXuBgVz6dt9lBLZJ1Dl_QR8inSqIE6VTRFSX02sQ&oe=6A5B7E8E"}, {"file_name": "SABER_TAG_16_9_1.png", "id": "3409808592500196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_3409808595833529_8661768386357044471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAP5hcLfPTkQ7kNvwEVxJ4M&_nc_oc=AdpKQU1rlfQfYl1CIPE0WTleibU6KxwTG3wxWQF9O0S5fKA_vTKjkRXvwRWREcHHNn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWjAe7cCmO5c5KV6oKptj5HUpnbfSg9yjA_LdfJIMmuA&oe=6A5B749F"}, {"file_name": "SABER_TAG_16_9_3.png", "id": "27041608242122013", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820387_27041608272122010_7962547080590402436_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7vdXKEao_oQ7kNvwG_7WCD&_nc_oc=AdqX0MC1kr09GeAsROyxK8NPJj7yK2_gSwf_2j5KnDLK67vTUZTmownYSnz82p6UOw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_Hn9wiLul5xPVa6govqB4dsOCzC8I5dAM_3ymeWmlUw&oe=6A5B8FD6"}, {"file_name": "SABER_TAG_16_9_2.png", "id": "1402660048294482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830467_1402660054961148_7265098711813766544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4iKI4--FykQ7kNvwFr2k3i&_nc_oc=AdqLcq4y7jHXoLuDTvPYlTL2o820clxx2VB1oQ4NwDo-p_P2tYpLDCnWADlzzHiUyFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNUhT1-I9NA2Jkm3laEd12KeRQqLDD74GvMviJTmQ8xw&oe=6A5B7ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (1).png", "id": "964185279701708", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_964185286368374_266341210004574788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRY_ciN7K-0Q7kNvwHmByin&_nc_oc=Adq3FDzzg5xi894NQQR0DbYUmkH_k5mJsGDvXE1RMe3VyNiRUDRnii-1l4i1yDhCgGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIVXFqgLGkct0uNURj2-j1LBhe0A7pOs07cBt_NXElZQ&oe=6A5B9329"}, "display_name": "SABER TAG", "keywords": ["tag", "running", "saber", "scifi", "jumping"], "long_description": "SABER TAG is a high-energy VR multiplayer experience inspired by classic tag and infection-style gameplay.\n\nMove through a futuristic arena using full physical locomotion \u2014 run in place to sprint and jump in real life to leap across the environment. No joystick movement required. Your real movement controls your character.\n\nPlayers chase and evade each other using glowing plasma sabers in intense sci-fi arenas. When a player is tagged, the infection spreads and the hunt continues until everyone is caught.\n\nFast rounds, constant movement, and competitive chaos make every match exciting.\n\nFeatures:\n\n\u2022 Infection-style tag gameplay\n\u2022 Plasma saber combat in a sci-fi environment\n\u2022 Physical locomotion \u2014 run and jump in real life to move\n\u2022 Fast and chaotic multiplayer rounds\n\u2022 Global leaderboards to track top players\n\u2022 Simple to learn, difficult to master\n\nPerfect for players who enjoy active VR experiences, social chaos, and competitive movement-based gameplay.", "short_description": "Fast-paced sci-fi tag in VR. Run, jump, and chase players with plasma sabers in a physical locomotion arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
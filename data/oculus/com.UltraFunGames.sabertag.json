c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVRvD_pAJVIQ7kNvwFl9c6E&_nc_oc=AdozLXx-8ztcs_s3mQ7kYsldcttc3aBJYJoWdC1_21Sc51LtUGqgq1W_u2qpqzIeOB0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fuJALnTkOwnayg2Ggfyooe7gk5wagNP0b-Ft3GrkKhw&oe=6A32A00E"}, {"file_name": "SABER_TAG_16_9_1.png", "id": "3409808592500196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823905_3409808595833529_8661768386357044471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tom2miu93tcQ7kNvwHVG0jU&_nc_oc=AdoHlEPE62qaoNPBXbhX5Q-VV0jSj9fNSExxaBfveocxw6YNb5789NlzOX-q8UJcuvc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-plx86iuxjWFQV_2YBpjyiO_INHe-4IIZFeqcgJXxEw&oe=6A32961F"}, {"file_name": "SABER_TAG_16_9_3.png", "id": "27041608242122013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820387_27041608272122010_7962547080590402436_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAHNY8CH2w4Q7kNvwGUQpO1&_nc_oc=AdoFg46yRZryc7xV1doqzBGKDzWcOsc8lG5QGw2A5SwCVkhjgqci3d3XdnPSVT9bq9Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O8bcRM4nQJ3UlbvdnAeY16ljgnkXmyxWhkkoh3s-6Gg&oe=6A32B156"}, {"file_name": "SABER_TAG_16_9_2.png", "id": "1402660048294482", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830467_1402660054961148_7265098711813766544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D15wynLl20QQ7kNvwF4amT8&_nc_oc=Adpq7xTZV2olUO5JHBUfy9KTY68xKB9GHBoXUA5tyNADjzz6NEoCTsj5OfT6lz8KmEM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NS-6mmlNGL47l0mGzTFc7DZs2FR9tUDxIkfR3D64YWg&oe=6A32A04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (1).png", "id": "964185279701708", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821568_964185286368374_266341210004574788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rnuc8SMwioQ7kNvwGhDBUf&_nc_oc=AdqRVBaLOY7tii218-ks4uIzrzaJhwDVjj0lbljYyKZR1_QGh2mgEZmnZLfVpSB8_Yc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wqvBffH7Cv2-APeAdQ0NQ3bANn_bAnjHJd7uIcoh-nA&oe=6A32B4A9"}, "display_name": "SABER TAG", "keywords": ["tag", "running", "saber", "scifi", "jumping"], "long_description": "SABER TAG is a high-energy VR multiplayer experience inspired by classic tag and infection-style gameplay.\n\nMove through a futuristic arena using full physical locomotion \u2014 run in place to sprint and jump in real life to leap across the environment. No joystick movement required. Your real movement controls your character.\n\nPlayers chase and evade each other using glowing plasma sabers in intense sci-fi arenas. When a player is tagged, the infection spreads and the hunt continues until everyone is caught.\n\nFast rounds, constant movement, and competitive chaos make every match exciting.\n\nFeatures:\n\n\u2022 Infection-style tag gameplay\n\u2022 Plasma saber combat in a sci-fi environment\n\u2022 Physical locomotion \u2014 run and jump in real life to move\n\u2022 Fast and chaotic multiplayer rounds\n\u2022 Global leaderboards to track top players\n\u2022 Simple to learn, difficult to master\n\nPerfect for players who enjoy active VR experiences, social chaos, and competitive movement-based gameplay.", "short_description": "Fast-paced sci-fi tag in VR. Run, jump, and chase players with plasma sabers in a physical locomotion arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
_AQT3lpybM_ZigKeFbv5MsDySkKGcfJvdgJ1Aqf9ns4KHHA&oe=6AE73D8E"}, {"file_name": "SABER_TAG_16_9_1.png", "id": "3409808592500196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_3409808595833529_8661768386357044471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrmOz3_v-vYQ7kNvwHTeVD0&_nc_oc=Adq9FPLk7FiA5LUgobdVeiIOgcD6F9GciLqW5sv5q8tP0hyH68Gb6LQXTF95bj6p1GI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3SynaYpKyY77UZkoykelZgoMCFqhBJYVuPuXa2QBQDg&oe=6AE76BDF"}, {"file_name": "SABER_TAG_16_9_3.png", "id": "27041608242122013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_27041608272122010_7962547080590402436_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SiATy_qdaIQ7kNvwFej_RF&_nc_oc=AdqTfEjBM3dvTlCSncrVvdmtLHPDO0L5byCe--bRKuU5vAFPu6M9ZgNPISKmUQ-S4iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTACrKneMl4u8zIaYCVFkaR69WEFV2GezFbzz0HcpPzYQ&oe=6AE74ED6"}, {"file_name": "SABER_TAG_16_9_2.png", "id": "1402660048294482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830467_1402660054961148_7265098711813766544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs44oOD-UssQ7kNvwE8nwnF&_nc_oc=AdqAZ-jc_CdxfUmehlsEi2K2taRpmC-T7iQFTCc1qzadsVoc2ThlKHooXA8H3eiGjPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvXGwr7Xp_Ip6Ox2DxA4rWC1DsYOVZzjvuJj-2fOY4kA&oe=6AE73DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (1).png", "id": "964185279701708", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_964185286368374_266341210004574788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1dmsKtcMb4Q7kNvwHDXzo6&_nc_oc=AdrF1Lyx9kYcrkAocamTUKfbZBE9U-rE-KF_n3XPdQSRB_vPl0ppUsGQSVbZeth2wow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmFQCjw_PQVAUAB3Na21BFnrllrZk8rD0lkqAby7jhuQ&oe=6AE75229"}, "display_name": "SABER TAG", "keywords": ["tag", "running", "saber", "scifi", "jumping"], "long_description": "SABER TAG is a high-energy VR multiplayer experience inspired by classic tag and infection-style gameplay.\n\nMove through a futuristic arena using full physical locomotion \u2014 run in place to sprint and jump in real life to leap across the environment. No joystick movement required. Your real movement controls your character.\n\nPlayers chase and evade each other using glowing plasma sabers in intense sci-fi arenas. When a player is tagged, the infection spreads and the hunt continues until everyone is caught.\n\nFast rounds, constant movement, and competitive chaos make every match exciting.\n\nFeatures:\n\n\u2022 Infection-style tag gameplay\n\u2022 Plasma saber combat in a sci-fi environment\n\u2022 Physical locomotion \u2014 run and jump in real life to move\n\u2022 Fast and chaotic multiplayer rounds\n\u2022 Global leaderboards to track top players\n\u2022 Simple to learn, difficult to master\n\nPerfect for players who enjoy active VR experiences, social chaos, and competitive movement-based gameplay.", "short_description": "Fast-paced sci-fi tag in VR. Run, jump, and chase players with plasma sabers in a physical locomotion arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
_AQATDWdOn9vQitgvHHEvlUdLsktZbzr3dIb5wluncCQk3Q&oe=6A56388E"}, {"file_name": "SABER_TAG_16_9_1.png", "id": "3409808592500196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823905_3409808595833529_8661768386357044471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1EpVrSJu5sQ7kNvwF0f5BK&_nc_oc=AdrRezWSLYxTxjkLShy--SQC7WABPrhwEvwKYbK6SQfvufP374xWnIJSAc2vcv11ogM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuPzIhedmn6IbuhTVICnXp9iy_d6ehk8BHOrmKjvb2Zg&oe=6A562E9F"}, {"file_name": "SABER_TAG_16_9_3.png", "id": "27041608242122013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820387_27041608272122010_7962547080590402436_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAeP_AnezrAQ7kNvwHag68G&_nc_oc=Adrdc-LX4n7S0EBmJY5MQlZwsvaDe5RXroSLq6LnlOymbR1aMkw--qMi59t3diaJybc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvwJ-aJiIJhos1weAmiVPT6E4TK91C6IM36Bi6zkoqcg&oe=6A5649D6"}, {"file_name": "SABER_TAG_16_9_2.png", "id": "1402660048294482", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830467_1402660054961148_7265098711813766544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gA90rivOoAQ7kNvwF2zZD0&_nc_oc=AdrLLdvnipuNzu3K3cSKHCgyg2_GzQmxcUu1AQv_CI9mJ4SPG4lRdAvOOz6p7qHqMqY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjNQJIqOMkOhBU_XhH9EVrutgQ0islrrYiiZLA6cjRcg&oe=6A5638CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed (1).png", "id": "964185279701708", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821568_964185286368374_266341210004574788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6agwzrjQ0nEQ7kNvwEJztqX&_nc_oc=Adrmr0JsiNN1KkR_NUfV_uWhBhKpqgfzIdfepo_2sU2lF12qBtGNWzzc2nFTv_q5gJI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzl15gbYC4ijgCshR80Iy1j5fhjvRFrdQI_4rIVg2eUQ&oe=6A564D29"}, "display_name": "SABER TAG", "keywords": ["tag", "running", "saber", "scifi", "jumping"], "long_description": "SABER TAG is a high-energy VR multiplayer experience inspired by classic tag and infection-style gameplay.\n\nMove through a futuristic arena using full physical locomotion \u2014 run in place to sprint and jump in real life to leap across the environment. No joystick movement required. Your real movement controls your character.\n\nPlayers chase and evade each other using glowing plasma sabers in intense sci-fi arenas. When a player is tagged, the infection spreads and the hunt continues until everyone is caught.\n\nFast rounds, constant movement, and competitive chaos make every match exciting.\n\nFeatures:\n\n\u2022 Infection-style tag gameplay\n\u2022 Plasma saber combat in a sci-fi environment\n\u2022 Physical locomotion \u2014 run and jump in real life to move\n\u2022 Fast and chaotic multiplayer rounds\n\u2022 Global leaderboards to track top players\n\u2022 Simple to learn, difficult to master\n\nPerfect for players who enjoy active VR experiences, social chaos, and competitive movement-based gameplay.", "short_description": "Fast-paced sci-fi tag in VR. Run, jump, and chase players with plasma sabers in a physical locomotion arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
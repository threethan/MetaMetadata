YxA&oe=6B030E42"}, {"file_name": "Screen_Shot_1.png", "id": "3788540308113354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_3788540314780020_6776121826638983113_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHyJkIt_FkQQ7kNvwFubOCi&_nc_oc=AdqqUiUyo7pZ4DtNOqo_TGCLVO4INtb5RDDXQBNOKtvVxoCxZS62RkbKaoA6Fq7mRvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo8h-brrYM4Qb_5p-vhbiYOHAkDNpnr2P20PMBbA2TBA&oe=6B031E66"}, {"file_name": "Screen_Shot_3.png", "id": "1589540415981286", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313074_1589540419314619_2099124498997540841_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0UeJRydVuoQ7kNvwE-xPpV&_nc_oc=AdpnoBSg0AFgHM7ps-XAKBwyonUlAthR9t0SHl4sAEDgFuUoSxNsGIU9u_0KkBDIwyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK8KucnF_PjBLlIJlzCPtNNzJ9mZpGRsjezQn3civBHQ&oe=6B032D49"}, {"file_name": "Screen_Shot_5_whale.png", "id": "1542985894262513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296236_1542985897595846_1522520736840960551_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh36JfVkIgkQ7kNvwHaqYh3&_nc_oc=AdpyNCgSPqFMqVAAwG47XKevEh3knmqmHHXZwMHDGpCNNMgaESYgkIz3WM7guLgFun0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVrk1hxCiw2gX3vwJOpYehK52XRTaxtzOxVVTcB1J8Eg&oe=6B03134B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1274022617267879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295661_1274022620601212_5198477169058522209_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyYVNXyTdtYQ7kNvwGMUb2y&_nc_oc=AdqelMdeoPzKr8E8Uha0TnqpJIdh97uroItZC2u64bklRJx6yeyVZHAxbRnyIP1Yg8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbx5KowN4xy3Dh9YG_xQ0Se3XBheK19Zld7uX8MrOtAg&oe=6B031595"}, "display_name": "Bubble Zen", "keywords": [], "long_description": "Float into your very own personalized bubble of tranquility. \nBubbleZen is a serene meditation space designed to guide you to a state of deep peace and mindfulness. Leave the noise of the world behind as you craft a meditation experience uniquely your own.\n\nImmerse yourself in breathtakingly peaceful environments. Find your center in the gentle silence of a snowy tundra, float weightlessly in the infinite calm of deep space, journey through the serene depths of the ocean, or breathe freely in the open plains.\n\nEvery element is yours to shape. Layer soothing ambient sounds, calming music tracks, and positive affirmations to build a soundscape that perfectly matches your intention for the day. Find your rhythm with our mindful breathing aid\u2014a gentle sphere that expands and contracts to guide your breath into a peaceful, meditative state.", "short_description": "Welcome to BubbleZen. Imagine a world of pure tranquility\u2014a serene escape made for peace and relaxation. Customize your music, ambient sounds, and effects to create your very own bubble of calm. Your path to inner peace, designed by you, for you."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://mirarami.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
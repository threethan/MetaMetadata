K5A&oe=6B0702C2"}, {"file_name": "Screen_Shot_1.png", "id": "3788540308113354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_3788540314780020_6776121826638983113_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IDROaUD3FUQ7kNvwECd1ai&_nc_oc=Adox9jHNkaB_2EuLPh-85iZkhpMTI9ItxzbIKs_EHJ_T_6Qu3tMflXNRD_fr7PlX4Bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR86i7IuEfc3h2CfTl_aG5NyUpddtVU-IN11Gi7lHZAQ&oe=6B0712E6"}, {"file_name": "Screen_Shot_3.png", "id": "1589540415981286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1589540419314619_2099124498997540841_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEas8yzNtuQQ7kNvwEB_eM5&_nc_oc=AdouHq67DY-kEZpeXnUcurtBsdaSo0_E7e6mdTXKaOO2GimNYtcoCYp-uF82qMEyRcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVOcCjabntJ_DNgWj6WSG6-FNcBh-4JmtDHWv03hurJg&oe=6B0721C9"}, {"file_name": "Screen_Shot_5_whale.png", "id": "1542985894262513", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296236_1542985897595846_1522520736840960551_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=218dKXIWjhkQ7kNvwFYkBN9&_nc_oc=AdpQsqMQLJGlP7XmdrBP8CHXKwEV50DHQbNNDoDDn3qT5VIkPwrgLhqFaVha6_iNMZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLM0qbqoQk_hkToTPGOFPxbBTsHVJkF2PjQCPQCDwjEA&oe=6B0707CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1274022617267879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_1274022620601212_5198477169058522209_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLQUuqLanKoQ7kNvwGI7NpK&_nc_oc=Adr21qfPCIvKLCE6W_6M9VXfSYBR3qkHtV1aJhofwmWv_-hBdW0g5bs0UWGSR7FGuxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMZEcSq_7ZlfCbuLY5FHFMsC1fqmrYyVuK0y36rpuZNw&oe=6B070A15"}, "display_name": "Bubble Zen", "keywords": [], "long_description": "Float into your very own personalized bubble of tranquility. \nBubbleZen is a serene meditation space designed to guide you to a state of deep peace and mindfulness. Leave the noise of the world behind as you craft a meditation experience uniquely your own.\n\nImmerse yourself in breathtakingly peaceful environments. Find your center in the gentle silence of a snowy tundra, float weightlessly in the infinite calm of deep space, journey through the serene depths of the ocean, or breathe freely in the open plains.\n\nEvery element is yours to shape. Layer soothing ambient sounds, calming music tracks, and positive affirmations to build a soundscape that perfectly matches your intention for the day. Find your rhythm with our mindful breathing aid\u2014a gentle sphere that expands and contracts to guide your breath into a peaceful, meditative state.", "short_description": "Welcome to BubbleZen. Imagine a world of pure tranquility\u2014a serene escape made for peace and relaxation. Customize your music, ambient sounds, and effects to create your very own bubble of calm. Your path to inner peace, designed by you, for you."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://mirarami.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
/491823431_707764552291420_4605260844428679294_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTFQ7-l_PIAQ7kNvwFdkHg6&_nc_oc=AdrU7tKw7DidOEanZ9Xipf7J1OgFstzWdpoYGZG8PYDJrTYgepEgzGlmNfpazTHOYdA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmeXncDN7b1S8OqEnuE6n_5Agz80jw6Xk0YUy9E8fBSg&oe=6AFB2542"}, {"file_name": "Screen_Shot_1.png", "id": "3788540308113354", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822581_3788540314780020_6776121826638983113_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlkSeyDCHkIQ7kNvwFfxmaL&_nc_oc=AdolasilP7kBMO4i6j1eVRC5mrPZysVH9j4_mF6ADNKGcFbyI7OMmXiugUQnDOADdPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ES2NgOkoYMY072oANmOEFY3XVVYkk8keQTxu1wo4Fw&oe=6AFB3566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1274022617267879", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295661_1274022620601212_5198477169058522209_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YexVxk4lTSEQ7kNvwGrnLiN&_nc_oc=Adq-lOcq8kvh3F0yPdEPzO7Pn1mSTylA1jamxhSp7V_EcaelFOqc2tIO3-4rAEQ2y_Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvvuMQBh5uchHUWW5XIQ3zW3pH0DIe2oWyTk5kSje0FQ&oe=6AFB2C95"}, "display_name": "Bubble Zen", "keywords": [], "long_description": "Float into your very own personalized bubble of tranquility. \nBubbleZen is a serene meditation space designed to guide you to a state of deep peace and mindfulness. Leave the noise of the world behind as you craft a meditation experience uniquely your own.\n\nImmerse yourself in breathtakingly peaceful environments. Find your center in the gentle silence of a snowy tundra, float weightlessly in the infinite calm of deep space, journey through the serene depths of the ocean, or breathe freely in the open plains.\n\nEvery element is yours to shape. Layer soothing ambient sounds, calming music tracks, and positive affirmations to build a soundscape that perfectly matches your intention for the day. Find your rhythm with our mindful breathing aid\u2014a gentle sphere that expands and contracts to guide your breath into a peaceful, meditative state.", "short_description": "Welcome to BubbleZen. Imagine a world of pure tranquility\u2014a serene escape made for peace and relaxation. Customize your music, ambient sounds, and effects to create your very own bubble of calm. Your path to inner peace, designed by you, for you."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24456972727307360"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3788784467921696"}]}, "baseline_offer": {"id": "3788784467921696"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757084940, "status": "PUBLISHED", "id": "3788784467921696"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24457569260581040", "version": "0.0.1"}, "id": "3135600546608533", "channel_name": "LIVE"}]}
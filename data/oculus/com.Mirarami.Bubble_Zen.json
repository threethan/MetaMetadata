[], "long_description": "Float into your very own personalized bubble of tranquility. \nBubbleZen is a serene meditation space designed to guide you to a state of deep peace and mindfulness. Leave the noise of the world behind as you craft a meditation experience uniquely your own.\n\nImmerse yourself in breathtakingly peaceful environments. Find your center in the gentle silence of a snowy tundra, float weightlessly in the infinite calm of deep space, journey through the serene depths of the ocean, or breathe freely in the open plains.\n\nEvery element is yours to shape. Layer soothing ambient sounds, calming music tracks, and positive affirmations to build a soundscape that perfectly matches your intention for the day. Find your rhythm with our mindful breathing aid\u2014a gentle sphere that expands and contracts to guide your breath into a peaceful, meditative state.", "short_description": "Welcome to BubbleZen. Imagine a world of pure tranquility\u2014a serene escape made for peace and relaxation. Customize your music, ambient sounds, and effects to create your very own bubble of calm. Your path to inner peace, designed by you, for you."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://mirarami.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
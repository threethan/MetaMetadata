=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPumcGDMSNkQ7kNvwGJrXal&_nc_oc=AdlPUB3ME_7jhbbWnVPlUnEeq_jj4yRwoTrQXF9mrN4KpsWgmJ9RSKv8N1b1xgFHzvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsQ9Gw6Uc4pLqBqa_eixgkLPG5lEwa72E3wtiA7iNvIGw&oe=69A5852F"}, {"file_name": "Image00004.png", "id": "1304212168064145", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827632_1304212171397478_5065680708425984114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz9oVy7_8oEQ7kNvwGsOf5G&_nc_oc=Adlgxe8IS1IM_Z4aFe1iGxQ3-ZoKbUMsbHRJo86D35QzM2e_OmDASr71D6m9pNTW2a4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftQxOo1jOE9rWxTC9gBhBRlwznyO3qi0Lwc5Y4XA_WUJA&oe=69A56BD7"}, {"file_name": "Image00005.png", "id": "1511615766957083", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821714_1511615773623749_4398017413360884289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPKsuvZrE4wQ7kNvwHyossO&_nc_oc=Admm-P4dp-BnGNtvIXYm8xtS5yJkbRZMflo36YF1d5Y3RlfwVYrlbPwb3YHI2RgMOCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afty6MDjx6RaC_2SItK0VFPNpVgNPQaeuM8IIC41lcjL5g&oe=69A58340"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SleepWatch", "keywords": ["horror", "ghost", "scary", "creepy", "sleep"], "long_description": "Between sleep and fear \u2014 you can\u2019t move, only blink.\n\nSleepWatch is a psychological VR horror experience inspired by real sleep paralysis.\nLying in bed, you\u2019re trapped between dreaming and waking while a ghost lurks in your room. You can\u2019t run. You can\u2019t scream. You can only close your eyes to hide or stare back to survive.\n\nEvery second counts. Survive as long as you can and climb the global leaderboard of the Longest Awake.\n\n- Immersive VR experience built for Meta Quest\n- Minimal controls: only your gaze and blinks\n- Random ghost encounters and tense sound design\n- A slow-burn horror where silence is your only defense\n\nHow long can you stay awake before the nightmare takes you?", "short_description": "SleepWatch is a VR horror experience about sleep paralysis.\nYou can\u2019t move, only blink. Survive as long as you can while a ghost watches from the dark."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-sleepwatch/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "https://www.inceptiongames.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24907324588900443"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "3342839629207655"}, {"status": "PUBLISHED", "id": "2693157837692140"}, {"status": "PUBLISHED", "id": "889837690165318"}, {"status": "PUBLISHED", "id": "4424707864428683"}, {"status": "PUBLISHED", "id": "1037948788381887"}, {"status": "PUBLISHED", "id": "1511688556414490"}]}, "baseline_offer": {"id": "889837690165318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "3342839629207655"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26119906660975557", "version": "1.25"}, "id": "2163249837493932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
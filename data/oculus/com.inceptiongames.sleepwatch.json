unaj6zI4zt5b9r6efPAJ1vNNbQDlD-UjQOw&oe=6ADF5111"}, {"file_name": "Image00003.png", "id": "4241125229520282", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4241125232853615_1078722330148175102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWd7Guvnh0sQ7kNvwHXLxBx&_nc_oc=AdpNFlMLczV5FSAlfYboZ9IkTgDgzxPK2RjbZ0NdNMkUmluWct_xI9gHesJhBDB4ip4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6r-m0VMghITc7N1wBQxbv6r0RRoulxIZlCiemv6CL4g&oe=6ADF4A2F"}, {"file_name": "Image00004.png", "id": "1304212168064145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827632_1304212171397478_5065680708425984114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5yEz0Z0D1QQ7kNvwGtP6a3&_nc_oc=AdproX4Lt_eeUtKXjLrTmAjxrSP7Dn6ZTscIfXc8kMIhXub59-HqJ2cfgHZSUwwizWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzRZxSbledMxyxDXHYduLwyAkCFRC7yt3ekz84LwiTJg&oe=6ADF6917"}, {"file_name": "Image00005.png", "id": "1511615766957083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821714_1511615773623749_4398017413360884289_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-IZhckYjQUQ7kNvwGAtUOV&_nc_oc=AdoKyUe-pLGPO2yL1dJ7eyJ7O5IRlyz2gobhZ79--iy4CRv0WNOHrN_Bz7Eo_5qHDdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmM-L8gPp8H2Bncnc3350KmXvdVOfMg-xflgAbU48CuA&oe=6ADF4840"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SleepWatch", "keywords": ["horror", "ghost", "scary", "creepy", "sleep"], "long_description": "Between sleep and fear \u2014 you can\u2019t move, only blink.\n\nSleepWatch is a psychological VR horror experience inspired by real sleep paralysis.\nLying in bed, you\u2019re trapped between dreaming and waking while a ghost lurks in your room. You can\u2019t run. You can\u2019t scream. You can only close your eyes to hide or stare back to survive.\n\nEvery second counts. Survive as long as you can and climb the global leaderboard of the Longest Awake.\n\n- Immersive VR experience built for Meta Quest\n- Minimal controls: only your gaze and blinks\n- Random ghost encounters and tense sound design\n- A slow-burn horror where silence is your only defense\n\nHow long can you stay awake before the nightmare takes you?", "short_description": "SleepWatch is a VR horror experience about sleep paralysis.\nYou can\u2019t move, only blink. Survive as long as you can while a ghost watches from the dark."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inceptiongames.hu/privacy-policy-for-sleepwatch/", "developer_terms_of_service_url": null, "publisher_name": "Inception Games", "support_website_url": null, "website_url": "https://www.inceptiongames.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24907324588900443"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1642789033876058"}, {"status": "PUBLISHED", "id": "1678569884271608"}, {"status": "PUBLISHED", "id": "1334334194827747"}, {"status": "PUBLISHED", "id": "2529868397443132"}, {"status": "PUBLISHED", "id": "2680898622296723"}, {"status": "PUBLISHED", "id": "956686050197286"}, {"status": "PUBLISHED", "id": "1540069740395355"}, {"status": "PUBLISHED", "id": "3342839629207655"}, {"status": "PUBLISHED", "id": "2693157837692140"}, {"status": "PUBLISHED", "id": "889837690165318"}, {"status": "PUBLISHED", "id": "44247
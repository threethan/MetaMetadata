luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3KQZM0hCVIQ7kNvwGRDbHo&_nc_oc=Adr443uDLz4mdwjLFGcvpojIO8hJaNT6cVOUGF4DTiZpQg4BSm9ojM8oVXPxI6kvwr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRY2N6u1Qllq67xG0idhQDnEBXuQZc81eennC7Fi_SUQ&oe=69CA8B4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1IG0F5D9TcQ7kNvwHLVUnh&_nc_oc=Ado5Ou0Z5UW9K2vnCCh6vhKOTVKGVM9jHWPRTd05xMQ9CGHv_wLU4Jqf3EIsB60gpq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpIEJz1BAn_q-Mo4PU-cqejWUU4wL08Bsdv1qIGlySzA&oe=69CA7C2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wok3R-sqSOkQ7kNvwE_wAnt&_nc_oc=Ado34SuBjNJKyu6Il1jEeYW32odES9eb9A7zGG6LK1SHMcjBYCRp05FnHAjOyvjCIWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsTuh5xuljtPn3RYZFsaTX6AFYkody87PJFMKupxKY4g&oe=69CA67C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMyE9G6Id2cQ7kNvwH39Y7Z&_nc_oc=Adqe0S07DLKy36fqw1_HJ-quNEXakAPc37AOw4z9EK9uZsChvQOvrLepdnsqRDUqAOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxji8crDcmO5hBU9JuwhFJVSq6vLlqh4prwjz7dg1EcUQ&oe=69CA5FDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9DYjDvSSvsQ7kNvwGvSysW&_nc_oc=AdoHxjPPm8UrSpVff4uATi-Tfb7AmPovzkcKTy-TvVJKzTHv-5yCmYk5lZrrI0xbuVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWnJKWXVKTC6hgPrt8E4eyBzxsulY-ZEyhA_fzg5DZaw&oe=69CA7F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWpOHMTEiSsQ7kNvwEbrPWr&_nc_oc=AdqWPrwcJkvj3R_a30aAuTnPy2rz4s-oULZ1dmsMDADJdiom1ErgGZTuIQDvvLX9fOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1JDI5sY2i9a9tyqyJdo9zz-uKJ__SblKoxgcY3cvhFQ&oe=69CBDCCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4ESyK12OOAQ7kNvwHuI0Nf&_nc_oc=AdqfIbm2cAWLrtYraI5S69V0dzb8GJSpJTXqYnBBP0w94Pf1KcL7GvlIAAvH-I__4f0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxFA6FgiHaUJKAzSJkWvZt-Pn_Td1sPHrNvpsEJ8zUAw&oe=69CBCDAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wok3R-sqSOkQ7kNvwGMO1QX&_nc_oc=AdorkIjD5UqZYLn7VCRQGPoDi1hr5fX2eddq6UpILBxs9bw45Gu70vCWkLwDb93hUB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysXYGRy4kXpE4Cii1JFKKbZl1RV-5ZyPF1iC-n2-oplA&oe=69CBB945"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMyE9G6Id2cQ7kNvwH-8oiO&_nc_oc=AdrkWO2-ceGQKK66AdmAmPSZxuHbNc_3hZQ5y3FfsCFy580A4l20uYuoWdn12EWIpZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhT55aJFDBTPJqCYj-adOgwgckJs4KXTAvjVvT8mOW7g&oe=69CBB15A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9DYjDvSSvsQ7kNvwEyO2QT&_nc_oc=Adqoyk4VfwFuK6o2p_nPPS2kqs24ex6sOvukbUoQ3oPrGlmMvlq8k5Y_VqjF63k_GJk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK-NUYwPjw2_NJNldXxkllsByZ4QPjCyPARpbznYeB5g&oe=69CBD114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
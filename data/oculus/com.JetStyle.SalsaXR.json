luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Urff_BjSjnwQ7kNvwGe8f_u&_nc_oc=AdrSk1K6lNRN8GkcXXRrCl7aiu9QZRQqahq8iW50r36bl8YxpHPuoXkQ4SJmZX25wI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QacbiL9bv469OyXi4Zhqw4h9ipTkkOONWwoOpmlTkCA&oe=6A1D99CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzToJLD7KfoQ7kNvwGJCC3o&_nc_oc=AdraVtHDPmPvDT9rmr_fisSs1JxnAmHRO5EVLkeP4FB9HnD7xDqg_2ouD27uOE3lM44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78bZsYpezgaukC_IkNSxNONSNOw9mPMzl8VIJQ_j1r7w&oe=6A1D8AAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ2wVCxtzMIQ7kNvwHNBBhy&_nc_oc=AdrF33AI48C2VpaFfeWFlNwi1ExZpGlSsswong09ediV_fmvOoploFsLjqZPa-AUrZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EiReVQCp9fLMkGgvGBUYNIxHhNCEZxo43EqNFVd0r8g&oe=6A1D7645"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr2NFA3nKMwQ7kNvwEut2j3&_nc_oc=AdqMEd0sqNWeGhj832oF9_1zCzxTIahgHTszQrqFc3YQqVb5H1Pb9Z01lskF2D2YFKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VSQugbP3G-GL1xgKemKnUeln2ym6GqEoqrmqEXipOpw&oe=6A1DA69A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOgKC7K62HoQ7kNvwH2f5Q_&_nc_oc=Adrl888H4a1j71exTJyJowDe-LVjphJ-qXskBc_wT0wdSChnWIi4Q159Gq9ec_hEixY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NpTbzGP3FzKQeDOnsalxIahJbKCWyim27h05ybqfrtw&oe=6A1D8E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
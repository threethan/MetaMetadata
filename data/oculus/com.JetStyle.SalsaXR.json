luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IkWHoKJgf4Q7kNvwERSckz&_nc_oc=AdqggAHSVDNoegWcAIUdzzp-EpyXgRP6BSKPrKBjn_Y3yIf74LRYyX73NVDfBUM0MDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H3W_I7ySnPVPFSk97ossKB7YCwBtUKBslLbKBhfvTKg&oe=69ECD24E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axhA9mvlfuwQ7kNvwELvL_4&_nc_oc=Adr1ItsFN3zZhjdb_LmEozlElEIYqTQpMcrI2zE4Erg8yS71xNpRibRt9HMGxL19hFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QjWRud2loUeuR5H8vvB2vyv2WrT44GOH8EHA7PnwnGg&oe=69ECC32B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIV80Pb0_e4Q7kNvwGwwLLm&_nc_oc=AdqRXMFn6dOu3KJ52da_vNlGyQDL6xD2H9mvjt3Br-DmVPYF6RXAZK6uv1EvXfvyrAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aLfHrdm46e27C9C9fXVLroX8B0Z0zKlTRns0taSMzdA&oe=69ECAEC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIyyWVZMr-cQ7kNvwEfpjc3&_nc_oc=AdoW0oMAqm7rd2PekcW_sILLrRZSr-wTJsqsYcA0wRyOS9VM6r_Vy7dQBfNeqsazJbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qYfM8JAmgWRrIXAaBsFisPMXaxRj3ew-Q-eOJP6GyKg&oe=69ECA6DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4MSQLWXoEMQ7kNvwGGu3y8&_nc_oc=AdrKd9dIwXwQUV2sY_a04C0IHMtBcUVB7g2rZjrw3TbaoLge2uJ_7cbtgXXiOO0YJwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DxaCntQpYpilI-MKJDBHrhlSp83pT1RETdF_7q4UIIA&oe=69ECC694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
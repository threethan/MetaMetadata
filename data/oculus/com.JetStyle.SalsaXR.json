luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5GbLQmwWI8Q7kNvwFESeDb&_nc_oc=AdoNtaG_OG-N8i87zDZlA2ACBG07J4yyXBrHAV5gKbWIwQl8GR6idmwzlioQW-s_1l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMy1otqIx54o5l37gyP4IDg6516XIHikygagc3G-7Ftw&oe=6AEF384E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFWlZCHuBoQ7kNvwHcfPeK&_nc_oc=AdpwusDLsKuxsD7x4k2BsxGMP0HJWsmmQQk8GrIYYuW8XRFWkY0EBgzUNguZyLJilJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnyRpJ9y-9KLrS3Q13amP6VNzMJCysj0BUwK4bXDNzWQ&oe=6AEF616B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBCohfvcmxkQ7kNvwFsxHY-&_nc_oc=AdrFaDyf57AR6iKmksmAYsMNIV9hrvji5T-WPmm4Yy1Mbf7jKr2EKa5iW2o1Gssliao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMoopsUliYohIgdRSEA8M8QVW6Mh4pIu64es2Ix49gPw&oe=6AEF4D05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZFdb5oxmbsQ7kNvwGAn4c-&_nc_oc=AdqEkaDGPWjZp0hC_hIIodq__2Lan2I40OeShvI0SaBn_qcOZoDPyoYrslApv4e9QlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTXV61JFxJeaReWjGv1WJpiqe11zdP2ZdM0l1kG25u-Q&oe=6AEF451A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B5A-KqO3-MQ7kNvwHNhJDl&_nc_oc=AdqhWigIMFfPOxKx-qjOUX_EIvt0mlUrPZYwAG8oSYXVBijjCvV8CjI9NQiPczETmoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOKgn10Kq5E0GTCKMjre34a8MIV6fIF2RYdd7knRXjtA&oe=6AEF64D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGd2pFB03bgQ7kNvwGk_2yP&_nc_oc=AdpfiilgO4PO9CydAWsnrvic9GwqgIw7X1_pd9aSOQCtDI3-BP-yk5br6mliuGVpNcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6pnGUAmJqKnMP1JB-1sFZ56ZBhatqajptg7evrKJ84Q&oe=6A7EF08E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx-Qz1jyKwQQ7kNvwHEB8RP&_nc_oc=AdruYsj7t14A06SCo0RxUcI4jzrYa4cXxIUPYwNDP0VsUwR9DPRPWxN4qgn1zNTgrIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXV1TvqlpMq5d5MAwWhh6LhUBB358X1PxB2WtVa2XiUw&oe=6A7F19AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6kjJgxkws8Q7kNvwGl7DJ6&_nc_oc=AdrAuqh9WbvAw-M9AAzVLkhEZR633AICSsRCMTxR8GPMYSLCv5yuULvYZXpcB0Jtz54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlAIJ58wrbfuaZ3ze_AG3hhIxck4EUQAbcTZubuDqP7Q&oe=6A7F0545"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3lbgPUJlk0Q7kNvwHnfLL5&_nc_oc=Adr3yKlWBx_Co3Fi6OHye9z0PrVSiw-fovewFT2G2v3VOrFHKtND5dDGMVqZamHRKKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHzUFWybZ0ewNOrhmnVzWQGaBMT_2rZpogwI52ATD9Cg&oe=6A7EFD5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLGszgp1jfsQ7kNvwEiN2u7&_nc_oc=AdqikJ7f1qEkGGzsMhKJjRlJrnGwhVKC2_WdwuzyQgJdV08Segh72bgn3OL6cZ3roNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeCn1Ayris3wiapE3aLjdeoSd86iiP_LcBCB9Nzwc6FA&oe=6A7F1D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
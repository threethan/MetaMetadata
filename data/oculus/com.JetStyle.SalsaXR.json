luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep2ZCcSt2NMQ7kNvwHG-ETE&_nc_oc=AdrVPVdktKKW2qQdfE2Ne3A2opdimv9WdXNhZOEoAThwCXFOUlYol-yv10lBzRuPgIE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc4dTrmOfMyywUxvscO07tFhMkx648BMm18yW_oRVnAg&oe=6A5A3ECE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w7lMw0FtUkQ7kNvwGNsS2z&_nc_oc=AdrlG18-2TZ6YJ9u8WnwVHCKbh9QmfR9LxMe93KJq-vYEv2YsLQwXl0azDaw5tucIkc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbMgyzuIKMng73X05uYT_cPWcg2emlRxn_hXlDrb2S2g&oe=6A5A2FAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZzOlYAlVyEQ7kNvwFq_kf5&_nc_oc=AdoAkGSGa_YPXQ91YyLaih3rNjzJ-vm6TzBOS0-fsFQ2_cZ4Ti4FtdgwfxP5ALT02Bk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqaI7akdJ1cIWOe5zob9YZ8RDZOwK5FUrP9JrzqAmCvg&oe=6A5A1B45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt1ALb-d7dgQ7kNvwGCzGh2&_nc_oc=Ado3MxR9KliDUT5l-lhJZ-hKSTPg7Ms095C1_YvPxZ2q_Dp04Fp1yDNJxTdTghbOZmM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7ktm4SY8uFyKoAbH_gTXuYsuAGnBrOsdKvK7SF_LvUQ&oe=6A5A4B9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFOTdQFYGaYQ7kNvwFEE7Ks&_nc_oc=AdrcLSjuq7Z5XAqqHG_GLoBq9XRSZ6a4n5izD5H-BFKqlCPKFxTr93Om8ZOWSPqndq8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSereaL8_JqfxmjazdJbIzmCUsrxyGbgZ454NqR2hiyQ&oe=6A5A3314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
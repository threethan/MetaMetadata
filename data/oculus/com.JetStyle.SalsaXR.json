luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOe8Rw9DKmkQ7kNvwHkx8Tw&_nc_oc=Adpye36W67pjnK50nzXVMTcwLI5OKmtul8QBiLndOTSy7nbgc8z-taS6QftQLZp0NYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7-cO-4985PR2QPx5zBkpBd7wsYyVRfYPdWvjVhSFNVA&oe=6A41324E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWKFOBt1UAQ7kNvwHx1Ydu&_nc_oc=AdqzSb8awARql8d1CZtwAv099Jq-k5E2eFdQ3Hqh5DCQwedxO5M7SjlaAt2UW5PJL0E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dHlJfsnYhU10xCVK0L1Rf0h9vQGeflFJNLhJ8HZXwbA&oe=6A41232B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0gBOGXUgOUQ7kNvwEauJ8e&_nc_oc=Adol_3S7SoLr142MutSSWsMHD3aP1oR2UWdwZ2KZYvIBXh4UcZHkw7y1D9-2UGX9YSo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IBtfi4LRyX5jzDEVTf30uIrjqpqJ1AAUpUYd8pQmm6A&oe=6A410EC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04jDV_Ipe2kQ7kNvwEuqRdp&_nc_oc=AdrYAuNbVsxuKbJCfuBH9XKFH4sID0RO3mw8xE7xwhl-j5_HkKRKPZ6zuAMAo_09g-w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8slMAANTsHjPyGO96H00gHNPYeXZ8_2MJrgkd9F09m9A&oe=6A413F1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ3J_bmqdxwQ7kNvwHxuGZY&_nc_oc=AdpgxC8103ybAwum2vU-Q75Qsw-DWQcxnXBbVHxB-lYOvO5_n2VO-p0JnfpI6lnCEtY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n8-G7sA3JWSEuoI8cvaZl04fXop56nFoqTbd0HjIqcQ&oe=6A412694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
QLG_pAWf7dTl48EhpRDeqtJ2bwAzioOiriwelW-Ch1VAwE22djxgWrsWcM92dY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuVRvaxmwM8FHN-yaPuf7fpJKwc-xgPfb0x95SLCiw4Aw&oe=6998724E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEjAbnJY1NAQ7kNvwHAECOo&_nc_oc=AdlT19RfT8vIDmbiy5xgmmJS7bV3oy8dBrFywqXuumHQ6V-8VTOMBFNHjrEGxbVDH1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftTycI7o10gz3MkcpLX1U7FkLtBAr4cyC9OiYk0F2_bfg&oe=6998632B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO-z9HMZEY8Q7kNvwFUEf04&_nc_oc=AdnqmfsTbJVUeUnyL5I3bYbAUVCTunUaOZZbnTcQv_12-JKtJ0BRfxczTqqDJ6qan94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsu63svkZvSsNUKngTmIdog9ARGcHKJfLqLDJr8MIgWXw&oe=69984EC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14GR7JxbMMoQ7kNvwGRX8tD&_nc_oc=AdkD3BSXMihP7-dQ9gaigIoYQgEB3__3WDDZszYOBpbJjwJVLq19v8KXyGlb5BerPAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftCkH3jU5Wc68fVSy4l4z9DOdupcvv8yhDvcELc3Km1qQ&oe=699846DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZLuWiQ8NLkQ7kNvwEYgILb&_nc_oc=Adm7IOA1cgDgsqnRUZezVobglr6q9IUSkIb5QSFpzg-4y96xluCWbyZzf3dBFqyUZzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuVVqFObuBKJuU3I8wPlYjsaEO9LYczDgGem5zKIfYp3A&oe=69986694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
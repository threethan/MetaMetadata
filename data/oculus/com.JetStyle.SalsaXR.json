luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD4gz0gq0tAQ7kNvwGk0a6X&_nc_oc=AdrM1Wwvatu1EZCVNYdfyFn8wrrW701ldbZ3zC8IEZdoVfFJ_NJFl2oejmDWrDG6-XE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIGJxW86qHa0QZ7BiuG9dHW4hsrmOnbXXrAImUjEbbqg&oe=69C2A24E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ln_v0-ELaMQ7kNvwF6hWjS&_nc_oc=AdpHdsNnL_8Xljf7sdsfW8FrkAHN4XKbLROj5YRv8JQjQGPQEC-at5J_phkZMth4870&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqI7GMSplaTNylqDrjbu0-cyl8T3dLt52FvMriQCCr1g&oe=69C2932B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-y2-CkNKcQ7kNvwH7AZ8g&_nc_oc=AdonC25e5UfuCPcoFgBu9HfnIpoTxJoYRMpzC5KvTMFnKrVPaMw0e-pkCRwNwNxL13U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3NovBiYeKH2auSL4jGDc8u_UiWJC0UHb7w-MurHjCJg&oe=69C27EC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHHh2Layl0kQ7kNvwHhBvFG&_nc_oc=AdqMl8T98H85JJBwCLy3u3mX_VEYDzE8RpotXGMXTDTb42pWRFUTO77va1CKH7hCuJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8I1e-TjqvHLhDsejyYtGLd_h1js0kRzefUnwYzNlmJA&oe=69C276DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BzDL_sf4c4Q7kNvwFon7ZQ&_nc_oc=AdpsH3Gih2LM5VdWclDr9-9YaIVyo0DrWuprpCtg1BSdyUppEyRa7_xTaeR_DcX7sh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3Bg-vDE37Yvrt4Ys8nHjNLsKHVdu144Blly5b-xuSrg&oe=69C29694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZevTNMQEasQ7kNvwEQvixn&_nc_oc=AdraU7MceMTpoANuS--nRjcTQJ940_wgda6cTHVoq_3dTvG2EKDmp2ag49NS_dRs0a4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YKV0Wo4sDIsrYjYFRG3N82sWOc2EsdSd9v3Rt-bGfXQ&oe=69E0F4CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wum0-NPnlQIQ7kNvwERzmvQ&_nc_oc=AdqqGg5kjmK6AViIxtz_zqc9n1JyhU1rf_q72fzorjxIc4d4fc8FlYv_AO-KYS2BfCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XdqKO6E9Id8pgoSmziFgadaokWW0QKv4sREift1JNDQ&oe=69E0E5AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCp2h1Opw6UQ7kNvwGFfLC3&_nc_oc=Adqop9Q0GHwNV098B9QsQbEUwT-p49GvqSlU5AmKENbO39FCTQpjVRynRzat0RJE8q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dfWhSARMoVSxCUVCYPAX437DzMfMKAzIo527ksQtVPQ&oe=69E0D145"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkGh7lavaFYQ7kNvwH4mEJu&_nc_oc=AdpVCyqFKTmEmDe0615doy8zhjvfqpxnczRjwAJH4vQQ5WnOzI2qKUxvJevdtG6oyzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sjxoPe1xZpvzfhA-K8eU-pkeHRxdURhaqmR3RviB-Cw&oe=69E0C95A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4mIleO96zkQ7kNvwFIdHTL&_nc_oc=Adp6npfeb5UHdmLZ1lq2GiG6u685EsAq8NMSunp32B0BcwoGd1gQN_R_FABdzz3st5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zt_I7grvXj-E5vaBUAmC5hJlYW7pUDJUOcPSU6BWnbg&oe=69E0E914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
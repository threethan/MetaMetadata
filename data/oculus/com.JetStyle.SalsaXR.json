luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bL8AAUUesoQ7kNvwH43PGt&_nc_oc=AdoQV9i9xVov-S59qqjOEeefWwh5l8tDjBypU4U2Ws0J6m1Y0DEnTvolrc2Q1QfhGrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv3XLNE8UKhR5zd0yO1cD-ozs_gnQwZkZ4e54MU8LEzw&oe=6AEB43CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMlDXt1PbYgQ7kNvwG31pTG&_nc_oc=Ado6xI-k9cfaZWyY0Ne1OPZY58MQDV87nVtTX4PgyaPsP-KbxEzPylJ-IRPf1zS1fVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp3DHtDXO_XpCScZe1UKXK_LsvVOFzVo4Uj3kLGzF5Mw&oe=6AEB34AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u87CRq9xUxEQ7kNvwHU7EgS&_nc_oc=AdqMyQ2RR9y9boicH15JAfIkrN4PFYwsJUsNmWXk1M2lTs1tv2uLLB5zdaqIJF7BCgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrciH08ifMwRgaAbV9Y_usfkl2VV7Pu89RrSD27Kk5vA&oe=6AEB5885"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVLEKDTarmoQ7kNvwFNZQmN&_nc_oc=AdpJK_lHmADkYwVuBnqcHJmwjslQLWRJb6pm2i6Sgsy7qTF1wph2yGUXjjJriUlKRWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBig3FH1UXp8lkotjxihHvnDPtDVIWqiXZCa3lmVSvxA&oe=6AEB509A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkfPcNleapgQ7kNvwFMgfdP&_nc_oc=AdqNGfOyNqM6sJyKL7MtE12JB9VXTZYObYyQO8nmgjLa6C64Jmo9YDc8i1srOT2eGIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdLaRQ_tLmkO74V4Cw1hbsV6lJBs7chRunzPobuJDYNg&oe=6AEB3814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCCG9i8fSuYQ7kNvwEhY8LU&_nc_oc=Adqnpp26LLjxnhTnCb7WY00kr2toBnZPtLRcQdAWjZn01_yZ-BPj0OMZjqmvfeMy0dE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWa2iLghQ8_7vH87uBTFO6eRWG1N7OsowNjp-i3PMelg&oe=6AC3B6CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQPLkcMbOy4Q7kNvwHgFuKX&_nc_oc=AdqRskmACt51hFTlLnTzSoyp6hZIMu7mTw-b6jOYJ2Xh1XMZIIYL5Rhwd9yQ06e3OyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5c8rW6X4iBPwKJq9xGGAUYLgB0rB_dxNKQrCo_Vb5fg&oe=6AC3A7AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjYqgDes0S0Q7kNvwF2MgTH&_nc_oc=AdrmJrQXr_szPm3rEx0wuT04zuBIpN_yePDASsNkAwncR5sjez80QRm6quyek3L_8T0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiMYrnxOR2NEVHfugPdXq-43BeaEPW3WjrcVb1Qfhn4Q&oe=6AC3CB85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CM_-bsIFWYQ7kNvwEvRVPb&_nc_oc=AdoawLvyUxlnXIajfzqjf6wnHC5AONOM-QEBHib-Z5qqaSv9hc2motv1kTHMMyE5y1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN40p07WjyoGKpoU2B5Lvo5tdFhWfcpfgOwSzx5JgNEjw&oe=6AC3C39A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl4M0_8ldpMQ7kNvwFqILWT&_nc_oc=Ado_Q4qyE5ex1ZoB0Y9ysnffvri6whW-79k-Or_DytReASPbHJ11PQpgrSEDaR_S6KI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhH9thUyTQx_QOvOdNdSzsgqB6eXSmhBxQdjmB0b1uJw&oe=6AC3AB14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
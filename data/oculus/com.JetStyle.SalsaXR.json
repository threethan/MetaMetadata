luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmXcuHx3wNMQ7kNvwHYCw5q&_nc_oc=Adpr7zzHqiWRjmMXM9I1pasELPZxlt6g56nvrGHaI1GQSMLH-7MLyCGVnXNEgF_MqqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sMbPUlliOL5y1lgl7zILL8ZoB7eoaKjrLHapwOAN48g&oe=6A2AC8CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNJZmfeJnTgQ7kNvwFjJYFO&_nc_oc=AdpkbjP6yN-fEBGEOF37fI8m3jLjy6TBQsgK5wBK62y01On0jyI-cdDKUCnyZ6FkXl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96XudQJkEoO216vM3YTZ4KAo-_jF2zyIFl4iCGKqIUtw&oe=6A2AB9AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_IvJJegkxoQ7kNvwHlJjR5&_nc_oc=AdqFzM9T8nEnTASkStA-dfTFbRpsXaef656ry8Y_cyy-Sf69gJYA2Sxgqe1kMDe6PZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yCfpP5XPW6UNb0tUQZ3UkbhZwasurHEuV7ZRo-sDUpg&oe=6A2ADD85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9fF1jXMqDIQ7kNvwH9qjVL&_nc_oc=AdrRdwFhZXsrCp3lhjN70oTFosJ5zy0YJOa9CuuFsZCaqASKeGIXbtWMWrOOOiuti9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aNxrFoSqtvlJioL5PgJ-PPw54DSm9TcV_YK5ss1T4LQ&oe=6A2AD59A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH26tNGIM1MQ7kNvwEB8vJO&_nc_oc=AdrLg2tAdb4v8BdiBlTbXFpc0UxKGSWzsVUbrp6Tba808Y2xX1BTd0T2wTHhTALLXNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zQV6t_oZ3pauOkFQbueMnmFdJp8auCdRxRxpAKlLSbA&oe=6A2ABD14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
cHVrgxkp4AIlZEqQRZNaqK0b6PJmw2feVla-UVSpEWh5Ov7ctjNNu-fyGxzzxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftnuETB-NlC-KO0rIlfwOAitrdOvrAyLwOto-olQAmCHA&oe=69A5A14E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpIiD6BC5CYQ7kNvwEVHp5u&_nc_oc=Adk2TvfH_20cfjAiNLS8VXgpGWzMc-tbu6OaQKqmeFad2iDlns2y7rV68V2gMMo4QxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsUDwBa3NKB1EqaXdBeCXXKd3geeMUY1CaXvdf5kbzIMw&oe=69A5922B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_XEw6oZSRYQ7kNvwGaqh_K&_nc_oc=AdmrFcqu8ElZ290ILurWPBM912NnfuYwSQNE3uMSZJ0eLSLLchCfofnFGUW3ghIwJxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsc3IuD4BVpzKbO1AxGQP_pIQ6FoE0MZpK5v9xvApEaXw&oe=69A57DC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btTvuWXoDGwQ7kNvwHpGGOl&_nc_oc=AdmPgJoVvLwiW2wQiEncNbJRgHtGI3VuBQREnTPumF-p8b5EUEXiuPwiSGIWnMOz_tE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsVWu0Irungo_BfiruhalmJh3jPwcwNfkpBojV6Svv90A&oe=69A575DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTHysQ85V5sQ7kNvwEYl4_P&_nc_oc=AdlLujBsMiqm_djqjR2F23U7PJZ6NL7Ih-AKuvd0u8MradTkUhsDqw6AlwcYbShZacE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvKQThbkzb-vavB0Kl7oR5hClo2S6nf8L86mn0s1mPQNw&oe=69A59594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
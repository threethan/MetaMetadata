luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2sMUVenzr4Q7kNvwFLsIFw&_nc_oc=Ado91X6vqveKDF-FFKU4sQ5RE2EnMrAcMMJZLeGnMoYdD4GAPDyH3royrmijNHN59Ik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12q6P3nZx-ZHHWZVDuEF2WLaz_3Rtov84XhAKk3nmuGQ&oe=69DA5D4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUWcHox2SAwQ7kNvwEkSL5i&_nc_oc=AdqzS4zNwH3stcjXoAmD1-e30XzLhCCfD2ieMPIfpKEF-U9e4t8Xfbrciyc4eBEOIW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pCdWJErg79dyVv6GtYCtRHTybMWMDhcQ19dqaXhWfpw&oe=69DA4E2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCo6uVPy2NIQ7kNvwGLPyrl&_nc_oc=Adp9euaZ7cbHo2alwIThiujU0xAUQiQGdMGCuOMB_Rf-FG3Oh4ZTjPYyvEmnm-UyQQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zzx68H8l87mAPescPx_zQXUxHImi9dnEH12eWrtHVLg&oe=69DA39C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjZn57dt6GMQ7kNvwGh42tu&_nc_oc=Adr7iNxHBvtfHSKgcJZlQAey3LLAP3YmHrrpuMiFSV0KFznXUPyk5ZY6VHsIdQI3OVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g5Jrem8L8FODH6ehN_mxKjIijeK4s9xs_7TUOeXrGGA&oe=69DA31DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lBHv_PgS5sQ7kNvwF59D8R&_nc_oc=AdpBdVtY-_S5RizwfGU2iZw30w7a5FVyDUo4m8L8LpVGluyGZ9_Bw7pwX2z3Ul3Iiv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rQ6BjdafeacDxawausSlMkRZzWLTJrmBdJ8GKgwWoTQ&oe=69DA5194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGJlk0w8vWMQ7kNvwF42knU&_nc_oc=AdqPDVe7oO-NolZFzJnix03CxHyR7Q1aINuyocyDJCEl5owfjG0-Hd-5vcxWKxY3V1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKtoJ1IB5o3VvKSMnpITxRFphABgO88YEMJMsGeM-jwQ&oe=6A98354E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5PVYAsmgCUQ7kNvwEae840&_nc_oc=AdoBT6feGEWrkMEMMmv0dUIHmZY7j3qGPnkxnIrmF_ZFLCn1cF-OuBlpHOT-OTSWswg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5OnQYvQTecJTz1y_gVbJKB_od8jspT4GhEpIwwBwccQ&oe=6A985E6B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkQpqQLqMGkQ7kNvwEeDRL0&_nc_oc=Adq7H7Kd88PTUtqHMsdI6Lz44Db_WdhKTlEn4ERIUBN00WiDUvKux5NEYdXHnpQEmIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRU-HjAWpIsne6r_r4Yw6T0OUK1la0SHjx_g5S2VtRhw&oe=6A984A05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql-x2tQiEH4Q7kNvwEw1FDg&_nc_oc=AdotJT46hHYP6z9H05KkoNmKdlzTLb0Cv6nRSrea49Oe4l83jjU9pxk11IatarfWAsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyo5TFSNaFC5p0EBHtxa0Y-rfHQQujeAxMfZJkC7E58w&oe=6A98421A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr7JUu12L9kQ7kNvwE1DbuK&_nc_oc=AdrxpIoOKfRhksPg1Dd-PvTH_vxLTaS6dsV146ltnlSgdmavDCJiLmQVjRNEVcYpnZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYG-b6xPRM_Sb9F_mSPweb4A1RshEmsWV_2c-gZNkNmw&oe=6A9861D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
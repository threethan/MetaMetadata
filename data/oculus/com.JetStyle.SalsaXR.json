luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njHdzy42jEMQ7kNvwESWc8Z&_nc_oc=Adot1Qz7vTTO35Q8XNV25gfsTh_yTaLfSRmGIIT6e48LgAugCf3_BjZnz9h-gCjEFws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6NmO5UjX3_WmNOXUVdWaPn2uyN_HNaCCwxDQ4R8bQLw&oe=6A8C1F8E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84LNRer7dhoQ7kNvwHcZ--J&_nc_oc=Adq4hHoqUOlwkkP-2pjLqwQbvhZ7ghrkOZ9j03YrunqfylbiYDuXroKmwjYfM_bzD8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk1NTdmJUu8r8UOX5ynIL7wacoe6Cc0y7FeIVnOUe3wg&oe=6A8C48AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXrRWie37XYQ7kNvwEASSwt&_nc_oc=AdrD3G6kzIUropVsOg5CkPizNWfsoyHIE5V55fSKNtfbezrtGzIEQcCg9uCHD5pKcnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSiQGWXSzPriOHl3pevUYiJIccModID-R3fcy169L_-w&oe=6A8C3445"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVh1UeCcEHwQ7kNvwGeswZO&_nc_oc=AdqVJeCguvqGdvE0yApH9AWelXgtP5O5FbhQuuDBdNXoiYZ4DM_nJB0ri0j-tBs_oIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExMtnyvykzR2tRlUlj0R8oNekYabF04cvKwmnuU4rndA&oe=6A8C2C5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1Yx8GaJuhAQ7kNvwG8z_1z&_nc_oc=AdrhOLFdTE0PSfXTd6G0rowPBrBsskyyWuVkryko4E4Kc_qzF1LymV8Ip-A6GZMI3ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENfg4W3cWfFwGphTPiRQzOYrBA6GFW51S3rxlottUl1g&oe=6A8C13D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sllSWxDtngoQ7kNvwGm0zGO&_nc_oc=AdotyP6vrjuXfXlzZ2FzfealbGYoJr3I56GyiRbT4Q_3II1QbcsUI9D8Qu1cnaL8Di8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdQQ9lO-P7toIlANACUwv17Ugpuu-q0wRbQYSrXjPn1Q&oe=6A676DCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksxKSmCuQKEQ7kNvwHSn_Kl&_nc_oc=AdqDsRDpS_QyLm7yaB54N5b6DYZ8E8--N2Dk3FGFswF-zc3vobJnAsdPtRXE-17tQKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGT3ZD5a4uBJLZHnTjuneyW0IG0GLECijZAjUInTsV_w&oe=6A675EAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWn0unxuD4sQ7kNvwExYazl&_nc_oc=Adr2K5_TCQD3WVnnz97OKJgv1k683JzxjgIWA4SSl_X9SF543ZK0mOO6utVORFRvyK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtdkgZdE8EU55a-cxVPIfwqBQUf-csw7fRWsnCu0j2uA&oe=6A674A45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSFr3BnSWUEQ7kNvwGPgCm8&_nc_oc=Adp9WCGz5qyFnHmDapny2Rrgd_8KlPHCiYH4spNrko33rEeiltnvlDd4GD3ZaVv8SPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAusE5Ac_2IiQs0hoM2yZPbFllLvAwo05hzfR23dCmyRg&oe=6A67425A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BqlmNWYW3sQ7kNvwG_-V1h&_nc_oc=AdqRjUz_Z9Ah4C_ZI6DoCvouZclRKjh6x0H1EpHTAofFAYiO-b4Y5Lr-3aX0JemDlNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAZEHlq_z97UBqSyr4x9bis5LF694tYan_OOWxToHJ_Q&oe=6A676214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_44zuKeeQsoQ7kNvwH5Ghtq&_nc_oc=Adoca0-Az6rrxcq0mP0Zd1242ODhGcDNWm4bMSnKzTiaditBHOHXPquRd1wfjBDyBSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuB73wJoC5RBS9FpjwOufVRuuhhI6POTdjKtitidYqZw&oe=6A773FCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZfDH2jvheEQ7kNvwFyHe8K&_nc_oc=AdqziiZrjDGIwsokj1qi511kBR-F0TGC4C2oioHMFGZvNbKYNA-nSROArhUOqLPSqdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYconliB84M4SWMED9-H230wYD_Mq8gnMr7OXyPxL17g&oe=6A7730AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvbqpvbavEQQ7kNvwHthE3n&_nc_oc=AdpGAUBK7pyFQzj34tRxzZb0uYzhgo8_sgfDin_sdtWDmLLoSAqzgNxr8InFvlADpfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvzrXJTB18kkf5IB1JnW7_Y8cdKhj_Tn8HOjE8kK0JiA&oe=6A771C45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwxCldWMaH0Q7kNvwFOlX_O&_nc_oc=AdpglVfwrruMrdibh8tZy3RSMmWpcbWiSAMGexBPvfhugLJI6RYYCoAjSWeSBJWbcKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5rm9NN80Zw6NFRQkPflht2RaFg0SJjsQ91KxPdfNVYQ&oe=6A77145A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg4I_tgwchIQ7kNvwEuKZ-Z&_nc_oc=AdqvdStbN9H50jBYLo_9RXpoM_iCLC_hCuWUaeRrqZRu1QO7HHxQv8GA-W6MQsy1XoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9yKsbcZ-z-EAPAyKseRrCu79EWmi1EMSO8CcsIYAP_A&oe=6A773414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oisUmOJQII8Q7kNvwHYwR4c&_nc_oc=Adl6KmqPpz6-HvM4YVl3yIxhHSfW5hS6h4TfTEH8vNteug9xCvft3zJ709-2Jr-ASRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd6OHEqGDctVGgqUnRfzUTkD64GjahmDnfbBWxmQmTyg&oe=69AEDBCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68NDtwcj5K0Q7kNvwHXaXeS&_nc_oc=AdmwTTte4SIp1F7td8MZTgi-2yPm3vR6bdajhRhFGN7G3n7BbRakL1E0wuCcAqic5Dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7RRTK53ztcwrXs05H8eRmlSBFCHKsQF8PdCtQBKDEIg&oe=69AECCAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BkPF18L0OEQ7kNvwFX6nVQ&_nc_oc=Adkr8NLZ2PUTvM94WVUIBw01vxWrvSgQkf9OFscZJ84i3VBMj1rFwt3h0mThUeSO1ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAJ7vPY6Ze3OHTWOAwQfzUvtdwouq_Snnp1-dkIprkdg&oe=69AEB845"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kydidWalgkcQ7kNvwF5cote&_nc_oc=Adnf5tZJRrfWxzWzMEx7UA5D4GO6qc3SiGkKXGMjpGeUZ1jmN0eZSM2k2JEBvBKStoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQv3HDbhaWImD_FLwGlkvqCh9hplhyYSH6HGDIWyiZXw&oe=69AEB05A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gxCclVA4aMQ7kNvwEqdFVv&_nc_oc=Adm7PDwf2oNhWrWEQ3q1WR-sK_M4izg7tucrYl8Fta5MIj3e0jlpMFSLO7DLmT11y9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz2w2lkiksE9IkuG2aswHR3INn4xF0pSA01S71BEjz0w&oe=69AED014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxjGw1CNsGsQ7kNvwEXpA9e&_nc_oc=Adp2SzDS4n0uPHY5jfGE8ZKdxu1ghejJjlr0hPIfg1atwMWWUu5bK5MkD-nIuwmaIeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS21EoLLFnacT9vHnEv_JcLVoWqcHJaCdYvFfZHi0tbA&oe=6A734B4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01aeyJ78_PIQ7kNvwHhmn_7&_nc_oc=Adoj6EM-D7ZsYPneKimLE3kLcB5zgK2YcNKTxxHSXA96QkjUom4HYUm6i7-TVI_CezY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWHFRtftvuLNyU1z675BIPw0h1HPGckKioaxNAEz8UOg&oe=6A733C2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcQuk0SEzA0Q7kNvwGKTjh7&_nc_oc=AdrMaPsv1bi7hnBeEozxu_LReOIHJkRbG_KAJu88fYqSNwA30ng7SHSmngWREE7JdX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQRKW672UTIEZ3mPQFuMQMJTEJo35M-R0VkZiDXz4W9w&oe=6A7327C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m975GH_7gocQ7kNvwH83Dzj&_nc_oc=AdrZOfyRVyTvbKDrhs00e14LVlQeMA2bduQUdy411ksNEsXLwllobg0oboGEEo6WCfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH6FniX39Q1REGm6Zmfw7_Glu7Nfo4AV27k3yhjYPupw&oe=6A731FDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b5JRsLH5-0Q7kNvwE7tGq2&_nc_oc=AdqCXtGPbygLq9xre10Q8JXSAWyJ7iV9UfekaPWiwdMHZ4UrvAApu10DbditJUjFBc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuEs9HV0nJ_vno9BVILQDjnUDNsEH4hkYpuLxb-MhT5g&oe=6A733F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
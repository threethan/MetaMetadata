luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_HKMKY9dLkQ7kNvwEYPZlc&_nc_oc=AdoI92-7iobYiJ5cB--oZl6laEZm9Wte_GcL9ljXxuSHnqSW8E17qu8aX01prqdq-u0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn1BDL4lOKU0b7bRnxzbOlpO2-3fZq5dwz50d4DLRmjA&oe=6AF1DB4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFWlZCHuBoQ7kNvwGYuoGJ&_nc_oc=AdrHqvcLjVXV8yVMcnzooHgGgho7kVHN9V-5GnqIGMR-JWVgXQH3in_g1AdSWlaa1QA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNnt5g45LPQNZ5RAQ98IkNR1di6PH6NA4fsHXnamzlNQ&oe=6AF2046B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBCohfvcmxkQ7kNvwFbQkGr&_nc_oc=Adp9hWP_s54PrOBnFcELQ1EObe7KCjJ3VRa6nEAOb6Bkayeo9YjK2iATM8Z3ednWhxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCc122XJtmODvluqBtwxbaKK1kA6CQkRHdESn5dJ5SIw&oe=6AF1F005"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxqjaJEmK14Q7kNvwFIeAFt&_nc_oc=AdqmhYi6RoP77hJHiik4YT0KeoyWZWvADBxgd_Woa0ZAx0mnQI0G-xIW0e5ksj1P2C8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMkfsT1-gkRquBo4zSGNHWUlUr4hOZZJumNQgEtQzGCQ&oe=6AF1E81A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B5A-KqO3-MQ7kNvwGLi2NN&_nc_oc=Adr94HOUhizts4JjnERpXP8gd3hTgyqPy_7PlU6aiNm9qkESWdrtz3UrSw1nCzQLekU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE4BQBLGJTwLNX5IRDfa7fUzeonhN5MQdpGxt71hH4kw&oe=6AF207D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
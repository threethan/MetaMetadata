luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt9Yl6DL3qMQ7kNvwFQQ-6N&_nc_oc=AdpghV4M2VuYwGrOX9D3arEI-8kysHHSybaHrTG2uEPnlGQ6RVB9ecyGVpOFZ289-6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nCXaTOKVDwI0FbNYKbl7di-z3Pkkw6ttAemlWwKD8ZQ&oe=69E397CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8_Y8x3aKyEQ7kNvwF_WtSu&_nc_oc=AdpDiZ7QCit54IWFuscKLDGuVArr8pLjzoA3ExR8DC9228P-1kbKbwcxFgiGmiD-9o4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oAK4zYmlZ7MOoljo1H9DmuQdgEpZSnyK6wxRE7YryQA&oe=69E388AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k62Olb-zpfwQ7kNvwFUbafG&_nc_oc=AdqQK6f01OnLhv3-43DXVcLrFHcTtJdvR1lk_Id8nj4AI7uczmTMrhAQ0MC2qWB18L8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FPqKhokTYwc3jUdRQogeAtJ-1bYMQbFFUSONCRw50xA&oe=69E37445"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkGh7lavaFYQ7kNvwHJb5HE&_nc_oc=Adp8x8m8Gxrf038hCmp3xsKvS680QCZE7FmkwhYk3umNuI9gWrNJpaZz6XaDS-YLkYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KmLfC3wfFEqxKDnvOkyWGD2K9NEoWfquNJgq_7VD1TA&oe=69E36C5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25o8LHG753MQ7kNvwFYF3am&_nc_oc=AdpCI6eELZxE-5pWt3nDZyI0IYeOQED_e7DBnHPUvgWrWCb5h1pFfgpbDd68vbskaGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BtJY4cl5u2voxEt8fM89oWJ_TTUMDmixXQxAyW3KYOw&oe=69E38C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
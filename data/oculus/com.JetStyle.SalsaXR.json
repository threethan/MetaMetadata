luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QG-5oo4qv8Q7kNvwEVqSai&_nc_oc=AdrZwUHB5lq8I9s-7oWuDbWQXPcrk1nINLzIcK81vjKbJnbk0N2HyHVVZH8vd3_iCQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhwFQquwUSe10uVfHDB7DwuNQBbN_Cdq_Y6YxSRfjuJw&oe=6A86D98E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2K-cq39MEQ7kNvwFaR5it&_nc_oc=AdqrOHRbqv2f8_98i05wXPfLzpo5epS6cEEI2eOtHAC-hW387quWI0R4V-z0Y4KAlKU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVzl61UB4j_UKnkgtaLDaN1WP513-i2euZUJ_-eIK4AQ&oe=6A8702AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr8-cKTrQvYQ7kNvwHVUXjD&_nc_oc=AdqP4oqa959mjlE9MZl4gISPSMtnKFoOduF1aOIaECaG2K_WGrkx9KSTC7Db-H0SNaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkeYPEbcWsRp7kYc5jI6pJJk8in-MzFkbAZcBV-s_ryg&oe=6A86EE45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0qalapUW-sQ7kNvwF79imw&_nc_oc=AdpeHLSW_BK9-ratGxj-WJWDq8p4CafIsubpgHBeH2RQ22iCJdJ4L3lA5mB2V1EbLK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEbkYe6-2v_w2kHfSfxsdWOoct2IVRY1PqWODqQhwdsQ&oe=6A86E65A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JQVSZyzA6wQ7kNvwGn_Qp4&_nc_oc=AdoueI6H41azZSqhR9zfpnHHHuPWyi_rukHGkB1vr5X0qxZH9Xy0Ku_5qDjezzhJUiw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcl4qe6U7VNsECNnJJBz6qHinsKnQJXpSn2z3dUdQfDA&oe=6A86CDD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
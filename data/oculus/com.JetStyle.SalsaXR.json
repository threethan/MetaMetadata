luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhLvvBFrTgQ7kNvwEM3Ses&_nc_oc=AdqCpgE1E9TpzfI8AzxDpUR38fdxGsxWapsPBnIFbDlcnyh3N7zl1KN9HOphbBMbk6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af504fvxxSGw0w7SveP8mzGSRj_e0u6Y8-lP2Cxe-6ZveA&oe=6A01EA4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ub0UAfe908Q7kNvwHv2-h8&_nc_oc=AdrnDdm0XyVAOQgaqGZlfTv1NFO2piUvDE5oetUtSY8w7iB4VXx8QxrAbofCsZuCQ7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YNOAjQIZkLtRq4bL3uMn6tZTH4TwxtCrvgAns3r083g&oe=6A01DB2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOqRJBe_3CkQ7kNvwGzljJ6&_nc_oc=Adoopdk2yWENSQL_gaOvMQP185PjB9I77lTBadbPxGbc79QkEu6TJlVCbnqm7lTK3kE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77tAeMqxSRs6gV49PDbK0Qq1kxzs2EGwB1gLj3BIvM2g&oe=6A01C6C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhPkGeFZZCsQ7kNvwHvXQA4&_nc_oc=AdqrD_VzHr3kilsMU12gZuYR2k2QdeyTTZf9ID9tinEkSOTK-eUW5NHB8d9N8AMNp8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64LO3qR5kDlx6ZrpMN48v_ZFdUXH8j3G3W6Hctnq9Hrw&oe=6A01F71A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=offSbdnHlvUQ7kNvwHQnFjm&_nc_oc=Adr7cSuB7_k9zdNR_pZ4EIECF6WLLfM_rK_Cnsi8FTt_vrZ39lGqidmWrbJbaLOSSpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53pBDLfIieSP5ycH1kLQm_hiaGktkC1TjnQa0k5jo9Gw&oe=6A01DE94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1-07inXzQIQ7kNvwEjaYzu&_nc_oc=Adq052uCXAh_wbZMEL1IHyP6Gn25eY4uV9-4gK2WcUJkVGiEL0hFUy5F7D1n_mPs7Pw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqguxqvpk96rCOMkmj6mnQFPnzfP1igoDQZXRVAg8Cnw&oe=6AA01E4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq85Ao8C_2MQ7kNvwH8nv_c&_nc_oc=AdqghLtvT_te_pY3oEKgH3kARUBBeIxUfkrvg06MjUyBLVOyZyQ4s9Ch-A_sCPgAw4I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK37Ijy3uX5lwVld95sjupu_-7h83umzWMezZtut7wJNA&oe=6AA00F2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19r2I_gcP-8Q7kNvwHenM02&_nc_oc=Adpn10bQOsW4GJmdfm-lmBQyTf8lIBxqnRk5L1Fnk2hSu2iYD84sCGEaTe05EpBDOw4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuxwcCyjx31d0-f_TmTPflgcqkbT7_Allv5IFe7rMm7Q&oe=6A9FFAC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNtwqIibbukQ7kNvwHMK-qX&_nc_oc=Adof-7NVrr6MyT4CJLarCKx8nw58SQxRZpMY9a4JeDL-BsrUMyBqnk3kCAZQDwSy7uY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRIHzqKHMGn2HYmXFOvh--vluPdbJCGaWDMnQ3K_gj1g&oe=6AA02B1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuGTcygBZiEQ7kNvwE8oqp9&_nc_oc=Adojv2IXtEBTS2fetGKnqvRINgo94gt85RTAOGc3DGJpQZHQLGHIQXdQF5RLaES2PiQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvLjTS5zr48zuZIlBfvPda46DgISznGt_2qpPHIYKXyQ&oe=6AA01294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
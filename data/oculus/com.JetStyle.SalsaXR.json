luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3KQZM0hCVIQ7kNvwEQ9Opk&_nc_oc=Ado2NWFdntwKG3x7LLbkJkuIw9pUL63E1d1s8W4UKJs8W3IlzkH0wfjAwPFzv3ThFgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtAGdEvPxG9Oz0XM3FC-W8uYSL4D4RsMbH-v8O-NPMJw&oe=69C939CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1IG0F5D9TcQ7kNvwE8_toa&_nc_oc=AdpDBRQQKMLC1yIJWyHbdj-35nxatwNX10YwAkSyeLK7lTv032V62Iy_aho5bKSBWkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYqBBdALXriYryocpll3L4FupZZqYcwp7dFwfrVZBZ7g&oe=69C92AAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-ENbxlNGKcQ7kNvwEVfjiI&_nc_oc=Adp2Waf_AGDlAq_1G6gH5CrsgDvQfFr82j9IGTElgcBXCWI1p5CNaOxHZvGSkExte8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMTv7mAxCBeH69nluLHl7oYhILprkWF8uQe4brTezCPg&oe=69C91645"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMyE9G6Id2cQ7kNvwFjoBut&_nc_oc=AdplErmP2L8A2QbD8jJD9jOtp9ASi-Omt2hBiQl-oW3OiDKKR6Hur9WScYJvyQYaBAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxfdD1r79qfcCGJqVr73q3iB-5EUrvaWj8rgzbdKz8ug&oe=69C90E5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHrTArqd5CoQ7kNvwF67EM1&_nc_oc=Ado7h-57ALyVqQ_nlhU6EicxNCkzyVYoIoLiEoTYgw8eflvAYAWU-d0LVoPznwLvq6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD6tG7JT9Y_OBG4Edmk_GESGzg5nlMf5fCzsoE8PxJow&oe=69C92E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
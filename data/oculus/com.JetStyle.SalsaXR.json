luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_44zuKeeQsoQ7kNvwHvoGCf&_nc_oc=Ado44F8MIeZinVxK490jw1-tRmJ00FeT3GtjeRlLJY9IhKN9X1HPgCq2ZlF5w86tvRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0v33BLySAtcuaxKq-q93ACkOafR3rkilUb6Qi3IWo9Q&oe=6A78914E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZfDH2jvheEQ7kNvwHhqRle&_nc_oc=AdprqBkk2C6OXI2CajIytbr01FuRNcWV4CviS78kN7IY1JblJLKhOt_xuYihd1tTsus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmgk75BXzUBakfqhZW0XJP4-eqWtbSHQ1LK4DPkQBGOA&oe=6A78822B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrtCajAZtfMQ7kNvwHob1vF&_nc_oc=AdrQjqyWEo3AaR2hBsaQl8f_vk4wpHmhXXjIOMIkQFFjnDeHQ1d5O-s4AQ7HzlP2qJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyh4mf06JcO0cRLmFMLb7OR-PdL2tOX7PRv_CdoBAZlQ&oe=6A786DC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwxCldWMaH0Q7kNvwGwo-Hy&_nc_oc=AdrrOkto3dvRebObFKGMNfVkUT-M7gg47816Y0HgGjby1l5DFP7fxYAhaVpQLf_FG7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMFmnY1QFD80isMae_K3Z65XlanRYVGU0H-zaShigccw&oe=6A7865DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD7ihc2o0YwQ7kNvwFDmhqS&_nc_oc=AdoJziicaZmJTOAOROxsALrJWBwF7e3VJYgxdye7_LVb0guqvXtraiy5HnhquClUzfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhFLhJxoIQW-aM8WVrLeSjLruwBDZIlciCn9O9tKQQ3Q&oe=6A788594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXvfF2HQCSQQ7kNvwHUp3FU&_nc_oc=Adpgi3BqT_EKj904EoVxHtu3EtUnBmtvAb6e51ujaToMtnSplkplQwNGsE81AQtESDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dbiYQG0QFuoe3ZT2rekDnT_G2nI29gWxyo5INWHKN2g&oe=6A3BEC4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSSu-ejEMeAQ7kNvwGGmJLu&_nc_oc=Ado722G4TV8P-hTtGJEUeZNiiJGqEULBlF7jJMIvBrNdY4k21QWGTJ4Ed_6M3Hv72l4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zFhrA2-68e6voYCYARQTYa11GrGqOaf2g8UJlmetYjA&oe=6A3BDD2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08bV1ozkCCYQ7kNvwEAzoXM&_nc_oc=AdpN-k6aUua43h_7qmHib2z2idMsXn0NhV3bWzg18HkgEhCklTuRn8ZDhjZc2l8GtwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94If1JE4UDWtPM2Hx8UXJgWSIL62WZt5CtXdsQ8jte6A&oe=6A3C0105"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9TIKp8aTnsQ7kNvwH38wSm&_nc_oc=AdqbSs9zyf_KjdFcw-xGQ9tsFodc2nuR6PRwiIMlhM3ix-n-ooeoFQM17n0M5gJR2q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h0ndyBE-T-BvPzaYUcZAiH-UNL2QoHjl1vixQkcRWmA&oe=6A3BF91A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxR7Sn5pzawQ7kNvwFyKq3R&_nc_oc=Adr8akW9GhqDKhK-2G-4kVYo0S7bW-v7bmYDfJhNeo2nFTzSKHuUKAV7BauRPpi7POo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-olj6gCcoqlcoJwWv73wHR8kW_PC-xgl94sxDHWl0YZw&oe=6A3BE094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
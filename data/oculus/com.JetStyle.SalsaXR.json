luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcWO8CLWTM8Q7kNvwGcyGca&_nc_oc=AdrT3kcIHcPaasVoL3AvO7S3nb8-sOV0StMLGUivlUjAfwCg6CuW399ZnRZU8916R6M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwnCJVLVHUEBuMyvia0S5RTxrRMIpEkDx4Yw8zxayq3A&oe=6A9AD84E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5PVYAsmgCUQ7kNvwHdd57c&_nc_oc=Adqw1Edqo2DHV1YinboKUVdqPtAhsaTnron1UJ5uhzgcXdvpBaVSTDKyG0MCBQxFaXc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEt4CYEfeeBdbWaW1NvCUQhek49Cys6M06ZjpLP840dw&oe=6A9AC92B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkQpqQLqMGkQ7kNvwE69tlY&_nc_oc=AdoJv5AjjgbUqgDiK2F4Cm41typ_kmEXHj4P7Vo_Zf6S9IMQVYA9VWXqzikX_r-_ho8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGtEaCC3owOynexVowE06rQng5Rp0rAwrNBvtTUuoMQA&oe=6A9AED05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvlQQNMrqCAQ7kNvwFSk2R2&_nc_oc=AdoxuPn1atFYojEbyKHLgvnHYJolc9k-aJUgc11i-pMSttjrr3RY89VNtLfLvKgk5ZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgPGbjU3VEhUVFuhp15WfKXbU4QXs2bvsgud00vyt1Mw&oe=6A9AE51A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr7JUu12L9kQ7kNvwF4v7nh&_nc_oc=AdpPTAErRc4BiGNQYBoRxTfCKtt1FfrlUNYuRmAEKTe-h_AshpGECgmc8z7wv17GpOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmVc82obaEuegmlxGnpC7NgmzJdR8I9apVc8rdN705jw&oe=6A9ACC94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
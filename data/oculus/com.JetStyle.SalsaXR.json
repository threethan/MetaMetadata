luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2vCG4oXAnAQ7kNvwG5rGh_&_nc_oc=AdoLVexSHT_dAs1B1JeREUm7qFyjCPR-F-SjgF5REYCkYvQsD4g6qXKUfjtpeZPEsIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIof59oQM77TOAH4y3JlS1nJz81juG4Ty9pP5rORlzEvw&oe=6AABFBCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNzEwVCoKWQQ7kNvwHtappd&_nc_oc=AdqbSAZfggS2qFIkOJf-OvrwKaEvniClYh9J8865QOKVJp8SS8xTaJoBiOyVD4Uj-hw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlX0htnDVhn6IvwRewvvxijB6iphPguKPIdaj2GECvhw&oe=6AABECAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erhtUL1Eqz8Q7kNvwHhjZOE&_nc_oc=Adryyd8ZAdcISL5k_ZQ_2H4UhqxnfpBkg5Kh2Dhke-U-AMBd-Jelq24T9SbNiJcbP1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIemG1PLrvBV-7msYSTY5vKNiS_Amxk0y0WuBnEhmmdPA&oe=6AAC1085"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF9nBKkhbT4Q7kNvwEXnyN3&_nc_oc=Adp7VBhHFHOpRE5IerlHRSuoTDfWnM3VUtgyiybaM4LuHe7r-7TC1bBgc09qtHcFpVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ--8qPA6BpYw8_x8NpTDDuQb_0wgQcmJKjyJ7N94U4Ag&oe=6AAC089A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9Od6o0iKAIQ7kNvwGjO-YN&_nc_oc=AdqbTHfzEHkqgeWoL_wD0bb3IwqSZNQdi271rky8HSbTSVUJzv3DxdaTlKg_IXzbfao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwnRuQ0w5yO8wX0YJfezxl-p4MjV8q7VZNYeesdQICsw&oe=6AABF014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9rzJwfN1c0Q7kNvwG_vtfW&_nc_oc=AdqQuyKnVdIT3k1qGoP1tJvH29rz14opYGyxvTDjqCk75uTYz61q1KdXGJ8zuzfB0dg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCabcU4bCBRjzjAQKzU0w4afkqjQxhyJ1VngG906yBKKg&oe=6A58ED4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w7lMw0FtUkQ7kNvwH1h5xC&_nc_oc=Adp6cncy1pjrQI5igPWIgFVIsky5J0CNHX5Qeb5NuhSFvAxUPoSqAnhrVIRL7F4gPII&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBratqKdFWrvIpAyEt6j8tjf4L__Y39DWU06lnq55nfQ&oe=6A58DE2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZzOlYAlVyEQ7kNvwE-8cOs&_nc_oc=Adp6Z4_5x3kAOJukiRGuAp3jWR8k100-d14-NcFPsm1gMOFrZHwvCkcfGFug_YsGUIM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXonXJDlELYTNlObP6bxB5fCUBA8TVYOztrgWVtuvvWg&oe=6A58C9C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2hNl16A6WcQ7kNvwGjGmBj&_nc_oc=Ado_u-BEVO_58MFwgP72BaHzs1S0Vl132W65QpHoHnWp4IYqZrvwqouTRkK3lMNnZHE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0TpEGMFJeV1KmFnMOQP9eRlQm9tLxyN9hIm0GOAzhiQ&oe=6A58C1DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFOTdQFYGaYQ7kNvwGVfC0z&_nc_oc=AdpXXiU_-GCsqNCiMCrQqFBP0gjVeR8tsz1A0w43QDonm6HS0Ip2_PqrVxtXTVG3yM8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEUQStrrwDxxOUxD5EpuF3avt1pD5agDuinTzXXIv6pg&oe=6A58E194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
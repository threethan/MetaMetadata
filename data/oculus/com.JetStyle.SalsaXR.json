luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67uqH8_1ACcQ7kNvwETyHIf&_nc_oc=AdqHUygEScjWZWoUJ7ZpJP2Jvopl7oMYEBhlvAbrozvr__ahcWveYiNwJpStK7uecq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9EVszD3tFCUkZRcN2EfoXDVW673dcb6FhU_OAx9GLpQ&oe=6A4A6CCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7zc4FIfUdIQ7kNvwHSGjNr&_nc_oc=AdrkUIJj3Wg8YF3YoOGuuy83bLDtWtwVx6TqtGlSEylcNkuUlxlH29pBQ9Xc9GdMvrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB_D9WOfXZZmWKhuqc9JmMnVRK7Njh-1WnSZC88zWATA&oe=6A4A5DAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlyEFjoHUB0Q7kNvwHUsbcc&_nc_oc=Ado8MXSMVkmltAL35j5v2c6sW_-tW_L3lj0kv1VbwOB7tR2E6OqfDsB5cfJEYcAAoKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjZsKwaY950md8iRPJ8gYaOIdp6Rydgqd3I47vtKC-tg&oe=6A4A8185"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ktcp5fHW_YQ7kNvwEIxH5M&_nc_oc=AdqGbUlAPeTdQGPT8W5_exZilkhEKg1ri0xCXqMKET1p_4Qs5zbehhiml44-neDTgTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrRX9xvWTKoemJ33UyAONCp0KCOD4uJt_Gjbd0SSwjVQ&oe=6A4A799A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRa0C5w_3AwQ7kNvwFph8q1&_nc_oc=AdpStmKeQzuXvkR96LMcXrEsgpeqjU_jr0PaW8sf6vczjmRn6u9-VrDuefbrnVYI6sQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARgj7J8xn_tMFEhTXdIsLyyXy6CzW6UrOJbwURdXu1MA&oe=6A4A6114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
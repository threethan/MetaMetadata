luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2sMUVenzr4Q7kNvwE2JxVd&_nc_oc=AdoL76gzooZaFLPGPdUES719m4LuILY8bjx2zBKGRTA-hwJKdx936MbB-YFmuqx2XFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LdDo-nPpqcKCw14v6qLuO_r-gg4EJD2fykwkX0y_Xlw&oe=69D90BCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DG-ZQtBeQncQ7kNvwHExj-m&_nc_oc=AdqJ7Ru5GUXqH_QK5MCl3GYE18NJDZb59Dn_Zg2rHO7_f9aZnhaUTQPEuQQx0g10wWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vr3Yx45AJgQ0SZZdIHthcRV5CeU_w5_xXpwAciJuL0g&oe=69D8FCAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqs0Z1CMSAYQ7kNvwEdE0PF&_nc_oc=Ado2I8a8KWuhhaY2HbVTRNh-xHA0N5sZ-EFeI2j9xcv056Gvp9YGEtCzdZ6Grwq4xqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WQ7kB1gD6-7EN1kUjY9K3EQCGMawjFRLF1rf0zjmdxA&oe=69D8E845"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjZn57dt6GMQ7kNvwE_nqBY&_nc_oc=AdrCZlzgjzlMfUbcOjG3LvnnemEKk570596mQsiRGTY5JpsTlN_5usazdERSYS8VKLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a71Wz6ZgKKOdzcIToT3F5mmClpdyFdjhxkajUUr7KEw&oe=69D8E05A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32yWW7xLf34Q7kNvwE-PzdW&_nc_oc=AdosYLqSqWTiMM3lAwYli4iJUGFCsxjLhJBedFKxLIeavLJGCeTxil0gTRDMTx0trek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZbszHEyWLiGvGdxdR4ESaCTVHkR1hMQSIxB1lw7_00Q&oe=69D90014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrPYwmMIB8EQ7kNvwGtBsy8&_nc_oc=Adp2q070-pHnPBZlF6vNKpVE1eBUB6BG4WSvDch_NbAn77o3rUzeU_RPYLcxIrqHMd8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kvy7r4Rl-LFeomKw7C0iugwkrqPQRE9PxZet75V-T2g&oe=6A0F194E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n74MUw0jZh0Q7kNvwFVCHfH&_nc_oc=AdpzH8fald1NbPsAti8EvHyfHFN2uDZY0ew0oEcnRh6QXUxDvGMI5P0nfrqsR15yZ60&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LWeTJs7xnDJP1eduRcTgJ1ZUtAGqVuw5Z07tOTGR95g&oe=6A0F0A2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RgbzsGFBEMQ7kNvwE7I64_&_nc_oc=AdoLOVgHqLqfvs7m7yDLcD-60VeOLne96A7Xkc6k0fHl6iHfRbeAiEeNec5kUWFAU0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BB_BSZrZyvGMYNCg8G4Qrf9o0bLOGnqsfXmf-6MwXTg&oe=6A0EF5C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwIOXDuWGu4Q7kNvwFwL0Qy&_nc_oc=AdoVX_MWIXC7lJTyYNv1_ATtpysuyEE0IOL2likJf1PzOkuk8R5reXaDp7h3D_oc11k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vyII1WIHGESHm5yQ-hyqOtpYF35ZNWZZDAmuOTeqDUw&oe=6A0F261A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvfjOoc01awQ7kNvwE1Y9pB&_nc_oc=Adqi8ZRQVeeXRgcnJbzFoUulGdEDmCPRAl7sGDp5v17m0cVtJFcrcSnMk2LTIWA5DwM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VdIu2In9sXl7XNchZfsqIcB3F-s6q38NsHVAVRE7IBQ&oe=6A0F0D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
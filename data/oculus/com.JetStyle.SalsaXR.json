luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iHUO_UB4DYQ7kNvwEY8Evr&_nc_oc=AdqHxM5R55PiWqWB7tDPvQAaSdvrcs3YgsrpkPLejpIsYKSmzeAGs6l7IeHoKTYEqJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tol1ED3Xtr56bASxHmXHyCQS6-8FTMWlRqKSeFkCH7A&oe=6A3554CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKyefezpsqsQ7kNvwEcQ6e8&_nc_oc=AdouE-50vt4ww38iiAYRWPY-MUrunKclzeOykMMvKKcceD4B-iGvrlZy3Vx5UN3oU4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2UFQ7U1eTWsoMeOXWMlzsHIwfytClrNj6w3CVhk3OEA&oe=6A3545AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcf350R5SEsQ7kNvwEVHNKF&_nc_oc=AdqhuMv7sj15aDkUCkdp0CcrOIo3wzzCfnUGAhgnNaXjuCrWoMTehOBRp4hC2YLSn9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rb7wkrJYUlbgLWuwOzmKKg5pZRdUHyYsWdERZkyxIEg&oe=6A356985"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdB9W7mqlZ4Q7kNvwGuwUGz&_nc_oc=AdqUQQET0WR9zBn2N0k7usvYCSD9WScaGXKGJOJ7_slwiIT5-5fIQ0Y1Gx3g3SNLR0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sAVzBJtxkKWRJQmqU8H7_LQ3VX_PO7Ib7FoKOxAWiXw&oe=6A35619A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4YRHjdblakQ7kNvwEMEuzO&_nc_oc=AdpZO1XaC63YHnwwf-Udm3iLEH4rb_4L-LhvWg9Q_vmQ-xeB35eHUG5zJ54Y6vxRd6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tbfmEdcs_lv7sk84l80I5qz6m93JettFLi36QXYLKXg&oe=6A354914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH8qRsDcpx8Q7kNvwHrqCAB&_nc_oc=AdqSquC_9osluaZtH6FMoIlhpnTFmCvwdalgCjsI-RBDgK6og8ZeLvpfbhO4rAhM-PE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VjSnuNjh4eFWg2Q6vYiBJyB5DLUuOWT7UTTSs0E-1OQ&oe=6A31604E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPPb5sYiGA4Q7kNvwGeMaxO&_nc_oc=AdpNRKJOqkDusq9Dehtb2az2_2QA880c_giegmy17lLgyVOCoEJpS4k24p4OPmKZQbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZdUTAUJWPymEWE7yDUPJIbRJphEH0o9fNqbc2zU55zQ&oe=6A31512B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuZ0B5gMcHUQ7kNvwGoXaM0&_nc_oc=AdpvPRY-0zgek_nmVFe2GgYdGhjtIUu_y296RFtTwxBpAuZHdGhpQF_poq-gOPI3oLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mreu3gt7bOZjCadfkCTCss_aL_QhiCMOJyW13Fh6QGQ&oe=6A317505"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzw5-yvV-kEQ7kNvwFbKmFA&_nc_oc=AdrGW67rvnq7LXcIACCtB1tjkLBFNaMSa9sOj2VkWXuYKA5Z9XuYurLo5XEQTrfnln8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bWRD_lzziVscG3iLeFSKfuIpugPjDS_MWomPXA5UUnA&oe=6A316D1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nuALL2eH1IQ7kNvwEvbKbQ&_nc_oc=AdqvYw2Cg1ePkudiA6Dk2sjjdsP6k0BP6VqF9DD4wim0kYowbayQlMDzkzcLtHlIteA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ztj7zwuW8Vy00MQJX6shJGAeRhIGHFKNMBhfZjbkA4Q&oe=6A315494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
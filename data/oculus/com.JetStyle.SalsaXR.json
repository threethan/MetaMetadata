luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep2ZCcSt2NMQ7kNvwFJKS-l&_nc_oc=AdrtImOZz4AgbUQXZHqaW3HcDXnWMkUlUgOZkHCKkl7jrwFV1V2wIUJPaJxF0Ta_F2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFwA0esrjQohwv_9sATvHkJzMyKKtrtKQzVVvxTu6qSg&oe=6A5B904E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w7lMw0FtUkQ7kNvwFxrKNi&_nc_oc=AdrKGEbTAH10Mk5S_dQH5RDprOM0cgqgla2CIiL1Jkkxb69P8APr_fziD8VtCjH6ilQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHP9syR_124hCc1TZcu4IIYanCe0x0CH5SrmSd5Q6ELQ&oe=6A5B812B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZzOlYAlVyEQ7kNvwFsrIQ8&_nc_oc=Adqujdio1q-jbPu3C7XvVxVJzF74XJceRCUJnD-NGZ_Gj3S769wwjIu0hXi5-w_z7Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2piEWgi-4kg4vygoTZU1hYlKvACK9BA4y4u1wtCs1uw&oe=6A5B6CC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt1ALb-d7dgQ7kNvwG7N0ID&_nc_oc=AdojAOLNU1fEWunTrOJqSwCTWXBtPkxiK7gZen3Ebat2wxu86adZPJqLw17EUvZj3wA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBByBCRHurbxBVE3sa741AEjKN8KhikfyfjRL6kt-w9iQ&oe=6A5B64DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFOTdQFYGaYQ7kNvwEJrTf6&_nc_oc=Adq2Hob6-AkRKjnowgit2tJ0qzfVVDdERs5UBJUbGvPScYL6b_pIPvEeyrdzYekeL2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2o2hkWgSm1qlkbZBjDFybwKcKEEbhk6U5vZl4iGWNMg&oe=6A5B8494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
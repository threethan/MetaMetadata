pFJxn9i08emS6IIfgrCsnxxzQ1ouwdIFmKpTmGBj2bUIJdgifvjXrkaEiX9sII&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afti4XpBWKiJ0mxaQTY4qDewwEmRf14i_QcsvbVnK5oEwA&oe=69A1ACCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouOKhy-i8vsQ7kNvwEBe868&_nc_oc=Adkg_Y77AFCYfViLzqOgfXtEFMQQtelmKApOUBNnd05L7gWtkNEAYR1kEajz9rzaHY4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afve7fziBTXp7Yd5kcIF1KacRl2-zjCXOCezszvfgtAQAw&oe=69A19DAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKx0Ywj1LlQQ7kNvwGKfVZt&_nc_oc=Adl1FnTBjZd260IRgYrZV7bL-81Fz3nucVxpQK5yMVGM6R_erCX4Q4WW_xOTvUQm7tI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftut0DBVLoos4zj6Qq_jm10PRdwORkWJ0YuhSzJr1L7nQ&oe=69A18945"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_QHsvF98ygQ7kNvwGwz5-l&_nc_oc=AdmeY0_8Mj2kFW9lAYGTJ6bli_xFzge_Z5WfMUSQVcNC-0rH5ouOOjrUM83eU-sgEaM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu3PaZfcq3AuHDcI5vy6EUF-L-cUQYbzXnVUWhkam6fTA&oe=69A1815A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWu3dtOYn0wQ7kNvwGFc9TH&_nc_oc=AdnnGfdfxJQc_gj7F1YSwvrNc6dBNPqubSqaDhHwKl-MArZHe6xZjIO0ELhRqSWTROY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvU_5wwq2hI_zuRmjV2nurL6ZKHYaEpsAxFJpyGyCEZCw&oe=69A1A114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
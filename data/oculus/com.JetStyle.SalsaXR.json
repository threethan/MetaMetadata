luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjtOtKdGjwIQ7kNvwFRsA-K&_nc_oc=AdqB3il6AJHJ1Psdz8GBbWhrZdBzvJpbj5MUMmCUT1KyhZ9g6EOExTTsFU1l35xv-G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UCzsLII9ahShzT46IuIUjw961H41yGPQn-K_lK2durQ&oe=6A1853CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3Qi9NB25C4Q7kNvwEgmtM9&_nc_oc=Adrm2Vh5HNe37ilet09kNEmjWIIUe2AbUWsEIfiYwp060woBC3u15ABrkv0WBnsm_C4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A3reNqquwOF3KL_cf0SB-Y0jS4XLyuVUXD3NTDelFXA&oe=6A1844AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akoj-xB89LMQ7kNvwGKquDI&_nc_oc=AdoHGmFVohuKT7ks5rlPnu7ju3SnzKeIhNiXaMW60_VRsxcJA8G3AT_2mmb1nN4aSoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54iZ56wdHcarJJqZhmFN_4uNd8qka3Vd7vekfvUOGDtw&oe=6A186885"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-AXqjG_iJ0Q7kNvwEZtaaN&_nc_oc=AdprnycfZWOAfztm4emWWzN15Dxd89zjQekRnNdd0ojlAJhsJo4FGSCsU9AU9CklSBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eekcOETaoE_PlW6fbJAvLuN8RwuUVaOAzw3pVeRFLiQ&oe=6A18609A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BRcRMoaZL0Q7kNvwGTAsdM&_nc_oc=AdrNpEb9kVoGg9isXbDdjnTFJwOVNipl4bd3jdb2GYgzQ23f2qIXLbMdwT0GPGL9KA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DYG_n_Bw3HFJs_wk0VZybo3GTokAgYskRPfqcY3pmsg&oe=6A184814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwsCnIO5ibgQ7kNvwHlhG2u&_nc_oc=AdqOLDgdY6rmWvGQW9nQyLQ9B7hcVIH2RW2FoIQj_msQZTVHmSYzWdF7GKgifDuvYjU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYYSRxv6khtFkyzEglwVDJP13PshPUTZPvemA1yfVkcw&oe=6A4E614E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MO7VZPnvaYQ7kNvwG2tjcE&_nc_oc=AdqrsnJqYtMLIV6InFIH2SXdBG4g2UJeTeyXUqNZqdlsuP2Y0NME4eDA6i-KSlRz5W8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB90hmvzXom6ZdAyWy5t6tJbPBU4QXRDUZgnaqkOoAqHg&oe=6A4E522B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkTZIQpZpxEQ7kNvwH-yKCF&_nc_oc=AdoK-wj9A3udZ3ZBmBcHCNgBXuf5AGAtBjobxJh3w4t4t71jlxSXaDfFL7oyeRObYBY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKOG6hfmnDHUf42p2OMD9U6Gih00W9oqYK5z3UN8BI3g&oe=6A4E3DC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCsaVc8CaNcQ7kNvwGSP7fB&_nc_oc=Adqatg2ueippHdePC86NcHzjAyhBEaNLFz2Ypk7viT5i3qDZJJY8PsTfB7cli9rcx_k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmo-hHZSphnqW1PsXVu_xX90v_exTR2uk-Lx8oHKUrAA&oe=6A4E6E1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr3FJ5_oi6YQ7kNvwEhQFQ_&_nc_oc=Adp-WOCMfnw9WfCCfNcb-wr8Xg6Ez1aYL6bSAA9xDXEfL2Sd4Cmwq0NK4wz3ssvGejg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARTn13079SVXs7DW9OS2KNPDTqcE2uwS7GzqVROd0ypA&oe=6A4E5594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
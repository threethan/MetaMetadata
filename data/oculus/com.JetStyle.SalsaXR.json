luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH8qRsDcpx8Q7kNvwFO2SYz&_nc_oc=AdqUAq6Qe-9f86gyz0H27y14brLp9SLdvKrQij0fHDFNzk-dmgomq9GcOBGdbkynrt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p4QvMwKlWAKDmRCvQTkHLgwb-jMyscp4bysMCBozbJA&oe=6A2EBD4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxhbpPcLiK0Q7kNvwFz1MVA&_nc_oc=Adq1KdrpkPYXcGu78h9VKUcepxiDjx2Nqe5W4rD3aJt8oam4xPNlHMkyCJ52B-Tigio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a2_S-g3n1A1kN7r7tKFgnm7WFOC6DhTkke3d85Z-Nrw&oe=6A2EAE2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqRaNvXKJ4MQ7kNvwGOEqL4&_nc_oc=AdorGtdRtrUt9r9971p--XQ22gj8PqA97gXjauHnZSzBJhT_T546o9UfwROz4Dpta3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZOnd4NwLEGuX8ztcLx9CUXJHMT6Vg9gNQdtpQL3VdCw&oe=6A2ED205"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzw5-yvV-kEQ7kNvwHFl5dE&_nc_oc=AdoBOZy6mf-htJLZYlu2QLHjp2bbLhOr5F4eZY53U4kDAXV-44mkfLUsmGri9JpXiT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SYued9NEWsEi2igEkqBzfAremNJ7t-41I60O2CPbL4Q&oe=6A2ECA1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtYr7Utu69QQ7kNvwHpiG34&_nc_oc=AdpiNkf_5iBKr6D7cTtgySxwM29hHHVwfekh2a0Awl17LhjVd5hT-hmd-pdQgUgwMvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U5zeyWU-xgd-vNB1ON71DDW2PmFzBPKcs8RSeuNyFKQ&oe=6A2EB194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
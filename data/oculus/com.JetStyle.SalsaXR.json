n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrPYwmMIB8EQ7kNvwFD0G7W&_nc_oc=AdrIdkA6L4zDjMrCOHBf0yK0V_p6RKcCs1iSnghkYmfJ6hnwL-eRn8tuKNOcMzdHxWs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M4B0wJWpY3mRn_c9J6oAsFRny4FSDRczRjm9rt6NG5Q&oe=6A11BC4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-_PFwIkdH0Q7kNvwGPXWDN&_nc_oc=AdpK5iGZzdBFZSd1vzPKKRJ5Fk6AhN6zlGmCTH-n0LMuSCqvnaElL_ZWX5NxZ928y8I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yxMh5Kht4EsY0sKp3zzC56aHYQEsmvEcnQSrUtN420Q&oe=6A11AD2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0AAemSSvr4Q7kNvwGMCnCB&_nc_oc=AdqaBykpOivsUWzN7aZaTznExHCIli4_wbx0CV-lzDSvfOuYPxBmNKi6UgZO5nUyWgA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ADy2auyeehq09mI6R8a4GaDvk5_OwNJbzuJa_3lYo_A&oe=6A11D105"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwIOXDuWGu4Q7kNvwEoJhVp&_nc_oc=AdpM5kviUym85rsb14ghNB188-14SPWq_EwTnrrDNlbnBY9ykq5K24KiuFwPPoG2rNw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af791LtotaItNWHB723GMYagFG_9Yg76qIc5XB2IwCdBCw&oe=6A11C91A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWUsz-R6094Q7kNvwHvH8Q1&_nc_oc=Adoy34G6YKA5iHF8NKeGBStsknu0_-maWk2unalrxaRx3sQ40EmI2D_XtDIx9Izpfy0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P1gGs2bDqzbhmUrEEK2GZEtpqj3AfH2oMHgzLRtrW-A&oe=6A11B094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
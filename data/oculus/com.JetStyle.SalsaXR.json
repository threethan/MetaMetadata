luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0h7pNhO89IQ7kNvwGcAuja&_nc_oc=AdrWQUtCw4LFVYtgP8BXNQjRguiy18vMkOlU-YHmMx6koDarMAUGmTmuBYx3_TfaUHU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R7hpXHZsKUt7BI7V_T8FYFrHqLIvE7QgSeuQ9py2o6A&oe=6A24314E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woAZzYtQtO0Q7kNvwH-bG7h&_nc_oc=AdreeGeN2oLh3WjwNUP4vveNeanefCWS9AueeDZMqql7pO8mKAYyRnrCY9u00qxcpSc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gl7JV-J0LKfjc3IE2TU4E2SkZtmXBHLAz3fAXsY4k1w&oe=6A24222B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGKOdGhMW2AQ7kNvwEIRXLU&_nc_oc=AdrYRd31z2ZyEDZqGtLztFXeyYjd2T4mjPpHyzkZlG3cdk-JCemOOoZXo-igFNiRkmY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vb4Osx3gEhKUgtnkQJurDpJEdv_iz2FxYL-S4nYWhHA&oe=6A244605"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9hRrurcmCQQ7kNvwFOQWht&_nc_oc=AdoNZ1qAmxEUQEXzgSAzukQ8HqV5nrm-SLLQ1jzR8VbxnAEBReMV5IOjqfpZGwS61hw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I42V-KE8zlYixTok7IFgfashNAH-rAy17DxVguS0UPg&oe=6A243E1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFSgdbCZ77QQ7kNvwGBellr&_nc_oc=AdrKxk7NWDWeQc_gld8d7ifS8rQLrUmqL9o53GairJewYsRW05luikF4BoSRoItKVjM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1KWakPnpv1YD3Fpa8lR0SHgA1oBUqTfkRijqP6CbluQ&oe=6A242594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v3hgJ75Lh8Q7kNvwFJ18NS&_nc_oc=AdqE_f-N1eb2z8-QkhLdAdSN8EUo6z8RbHXjNPqG-56uG09HPUVUz9_uM7b-ETKp-tw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbjopVVQo-9UvIIcVsFiqH__Ex1Tk79dUc-hi0X1SrMA&oe=6AA16FCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq85Ao8C_2MQ7kNvwETEeQ-&_nc_oc=AdqKH6eUkLwe3bmuqBnf_lqq51s70twPh0uYLc-6bku1RyGr07nxkzzWiPUD9Ih8pKY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI10l5mb7BfRpXbU4MoJIJWTY0o6mocsc0z5QMHiYPKIw&oe=6AA160AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19r2I_gcP-8Q7kNvwFuNd7M&_nc_oc=Adr3w1YWnD27GTWV-55OqO5xyXsy21blVXIvVE_K5FecpWElIxRRebuQpTai8Wg5aNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1J9fcrLYcyVKuQj1bllGRCDgRjHA9s4JCsHXffwqOIA&oe=6AA14C45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLLGFtflk_sQ7kNvwHiay2Z&_nc_oc=AdpZHDLJoIW9VzkRY-HblQBeV4MP3JCz9mivRSLeUo24m_4PV8A2XlrgSLdpP7NZvYQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtU_jrJtqeR6V3qnk86HlMeWQK8evCYijdGZvN4r2uNA&oe=6AA17C9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuGTcygBZiEQ7kNvwGcOsjg&_nc_oc=AdpV1PaRzffNZOFyEUE-tRW7HoY-hva1X0UUCny8FSChS0LHmKmvBR9F9I06wRUuFJQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLewz5iQeQJPoR4eFagg9d2IyZVZ6mth1IrENgTOuxSiA&oe=6AA16414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaJrwvPzXZIQ7kNvwHnFKgZ&_nc_oc=AdkWVpobx7s8nKG4MilDVCjAJkME07Rh68ELvgWVohXH4DQwfScGVcKxjbWHdWtvrb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBnpIGcEr8DjBBGMRNvGt_LG3JSAZ-KzwiGialnOVU4w&oe=69B92F8E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lefn6KpfogsQ7kNvwHQs16M&_nc_oc=AdnV2Mz0YoE8HbltbAej1V1WvtiaRL0Ybm6fTzkGIUoJayooLNwoX4IAg2FAM88VFCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvL6KqxW6KwM4LQJ9siC5JSTufx5svXWReiOfLu69y-w&oe=69B958AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ72tVl2Y38Q7kNvwE1oMUO&_nc_oc=AdlPDOTbFF5_5zqg1fa1Q5lRGocOvFlqdRLAhaK4avcoODHXenUKZBMF80CGwS0ddl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT4QwUgkluCJ28jLMGMi1RbUJ7f-iHB1lCAVM2sKPuGQ&oe=69B94445"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZjdXeYvq2UQ7kNvwEwIE_6&_nc_oc=Adk-AKu7rvrCa-t4tRVDUhffZO4qi5o_8WYXDY3mBIdD43RURwzD_-_QhtzF_OjXMnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0qWmW-P1G3wBo-J4HwGNoedmXe4L1USPw4GE7E_RPMQ&oe=69B93C5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YrGLGBp5qMQ7kNvwFxNnby&_nc_oc=AdkP1woLqaIS5eywlGVPGPPcoQJo_gTMrRLQDhidHAtGIB1NPahauKAcwVxZq0HpJOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMUBqs5O34-tbBXQ7ZxHS6iv1gRaJ50hsHYzrGNOlr4g&oe=69B95C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
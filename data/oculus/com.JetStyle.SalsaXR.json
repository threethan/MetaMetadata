luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3GgEC1oNMsQ7kNvwGCpwUB&_nc_oc=AdqtqFuSkAYUN_lMmIItnl8BQXXqvSYVF8fy_cSyA2rR-s_2Jr49e-7fbRVIRk_gzvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KJv_nXybxs0ZJKycDjRP5b0GFwYoNR3Ba_c0wBxEcJw&oe=6A048D4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ub0UAfe908Q7kNvwGYuTzu&_nc_oc=Adr9Jdw1RxWBFl-mu9LZJVHtCO2QA_eVLB7SuYo7GH4j5TTCTDvHQJshC3ObrdpJyPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IzW4HAWIwn9LbQkQ5m0_5JDiN4BbVySw95tGKBVAbgQ&oe=6A047E2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOqRJBe_3CkQ7kNvwECPeK_&_nc_oc=AdoCKyu4iKy8KZD7vsNw3PqIy0WIEcEhlx_5caRV145f96SjutvEtGUJC9Wvr3TeX6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4arK86rkCYUixhQttm7f6NBNuo4_eC7lEjHvv0C9xaMg&oe=6A0469C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBGsOcyZPQoQ7kNvwGLRfFy&_nc_oc=AdoLuQ1T9dbD_6EUaHjOm63j3L5Pv009CRhSdXhx7VxnQcnpRtp0Z9rlnOOAD0Enj74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WHQoQ87_x_BSAIJSesTrURbJbtvKf5jFj342tK7Fk4g&oe=6A049A1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=offSbdnHlvUQ7kNvwGeDm9V&_nc_oc=AdrJEf_JgzFml7wNI0SivfB_X-X7esAm7TD8iin3vCXwUSI3OoKQSrfJQKWc5wDbrZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HuCFL4vQ713k5PVzXX7YQlqJ4A4Q_m4szmX2ifeK8MA&oe=6A048194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
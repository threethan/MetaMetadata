luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3KQZM0hCVIQ7kNvwE0-szu&_nc_oc=AdooS_UDYulrQa8UNxMVhppapxpqI7EfLbZ5TGJKIXymhiUP7gGQpRY3abNwQoH3wOw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN8f2NyDIWlGay2zKV6IbRlEi8QaXCr7YS9JRauIzfyQ&oe=69C7B00E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1IG0F5D9TcQ7kNvwF-TNwH&_nc_oc=Adr2PaixvLYUt8Tcxc44GBTnQKL-3UF__UOPgFj-jX-7MLJDjv_92j6qAxE0UjVNK6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRPrY-z7PW_ST6e3D_8-W13SMnhJzHuFxyWsYdye_ooQ&oe=69C7D92B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-ENbxlNGKcQ7kNvwFDNPI-&_nc_oc=AdoT7EHKLK65D1DLItfpi4FIh5ioXD-UOPdPkoB4ALw3D8xLOb02dhVnyy4hxEf-Cpg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdpi6o136hrrLtPsdoYIdCMEBvAGecpW0yH-TX2NQGxw&oe=69C7C4C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7m1oWmKLxsQ7kNvwGVJdQ1&_nc_oc=AdqKRJMlUexzM_Ky-l3g4tOObGU3FE_h1Guchc-MkUvIKTyY9s4JbiD_zipHKMkvW6Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeE770e8-F9xlrKG6bOapbxwMx3czh1qh3h5zXja0D5A&oe=69C7BCDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHrTArqd5CoQ7kNvwG_Nneq&_nc_oc=Adps-jrxgi3lqI6nCOzexsgezTytN6gdNUqaLxt_XVCGwvhOOvadFj1dDA_fINbzdHg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgWk8Ep8P-rw35s7bJ_HslO2RWZmGXeIZoau7RL4ZLMA&oe=69C7DC94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
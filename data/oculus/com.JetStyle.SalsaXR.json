luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKpe7-vyzosQ7kNvwE80qN-&_nc_oc=AdrWG7Cc4VZyPRzPBtrb3VafkIKk6M2fKiqEH01MWdCTKRv1VJd3EEEkWZDiKLPaR_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6FWmd_VDkmBF5t0Vo8VcU7JUdlDH_7NB2Pki5vhDH4g&oe=6AE0B7CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZgU65Bm4swQ7kNvwF9NVuA&_nc_oc=AdpngWkVVLf_7s0Iw5F7Oik-82jScspiSDq1YYHidWw2tNCdVm8XM3mKBwVGJZoIuWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPft-SZOSeLSbvbOHqkpP7CXGzkKOVypjONIR9edTWPTQ&oe=6AE0A8AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSfvBW0SjIAQ7kNvwEzkwpC&_nc_oc=AdqDb88YG1UXJ3iTXqChj0lTnZ5RS981yu8lwsfurPGQiGku8tJ7G46--hVQhBVe_MY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwu9Zp_gLQ69dj4N7od4Y-2hGrQUtr-0Mkt8uZ-oFvwA&oe=6AE0CC85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IvSV01EC88Q7kNvwGSlPio&_nc_oc=AdrCtBFpnGIQo10M0SAICxROAhsTeaMjIelpbZnSxGMEWVQTz-H4l413XK99UVQzVJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsnQWUiQPUIIus6aggsCwx36NcUlkep58BOn6TmU-4QA&oe=6AE0C49A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WrzAtAyc10Q7kNvwHXYSBL&_nc_oc=AdpPdDZztDx8pZXnvA7rgPcv1G7dR6FG1tTI1ntRuLkJK1i40xbRfd1VQpH6YvugS_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjI0RyiPjWftAePi_o5QAaY2WdSYZ1_hh9XEqHqztTPw&oe=6AE0AC14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
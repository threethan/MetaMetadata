luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iHUO_UB4DYQ7kNvwHtxJIh&_nc_oc=AdpjGuYEQRpbo7YbCpi-WUTqhzPPz2Fq-UFx-wPFZCzsKahB6-Uh1s55hBodKbLglTY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88rfDuYJeZo6HPDnmT6SN2x_G4TNTMA8dOoARu16MqsA&oe=6A34034E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPPb5sYiGA4Q7kNvwFo4E_W&_nc_oc=AdoiDAE4NEqK9VzL4_txJbNfZv0MvOhU5cn2PLZN_4-Agh-KfMpVey28v7eVO1Kyqkk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86EodxyfTprh3FM7dWjoTj8BeaqajGHVyLkEzWmei6mQ&oe=6A33F42B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuZ0B5gMcHUQ7kNvwHZYNBx&_nc_oc=AdpMMzckg7x5ArxGzCLeEL_4osHTeMDiQ3YoD1YTbnDw34UgVEb8SKiwm7h37rkTm7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XMP4NwwuCfmSPTWuUf4QqOJPQD0Ty-n-RrYorT1ao0A&oe=6A341805"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdB9W7mqlZ4Q7kNvwHWMOcC&_nc_oc=AdrDETfJY1YOlIKdcAFGPfkLqlNnUhhgKZJ6b0AB9hzSxtVXGxRM8X08J_DmLH36_7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Evn3l70jWqjyhUgllh77Zmn_BTjU62vzs6zFnrXCiCA&oe=6A34101A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nuALL2eH1IQ7kNvwHo3Vix&_nc_oc=AdpWUMCiBMR69aNWBv2mTUmGEQ88cydI9yuo0iqlqDEFyKcSSYDVryKQymFME7A-HCk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BTXDBsCSus05mED7jFQ9FJ6xX8aNgR9Yi1tftAuF09g&oe=6A33F794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
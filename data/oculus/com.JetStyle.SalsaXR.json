ntent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QG-5oo4qv8Q7kNvwEM41P8&_nc_oc=Ado2SJgHqJgy896lq31seJ3Gevc-baVkqNEK5Ypj32ExC1azL-Kp5_UtvPC3OpSBlzA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd0k_QsCznHunqNkEmfPEFtKo76WCDGDxGqjkZBhmHOQ&oe=6A85880E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2K-cq39MEQ7kNvwGR_ln0&_nc_oc=Adq_ZxL82UAenTZ0AgG4sDBm0tJguhCUPncd9UxK3_qVSiO6VOYXYaFc1S82QyQnIPQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo9YcSY5BOmtYEoLBaIsKKiJDCPRJ0AbCQOluAzCgsXg&oe=6A85B12B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr8-cKTrQvYQ7kNvwFFiiCR&_nc_oc=AdrCBXp1cDS78RGDVZSe1_EVD-dRo4PnHlN0ImeNNJyOLsEP7msokk5uitGuWG06zpw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNQWmQPlpbH19y_USTdsn71fp-1knpIhv4B7mAbREVRw&oe=6A859CC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlh9KS5MIrYQ7kNvwFfGcz9&_nc_oc=Ado_kJneGk9S0Eqsw384tHR-A5fehyDeZg020gNvOsZNqsWbXpHInCFWCNxxJreQ5bo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpeuAOl5_RvwHyp4w3PhPAvlQdsFkTaEAjjDRqueSpgw&oe=6A8594DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JQVSZyzA6wQ7kNvwEyXNwf&_nc_oc=AdoWm1Vv4dSbrF2OetVx-f_Eh7eAvkEdAF-7B5BZVdEbEIaZCKUKO7Qd6af8p3OrtFY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhp_9lT4AZMDNv_XoohK8RHXqHbhe2hnFkwtWofQ-_lw&oe=6A857C54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRE
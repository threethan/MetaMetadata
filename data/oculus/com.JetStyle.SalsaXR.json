luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3GgEC1oNMsQ7kNvwGkT65x&_nc_oc=Adokh15xqpyo4e-XWzoDXIzWyWAO0F3LGMU4SsglY_CAySiff_eDJkP_V2nLquys3Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af436u0ocjqzUqYDG-xHtNvJo3dDsR000y_DWzQ-OavvKw&oe=6A05DECE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiSIDx3kiOMQ7kNvwEUIgDa&_nc_oc=AdrCq0peEnNAwrWFX_iY_U-OhCtsiGD7oSLz4Aq_DCJM3lNSpRzKgFRL7wAOoc0UhWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IJ-SmtguyqeLePPokt7QdvqfnG6AkqD4olLZ5bUNodA&oe=6A05CFAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTP73c9D9QIQ7kNvwFpBe1o&_nc_oc=Adp9kbNscbCNOdcvFsqfq2iShlZs6guR-Kc71zRDOYdfRXMHcNDUPQ0sUhenLcH_npI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af447XliWZrZFyiie2AQtwlWGBFaXta1Dn1I5ENGnDocJw&oe=6A05BB45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBGsOcyZPQoQ7kNvwEgQmTE&_nc_oc=AdoN0W_NQcc2st9T5xkJ48eE9OxPDvoZZmMH4BEU9rArq-Dv81EDg3gdkx3Gr7FueMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Ol_SDbdMeK0f5iAfOGZzYpi2EIyakyV8NlyUbZ458w&oe=6A05EB9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05IZCyR8RtgQ7kNvwF7Q3_t&_nc_oc=AdoMOl_-wvQo5tx9WB6inBX5Vfl91SVAi9vQuv15JuPEskQKy8otgdoArc0xQBZ_QBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5civHgvbIMTuv16sZ4A1pwfZQTOiHRN-6M7fQPrgD-fQ&oe=6A05D314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
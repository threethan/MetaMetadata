luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jd1_I1Zb38Q7kNvwEhNJDD&_nc_oc=AdrN_lqY3EkQz8SlmdXqMScePczD0jY88u-aZiIIdgk8M7jfYAYEudDw5gZDPodcBOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUXwGCbLHLs_OMEYFqt0tl2deiN-Zz-_3Od9zgUzsBiQ&oe=6ACF944E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeTFPn5NGlEQ7kNvwEuT1v6&_nc_oc=AdqgBHAFOvefuwgId2we9CQ5Mg9G6-n86dWt9czDQ9qICkqGjoWpwEOaYbiOywNWW4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl6mDlb4fUWOoJnDdwUuoPoMwlPPO-EQKc-oMOYdOVBQ&oe=6ACF852B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRgQVPtckFIQ7kNvwHs4WjP&_nc_oc=Adovt1JDoUUzoaK2PAAERBz71iO7JRoqaYd-vdy1FWYDGVU3x8O49VkhGkdYxTLXzQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjVFrdIJPqEXxHx8KcNDeYXiOrRQ1JatsMrGpWBLTLIg&oe=6ACFA905"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NLuoQtn6m4Q7kNvwG222IY&_nc_oc=Adp0VHj8eDPvHf3FPjQtyKbxN6OXTY7pV76ij8FHEWqwO5mpfZ6k9_zGlI5UoRyJDy4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7odPYdaD6KpP-adV6WPfMhev1XkzH7mLB63KlrtupxA&oe=6ACFA11A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnQUj_hG03EQ7kNvwGWOiY0&_nc_oc=AdqOsV2Gigu0MLzQTXJU_4tAF0y1-UdFXpIk7d_AhjN3bL4j6UWHrKeY4krWrUR_Flw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLjQ8riAmpRj45KKBPbdEl5m7ehEO0CVLLAV5f-8vP_Q&oe=6ACF8894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67uqH8_1ACcQ7kNvwEJpAYE&_nc_oc=AdppToKq04mBzNeLhAJkKlzYOurtvahxE-eFSyNP2YtSol4_Irz4QoTbaoSKOYf9OAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXo-TRlpX2wAp6L0o1NIWaa80nWRHuRqdXkBkKSUql3g&oe=6A4D0FCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MO7VZPnvaYQ7kNvwFCnhQF&_nc_oc=AdrXrpifNjhD0YyToMCQBERbuyEOhe4zYzd5kvlNUJQV5oPr74DfmU8TOh6UIKvUJGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY047RgkkaVGoWDKsHisDn41tMqQuFH-KY9_ex50Izqw&oe=6A4D00AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkTZIQpZpxEQ7kNvwGxngEc&_nc_oc=AdoDB79TGopL34zp1yhU59R7LAdrMq9UIUPkf4KhKc0Vv4omhWC05xxsF7cMtvrTLpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFYPdZ6K1Tyo3Y5323heJ5Sebs5R8Aux_PUfAQWe9oyw&oe=6A4CEC45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ktcp5fHW_YQ7kNvwFEsVzt&_nc_oc=AdoS3cj9HKuJK_UlOpvR6sg29qZYDLKjQ6spP_nhgQX-b3Q45btVT28NnY5p6jlVW-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmjbqN0fryIgq5hgTyhokODTTudbJ0OpwVaujzcmLCXw&oe=6A4D1C9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr3FJ5_oi6YQ7kNvwG5w1Wi&_nc_oc=Adrcb62lhWnZzM8TIYbXlgUVBdO0I9h0Z0seaFxjtym26F9M4DGqjF491Ju-5cu_kjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn6HCq0CDMLswyvKCLxVXvOF8Nv7KGl6JVEiDlRa8ESQ&oe=6A4D0414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od48vWOpfUIQ7kNvwFhWtPz&_nc_oc=AdrJeh5R0B6akf1IY0_nBymbm8o3IYSejT82C9CRPdyhf54o5T5lKRRs89NLjSzH9hs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XWjYZRmRnNX4_jBvXNR42ry6GCF6H9Vq6x_PYsiuEGw&oe=6A0C764E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBLnHrqEtggQ7kNvwHq2P9y&_nc_oc=Adp525h7HRF8tItt4O_gblLX49-bd9LPEM7FUAa8mE2vnxwa-8WraVsRjfgYT_yHIJU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MX_6uY0vGzUv45YuP9O0T4fFR6O20EDGmgc1KQXYeSA&oe=6A0C672B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM9ilvLZBaoQ7kNvwGsxmAP&_nc_oc=Adr2hAQ716KSLYPFpVj5rcMvJOeNNqUTnoM1adOv3aQI-rZ8VM6QiUWl2yQ-ou9H6E0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A_-OSJj9qwXog_HGqlQZPsAZRsXLMQEcyeh3BF6cjLA&oe=6A0C8B05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI9HVYc_0ocQ7kNvwFIqFR5&_nc_oc=AdqK2w84tnhj0cDZDbrQUqOZh2FIXjFz35KHOmOQWNlK0OxuXHUOJmV1jJT_V6F6Mq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iW8wcIhaomhOUxpw4C4OjxjcagWNu4cQBQvfPxMEjIQ&oe=6A0C831A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chvBr5mxlsMQ7kNvwEvy1Sp&_nc_oc=Adq-NOmW7mlUturL5Za5d5gXxwOBsiY6mUD21pEZf1IGER7nYyEnuIBOnPPP_2_oODM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Kr2zaOlMyKIxl9vLVjYdylPFAoMqjZzOgGcZvaas4w&oe=6A0C6A94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSbSCIP-MX0Q7kNvwEcqMcO&_nc_oc=Adr8G5qz1WfeSv-sj06rUzJCWr5Ll58ztgz2MjU9PS1tZgK7Wy1SqnizAN1OBnFc2gk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2skCRTN2srhHTEFx4P2fJ4btxM1CzHGNxEwvyby5vvfw&oe=69F369CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcnhojX2Oy4Q7kNvwF5ti2I&_nc_oc=AdoL35gyLlinPoAedgI5_VDFSTbFKHfyXG7esob7h1ghdTPn1N2rsEVdfaipezWbi74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0O7Q04OkmmprBXYgy5rhNkRNQbL5k0h3sMYpE9203qWg&oe=69F35AAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K00XPoQcvwQ7kNvwFX-gQp&_nc_oc=AdozzHzmi6crkTEl0s6Z02CTsFlfGhmw52HijZlM6i5ywFdmFEKj0zM1pwX1_ewugjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jRwDla9lug452GRjtae7I5bStiVUNPHPHRz3RYYJ3Ow&oe=69F34645"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2uK-xnLO98Q7kNvwE3hfml&_nc_oc=AdqABeld56bB-AIz-q-Riec4esm7COOi392yorkbaJEafyYesD4NrUD3KkrYt-J3bY8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ExdVW3q3fbsDZLGR166-Ydp9UwRosQiXJ-yjYrfonCQ&oe=69F3769A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g6MmO1KMKoQ7kNvwFbHeeo&_nc_oc=AdogNpMoSwhC_iQ79ALA3nSEwupXDADy-wwm-s70oYLbPTkEFhBPH8xSK7HX1I48OVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q51JCPH3JIWg_ebxIF4IBh3r-VKShkmTzs7cfCe29Yw&oe=69F35E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
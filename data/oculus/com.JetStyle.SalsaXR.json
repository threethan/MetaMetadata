luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHkRJqTKYC4Q7kNvwF08vd-&_nc_oc=AdpPixqu6VSZy6zQIgUWMBXhJsKTuAdfSl_mnSwSdhbex5lE6_wIZXGtSnqpXqjQgjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXkEneC0Smu4EsWnr2FT9ce7KjIsclWFMFBDdExTHU6w&oe=6AA5644E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAnV1H8fYbsQ7kNvwHRO37G&_nc_oc=AdqEpTabTqLt5bVUAxZ6Pj2ooCbJZI8JsxGqmo4lMUpawDqDqPjo5MoQtrITHaQHAcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIplGXeYS7VGz3HUOyF5YMFIFf-EID-yTnTZgqsX8zVpA&oe=6AA5552B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSh_WN4GcRYQ7kNvwEFu4iA&_nc_oc=Adq84yqjMvw9PbnyozM_iPHNbyYChvknnvU7S34Ogg5czXbkyh4bSCXM1LAwvZx1K4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrJZdnDGm1e6w27o0er8g8c4GexByoxVM2FowjVlRRaA&oe=6AA540C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-glpluKMuIMQ7kNvwEo860o&_nc_oc=AdqfP_ogQ0WU4MjPuDlfh8bImEvJwft14IrJxielqYP9vznhCDuDmFqB7u3q1wpfX6g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxxtWCPP8Fnr1h7adaNGnmx7w4OtDVj4HuhHhW8H9fqg&oe=6AA5711A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfYXv_zpAXIQ7kNvwG6HE9-&_nc_oc=AdpBp0sGHUc8LQHZGWMEWPpWEkKPSp1eRB8xHjIEkpXiHT_VNBAYgvhIlTQg8VTCnnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRd0PM-VtnXRLu7wbXUi8IkJKktPvpCDihyQNV6_z5cw&oe=6AA55894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
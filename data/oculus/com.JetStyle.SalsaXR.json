luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqVYEylywicQ7kNvwFOOumP&_nc_oc=AdpTp-hz-WsrKX5D4Rm-MrMl2wNwI7zPNijIoc2SJSqrUt-bHrjhD0KYbTTUJ8YYaWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IYa4dGInHJlIb6mHuiu5RZ6R6KdIF8huB_lF6zeervA&oe=69D5174E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswoNLR2tnUQ7kNvwFHqUR2&_nc_oc=AdrNcTCnKdKG_exNQEDeMUljlF7Hrd8uXE8eBQWKOLYXF1zkiZTOHKEPnOvXiH4L-04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oeqfliBywQj1WfxeEUm0XnZQ0wmiBcI4Tjn7IP4CgQg&oe=69D5082B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67g5QhM-wgQ7kNvwEN4mVi&_nc_oc=Adou7Loulpz1QP2j38yprG55qTN_IN41XYwnW2ctrZNB9PXDhn-fLinchsOVd1CHQK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g64TKvht9nEYNLj_pBp3CtsYHTjLdvO4EgCAHt-IPrA&oe=69D4F3C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDF8CQUpTiAQ7kNvwHHuAmP&_nc_oc=Adq5H6aDgzPJhQ6Fsvh0H7MM76sO_t_KeSWBkfXQIKy-4SA0iLb-i9WE1PaQ2XbwhDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af077h9unK4jX_VNZVs1fiqi15LtlfwNrj9UZNBc7kcGvA&oe=69D4EBDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49C-q7mwLFMQ7kNvwHdb0HG&_nc_oc=AdpHO5T0rUbYB1pdE9RoTJ68nKMLFKxB2Rt3b4dFOVSyyOb0lYSpHlR3HRWTXhi3eTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05Zhm_GLleHzJDjyYI8nzv6uwZkgYlYpNNwdcEYICdIA&oe=69D50B94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
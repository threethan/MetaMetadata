34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmPZm_n4zHkQ7kNvwHdlNb6&_nc_oc=AdnYM04bgYY2FJWM_VLs7oULuD1wZxP3WiWOvRWJS5Sp7w6h_kaLLMkNdhy2M167lcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6EZZjRwIMawiMfWQ122_dS4nIZr4nhwpZg-VDjKBGGw&oe=69B6C4CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz2SV11NmpkQ7kNvwGvz57E&_nc_oc=AdkJYMc_EVDbzEJVJwRT_FXw2RTB9FRTp51HzhrdlBuJAdJ0NAzhv8nDT-PC2mJsSaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4C3-zChXLtNbImTUO8mzzjeowYPaaxvMhyaAZxGlfig&oe=69B6B5AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ72tVl2Y38Q7kNvwEm_udM&_nc_oc=AdnDXcPCA5dZ_D58M22NapvnMXAk_0-uXe_l_zXDP9IvEkzsnF1avo9YTh0-3I8CX4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtAFFqqwgyuRyPf04rKn6Z0n6ZSnH4Jrk7pZ10yMX0hA&oe=69B6A145"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTcXIBfjN_cQ7kNvwHWz43K&_nc_oc=AdmxmH8VAgS__qUsfEOjLVOWcGFF83h46n5p_YHxrLqPAHxZFi-OODOfe4RygF89UcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfygozgJ6tbJAP7EbUS7yNXLizjxllef5uJlThDqFPrm7Q&oe=69B6995A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YrGLGBp5qMQ7kNvwHSTmP2&_nc_oc=AdkXoXa5GEBMH5GD3j_XojVNyoV0XZ2tFmMsMybSowKwm-mIXGFVNGKpqB33CE17KrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8_gbZir7pk-HsSUBWao4DGTFJIGFuVfGtkLNx5_xuwQ&oe=69B6B914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzEoBMo3nsQ7kNvwE77sDT&_nc_oc=Ado3QCJ3iTiaOYPgc8Guo_sY1Oxg4UMC_tNIflsKZi8q6eV6rVpzt--1jzKkNq8-DkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uhf2FZuknmZx807dLTGqBynRfZB6z6pvq5x58DgKdXQ&oe=6A145F4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-_PFwIkdH0Q7kNvwE4LdvH&_nc_oc=AdqocK5Z3Y4BI4I1oYlI0jZ647IO19nrPCPWbSuQ128qoaMut8r3r0n3mWNybP6SlAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5juxN4qyhkIhPdcPX3_7CGKb3-NjT9dZooMLZRyRNx6w&oe=6A14502B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0AAemSSvr4Q7kNvwGpv9pZ&_nc_oc=Adonu_41umYDGKOraJKK7M7fsXEqvBXUTbdsOsJ5M3b-aoGSaFor051lghE39OgGqqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wmGRiiPo4utIoHS6zKnO6WK3oHOcG_6jHZ_MBGdfn2Q&oe=6A147405"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSQcsQ0JG-4Q7kNvwGRI06V&_nc_oc=AdpS730qlwYvUtEZeKPxytNmIJgfveANIcJ4D5QbdNaxUPm4RXo11Ew--9LDLz4NERE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ySCCxHgljQNIsdmLiKk7Gd7TZJJJ7LNTqeYGo62bVjg&oe=6A146C1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWUsz-R6094Q7kNvwEf-Gnv&_nc_oc=AdqHpd_eRxqdN9u8kmxA8BaGsQdSrnPYWvkoPnXbuYUh4LUtRhEoz6q4CFdUsWRUK2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YSR3S4LMiQ90hiMZSJl18oPTkocFKbeBG-E6WMsR9dg&oe=6A145394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
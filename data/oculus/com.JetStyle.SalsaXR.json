n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkhEu4VIZWEQ7kNvwF5cgqW&_nc_oc=Adr3EgP5H49hy4722DMi5y_6FbOe-r04Eq3di5y1ONFdyHSVEciIAALBxPte2DdCBzI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UOlMbAxiQH6gYPgrXQVu8hc_L1zr0GXhRUX_Epijv9w&oe=6A46784E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-EOTjyOKQoQ7kNvwFlCitq&_nc_oc=AdqxLKlvILH_NPeHs3WLx8hmxZmuhkdy-0QF0mX7CAIhW8WhwMS-yu_BxYD4YXEUoC4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r0iCIGxy4Q_tL3DsMpBBn-0vldlcahe0KF70kaLJoDg&oe=6A46692B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uE7QGvju7wQ7kNvwFYj6Vi&_nc_oc=AdrU-UTlgfLQaMz6C-V8obGGQl2cs2a6kBCF-ZdO-fbvAbX9mPAW2mPUzyCng0BHukI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wfqa6_4dnuVf2YEmFWuJPGunPx9ykSmgTPXd4Rw3pQA&oe=6A468D05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdU8moVrPNcQ7kNvwEhgab8&_nc_oc=Adp__NjMPqd7PX514igQ7hlm--VtO9KQ6rPC1iDlgfo5xtPq3_Jz29T2-1QXhZgrV9w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qsYcZaivpL5aEDMtMM4ivMmGTp_g2qjXWTb3iLBHgAQ&oe=6A46851A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwM0LdUYsqAQ7kNvwGR08jH&_nc_oc=Adppi5DWsoMdKnPN_KJKRE9lQtZZNf4xKVJiVwkWuzWfLz_7F2ZUeJXVGUqX3fonWiE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CrL_AVRDVGQTDS0YkMA7trKNSSd__EdvQGPJwq9At8A&oe=6A466C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
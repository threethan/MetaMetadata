luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm2WBpiL8bIQ7kNvwHMoG9O&_nc_oc=AdqwOdJ6xgi3ELCdD7sKm57zPbU1j9eiKm7yqcIxiaZi2qka6MXc6mFyQeMQ3UuDJm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t0IBnRj8oGksXkqgk_OMVFpdAia8Cz1rBsver4BT1mQ&oe=6A07304E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiSIDx3kiOMQ7kNvwH1ST9g&_nc_oc=AdpagLuM0-u6cM_ehc52eK80FidKZEdvTp2ep2Na0JBCkMGRkq6HdrH-TrMHQ5qNRIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HOKU31R8-wSmQcismyd37Gxkr8k14hu8o8o4q6mA1Bw&oe=6A07212B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTP73c9D9QIQ7kNvwE-55Rt&_nc_oc=AdpL-CRPha8DfIh9SWj0UnJcknsYmvdHXB7ZNjTNCgUdJE9JSSe81fnPAdM8Gc9M2Vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zNgNGLSfUihhWNhIwh3r5O3975EM1WeCNu-GHnwQv4Q&oe=6A070CC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hx0I0hG01AQ7kNvwFD_TqN&_nc_oc=AdonIBARtfMvUUIZqQWMAAMPxxYENy71zJu4sj35gWGZ7IHsFX-_5tH9ECxJIBRF6IQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vuG1uZ7OZAohXC9Ik70FxzW4XX6by2N0s1PYJWh_qKw&oe=6A073D1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05IZCyR8RtgQ7kNvwGQm5J5&_nc_oc=AdoGtVzFuUt4JeKkXs_npo-jAuH8OzRmEUIGl0iN1etG4EFJRlQEHlIjiGNuh0efa0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lAd-a8VGuYZ-8ARSof5a1845FSOi0qWJR8j7au68b3g&oe=6A072494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
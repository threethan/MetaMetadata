luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2KZoLLBj40Q7kNvwECv0xy&_nc_oc=Adr6tX9J0Yu1AOWz6-Zfh6z_f5EQskZEkgNFpHrqGyL2rKCNYpKPjwVqF3FPSqZedDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO7zgBioDz3uxfdC1CzZ_wCS74fLNNN89iRpVRToBZ2g&oe=6AB5364E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3-IUiNM_gEQ7kNvwEsrmEG&_nc_oc=AdoSHjT363ad4YIvnrns2J2WP3RecqrNtKx8wnCxrgLBU-WHP8qbxYrD-DuoV0r4gpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJUZG8z7Y_Fm3PgMGQcpaeuFAmIl9W8v7-cTRbIjpZoA&oe=6AB5272B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLGnOfeNPuMQ7kNvwGPM38w&_nc_oc=AdpMhOwD8Qt55Waiqs9aEbnnhW8ixqOjazXuAuFGsJNlCL4bBXNmPh8gp-_QDKJpBig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF08DRVNNzuImafTzPAn9xTmlt9qpEzqz_jexJNiKkQg&oe=6AB54B05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBUy8878hqAQ7kNvwFTTu9-&_nc_oc=AdrxeD47T9xfQv7mqjUXalUtVmv0rEQ6NrDNyLetLNXUZg4zTJLp5FRAP8jsX4C_oaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEf675PnEup23NgciMcQWFLLAXm8_gy2fVxfTVeZ_N2w&oe=6AB5431A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhZ3-8cgPcQ7kNvwEF68um&_nc_oc=AdpWi_lz2JllNN7qymgASd5ebtRPiEyTGcfIstIKUqF0dk6ETi_uCwGfMrlvQIq3q6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISB4B5cSxIZNTElpPB34M143EXKANlMi7A-NfPYfbhyQ&oe=6AB52A94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
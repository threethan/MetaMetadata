luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SGLzHKuKV8Q7kNvwERYXr-&_nc_oc=Adq-wmqymbdmJheaILquGYzEt6c8bl7henjhab9My2gzD5kd1qC0ZZLd-CNMS5IcE0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc11BwQY9Dn7dbu-VU1DAkfS3QeHXolFYskGg-QS1CmA&oe=6ABBCDCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p5Pdb8wRZUQ7kNvwHn4K_Q&_nc_oc=AdoXxSQoqIYEdCdwAdWJ6BbRC9_EjEtydkCf22ylF0wZFf0a1VWLmpfY6l2if_HdHX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX9d0y9Xk4HMjyBmr5CsgBC24Y1s1OatTMyy5dqtBOGQ&oe=6ABBBEAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SXq872yTrwQ7kNvwFcOE05&_nc_oc=AdougA94iNP4GNvzWcUIAUOlmSpK7J9LBUXlWlybdT3LwfBu4IBBTMGCmNSN83HhWcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuewltiQQHR7PTfRIL7NqKNza42gOzgQ1BHKyL--WSSA&oe=6ABBE285"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78l9v1UbBykQ7kNvwFHvoOT&_nc_oc=AdoOI7EYycv8Ha3TRLMQRIpSytIj2rNFIwcZCk4LQq_DYFYQ2zMWxTh9eY5hy31Kgfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcmS-YDSomF58LxP27KFQE_1-UupfFuZAIcSg812eo8w&oe=6ABBDA9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLBk-PYp1bsQ7kNvwFJd0et&_nc_oc=AdpHhuu3lbvUot1dbXwuon4SHAjxrtrDR7HfE7s66EWKlcuX9PZCU-A3jykM3GLYLSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyekhbcQAsUAYq22nM0NLBprE5-qCZutUBgAh3CEosWg&oe=6ABBC214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
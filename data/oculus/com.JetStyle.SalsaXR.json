luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3GgEC1oNMsQ7kNvwH8tKx3&_nc_oc=AdpJLkThuOuchmJOHKkqsknLPNAjabEHF3lp3VvjF_CDhiNAA8xMXOFzUyr24rX1h9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eiKso8eIKKTvvwq_C47fhb2SC37SQn129EsG68P5hTA&oe=6A033BCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ub0UAfe908Q7kNvwEgsgNb&_nc_oc=AdpJxlnXQ9iFy8CpIsCxa2tj9plyFpL_Ra8rXDcXcTMFjhPxWC4HPa6NOu5OGrAzZXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VpeTfewZ3RxSGvDNy9B1-JT_icY2hVwoAdGkSE2S7Ew&oe=6A032CAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOqRJBe_3CkQ7kNvwH0oO1R&_nc_oc=AdrQziks3TgOKi3_NqrzarmLa4G6lgykYWHWc2zLwcHLycsFlAD4ul4G_0D1FxUNTYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BlYaPJ5KnMGbb1s7BGkx005W6wlAQMgLZhVILiWzUMA&oe=6A031845"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBGsOcyZPQoQ7kNvwGuP5vX&_nc_oc=AdqcCgxXISnRdGaNdbaxga3ErU7XE_ZKWqcwLyWNZ2z71xtNI9pT2PclJ8H7iT1HAac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O_u0MlbdTGHnJu0OIikbE7KX7TneGaiRIcU4xLGC8Kg&oe=6A03489A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=offSbdnHlvUQ7kNvwHtmrKd&_nc_oc=Adp1q_zXtkpk64pR9BSoENS4ZE1dM_bEcDlO3N3_E-sZWOvGsTkAI_qjD_45opqzFxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r62IJWv2_xZFHLjQbNwYsOrD9iE_3G47tYRp3eWt9Ow&oe=6A033014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caTG2UKkORcQ7kNvwGlWvJF&_nc_oc=Adoa9GlVhRZVtGsbP-DzA1IxCcGnO6hUWRsJmyirnPmfcUvP_TVAnXVpKFjEntq6kTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyfln2IK_1qiW-K6YRM7hO14mx9rEQVzTYqPjBQh3aRCg&oe=69D122CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymgwPxz6tA8Q7kNvwEZfT-X&_nc_oc=AdqgB0ZNyUayiBAGldtyqb5fUHCyjEE8WClecXeJoZJ86fl1Gu177gZZ9-bsA3VcX6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJwKWxEATFIL-wGb8nm_2Ll6XzSeWFdskTKJksr59Haw&oe=69D113AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngWO7QO42vAQ7kNvwGGXAGT&_nc_oc=Adpn95WXta3MZC3fPex96p1WOWb-SkXaUTlnLuZ-ZegtvP3RkwlHqH0rhliTm-iNldA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-xHyUsd4rX9AzviSmiKWIbn3YSFKmcJWbPU6BKOmvnw&oe=69D0FF45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_xsE54tDMYQ7kNvwFy_zEY&_nc_oc=AdrsdahYNl04Jp1mPj5aAGP2GjLlTvHp1_kPO88Oqq_9mmcYFk67AZdgCp5B28H_cKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt7m05NeQQoNamzYr7Vu3J3IkTx4ukOLM5HzOAz0TMbw&oe=69D0F75A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P0Vgz50PzIQ7kNvwHRbkhS&_nc_oc=AdqoquWuQZ_kDpILzawWmE8HzaeO_A1AZeqMRQR2DqS3pze27E9sOWC63GGwuJwp0cQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZCMV5-o3WIAWazEayXekH5zrz7X3yixuvPq6AjhhL3Q&oe=69D11714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
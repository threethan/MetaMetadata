luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAHup2j5M8UQ7kNvwHLl3KO&_nc_oc=AdoM2ulLl_EbBS9V-gnqXThmn1DZUPASYKu-GzzHvg5myp0r3fL4FnSr-lgbf6_epOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S-TJMuvCpLQUr3hsiNpWRUuRN8sTDHYkm4KS96Cb4pA&oe=6A43D54E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWKFOBt1UAQ7kNvwF_-huK&_nc_oc=AdqeoKDDKmDPzmrINyJAczVWefFmXHyZCJYm0njM4ktFX9ktleKrHpyR-vIQCrGfq4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A0tateMRNLkHylnbPha5jdwwC0THQZFNtZ_yVV4xLDw&oe=6A43C62B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0gBOGXUgOUQ7kNvwHKuorN&_nc_oc=AdrLSqbTda0qY2wJNkHMKyo0X6JxmsuEYvYTnwt3fDGxUYvCppXm1jjkowO6HXB-8YE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F1sl7pPw87GgzF2ngMy7e3ZFBegck1nTpWznThkTR7w&oe=6A43EA05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORhGPGWxwg0Q7kNvwG9z24T&_nc_oc=AdrBepfsw9CmdbQmbwHugp_zeXXSqG3A9c4XwrNe7Zjw0S7Fskpo11KHlqq64PRxM3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UvvgWuvTpJZ4rAGy1pWeSIOrbB19E8JfYihG7qRAcoQ&oe=6A43E21A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ3J_bmqdxwQ7kNvwG9BOcB&_nc_oc=AdoyXsrUO8HXbJmPupBOjfW-gX-PpLtX3nCOQ5uxjx1LU6BgdlwS0zsnmjhUOiu65Ps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8caePteMFj8K4bWsQiRIg4xYZWz-xj_UiX2BAv76k_6g&oe=6A43C994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
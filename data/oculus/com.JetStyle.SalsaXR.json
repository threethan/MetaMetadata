34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaJrwvPzXZIQ7kNvwE44gBK&_nc_oc=AdmO0gncnG2mHwUsD8S5WVdCJTrgPMxrwPT9EehpMjMe3Y2Qj7B-A1RX1kWYorwqCcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZfOr87bvV_q34riW8QlkmpR6u_H-Mik_yA9Qf70x9yw&oe=69BAB94E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lefn6KpfogsQ7kNvwFot1_-&_nc_oc=AdmnCWZT2KE79h-44kewcVDPvAZ75_Sabv2wraIO9cKOQFVnbYXGcY-zbyBEOMJ2jHs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlRloqaOx2LNYzqezL5ofc1O__8b7I0qlpa53XG57w5g&oe=69BAAA2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr9PUp-wRC8Q7kNvwHhyvTE&_nc_oc=AdlA5QPWKwt9myprcv40-UlZDUB1PpW7RkRIpl_OhMFFXo2Lz2lQua3ZM4-c6whodyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHqZQmv4x2t36gTwbwOIjxv-8v0onXL1YQjEungI3BAw&oe=69BA95C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZjdXeYvq2UQ7kNvwG808mh&_nc_oc=AdkLk5wsTOxLB2gNzhk_7GehPuEK83shoPsj90opU2OYalzvO0uXWB_R7rG1U6-_EkA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx71UYlth366rBkxvUVsXAYh1WHEWcy76ChpiGVo7B3JA&oe=69BA8DDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8cQOw3RltMQ7kNvwHjxYIs&_nc_oc=AdlgA79NwJPid8xLiQNFkGy_JKkA0EUS2PSDXE33LVLUeX-JZ08UbgylYx8dYUTr_zY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkVNlcIqrNb2TrOUsTzhqptPiU1kMBUEx8jfccabIfcQ&oe=69BAAD94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
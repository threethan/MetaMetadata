luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IkWHoKJgf4Q7kNvwEF-mwA&_nc_oc=AdoPjswzjXaYkydXPhXAtqKM1SI8RmPqzaNuZo8Ne9cCm7iTsIJldPt4_h-o8HeXSso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nG9KrV9keoCEWtOr5ePukdX3CbhXSGYTK9EFFfGVUXw&oe=69EB80CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axhA9mvlfuwQ7kNvwEA5Ssk&_nc_oc=AdpSDLVwV5dZGLITHWVuJinbocQuP3PyxcN_D-MVaXn5Fqcmh2sWkz2_OF3W-mVZhG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38DAS9q-C0cshqrQrfzFoyTSH7-d0MKytDX9gW2kKrkQ&oe=69EB71AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIV80Pb0_e4Q7kNvwHZgATU&_nc_oc=AdrCwUsOE10LrSEh4vmp9hf8nTSnTtfaQ9e5hRpwLXPygbe-VA-XnUplOux9F_JNuqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34MAG2MuxWFrzmBO6BhXMxHhrmoCgPrR9sJXW-x7icEA&oe=69EB5D45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yARDreLNCYEQ7kNvwEF-vyl&_nc_oc=AdrIXUbl3npWlRvmAIY-KwKxrKzNcZN0Dps6RkhQTyEDEyk5aneDcRYULXsTNkQGoB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fIoBE_daD2CmOsWONwrvUBIWlUegDB0dz54fFDd02XQ&oe=69EB555A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4MSQLWXoEMQ7kNvwFMpV0q&_nc_oc=AdoJRfp9jIduaJR2d_GuApgYN88inCKldMD1CHsqY4MORt8mvT5oo82kjsb007_pDKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O4Mf3L2DFOL8OpJARgUJppMK4JX2XqU8KhbKB517W9A&oe=69EB7514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGETXQ-8QJIQ7kNvwHAiYvH&_nc_oc=AdpCi3KdLtZrj4bOoDFD2xVD0HfZT4Q5wRBD78821uwwdtGNUgpOmBJw-0a9zWIUt4k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1w82U8xpu5OMnM7rMrICcNEYvLdt9lvldiOsQkw1gFw&oe=6A39494E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSSu-ejEMeAQ7kNvwEQc_Rn&_nc_oc=Adpxu1U3tP4RbZI_w1KTbka0CUsGB0C32v_AFishqZXsgdxJGfSfd5hZxJ1q8japVAw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3TzTrscy7xNQB8LMTCbRdoNDOxBdbaNU3LM7tfIzT1g&oe=6A393A2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08bV1ozkCCYQ7kNvwELCKJb&_nc_oc=AdrhQJDAVmHJ9mRX-5pXiSiJDOkQIs_xSmwv1Rjh-Yoe5xIIJ0rkIAUlUT4IJYtSrcM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BO_Foq3OrQgASiHiuNyenMlFi0CAkh2ecfpU-W0_n9Q&oe=6A395E05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze3aPdHQQaMQ7kNvwGoGGNb&_nc_oc=AdpbuzZ9RJJKKE27aRjKp9tiNiT1vSWzQzVAOiG8Glh8vwAHGgnjPg7rwORcxp7pdM8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tg6KXC2Oe83Ffb20W53Hdveg4VgOqkugo-qDIOnlWtg&oe=6A39561A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxR7Sn5pzawQ7kNvwEd-lqO&_nc_oc=AdqUQ7Tr_ZWV576ELG7nysV10cWE6p_NKwoukPzK2UqjT2DcGPcFZ4CnbxIwOJLDCgY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4yZSju27dW8iCLxG_u8NsGykrydwRc6SYTDdt_YvNMA&oe=6A393D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl-4Oinp6cEQ7kNvwEKpHbC&_nc_oc=AdpTWpFC39QqOuy0Q4vNllxecad33_Gc8lQ7D1F4V-NC_PJRUdPcD1drkxh-nooUYsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUuG9HS7SW_e8ZTIvlQAWvKF0IcVvGKQC5Xn_62gKiaw&oe=6A60D64E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmSdOmZ1uA8Q7kNvwFRzIRv&_nc_oc=Adq5yqMBocXq-007MR9TqsFWtLWlk6rK4DOk4y2qT2R4asGc57-ROTYx3Am3KRzgCUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQxsy9DYSzsCSF7muA9G_LUa3NQq_y2zIyvOceInx72w&oe=6A60C72B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xb9IgvH4zsQ7kNvwEO6Ptd&_nc_oc=AdrO1m9zC0o7vP2x7XiFIpd_lrRUxOU9QSUKGudWz_Dsjw4nwkGI7qkb3sVfYaHWyDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVnbTynz5nHooq-aGC_mLfy0Y7s2rjqOJ-IgUruBclyA&oe=6A60B2C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq_bmX3DEBMQ7kNvwEtruBP&_nc_oc=AdqO66vz96YNr6xAVFk9HTBCtUFzTrZIP7oDHfsfC-spQwp9909d9MtcQWWc4Nq3sjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjqXw4LpajfUb94umxiCH5zeS-doKWhYNKVXry7je_UA&oe=6A60AADA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LP1ebKAiZkQ7kNvwGCnN8X&_nc_oc=AdpMEcbl1S9bgfFb4FR2mhDiSyG3YIG-SzBOoDiSBy6oqYyrBN6ftlEOuQU_apRVaEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOHCayg13R5RXUGd0e4uLi_XAHIvdtS0ufwbO0zz9S3Q&oe=6A60CA94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
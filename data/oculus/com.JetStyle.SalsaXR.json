luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt9Yl6DL3qMQ7kNvwHxJkBG&_nc_oc=Adp9aompgcz3cDhPeUE8Gsr3dE9XgesEGKClUoxlpd2hhUhzeTQ5-qhx8VfZxvIiIXo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15dS2IQsErHmQGw0zXVnr04pE4v56JfyoeNyFF2vWedw&oe=69E63ACE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Vj3VEeWHAQ7kNvwGjPLkl&_nc_oc=AdqUkR5Slmi5_AhPVMZDoOlzzDCXbAFAoSBn7CwZj9vfVWV1XynBCuvJOc0CnbooNrM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14PPB9fYtcZRER7vR27s42hgVndiodCK5UgdD0Xt7ztA&oe=69E62BAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAdvMZnVjT4Q7kNvwFVGVxw&_nc_oc=AdoJ-VbXYTU3QzX6bWt5xrwf_OS8-h-6t8UqJoes3hzUNOE6Modh3zVhseoTCTU91GI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FeRRNjChXvVIHyqBF95D-5jkyvjvGmYOAsrCpgTsVRw&oe=69E61745"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvil2yyEnTAQ7kNvwEum5_j&_nc_oc=AdoCo8oF1olgK9lArYbrjL_NaL0hctM3qJ0cwWbAe2RP4T_rYAfzzCKvmbWgU9hjO2s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zV6111zZ1Glx9pA7ZxjDUtZ9ayb7KNNQtuehsrOgcRg&oe=69E60F5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKqsrYir960Q7kNvwG2rndU&_nc_oc=AdroIH7wYGXMsNwlK7tUm4gs4w-UPjvaIoMk7RRyktuWpXsZ-gjF7oz2whwWrROL9KA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hayfn-xo3K5Lps4JUzWS_fzCYPXfUnjTYLjxUkEmulQ&oe=69E62F14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
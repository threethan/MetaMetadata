luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw1_eebatIQQ7kNvwF2MIU-&_nc_oc=AdqdIjZZd0MRPUeYHW_g_DI-93A0YsWIjclC-_oA2Ii5XFQFe2m8WmSoLwReB08CKu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHorBsdHKmeghu8ctqUFVxa4Q4hzJ9A9o3mTxhpEjYf1A&oe=6A82E50E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR87Ksko81YQ7kNvwFoGsQU&_nc_oc=AdoAjcASSn9NGsX1VxTqhYTUI4mTqTh6QRSmq4z7sqC1nIyL0n4JSNPsB9v4TXGN8CU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG59gkdfe5PinFcaFkmaCgDnd_Noj6ZPjIzjmpuMgL6cQ&oe=6A830E2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKeCAPyqzSwQ7kNvwFgo0A_&_nc_oc=AdqjgU0J-RCWTdiTvK3PanqF2cy3wnrW4ZM99_TwkP7CEEn17ab3nwQFNPYyZtTRGAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7xNF9f8JG8XtgikSTfHwEYh4zU7iaHnNn7QkMlLpzEQ&oe=6A82F9C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlh9KS5MIrYQ7kNvwEJFii-&_nc_oc=AdrtpGAT6sf6eB67cqBdLwn_-4HYDf_cKsAsIfdmJvXCQOoAm2H8k9paC3JC8eoyeZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJmlt30t_Eu_BjxNRltTWy26Ghrspa83pMLiu7qbBFOA&oe=6A82F1DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDg37bf-0PEQ7kNvwEx180i&_nc_oc=AdrywEtejkH-CZq8LCsPaJGCvD0iGrlejTbGP7Hv52YeYNB2wjmikJOIEU2Tynjd7FI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW0UZHYs909aF6e6xNrlzbquUCGPqzmiye8DthEcoSlg&oe=6A831194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
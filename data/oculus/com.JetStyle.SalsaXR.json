luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caTG2UKkORcQ7kNvwEW8luN&_nc_oc=AdrMZzEyTWWsE-w5ueYi69xkjGdXf8gGf8op1OUfT3WBaQHBq4ws1mb8gzF2LTcE8tQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H4bJLUH3PJtIpu4bnh-VDat5gl3i9ZwYSDLfniXlMPQ&oe=69D2744E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswoNLR2tnUQ7kNvwEvS4Fy&_nc_oc=AdqftP41W3elc9hP7ZJ5pT4Pyseb_NnbnricPelkbSfpo1y9CJ0_3zapdiKINqT1daM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ypn1KUvx5eSxAvOFT4wquQF0jnDtJ9hlK1r0UfYfLUg&oe=69D2652B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67g5QhM-wgQ7kNvwFih9LA&_nc_oc=Adoj-Ti96CS5f1pQfbn5VCedVfxLf_PCMx4PKVfQlpG6MSoTrYHrtQgNE-ehpznfSeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k7u6ljxs07ZAjV2Q-AtdhRSL3cJdJgPRJaVBW-PEv6g&oe=69D250C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_xsE54tDMYQ7kNvwEf9iHg&_nc_oc=AdrSDGWGZFk64Udb3kvChZk3NUyjsjBfvG7867uMM0MeDR3LqdMq2wfvqCB0X9dLYGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h1ZQalEBi68bX4vb6i1-r7jINEEph10LDEq5D76XvOg&oe=69D248DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49C-q7mwLFMQ7kNvwEWtWL_&_nc_oc=AdrRkFWZBkDclvaOWEXccAVHbG0thMUBICik6Nf98li4Z5eHwU_OGIB07-LpMhZUb8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i1jv1wKoa8g3OraaAT_cjA6MIV2hJ0SMvpD_R2AzWjg&oe=69D26894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
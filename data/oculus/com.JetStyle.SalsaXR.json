34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD4gz0gq0tAQ7kNvwF7YkOg&_nc_oc=AdnAhZrD5DKqld9OjkAaEpYxvP8_GS0ObLpsrR51wTTbpkrUEKYFNNxb9Zcfrnf89n8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn_Ud6a-XU47M1U-yyosM3mdfVy7Qz0mgkqQ8OQYWcdA&oe=69BFFF4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ln_v0-ELaMQ7kNvwG9Ikho&_nc_oc=AdkkG0mVO00b8fMKzdzWjtbyjxu0CE6Gow2pCpkI9MYMUhmYMvJZVZsBvboP1okiLc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxes9jNHnop8xJNUIfNcWHT5Rofx2O1l3MHQ6NbP_uNqw&oe=69BFF02B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJn8zaMkBDgQ7kNvwGrFI26&_nc_oc=Adlc-pVn0RVGewZY-clkX3iRSW-Sd8ogGsYHyLUb-6lNsxZDWAymv8ODEqAb_F69JoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHXhxTUfO_wzFdytl676OqSbhO7RWhDE2qL4ABCXDeBg&oe=69BFDBC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQqP2oy6R_UQ7kNvwEVd7zr&_nc_oc=Adlry7wcGXLdt4bHkhYfgSF4a3mDloksfHt_-YMFOyybKtlCvn48ajy8JnZP_HIs-lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyU4jm03ppFnzlPGCMffelcYGDVi-cZhD1igdhDCJiZIg&oe=69BFD3DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx7onEsauoQQ7kNvwFfhQcH&_nc_oc=AdlZecBH-TlVRnGwIFvBkQzHw8WZsGoIHoGFzW3zfjnScbr0j26c4oz7H7CU7CTtxBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAcvEs66B1EnwYEaCLVMK7Ha2gNEkllyq1-XIASVNmUQ&oe=69BFF394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
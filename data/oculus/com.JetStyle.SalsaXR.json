luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od48vWOpfUIQ7kNvwGzRXMX&_nc_oc=Ado9p9J3Qml1mHVhwYZ0_6OzOEtm4pjB_WMMYNjZiWP6eR-NLkU4S2IQdqR00IzKjRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Heg2-geF5rTFH4vWRKsMyLew5OFW5Eae6_KUajf-HLw&oe=6A0DC7CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n74MUw0jZh0Q7kNvwF-DGvU&_nc_oc=AdoHz1tCEKCu3KT5hcySg9pigBKvX4I_N46Qwfpvj3GSXGtUO60tWkBS_HkHUlZ9O60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jWooO0LSHzDUMJSCCQziNMiODLQOIBl-iPof6Opl8zA&oe=6A0DB8AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RgbzsGFBEMQ7kNvwG1Z1RD&_nc_oc=AdoK1v8SFEpKKLdWOoJUR8ICeCgK2gnK7yJQrI2Fe9yKj7YyqBMJc7CBuvLd8wuaWeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rYpNrbk6WQNWtVuvtVKM_mbQjKMoXD5T03ZTXY98lKg&oe=6A0DA445"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI9HVYc_0ocQ7kNvwHr6YGk&_nc_oc=AdrNtH3qOBBrXlL9_Rp2ZQJrUoNHneyXoD1jtWxIIW1s-4qmGpsjXFEzIqlfumWvBO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77p_wMUpuU4ZlzisTMCYUxESpb33dAfriV1l7-2G3-bw&oe=6A0DD49A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvfjOoc01awQ7kNvwFJ5DKX&_nc_oc=AdonDxa_ac56Lh9_ZErsPtRb-k1EqAumHZr4gGChPnnrBqp3WHcUMllbtdlIrs-nouU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jc0f29KxXs20QyIREUoBgGweUxGlsnUzL94-kwSavIQ&oe=6A0DBC14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
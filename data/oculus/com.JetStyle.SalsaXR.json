luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jd1_I1Zb38Q7kNvwGIIOG-&_nc_oc=AdoulNY3z8REZY4sOoRiA8a4wWTihDgx19fNXY_2crThrnjL2meTnh6nRBqq178M9GU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO13T38ebnTJxmYOQpWnfmN2B7sgs9bq2nkH1Yfo0jn0g&oe=6ACE42CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMYCrWjTm5gQ7kNvwEnebzW&_nc_oc=Adr0l1FZqV63npfWe7zrFTExrwpfwIEvyQvbucSqhMWqyYAf30nASjBI-jgRRf19OkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOokQ-1eOqnJ0Kfs3iZ0XKsF8-FvxqYl2VtddbLXjBcPQ&oe=6ACE33AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV5Av_T0JbUQ7kNvwGUu7zw&_nc_oc=AdoGsiKQDpchsUngatWoc4Wdu3pOKXkPr2So_J5wlKeFiTnBIaYKSZGLDL9IkOT5Qko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgqDmErf0fiecZiYryJ7TzYt8E2NwfCjNSFS6-GJTQHg&oe=6ACE5785"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NLuoQtn6m4Q7kNvwGv3l_3&_nc_oc=AdptbtO38ouC3NG6sFmX--NIZAgJYN3F4jiL1Y1nWmQXaMGYd1nHweOgWn8irKmE6hU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7NgWypFxrOUnsmaoic_w53k4M2yXcUTidNR9xyQbGEw&oe=6ACE4F9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0fil3-m61QQ7kNvwEQBMrX&_nc_oc=AdpYktx7TQkDwM3PrHY-Xz4ZjWJyNlOyy85nlF1VBICQ9UGKbYEY4SCTZsvLqIj9Sho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX59bcOzMv1SefpKlWigBdxV8zWCO0k9Py4lRVvNHGMw&oe=6ACE3714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
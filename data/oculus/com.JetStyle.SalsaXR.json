luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU8MHAoYj30Q7kNvwHK5RhB&_nc_oc=AdrYbQVONDzpuvDPeht4LK5QH7JocCLfn2cRE79U0B0a-WJqITJQVbTy7SfFYtbEt5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ6s6cCDfrN0CtZsEvorxPXetC1VSqkYbT80n89oFHcQ&oe=6AF9C44E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADtEmNG4o70Q7kNvwFPSEc6&_nc_oc=AdqmVHdMlAbBDfa9mNJxqqzzolCpcBJmjgu9wWsivBnQU0COGZ56DeFRsH5tOIvGCPo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMP_MjBvaEhxjRGPhyY7PF4HCqtmVXOkX5mtl52e9qMA&oe=6AF9B52B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIkACZrQCY4Q7kNvwFJdmbv&_nc_oc=AdrRr4sQyiKEr1DDR01j-F6unTXukaOGfEQrl5mYqHnnxnq0S5KFmaluI3U4XNitcts&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS30ESp6bZ9nw8ef0p_2pKb1h4d21Kk01Be4gm57sF_g&oe=6AF9D905"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32cpWnor020Q7kNvwE0fBp8&_nc_oc=AdqfXMcfMxNDxOB3nFWG_ms6o6cBmu9YOeKWkc_Y-eFF_Z41HGnyav9FNCw1OuHE8KY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYG4TskxaqIEWoswvlbSB4veHX4GKnswj9SyKapRmveg&oe=6AF9D11A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvqCMen0kSkQ7kNvwGsNUxh&_nc_oc=AdrbeJQsIH2ypF4ZCA5SevTCohDrNL4nFIyOhLiZDpjEKWkTo_uRGVRf5-KlPjjgPnI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9tDOG0s-OhMbM6-hnmsAretxZynm6qgAORplx3BbQnA&oe=6AF9B894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
ntent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx7OLR9PUccQ7kNvwE0X0ne&_nc_oc=Adrq-N_TGQu7lYOMtBDbFq-BUsfmYHEQKUWUZ98LKMSvZxhPooGXKmVOAOvsdBZLhrA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjHPMEkc5-1Z6DZKHLdzGsGlDX2Ohtra6PgYD0qgRWAQ&oe=6A8D710E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khG5ee_3Hp0Q7kNvwHPyI0R&_nc_oc=Adpq3k6r3cO5w3dwB-BuaiNs8Jfo6yas1LZAQA9liSFSBvCySNDcs2lfF8A4yTkj2Yo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8n_kc0mt0vZ-6Tb1TvN_vMOFPachOW_IcrDbkNQEz6A&oe=6A8D9A2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXrRWie37XYQ7kNvwGu9pBU&_nc_oc=AdoY9GskXOL7v00pktmEcm64tuxudT9DM9AhG5rlZSuZcbeNQxJnCcwMj9gNBGiOrkU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7_ZO03U6-EyFy9WZIvMoeqvtr9a3qwJ2ZhZQOa-a9TQ&oe=6A8D85C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVh1UeCcEHwQ7kNvwGWgEUF&_nc_oc=AdrOOuZofrMgpvIrSX08AuUlB9arYCtjRgE4ves2E-b6GokqBzr56hRMGLy0ICU52uI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgyz98gHvtGGutbpu_a0xg-cuFoo-QlSC8Q8IBVsiDMQ&oe=6A8D7DDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1Yx8GaJuhAQ7kNvwEziWwN&_nc_oc=AdqiLtxE4Hn0e3qKhu64E2vlpl46VDL6_lZlUzSH_HR6HcxzJss8-i_K8phVvK8R1-w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGReWtKfgcBVLQX-ixwcmrCFYCMGJ9uiKetjO4IayY5mg&oe=6A8D6554"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRE
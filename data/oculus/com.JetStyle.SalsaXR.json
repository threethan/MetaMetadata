luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDchGjM8jIsQ7kNvwE_bh50&_nc_oc=AdrKC7pxB98Tx5CAcRfPmjD48WLS1Y_P5UHpll62lg99PCxHNxsjwWSjk53IEcsc_Bo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhu9k_Mda0JphihpVWfWdoGbKOT46RCFce2rSwUY4Yiw&oe=6AC8FCCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgcKK_yoMXAQ7kNvwGPg7yj&_nc_oc=AdruNfe8KNZAQ1ck9SUe_ogB3krzAEA_cuFWwLt-1LVO2qi-hdBzCu2d8T9pQpGdQZA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOWQqfiKBtmN-s5gPmQ8Mww8zQ9oBqXXdDj2swifARAw&oe=6AC8EDAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qSBgxc5dxwQ7kNvwFQ6mxj&_nc_oc=Adpl-r0hmhsrYIBtoKHDXlzgZbr6XDbK5eN-HEF5FV2ARJpFJcxqR_fYW8Wq6mzIMMs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Y_7nSxCMIv9qgi_INc6JFhQ8WRTL5TUyo_NTJVMnMg&oe=6AC91185"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkDvEHxKCRIQ7kNvwFykoXC&_nc_oc=AdqhnAjayLDm-pigAOoo7geeQ3jxLiLUDpEMAWGHAro3VJG4bzLigGLqfR7xerKCPIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMosS8sGfaC9bKsLm_J7JN46TdPkcsDETqmxGxQL1PjxQ&oe=6AC9099A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDJ3ftxRfVcQ7kNvwE4jwc1&_nc_oc=Adra6aHBTx4yK1gIM7uO927t4qPqJUvbqaQo6i4l_Mogx9wmIuzDJwlbFOGA1GE3vvQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgjHqhkU1qLhm-suMyZoJ8THpEpVAlJ0vxoNeqpAQsvw&oe=6AC8F114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
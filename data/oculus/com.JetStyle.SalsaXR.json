luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StlwXI_aZPUQ7kNvwFQFui1&_nc_oc=Adr7H9FxE5yTmIpAk_Q7mpr3hGdVZL3n8gRrv9e1wYak2dxvwWdL5Wr81Gc_mfJx0Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ12161prY0-sMiZQ_gpqwN75nKaQ0BLKpHm6qmfJgVFw&oe=6AB141CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hacZBcDEJzoQ7kNvwEUBMKX&_nc_oc=AdpND-aGFcqLSuxUTCN10mcIOtsrs6RBKXHGhRhSoPC2arwyuAMckketnMq9c3QbHIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdDzV9v8EYYJu8ifcXM2GFpUdEzdVuaFTsk10YsX-wlQ&oe=6AB132AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eapX-tz8QxcQ7kNvwGhNh2e&_nc_oc=AdqRWc4KfDiZjJRgBo6wB1JbJB6xv0nZqOOE7z0DNjT2pULQ9NANPQlIH8a4ceb7MBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYV7H0bv0Jo34gMbnm8HdOM5ZjI9aFUNOyjsU4RH01SQ&oe=6AB15685"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iham4XITKH0Q7kNvwHAAns5&_nc_oc=Adp-2nzzQ0ZZLvSXppErZ17HPbxW_GEEBi3v5_YUQTqLMJ6i0qZlKyTQrOAMdfOr-6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtdJEbO9xrB4LaOPcC0Lbh92GKwrp09m8mreLa3_og_g&oe=6AB14E9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtqMzEbwyFkQ7kNvwHmOU-z&_nc_oc=AdpCZOWqxmrACgWaT_NSEsgn8tCiVeteK1uOENj--ZzmA-VCj6dRVd5d-rlw5oHAz3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4frqkXMejk-dcqBmeOxBIrFWP7bH3uBQ7pxprPwEfPQ&oe=6AB13614"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFG5jCVqfDEQ7kNvwEjcRGy&_nc_oc=AdoFe_UiVffvFwHtQ_fzGnHkNgzjaCT_ylDw3gentggtsvcVHp0IVEu-D2zossRY3eQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInu4HvoIeq2YEZbJOQRQVbV_985rwJRZHA1BW7ByGj8w&oe=6AAD4D4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNzEwVCoKWQQ7kNvwGdaKzX&_nc_oc=AdpMkAD4PkCUn_iarC0zg-MDPUt0CsDIEV0gRd3sH5Arq0bM5xbLqf6IeEuJyx5WkLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt2bTiyjyAhLWeaeecEpEAPFy3wFfTcmctLLRvaQG4uw&oe=6AAD3E2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erhtUL1Eqz8Q7kNvwFEpKun&_nc_oc=Adpl0fUflmcINgpK4639RnYRC4o-Bwya3q14453D0dX5T2Q_VHx89ZoZUm0OOD0B-uo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKqu_P1UlLuDgI98y3g59a2U8OCjKazuNZ5Je0xSeoOg&oe=6AAD6205"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgPam-Abmg0Q7kNvwGHesS7&_nc_oc=AdrHqhg1zPNElV0q4zMPnWbxIK8PFR4Dg2fI1pDZTVFeiEoddQhBLgEA3amTMSn8iTI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7CPiRO07BFt5cYHCYeRgzk3xfmKci8u8LgluFH1fbxg&oe=6AAD5A1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9Od6o0iKAIQ7kNvwHwmEL2&_nc_oc=AdrLfN7DGWigOVzU31pCGNu6AZKm5T2iyvqF_PUw7nZ5b5mA7YaLmfQmywaC_-nlQFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRDX21ig0R9SNjX_y3MULMlAxB7CHQRYLitl0h-Kq40w&oe=6AAD4194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
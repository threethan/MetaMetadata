luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bL8AAUUesoQ7kNvwGS6_yF&_nc_oc=Adq1YWoBLl9pZeXuSBgh_J6ham6WVf3TQzZZKan2LReXrk6PTesZm9focvtVrOrpnk0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0cF3C_F-9K1ESOhwOP8hr0ggPhfFtXVQ5e6o8A2dNJA&oe=6AE8A0CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fJmakAmljUQ7kNvwHMN6_x&_nc_oc=Adr79ty-OeG6yQCfTwQW7ZT1VAXqEmQR3o1qkUsTp2Sz6DrL87B8kwdew5UpBkMO-xA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxJ88IUM4mGYofChT4Ev_9Ceo1a3Pvz84K8bxqkD1_8Q&oe=6AE891AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYT8CSZtfFkQ7kNvwGN6lE1&_nc_oc=AdqMNcRTvDRjVFAoEzgSccYlzztNAwChzZMtjfMcOVEfw9BGaR0Y_GuJ3POtL1KeBC8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvgGRSUpbgLpyHuwiF1LUtHGWSGozii6FhuHKrLHWYvw&oe=6AE8B585"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVLEKDTarmoQ7kNvwFUR0B1&_nc_oc=AdrecHCEMYQWrtqIk4zCDcTa95GK3x71ABJiwW2HQTgD4aNdfqCjKMpJRrac1luIPRY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8_4vuNCZBf09TJWEkFbRLjdZ6OGYEm9Qzf3e0yP94mA&oe=6AE8AD9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS5qZnNBSLEQ7kNvwGy8lZ0&_nc_oc=Adp6asBY__9FqXe4GldGdSQnXaQzwvH6h2bg1s-dng8QwFaQ4I_bC77q9IUvgLruIBw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbhUY9kQA6-iFg9-JxySw05UK5eI08Ki-Q_ctnnN5Z9w&oe=6AE89514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
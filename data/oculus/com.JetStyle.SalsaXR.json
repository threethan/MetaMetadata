luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiVTH4HMOIcQ7kNvwFs4av7&_nc_oc=AdroZ7Il4zmsCjV84nswcbziIlyTN3B5JO174PqrnNVbv-ipS-t7sxvOJnPw0oeTqtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlk26K28VeQzCKAux_PIM5-ef1z9Dp3hMPYbtYENBvKA&oe=6A53A74E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJWwfhVUoNYQ7kNvwFuUaff&_nc_oc=AdoZXaHT4cbBZwpvwNbewKohimnOT8zZLHtmtGIiejk4z9RCuR0V4JAUP1yPjv7UsnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQNb1fcfk_Rw0xBmRcOSKdvAai3QrVA6XZfRdOhTxUsA&oe=6A53982B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB4HR2Sm8QUQ7kNvwFtzZ78&_nc_oc=AdrpaCV84lpKTf7DEUrZ0gm6Hpj6oK0x1vhWykkfoDYm7IEHIxi4AUBdJI_8c_q0DQM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE2ZwkmykAI7j_tVKbA3wyFUQWyQR1byiCMt5EJIb77A&oe=6A5383C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRZTZuDHBnQQ7kNvwH_PhBZ&_nc_oc=AdopYX8NTXAhGxqDJME4NbCNGr0iPNiUw7NOtDM_wko46tdd03-3wzDMG289cZMr_UQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRNk3IN49SVfI4EkIHHAKKMFDxDNJ88R76Te-rsCvmhQ&oe=6A537BDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h5qDS1sj0kQ7kNvwGqoPmM&_nc_oc=AdqfZ5Nn2gGEb_oQZxucdGd9OkrTN3_MKUwzANv5A1VkIircs2beuO_cRaEKqg-9kJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeSyrrkBm9uepn-aZqewwUhWdz7Lu8dqBvsRWJOhPOhQ&oe=6A539B94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
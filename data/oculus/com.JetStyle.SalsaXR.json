luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1-07inXzQIQ7kNvwGTeXOa&_nc_oc=AdoU4RNrjdPBLb25H_-QBJN0Uc2erqHhkFHld3gt0TZvS3MJSVJHIG4emNqxffYw50g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp29dVw_eWVNTZ49aDPTjihfHsCWEUvJLSoA0Qy-Q8fg&oe=6A9ECCCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78UaVJKUHCgQ7kNvwFe73qt&_nc_oc=AdqlM47achB6s6dlnMBAisCwUvYKziF7mdRkb5uvRNBwuYEGNvb_7sWO-Y_5awzZV50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI_JcQe9ugrjE0p-CrM2UbSVLieFT75kf3dX7nt0wvRg&oe=6A9EBDAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycuycCJvwdcQ7kNvwHRdQg2&_nc_oc=AdrWlFwV4I_kREP1ZCTUfkSpdhPqJYCieJcqO5z_0vF1gJ_EffO4u2b4gvaSMnPKDnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOMSic9YqqWYDou7IokR6suSBOWiXpdIw3SLU8jvUWyA&oe=6A9EA945"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNtwqIibbukQ7kNvwHr1NjR&_nc_oc=AdoQKPXm0ADZmDLtrlPlZUIFI4GtaVxMF9IReeQGUMI0zWkUx3zkQW8n6nnkcFGiBFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOg-2Vdn4eOLhFUThj4vRM2cCD6IZH5HJUaBF2J0HK8A&oe=6A9ED99A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSp_wnefHf8Q7kNvwEKjlbn&_nc_oc=AdqR3t3d4pjBgq6ahPxPBsWkn-qDs_v_Cvpl_DoZdPwfiQlHc9fut6Z6JEqxj3YlLm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQai6IfRxzPBOvi1s6MWaYR5YbkXbY-fb8o1HFR7dx0Q&oe=6A9EC114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
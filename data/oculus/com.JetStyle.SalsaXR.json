n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v3hgJ75Lh8Q7kNvwEa2EqJ&_nc_oc=AdoZwEfgdjUAsjEV03TB5RTF8PJl9HlwicmM09P6tQpjd0An7sW4_r9XMzlvsYB7r9c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR2nXj0d-aYvszaEHBuhLN-v8vJkBZ7YI62p9JsGcLug&oe=6AA412CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAnV1H8fYbsQ7kNvwEC4Hcr&_nc_oc=AdriwuZrEP0izZ6rftjvTnEUpxEERa4dRHKvoF2OdiGIB6mgYQgr1II4crjAzEwengc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5NYEVIxx2nR_S26iSxo69HXbZXSW8c-rdyWt3gqFhtA&oe=6AA403AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSh_WN4GcRYQ7kNvwFryByj&_nc_oc=AdrLbV-RZRa-8iOqQd9u49fO_6BmOD_HsY74VJOTcdwFutOrGb-rdYozSniaAGVnXms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKqR-kvLelzUhyaAd-dTiHvshwxwK64LDV8dX9-jbgZg&oe=6AA3EF45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLLGFtflk_sQ7kNvwEE4E0x&_nc_oc=AdrSHhj6zsPb6_9eh5i5MAXpuyhFi6GpnqjCufWOVXKLSIWFXV5jrUzqLwI71r9Qvr8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpoX9KAaR1GC_IGhBclxMHNTaHzyUEiAYfvkhrG3ZeDg&oe=6AA41F9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfYXv_zpAXIQ7kNvwENd9R6&_nc_oc=Adrhy5r6a4Qya6llt88tGHLXhGeL_MFhml8mcK-R0-MZDn-aO4otGvdhwZ52WHwWYRE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjf5_y5y6d-E8a_kKx7HWMGPh8Qq6aJ9RQj-fkhhqH9A&oe=6AA40714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
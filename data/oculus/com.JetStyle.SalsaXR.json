luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKpe7-vyzosQ7kNvwF7Mm44&_nc_oc=AdoI1H8oCOFMTtEmVgOj0qb22kw4eLUbHs0NOrLeuODHBxg0Gg-uxyF0xWcaEMq3LM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW4SULeve1Fg4Eij3Zcp3zgWBy1yLlssUMRYACHcDN8g&oe=6AE2094E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZgU65Bm4swQ7kNvwE3QetS&_nc_oc=AdolBInsektktpe6K8zOHhi9-WBXHx92xoaCgatD77GtertV4oLMLbKjRUrQG9j-GYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuR1ZLx4Tap3TI5-UNGoGds9k5ecsc1erC8yxkOzTEYQ&oe=6AE1FA2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSfvBW0SjIAQ7kNvwHG-c62&_nc_oc=Adr1iKZF2SERgUAhACA-cyP8nOHg-zKO0OPAz-KKXMlKuIBsvvS1YMgLbMQMLD-HIeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVjBunISudBI6dtfBV--rltT80zxAAPpvC4A2HkGNT0g&oe=6AE1E5C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IvSV01EC88Q7kNvwFxS0vl&_nc_oc=AdpQ1N4lXdupW7tTZ5lHKBn5VzXA8c3Tp3sl_wiVSjaLFBNdMLDjSDAiA6uide9ehtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD2srTTmj9xFcprgFKAcxETGoT6lLDx2WqVEbqqMb5bQ&oe=6AE2161A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WrzAtAyc10Q7kNvwHR5x29&_nc_oc=AdouXMLBwyxEFzVzSgjGvmzvqFV0Stn_Zi0ZQPQ7mRALfsZszhnPIp3g3b6skTsl0vQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe7YyT6nJOdTog6R0fqUozvTxOvPgK-ikC-UDQMNJwOA&oe=6AE1FD94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
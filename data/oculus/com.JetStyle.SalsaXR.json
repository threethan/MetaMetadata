luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dftEo5yI2-UQ7kNvwFKlMza&_nc_oc=AdrVCZ8fJKsqfJXFpxA2ThapVFPWW8DngBjmAG1y61rGpnJ3__qr9QwbqhvxSYDwLgs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-nSMdsxgEDCV3KaLMvRzrCzph7-l3ja_J9JA6wAwjzQ&oe=69E78C4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Vj3VEeWHAQ7kNvwHx6tEd&_nc_oc=AdrPGja_P19BushMZwvINvY-4UcPqOlApnIZOwclbgUDTFBVhAZvGbkBKflHjXgSdMI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03Zd5c9cMWbVogCxw30BY9Vvkb3h8ObzVOodCdh4XUVA&oe=69E77D2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAdvMZnVjT4Q7kNvwF-O5fh&_nc_oc=AdpxPHp2j15T7H8PewejvtpVQVL7S3JafZS0XCgYASb1VnOAIwQ1j1GKUny8Cq_vfS8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pHT--TeuscRp3KIL7Cx21Ij-4ZYPYlzkW9yZmus6bxg&oe=69E768C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvil2yyEnTAQ7kNvwFWWrsx&_nc_oc=Adpd74qNGmqYKOyfqYb_AyHd6GZR_HcgKf246bUQLqH9jLYX7F9EE6FY52AWACJpFPQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GU4ZNBrJIHUpR9WXCsRbOEyhqrmZUDbBVW-wLfQ53IQ&oe=69E760DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKqsrYir960Q7kNvwGhZ50H&_nc_oc=Adq_cSKRIVPdMmkDBuwc3uGIeTWlfRj_JUJyha56-s-ddafGL8mlfIfQOCO5Lqamlak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OY9dx11sFe0bv_w4kahhibdIjgw35Dl7FKBPgNDeCaQ&oe=69E78094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
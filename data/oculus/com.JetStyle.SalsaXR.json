luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDchGjM8jIsQ7kNvwGFr9vS&_nc_oc=Adoq5cO31IiwV1KqSJs_qyylPboCIzEe6gb6qkH3OzRvBAFpO5_-L5fYyPqG9jd5TLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlzj76IZQTwTlaGksuOVsvlA2JX0C56nJHXMHobM6ELg&oe=6ACA4E4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgcKK_yoMXAQ7kNvwH6m4IS&_nc_oc=AdrkWHk41eYVueC2xd3V1Q_97fIp7RbVZXqc50ytm_Zd6KWEW-IUhE1Ab7JuBAbQ0EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG3S2HUNdfhcJuq3oaMmMqpZjKyyRJ3xkM8KXHBekLYw&oe=6ACA776B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qSBgxc5dxwQ7kNvwFSGuT2&_nc_oc=AdpXGyj9SQC_OJ9-hesdLP4AL36NJxSTYC4UXRKvurUtSxiKppNZ6VkPif3Keqjuzqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsYLPCB7-mwHer7bCehy0cktRAA1G7D7acvF1suDJiXw&oe=6ACA6305"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkDvEHxKCRIQ7kNvwEBYPWq&_nc_oc=AdoioFoMbJutlKB5BNYSGQcLAC0NjoCVUXtDaMs4mnxmUfgss0xwkUmbvQdO74R7m3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEVhq90nU32NO22FjUdPMHDw0KcYfacn2cNzEDgD_cbw&oe=6ACA5B1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDJ3ftxRfVcQ7kNvwEfio0V&_nc_oc=AdoLdqZhzkunBEvdgWysFqqR02Yt9NWHq1ksUGgvsY4MOMeJJkRPXyQyhnO8jWBwDt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJGItEP9fhjiObZ-stI5sPHrLO5sqdinGSeNH9PXF59A&oe=6ACA4294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
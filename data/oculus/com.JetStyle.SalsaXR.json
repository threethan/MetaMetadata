luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_bDHZuRnLMQ7kNvwFSg_6r&_nc_oc=AdoENBJZYwmqGPNNrBeTzQki4yVsKPydqMHQF2Rj3JpDrue1tHLZ8DNVslM1t0KIeRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVinGBtG4osCWM3PgYzLV_0B2xrkRlnV6CPDFhAxAemA&oe=6AF47E4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmWSd26ig7MQ7kNvwGxkEGZ&_nc_oc=Adqsz33p8l56IIIpJRumwhErgtapuUW9vvd0CYn45MuZULQjKmhy9jciX5XG45XNtxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuKZrEUt4Q8tzowF1arE-WMcba3Yf8H9bwgbwoa4pi1w&oe=6AF46F2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q6a-oABLSQQ7kNvwHsvG4P&_nc_oc=Adp54uymT33f09E1I2pVMrdBv5TnDl4tnFJvdDvf2M1ShITESgfJuJwQpm3E1AiPxys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHO2cInTqxj08uBPjsFf1iO-1m-7oadzJ0sYlkT4fXJg&oe=6AF49305"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLu5ek0n4mEQ7kNvwGSiwsk&_nc_oc=AdrFclmgJgE7ek85IrAmCQ5heKuQ5mAxhu5i9ywOY3AVUcGKqD5x0wqNDw6i2xE8G4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOaP906wD7mtnreO-dmraU3AFVJDW1I5lZTboTr5SjZw&oe=6AF48B1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWJOHo22f4Q7kNvwFTy8Rx&_nc_oc=AdqvGedLHVvCccA_3hwqwfbKJb94TKOmZbM88ajtE726J9n-HCe_KhSh5ll5eeKpqfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpSYB6-rR3xNw7ssVwgYN3vg9LGXB0P1B80sclJvIFIw&oe=6AF47294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
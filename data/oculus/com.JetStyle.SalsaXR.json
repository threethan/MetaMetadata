luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxjGw1CNsGsQ7kNvwG7L3zZ&_nc_oc=AdqM6Hy3bm_kcQTH0vI4MXTsMpkQNs_gZef2QmWfXPMDghEtsTk2BqEdbgqJstswDMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVBqL1o3gTIJvco3iQfZFa91OT-x79dnMCvjVqyxxcXA&oe=6A71F9CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01aeyJ78_PIQ7kNvwHpBHSK&_nc_oc=AdpgLIZLFQVPimiyYI5EL8ngwlwB33BWW4KkcKqYQaNs8HymELXoFp6a-TSQ-4tlnd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4P4yOS_iCuVbyQlyQShqfDBva-GU5LOdFL4no4fa0tQ&oe=6A71EAAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcQuk0SEzA0Q7kNvwHGELKD&_nc_oc=AdqkJR849rEK7QUbDFptmGztDBZrf7KM5NB8lglgzdh_6NA-5XB4cbPvUU3pIE29FlQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3NeeG-twm4QuRekhbiwB7uT3-cxn2sukLWaUvSdcBWw&oe=6A71D645"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR5vBgG2JGwQ7kNvwF4IMEV&_nc_oc=AdpkL4DVsw-Y01OqXazwrW4QMfOQtm2mbcbZBDGBYNbb5biu5ZJ-5HuophtoZWXenx8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwK2FuWuwihgyTgdpnLv0ZBmYdjT_q0-dzdKrWjZKhlA&oe=6A71CE5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b5JRsLH5-0Q7kNvwFBDPSO&_nc_oc=Adp7cKeRuiz3g5nXVsIajct_4F3OyvwEUuM5u9WusBV_kEQ-nBG5yPIfv_lH1nmMTPU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy9xMQNP8LV40D4weXM3X9g3ljhB_jjyqm9uWXa_l2SQ&oe=6A71EE14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
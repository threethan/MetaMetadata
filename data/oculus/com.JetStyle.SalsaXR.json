luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOe8Rw9DKmkQ7kNvwGvS79v&_nc_oc=Adq2daxF4PZbQTvXDkxifRYVIoA4pwyD7Y9j3QXr9WZayX1awvfnGGlOoGLEhRlltBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-77OAjwNDwittEZulEH4s3q8e_nZkFgRUCi8mtJGQ9Zw&oe=6A3FE0CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhWTz2Jlp-EQ7kNvwFEPJ0H&_nc_oc=AdoD90iABXudWT_i6ZuMXiRBOyyiHmgfFEfaKFR5Dk80JpkAnWh-7ZTVJMWmxeIkFRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VP9dB057DKw25Kn2BuTVamIWb4saevXSTocVtSbD68Q&oe=6A3FD1AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zwn0OeJe34Q7kNvwEngX1Y&_nc_oc=AdpHQ7o1E68J8wzn8h1ZnjLa9_ysVlmCOzNB5TEoWWB9BERBi80oEaX-WONRNPdrO7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hth7rh6Nr2kh4MzgpQ8iy-2m67VYTpGDY2gOByVPJ0Q&oe=6A3FF585"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04jDV_Ipe2kQ7kNvwEYG7k2&_nc_oc=Adq8SrGF_i7fKDK1mZqq92xwQi7WhWiiAuObCYfTUL_zLTpEdoAINwrjDbpWWhyNmTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q0LQlyELsub5aK38q_GF385WW7iIP8_sOxnrWc7iSAg&oe=6A3FED9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OueV9sVTQMQ7kNvwH9xfe3&_nc_oc=Ado0TpPwKRwS7YOuM5ejyqwNauuNW4lqhCqCbzBeAoGqP80FWbWIWSdUzJbmTxxgH6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3uQ0xAroAXzYGbxvfDGLE2rXJmSsLM1fCELHch0fPdw&oe=6A3FD514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
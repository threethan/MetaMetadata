luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqVYEylywicQ7kNvwEPfJc3&_nc_oc=AdqHlqTH2fItXRQ0OzcFWH7dyXjEf3pmwWKzh_Jy7f0jN7WVHJxq8ZOTs3onchKPjAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eMpJMDXEtXUoGRaQUwA9SuuVGb0LS2BJ8IT3WXUcaWg&oe=69D3C5CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswoNLR2tnUQ7kNvwHF2oc2&_nc_oc=AdoPenpbdF8Zlpt_AMsj2fT9-efq8Aah4NBC782jQAYXBH2ehQIX_-ZY32BB_4ZIQ4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JWisGUZCCPzw42vR6VtLqxotstOWZaKQ35XUbwYOk6g&oe=69D3B6AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67g5QhM-wgQ7kNvwGwaT6h&_nc_oc=AdpdwJvSaytXdBnTi-6mw4Oqx72neu6v-TWsggPeSiFjAih_6yNpWt5qhvIwLpY-VGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WW3A_KksGBskBXNixS8JfzvdPwMuMfAZVUWcRXRYu1w&oe=69D3A245"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_xsE54tDMYQ7kNvwGU7_jm&_nc_oc=Adp0ZdNcs0gZHk6UYk2CD_dgV8gif3buZ62Uz7PTu0o3anTo21tHubFDr1P6U8a5qAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bTLWI3PgZ4p2JKjJ_9COLBQGbAXqMarcjrMXk4EGGbg&oe=69D39A5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49C-q7mwLFMQ7kNvwHy5v1x&_nc_oc=Adr4H6yBaqvpxPwrjA94V0em_ijjxgJhw-k-gcF0cXEx-XNWsBRzGaEOtdEfoE1GUv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af289Jm7yMw0QfjMGW2lTDoma0aI3KUciClRxKAijnBPaA&oe=69D3BA14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
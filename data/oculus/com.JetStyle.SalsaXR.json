34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwO0JGFjvhoQ7kNvwE9kvJE&_nc_oc=AdnrPRagGggv_OlIGxbUHzIyka7aG6reoG6L8__AibMtqYXuiP08CT1IUWsgUsJWD_g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2vtUtXGD5Rs1saW22nN-xhkU643wSt8J1d9dvyrD39A&oe=69BD5C4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wHd8xXViDwQ7kNvwFBFxUT&_nc_oc=AdlBAM5giwbIRKBAhpHXU2_xCtIzQNtPmwlnxB5p25Lg2SslYRJrYnTYBGhT6veryvA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmznBzXHN90kIMq04uvdOU3DI0XpuFDvwWsmPFJNPsdg&oe=69BD4D2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr9PUp-wRC8Q7kNvwGAEyFq&_nc_oc=AdmkJmJ6JHStcpVn2-dBINsJv2Y1pojdqlvgiYecyvrZ_ah94Je30PPsG8hT71MeOnE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCKpWuVyHL1jyzlGR9feDPNKu6gTaW8qGXTwlHD5cXXw&oe=69BD38C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQqP2oy6R_UQ7kNvwHr0a1U&_nc_oc=Adnw3h3m5Hk8NN2_JY0d14Qb2rdA9cnM5xWAiZuEd2dBNgVr9EWFP2GPKpKZVCZmPew&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwBVqXWDGpF4hpO2jtrny8fCxjd_Q6snBKqvptnaNMew&oe=69BD30DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8cQOw3RltMQ7kNvwG5-OuT&_nc_oc=Adk4PVPaW8seXP6uJgiwws-IgwIqf3aSUHc8clB8TYfZvntTXZwNhQyUe-V68cIkSjw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyRGfL6MkmsO2tBifVy7LSX35-AHWBnnyCXNm7-l-v4A&oe=69BD5094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
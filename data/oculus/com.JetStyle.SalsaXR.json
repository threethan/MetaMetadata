n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGd2pFB03bgQ7kNvwF56flC&_nc_oc=AdpehQ4NQh8HUvrIT9iSwsr9PRB2fQBYhhwSJXD9S3lFHCZ69Szaw5aiRjjR_sK3sck&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfExZouzP2nlXIZebJVh4upSXocffBhZPxiUPi8Z0J9Q&oe=6A7D9F0E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx-Qz1jyKwQQ7kNvwHQnXCJ&_nc_oc=AdoMzyCGdTB2FWCeYnz8EofP6Z8UzsVpB1Jcqz1NVH7S8h1XQu90uWEDJwkGVJLrUE0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLzBabf-713pnMpIfGH4p8W2IjcxSKarkq1w3XHELjzw&oe=6A7DC82B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6kjJgxkws8Q7kNvwF_JTN5&_nc_oc=AdoiIABUcr_4AUNJAnm_YmhZpHI-Cqc47H7uPYEvDZEHOykCgB9sjVDJWc_68vnVo6w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF31RWdWay1ht-rPKDJy_vU3BI2q4X-0xpEgjZ7VP1z7w&oe=6A7DB3C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3woBAkJnoewQ7kNvwFN7nxX&_nc_oc=AdrNqQS2BE8V_b6s9Cmkh1eJWvwmEMWesGk7JCRXkKDQYPWrhSE3vwKbXx7U7gTBFDM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF34I9-cBQDp1VLDrRzyn-5gJKo-83lkAe39uanPyDNtA&oe=6A7DABDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLGszgp1jfsQ7kNvwHqc1xJ&_nc_oc=AdowCLZjBnKc7egEhgzxWHECbnbjp6GqsGOonckO4QZlUeBNdFxw1QxSfJdqNhE-NEM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZzcMv_C3Md1JFVRl_BoguNzFhOBTgrtA77HgYl_h7Sw&oe=6A7DCB94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
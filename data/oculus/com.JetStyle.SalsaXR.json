luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSbSCIP-MX0Q7kNvwHaBufE&_nc_oc=Adr8PzAaT5NJCy-q1MxEAjyQ6_SDfebxqNliQmZumxok9KYefeDUVDFSZF_uGvEJiI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GCGhYg4h3shVq60YWPNoon73KKT7PCjOg08QiitusyQ&oe=69F4BB4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcnhojX2Oy4Q7kNvwHaGTFl&_nc_oc=AdqA1pRIteGP5XI0JP1CYUD6HlQ0qfxl_qqhLgN4BRp0Ez8eoVTraSFOSCBOV11wLJg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZI82NIZCOehNkWbgLiYh0VTFHZNnyg2uG-RCbpfq0HQ&oe=69F4AC2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K00XPoQcvwQ7kNvwGXeopt&_nc_oc=AdriPfjK2bcyXtpd-UbMdad5DqrTmFtZfIob3fa97tQkRiXtIJ7z3eo8waPIx58YPk4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gJneEPNlq7u2hvtuNz7sZD53dLLK-XQcLVAazOFg6-g&oe=69F497C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2uK-xnLO98Q7kNvwGANlWQ&_nc_oc=AdoY8njeO64gG135W50FP2dZDfPw3ntm5fqViL1B1n8mD_T-udEcuXFq2796QVsKydY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2n0QaJZDcW-tnLnSlr59TLavYnX4-bqAUvE9zaUn46-Q&oe=69F4C81A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g6MmO1KMKoQ7kNvwG7GMvo&_nc_oc=AdoHORkhU6WXWhiPCtlZa4xmjnlXNr74BLlmnla29FcUmrtC62ygkGc1I3KaENB9WCo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fiwoI-_qZ4yfUsrvjCkjJ1PmwwJnrjVUr31OSYdaB3g&oe=69F4AF94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
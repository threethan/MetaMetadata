luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjtOtKdGjwIQ7kNvwHK-h05&_nc_oc=Adpo6EHUZWMvL4ypOoDM_W1-m-N88NqtDG7PehLUaTKvxDZlUoJKvXkj4kUMIISuMJI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KqIiT_Ad7mOOiiWAVeQIHcYXS8JCJkBnTX3t1kodoXQ&oe=6A17024E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3Qi9NB25C4Q7kNvwEZUFFX&_nc_oc=Adqe7uvQ4IgvIyX7C2h7GvN61kZtHI0t0dxgDHcy-va52eied9ab39IhRxzHg-mL4R4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ru5CoBSydDq3PDC4hTw7crLWUXaxsOgnD9PAZNMuodw&oe=6A16F32B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akoj-xB89LMQ7kNvwEZmYwv&_nc_oc=Ado9fC4wma7wQ3rl1So6G0V2qWne-aSDIdXBld80OBrOjt3liJDYuDbzYL-WCzcnxJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55FstIptf792PQ3eQqJhLlTwJVMZIBs7DQxjcrZtkIlg&oe=6A16DEC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-AXqjG_iJ0Q7kNvwEoM55K&_nc_oc=Adol0HeaaoVakwcZn2VaKEUJOSztnJks2fEBMx1R1kxVJiguUzGZh7lfnlFSgoNdzI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_Yv1-vzQPOIYYrS1jcQ97DxMVDKPHqFh6FhKT1HIrJw&oe=6A170F1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BRcRMoaZL0Q7kNvwGKe1Wd&_nc_oc=Adoyhp-XulPgb3oyCtCSgt8Bluda--nVG6nxd0y1mFt9_FPHmsSrmUy5aBbeTEfdDWo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af449TVmpI58HIl9b6Pha7qtuMw8_zkHX1MyYgrhMNj4Iw&oe=6A16F694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_bDHZuRnLMQ7kNvwGjYNkz&_nc_oc=AdoOT7jWBqNFYIqIRUabCIcXCMJg-zitw24SJgkpY1hV9Ppvstrme7LAY0-q_7aZcQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxQVtXaTGtdRlFXRZSEAPoswoTREP9dL-axaeHJt_sOw&oe=6AF7214E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADtEmNG4o70Q7kNvwFQsNd6&_nc_oc=AdrZNhIh4pCdb_F1KIiefxnqP5ZhcXnM6GV4bPAZJM11rV57EYcNsIfgYU_7E5M-xgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAwFU6cz_gs8igD9dfbN0BXI59p263rEcCMc0l_MB2EA&oe=6AF7122B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIkACZrQCY4Q7kNvwF3ziEj&_nc_oc=Adq5k9pdQHunXAVheFTkgCHj8e53NE4XT1xBaZoh5CHSpanNLCyh6GoXiwkiqLKQMhc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiwi_6NtO35GboUBY-1DEUNigRdr1CMaSFAxhO8n7Ckw&oe=6AF73605"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLu5ek0n4mEQ7kNvwHmBzSD&_nc_oc=AdqLrbrK5wbRzg3UbUBIpV6iv7Q0Ouj2-94cGJX6relpbXx8kbZrpa63x99LfUEqQGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTebVGpwnA5D0d6w-D8kHizaATqVKvdN8mX9bC8FMLtJQ&oe=6AF72E1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvqCMen0kSkQ7kNvwEDtElp&_nc_oc=AdpK6nufaXkNDnRM5f-kLDxttnizz83utSMKUtFKoeF_Qs-V4i9BqBnRonP8i0Nsdsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkM_4kY2dWVRamtiK1RLzwLlIHkAm_i5qqjyonNM70Iw&oe=6AF71594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
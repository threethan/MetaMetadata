luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUN6MJbrzssQ7kNvwFX8uxy&_nc_oc=AdrHCRzAHpvbghBdbXAZNM_SoRuoLAf739GRfOenueZhrpK5xnLdXbRiKVa3ALrbHhU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JuqEvwtSetaC2q51MZ4umBXF11sY_5krPgdF3uRO9Kg&oe=6A26D44E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVT1dmNtJp0Q7kNvwFkpv9z&_nc_oc=Adod-evD4DNxeaNKXju4XXkoRMbZmq1BeGkrOi50_sb65lz4Mk2pyvSttNpxO6E61Js&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3gAgE_m4b7OAyzEEGVgT2sEPvSDPFm6XvKN8NCiUNtw&oe=6A26C52B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fK1b1ucCcIQ7kNvwEd62Qu&_nc_oc=AdpLHDqbQHjMxJj5SXaJRkQ9yMhnRpZ3BtfjqOdAbnvZcFWIvLK_BYIcQmye9B0NajI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xj4Vgy_2T3bntgF71e4qHzwB_hNXkXF92vrZpTaoWlw&oe=6A26E905"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0l-OYvgA68Q7kNvwHc4icT&_nc_oc=AdpG5ALDouhZSO6TAtMBFboTOAQXzHFCsFqq1hEN7bbBjcJn90I-SaPt7CS9rdG2DW4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZZ-S3vYBihEc3B-O9oR7eRQKWqoVD569yvtBbEty-Hg&oe=6A26E11A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFSOHeEX-yUQ7kNvwFAnOWR&_nc_oc=Adok5pnEfYLWTzE4LWs5ld1f-uz4sfU9otB8eLaT9wajCOGD51cx4SNHBMRbh9rEhyQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5xoBEd47802BBby80gyPPz77cweinwXhK0nBTJUeX-g&oe=6A26C894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
8524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BceCctn5reoQ7kNvwEm7dWA&_nc_oc=AdkemlWSvUmBNhAxY6XOi_el5iKMSIEZB3N4OZX_LcOVV9cFd9BKRuSAp60Ij3CBwYU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE4rdf3VWOavWqVQckktVVYcumRtRgrm_rjBXt0fpi-Q&oe=69AAE74E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jow1jIQFuhsQ7kNvwGUVZa2&_nc_oc=AdmUtlNrPVT1bM4COxA7PmQuLn15s9jhK6oP-_kHZi-nCUW9GIPu__B4Ptqq7qMEbSQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIlOtOJ0UDdypqtgW0faHi8ePOKvKGB117mpFpmLbANw&oe=69AAD82B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV879O4-RRYQ7kNvwH1Jl2G&_nc_oc=AdmZttUn7LS_NndsSWRnX9h2ytz5lEmruztDh8sXxiQ7FX0cQ7oDYVcb6r7Ae9FEz5Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZ51QQKpCl0h8fZ3QEtM67iLipDyVIc0khTaRYmFaFLw&oe=69AAC3C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mB_YMfmeP8Q7kNvwHb4oh4&_nc_oc=AdnLMVLtMjOSOW3oapTAKIokQ3m487HSzBFrmy1MmAKVtk0G2AjppnZ7K_dxSZc5pog&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDa8RIpYCnSnmssIRX5uHMHWdIpPTZbV1Q3Qa4N0KN3g&oe=69AABBDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3arnp0GUILUQ7kNvwHYUS6O&_nc_oc=AdkpdUV8K98YH2c7zjJ1mWT8apmysk_zTNNLYTvCOxlyvDoyAhjPPNpj5jFsMv4puwc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCKFcmdwl3ymsz4K6k0shYxlvwb4EyQ1NCVZs0Sq-lFw&oe=69AADB94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
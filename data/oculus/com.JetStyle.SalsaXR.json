34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwO0JGFjvhoQ7kNvwEUdaz0&_nc_oc=AdkPGb5b_P1n1eflIK_MZgriKei3m3RsXbU4z7-M1btinZUQYQi1sD2kNLddMiL-3GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyePm4mDWGdaauwZOdbBQJKotX5lAYzVaQDWVegVBVXgA&oe=69BC0ACE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wHd8xXViDwQ7kNvwHTEoAt&_nc_oc=AdlUpXYT4ATI8WxGt1XCnbENq1USwaA_6qrSS7mRxGm3_9mRnrpLfHZ7bMZuhkpsRQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrmesvWLpSPDo7cxTRJYtELIs1ITP50mvIeAPqSrMfSA&oe=69BBFBAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr9PUp-wRC8Q7kNvwEIWhMI&_nc_oc=Adnv8qUd7ZvBVAAaHb0AYAW-e5tv1uXIVWaSQ4HEtkwGakrxQoWvcsgzDQ_i9IG-TUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcdFbEhene4lToMFz35cKEZlx2dTnSUnCUHtRMFEr6SQ&oe=69BBE745"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZjdXeYvq2UQ7kNvwFE8PaQ&_nc_oc=AdkWzmGcuh4Kc972qfKndTih3EZRmSh4WE6so4kKpPGFfeJO9t0H79W5ItPbiY3csRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxhisErfdG-ICamabJqDcX8fjRdG8Y_WO6YPte4p7OPw&oe=69BBDF5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8cQOw3RltMQ7kNvwHqsHp4&_nc_oc=AdnMMdO_uAEDZ8t7AjLOJ9gV-5Ghc0-ZkFJ2YcYxZZRPrkuqXTWqtkXQgF7BvfqLUjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeX2ZSXpyQIHUxrXNARcBJuWJjz8vnGha0AQOjOdECnw&oe=69BBFF14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkhEu4VIZWEQ7kNvwFitCHp&_nc_oc=AdoHlNIBqdtVIzwQrDggZchtTob6c8CC9n88jEB7ZEPNKgNjgf74lMQTOdjmfk2Loew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKjyi7_vsTMl1hac8ycLq3Hi8ezhEimRtHLXHa42eHdw&oe=6A491B4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7zc4FIfUdIQ7kNvwFnKlsA&_nc_oc=Adqwobkj4KJ64fLoCNPxdCmnt9kGZlH0KLJps3eir5zqGPvPIoOTbRKMD08swfXtrbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq1-B6C-2JwvGWNeDpS0iVFCD_hTNGoPlUzOVp05k6rw&oe=6A490C2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlyEFjoHUB0Q7kNvwFTU01N&_nc_oc=AdqA19sWm2bQ_KfRDFn_gGyMf0k19zLfEc5IxYRnEO8ABMbO3I_tiZsl16E1-nD8ZaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtGqkk0WuBqIaDfNm1fM61VgOQn5U1knOtdDaTI3EF5Q&oe=6A493005"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdU8moVrPNcQ7kNvwG92arw&_nc_oc=AdrrEeUB7glUTa2QKlKyw1nDRz6tC_wxqAk0wi_kSa6pgwkQhCAO4_kq-k94tU466ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9Qfn9t2hhi3KaCPqLDW8uDvIm5SLip1AYP9xSoDUdSQ&oe=6A49281A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRa0C5w_3AwQ7kNvwEnhpsY&_nc_oc=AdrXjxubDL4Dy4lFUJkCLZtcfrS7Xc5ZX6WD0ibNoQNL5Ui41i63ahwcPZJnVaKK__s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD44rLDu5BuPqZhOAXGHq-b_fwo6elbbFwqYXQUck0gg&oe=6A490F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
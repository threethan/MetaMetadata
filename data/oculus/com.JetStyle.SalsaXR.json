luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt9Yl6DL3qMQ7kNvwFcelF_&_nc_oc=Adq-ilE5cbYuXbhbEfn32pzK7OTOYeaev-bdH9q7jpDB_B_RBZgZoxaMHSmi4-tXaCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C_KM7ZTvkHebtrUlMXc_G5fhBXrb8wA3kkY0fkP6wpQ&oe=69E4E94E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8_Y8x3aKyEQ7kNvwFJBP_8&_nc_oc=Ado6Uv4V6cVTfdLLAF54p8JuFjJUapds3EAAKZJGEa_dtssyAckm9DRbQWkROF0NkqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af182Q8JCWwCoA_MppMFmeYa2KMyPuNYbyxf8JJ-AMG0Zw&oe=69E4DA2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k62Olb-zpfwQ7kNvwEzzf1T&_nc_oc=AdozKKqdOVwARWyvcHoTQxcUPG_r6YanAqPeD-LfCYd6f5-_CO5Xav30AcpD3evki6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fyPrW6F6D3ec5i_DAoBo6MblU-5hVKD7ujg5o5c5Pxw&oe=69E4C5C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvil2yyEnTAQ7kNvwGijWL7&_nc_oc=AdpALKCZ6l_mX1dM9bARe4kxi47cE7euK47J9lkcwYwNd_iMBVT9SJqaDBz6w61Xv8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V6GD1eRPgvXZ8vDXtWBZzwv83j-hUehzRLtpsfrEcvA&oe=69E4BDDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25o8LHG753MQ7kNvwEhzp5f&_nc_oc=AdprZ32AHjJv0Auwb7sXi9Fr--WJ4mlp-oEphJN6_IQu3vUi7VMJAI7Z3IDTkPe4nF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xXezxmT9mlCo1ymCCrSBpJllvZgglThvdUSSSelz8KQ&oe=69E4DD94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2KZoLLBj40Q7kNvwGleW9H&_nc_oc=AdoQ1mmKLF0tQbYY1rBQW9_bFS0wCDpZxU6B88rzYYrroSjU-TvmWQYzfZ4YqOS3myE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVLNxIovOEXC2N9pb8qdL0S0WqYeav4-xNvunYKW2gpw&oe=6AB687CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3-IUiNM_gEQ7kNvwEOzpIz&_nc_oc=AdogHF28AIfavRY7kbAUZuW-e9QWDiDZoAo8MB1JDSw_5YSPCbv7M7udF1N7Cy-9cEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnLr1Ajg6E55mCesltJ8W7Ce9HWX2n8y5r3oxFf_zHpQ&oe=6AB678AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLGnOfeNPuMQ7kNvwEBr5Xk&_nc_oc=AdoJtHDU5lEOZffwKEuh23uOUkBR8LV_SWA6FhmSYoThuVTqeYIHJ97K4yUewI6alJk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkoTodnauI_CAISqflqBP_GEGxLW_FeHn_98rRFgfDuw&oe=6AB69C85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBUy8878hqAQ7kNvwGKMfnZ&_nc_oc=AdrkXoM5XUF2rnL2mVGV8tEwxMJX1cDwcVKFW4SysxbofiJTfCiAsQkNxakp7OZCc3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxz6MgAxi7gxfGkNPNPpBA3E36_D4iGqej_23qmeUqqg&oe=6AB6949A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhZ3-8cgPcQ7kNvwFbQD2i&_nc_oc=AdpgojZ7PeqxsEGcxJL0SAI_hUq-PFR7qV4dM9CGH9xmhsVvRgiRqlgWYnJ4tPom8PE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlFUE-ko8NjZ5uSDqvbs88g7MWQzgjG0f46ZQuael4Dw&oe=6AB67C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
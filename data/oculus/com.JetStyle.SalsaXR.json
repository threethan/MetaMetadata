luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH8qRsDcpx8Q7kNvwH3MGsK&_nc_oc=AdqHeMQAvqDeRaadxRYk9HvxnKkLEhBaK7WVIAERCjuihtfWx7974yygi7YVDnYZxUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89XFr7E7e3JfEwJJ11pSV6PhoJG3viVDUONyEb3yC8Cg&oe=6A300ECE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxhbpPcLiK0Q7kNvwHBoDCL&_nc_oc=AdplY7ho_6xUrcqrrYC74bcxMUCYQQ4_e79nxoHQnCWbCVnKtyKRAIZwzarLEi0Q3Ko&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vSumVA0usFRdPzAeJaLdh3Qlmm1zoQXzCWOvJHZNZmg&oe=6A2FFFAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqRaNvXKJ4MQ7kNvwFdoZHv&_nc_oc=AdqycU2EtmBMQD01O3szcHwRsrw7Y7kHrK9YJcSrHEQjEXVVBISOvBw1jzyArmZM-tY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92_vn6bU8dxunJoPmItC65X8UxEscbPHkOjqXoTNWAAg&oe=6A302385"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzw5-yvV-kEQ7kNvwG1TgAg&_nc_oc=AdqmnMdR-4VjzMZn0kUdHchhV98fMtD5cMwXkrRTxKDKMGvH6LWYaqbgMKgEw02A024&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UlgwwbrMD1Q3A_KJx01ElRtwXe0KajjDmf1lr2x0mPA&oe=6A301B9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtYr7Utu69QQ7kNvwEx7cww&_nc_oc=AdoaJzTsIveeq9CxxOh533zotY3YqcxkoqGsh59tQY_JwsDDpHoNNJ6HlvrV6RRjP3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZGr_sMev3EOoCe92VmXG0JraR3cVvrJXkmO_65UJduQ&oe=6A300314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dftEo5yI2-UQ7kNvwHWecT0&_nc_oc=AdpiCvQ8v3XdBNCv0tq_XzjyRXrDh7uCcK5n3BHxNVsDJsXCcNYy6DRVkg4VLzNqUcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N_Yjls6hMvYl62xOTJ8RCKGP16NvyexymFbnoo1UiGw&oe=69E8DDCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Vj3VEeWHAQ7kNvwFm8VZQ&_nc_oc=AdpDldONgneFRLU0wO87y9vG2NTMxWB067wcIX2Ila4rm6Nh_PBlJ7B99IEUAPQ7d9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lC0O5f0nHR7_o1hy8rS_HS2Z33D3BBWyGerFWsZEQfg&oe=69E8CEAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAdvMZnVjT4Q7kNvwGK93sa&_nc_oc=AdpR5iK2X4PneeIXyg8zClKdu-b-po7KSnkKVUJ81hgeMjq0IFchcBEK-7k7404_SKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z0mw4xDSbZ26UDsY6ZXL86MeelBK_l3gLQ7uf5WW1Uw&oe=69E8BA45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yARDreLNCYEQ7kNvwFzDoac&_nc_oc=AdpgI_2cnOr5vDct3qEIQR2Hy4yXoY2GkHqRFCq0uWa7XBh5MLIFl8PnMjrdncC1aKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P8Oz86-RuBwQRFWTlWgCcyxZ59ap7a-XOUHyKj8EQ8g&oe=69E8B25A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKqsrYir960Q7kNvwFmmzBh&_nc_oc=Ado-yohwfu1R4OMgesPHsdX1SR87K_1_QGScgahZ6-8OZvurLT_Euww8lSBx4nStKYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yxk3GndmcBI6NbRRGrv3lsdJJg9JaQroGeqg-3Ki4lQ&oe=69E8D214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
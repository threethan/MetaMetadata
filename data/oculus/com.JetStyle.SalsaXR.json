luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P23ycUYwx1EQ7kNvwHZti5n&_nc_oc=AdoAXJpHhjcBu7QfYhLOvSnCAg3A_mY8lcdQtyXU7Fr9K_-rGDQ7RrIogsdF8-aPe9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wv5Uf-y7YaHEzDsERzfJw56--ZGvxiNu7OH0vgYPUow&oe=69FA014E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EHurTM4SOIQ7kNvwELo-JU&_nc_oc=AdqVB9klGuN7LWwiT7g5PnPoT2Ll9EDs1lvEmnTtnIv7hv-QZQcOsf3CMfyrOM0Aka4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54NqlHXEr9_vD6nXlFP2WWRItt3ISZaP-ST4VpQfZV_w&oe=69F9F22B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9HAXC3-_WoQ7kNvwHthia2&_nc_oc=AdqqUW9XQX1K52FeIdUGdrEGUsPvNYppbNaOK6HiJi5Qw1AQ7ypKLTq6bw6XcYnp5fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46Oi5PsmPixGEceE2Ctu0bDnRjqIQisipoXSmmMmIglQ&oe=69F9DDC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyvjJa0PbUUQ7kNvwEinZZM&_nc_oc=Ado_MWUobH8iN0g48YFDyFg9H0dWgpLPo1F-ulEZyTsxQm9xGFKb7-0WtJbSx59mvC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KrPhgZts2Rf1v39uaHtutCSzEkuDSjxj3nrkN8St81Q&oe=69FA0E1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkf35kSx46AQ7kNvwErR4NZ&_nc_oc=AdpDTHjEOkSw-lI6F62IyvN9TFg2_iQHzzyQyUBmZ9ryBzZkZnVQkt5iJwvpT7sWTRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QEeSGrfJ0Aqv7GU4GZcoT5i3nLRpx4VMfLOolDUKzOw&oe=69F9F594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
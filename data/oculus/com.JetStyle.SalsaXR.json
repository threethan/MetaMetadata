luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpIIHqKO7l4Q7kNvwGV3HyD&_nc_oc=Adp95coLcLPVLx1MVKiW-lH8NM2S_td6QoNj2ubD8Q6KFui-HbPOZOL6iJTL7In5y9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtIe10az8NNvyQHI6WllHLpibtcOq0dih48w900lKTqQ&oe=6A6227CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFDfwiiCHR0Q7kNvwEtlaAC&_nc_oc=AdpYfomzlo33A7H0lBbO27Nb2plBnDXqLr4orstA8pndqzU7hVFomqoubA-1byacHws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_P636iUH5HOa5q0bqcB8Kh4ngu7W_oCvjFAmtQMT5w&oe=6A6218AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xb9IgvH4zsQ7kNvwEgSY8g&_nc_oc=AdpK3EANgKRyfEbcRVbXYcdEnRJLfSXgDcnoLnf99QBMWvUSJD0C1z252R0a00KjSxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU92YPsFUIKpCjsRxMMhq4FD8ssqKpmWsrppjdJYvIIQ&oe=6A620445"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq_bmX3DEBMQ7kNvwERXUZn&_nc_oc=AdpG-k0rZTz6-uG6Jax1KDHxnVXX6WJhVrSFJMb5Y-5Uj5Ab_XijdgOoCtrnAwXdOaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjLimCXQBra35YIioIcT11HCf8ePdypULYnibABpLg4g&oe=6A61FC5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LP1ebKAiZkQ7kNvwGiuOZc&_nc_oc=Adp-Ap80bwT5IwdMKFHpR-lWlKBj88jJzpgEwTgHXYNXQsdRHqa_TCjgz2H1H2KM1OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMjgQMYAyWlVzNZSR5JjxVzP4A2_G0yEefQeduyXVkXg&oe=6A621C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx7OLR9PUccQ7kNvwG-izPJ&_nc_oc=AdpCHxiDmKRELEC9D53H8G8xFX5QbD9FkGMlzP3kgb5JkGKe1leih6TyUnev4oGMrZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj_LbOoCg-cC3-qBD3gxPNfvgjbXNSufzCM8avL42T6g&oe=6A90140E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khG5ee_3Hp0Q7kNvwGISM4Y&_nc_oc=Adq-Va1xYK-TZSOC0988ZoAXtVtEDrrV9xVa1T9sCCwlUj6YOMIZlnyRFxgrEHhwM_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExIW1qfNtVDdb6jIZYEiNl6OeNx1RhmrMWqoeXBxdfKQ&oe=6A903D2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VsE3CZHOUkQ7kNvwHQ5i5v&_nc_oc=AdpqBEL7VEaNHRtE7n1oKH2-gGWcZPZrHYwqHlSPlMor0lMuqyDMK16TH6UN-u7Fffg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMA6kecvGX2LfEx5ke40lAvWJyLzXd13w4iXRNafa_Vg&oe=6A9028C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kXjJrPfHaEQ7kNvwHiv7iG&_nc_oc=AdplMZDJpVZMdtxRVTp5-8vT_iLamtCFDFl-yFtbZrbY3pcV0zqOIQLL9kz6qePGoFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHV6hW3dnL-YFv6YVapm5RLTlM9OY8THVHzY1JvZ68Wg&oe=6A9020DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3niSsqAf_MQ7kNvwGsSldM&_nc_oc=Adq2fewzmdaUAgDg9dzTVscF0VbxPWVlSZF50CorcjCT-ym31rA6Gcyq_fr-pUtbP80&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLJ3JM1WCxyh3hARgQ4EEd85D7D4_VVyw8PcDBRevzpg&oe=6A900854"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
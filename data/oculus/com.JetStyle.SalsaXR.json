luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm2WBpiL8bIQ7kNvwFFqvcl&_nc_oc=AdpRLMhEBzyPhENeUhFGL4fXT2Dgl2yWGIBFxW2VeOZu35om3UzvLFMcPle4d6XbzDE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t9zA6Y-IfbTUkX3aQcuxuIN9W8WULUfd3VRGA9qeS8g&oe=6A09D34E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBLnHrqEtggQ7kNvwFGZP59&_nc_oc=AdrcpO0SAWOCebHEdp2lrNszy8ugAMW1UcleLoali881uEETQm6-aPYdqIbVNopbZBk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BaoXgJYtei35tDJVZywoEVaKPHoL7V1A1Uws3NKI79w&oe=6A09C42B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM9ilvLZBaoQ7kNvwFBcGlZ&_nc_oc=AdpVJ75vV-nNJrIJknhrsEnnBe0xpoM81_dI102SSP-WzTiYUdxbcyPAa8k9Bg6_nY4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JpzbMkNLYsgrlO74TN0DxSXJpm3MqwxRVyNK2sTF_-g&oe=6A09AFC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hx0I0hG01AQ7kNvwEpGIxT&_nc_oc=AdrJ7osVRTodAFqIYEhMj6naMc6nFjyI2LLm5hMHF6_sarzcGTvppsL89KsvW5Z2_4o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4meACLNoz9zB_Zg64K8etR7UkjDX560bTDrek_rp6P6A&oe=6A09E01A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chvBr5mxlsMQ7kNvwEF_PDz&_nc_oc=AdrcRKNlNm9zXplj7wtkkrmNYjsESfFjeI35LEVwoe0Kw9mzwY_4PPO6NhzqBV0yAec&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fuNc3PQ30zLjSqDbkLFyqh8OcXy9OJHSvXLuFK4gdjA&oe=6A09C794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFG5jCVqfDEQ7kNvwELG3SN&_nc_oc=AdopXvam5s_kUUZpu9bP_Hi471rhm96Xi3DtecRTAfz9NHRGdQMOffK9g-5W5VFeRqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXtQh3_mPE_6tKdkkb_3PQgY1U27t4D6eoKEPVq2BIIg&oe=6AAFF04E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hacZBcDEJzoQ7kNvwHexcPH&_nc_oc=Adq5sxH7K19a3RC_FEpJ_cZ-1QH5VczBXDLgdsKXObp9bD1XNHFb1SDdo_72m7P-qGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZf_b2X_l6_92qX3PIzPmskJ0Q1iLiAL-2bp3V3FTatg&oe=6AAFE12B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eapX-tz8QxcQ7kNvwFvvnv0&_nc_oc=AdqR4Ar4TP-R0Y8Afstc6aMzIdY5IfWA8Ox1s0PQsRjq7ke5O7e5zeHw1TzL5P7vhrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHaS1MbDnat0ymlviiAZGoSBCj15VHtuTQaIshSRjLZA&oe=6AB00505"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgPam-Abmg0Q7kNvwGHvZuV&_nc_oc=AdoCgb2unhIrPFe106zn3kdITC8NBuUfi2ugN-oTIbHvPIjhd9GiEtnxDgpIXDOFPDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk81Z8XTgEPcnCs7QcdQv7NZUWlY7UkhNIw4M8hVAQZw&oe=6AAFFD1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtqMzEbwyFkQ7kNvwEmW-zE&_nc_oc=Adovr9rj3eqS4sgPr6BIT7EbnzFyedADUkE9Q9xbm1aYAZLQXKnOiyMWuSe6jruo73Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk4Z9xghHIeaslswBSPzQoHgJedRSVGpVzD7d6sYt5Bw&oe=6AAFE494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
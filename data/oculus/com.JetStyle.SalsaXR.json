luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_HKMKY9dLkQ7kNvwHiUMVy&_nc_oc=AdpaMgGWpednAla0Jc5Utai7iNWO5s8Ay2gbEwYDhnKg0LO6kdbwlKCXUqsDxLgYSoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuJI8KNkCD_X5bDKVBTKgAqsr2zK_W-1L890wks4k0zw&oe=6AF089CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFWlZCHuBoQ7kNvwHDMtQm&_nc_oc=AdpnWetWQPz1XcPkgJ2G4VGB_hckGzf1LBxwOaH-GTQYYLWdxePQhnDDx0rh2usajL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQClMZSUS3f3poooZRIPCDFrb4SPMvRVXYyMMC0Sa3VNw&oe=6AF0B2EB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBCohfvcmxkQ7kNvwHJYIzF&_nc_oc=AdpXJJE8ek_PsB--wIVEEg3WnZ3C5ajJrFilWn52CjLscjWFVa9piU8UoUYhlgzv0mo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ_lWITHN4N_Zf9q9VK85eQB3-lH3yjOI5DiwVky1Grw&oe=6AF09E85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxqjaJEmK14Q7kNvwHNvJ3a&_nc_oc=AdpbbieNXNkqZHKKvVSRHJMvXmFqIN6IZUv-2kSJfgWX9ADzKow6Nw-fn5pjlTnapKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1wnxs5b1qgR_qo5bGjQqREbhABBqhLjyRCh65iJndAw&oe=6AF0969A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B5A-KqO3-MQ7kNvwHIXmSQ&_nc_oc=Adpr1L6zzm0IF-uo7vU6va5DJ4620dnlROjvoMCxWvqL_fAfKM24FRwM2hn8jPTEYO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxUjchVjJy29dHE-xQqYels_pgFhUV9b8uq6EWbU8eSw&oe=6AF07E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QG-5oo4qv8Q7kNvwETXhBa&_nc_oc=Adoh0PUtMYDIE84HfI8ZjRPzwVPTsQ-7YT9GIkHD2w9wwlq7FwRhF9xVd7-U8v4kqfg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXkDl8753ECA_YzHnfEV96SNNdehUXC66NR3s_A82ynA&oe=6A882B0E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2K-cq39MEQ7kNvwHf0bMp&_nc_oc=AdrvMPSOUaH_OLoCxzFDEII7mLzCbkJXLQ3O_OzPSggyr_a3ThiCubwIcIKCJFSJBto&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJpfjyicbN4TBST6HMWi7y6NSJvqMXG4f1kan684I4qQ&oe=6A88542B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvVlZmxlhqwQ7kNvwFchfyl&_nc_oc=Adr5wGAB2rnyGuHNjduV_z4jiZUqXetOmNduc0VPnBclLAQkxck1r73Llvyy9pyNMsg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO0cM1eo47TtOp8Vc5Ns69569kFGtXWG2ed-xnm4BLMg&oe=6A883FC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0qalapUW-sQ7kNvwGQkj6g&_nc_oc=Adp6jHq3OoywZEHcWIoU1Y7mfLZkflEUAZvlViaXwb--ZPsKgqPSsT2hUIy9dHpnPjg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEefsLWz17rUNelUBJa9SUnNrrrAU7czkNmBy_zJCaiFQ&oe=6A8837DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gV4K27M-hAQ7kNvwHZH1fB&_nc_oc=Adr5o0hCa3myXTkMJQbzWi1lwgzVQXYwWkJyNP6aIqoabmq-rRatRYVuvH0WCr5vNvU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOy9uIrLA78dYAO38jj6N6f80nKbCI4L6jfprhU8KEGg&oe=6A881F54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
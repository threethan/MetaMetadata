luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhLvvBFrTgQ7kNvwEhmaBb&_nc_oc=Adq9U5p13_HkXmaGvqsrmFjYyhkqZ81mr24lPgnjhk_MnbUkoAtUgElLOCez3-1UhiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af633AZbAb1a6muHGB54ew8yfxeBH26QpeVFnr5rto0xiQ&oe=6A0098CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_yq6IGfCNgQ7kNvwHP-uew&_nc_oc=Adqz_Qwtmvycu6sq2tMZab-IfoxtU5Nyv3SxnhsxdlZKtr4q82x7C2y5tJcT1u2Nf38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mPrVGbJ0vn4suxx51Ol4ophj0l3SVGhpQjl37v3TFoQ&oe=6A0089AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtXopzPaMPMQ7kNvwEasxKH&_nc_oc=AdpghU1KP7z0RbVYCoQSo9osP2vQuPgOKoFobp-sKdggoyK446MAhhYj8V-MMI8jQBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MltztYxh1mAjDvqy_T1YPBThqIqD6D1W77Jhltc6cDg&oe=6A007545"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhPkGeFZZCsQ7kNvwGRU2iZ&_nc_oc=AdqQ0lkQ2mCNjirZgC6lj84ewzjNDdXOh38RaWdAEOA123NqRlklh_84ivhwwmGkqAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d-VN6ctbzd1m7hcFuVMhBZ9sH_ESFgEwJC_yKv7f18g&oe=6A00A59A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOvP7CyG8kMQ7kNvwHe-V2g&_nc_oc=AdrKZQhXG0W8RXkjeTYA8M0l3XUWqI-VKB_5XGYqGy_ZRJDhiN_eBEk2ZEAiBYXb8LI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QssuPrvNHSQGZRWcDGhBKWiMo4XGgB0ixsPGs233PEQ&oe=6A008D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
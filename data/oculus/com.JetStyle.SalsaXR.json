luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHVWNW7oIPcQ7kNvwHcEsnv&_nc_oc=Adpp3ZjtHnjOGqNi_QHBuYLkh3EOZ3Oon9oCfZ38PBy3jXWWEfJdTvKXW5W7FdfmvYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bZFGO4ZRb0hwru778o8wsLUFXy-wRPVMvx8Tf5gJaTA&oe=69FDF5CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_yq6IGfCNgQ7kNvwHNBMBG&_nc_oc=Adoowhg1cxz1Y_qTtJnxhnNOensH8O3KuOMk0vV_ALye4yrU6x25RygAmFCkOzRBjCM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bP6dCFhDmwOowkPf2of4ziIssrzy4i3LBwVd58M0NSg&oe=69FDE6AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtXopzPaMPMQ7kNvwEOLusL&_nc_oc=AdqpaWF14yQ2oB7oY8i6hS3jM8v3QvU8YfkGWXPCnuXxrYGdrKjTJ5uznn-hiEF1qzI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IMiq9btzIIHTGjfcH6Eq7q4FtPdqZ_SDeFMI4FtcCHg&oe=69FDD245"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wQEAKRFnAIQ7kNvwEfSHm2&_nc_oc=AdqlC5qbHait6B9Iv19JzvPJBkTEHoqZee9U7ojaWsRF-br7CNdAIvCkTbqM-K8T1uk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wnvF52ZIivmpNSKTCaTCz36_p2LPDM1R8Jald17r62w&oe=69FE029A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOvP7CyG8kMQ7kNvwEQZdU_&_nc_oc=AdrnuEJVxyFZUMK1ug_5nXxz7-7CHkgv_bNHT2jYu4L7gDokatk0ziCczltqSFt5dfQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XEoLSAVZXbL-oC_r69OZ3W9wFwF7CRfYqJFozi0_jlg&oe=69FDEA14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
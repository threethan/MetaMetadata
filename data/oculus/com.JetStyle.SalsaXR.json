luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABfKa67wuYUQ7kNvwHUC7lk&_nc_oc=AdqDHBfIQN_gAQyupmCQR9RKHNui792AWm0EIRBiEIzek9CxgjTp6vCkNRPbC1DLB2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4t9PGFtEZ04QEz5g0Q2Nfl6dqP56YYNBLmCzFbcIk2w&oe=6AD0E5CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeTFPn5NGlEQ7kNvwHmE-xm&_nc_oc=Adq5FpEM5cG1Vy5plJi3HLxAaMpZThx1qrDtN9NT968QWgCT-nxGwoWZKCL8W8W-wg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlIXZHOpm69mKSNQKhrNJ_yZ4e-rzX6YzrHYRSL1xtBw&oe=6AD0D6AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRgQVPtckFIQ7kNvwFm6SHV&_nc_oc=Ado4Q_ubHHA42r_aj4Kayr_XzGiVYbN-cMl3zLB7RILsL3Pqz7fI2kZycpQJE0NvnKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKwEvQlnymOVYt5vW2yhUdyzPxkRIaHa_ZRrYKK9btzw&oe=6AD0FA85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HusQSqomQxkQ7kNvwFfyS9B&_nc_oc=Adpn2jzc61ufDkXJzN_DXk2P6UZIDchS--0qYdkPGU4BAsNw4VJYO5Rqa7O69orV1ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML2jNUrI8PnzxSpRMoPR3Ply0xUeSCoqu77_6MxSPyIg&oe=6AD0F29A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnQUj_hG03EQ7kNvwHEGUzh&_nc_oc=AdrOM8nK2o1LZMxUYX7k9vv-xOksD5XfxBlcPXMWbVjmAFzSBsgL8ytAhNAum19rpAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvTHPFmik4R3BXEU-_wo-Lskxk4HjV5A4NYZXjSwGOcw&oe=6AD0DA14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
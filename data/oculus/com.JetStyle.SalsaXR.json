luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzEoBMo3nsQ7kNvwGLd6cn&_nc_oc=Adq5XnMifII8V-HKD7UxMwkPvH-syLheZwaYjK38UqmYqXSdlQfPTtwD5lMyVK4aAfw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ipGmKqzPgJgrNkUu_DpsH3IiEVgQY6agRC1hfC_P1BA&oe=6A130DCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-_PFwIkdH0Q7kNvwFWQzew&_nc_oc=AdpunRyOfsIsDCedNAx5lBtgG5U9OW2-UbW0U-YYlEc90W9fhdijI_3e_DvMwLnFZSs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65nsqsnyX_5aBPRX1swmLk3Xp9oGFs_ZxnE2dkZzn_lw&oe=6A12FEAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0AAemSSvr4Q7kNvwEIQn8r&_nc_oc=AdqfhJ4REnkcqExmzom2Tm5kYgpU_y1IC4v26riPjvoGoOu6tg3nXIBeOcyLUZqfe8s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bV40b_6JcC8u9PTsyvweX_ymi0K7WdugvtUAEAOYwnA&oe=6A12EA45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSQcsQ0JG-4Q7kNvwFtTV7w&_nc_oc=AdrWT28HNxl5VHMQsH_E5BswZRky9JD7rqCLhWbBXG7FKfOq1G5ux4g4pbTuIJZf92w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NKdgt4pymtPSLENKRERZikelZalSgyRGmux_CKzEmfw&oe=6A131A9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWUsz-R6094Q7kNvwHhdqLv&_nc_oc=AdqeFW5KAANmLL_EwfekEpt5KotdvEu9DYgTGC6fhfRdr7eEfGwntOCkel4xPR0vgwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lfS556j00w4PTgFiCGheAbs70AvfgMA5Ez5KXn2FtrQ&oe=6A130214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
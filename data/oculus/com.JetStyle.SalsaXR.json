luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvZhVyOsu1QQ7kNvwGu_20o&_nc_oc=Adpvbxiici4oKOKw11BkVzQbmRcOniw6jJtEOv5SBS0BkmBGhkHjFGPfonhe_Q1IPgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1HJos2Qt6jDaO1fT-_E3wM2o2xJQREBzwvAZI3sBqPA&oe=6A6B624E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WE9TMCjxGoIQ7kNvwGFys9v&_nc_oc=Adp99CPWhJ73M-Ksf2z0gMh78Bpe3Sba5HFnBWT3L28r_e3T4ZzE0wUTvOPQUXdOHhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzV8aUppTXJprq5cHJzALmNVQdR-ijfkfDjMBWhdEwVQ&oe=6A6B532B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpVqoX6WYGgQ7kNvwFmGYHl&_nc_oc=AdrSi55st53vmE6uZlOoEKZa3YrJJNH_h4fr42dQ6iqLt2y7wehtwfA7TSfuulg6Q_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPjGo2ynfPLKzUJod2wYoGPjB7AdUV9WXH0Ex916LwVg&oe=6A6B3EC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyuLq8FtGyEQ7kNvwH5HWkH&_nc_oc=Adq9z_xBjpVUlzUmoxwdMUMKlYzBpwY2hCj4BPJt4EXzaMLO6ZuHdIYK1cgfl9QqxmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFW5mkoGlk2CsUdjgU-uc2fbxcFjZC7jIMBudnFufbEg&oe=6A6B36DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdWdgptjG2kQ7kNvwEau7sf&_nc_oc=AdpSTKNPZW2ZNC_hq1oD1wjasTiy9klbLXdjfXZPKlPxfpvrpkEXF-5V83QegTzEcxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGGlcog1AVaeAmnVS-ch68YK0IKiSX-H5flb7Vnlj1gQ&oe=6A6B5694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
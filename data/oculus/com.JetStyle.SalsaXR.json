34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oisUmOJQII8Q7kNvwEkLYb-&_nc_oc=Adm3HIpsPymxmJ3rzG__Bnl8iULt8vfAF59Ia7Qf2K_qHWOSiGUDqaR-RqwqlQSkvxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBazXQb8TEzDte942UIb9nlXLdK7GEZXIUcuadPTdtyA&oe=69AD520E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68NDtwcj5K0Q7kNvwFgdQ6p&_nc_oc=AdkEd6mh435WKrUBeW0gICyeuo_BbeJABSUjdzNvaLGmq4D2ThFB2H-U46TmBqXOtBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDruN286qufFIgJNLSVrozoWv_NuipKQtmUxJlLu_WsA&oe=69AD7B2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV879O4-RRYQ7kNvwFRt_Pt&_nc_oc=Adnz59gDfissZ0h7uEq-JhYXafMPg_HsT_EsmA4GICnNahf0tMDWQUZo2nmztnJaw_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-5u7KMJfM3tb2LylCR5TRzfEi0fKaOK95Igu13is3Ug&oe=69AD66C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kydidWalgkcQ7kNvwFVR1QS&_nc_oc=AdnR7H45FypR1xlEZ_p4lau8ZaotFcE8D_7McVIvyfbmzFR1aIELA2t5olYspuCCP_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEmdp6YazLKBYBDf-2AtbF4c8giahQyHt4Nq9q0LukVw&oe=69AD5EDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3arnp0GUILUQ7kNvwE8il8z&_nc_oc=AdnB69ocXBZS1kYdH68AJDzYoh0w_K7SSfeLUlELzpK1m4zoAR9iQZdNXyaBQEdxQFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2f24kqGIGDftp8EalDqTq0SDwq7PfYX3vMiPSeMd3sQ&oe=69AD7E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aAICoWUrxEQ7kNvwFywZmj&_nc_oc=AdopNiEgT09Tkd7DM3zufqu8NOmCSXloJVVmHaqCBVyr1qMp7529kW-ogLtnCgRTaeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F0NxDCXDJhI7tirDJzmbYz6Cp9JnLhKbp6GDg2UuqSw&oe=6A203CCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzToJLD7KfoQ7kNvwH97az4&_nc_oc=Ado26_ECI1zcalv-T0z4hp8andGGl_4e6r9swy-UIQXYuZkpQeyirjEZC1TZQzHkql4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rJyj6vfX3YTNbY5sPGx619Qm6wgi5E48n6X5AjOWkAg&oe=6A202DAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ2wVCxtzMIQ7kNvwEi--dx&_nc_oc=AdqEMeBbd6gXDcRxB-q5GHAHVbWxKtKytCsGEkaEXXt5uUisNcQTx8O5p8-9YvjmMf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_egKbcfgIeQCmeP4dLVa6u4epR_MqVyiJGjKM0L_fOA&oe=6A205185"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrBYb-QtokYQ7kNvwGl4voN&_nc_oc=Ado_hSgzzON5hjjtTuigRrtoqeIaMC1_oSIYmzamRHQHxsqjeMLBN9-AOEMMsLfgzb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v2yCNQNdIYykYBSPILMmOjP6klzc1rXoKSvjJ7Bcokw&oe=6A20499A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOgKC7K62HoQ7kNvwGyCm12&_nc_oc=Adq28BkaGyfmfumeONrAM1qt64CcagSR0g1Ytfy0VyPBZYh9j3UcFBgO8rYMYvvLRi0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EzDbwLGudDW8ACEGaSVJFOxWwYx1h2GtS855YBVhVDA&oe=6A203114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
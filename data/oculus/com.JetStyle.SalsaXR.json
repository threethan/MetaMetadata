luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azGfccjJP3sQ7kNvwGIrOjT&_nc_oc=AdruGBfwbCar86zC5pS9R1y8WvTgEQypWlDrsw00mcCJHYWpxBjwqVZc2fFFWFZbga4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d6LM54FPRS_jjGpKwLoFZ5VhGAYiKnb_qeaE_ynP_xw&oe=69EF754E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g11ogkiPUcQ7kNvwGHq7Ip&_nc_oc=AdrJK4Cd-e43-3e0XD7jABz7DMYJSpB7CNQKlGTMFlLuMzO_1dZh4wwQZLEVj6VcsWc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nPPIcRFr7c7fCEqE-UpWypmX_v53d5hYYKbR2775MQg&oe=69EF662B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX5iT7s3ZHcQ7kNvwGIFYw0&_nc_oc=AdqtkifDb-iHrFmKWGNVwU7JCp9PQgCTWcMY4ZXGmSNJ2EouoZDLLD2S4lXXZp_3-tA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zFLknf0N7z11erBu9W9L1jOj7j2LBIlVCHhM6cd1lDQ&oe=69EF51C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7m9gFEgVKgQ7kNvwG3ysWQ&_nc_oc=AdpITe80nTVKfYnieZGnHG6agW2qNVWg1TVq7_coZTs5uJKHB_k8uT9YrXu6njaFtmg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ifBIIbauSIHd0_St9O7AJ63dKue9_1-yzI973FcLPMg&oe=69EF821A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP5B7AwcixsQ7kNvwEyWeSp&_nc_oc=Adrl3eFy1FiVfXINSfy_PttbIR4l6VUsAr_NFkPTvQb2kHkK1L-1jcdmdF2w_RBJpok&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ej0Qjm7OsAOqx-GeU26Z5v7d_aTBu16vZbCWdgkDwXQ&oe=69EF6994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
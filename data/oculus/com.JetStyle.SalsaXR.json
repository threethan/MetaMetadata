luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOdjNJ0pLCUQ7kNvwFia_q_&_nc_oc=AdpXy64nPDsWkFwbDyOLZXrgjzgsYgrgoKXgcsgNwK22hkMMBB2Kevo8svLvu9X1q4Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX5kJ0U1vG5FZYMY7HI0vzuAaw831VrOniyR-hJfia1A&oe=6ADCC34E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE_11R8sIekQ7kNvwFe1b-1&_nc_oc=AdrNxO97V3n2g0bVEUKe-pDzdlIc3YewVyvHMzTbbVzmoqgA52ue3nWFf-Db50O8Goo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVBYp3IO9f8KKGXXAAnti1cyk3B5ilplhwe6deTT3HRQ&oe=6ADCB42B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwSMd7EI9iQQ7kNvwFH9Pgu&_nc_oc=Adp4FXUM_JzUoKlM4LCgqTz_3l-UIJCz-zGwPNiPPdHGYduyThNuTxOjsaSDZinZ_XA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtaosSjnIVJeV4SyvU9MRYs3Q5STucqTXBDiTqSOwVEQ&oe=6ADCD805"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQytAgzdLLYQ7kNvwEncSFl&_nc_oc=Adq4XYwPhzp_A15va9cRTlJWwhdw7l9xrU6ZsIIMRdDJsAGi_6tC9I0mIUfT8zomM80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOByr8wzs1rMPQizFIxH-jt52zHMIRU-on-hkG3KtA8gA&oe=6ADCD01A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RyOPTBTg14Q7kNvwEANpfW&_nc_oc=Adp1W9FXegrMB1TAZRiY9wBmb9oz3db-SLneI-Z9JwLdpvbRJ6IY0BqPnH0E3WRZf58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAnump23M8o1Ph42fTOKWv-QTEtY_mKE_LPsSxySPoqA&oe=6ADCB794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StlwXI_aZPUQ7kNvwHEruRm&_nc_oc=AdpcFbyfyU0SYIAI01jvjw9UARwzrq02Y6FMLFh-yXMPyfLeY30RNs5bBgQ5IY3_Z4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItYC7pb0eckbMPvIeXpN4BYhDeTTkNCRogYaplFWgR3A&oe=6AB3E4CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3-IUiNM_gEQ7kNvwGq_rcj&_nc_oc=AdputrC4PgbOF3FbZCVLz3WvKjQf3nuhyJIh7Qq1sh4_UPfz5ipl9lxyrGAQ7GLhLWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILLEgPuiH9DmIoOuQUu5bW8gyz__1cuKHXrMdk77KUJw&oe=6AB3D5AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLGnOfeNPuMQ7kNvwEJsmoC&_nc_oc=AdrWyMGWqgMKN53hWxtD6NDZFtcjjxhNRhVM2ZYZkdbk2r1yIzwoB0LTx2ax0IWg7pA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqjuXCjpBtPgwZ_ygxxYAuqfQv_YQRBqaSTYNkVC_WWw&oe=6AB3C145"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iham4XITKH0Q7kNvwEd3rZy&_nc_oc=AdqN3AdyUXKq4dMzkhQNyEUFnFNK3pNwgZWZQcO4uv3Zw8POY0sOVMF6eMD7op7QS9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwrgOzPfkQroSyZiDYt-ltrvNICoWFMfM_wPMxlUs1iA&oe=6AB3F19A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhZ3-8cgPcQ7kNvwHusdiv&_nc_oc=Adpab_9tgt0dVsByMgr2RQJCd9T4mPfiGe8eS_30O3asOWwciYI2iXShrL8d4gflnYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLidMyNgSvOm9UgtZ8XifunS50ZMzzaPsvMpbBYhdYklQ&oe=6AB3D914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
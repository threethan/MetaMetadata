luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bL8AAUUesoQ7kNvwECP7AL&_nc_oc=AdrxQFWvNiPFkvr_m_y78lKdfKQMtk-pn1c1qdnGC9ZKckZ9WW4rCyyEfcj3l4VhUZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVJqfVT0R-HGU_H-prqisRIlv_ddI8GIY7gDvWaTmxVA&oe=6AE9F24E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fJmakAmljUQ7kNvwEAuohK&_nc_oc=Ado7i9sc3PPUcnX_msUvdF6WuYiD7sox2uteFKPsj-dCgFCfgx_5K1T4UrRr6PvIw0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCitWBHfBzNYZvov7Rd0dErnNGtfyeyaHdhf9N_cys3w&oe=6AE9E32B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYT8CSZtfFkQ7kNvwF0g5rQ&_nc_oc=AdrH_O_tI8_pouJuiYSMOvdQdyVpfRr17xWaFVzH8uu_DkbdOcaTmx5_9zU3Qqrh8os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrxeNqS6h3dpLMWToFtIJnCU6xUUyPzR652YJX94iBXw&oe=6AEA0705"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVLEKDTarmoQ7kNvwHQVUIe&_nc_oc=Adq_RILb3tr0SW9lGwpiVfPmUbAKYnavLpsfOPLNbRccYYahln93IcaMUlIbrjCGnzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRxuM28r1CMXQH6JOeVQh_tlG4E9uZSVbs5SvjcwtSEw&oe=6AE9FF1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS5qZnNBSLEQ7kNvwEDf2Ek&_nc_oc=Adq5EHMiT_kIxwW77vV2nbpIpnDPPMW40em3NEzrEj_OVw4oDAoDsdzahFhltLKETgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcFOPc69cp9lRc9USpHqz-94-8HAkY-x4XNGBfhma-9A&oe=6AE9E694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
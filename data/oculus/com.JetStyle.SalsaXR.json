luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sllSWxDtngoQ7kNvwFi-UOX&_nc_oc=Adp5rP4QhCznuXns8LF0xwW4gxpJKU-blSTwDihsBiltlbRhLRJqpXdRLo8REqCsvTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz113nj0HVWgqPlH0K7gO9rUzhpki8KkyaxhF_TEkgyg&oe=6A68BF4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WE9TMCjxGoIQ7kNvwHakTvZ&_nc_oc=Adq2d4SrSFPhgzhTk8wLpY9kN6MA_rJq7igB2FsaJbp5W7Q9PbdVI843LpAvG_7tmXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBksegr9aymyznYQjeO3XI2CnHZbion5eHCKC24_i6beg&oe=6A68B02B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpVqoX6WYGgQ7kNvwFjd7oT&_nc_oc=Ado6iSZfFUS1SP-wUQ8yz9pEn5yxjYc8CNX4hkm-lUftQYr9uguVeENCzgeJalEnrR8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYFW8a8hRKSBbBOR5HXPprhQnQx0EgCbNnGr8OxjLjug&oe=6A689BC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSFr3BnSWUEQ7kNvwG2nptU&_nc_oc=AdpPRdnVDTukJy_FHwGrJHM2utpHB3GcFe1CawiBH6GxThxwIjk1U9-Vo0BqSYElSSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgj_xmrfDD1hAADVjCW9CclHszBSqe_s_zhJtk63B9RA&oe=6A6893DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdWdgptjG2kQ7kNvwELHLy1&_nc_oc=AdoEiUOYJwb7feWMQUrA3pT4vj6iDiUn_J1dROVgETljl0elWYABQRQ_whh5h0XP3C4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAYykgIhLwzubwFDGfgCn0_cNhrpGzzpsbseNidrhVAQ&oe=6A68B394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
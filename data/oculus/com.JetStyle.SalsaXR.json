luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUN6MJbrzssQ7kNvwGGUzQh&_nc_oc=AdpzJlPNrAJJV5BRI3YSp80igzhWBxJNTR-2viSiKH7VZKFUJGF3upGPhwExO6HYtvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M1ntLMvSREkgM9MjjrTT8r22uUhPs9hcK1_IkTHLxXQ&oe=6A2825CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVT1dmNtJp0Q7kNvwFqNV2Q&_nc_oc=AdpsC90OTO0kKrwnQwtWk7CiwLPYF92TQPqp9a-lTK6qkd7kOoJr5W_tj_KzxkJIvwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cb-mqJChWTvYDqSLxJJ9w6REVp-eUeQMsv3UJ7tfWqA&oe=6A2816AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fK1b1ucCcIQ7kNvwGQDqcA&_nc_oc=Adqa21wTqkXuq_1sPpuSum3v6pbORoLx0B4SDiu76PbwJvR14Qd_627ngvbhsOC7iaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aVV72ir2MqSeg59jpL382NAhRRIyrubbwN6nWjem6RA&oe=6A283A85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0l-OYvgA68Q7kNvwEHRq2e&_nc_oc=AdqnGDgtyko3AUeyvTayKxBauhvSu_0I5HngWI69O57ctK7Es-MLzdRQduyczBIpYTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yEMEXL7YuupTuNK4kREx8XfH64dGZgCq5MrdTnvhw0A&oe=6A28329A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFSOHeEX-yUQ7kNvwG3y_zZ&_nc_oc=AdqcIdktWvIkJNxZXKLDBp5CZFfoNcK819k__W9xl5jXBfMlUZ60SGVmp6U1XQ9w9WI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qgkcUxA3tRRrwkEv176HfS_0-cche35DhTdpmD48z1g&oe=6A281A14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
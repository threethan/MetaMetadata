34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BceCctn5reoQ7kNvwGFRyEU&_nc_oc=Adlq_CSvjyNbVnjOTMOUygAc46hQ5baQymXKqZDft46ewNInUQfFaiO0ExbX0DxqvPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu995WlC41obXP6nOfjfUF704Sr0A_EJlWCB4KnrtRr-Q&oe=69A80C0E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jow1jIQFuhsQ7kNvwFLhjg8&_nc_oc=Adm3iuQWbAmyJY0CVuUAjuCnDkeg_G3uQII6HARL7E-LrjFbcd5OWyQLIXrY6ivRf44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuuf9M3CLi1RDEL8aPeb9dHu6o3XLvyDt0YSYJLck6zSg&oe=69A8352B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBOM5R3xElAQ7kNvwEQyVh6&_nc_oc=Adn5xQYCNdnzU20apfbVwZvSl7F0OHytz_OmRSAurx_STmYuwIFjMcNwvnrKw14FhV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYxE8zTMg3gBzoOGWII5155Zy95zh5sJFH8L4oaJa-Uw&oe=69A820C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btTvuWXoDGwQ7kNvwF9QAlW&_nc_oc=AdkTnBRi6t1J08z8NMe_rzZmEphaRXQCa5pVhph15Pyw_HGiFHwOTxEc3aX2t8tz_DM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afty2Shp40rmyU5-NIOCT_fKYRe6GX7wQqBFAXwzuDfOpQ&oe=69A818DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z0PyMDOCegQ7kNvwHDsEQF&_nc_oc=AdkTMiR7r2BMWx6kU5g0NiccpCdmjBMKCpjs1H24xLHEx7ZFPRJIyDrmeTfR3QrCQow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLbqGGMGJMpkoY3eRDYSSlDMU4YSozAaay3yzBRcMxqA&oe=69A83894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx2h_pDZvpMQ7kNvwF6oS6E&_nc_oc=AdpVZ10PAETISQ_qV8QgFX3yt97qP11MCAALeVoEjU7sdIIC96o0jKCmeHH7wRIMROo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZx7mgX-mrPVAwDo26jkNzCd6c28P5NrH9FABqSXBwPA&oe=6AC7AB4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgcKK_yoMXAQ7kNvwELdBtV&_nc_oc=AdrqQYZIKQkI8BmETpHm76TT95UqZYYaT0ZuLirBsR9tCxUrrgiKOXXW4vnXR__Zo5w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaUECHQkZ4hH6SYsoZsgCcpDGcmdyzYkKkW-SdF-5F0w&oe=6AC79C2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qSBgxc5dxwQ7kNvwFqDn7M&_nc_oc=AdohZZnjoIikp9BuScFZDK3d1Z0OoK4EOBXeKve2vfSUrK4js99jm-l8Jet56It15lE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIgCQXWyqdX7TwkNNuPKLxaRFXEL2WMuqNXVQUzi27Rw&oe=6AC7C005"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1obpVZlrhwQ7kNvwEOHFyK&_nc_oc=AdqPpcSof44WEQTLF0SPRrMYkM3LUtebJVN4L03WMjXzAyNS4wfYAERkpw4vjfCKqxM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmEeQQLyYvagsf4YWIN1IMp1HKMuBxPDUyDfxcPcp-fw&oe=6AC7B81A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDJ3ftxRfVcQ7kNvwGDXTUj&_nc_oc=Adp0Jd0fOERPv7BCkcDzVHmNBEW58HoaY2R9uQTBMKJfvxSsk1OMlqql2k8AB0wZbA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2DiCoWcUZzAFDc_CscVpGN-I4QxirjwLuKaZO5NyyrA&oe=6AC79F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2vCG4oXAnAQ7kNvwEfI0YI&_nc_oc=AdovTssp8jQWj7L9xexkcXSMVM0zHF1T2_LEeshk91jCJnJ8lbwrozGfrE0pZNlRO9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK0NFbkTCcQR-QxbfP4_6DHVbhxvh4bLX3b3WKqBeVow&oe=6AAAAA4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJKF5Z-qVLQQ7kNvwFfWweK&_nc_oc=AdqwjRqWWIjpjfMUmIPqMzPXlTWQxpLcD_i1k-cLxm1wtLcbimiDhP8CisXPbJG5CDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJntV4cTKBI3CS9FKigzqe3IXzLKZqw_WatdlrYaTwBmQ&oe=6AAA9B2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oomvrZrrh88Q7kNvwH8XCSk&_nc_oc=AdoBjZu758HQ4OY87VqaRQyQ-GKMv4FJ8dugDpipDRzUBQkPk5wBp4ji9K5Msb9Z4Rk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE4TvNjeuipAqJKBs5p8z2u0cw5MdbvfzKem2G09H_fA&oe=6AAA86C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF9nBKkhbT4Q7kNvwGWjx5s&_nc_oc=AdpwDVzwLjMiq4T6qoV9mMJSo3MuPJCdVYKfsKnJTLOdcWrGGdHmUB3IaVEGZsmsEN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_4rVaUCzhJlxUqCgoXmkmPciE9LEuJdQe2fsOG5reVA&oe=6AAAB71A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl9J4_nuXHUQ7kNvwFgNtHM&_nc_oc=AdrDd9vzu4KtQR5YczqTazIO82V0-0EAvxpF2yUDXNii42eMhwMXatIDwiGaCD37Lf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVX0cxKh5MKnZlWCbCrrTbUx10rHIj-usyCJnVg8-csA&oe=6AAA9E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
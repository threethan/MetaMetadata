luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7AGBOQXgHAQ7kNvwGn2Gga&_nc_oc=Adr4E_RD1Opj1eLj0bVwr8mN78Jseemvvdpj70vC58_dzgSVEP5_4EATY-Shex6wyA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEFS6vlLQmPBIRltPACBhW9BJzeV4paXSEmZvC-khtpg&oe=69C696CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_ThufKm8T0Q7kNvwEvb_20&_nc_oc=AdqLJWzb19v7236C-29TwFcthumHZN3ERAqq3XeXUMnBWpB9fN7xxGrWOymDa4RRtcI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwseXQ0rhBPkDPSWwS_3YXXPo5EExldPG1LAITOAYHLLQ&oe=69C687AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-ENbxlNGKcQ7kNvwHESNoy&_nc_oc=AdoFN9ffqfPCeXLbXavNgQlnKT9AZYNp-70TW9j_TpO6yNNyxQPaNZ05_EaZSo8pIMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNtul2723Fns6nkBEFUibfLM3Z1j8RfWFXLpMr941uMg&oe=69C67345"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7m1oWmKLxsQ7kNvwGDS6xP&_nc_oc=Adrf-Al4IaKRmRqGd8zQbob_JK-itlA5u9k5qygNhWoDeaRrPGJ1mWc0SGESQkk0UAo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ3cj8ea_PSc7EPW5CIbS3ueFtk8rJnBeIQ12N4OTO9w&oe=69C66B5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHrTArqd5CoQ7kNvwHdH6jr&_nc_oc=Adq-SYJTG53WPnHOhkCbszU55Rab4TKrwDDARZA1Uom4b8GujykvD3yOYqWGfOh5Nlk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLO8Dy6Vb-fXgL8XfeEpbhJqISfCi_kwk2ofx3ltP3uQ&oe=69C68B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
eu8Iy_xofd8P8OFBw58gQs0lFBq0h-1lhxBa8Z-dKFhjXWLiB51G4bEbu5LNwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afstq8zxZ6ziH2eJqm0l8v1L0mo0gGdVQtcMoylOe-FC1w&oe=699C66CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPnlc-4KISYQ7kNvwHsro96&_nc_oc=AdlY_eb93PiOw9qvblT8ZrlhmQDZqFrqirBoAUegJzJymmzTfvfEZLCepbPhcSAGXok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssOOFodrbXGhOpp6yUSPidHFrbi0I4lmPs_C8IMlWA4w&oe=699C57AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-rCzCwOQw8Q7kNvwE9VJSr&_nc_oc=Adk8phVgPjN5UTVx5F7FLKVA9ddYyP3gu_gavYAtlIU3dv8D2P_oN985cQ6jpY1HG1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuBXwVecDNsRqJ381KJaydrCY4DJ_Ncqu1Ldl2YVRtyBg&oe=699C4345"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-_vzR-xjx8Q7kNvwFjs6uP&_nc_oc=AdlHzjB0ymHKQ60-3Wmo_PFovzphesjms4wy8c_9eLtqCX6jnDQTT45ZJW9Tx5DrnvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuHbeeNtqu-zKxcM8LZvjb_2V24RQ5lqYlsnDojASbTaQ&oe=699C3B5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO6-wAEDZYAQ7kNvwG88M6E&_nc_oc=AdnzQOxyE1WlcHO4rZ9F9l4do8Zw-xfSd0rvygCkDcCPYGNoaFIN9PPBtk3-giOzUwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsBJTM3AWhbgwlze5MQFQYaxMbMGP7UghaER8_ekKrynQ&oe=699C5B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
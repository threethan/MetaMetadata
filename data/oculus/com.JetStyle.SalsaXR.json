34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BceCctn5reoQ7kNvwGyu63I&_nc_oc=AdnC_m7kf7gOG3SdPYBDDPJagIJoWFFmEcewvRvXGDy6Y7ctk5d97wPk51UrSQxlL8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJGoZYuE9obKvFmeZVQsn26gyPLuqNoQIp8a1ZweBDjA&oe=69A995CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jow1jIQFuhsQ7kNvwGFAjFe&_nc_oc=AdkUplcU3oO9S_BzhacAjVbnLJ1t2YBd6uS32gHxocAQguZ4qdV_aqHZW3XDUt0J7I8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvHF4dD3olWAzV4qwLywKOlE856O7DmGdg6uT2cbzcW3Q&oe=69A986AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBOM5R3xElAQ7kNvwEdSHiQ&_nc_oc=AdmMUBD4lMZm0EF1ut5KpQ14nJLB4c_rpTlc3o29RgcOHCZUK86qk4o6aGEc0UqPhlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2rLdnG0UzO7vijHy3eq2shmimlHL_YLIe-2i_liWtAg&oe=69A97245"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mB_YMfmeP8Q7kNvwF61i7n&_nc_oc=AdnIa8t4N1dAIEW4SKt0rM4Cindq33HzyA_FCwzWA1QzDwNJh7VwlB6TWbXITQwEoaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvpJjacPlW4fXKr9HC9qTKuc0lEqPU799B2UoVpHvMiDw&oe=69A96A5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z0PyMDOCegQ7kNvwHFIWHE&_nc_oc=AdkgSKVkwCbcBIUT5Ud4o6GC3fvvWnNBkgPN4yI3p_1Z4_scQ1RmkRde5BN5DLu4VG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiqGWAijVodn-1pzQBPhhe8gRJTPZnoh_x9JV93nlZ7w&oe=69A98A14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
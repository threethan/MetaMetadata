Ca1Ie7b9LxZ7uQFjQ48xk_FLyqkilKDS-5Q8nlz93vAaQFeR3lC5LsqKQymfHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoZBYOXGrPNDUC1lOX5HCZrf1X9YVOoCswFoLOLdZOYw&oe=69A05B4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouOKhy-i8vsQ7kNvwHfDn5k&_nc_oc=AdnJvmgfUZbe52WcgzVDOZSocV7459qLUpyLgAyanQX1mWK9TC22_wKvZepU4uZNd70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfAVhPx2GZPF_QngMbBNSqrYeGyZoiEykPbZ5KsWOgFw&oe=69A04C2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKx0Ywj1LlQQ7kNvwEruLzB&_nc_oc=AdnDvP4shtbNNVnQiZ_9ASO7gfRI4jtklQ0IVI5K2IY6XtbKmQBUA9srY7PFI0pmYLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIGU4P1i3U3SqOgVKPpGPatbja9zFefM4kEpbUKTslOA&oe=69A037C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDOW81BiM9oQ7kNvwHZuHej&_nc_oc=AdkS64vhlsWu8vxXBLugErriX5tOmwWnqXmnESRv37uBIeIjVb8v1-t2NBzMv5jL4f4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftT5ZZl0GXjYV0cCPa9ZD6KGc2RCjUhP2UThJ1N9tWglA&oe=69A02FDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWu3dtOYn0wQ7kNvwEZ5Cdv&_nc_oc=AdmlIZhO_stzLjRQy3TgPf-ANg5qMDzIloMhpEklW3PgVx44zKwdUMUQ5ce1BRKW2a0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7bf_Gv-qzaI8ouHLGtdeI6PxWlCypYTHZOfE83v4Psg&oe=69A04F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
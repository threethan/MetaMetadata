34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b48-K0u-TtMQ7kNvwER7uN4&_nc_oc=Adm0VvUQIVHUvthMNE30GI2DS3AaJb11LgvrqwKO8Hl9dqZt3aC1E45rAvOs1eqwY-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkyCfhqFNMRianV-p7dazjMyA3UzNT_hegNsJHWGa7Vg&oe=69AFF50E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8O9L21NNLMQ7kNvwEaZ7vY&_nc_oc=AdnqalIEwipc6AQ6jSu4_s9wpwHatqLhritaCMtEYEMVEHj3wgWAnWcTY33M1s4U1ro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-UVh0P3kTkTznZfdo3QFS8oZC5MNyp9yUFYr-D0-w4w&oe=69B01E2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BkPF18L0OEQ7kNvwFzw_ZV&_nc_oc=AdlXOIb9jHYoogb5opdSowHGaSAjYgMgfYlovU64eIJEY_3C9LXbcTxyRFXzGDyjiTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU3odmUESUDxfaXKKqDjoeSxVtrx3AWOR_W71UEYCafg&oe=69B009C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kydidWalgkcQ7kNvwGsZmUy&_nc_oc=Adn6d3IQErCNST9eJpIrGxQuHWNmIGftphwmKXNECvQNqxiz0B-OAdsZbvplJ3g8vFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOdoPeMKJgFdqngHmbmcqY6Pvp90CqDQLQQXhRgvMCjQ&oe=69B001DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gxCclVA4aMQ7kNvwF-zNbf&_nc_oc=Adn1zDBFslH3XY8dDZcY54JuFshz1HgC5smWsn_luhs9IV-Y3va86-mjM6HoYTHvCC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4zEuGRDA0cRVivJLBwhT5aHJw7K61ZxdRWx_ocV7rBQ&oe=69B02194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
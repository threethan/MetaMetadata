luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jd1_I1Zb38Q7kNvwG6H4k5&_nc_oc=AdqCVxuAoSTKH7e0HvsylUHdnN7PWMDe5LmoRwtD9Y0eyXIT_NZemEmiVO0FpnzGWv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl5zlhl_UjGfCxNViqmgVZ93-mQMCcIy4Qq0B1FlMAzw&oe=6ACCF14E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMYCrWjTm5gQ7kNvwFiRXuD&_nc_oc=Adq-FfI-azmDsmu5EZdN7sgIhEz79EwsylcpJBqcLBGvhHLeGNEhCngs7hzE7GV8FZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjMwTDHvNhduzeYdqHOW5_r1WUMXmA6w0kqI1kXxOZKQ&oe=6ACCE22B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV5Av_T0JbUQ7kNvwH_oz_C&_nc_oc=AdoqJwNXf_W7dHampay9dIjB1pwEBJEnbOFhd8AGVaS5y4oaAuv5YI3Ttbb2nRd2IMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl95XIxTBF5nUcIJTms0Bjf7z0wBWbFHnr-VXqzHNHfw&oe=6ACD0605"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NLuoQtn6m4Q7kNvwEGfa57&_nc_oc=AdqUwVQBIkKiDzko1Iv-sx2xxnEixvv72omK_s5UPV23yLu4UvQ9algHjCh2D43ZEao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3rMavf6SXPYa7OHnoWgIC1Yw_TtHwLPlaYi4kaqYyYg&oe=6ACCFE1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0fil3-m61QQ7kNvwHNNsXm&_nc_oc=AdohRxszP1DNMcXtsjsChWSNab0Ir8pgLzqG2DamgXUtnkT8Z1loz47iQ783ZOBMuFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcytkBbart6aj1K61bKJc7imCRPmJhIfXUjwM7NFoP_A&oe=6ACCE594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
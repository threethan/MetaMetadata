luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHVWNW7oIPcQ7kNvwEuhbIg&_nc_oc=Ado6oxGJ1B3fEhDWsrBUuEJ5qNLTkRj_LrxWmoNjQWOyixmAA2083ALJimgyN5yIJJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54cETcEWCfeitkrkSCcuD1h5ggdgF4txkWPfYbaU2bwQ&oe=69FB52CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EHurTM4SOIQ7kNvwHvbN1n&_nc_oc=Adr0ms_VfC5dVvj9zcEYZ8pbCreW7a-0ttdgFlVrKuT293xc_gnASRD_kUnYBBIalOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XtNlInsKcpcz62GUTfXVQW5MgxhamlGaXgQroKj_eDw&oe=69FB43AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9HAXC3-_WoQ7kNvwHBWWJW&_nc_oc=Adp2rppE7N_o9eqz7ifrAXmmFA1NFIMqURrVJ3ZGWim_XtzAVYds3F_UYkFM5VtK-_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GGWIsBT53eoxxW3jtgwHrFQBfcGgxtrVa3fc-UQ8PNw&oe=69FB2F45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyvjJa0PbUUQ7kNvwGd8imQ&_nc_oc=AdrVoFPZqpVUy-xwlaaxFOvoLg2rr6s2YPMsyDuLEFSxJIc_rqR7V8Q9YRllUbf5FOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40SbWUnnYCS5jiKtRrLa6YllGMXTMr9TyzPqkyA4g-EQ&oe=69FB275A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkf35kSx46AQ7kNvwEwvOgX&_nc_oc=AdqlC_x9I3VSTpvl2S073OmlhwwfjN0pcnemaroFy7tL1oMaq7rQedEpXc1WdM8G-Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ctu1Vc6VSMCGQU7TYfBNtQhCwYm8sBeOOT1E6Y8lD4g&oe=69FB4714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
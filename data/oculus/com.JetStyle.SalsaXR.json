luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SGLzHKuKV8Q7kNvwHiDVWQ&_nc_oc=Adp_RObJRaxAjN4nOCVzOKZrhPHk77nLA1sT-jiFSDxyzQh03RoaXAeLBGM_mioWNv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBPgK0E4MY-I453_maAJXDgHofCNzJccgn-pcPmp8zPw&oe=6AB92ACE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFhyiLC7hIIQ7kNvwE-oO9S&_nc_oc=Adq5CSWcdER5BVNHrZnd-w8Pk1g7nouyruLHqmU9ykchNpR4H4U6upWkDy_ROAfsHPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd91xdTuhkw6RfRhcw_3YuPDdMJ4BjpSfuWOE-arsqRQ&oe=6AB91BAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIHsYuhQjhMQ7kNvwG7W6i0&_nc_oc=Ado494_W6UB8LUQr6A4oNt1xoU8VKyuuIopaChkaJ3TANahRqP9tH2qUgMcBVP7iCWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3lBgs7UKK_ZKs-9jqfmjI6Mjg2Vg-gIpCN0XuMQighQ&oe=6AB93F85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78l9v1UbBykQ7kNvwHdPk80&_nc_oc=AdrcRkU1ywChLfIGq5Hk5UxL2sqf5mLz_QX1dpdI0FueyrttH2NLxi-p6wPXCZRu22A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0KbijF3miReC2dX6JhwGhdOPZu-fRPjxnS44t0DC4Mw&oe=6AB9379A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGrPiLwGK8IQ7kNvwGo_2Lo&_nc_oc=AdpGTWzIN49Xv3qLtb22IdzTc4bsP96xN_WVbKUkoG_uQcaJ1Oxvc8CvY_-2AKhXAfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6iLmVgcqq_I1bjQ5pkI8Z92NXPdwcuYInUZmtr_XCag&oe=6AB91F14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
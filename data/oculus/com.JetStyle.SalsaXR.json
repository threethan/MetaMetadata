n2-1.oculuscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2vCG4oXAnAQ7kNvwGX_O8u&_nc_oc=AdoWFpHNWcmryjaa4A1NLhLdPMF72ElacmE3HwMTXWLwYExj50nclTKRyGHRVBpRH7s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH64nV7xE19e-mt4lf9lBVy3tOs1Dmyw0p01jx3F0jig&oe=6AA958CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJKF5Z-qVLQQ7kNvwF86dpp&_nc_oc=Adot1SAGlvk1TaSDkYl54_srVOnl_0L9_0yiECltxetbBl7uXuxNrE1KSVV5r1TKBhA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTs6OLLwZVAw-M_J79a3lrVPTkA3vfzenYc-iJREf2ZA&oe=6AA949AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oomvrZrrh88Q7kNvwHNEszW&_nc_oc=AdrZOmg0XBw1VEzy4ocCnxpnsg2oPXMXoMk-IeuLpN30yYrswkD3mCkfBOs3E8XrKsE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrFg1SoHwwmrSAWW7WNLAMo-XhrCA6qOXvO57yjheG3A&oe=6AA93545"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF9nBKkhbT4Q7kNvwFn3KWN&_nc_oc=AdomtaFztYdi3Ecy-gKr_4hEtpXj4ihPR4gFSIgrSpXbk1eiI7x5tbSkM5Me3ri5OKs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqOLhRFxfwhuzJ6RljiJfMq8bacSKf6nPfVVv-MVVTog&oe=6AA9659A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl9J4_nuXHUQ7kNvwH0U0Zw&_nc_oc=AdoL5ofC-p0GrF3PaYsCDR0jJlxnWxycxnm6y-qt9sj9omKJL2FYGdhM0FFqbesEiOE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0wpujLHiddCy17iyBt2bB_HhM3d4HdW6vZzLtYIMu_Q&oe=6AA94D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres"
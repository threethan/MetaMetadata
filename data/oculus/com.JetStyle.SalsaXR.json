luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZevTNMQEasQ7kNvwGq3AnY&_nc_oc=AdqlkPPD236ONggUCiVe9D4eSSidT54b2n9QcYDR6JE08VHUpHxp51RNTYizYOZHKHw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zSQMqkFgJ_xr_WCnJbxvsqbxfJtJ3Q00i-LhK5Com3Q&oe=69E2464E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8_Y8x3aKyEQ7kNvwGE2g_f&_nc_oc=Adpyrc4P6_Svv7d1a2_YCYvb1sKY3OEbyIXK1ZNDf6ysxtTWeI5ejeTc2RLqJ6zTJs0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FY2JGLbtPpi7317M4274FCp5abBu1iWYpV9T0SmSgSg&oe=69E2372B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k62Olb-zpfwQ7kNvwHDm7iE&_nc_oc=Adq72gT0t-hJCXPnWgscWTS7zHvkxAFW7Qrz9u7hBBi4AvLtyE3MgiFboodYLUAfQAA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rNs4FRlCYD0haLC_DgqqLXYeNgCmgRye91p7_oriCCQ&oe=69E222C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkGh7lavaFYQ7kNvwHRrr9n&_nc_oc=AdrzrbpsCw3Tj3b0A-bEg61df-ribytpNkcKxvn4_1noWJBwY8RKOrDNag9vESatos0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C208GkN3-wLUQyncB8AyWStZmXOHoYtvWicCEFbhmTA&oe=69E21ADA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25o8LHG753MQ7kNvwE7jmPP&_nc_oc=AdpqBTn4IDBE_aVyGNRwBKn6qmqOXobuv8I-p85Hh9jK197NUNXgNccHwNUXscAVPU8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3taL97Jg2HoCOG08_Y8rRfAwJz5zviE-phd4YNuISh7A&oe=69E23A94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
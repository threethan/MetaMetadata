luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfETduvHhq8Q7kNvwG6nDAt&_nc_oc=Adpcw6visChnI08z_0GtTTGZIhsZGO_cjYHzhta8EPrB_4jTqQqo90aWSlrAL5PjV7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k2Eeez_eDy7L1svo3-fjtkpVmYmB-RcEVotJ4iQQZ0g&oe=69DD004E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUWcHox2SAwQ7kNvwF4G9xz&_nc_oc=AdrWvQI3HjQURwQUG3EWfsFRAVnzSHMaBZqbf5V_XE3Cy1cB7ivMlHsjdBfZN9lHis4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CuoYTraXNikUsMF9jUWo1BthKmqaealPBUMkPoQOMHg&oe=69DCF12B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCo6uVPy2NIQ7kNvwGcg7eZ&_nc_oc=Ado9ZeRFdNeHwoGiVb72c5NRVQO7-9Rv2O02lo5fQRYbsRis8Gvp0nouVvpeCddqD2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rm3RKV9JfdDe4jKTV2bUhTqshxTAUOMn1nIiFcBnMXA&oe=69DCDCC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMz5BSk-Eu0Q7kNvwF_JQdT&_nc_oc=AdoYOV-kiqOpZ0bKaPXbhXbsNB6C7-JOGbWVn__0A4-ZJjHdbzgrXgC-Vjd4TUlGKpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Yuf7vOmgRS6oA5bRMbDpb_76VL7CNhyXGpe0oEETTgg&oe=69DCD4DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lBHv_PgS5sQ7kNvwHMer2z&_nc_oc=AdppI8NDFKEga5t-QYNJIDX6sWWOjD6Ea-crMUZEhZqjvMz-94XQMlFqpOpQHdii6WY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38cyAEWMRoHtyvQCdz-EZNG0v7hFZcYeApEuU1E8rsWw&oe=69DCF494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
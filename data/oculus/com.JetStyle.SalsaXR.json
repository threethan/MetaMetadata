luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7AGBOQXgHAQ7kNvwH-ioa4&_nc_oc=AdrT9APKj-2JE7WWLV3A6J6nn5pm4_GSK2PilQz-tSwJPzyv83JE7MPEcWO6pVimqNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1lDhCoNHyZgKH91hJyOgzy3LRIN7fRtjhe9EjkTT1Dw&oe=69C5454E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_ThufKm8T0Q7kNvwHnWUMn&_nc_oc=AdqeM2VQIll3tOusv8-eQugDkTMP61xb-nSuDjXukVe5KEkRRfa6ZPQvSlZdCol5GMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzi_JoeRHXTNE7j1TJI4CmyjbY8lKChQS7GPE_wUFWLHw&oe=69C5362B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-y2-CkNKcQ7kNvwFSNVDb&_nc_oc=AdqNIqJhyax0Mlt3LSs8N97gZGme-fXJesPtLBBSW0we7zdLbazKD-OMCzyxf8son_A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT3njqtbRrq0sCtwQbLV24zI4RlhPEhxRDBtjo9_ARKA&oe=69C521C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7m1oWmKLxsQ7kNvwHQxMoe&_nc_oc=Adr7pGN_Ot1C4pNA2IxY3AwZsZVJbeEFhu72mcIUdpDpBbtgArbFXhJVb2EfZv-T8Qw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0VYK5M6l9olBMzeWAboq6kGvoVU1t_-0uulGVSjxCXg&oe=69C519DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BzDL_sf4c4Q7kNvwE4E_SO&_nc_oc=Ado3eg40JKG5ywTMvxuJT54j2UHAba1N1WonwmxuHoougbLlghH7Pa1e_ksoTEOCdyg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWagIehuNrxILwe6QKIlCmhJWd4hmdrSy0oq-I4NFt8A&oe=69C53994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
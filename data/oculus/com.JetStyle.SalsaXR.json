luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEMTRVIfE4YQ7kNvwExWsM8&_nc_oc=Adqmm2ho6eKPd6Rc_PiWNN2LfDI-1lCWs_MwyOOODvSpA5UFyMsM9TgmH2ZdI_hFJcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgBqk-s3FPkQpcOR543dZSy3qaA2Hnkwx1NQ7QZo8bbA&oe=6ABFC24E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axDKvbuOu0cQ7kNvwENxpKi&_nc_oc=AdoexiEFclfqhfkyXeRjV9jMlRNrzUhGJPMMqx4Sm1E_TtHyboTdESuNw72T15260ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbwXuoD_qHHFr6tOrGoNhYqOv5nHcoKoIwf3ftKoVXGA&oe=6ABFB32B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD8hRLYYYSYQ7kNvwGzdqCC&_nc_oc=AdqFU5VetBFiLlhT_9klariWsowc7eqZjKXpKT-nyG8O3OrMe7ERZNB1vgE1l-3liII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVAV6nX_l5LGB8dtYvw_St-S9lzmJoXvvhR223UVIV9Q&oe=6ABFD705"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Q-fPwef0gQ7kNvwER7KlB&_nc_oc=Adq4AyOlZ7X7mh2UqG3mOd46Q1Ebu1kAVM2IkOFZyuo5Fn3FE-iu816mR7RThqIyGIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-apsfG1Ux2ZmrV_8KnKDlHPdf7Y7tG0vLq8sWaZ09oA&oe=6ABFCF1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lfEvj6LWIwQ7kNvwEj9_xM&_nc_oc=AdqeDZReqlb9-P-8Ej3F7POgF14QwvaMQy-uGthoIwX_BxJG71sY4oMw4Ml2EQL6_Fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNgCBGu85WM5baL55VZUPcbzbs_DWJjTqCvpcbbCQ5Jw&oe=6ABFB694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
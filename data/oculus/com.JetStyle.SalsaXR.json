luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njHdzy42jEMQ7kNvwF-8vdp&_nc_oc=AdqSPujobRUDuBgL1Q2Fii1-aQAoUtxaEzCnnPAMlUFXiS2Pcpb0PurB3c9Ji5gFsgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Rdn3fAwWnDOzCCY8GUOgV4_X-xMxZCM-hI0scthSbA&oe=6A897C8E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84LNRer7dhoQ7kNvwFIYi23&_nc_oc=Adp3pvH9LI-hDy5MgiX4q1BZNbp5CQB7NgckoPeiVIKkZaXQUK6ZnaqHLUZwpPwGv5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFxHdkdfA-xgArljOGnds22RQg1R02rwda05AwCw8ksw&oe=6A896D6B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvVlZmxlhqwQ7kNvwHaUcHU&_nc_oc=Adr1-wfZJgOnCs_ezAu74UyJ3ZDKn5q1mJsux_7TElnYOfiHdywHg6zu1O5qtt416NA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV9QI7IipjO2jJaEvXIrx0r0IuTjO565x1XJASSoY_7g&oe=6A899145"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0qalapUW-sQ7kNvwEexENT&_nc_oc=Adp56BAQDbB06xaBRUTRbKcmwdbIgMNqjyX05jd-88QyTvRcxV8SaT0DmhTar4Q3rGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8CBeGIxPPRgwydw0VfyiDBHwl_nIK0WvRHivQakWXag&oe=6A89895A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gV4K27M-hAQ7kNvwEFCU01&_nc_oc=AdqIGvg5Q_AIyOiN_DuZisDuy5aiqBDbP2puHAjcCBCrgxgX9LYhSELdKQHeAEpMEvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnjx7H0q0-nNC8QCUlK5tA6dlLKBXSftiE5KuC7gSSEg&oe=6A8970D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
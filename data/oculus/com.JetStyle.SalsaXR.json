luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v3hgJ75Lh8Q7kNvwGzjHe4&_nc_oc=AdqvUwvkKxRrO0fIZQvHgBwMSSGK3153kimV99TMPKa0P1H_1LTfANOLZtdpVX-pvJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfqBH6SvjZLiqiQgvOXT4XmdU5Q4ndftUAYC0fx7jfRw&oe=6AA2C14E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq85Ao8C_2MQ7kNvwGuCacw&_nc_oc=AdrxvmNoKW8fnQitTH4l83trysdVeqLy6L3gIsuWrqpylGAYaZKsFMS188rhf2-BcLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSo15-kENM4AiBEoOYkY3UiUWEcyyvZXanHxGvvU0zyA&oe=6AA2B22B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19r2I_gcP-8Q7kNvwEwNGXh&_nc_oc=AdpKXEztmMPOS_n9mNj3PgKyIcn0uLYWy9ngW2uLQGZv6l_qqvlAmHAdVMFtmCQPkJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXNazzht48Nq8CBXl1qx-SslEzn6kNP4moYNJPHVvjIg&oe=6AA29DC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLLGFtflk_sQ7kNvwFcF_dM&_nc_oc=AdrHQB8E4nOeLF1uezvcp0LbxTbnYwUrtg1GMPO9zJ4n63jYt0n_1KIl_vsV-QXWs6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOJhMQsLO9EyrJTRBkkVz2ddoPF52qg8IMGgvXcuvOvg&oe=6AA2CE1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuGTcygBZiEQ7kNvwFopDHM&_nc_oc=AdpcpqWPBvyno3RDX7EePd3aIsIv5Wm7PAK3LMABRduCu-EbrLEyAioObZnfTw2nl0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1uYT9goCAqgDCI6DV2KiI7thk_j3H0eUJAQvKQItzbQ&oe=6AA2B594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGd2pFB03bgQ7kNvwG8CIUX&_nc_oc=Ado0H0u5iNcsAl_uShxXgHx5h9eWMkOeMRN1559xf7ZLsuox-PImJJd1Qjxl5t92JCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRaOefXp5cHaAM_LUdHEFb34gHvVPNanSWfGtNpx6T9g&oe=6A80420E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx-Qz1jyKwQQ7kNvwFS7wSR&_nc_oc=Adph-9dEipwtiRsSdKRGrmsEkW6ehZ5DfgDvEZHRTUIrZVS9vL7UJMFQr6vSQiIZ2qc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsVNUksTBUNfiH2SfPnWGekUzL1_G63ZcTFJpJsNAWng&oe=6A806B2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKeCAPyqzSwQ7kNvwFVzT36&_nc_oc=AdpaojmotIaY3lnq1GhBqDn1W5zag6m5tOzorYM-SZWB5c2ofZhfCjIjUdhr1pHJIfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaDaBU9lr5guX2dttORgwvO4vyVLX9aZs5zorMAsRyog&oe=6A8056C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3lbgPUJlk0Q7kNvwHPKN7k&_nc_oc=AdrWJAEVsA0s-0ypHaDGfCyLz5GgxLX4bfdqX5Kg-cM305tttAq8GaehKcnfevHhiNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbEYbciKKl-F1MN_AY8h6V9ps_UmhfOSbvz--gTC9QNA&oe=6A804EDA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDg37bf-0PEQ7kNvwGuHjwg&_nc_oc=AdrXHmJnNe7vOZdH9U87gDxSbfR9Jd69m_Csy32sZD2N30KaYYD36mPjhXaQkbONRt8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2TP-bNJbR852XfBzAoH11dHp-CtDwjFFfhBV5SZQ1Jg&oe=6A806E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
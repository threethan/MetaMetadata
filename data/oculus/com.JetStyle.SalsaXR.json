luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx2h_pDZvpMQ7kNvwERvpMn&_nc_oc=Ado1-HI7Wcs3xKuhIpORJzMtjnOJpwpVVgWKqqWehVwgqXbwibA9uDJmg0hAJOk7nd4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjdhspi2y92BP0xElBmZ6iYNGYP0YdJY2IXgLOpLgFqQ&oe=6AC5084E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQPLkcMbOy4Q7kNvwES3rsp&_nc_oc=AdpcXgFu3EZfJ_soXq0UrLx70R9rrJFSMfbEic9M-6luL2PUAl_PzhQgcBU3x4VI_1A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVyQv5MP5kLA2hc1BReTXDYCX8AJzyqkWXHonXh4K4VQ&oe=6AC4F92B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjYqgDes0S0Q7kNvwGeBS0p&_nc_oc=AdoaRWvpvZYilLclcNu0ZkZtVDiRniTZTjrdlClKA0r6Y4XBfeKFan52ceRPm9sXdiI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFm5esrEsB9HBytom-1qF9-vpQ8-cooW42J_bT0WZObg&oe=6AC51D05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1obpVZlrhwQ7kNvwFtGxKg&_nc_oc=Adr2_batlFu91vAKdAGi7HxMrjnI6dE20iUkxwgTD6jmQfzNb_s1lal4GcPBmLBA8zg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdjy_C0PqjxiJWssdXy2rIoXzAvfPNThevUCVwbGaUfg&oe=6AC5151A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl4M0_8ldpMQ7kNvwEqTWuz&_nc_oc=AdpjJyPfbJrN9VrRjysPqG4Qbk4LcmulaN_3n2Q9NjmIi2SGUTf0M5qMGVLh9s_tgFc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzVhC4KRtNXSvFKkMlNpcests3c2-wCu5uthQtw7BTJQ&oe=6AC4FC94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
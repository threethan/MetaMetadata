luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqVYEylywicQ7kNvwFwIgYZ&_nc_oc=AdrMWG_vPa6T_OEqFBjk9JrhuKs7DrvFFLvaofYeBXDnUjRnUP-g4M3qcZm5rz0A7fQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01rN-C7MBpaXY0WfqzQ7wFAGKpzRRR-FrztbCpAiuwow&oe=69D668CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswoNLR2tnUQ7kNvwEd9CAr&_nc_oc=AdrZXm81FudZi0zTNfXnDcSVjgYLIi2xZcRFJHjRaC6mnILBIbJWqvaHsKRhWz_d8bY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28lL4MaO_C3eMZ-_qNPYkF6IgjeFIBizhZ-0NtfOXMJg&oe=69D659AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqs0Z1CMSAYQ7kNvwFjnDVg&_nc_oc=AdrZlr01-4NAxBXy96MsGsyo9i7_LgeBODYW1yX3j7TRneE57yt9zawrwq-XLSpswmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KNI_YglO_lA78fw4yPY_bF1WEe4bvHZtgyQu0B5jPCw&oe=69D64545"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDF8CQUpTiAQ7kNvwGHAMc_&_nc_oc=AdrzGocoQXaqKsG7GeNU3Zg0kUKd6kQvLLlPsMB0WqRLGae3P-6PPWKVgD75mGWeDGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e-deUUqtZXmJnhcmhIjRncS-1pFNQYSWyGGID0IvM9w&oe=69D63D5A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32yWW7xLf34Q7kNvwF4HWoa&_nc_oc=AdrlU-qesHFvsG-G6H-RTk_hQc5VwjrOu9WcWMj3deNaEmt-m1dGdxOFDjQ-SYNXOwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KMoGGh2nyTuA9J7JLnVulPuQD0Nx6VuKqt6xRJ44DNA&oe=69D65D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
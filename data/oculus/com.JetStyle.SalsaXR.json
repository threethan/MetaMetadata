luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfETduvHhq8Q7kNvwGvO0v4&_nc_oc=AdpbNnJIIAATfDGp9NpSyf-4OAj2Sm_OO62ashXosZm3iuvG_YSm86NJByvEu2-kgPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_RsfQmmdjLeNUkAnkFb_UijRG7jJO8vZx4dJaAepYhQ&oe=69DBAECE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUWcHox2SAwQ7kNvwGbzccI&_nc_oc=Adrov_goakDlZBqXrz5kFJ8bRSMsrxlhAw80zt22Gyy2BitEwfH9UT3O9FHfQqb49CQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af127aTnyqJHRGtQi0dEj8w21KzNOglP8jPeA3KqOWjb5A&oe=69DB9FAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCo6uVPy2NIQ7kNvwEV9UyB&_nc_oc=AdqveB1wE34QRoFCb44pHr5lJxh7wBJoFxyJFlRnI4HBLIIiPb-VB2JO5k8rYR4XlL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XHDmzGfLVYjNxTd4wKkYKhsz3qNmN5OaAIGcVQi8MwA&oe=69DB8B45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjZn57dt6GMQ7kNvwEk_GNU&_nc_oc=Adr0NdFn6wtO2EnD6c0nm-o0-2F8t7Xk2GlgG3B7tw_xouNxb3aM4uFyGK7e2BWp-Pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hfEl9tGqZvBCbrQvR7jdw7V2CrNcpbQG1pIo4Cmx8JQ&oe=69DB835A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lBHv_PgS5sQ7kNvwERWngK&_nc_oc=AdouiP1q0qemjQjBKSwxPe8AIjcHJuwa4On4uCUKWiGIZ9cjmxNrs1O6RwkDIuq40pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OWv3yCNuiSwIPZ-Pkd9vA32QcaQr9_gAAhDtBWUftug&oe=69DBA314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmXcuHx3wNMQ7kNvwHLitUk&_nc_oc=Adr6_tfIEy_5ZFrwEp0HDrIWFsU5cN0QyVUJr9vZr0v8eyshPtSUKq_5v3LFsmjbtlM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GGuxTbZCLa5GwzZQBXGiTbT21xZKs17ayBBQS3lc_Yw&oe=6A2C1A4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNJZmfeJnTgQ7kNvwGdGgpF&_nc_oc=AdocFxYafqRY0V_maGCPz7OZyopR6qY38zhmRlcSrj1guq2iTzjw8De1rka63_x6QyQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cxP2JK2UrDlrmwVPgCCP06IK6QOJoLwAKO_Y9RLplRw&oe=6A2C0B2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_IvJJegkxoQ7kNvwEh8CWb&_nc_oc=Adp_4uPGBB9cwEkSpc3BAQ-sTtFRzvTVRnJLIg6VhFMbimdJOsOrZtHwycgZogzKvK0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_PQNi68hNx7rOq5HC-5ZqI9psssIc1ZO4PTDAZHMjpQ&oe=6A2C2F05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9fF1jXMqDIQ7kNvwFl7uLw&_nc_oc=AdrnecilHx3YRRPH3F9R48SyED_AaJPP4JPsHkCK67474Vh4iJUcI9zOQugSisudpJg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OyAvzrwH9MJmak3ePDYX7_RMatXm5TXYr57CiC-IC7g&oe=6A2C271A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH26tNGIM1MQ7kNvwHcYiUh&_nc_oc=Adp5z_oLS8FWo87IriQ469XyY8SHdE3fvXBahfCAoxqRaN5FNg5KvOuzihWMmDFcxDo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WXOwWuwU9QpbA9YJ7dsS-9OwbRlO3eh-CT20ctzySLA&oe=6A2C0E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
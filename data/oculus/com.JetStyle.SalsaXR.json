luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_HKMKY9dLkQ7kNvwGMB1Rw&_nc_oc=AdoSbPj_OIDfThvDR7aC_cMhh8m41opEswrz3an35ySd9lT9jc2BxfbOSKohJyXjKsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmj74bAUSE5YhpPYGqZBytfLAahBHMyheYE7A4tn3qNA&oe=6AF32CCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmWSd26ig7MQ7kNvwHgoOW9&_nc_oc=Adq6WBqF_ai6eBjf9S6SoVuvi4J-oUFv9lGTSWqcsNXvhlUwi1Gux-tqcgzkGDCXBSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxV-di2H0lCdlgo66ZfLPBqc_aGhvi4n0Uc5W7uY8MMA&oe=6AF355EB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q6a-oABLSQQ7kNvwGkgaOL&_nc_oc=Ado7nCA8ydzuiAhe-Sewhv2Vwkg2o_myoe1T0lZohd9NxDNhv-O-cEo3VwwHVefBvKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTilk2EcqAmZuOh2rhV_6AZbe3RyqBw4rFBiWDFHZyckQ&oe=6AF34185"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxqjaJEmK14Q7kNvwHc1tpC&_nc_oc=AdojgPlyCAsU5qmlsW7FMZirf2UwdFe64YKMA3g0VvlaQBpZE4DU_JdvO8lGm8PcE5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnexl8ZXuJxn8_69UXmkm64GW73KD9KBWsFwTHqsFc1Q&oe=6AF3399A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWJOHo22f4Q7kNvwH1SsHy&_nc_oc=Adrs3_fMAfGVAtm5Dcj3Jhy-yuuGfNRskZ9Osaphgw70-abri47VYM8qo1Pp2qIfP9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt250WqWNYrH5dfSIoAFGt-pIX7Y1KhAob4LFGu1m8bA&oe=6AF35954"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
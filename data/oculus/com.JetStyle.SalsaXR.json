34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b48-K0u-TtMQ7kNvwEbC_1D&_nc_oc=AdncmJbSl4p02KWi0g-XMdYTC-9NwIwxUwJ9lORGEIhZYPDHbggH6o8mbEQfRxghOls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeW_vwd8OLqXJqOLvy9Omf5brLkY8i6gigFZzKWJY8aQ&oe=69B2980E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8O9L21NNLMQ7kNvwEKZl7p&_nc_oc=AdmDYIJlk3W_gEyIZOWz5108lRDvgjHh9j-PF9lQx_1lISjXTBpkORTCVsghJ5SLmzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTd1rsAdU1_2J2BppradoWLq1pvBGtfwk9nhoBIoXGiQ&oe=69B2C12B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHqSH8PIysYQ7kNvwHFRZ6n&_nc_oc=AdkOGGn9Ty-P7H6yxWDBzWNHSPi2xTK5njjjdMzEP37Ow9XXQoL_Brd-wh8H4qoZDYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwe29WkBJ4mh9lEu21KVAwW5lsARNEWl-0Yw84qv48TCA&oe=69B2ACC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfY6ov00YKUQ7kNvwEpPdf4&_nc_oc=AdmFmTn4H6AWAvMTtIrRsPoYp4huELs8uxFyzkWcMOcNxb5Z1xkkR_P92FasHJx3aLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj2cw5j_EbvOPTOTsfWP-t7EaiwRFajkjN-ZEA_3BaIw&oe=69B2A4DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq3pmhPZY58Q7kNvwGscVkO&_nc_oc=AdkMDieSAx1Z3qrhN1_BAvZfyWRzNpQJuq4BYsdRCrK5BmQhmRxC5g78nR8w0k0L1Zk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVkG1a4aHW0Vfkas1d-TBmuFHoc8zGZ7oCsYLJO7bVTA&oe=69B2C494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
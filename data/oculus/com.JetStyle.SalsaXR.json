luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IkWHoKJgf4Q7kNvwEM88o6&_nc_oc=AdpWuHqfmDONzUbEtp7AjtR3HZKF8nL4G0bQkbpyvgn9MNdmJvA8MjJDBT-8CcIU6JI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cOsJJ75LIJVsC8qbPArbX-R7YAitb-W2FRo5uRpAzXg&oe=69EE23CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g11ogkiPUcQ7kNvwExg6I3&_nc_oc=AdohP-AHP-LHLvU87j3mjOo8J4OYuCbNpmKlo0FCadFrMrzSBhx3-kqFHzoGmQsGI68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xEoRgj0eH1mR9brxC9xiFfc9AXXIUmuZbcoOvUUc28g&oe=69EE14AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX5iT7s3ZHcQ7kNvwEAbLj0&_nc_oc=AdpDLaCYNu5qWtJabsMTwNh2sE7uI-W7KhWJTWe0FPCUQEHRL9FTEEy9cLUZyiZ_EVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MDJ6s71b-NgL1YJhvX_mObw1EdpRW-4tC16oSm5D5Fw&oe=69EE0045"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIyyWVZMr-cQ7kNvwErqMkB&_nc_oc=AdpB2EXX75SKUmKn1wGwl1fwoM3g3Jl4zg3BZ9MfxEWIuP77EH5-ussIAf7jcWwyc8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cqx-s4Y-e1SRxVI8CHKpytg2l-sRBP7Oue--yEGsFwA&oe=69EDF85A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP5B7AwcixsQ7kNvwHIKK8Z&_nc_oc=Adph_aubSvgyFA6jrNjSDnE9rKXXs__IhlplVqyfyNUADi9LzsXjjBEtP9DcQHx9cWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yi8VE0PkgMtY-4u0l1qdt_-u8fBQd-YYd2NVvmu1eQg&oe=69EE1814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
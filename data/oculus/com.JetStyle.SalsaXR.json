luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7AGBOQXgHAQ7kNvwHcT_El&_nc_oc=Adq6tDvlq_UH50vOS0S4u7jq0FHG3j_9P7HuVQpIjbjpaJiHbIaVkAdayBrW1PY_ltY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIwjlojShkxHH9nxHwwmOo4_IB6LsPr1hyGHivcnu05g&oe=69C3F3CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_ThufKm8T0Q7kNvwGJRAt4&_nc_oc=AdrpAJia6Fbq4nKxnpkKQtJdsTQzwYlhY6-6Su8wTREwTnlg2MRZEZHemO6DxUAPBlg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXqWx4qCHGqadtIfiNS51wCVDwCs6a8iUg3HIhRs2nlQ&oe=69C3E4AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-y2-CkNKcQ7kNvwFnBxGG&_nc_oc=Adrc86i1r7I_AbTlndgAFSY2hzJJngzz0sHtvalfn1CibXNpGgp79UIaTTgB1x7wrRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymMm4F_yqr4aAnXpNrSRnR-UOrpLH7FJUNhAZR-Zxudg&oe=69C3D045"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHHh2Layl0kQ7kNvwF1R0qJ&_nc_oc=AdoQ6kIpZlxl1R0_gq11Zm1WYMRqeXJWJsSL7naBaV71s77TKGkQzf2xyOy0dxbDQaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyW1SXOPH5-i53R2wiWdhcL4cDA8YhovsxBBRL6WZfEdQ&oe=69C3C85A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BzDL_sf4c4Q7kNvwFIY28_&_nc_oc=Ado2XouAbpK6kdqdKve3tOrco_l2FglclEnU6zbvisA23FA_OxYAWNlJeGcdbe307Xw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxpp1TCCS0lcJ5K0u7xWn3pJfB_rvU0p4C9S0cToa3w7Q&oe=69C3E814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
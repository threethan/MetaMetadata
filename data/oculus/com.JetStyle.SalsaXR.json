luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiVTH4HMOIcQ7kNvwEDaU9Q&_nc_oc=AdpyTDX9yFeb52GdZ5VWUEF6kRs0oQPqJz85v7NENkhHvPal_YapoobukMbie4c2VpY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPf_As4N938cZPZjt4npwt1tCbhfFQSwZ_8BEtSOGP1A&oe=6A54F8CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baLbj3IRUxoQ7kNvwES8oAB&_nc_oc=AdquN_ugLvmxTRZLRIQjqfLw1Z27NzlDYdXw4WVcv4VnxuREQ_PNKTGYi-sTQyIphfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU5VgL6Bbp3VinXkG3ngpWlnQ2kpDyUx-iky8Cgt7x-w&oe=6A54E9AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raDX3d7ArIEQ7kNvwErxHKK&_nc_oc=AdpntreLDmgCdLwMpmrJKDGIHr_o9WKzGu_y73bKS7JS33BTYRz7VCMAzgzkrViOPcI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATNIjD-zdXWlwRBQiXxZ8n9FzKtT69HZRdfsIvzj4FYg&oe=6A54D545"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRZTZuDHBnQQ7kNvwF5ke_M&_nc_oc=Adr9O1V2Z2SZy4b38vCE2yMMQmTsntoIrOGB7gHgbfmtZ62PYwVn7L65-wSFp5JU9ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGBQGZ0EZMyqJgJrf2sBRyL6sazOqBLuhXL_fRxkisQg&oe=6A55059A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mFhfutJWSoQ7kNvwGG9Igs&_nc_oc=AdoNkC0BV5AlESLc4lODfn4NmETv7XEZasLL2HpeLW-2yXVHiJadRZkBPD-kRDe1LEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6PuHGMCf3PqwCMor8YBPH23A89DICB6o8QGZ-mmttbA&oe=6A54ED14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SGLzHKuKV8Q7kNvwFIOHhg&_nc_oc=AdpnSNbBmme_biQZwJn0eT2Ye3tPxa7H9XDboTR9eTbwpCqeSpXzKsg4u0XZM7bhCZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAOS5SL9eR5SvbsHUWurA8DD7XEh8Oc0qeT8UxZHt5xw&oe=6ABA7C4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFhyiLC7hIIQ7kNvwHpB4ga&_nc_oc=AdqtDCl-XduecTTSl-T8bBeK-NWvpLJGafKr_5OUwFRN1cnES9tVP75NTuw8cnyNsrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiqLH_h3pnY1V_nbmtrfPCHfUqmN0sGbRsb8UV-nJNJA&oe=6ABA6D2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIHsYuhQjhMQ7kNvwETLoPO&_nc_oc=AdrapSdItqVOs-3WTYXFH-vN4me3cgtK7RvjGijg3oOuC32aWw9vEfcw-X62_-JdBEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuy-oxPjkU43UKxXOcEfpeGmAYatue0POwDVOmPD94Vw&oe=6ABA9105"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78l9v1UbBykQ7kNvwGGBtos&_nc_oc=AdpjcHsDULnMcOUONdoKxyGiY9g-CMVObDpZpxKpXldCt-5jlpVxqCHlGKj-jpWssPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFlJObjSyLuAiFetPs4eu74EY2a9gjEGoz1CDXRVi3nw&oe=6ABA891A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGrPiLwGK8IQ7kNvwGloY9R&_nc_oc=Adq_VLvb2yjsj4lLjxip7IJpoZMLYvMA9bl3s1Adg5BlxoLX5s1X4bgW0Nb7KbWZiWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqY3jzsrib121tsWWFjOeZw-Lz_vxjHhyUQ_YmvY288Q&oe=6ABA7094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
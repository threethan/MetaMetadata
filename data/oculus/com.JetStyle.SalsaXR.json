luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl-4Oinp6cEQ7kNvwF5x62h&_nc_oc=AdrkTd3bpoAaARFtdXWFEcYDI2JON0Qm9_BFVtfMBh-UkXZG9tQBuu69BFuTwi6HWdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWwQDiU4aCQhygUgp9YF5DBnCXIRYkA3X5zxCRRcGFYg&oe=6A5F84CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmSdOmZ1uA8Q7kNvwFJvPEP&_nc_oc=AdorHU1-wr1xccfPKyJujdhruM-CTs220sjwbDnx5Djb9-fT9Rjk9i4XsLpT81OjkUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB56QhvDrQKTetaDLzZtaziQWV0rOBnUNlE1kH-g_I6Xg&oe=6A5F75AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXWXZ3v79S4Q7kNvwGdmO9U&_nc_oc=AdrGmqx9VZMxkXTNBzWfxzsS19tIO3S_X0RHnKs2ZvX1Axp3Az65EWBMgWG2OCqxTPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI0nMd5ogbflB81ZUGc6_0lP48UfWhGyL8_klnTPUcng&oe=6A5F6145"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq_bmX3DEBMQ7kNvwECZrTi&_nc_oc=Adr0W448bbhQIPlBdPES4W_V5QhVgNEd0zTVsg-eiXFs7cVtxvKAH9kQYR-WqAtyLTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAI1BD-Y_NOcqXr4g06JpADuk029xbIi9hh02SrPHvVg&oe=6A5F595A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4ecD4nEplEQ7kNvwG5AY4c&_nc_oc=AdphBY27s5Z4sO9AGoKsrqIOD8tYFIwNw2z3Bd1jN_cbyGvidoygU3YRM4dpeL7GYl8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPSHEeYzMgeWgPk23BLfM6xLVXviqziQI9hA2Stj523Q&oe=6A5F7914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
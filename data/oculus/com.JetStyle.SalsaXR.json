luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSbSCIP-MX0Q7kNvwGdK-ta&_nc_oc=Adq4enEVY9z1VieaXGtUQlha62jseI92xKt_hXOCKXEdmNKf_V_VLFjZI8vEOxwPUio&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qxqFsgtQxAza25JO7lN9bdA9anGWr8hpYB3V0LLOMrQ&oe=69F60CCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq5MHA_BeWQQ7kNvwFiAxMK&_nc_oc=Adr-AqWva1l76n1K7VQVbsOO5HD1e7olBGo5UKOKDlhq5jOoEpFNb9iMsyFINkEgN0U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Vph517ZeNVxFyuEElq48WUpqI6FAwdGTXpi7vTDPFxw&oe=69F5FDAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kViykEAB_sQ7kNvwG8Zpn7&_nc_oc=AdoLMme_At2BI6ZZeTj_3qnFHsZ2mwMani7vmwJLvjGaeDHiWYt_JADDqfhlYgcmYP0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27-IL6qhBg_Ujz2EMfdWU4jmczDfiZbFetovAH_RQTjg&oe=69F5E945"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2uK-xnLO98Q7kNvwHzfh7G&_nc_oc=AdoLU3okOAMIXN1Ln8G9wxSPz1dFZjv_Z9jXAeEU-knN0j1Ion3ncpd4kwv5PLKzWK0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w8YHzpkkG7F_eIv8AL6fuIB3RkIFdmNQr9jwcR6SA7g&oe=69F6199A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kUWOU5OGNoQ7kNvwH8eadK&_nc_oc=Adrhv2ZJRyXMaEd0tioqLvjZTE-UAqBHSfLL8my_ThuUWSdOlUheKRFCJTruK9dBhOI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GGfvA2EelxTfQ2AFA1k6CLgzpHlyA0J9uZ99uEsiHKA&oe=69F60114"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGJlk0w8vWMQ7kNvwFp095J&_nc_oc=Adqb-AMmw9C6z5qnb1T_j-O6FxYOqkkz5Q0FlLoRxJ8vlBe5UwolkXt0grzTyn2fXMM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0xnttPfGn06Q9MJMdyniPzR3AtwScG56GT-krE6WJ0A&oe=6A971C0E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOrwS-H7vGIQ7kNvwF5JeWt&_nc_oc=AdrH5NBSNppkFzaT1SC63BC9gSzuV8d5jdi6j9L39TX80rKanyhdK3EhHFXh9lDWOds&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8J3siLBZND83gK3ouMpOn-v4N91Q6Oks4FtcO-QPQuw&oe=6A97452B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRDDUJrOa-AQ7kNvwFtCNJT&_nc_oc=Adq6v5opmUnGio9OhueoqCoPx7KoOoVOLn_kMjuHz1JMGbEceafz8U7OCgtTOLpVOe8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY7wDHhhqK1H1U1SZxMNBIPBkwWeFbMCXI9t7Y7kBfPw&oe=6A9730C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql-x2tQiEH4Q7kNvwFLbUYc&_nc_oc=Adq9WScybFtOzjCxJeQ22-WpO-ssHTSqTQs2xSde1Q3Ibzw5BQiMIh7fa4oV33-kJ70&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbVoNvo3t5xKPVwaPehVZLRl0J3TvawmefJpT8JsdQhw&oe=6A9728DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW9cAfjF16YQ7kNvwFEH6It&_nc_oc=AdpI3pgXsLaHCbBwodkPV3a8YgEgbxO3vjUip08q6anXpZc32p4yzeAmZ4W3EVNEdl0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEus6rwF3lc2qMnyDLhn1dG7_NOVulElTqKdLC_TE35Rg&oe=6A974894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
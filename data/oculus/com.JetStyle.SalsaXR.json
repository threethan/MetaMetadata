luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P23ycUYwx1EQ7kNvwH4Zsg7&_nc_oc=Ado8O76U_xzG1c61vtOytefjn1ImolxkznLk-r2nZcj3L3QJw1_sewBrVwoI7Itz_Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ia-LtF-GrFOBwYOIakTSNl_xFIZrShVmsBZH5XfJd0A&oe=69F75E4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq5MHA_BeWQQ7kNvwHod4Q9&_nc_oc=AdrEmo5kEmGNoejl39Y6ge6mSzu0IIW-zUQruVJF-A9mbKD3YDugHHmYtIt4UPgw5Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mtOX5eiBot05AskYSY2gMIuxBR2aOUKM7TKuJWZzfDw&oe=69F74F2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kViykEAB_sQ7kNvwG0z74y&_nc_oc=AdpT99zZKZVAAlXXUwCLq4urBqiDw-RzKUFKRjCAFsqWS9iSw-fXqlB8x07Q10Nf_oA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qnND-qg9QfLQk6tbb1c9FN6XiTtCishlbZkkNN8JP3w&oe=69F73AC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyvjJa0PbUUQ7kNvwGH2apQ&_nc_oc=AdpkjJ-6e1QaX1yEKDzkkAqmydfh_k5GYYRZbDduAxQ3vx3Pb3Ic-Nr6FGY3DSUBNF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xnhZiw67-AMoDMw8Eu1rP4c2jaj2hIbuFAsg0ARp8vg&oe=69F76B1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kUWOU5OGNoQ7kNvwGEN-Wu&_nc_oc=Adpi_7_mDUAFN68tDLGuolALZbqST3VYBWn12c0QLlXXOK2xREfdqhQeWIhOmNEGCLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jlv-cbM7c9kqTuuSfHz1nlwh7341R5cRf-rXapVHZbQ&oe=69F75294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
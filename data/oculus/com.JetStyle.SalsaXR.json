luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB8L4JOHQ0oQ7kNvwEb8mMw&_nc_oc=AdooZlA_-or2xMjwrO_s7yekTBqfr6oNSyV1oKvkCuQLcKD8fSQHlFHabu2-Znl5uik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSI3PCUVmNV_KmDj8NrOog-9OvWc7fqmsxuS2WNmdaVg&oe=6AE74F4E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fJmakAmljUQ7kNvwGxzoXW&_nc_oc=Adon04DyU8M74XJpVYdu_sc4AtZE0mkpuVjgNUYWNa2SFQaurRPQmQ8XoBzl3yu-4MU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgatsqq7fnCEK0oLVLon9nmQ2OPtn75sjsbAjPoqBjA&oe=6AE7402B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYT8CSZtfFkQ7kNvwH1sKz4&_nc_oc=AdqpsSt8fQls3Jklslx9JFgRfzEgyLxlVxkVTceMuRf0OZ0HEDThep18PdV3eaRs0a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBACB8dyOluCBkRd-8TV0PI59tOYKQG-yd70Floucupg&oe=6AE76405"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L7HNDIDaQgQ7kNvwE2GW_S&_nc_oc=AdqaqKImR3d0fYQ8Uabqr6talSwJeOz8ZBLkUXDGN3fsXO7mclOnKC_TfTwDlRePBb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUO9TaxUHic75suoIt1XmHuVg6HW9OmYjCBzo23LEnVg&oe=6AE75C1A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS5qZnNBSLEQ7kNvwFOKU4L&_nc_oc=AdrYV5pNwBuQhr9se9uJDqKkI2KIDpP01UWMA_OqbPrttULqIJxXVbPwlUL20Wo7jl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOv3r06m8J269kcetJeZNXRkIdkX4YtJnm4NcuXeF7NQ&oe=6AE74394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
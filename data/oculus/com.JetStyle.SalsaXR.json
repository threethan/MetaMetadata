luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUN6MJbrzssQ7kNvwEwfEJY&_nc_oc=Adpd_lTOeFRW24z-R3Dm6F85tA7eOfwNVy5PxvmNXl5MqdbNFVYOlDyGYn2swsHSmOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B9jdMYEsNtV3PDRT21QnFEXWz6jI1H0YmLRgRPIJBBw&oe=6A29774E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNJZmfeJnTgQ7kNvwGE0fR4&_nc_oc=Adp0Z260L5Ewd_dzRgyuimHzm9DcWkpYWm1jwDSvmxkabM_GQwHYxsRyD2Y73i-Gkhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AsD6QjZtulZYb-02F2c1-Vok7jl_iTN_R0cIT41bRDg&oe=6A29682B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_IvJJegkxoQ7kNvwEGH8T_&_nc_oc=AdpmsXzvd96wQWtpktnBrLSngZ2Ej2wfdN3upn1TipkvMoSKkiLMdEZ2_0R8rPRX0PQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qKuQPb65s-I6OtgwsvW6xlK7F1EhEuxrorXrCjHhdnQ&oe=6A2953C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0l-OYvgA68Q7kNvwE1kj9x&_nc_oc=AdoeX9PgnKrXGDD72HryfrayFoKI2PLqbI55ncVppAocXhzmh64ISrHC2BWSKgq8uys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d_FGVEMcxs_SGrQqHNVZWMEw_6XkJP9XrO_zRrmZ8Ag&oe=6A29841A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH26tNGIM1MQ7kNvwESDt5F&_nc_oc=Adq_AS6PyJzr7kyglxvw6vf_u0e-t0jexLqzIep7iMAIN9T-GniCGs9bQD0hR_gaSN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z7B2ZPBPHbPSNv0lBnA6-w71uXIo0zVIUONZemSBq4g&oe=6A296B94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
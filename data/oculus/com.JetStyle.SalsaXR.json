34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwO0JGFjvhoQ7kNvwHopdbL&_nc_oc=AdkfXwNdfw3naMdYzPPU0LFFUPumAPoAJT7zB1esQhBu-fMv418RukZgfKnSyUAWbLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNWi_nSh1LQgntjSCg5SS7UpRWP79T_W_Y1eTA2ARqGw&oe=69BEADCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wHd8xXViDwQ7kNvwHu-b7X&_nc_oc=Adl-KY4MlbtlQFfjDtHNDyWwyn9oFgIM2IR1G2XbrloGEV0pj6102M7mdmOzfxxh9EE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBIZEODKvcBjSIYRqvkVZAXd1qC-cocR1rgGUx5i0GZw&oe=69BE9EAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJn8zaMkBDgQ7kNvwF0i_Cs&_nc_oc=AdlPOm6-FQTtjWQmgABMueQ2HBLdema17xiXkSJoes4S4NOULzfDWrWD8qXZhCGFIY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztI4DkIHCejLW1fvIBGeJX1aDa_aHzPbx_NN40rhkh8g&oe=69BE8A45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQqP2oy6R_UQ7kNvwH1aDPx&_nc_oc=AdlLgWximEJF_kZojaOZLB3DfW6_ArbQWWs-4ySKsUrOx9D38kxKoJeoKrgxIGb2i8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEjnaXInAD_YNS9t56vjpN5w5hgbNjGY9Ck7ezE2SMmw&oe=69BE825A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx7onEsauoQQ7kNvwGtf1Xl&_nc_oc=AdlLzdvi-bny0OuAcldiW-NS6Oe_dv032AjIaMQZF9-FTyVU1vqhvr2Q9jaF-BeR9pE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2M2L8E_sQCL9hw5ot9tB7comVggJ4GRsEvtg5LIVEBg&oe=69BEA214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
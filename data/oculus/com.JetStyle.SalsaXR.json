luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfETduvHhq8Q7kNvwGGawBD&_nc_oc=AdpCuVGLxaG06sbM-_hYbYcghWWG5WTgMqMyquh-CI8xk9ATGNItNQ1Ly8k3Tey5_Rg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j5OA6BEruB214k6RyxbfmUZ00tHQu_llWFJ7aJI9VwQ&oe=69DE51CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wum0-NPnlQIQ7kNvwEoOvk2&_nc_oc=AdolsVh_lyvKgUn8fZnUwhM4XyxWD_UQ5mdOc6Rc6iFI8ATsEzUVqaWEyBvXum_8bhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wZkWUfkJ213oTLnrFBFtOGzSk91GqsaNXoObFnpVQMg&oe=69DE42AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCp2h1Opw6UQ7kNvwHewIUi&_nc_oc=AdoZ3c9VKW0DPMCV46xd_D_eHawcQ73MP2zBW6idQ6mbscjESWPFNzxB_hyNdc69Zeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3crJ2p9ohaYeNhPVEAcaAFKzJZ__DosFYH33ImjkMz6A&oe=69DE2E45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMz5BSk-Eu0Q7kNvwG1RvEd&_nc_oc=AdqFYeGySJTISHTsPXtn-isywx4WCUgfTg-w02-tFVm9bYAokLJmAdM0Bz9KKsOGI-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nn2lCcMf6SBF3akRp86dV8RTonZnBr3WLnqrieDYMXQ&oe=69DE265A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4mIleO96zkQ7kNvwG34IuU&_nc_oc=AdqeyWWmfW9cBazX8zlTZw2MLi44Zgta7FO-sSdIZGpJYmfhG80fANQA5mOtivM0XFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XZNp6NBoVnmKEZ9LHHfNm42e3fJLo9ZMDnR93SSLYng&oe=69DE4614"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
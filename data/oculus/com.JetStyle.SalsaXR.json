luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQG4FEUc6gAQ7kNvwF2yKlD&_nc_oc=AdpxjC4el9w7itR0q1Tra5PjXqby1TKj9zXhMKRyybyCK8Rml4Td-DBHJK6mCgyKkcs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4ohboV62uGAJfK-ONhz0pV001xOo2acYVjnzUYcZLoQ&oe=6A94088E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzA0bofDqtwQ7kNvwF_XRja&_nc_oc=Adr44CMV11ZAwTwfiHOCSTvYLmUnED5-QJ70SYX6YFV-Lw7lIz3Sk-tkghECKIHMwHc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiZ5rYTDZ7o7m0ZPdLuF8VKLtKUdfz8EVxn2nXQ636sQ&oe=6A9431AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRDDUJrOa-AQ7kNvwGCu5tR&_nc_oc=AdoWtW1k8SqHav8xd1RSBcDl4ahd-10gtmPu8C-PiOyEXjGk-MwxkEmD5EPo3ZPXbzY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkRBFRydy_x2TA_P5apvtO4OwXm3z990HhzI4ryyrHbQ&oe=6A941D45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiLEA_CNtT0Q7kNvwHiiu3x&_nc_oc=AdpstDe4w5kopq2v4A76rlFaHGIGKD-U19-rVSJGytg_T2zYzCtmabUQKAV0vUWSQGY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF925kZSOLUc03xBBOP29tLyuhjWPi50yQQCouHa5yWw&oe=6A94155A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW9cAfjF16YQ7kNvwFryKEJ&_nc_oc=Adr44o7j1YTyF9F8VlFHzO9qV6aboxXz1bdP8JtS30j9SbhNAV-tIf7VZYrvsKq9F-o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCUn0394yc4xJ1laEex4B7X1TGsFQ0OrSkJOia_76YQA&oe=6A93FCD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
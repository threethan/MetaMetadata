luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl-4Oinp6cEQ7kNvwHOa1GG&_nc_oc=AdowkQldhY1jajPh1wq-4jjBD7K5xLmnXWuDqYIAlRwk7_eZkttD_nBl3JXE7dF3_l0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxRD1opW6yjTlJsFEym2Zgsw0uOsKM8oyzYAQcnZnY-A&oe=6A5E334E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmSdOmZ1uA8Q7kNvwGESGFA&_nc_oc=AdrqTpxjPjKwUqYBl37nr3V8BYfPfoT-E1QAVGKY59mWt_YnQTGacD268jyCjunbTwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv1z24392M2vIspj6k9Aac4e7b6YokBTB2NNZjEqvxoQ&oe=6A5E242B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXWXZ3v79S4Q7kNvwEtBBjw&_nc_oc=Adp988Irh8jaWnTtaMI3KRo1xv8_TarXla39BYI7NLaX4ad8XAhBRULwSZ06xrgvR9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyW-W7SzPLys4HPMVHeGmbhDqsX8sSGJGHMMWy5XAnyA&oe=6A5E0FC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt1ALb-d7dgQ7kNvwERwCc0&_nc_oc=AdpUzOO_ODm9hIZkxlI3ZQtKzbqxd1E4l_0AGhiO2E04n4kUrSiFK578wFcZ6-T4WDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcf81iJmedA-5ZOkv-WttCK0P5sBu3xwsZMA7iSSzIAw&oe=6A5E07DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4ecD4nEplEQ7kNvwG4O-Gk&_nc_oc=Adq6e_hf4JAK6tHFZ5pA_nTqspVU9xyZvHKb6thRHjA9sKRv3mOsGITgmUEUx0l7qhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHjsOmXsjZUFWVF5eWJuO9ENC-gmMtx2BKiIKF29NP1A&oe=6A5E2794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
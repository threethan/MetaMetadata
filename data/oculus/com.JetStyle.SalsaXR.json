luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw1_eebatIQQ7kNvwFSCpbJ&_nc_oc=AdqwBbi4DlwHMu9LQF7fpjjD3ps5__JL7UGvL8Qcqosrhs38fjTAiawnRKXRzXaXJc4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBMsHfqHOkRtbR88Xb988rItYvRn55fJxps5hfW4ZiYA&oe=6A81938E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR87Ksko81YQ7kNvwHp7sBT&_nc_oc=Adp1jEQRHbiIfJxX_xOSw4GBGmZfUcPRyJRXNnIWTtU03CdFUXQ9h61HLLd6i5Jek_c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-uO7CgxDM-eZTC1Y9l2yFWZZNY5nGQYHOKS9D3O_mQg&oe=6A81BCAB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKeCAPyqzSwQ7kNvwG1ywX8&_nc_oc=Adony3IEGodR5bu3pLeCICt3PnST6FIfYLId9i4tV2_IKAQTEcqeaXonHX45P0w883I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5_6c5w7TNcMo6bPuc_wFaMVvQCZ9sdhaxZeSpyz5aEw&oe=6A81A845"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3lbgPUJlk0Q7kNvwG9TRvw&_nc_oc=AdqdeXtKB_dmb3p24TWEzOhJWEqHHX5kSdKDAtSAkP2WZ26_ZxiQEGHmFuS1Os9Rd6o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKAI9-w0t83XKwFC6zrFQy3C2fFuPE51UVS7_pz0ek4A&oe=6A81A05A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDg37bf-0PEQ7kNvwH97Po2&_nc_oc=AdoJy6Nh-vsfUjagZrF2KWNXJsZMvYwTEey3X3Oa0w6XtvCga5sgq30Ptz84Wvs-yr0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGkW5bN5AzEWqWeFlM8Y5hlMt8l0bGyvyf3GcU41yuhA&oe=6A81C014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
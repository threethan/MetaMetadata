luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_bDHZuRnLMQ7kNvwH4R06X&_nc_oc=AdrO1Nfqge_X3dZhAI-YCcxDdbuFEF98q_L7mcYmmdy-O1gmOHM4yftC9JtaxGqI-PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn0oD52skmhgsjQ0vUj4q7fCMZWE2aKjgIy6hfkr4i1A&oe=6AF5CFCE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmWSd26ig7MQ7kNvwGUniKs&_nc_oc=AdoJR5iicsvRrwjGyiJpCfmbrrt6STSBqloI04Bha-k51V4tN4iDfsE-JTegOO1eTsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDvzX5wDuzaVrX_gvjNU7198HFERSMN8JJQqqN7vBD2Q&oe=6AF5C0AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q6a-oABLSQQ7kNvwFg11dU&_nc_oc=Adr4lefIr6C2pLnW5asQ1Od9Blg3lGnPY2NEOPnU5yNNcPhwgx4KNjVjpquTmvVR-QM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL3-xm4dTvY21XMrSMTe8IarhEDuOzCMWyUn04vXDcNw&oe=6AF5E485"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLu5ek0n4mEQ7kNvwFc6WY7&_nc_oc=AdpynsDMgaYOKpBwXqmNVAOdB2RNnq29yxAiVoYTuSl6NgKvddB9BvQae4cN4t-_Y88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC8j5PEr5tbY_I8_l5C-kyasYKXWi1HxIbJY16OLi6hA&oe=6AF5DC9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWJOHo22f4Q7kNvwH4tTPA&_nc_oc=AdoqIhpi6eI1zL_IUP1LsMyHhtoG5UBebrIh8fgqq8z50qclqlCp-XPn1VveTodhzKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-mXtY0pPTYSgP2TaRvh00XGTuKs9UlbZnBTMueawDRw&oe=6AF5C414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
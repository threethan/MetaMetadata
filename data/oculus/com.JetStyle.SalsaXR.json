luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5GbLQmwWI8Q7kNvwHH_UFo&_nc_oc=Ado7KLiPDq96kAv2z75zryQNxWjkG0IRZ_b0RcHOJLw5ePtw3tj8ABZliE2pakpUnKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDspQQisLfUjCaSoxA9-YcGXSQolZfbtiRto3m99fImA&oe=6AEDE6CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMlDXt1PbYgQ7kNvwFMAnRs&_nc_oc=AdpClfcO-oLJtFd-rBKW738OFgZKnIMMFr61R8zWQ6XqBVbLPaTtgIPcry3gzRmPY1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzZLV_eO7lLlGEyRcO_O-RfH6xauz1aT3Jcp6UCiX5JA&oe=6AEDD7AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u87CRq9xUxEQ7kNvwH0Fwvb&_nc_oc=AdozerTSflPc4Nwa6bG5cXjzRVP1iZsQtcJXhYXboarCnmM0BCT4sVeMPs3QgdYIAoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgXaBSR-K2Pmn4jy3GzMceKuWhJcKKJ97xnfSM9mZWHA&oe=6AEDFB85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZFdb5oxmbsQ7kNvwGuF1k6&_nc_oc=AdqL721ni8OAsLsyZpcIzEsNMhnWYUosvcfcYvBT8pzvXpFUMUm6g6Mzcb-5kPdj_m0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEJJCSYxMcYrnlzHvR-eSN0uMF1JouX59EWnSfmftwdA&oe=6AEDF39A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkfPcNleapgQ7kNvwH0Q_Bq&_nc_oc=AdoBRA5CGTIX2nqh3g_USFzH6o1d1SkBb-PTRudXPcgrvltn66kdTh46iz3ep7ZRV1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtWnRkd5uHsQqqjzDqE2hGwh1ajrCUlMdzDCRfqvZ1ag&oe=6AEDDB14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
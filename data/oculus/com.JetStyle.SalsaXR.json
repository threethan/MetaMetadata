luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpIIHqKO7l4Q7kNvwEMqa0E&_nc_oc=Adp4o5_kA5ACXm11RcpIj3g9ypm7xrkdNvfuaLusZCgitiDJk7oocL_haUgdsZAMUik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtDvF64BoVPfuqQAg_YhINNvc-jCW6oxno9R_-R5uUaA&oe=6A63794E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFDfwiiCHR0Q7kNvwHizqUB&_nc_oc=AdranPPmxTlmMT3mq9VHO4rM2VTltX0aRK3BHBvk6iyfdI5dkJUYIwyAJXYF9nfkxck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkKuCz5xkCn2L0esxqjuaDWaPxC8jOg6wdUm86EZhKdg&oe=6A636A2B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xb9IgvH4zsQ7kNvwHE2BUe&_nc_oc=Adr-PlPmp6gammvvSIuUUygTShKkvEOTpDvHaY87aCxp_FkbBwYGM112GJgExMuhRZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQPtca1SDh_kxm2NUqHQDiUN0ZY0uCfxZQopQammC_8Q&oe=6A6355C5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU5oQW4JPc0Q7kNvwHawNAW&_nc_oc=AdqtKjf1cl3HOby_ThTj5h0Er_fdFHfKovp__zu8wE1WQyx-swNYpFTP7QN-zRc7oEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOWrQGOHbOyQRHsMJytMBFcy3bciSSRjKJcRlJtCTLFA&oe=6A63861A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LP1ebKAiZkQ7kNvwFD7T1X&_nc_oc=Adol-jjw6DMSFdORYZkcOAD645F4JcgM2-A8FpwOazDUn4Z0ydmOGRG3oX2ozGNC7n8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG2mmFt8NXyPREhC4f0hHNapERYble3bCg8KnwNWw7PQ&oe=6A636D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
34_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmPZm_n4zHkQ7kNvwHgHrlv&_nc_oc=AdkaqSL_WCleAS0XWPc7vPAqst8UWzsQbqFauOT9Gg3iZj4Y2sHs2ci_0dRuQ73f8rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB8fzSVF67y_8I6KYix9L572exmGtIVuiQa4HqF5npwQ&oe=69B53B0E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz2SV11NmpkQ7kNvwEzmDfX&_nc_oc=AdlIz6keClnET2Nh4E-NbFArTYo2UTCqwxGncNw5qqhuSX_rx-d1cLFgqLYVZ1q_laQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxyD7CTxr5qK3fIT_duY27pxSbTtqyB5m6FaLuHNcMNkg&oe=69B5642B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHqSH8PIysYQ7kNvwHwieWC&_nc_oc=Adk0XonId8BbOi_vqfTU4bH6XbRGcnzCJD_h_1l8O9_kP2fS5TV5v51e8jiVfPjZLQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGLWbWzfdh0UMaEBpfKfy8Z8UDZLDg2i-ZlnOrCgkX7w&oe=69B54FC5"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTcXIBfjN_cQ7kNvwEHdiLF&_nc_oc=Adkcdp7iqpeRL81wCTCL_8G3Rk0nV9eoW3W2WJPs59ULOTkO3NVkeFP8SOHo7ghR6bI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afysy1gKGlsLTV1lghyYvg7fL-jHexkoqBUOyTY8_qY3zw&oe=69B547DA"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq3pmhPZY58Q7kNvwFt4Zvj&_nc_oc=AdmP9-zUWMXV1ufmzaGE1ra4R2rQcBJPWC7X8Zf1uBGcgiOBS1W8UO-Lo9gVpmMBHm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQOAOr4AkAjxk3LUs2xOpK1qELuvY53TvPp9zMdyHkgw&oe=69B56794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcWO8CLWTM8Q7kNvwH3uZeW&_nc_oc=AdqGCMqfsnaqdpkVzpUHMfgxtMTaaem9C1vYYe9tTH4jg-dYjCn_4air3-aIlJ_A9Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtZ0xdAKqsPHt3hjwTLMwUw_M0pgrwop8mMkIkN909oQ&oe=6A9986CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5PVYAsmgCUQ7kNvwGV5Xfo&_nc_oc=AdrE0Ivuuqiyh8B_i1pKSFXJ9xY10Plw8hjLdGD9oyzERoubxp9MXTSzEyqfX7mCRW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGkq_eShUXDV32yfmaPq6g1SZfrwKE0Gd1CGg4cbGsVA&oe=6A9977AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkQpqQLqMGkQ7kNvwHB4Sy1&_nc_oc=AdqA4nHlomsDpktG5eU1x348_e9JMeQ5M6FyzrI_Xqx1RPCpeZdj0KkCPi6Hc2PjZls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKvVewSmQgVfieaWF2ATdILQ_wMC4nLmf2GN8VTCRynQ&oe=6A999B85"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvlQQNMrqCAQ7kNvwHnIm3X&_nc_oc=Adqcu0CPiJfhPZo1-WA0k7eXHerk9s9h9JyoBMF0rdPi-KC24Dt7Sok8IFrONOg5oOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwJ_hj21n5H0dq_l_yJAI_Mysg8AnMGiPHMDkI97aMTg&oe=6A99939A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr7JUu12L9kQ7kNvwEElTS5&_nc_oc=Adpkl_q3y3F4_L3SyV7cZZh0daN01V0RUltnUoXij9pOTzXmoKDgyB-ZZ2ygenno_MY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtmlqTLO4feqV1ELJzB1eOR1mE3ft714sBUryqjFBrsw&oe=6A997B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
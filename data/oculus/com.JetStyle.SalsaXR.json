luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwsCnIO5ibgQ7kNvwE3-moN&_nc_oc=AdostLgyxGlBCWwHIfTuL2t3T4TFsGIEoUb8gBgjtotPu4475WQv1q_8-Ojd8lL5HJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX3XoTLM7KItEhChquToTOrf6arBPZbpQVtAtA6mRHag&oe=6A51044E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJWwfhVUoNYQ7kNvwESY9wH&_nc_oc=AdoLQmwih-xePANTO_C-1wnytqeFZw6juAVvN_lWiE7uEtCeS3P_fjAwY2ZRJp7X2lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgZx7W898-p2NvVf7RrGyLI_w-3ZVEvTVwVXIKm3u2pQ&oe=6A50F52B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB4HR2Sm8QUQ7kNvwGgtaMX&_nc_oc=AdouSxx7hwSL997whroYrNbNgu2nsJTKTBr5gW4VTuW1Q1OaRHDn11GTyw9sb0CivOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_6On9RJ_BQ9GmWBYpdcEjv8TXoEJOXE_jO1cv4eWlA&oe=6A511905"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCsaVc8CaNcQ7kNvwHkx_4W&_nc_oc=AdoLDVwAHPRLhYaCR-LMia2W8WyrroUmp-1OkQXwi35wDBaSP9uXmjO2o6g0BbzEr0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoC7CTENytq7vFBkYnnb5RBtI_FJwHypSjZ4f4cv3KLg&oe=6A51111A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h5qDS1sj0kQ7kNvwEeBo1v&_nc_oc=Adppt2FQVYhml5xwFANLfEcOU4qk5Qo-WzqpTythHcsVWKXbyGJkurhgss0SHOuD87E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwFMxKDIymDlqhfad46wTZQ-FVB8E0XLSiLmsQaOmKxQ&oe=6A50F894"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
5aT7faC4T9iQavq93hthYJ2mhBBSHUJX936wxKKYU1gn2wm649OKLefP4pxFRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuK5m8mn_xdMhVS4qopNCE_W2lucmkCj7OIXOywgRKxFg&oe=69A6BA8E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpIiD6BC5CYQ7kNvwGocdpd&_nc_oc=AdnySqDgIJR5Cs32UH3AfdaZk0AOe9iDr48Q4Yd8QK_WWvvVABf-T3XDLNBNqWiIp5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4a2Ik6uHyLhmN-JWvbiDKzM6q6x-WUhKDQjSpIbBZDw&oe=69A6E3AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBOM5R3xElAQ7kNvwH4IT3D&_nc_oc=AdlwyzUUBOxKfaYGmzsgi93KeNQ1S9RnVCK5Fz345mw94iC4eoB9trIoTLCmKJoq2Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaK2OP5FSNozLPDYNBVnfES_35wNmIhnPAy7p9bcHf5Q&oe=69A6CF45"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btTvuWXoDGwQ7kNvwEyTlvM&_nc_oc=AdkN-P5YKDurmRaAEaAxPAPyS7YntJoiiv9r5fMb2eRbXCYJqKeK75xLX2ivMgURWAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvqX4_GsrYu8R7lXfz-LbyE-8t1ojLDPbuOtcfP4v8YQ&oe=69A6C75A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z0PyMDOCegQ7kNvwFDUyij&_nc_oc=Adm5snFGX62RehM87iRVRMUmNvpa0ElWQDCXYWKGgmdtXG7HoBpVLFUaGl5Iz0hGXFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjSFYcIjNAAwMIiR_vIw3cUe8wokbM_9fhQ0xz_ISd_g&oe=69A6E714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
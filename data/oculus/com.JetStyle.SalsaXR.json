luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iHUO_UB4DYQ7kNvwFitdlR&_nc_oc=AdpLacJXYMyW_q0Jx5aYE50gk2enu2_3h2AeNHVQG1OL66skucDPt_gK0g-Qwh5cUtM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KNovdYq7ab5euVr0QWCWgorRd3wC0EuSIVVitVU3EHw&oe=6A32B1CE"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPPb5sYiGA4Q7kNvwGeq9XH&_nc_oc=AdoGXIdnu45yCvu8NvkbYlIWIweurHiIeNexkVnkSaeE5Z-U2_nKMgekbhaaI6iHxE0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M9C-T8zS_QUBucRyKDhWPnWc7Vo__APW2B0Gut6S3xw&oe=6A32A2AB"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuZ0B5gMcHUQ7kNvwH5W8Gp&_nc_oc=Adqbi9i84Ku4-1NnwwvVhMIun4XBEv3WrCgAPZUvG0RorMTFjTUeeFI09o2czJ7bGbA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-51MQc1xBiZJJnHChXKoaHwWBTOHUKEM5isleWG-odlw&oe=6A32C685"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdB9W7mqlZ4Q7kNvwFkqq3K&_nc_oc=Adq9_mjTTkCM95x_t9Cp2L95-FBr3QCrpyM1V_PIOEmezU9tifT_shV7XGHGNhByhuU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TrdZ5f8TXvHjTM8vUT5pc9XPQFpw6YDwpdCAFNmynjg&oe=6A32BE9A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nuALL2eH1IQ7kNvwGeGdYj&_nc_oc=AdrHg95L9X9biWv5Zk51NoLoIF2Z94qW98V8j4q9aew00TJ9o88_bHrOnZG6HdZcDF0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vxYR684iCaJthO85eS4acjwFi1eku3sKRpghKUqAKtw&oe=6A32A614"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
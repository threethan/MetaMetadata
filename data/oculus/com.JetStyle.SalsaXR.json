luscdn.com/v/t64.5771-25/39031315_1009978524234134_5745695367727481674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABfKa67wuYUQ7kNvwEUTEvc&_nc_oc=AdrZ_s_NSiJZPzU3P0N8ZI9ZzuMvPSvECnr_urgadA48gRYwdgGWtCaFxGyLp7D6qKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0zZMRU5oc3vdsrf7diiizacaiwJpIlDbS5ZpSff2f1Q&oe=6AD2374E"}, {"file_name": "02Settings.png", "id": "1001858908403441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974809_1001858911736774_8337514040661926404_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeTFPn5NGlEQ7kNvwF3u-eb&_nc_oc=AdoiByW-olZ2BjemfLoyuBy_up62nxwCHKzFEPlIDr95EpU2VjGLOQ5WpGYojyMcX_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWgpdKtCGEp267JEcO5xwrSX8nxebHf4FTDSULS3t0jw&oe=6AD2282B"}, {"file_name": "03Tutorial.png", "id": "488465360674380", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982581_488465364007713_315723785327923060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRgQVPtckFIQ7kNvwHSprFi&_nc_oc=AdoE1wGHrPsllZ1HpyimXrQwyjA02Q1VQqdga-yci0nb9VUwqCl9EZHoDQdYj3cX-9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNplxgx4cWRolLs8GTG9xqFdjLZFV8sdhRRFoSZX-34Nw&oe=6AD24C05"}, {"file_name": "04Dance.png", "id": "1166657517781236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_1166657521114569_5627153293980512491_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HusQSqomQxkQ7kNvwGE_Wt_&_nc_oc=AdrvSbzIFUaWyv_GU7ZvPJdYkxLvdTTfPHzS38C_T_VGZiUsDw-_A1wiSlDTtyugtrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCeAOzDqo6PNaHjL1aIbgiByec48velc8MyWvVwgrRmA&oe=6AD2441A"}, {"file_name": "05Steps.png", "id": "490599910428063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402515_490599913761396_2509104378714936354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnQUj_hG03EQ7kNvwHxTD9n&_nc_oc=Adpi5sl6R1xfQCnk1QQNkWL-fl005g8Xk5x8lSInNeU44qNjm_ns3o_OmK5O134J0dA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjd4Bzcl4yjNNW1GXSJMNf_EOdHIA2UHFvpYCoOlKj4Q&oe=6AD22B94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salsa XR", "keywords": ["salsa", "dancing", "dance", "training", "couch"], "long_description": "XR-specific UX \nWe developed and tested the UX to ensure the user benefits from the new environment. A user can adjust their assistant and dashboard to where it\u2019s convenient. \n\nTutorial \nThe tutorial shouldn\u2019t be too long or too short: we need to explain all the peculiarities of the app and not get our audience bored. We tested the tutorial on people with little experience in VR/XR, and did our best to find that balance between the timing and detail. \n\nSalsa coach \nThe coach has human-like features: lip sync, body language, and natural leg movement. During the tutorial the coach provides a detailed explanation of how to use the app, making it feel like you're getting personalized coaching from a real person.\n\nLanguage\nNow the app is in English, other languages are coming soon. ", "short_description": "Salsa XR is an app that helps users master the basic steps of salsa before they start dancing with partners. With Salsa XR, dancers can take as much time as they need to practice the basics. \nThe tutorial explains how to use the app, making it feel like you're getting personalized coaching from a live person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jet.style/portfolio/privacy-policy-salsa", "developer_terms_of_service_url": "https://jet.style/portfolio/terms-of-use-salsa", "publisher_name": "JetStyle", "support_website_url": null, "website_url": "https://jet.style/portfolio/xr-app-for-learning-salsa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
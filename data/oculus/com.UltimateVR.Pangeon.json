71-25/39035322_1397437880773460_4716594464680409060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epM9kCUw91gQ7kNvwGNLa5C&_nc_oc=AdkYM8hJBg3nwz9VPstO_6kn8y0xJLZnBEj9y5xg-L46Rle_UZ6NuuWQWxWcFKUSz1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1O4L5fnmhbD8nfQn5F_PV9ZKcm0tB0ONVCt4mHue7oA&oe=69AC1F21"}, {"file_name": "4.png", "id": "484815836778535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_484815840111868_5288699189366514476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8cqeqYMk_cQ7kNvwG1TbEp&_nc_oc=Adkm-MYYRwF6EhzCsyV1H1HFnWNu75SCe51N60zNeA9DiLnezsHh2dvfL8_q4-kuo1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZHpG5qgY-2alig_MeMAWVM5F5CPvIWkk4lJ01XvprSQ&oe=69AC3459"}, {"file_name": "3.png", "id": "332933862328205", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001655_332933865661538_4251527810063043633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0T8uZuqrOMQ7kNvwGBwoPX&_nc_oc=Admbe3Un8iKH023lRQlOlEq7Z8R9_sngwOwbytXaAOCBwP5WdfA_ppYmP3cr1SxSWs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTSb923lpXNFOoIkCpRQddo-TpG_9L3tRD1CT7dgFo_g&oe=69AC020D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCvTqesiE9YQ7kNvwHivQYg&_nc_oc=AdkhlFQj21xOL5A_b1DSlc0i1NzjurpGdrEm3ENi8bQgpIZEEj0K_1BFUJgMNXAGaUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAfqJmRQQG-haRJyiUahb1mgE0KS00Rna5IB2yQGW4rA&oe=69AC2A4B"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCJYJzzO0fAQ7kNvwGCWImX&_nc_oc=AdkbQoitB2I6774ppJnR4wUPNntGQCsDqycHQb6XlrWWUoIT6i5yI1l98XN3AYiVzIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi_CVtpy-j1YzjIDwLpew7ZSctX-LB2kmMzJtK2EFllg&oe=69AC2B7D"}, "is_concept": false, "
7u0GpJPl6inGDuBD4Ay0kPulzDxK69Kc4A&oe=6B071D0B"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-
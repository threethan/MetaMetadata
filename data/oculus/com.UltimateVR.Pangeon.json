wKkaGxw28ZdiQM651doGdlQ&oe=69998D0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6h40wsqYyQQ7kNvwGDaLre&_nc_oc=AdlNNC5CgI0TgcTBCUsYKwkujSL60is6lEU1tyxSHS7WpFlwr4yZfWq9QMPgRB6Cns4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5_J6pmUQ5g73LNwRYnmoZz_crFfLgfnVm-pSjvUVImg&oe=6999B54B"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the brand new version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": n
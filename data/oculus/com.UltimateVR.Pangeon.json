71-25/39035322_1397437880773460_4716594464680409060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g3ORvyJIWwQ7kNvwEwGerL&_nc_oc=AdndXT9uTa6v-YF8WLmcPy6yMtfE26pNkA8hj3kLvuEFG3aKdxOxQrnHglyismEyZZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7Ajq8zY3THCjA_ptvUBIchimUQy8DBk2WSexOfziCAA&oe=69B559A1"}, {"file_name": "4.png", "id": "484815836778535", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982532_484815840111868_5288699189366514476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCMvOdR2VTYQ7kNvwHIkx0H&_nc_oc=Adl45fzFyeK28yp_Az33KYpzHISHJGqzFUKpXAL9isRZe3pGuUogQiqHXZzs8i7xz2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzChI0W-e_h6ZAyyPJZMysAlXij-tTYc-xOnPVDgDQzA&oe=69B56ED9"}, {"file_name": "3.png", "id": "332933862328205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001655_332933865661538_4251527810063043633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rts_sVfRqAQ7kNvwEqyXt7&_nc_oc=Adnu7SbQB4MWOJrBtgNw-vjGXsnUn4RVzC0lfB-dVPGVvgTXl3_MRIfpiqSYuRB758I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8A7mMI0EHJLnp4LRTlM3z2q7-XRTouUvsS06MpO4RlQ&oe=69B53C8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra7oWwULIYkQ7kNvwH9_FkL&_nc_oc=AdmZ6elWYhM6EJeVyWPE-kdjJJlzvqM0UfqB5oKByw8WOM7uc_MztzYumkZv0n2j3V0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWjlX9Co2vB5Whjks4UpOyFeNKTRPZTYgY6w8F8cIylQ&oe=69B564CB"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGz3Q1mt5FUQ7kNvwHjM7Zx&_nc_oc=AdkdPhF8qeNzNLQj-R7TP6HngSy5uEhAxY-0QjYqAA91nE_EwMWhHRzAvSlh3shYZ7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0K-gG22GOYObMPBk-9muIoSCukMKCX7m3z8PUaiDZAQ&oe=69B565FD"}, "is_concept": false, "
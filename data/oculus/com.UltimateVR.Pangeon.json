vil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaO_l8uOr0YQ7kNvwEE-SfJ&_nc_oc=Adr25V99Hx5tyGvRcufollCBCsAgs9nRSzdqLaKZ9DHDcLlxZ44wvfcjT_Dm3uPXd9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0wAWe4UPRfzwPjoIl_DIwLqXebMPUSs-NaVYrfcYk7LQ&oe=69F0B97D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pangeon VR", "platform": "ANDROID_6DOF", "context_category": 
71-25/39035322_1397437880773460_4716594464680409060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epM9kCUw91gQ7kNvwEqVK63&_nc_oc=AdlLbCRwLWsA5h4WmgXcEhlvKFpreXeGKrwUtw_HtCZ_1f8Evs3wiMle0xr1ml9Fr5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywPchRZVAe3DiC-3Lyd1WzhNisd4vdX-P8BlCJxLmM4Q&oe=69AD70A1"}, {"file_name": "4.png", "id": "484815836778535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982532_484815840111868_5288699189366514476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8cqeqYMk_cQ7kNvwGNPeBV&_nc_oc=AdlupZ5tv16aDkVboU1xJ1v6Q62BJBXq36m9xI7bHujZnZd7OoqLu0V6CfZd8CxVY-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU833KQdPnUmEMvrgQJH-GafQmD2tN2LEnLxFaQLWrzQ&oe=69AD85D9"}, {"file_name": "3.png", "id": "332933862328205", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001655_332933865661538_4251527810063043633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0T8uZuqrOMQ7kNvwEY8bCK&_nc_oc=AdnlTOQl45tnLl7FZCq4y2xJ6hjEBeTwdoGb-UbFaTyNMObgscsBmz20YZ0aM6qfo1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypE1B_xV0Z-IbLxzy3eimQSBUOFPn_A6ZIpsPZx8LRow&oe=69AD538D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCvTqesiE9YQ7kNvwHvvZA1&_nc_oc=AdkdslT1z8txiuEDwWW4PomRzmO_YkR72z002IU8b5MEz5n3_4F-Fd_y74x1n824xzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsbxxxK2PpiY3d23utrZFXwo4uwHjmSzeo7nbUdV_nVg&oe=69AD7BCB"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCJYJzzO0fAQ7kNvwHgwk0u&_nc_oc=AdnQ3pMCF4uEeWNsSdoYj0X6BUoXXMsOr_yfAoOYOzx-YpiiJ5fQwdQBreBAnFPPOls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBrYpgWKOVJRNg7nRoqzcYgJ-QuAbaUX6UMuZkkCXWTg&oe=69AD7CFD"}, "is_concept": false, "
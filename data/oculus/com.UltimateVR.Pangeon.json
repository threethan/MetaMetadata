71-25/39035322_1397437880773460_4716594464680409060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-OpkwAO24UQ7kNvwEIW3BV&_nc_oc=Adl-Y5qvrNciw9k0kW3CTBKrPAOp5sW8jTfl3PBTRr5Y5W8i0CaQ29nxi4SsG26Jwbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxb2wdR2en_2ZGGiB7P79d9u6ANA-ZfyXc43T6sx3CWJg&oe=69B7FCA1"}, {"file_name": "4.png", "id": "484815836778535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_484815840111868_5288699189366514476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZN4aIJOAKgQ7kNvwHBPsPk&_nc_oc=AdmvAZoeKwdWlNyeZyN4GFZNw-0_nnJDvPhQlp8rHyIE5I32Oon8Pp3CynomuxdB28w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4e_YvIbjrQnf_HvpEe2FHGTkB4hDWaVXjL-5b1mIrCw&oe=69B811D9"}, {"file_name": "3.png", "id": "332933862328205", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001655_332933865661538_4251527810063043633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6SdiW-YvWkQ7kNvwE5CdFG&_nc_oc=AdmLSB70ILfhVX3K1jWlwMYKnyzaY6KGDDkdHeHZ2swQiHaq_QbFF_IVfQvXVbo6aNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfNsLK0u_jsLJJOAjd_Gq83Cj__fFnvOpwHDxi54splA&oe=69B7DF8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIzMeYq7YnsQ7kNvwFrbZjB&_nc_oc=AdkYH7Rz3C5F6HL4dnUZJ252rbk6rLdTOxM216SCh2k8raB5eKn8ABWaJM67dYtUhQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuIAloEOsaiTUY9AbQhSf2oawUEZbOvZckrvHkdWwW2Q&oe=69B807CB"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT-oPIIJTrUQ7kNvwEnx3zo&_nc_oc=AdnAAJb4oF5RW5jqKGNoEmErZWtO2a55zT4oV6PSIVAbdPfeVC0GXyteIES24J6aIRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMh8ranoxR7jWt-zNjCRfF_dpLy1BVJBXlXZMmOPNP9w&oe=69B808FD"}, "is_concept": false, "
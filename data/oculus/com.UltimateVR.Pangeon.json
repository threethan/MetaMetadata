3_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6SdiW-YvWkQ7kNvwE5CdFG&_nc_oc=AdmLSB70ILfhVX3K1jWlwMYKnyzaY6KGDDkdHeHZ2swQiHaq_QbFF_IVfQvXVbo6aNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfNsLK0u_jsLJJOAjd_Gq83Cj__fFnvOpwHDxi54splA&oe=69B7DF8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIzMeYq7YnsQ7kNvwFrbZjB&_nc_oc=AdkYH7Rz3C5F6HL4dnUZJ252rbk6rLdTOxM216SCh2k8raB5eKn8ABWaJM67dYtUhQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuIAloEOsaiTUY9AbQhSf2oawUEZbOvZckrvHkdWwW2Q&oe=69B807CB"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the brand new version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
71-25/39035322_1397437880773460_4716594464680409060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9UsvdvMZ50Q7kNvwH8hvXG&_nc_oc=Adl7XVCxfs7pBnjHFOqTp5-05AMaIYPvirEXDdiYVSOK2pmEmYMJaItF9en6YPxr0UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHEfW-IdP3c8lm5ZyoKqIuKv0Z-iXJy7HDrOBNrVQ7sg&oe=69AEC221"}, {"file_name": "4.png", "id": "484815836778535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982532_484815840111868_5288699189366514476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8cqeqYMk_cQ7kNvwGkR6Rp&_nc_oc=Adkl6F7IK7iou8dtv7Tevh982E02lX94xWRARFkdBOvJcOJrLjq9lYGMQhInT1kW6wY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5o_s3SVat34ml47ooScdtbCOAij0OOHC4aufCJApAAQ&oe=69AED759"}, {"file_name": "3.png", "id": "332933862328205", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001655_332933865661538_4251527810063043633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxFAyHo8qTQQ7kNvwE-YFL3&_nc_oc=Adka2gIlGxF4iyXOFo5bW17xTh3GXjzyAwxGIuARefNr4PbUF2xJ4tWz_AMFoi6G_G8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKG7LBPkr4Z47hYL2A2_CLkcN1sO0fyZhr4oR1UesQGA&oe=69AEA50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "741062293761933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_741062297095266_6438739400357250316_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcuR22NM0dYQ7kNvwE2AkEp&_nc_oc=AdlD9_aSigPFuMimjkmG6BClQmKFZvZbOib47de4xcxvtsaxex1R_e1uzoFnS_qBOsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSTlvssepb7nfdvrdoyNqOGRR8bgZrdGVzVZO1_7Z_2w&oe=69AECD4B"}, "display_name": "Pangeon VR", "keywords": [], "long_description": "Our adventure party has discovered the world of VR and wants you to take up this new challenge and conquer the VR version of Pangeon.\n\nFight your way through to the bottom of the so-called Pangeon - an organization located in a dungeon that we know very little about (well, except the fact it contains something that has the potential to destroy the entire planet Earth) - eliminate the evil, and save the World from a potential tragedy.\n\n- A mix of many roguelike games combined into a fun (although short) experience\n- +7 levels, various in looks, enemies, and loot\n- +8 weapons to use - ranging from daggers, swords and ending on magic staffs, bows, etc.", "short_description": "Pangeon is a singleplayer roguelike inspired by dungeon crawler classics. Dive right into a dungeon on a suicide mission to kill all the monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ultimatevr.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ultimate VR SA", "support_website_url": null, "website_url": "https://ultimatevr.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2021969171335586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_1272314956633726_9188066131137210387_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCJYJzzO0fAQ7kNvwEav5Zx&_nc_oc=AdlwMkYADG5-DnokA6jyAVUbKGMMxw-njr4MTW81O6-Jy1QBh8J2KrwX2gwwucPrhR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwmz9nhzLBdY1-_G8GwWoOr2SLTVYLTMy-lTFL0MZIPpg&oe=69AECE7D"}, "is_concept": false, "
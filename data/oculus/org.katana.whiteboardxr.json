uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1J44ClL9VgQ7kNvwHrPs4Q&_nc_oc=AdmG6ySlGZJg__AyrBQtc8Q9fp1MwqljrRWCE9shlaqGOqYrQA_HowyfNCoCGNZ0I2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7Rda4YM1yoQtZsGs_gBQhOANM3U94HPPmeSeg3W7HwQ&oe=69A6CE33"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTcTK3AsKMEQ7kNvwGdyfaP&_nc_oc=AdnYNgwaexuqec_dQpgRHLg7RXfjAGp4BBJ2uDaFIO--46NJFKgqDA37uD4jMWyzCfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCbBaGwv41PFi-nOU__lUHZwBYPmQca1_D61BJWYU1bA&oe=69A6C977"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4g7v_aqf80Q7kNvwE19c1N&_nc_oc=AdnZ4Wd0NvGhrHRPxhVUHBFc9TdoImLxSAmKfOm2ijo4JrsOnin3Z7OMoKzOl5aZF8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7kfK7oWXkXn_pgC7FFiqEN0Nbb1WarglL-fQM3NYluQ&oe=69A6D7F3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mePaq6guk5gQ7kNvwFRNBod&_nc_oc=AdmMnk5AO5UEwf1PDDRcXBD8sJV9aMRU1nXG84EXn2VwpxI_DELtyfdQtri-jrqV5CM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1s0Tx33Z1NUhS1Rr8Np30i9c3SWwlaCPb-Xo9elqUoQ&oe=69A6F2C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1aAdX9Lm0kQ7kNvwEklRLV&_nc_oc=AdlMyI6Ex5Rl3LCP82fIEOo61E92RqpimuHV99iyiTztkJO2PtIpuwZzkbfOLJ4Qn-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2ALgHDVZbS6efQqqIo7SKZzjdkgdkJkYlTOmwuCcdIw&oe=69A6E710"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylr-eRvQgbMQ7kNvwEtzuEM&_nc_oc=AdnS-dfFjJEwJG73fVQsCI64c3hvMG4fjQajJNaqvxYv2pZjy-tTNInwQA5buJT-jUw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft86HcW4xuYj8Jmwh7qSA1IpIQZAzFnPSJECZl_ki85LQ&oe=69A18833"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-mouoJWC2kQ7kNvwGyqw8H&_nc_oc=AdlkCH3QFSWuWpzwY_Q-3SPkDuLQkdDpPgqFoO7DKZGcYLE_T1TEQ1Be0ZyfJqe-m-E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsSA3FWykQ6tgkA5UL6WYOAvvWDdOaB2boCvXGLIxxseg&oe=69A18377"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzi1BhPvzQoQ7kNvwH-emcE&_nc_oc=Admye5Gel7sXjDHioak13wuvxsHBmUa9OzkEqpTXTnL06F8rRZwLAXGECZ8lstTGZ7U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuHnvM-vGQf-sQV5BHm8fDIE1-ohwVvqLFIAD40EI34zg&oe=69A191F3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRa4XBBO4BUQ7kNvwH6j4a_&_nc_oc=Adma5BkzMKNHuHWKbVHnFIitB3bFKbS24a1ZYAWkzTu5TMqXfylvyUpVC6n5QG39lvs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftyQq5r6v5VxJVyiZNPBUJtq_Uf2Qlwe7YYY5pIfdrClQ&oe=69A1ACC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg2yQDCcStYQ7kNvwHhh5Jh&_nc_oc=AdkkqC5XqIpc5_WOI-lpIN6LFiD9LaIoSFRls79jSThEAmK5yNiMJrSCFNk64s2vNsQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft2PoClIeJFTSGTo4Al31VfDwtIW1IjgxJwWASjXHMVwg&oe=69A1A110"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
nshot4.png", "id": "439764715421457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u_19qdyRsoQ7kNvwEwhqX7&_nc_oc=AdlklagTehR19vZ9dA597Unhz_pzzj1ZuXGRMw6fRzux9bvRHMKFNq-r6es5PQqVDoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmfu1pz9_EI1PHMfmdXsxQfaaRKk_0UoucRnKU_pZJog&oe=69AD65B3"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhRXd7Vma1UQ7kNvwHnJjms&_nc_oc=AdlT0p15GtJmxUSXt3CvKGymHbql3FKJsD3Xdoy-uvDFJq1t24h2kzW9vMsJ2tp9_JY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBCawW_qhdpykgDL1kbfE5BiiZR0YR034g3f4LWnF_ng&oe=69AD60F7"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOp6YhJ5NbYQ7kNvwFQxRdh&_nc_oc=AdlF9zypBuDi0VMGlX1Jhnzh0YwfJVwlctXLGG-P6HleepdHKNiior7kFkaTVlYwzfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxujpCNDhRDS__OELFoCoCJxcZ9qBee78s1VOhb5w62Cw&oe=69AD6F73"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTzvJ8NXrxIQ7kNvwH0cXZt&_nc_oc=AdkqnC-ttDvMhET3mq8Bz54i103i0ch8pJIh9lu1Gwx1zpjPvonuSabuoxi8wQh7x2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1hK5OF4Dppmfxf2bg2l2ND_8mAbKcI5EZK73mLS3bNg&oe=69AD5203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHdt-wk8nX4Q7kNvwFKsWJI&_nc_oc=AdmKnIBEaKWgedqGKnWY0291Y3BlIikK7JHWlviqmpPhBbccTaYH0UbTUXoB2jOwweg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykbjfdoFqOWIb51LlbNoAl6JMjNJd0mL8TL-vsbR6XhQ&oe=69AD7E90"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking
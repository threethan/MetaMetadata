AjcNvMs7OtSeS8Q&oe=6A972AF7"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBloFq3vNYsQ7kNvwHIxdyK&_nc_oc=AdqlnNGPKk5EJonK3wkf0Dlgl567UFmvfud9Ggt4q-mKX6WEDBfoYUUJ284PwUz8b7M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRWvwDa_kiE8FFPcXLOZyOyF4tJeADHSFdEnogCZnjJQ&oe=6A973973"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNECpHbleq0Q7kNvwGo5LrO&_nc_oc=AdqmJ0yzBqRy0fc6Z2B5LDyZtb4MgHp4-j4f5jcAveLjtk4SleRlyS8XgOO4zKaai9E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiVOfzxKYnPR94sTvRyQs39TrB3RdnPWNzg7EBrMwGdg&oe=6A971C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYBDDIN26CsQ7kNvwEymwb0&_nc_oc=AdoUPdYy5iwktiJLKsbrTTc3gf8Wj2wJ69n790MPs_8Do-lz35jhW_aOvBOoPB_NmCw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjp5Qo1sBaGs5PicCfnE3lKjmdUElLeeJ9EQgHdX2wMA&oe=6A974890"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "817983180235387"}]}, "baseline_offer": {"id": "817983180235387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1716583020, "status": "PUBLISHED", "id": "817983180235387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25007217592265740", "version": "2.0"}, "id": "788471716530653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7353648491382589", "is_concept": false, "lat
iqXPyGGfZRYLY2Izcpwqljz7ZLvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYR2FbjK3IjZ4tDXh1_VElExuUQ8xmPx5mq1Q_yWoSaA&oe=699D9D73"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tGPV3iLquoQ7kNvwEwgdo3&_nc_oc=Admj-G3n3saWmZ6ywrXIwDX90ftuBWk2R1XNjtPk_ws0OyWgkpOdrn_b8IdRlrGWz2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3n__ddRW-TDGp2ftI_sTj7hFxZXWwINGztjkBzT5X4Q&oe=699D8003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks9U51xEcrwQ7kNvwGjO-YZ&_nc_oc=Adm030bmHy7G5dF9zQNoV20ACtKYfh_t1zhKIDtezwoATE4vkRl3dBsk2B6mJfOmOMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXwsT5c5ib4OMKvakUA_ArSvxz8cuT-DFo3MPpt5J3XA&oe=699DAC90"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboa
uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYJtDU6immIQ7kNvwHonbOr&_nc_oc=AdkWZfRFX0v28P6SPEjbCGE4JwCRHan_5nnxioJTyHvure4VUIgEyZlds9rKk9Uuhj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyfEmyryo8tTsEPoeGbUy8GHjj4FjcXHhiCSSVS8xCQw&oe=699D93B3"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-XzB02ItYwQ7kNvwFjtkit&_nc_oc=Adls8aLE1ZFrmYuKfr3oeRYSwTgvrh0KZVLNnI1lOnU7yPzFDoKqyL_TNRi3aAXfAK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCV15ZYNU02OEHrJPL50_eBKqAccGBV596jGiOHQvmeQ&oe=699D8EF7"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLyHywbZa9kQ7kNvwGQGs2n&_nc_oc=AdkAoVzxCQyg8YTXbyP2YCUl4eS2kuqWSmKtEjGiqXPyGGfZRYLY2Izcpwqljz7ZLvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYR2FbjK3IjZ4tDXh1_VElExuUQ8xmPx5mq1Q_yWoSaA&oe=699D9D73"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tGPV3iLquoQ7kNvwEwgdo3&_nc_oc=Admj-G3n3saWmZ6ywrXIwDX90ftuBWk2R1XNjtPk_ws0OyWgkpOdrn_b8IdRlrGWz2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3n__ddRW-TDGp2ftI_sTj7hFxZXWwINGztjkBzT5X4Q&oe=699D8003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ks9U51xEcrwQ7kNvwGjO-YZ&_nc_oc=Adm030bmHy7G5dF9zQNoV20ACtKYfh_t1zhKIDtezwoATE4vkRl3dBsk2B6mJfOmOMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXwsT5c5ib4OMKvakUA_ArSvxz8cuT-DFo3MPpt5J3XA&oe=699DAC90"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
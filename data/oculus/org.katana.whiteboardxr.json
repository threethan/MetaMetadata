uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhoVZf5tF1wQ7kNvwH4hVcD&_nc_oc=AdoXQxdKbVdG5dfxMt5dysOr-Hs6Jj2g4qK_7SOBpMB82Q-tU_JQCd61ciT8reApP-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af13v7NSVT7U-u9gh0w_Nso670fssvvXO6xCwqlRQwL6lw&oe=69F0A233"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo81wRAvHscQ7kNvwGnfwwB&_nc_oc=AdqLY9vSbiQzVTAUnfK40oCjwfPe1rjB5HJltiwW9D6zjxD7ZSLuElMIMIfYRXwRdY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3Kc92zNyaO1O0y7xGkvIxpaXBlup2sLbtQwCQSusIftA&oe=69F09D77"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbqU2FDuIIgQ7kNvwF4j8As&_nc_oc=AdqEeGomCSNsA3a3WF6nGjHV0xuzsJHLjH5PlaLmANuhaK0E4_99009xp6H3qaWp9x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27TWlDWqcykjj8OjRiOmhFiOS-VRtsQy9MqjxjaVcL_A&oe=69F0ABF3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ2wWDfL1jAQ7kNvwHY3_zq&_nc_oc=Adq9jX0e4DtJPOfN_mjxXVct6KNLTo5gNQH5rwumc2S4tK5TywxncXA3mB4lRjgkIGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af35UDSulCTfa7n_UseCSoUAjwmbvrLYUd_ht3lp_KdJXw&oe=69F0C6C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR6-xZidWXsQ7kNvwEmLQ9f&_nc_oc=AdqPdetIMYf3vh9LeLaogdRpp53lXfITIi1i3w9Yltmshl_KN36zkFLrFgbkxu-NMtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3ZEePELXPS5erxUtI46X3A1d-iOlzBetYGUqG27tHGEw&oe=69F0BB10"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
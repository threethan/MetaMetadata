2ijo4JrsOnin3Z7OMoKzOl5aZF8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7kfK7oWXkXn_pgC7FFiqEN0Nbb1WarglL-fQM3NYluQ&oe=69A6D7F3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mePaq6guk5gQ7kNvwFRNBod&_nc_oc=AdmMnk5AO5UEwf1PDDRcXBD8sJV9aMRU1nXG84EXn2VwpxI_DELtyfdQtri-jrqV5CM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1s0Tx33Z1NUhS1Rr8Np30i9c3SWwlaCPb-Xo9elqUoQ&oe=69A6F2C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1aAdX9Lm0kQ7kNvwEklRLV&_nc_oc=AdlMyI6Ex5Rl3LCP82fIEOo61E92RqpimuHV99iyiTztkJO2PtIpuwZzkbfOLJ4Qn-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2ALgHDVZbS6efQqqIo7SKZzjdkgdkJkYlTOmwuCcdIw&oe=69A6E710"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboa
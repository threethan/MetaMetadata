uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYJtDU6immIQ7kNvwE1eU5j&_nc_oc=Adk1igkhO1Q5NcuQ-t97p1zJgwqvwcQwt9qvpdSN0zOr804HIZZdGCsgDVo7OWyhcp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfujlpCdc3N7nckFI_GH3eR9yeSZ2wUbOcc08BRxOPkapw&oe=699C4233"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-XzB02ItYwQ7kNvwEEViHH&_nc_oc=AdlatSHDy4_9QsbyZCGOYu99g8IW0twua5kB4wZl4dRGy50_w8gWQQ3wb4wEsrNXtmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftWdYXOzredYj-HTNl1lgb_Epol8gkIDGBD9nbTZr2SUg&oe=699C3D77"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLyHywbZa9kQ7kNvwHGWWrs&_nc_oc=AdkHtGTqkXAJYX24OWIsSMpr_RcuLqgV1UQq9I79FLIqpl9OJHXjIpfG87_r5v5jK8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftXS3R20Dr8j7JZLMyhE2MKl_QfTn-PqBz9VkeMrp4PKw&oe=699C4BF3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjMoCRi9HEQ7kNvwFfnQ92&_nc_oc=AdlOUZGqhZpyPUuMUF_osHnUWMDav5n6-vZ0a9Zicgr03DV8EyZpK6h5Xgo8fZUKAPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBzIyVku6D184qP_hJ8O8GTEfb3v1nUy5rDDi6UrbYMA&oe=699C66C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-z2_q4a4wQ7kNvwHQ83KF&_nc_oc=AdlNXB7yqgnTPSFetY9LRyYQRXuiJW9yyS5SVD1doviU6ZCJz0uU7Ho2D4BLpgQ7jbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuiXhxEqiXJWZgJYvBaBscNJ1VS0_ltfIFm1DpdstVibQ&oe=699C5B10"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
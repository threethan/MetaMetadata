gB6AJJzyk6SPI1VQXye8OVpQTSzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftNuN_QnQj2MwYVAFVtVO3qkhrh7JHKqaVbmMeJjsNaIg&oe=699AFA73"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjMoCRi9HEQ7kNvwGjLYZ4&_nc_oc=Adlzty8dmgxhgkDZN5Qk1YY5g_tnsG26krzR_AdEX4BpOS-CDeJmiIathzmQrG_46qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSKAFhloe01mBhGJ98gG38C954nSX1OF2FvA7AV0TYWA&oe=699ADD03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-z2_q4a4wQ7kNvwF11tjQ&_nc_oc=AdlbjhgZVndb8TMvijKfEggfQRuEauZm2QqcpPrPA4QmlsUv0D26EtuXKIy5Ei8-hko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvfHLWnc-5eZC8olfecSCBEAKS7Gb5H_MfK4xIn_0xgWw&oe=699B0990"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboa
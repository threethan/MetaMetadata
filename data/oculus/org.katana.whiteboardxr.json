uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkU4mhzdc4kQ7kNvwHnxPPd&_nc_oc=AdlDAy1tubTGM5v0lCWC80G5MzE93jZ0ImLiVDhAuqk3gL5PZjVv7IbeIZzKhXRFcr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu4wLgouyBz6AphqCECR3oSIvuupJY6gpCDo53rEKqfOw&oe=699AF0B3"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-XzB02ItYwQ7kNvwEFWD1b&_nc_oc=Adnp9oTosexPaiBORlCbjJNxAB1hwCQjUsRpLT1cjkwMaEl0ePr78MPI4GNe9aVkyNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfujIL06nda2Eb1_JD8zYWXCmPyI1PD8o0z7fiUXPW0emw&oe=699AEBF7"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxV5D1-YXPMQ7kNvwEXcnqE&_nc_oc=AdnquaKad2ubmzfmFL-cWP_Vtb2ijZOPaqVIwzjgB6AJJzyk6SPI1VQXye8OVpQTSzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftNuN_QnQj2MwYVAFVtVO3qkhrh7JHKqaVbmMeJjsNaIg&oe=699AFA73"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjMoCRi9HEQ7kNvwGjLYZ4&_nc_oc=Adlzty8dmgxhgkDZN5Qk1YY5g_tnsG26krzR_AdEX4BpOS-CDeJmiIathzmQrG_46qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSKAFhloe01mBhGJ98gG38C954nSX1OF2FvA7AV0TYWA&oe=699ADD03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-z2_q4a4wQ7kNvwF11tjQ&_nc_oc=AdlbjhgZVndb8TMvijKfEggfQRuEauZm2QqcpPrPA4QmlsUv0D26EtuXKIy5Ei8-hko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvfHLWnc-5eZC8olfecSCBEAKS7Gb5H_MfK4xIn_0xgWw&oe=699B0990"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
9PT5RQ6Smu8JWNjnm0wDvPSLjJzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft4CQ5C6i4cFHDHcr2Ysv_w6qrsZ2Bo58ciBjbqNZoKww&oe=69985773"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMNNtEzZuvcQ7kNvwE69MPe&_nc_oc=Adlz6dYU8mIoRjjjIbz6fYY5pVA-a7lhf_9qXTMz2Ogh-17eREyeehMaM-9zbIZcpn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftlKIeB1ySvuPsE_OgUaS9_0XCTnwst2MczC6FkpkHHDg&oe=69987243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5U9zH820XEQ7kNvwG9IbsE&_nc_oc=AdmHk8G4gEsmJX7KzbNBaxTqWHH9hLBjrLCFS1jUyj42uN4d_we8Ck7mljIQSLsU9mE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftcTGW0voim3oVEmVQScrESBGFhn6lmQSS6X1BRoohx5w&oe=69986690"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboa
uluscdn.com/v/t64.5771-25/38982634_439764718754790_324634813400039303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkU4mhzdc4kQ7kNvwEZGlEE&_nc_oc=AdlWHOdzLMYB_MT1-hwV0hBZWfUDIfFAsxo0Z6nTt-Lm2bMcBZDXguo2XcFTH6hd-xU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudLb8YsivVu3Q235MiWqYBoIW29kitJR0DxGQGDd5tiw&oe=69999F33"}, {"file_name": "screenshot3.png", "id": "1402586973787125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035394_1402586977120458_4731010777511337368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z3O9cbo35MQ7kNvwFksWup&_nc_oc=AdnpmAJxasoBbKZLRw-W82_6fqA0FSaO7Iy9MSTs8ueqD0sm5JnUeQjO7vSrSbLkUmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9NA4tPrc47KgVqpddNEy-PmlHQEjR59eBWqIixwvQTw&oe=69999A77"}, {"file_name": "screenshot5.png", "id": "419123221047104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982654_419123241047102_365603553195041247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxV5D1-YXPMQ7kNvwH1pOD1&_nc_oc=AdntMFB1zrKlAh6Ma2dOo3OTxtaBRDLGBtmed3NKEtx_Llfo9j9I85mbxqpxo5SW50M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuogXSkq0pDFOp2j9Y8pLYIPEimIb95APFJz_xdGAv4oA&oe=6999A8F3"}, {"file_name": "screenshot2.png", "id": "1426207118025390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556798_1426207121358723_2648143554158698554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjMoCRi9HEQ7kNvwECpc42&_nc_oc=AdmBIKXFJ4zo2JBwnaflFNUp18pFOBiWZ2WGZ8rxdZ6NNT24yFaXWBF9Ct8CEOzkV6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSieGxPzBINvSgv1oRrnauA_wU8gvNP0SySwKDRlbBdg&oe=6999C3C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "990589445769829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_990589449103162_6151257044926900171_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG-z2_q4a4wQ7kNvwFquSdW&_nc_oc=Adn8H0kBfBl688EbbOwBbA6fjlHm7eR_fVLQHS49Yrw4TDYyDgRozSormHSF2rNhON8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsttBgEY-Z49OjxZA874c_zepr7mflbIDxv2oIB5b3cdQ&oe=6999B810"}, "display_name": "WhiteboardXR", "keywords": [], "long_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's Pictures folder onto real life surfaces. It supports images scaling and transparency, and works great for tracing transparent line art images onto whiteboards.\n\nThis app is best used with transparent images. The app will not automatically remove the background or trace out an image, only display an image onto a moveable plane.\n\nThis app does need permission to read from the internal storage to access the images to display. A stationary boundary is recommended. Also, the window for drawing will center on your POV during start up.", "short_description": "WhiteboardXR is a standalone app that allows you to trace images loaded from your Quest's storage onto real life surfaces. It supports images scaling and transparency, and works for tracing transparent line art images onto whiteboards or chalkboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odachivr.art/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "OdachiVR", "support_website_url": null, "website_url": "https://odachivr.art/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7353648504715921"}, "review_messages": []}]}, "cover_s
KijvLOZ20JL_TdLzpQ7dHRltudA&oe=6AFB29FC"}, {"file_name": "Screenshot 2026-09-15 at 6.13.50\u202fPM.png", "id": "2305082193599173", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300738_2305082196932506_6161857897463946903_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zi7SzjY1X4Q7kNvwEqpsk7&_nc_oc=Adp0rqpl3GqO8iCHaGPfBmzcZAJY4eaO9cTwcSR0DqVe9Yvgr0cQrMg4tm3q3O3jA6k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPmQovxsf_8xuuiI-r33jCmmaTlmZZmjwvAv87hZAHmg&oe=6AFB2DF5"}, {"file_name": "Screenshot 2026-09-15 at 6.20.38\u202fPM.png", "id": "2310002223151647", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294643_2310002226484980_5314344715002547281_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov8-ucVf7yYQ7kNvwG4Tbzi&_nc_oc=AdqECBxYC2ta38fxgJqMUcryBSvhlOng-yi80kLTYt5G_snYtWW4NO5w_8nP5DiZqnc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL2ijLFbcHbqGUaomKSCbqlGnjgoYfQ7p9mqVjTadbYA&oe=6AFB29FB"}, {"file_name": "Screenshot 2026-09-15 at 6.21.44\u202fPM.png", "id": "2082878855659022", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310596_2082878858992355_2922133381572737299_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTWKvwMTAlsQ7kNvwGmDC8z&_nc_oc=Adr0M50nHl1ouRB1l0grMLSLbQubKqhJTzFWoGhl3Y_sT3ludY5q6CCOHeYSqX0WXzk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7havjhnD7L3dBvt_OPVO-Uf-tN8JcqY_eFTCFwbiYmg&oe=6AFB3C53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rabbit", "keywords": ["Horror", "Rabbit", "Fox", "Survival", "Scary"], "long_description": "\ud83d\udc30 **WELCOME TO THE RABBIT!** \ud83e\udd8a\n\nThis is a survival horror game where 9 rabbits have to survive against 1 fox.\n\nEach round lasts 6 minutes, and the fox is trying to catch every rabbit before the timer runs out. As a rabbit, you\u2019ll have to explore the map, collect carrots, find burrows to hide in, and try not to get caught.\n\nIt sounds pretty simple, but things can get stressful really fast when you realize the fox is right behind you.\n\n### \ud83e\udd55 CARROTS\n\nCarrots are scattered around the map and are useful for both rabbits and the fox.\n\nIf you\u2019re a rabbit, eating a carrot gives you a speed boost for **8 seconds**. This can help you get away from the fox, reach a burrow, or just get around the map faster.\n\nYou can also collect carrots and put them into your storage during the round.\n\nThere is one important thing to remember, though:\n\n**You can only sell your stored carrots if you survive the round.**\n\nSo if you collect a bunch of carrots and then get caught by the fox, you won\u2019t be able to sell those carrots.\n\nThis means you have to decide how much you want to explore and how much you want to focus on staying safe.\n\nThe fox can eat carrots too, but instead of getting a speed boost, the fox gets a different ability.\n\nWhen the fox eats a carrot, it can **see rabbits through walls for 7 seconds**.\n\nIf you're hiding somewhere and the fox uses this ability, it might be time to start moving.\n\n### \ud83d\udd73\ufe0f BURROWS\n\nBurrows can be found around the map and are one of the main ways rabbits can hide", "short_description": "Welcome to the game! You play as one of 9 rabbits trying to survive while a fox hunts you down. The fox is the hunter, and its main goal is to find and eliminate every rabbit before the 6 minute round ends.\n\nAs a rabbit, you need to explore the map, collect carrots, find places to hide, and most importantly, stay alive. There are burrows placed around the map that rabbits can use to hide from the fox. If the fox is chasing you, getting to a burrow can give you a chance to escape and stay hidden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rabbit-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Skipper", "support_website_url": null, "website_url": "https://sites.google.com/view/rabbit-vr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2243426743107154"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1574098523630847"}]}, "baseline_offer": {"id": "1574098523630847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791295200, "status": "PUBLISHED", "id": "1574098523630847"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2283315402451621", "version": "0.4.1"}, "id": "1084609167571771", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2192433161539846", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2283315402451621"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1084609167571771"}]}, "change_log": null, "created_date": 1794434886, "id": "2283315402451621", "version": "0.4.1", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files":
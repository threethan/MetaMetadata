nc_oc=AdprUQxTPWkzvwjzhLFlh_2zmc1Gmfs4BXigjXFke_mH4PLhXCqIdWGrqkzPP5NjaUM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2opcS9-joH38GG7zt1OZoIywcnJdKB5Z2qUXoTh9iug&oe=6AFC82BD"}, {"file_name": "screenshot_attachment_3.png", "id": "3261285097386731", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499305194_3261285107386730_2361341929222847187_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--BjCp0ZitEQ7kNvwFwh-Mo&_nc_oc=AdoVShvTI5yY3m9Z1UztwSZEfIOac6_NWUl2w6Z6LmF-nO9V7VMTgUg-FEl9-hGS7es&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRBf-I8MM4S3oaDg5tYkdoxg0DdZwEfQ4I8Jv9pTKqrg&oe=6AFC9580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "H3VR2Trailer_Logo_Flag.png", "id": "1612924426589053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_1612924429922386_1994103761780407784_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4YCmIy_F0QQ7kNvwHxT3lD&_nc_oc=AdrUJy2eGLgx0whLwhCGhPZDwnygoXXZWUb6UJgXPE9JrQqcB8bb6-cDLgU0bnOExaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx_zUM384PuVBQitHooPR8oeAh-mh-yeeMmHMUAMdiQw&oe=6AFC6011"}, "display_name": "Hot Dogs, Horseshoes & Hand Grenades 2", "keywords": ["guns", "shooting", "loot", "roguelike", "action"], "long_description": "Shoot, loot, and scoot as a sentient hot dog in the sequel to Hot Dogs, Horseshoes & Hand Grenades (H3VR), the award-winning, best-selling Immersive FPS. Master an arsenal of the best guns in VR. Fight your way through an endless proc-gen megastructure. Chill out and plink on the range. Wonderful!\n\n{1280454694176844}\n# Enter the Facility\nYou are The Handy. Part field engineer. Part tactical operator. All Beef. Arm yourself and deploy into an endlessly reconfiguring megastructure that\u2019s slowly tearing itself apart. You\u2019re the only one with a chance of surviving The Facility, and discovering the truth of its decay.\n\n{2426748107797451}\n# Deploy - Fight - Loot - Extract\nGrab a loadout. Deploy to the Facility. Fight its denizens. Loot what you can. Extract to your base. Build your armory. Each run makes you stronger than the last.\n\n{945456604747940}\n# Endless Replayability\nEvery run of the procedurally-generated Facility brings new surprises. Unlock new gear, challenges, and upgrades as you play. \n\n{1326126452669375}\n# More Ways To Play\nH3VR2 continues the original\u2019s spirit of experimentation and letting you choose how to play. New to firearms, virtual or otherwise? Our Certification Range is here to train you up. Looking for intense Competition, chill Arcade Shooting, or aimless Sandbox vibes, we\u2019ve got you covered!\n\n{3161821924002264}\n# Guns, Lots of Guns\nJust when you thought VR guns couldn\u2019t get any better, we\u2019ve gone and done it again. MORE realism. MORE complex gun handling. MORE ballistics depth. MORE authentic audio. MORE opportunities to configure your perfect shooting experience.", "short_description": "Hot Dogs, Horseshoes and Hand Grenades 2 is a Tactical Roguelike Shooter. It\u2019s a full-fledged sequel to the premier Sandbox Gun Sim in VR. Prepare, learn, train, practice, fight, loot, repeat. Experience the next generation of our virtual firearm tech. It\u2019s endless meaty mayhem. Wonderful."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rustltd.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "RUST LTD., Creature", "support_website_url": null, "website_url": "https://rustltd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
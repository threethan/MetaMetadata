//scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823943_1457950518563602_4144567172407260079_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew6dry4MwTsQ7kNvwEvf_v8&_nc_oc=AdqKGO1n3EDwAjZghZZ2M_S5fsB89dNga09EfdWwebAdlRfwXO5bLsxKrZ7BDiuvRQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RV_ca-5lny0E80mVJJaSdN_R-fN4GzOdF_ou9pWyb7w&oe=6A1C3BB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "fable tag", "keywords": [], "long_description": "Fable Tag invites players into an enchanting world where classic storybook heroes and villains come to life for the ultimate game of tag. Choose your favorite fabled character, each with unique abilities and special powers inspired by their legendary tales. Race through beautifully crafted fantasy environments\u2014from mystical forests to enchanted castles\u2014while chasing or evading your opponents in high-energy matches.\n\nWhether you\u2019re \u201cIt\u201d or trying to avoid being tagged, strategy and quick reflexes are key. Use your character\u2019s skills to outmaneuver your foes, set traps, and turn the tide of the game. With dynamic multiplayer modes, customizable characters, and regular updates introducing new legends and arenas, Fable Tag offers endless fun for fans of fantasy and competitive play alike.\n\nDive into a world where stories come alive and every game writes a new legend\u2014are you ready to be the next hero of Fable Tag?", "short_description": "Fable Tag is a fast-paced multiplayer game where players step into the roles of legendary storybook characters in a magical game of tag. Use unique powers, outsmart your rivals, and rewrite the fables in this thrilling blend of fantasy and action!\n\n"}]}, "developer_name": "Bigboi studios/fable", "developer_privacy_policy_url": "https://sites.google.com/view/fabletag/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.c
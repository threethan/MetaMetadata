c_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVULMijQzOc7bv33TeYhAjamt-FqUD3cjAQ20nHbYoIA&oe=6AEB3CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1064505399317307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1064505405983973_7931895581044050686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQctUxir4AsQ7kNvwHPL3SL&_nc_oc=AdpGrDcwm6N8ZAfNxTYQ9ZJU8cBTSL4TZfRLRQlIgcAMIdSp1DIrzb_GwcVz2mU3BK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbBE2Ug2eKKFefcbUdTyY6xZwYnITDIEoXFkd0L7qMVg&oe=6AEB5B34"}, "display_name": "Area 51", "keywords": ["alien", "shooter", "ufo", "pistol", "scifi"], "long_description": "They told you it didn't exist.\n\nEighty miles of desert, one gate, and no record that you were ever here. Walk in past the guard post, find the freight elevator, and go down. Hangar 18 is only the first floor.\n\nFour hand-built levels, each one deeper and worse than the last: the floodlit compound at dusk, the hangar with the recovered craft still on its pad, the containment wing lined with specimen tanks, and the research lab where whatever they recovered stopped being a specimen.\n\nYou carry two pistols. They are all you get.\n\nFEATURES\n\n- Four full levels connected by working freight elevators, each one sealed until you have cleared the floor you are standing on.\n- Two kinds of alien, and they sound different in the dark. You will learn which one is coming before you see it.\n- Dual-wield automatic pistols with real recoil, muzzle flash and ejecting brass.\n- Room-scale movement with snap turn and comfort options throughout.\n- No player death. Getting hit pushes you back; it never sends you to a menu.\n\nBuilt for Quest 3 and Quest 3S.", "short_description": "A restricted facility in the Nevada desert, four levels deep. Get past the gate, ride the freight lift down, and clear Hangar 18, the containment wing and the research lab of whatever they have been keeping alive down there. Dual pistols. Nowhere to hide."}]}, "developer_name": null, "developer_privacy_policy_url": "https://area-51-vr.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiviewgroup.com/gamestudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231435126729127"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2924887921203390_6872893199988947985_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePe2_dm0b2UQ7kNvwEys9VG&_nc_oc=Adrp00V1aiBVg3-jvwwFMQJ-O774eXLQ84dVRF8iexAXo9Wz-zbiMj2qU-hfvoT-t1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFCrFPFaUkPFyz4SKme2OAJZ3hXvLDQG3RVRPxnsr_3g&oe=6AEB5D1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Area 51", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1789474920, "lastRevision": {"nodes": [{"id": "1231435133395793", "release_type":
 the Unicorn BCI Core-4 EEG headband. These are wearable brain-computer interface (BCI) devices that record electroencephalography (EEG) signals from the scalp, enabling users to control applications using their brain activity.\n\nFor more information, visit: www.gtec.at", "short_description": "Unleash the power of your mind and navigate your way out of the labyrinth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/b3e72fb8-5769-4234-b391-9ebf13755cd7", "developer_terms_of_service_url": null, "publisher_name": "gtec Medical Engineering GmbH", "support_website_url": null, "website_url": "https://www.gtec.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27322060367381955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "975153775183329"}]}, "baseline_offer": {"id": "975153775183329"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780824660, "status": "PUBLISHED", "id": "975153775183329"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28495778460010134", "version": "0.1.0"}, "id": "1588791575761647", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application
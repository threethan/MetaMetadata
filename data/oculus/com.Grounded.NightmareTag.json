m&_nc_ss=7f20f&oh=00_Af3XS964XTFgCWsuZOGkx4y2MXBLpEW1VQfJZNemeeGS9w&oe=69F73EC1"}, {"file_name": "Trailer.00_00_30_23.Still001.png", "id": "222821904141208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974812_222821907474541_2052841613157010489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhWLBRiaT40Q7kNvwEk4yYM&_nc_oc=Adq7KynvAIa3PyFqWp5YWsy2NJjSA_R3dS77QugLC7NoJ1FMGslMGZF0HkfgdKsZcDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Zsu7KgzJXhAAVhwDaLfHQgAOyvgyuwRuOylDskQvp2w&oe=69F76581"}, {"file_name": "Screenshot 2023-09-10 180945.png", "id": "1003308547591264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974663_1003308550924597_4301389862031791654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYW7vngD8y8Q7kNvwHrLbev&_nc_oc=Adq0ToC_JBjKafd_gCRx6_iOK1R52Q6j9p7Lbdhlq0VCf4tf1bK7PDcCI79Qrx1MKYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fi08MJ5mzFAvWdIo5S1FReBk5qyE1ZylghGXcqyc97Q&oe=69F747A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_V6.png", "id": "2017596495808088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819476_2017596499141421_5783729764535329801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkFgaPkyw4EQ7kNvwHh_fJF&_nc_oc=AdrTIc-vtAhp-QEYSh-LSgWdrcmnBnhx4h5aH97J9IEVtvSiS-2JSHiaQl12Gjcda8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NPW1awJbJaRgtoD87TY152PfBX849qBjAkvaJPsKdxw&oe=69F748A2"}, "display_name": "Nightmare Tag", "keywords": ["Multiplayer", "horror", "pvp", "scary", "tag"], "long_description": "Nightmare Tag is a PvP horror experience packed full of INTENSE CHASES & JUMP SCARES! Be one of the mortal humans trying to escape the experience. Or, become the blood-hungry monster to terrify your friends! This game will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! \n\nBECOME THE NIGHTMARE: \n- Find & chase your friends before they complete the objective!\n- Two playable monsters with different customizable abilities\n- Unique controller motion movement to run, jump, grapple, and tear humans apart!\n\nRUN AND HIDE FOR YOUR LIFE: \n- Join your friends as you run and hide from the monsters!\n- Hide by remaining completely motionless, making you invisible to the monster\n- Physical running motion allows you to sprint when you are found and need to escape!\n- Your flashgun is your only weapon, use it to see where you're going and stun the monster!\n- Use your scanner to locate the monster, reunite with other humans, find power-ups, and find the objective.\n\nMULTIPLE GAME MODES:\n- Quick Tag\n- VHS Run\n- Elimination\n- Capture the Fruit\n\nPROGRESSION\n- Gain XP from playing games\n- Unlock new Characters\n- 9 upgradable perks for the Monsters\n- 8 upgradable perks for the Humans\n\nGENERAL ADMISSION (IAP):\n- Unlock full progression system\n- Required to unlock Mimic and Charles\n- +3000 tokens", "short_description": "A multiplayer PvP Horror Experience packed full of INTENSE CHASES & JUMP SCARES! In Nightmare tag, you can either be one of the mortal humans trying to run and hide for your life, geared with a set of surreal tools. Or, become a blood-hungry monster to terrify your friends! Nightmare tag will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! "}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/vrdevelopment", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SOCIAL"], "has_in_app_ads": null, "internet_conn
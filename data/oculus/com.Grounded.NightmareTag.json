2783578632717843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80OWAhLjtyQQ7kNvwEmX-Ud&_nc_oc=AdoAkEWdhSq26tTeiPnElybS2bf6Q2rk9ZdildB2qUSq3BHttSliJU6GFaZBB7CFSuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3dzxgP6Sit_kI9fDPBfSktuArH7QAnMhJColpUtE_BYA&oe=69F1F8C1"}, {"file_name": "Trailer.00_00_30_23.Still001.png", "id": "222821904141208", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974812_222821907474541_2052841613157010489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkyGLHw3Y-4Q7kNvwFpREUd&_nc_oc=AdoAo8IwH-hefrEMvcdN62-uY815a8i_TV0DpLxUxyMFKAuVPzeUROg4L4Aq0xsTWgY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af23IANuNXbvwldyzJxymaOXeuNEUtN51RPRB9RDQuWMVQ&oe=69F1E741"}, {"file_name": "Screenshot 2023-09-10 180945.png", "id": "1003308547591264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974663_1003308550924597_4301389862031791654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSpntMgGo-YQ7kNvwERZQZx&_nc_oc=AdqeEhWkOY6va9MgUfMiwCfEYDLuQFEfjlibx7sGzzzfdAb0tHs2ooNL3R5LZKn5ID4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aR_u7_STpFN7m70myN1-Ew-q6VX0up1z3KmZyJa4R1w&oe=69F201A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape_2560x144020.png", "id": "6675375442547548", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982461_6675375449214214_374955904288494240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL150-bwZowQ7kNvwEmxRli&_nc_oc=AdpuylV2pnBaraHhcslzk8fItFNyrKJRHwSX2YZjSWVNAr5aXXSaRPupzYFcgI51d-E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1Mobs8ud_C0Qe6QYeRDzdqp775AF3vo4tVnLSdIjXZVg&oe=69F1F37A"}, "display_name": "Nightmare Tag", "keywords": [], "long_description": "A multiplayer PvP Horror Experience packed full of INTENSE CHASES & JUMP SCARES! In Nightmare tag, you can either be one of the mortal humans trying to run and hide for your life, geared only with your flashgun, scanner, and a variety of surreal attachments. Or, become the blood-hungry monster to terrify your friends! Nightmare tag will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! \n\nBECOME THE NIGHTMARE: \n- Find & chase your friends before they escape the liminal Dreamscape!\n- Unique controller motion movement to use your claws to run, jump, and tear apart humans!\n- Track & hunt humans using your many abilities!\n- Eliminate all the humans to win as the monster\n\nRUN FOR YOUR LIFE: \n- Join your friends as you Run and Hide from the Nightmare!\n- Hide by being completely motionless, making you invisible to the monster\n- Physical Running Motion allows you to sprint when you are found and need to escape!\n- Your flashgun is your only weapon, use it to see where you're going and stun the monster!\n- Use your scanner to locate the monster, reunite with other humans, find power-ups, and find the objective.\n- Complete the objective win as the humans!\n\nMULTIPLE GAME MODES:\n- VHS Run\n- Quick Tag\n- Elimination (requires General Admission)\n- Capture the Fruit (requires General Admission)\n+ A variety of game and map settings to shake things up!\n\nGENERAL ADMISSION (IAP):\n- Unlock 6 more zones\n- Play Elimination and Capture the Fruit", "short_description": "A multiplayer PvP Horror Experience packed full of INTENSE CHASES & JUMP SCARES! In Nightmare tag, you can either be one of the mortal humans trying to run and hide for your life, geared only with your flashgun, scanner, and a variety of surreal attachments. Or, become the blood-hungry monster to terrify your friends! Nightmare tag will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! "}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Enver Studio", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/v
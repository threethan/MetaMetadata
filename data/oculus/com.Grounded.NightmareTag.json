e": "Hero Cover_V6.png", "id": "1161961516126010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822723_1161961519459343_8041830002944576632_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2hduJmiZjgQ7kNvwEY0oFy&_nc_oc=Adls_VdkBk5-f5Ez2odv2Rb-Auh1nQwk-ZTHMn_eKKSfODblaGeTBU05FFlI0631qnE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvqCftZxxbUCwONwU-ZeEf_FPpJN19nArM_EyITEhHqUA&oe=69A57281"}]}, "id": "1508398597960938", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2023-07-01 153903.png", "id": "3151034505205916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982461_3151034508539249_6569976495400496386_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMskvRazOCQQ7kNvwEkVzjC&_nc_oc=AdmUa7JcdVn3m1j_qtoclUZFDsWXYG4NK92uibO3Cyc02i36ZAB6k4j0tqJigUb6xDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuxeq0Oiy3ZIo8a9YdFlf0UJZ6EPVI9HG_9U0eoTef5nw&oe=69A574DD"}, {"file_name": "Screenshot 2023-09-08 133257.png", "id": "988025082484613", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982659_988025089151279_6146952839061566164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yARKHYnghKYQ7kNvwHmytE3&_nc_oc=AdlLdVHQIHoFZ9QOKZy3sw5fb_FNbmr8ArIBAM-TQdZn9mRQWQ8IZ9HzRZyvbQbLkA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuVy4PG0uApitPafLjx4hUWyS7UIi39KZw8rZYXiOlFwA&oe=69A59DA8"}, {"file_name": "Screenshot 2023-09-08 122812.png", "id": "996168804943983", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974635_996168808277316_5512783578632717843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al2CJZO-RnQQ7kNvwFkC3KH&_nc_oc=Admgzz0E3II91DjLFCitwXguxWRgAXQA75u2UAYPgKWabi5oFkvdmQqqd5D768GaS_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu74mcVNMXgBq9TErgtSl1qP4j_Ma1nSGLlAD8U54n5OQ&oe=69A581C1"}, {"file_name": "Trailer.00_00_30_23.Still001.png", "id": "222821904141208", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974812_222821907474541_2052841613157010489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZeCOcKIq6cQ7kNvwEaaYMu&_nc_oc=AdkgE6fBEyNfdTVJMmryE3gqWnRCbgup9rY8c_-cpCwSh4R-KOwYpwPjYcbbVz5qaYo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvtphkjaVZpFTfFRlY0JSv-wnKNvyAKUQHjFSkokrp1eg&oe=69A57041"}, {"file_name": "Screenshot 2023-09-10 180945.png", "id": "1003308547591264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974663_1003308550924597_4301389862031791654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQfVwYtz-hQQ7kNvwGn8-DD&_nc_oc=AdkefJjntiyA3pYMw0o1jS6A8jBM6UnITqzLNTHo9B1V_9XhqtwNu2gXbKDMF6uqcME&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfueJpLssi0nqs4TCqdymlCcpsMlDolSx3FQ5og5lIO13Q&oe=69A58AA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_V6.png", "id": "2017596495808088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819476_2017596499141421_5783729764535329801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKvFgzwC-eQQ7kNvwGbCC1L&_nc_oc=AdlOcCntOOldGrKJs_xnvvNXhQUlIJ_YzFhOMIsAj6teOa9U0MX6yF_YP_sgxmMvoMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvPtlTf3zpQSjoBlEXuWdQsI3P4lzl_kMDjEIp2RXubqg&oe=69A58BA2"}, "display_name": "Nightmare Tag", "keywords": ["Multiplayer", "horror", "pvp", "scary", "tag"], "long_description": "Nightmare Tag is a PvP horror experience packed full of INTENSE CHASES & JUMP SCARES! Be one of the mortal humans trying to escape the experience. Or, become the blood-hungry monster to terrify your friends! This game will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! \n\nBECOME THE NIGHTMARE: \n- Find & chase your friends before they complete the objective!\n- Two playable monsters with different customizable abilities\n- Unique controller motion movement to run, jump, grapple, and tear humans apart!\n\nRUN AND HIDE FOR YOUR LIFE: \n- Join your friends as you run and hide from the monsters!\n- Hide by remaining completely motionless, making you invisible to the monster\n- Physical running motion allows you to sprint when you are found and need to escape!\n- Your flashgun is your only weapon, use it to see where you're going and stun the monster!\n- Use your scanner to locate the monster, reunite with other humans, find power-ups, and find the objective.\n\nMULTIPLE GAME MODES:\n- Quick Tag\n- VHS Run\n- Elimination\n- Capture the Fruit\n\nPROGRESSION\n- Gain XP from playing games\n- Unlock new Characters\n- 9 upgradable perks for the Monsters\n- 8 upgradable perks for the Humans\n\nGENERAL ADMISSION (IAP):\n- Unlock full progression system\n- Required to unlock Mimic and Charles\n- +3000 tokens", "short_description": "A multiplayer PvP Horror Experience packed full of INTENSE CHASES & JUMP SCARES! In Nightmare tag, you can either be one of the mortal humans trying to run and hide for your life, geared with a set of surreal tools. Or, become a blood-hungry monster to terrify your friends! Nightmare tag will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! "}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/vrdevelopment", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "suppo
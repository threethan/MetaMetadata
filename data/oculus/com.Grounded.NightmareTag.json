3s-76eyDOiQ-0dr-qfJQ01PZIqgWbJQ&oe=69BE8E41"}, {"file_name": "Trailer.00_00_30_23.Still001.png", "id": "222821904141208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974812_222821907474541_2052841613157010489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwNU4cdftSgQ7kNvwFsmtju&_nc_oc=AdkHZZBZi8j9Mte6v_6DOIazMUhc_Ne3hLcoEOdN3UXi4uSqpGbEcQeTG_paAOeuvFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySvxEHivBWFptOvI9BQZyQefKOg2OXBzRbKURa6DjXOA&oe=69BE7CC1"}, {"file_name": "Screenshot 2023-09-10 180945.png", "id": "1003308547591264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974663_1003308550924597_4301389862031791654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyEJ9ZeUjDcQ7kNvwFWeL5I&_nc_oc=AdknvUSYqvAg4LfH5cmOHhAP6H6ij6VRDfKLBKSFFWQNlPC2yfjA_qfR2hWFa_eDcMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7wj2ooXUi2oXLqTdFPoY_wnqT-iy4qjIqIRGuAZKzxA&oe=69BE9727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_V6.png", "id": "2017596495808088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819476_2017596499141421_5783729764535329801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbi91BrTvBoQ7kNvwEyzQDY&_nc_oc=AdlfY5wv0KJGXnEjMvssPy9IzSvnHsZbetD0QP19MiYcta-VNWIJ3YzdWhFT_Fj8z20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB1JttC25dtU_3CVfwohBy7JInejrguVW4hHMleVpOkQ&oe=69BE9822"}, "display_name": "Nightmare Tag", "keywords": ["Multiplayer", "horror", "pvp", "scary", "tag"], "long_description": "Nightmare Tag is a PvP horror experience packed full of INTENSE CHASES & JUMP SCARES! Be one of the mortal humans trying to escape the experience. Or, become the blood-hungry monster to terrify your friends! This game will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! \n\nBECOME THE NIGHTMARE: \n- Find & chase your friends before they complete the objective!\n- Two playable monsters with different customizable abilities\n- Unique controller motion movement to run, jump, grapple, and tear humans apart!\n\nRUN AND HIDE FOR YOUR LIFE: \n- Join your friends as you run and hide from the monsters!\n- Hide by remaining completely motionless, making you invisible to the monster\n- Physical running motion allows you to sprint when you are found and need to escape!\n- Your flashgun is your only weapon, use it to see where you're going and stun the monster!\n- Use your scanner to locate the monster, reunite with other humans, find power-ups, and find the objective.\n\nMULTIPLE GAME MODES:\n- Quick Tag\n- VHS Run\n- Elimination\n- Capture the Fruit\n\nPROGRESSION\n- Gain XP from playing games\n- Unlock new Characters\n- 9 upgradable perks for the Monsters\n- 8 upgradable perks for the Humans\n\nGENERAL ADMISSION (IAP):\n- Unlock full progression system\n- Required to unlock Mimic and Charles\n- +3000 tokens", "short_description": "A multiplayer PvP Horror Experience packed full of INTENSE CHASES & JUMP SCARES! In Nightmare tag, you can either be one of the mortal humans trying to run and hide for your life, geared with a set of surreal tools. Or, become a blood-hungry monster to terrify your friends! Nightmare tag will have you and your friends screaming, laughing, yelling, & sweating until your headset runs out of power! "}]}, "developer_name": "Grounded", "developer_privacy_policy_url": "https://www.groundedfilms.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grounded", "support_website_url": null, "website_url": "https://www.groundedfilms.ca/vrdevelopment", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "r
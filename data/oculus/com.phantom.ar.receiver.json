006108290_2298093858752791040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUhqOpetToIQ7kNvwFVlMSL&_nc_oc=Ado2AjCBr7Uf0htSrKcvZGDWmGqQSLwQWoPV8mJuCe0XvbybwrnpgpxqSvsfnDRc-7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0p_qrjMNGvoEXMeSSnK1U5ZvdlOmDVndQl4l7Ljxy9A&oe=6A689CCB"}, {"file_name": "good8.png", "id": "1874861916511019", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312236_1874861919844352_803476674099400568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVDW48pWU0sQ7kNvwET6-lV&_nc_oc=AdrN9GEsvl360oXXejEWuDFjbVatGTLgwZM5toJQb7yJsqPZ60TJ4dD3ECpUisHI5hw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH6ajcVTzUYyepwLZj8zy1_-_tNpYb_aaymlGbgdtp9g&oe=6A68AE6C"}, {"file_name": "good7.png", "id": "1290586959866720", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824665_1290586963200053_2756332514316972826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fTMdwRkjh4Q7kNvwHoOKA1&_nc_oc=Adp4Ho5y-mh1xeKzNyohnkEUQ7y0qUtChbW5-6E_6ABMhf_15v8MpWD5wbCLzeAyPdU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl8lFe5C1tlvOkT1q7x_YVLW_ZFPydYI3p54PneTmoSQ&oe=6A68B6AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phantom AR", "keywords": ["hologram", "passthrough", "mixedreality", "streaming", "camera"], "long_description": "Phantom AR turns an Android phone into a real-time mixed reality hologram source for Meta Quest.\n\nUse the Android companion app to capture a person with the phone camera, create a room code, and connect from the Quest app. The Quest app displays the streamed subject as an AR hologram in your space, with support for passthrough and optional voice communication.\n\nPhantom AR requires the free Android companion app to stream video from your phone to Quest:\nhttps://phantom-ar.site/android-apk/phantom-ar-sender.apk\n\nKey features:\n- Real-time Android phone to Quest streaming\n- Mixed reality passthrough experience\n- Room code connection flow\n- Optional microphone voice communication\n\nPhantom AR is intended for teens and adults 13+. It is not intended for children under 13.\n", "short_description": "Stream a real-time Android phone camera hologram into your Quest mixed reality space"}]}, "developer_name": null, "developer_privacy_policy_url": "https://phantom-ar.site/privacy", "developer_terms_of_service_url": null, "publisher_name": "PhantomAR", "support_website_url": null, "website_url": "https://phantom-ar.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1228796255027646"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36826753973605600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_1236838371856315_8629448095266997278_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_eVFgts_CcQ7kNvwF1l0LJ&_nc_oc=AdpHVFQkRc7nUd7pnhJH-1G1EtcuXLujOZr7tkWhEukjKgw8-eSeQO0v6j97xQ1B4N4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyHjP5kQnPGKbaKxoYcjUdtzeHSH2y0D_vijsIOhhprg&oe=6A689A1B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Phantom AR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Communi
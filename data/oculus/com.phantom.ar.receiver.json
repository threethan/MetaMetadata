87_1360717006108290_2298093858752791040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcjLK63fxxYQ7kNvwFp4-EK&_nc_oc=AdpgL_DXhSC8IhwBTV00M9Xmm0Uis5z2Ph9sXJhS7Tcc7eEpN9iIAMkNNFq2fnFUOi0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHK-EYmrCub1dFvOZZRMgXZObQjs-keemI6Dq8a_3peg&oe=6AA9364B"}, {"file_name": "good8.png", "id": "1874861916511019", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312236_1874861919844352_803476674099400568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be1KYweeJ4wQ7kNvwGVFN5R&_nc_oc=AdrcC_rUXfvSONyitGjOL5aU3AumESSJly6cp8hSxfUI-tUpSVwnGk-Wy8q_i9d3ffg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3bADTzGG2rYYiGu6omCEerc46wuOsLj3lIwgKxMUmig&oe=6AA947EC"}, {"file_name": "good7.png", "id": "1290586959866720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824665_1290586963200053_2756332514316972826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KECme05FuHUQ7kNvwENbZnx&_nc_oc=AdrQgmkmE-ZajRaR8T5dqE6q54AjyzFx3ZcRTrfE8FkbiWtCrp7XGUfd_CQ0APiKxoc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkDDuocB_gF33dy29dayc6bjIl1UAyg8prKmUkzrNRaA&oe=6AA9502C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phantom AR", "keywords": ["hologram", "passthrough", "mixedreality", "streaming", "camera"], "long_description": "Phantom AR turns an Android phone into a real-time mixed reality hologram source for Meta Quest.\n\nUse the Android companion app to capture a person with the phone camera, create a room code, and connect from the Quest app. The Quest app displays the streamed subject as an AR hologram in your space, with support for passthrough and optional voice communication.\n\nPhantom AR requires the free Android companion app to stream video from your phone to Quest:\nhttps://phantom-ar.site/android-apk/phantom-ar-sender.apk\n\nKey features:\n- Real-time Android phone to Quest streaming\n- Mixed reality passthrough experience\n- 
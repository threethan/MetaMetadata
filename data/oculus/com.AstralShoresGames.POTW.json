FGXTRM2qRaE5Y71n5RiKtxvtR8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMQO2c_uZfe9Nogvam3YTnFR2JOsfmMcs1M1VLZ7YKvw&oe=6AAE8E5F"}, {"file_name": "Screenshot 5 (16_9).png", "id": "1543401544043066", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623384_1543401547376399_3466113532864333506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIBxiWcd65UQ7kNvwEHMgb7&_nc_oc=AdrjPTdf4XVQOceNDZIh7yXayGxdC0zCrYnjmbw88jFv3WuQI6m0quS4YzSXJL90P44&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJM-e3l0h1ciPb5yZL6UFebqnMi2TBNpkM_9sGiDA7cg&oe=6AAE8955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (16_9).png", "id": "1013941954421137", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622276_1013941957754470_2602000232011089269_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1UnQBWWZgoQ7kNvwE-zvgB&_nc_oc=AdrW7YctMmgiCc_U2s3M-AHigQB7TzTVdBmZplA5KsanNyNaXd5C5zbfvPICu3zFsy4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtFTlTXhfsZELPUgFysKO_pbE_7dCx1iFHWjaYm2TOxg&oe=6AAEAE22"}, "display_name": "Puzzles of the World", "keywords": ["Puzzle", "Cozy", "Relaxing", "Travel", "World"], "long_description": "**Puzzles of the World** is a cozy puzzle-building game where you relax, travel, and assemble beautiful wooden 3D miniatures inspired by iconic landmarks and destinations around the globe.\n\nBuild **7 handcrafted wooden puzzles** across **7 stunning destinations**, including:\n\n* **Yasaka Pagoda** \u2013 Kyoto, Japan \ud83c\uddef\ud83c\uddf5\n* **Venetian Gondola** \u2013 Venice, Italy \ud83c\uddee\ud83c\uddf9\n* **Lakeside Cabin** \u2013 Banff, Canada \ud83c\udde8\ud83c\udde6\n* **Eiffel Tower** \u2013 Paris, France \ud83c\uddeb\ud83c\uddf7\n* **Taj Mahal** \u2013 Agra, India \ud83c\uddee\ud83c\uddf3\n* **Machu Picchu** \u2013 Cuzco, Peru \ud83c\uddf5\ud83c\uddea\n* **Arctic Igloo** \u2013 Svalbard, Norway \ud83c\uddf3\ud83c\uddf4\n\nEnjoy a relaxing puzzle-building experience enhanced by serene visuals, dynamic music, and immersive soundscapes tailored to each destination.\n\n**Detailed Wooden Puzzles**\n\nAssemble intricate wooden 3D miniatures made from hundreds of unique pieces. Each puzzle is designed to feel tactile, with satisfying piece-by-piece construction that slowly brings every landmark and scene to life.\n\n{3481857601965494}\n\n**Beautiful World Destinations**\n\nTravel across a variety of cozy, stylized locations inspired by places around the world. Each destination features dreamy visuals, its own custom music track, and immersive environmental sounds that make every level feel atmospheric and unique.\n\n{3476643469164644}\n\n**Comfortable Building Experience**\n\nBuild your way with Quest controllers or hand tracking, follow clear step-by-step instructions, and use helpful in-game tools to control music, adjust sounds, read bite-sized location snippets, and enjoy each puzzle at your own pace.\n\n{1358828186213227}", "short_description": "Build, relax, and travel in **Puzzles of the World**, a cozy puzzle-building game where you assemble detailed wooden 3D miniatures inspired by iconic landmarks and destinations. Explore beautiful immersive locations, enjoy satisfying piece-by-piece construction, and unwind at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.astralshores.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Shores Games", "support_website_url": null, "website_url": "https://www.astralshores.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
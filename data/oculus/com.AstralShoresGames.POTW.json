ame": "Screenshot 1 (16_9).png", "id": "4607490466188243", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624606_4607490469521576_5520525343223246162_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er6XAP-fqCwQ7kNvwEDEOkq&_nc_oc=Adohafi3OHcsdqah_Eb1PnyL7ciizQJ52An0jV-IliWkubfnfu2W4M6jNKpIq__RY0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREf7_BHR9Yt7y1S9PjUVbmTITdPuCW70SpDQw8AlR_hw&oe=6AF8A617"}, {"file_name": "Screenshot 2 (16_9).png", "id": "2316775159146042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593784242_2316775165812708_6278914163288353402_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aehgNfHs-YQ7kNvwHfe4oM&_nc_oc=AdqBs9XyJQFUQS35DXXiMRgfvPNXSZ3NDJZQCmdis7N91Stj7fb_aRNTJn_u8NBn-38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMWTZ6StJr5_pRwJHcDdy-azmrYVHrl7ZBZuRHaUscPA&oe=6AF8AB8C"}, {"file_name": "Screenshot 3 (16_9).png", "id": "1774902360255525", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593983210_1774902363588858_3686600252728733379_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FaYcQ1KfggQ7kNvwFsfyA6&_nc_oc=Adr_rbFj0-hK9h8Yv0nREea6z0-ic8Hk-Ux-N-aTGQXczZ9MJy0XVUStgAuQ71neE8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNL9L2uxDCaw4anEAT__px6XfXGZj4oTp0jSLDLmH0wA&oe=6AF887EE"}, {"file_name": "Screenshot 4 (16_9).png", "id": "26836779552685599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_26836779562685598_4385023523869815480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfPm-YlBBEQQ7kNvwGO18if&_nc_oc=AdqGtXqk037fdAXCe86NAYsfPLmzAm8I9ywIGgplMFpk0flbWqZSSvDG4YkTPTfSst0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4-3_AgDQ3KZb3gXbYZz2d9LW-YU3I4ti0G1ARXvVP8w&oe=6AF87E4D"}, {"file_name": "Screenshot 5 (16_9).png", "id": "1608040813737145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620316_1608040817070478_1440638357148656356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZBhVYvkD1QQ7kNvwH1ZTuw&_nc_oc=AdrDqBB2YAp3AhvV5t6NO-6h-n6XeRRJTvi5kEPzS4bexvfX3xbc8j9y3uU8gH4rsn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx02TQpOo18qJifdUhy2IRKv0HUxzony5-X4xP9lC9FA&oe=6AF8937C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (16_9).png", "id": "1005475415164611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_1005475418497944_2625561805415309206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMyLaVNcbFQQ7kNvwEdy1ku&_nc_oc=AdrJLy3ufKcqWtKFsJK-OC8NfLNli5kn_scx2ls1VvqnZ3xp2-YGPshHFG7RLhdZWy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYcXBQmEvCzAawrg7oSHX3-Nb0fCepWC5o-8gN5JNYrA&oe=6AF897EF"}, "display_name": "Puzzles of the World", "keywords": ["Build", "Miniatures", "Relaxing", "Cozy", "Travel"], "long_description": "Build the world, one piece at a time. **Puzzles of the World** brings the joy of building wooden miniatures to beautiful places you can explore.\n\n**Build Miniatures**\n\nBring iconic landmarks and charming scenes to life, from Kyoto\u2019s Yasaka Pagoda to the Eiffel Tower and the Taj Mahal. Discover the satisfaction of assembling intricate wooden miniatures, piece by piece.\n\n{2313346372786937}\n\n**Relax and Explore**\n\nStep away from the table and explore beautifully stylized destinations. Unwind with atmospheric sounds and an original soundtrack by Markus Zierhofer of AudioCreatures.\n\n{1376899420965537}\n\n**Take In the Details**\n\nDiscover detailed patterns, warm wood textures, and laser-cut edges as each miniature comes together. Lean in to explore the custom-built designs, from ornate rooftops to tiny windows and doorways.\n\n{2466738260801800}\n\n**Switch Between Day and Night**\n\nChoose your preferred time of day and see each destination in a new light. Find your favorite view, settle in, and enjoy the satisfaction of seeing your miniatures take shape, one piece at a time.\n\n{1963485791295381}\n\n**Play Your Way**\n\nBuild with the precision of Quest controllers or the natural feel of hand tracking. Pick up, turn, and place each piece using whichever feels most comfortable to you.\n\n{2332791394242519}\n\n**In Your Space**\n\nTurn your favorite spot at home into a peaceful building space with mixed reality. Keep your surroundings in view as you assemble puzzles right in front of you.\n\n{2094103488646182}", "short_description": "Build, relax, and travel in **Puzzles of the World**, a cozy puzzle-building game where you assemble detailed wooden 3D miniatures inspired by iconic landmarks and destinations. Explore beautiful immersive locations, enjoy satisfying piece-by-piece construction, and unwind at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.astralshores.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Shores Games", "support_website_url": null, "website_url": "https://www.astralshores.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1607831861026200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624592_1135293818878447_9103225418555491568_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXvqiFFUEvcQ7k
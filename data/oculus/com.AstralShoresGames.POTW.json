, "locale": "en_US", "screenshots": [{"file_name": "Screenshot 1 (16_9).png", "id": "4419660318264956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_4419660321598289_6994338770031945904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7n-5B_qSQEQ7kNvwHJMcf7&_nc_oc=AdpTJRxZHnOuWD7Cx0ndKNwJRG84TVSt7OIRdJCv2X3IlNQSAik1I-r1cyiGC8MDlI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP50KNZ7KmDOf9AIhh2CRbCKReY7Gh3zuKmsKanjrqmA&oe=6AF891D1"}, {"file_name": "Screenshot 2 (16_9).png", "id": "2188558335326621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622334_2188558338659954_1961124146894974067_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_LhIRQQpe8Q7kNvwF3FnyL&_nc_oc=AdoNHhSAOZV1DpNp-oWfZIdi_sg_mlrca1nybMEQIc309tFZJ4fVZPz2C57xbDl0lbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJiAbLaFBUinjZg7tVUzeCcc50N_gdsa-oZ2UOSuQ-uQ&oe=6AF893CE"}, {"file_name": "Screenshot 3 (16_9).png", "id": "2516594112112294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_2516594115445627_3264820292284045348_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA05V97ZQSMQ7kNvwHnTCZ3&_nc_oc=AdrrbjTgVzQZqcd0RoIvgS1ekHwYWFiE4_wOtDuC2vDh1BpVaQ2OtgxsaDgaIaPpW0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThntlsdAq_94qe8kWmTet1FHf3tNpeHxS9qW741D4Zug&oe=6AF8AE1B"}, {"file_name": "Screenshot 4 (16_9).png", "id": "1569771048054995", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620940_1569771051388328_5728878085301911057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JqRONdk654Q7kNvwF4ius5&_nc_oc=Adpvd_VgsEET_Tgq-p3kgYv3Pc0aVFzerbgH5qmNGrQ2Kwxg45kVJUXvu-hRfwq37Gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNoGPwZMgT3dEGKEP03qabOeGvTL6wSWtBCldeO7dXOA&oe=6AF89A9F"}, {"file_name": "Screenshot 5 (16_9).png", "id": "1543401544043066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1543401547376399_3466113532864333506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-vTDJNljvYQ7kNvwEfCuw9&_nc_oc=Adq55dFT2Grra8y8R1Vb1Z-D8t7HJZ0V3HVcFZx3fS-2aV2txtkt_1Lb9VVe_jNOyMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8FummIhBmilEIgJ5FvNQTXyGjRfDPiDHZ2WNrYFU3_Q&oe=6AF89595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (16_9).png", "id": "1013941954421137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1013941957754470_2602000232011089269_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCanelTg8U4Q7kNvwHpFsun&_nc_oc=AdqygASU1ZJx_Gy4vl24-XJJHAgrT9kjxXCGC9C34t8HMgfQZeKk1JuJBVLg_Mf1-QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv2eYdPr66y-iYhdjCIczgVLLCq619H9cnqJmS4XjIEw&oe=6AF88222"}, "display_name": "Puzzles of the World", "keywords": ["Puzzle", "Cozy", "Relaxing", "Travel", "World"], "long_description": "**Puzzles of the World** is a cozy puzzle-building game where you relax, travel, and assemble beautiful wooden 3D miniatures inspired by iconic landmarks and destinations around the globe.\n\nBuild **7 handcrafted wooden puzzles** across **7 stunning destinations**, including:\n\n* **Yasaka Pagoda** \u2013 Kyoto, Japan \ud83c\uddef\ud83c\uddf5\n* **Venetian Gondola** \u2013 Venice, Italy \ud83c\uddee\ud83c\uddf9\n* **Lakeside Cabin** \u2013 Banff, Canada \ud83c\udde8\ud83c\udde6\n* **Eiffel Tower** \u2013 Paris, France \ud83c\uddeb\ud83c\uddf7\n* **Taj Mahal** \u2013 Agra, India \ud83c\uddee\ud83c\uddf3\n* **Machu Picchu** \u2013 Cuzco, Peru \ud83c\uddf5\ud83c\uddea\n* **Arctic Igloo** \u2013 Svalbard, Norway \ud83c\uddf3\ud83c\uddf4\n\nEnjoy a relaxing puzzle-building experience enhanced by serene visuals, dynamic music, and immersive soundscapes tailored to each destination.\n\n**Detailed Wooden Puzzles**\n\nAssemble intricate wooden 3D miniatures made from hundreds of unique pieces. Each puzzle is designed to feel tactile, with satisfying piece-by-piece construction that slowly brings every landmark and scene to life.\n\n{3481857601965494}\n\n**Beautiful World Destinations**\n\nTravel across a variety of cozy, stylized locations inspired by places around the world. Each destination features dreamy visuals, its own custom music track, and immersive environmental sounds that make every level feel atmospheric and unique.\n\n{3476643469164644}\n\n**Comfortable Building Experience**\n\nBuild your way with Quest controllers or hand tracking, follow clear step-by-step instructions, and use helpful in-game tools to control music, adjust sounds, read bite-sized location snippets, and enjoy each puzzle at your own pace.\n\n{1358828186213227}", "short_description": "Build, relax, and travel in **Puzzles of the World**, a cozy puzzle-building game where you assemble detailed wooden 3D miniatures inspired by iconic landmarks and destinations. Explore beautiful immersive locations, enjoy satisfying piece-by-piece construction, and unwind at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.astralshores.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Shores Games", "support_website_url": null, "website_url": "https://www.astralshores.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1481842570291797"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2397617480760244"}, {"status": "PUBLISHED", "id": "1874311929884129"}, {"status": "PUBLISHED", "id": "2591212231313644"}, {"status": "PUBLISHED", "id": "27308967582114316"}, {"status": "PUBLISHED", "id": "2092797627939243"}]}, "baseline_offer": {"id": "2591212231313644"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794250800, "status": "PUBLISHED", "id": "2591212231313644"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1602938924848827", "version": "1.10"}, "id": "1751045136058127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1481842563625131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1602938924848827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1751045136058127"}]}, "change_log": "Version 1.10: Build Your Way\nThis update introduces mixed reality puzzling, a refreshed interface, improved visuals and sound, and extensive performance improvements.\n\nMixed Reality\n- Added Your Space, a passthrough location that lets you build puzzles in your real surroundings.\n- Your Space keeps interaction sounds enabled while removing environment music and ambience.\n\nInterface and Menus\n- Redesigned the main menu with updated artwork, interactive puzzle boxes, and clearer puzzle and location previews.\n- Improved main menu rendering for sharper text and visuals.\n- Added the ability to reposition the main menu.\n- Added grabbing and shaking interactions for 3D puzzle boxes.\n- Improved text clarity, layout, and positioning across gameplay screens.\n- Updated the Pause Menu with Resume, audio settings, and confirmation before returning to the main menu.\n- Refined the cabin tutorial with clearer instructions and consistent styling.\n- Corrected inconsistencies when opening the main menu for the first time.\n\nControls and Interactions\n- Improved hand tracking stability.\n- Improved hand tracking and controller interactions with the CD player and tabletop buttons.\n- Refined distance grabbing and controller interaction indicators.\n- Added placement feedback: a white ghost previews the piece\u2019s position and turns teal when it is ready to snap.\n- Added Realistic Mode in Settings to disable placement hints.\n- Standardized starting table heights for a more comfortable seated experience.\n- Improved pause menu pointers and tabletop button visibility.\nSaving and Progress\n- Replaced checkpoint saving with automatic saving after every successful piece placement.\n- Improved puzzle completion messages.\n\nVisual Improvements\n- Refined environment lighting, skybox clarity, textures, and materials.\n- Improved puzzle textures and added laser-cut burnt edges.\n- Updated puzzle and environment outlines.\n- Reduced visual clutter from outlines around foliage.\n- Enhanced completion fireworks with larger displays and thicker, smoother trails.\n- Fixed several water, foliage, overlapping ground, and lighting artifacts.\n\nAudio Improvements\n- Added and refreshed sound effects for menus, puzzle pieces, page turns, buttons, and puzzle box shaking.\n- Improved audio balance across interactions.\n- Added sound variations for grabbing and snapping pieces.\n- Corrected layered music synchronization in Banff\u2019s day and night modes.\n\nPerformance and Technical Improvements\n- Improved performance across locations and puzzles.\n- Optimized puzzle assembly and collision handling to reduce frame drops when moving tables and assembled puzzles.\n- Improved performance as new groups of pieces appear.\n- Reduced texture memory usage from menu artwork and 3D puzzle previews.\n- Upgraded Unreal Engine and Meta SDKs.\n- Updated XR integration and improved OpenXR compatibility.\n\nAdditional Fixes\n- Corrected instructions in the Venetian Gondola building manual.\n- Fixed manual pages wrapping incorrectly after reaching the back cover.\n- Corrected viewpoint positions in Cuzco.", "created_date": 1793309497, "id": "1602938924848827", "version": "1.10", "version_code": 80, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1602938771515509"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1481842563625131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1602938924848827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793223426, "id": "1601947344947985", "version": "1.10", "version_code": 79, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1601947108281342"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1481842563625131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1602938924848827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793155508, "id": "1601140258362027", "version": "1.10", "version_code": 78, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1601140085028711"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "Andr
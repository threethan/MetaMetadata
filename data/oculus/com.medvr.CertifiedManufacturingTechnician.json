4_706214845881483_1220481414707867151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6jXuc7cIi8Q7kNvwE_SuNi&_nc_oc=AdpJrlNaWWYxIaU9sm9AA8xqFAHoKEMhcMpOqaa-cViWQBOc5g6Hgi-Fv0rZe9WKXb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2LPMQnLLOM_7SuSLU8mhukqbNrxhBc6-kkSoRzUpS7Tg&oe=69F09F3F"}, {"file_name": "006.png", "id": "1262369279339576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618252_1262369282672909_5076467394983428840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DjKnZuQJicQ7kNvwFjzUR3&_nc_oc=Adqd-HFbCq26qQY-KUf736PGZA6ZAjwVxjqk41quOURmJonOzErY0ueMn_Cjp6TYnoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1iJ493u5FwFYF5bYz8lYyyQhIt2m7IB2YG7PNFZvKyFQ&oe=69F0C5BF"}, {"file_name": "001.png", "id": "925342933438411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_925342940105077_2331920716148586082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIffNJ1ItX0Q7kNvwFytCNh&_nc_oc=AdprYCdlVPDC-g7rEn-MTD1NdRya0EcxLwIav0LRC967qVvTPOeGL-geBlqc8hK5trA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af37SzdKO1VNqkK4KpOIIfcbCM0srBItpahAyeqq-4u8rQ&oe=69F0C3A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Manufacturing Technician", "keywords": ["Manufacture", "VR", "Immerselearn", "Training"], "long_description": "Long Description:\n\nCertified Manufacturing Technician is an immersive VR training application created exclusively for students enrolled in the ImmerseLearn Manufacturing Technician certification program.\n\nThis application allows learners to gain hands-on experience in a virtual manufacturing environment, helping them build confidence and practical skills through realistic simulations. Students can practice essential manufacturing tasks, workplace safety procedures, equipment operation, quality control processes, and standard production workflows in an interactive setting.\n\nThe app is designed to support skill development and reinforce the concepts taught throughout the certification program. By combining virtual training with structured learning, students can improve their readiness for real-world manufacturing environments.\n\nPlease note that access to this application is restricted to students officially enrolled in the ImmerseLearn Manufacturing Technician certification program.\n", "short_description": "Short Description:\n\nCertified Manufacturing Technician is a VR training application designed for students enrolled in the ImmerseLearn Manufacturing Technician certification program. This immersive simulation provides hands-on practice in manufacturing procedures, workplace safety, equipment handling, and real-world production tasks. Access to this application is limited to students officially enrolled in the certification program.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26289696437361952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_1522464939484939_1812697665977441945_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Onc3zLKkx2cQ7kNvwEu9M6Q&_nc_oc=AdoEncd
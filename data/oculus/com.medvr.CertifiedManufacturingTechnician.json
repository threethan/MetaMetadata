Ow51L8QiNIKrW4Ub0Ew&oe=6AFB267F"}, {"file_name": "006.png", "id": "1262369279339576", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618252_1262369282672909_5076467394983428840_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzT-4o4sVh4Q7kNvwEOxCLK&_nc_oc=AdovoaYdp5yLIp97lLQOiTlM7qBb93dlfzD3GN-R46ywgoY0uSvEO739iTwarmkcl8c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgS122Lw376c-h0DYTJ0lsGARd-RBvo4DvEXBBp3WIwQ&oe=6AFB14BF"}, {"file_name": "001.png", "id": "925342933438411", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619751_925342940105077_2331920716148586082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R97VRHdOjWwQ7kNvwEUtWI6&_nc_oc=AdpeMHq7oyaCrp82BNE3IF2CQ8CWVk4xp0OU27AxS2dzhBF0-ocJR5Qjjx2k7YXwwXs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwSlzGExM_d-5p6nwN9bzxmN0c5I9bSWDTZNWFYgnITQ&oe=6AFB4AE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Manufacturing Technician", "keywords": ["Manufacture", "VR", "Immerselearn", "Training"], "long_description": "Long Description:\n\nCertified Manufacturing Technician is an immersive VR training application created exclusively for students enrolled in the ImmerseLearn Manufacturing Technician certification program.\n\nThis application allows learners to gain hands-on experience in a virtual manufacturing environment, helping them build confidence and practical skills through realistic simulations. Students can practice essential manufacturing tasks, workplace safety procedures, equipment operation, quality control processes, and standard production workflows in an interactive setting.\n\nThe app is designed to support skill development and reinforce the concepts taught throughout the certification program. By combining virtual training with structured learning, students can improve their readiness for real-world manufacturing environments.\n\nPlease note that access to this application is restricted to students officially enrolled in the ImmerseLearn Manufacturing Technician certification program.\n", "short_description": "Short Description:\n\nCertified Manufacturing Technician is a VR training application designed for students enrolled in the ImmerseLearn Manufacturing Technician certification program. This immersive simulation provides hands-on practice in manufacturing procedures, workplace safety, equipment handling, and real-world production tasks. Access to this application is limited to students officially enrolled in the certification program.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26289696437361952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618254_1522464939484939_1812697665977441945_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_QYq-Q_N9IQ7kNvwG9KstY&_nc_oc=AdqKevGRSCpqh1ot70foOgFLnRJYcfoETzeR9PhFR3IeszNYzmEofvfkcbTWl9MuokY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_RUsVVZmTqYyl8uJV9fXkV5vJr_1xPsO
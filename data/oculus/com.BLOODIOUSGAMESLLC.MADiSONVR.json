wQIqQTjepwQ7kNvwFjr8mq&_nc_oc=AdpufK9xslEukxUN9JTMd84Hgo7aqwiqYSfjkraRvyB0_iFnxSWKIA8GhnNLxW3ddmU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIapjcKid4rbR_vp-5YHscsDeFo8wrNPUGowWmNUqFpVQ&oe=6A9AEC80"}]}, "id": "1087209856409610", "locale": "en_US", "screenshots": [{"file_name": "ss5.png", "id": "908398331251509", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982581_908398337918175_4360524429943302752_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt4GsmaBUWcQ7kNvwHa5xDf&_nc_oc=AdqVyLS77_mGOgMa8ahNRSSYH3iSHeVKpAB5h2Bzb7FgJRuANLm1qTw1wi2gqsq7-mU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfGXXaij7jg33VHAA9FLGI4Tbj7g1T8G74k86gLPdQMw&oe=6A9AC100"}, {"file_name": "ss3.png", "id": "906278708101895", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307249_906278711435228_1294603081593494376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfXbTI2N_NEQ7kNvwF01nDc&_nc_oc=AdrUO-B9M4r8OFY8y0s6fYlNPvf5s6zxX9m43T914LAB3C1owS2fM2BH4I4AaW4DFAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuXBhoQ94e4zkV-GYE4rr4L-Wgq3A88YXQdqoHLzYs2g&oe=6A9AE6DE"}, {"file_name": "ss1.png", "id": "1510132379663413", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570296_1510132382996746_5467417863881995495_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKw0YrkLZTQQ7kNvwHf8qvh&_nc_oc=AdqldDARvrvmutV18Om0Sg1Iz4Jt5YX5mS11lsKGXbAUuB5yfsZob27KsGVmMhXKBlw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsFNTugnbwqa21V6GaKhTkW1770TSBy8n0EDoF8ELL2g&oe=6A9ACC00"}, {"file_name": "ss2.png", "id": "820732743358387", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982555_820732753358386_2034495332364331082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJTox6qryUQQ7kNvwFeZ9y0&_nc_oc=AdpzdDPfWSZMrx5hMHgLUIota5eMTSdsdenIFRbRwPvAqMVGWlLnh9OS4s0IOQZwnZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-WJbNrmICvhOhbVuyFrK3flUoI0JKKfVByAezniG_Vw&oe=6A9AD239"}, {"file_name": "ss4.png", "id": "1099970795021302", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031341_1099970798354635_3888168239788767634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKfUybTtNw4Q7kNvwE2FHB6&_nc_oc=AdoXQ0oyIeX0K6TOef-AU1aO4Le1-s9c_E0H76M9T9sy0Lya3hfI6p83OG3_kIhJqzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5bNHNeUyOM7QudRXeiF--COVvdg3Km8be07RRHMGykg&oe=6A9AC58D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MADiSON VR", "keywords": [], "long_description": "Science does not lie. \u2018The Science of Scare Project\u2019 confirmed the award winning MADiSON is the scariest game EVER!\n\nAnd the scariest game ever just got even scarier, as MADiSON is being re-made in VR.\n\nWhat would you do if you awoke locked in a dark room, hands covered in blood \u2013 your sister and mother massacred?\n\nMADiSON is an immersive and terrifying first-person psychological horror game, featuring disturbing gameplay and an unsettling and compelling narrative.\n\nWith the help of an possessed instant camera, connect the human world with the beyond. Solve puzzles, explore your surroundings and most importantly, survive. Throughout your journey you are haunted by MADiSON, the ghost of an evil murderer, who is forcing you to continue a gory ritual started decades ago and commit abominable acts. She wants you to finish her sinister ceremony. Do you have the strength to resist?\n\nIt\u2019s not just her that you need to worry about. There is more than one evil entity in MADiSON and every character has a disturbing story that blends seamlessly into the main narrative. Use the instant camera to survive this torture. Develop photos you take manually and face the fear of unveiling the truth. Search everything, pick up elements and interact with them to survive. Random events and changing puzzles throughout the game assures a high level of replayability as you get lost in this immersive and terrifying experience.\n\nWatch every step and be careful not to attract any attention. You won\u2019t be alone.", "short_description": "The scariest game ever, just got even scarier."}]}, "developer_name": "Bloodious Games / Team Beef", "developer_privacy_policy_url": "https://perpgames.com/2024/11/12/madisonvr-meta-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9428827553799023"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2324926521585111"}, {"status": "PUBLISHED", "id": "2115072649073655"}, {"status": "PUBLISHED", "id": "2105814377019380"}, {"status": "PUBLISHED", "id": "750781668024367"}, {"status": "PUBLISHED", "id": "1577278656682037"}, {"status": "PUBLISHED", "id": "930897906094516"}, {"status": "PUBLISHED", "id": "1432046625221216"}, {"status": "PUBLISHED", "id": "696198940092366"}, {"status": "PUBLISHED", "id": "892488203300167"}, {"status": "PUBLISHED", "id": "683867614415864"}, {"status": "PUBLISHED", "id": "689490353664087"}, {"status": "PUBLISHED", "id": "1418450339211151"}, {"status": "PUBLISHED", "id": "1564242194704961"}, {"status": "PUBLISHED", "id": "1964607187405769"}, {"status": "PUBLISHED
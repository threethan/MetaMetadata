_2034495332364331082_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFhntJvzqkAQ7kNvwEORfbm&_nc_oc=AdooK-o4ZdmFVg0e25VQBWSWkvt7oquZ3_dxFXeag27uEFwOH4eXUkBPN_AUt_BM0UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_In6p0JH2CX7oCt9vchmZr_yry60ZQvjTsSWK_udDlg&oe=6B05D3F9"}, {"file_name": "ss4.png", "id": "1099970795021302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_1099970798354635_3888168239788767634_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81z5I0CL_mkQ7kNvwHXb1NF&_nc_oc=AdpRblIT5FtQizUBJ62RBUsm1k6lJZWMJioCnUmgJikY08NzqKDQF_Dm706SJm--IWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTHEdhxopzoDD2WQXM0PnLhRiynaRV59bmagjrgLsIxQ&oe=6B05C74D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MADiSON VR", "keywords": [], "long_description": "Science does not lie. \u2018The Science of Scare Project\u2019 confirmed the award winning MADiSON is the scariest game EVER!\n\nAnd the scariest game ever just got even scarier, as MADiSON is being re-made in VR.\n\nWhat would you do if you awoke locked in a dark room, hands covered in blood \u2013 your sister and mother massacred?\n\nMADiSON is an immersive and terrifying first-person psychological horror game, featuring disturbing gameplay and an unsettling and compelling narrative.\n\nWith the help of an possessed instant camera, connect the human world with the beyond. Solve puzzles, explore your surroundings and most importantly, survive. Throughout your journey you are haunted by MADiSON, the ghost of an evil murderer, who is forcing you to continue a gory ritual started decades ago and commit abominable acts. She wants you to finish her sinister ceremony. Do you have the strength to resist?\n\nIt\u2019s not just her that you need to worry about. There is more than one evil entity in MADiSON and every character has a disturbing story that blends seamlessly into the main narrative. Use the instant camera to survive this torture. Develop photos you take manually and face the fear of unveiling the truth. Search everything, pick up elements and interact with them to survive. Random events and changing puzzles throughout the game assures a high level of replayability as you get lost in this immersive and terrifying experience.\n\nWatch every step and be careful not to attract any attention. You won\u2019t be alone.", "short_description": "The scariest game ever, just got even scarier."}]}, "developer_name": "Bloodious Games / Team Beef", "developer_privacy_policy_url": "https://perpgames.com/2024/11/12/madisonvr-meta-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9428827553799023"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1073844842380146"}, {"status": "PUBLISHED", "id": "1116308311383660"}, {"status": "PUBLISHED", "id": "28209861785319189"}, {"status": "PUBLISHED", "id": "2324926521585111"}, {"status": "PUBLISHED", "id": "2115072649073655"}, {"status": "PUBLISHED", "id": "2105814377019380"}, {"status": "PUBLISHED", "id": "750781668024367"}, {"status": "PUBLISHED", "id": "157
9788767634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS9CQv6S-OMQ7kNvwHVz86L&_nc_oc=AdoIrc8y9nyUXeu_pxz0PBX-vR3aPJvUjy5b9eJ7Hr-E_moB5Wvfg02upX-cPfuOpNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1nVs5YgROY6WJ7bN6PqvbBmglWsUJADClekoTHrOSZ1g&oe=69F0B40D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MADiSON VR", "keywords": [], "long_description": "Science does not lie. \u2018The Science of Scare Project\u2019 confirmed the award winning MADiSON is the scariest game EVER!\n\nAnd the scariest game ever just got even scarier, as MADiSON is being re-made in VR.\n\nWhat would you do if you awoke locked in a dark room, hands covered in blood \u2013 your sister and mother massacred?\n\nMADiSON is an immersive and terrifying first-person psychological horror game, featuring disturbing gameplay and an unsettling and compelling narrative.\n\nWith the help of an possessed instant camera, connect the human world with the beyond. Solve puzzles, explore your surroundings and most importantly, survive. Throughout your journey you are haunted by MADiSON, the ghost of an evil murderer, who is forcing you to continue a gory ritual started decades ago and commit abominable acts. She wants you to finish her sinister ceremony. Do you have the strength to resist?\n\nIt\u2019s not just her that you need to worry about. There is more than one evil entity in MADiSON and every character has a disturbing story that blends seamlessly into the main narrative. Use the instant camera to survive this torture. Develop photos you take manually and face the fear of unveiling the truth. Search everything, pick up elements and interact with them to survive. Random events and changing puzzles throughout the game assures a high level of replayability as you get lost in this immersive and terrifying experience.\n\nWatch every step and be careful not to attract any attention. You won\u2019t be alone.", "short_description": "The scariest game ever, just got even scarier."}]}, "developer_name": "Bloodious Games / Team Beef", "developer_privacy_policy_url": "https://perpgames.com/2024/11/12/madisonvr-meta-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9428827553799023"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1577278656682037"}, {"status": "PUBLISHED", "id": "930897906094516"}, {"status": "PUBLISHED", "id": "1432046625221216"}, {"status": "PUBLISHED", "id": "696198940092366"}, {"status": "PUBLISHED", "id": "892488203300167"}, {"status": "PUBLISHED", "id": "683867614415864"}, {"status": "PUBLISHED", "id": "689490353664087"}, {"status": "PUBLISHED", "id": "1418450339211151"}, {"status": "PUBLISHED", "id": "1564242194704961"}, {"status": "PUBLISHED", "id": "1964607187405769"}, {"status": "PUBLISHED", "id": "1775170879935330"}, {"status": "CANCELLED", "id": "1154698529599036"}, {"status": "PUBLISHED", "id": "595261213001295"}]}, "baseline_offer": {"id": "595261213001295"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1577278656682037"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": 
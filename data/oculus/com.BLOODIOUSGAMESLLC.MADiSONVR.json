yaPk41hdbIQ7kNvwHRzbvW&_nc_oc=AdrfCgusPP-SD-yKE0jiJW_wvC0_-9EEwg1LwFSNNVJ834EGTEac50Yh6b7N-S3oSzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-JFxAyMdx9TW7T9GaReSS0aVkh4Pzmki3IoMb7p2eig&oe=6ACD0580"}]}, "id": "1087209856409610", "locale": "en_US", "screenshots": [{"file_name": "ss5.png", "id": "908398331251509", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982581_908398337918175_4360524429943302752_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr5XrnfJOuIQ7kNvwHn9joo&_nc_oc=Adp_INkDyCLMvKndhcG5_8d-WbCdjybVtHcLot7k1Ga9po6fPHbz8OQtIhtYyWYxTXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGixGfl4L3KqAIidW09YI3oVhdMO0i8qjcQp__Sag8gw&oe=6ACD1240"}, {"file_name": "ss3.png", "id": "906278708101895", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307249_906278711435228_1294603081593494376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqyuLLvuvccQ7kNvwForWYB&_nc_oc=AdpgpShxbOHDIbGP5iXjQ9l4ywBadu2WylnDZRmDw-1vRD8xNTvWbbKzD0a65Saa0ME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpwb4g6dxpEMX-xTedm3ca0cy_PEXh9EUbN9zvGyWLkw&oe=6ACCFFDE"}, {"file_name": "ss1.png", "id": "1510132379663413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570296_1510132382996746_5467417863881995495_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bX71cqoWYkQ7kNvwGejGcP&_nc_oc=AdoKSXGYzojxXen3tyubpjES90XBUSz6t079Q59_FF_gQiXOLSRDQzpreYF-tBmSAYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVgWff66NNWHNG2GiHZMjFs-yPOYCMyxr6fat7_aKeew&oe=6ACCE500"}, {"file_name": "ss2.png", "id": "820732743358387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982555_820732753358386_2034495332364331082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9gMbvdtkAMQ7kNvwHuLX_f&_nc_oc=AdppNxfQxYjinSQdSCEVfol_EcpBGxPdqx9rWTu9By0LfuMuKqxw2a2BRGp9vJdJ2c4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm2gTJ3uVjPBKVojFr561R6ztfi305GBN5IQVsiyeFwA&oe=6ACCEB39"}, {"file_name": "ss4.png", "id": "1099970795021302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_1099970798354635_3888168239788767634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiULSuzRpTsQ7kNvwHgCbDx&_nc_oc=Adoi3MY2vgpeJsBaVLpwccB459A2MtHOVLy5OR_U7sHlloHB-GdoTEDH95-Y9SDO6Ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYGvUxzwjmSrMh9EfQICewqRVeqeW0nBDiymaCWqRRiQ&oe=6ACD16CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MADiSON VR", "keywords": [], "long_description": "Science does not lie. \u2018The Science of Scare Project\u2019 confirmed the award winning MADiSON is the scariest game EVER!\n\nAnd the scariest game ever just got even scarier, as MADiSON is being re-made in VR.\n\nWhat would you do if you awoke locked in a dark room, hands covered in blood \u2013 your sister and mother massacred?\n\nMADiSON is an immersive and terrifying first-person psychological horror game, featuring disturbing gameplay and an unsettling and compelling narrative.\n\nWith the help of an possessed instant camera, connect the human world with the beyond. Solve puzzles, explore your surroundings and most importantly, survive. Throughout your journey you are haunted by MADiSON, the ghost of an evil murderer, who is forcing you to continue a gory ritual started decades ago and commit abominable acts. She wants you to finish her sinister ceremony. Do you have the strength to resist?\n\nIt\u2019s not just her that you need to worry about. There is more than one evil entity in MADiSON and every character has a disturbing story that blends seamlessly into the main narrative. Use the instant camera to survive this torture. Develop photos you take manually and face the fear of unveiling the truth. Search everything, pick up elements and interact with them to survive. Random events and changing puzzles throughout the game assures a high level of replayability as you get lost in this immersive and terrifying experience.\n\nWatch every step and be careful not to attract any attention. You won\u2019t be alone.", "short_description": "The scariest game ever, just got even scarier."}]}, "developer_name": "Bloodious Games / Team Beef", "developer_privacy_policy_url": "https://perpgames.com/2024/11/12/madisonvr-meta-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9428827553799023"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "28209861785319189"}, {"status": "PUBLISHED", "id": "2324926521585111"}, {"status": "PUBLISHED", "id": "2115072649073655"}, {"status": "PUBLISHED", "id": "2105814377019380"}, {"status": "PUBLISHED", "id": "750781668024367"}, {"status": "PUBLISHED", "id": "1577278656682037"}, {"status": "PUBLISHED", "id": "930897906094516"}, {"status": "PUBLISHED", "id": "1432046625221216"}, {"status": "PUBLISHED", "id": "696198940092366"}, {"status": "PUBLISHED", "id": "892488203300167"}, {"status": "PUBLISHED", "id": "683867614415864"}, {"status": "PUBLISHED", "id": "689490353664087"}, {"status": "PUBLISHED", "id": "1418450339211151"}, {"status": "PUBLISHED", "id": "1564242194704961"}, {"status": "PUBLISHE
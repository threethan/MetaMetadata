111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilvvMvw6uO4Q7kNvwFXaFI5&_nc_oc=Adndk0Gx9ZF344K7Zis4VnVO_nqzr52XKLDUvD30sD4TViLlHSiH4l0h6JFe-LLVY5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvx7j_gRjDz-Sw_fEmBFfWLTWNQaYt6BhvxqDa4BJrNOg&oe=69A578AD"}, {"file_name": "GetAttachmentThumbnail.png", "id": "1557946618666226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307451_1557946621999559_8520575255777214725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqd5OPsOviwQ7kNvwGn3eU2&_nc_oc=AdkZ3mZ99JLnmEU89UqgW3P9q5hQgyrDQLNAjirD4wm56zHfIWjCKj7w0r0ZZ1hkrAg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsGxf830Mi5dY3Pf9Mr074uUUR7QQSKmy0IvKDP-g5ksQ&oe=69A56C11"}, {"file_name": "GetAttachmentThumbnail.png", "id": "1560756111630225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304764_1560756114963558_6246825538895104305_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4HSHBBNG7YQ7kNvwE6_wrF&_nc_oc=Adkpp_TWzYP3UzFkQ3L4kccsqCLW4T971DFaNcotHe8L33At24jWeoFz7-UmuWMCjHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs7YXz6vEITuZQmqzP8yMeQaVfL36Q5vpbqvRczgIZCcw&oe=69A59928"}, {"file_name": "GetAttachmentThumbnail.png", "id": "854427763888148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_854427767221481_3951429925126291369_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zED1P9D2CBcQ7kNvwEJnlQ9&_nc_oc=Adld9zb3eIn0MGVP7-hvpimglKVX9VfukREHoT3UGYdCSIcuGmgCvneD_kJ3o-LXXr0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft3zckV8Vv4wyKHCCDoyC-u5btY2wuLSMc_yM2tLCFQQA&oe=69A56F34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place of Peace VR", "keywords": ["placeofpeace", "jiujitsu", "grappling", "boxing", "fighting"], "long_description": "Step inside the Place of Peace BJJ Invitational:\n\nA fully immersive VR arena built for athletes, fans, and anyone who loves world-class Jiu-Jitsu.\n\nWatch exciting matches, explore the venue, and experience the action from angles you could never see in real life. From highlight shows to live-style events, you\u2019ll feel like you\u2019re sitting mat-side as top competitors showcase skill, strategy, and heart.\n\nBetween matches, walk through interactive spaces designed to celebrate the culture of Jiu-Jitsu. Visit virtual shops, discover exclusive products, and unlock in-game items \u2014 or purchase real Place of Peace gear you can wear in the real world.\n\nMore than a competition, Place of Peace VR is a community hub. Hang out with friends, meet other fans, and follow your favorite grapplers as they chase greatness on the world stage.\n\n\n\nFeatures include:\n\nWatch Place of Peace BJJ Invitational events and shows\n\nGet immersive, up-close views of championship-level grappling\n\nBuy in-game items and unlock special content\n\nShop real merchandise and official Place of Peace gear\n\nConnect with athletes and fans inside a positive, inspiring environment\n\n\nThe future of Jiu-Jitsu is interactive.\n\nStep into the arena and experience peace, power, and competition in VR.\n\n", "short_description": "Enter the Place of Peace BJJ Invitational:\n\nWatch elite grapplers, shop exclusive gear, and experience Jiu-Jitsu like never before.\n\nTrain, watch, and shop inside the official Place of Peace BJJ Invitational VR arena:\n\nWhere champions compete and fans connect.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.placeofpeacebjj.com/blank-2", "developer_terms_of_service_url": null, "publisher_name": "Place of Peace Brazilian Jiu Jitsu LLC", "support_website_url": null, "website_url": "https://placeofpeacebjj.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
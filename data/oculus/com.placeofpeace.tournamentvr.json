5/499311582_1415873443571886_1865936280455260914_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=532gK6zZZN4Q7kNvwHD2f8n&_nc_oc=AdlTqc98fYrc07VAnw9eHcfO7nDFglx9wzDLW86FG6lUvhgan2UZWTGi_Uf-4a9Dquc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_103zJoUishOEn-E5R6BW88sZ48ma9SgAGnlN-VHSjA&oe=69BA90AD"}, {"file_name": "GetAttachmentThumbnail.png", "id": "1557946618666226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307451_1557946621999559_8520575255777214725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea86C_PVPogQ7kNvwGfDFdF&_nc_oc=AdmjFXBrvUlYbRsXhcmW4NTYFbTsEHD-W9h-x4sVvixWSE4y7PH4r4IjRJ_QP1ZNizo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6FeKlKmK8ENE68K3KlmKBhPGSdKQ9XaFux6nzJ2UHAA&oe=69BA8411"}, {"file_name": "GetAttachmentThumbnail.png", "id": "1560756111630225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304764_1560756114963558_6246825538895104305_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVwwMV6TjC4Q7kNvwGWzTWN&_nc_oc=AdkNOmw7dpqhl8cfLBmfUEiTVAfeZZCWivaBng6Yq_ZQ0N1B0b_ncRq-C8xPzfDad_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNR3QXOSnvEceCrhmKjcW_WLPaRoK982ZoPe46febOyg&oe=69BAB128"}, {"file_name": "GetAttachmentThumbnail.png", "id": "854427763888148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_854427767221481_3951429925126291369_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDZqKKzmdboQ7kNvwEudq9O&_nc_oc=Adl1msOUjYg-rzyKXo9pyOaU7E0rVFSmjKxA1vdZhh3xFAfBrUIM9CbD4cdpoX0uc8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaH9L4K0WPhNH9Ujh1rjAlFdTmA2MeZldOhD4QeXnvzQ&oe=69BA8734"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place of Peace VR", "keywords": ["placeofpeace", "jiujitsu", "grappling", "boxing", "fighting"], "long_description": "Step inside the Place of Peace BJJ Invitational:\n\nA fully immersive VR arena built for athletes, fans, and anyone who loves world-class Jiu-Jitsu.\n\nWatch exciting matches, explore the venue, and experience the action from angles you could never see in real life. From highlight shows to live-style events, you\u2019ll feel like you\u2019re sitting mat-side as top competitors showcase skill, strategy, and heart.\n\nBetween matches, walk through interactive spaces designed to celebrate the culture of Jiu-Jitsu. Visit virtual shops, discover exclusive products, and unlock in-game items \u2014 or purchase real Place of Peace gear you can wear in the real world.\n\nMore than a competition, Place of Peace VR is a community hub. Hang out with friends, meet other fans, and follow your favorite grapplers as they chase greatness on the world stage.\n\n\n\nFeatures include:\n\nWatch Place of Peace BJJ Invitational events and shows\n\nGet immersive, up-close views of championship-level grappling\n\nBuy in-game items and unlock special content\n\nShop real merchandise and official Place of Peace gear\n\nConnect with athletes and fans inside a positive, inspiring environment\n\n\nThe future of Jiu-Jitsu is interactive.\n\nStep into the arena and experience peace, power, and competition in VR.\n\n", "short_description": "Enter the Place of Peace BJJ Invitational:\n\nWatch elite grapplers, shop exclusive gear, and experience Jiu-Jitsu like never before.\n\nTrain, watch, and shop inside the official Place of Peace BJJ Invitational VR arena:\n\nWhere champions compete and fans connect.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.placeofpeacebjj.com/blank-2", "developer_terms_of_service_url": null, "publisher_name": "Place of Peace Brazilian Jiu Jitsu LLC", "support_website_url": null, "website_url": "https://placeofpeacebjj.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "877379582865093"}], "extern
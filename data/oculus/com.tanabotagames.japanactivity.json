&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI92gljhqiEQ7kNvwF78n42&_nc_oc=AdqkQ5uCZcwntelnGW9a6JRHiQQDewqDnDPzqxTZr4A_bSH79LjeC2sQoNYOLRYJVmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtN8wWEvfbwxhIYkbaY7P_PtSvg2uU9Bl6BYxWuxJrww&oe=6AA2CD34"}, {"file_name": "JAS_SS04.png", "id": "867971115855593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618284_867971119188926_1943889616287134071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9ds_59R4XgQ7kNvwGS6F5H&_nc_oc=AdrPlbfSZE-TjYijuCIdunsyxaLJ6eQDj5zeexB43XEU5Ob7n0DHSSZIN-P-bswGZwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIh2y39eAsMVISp9JY5sz-NylPhiOAsr799Z71VTA8WA&oe=6AA2BFCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JAS_PV_cover1.png", "id": "649181138258808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618432_649181141592141_4738211282412047997_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gf2GTA7I8cQ7kNvwFh8sR7&_nc_oc=Ado_Qeb9xiCljL5WulqH4ZwVF9Pa9d6CAagcPK3V6gqYQVT4lMdXI588xvd7VH-x7qU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN_I8tbU40RI76EODjGsBVcR5yPUSOUVM2cJ7jGYj0JA&oe=6AA2C23A"}, "display_name": "JAPAN ACTIVITY SIMULATOR", "keywords": ["JAPAN", "BUSHIDO", "SAMURAI", "NINJA", "MATCHA"], "long_description": "The four \u201cways\u201d: Bushido, Sado, Kado, and Shodo. Centered on hands-on experiences, we offer more than 28 different activities, including samurai, ninja, tea ceremony, ikebana, kanji, zazen, sushi, and hot springs\u2014ranging from mindfulness experiences that bring peace to the mind to creative and game-based activities that express the heart!!\n\n{1119488606821638}\nRemove the tarnish from the sword and polish and align your mind as well\n{1184257777030409}\nEveryone is equal inside the tea room Regardless of rank, everyone should enter with their heads bowed\n{2944312539085173}\nArrange flowers of each season freely, and create whatever your heart desires, \nsuch a
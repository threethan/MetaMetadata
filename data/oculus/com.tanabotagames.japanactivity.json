&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8kAoTELGvMQ7kNvwFsu_c2&_nc_oc=Adoj2tNGkAMbo4roNrsrA2jaFtJ-b8mnXlz8vX5EXObMe0RK2lz6EVQgabos3fz5QG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7gblBfw3FqHktz5XA-3ML7g3KI92DJfXLypqIl48q5g&oe=6AF87EB4"}, {"file_name": "JAS_SS04.png", "id": "867971115855593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_867971119188926_1943889616287134071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzKPbKObQ6UQ7kNvwHBTrGd&_nc_oc=AdrV90GiAffI1Tryjpg1Z2rYzod11m7-c04nRD0q2ppazX3FyFYG_lLGdaop3grjfqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIGiYQ1b-lK7hqDVCa5upDhXX3eT6T1ktbzzqn_qMeMg&oe=6AF8A98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JAS_PV_cover1.png", "id": "649181138258808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_649181141592141_4738211282412047997_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72bDX5-RxRQQ7kNvwG3ejER&_nc_oc=Adr-vt9o_USIHq_vz69g4OjH3W8VXHbCGblNszCmr0dlknt4Y4QulAYqZ44_XdT8xh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS19oXloXod0KDCf9p3SNYr5aZ7gYhxb-RE11x1XLiq5g&oe=6AF8ABFA"}, "display_name": "JAPAN ACTIVITY SIMULATOR", "keywords": ["JAPAN", "BUSHIDO", "SAMURAI", "NINJA", "MATCHA"], "long_description": "The four \u201cways\u201d: Bushido, Sado, Kado, and Shodo. Centered on hands-on experiences, we offer more than 28 different activities, including samurai, ninja, tea ceremony, ikebana, kanji, zazen, sushi, and hot springs\u2014ranging from mindfulness experiences that bring peace to the mind to creative and game-based activities that express the heart!!\n\n{1119488606821638}\nRemove the tarnish from the sword and polish and align your mind as well\n{1184257777030409}\nEveryone is equal inside the tea room Regardless of rank, everyone should enter with their heads bowed\n{2944312539085173}\nArrange flowers of each season freely, and create whatever your heart desires, \nsuch a
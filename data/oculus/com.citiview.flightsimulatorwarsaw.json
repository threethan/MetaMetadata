og_AldU_V-JPpiR774B098CShZqQErfW4eMg&oe=6AF7448A"}, {"file_name": "screenshot_1.png", "id": "1119658660540100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596106838_1119658667206766_6916055702104953909_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkOCwiYiCfgQ7kNvwHTBLBV&_nc_oc=AdrILRy1zqYPRTkdyrTtGtLOS0Ec6WKwiYbvX6KdK8vjyuNP22xfF_iwdpUbxft72UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDtTQoDllo5gwmp8ptAGoZwChJ8LEOcNygz-4eGYKPzw&oe=6AF730EB"}, {"file_name": "screenshot_4.png", "id": "1455351673045804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1455351676379137_4109560245279234806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OW2W5d354XkQ7kNvwHh7tSS&_nc_oc=AdqopCGFc3oTmqMAHM7DvBWo1B3jgBD7GN3RgAz7FO5lVmzs8OUP0gyO8cmF3ZCPk-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqgj6LiGlGdIM9BdNursVyJ0SmMbZt-6myXPv4KAIb0Q&oe=6AF71709"}, {"file_name": "screenshot_2.png", "id": "1118909417365944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_1118909420699277_6746543044358055370_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPNnS6hSUUsQ7kNvwFDXA6a&_nc_oc=Adq4FTOXzPiOF2RjxjDsYTEP467hHSm3NPFZZspz7YkV7UyrixVeYh3E23nnkzZmHbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQetyjSuodHVEruWlsAfdmdiecJqGgHstAFNko3G7cmOQ&oe=6AF71F88"}, {"file_name": "screenshot_5.png", "id": "1815926756072227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1815926759405560_6659219624527311864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ33PzYtVosQ7kNvwHXXGcK&_nc_oc=AdqDSSdxGpOCmq-KUHdLjSX9z-UwAVDoOM5HzGzDO8YUc9TYlFg1EELb3Hry4RyKr6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIKKYLKeo0RN7dDYWaxm2UbS51cDQ3DYqZvHYoL-SiDA&oe=6AF74620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1644871463973962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1644871467307295_456294374334833763_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZyzl47J3NsQ7kNvwHxK8C8&_nc_oc=AdrnX6xUaOMFg7d0KyjotHWh2TT_csEAAUhSNkTRwxPVjFd51WAMqZP8AahXJRflJyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxP6EPsaYw7lK0wg4Obelcb_0fnYGdV7SS12KqFrZbvg&oe=6AF71C19"}, "display_name": "Flight Simulator Warsaw", "keywords": ["flight", "simulator", "warsaw", "warszawa", "pilot"], "long_description": "Flight Simulator Warsaw puts you in the captain's seat over the real Warsaw.\n\nTHE REAL WARSAW\nReal satellite, elevation and map data: the Palace of Culture, Varso Tower, the Warsaw Spire, the Royal Castle and Old Town, the National Stadium, Lazienki, Wilanow, the Temple of Divine Providence and thirteen Vistula bridges. Four airports: Chopin, Modlin, Babice and the Minsk Mazowiecki air base.\n\nA LIVING CITY\nKoleje Mazowieckie, the SKM, the Pendolino, the WKD and the trams on their real tracks, cars and buses on the roads, boats on the Vistula, dinghies on the Zegrze lake. At night the Old Town, the Palace and the Stadium light up.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Vistula, the Royal Castle out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Chopin city approach, a Vistula run, THROUGH the Siekierkowski bridge's pylons, the Modlin fortress, a fighter scramble, the Old Town after dark and a Warsaw tour.\n\nPOLSKI LUB ENGLISH\nMenus, missions and the hangar in Polish or English - switch in the settings.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Warsaw, built from real satellite and map data: the Palace of Culture, the Royal Castle and Old Town, Varso Tower, the National Stadium, Lazienki, Wilanow, the Vistula bridges and four airports. Start in your own glass hangar on the Vistula, talk to live air traffic control, fly through the Siekierkowski bridge's pylons, take out private jets or a fighter. Menus in Polish or English. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorwarsaw/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorwarsaw/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1369206219605574"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1090400257071303"}]}, "baseline_offer": {"id": "1090400257071303"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791981840, "status": "PUBLISHED", "id": "1090400257071303"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1380775431781986", "version": "1.0.2"}, "id": "1803991990632951", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andro
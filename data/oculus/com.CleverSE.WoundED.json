uluscdn.com&_nc_ss=7f20f&oh=00_Af0tdAn2ICkYrH88DE-2W2iIY_RopZtNYHW4HvILnqWMmQ&oe=69F5FB18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WoundED", "keywords": [], "long_description": "WoundED is a virtual environment dedicated for teaching wound care for health care students. Players can select 3 different wound types, clean and treat the wound with varying wound care products. The wound will dynamically heal or get worse based on the treatment choices of the players. At the end of the treatment process players will receive a detailed report on all the actions they performed during the wound care. Game is localized only for Finnish. ", "short_description": "WoundED is a virtual environment dedicated for teaching wound care for health care students. Players can select 3 different wound types, clean and treat the wound with varying wound care products. The wound will dynamically heal or get worse based on the treatment choices of the players. At the end of the treatment process players will receive a detailed report on all the actions they performed during the wound care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cleversimulation.com/wounded-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clever Simulation Entertainment", "support_website_url": null, "website_url": "http://www.cse.fi/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
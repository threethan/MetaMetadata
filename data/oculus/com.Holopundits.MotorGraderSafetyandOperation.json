ile_name": "motor grader - screenshot2.png", "id": "1000268688192852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392881_1000268691526185_4547162126362453768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=assn-n7BWw4Q7kNvwHPA3RN&_nc_oc=AdndK33BXZQzNDqUHXGANVyBGnEWdf3BUL1fR_qyr8wFjP3iQP0ihG2-cbaL3plDTUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZD7ZmY8Dj4Urj4lZqqTkNQYY_2kMY81RDIsrNz44Lvw&oe=69A6E04A"}, {"file_name": "motor grader - screenshot3.png", "id": "742180471399040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240104_742180474732373_7697663168727996629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsRMuLVitf8Q7kNvwH3rMfw&_nc_oc=Adl554urcUAEcXjopF_FxI4O9uRz_LrJa8py2p9Ca5x47MDiQAlE9FZc6DdxCsMbTZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft589SRK_ZIkH4M0qITlZ2oKYTZuZAoiIKdMvG6-sdv_A&oe=69A6CBC9"}, {"file_name": "motor grader - screenshot4.png", "id": "766482238796501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210401_766482242129834_7777293721774243715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM6BTcOrWacQ7kNvwF-FBUX&_nc_oc=AdlsLzjAYvwY0UOYvC_AYy1s-K79m77K2pzIaUrInwnGKat2WhBctVkt8c5HHbVD49U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCyYXCukUk9r1S6dnlnSGqb72vJlGCAKrJCxIg7z5uUA&oe=69A6D5FF"}, {"file_name": "motor grader - screenshot5.png", "id": "462114316249595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974660_462114319582928_4452116861395859515_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SRahGRVYN4Q7kNvwF2EFjQ&_nc_oc=Adm3aNByZdQY0TaAnXHBOtURbClzbHmzShRw58qEqYOCZrAY-AtXmwCvzQ3fDj836LM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_fHFradqZDHZJP_bq7G4q_Ie306d3XDrX0Em_2awgEA&oe=69A6BDE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motor grader - trailer cover.png", "id": "840143774838027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86597262_840143778171360_6047656471363500610_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQIXfGqGTVkQ7kNvwF_3jp1&_nc_oc=AdkdHIPLPToKUZZrQs9gGuvVDFFyfmQYUmIERVgDJMTYy2K2j3RoHhuT_cdcbxKlWpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_fzceNO4VKt8GkM7iRuzz5It_H-KB3keywge4AIdVWQ&oe=69A6EDD0"}, "display_name": "Motor Grader Safety and Operation", "keywords": [], "long_description": "Motor graders are versatile machines that play a pivotal role in various projects. Participants will operate a bulldozer and complete various tasks on an active worksite as part of this engaging simulation. \n\n**Overview & Activities:**\n\nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment. \n\n**Participant Simulation:**\n\nBefore starting their simulation tasks, participants must wear personal protective equipment (PPE), conduct a walk-around inspection of the vehicle, and complete one task to familiarize themselves with the vehicle's operation. Finally, participants are challenged to complete tasks at an active worksite, including leveling a small hill, moving piles of dirt into targeted areas, and filling a trench with rocks and stones. \n\n**Benefits & Key Features:**\n- Manipulative simulations provide hands-on practice in risk-free environments  \n- Instant feedback provides \u201ccorrect\" or \"try again\" responses to guide participants  \n- Flexible choice points allow participants to revisit any part of the simulation as needed \n- Realistic 3D tools, equipment, environments, and animations  ", "short_description": "Motor graders are versatile machines that play a pivotal role in various projects. Participants will operate a bulldozer and complete various tasks on an active worksite as part of this engaging simulation. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7303238916454008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569457_447718910973282_2584863672054203103_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miT32MRvpmkQ7kNvwHMUzZw&_nc_oc=AdmizBVnaRNxUCt2DF_iji3EIAVqLPFXIDwzGR1bt55t4wvz3Nm2gPuWDO-yn7PO5N0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsohKW1wO4YuNjhmo-Gi8aUNZMMp2l-GLKgHumnRa0lIA&oe=69A6C9D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Motor Grader Safety and Operation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1727462340, "lastRevision": {"nodes": [{"id": "7228969297214304", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
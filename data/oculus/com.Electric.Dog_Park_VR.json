luscdn.com/v/t64.5771-25/75221319_7753756827996734_7509262103343488003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thlF52MWJboQ7kNvwHPCY9K&_nc_oc=AdlXZicqAr6QnSgGF4Q8APi1rKRRuoMzwdjIQtH1j2yR8zNo18G37GzW2sk9sVixH0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvSrb6kqePDh0MJnDIdr8KTLzqQDXZLP166Gg45FfYoNQ&oe=69986BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000043382.png", "id": "2206767403005080", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984440_2206767406338413_6104468743794551067_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg3XUO5l_hAQ7kNvwErCXvd&_nc_oc=AdkZckUHMxz4a-cN7fj6wFvs88PqmF1afk66MVP2qG2CpkWlfHVfQ9pipzNHcedr6Gk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftuhN3inNW7msLWw4t4A-NikvE63Wc8uBshHje_LH-B9Q&oe=69983CBC"}, "display_name": "Dog Park", "keywords": [], "long_description": "Dog Park  is designed to be cartoony and whimsical. It features bright, colorful graphics that will bring the world of the dog park to life in a playful way. You'll get to experience all the fun activities that make up this virtual playground, like bouncing on trampolines and chatting with other dogs. Plus, with an environment designed for creativity and collaboration between players, you\u2019re sure to have a blast while playing this unique game! ", "short_description": "Dog Park lets you be a dog and explore the dog park. You'll have the chance to play with other dogs, bounce on trampolines, and chase balls in an immersive environment. With cartoony graphics and sound effects, this game is sure to provide hours of entertainment for everyone who plays!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/mep478/dog-park-stuff/main/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Electric", "support_website_url": null, "website_url": "https://sites.google.com/view/dogparkvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfor
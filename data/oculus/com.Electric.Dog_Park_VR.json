luscdn.com/v/t64.5771-25/75221319_7753756827996734_7509262103343488003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3bofumooFAQ7kNvwFqTUTB&_nc_oc=Adk_bKyxszrQlDuOsWuwahWBSfc9ICGWnKjK2FoFuSRrbEeWhFVXhvuQTnAA70j-Dpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afud0m86R2pNbWfcFd-S7JhRQ04IQ8a_oji0pQK2zZEEEg&oe=69A2F7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000043382.png", "id": "2206767403005080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984440_2206767406338413_6104468743794551067_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27OW49RHWCsQ7kNvwG8Ei0R&_nc_oc=Adm3DtRdmaXPNDChqQzjL07d-IJrDBeI9HN9qRE-BvBiLcoKFwoKvNWg8D4WaZfO6ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvi8lWJZyfkf33NwDLeEe-8loccJiHLu-owdvCkuOWCKg&oe=69A2C8BC"}, "display_name": "Dog Park", "keywords": [], "long_description": "Dog Park  is designed to be cartoony and whimsical. It features bright, colorful graphics that will bring the world of the dog park to life in a playful way. You'll get to experience all the fun activities that make up this virtual playground, like bouncing on trampolines and chatting with other dogs. Plus, with an environment designed for creativity and collaboration between players, you\u2019re sure to have a blast while playing this unique game! ", "short_description": "Dog Park lets you be a dog and explore the dog park. You'll have the chance to play with other dogs, bounce on trampolines, and chase balls in an immersive environment. With cartoony graphics and sound effects, this game is sure to provide hours of entertainment for everyone who plays!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/mep478/dog-park-stuff/main/privacy%20policy", "developer_terms_of_service_url": null, "publisher_name": "Electric", "support_website_url": null, "website_url": "https://sites.google.com/view/dogparkvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfor
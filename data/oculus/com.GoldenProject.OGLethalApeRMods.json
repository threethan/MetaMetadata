Sk7zU2bZlY_SA2deKE8LGvefgqnf8KnwnXqFUxQH1WssfXoEnSPAbNB7jUJMiZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5E84j-hA8a-74p9ALOYt3zBRZOEMgKvJDH--jfTKZIw&oe=6AF34DCA"}, {"file_name": "2 (1).png", "id": "1591331115440742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_1591331118774075_9178979476674748196_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0AzH4ab4IkQ7kNvwEXCOkS&_nc_oc=Adp7_wvwK23ajhd2swKTEhbUyaWdRBTXWi66CgCszO0LVWwrnuW8g1LUc6vVJwa2vow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIIDXeHQf3ZghP9RTXqlg0WfoOj2R5jFOWhB6uSO9T-Q&oe=6AF359F8"}, {"file_name": "4 (1).png", "id": "2506385053127548", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_2506385056460881_2851324203825431241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1nvomjuYuMQ7kNvwG7uCUW&_nc_oc=AdoipDRTK6k8CLsGXjvQM-dj_8vTXax7oP0QysmqUDSWEd8oHf-bu7AcSgPm4s12Q1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjphJlxL6f9jUjZA-SIZcQZH98xOcZx9jtzW18ZFBGOw&oe=6AF32A01"}, {"file_name": "5 (2).png", "id": "3109070126148239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_3109070129481572_1948370699778264998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfU-V4oKv-cQ7kNvwE6UPDX&_nc_oc=AdriGaY-8uFFLxk15O-2nM_rj14c2kYiDwdGV-JVF5azA5lGYu4i9iyVdhi2fsctqoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYNmebmrycHrvnm86vGB1m8Av5ew4Zz9K17C3LbbYubg&oe=6AF34919"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OG Lethal Ape R MODS", "keywords": ["Mods", "Scary", "Horror", "Sandbox", "Lethal"], "long_description": "OG Lethal Ape R MODS brings a new layer of chaos and replayability to the Lethal Ape universe by introducing custom modifications, redesigned environments, and unexpected gameplay twists. Explore the OG mods map and discover hidden changes, new mechanics, and monsters lurking in places you thought were safe.\n\nThe world feels familiar \u2014 but the rules are different.\n\nApes react faster, environments behave differently, and certain mods can completely change how you move, survive, or escape. Some modifications increase the challenge, while others introduce strange surprises that keep players guessing every time they enter the map.\n\nExplore carefully.\nAdapt quickly.\nSurvive the unpredictable.\n\nWhether you're searching for secrets, experimenting with new modded mechanics, or testing how long you can last against increasingly dangerous threats, OG Lethal Ape R MODS delivers a constantly shifting horror experience built for players who want something beyond the standard game.", "short_description": "OG Lethal Ape R MODS is a modded expansion of the classic Lethal Ape experience, featuring altered maps, experimental gameplay changes, and unpredictable encounters that make every run feel different."}]}, "developer_name": "GoldenProject", "developer_privacy_policy_url": "https://sites.google.com/view/og-lethal-ape-r-mods/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoldenProject", "support_website_url": null, "website_url": "https://sites.google.com/view/og-lethal-ape-r-mods/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO
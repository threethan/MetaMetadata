bZ8sRZVeSXVeJ7pYp75c4MyeZQhRFWYjOeTAvQ&oe=6AE0ACB8"}, {"file_name": "4 (1).png", "id": "2506385053127548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_2506385056460881_2851324203825431241_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajmyd2smZvsQ7kNvwF75whI&_nc_oc=AdrT204K1u5Otk--PTICGERpSHqBYgl1MCrciD3P4n-s-iKwEEl-LkXHC4PN_Av7eTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_pMNhvLzS1YxsF-2v4ANPAXpF4tAa2zGOwsFl-3m_oA&oe=6AE0B501"}, {"file_name": "5 (2).png", "id": "3109070126148239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_3109070129481572_1948370699778264998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I5rVZDSyCkQ7kNvwFGKJpK&_nc_oc=AdpT6TXvYxMFSYY1IQ479CzDjPL43-qplEGx9aY15bCK8a5AnFydYLiLCOwoejjCHY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhK4pv5TC3RnptHRxnSxRdJVCJzlMEnj2rj5r8oidnuQ&oe=6AE09BD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OG Lethal Ape R MODS", "keywords": ["Mods", "Scary", "Horror", "Sandbox", "Lethal"], "long_description": "OG Lethal Ape R MODS brings a new layer of chaos and replayability to the Lethal Ape universe by introducing custom modifications, redesigned environments, and unexpected gameplay twists. Explore the OG mods map and discover hidden changes, new mechanics, and monsters lurking in places you thought were safe.\n\nThe world feels familiar \u2014 but the rules are different.\n\nApes react faster, environments behave differently, and certain mods can completely change how you move, survive, or escape. Some modifications increase the challenge, while others introduce strange surprises that keep players guessing every time they enter the map.\n\nExplore carefully.\nAdapt quickly.\nSurvive the unpredictable.\n\nWhether you're searching for secrets, experimenting with new modded mechanics, or testing how long you can last against increasingly dangerous threats, OG Lethal Ape R MODS delivers a constantly shifting horror experience built for players who want something beyond the standard game.", "short_description": "OG Lethal Ape R MODS is a modded expansion of the classic Lethal Ape experience, featuring altered maps, experimental gameplay changes, and unpredictable encounters that make every run feel different."}]}, "developer_name": "GoldenProject", "developer_privacy_policy_url": "https://sites.google.com/view/og-lethal-ape-r-mods/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoldenProject", "support_website_url": null, "website_url": "https://sites.google.com/view/og-lethal-ape-r-mods/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "33830843529897613"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2031810000698907"}]}, "baseline_offer": {"id": "2031810000698907"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771018500, "status": "PUBLISHED", "id": "2031810000698907"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38983643831284198", "version": "OGLethalApeRMods"}, "id": "1970705380177298", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
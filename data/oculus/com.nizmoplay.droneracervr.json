154909563692409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/789212960_1154909567025742_9166465951468133400_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCBEUDwgtcQ7kNvwFIxnOW&_nc_oc=AdrEIrMFoQasqZBfKWHTMRJk9MlMXAXmT3II1plWh1uVwlPLNiwQvmo9T8PdDRlOUgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZwjSOGuZJhHsvYa_w51Sl3-cGjRMqeT8Akdwb_Z7tXQ&oe=6B0F0DD1"}, {"file_name": "Sunset Steampunk Fortress Race.png", "id": "1676445064120807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298387_1676445067454140_8743655573935963902_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzS5dFd4j3QQ7kNvwHfVK7X&_nc_oc=AdoCdXhbBQ-Mo_elfMAryNaN8icQDk55o6gniq6g80YIW7WOAU1nQKQew8VvqnHohSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSvE0Q3l2rRU1fa5QO71T5yfQwCHHSrKBhCPSteNIKOg&oe=6B0F171E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Universal Art.png", "id": "1155439850329973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1155439853663306_5775738246676208076_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v6OPpQ18roQ7kNvwHagphb&_nc_oc=AdpAlhU-jlNnFGnbMsdNWMUSLdIACD6IZlh86voWBVY4LQZeyFFLeOgXW1kXdj-aIHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJazsIBjl6gN5b7O2gXGSpNIxoG6lb5PArKi4KpvOKYw&oe=6B0F1A9D"}, "display_name": "RotorX", "keywords": ["Drone", "Simulation", "Flying", "Racing", "Simulator"], "long_description": "Take control of the skies in ROTORX VR, a fast-paced VR drone racing experience built around precision flying, speed and challenging courses.\n\nChoose your drone, select a track and put your piloting skills to the test against AI racers. Fly from an immersive FPV perspective or switch to a third-person view as you navigate race gates, sharp turns, elevation changes and demanding environments.\n\nEach drone offers its own combination of speed, acceleration, handling and stability, letting you find a machine that suits your flying style.\n\nRace across distinctive environments ranging from industrial locations to forests, hills and coastal courses. Dynamic time-of-day, weather and wind conditions can transform the atmosphere and challenge of each race.\n\nFeatures\n\u2022 FPV and third-person drone racing\n\u2022 Multiple racing drones\n\u2022 AI-controlled opponents\n\u2022 Multiple tracks and environments\n\u2022 Circuit, Time Trial and other race modes\n\u2022 Dynamic weather and time of day\n\u2022 Wind that influences drone handling\n\u2022 Drone customization and progression\n\u2022 VR controls designed for drone flight  \n\nLearn the controls, master every course and push your racing skills further in ROTORX VR.", "short_description": "Take control of high-performance racing drones in ROTORX VR. Master precision flight, race AI opponents, conquer challenging tracks, and experience the speed of FPV drone racing across dynamic environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nizmoplay/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NizmoPlay", "support_website_url": null, "website_url": "https://sites.google.com/view/nizmoplay", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
ng and sleeping.  Play fetch.  Win special food and energy by interacting with VR brand objects and videos.  Earn your pet\u2019s affection while building it\u2019s happiness.  All for the love of your pet.  And winning battles, of course.", "short_description": "Meet your new virtual pet! This loveable dino is yours to care for and grow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immersivemagic.io/privacy", "developer_terms_of_service_url": "https://www.immersivemagic.io/tos", "publisher_name": "Immersive Magic", "support_website_url": null, "website_url": "https://www.immersivemagic.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "202356168734154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_340249619748903_1987838833139384320_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkQ6UVulIYEQ7kNvwGoB5re&_nc_oc=Adow4ePtCz2puAxpiP7OhY_S8UiAqsvYTiXDkT7wBz5Ot6SUznOHhZzf3M3q8WVYhkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwcea7VI_j-C3d4xz_rNySG0crtNs4FXrj1niwhdnzclg&oe=69D103B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "My Virtual Pet VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1511373600, "lastRevision": {"nodes": [{"id": "154465895137507", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"
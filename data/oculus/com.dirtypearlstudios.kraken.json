BwvPEHoTleL5HtJkEQAbgO1K8Xq8vt72-E4C0439qSYrRcTeHGpBgM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgpODVWCO1MyLjzvs97i23bowJ6e10_QxnIGXuol2kjg&oe=6AAEB0B1"}, {"file_name": "Screenshot-4.png", "id": "1062672468971772", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308056_1062672472305105_1359099920964143148_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9QRRRgFuD8Q7kNvwHJ26IE&_nc_oc=AdoSQJL_SjROR-cEdSOFNDUcLO33VpVbu3lVzydS8jVI-C_o0eruODZGnpPtqFXcSHA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_mIzLDRVEdHw4112WPZPOUYNothY0KS7K9LNguD4WQQ&oe=6AAEB2F4"}, {"file_name": "Screenshot-2.png", "id": "1090993083240151", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308063_1090993086573484_8307373793517790545_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeXQLzfMw08Q7kNvwEaCzjc&_nc_oc=Adql5Z9yUs7HNMCuhVDStHbH5W_R8H20tGt7e14ddwoDcAUsyzddKvylmwOXKRPi67s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInXbesIojih9rducXJwbSNy_NFcn0W-v4oC1E1PrIlJQ&oe=6AAE9CB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "One By One", "keywords": ["horror", "adventure"], "long_description": "Step into the shoes of a curious child and explore sprawling haunted mansions in this cooperative VR horror adventure. Each session begins in a lively shared hub, where you gather with friends or new allies before venturing into eerie, multi-level houses brimming with mystery. Your goal: collect valuable treasures, solve strange puzzles, and survive the supernatural dangers within.\n\nEvery mansion has its own haunting\u2014monsters with unique behaviors, environmental hazards, and secrets to uncover. From dolls that stalk you when you\u2019re alone, to creatures that lurk in mirrors, each encounter forces you to think, hide, and act together. The child\u2019s-eye view heightens the sense of wonder and fear, bringing everyday objects to towering, ominous scale.\n\nNo two runs are the same\u2014treasures change, monsters adapt, and secret areas hide behind riddles and relics. Earn playful cosmetic rewards to show off in the hub, but remember: nothing you carry in will survive the night if you don\u2019t make it out.\n\nWith its eerie atmosphere, whimsical yet unsettling art style, and emphasis on cooperation, this is more than a haunted house game\u2014it\u2019s a shared ghost story you live together.", "short_description": "A cooperative VR horror adventure where you explore haunted mansions as a child, outsmart unique monsters, solve puzzles, and uncover treasures in a spooky, story-rich world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dirtypearlstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Dirty Pearl Studios", "support_website_url": null, "website_url": "https://Dirtypearlstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24328309663503687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "26873047819044399"}]}, "baseline_offer": {"id": "26873047819044399"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782228420, "status": "PUBLISHED", "id": "26873047819044399"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename":
scdn.com&_nc_ss=7f20f&oh=00_AQRe8Dq-_8VhIGPO7FuW_55YrYe_0t5lKna3IGkijzyR9Q&oe=6AF87790"}, {"file_name": "com.ULTRAFUNGAMES.XRULTRAPHYSICSSANDBOX2-20240926-010735_resized_2560x1440.png", "id": "2215669435460495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982483_2215669438793828_6861574559591628737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ6S30faCIAQ7kNvwH6-1_D&_nc_oc=AdpLWZJACfBBOMZqh25f0idzTN8EZHFDHJ7au6M5KZRXjpvHMyD1w-KS7BwMjmws5pY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIUggyW9cgYuH3efT04XxXwzvi-buWxXo1SnNb5Qfvvw&oe=6AF8A6D2"}, {"file_name": "com.ULTRAFUNGAMES.XRULTRAPHYSICSSANDBOX2-20240926-012055_resized_2560x1440.png", "id": "1073166737700169", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974683_1073166741033502_909029946867039203_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI8LsEDF8IwQ7kNvwF0V4QV&_nc_oc=AdqHhg8Tuy2RWmGo_8J9_Jvt0Pwf3bIyHyGzHKfVrNH_PIQ0QLQDKSfZfvvO4P3rbL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5jHqAPVDEUMRPUaA3hobCJqmlMVGklD45g0jAHS2QkA&oe=6AF88C7C"}, {"file_name": "com.ULTRAFUNGAMES.XRULTRAPHYSICSSANDBOX-20240904-141728_resized_2560x1440.png", "id": "1177831406656454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269300_1177831409989787_854214409302971071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIBJgluEEgkQ7kNvwHp7B1C&_nc_oc=Adqga33NK-ipWbEQvsYyRHl7HCS5evlDWjTEMMCLCUDN7Pyg-XhCm8huEnSJVgY4FKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW_IrW7LZL7GKP5D5oJ116FaATCsjWtfZafizOvRneTg&oe=6AF87941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XR2_resized_2560x1440.png", "id": "924939842785466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974713_924939846118799_2719880002950578241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mADLF1Dypj4Q7kNvwGqMcBe&_nc_oc=Adr7Bc66jxiULAhPuptUNpOOxyQiIzWOLJ7i15M1RPBjSONFCe95aZrFG1oAuXAWrKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGFq9Y1n6r97iLUcYL5Mjw7DdzEkBSWEXTn_0s1VXkvg&oe=6AF8834E"}, "display_name": "XR ULTRA PHYSICS SANDBOX 2: BATTLE MAYHEM", "keywords": ["sandbox", "physics", "combat", "shooter", "action"], "long_description": "Get ready for intense VR combat with XR Ultra Physics Sandbox 2: Battle Mayhem ! This action-packed sequel builds on the original with 165 weapons, a wide variety of AI bots, and realistic physics-driven battles. Step into a dynamic arena where every shot, every explosion, and every fight feels immersive and real.\n\nIn this game, you'll face off against AI bots with unique combat styles\u2014melee, pistols, rifles, shotguns, snipers, and even boxing bots. With lifelike ragdoll physics, each enemy reacts to your hits, bullets, and explosions, adding intensity to the battlefield. Whether you're up close with swords and shields or taking down enemies from afar with sniper rifles, the action never stops.\n\nThe game will initially feature a basic map and bots, but will grow with future updates, adding new maps and more challenging AI.\n\nThis time you\u2019ll focus on outsmarting and outmaneuvering bots in chaotic battles. And soon, Mixed Reality Mode will allow you to bring the fight into your real-world surroundings for the ultimate VR experience.\n\nXR Ultra Physics Sandbox 2: Battle Mayhem (Alpha) delivers the best in VR combat with stunning visuals, smooth physics, and endless possibilities!", "short_description": "XR Ultra Physics Sandbox 2: Battle Mayhem is an intense XR combat game featuring advanced AI bots, 165 weapons, and dynamic physics-driven battles"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": 
ame": "LINE BREAKER", "keywords": ["mixedreality", "handtracking", "runner", "linebreaker", "obstaclecourse"], "long_description": "# LINE BREAKER\nThe fast-paced runner game built for mixed reality. Use your hands to jump, slide and dodge the line's relentless obstacles.\n\n- **CAMPAIGN**   Progress through a series of levels. Start with casual warm-ups to unlock brutally unforgiving challenges.\n\n- **FREE RUN**   Push your limits in an endless run. How far can you go before the line breaks you?\n\n- **MULTIPLAYER**   Compete against friends and foes. Outrun and outsmart both the line and each other and claim the top spot on the leaderboard. (Coming Soon)\n\n{740825562198293}\n# Do you have what it takes?\n", "short_description": "Dodge, jump, and slide through relentless obstacle courses in a high-speed mixed reality sprint. Put your reflexes to the test and use only your hands to break the line\u2026 before it breaks you. \nEarly Access - feedback welcome"}]}, "developer_name": null, "developer_privacy_policy_url": "https://line-breaker.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Giaste FZ LLE", "support_website_url": null, "website_url": "https://line-breaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24658927857
3EVt3y52U1DE85pokzs6y-Q_kFlx9JuTFCRMuf6B2FIoPJSMiGWlNwyhRU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJPTozj00czwI180cdc0LFEX-pbfFAQH7OXpL_Y85sAw&oe=6B085EB5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1YAYEN5YYsQ7kNvwFLUwhw&_nc_oc=AdpKoTBxufcLrkOJtrJzjOcYCnWf-itLqsvKB9wLg6kJcNspXYaEjOOvo-MWsSu2oF4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT9GCbccsWLg66GlH-ME6-1j0OsIxWnEeb3_zDPijs2A&oe=6B083F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capsule_main.png", "id": "1932295487232755", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031470_1932295490566088_8845111807748253844_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zihxtmOyGiYQ7kNvwGsbK27&_nc_oc=AdrpN3o2_H2YCWavqaaRmFzVbWyN0aApEpOO4fdOvgMwyzyX0rXbORf5dyHs-AtPlv0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReTnVemHbP2md8wKGqTlCBFm9_vfxK6aV9Yq2JsZfFQQ&oe=6B086716"}, "display_name": "Tower Tag", "keywords": ["lasertag", "laser", "esports", "sale", "quest"], "long_description": "**Dive into the World of TOWER TAG Where hyper-dynamic action meets thrilling PVP battles.** \n\n**No Motion Sickness Movement**\n\nSay goodbye to motion sickness. TOWER TAG's intuitive grappling hook makes rapid movement second nature.\n{449451971417020}\n\n**Strategic and Impactful**\n\nTeam up, capture towers, and conquer the battlefield with tactical precision. Speed is your ally, and the element of surprise your weapon.\n{4576815695876082}\n\n**Effortless Control**\n\nWe've kept the controls simple, letting you immerse yourself fully. In TOWER TAG, your body becomes the controller, and the game flows naturally.\n{375037532292289}\n\n**Content**\n- **Multiplayer:** Enjoy cross-platform multiplayer between different mobile VR platforms.\n- **Match Variety:** Engage in 1v1, 2v2, 3v3, and 4v4 matches.\n- **Diverse Maps:** Explore a variety of maps and environments.\n- **Motion Sickness-Free:** Experience smooth grappling hook movement and intuitive Paintball mechanics without.\n- **Safe Space:** Move freely even in small spaces.\n- **Game Modes:** Play three different team modes: Deathmatch, Elimination, and Goal Tower.\n- **Intelligent Bots:** Practice with smart AI opponents.\n- **Ranked Play:** Climb the rankings with leaderboards.\n- **Enhanced Experience:** Enjoy support for bHaptics vests and other immersive equipment.\n\nHop into our **official Tower Tag Discord** to connect with other players, join matches and share feedback.\n\ud83d\udc49 https://discord.gg/mptpJk2\n\n\n\n\n\n\n", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness!"}]}, "developer_name": "Steinfatt GmbH", "developer_privacy_policy_url": "https://tower-tag-main.webflow.io/privacy-policy-tower-tag", "developer_terms_of_service_url": null, "publisher_name": "Steinfatt GmbH", "support_website_url": null, "website_url": "https://tower-tag-main.webflow.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "th", "zh_CN", "ko", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "
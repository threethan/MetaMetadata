-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D7Udb7o6VEcC6-aZ0Bml2b5FF5nOu5WzPerweKvE2iA&oe=6A1ECCF5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELLHAPq3Bi0Q7kNvwHOrq1H&_nc_oc=AdqGJEust_h5OcHgPnXe3UXhWV8Lm1nXBx5yy9bbHWslwAmoouI01P4B9oLeC1h4Mj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UfpU8OtLMqz4E4S-ohypqIqkcyiG8X1ompiBJmFQ8uw&oe=6A1EE619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI21CE-YNfEQ7kNvwHN1sNQ&_nc_oc=Adpq-zpOiVrQFd2PLXhLGwL8Vnf7YI9MxOR_uK0Mhol772MSfiHd13n5yScTn417prs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sEE5gqwqbgRO1Nbd1pIor0oKyXLj9rYDtGs9thTTSag&oe=6A1ECA32"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes seco
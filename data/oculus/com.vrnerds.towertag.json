670388527264338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031323_670388530597671_5490469913338689382_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qP2UMpspS8Q7kNvwGfgclR&_nc_oc=AdqKZ40XZuhsEX_mrp6jmiDeVx4Nox9h640arC48ifa2lekYZQubbaE8je9D1l_RAvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7VTKTxxXTeft-6fJ3-TKX44Ys4zHUrV5Mu5oZWfGZNg&oe=6AB93C9F"}, {"file_name": "Tower Tag Screenshot 2.png", "id": "907975100116080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003259_907975103449413_7656664959858111418_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJSobfJ6MrYQ7kNvwFExvoX&_nc_oc=AdovyjolhealZ928aixyuAMzM3CCPH-Ep2jEKIfhZ_ksCFhbqoQ8h8krEH-bp31b698&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO5JvhG6UXF3jR149fbB0vzjHt40OdLM4Klr7MJiKG0g&oe=6AB931D5"}, {"file_name": "Tower Tag Screenshot 3.png", "id": "168422975392861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001729_168422978726194_821451168504875527_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGs71InCX0wQ7kNvwFtCaF1&_nc_oc=AdoSPvJLbkU6VvNpnNvMw_v5TDv2kBCBN8pxQroDhPoEBPtUp8iwoy7gJ5kKcIFFtgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLilgWoNAFkr0Vy_frq9oAVH_PdsoO0ZQu-SxjdUa3V9g&oe=6AB93720"}, {"file_name": "Tower Tag Screenshot 4.png", "id": "545737423294026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974720_545737426627359_3418342792352847773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg_VnWrKOeIQ7kNvwEhHtNO&_nc_oc=AdpAXT-Fevk4b0p7DzkhM22tegWx8Mgd1i8noHmI6DFTtpoxs__Ww9Qn7vNUYswNowg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSr-8IEY-CDWIqWQfveMKUPeoqDwn2QTgXHnfWxeVAOA&oe=6AB90C75"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGCZl8DjcgsQ7kNvwFwjeWW&_nc_oc=AdqtJ6Calt6sE_AIwekP7HtDcvuNKR_c2FydhrXmuwn2De_DpR9xL0Ig9HuvqeDUGRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvaxphl9hugTConwG9y1e5YVsxBB7VFA-SE3KJFp2sDg&oe=6AB92599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capsule_main.png", "id": "1932295487232755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1932295490566088_8845111807748253844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNfAP1OwMGoQ7kNvwGWqYWd&_nc_oc=AdpbBmkgby-z-fhQ2t6NuEaN53_L-AEARrCiJJmwi4l3YLB9QdpB9ryEGGeXB-vUSPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKMmjwrBycLx7HdUIXtnTpIDOeCiPhQssAUzE15Swt2w&oe=6AB914D6"}, "display_name": "Tower Tag", "keywords": ["lasertag", "laser", "esports", "sale", "quest"], "long_description": "**Dive into the World of TOWER TAG Where hyper-dynamic action meets thrilling PVP battles.** \n\n**No Motion Sickness Movement**\n\nSay goodbye to motion sickness. TOWER TAG's intuitive grappling hook makes rapid movement second nature.\n{449451971417020}\n\n**Strategic and Impactful**\n\nTeam up, capture towers, and conquer the battlefield with tactical precision. Speed is your ally, and the element of surprise your weapon.\n{4576815695876082}\n\n**Effortless Control**\n\nWe've kept the controls simple, letting you immerse yourself fully. In TOWER TAG, your body becomes the controller, and the game flows naturally.\n{375037532292289}\n\n**Content**\n- **Multiplayer:** Enjoy cross-platform multiplayer between different mobile VR platforms.\n- **Match Variety:** Engage in 1v1, 2v2, 3v3, and 4v4 matches.\n- **Diverse Maps:** Explore a variety of maps and environments.\n- **Motion Sickness-Free:** Experience smooth grappling hook movement and intuitive Paintball mechanics without.\n- **Safe Space:** Move freely even in small spaces.\n- **Game Modes:** Play three different team modes: Deathmatch, Elimination, and Goal Tower.\n- **Intelligent Bots:** Practice with smart AI opponents.\n- **Ranked Play:** Climb the rankings with leaderboards.\n- **Enhanced Experience:** Enjoy support for bHaptics vests and other immersive equipment.\n\nHop into our **official Tower Tag Discord** to connect with other players, join matches and share feedback.\n\ud83d\udc49 https://discord.gg/mptpJk2\n\n\n\n\n\n\n", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness!"}]}, "developer_name": "Steinfatt GmbH", "developer_privacy_policy_url": "https://tower-tag-main.webflow.io/privacy-policy-tower-tag", "developer_terms_of_service_url": null, "publisher_name": "Steinfatt GmbH", "support_website_url": null, "website_url": "https://tower-tag-main.webflow.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "th", "zh_CN", "ko", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10065533410172875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_134569615231532_4812547263809071213_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-N0xjJXrHEQ7kNvwELEHXv&_nc_oc=AdrPJqpvCx6EjLM09q7AUlRSuKiwnfKeLQY5HR4XdO78iZ8msWcGOFypTAB8xenfGnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLmt5UszY7YyCWhv2mwrl7PTV8Ryhyy1dqK
70388527264338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031323_670388530597671_5490469913338689382_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6seqKQrEXIQ7kNvwGZ_I4e&_nc_oc=AdqZwiGCXYtw1MYZlaIHjG5IjHJi3MkWWNJpAHk_TM6JPlrlrE92YY-O6wHdRa7gkxw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T0Jmbqu4P8MHRn1GIR12U_zxPlPZCtzNFhQV8MLv2DA&oe=6A1C5A1F"}, {"file_name": "Tower Tag Screenshot 2.png", "id": "907975100116080", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003259_907975103449413_7656664959858111418_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dsBvIOuv7UQ7kNvwH_Do_d&_nc_oc=AdpphZvNPjTyc3Xjp8TobP9v2huLUKs5bNfCLK9g2aS--xhovpY9IE2-eOF6IdLOnF4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76VpKE5i8_rH3MrNRZV5_zK84qCOKYE66eLFnhj7s4hQ&oe=6A1C4F55"}, {"file_name": "Tower Tag Screenshot 3.png", "id": "168422975392861", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001729_168422978726194_821451168504875527_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiCR75nXiu0Q7kNvwEjVLGA&_nc_oc=AdqAKawXjPtbu5nvomJuLi_vgXqrbtcBe7D-nHvapboVvo8S_TFSaQAkDIXEGVKRTUQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_ewOdnziLwi0gUy1XL_ciPldsx-ye406j04FxbMh0KA&oe=6A1C54A0"}, {"file_name": "Tower Tag Screenshot 4.png", "id": "545737423294026", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974720_545737426627359_3418342792352847773_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkPaNZDvKz4Q7kNvwF5hCty&_nc_oc=AdqSFbwHZx9R32HbcWQM6DPunedYLNwKxisVB6WqJzlPPWVXFOJikEcDfA8ERMnEWtI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6II8vqXhC7Y4_qmuH1dP4dcrIRk336owTkrkeekTqMKw&oe=6A1C29F5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc1LypP-Bw0Q7kNvwE4cvF3&_nc_oc=Adr1eg9a4n5H0aS7pgV2w_2DW4MXqIl9QN1gHedRyRRDAqCWWh4w38DPRBdL-5Kceo0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RyI4ZZisBmJZg_M-5f6Ljfy9buA6xalE2s8WBWmbsCA&oe=6A1C4319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capsule_main.png", "id": "1932295487232755", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031470_1932295490566088_8845111807748253844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uyLlnFkq_EQ7kNvwFjzMfQ&_nc_oc=AdrXKgE81g6htInqZT1jRQTugX59nUZsZYgb1g0QOQEhbgeTeBPoxtcM2Qe5_rZP7vI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lfpOLllYRsaPKmcmOregqa6ELgtZm2c6m2BFrbDpb3w&oe=6A1C3256"}, "display_name": "Tower Tag", "keywords": ["lasertag", "laser", "esports", "sale", "quest"], "long_description": "**Dive into the World of TOWER TAG Where hyper-dynamic action meets thrilling PVP battles.** \n\n**No Motion Sickness Movement**\n\nSay goodbye to motion sickness. TOWER TAG's intuitive grappling hook makes rapid movement second nature.\n{449451971417020}\n\n**Strategic and Impactful**\n\nTeam up, capture towers, and conquer the battlefield with tactical precision. Speed is your ally, and the element of surprise your weapon.\n{4576815695876082}\n\n**Effortless Control**\n\nWe've kept the controls simple, letting you immerse yourself fully. In TOWER TAG, your body becomes the controller, and the game flows naturally.\n{375037532292289}\n\n**Content**\n- **Multiplayer:** Enjoy cross-platform multiplayer between different mobile VR platforms.\n- **Match Variety:** Engage in 1v1, 2v2, 3v3, and 4v4 matches.\n- **Diverse Maps:** Explore a variety of maps and environments.\n- **Motion Sickness-Free:** Experience smooth grappling hook movement and intuitive Paintball mechanics without.\n- **Safe Space:** Move freely even in small spaces.\n- **Game Modes:** Play three different team modes: Deathmatch, Elimination, and Goal Tower.\n- **Intelligent Bots:** Practice with smart AI opponents.\n- **Ranked Play:** Climb the rankings with leaderboards.\n- **Enhanced Experience:** Enjoy support for bHaptics vests and other immersive equipment.\n\nHop into our **official Tower Tag Discord** to connect with other players, join matches and share feedback.\n\ud83d\udc49 https://discord.gg/mptpJk2\n\n\n\n\n\n\n", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness!"}]}, "developer_name": "Steinfatt GmbH", "developer_privacy_policy_url": "https://tower-tag-main.webflow.io/privacy-policy-tower-tag", "developer_terms_of_service_url": null, "publisher_name": "Steinfatt GmbH", "support_website_url": null, "website_url": "https://tower-tag-main.webflow.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "th", "zh_CN", "ko", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10065533410172875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974578_134569615231532_4812547263809071213_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7owmWiMEwUQ7kNvwH2H0BN&_nc_oc=Adpc5pC9f5sKsm35SRj9bHMPuZ0i7qJiFEES8DSlGuqQrCLb-imX8PilXWSy_f1dgRQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ceFTjW8DgSwCi4I-A2m1Hi-KK_mfrPuobmx
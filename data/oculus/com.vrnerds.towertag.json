-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_RNCSBuhi-iCM_-T38Ck1IKAM7SyZpCGl4q8eK581ag&oe=6A09B4F5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgNzzb2fHtIQ7kNvwEQ61TZ&_nc_oc=AdpKiVItmZ931SWKGoSroVUk6PT0hOzGRPcQSrxRlWcDFj4Ih4ZTZwQ_iAJ3tHwnsWk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78MNWO1wEEwy2SMomB9frPZryTNZGGlAg9sWrCrt0nYw&oe=6A09CE19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ3LO4iMXeUQ7kNvwHVaznk&_nc_oc=AdoZxTAOtgSz8V8ljMipW4viBDGQvBaeI-D4GFFduHjzd0t7FtOHp2FpQ5Wb286BA08&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PzxqqHwAOoRBWuo9BASHyR0GlPJ7nwzHDabpWEGWQUg&oe=6A09B232"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes seco
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-736Af250Ssu1UDVlPqC6tvl5tnJFuEWUpd9vPT5LeTw&oe=6A3BCDF5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDCoV9TANWsQ7kNvwG0UF6b&_nc_oc=Adoj1_rpUdLY_gDZ2ifhrigE47suE7ZO-IM4YoKK9KN7QFnJ3r4km8WoI0AUXBvnjH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mGqk_RGDOGwTp2mlxhpuoIiEuaDMajI9kWUagtEbwXw&oe=6A3BE719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zY_p-r2MFAQ7kNvwFNhGKC&_nc_oc=AdoNcQM1-8TM2kTsglVTUJSN_ekz9AddevfxEc_1vm5d5mVWFLMORLPqW-3k3tPEAb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oTr4-au-VgAVydfjoQ_3tqshnFz8yHAeVIixkqrUxWg&oe=6A3C0372"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes seco
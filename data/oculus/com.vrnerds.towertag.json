-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bnwi8dEHWmexeiu418UGP2KQElg55bgRJBvHxICfPoQ&oe=6A259CB5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff0FF8b57iMQ7kNvwF6M6nq&_nc_oc=Adrip9B4wWPbLF-P09Vi1GYG_lbNOLpHt-oGwILQG-rnKYZUuIzl-SSpXP7UJ2TEDu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y3E5iBqe_1YTg3ugVodlhC3505LIaRsfmVm1Dc1ouAQ&oe=6A257D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy8NI7Vlk-4Q7kNvwEgrSBc&_nc_oc=Adqgmf7whCndneWs3MO0Wfh-ExZaqKiFw8blTJ4QHzb1xDGqzEOgdq-kDzlJeBbf8Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WcuDQYCx7TtwXnNkVmObDlGQ2yh_PSEY3HDk1rh5faw&oe=6A2599F2"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes seco
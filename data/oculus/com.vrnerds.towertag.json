-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fK-2xU8buSAjugWLKVFg__1l7k2G8TSEtQczUTLAaSg&oe=69E37975"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbS4o0YpOT4Q7kNvwEetEIO&_nc_oc=Adq4jVmjGEvDodJQVkCIy8Y0M7KMKiVid2Pz58qDn4WjhCH7QDmLfqUTFKIN1SBrp4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07FxWtPwVA3L5BqB35Pl3hkaRiTkifbL_08xEg86KQCw&oe=69E39299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScnJgZn3GDwQ7kNvwEn9jj6&_nc_oc=Adr8Yk7D95nkJ0PS9d_2f8pYE-iW2Zyz277joBvA-mS3wiNoHfWXLn_WvxHWfD_QKM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_4gm4sdEDPFIWO_NwQlsxG2jnAPho9Gi_2DVSCQK9vg&oe=69E376B2"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes seco
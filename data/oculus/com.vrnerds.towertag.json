c_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XnYMdxXwHqxI6hsor19GCxJJjSEBFTKM1hv-2xvJ8mw&oe=6A22F9B5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff0FF8b57iMQ7kNvwGm69ge&_nc_oc=AdrUMFgVvLhaRd7EeYVfZ32b86ClIE7DSJLFhn-9ct7TXrQQ86v1QbhwO-VRdarMXEc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N9-36wSpHDYKMUEANTIrZQkZf3t7wqY9o0HzUuqlDZw&oe=6A22DA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy8NI7Vlk-4Q7kNvwFu32kX&_nc_oc=AdqnxXn7WdXXQxn-Riv5aMse268lMbupKs56ydqyA8J9hiyVG7eMl2kZP-yeUFz2J9I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YQg-JAi4BeBa5N-heJEPyJELH_LqUJqSlLd6ap9YWJg&oe=6A22F6F2"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion meth
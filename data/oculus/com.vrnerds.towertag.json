6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUSOn29u-czja6PeGockkDS0emLm93xAK2WlzIyFWjHQ&oe=6AB15BB5"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uBG4hcxbaAQ7kNvwERNzMO&_nc_oc=AdqmXMesw-CN8SgQ51W_6ylpILK4aC5KdMcf_j2oVEXdSn8KMRORc6uTOddTQEiRHA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoFej-8xsFTY9hH4JvVGlGq0Q9sdJPzDgqH86_C0MEzQ&oe=6AB13C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bqq3c4-OWgQ7kNvwGrVRca&_nc_oc=AdoDO8uB2h9_TXAIyenEhUNX_Hb1TbVHR7VZfBq5dbFyXIwfnBnuWZewLZ6QH2hitxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl6M31R-eT-cMib45NticxnDH3jbZ3amIntJPqhM9OUg&oe=6AB158F2"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes sec
VDTYzeQD9Tpk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEssJmFaUjNcMe-tZeCbsbrs5fXcEKeiq8HWWsX0RFfQA&oe=6A8EDC75"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mttmziU3w5AQ7kNvwHJzLAb&_nc_oc=AdrQEZye9Z6wJLxiG9eBll-xE-fAmvDqn6emPdCOR0sjoJz_sle16zjpfrmEAVacwn0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHQqDYClOvYiBO3CW8yuu94fj2L-sdYbDDdqD-9094YQ&oe=6A8EF599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrMs-fZ-GawQ7kNvwGYAYAB&_nc_oc=AdrFw-nAw-IHj6oJo032ErQMYxYEXaBSMXrrwKvRx2UKcoL3ALgwm8oCfhtkNUuUd6c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgE087goJsP5EqgVPJrpmrWfjjUDNoNha1yyRD9baWBA&oe=6A8ED9B2"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grapp
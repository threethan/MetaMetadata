XwZnBfCROb0ZODC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu81CZJuJFswKMteZkNmlfW4jXwEsa9Az6yy4n1GhuLSQ&oe=69986D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOnJkJrSyj8Q7kNvwGQ0ZQc&_nc_oc=AdnhpdNhdA_0BQiJ8Ix1CjhbRiNgRr-WygxmHTYRwc9YLaIYfvcgipZhItPqWIamVG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvxyQZrWblXibRHXbwLKDME-sRFR6Rk_LSUXCZ3lvYu8A&oe=69985132"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrnerds.de/tower-tag-quest-privacy/", "developer_terms_of_service_url": null, "publisher_name": "VR Nerds Studios", "support_website_url": null, "website_url": "https://vrnerds.biz/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
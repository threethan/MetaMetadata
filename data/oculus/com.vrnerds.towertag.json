3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8qm-sjIt9XRni1s8CsuEsGkIxrEBNy7PdFZr3mABQ0w&oe=6ACD0B35"}, {"file_name": "Tower Tag Screenshot 5.png", "id": "520008265743970", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_520008269077303_7443019661941137749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veQcFtieHlkQ7kNvwFcvGjC&_nc_oc=Adoq1bM7J3qRfbxjBhi7dfzQ5P_JW1Kmy1CnGoSETmwoWDUdKJFLnI8zU6R5Kw9_8BU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV6QgGvcaZWrUswKabyI8qSkpEv4_mW8DWRTa0KKqEgw&oe=6ACCEC19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tower Tag Screenshot 1.png", "id": "581363389697654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_581363396364320_4211978194189723017_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rstDg6o9uzgQ7kNvwGTXGJt&_nc_oc=AdodF-Q_hJospE9hmZrEev1lJIYe-lf493zhT89o161B7baPseYiwU2l98f7ya1F31c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOV7g3zIyX3aItaVwZECe6hkkEeI9kzwvUKqoiq093CA&oe=6ACD0872"}, "display_name": "Tower Tag", "keywords": [], "long_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes second nature instantly. Without any motion sickness! Conquer as many tower platforms with your team as possible to be able to move quickly across the field and beat your opponents with tactics and surprise.\nTower Tag works without complicated button assignments so you can concentrate on the essentials, become one with the game and let your body be the controller.\n\nPlay casual matches with and against your friends or join the Tower Tag Community with your team to climb the rankings (coming soon) and win tournaments. To be successful training is important, but physical fitness and strategy are also essential.", "short_description": "Tower Tag is a hyper-dynamic futuristic paintball like PVP shooter with a grappling hook locomotion method that becomes sec
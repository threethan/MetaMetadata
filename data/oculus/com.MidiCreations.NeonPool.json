20f&oh=00_AQGRGgk1FqZ-joiLQD363FeRG6aUv2H_-P3TdaBChGwASg&oe=6A819440"}, {"file_name": "ScreenShot1.png", "id": "1477897310635112", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314648_1477897313968445_426443042783417120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko6yKTtestoQ7kNvwGupTTl&_nc_oc=AdrMIPoArBGuo4A24QL0OVuG1jF20jBRNBlpschv6bdAJp1LI-qVQixHMve05h4iE3U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9NB1I7ZJ0GaoBPYjnT8NT4us50hhP-NzpyLPaH7BNVw&oe=6A81C84C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vY1gj8kwGsQ7kNvwFma1fT&_nc_oc=AdqP78FkVHjDgt-HcVroCYryvVNmmu3B6PzQ3VXkmOpJiGCclQksjjpxkB1tL8Z31Lw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF87C3gKwVqJsWtViuO29KuRj9WzRU2eFAldBpbuDbu5g&oe=6A81AB3E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aScB4OQdH0AQ7kNvwG8ScSt&_nc_oc=Adr1DTbTfhaiyFrkYdF1_gfDMWdqmLEcUJ7dberkhhBuP7nNwjKJSBy5o-C0Ig8FNf0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF118Ok8EbzTrdlQ2IQNom16MScjq5Nm25HNMzjlV-jJA&oe=6A81B41B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPqhpYFhpNsQ7kNvwGEJDPR&_nc_oc=AdocjUPECHqV_BMVEct4iS_VN09NRso-A_VIWOEu0JxQTri8y_s41fbGnFCn_8lIlrk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMtp3_eRfhNvt99R5qojNr5UNZrm5pmPiybBpO0OzpmQ&oe=6A8197C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA7EccWNfu4Q7kNvwFPVAKp&_nc_oc=AdpdkD27dA4XFnlBayu5pTbpx9UIXcfR5WGL8IcH2elLheZxRhrYyug-lyQsp3DTrbA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNJJ4P0p4AbLG40nLH8XkCiHKu1AwivrNw22ljTEJq9A&oe=6A81B5C0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connect
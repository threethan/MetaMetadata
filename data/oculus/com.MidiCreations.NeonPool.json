20f&oh=00_AQFk89Lyvrx60fB_g-ktUiZ7ow9I87TCaOjuumy92qZ7Ng&oe=6A7B3500"}, {"file_name": "ScreenShot1.png", "id": "1477897310635112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_1477897313968445_426443042783417120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oHYc76791gQ7kNvwFTl8Su&_nc_oc=Adohn7L8Nr5ibtb1YoFXRBSER3NButzuItTUKK3xhYP0-ajc--ehgeUIh-vcYGrV6DU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtSkcKjOBpGy0xleDqWK4cFQs6e62t22Ig-NXywPBAJQ&oe=6A7B30CC"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j3G2HQxyIIQ7kNvwEr-XoE&_nc_oc=AdrUyWYVg0FXxoOxcEfaap7lcpDOQa6BhxBGllICBkgOAwADY_92LZyu5n0j-7BRq8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0d8h3rG95GNznnl46CwNe6fe3av4OTvRc7b7TkLieUg&oe=6A7B13BE"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtl755DDRkIQ7kNvwEuKP2x&_nc_oc=AdqsulYW_I6xFGuEr-qq6QEOvf3z_5tVgpK0RYKNzzPcXftdotBvUMjhRKvfcBS0x2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB5TY-PPF90HDdB5XbdiSSs3LisY872FI003m3XuBjNg&oe=6A7B1C9B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HukcmHnvWkYQ7kNvwFI4MjB&_nc_oc=Ado4XiftvdsLoeEOyM62Pb3UkfrVRFAl_FMWQid1KAL7YloXLyl4vb0xwAX4m9ljiV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDc_LoX66692TGXgdInLq9jDEbLu1_fmuXOScXLgxO7g&oe=6A7B3889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oahke-SaFbYQ7kNvwGP6Xez&_nc_oc=AdrPxl0ugEkfWV-vSt5rGXflLKuFbg46e2hvGl7de7F3ujAE4koTsXu7rOVNIlgMDus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaYQS0_vBFN8TPn1uhvbEks9y4B83IsRACUujVYf6Xhg&oe=6A7B1E40"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connect
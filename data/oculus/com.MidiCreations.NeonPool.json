culuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgn1cVmn2NYQ7kNvwFMD0yh&_nc_oc=AdrmN1w3S_DhD9kAkVf2sFoz1gxuAn_HB6DM1aUlNLeP7GQrjQSgsaMCYJNlgTZOXhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUjkfe4tsm3aC483Bu9azS6bqQGxRuGfgGhE-ePBxfVw&oe=6A92BB49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKVX5o0LBVwQ7kNvwFXl7FF&_nc_oc=Adp-9Y3lwZNhbh7WWj7o9f7ZiT8U8eRdYDeek2xss9sKm9TDE-15pBkSFbhI0l38xzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDHGjxITzNmrgRn5vV0pElcDXcV6CG3RCsjTklrR2P7Q&oe=6A92D940"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html
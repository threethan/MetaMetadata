culuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEfDhYCQPAsQ7kNvwFgkFU7&_nc_oc=AdqE-F_OuCOoMSmPY0xXJqbkSas2qlhXd8A5c_smVI62j-ImBl_I2BmOMmW7B6-PE5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMfBrUYut35YA_gC6WvX0EiqAjOwzAr_BHCTlWXk9ohA&oe=6ACCF589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd7RPcplBacQ7kNvwFKQvYj&_nc_oc=AdoWmt0ATvKTH3lrBjl7t8vsVhgBcoMYfqVOLGbroOqhUxIRPKh_APa3oTp2CK_jABI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7g8K6cXmR-7kXcsN2tF0uLLpKyUiNBf_NybznPxB3rQ&oe=6ACD1380"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html
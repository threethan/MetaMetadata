4bSsRsTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_whH8sgDTJehuUQSpcuyN4uEAX5rJMeUlKAN2Ylut8tQ&oe=6A28224C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jriGPZnwRn0Q7kNvwGHEgXP&_nc_oc=Ado65FY3y0NQbkez2J-lMzHUzec-eoncpWQ8HHHfZArZwoV48PZR39MT9kSkbQRy8S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lgXZLsW9wAZwmQut2-yGlrCG0EmekUGVm826hzp-_JA&oe=6A28053E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbvoYrkmlSUQ7kNvwGR3WRj&_nc_oc=AdpdXrBRL7NJpbMpR8m331TIoTrp1op-9h2iwlQo1REEitnAL3Il22jc_-TPhZWw1eE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YEFjIh1hH3AcffeZz8uEHZJFjPhk601vPKWs3poHWJQ&oe=6A280E1B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDugoo8HujoQ7kNvwFmF-4g&_nc_oc=AdpqQqrGZDwM4pvFBlR9oU8K6z7ysvV_oXQJ1gp7H7uMj0rSBoCDv-TEUAc1zRMHR-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KkzaK02Ib4DaMKzqFxqiok_LPSbYekA8nySPOmxi2Jw&oe=6A282A09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8myXXQcXFYQ7kNvwEA1rO4&_nc_oc=AdpMoRFjG4ZCXN3em9LMNpK_BxIN4LahF5E-VaU04oekr-Pe8Rs6W_3r1GQkjGTX9Sk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KkJ_zjg2w57I8Rksub_pRQhAIn_3N3AyCtWbDfrbmxA&oe=6A280FC0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], 
yYRQ4dCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_69MQOBfadZMnC3MyV2CbhXyEHJCQhOXdbUJ21b0LBiw&oe=6A315CCC"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0UzeeD34o8Q7kNvwGSqyuX&_nc_oc=Adq9l6JAOiS_M2XSNlKSsvP6kkFjvMRS6ARQJIdsn2LOLXuqbzPGKTToJDSZty3wPAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HK8w1anPaDsBno6_jOLg3vliuVWgG-S7fINQHYIo9_w&oe=6A3177FE"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exyg6QxtwrwQ7kNvwGYV8xs&_nc_oc=AdoEHFkSVtF-XqjpbHmRefoYD4Mk4Av3xLlvhXzIL8gEFfqmF6S1WdKxFlMteYZTMfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SWNzr09JqUuUp7Bq3rnw0HOWSLFYL2V_xIISgvQjLGQ&oe=6A31489B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I00zT14-pgEQ7kNvwGGXym3&_nc_oc=AdqwkApe7kxak6Jn-mF4rsNJgSs3Xbk6QpON9BqhS4LD4bv6FABtwy7DKejjiehMPtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BlM9aRz53b7AehNAb7Lj7OwbV5MWzOSbAwqYomXwVoA&oe=6A316489"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqcfP1tOlv8Q7kNvwErSnH8&_nc_oc=AdrCGk-UMu0QbafJztAw49lGbKiAC-Jd1yTKb1g8w5QFuAXIzHMhEzvTep1v9HOCblg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3dZKXfaGJjSduPPI2fUvhQ3FjvUeYzG5iCCXg_xdnOw&oe=6A314A40"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], 
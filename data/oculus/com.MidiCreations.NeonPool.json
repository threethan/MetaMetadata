wl0Q&oe=6A22DC4C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jRBoG0ALtgQ7kNvwGTMQB1&_nc_oc=Ado4fLqVPw23xLY-fXk4HZxE4l7zgDIfnz6evDwjGZKYSFKPkvlK5M_cduQs5MIutfc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rU4OV_k1xNuvNyXAWsy6gsiP-W-gW5PtUfg2nbtj7lw&oe=6A22F77E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW5OH8IFeAUQ7kNvwGeL4I6&_nc_oc=AdqwrwDR_qI2bg-SgHycgGhJpq7F0p0gEYjCHZP78INd8BkD_hI-jF1McFHZojkG5mQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qqw_Y3r650dl4H-PN5RraNYnsbFHV7miWcqBlW84Xzw&oe=6A23005B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtIbNb7iFekQ7kNvwHSfbXy&_nc_oc=Ado_BwOi-9OCQyBEXXono9WBL_8n3HsK74A1P3zvQvtzok-r6bhN-9dw6VbwrcP45Zw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jvcIyd_RXidBRmwj3KPaXP41ko2HZVi5A8lerh2tY0g&oe=6A22E409"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jnHIN2KkAwQ7kNvwENTdzt&_nc_oc=Adr8RUu7yzBHEVVuAEIpJY0NfuoiaXsywU6dmLb8VMIQQSH6QpzjssatzLr7dT1lne0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ugGwiZfjhoaqh7T_zJiRfFi_Y5IyL3T-ALyDb3K-0WQ&oe=6A230200"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26386263941012535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.ocul
ggcNHqBj9sRjC9SCeHt_Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28IiIj9bKajoAmQiUZTK05jyfrdQ9QRlR9ZunbKtn19A&oe=69EA2BCC"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMMBHeasP9IQ7kNvwFI2g_X&_nc_oc=AdrCvE1GeWt39mU2N2GQBdPooPEtA2mJjxIXoGLHjHN7c6xOqi-0pz5QoiIPvisumzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3chXB5FEzOltGCPk__0yOAQGSRqwSOJiShs6j_pDr1Ng&oe=69EA0EBE"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGv277JAfEgQ7kNvwECVlmb&_nc_oc=Adr6nlGh3eyMYZS_2OVyb4dm6Cbw0vULeUrKbLbXAf6xyUZiXcIIhfj_1uGXOwhXm9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FKojqdDaFx9xjB3Mwzb-qkLJeEBvvmt96H8a5A5V_yA&oe=69EA179B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAnxq6c9-P4Q7kNvwHEFdo-&_nc_oc=AdpX0-PRIyACAwMDX0C5ALjgqGTPMj2CLxtlh6RX76WOjJPaUI9kBKadA7gghqJcSeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TuBIJV1XZQ8j83_F9GFb_9bBxkYADQn7INPv298yGpw&oe=69EA3389"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZoDE3szUqAQ7kNvwE-WJbW&_nc_oc=AdrUflxjuvI88GTeZ801651BLenQneB363SKZw5QV0XWnf6BBFhwjwye7jhvE_3JjQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21HYznFXleLUY_xzjLVEAXVKimy7D-J2FKWk53d5Mz5w&oe=69EA1940"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "S
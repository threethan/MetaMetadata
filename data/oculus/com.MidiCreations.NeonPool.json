105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_EToPK6uQYQ7kNvwEfzUV8&_nc_oc=AdpHvLa6If3puYYfOeVVbM5wek1QK3IDHuuS-InNywdwyWPvg-Dv6WZjBoFO5Cq0T7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QZKyXus1YQIZEz5WVF-E8SW50F1SAc4ZA4gGnvEsJmQ&oe=6A3D3A4C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlJL5HvWiYMQ7kNvwF7ZG-c&_nc_oc=Adr3LmzFx_xcGqDEhZ68Ds79FGHh1vYPL6yQEzyap06xQodcrqTrKMv_aVSqDjvtBOE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87RqaizXX3tQCm20iiTSIy67K3Yv8ZrJEzugulqt_TdA&oe=6A3D557E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvHBCTFWJsAQ7kNvwGnQCU7&_nc_oc=Adq18KZTaXPNi1PKztsu27S5rARH2VGmQLGllHMs7fy2vTddU73ArSm9bzjF9E1FEDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d_iQ7w0yGGZVn3KADzPUWIusXqrUEIaZkDD-dK0huww&oe=6A3D5E5B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfZKYx58zKEQ7kNvwHr7LJT&_nc_oc=AdqQLTTyqEb0OUjTseBLMsRl_mrgRQIoJyrKHOa-A_H9ONR3nF3dEc6taNHR0z7OVxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CvXIMBpRBWoAJcVE88HHhRMP-IOlCgbYJKcnwekuISA&oe=6A3D4209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CArnCxAxr1YQ7kNvwHHMHut&_nc_oc=AdpxC3EbNgH-5u6q2tht4sf6mK9cfe741-6ngpXpndQEW74QKDS67QPiJzsiXgmOoWs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x9qFeIhuBRIrSvoZekLFyR0b16YxaEpR6U_zidu5wkQ&oe=6A3D27C0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
culuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVauPv3V-dAQ7kNvwFgLHzp&_nc_oc=AdpsyJ8uPoL_H5vuIjfmhQU6-IPeS1Oe0oQU-Or5J48yxEeiCXAK60yobzccxOr8iyg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGcIV6KD-Qbi34VDO0Qsg9aPAR8SDHDEcugVVpAQKswg&oe=6AA02289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgrMBNLTVnQQ7kNvwE46VWl&_nc_oc=Adp1fIa3_-rxeMJJyceAvLnVz7qlW_H0JLwHnbYIz_g55njHJEAGPm1wg_70vgKUMdc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJluDYEzsfWZCd3ulNenc_tNj2LhqU0Wynu1-mIublOvw&oe=6AA00840"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html
L1xZxTBa4Q7kNvwGFZhNS&_nc_oc=AdrlZ_Hk6F4xCcAhd9JVxIc-SCcsJEYEDo8dZa2bkbCIaDF_WcHqLuHj7QlZ6MQgOCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaUV3-bBFkYGNHg0abHNyKWqz6qH00swUReLdu9icXsQ&oe=6A734F89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCSd3PY17xMQ7kNvwEqQSg8&_nc_oc=AdoRJZswPnxWIgE-ZCdG6B23bV_JC8RpHf6bUqHYaYVFTHFKJLMT7MiZm2g3V3H0G1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtZWKpqIsdGA_SqAM5b8YU1bE2DjrJofF5eYFy6YSWPA&oe=6A733540"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "h
9-yE_aqj0u7IkOEEHtPygw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W3gFFr_SabtA-DIgGcSb5sHvNntfzAXw6tzsURvwyog&oe=69E8DA4C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMMBHeasP9IQ7kNvwFWTYBk&_nc_oc=AdpCEjPZhJILF3TqpvrgWBaiYuRnhra8_gBOQ7L2XDcySGbg_u01eH8FCi7Tjh1p6XY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x8PLLmi1zS854A0kKk7t7KROCqJJjGQ36WGSvhFHPAg&oe=69E8BD3E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGv277JAfEgQ7kNvwGtFEFL&_nc_oc=AdoaSBU6VFP8r7mJ1r_xMrxzTvZIaBlYuKyQYbQvHTLQTUqgu_txPByWSofU5A8JaCo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B90OYBvpC921Qd_zubbIyH6z8-5pjtfgEpsNxJAfnbQ&oe=69E8C61B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAnxq6c9-P4Q7kNvwE7cRsr&_nc_oc=Adp-Webb5nIti6_59eR9PDVyeegLpTDLwlL9E5j1-7TxAG9a5MtUJJuuk5SsgbE1bxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wIT8xRpO_jAEdF92HcJk9LdGZ6QCt__g6_CiyQkwNog&oe=69E8E209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZoDE3szUqAQ7kNvwFWQCPu&_nc_oc=AdrdqT1NZMxOJOFdoCKjiM_sYDLtgYycPAghUUMku-jVxZDrzB90BgU-01xGp2q1iGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BTULRdWV3O4PhxvFn-pyIE2a2MOh4eD4J3vS4TOE5iw&oe=69E8C7C0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "S
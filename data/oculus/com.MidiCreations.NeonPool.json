a&_nc_ohc=H2qaQW04krAQ7kNvwF2pNHH&_nc_oc=AdpX7WkkIyeZqrOnMNmQ7nlFe9b0djFcGeI2O6bY0q8M-4W4o4kFNX_hFPhqreXXhsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1QwIsjS0Ag8ZZu0hCjALxV2SVSQnjmC-WskOIbpPB7gQ&oe=69F0A63E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgRho5nTCtsQ7kNvwFUvnTg&_nc_oc=Adrnv7ciBY4IjSmbjMrX7iEpdSxORoMIPFN7G3sx-GlgBc1Bxmo5Npg2AZOgXHp0-fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0sivAd7dj9wR8ILpZtNx6_f-BMqDxfuJRaL7l96kFScg&oe=69F0AF1B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQGQj1H0cfUQ7kNvwH22FhI&_nc_oc=AdrnoOFE7SvUE10uXZHJeGPx3t8pZQpEu54_vDPgSfLtiY4YRsiXne51hadrR_yxrWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0YmgOPALJG6DrcY8wKzWRjLsjg5FPlo8TZUrqJxetEMw&oe=69F0CB09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNabWHiqOlcQ7kNvwGJFrUn&_nc_oc=Adpq6EBsWxwH7RY-N-G1MutLBxf50sj_pQ70Fc2Fy3U0enMljgy9qa5XbVjaLIlCMaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2HMnwZ-5FV8xt6QfQABA850hC0_ZyfxFCec2jAgAzCvw&oe=69F0B0C0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26386263941012535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_973104715136369_3194392959466505948_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bls83M8VAuoQ7kNvwE6JE3c&_nc_oc=AdqXpzOkVF0Z6cRdktQOr6zWmqx3gYJH2jm7pkC5-B2v5qSPD8vJxqqdoXUl_o10ZzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn
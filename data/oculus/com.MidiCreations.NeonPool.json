105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpULtNZBwekQ7kNvwE83UtH&_nc_oc=AdrJf2BADqeCwHBa-k2aPwLKWd8gYyDH5R667yW_hLt8aaN7iLReuyTqpb84hAKDGjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y2eVGjDrwIrwcyquGeFCyD2l86Xz2aZD-L0EQPe-wPA&oe=6A37F44C"}, {"file_name": "ScreenShot2.png", "id": "1461166165412321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821194_1461166168745654_5440374780000579121_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzz0Ar4GaH0Q7kNvwG1AMwQ&_nc_oc=AdqLkQ6mCFi-8z59_rSDjhjryLWfLcOOgCZs186Eitoj0EEAMvLsrwTkNrHcSiDkkmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1kffK3YocQ5Hag37IxmDag_bTDXvHMgR4xs8u2cnVgg&oe=6A380F7E"}, {"file_name": "ScreenShot3.png", "id": "1475419777303291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_1475419780636624_321223828696856386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfMbJftLgPoQ7kNvwHU_Icy&_nc_oc=AdqXLocGNSSbzazJ9rpoZVlb58TeTaqkf82HKKUjmEFFPv_teS9HdcNrHsuJARONqWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jsJo_PyHSSoAFRd9_i0nZyl5wO8-QEN_N3YI0xbvrgA&oe=6A37E01B"}, {"file_name": "ScreenShot4.png", "id": "2696429090738581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2696429094071914_4027493837046151170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzsJXeHyak8Q7kNvwH6I5ri&_nc_oc=Adpo12cp-5yjxPwfktdZJQlbYYOH5qnUX_84RVY8Oe6QPPzpf54cS-p12uEvWlXxEww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J9C--32vR8dCxIj0Xx86bXzitLv44Dp-syJqSolcvIA&oe=6A37FC09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2236750433728309", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820001_2236750437061642_7202580099581255007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMlYYxKiloAQ7kNvwG7Jt-7&_nc_oc=AdqBfE_Aw4oTZwaUM0cIbdnogUPTxazUvGPW5yuUS4LaYgUOTauxmLZIxWt11k3_MhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qX5O8yk2tJeDesw77VYfa4QM0In6Mo6va2gqgCkztng&oe=6A37E1C0"}, "display_name": "Neon Pool", "keywords": ["Neon", "Pool", "Billiards", "eightball", "Elegant"], "long_description": "Neon Pool is an 8-ball Billiards game played on a billiard table with six pockets, cue sticks, and sixteen billiard balls (a cue ball and fifteen object balls). The object balls include seven solid-colored balls numbered 1 through 7, seven striped balls numbered 9 through 15, and the black 8 ball. After the balls are scattered with a break shot, a player is assigned either the group of solid or striped balls once they have legally pocketed a ball from that group. The object of the game is to legally pocket the 8-ball in a \"called\" pocket, which can only be done after all of the balls from a player's assigned group have been cleared from the table.\n\nThe game contains 4 levels of difficulty: Easy, Medium, Hard and Master, it can be played on Single Player as well as on Multiplayer mode.", "short_description": "Neon Pool is an 8-ball Billiards game with an elegant neon environment setup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-06.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
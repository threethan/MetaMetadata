ZR8r8je6H_BzJ19U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o8roOvLef32lmb6qDIwbJOzUBvcuverU2QisqxQB2Fg&oe=69E8B693"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P4SJm30pFoQ7kNvwF02s7Z&_nc_oc=AdqtDWGbXluI_Dyr6RM64BflkIm-MdFf8N6hPSlG3pV4VgbqBLifgcfHfF4rkWZSgDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l1Fc3lX12bZQVoKBAgrDzbOuf_9PkW5yb4HEZ8XeGeg&oe=69E8B2AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqgNYvT4SaIQ7kNvwH25MRY&_nc_oc=AdrH_uEt7iY3rmoF8vkjTFteeH8dpEKnpD-ZIexZ3SeQhzaH0ctitEy9FlZftRCbeE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aUAVcIW3rrSvE6RJrb-3BZetlIkF2-EH6UX3e5SHLnQ&oe=69E8CE51"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
azL3P8uzGANcwoGc0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKGqlXZf9AbL7NDjz0irkXeyBI2TfJLHzOwTHnMjMVvQ&oe=6A562313"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1TmtOwfV-4Q7kNvwGVx3Vn&_nc_oc=AdosCSaFOiF3PC9jglCz-k4xsjRTcBKnVDr7bSGsSuQ_ous5V2G92anGzg8ctdptDiM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjmr3sKS_foFn-PlAvgopEXwci070uAlVWFyR75OxmTg&oe=6A56576E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3URQBDh6rWgQ7kNvwHyt2Dq&_nc_oc=AdpUeoktuhAT0wdsiev-XPbxM9rssQCsylfELQv6GicDTX4OjRQt0y8MGPdtrvhC7jk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM8NTSXPpw4jsyDZmvUcgSCd3v3qp1Fjk3sL32YAO52w&oe=6A563AD1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of th
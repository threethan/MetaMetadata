ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618064_1268715498238943_5088081355294472252_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ1LeOGaOdwQ7kNvwE_h0D-&_nc_oc=AdpVgfTW72yOb0dP7P0d3ws4RqqrhHWvlZSz0P7NpUMAiu1_E3XApoTlAGHKSD9PP_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34BYDaCkBa0QL063LMPwpie-cKMpwHn2Ql2ePgG5oSpw&oe=69D8FABA"}, {"file_name": "7.png", "id": "2729253653938495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_2729253657271828_6027909120106676367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGIAXQCHX_UQ7kNvwGunCNn&_nc_oc=AdquwaoMjlgYnfcFCtffV_LIBMNWRdOLiAeIbTtNpdAXirv7UO5Y4PuUY5G59pOMsa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31MVOByirUxuL3Tt4q0ce1y-2L8jNFoFEqkK1-Qv5UVw&oe=69D8E46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "703872235920063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295957_703872242586729_5472455875205162841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiQ_u8s5LpUQ7kNvwHsbJcB&_nc_oc=Adq-oIirVf2uDr_4jD2nFv1z4Xke89FOIaWN-0WWkggCDx9cLXX1ACmUDnIXBEsJ3do&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af300c_P6wnVlFhwESBr4PhYSIHrUFaOfJo-bdvkdsM5aw&oe=69D909B1"}, "display_name": "Mecha Force", "keywords": ["mechs", "mecha"], "long_description": "Join the Mecha Discord server now! https://discord.gg/VuNyZQQZKH\n\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n{8612168848909623}\nExperience intense, hardcore melee combat with an arsenal of mind-blowing skills!\n{1281171763075308}\nSwitch up your weapons and colors anytime to unleash your true power!\n{1304830153868411}\nBattle epic alien mech bosses with everything you've got in a fight for survival!\n{1287161829145409}\nFeel the thrill of powerful weapon combos and their explosive effects!\n\n{585450227365264}\nInteract with your cockpit and unleash your EPIC ULTIMATE SKILL for total domination!\n\n\n\n", "short_description": "Join the Mecha Discord server now! https://discord.gg/VuNyZQQZKH\n\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel giant KYLIN and fight to reclaim the future of humanity."}]}, "developer_name": "Ming Studio", "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ming Studio", "support_website_url": null, "website_url": "https://mecha-force.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34058151120495096"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_2741253386223291_8218475437022163979_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKoGtEESuW8Q7kNvwFic-jd&_nc_oc=Adqfx4cAO8F43ci6NsnVgcJCUzvi3_Jkt37Tbip2cw6XRlIzteYg-5sbqrB86OqTb9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=
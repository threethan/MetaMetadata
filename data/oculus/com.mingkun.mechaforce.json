gFnw35yx1xvahsHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iz5NHHUL6ZCo5C1pb0bELAX5k4AXSpFcwxVNBqtU5zg&oe=69DCD913"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXyfFM3aZVUQ7kNvwEu-Dgz&_nc_oc=AdqPnZOQ3vfa0g_33lAIv0WXacqVUGU4HITqNblw7nuPWGOcQhYmeMZehQ0OMZPsz3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nT13BMfuGet2UEnkOUJjVzsLAaQC77fCEgc-OVKy8UQ&oe=69DCD52E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK97gBOuZFYQ7kNvwFa-wOw&_nc_oc=Ado-P47Rp9RlsvQWIl1yda2xo8wVj8jHNZyW0wqFFt_AQN_XXej5Tr4JH7OHKLEOPBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y68z8-r-8QKb2Y_ROepmXmOrNxEvpSZ8XGH0K-T2dIg&oe=69DCF0D1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
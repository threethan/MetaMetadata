80euDe6dhFn6cq46xyv12HQKA&oe=6A9C3AD3"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RO8jIzgV0pcQ7kNvwGrJ_ON&_nc_oc=Adrfwy-AG8V_VhqOmFInw_tHjifkz6V_m4wvLsDqhHKbGCxzUMtIHN16X7RPGtvdo_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmYLKpmOY6NWIr8S_p97pMD1tNH66hVd3j8N5KIJcyyQ&oe=6A9C36EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58asCrfE02YQ7kNvwEGyVNJ&_nc_oc=Adql9L2bZB8yGQY-koJnzGG3zlhsIliu3lBnY24E1fuHIBNmwUsKM_ew1gOCyTtfZVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJkBJCeuBd6mhN3mDJV7zKweiwrflKBqghPEOtB1RSUQ&oe=6A9C1A51"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel
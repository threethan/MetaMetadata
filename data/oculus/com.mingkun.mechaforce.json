dpuv4pB_0VkSmIlDjwFDib9yJaVZakUsI6PDB408miJGaVZpEyvZcturPipI13gkA0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEEdOejzF92SIQNkYBMLORcLaS3ohCXs4_UCZty7eQjg&oe=6A859913"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvI6TdqrFmMQ7kNvwH6hElo&_nc_oc=Adq9hjOIhjKl0f4LmxxBLvzsgddLi8hUtem8NaMQ69EKtUpDArEb-vVYUfjjBuO5ryI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMkfQ79fSUn_atm1gCaW30ovkEiMoKSCfZmX3-QCni4w&oe=6A85952E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw7prjIQ0c0Q7kNvwGusIEc&_nc_oc=AdqzpOmIBoXKlRJApUyHeUlTv6Ufwfa9uFRI03KfCijqegbDB-qG2OW7DJYpknSJ43s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv1N64P7xrQ7gV8zCjrZBszjA_uE458c_SXUixfAs2CA&oe=6A85B0D1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominator
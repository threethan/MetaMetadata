oPrlIG7-Mqy1L2Fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gvgJAjZxcGqKKU7PX6m-GenFybqp10Aq9xWn2T8hsFg&oe=69EDFC93"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sH15PdqKyoQ7kNvwFVTPQB&_nc_oc=Adq3o9cQR-U1NAIOGhKBwMT69DwfWRAxWsDtE6H3_hlYpqzbeGfDxTZlPxjQyBdDTaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HXtrF4hKeNyMGyKxtnm32iO8IKQI8RQhlg4QPV5Qmjw&oe=69EDF8AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9a71kq8rcQQ7kNvwG4LkpH&_nc_oc=AdpcqvpW4Ry-kozi6AD030MP7Q5mwUJOwDw8H4ilBa2sSyFBywpERy80tdWplVZMpVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YBBO68XxTL7vsUGE7kA22GwOn-9mYhwidcUjCzLZGqQ&oe=69EE1451"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
-\u5973\u738b_2_0.png", "id": "1629104904656328", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_1629104907989661_3063243641799911176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WTsS38Tc1YQ7kNvwE4ffLe&_nc_oc=Adq9FyykWfE_f4VtT-EwSBFZKW3bbquwJr2vtUyXPhHbBnGPfOC-RlIaXnewFa7fi_c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPkKmwShrclzeWy1SwPVW2S8Fzmw9gtm3KfQpfUMmX3g&oe=6AFB26D3"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X7kP_FFD9UQ7kNvwFD0APe&_nc_oc=AdoZj80qUoSxqpNscLFfDlkrhcVGtb9CFVKzefT8cisKiX47Vk6p4VIt32nj9etXhvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBpbKUKXuzWw8EVSjkfKzQN6aTk9hh4O6FSY2GJIj7Yg&oe=6AFB22EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LDMaNxEYAcQ7kNvwG0ygdH&_nc_oc=Ado6f9WArRKCILzqRNLYBPApmk3FziHWoU02tRqipqarXdwuDRThAOAfu0rqH1xZ-PI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_hH6hGcGWOldeajf1ec6KujOtrMXIv-rWF4GzOv-s-g&oe=6AFB3E91"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel giant KYLIN and fight to reclaim the future of humanity."}]}, "developer_name": "Ming Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mydearest", "support_website_url": null, "website_url": "https://mecha-force.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27606377265672546"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PENDING", "id": "1596576005194213"}, {"status": "PUBLISHED", "id": "2001513000438110"}, {"status": "PUBLISHED", "id": "1254436263569744"}, {"status": "PUBLISHED", "id": "1381205620441398"}, {"status": "PUBLISHED", "id": "3920381444918925"}, {"status": "PUBLISHED", "id": "776961078746442"}, {"status": "PUBLISHED", "id": "1479975763267119"}, {"status": "PUBLISHED", "id": "1019499706783073"}, {"status":
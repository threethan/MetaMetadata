SDh4X-Eo4GJniku4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mDh61dia8EvTUnhpcFKSYL3GNhWPaJYRpAs9DuY8q3g&oe=69E61393"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de2Amf7Kl3sQ7kNvwGTDBch&_nc_oc=AdoOhO8tCNZ4eSmmiUMcMf8C-OhoD4Eln2JDzT6PvEYfTGba1xCc_h9ktDjTgYJK9B4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nJPKNIP5stWxJcuWH7G3aEONZItuK3BnWZo2Hoo8viw&oe=69E647EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92bDgOv4cAwQ7kNvwF8MWbU&_nc_oc=AdpXr4A3QlgeJFULK_K2ATO7w-CJjCuKkCLQiYApjYpCTz3YdeEX0S17ISdL6zPdFU4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YNwz-c6j_AteuFNZUPI9xZjCJLXLaXZBfQNpeipofYA&oe=69E62B51"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
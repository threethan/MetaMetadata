_WLAWpn-YzXliL6_Q0BFham5g&oe=6AC90DD3"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj4GkgNQ1fQQ7kNvwGyN7jd&_nc_oc=AdrMjcrBBsnC2PHIr2s3gVMAh1ZARjhWA3xzZ7Vpf40Dy7USP0cCIfPvb-0dREYN8Fs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjAwWFhlW-yW2QZAlB5FJnE5N3DLVYVdORPClmBDvucQ&oe=6AC909EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgwfSzARmCkQ7kNvwFxyLj0&_nc_oc=AdpZWZejoye7gZSn9o3HioLxmLVWohDAReX_0kmgIu0BNBZiIQaCTm7NFYqqFi0NoqE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO59cyYiXIhviK0Ylk53CSEPYToWRSIq0JTDEiFRMDl1w&oe=6AC8ED51"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel
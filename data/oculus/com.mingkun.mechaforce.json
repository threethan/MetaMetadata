8WpmIy7WYR5zfQgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPu0Q3_nVRX3A8VbfyR9dPvE5Ht3KR3M765Y5Viuypqg&oe=69C91293"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL3sAr22dG0Q7kNvwGvLZWA&_nc_oc=AdrDrnAswccfa7Y_YeKR3W98cZfWeT6jPj9d0dxC1ZPO8D5TeUjBrPc7jELEwI4IOsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTNvf1wRqjkJrGJDI8WHatFWjHFj6rMtOdGriuXbOyoA&oe=69C90EAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp71tEbLNawQ7kNvwFJ8Ci6&_nc_oc=Adqctp3E1m4YQ3R_VA6wbT6h2_B80rm4jyLqBy31jwrJAp5RfhsqlipxKwSjk_Gr3KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqqoLf29BmYPWanulR0eGkCPlBmW35099woz6j9Z0p3A&oe=69C92A51"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
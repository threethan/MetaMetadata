K3VkE9F-5lZu8Z10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7sSIU-ZWFkFvSvnYf6GJT8bhJWcgqAN9i4qQ8rMiJoQ&oe=69CFAA13"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV-qYraJ1UoQ7kNvwEv0s1y&_nc_oc=AdppZ3OCjVuusjmTQaWv_xlnAlNOQJSj-Ry2AueDENI64-OCXL6TJcQW10E-NQREJdA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvsH_nh9vrtZpsgpgSCAndZtgbpIFZ0KL8iCOITxr5ww&oe=69CFA62E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61N7dtuB6yMQ7kNvwFT2hJt&_nc_oc=AdrZ8MtVdXXvpPVp8D1qYGXN22-lPRhErl-WxMXmrq1zF2aOCccyVxbjMmkLqor1dZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEaCpOpeQcQxi3jziiLKIVi0Q4t7_H4OwvgQf0MlrYcQ&oe=69CFC1D1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
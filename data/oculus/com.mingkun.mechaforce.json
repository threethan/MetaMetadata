ixY6Mkm72d869S8hs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z43BpmcDCmnFTF3M8G9vxRdgopQ0t2cV6JTwfSc7IWA&oe=6A1C5953"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEUSkkRW-68Q7kNvwH2Yk5S&_nc_oc=AdrDTQm3b1fBo2YpckgsJKkTLjAuaq8cbZvWvN7K8TfW6BxqVsVNeds3efn_dr7Knvs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QAzddBM0yOux7oE2JHsBP6-Smp1kkozq2q6_EQSCdNQ&oe=6A1C556E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VZrzbB3nuIQ7kNvwEtDk77&_nc_oc=Adrkk65TQWxbgerAGZt_jXby1ZBD2ICPYqsmCGiw02_r384C4Jmhp_7mtHp9qXpvoAM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yYrrTx91_s3pe8QQzCilifjVtyoy5fpXUjMQ7R4Ng6Q&oe=6A1C38D1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of th
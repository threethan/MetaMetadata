rCHyUNsn533GEkbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P1jmUbjS0GlRpVXHA4yWcw8Ks4CYqHNNMvDYYKE60_w&oe=69EA0813"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P4SJm30pFoQ7kNvwHYAb6e&_nc_oc=AdqFrHG27ugVYq2Z70mzEYMZxC3spL-UIFqFmK-gXsEwx3xKaxU5WgUU5LHK7WOXqBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tR7UtmU-ZdlpXuiKMeXW403kF8NunxmsI8eqPJpE0_Q&oe=69EA042E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqgNYvT4SaIQ7kNvwFQOliU&_nc_oc=Adq3PesFDVxsEUjh3QAi4HpWNegtJiCC1aDO7wWLiBmhfQVq5jV-h_rzGEsDA70l1Ok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Stk2vV1Z9I2DMz3AGqdO7r4h7YDil_Yc5YPxHdT8juA&oe=69EA1FD1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
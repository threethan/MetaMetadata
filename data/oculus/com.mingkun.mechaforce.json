wYDww21O0BnOYRO-0uNqu92dA&oe=6AF9D553"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X7kP_FFD9UQ7kNvwGkCVIM&_nc_oc=AdplhQvPEc7icuG6r8tQJy0oMR3Cg2ycaKNJSj4XWv6QNUKycqh4H6R5zx_vaqaBb4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT5c_5IKUEJMdBmlIbZ7sPbChB3DsCQ1wHFqo7ObSRVQ&oe=6AF9D16E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LDMaNxEYAcQ7kNvwFGgbjC&_nc_oc=Adq5wF6nzYKoOMp5NDYNMa00AZ4YPYusGkjm-rErAeaGMeJFQCiMKm76fqoBynbB0Uc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJGhtNHryJWtDTPV6fjVBTnqLmQks8b_-Mjbb8Ubrdnw&oe=6AF9ED11"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel
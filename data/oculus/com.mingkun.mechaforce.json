tP6gqq9Cy6IGJGlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LarZKPcxPjRCBP_TzTSKLF7y1nB06LCY6DoXj5cyqJA&oe=69DE2A93"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXyfFM3aZVUQ7kNvwFY0GzQ&_nc_oc=AdrrIxlN6Jzc4Imi_O_k1mVon_OBZLpjbU8ZKOCaoUGITVhlKXUKYte47bBf0X7Eoz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xL6m5RPOi-muwKVRiLdKx9uWlRpOGK5ZJixcNBSlQ6Q&oe=69DE26AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK97gBOuZFYQ7kNvwFP0EvR&_nc_oc=Adr7F4u4iQkPniu4eGvd1GndciHpAlVorVHWWMz-_Ddy6yvk27xhDQmK0kjcvurS6vA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U2SWg0njIFvT2SDOd82P7grtADLeWyfzw23pYKgATSw&oe=69DE4251"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
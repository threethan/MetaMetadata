-\u5973\u738b_2_0.png", "id": "1629104904656328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974812_1629104907989661_3063243641799911176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmFgb8QHQkwQ7kNvwFEQsJe&_nc_oc=AdqSt2u2P-sroq-SSMAHLuzcMK922y_b-7QnWnEbAtQXxtGUFRJahTJpK9uTkICXoEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZ1y5mTwjvk2Gdu9pg-KLK3kl6xZU_4zsoAvjTsS1bjw&oe=6B103ED3"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-6YFq6acmUQ7kNvwFMDOAk&_nc_oc=AdqhCLhx4VhcENcLLeQDX1EMoIbcO796spOSitlIAE9U_5EoAcZQ1sChS1cUaBcjEbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZT02m-LmN3rz26qhDvFqdMXDn1vE585fKx0rdgX-Uww&oe=6B103AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEJxMw8IE0MQ7kNvwGjh4Ub&_nc_oc=Ado0isAmtjmWXIFQ1aBT-Qvp_hWSSsX9vvxFvUNN5YzIc7Kr-u5WbCIVzYX8JUtb9eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXu2rNMnXYipNDiSsxarYCz-E_N1hIYBvQaN75lZD7Yew&oe=6B105691"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel giant KYLIN and fight to reclaim the future of humanity."}]}, "developer_name": "Ming Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mydearest", "support_website_url": null, "website_url": "https://mecha-force.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27606377265672546"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PENDING", "id": "1596576005194213"}, {"status": "PUBLISHED", "id": "2001513000438110"}, {"status": "PUBLISHED", "id": "1254436263569744"}, {"status": "PUBLISHED", "id": "1381205620441398"}, {"status": "PUBLISHED", "id": "3920381444918925"}, {"status": "PUBLISHED", "id": "776961078746442"}, {"status": "PUBLISHED", "id": "1479975763267119"}, {"status": "PUBLISHED", "id": "1019499706783073"}, {"status":
5OPBgq9SHz8Y_5B8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zOsEnzIKJLmhSMI1qiukQ2_h_c4lVOyEQp4bs2Fl81A&oe=69D24D13"}, {"file_name": "\u5bfc\u5f39\u6218\u6280.png", "id": "1091879432315855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572660_1091879435649188_1701237092599665992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2g4afZJAhcQ7kNvwHz1vv0&_nc_oc=AdqW9fz4foMApJRce79oLRK-IR4AS0lL523YT0v4lh5-wwIW-LuSDUVP16rJknXIBiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c-eF8aWEssSfqzIPe1hGIGaSsr5LU9GPzNxYL-p1Tlg&oe=69D2492E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982494_751118513198606_7854897098861557892_n.png", "id": "1098860361900305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974907_1098860365233638_4894531416401140441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61N7dtuB6yMQ7kNvwGU-aKj&_nc_oc=Adq0T-zg32hBvRZ1mBqH4t2JyYPCs6GWfqOa_PLbxNI78O5T0utMkSjyXOkvdFXJK18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XOHfq-DZaZPatjS-B6_A03XtylLRw9Jq6R466UZbbaA&oe=69D264D1"}, "display_name": "Mecha Force Early Access", "keywords": ["mechs", "mecha"], "long_description": "Total Fusion with Mecha Action in the Union System\nFeel one with the giant robot as you climb into the cockpit and face the Dominators.\n\nUnlimited Customization Options for Your Robot\nUse the multiple options to customize your KYLIN mecha to your hearts desire.\n\nEpic Battles in a Roguelike System with Random Maps\nExplore the game's roguelike system, complete with random maps that expand gameplay possibilities.\n\nNeutralLink-Navigator\nThe mysterious Machineera (Maki) can connect with KYLIN through the Neutral Link. She will accompany you in battles, helping you as your navigator.", "short_description": "\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the
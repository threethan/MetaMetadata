99618064_1268715498238943_5088081355294472252_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IVN66hGZj0Q7kNvwEZGY6f&_nc_oc=AdnWXME8dVRmk8iSY-I1f_bSHjoDAlkFuwLJV-41hXjdHmyBZopz43MxFCs2GRwUcmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiME0ozYg0coQtuOadsPy10RtOn9KIPKidCfITGCy0pg&oe=69BE9CBA"}, {"file_name": "7.png", "id": "2729253653938495", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618064_2729253657271828_6027909120106676367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0SG4dw96foQ7kNvwHokv2t&_nc_oc=Admq8i0mdX4BGnEbikNOP4izBULmlar5kit7zQSjE1GmhrliNYcXx4HUXoL4S1SHurE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygAlDhdqNWDKFeXfWsa0eoQ1MemKzzkid8MFHhAklFWA&oe=69BE866B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "703872235920063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295957_703872242586729_5472455875205162841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeZV5npKNpEQ7kNvwFJC2xL&_nc_oc=AdnT0Xv1NCPh3E3Ded8akfHuIoiLV029T00xYKI1Ry4LbNKcmXkqifBLA7gGRJTV5dI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl7P4FHpA0vtMY_QfVaaO1CjAE0-g8RHKk-BHp3U1OAA&oe=69BEABB1"}, "display_name": "Mecha Force", "keywords": ["mechs", "mecha"], "long_description": "Join the Mecha Discord server now! https://discord.gg/VuNyZQQZKH\n\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n{8612168848909623}\nExperience intense, hardcore melee combat with an arsenal of mind-blowing skills!\n{1281171763075308}\nSwitch up your weapons and colors anytime to unleash your true power!\n{1304830153868411}\nBattle epic alien mech bosses with everything you've got in a fight for survival!\n{1287161829145409}\nFeel the thrill of powerful weapon combos and their explosive effects!\n\n{585450227365264}\nInteract with your cockpit and unleash your EPIC ULTIMATE SKILL for total domination!\n\n\n\n", "short_description": "Join the Mecha Discord server now! https://discord.gg/VuNyZQQZKH\n\"Mecha Force\" is a VR mecha action game. Pilot the gigantic KYLIN in a chaotic future and face the Dominators, the ultimate threat to humanity. The fate of the world depends on your skills as a mecha pilot!\n\nMaki will serve as your navigator, control the steel giant KYLIN and fight to reclaim the future of humanity."}]}, "developer_name": "Ming Studio", "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ming Studio", "support_website_url": null, "website_url": "https://mecha-force.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34058151120495096"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_2741253386223291_8218475437022163979_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FzD0W6AHokQ7kNvwG6C99i&_nc_oc=Adk0N-utT9y9cwkGDddvaxmwp0GL3xVGqfr3XZXTQwIPIP4k3Sp3fxVsjCe409jhTzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK3B1bNkbBoeHCDyEijoe-yq4Qq_rtitWl6zMiJRDRJw&oe=69BE8FEB"}, "is
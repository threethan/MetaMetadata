culuscdn.com&_nc_ss=7f20f&oh=00_Af_8nNqDlFOXO4R5MEZy4gTC3gUu9D4ddiJ_M-6v8-bx7Q&oe=6A395AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover..png", "id": "4033990933345146", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974838_4033990936678479_3976172047705502593_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TesuvJL2bo0Q7kNvwHwDxoq&_nc_oc=AdovTBL9rurx7zpcgq2cdl212vL_UinMIkaFkdcFNM4JlPkYTTcuJEDTAm27c7DqzSE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kUsIt-kV8SKwDdtNog7twaRimfxTI100wbMyUWFU2Jg&oe=6A393A0E"}, "display_name": "NAKA", "keywords": [], "long_description": "everis NAKA provides customers with eXtended Reality (XR) spaces for configuring immersive experiences to cover a wide variety of use cases:\n\nTraining spaces\nConfigurable focus-intensive trainings performed in safe, controlled 3d realistic models and environments \n\nShowroom and retail spaces\nEngaging and memorable experiences for retail and customer support processes\n\nProcesses and business support spaces\nBusiness-specific connected process for employees, associates and other collaborators (e.g. onboarding, support)\n\nMeetings and collaborative spaces\nMulti-user, VoIP-enabled environment for sharing documents, videos, tasks and much more.", "short_description": "The purpose of everis NAKA is to help top level organizations to provide large-scale engaging immersive experiences either to their customers or to their employees by providing an enterprise-level extended reality platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.everisnaka.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "everis Spain S.L.U.", "support_website_url": null, "website_url": "https://www.syntphony.com/naka.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584
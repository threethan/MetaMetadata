nt-iad3-1.oculuscdn.com/v/t64.5771-25/499299928_1836067150286610_387184564133014991_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CURuwKfw1CsQ7kNvwGtxstw&_nc_oc=AdrZOYhmAzXMFaiLAv8-zWrgkdxCxT0baiESpbSDioRe1q8JYYfX6loj6amIQFZ5RyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5k1t-d4oxyY6Ypu11Y7r-iJ_27DgoLdRAA55E2q3Qvg&oe=6AE4A054"}, {"file_name": "x.png", "id": "987545916631485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294630_987545919964818_5925676768443313215_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwHfKpyAd0EQ7kNvwExN3p9&_nc_oc=Adq0E5KvFtZER4HN2Zrfu4ITSyfasuQW5BAzjXRVctV1N2TdI0Qm2ORWWYHKEcQEKg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUs0V2MZYTtOaCKsK2KKW-x66CtGidOMvmBn4f9IMysw&oe=6AE49A79"}, {"file_name": "New Project (13).png", "id": "2151517518592509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293732_2151517521925842_1158955511296185329_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fZ6T1vs190Q7kNvwHEBHXv&_nc_oc=Adqorzpu2Fya4dcB5kWC1GE8PhTHONoMpnF0jVIiPqhwcndh-GbtDAJ7cT03gWtZW_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiQJ9LqZRtynTRMPM3uYvocqwfC4FhQImMs-DEFzNXpQ&oe=6AE49BA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hammer Core", "keywords": ["Hammer", "bash", "bang", "fun", "hypercasual"], "long_description": "Welcome to Hammer Core, a fun and simple VR game set in a bright children\u2019s park with colorful swings and slides! Sit back, grab your controllers as hammers, and whack playful cats popping up in the park. Swing to bop them before they vanish, scoring points and building big combos by chaining hits. The sunny park, with red slides, yellow swings, and green nets under a blue sky, creates a cheerful, nostalgic vibe. The cats, with big eyes and cheeky grins, make every hit feel like a silly game. It\u2019s easy to play\u2014just sit, swing, and score! Perfect for kids and adults, Hammer Core offers lighthearted fun without complex mechanics. The intuitive controls let you dive in, while combos keep things exciting. The park setting adds charm, making each session a mini adventure. Whacking cats is oddly satisfying, and the happy vibe is great for solo or family play. Grab your headset and swing your way to cat-bopping fun in this delightful VR game!", "short_description": "Hop into Hammer Core, the goofiest VR cat-smacking extravaganza set in a wild children\u2019s park packed with colorful slides and swings! Plonk down, snatch your controllers as epic hammers, and get swinging to bop cheeky cats popping up all over this laugh-crazy playground. Whack those furry scamps before they vanish to pile up points, chaining hits for super-silly combos. It\u2019s a riotous, hammer-happy, cat-bonking bash for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/hammercore", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31250258591227906"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "741374428280032"}]}, "baseline_offer": {"id": "741374428280032"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751526060, "status": "PUBLISHED", "id": "7
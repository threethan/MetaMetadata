jXxDX8Q7kNvwFEoY-6&_nc_oc=AdpV4s-WoxHJVZZjWQhLpkuHPpBEdbiXG80P9q6bACGFUiYLlIX9hbHZZbo01wSyuds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLuyh-1ezyrP4E3FAJeGTvxvmKRHLdeGwpvpJzCyimDg&oe=6A4E3759"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMliDeiAYegQ7kNvwGtbVSn&_nc_oc=Adpn6JguTGpXlM1tIPfOUpb14tpN8teAVeeDC1OYqSY4pW0pNlwykizm1z0fkuEZijA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfQxujUzcPzG0fOd6zDvLiVzkjmZCZb7-Umy68traDEg&oe=6A4E4454"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHhA3HVhEAAQ7kNvwGtysaQ&_nc_oc=AdplL4L4pTqH5djHN5jf9oMCRnwdhpslkcIvuzRKrLCu6hM1FXGFZXV9PyMWRjkjeJM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa8mQSb75iGX56bU0FiSevpVhCqaHZLbBCgur_PD6hug&oe=6A4E6317"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXbgDm6IYPoQ7kNvwGlThxb&_nc_oc=AdqP_2Tyx5HX-a8vh0e9nGhVcF26MDq0gOxng5k5gFS4-bH2xK8ouSstRlwPaWyIpik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXcpgJ73mfa39vF74eGjvcD3gBMBN1yJtUs6SRxfR2bg&oe=6A4E529C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_UN5Y6NpZIQ7kNvwETj8yD&_nc_oc=AdqQf9ts4xKii4syEh8CAOCvnCidY6vkYBS12njdotbbwQz2WGapCgSIvql2kOSzifg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaBJ5DW_NVQWlHSbyjx5K80SG3MRX0cYWj7v1l72Xj-A&oe=6A4E5882"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
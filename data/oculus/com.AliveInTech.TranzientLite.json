BOmM2gQ7kNvwFXIsDd&_nc_oc=AdoHzrjpbL9_yKVhsIhv82EB0bT7YfLPX8LlU26lnpvQD9WjMAAe0BwJKWlq8u_hQEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ml1MbWbU8LHP-P9KPrwy2k_aqpMzu48qyQFHw3ruwhg&oe=6A186219"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mzvCqx2d7wQ7kNvwEN6Fe8&_nc_oc=AdroA9W9jEsMpiKguVKRcbuHFERfTgN8O81Yo_sqeRtRLJOiM8V2aQprPXNYVSYkfxk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B8-mOQILhksY2q8GHtJyXKfB60XvSpYvUxBUKvdFFSw&oe=6A1836D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP8HX1zB_m0Q7kNvwFhSOXj&_nc_oc=AdorotLRhfEKTITlZGfm46zRRc5gxLAE_8f-lc2jxg1Dw3YhpBbniD5BUAlFXbOlM20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cUGfDCyRKLt1OxBbGR21sesjzzQ0SEdUvnWtFKcuCjA&oe=6A185597"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYz-Nq5v0Z4Q7kNvwG3vQ5V&_nc_oc=AdrrJapFST67pFugkTeB5kWsCiUyLOGyMyO48PZlosyBVdjpIsqKNWNGxS9A3hWNlXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AViNhZqQdMrfQxL_brOlnc8Rk5wPEHCbfxIe6MlebbQ&oe=6A18451C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUzWFEMQVlUQ7kNvwGWz5gy&_nc_oc=AdqsDnKu4snRXsbMwKOIb3s5oqQ9bmOFh9KZ5orfn7IEer6BRQq7qiWzGklGwjBc-rA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JD6mRcWuoxWgvq5Qn9LqvzQR_D9ob-E294MKja936KA&oe=6A184B02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
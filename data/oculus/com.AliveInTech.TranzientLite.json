J5llBQQ7kNvwFmoZOO&_nc_oc=Adq0bsnc-LDc5bzRFp8mgx8CWlX9V3cv_VQTlv5GqHiFUxfgawfh1LDhM-KwO6NRwE8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73yXj7vqZgorYTYI7RUOGTdHkmnNZ_W5WhcwVJFAVgHg&oe=6A107919"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE7nx-NWe70Q7kNvwHf0cVj&_nc_oc=AdrDaumNrLxr1Yu8TEslxssV_Lx9EfSmoKBFN8JCm0n7AhpfBkCdErtjM4X_T28hSm8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Ln2JYF7pko1CliKh2-n9iLkaDMweAmZJgPH0wNzrWg&oe=6A104DD4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQpwBJmxHhMQ7kNvwEIu7v4&_nc_oc=Adqi0D7SpbXt0fEKTJ5s5b92_iMUtQEacOcodOL3QUxWWwucH3z9nhrkcMXAVTcbRrw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65fRtypHJhv-W067LC5GV3DhwNNcWjNdxSylQppaUnNQ&oe=6A106C97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buegnqfTlzYQ7kNvwEvNHoj&_nc_oc=Adqlf8patWDq7ph6-wC3awftT58sIWdODjQ6WUQtxBOcHMAW-7KEP80-VPZHI8J-Qx0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WAAB5vrOm7vDB7naZm258zXCzhu9pNc-OAwd-DuHsoQ&oe=6A105C1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjuvkdM--dkQ7kNvwEW9ZRR&_nc_oc=Adprw1PBuBxQL2OzrFJ0oVHfYpMeiPwW-CfLcI8oqGhUsVbO4c7ogCw6U3xsxvCrtFc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y_xdtlRMg_-qnSA49Bzu9kPcADW1f0KsJ0OinlpR-kA&oe=6A106202"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
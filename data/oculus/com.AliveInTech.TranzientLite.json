-MKuAQ7kNvwEVcf1F&_nc_oc=AdqvZ8KeIydfexsSBim0TSTG9p4cB0I5JpQhV8HrmISgn-TkcWUuMDo5365zsACsrn4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIqGDCzzv4S6U01FPGX3Nb19fikbApXIYL469ee2VCFA&oe=6A859659"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdEHm7IngSoQ7kNvwHkA2_1&_nc_oc=AdqCXntce7SnC723T6QMoCEvThBNkNRmLosTHaALQIX6ZO2iT7GLFEdaKTSVkbxLGG8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxXJv_BWvYwGtmc0b64us71_zxr86sc6DMUet5FCfqwg&oe=6A85A354"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opGf4uFaUsEQ7kNvwGrJ_qC&_nc_oc=AdrmPspbg-qMNFOo9OHvWuAS7vCor7V-8cItUubPTPVSbJ92ynkJcz2CnJgIviNtLUQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdAU2AUPZIiVkXFTKNKPu5xeuyXuWsR5ISIzGiNR82kg&oe=6A8589D7"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV0HEzTKUZMQ7kNvwHG3RNe&_nc_oc=AdqMbPPFQCbiaHU11lOMXkCYKQdzI-sTgvF1fH8T0LmNlngAIZO0FV2o9j5vlevRJe8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkGd4jOZUiHMyC7X5B_TgLDCl9_8ESVU3z9IZts7Wv5w&oe=6A85B19C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-Oh-H9XTzIQ7kNvwHFAWDU&_nc_oc=Adr-U46-Mi-4rQ1BXxm9nIxt4_WD2tKyJVlqE8Jx8lf5ENGRGR8gHHHMQGAMoht0Oo4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlCEZaxJVZ-2x01xwrnfU_BcpXrLNeLHqgz-qgmzrt9Q&oe=6A857F42"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
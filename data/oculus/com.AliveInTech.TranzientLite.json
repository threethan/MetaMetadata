tent-ord5-1.oculuscdn.com&oh=00_Afvp5aRRIN2fMHnCmKDMnE4yjGNn00amCx75gCPMqRU-Mw&oe=69A43A78"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLaOP8vOrAkQ7kNvwGUoNiF&_nc_oc=AdndxnN-3VhiSaXwTHKc_HxDAd_hcLxIoTw0yUW5cogHjOh0OxbvHxQitM1wD29jDS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftgxKveZE4P84VdPlUcEiz6O23UpLqxbMWB6HSLWeHU1A&oe=69A440BD"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNZyTfBhL7EQ7kNvwEFNnxJ&_nc_oc=AdmVbydHMdl3TVeI1a1v6L_hc0q6sZ09fEKY7vSwMIT0y4Vo9aWNfVFyceVeHy0n-9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsJJJ7j-Z7dN82OJUVTMQqddnboXKVGkHCWajCBQS_Mzg&oe=69A42960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqgTolOODAwQ7kNvwEj8c6M&_nc_oc=AdnH0cYYoVrH9PNXMjNRXsNqX83iT0Q5GO-LJti7XgxlSamDYZYW4ZxhV4wk0n7R4YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXvPzA89sRg5t-1tub3KBsoVlGPLCgqsWPCFv51UBRQQ&oe=69A42A17"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": 
dgeznMQ7kNvwFFuFcm&_nc_oc=Adrr7M8AKEtvnRxh6DrATcgFbyN9wgcahgCjPtZWqKV7FGTqHAwLE7RDkKPbQZGNH4E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABorQLbxTePUPaFzMArboBMCTg2bM-IMHF71qeFjhCHg&oe=6A5A14D9"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4I4vQfjCQwQ7kNvwEdBYWC&_nc_oc=AdpfOE5uUTYA6m-2pn_GylRFg4afRjSl09fgIbFx1zKQ8hslfktuSMYKRCr6RMfmbpI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBchn4PhVXB0nKQ9fNEbdrrM39KPXgOCUXuauM-2GXlcg&oe=6A5A21D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcmeCQRcRn0Q7kNvwED8uQ1&_nc_oc=AdrvgYMMUzJ5LZCxrhJfqAoNwYOrsbPpP8C4e6H__YhJiNO14yw_CmiJiaZVG2NQsjM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWC13R_3TtIfdVBuhim5TIqR7uB38R_9EhaX_Tz7TM7Q&oe=6A5A4097"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn1qS21UMAcQ7kNvwHUZ4PW&_nc_oc=AdoU7DJ7FkXt5L1mvocNUdJCVlAiQOULsMiCMVkSqhQFRlvGQ7zrYrvl10J1gONGxeA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQQZBk3pI6LB7QBkokvd54BrJkaCGo5a8AvphIJh7IAg&oe=6A5A301C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPuGqS2reF8Q7kNvwGLFtQ-&_nc_oc=AdpEMEe_k2nWMdZDTUNRiM61otqJdWoOpsfO6Qsd3ZHA_Nv0G-TE34SWu0ty0hL_kHc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUIMeFBFlrMqh2WfetwzSNez2yTpDcNXCo07J7HarSOw&oe=6A5A3602"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
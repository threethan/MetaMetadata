vwGEGvXc&_nc_oc=AdokHafENyxH7I41Wz99le9OQNRxnvo1eNIoQsO2ntEx5eOVXdWoO_kC61ouBl_Oj6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S1wwnWzpr4VakgdViOpdDq6wvCYMY1IwPRpkK_Bnikg&oe=69ECBCF8"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_LX9xvt2fQQ7kNvwEqdun0&_nc_oc=AdrWRSutODFmukd46lsp6-kQoftOL2cr9-ULLwFOXZ9ya0_YKaU-AyFyxuOq2LqMOVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03peS78GCu7_lnveCTtavVQovP-Wmn7czKd06IMXIUtA&oe=69ECC33D"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZGB9N9R_z4Q7kNvwEVXs8D&_nc_oc=AdrUK4tLBkmJgEsUQhYZyvJS9mY-QBf08y3SSzbDmPkI1dcIwYIPGVB0Sbe37aj7Pn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xI3JO14WuHsYap6V998I6m9gLX-MGPPg-i5bDJ9FTug&oe=69ECABE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSWxOCzgMW8Q7kNvwFajWsF&_nc_oc=Adov48LxlkPocj0TlsDeFOVD_qqRYuu9ZB9ZqhWY3Pu5c87KV0iFuK18VBUJX9JZ1i0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aVz6DxhuZo8FWGcxe8yULE0QB9E45lfODmvygFWSNsQ&oe=69ECAC97"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
J5llBQQ7kNvwFEzeZ9&_nc_oc=AdryC0igrygXtCiCsZNM1amQw4uM6FKFEbKXBrMMcs6k-CvVfqf3gfh6qlw1FSL1EcQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xFblR2rbCelwiv-vLdHoUX28ibKF_ITNJGB2NShhMQg&oe=6A131C19"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0lO7TwJLaYQ7kNvwGAT5-s&_nc_oc=AdqIx6_VG0GfXk8BZYRW-cBODCZeW0T6B0yrnRguNYfv1ujr9aXq2CKtLKBg3NOpOUw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_CPCSv2TXVry8FpepSI73AZw_N1VrGL7DKBGUQHQqhw&oe=6A12F0D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdAoKhBZmPgQ7kNvwG10_gp&_nc_oc=AdrxvmTQvU3WBqyWTn5cXc53aBKy2lKQMJD-gGeAHJ10RfE8Dru3MKcMkv_7_YysnwE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rIDrrAsfl3qd_yWs6WoSQatyUiMLoKAFUwWTAzEHd2Q&oe=6A130F97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8WKG8jW5owQ7kNvwGA56rz&_nc_oc=AdrYNMvgpCule1-jjolfnQGkUzWpSfuORFtw5BWSdULsCPEXbUEwReFOR_PDV9xP_mU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WSlbXcsfMW_MI0zOluUfrfoo6WGXUUYtvUVG9QphFbw&oe=6A12FF1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZGfvX6kV3MQ7kNvwEQ9_Lx&_nc_oc=Adpdt4ahibZFkTy9mMr112XdqS6nz6BNKj5qVDCd6srYYjiPTRG6RPfphVNswMt2SqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gJgVVIc2gu2-_S7MMEPJQyELX4Gf2yNUYX_TqYbuW9g&oe=6A130502"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
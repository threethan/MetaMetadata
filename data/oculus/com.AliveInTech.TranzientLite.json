P0eGIMQ7kNvwGscL2r&_nc_oc=AdodRJEDCmhmQHIBEzs6EM6CgD8SA3UC78zbj1GjNTPoEjL-kRUUo_m1SU87rFElwvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TRegF6g0GnoP0B4XmEvMKIQb1I8z2j0RsycCAhsC4Iw&oe=6A2AD719"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovV9xJpLp0EQ7kNvwFx74up&_nc_oc=Adry_ua9t-VUWy_KlDQ6_r_R2sZsIehz3hJPpIn1277ATR4rdSGET5hYfpzJZK_NalU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HsICzlJfnTPPRULuMKIQfti3KRffxyPediv6YkPI4Og&oe=6A2AE414"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BK9qVZM0TWAQ7kNvwFS5Vgs&_nc_oc=Adq3MS1wBn8wCsEjs-S9Q19hC7W0ojU9hSmLHLMjA8uaPALt3-xX85SSAagv50Y7MiY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OYBYxpAWNvjCAzQpkmiuvC_2hU7WZKsb8O7Iwyj77hg&oe=6A2ACA97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzNPliwn7AsQ7kNvwFLQxTx&_nc_oc=AdoFmGAmLIgDkoGN7_EHzPIEIHWEXFjh6L_IvNBrBwrNqrUogzcDw0rcvkoeXGv9dYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IOxbf4dZVcvDMMCNWoZI5MjUnzXtgAj2MDfSTtzx54Q&oe=6A2ABA1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXLoDldFCb0Q7kNvwHohSuC&_nc_oc=Adqz0m0G5Dw0YCBB-RF4HABJJTxsY3VU3i5N-MTnGQG2b9O6a6GEbQnTMBTaZHy8fO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qxpJ7EKt4A7acs1K3QjXyP1uQXSpsOem_t7NwoZH9zA&oe=6A2AC002"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
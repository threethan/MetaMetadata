YcDXf4Q7kNvwFDDVgd&_nc_oc=Ado-0cOwum4me06lTo2V3WCrynUG_PB5Y7z2HaOdHqSd_xraR-HcsY0dBY-3oPMbeZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKr4iDH-T8ge3eYpaJiy4P0173qylRqJYo0SgbeiBmzQ&oe=6A5E0959"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtWZ16HFozUQ7kNvwEBvara&_nc_oc=AdqGCRWZMNh6lOokUQYjxLn6VycnSR7ggtraSsn6RhtXVvlhtNzKoYXdQSOorV6-ZCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHGm5olo1EgHXJJxF19kLxG8mvg9mbaEONsRUGSHCxaQ&oe=6A5E1654"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3zqTJZSQX8Q7kNvwEEUCVA&_nc_oc=AdrYgBmKQQedfWAex1MSGJhUEIJ71V_yg7XfdFdZXMNBEderOb7Fr1AwDTKlZE5aEfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdGMwJbGiaQONTYj58-7O7W6pMlpH1SsVnxQgZ8zWw9Q&oe=6A5E3517"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czynxtgmI3IQ7kNvwF0-Vrl&_nc_oc=Adpd4J31HvSUVcxOSRrDEi3kNyskCjSIEZRZVUlSeV7b0nNclqWPLLy7jiHVOWsO0hY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgeUPH8tbQayH6kOE1D2aEvvMX4792DKI4Fvb9HewPQQ&oe=6A5E249C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMdpV12Z3uMQ7kNvwGcFNvo&_nc_oc=AdqcALzhkLIK8gAbQnCoqpqnq8ozwJldwRK_dSwSUxsEuSRCLNg0EIQfoyniblqKt2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfgdPzASB-pVbJXfoxO18X1sJwTQFLy7YxX1HIJf6bgw&oe=6A5E2A82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
jXxDX8Q7kNvwE7EJtG&_nc_oc=Adr7kBq6ifd4DPdRXOvDbx-KNBOgt88t2uuFDtjEiHtXuKXbRBhZbcP1TyLFz_J6cvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk09V-n6GBk7Z7xs9k9uvj7ijnbT9EKuYpb3CXv-ZJdg&oe=6A4BCC99"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVOrQXc_Xm4Q7kNvwFoXTwt&_nc_oc=AdrHC96bE0ugpCIqliZtym1gn_5OmEmEsO88GLKJp3ske5EsrYcvwxwOcSyCeyGSS3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVLve2-qFyb_gCxZfNpVEUlOdx5MzYhlhnlOf3FOYLiA&oe=6A4BA154"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow56F8-q3vIQ7kNvwHAAS4t&_nc_oc=AdpWdMzwOnJnUhHx_OY2KpPH8ohWZXCjNpqxvyr3bdv8IAOn9zFjV0OagRk18Hq2aN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoQu-qtcJ8X3ZM286DhYyxtGzpY4tJhlqNCz1n1OiJyQ&oe=6A4BC017"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pue8hWpQRfcQ7kNvwHkLrG2&_nc_oc=AdrkZSClj-we8T9xotMlMQamnKmf4W1GnySE5NSXWyJcpnaft6RYbe6PHMN_H9qkfCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE8Co_WRvfouGg2PhQGcdwA5m8pds6sTj7YLcQbamcOA&oe=6A4BAF9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNUfzOnBuFUQ7kNvwG6-IWX&_nc_oc=Adod1a9PKb7qtDTjjkYxuzXkJM2l9oBRjqPRxqlSsyZSjYjimj-xJS2QLw7X3x7LR9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqVeN5XXSL7_DaqY9FKwByo5Oi2PpfLwDM_TmczXjWNg&oe=6A4BB582"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
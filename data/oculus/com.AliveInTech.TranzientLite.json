P0eGIMQ7kNvwFGLZ4j&_nc_oc=AdqFZESiQ3m_2gDd0I4n4DyDcVzsS8Wfhj_9vxGBiCL8FuyvijEH9OQWCWRp087dD_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3_lPCyMxNpeGjAfCX6IrcuVAFJcwqgY-VB56363b9LA&oe=6A298599"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ifEFJatl3sQ7kNvwGWmwZE&_nc_oc=Adonmth0zIXHJzmcw4Wr0_InRctBdkLjMZWVa0_OjuePMc-fIhhmB0RSHwfWlzuuTTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LgdGuLeEywOpTrRZbluP2P6eh_KY08xUoFJi5t2Ax7g&oe=6A295A54"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg6gi6aZM5YQ7kNvwHt9eUu&_nc_oc=Adol71vaRhYrEQZSWT9MlUpOjs46q5gp7XEHZix9GSliWcuvUogOeFIVtNabT4zRPa0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F4ZVnGXvbg8mxSq5Dm0Z7fFtDBJ5KTky08zN_6rEt_w&oe=6A297917"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzNPliwn7AsQ7kNvwHj6MRr&_nc_oc=AdoFU9Tv5voeBSxyremjV9PC5yR5QDmFks1PT318VmuYpfNa-5EDEIJ-WAPPYD40ov8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LxwsKQminfo9hae_fignYaFYHGXFtQQDxRkRV4QUJ0A&oe=6A29689C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3LiNN-B9NMQ7kNvwE8FuQj&_nc_oc=AdodwuYwgPsoLKr8ml5LwRP4sv9-5fOdz7ZPLkXZTUb0uppGEB6pk_H67uoz8fDsRAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mKj8EntoHtYiIXodwzhtNnlE39vYqZyakGB6N_ZNpjA&oe=6A296E82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
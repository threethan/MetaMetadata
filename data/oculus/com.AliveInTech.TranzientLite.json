80I8EAQ7kNvwEbeipL&_nc_oc=AdqKX-dZGAOFAwk9dv-BsqjKRS_A56CISBC-4aOZZBMtFhrwwnOvHl5dcHP9GmKazbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l4hPja8BERh00SM0C4O2zMErmX9IxmyX5zr2-Gdso9A&oe=6A356319"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKOU2W0LEJIQ7kNvwE-hBfK&_nc_oc=Adpm5mO7O-Q1s18XG5oluLhawptu3V9LHfGMibKsRaNvjc2pcOPrV1uTEUwsohaGCC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1B4IeidnCvNn1c9CN1cMfgg1KeBD4asYp5A4AP6U_qQ&oe=6A357014"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2jBPy65lAgQ7kNvwEf-q_u&_nc_oc=AdoiirqUeDEKJ8xCv5RWcov1qPHOUth3bxFsJ_KLmFlMvqsKObnR9GWWUSjGFJymyJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83ut1-HBWZZfHMKRc5ggaCVZ5dDY79V9Z-CvC83d5qHg&oe=6A355697"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqd2-AOs6fkQ7kNvwEWz-Og&_nc_oc=Adp9Fsuvp5nVm_FPEtfnqm3AKo02Gou3Fkn1YRoPXeWu5ODind2wO-0tPi5l3aflY7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZkPIp710-_w12L5-diSLOshlgzw0x7GeL7-_JSTU20A&oe=6A35461C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR1ysuuid9gQ7kNvwHE-NoC&_nc_oc=Adoiw6qm8ADJ92GjgPxJrWD2dL_hLG8750COH4AwCzNVGduAxu-clDJLBXEjZFjOxXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XAOcGC7bkN1F0mzHM4bsYM56_3-0cBPYu3vHW9ZIfnQ&oe=6A354C02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
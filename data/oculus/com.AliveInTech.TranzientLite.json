o9bWiAQ7kNvwFWt2eZ&_nc_oc=Adoqy7Tvm9txBwgheQMJS0T55T2SQ0oyilzKptuEJbNiJ9-oKEX8eUwpfHkLaXU8h3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWALBEqUQ4A2xqWx-WilRPwMRGAdpis5BppEb19hzbEg&oe=6A60AC59"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtWZ16HFozUQ7kNvwHc34UM&_nc_oc=AdoWj8YtV-EbeAC_uEm_b_RTnjQY9Rrin6i568YkbToKxgCxhPrJMIdApfkYwRnWO58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCefIgly-vWSjA_6xeLhE_BPXKMh9Z0_q7iR8UhEXmZug&oe=6A60B954"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3zqTJZSQX8Q7kNvwErA3MQ&_nc_oc=AdpkVwE9XQRBvvFIzj3hS8wUsb5pKi0RdJMwnkTTBeeLAuEI5-UBfm7s2VJAGbn0u98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOUxaXp1ivTLTvc4pVvUeqpkQTvZrd30o9iduLkMrViQ&oe=6A60D817"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yML-NQ7O6IQ7kNvwGCZ-nk&_nc_oc=Adoau2L9zPLXqlTLpfGeL6uSrMkknrhDCbO89NWb24RW3noHRdk0z3V8K4DoGI356MM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDBoTkrWpNXWWZKxWNY3fWA6sR0eP16kaE7m8tABbAJA&oe=6A60C79C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMdpV12Z3uMQ7kNvwG2fivq&_nc_oc=AdpfvnAYriPLi2462LSLBYEk0Iu1U_EP-LLwa-AIpsOmTpf2jenRBE4IqWtE1lGNRrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArqh4HJjUgHi3TmAhAS0fbworPTf_1AStlQtvBX5hTqQ&oe=6A60CD82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
s97vI8Q7kNvwGrxHQr&_nc_oc=Adqx4alCvK0RCPssUlCWrtTBp4IAopjviWTb_mqYD1PbABdM3JMbAeI_pnHE85Q4GqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDprTaaNC9Ilqeg7rF4N8OymPBNmNhkHGzuCPiPEXwnfg&oe=6A4FC119"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMliDeiAYegQ7kNvwFUMXUu&_nc_oc=Ado4hegogsQBVjiA16whmwthn35krGMMfHk6fSz_17ygpw_wCtwEWkuzbGjOt34RKOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPuZODsTG2QoDbp5iM0ndHht-EwArAWYaTs1E1VvcCsg&oe=6A4F95D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHhA3HVhEAAQ7kNvwGioD8E&_nc_oc=Adq6GpPz6wyxEnuzbhMsdfNzWL1nDiSH6_YleOBhDW-28jUITWT4edLPo_2XjAB2IRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMCOTrN7Yc7zIzRRVqosznKeeNfeHT99B5GEU9L552gw&oe=6A4FB497"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXbgDm6IYPoQ7kNvwHlnnk2&_nc_oc=AdqpYeQqro_SXv90Vvfi9U0v5hCyo-qoAsB7qL4TMCPLC9IvVlYuSB7BRNbvZqQX84Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqsO6FP9q5-eu5RkV_hPo624SeQiBZJn1eVbLXo1J8iQ&oe=6A4FA41C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_UN5Y6NpZIQ7kNvwHyyhLO&_nc_oc=AdpjCmkKj80Kd0COOjoLKWLI2bPAqkOrMGU4RbDPItPQoYAQjJ18ksdv4yW5hH-zaOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJo7dT52T93iaELNa6Y-27fL6aRPOBt8YlsmPrvXsT0w&oe=6A4FAA02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
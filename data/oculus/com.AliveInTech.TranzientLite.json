ELFExwQ7kNvwGcLLqW&_nc_oc=AdqJb2429IpEXhTzr-o1SaHUWFrOZpL2WxBi6TWEp1woIgE3ynKZuKJDXZ82PMX13BA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UCFrZQF1kJCFgLVZbh8AAORmKrNm0x2GpQ-A9J1eHVg&oe=6A414099"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz4kSZxa7OsQ7kNvwFIvJUu&_nc_oc=Ado-pBDaPF3emRrtErphmiTKSE48HqILAb3jKl6xguHsgwq6M_ArX5HomEs6EwVaOWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jp4T8PYihfxstNzSh_by8RSozNv6UdkcLnb4VvZkMkg&oe=6A411554"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ldXi-x4O8Q7kNvwHnNV4J&_nc_oc=Adojh64BBTM5fHmM50p0iaI5jt2wAxh1bu1u1AmUtPLjU94VrcoAWBBV2SxoxfQWfgk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91wJchtTS2JWPrCEFbvct1o2VEs7Wm1WYG5MWLDQnpEQ&oe=6A413417"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J04D1qHR24Q7kNvwHigndB&_nc_oc=AdpiFIZnxmweMXyhJ8DWoINLGpzB3-CL5N1iiAyEhpxTBG197K1iWfGe04nvJRNX3Ss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wp-ZeXpb4atcXPRJG6iFTBPEVBuR_ELf1jdW7efOxrg&oe=6A41239C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GbevXZJ7u8Q7kNvwGrEx9V&_nc_oc=AdqbAl5HZAkMhS-yh7LsNT_See2rQz0l7eTREBDT-Soa0tbi8vfMvbLFE4mOkqU20t8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-13X3SWNX3DPoTo4TMyAFUqVuunWp-zrIsUzlC1RfaOw&oe=6A412982"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
399nWv9r9p2-6nLljHsu2gECGPzNshpcvddAvi1z6Xs5DLUVF8NxQ82PhcQrOvg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtyGY_6VGTHFD_rTDQOYBkMhcWPMm_jLOTJQYWM25Jlg&oe=6A7472D9"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TM7RIGy_asQ7kNvwEQd3FH&_nc_oc=AdqyxZdQ6waL-Rry3_ge47Dyg6aKZewqvC19mnubuLfFRB0Sl8Y4R9KUjDDd5DW-GCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP2xJJrfUDjc5qoTffbJPwfAVsJAcDfZS_MxxX4IlRpw&oe=6A747FD4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZA5JRlvleUQ7kNvwFgmlEK&_nc_oc=Adp5_VX-C89S_tIRpUiPn8xr1yR1jl82WzkZlifs_FIsXruRWSGLUT3kFJc4lg-rOvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-O1BzBAbavE054v7KVTK4VkVFJ9cKq0Gd14YOYu03WQ&oe=6A749E97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thIXH6mqY7oQ7kNvwGhTAb6&_nc_oc=AdqU1ewHV6f1QrIbAsZHxQYVfAxvtzIsBYD5nImWKreyDzR0Ywc52RkMFzHpZjXnrCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_nddR3V-l79Ug9EWNxzY_Ggk98rFWTu5F3CoVeJcJ9g&oe=6A748E1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieznHkzgSBEQ7kNvwHC7fft&_nc_oc=Adr2-vEqrKzTb2KtUTqFstxnoePxXlC1CigP_aFC13llITItPfslfMVjVigcDpZM77k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRchv3tuZKAGG3Of1leUDUF0IXiU2WqOk8C2RbdSBb0w&oe=6A749402"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
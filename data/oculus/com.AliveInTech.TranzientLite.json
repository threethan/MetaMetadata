0UwCcwQ7kNvwEihGSw&_nc_oc=Adp253cJYuFX-NDzTO9ghtiwrG_cDDR1rfC3sXxiO5JXdOQZ7NtLpYl8Ko5LE5CQ9Ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YiryIdKWLn1klITx0v22bOKGgmf8TcW3hS2qvQo8IxA&oe=6A47D819"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0uwKSUH4nIQ7kNvwGkg3Bj&_nc_oc=AdoQBVhDTWvtNbND_FV66fDM3SAkyO0yY1pExAr3EbRxTUkeq1b9Q9RPPaiGs44lNaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VPQTQA6iaOqHQgY2EaZquQE2pO10jja7IyFPrFbclFA&oe=6A47ACD4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJlVsgiViiIQ7kNvwGFZCpu&_nc_oc=Adq_NRUd8hE-gILUHrl24J5Iylvcbt0iG0bt0Z4ybXldM1en2zsRb3tOlltlM16VI1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PGqUJlkgGkvagRWfIegBy7tlJnPx__4iCDZPLy0SW1A&oe=6A47CB97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EhabC3SHFsQ7kNvwF1thyp&_nc_oc=Adr3UzAD-5Kp7AWrv6I6Z9r6fBsetGzyXNYIhXDZGHAH14G9DC5wgWuBA6vA0uPjvQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LIPgg2AYhoRbu0mr7CwV_Fwn94NSpdhWKmZPPEn8wJQ&oe=6A47BB1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg2ib0nJHHAQ7kNvwF55O5r&_nc_oc=AdqbY3cfe-R3iSCneBt5GqFMV690y-E_yNJjMo1_0WWr9dZ_iJoDvdywYPApCpI5YJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8JXDo1FJ4cJuiNLudtIemYCgXPu2j-JtHxHYXeb6BHg&oe=6A47C102"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
kNvwGRh-_c&_nc_oc=Adq7D-2-oyeMO6OOVP89L8gHcHTdrlYePabwNRR6TvZbGgH8RchIn7clMc9OmEFBvOU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJyvRGm2IJxt3MX-51NS4z9-ylhAYKcqXfm3_O42-dng&oe=6AAEAD19"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt58qE_ViKMQ7kNvwHFpWnZ&_nc_oc=AdpK5chjaP_Pqib4sSCcPKOU99Rcxy-9s5_X4jVUWu0wdSbHVvFP9Y3SNIU16-WOcTQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNLHtsUimb7fdCE2wUiaEavUO3jEyos7L8h0YKoClE0g&oe=6AAE81D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHzkdcL01QQQ7kNvwFQSYGE&_nc_oc=AdpASiswAsnPY9LsFQC3w-7QPbuDLcn7zN_hf4Fi9a22vwBNMYzmdhr6MCNK0_YVL3Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwlJwI_AO9rs0o1R7RJqEvUhVeMlsuhHMBbo0uBKKVSQ&oe=6AAEA097"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt7wDsz3CPUQ7kNvwHM2Tb3&_nc_oc=AdrqhpI-p_NLhW7B7jl65Q8jEZa9b2kegvwmJPHY5-QuLF9k67fMKBYz8LmyEiAVLps&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwRJNwvUhjGiHCoD5vsEf4HQzAlabMeEIG4MATvwHeRA&oe=6AAE901C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ycBhXm_1vIQ7kNvwFg0ePE&_nc_oc=AdqOJn75OUsgfwcmQeBpUhXMRAgK5Ht9YPZiLmDVrpoMamPaOU_D05NeaAwT76ab6zQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNJ0bUAd6Dxd_EFPe5gFDgU06YPsvng9BJT9QJrGZHxA&oe=6AAE9602"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
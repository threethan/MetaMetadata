73391773_1175249656776700_2139652667531337881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EYpaZgY41cQ7kNvwHrVOWa&_nc_oc=AdpWlkhv6Q-rHwqWTxQweNBzJglHRTnChv1hOCBjzKBEq3WXOe3dqtW6KSXzT8qBfKo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEgktXtXPyw-3EsLcC3aim1LVw24jDwCNwZNMiFetZcQ&oe=6A8D93F8"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVh8SdGLYQsQ7kNvwH3TLg_&_nc_oc=Adq4S_ccq68JVk1V6pJ7v8D9ju1GPvZoWg8td6Otw1BVyNghT1qNcN1Pz9l75AhhDto&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ0nulchQv2iAhZQi2Iv5d-Sb-NNaCJPl0agmHtECTiQ&oe=6A8D9A3D"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEIvqi21u5AQ7kNvwFI9ijB&_nc_oc=AdpwTLXcYSEJXuALzxn-DOONBvRVcfFneJ7HXjH4ItkmeByuj5G6Ad_UnBZSzCxbT7o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVZYM4ZJK2PiFUYDLaXgFhSoSz9KshNIhBFdATKs4EAw&oe=6A8D82E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jugxm3C8z_UQ7kNvwEyLtFU&_nc_oc=AdrqIbyVBX3Th4GqlVbSEfvOoJRLOw6GhTrD51crHb-9WkTpelQnlmtwjWZZRY7Et_o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP0IFPwLB7B1v2nPHLhPLHB3QuzsTxA46i19w-Azuvrw&oe=6A8D8397"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27596023866685663"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827960_1359314172308278_6765249258417181831_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h_MNB7DEo4Q7kNvwEtpUK2&_nc_oc=AdowOV_fThKikrHdnI92XdAIeZebzFPmjoxpeSaGQC_3RxyvgqWJUrk5CjSJjpxFR7w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeBcu6ZUZfW-ypt_vVu90K3char3g1jqXOM1AIVb2R6g&oe=6A8D868C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tranzient Lite", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1627604630, "lastRevision": {"nodes": [{"id": "1238789826516947", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3554141864633866", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "415826879239186"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "OculusHeronosnowlite.png", "id": "874251286634596", "image_type": "APP_IMG_HERO", "uri":
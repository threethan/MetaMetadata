ypqqtoQ7kNvwFv8s0o&_nc_oc=AdppcrMfzFtBUL8RkPAaiKS9QXIMCRFC9COXTSSKkWacfdOzFvys8LYvSuH0LH0YIiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pIH7M8VFbn9x8UQd_6O0USj353MrXFoWvoY_wSPfRYQ&oe=6A380619"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfCU_NevLysQ7kNvwHzbU4g&_nc_oc=AdqGrthqlz0KxHIj6PGhpIq5rzFe3p9sHN4m-yX3IZBNtu9Crn7fjjMqBRL281thkU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zk7TiKTkJVv3Js9t7n8R07PrCS1jkSJK77nxN_m3PvQ&oe=6A381314"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE0B7UzgfDsQ7kNvwEANvlr&_nc_oc=Adqk3WcIMX3VYomYG3UjByoCgImh5droV1TPUTBUWgq3HCNqisdFGYQdrZgFo0R7FaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZjfJBSB-w1ZYMbUkRW2tijYhLgfRuPhqwLECZ7UzHsQ&oe=6A37F997"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqd2-AOs6fkQ7kNvwG4Vbi4&_nc_oc=AdoJLO2nzHpkbPoxyuBrpOrCZ2AK5XcATwR_7OymjC0edzOcs01fpn0J_ZNzo9OOmZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fT-ukuuDOBVeVGhnTpvsV-QqPCkkvKKQ6CUqh8cgNSg&oe=6A37E91C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM7_fwUIhsUQ7kNvwHNElCD&_nc_oc=AdqKLjy-OIBdRShZr4RW9w-Mo0rhkta2qogtuOyzi4YPoHl2UtxQPrUU_bCf17Vbhys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wa9lS7mgQZIjOwrrp7dYZ0hDqH6t1TimgTFBZls7Dqw&oe=6A37EF02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
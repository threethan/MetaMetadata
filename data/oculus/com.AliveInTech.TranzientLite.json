fVhvb4Q7kNvwH8Sd5N&_nc_oc=AdrDkT7ZNQPK93HzeB6Nw0P9fOS2-6bSjaRyEshLsXj0craDpnZeAJ2P_2JDjNhnR9M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxEpwuHA77LweN_DLMJzu0Fn4A04CBg2bvOmu4VUcLVA&oe=6A565899"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sUet7ULpmwQ7kNvwHGW8yu&_nc_oc=AdqIDD1KJSAsLaXJqmgs2DEg3p7iIthQN7y3kmLAvpjdntQW7TmZnpUkdZTtziuUm2c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDthri7RX8Q1FpibyFxivfawcrUGv1o4kFljkqpxL89dQ&oe=6A562D54"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_vZMkfzDIUQ7kNvwGPWfKU&_nc_oc=Adq-1i1u9gC9xvIWltqX97BnrtPPuVAyhjMIDyFq0XJ5pL2BXMMxnaOKTDR7rjXuHRw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNxUigufrfL8sgjqYeRYi1IPZ9gLs3pXWZkqsPSvp6ww&oe=6A564C17"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS9n213b-j4Q7kNvwHcgeH7&_nc_oc=AdpkaEVB-Jm4FCZXkvqmYvjalzbJ-Tsug2iEip_7VR5-uM6WHG3EivgaGwo-ntMrumk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2H6iO77h7F8X7Q8P7BDJ0dBpNd51IGEt9UWEFar6Zdg&oe=6A563B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dziSe8AFE1wQ7kNvwHabHUV&_nc_oc=Ado3fgmE_9emjAJ2s_RLyd9CBrt9m-lmfqvrD_6SE5RS-cXKM-Xh491inPMM-vD1DkE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU6QQhijoieYhNXlCKrmb4-NTsxRdwFnR3NEFVBNjxBw&oe=6A564182"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
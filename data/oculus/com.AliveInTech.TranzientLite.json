g0DPz3RjxtnUru9lKyxwRBG9OAxcbeZWQMgNgS-pF3Ffd1XM-hxBAzrmACKzh6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7BnUHfIYXz0ZFAt4DCHs8Lo1gs3_-FYN2Sdon3zGlzA&oe=6A707E59"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB415-xJwpoQ7kNvwGVQW0S&_nc_oc=AdqQA7Idg8hYAADeERd4ykkMKI55QqODkdcBJZQQYUiOA5Co_3lMR1vQ5ICgUhO_rbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAbaFZmlXKzlJNIfsOni106blW1gUtO_pY3LSeIZN7dQ&oe=6A708B54"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0QshwpHQesQ7kNvwEB2eE6&_nc_oc=AdoAJhgaXpyIsu0EYltbnRwn4roNYbQC4TADdYAb5VTr3LwyCwtdwE0QlZ1SrTMmhK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIbTmuhYnihJY6f7hYJsUYEtFgHju6UPu61a1WvLyR4Q&oe=6A70AA17"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqHbaNBFFY8Q7kNvwGyo4HD&_nc_oc=AdoMjEvNyDEU0G7MgFaa-FxJUPrr1TpDEZfANhBp3MxJowaRXF_8PqRDLJYYaOMyEiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbp--JMwX3LhYWHb4QpvFjpLptTvO5u14DAuZAVoBzMg&oe=6A70999C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ8hfUVjZjoQ7kNvwHZMWmR&_nc_oc=AdrItIye0RI60iYNWk40QqgXmfrLc_QDGHXwqYd86bFKgcR2Q-GTR89GQCqP-eUYwCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqzEvG2uNI-O6UvE_x4YuKiOYxQIpAwuF-J5LacUrnog&oe=6A709F82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
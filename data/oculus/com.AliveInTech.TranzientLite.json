ELFExwQ7kNvwFL3wkg&_nc_oc=Adr-ogRyik0VwDbonVJ2IwvScCu6nqqfsC-6WQShjWkH-93ArpiBef7f1ErnRFZtra4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XgnPsN-ShjdxeZpuckM-AX9eLQWqYEulNxBDiS1LbiQ&oe=6A3FEF19"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz4kSZxa7OsQ7kNvwH6XGnF&_nc_oc=Adr3O5_bar_DF3MTE6J_AfdzJE8_5LkXNS6IpTaSwQDojDoSuFJomONjBief-HiWpiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80kNmzRt2YHN7C6Z17YQrY2N_5C8RsSvFc0QebXM3G0A&oe=6A3FC3D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ldXi-x4O8Q7kNvwFtSFfl&_nc_oc=Adr_8p9ogrhUbvcvIBKlpyJKpuZTlzfBVvFXG7uoVAI6dA3og91S73ZUxLNGTAR-9sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t0S08CQHvpnjgkrKtMJbR2-nu_94GLv1LwaceQ_J7RA&oe=6A3FE297"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYBL1d3gF5AQ7kNvwFLTzqP&_nc_oc=AdqWjhSMAZQJDnVU8ZlzmBqkuIfR63d4_h0H8Kv_Qycylu2WAaTT1GAEiAKeGKj8XB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6KEuHlol9R0fcd7_Q25Zi-JjRUNkJ_Ou4t8H08n6x6Q&oe=6A3FD21C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GbevXZJ7u8Q7kNvwGvuJiR&_nc_oc=Adpro7qHwGw2IYD3XjxCSBOB_rMkA3t3WmVQy_uSotCKp-jaUDFzrqXLl3CjPGLKY1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PXnHmTs5AZd1XBdXKsKs56_DVy8VIecqftlex6OrXug&oe=6A3FD802"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
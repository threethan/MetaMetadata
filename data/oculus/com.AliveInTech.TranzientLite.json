1175249656776700_2139652667531337881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxv77hcIjDYQ7kNvwGo1uZE&_nc_oc=Adp__5DXq-YTtwTLDJ_WJ0ZdUt_zE3ZlEugY2jkfW1qHfR0xaiYIST6dd39v2zEYUg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-8BJaTqE8G_ogsXZ-CoXxqr1cvAMnMkG3NNpSB2N2pg&oe=6A9AC2F8"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkxl9wuOr04Q7kNvwHhYHVU&_nc_oc=AdpilIT77B0-qI5vp2k5ysXuqvRBuEKS8CzV9WLibrNb47I7ao7ldaEIeEcCDE7lJCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJZKlju-ONfZxVbyCORqMnBJxNh5OyxpV_9LvGu6vo0g&oe=6A9AC93D"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhjtgPFNodgQ7kNvwF4DShI&_nc_oc=AdoQ2KTfqkUTG1BlE-YlgK_E4Y41utSYsoq0nIPt3V7QJ-HsJy6Bmlcm9VwlR3pVG5k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYuzKreUhQOUORzd19vsvmkHFy9bYjVACmyVC9-jp-Mg&oe=6A9AEA20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kby41OgjFCkQ7kNvwHYPtJ_&_nc_oc=AdrY1uwJUf_uLQPrbOzRaCCkFur6J-BeRllNh-f7d_qTwnO9_kq-FvrOm_KNClCsEYo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICY2UNewRo9S-cawEfsbEwFAsz_bSslGgic7PdR5nkEA&oe=6A9AEAD7"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comf
=7f30f&oh=00_AQTUypdB4txgfkZQH_T-EsuBMwp9f2Tm5WFIt6x7Ni_uBA&oe=6B0B2F21"}, {"file_name": "stepseq2_1.22.2.png", "id": "1175249650110034", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391773_1175249656776700_2139652667531337881_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hx7FBATB5oYQ7kNvwGzoImN&_nc_oc=AdqIH13cE7u-zqLUO8L1q-0Bg_bQYDq5-rHUUuksmWHvyHRN7jXea6AjcI1Osqf96yI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvh2vkB7niULYPpYqgjPBDXYnji8Yk2Dmf8iGiKQBueQ&oe=6B0B42F8"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVDnE_jL1IEQ7kNvwEDeekU&_nc_oc=Adqv33dZ9smihhYtLt8xgo19EIwMMpVbMgxrdd0csMWOA0jh_VpRqQquhuhk1xPr7LM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSObGF9BtK7qxGnrx2YmArkB2_TSknT2ET11XzorMhY8Q&oe=6B0B10FD"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgxEeaaqBkEQ7kNvwGgTQwh&_nc_oc=AdqAQi47Wzv6ugPRBtCk4RBrOCZYNqzOQRG6qNqIv5nBDrlhcM-pUZOg11YDOL_9DGI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1A1NAf7RQi7oYVv1Hn6EurQa1XU4stLO-OWZJDiWGtA&oe=6B0B31E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPirMjooMyIQ7kNvwFn9j_8&_nc_oc=AdrZwqPpUumxnhlDcJ0QXMMi_s0p3WAOGXqXquaE8n_fSpQjhrEKMl-eRm3SUK3TCGg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREIMj_Zc8hLpUFHzLoL6sXUnw6594I5Gxmhg9pzgJgWg&oe=6B0B3297"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.a
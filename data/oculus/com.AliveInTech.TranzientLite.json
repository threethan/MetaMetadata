gbz4bcQ7kNvwE5oo3H&_nc_oc=AdpvezJ7y6WVOQ_wwGnRhWfvCjC7nwffqfQPvlnvVMXU_4z_hRYkj15H1yncGPr0UZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pd7mANmdH43o7kIEONNPM8jpmUEbZxNEuKnHY_ngXfg&oe=6A316E99"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxSa6fYc7tIQ7kNvwFloyMB&_nc_oc=AdpSEsnCRYDmY--ktK4NqLE1los-wVktOKukpyqTlXnQ-d8iGWD-HraXwIAILXpR0SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Xd4VkbqB9qHMpG6v1t-YJ8z2w693T0JLRmbNLBMkcA&oe=6A317B94"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOCbsq6KaZgQ7kNvwEIlc8g&_nc_oc=AdpdDWkTGqE0nxwJPgQy6rYAUlEaXZrfn1pVTjNSOnC3OiRruG3ZqMghKBEXCI-sd7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GkX42WlGlC_LOdcIwd0DCikKhwrzBu1BsZlfxxiOX_A&oe=6A316217"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rcdIlOGJi0Q7kNvwEsEE6e&_nc_oc=Adp2ZMbnz_NwroMBSE1W9OvkbeRllTY2P-M-VDAtaE3tN30ZU-l8Xw6HIPjVazJt2rA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82JwEwf81A174P4UfraHNJJKLU8QK2alOznzbaRbcQXQ&oe=6A31519C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIyoapPtXikQ7kNvwEAmV3D&_nc_oc=AdqfvKufIchfMqi7G8awXXsg9fed0s73bve67O7auQnPqB3LHQZFQ6WHfO_e-eBHplw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ugEugeU8UHOnkweuOjk6i7Q539pTpFi2Ud1SCoPLpxA&oe=6A315782"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
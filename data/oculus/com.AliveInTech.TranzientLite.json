80I8EAQ7kNvwEMXTT5&_nc_oc=AdrIvFMDBBWYSEBr3B2nUwFsgJflt0bI0ZAwa7XU13xTIUPcv7pKR7DwnGLDmdy27Bc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oe4CP3aE7EcDznXkawTenBYgvfF4XQnvXHE7zSLp-cQ&oe=6A341199"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKOU2W0LEJIQ7kNvwE-khTm&_nc_oc=AdqwNenvZ_vjI34V3TmwFFuow-qg-RfawueXu-Is9qNDJUkFlo6avtd9XA1DFe_HQ54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9A0I6H6D6_OmCF9RxoHQQPH113XScZpIWIyaEPnphTg&oe=6A341E94"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2jBPy65lAgQ7kNvwE0KAFP&_nc_oc=AdrCdNHeIig6mjczGingN5dlOiTzAK9fdHirtczw1Ui5_1dk1itdMPvPQoGbHfufaro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A7T4YjPbMIRJzAjU1ByhZbN4PlDrwV4Pv04SHRHMHZA&oe=6A340517"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rcdIlOGJi0Q7kNvwGKoTs5&_nc_oc=AdrM7saD_0Lnt-I4xx2f2S0_8sMmOjKxhvVZqN1Uxq5hhMzDMb7VcSZqG2jwe9ieuU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97F3I4XFVDYQfDrMzMW_sd5iWYhfSVGA6QJTCWY39iIw&oe=6A33F49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR1ysuuid9gQ7kNvwGT0fwG&_nc_oc=Adq7nMpYda7rs_ebhaGjYKRLKVUfRokRNpbr2R47Gy4u_aKlKnUQnJox32kR-mXrie8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gq6RWYspa7GSO3faTvBPoz_izhf0xLhXlyTdEYa9jqg&oe=6A33FA82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
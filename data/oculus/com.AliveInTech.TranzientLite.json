kNvwHVNuGL&_nc_oc=AdpqZdT1xNBpzK1R2URLglSW38k_7yOIBK0tW9eJheHzM6DtA9xwImKV77ZBLT-leEk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLMc1cVs9QGrisKoWXF5abLXrgXJ0x7S_4x1BX21OVdw&oe=6A7DAD59"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk0ArWI4F4MQ7kNvwEZOPFO&_nc_oc=AdpLAHgoxQBC0qRDw6eo3MPrZbp-oIUOfA1Ypj7gyzQbMQv4x1NZuPyit4ymJroM_Ug&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK4-3ga8oApXP-lG4TsAag024N5jHcVxzj9KoYKqjXeg&oe=6A7DBA54"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GJCedxSq3sQ7kNvwEPq1sr&_nc_oc=Adob1jXuOXphvrfjxgjqiIiC_pT0cc5ijssScZQJ7NKTSo90NuYUppMBcz4XSu2MvOI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc2xE3xWxPSoVJD-jswdpMCd5zowRbyIb1w6nLjYA-vw&oe=6A7DA0D7"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSECUES5cmgQ7kNvwEgaj_1&_nc_oc=AdqeoBbU_aedsnDTolkaD5TvVhqDveXWYQTdbyJZbY-hWEnmGa5cgQfowA6jw62NIM4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeBBcf5JYqzYKfKLO_08MgtgZbr26eD4lbxHCnrQ4XOQ&oe=6A7DC89C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-cPkWLcHW0Q7kNvwHm_wZ2&_nc_oc=AdqNaLM5WzYA-DH0CZHbsudDVl938_nViKyC9fDUmF0F8xdyHcwLbbJWsSdu3wXUC4w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgS263R1_NFL5pterwH6k4tD0J5toJYW7-hfje7VatDg&oe=6A7DCE82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
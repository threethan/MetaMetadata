vwEbV0ch&_nc_oc=AdoyWxfKoATEWXS2aBisj4lrSZ8foZzYjVqgZvzok0iXRJBCduWjt-XV1jW_WvzCg50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tyA-uUYVZ0Px-liiSRN-a5rkVOKmaPcpkxxoAlEguNA&oe=69F4A5F8"}, {"file_name": "Session_1.23.1.png", "id": "186237824499218", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75363516_186237827832551_3418390153140386055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACwhDNyZkIEQ7kNvwEkTarz&_nc_oc=Ado5amvXsx9lO-dR8XkooerWM45Ob8d2rFz8Wn0UdwwqqWzz9vmX-6jOnjYsQx95BZ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0h0XiCh9drdAtjC2WQ5bXFLVDnDlzYhtFxeQx24J4KRg&oe=69F4AC3D"}, {"file_name": "FXTweak_1.34.1.png", "id": "2134519373650271", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393467_2134519380316937_6763974651106234459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No-NY69G0lgQ7kNvwF3pkYi&_nc_oc=Adrz0lTBYqxHqUM29Ncah6xGy8-EtrRL6BjoCkIVKteB7Dcr3WNLGZD_BwFkWmbpfPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32ZTjnhLz2n-6H6bVdmw2O2vpKYEhqzh5QEaIgPVdd2w&oe=69F494E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewHeroSnowOculusLiteVideoThumb.png", "id": "1461202384440410", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035321_1461202391107076_2829141908334275354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbSLUb0ooHgQ7kNvwECM7SN&_nc_oc=AdoqOtFtHPQ18B2YBYO1zrTs_sI-tX_3B-XSfF5HisBEIw9iAmJfR7xSTfIzfQcUw6w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zzFP7MZlvoHvbNDorYcppyPMK3bhJacHN5tOZLYFcog&oe=69F49597"}, "display_name": "Tranzient Lite", "keywords": ["Music", "DJ", "Beats", "Drums", "Concert"], "long_description": "#Create Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\n- **Seamless Immersion**: Full hand-tracking support and mixed reality passthrough bring your studio to life.\n- **Perfect Loops, Effortlessly**: Sync loops from a rich content library automatically time-stretched and pitch-shifted to match your song.\n- **Sing & Perform**: Record vocals with motion-captured avatar playback\u2014your virtual self, center stage.\n- **Be You**: Rock your custom Ready Player Me avatar.\n- **Beat It**: Explore a dynamic set of drum kits and one-shots.\n- **Mix Masterfully**: Use Decks to craft flawless transitions and seamless mixes.\n- **Sound Sculpting**: Apply pro-grade audio FX (reverb, chorus, and more) to individual clips or entire scenes.\n- **Automation Magic**: Loop-record automation for FX and synth parameters with precision.\n- **3D Control**: Assign and tweak FX and synth settings in a fully spatial environment.\n- **Visual Vibes**: Sync looping videos to the beat for a multisensory experience.\n- **Step It Up**: Trigger anything in your world with a step sequencer\u2014loop instruments, drum kits, and edit steps with swing quantization.\n- **Synth Powerhouse**: Built-in Analog and Wavetable synths with over 250 inspiring sounds.\n- **Binaural Bliss**: Craft immersive spatial mixes based on clip positioning.\n- **Capture the Moment**: Record In-game camera to showcase your creativity.\n- \"\"Your Gear, Your Way\"\": Plug in your USB MIDI keyboard or controller for ultimate control.", "short_description": "The Lite/Free version of Tranzient.\n\nCreate Music Like Never Before in VR/MR\n\nStep into a revolutionary music-making experience in virtual and mixed reality.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://discord.com/invite/mg6ZJHx", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
kNvwHmN4HX&_nc_oc=AdqYRYwn7CqIEZ_I5z6v-pBzT6wETkRewXeYD0fVgijW-0Z9bTU8ilwDfqc2rjclvfE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ0ekm6eZBl_g9wj_wctwX-LV4L5phaHC5DxlBe02oDQ&oe=6AA96719"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y93mm4r2vLoQ7kNvwEklg8L&_nc_oc=AdrkfhTVtkleZ4Uo5_VaBBLFU474crpECeAZnNdH71vIqinYYGkN34dtm1vzQaMIWzE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5LqxmXC4WgJRaXZXxKw67biFfPhWzKMrLnWcnvWZYRg&oe=6AA93BD4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68VQ_39b5ScQ7kNvwE81ZZ3&_nc_oc=Adq-u3znp1WGI8pmtYf-ib8En-XT_vy7ypbwmWG4w4hs57DYcdQxqSxaijFQWPnyd2E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkaI2wQWlVAfO_cU6vcicCKiiS2xs5nqZ-s7v64E3TEg&oe=6AA95A97"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeLicHPNerQQ7kNvwFL7XIF&_nc_oc=AdqzjSMZORN1R4XsaW2WDFsr05mwtEpT3wwF1LP_-VXIszUPhyPnA2urVgaC3FqAiuA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwD4xyuowEZDSDd1f-5iqJBsVTvqaYs1btMRqgHqALYw&oe=6AA94A1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfrDMW2heSUQ7kNvwE_5z1T&_nc_oc=AdoWsOSF4RSKFm6lIlmOC4nP8nPYHjybABfkkN9j6n05jIA57X4NMblK7vVbMIUL3b0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzm7UBA5u1mSXxIvt6cZL-Kd4TV0BkFu-YzVrapt9N3w&oe=6AA95002"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
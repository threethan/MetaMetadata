yZlUdIQ7kNvwG6Ygy7&_nc_oc=AdomOyX3zGiP0_hs4iCJReyfbB_odh9JSauhkE08hqmc2hgSzdE7BMuk6S8WrG9zcIU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84UvLSGHa1-qXBhL2iCayzMIi6KRSyKgIS7J6snEVTNA&oe=6A453519"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUs-ZKVQwS4Q7kNvwGeSDYZ&_nc_oc=Adpvn76ZaWOo0NgDWyc8vs0ufQ2hFYiYohPA0HDNFxFWOULUSCiWnvpbRLxRW1alHrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lVBwFjk1YVJsaOOzD7DQlu26m4SBhtTqAQxCv17IVyw&oe=6A4509D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUXhJNVyL_AQ7kNvwF3fyhR&_nc_oc=AdppTxzyPyhkYfApx9OqcR6Xq1KNfAcGSeoBSxxYL95egUve9q7H9JEqtnDYeigxDsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-nJG2tCjGOFwz19ZeCHRnaNGdytDVmeaRQyMkhqFDIA&oe=6A452897"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EhabC3SHFsQ7kNvwEdW5m0&_nc_oc=AdoccnQajenC-xaGHQSV5jnAR-cKnymK-komlXXnL_YFXqdKDE2OdPVGcslMRdQlvxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90RIL2myWhGfh6rAfR9rydf-t-wZz4treuxPXWKoZZ3A&oe=6A45181C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzZJq-MPVfYQ7kNvwHgY325&_nc_oc=AdrXcBYcxVK292sDZh91TghJdAWPN4x2TsVbH7_qpfl1F_QS_w2CX8lgVTCQAIHCWnc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RrfUjmjpQoTvZ5dOV7eKMo4dweXERI8H9e0cJ2AoIuQ&oe=6A451E02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
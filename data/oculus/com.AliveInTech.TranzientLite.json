059"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqGiX9DUuZgQ7kNvwHFpuj-&_nc_oc=Adkttc7kBdHZyed2mFbERNfjRA2tFBeRkbqNu5yatjqGUK2Hj1rdQ3hfpNordwouFxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHYZEkYDBO0efcsxR1CrLNLaKGIVwTL34KXrvWMwHB1g&oe=69AD6D54"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyFJ6D0yXSAQ7kNvwFQASDI&_nc_oc=AdkhKb8nDCZPuAwT7BAmSPHU76jPws6UdmiEc0czZIM0GTUcT1oJVSRDn3GRQYEXytQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNA3h0ihYL0am6cxDH9ar7mOEU2h0DWdI8c-DodcHxoQ&oe=69AD53D7"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3cbTVZFnZwQ7kNvwEtHx_V&_nc_oc=Adm-QOMNxX7Hoj5Ma_8R0aOMSVlLlJPQLSwUcWlBh-Wyt4S2yu2GXv2N59HoXADVQqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWbiLekF7669rdWcAeWjPX-oH8-GRDceyj2VCZbnAk2w&oe=69AD7B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wri6z8Rp6zcQ7kNvwEthA2Q&_nc_oc=AdmYphSV07c7-f_j1Bq_oTePbUBkcXXorJrLiX24WuqRS-xXjIfMhvoJ1yb-mLU0ZPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNSwHEYz8VuXdX_h1aKIM9jcXkJyxCLhQmo41KEn2IPQ&oe=69AD8182"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
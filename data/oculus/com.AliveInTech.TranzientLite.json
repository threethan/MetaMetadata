A59"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUEI04lSsvIQ7kNvwE4sWd7&_nc_oc=AdkI-zNuW8usjgguFA94x--6scnzk9OApDTAK9Ix86PnY2KwrStLDLj1Q2JSBvxH64c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwYrBrj15mBsFRs-L0XQu7InSORQOWG77Vp0NFOzgRXA&oe=69A82754"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fLkcsgRJf0Q7kNvwHm8Ffo&_nc_oc=AdmcJHf272tMkVaZ_5p33Z0an7ZriuHm45harrHQZcv0_2iA_Ewl8WiXNzZDtHuK-9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmXScZ7PzcJNQxxJQmOpkytnezjLhNRzJI9p38rkNJTg&oe=69A80DD7"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Acm5gnJ24z0Q7kNvwFcVkrr&_nc_oc=Adne5sBAh2G-D9fzinM78YregkAKA-LWujhCLxp5xixiADwDYFWqvzNNKNvsmCChRjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afttqw_95dvKjF25GIGa8By1n-NIJcR48xOHQzImCJXd9w&oe=69A8359C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smdIWNrnoaIQ7kNvwESfvhc&_nc_oc=AdkVpKQAuTArxx5x62aEKTTBy2dTJgdH6giT_ixD7hCgflA4xxsJ0Rsft3XfH9wU-n0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7AdiVH_Z4yJpcCJI51BfkQprJ7WZ6YIkeN7b_nBo45w&oe=69A83B82"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
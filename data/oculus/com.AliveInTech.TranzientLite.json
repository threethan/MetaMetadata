kNvwGx9z3X&_nc_oc=AdrIWcTfgqN27-rUIM7rawTlF0fXtiWN5lTdbOTwvAhdS8c7GTZt_Cak9FDJf4Ma638&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkttFFPDR7ltOtjfMiUuU_ncTMqw7r2IIdEcmbnU16NA&oe=6AA42119"}, {"file_name": "VFXCrop.png", "id": "177051320991484", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982535_177051324324817_536426833029901367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6knOT3KMCDQQ7kNvwFJ_l3y&_nc_oc=Adq8dxjqPLgU7b_5hapjfP5sCCDBVkvg8OJQ56JrKwbkqbX-41JMFGvymdcJinbC3bk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITkWToazCuv_jEICgbDpt_EP1BIXqHhGqI2A7CikBfbw&oe=6AA3F5D4"}, {"file_name": "DrumsBrightCrop.png", "id": "906668313223333", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974538_906668316556666_7612337564929272449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpyDwsHNKJwQ7kNvwF8NZbf&_nc_oc=AdoFRFwWEKsWTgNSSlJxiQwxafD2CrJjXXQt8MpsZfMy-UK1SPIA4H9Lnz2bJAld0fw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKnzvnzvgb7QuVJkc3bfDaMaSTRQc_qaB_mgYGhBoQ0A&oe=6AA41497"}, {"file_name": "vidwallcrop.png", "id": "188480243148567", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_188480246481900_1395795850249111562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOcrptdKq8UQ7kNvwFrPmRY&_nc_oc=AdoSHigUacjCKdw9yI9uZHbh2gns0xq8Cm5j-WPrKsmf4QQ4yXSOk5ucfgiQs_byF9c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrHnAIW6yonAQ7pW_HVkNpcuG9DdfJlMF8cjEHTPrIJA&oe=6AA4041C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RPMSynth.png", "id": "529939358451396", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86613168_529939361784729_5099460692979232560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MxvSNA2jS8Q7kNvwFDWllH&_nc_oc=Adq2XEYW1x3n7ACSmfneoy13MztAivmJZc6OeNtwHrASWdkar7qWsmTI9qERVF9rEYA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzSb7M9vs0UizN02UwbdFitNeljSEOHhybAG4Ljp_eeA&oe=6AA40A02"}, "display_name": "Tranzient Lite", "keywords": [], "long_description": "Make beats in VR - This is not a rhythm game!\n\nImmerse yourself in live looping and music production in VR.\n\n- Synced looping with content library, auto time-stretched and pitch-shifted to fit the song.\n- Record vocals including mo-cap and replay of your avatar.\n- Use your custom Ready Player Me avatar.\n- Set of drum kits/one-shots.\n- Use Decks to create a seamless mix.\n- Full set of audio FX applied per clip or per scene (reverbs, chorus etc). \n- Loop record automation of audio FX parameters and synth parameters.\n- Assignable 3D control of FX and synth parameters.\n- Loop videos synced to the beat.\n- Step sequencer - trigger any item in the world and loop record instruments/drumkits. Edit steps, swing quantize.\n- Built in Analog Synth sim and Wavetable synth with >250 Sounds\n- Spatial Mixing - create a binaural mix based on clip positions.\n- In game camera and screen/mirror.", "short_description": "Make beats in VR. Full live looping music production and sequencing environment in VR including visuals. The Lite/Free version of Tranzient.\n\nThis is not a rhythm game.\n\nWho made the beats? You did!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy", "developer_terms_of_service_url": "https://www.aliveintech.com/eula", "publisher_name": "AliveIn Tech Ltd.", "support_website_url": "https://www.aliveintech.com/issues", "website_url": "https://aliveintech.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
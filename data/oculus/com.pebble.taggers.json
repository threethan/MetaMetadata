_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKOkjx-5mCIQ7kNvwEc7n3g&_nc_oc=AdoG-L3goivGxXT-ueV_zXfukrq9y5ibPYiNj6sHb2aHRvIGN-8JY6Ds3GN7hUs4OJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvQqgyS1w8jd4fXV9AzWZORVx9U50y9EYqqiPRhxG4Fg&oe=69C7E394"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "pebble taggers 2", "keywords": [], "long_description": "This game is a VR movement playground where players move using only their hands and arms. Push off the ground, slide across surfaces, and use momentum to launch yourself through the map. The game focuses on smooth physics-based locomotion, letting you explore, parkour, and move freely in a stylized environment. Jump across platforms, scale structures, and learn advanced movement tricks to master the map. Whether you\u2019re hanging out with others or practicing alone, the experience is all about fast movement, creative routes, and fun, expressive VR locomotion.", "short_description": "A fast paced VR monkey tag game with gorilla locomotion movement, where players climb, run, and jump using only their hands. Move by grabbing the world and launching yourself around walls, and obstacles. a fun, movement based."}]}, "developer_name": "Cyro", "developer_privacy_policy_url": "https://sites.google.com/view/pebbletaggers2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cyro", "support_website_url": null, "website_url": "https://sites.google.com/view/pebbletaggers2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
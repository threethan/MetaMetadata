5D224"}, {"file_name": "2.png", "id": "1077285988373497", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593875952_1077285995040163_4410201675877272216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKgMuZyk6ckQ7kNvwE8MzA7&_nc_oc=AdqRlZnLLBIN0OBHpJwCjaYWUqNzUaTYqLmF5EIFxTnyIdC1PXSEJ2T3h_S-5KUShfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6SeifOquX-EHdOsIhcTbpzHp9-1TTcHarYKPIaNQu0w&oe=6AF5C0DC"}, {"file_name": "4.png", "id": "1095786740092992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1095786743426325_6779400596273969155_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEPAUc_jR08Q7kNvwHwOdvs&_nc_oc=AdpuBGdpUtw0gsr7zSo5Q7AXJwwDubONgvCdR1yrI-448Da-xFBA9bGArH9FxqPjK-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-kh9esM6bpnG0Yu0VgDq9-TtQC1ewIc2LQi82cKj7XQ&oe=6AF5F167"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warplanes: Pilot Force Simulator", "keywords": ["warplanes", "pilot", "force", "fighter", "combat"], "long_description": "Warplanes: Pilot Force Simulator brings intense, arcade-style aerial combat straight to VR! Jump into the cockpit of advanced fighter jets, pilot through hazardous floating island arenas, and engage in fast-paced dogfights against enemy airfleets and heavily fortified sky bases.\n\nWhether you are weaving through narrow rocky canyons or raining laser fire on enemy squads, every second demands razor-sharp reflexes and precision piloting.\n\nKey Features:\n\nHigh-Octane Dogfights: Lock onto enemy jets, dodge incoming homing fire, and unleash destructive special weaponry to clear the skies.\n\nDynamic Floating Battlefields: Maneuver around suspended island rocks, heavy industrial skyfortresses, and narrow sky passes in fully immersive VR environments.\n\nAction-Packed Arcade Gameplay: Experience intuitive VR pilot controls paired with fast-paced, wave-based aerial combat designed for maximum adrenaline.\n\nUpgrades & Star Collectibles: Destroy enemy targets to gather power-ups, boost your firepower, and score stars to dominate the leaderboards.\n\nImmersive Audio & Visuals: Blast through clouds with realistic jet sound effects, dynamic explosions, and vibrant VR visual effects.\n\nStrap in, grab the throttle, and prove you have what it takes to become the ultimate ace pilot! ", "short_description": "Take to the skies! Blast enemy jets, dodge crossfire, and conquer floating island battlefields in high-octane VR dogfights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1339426492584727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_1127320653314269_2141846427492393900_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NALFj9U6avIQ7kNvwEqLQHc&_nc_oc=AdqOohn0z7UJy6nY2aO2EthXPECuDFKDIPkKYzxP9SN6r_jT2aCL2U_I9DevWh2ddcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=
tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_28332027726499256_6944958801978866481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chY904Ur0J0Q7kNvwHLvBwy&_nc_oc=Adpn8vAKHgTKi04VLx1hs5zKY2SsnFBFUrOTpVBMErLUsJEK_l3BRTXBEfe32A1dOfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv0SBhO30_66SMzj22iQx0yT5X_3C_Jjy8Qejd5XgC6g&oe=6AF5D979"}, {"file_name": "5.png", "id": "1076227608716394", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619404_1076227612049727_3483851431962858597_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRI7q9v8afYQ7kNvwGCFUBq&_nc_oc=AdretCG2gKjeiUlL0VegvjwHiA49BGcQp6Tja6DJ7gke-U5pdtoM0fszltVMf7oNNS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqOKVYFt0dJvvaUDeuiQS3HkTShPqCuY1y84JDrO6V6w&oe=6AF5CC51"}, {"file_name": "1.png", "id": "1399652145711614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593716858_1399652149044947_1743158870013149737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jdix97l14cQ7kNvwGlIGlu&_nc_oc=Adq3f26lK5xAmU1SuEKNBwM-F8xmI8RHgFb_k9H2dr-WLSISRi03S67XTiENH6DoonA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4tpjWKiuaGukj2qMSL9TWMpcWwxciC2B7CeoRUZKBxA&oe=6AF5D224"}, {"file_name": "2.png", "id": "1077285988373497", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593875952_1077285995040163_4410201675877272216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKgMuZyk6ckQ7kNvwE8MzA7&_nc_oc=AdqRlZnLLBIN0OBHpJwCjaYWUqNzUaTYqLmF5EIFxTnyIdC1PXSEJ2T3h_S-5KUShfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6SeifOquX-EHdOsIhcTbpzHp9-1TTcHarYKPIaNQu0w&oe=6AF5C0DC"}, {"file_name": "4.png", "id": "1095786740092992", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1095786743426325_6779400596273969155_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEPAUc_jR08Q7kNvwHwOdvs&_nc_oc=AdpuBGdpUtw0gsr7zSo5Q7AXJwwDubONgvCdR1yrI-448Da-xFBA9bGArH9FxqPjK-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-kh9esM6bpnG0Yu0VgDq9-TtQC1ewIc2LQi82cKj7XQ&oe=6AF5F167"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Warplanes: Pilot Force Simulator", "keywords": ["warplanes", "pilot", "force", "fighter", "combat"], "long_description": "Warplanes: Pilot Force Simulator brings intense, arcade-style aerial combat straight to VR! Jump into the cockpit of advanced fighter jets, pilot through hazardous floating island arenas, and engage in fast-paced dogfights against enemy airfleets and heavily fortified sky bases.\n\nWhether you are weaving through narrow rocky canyons or raining laser fire on enemy squads, every second demands razor-sharp reflexes and precision piloting.\n\nKey Features:\n\nHigh-Octane Dogfights: Lock onto enemy jets, dodge incoming homing fire, and unleash destructive special weaponry to clear the skies.\n\nDynamic Floating Battlefields: Maneuver around suspended island rocks, heavy industrial skyfortresses, and narrow sky passes in fully immersive VR environments.\n\nAction-Packed Arcade Gameplay: Experience intuitive VR pilot controls paired with fast-paced, wave-based aerial combat designed for maximum adrenaline.\n\nUpgrades & Star Collectibles: Destroy enemy targets to gather power-ups, boost your firepower, and score stars to dominate the leaderboards.\n\nImmersive Audio & Visuals: Blast through clouds with realistic jet sound effects, dynamic explosions, and vibrant VR visual effects.\n\nStrap in, grab the throttle, and prove you have what it takes to become the ultimate ace pilot! ", "short_description": "Take to the skies! Blast enemy jets, dodge crossfire, and conquer floating island battlefields in high-octane VR dogfights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaest
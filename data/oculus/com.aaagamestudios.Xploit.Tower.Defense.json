cdn.com/v/t64.5771-25/499307931_1828317405188253_5306163265984783822_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuG5AOdL-MgQ7kNvwH1WI3U&_nc_oc=AdqO6iYSrj6I8s3anql9OnAblSE4fhu687Ao2oUJGfQ5dhy2ZILSEA71cDliDf-4SXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7Ztv4RMB9wRUszAkYOnfUwJN7Z3t2CdNrsGT4Z4hkKA&oe=6B1067D8"}, {"file_name": "ScreenCapture01.png", "id": "1264304975679481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1264304979012814_7016415153274904402_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Sp10e14wN0Q7kNvwGrbTKR&_nc_oc=Ado8Z-ZW3o9GsPO34RV7ZBikpPcf9sle8jaO8Fk0IlNk3IIABpOgauq7uFBvDLVGVjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJVpr3qVOcN0eWaDRfQJd22Ou5HTNFUT8h6RZrd_tOaQ&oe=6B1050AE"}, {"file_name": "ScreenCapture03.png", "id": "1596091525204093", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_1596091528537426_1164627618801872421_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlkTX4M_E3AQ7kNvwHbpRwW&_nc_oc=AdqHMvsPQXUHU8WWeqJYXGgyHGskNiRkmXGoRF9YfyKfzRIgj7IhNR4AcqdGhEfauiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8yX75AsIf7sxq3EgDXJhtG9dIqUDZQ-H2ul9S3nFiAA&oe=6B104C96"}, {"file_name": "ScreenCapture04.png", "id": "1592650348877319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_1592650352210652_3542528810768719988_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDfmvXmvLuEQ7kNvwEkOgIi&_nc_oc=AdqZrCGilE0l2POYlATmQVNXICa_nkNyLlkyOFJbzqIqOU-z6LGw2_Jw0EKCalTe0wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFABEaUD4fWl5VV7hpl6L1wZAOaYwyb1DEGSQx_eayCg&oe=6B1062C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xploit Tower Defense", "keywords": ["strategy", "defense", "scifi", "MR", "tower"], "long_description": "A massive cyber-invasion has broken through the firewall between the digital world and your own. Crawlers, swarming digital insects and their larger Malworm cousins are pouring out of the network and into your living room, hunting for the memory cores that keep your reality intact.\n\nThis isn't a screen you watch. It's a floor you defend. Using mixed reality, Xploit Tower Defense scans your actual space and turns it into a living battlefield, your couch becomes cover, your hallway becomes a chokepoint, your walls become the front line. No two invasions play the same way twice, because no two rooms are the same.\n\nPlace your defenses where the threat actually is. Track Crawlers as they climb your furniture and crawl across your floor in real time. React fast, adapt your strategy on the fly, and protect your memory cores before the swarm overwhelms you.\n\nFortify smart. Aim true. Think in three dimensions,  because the enemy already is.\n\nDo you dare defend your reality?\n", "short_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. No two invasions are the same \u2014 your space becomes the battlefield. Think fast, defend hard, and reclaim your reality. Do you dare?"}]}, "developer_name": "LENYA DIGITAL", "developer_privacy_policy_url": "https://www.aaagamestudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Game Studios S.L.", "support_website_url": null, "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
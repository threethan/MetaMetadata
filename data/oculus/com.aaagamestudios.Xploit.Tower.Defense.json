cdn.com/v/t64.5771-25/499307931_1828317405188253_5306163265984783822_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuG5AOdL-MgQ7kNvwFf4g-G&_nc_oc=AdrpZrzveV5W7k1LAUWWCzc213wwTuVe7IOgtCikFDS7zw7nmxND0tUalGYcqqPxqKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0Vrn52abWayRe6sJQ14EGyhgw8G84cQDnHpGOSKhBlg&oe=6B0F1658"}, {"file_name": "ScreenCapture01.png", "id": "1264304975679481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593790560_1264304979012814_7016415153274904402_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdNwx65lH1cQ7kNvwHYL1sH&_nc_oc=AdqDEmkcCA-FmiwkFLK4IG4yfH9MLB-XSDqpNyipiEbHS6X1Lpp0rkOZYKSRVH53jFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWD5WFWG93ygq3CskyXNHR_n6DU681dP6evXiF3eKm66Q&oe=6B0EFF2E"}, {"file_name": "ScreenCapture03.png", "id": "1596091525204093", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_1596091528537426_1164627618801872421_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlkTX4M_E3AQ7kNvwE1TBEh&_nc_oc=Adrmb36Afue92IdpnUV4ytmhh1dtDSdQ1Z3dD-cIOZMX4Q2IUaYPjpowBnPuutUMSUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUA1uvKQy4nSCgU6c8t2LOcRJtNk4zHQAzitdAICakZpA&oe=6B0EFB16"}, {"file_name": "ScreenCapture04.png", "id": "1592650348877319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_1592650352210652_3542528810768719988_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUU7ovfq0Q8Q7kNvwGPp0q2&_nc_oc=Adq9NmPIUkP88eIDWvyLi1dZtMdHpZ5neWUXppMH1I9WH_h7lGobW39Jmh83Ta-5SXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgPksSqNS7gXgcoYvOYE2SVersiKeULHf3i2MSeFWVjA&oe=6B0F1141"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xploit Tower Defense", "keywords": ["strategy", "defense", "scifi", "MR", "tower"], "long_description": "A massive cyber-invasion has broken through the firewall between the digital world and your own. Crawlers, swarming digital insects and their larger Malworm cousins are pouring out of the network and into your living room, hunting for the memory cores that keep your reality intact.\n\nThis isn't a screen you watch. It's a floor you defend. Using mixed reality, Xploit Tower Defense scans your actual space and turns it into a living battlefield, your couch becomes cover, your hallway becomes a chokepoint, your walls become the front line. No two invasions play the same way twice, because no two rooms are the same.\n\nPlace your defenses where the threat actually is. Track Crawlers as they climb your furniture and crawl across your floor in real time. React fast, adapt your strategy on the fly, and protect your memory cores before the swarm overwhelms you.\n\nFortify smart. Aim true. Think in three dimensions,  because the enemy already is.\n\nDo you dare defend your reality?\n", "short_description": "A massive cyber-invasion is breaking through into your reality. Crawlers and Malworms are swarming your own room, hunting for your memory cores. Fortify every corner, deploy your defenses, and react in real time as digital insects spill across your walls and floor. No two invasions are the same \u2014 your space becomes the battlefield. Think fast, defend hard, and reclaim your reality. Do you dare?"}]}, "developer_name": "LENYA DIGITAL", "developer_privacy_policy_url": "https://www.aaagamestudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Game Studios S.L.", "support_website_url": null, "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
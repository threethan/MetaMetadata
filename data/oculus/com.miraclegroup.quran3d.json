 114 Surahs included\n\ud83c\udfa7 High-quality audio recitation\n\ud83c\udf0d Immersive 3D VR environment for spiritual focus\n\ud83c\udfae Simple and intuitive VR controls\n\ud83d\udcc2 Easy Surah selection and navigation\n\ud83d\udd0a Clear sound experience optimized for VR devices\n\ud83d\udd4b Spiritual Experience in VR\n\nQuran 3D is designed to provide a calm and immersive environment that enhances concentration and reflection while listening to the Quran.\n\n\ud83d\udee0 Platform Compatibility\nOptimized for Meta Quest devices\nCompatible with Amazon-supported VR platforms\n\n\ud83d\ude80 What\u2019s New in This Release\nFirst public release\nFull Quran audio integration\nSmooth VR environment performance\nUser-friendly interface", "created_date": 1771336811, "id": "25687663594189295", "version": "9", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25427666136855710", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25873192928969693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2365363233967863"}]}, "change_log": null, "created_date": 1771331910, "id": "25687075860914735", "version": "0.1.1", "version_code": 8, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25427666136855710", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25873192
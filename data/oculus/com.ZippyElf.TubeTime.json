-5PJHn_QkGNnhlyBJm5NZRgIZykbAI3K8ebFfE8P2kVtErgfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs5FcWkG-RIfCNpAZkLmrj8DMjpKFM1iqOP4WWlyvFIA&oe=6AB28DCB"}, {"file_name": "TorchScreenshot2560x1440.png", "id": "1086068316442045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_1086068319775378_1286356508104481347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzud7hJFRwgQ7kNvwHcn0RS&_nc_oc=Adrwn4Xi2jiq9jXsGzwIrMz2KeR-A-Tkqzanz5rCz8esKFH38jqUwOHSVyV4ASNtt0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0fhpDJbLSFXPJalVaMk5-eKryZEYW4QzOCenomaIWGg&oe=6AB28632"}, {"file_name": "PickAxeScreenshot2560x1440.png", "id": "893452486042640", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974723_893452489375973_1112798142056394262_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiPONWeME-wQ7kNvwHqd95K&_nc_oc=Ado32aHEp0sIi2zaq64mozzBZPVdFWoHuPfhSar2TJPM5kOx7jC8e6pKfwO1SmQMdZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkYvcyyTdMeEwQzZrYlbriiCwM95ze3RiVPqjSH4LkKg&oe=6AB27278"}, {"file_name": "Horseshoebend2560x1440.png", "id": "1075239917594189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1075239920927522_3997554703966401821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JW4VYfXQicQ7kNvwFeKfE7&_nc_oc=AdpstMGrPJDOuE6ykRqsZuEHjKimf8QS3UYYkvPi0Gm7E3qsCtvc8JWQ41rOigqij7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqg_pDZN0nFCM7tNu67kvy62OjLwPZvMmQdGVpJFfl6g&oe=6AB295CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TubeTime2560x1440.png", "id": "2284080728657621", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569430_2284080731990954_1834225393466360514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgfqNiy2QKAQ7kNvwEJLBPE&_nc_oc=Adq0hE_8KYJfKXe26UvN96_iUi8fxg4UfNRokuNy1y19fZPIT7Xz8sm2EfJPpCrUAM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFt3Ms0SksrDuDV7WZHFPUt47-Lwwsfbq2g1lEKpsiUg&oe=6AB29D27"}, "display_name": "Tube Time", "keywords": ["Tubing", "Relaxation", "Scenery", "Nature", "Multiplayer"], "long_description": "Welcome to Tube Time\u2014a relaxing VR river tubing experience! Drift down beautiful rivers, take in the stunning landscapes, and enjoy the gentle flow of nature. Maneuver around rocks and logs at your own pace, discovering hidden spots and enjoying surprises along the way. Whether you\u2019re floating solo or with friends, Tube Time is all about kicking back, enjoying the scenery, and sharing good times. With immersive visuals and intuitive controls, it\u2019s the perfect escape to unwind and create unforgettable moments in a peaceful, vibrant world.", "short_description": "EARLY ACCESS - Hop in and float downriver with friends! Chill out as you drift through beautiful landscapes, soak up the scenery, and enjoy some good vibes together. It\u2019s the perfect escape when you just want to relax and take in the views. \n\nWe\u2019re still hard at work building Tube Time, so we\u2019d love your feedback! Connect with us on Discord or drop us an email. Thank you!\nwww.zippyelf.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zippyelf.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Zippy Elf", "support_website_url": "http://www.zippyelf.com/", "website_url": "http://www.zippyelf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMZ1sSWgQKcQ7kNvwGQAdDj&_nc_oc=AdqI5_L8doXBSkEEx4KksW_G8YEujeSpjlJAqO49OHLoXLZFXyx9B8uw0IfdalQ1hQo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnOjOeDvfWCZZxD5s5kghkJHeSlN-StHmB2Fy_dPV-kg&oe=6AFB2CE5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.melcher.ca/dr-privacy", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.ca/", "support_website_url": null, "website_url": "http://tourismregina.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_CA"], "supported_input_devices": ["GEAR_VR_CONTROLLER
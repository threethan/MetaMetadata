n.com&_nc_ss=8&oh=00_AfxTbvB4yBNy8hzHk-G4Xl3qZq4MUrjx7lGsdvs8_vbIww&oe=69B014D3"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HAgNFHcFd8Q7kNvwEZIkBW&_nc_oc=AdloApUDsg8Hm-Tw03CEvDKXq7iCQylVUIWA8nbvTdSsY2QEWbKxD7yU8PnIYAnDF6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0P51B4eolinACTTvGaynQDEMqRlmQSu_YP_yyKRPTbQ&oe=69AFF73C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCrszPOE6yIQ7kNvwG3VRIv&_nc_oc=AdniZQvN3t-S_Eqt3a-YEN-do91ZgdmDYrwTga7PE4aDg1JiHtyuFiRigG2Y8pi8z_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXapC4z3vKv2cg_JSc85omQ7SpDSgXpoe4buaOW9uMoQ&oe=69B00C25"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
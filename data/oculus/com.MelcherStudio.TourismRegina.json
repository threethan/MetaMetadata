n.com&_nc_ss=8&oh=00_Afyp60WG_zOc7wod16I4X9g5od93Is7IrnCVLOl0z20D2Q&oe=69B2B7D3"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HAgNFHcFd8Q7kNvwEFe6bq&_nc_oc=Adkbvwjn2Hzq3Fuma236CAnpYx3h8iqxe3QXWpbnOFfh_wtubb2vFIoCe8w6lp5vyn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCEznyhnd6qiKR1qu4enGr5PxQZ4yNvUN6MDvwOB3Z0A&oe=69B29A3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCrszPOE6yIQ7kNvwGkfSnS&_nc_oc=AdlsPg1XrKQctiyMP-J_ZNabi7MJtuMeUjm9UWQyfa7gePIxQb2MQNqYZfXqYB-xvgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCGoPKZyQj472mc45l93RPUb_OhIUjV0UEhsl091dZCQ&oe=69B2AF25"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
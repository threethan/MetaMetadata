n.com&_nc_ss=8&oh=00_Afx61HakKl7oLisfnW_y82Bvt9qxHJ1y0gfmnUkdq7FC3A&oe=69B16653"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HAgNFHcFd8Q7kNvwF9CxgQ&_nc_oc=AdkOVGvhSN_Zccnizm32s4-wO4tUKK2UE9eDW4KVyxDxugRJWlYp6_4CS3ad56cQezE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyUIJE3Iry1Te6hfYj-TYNrONUGfTZEN7aXzXjbSRGjw&oe=69B148BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCrszPOE6yIQ7kNvwE3DUsl&_nc_oc=AdlynCgZhxTcMp3K4ta4SvCUTLhohufmqeWMUO9IGyazqilw408NxDqJzoHHB_jqyms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfygnRxfM-tHWAGBRhL96N4kBHSr7B4KVbXw9xetQrDQAQ&oe=69B15DA5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
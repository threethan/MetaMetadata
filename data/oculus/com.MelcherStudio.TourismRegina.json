n.com&_nc_ss=8&oh=00_AfzCVrS7wLJZfeuhhGAA_WN9U_MJ0gTLZSJaYJeE16phtg&oe=69BBF253"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq29O4y9fA0Q7kNvwEqGLYq&_nc_oc=AdlhH27jXqs0YXuGGdPTGYgqm5lOvbUPO3oGaeccvaYeuEhmpngKhZoaSos_xnNn68Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyj4BrxPWuRT-U59asKFRAyTobBcrq_to1dnGgUpjjoPw&oe=69BC0CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRuMRRnFYMcQ7kNvwFfC0S9&_nc_oc=AdmHYSojd-i_UyoslgY3E_QiOwVawUXrIVdu8FJCuQ09ztGMWRMILgJNOA5zZhcBz80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyeb16CI2rkqriUtAqK_1orFzYDGCsdpCub9JOhkPNa2g&oe=69BBE9A5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
k&_nc_oc=AdqealaZDl9AQg5KlkK8YWRElIbeaq10yAoV7k-S2lmIxBClKhcZG0XAhRHcHM0VfU8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F4Aq6XNXfUI6CiVU9LgE4_cK483eJXuDuLcmFJQtgYg&oe=6A368DD3"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbOAzZOvWXEQ7kNvwGCcgG4&_nc_oc=Adp1V0dIT-SxaoU764DyAve0cCF1R7Tst6RRGDGkY0MXv9lq6VGW6iKW6chhlimjzD0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TDjIK0dRq6umqLp_lm9SF4V_EmzT_9FqyBiUP3NWt4Q&oe=6A36A87C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGBhH9gJ5GUQ7kNvwFqtBry&_nc_oc=AdqKyhi_FR0ptY-nbijHAEdraWjqZ7skkVycmGfeIF4Vd9Lqx0n-HgExX3PXI-G8X5U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h2hsQWkEcWk5Wmm07WIFf6R775xrZZYZp6bXlGNc6HQ&oe=6A36BD65"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.
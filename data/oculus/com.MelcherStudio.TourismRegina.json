n.com&_nc_ss=8&oh=00_Afy8G5e4zcrP7WCAloULJvu218VbIwqV9MFaehz1qwNuzg&oe=69C13853"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py12iro7PNUQ7kNvwHwVlhp&_nc_oc=AdpW8y8OL_RbahP30hA89sWHZatICCnhRw7PdZjeZ3wC-CCLLdKHliDQ-ZrbOnS7dck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzR78JjgQbTaSHKCjEYF6PHM-J4Vpop-4BSD4kZSKp7BA&oe=69C152FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN7JYtuGm-gQ7kNvwFqvfTf&_nc_oc=AdopPyPDAHsQO5EtOMakIF33TPfBU4LISzCCIlAWtPNJPdzAHDnTPHTP-Qs7AZLu-7U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPiEeNx45TKmF1JRP8b5nc7LzsE4dZm35QuhS8XNfNpw&oe=69C12FA5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
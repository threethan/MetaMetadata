n.com&_nc_ss=8&oh=00_Afwka0j7zBkgsOVupWN2wbt7zlim6CfGfCvWso1cMw2Whw&oe=69B7FDD3"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmyrh3q8NxMQ7kNvwFuDpe2&_nc_oc=AdlMXEvUOkwRKX_k9VV1vds-9xeNrOPF1e6MFIZGfzex25GDYrx8fwP__atgNs4GLac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9v5RnmAwhsAlxj4DoYeM7SBsLTxuBAvNI3IcJK5mzwQ&oe=69B7E03C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxyIeh92v3IQ7kNvwGZi9U9&_nc_oc=AdnsD0ggWO7N4xXP-DxHMq0pQRMKU3PaPogc7XjA0-lI3Xl_i_adFgNtAJm8NU4C92s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8IuUrlQjrxo0A8PnvgIRB0OB7JAilp2xOejLu8YNmCw&oe=69B7F525"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
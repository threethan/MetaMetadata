n.com&_nc_ss=8&oh=00_AfyzUcbdpvXQejyQTPCF4Mymu24rDix5GP0QpdL4s3-MjQ&oe=69B94F53"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmyrh3q8NxMQ7kNvwFlQGjb&_nc_oc=AdnATySkvRrfepkkYJ_0r-_joGXT5o9NJjdDgO4OfRfFLlyKFPx5qqi3g2D9UJc1P2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzh1rPY_bB6WjzCiuRLnoJNJ7eMJR7axLuikJLlVJWexg&oe=69B931BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxyIeh92v3IQ7kNvwFbKwGP&_nc_oc=AdkjN2nG7dRmoFom9ALZaCHvo8fgaly962fGV6i5LjM_xHnB0UGTizGcXKav-1WYsB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN84tjrJjuHpnMSrLj0yufRd8TINcF5PC4Zx4QEzbUlQ&oe=69B946A5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
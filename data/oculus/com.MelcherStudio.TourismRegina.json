n.com&_nc_ss=8&oh=00_AfshnWgJbeNkOm40BfPUZcGyscw0-qK9FIq9hqlCsfocTw&oe=69A97D53"}, {"file_name": "migrated_image.png", "id": "223600082174446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162737_128679784449127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvUAOlGrcyEQ7kNvwFVngTS&_nc_oc=Admm6Brl7Q1IzWf7iDkrW7aFPN21KJQzG-6MhdbyLy_Z_9V6IHStnwp-yQclP2A8Ry4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftbezh_0A3KKNgz1ulCTLQ66lqE6i4EHtYrWf0DQpHVLQ&oe=69A997FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ok3yh0Qmp0Q7kNvwG4Wdyv&_nc_oc=AdnmOFm3-4NV4Ub1Nx48YVqlmXd7Elsl403aD__JjJsaWsWGyGoRFRO4y1254RalW7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8Z6ozVis3ocUSPAJ4Y1sD-_LdyYcqYG7YPkkdz3qsdw&oe=69A974A5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.
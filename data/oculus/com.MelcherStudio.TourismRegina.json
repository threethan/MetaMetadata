127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdkVR_1MgS0Q7kNvwGqGFlj&_nc_oc=AdmIP2lLolcvoKhk_2bH3Xu4oAHiqAIqCFH4S96Qkj7jKGTezrdSEp1Hvpg3uxkzosM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGaPXbXlf_tKTOE03VFiQ4_AbGTqw_XBU3wWdjzAnCHw&oe=69A6F4FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2e69t8XheYQ7kNvwHNV3vm&_nc_oc=AdltmPhI_Jd6cPjb4lY24blPaU_rr9jU2fZ6JQXQD_iYGK7pjluMra0dOXCvis2SJtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveFhUHbdGUAnPHZSorqnsa1YPht-4w2sAMvJKFcYym8Q&oe=69A6D1A5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.ca/", "support_website_url": null, "website_url": "http://tourismregina.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres":
127_4011094907199422464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdkVR_1MgS0Q7kNvwGPodqj&_nc_oc=AdljVDnceXI_q0o8QlyADJ1qiUxBXs-QBho6a_SRVzWvrn0Lu8PvEoZ9_p-ZFQUyGic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftz7dJ3Ky1DZPoL696HwJinXwpa0lMEIh9D0wUDOQbEDg&oe=69A419BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalleryArt1.png", "id": "119255108779803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_119255112113136_3054877944062148608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2e69t8XheYQ7kNvwHMKg1h&_nc_oc=AdkKpdYVnd1LvmTJzWlkM7c6g7JjVDZMp80Dyifwj9w61HCln8UVT1jJo6BvusruZkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftnZH_5hEIZMeJJKiaS-X5hHi5M2gt31LQb2NfH38IaTg&oe=69A42EA5"}, "display_name": "Destination Regina", "keywords": ["Regina", "Destination", "Tourism", "Saskatchewan"], "long_description": "In Regina, Saskatchewan there are tons of things to see and do, with new shops, events, and attractions popping up all of the time. Here, it\u2019s the locals who know it best, so who better to show it off then through their eyes in this 360 virtual reality experience.  See what it\u2019s like to be on the field with the Saskatchewan Roughriders, or  hop on stage at the Regina Folk Festival! Love food? Party at the Market Under the Stars with tons of vendors and music, or get up close and personal with a bull at Canadian Western Agribition.", "short_description": "See Regina through the eyes of the locals in this 360 virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://tourismregina.com/terms-of-use/", "developer_terms_of_service_url": "http://tourismregina.com/terms-of-use/", "publisher_name": "http://www.melcher.ca/", "support_website_url": null, "website_url": "http://tourismregina.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres":
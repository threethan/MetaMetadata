878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-VQCCivgoIQ7kNvwH2ZVqh&_nc_oc=AdoYKjGHVlF3yfKqQOiFOgzIvGSm6JACh0fHTE9UvflMxm8v3zDxf1Wv3L4oVWc21Wo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTKFTH49m2fxO5TJEsfds4LAhUZe7NdfPv3MtlP5vuw&oe=6AEC99F0"}, {"file_name": "SC4.png", "id": "879061081387166", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_879061084720499_7568711587934158013_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0sGn6TNDpwQ7kNvwHX_pJB&_nc_oc=Adq-lJQvWQYyZ6vQuYzKQKLxOb078OrpqHLsDnec2bJTByCXtYTXlnwyqjVBYLJAmZ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhZmHl7qheXoAyhucyYDcsTmIHqBZ2K8uFwdENh3KFfw&oe=6AEC9AFC"}, {"file_name": "SC5.png", "id": "1521691042166546", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499311597_1521691045499879_1196373838991986073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8NqffAbHyYQ7kNvwESR17H&_nc_oc=Adp56gZAZRK88AYU-UQ7yHDx_28lKKqgdvxY1t-TNqQrdICLBgcRhuEEZLLqIWKXzcA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCG-FZJPka0wAf5HtCyYibFFynR8xYnkbC9iRV3nFYAQ&oe=6AEC8739"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "multiplayer", "gorilla", "animal", "social"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a brick wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": null, "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1218791927981375"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1543442460758773"}]}, "baseline_offer": {"id": "1543442460758773"}, "is_approved": true, "firs
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6LrWivuMyIQ7kNvwHX5zeT&_nc_oc=AdpNBoT0bMwNO4beAU25pUwNovqZ6v53pDqiv6tTKMCbcs_Thf3EkZ8JWKoZPdCWmQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVcJv2N7GHnARAkfB8eUh9Jd9-fOynBVlI8r1yqHITlw&oe=6AE76D01"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je6QEwRNaU4Q7kNvwGu7YMj&_nc_oc=AdpoeHmuRLQObFwbY3Y1FnRWl5tjyxd-w3YvcsE6FQWeY3Q_Pa2GoTCqyW5ZY2ccxr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOGu0RuGNNP9Ts3sk5apmacsdP5Qp40YCk6EcDHqdppQ&oe=6AE75747"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ncE-wYm8DYQ7kNvwGqm7IE&_nc_oc=Adp6jY4uu_SB9nKF5nArw9weU2N2gqIDnJD7lKmNATMQP0Kuwh9RYoa3lBaIPuRK-Ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMcJW19crkJMjgdJ5iAMzGXHJjHfxJkFFpdRuU_84nsw&oe=6AE7700B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjDTcgCwA4sQ7kNvwEU2aqB&_nc_oc=Adptp-urOCfx7sn68HKIuobZyqJy1Di-SErS0yS_HYVgqVD68gEutbX1XFevVTYy8wA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ9c9v66GIZqv5U_9d0YQVQ1FAG5HeL4diYah2IR2ZzQ&oe=6AE75314"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9pRfn5yp94Q7kNvwH9FEao&_nc_oc=AdruqbhnYWIr2mLbaV98NrIxjmQxbo4HN_PmEsRI-1OWO3uMwnAbI1nZzvfz4It2jz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxsZluW7XbPFXKpE4WqfTxzQz5SVRdEW03Jsw0LkaftQ&oe=6AE7558A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXpTUcKTVgMQ7kNvwGta4Cl&_nc_oc=Adoo_L052rNM5HowL4g8fsX5MfqlH7ir5oPJiE6vevo48gVkkompWIvQ_xdn4kB7B-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvjRdHB3mxuVDOI2wNtihsPX0jBgMILoMZBexBXxMIig&oe=6AE74582"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
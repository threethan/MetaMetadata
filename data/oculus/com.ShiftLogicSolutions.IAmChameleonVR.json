://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAU6JlrzUZ8Q7kNvwGdNth9&_nc_oc=AdogVE5NyS6o3PwolsR3YBC18uX5Xqw5_24fV6gsNeMZElTGRQ6V300RkkgUYw_xN8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa-eFpmIWeXU1SOgC8ecKsEWc8a0Ra_aOyDf2WpvThjQ&oe=6AB278C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6RImCfHznEQ7kNvwEJingf&_nc_oc=AdoZQz-VHu04cj8r5EWB49tsTjpCVcidCS5NeObSmP-scHcHO8MSvXKRc_DS6xS0FGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFRwvyLqkjg8D0dcBTnE0i4fXVHzs0KdetQlAyuZHQ2g&oe=6AB29B47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu-RyDT-0tQQ7kNvwGx__d2&_nc_oc=AdqgBsSxqEPUCLRmoIQsIrW03T4KfYgw-emTImVBNSJSDluksZkiKNNX-oVbGz1uvhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9KBfBDegSKgjj7i94BS-_d4G3iz3zR993qL5DCEJKwA&oe=6AB27BCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpgJiAABZIcQ7kNvwGeFESG&_nc_oc=Adrjirsx_TPQsYHL22Qa6yQiE34DkOrOxhxS1KOGrENMduY4FTbPk01itZXERtChKSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbyChQX-SH_cL15m53SfFpyecTOih308x-2Izwy8kSQw&oe=6AB29714"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn-L8eP4RvcQ7kNvwGUad0T&_nc_oc=AdrN_X5IKFqBGC7ORURvYF-GCx0UZfE7f0Iv-KqI2EGK-hDs-XsS-DDGvIjMDanSKdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5oi4Ot4RdiZAnEzoV6eH-c5kOgHh_ZpABhRA22CUymw&oe=6AB2998A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzhy1zBUoWgQ7kNvwGblAad&_nc_oc=AdqdvY9lU3jkGFNItsw63Hgad6nXpADGHcC4RRkXZNgxogT2_MRnjQ4zf2ft7s5wfjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK0PtUqKsbBIWEg3BkDhnnmhOLzu2yDth9Um-GOSrHJg&oe=6AB28982"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa1hlQSa1VAQ7kNvwG8U94x&_nc_oc=Adp0x2o76erCXog4hLj-_4owc4AXFpU0RPeaRtpGuecNBXx3cJF-eEwO2oLkmJf2qnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7BA9_oedmi6Ps3pfQ61Gn5Rkv89vNsZtv5z-g5LQUgA&oe=6AAA8FC1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-eDjc_JjUIQ7kNvwHVYZ5H&_nc_oc=AdoZ2Inmg-xKG1lWBNI3qVp9BQFlgTpbUcfe_RvxA4QK2QNBvUKOzIQDBnXWAtEDwwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNQ_HZnWtuCHCDGFJBiXoHo1gHSLOgXIYDrmUvmVbf3A&oe=6AAAB247"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz7V7XyLZC8Q7kNvwEQbp8d&_nc_oc=Adp20PQYMITKqFo5prVSmUAwMnQzcwrWvd2KwkpK-vNNnkuzKqxahsraiYPtdr3oCSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJNtuyeRQu1yupR902ErRi2ZlwZ6Ipg1k3rZEfwrGKww&oe=6AAA92CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2bHe6BrojIQ7kNvwGEQKc8&_nc_oc=Adpvxngmay7p8Iv5jt9ICP--9vJvWV--fxROfGGYXyRezUnJ19MJucl2bywT7dKILyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7D80d9gWyovntNxEI1RkoiQy9Ghag_GQEBvo6POZx1A&oe=6AAAAE14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciCdS87xWkQ7kNvwEl6bwi&_nc_oc=Adpb9cP6bqdggcERIru97931rI4tzCkwRONw19OoDOZifvfgc-npqtilqUWVSvPf9RA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJltH3O1NxqsKRc0L9H3WGO6f8BQmFvUsmxoMaAHZcnAw&oe=6AAAB08A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUL8UMvjkcgQ7kNvwE3EX4q&_nc_oc=Adr1cjY17U3IizdFqKt0rmS4eGIlgTNi--UanwdgkJQ9YBMI81I9hMhiO-KRhgPhoec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJte83Q3uo5wFcarpkC5_Ae9-3VfYtNzf8RVSl4FsHYog&oe=6AAAA082"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruK3k90bc1wQ7kNvwHz_twG&_nc_oc=AdpOELckD7QUatgc7PVO4kLKCMuL0LAtjI6pZ9FaJ0jw-tY0KDsO2G8ucPrn2OX7aTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAa2ErRii1r1oSdMiYFo1LUvxMloOHBctt200VkEMN4A&oe=6AAFD5C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch7-Pu-FXfsQ7kNvwFOL6sW&_nc_oc=AdqWN6guGoRQiDCJS3PWrQzXhyfRnUHEFfq3YaY-ELzyCACmwX-nDZJNdCos0QkIETM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgMwUDahdl1R0XkZMfpPPYgWr4bSQOXygr76a_ud9jFg&oe=6AAFF847"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zr4WT8kn4wQ7kNvwHrVBcK&_nc_oc=AdoNIf1Y9YPXcENlZO6Q-LjH05UOsNWyf6LRavsXCsDUpWUxTw5jz9xP1NHKYSyt8eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuqKDC6_4qgMcK7KwZlpsEelt7BcNmw72gJGBX2veBUA&oe=6AAFD8CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlHsHpWA1yUQ7kNvwHZMTpV&_nc_oc=AdrqWACfXaWNpznit9k9-owI1gB-fw3geJ2_veO_1P_oDkdGaKJTRb1JBXVt0rU-xdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnB7n_PgTY1sj3QSed2t2mGkzTN3yhnPY9f7eG4OsdUQ&oe=6AAFF414"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pfvwWiCk_AQ7kNvwE_cQeI&_nc_oc=AdqgydkdppOpHXcqkx7iq2Sqk4KvzNFlhMeRkbEKz0sAvhxTeQyw-6-KWenwKg5r0cA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIWI5N8c7WtqE4zFUMTmxqEQB-cEntncyQdF0y1AMEHQ&oe=6AAFF68A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzhy1zBUoWgQ7kNvwEdsKFv&_nc_oc=Adq7LwwbW9A9PWC9MjQkSWLxKn31JbKRSHlslfMTbD8lj3pvsqcatqFb4a2MrlvXNKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdzjKcPSEGCLWDdel0c-kO_6IIFok4-zkYNnCdZbFrNA&oe=6AAFE682"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
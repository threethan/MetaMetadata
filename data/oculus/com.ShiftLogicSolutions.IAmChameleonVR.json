://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtPv19UAWpEQ7kNvwFMqkOT&_nc_oc=Adri7_N6wwU7DRhyyefTmbVnJaSyMNec_blVL5vWixADG-6jEluumShChpkimPQ0mD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIREzw3H0zgw4M41K1TpaeKq2xqMVcLdklOAIZdZhSsAg&oe=6AA69B41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVvwLnSK13IQ7kNvwF-hK9t&_nc_oc=AdqqTBH0hEkQmpYRk9gKgtd3Ffs6zQHpAN-w77nF2AUiBMQ0LK2xsiJA29qSFxsi5Ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdZN7lfXrfYkdUHPoRJrztUbh4QDQpi1PB75oKqZ_H7A&oe=6AA6BDC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVgkDi0eKUcQ7kNvwGK_F57&_nc_oc=AdrZbutIx9Po80ILD_uhLpy1RIDqdDn7ltIgQ-cqQBMG-iMUjeonOcCLK4DcPuc4PuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY5hXD1NrFj0ojVT5IQge116Tg66hgp_JdqWYBJ-uYGQ&oe=6AA69E4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU-9UT3F2C4Q7kNvwF5g7cw&_nc_oc=Adq5FHHWFdRozmkL5sgfzGX6dnfxudeA4ZnpOfBiYzUuQ_anjiVck2ydLUPX5vRR1BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu9aKrNE0b7MqVj_eIJLonmx-2T5cdhbN5XMcjuyUsCw&oe=6AA6B994"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vunky54ll7QQ7kNvwGPRK2E&_nc_oc=Adrs0Q6uultVL4Wgd7VcBU4ZTibKmcD-4HS16MGgHMXrtJBelM7iXyilp8KLmBVgm5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfEni0FIXGLOAt4Be-VBGt8_Hf9DYA7ZrS4xOO-aulaw&oe=6AA6BC0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0VRm8xtZlQQ7kNvwHFV9by&_nc_oc=Adq34ed_wxnZwjd6Sxhn3MolRhO6np6oiUvAV0_LbZ8L32uLIWmZ20qDgSyyMWcusW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-_8PnqdeAZ0HHvKTgZSe-uxVp3jE9euewpkCOlpOcYA&oe=6AA6AC02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
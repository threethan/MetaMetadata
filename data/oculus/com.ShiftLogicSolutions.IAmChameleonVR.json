://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYMJ2N4D1DUQ7kNvwFNgQL9&_nc_oc=Adpc19_LKYgkHoKF0FKwGekJP9QcWiJhRi0ImTAB3usFDcfSh1plC2TikNV1g-dZVRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRe3ESX_JugMNcaJAjW4QxpXrOTFRQqoCj8mLChM8bEg&oe=6ABA61C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kDOCBZ6aqAQ7kNvwGNDMBD&_nc_oc=AdprCjye5QzcqCpeOA9J16zk3T2hlIzvygjwU0kyXQ3pVhyuPu9lZGvkkgnufjFx3kQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAtb37ROzVHxg6m4z9XKuBlNUC_5g1kr6B9MbkYHoV0g&oe=6ABA8447"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqExygtRJ8Q7kNvwEt4hYP&_nc_oc=Ado1oOLJK0OdQ0eOT936rQoYf2e15bqETNoJ51DRDAMF-02-2FdrrYsmO8eVHfJ-gJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuiy2SFg4QOgY_VPBWD2Fl-Bknzx2RFpniWKfmQmNc4Q&oe=6ABA64CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWBMJpWTU_UQ7kNvwFVzNiK&_nc_oc=AdrWbhg48OTirbRjcEujMFpE9Ty5M6NAhUZj3c4d_iijxr8-OaI-BjzQCSYOidHWWEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlPH_QI9DKNtmMH8CifSGHQz5BqR0tdj0aYpVI1ZlzoA&oe=6ABA8014"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRUAhBVmwBgQ7kNvwGFAqWp&_nc_oc=AdrJqVB34l366BvmMEXBxVOXgJCv-R056AO9Naco1R8PHeUvm3GHUPzuQDA1U47cQuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX9vCg2bUvRSuObdScvZ7Ium2sPHKIFhWHk60gjuqHdw&oe=6ABA828A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGHBQv7Xev4Q7kNvwHOvzHC&_nc_oc=AdpPkTqf8sP1_N2TynUC0nYJr6qbfQfzKjSM5nAnOxBf36nTU5Lg3JFIsCw_O28zAr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaGPh02vA0InVCD8rtORAn2976xCedIIHsDkU_1RBVIg&oe=6ABA7282"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
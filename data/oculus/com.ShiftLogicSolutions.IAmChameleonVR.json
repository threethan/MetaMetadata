://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxbqrNh1QUMQ7kNvwFcPpRF&_nc_oc=Adr52vMeel_H_ouc2EzkD4nEvmJcTd_rN-UPRHHVmw6G70ABIlN3OcOKNzj9MEScWB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-h9LYTyOM50w9HDZ_-68x36E4amRDi7XzoFYTzX9ROg&oe=6AC7C901"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koiz6oXa3zwQ7kNvwHX1HRz&_nc_oc=AdoT0YUR3o-w9XtXvsx_ch9Jp2iGBXB1D0iQAhN-CJFNzkGz4RQDnLpGjwWhL5yNQ1U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBYKn6iJXvedzuuUeEs0sURAna8NbszVTIJt6QVtyW7A&oe=6AC7B347"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noJJB8KwWMIQ7kNvwFg7y44&_nc_oc=AdoQcW4krkXpUaKnycP8naDTrbmdeKfoq4bISmgXnM-8avBwKi6vX7k4UxIE91UfXt4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVDHemdmLGL28oaPV4c1Yu4iTZxx2SCqoByaJQgwZegA&oe=6AC7CC0B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayRsos7ZrXoQ7kNvwGaX2kQ&_nc_oc=AdqjfgSXYDEzOzQPd93D5vQMO_jJTlKl-i549Ln2y2Nzd6O6WFZHqA_h9HPu2RuQ3jA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0loWO6i6DixCp_-9dIGez24t4pZA9MT9PHBPMoku6-Q&oe=6AC7AF14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PnaOi8G8_8Q7kNvwF5TsFJ&_nc_oc=AdqYL_h74eQptNKw-KhLM_0w9jPoAj2JjtOeJBC1-wZYkoMjxSdHAcHCrFbGOi_plAo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1NlPh_5bCUjhYD1HG6hgZk_g9rsg4VO6zkcbC3qHkfw&oe=6AC7B18A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alhiA7RiYL4Q7kNvwFLQpk_&_nc_oc=AdqOrTznDI5A7JL3srUHpKGn1J-xn2Yxo_cKaKFmvNXlk3NP01BGh862yIF0LuB5Fy4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHXAJjK4LdKhvov_ZlOS6x7IQ7_f8RKaVzDvXbdghyZQ&oe=6AC7A182"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
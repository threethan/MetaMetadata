 "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZLCRISaSR0Q7kNvwEUi1SY&_nc_oc=Adp-1BIYEAvQZCclfid04rGKnlfLnL5MmNDV_jPqrYssALyDCUAQXSzSYvyppA1BUy0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbsbt2kGnVpKBVIM3rz3b-lgmfc51AAm-x47yiPxFCjg&oe=6A8EE041"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fiddlJ7mosQ7kNvwEaoYNm&_nc_oc=AdrW7-ChEO_BDxBZnGtIxyQdNNlYtJG6uYj8DwqEURlEH1HxyhUU113Sfx-Rj4W9vI0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXAfp4jbBmUlAV2Dyiaac3QkDPUfOZWp8Cvzzx3HT3TA&oe=6A8ECA87"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GWcuebXiEwQ7kNvwFXr18z&_nc_oc=AdoX1Lcazq0WyqQRTl_WjY9INE6Clr9hhcr9e9QklFZjRyoQg5YmEhs76vFKssysjFI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfRqrzHxSwhY0s5hRvSpWI2LKIY5EIelCuP3Prb9xC_Q&oe=6A8EE34B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkwoGWTsVPAQ7kNvwGBE-my&_nc_oc=AdqKfG89wjZEa7hmp0IdzgKndybJjCQbRViG4FSMEqp-L_lL-P6fSDJcdjZPMKGLXm8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdF8x6qV7Ny6G2i1Jaq7U5hJU2HOxgzKKBsmUxZ_Ck-w&oe=6A8EC654"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP6uYaul9swQ7kNvwE5Uo5e&_nc_oc=Adp4GDIjLriHw7Qaolztz_SbeC_bXOgk-y1RfFnzsyPqsbgSBLsmnDw7dpt5Z-91610&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5-oadUgjCuNPT-aAqQT_Ix5hyz7wODK-vrS0Tv30HrQ&oe=6A8EC8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItsSW9U9VQIQ7kNvwHvt_GZ&_nc_oc=AdrmvjSw3-lkwqFiAoeeS7iD_Bc1c3X6XZw-zchxuAdgJFsZ-WvMKllc8ZUSlPdLrCM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHppkzfRgKEmBxb-OjvuKfp2TSl3VpdWJ14ZRq4u8UWYw&oe=6A8EF102"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": "https://discord.gg/iamchameleon", "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1245579761969258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/595112037_2235777820552704_5090708819474035322_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy7rrzXK0acQ7kNvwE81Qj1&_nc_oc=AdoiviUfyYKzK4zcG6q-22nyf7_T0htAfhNJs31IRagdn2YYLuyFq2bCPcK663VZYG8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9In32_dfY5avzUt0n26X1qD5l0SZQWEEcZxPtuwolmA&oe=6A8EC8A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Chameleon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action",
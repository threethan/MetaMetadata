://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2_WfB4pb4Q7kNvwECVTNq&_nc_oc=AdoI1nAE_Imw7uT1V0zNSiBrDc9EWVyA8QGf9VQjhcqtjKAxVeRRFy7ZdBeii5ovmpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY4S1Ppx1fUkXgmpzoJv3s08ZyoqwQkQRih_PCw7rFgg&oe=6AEF5601"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gPo2cdKzbQQ7kNvwFqA2lm&_nc_oc=AdqI3SVvPG4sHHdFonYmRnTUzY74mWhNxUeii5hgGH37VDx4qoFqHimcKbBwHiNHkcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScMuYaftEMTOQ1JFoeRAn2C0TM9UnFbPlKMnVihnq20A&oe=6AEF4047"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1wS3LAXEl4Q7kNvwEohf11&_nc_oc=Adp2WnLsUI7nQp1cuoK6IRqlSYh7BN5MBd1o_Q9cZjXOIflgv3SdUXlPIPxWv_NSOv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi95hcnc13necS29dkWZ-uA-AnrdkQWUGVHrpjtDrI4A&oe=6AEF590B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brHtlg_tbp8Q7kNvwGtHTu0&_nc_oc=AdrCe2pZ-81kmqm2ieoYoSEEEuCXdBn5oVREh1lXeu3hEPLEW8JGVCSPD4sFs5PIElg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtL-EkjYmqoad3eLL6nQvHIwMTe141kcmHtSP1bh3O8w&oe=6AEF3C14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTyC16rcbMsQ7kNvwHgvjyX&_nc_oc=AdrB_B9DVi-rNmMCCFa-iujEFsEFPXB1fjDM5sb2uDgn5m6CQ5rq7Lv53DH756tJWGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtZxZCAdxurEL-rurZnbccXcXHKMaGy3TmZK2kgwRNoQ&oe=6AEF3E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4B-oEk_xAUQ7kNvwHYf0xx&_nc_oc=AdozU_pT5RrceZ_QmY6NJm4Q2JbekP5hkJ03KAx_CtrzJFeTEvEQkTX0S9gL817ZS4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIWz8UYCyZ0hfEMW370lxqh3IXsUpkXczFsdLI0TQRSg&oe=6AEF66C2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
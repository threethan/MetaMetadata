://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa5QgLPRkjMQ7kNvwF9KRaZ&_nc_oc=AdofLQ4SUjPUBTRb7EqCmuyDx06a0bEMQK2aqMiRXNhmfjaXGZXOelomdOep4wlAp78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp7HlrpwQveWLp2bWoyzLawtWLTKaeBAAWPpr8C_cw2g&oe=6AD10381"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUQsVeYzDCsQ7kNvwEYzp4i&_nc_oc=Adro2w4dCx7obKBNrGi6HCsrA1Xw606Vk18PALaX1z04Zk2bUCMY5FvPIcqJT6cO0dg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0SPf6NUSo4ekHFpDMDFCDpOW9DQjcBgauebLcpKL50A&oe=6AD0EDC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsWWhY2PIlMQ7kNvwEiHQQb&_nc_oc=Adq6BBw_kOLFmTkUgVx_6E8E56mP4cXUvrs7yOkWuJLms_0LrnkOcGvxAYgugxphE8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlcRgOJ2UJcPNXFxUeC6dj_RNF5OZ6rH1k_Ng3VSzDVg&oe=6AD1068B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaNimfLwFKoQ7kNvwHC95py&_nc_oc=AdoIFNSVeDjpFpZhVlMgJDIluiWTbHqh5AP_qtVQF9lXvDYfT9vrCHpf-GOe1YDcn8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwXzPfcdsEHgkhgwFtUx5_bsyV3MtIjq3aLIcyQ7Fg9w&oe=6AD0E994"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhBqs-suQ94Q7kNvwHdBN7j&_nc_oc=AdpjSs-eBt7Rfsla8P_VYTWdYkTgUOSbHiSfSIGesOt_wLFDBcsjEuImYkzMQrrAPFs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND5CR2iybuMUZdLn1eKYy5I1fy9aZqqBFdJO3_0CDwtQ&oe=6AD0EC0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2TG1skE7VEQ7kNvwGpIRlD&_nc_oc=AdqSrvLLLrNcgivKgxkaj8S7e-hVAl5LYTAG8jIoRM7Oxo7YJ45_hyWL92iTN5OGS2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVDovSkhQnLFhhZBE7rAbo3Prajpz3KTJORjyAEAMAuA&oe=6AD0DC02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t0zSobuU_sQ7kNvwEHa4zz&_nc_oc=Ado-WAS4p9dEwaqu_-SgTv4mVqYsMFJJFxDzjoGuFGvr0Usvszze6B6Y8BKadgfrxPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc0C6CB6oDzUedsz_UEQ6iCIpFmILQb2bG-SwgCtDgJA&oe=6AC28301"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afNB0d1z61EQ7kNvwE8dYps&_nc_oc=Ado1UVUQMQh8mcdRHBBkPu2rFbEqjFK9ml_g2R_htJIcUZZAQP04MWrINZqlYxotG3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdw-LwW5Gtb_zOmBowqeljgA229bgVezQi13yDD4GtGw&oe=6AC26D47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8b7vyLA78sQ7kNvwGLbl77&_nc_oc=Ado7m7cuCRW5LxuWrhPqReiqBS88-VHrewEgEAjqViIhrgo4kOpC3aBU5RQp_k38ArU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBFO8UexU-1DeN43N3Wvuaw5GjsuLwE5398TEzLiNSkw&oe=6AC24DCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu55P2mMsRAQ7kNvwEpmgnm&_nc_oc=AdokhczrRwWK6c2_2yB5Ndd5FqOhj_l4vk8KyKiHd2HqhNh-Mw1X0ntFJfPVu1vHcWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWjRaOEpEl7cKfEk4L-ql6rYm12DMWE-ydIqI-3MKqUQ&oe=6AC26914"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f1ZKZa8VvIQ7kNvwGp4tct&_nc_oc=AdrjaMjqA_HTWGxtpHlkLOocaW4NIPg5oiDH4vjTXjZWPk9lRxa7Ycl-jJ3VeF3ugPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN953PTRdycDBAiS_oQANcoFIrXay8V36k2htpRl6W8sw&oe=6AC26B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJwhGMtGhG4Q7kNvwEDMSSW&_nc_oc=Adqk5rOm8p7slNZCymumvv2nkuqAyB-67gu_GIbEdo9_kBcQchgmTTDAJsF_bS12XeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkIQfOa7QR5-ffZBKfCnJnvJkVMzMvLb3FgvInx-oshA&oe=6AC25B82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnhTa7XLYGsQ7kNvwEUhVvB&_nc_oc=AdqE_BSNhHYsDnJBeAY_L9PeVQ1lxIWMazjB6Q8BGZB9vD4hfpqkwgq2_BLmD-K2UwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsUxpCG-2b7bWdQrVxC6i3Puyc8Lvmz4vXs7biwhAdXA&oe=6A996C41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaCxGdFUaAQ7kNvwFjbHkd&_nc_oc=AdqpSNBKj-3Qi72djzQfsyZW_xLSYSgc9JD0T4_IJ49OqK7yIJGsllroNuL2R48dfsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSZeZ7ar-cz3mV4k5zUwJsd_cp2vdNJZpRZz5fDN1fIA&oe=6A998EC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOyfG46iS4QQ7kNvwHRQWBE&_nc_oc=AdoPq23QggbgKNVIf7ldVaUM9H1F80Hfrcvj6hDfkaYWjolTxP6Xo06r1UtEe08HJdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrhHce_346g2aki1l-efLweAZQEyPE3k1380Fu_7mXXw&oe=6A996F4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN2EXRyu3VoQ7kNvwHkrZKq&_nc_oc=AdoqdwQ0lNWPe6E0NyS0X5OoSPEbdItOxwy2v9aNdVRoSOgBbGivx1Rzj_KIPhFRFQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZihEH4bjhDhMnNVhv8lpNqcg88kzBZ5YEKBzceo4iQw&oe=6A998A94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O88RTj3ehXUQ7kNvwFy1F0c&_nc_oc=Ado3x5tcZdkXzujXa6LaUsp2yjms_V4AOxUuxPE6-5yjdliu2QEyYH17RxVxWnJWNjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGwyRaDONo0zJsSvPJpd0FQeGUnV0IJx5TDA3hAxgHIw&oe=6A998D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKymze1cLOgQ7kNvwGbDB68&_nc_oc=AdohazmNSt_qMbf-xdum1xoK-VNLTWmRqNpVtCQFmZiLnaDPqZC8usE6zY4Pga9eIN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-tNb2RFJDPmkuUCQqGD4oF8p26JHZZbZojvDHL_n3cA&oe=6A997D02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
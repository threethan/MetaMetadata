://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF0nLUKy5b0Q7kNvwECkool&_nc_oc=AdqS-e_QBBk30YAVLFiuZRmtla71CvN36_NmTovNOkYej2hthGmtx6qxlc7HVlWIkvs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuttNl8HpNBhQGyHAdaO7ktL5Is53vmFDhw68KOP4f8g&oe=6A918341"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EFYrwrB76IQ7kNvwHP8b1T&_nc_oc=AdqZH6_pjtq50Ub-JAtKAQrY9GPv0AsOGGrPLFUC8RaltCUeNqffF6Ayqm3uyXoP1Lc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFppTsO51QcG_5zbFKqzOmtuaooFDX-43C1jqK-KvUiPg&oe=6A916D87"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqscfBAET2QQ7kNvwF4XUQu&_nc_oc=AdoLlAEYshnZzh--Y3p01iznSOlmr__qU59vuNLq3TfvZzsnbIHKu47iAgGrW0PRtpw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5ecHZZBCvRwSJyDIAE-Z7dAjyewjO2jOg3B4apjptcw&oe=6A91864B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNrD4WncFygQ7kNvwGu63so&_nc_oc=AdoZ0-64Q2IWYUvdZ_B-sIIkAzdHgVzrFO-loJoRFViuJX0UXE-uv7dmAHLypOjLHYg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHILvuJKCQHPYIpx9lauaoDcceiS93N50P3NYNPGSGMOg&oe=6A916954"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP6uYaul9swQ7kNvwHucRMb&_nc_oc=AdpqwOqGhapKQvOeN0AzlfsTZjt-fomoPua5-bupNoKRkYcFvGgy-Kl2TmXMSVnWSEA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjGgrsTwMgwo2oZ7BGioaYONaTkhzTgMPyhG6tdL2WgA&oe=6A916BCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3q3SEjzEWcQ7kNvwEVsEK4&_nc_oc=AdqNwLCXWFdw1gdq--PCa6rp1mv_WwewAc6yHWtmNwx3DHPoTt9Apj28Ah2uXIzeqK0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExZg8NkPFjYHHfikcEyNsNK9srH90lc1a3qOqEhz1e0Q&oe=6A915BC2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=habNTEc7fLsQ7kNvwEGlvoh&_nc_oc=AdormJ_cBXhglZQ0BvVdg5FUE4S6RyCpj0b5kYmcTcp5dFpj5zqmKQ-3IJRd2LqF4CM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzY9ALN6u4w6WKrsO48EUWubkmUFUV1C7ea4eyR4lv9w&oe=6AE1EEC1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKjmldSj7mMQ7kNvwFeD8gP&_nc_oc=AdpKMnuXJKzlX7-HZ03ZjdrWgkrQaz4Qi3mjI8U4PGvMh-VOC98OrI2sTFMwjz2-Ogc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHf_-jpLNeVpnvZ-cztqP4UaRBNt1-SbfTO0Qw6mbi-A&oe=6AE21147"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLv6tzCJF8kQ7kNvwGbMwOT&_nc_oc=Adoi4iQz7ednMSbvuLODqIZY_LuxgS6CtWl_8_7qSRs0EPilvk1SsGfIaHlTW6YwlWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnFxCzSFvqRjZ1DAMWh7Or4JwAL-F8kUh-tpX-fGEy-Q&oe=6AE1F1CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZUFj3HBEIMQ7kNvwEfludq&_nc_oc=AdpvmYU_A5z4Czn0kFVGW4REgl9fBRv8KLFYXhbO5yok0lSzkF-BUQ0n9Kb9WStNuvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUe3J0-GA3CUrxnLafyBeKIhO5P3yruAu_8GpeX32uEw&oe=6AE20D14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAdFacjJM8QQ7kNvwGvIMj4&_nc_oc=AdprWlseqK18mdDvTTfrc9k_cjdY6XgbREDan_Wk50OXt44gTOsYZ2RQ6urK5vcM4L8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN923cBuc43MLttprNmf6mwTabIbaU7CRAqwj8llMBLdw&oe=6AE20F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSObJ0c5kKwQ7kNvwEsg2S3&_nc_oc=Ado__eOoHNjp72sX_RGZq7S7PhA5xWCCmy0aOkou87TzTrIxJ-LPeKtcB4BpyLU1WBU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6DXe8xRtVr5N1kzMX3WMtrI4q-aB8uavbMN3IJnO4sg&oe=6AE1FF82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
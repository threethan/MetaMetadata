://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAU6JlrzUZ8Q7kNvwGi4eoG&_nc_oc=AdruB3QXCWW__V_tzpDrnDfdQYLyKbVOmd3dCd3tPhONA5OFusAXgcWq27dcvPObZ7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhu54lkpLDnq-ALMLqhV69VPgllJoRSsezcSPc15JsyA&oe=6AB12741"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6RImCfHznEQ7kNvwHgwqFF&_nc_oc=AdqUJZizwOpA5s6yfvVk7RMfWFChI6078_H1ouAoHZAvkiGA9PZeBCdlMjSPKMmCMKc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs9BasAnrvqLnp5p2Xdm_0OdiZ_FRlx_IicySpo8ILfw&oe=6AB149C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu-RyDT-0tQQ7kNvwGwYRti&_nc_oc=Adqim7A_dyrXtov4dIMBGvBXPccH3IahfAW2jtdZCxR4uJk7je3xa7q-G6eVhRtBWXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTyqoaCxF-s9nYxQqPeyZ-MfghRav7iOGy-t1mWFws2w&oe=6AB12A4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpgJiAABZIcQ7kNvwHZkmmS&_nc_oc=AdpXEv0UUcLGM-FDSeOJpZuDCr_YqbUee-y0AX4upxJgHggpugB2BC0v7I-2PL7R7kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV9547nbwpnBwODL2bMSST1w2E25oYpcrwJM-DOhbnKQ&oe=6AB14594"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pfvwWiCk_AQ7kNvwEfiUG6&_nc_oc=Adqd9wRT6RLFC7dUQqWMkO1bLpkO-s5kbdimxuN8x7EJsMJ7pEozUOGRwo3yzk9AaWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-78fWrV1ofms0RKSw7R9zTJphV2Tz-arseklcTJSokw&oe=6AB1480A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzhy1zBUoWgQ7kNvwFfpn39&_nc_oc=Adpt5huj4iY-9O5yhELiN_-JqAb69FN76HYo1tmK3i0TqcveTJ9fqIuaaaTI7gKyPHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw-Uoqmr_eZrZ_-wjSwfqbKFsV7bCY-DxsmiHXi1yXOQ&oe=6AB13802"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
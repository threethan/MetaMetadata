://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4CFlwN9zIgQ7kNvwEwxIyt&_nc_oc=AdqPKzJyrxe_EbJg4m4qkgZFOOG7oKKw_X578Rb1KI12Ctn74aRST9sZgguO7I46PvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWIfH1vk01TrYsUIBwFG96Kl1LjMDEYGHO7TlwPWLpCQ&oe=6AF73F01"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb7YYdD6NjYQ7kNvwFN5gos&_nc_oc=AdoQ98yBT6AqauQ8bDGuRjX1HBrLn256rIMWTHF-cDvrR8ZCjayUuye1T7aTm1TluRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQZqsr4kl-JVO3FwBUMqK15Kys-oC7ytmXl7GlCcw_bw&oe=6AF72947"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrWpQxxImfoQ7kNvwFkg5MJ&_nc_oc=AdpAIrqa6KeiHBG_evGDAeUu6G7WhKat8LlyC9oVOCrmc12uBWj5y9-c2U6MX_YH8Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWI-tC3vdicF0-rIGDKLxNHe-cOCPPLQ3ZUdxZzrENDA&oe=6AF7420B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz3_5AIcrLQQ7kNvwFytobZ&_nc_oc=AdqmuE0-GhwS_WAPfT17MAyXAxm3G1XiD2_fNoHsM2WEgrxJlMSZE_5x8n25xYHoqls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwtm1_RDTPjC8ybi8ZH0j3rhFcl1kPxJAHPlN7FuhLWQ&oe=6AF72514"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKbUyj-AJ4oQ7kNvwHlTZ_m&_nc_oc=Adq6HVAIuWBJ3mJwy_MDfqkslJb9GDTe6jEkpUoJ0mR9N8gPEGdrcZLEZeHKeSPQFbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1eTbIUhqCv-AmujlQzQaoLBWQm97xeiMQ5dg0sfZK4Q&oe=6AF7278A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_lbPmIwHToQ7kNvwEHvhTJ&_nc_oc=AdqZWouf86E8jtheNvGgnv4PrRCuHAGgOr6TXlS6V42NYEl0Mq5TmejLa7TGGmh7GwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScnOc8oISbcoWT2CEiLemsvJVJq_35zYG69R3tijYgqQ&oe=6AF71782"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2_WfB4pb4Q7kNvwHsj4w6&_nc_oc=AdqRBVD5Am92ScA9tT4zH6x6M5s3uRUgui4MUzmzGdJyI-fTLS7HVyfCRcTLi5IL4u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU05F6h_rXuD29ilYtwGe-UbTS1E1JJeOp1yA-rReihA&oe=6AEE0481"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gPo2cdKzbQQ7kNvwHH0XrK&_nc_oc=Adog5I6Ck-IAb7iRR1AibVZ96e7T4SJWsfcTmd5Ixz6U_3VGQHW8Sm4cJZMg8eQDdvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKiwo1uB47dZgQL5_ccxjwROh3k_TOzN-yK-v_mGG-NQ&oe=6AEDEEC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1wS3LAXEl4Q7kNvwEER5AK&_nc_oc=AdpTWTW6xZgqakFXCC0_wwJ3gfLvElB1yr3b4WOvx_xdgtt_HA3_RWodACFu5RnPpEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbaRjARFTYLPViFz1xsFuGxZqMsnTdQF4thA2TWmvEWQ&oe=6AEE078B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brHtlg_tbp8Q7kNvwGCWg74&_nc_oc=Ado_dGgHb7lYTws4VV8-Z02Pe6CtDX0KxwTjaS_3tRhfNh6pOUvfHrp8LG_vuJMDPo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Kq5QWTDOba-EymFUhwJT8lAPp4MV-mH0YrBhDfwMXQ&oe=6AEDEA94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTyC16rcbMsQ7kNvwFFpd6g&_nc_oc=Adr7TeiuRtq1B9NBf287lx-_0KAiumhtGKSe8PJ7fAZrZre26_a-C0FMx_w_oJfD_iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_WeABEC_6T5dYifLGvlDBzHrznKJRIXPrNK-ioFMyPQ&oe=6AEDED0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLGWrpEFLZcQ7kNvwGmBXbA&_nc_oc=AdpTGVwgMZt8VrZBnJxfb7ZLf06uDsPxkXDl2CxLBfoVEBd6r5JpJpjID4KjfpHfGlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8nRhOS_Dc3gU2MAKMWaezNrYV2BZcjwZbKezAOAHXWA&oe=6AEDDD02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtPv19UAWpEQ7kNvwHG6zSv&_nc_oc=AdqVCEos7_kWORNN45MEGCUZ8W4u24U1keslAa9XSegWuvK1s3W0tFQXIrutLuI78A0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvumKgFOU488KTW5IdbpG2HWVLGG_GViWgWldMO5LQdg&oe=6AA549C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVvwLnSK13IQ7kNvwEgiMcL&_nc_oc=AdpoOiMyC2tNtj5GJEq3HotY2T89uRDwm49N3k__wDNABnk4-dp1lAZ651zHcHWJP_Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq9bIqWyE0B1wUkk5tIhPkxqszrGytktlvyvs17ahE_g&oe=6AA56C47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVgkDi0eKUcQ7kNvwGjakpN&_nc_oc=Adov6BK-_a87WlUHtvwDxUndL6Dl9Ohoj3qhmc9DHdNT10TbL2ENrGYazveJUmJC5B8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1keJ9Fynd4iS5ZoCCeTCV8Rka872OgkPMqM_NhWoyhg&oe=6AA54CCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU-9UT3F2C4Q7kNvwGhWA48&_nc_oc=AdrD1rqwcn55ngtpoBCvUQxwOIoi221AacufR9pI7e5Oq2UpfBpYGFoXm4pEBR2eITg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjTFAParFfzRWBALFmLU8_zMg3YR9K3EretjfBYtViMg&oe=6AA56814"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNSe1Fcyr0cQ7kNvwH90Am1&_nc_oc=AdprhzSIa-aRcIzQ6fQKcZMyXA5o52YdbR13cLbqLPA902ulSyZYXwWFbU-AWFlUaJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_05K7iF27NflMINhSPCJfxoL6Gmu_9srRJBN4vRGG5Q&oe=6AA56A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0VRm8xtZlQQ7kNvwHLOeW2&_nc_oc=Adon8F0MxzaibzCY8NRevCyfOHuLRepFXnpKEGZjeAo3_fk6RacUgEl130Q-ry2qSyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV1OIjOA83lv397bJ_m-a1IoSQMSDiMiGmVDBKRBPq-A&oe=6AA55A82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
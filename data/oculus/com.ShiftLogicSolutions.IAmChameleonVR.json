://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t0zSobuU_sQ7kNvwFdx55M&_nc_oc=AdqYzPncwlRKP9iEh0sw2cyy-im2Y-xrv-JzF0CWFMjs4qoq1sXz7RBMLGwOCXJTgvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3LP4tHqACh_1cDmWa3wfr0Gz4XIzrp7VfnA3Plg4zCA&oe=6AC3D481"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afNB0d1z61EQ7kNvwEjgDmR&_nc_oc=Adq3EDI5jkryKfCrpnqEimrKvx4oI2uliNUETgJigV2DErRHBNWd6sztpsDbDKhwyJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWzhAZUHwZ2QXzySo4NzqKq0535R3Png4rWmG3ZEuwlQ&oe=6AC3BEC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8b7vyLA78sQ7kNvwGo86IS&_nc_oc=AdojuLlsFrXI8Kr8r1PMIM-AdGDGmzvM5JT2MCf23Gzx0fvo3dvE-3zRK2tP0aT10UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIPh3FrNsaFJBSjHGXu2v_YUR1KjCvTp8xHsc0v9I30A&oe=6AC3D78B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu55P2mMsRAQ7kNvwFs48ey&_nc_oc=AdrPPKYE8477DRUsKF1nuiSqquZMv5UwOq0nbRQic2YNZumI0rJYShn30DfRh9L7Hj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxXNqWuOMqnPvVFtHFy5-fdi936YNqMrd50EM3kzcgPA&oe=6AC3BA94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f1ZKZa8VvIQ7kNvwH510mE&_nc_oc=Adq0U7JUvvAiO6x6MLN6q3Jn947R7exnmsQUB6HScVKd37a0jkbbFNLiDH4n4UoBS7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOzZghpCzuY7cLDUtlVpRSAh1v1x7JYp4eJldjmdc15A&oe=6AC3BD0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTy0RjFpI_gQ7kNvwGpYEiS&_nc_oc=AdofinbCUgQVBN9tI53HPfFjrlAzBZXgl6GqU54PeU0EhAxRb2hh67PdyFzJGfOepEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4l5jtbZc33TqlmNMTu1m00jb1iktsdyHPgfmnoad0RQ&oe=6AC3AD02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
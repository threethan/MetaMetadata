://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5lOB-8EoMsQ7kNvwG86BwL&_nc_oc=AdrgaQ83GeqpFNw3ROE9MWW5B-8P9tUiblC3aQfjcJVrsQd2Cg-Ol0_EHv4V-gAx7Kc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkrrgiXG1L7DolBC-ra7GPBnhPxFtbDyOU1yCo9b3iww&oe=6ADDFA41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZt3jdpzX2wQ7kNvwFtsd7w&_nc_oc=AdpDGqV7fZEutVIsTpgOQyhQD1IMENmEAXowRZ_cApyHn_JMUZJNNMLml8a0kPl5pmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Ls-wdRxFrKAW93s-TEnDzBiR2mP_rWs7LB1Y7yYWBg&oe=6ADE1CC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IAdBJlJ088Q7kNvwG1HV6B&_nc_oc=AdoNsOMtWfZK1npc4jyoLm7Bn2QFmOYIIZ0-IPpy17PWJmPt8sHSgCYS70ynZfTpgZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMcbVZnJvcVkAL8McO00vF9iRJx-K1L3QnAkKEbI77jQ&oe=6ADDFD4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQqYIwzMZvoQ7kNvwEaRg4u&_nc_oc=AdpucnQFBXbpb9Yf7y3x0qWx98Cv7tV4wehExJBkAi-7U9MSFBJVlxCxVnHp7q0iNp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-xP1QpsEFFT52Nzs-9zE0tF4s5ZXtMfPzvdjziQB1Ug&oe=6ADE1894"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MogV-of5SYcQ7kNvwElDAes&_nc_oc=AdqEVq1c7CdqR2ixd6pY6_q14UEZeI-d08SVv1hi-zz6xi-lXcqcg0P_HO9w9Ad2DLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Q5xxSDc93jU4yEpXO5OLyqji3VDr1D1EHypJ4BUigg&oe=6ADE1B0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrHUGy7ZnssQ7kNvwH0s8n6&_nc_oc=AdowT7WCbdTcvYkxtKJDFMBc2wm3txag_VvptyfbZKAAGHUcwhAiqMpfv2km40N3b2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcSMVihWd0sVy9Ro9dXDl65lYOsdWVr5hBG643jRH89Q&oe=6ADE0B02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeOq_Bhl9WUQ7kNvwGR9cua&_nc_oc=AdrQE5fk8NkpvJVkAoUa_Qolg6JxoL1sfP-8KqhHy0Eotb71BVUo1FCWIlWbPB_ablY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwU3dRtfojYgcQmWq4dEprcc3TghOQtg8NKNLlf1iQNg&oe=6ACD0F01"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7LRwYiZvlgQ7kNvwEsQPtq&_nc_oc=AdrmhB3BC_9QA4dem18RcDi7D_cn2UJlKPYJ5PSTkO-k9brgShEFUEZyJjwspUoH6YA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWGFSxcKwuc2SVMoZ8aYc7xKHjosHEf-ICI2wGmb5qKg&oe=6ACCF947"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_-4We355YEQ7kNvwExFpcb&_nc_oc=AdoplWkr9yZAUVZyUlHP3sXie_9uh4B55_Zw_CKSQQNMWzlh0svXwOE4WHyYq63VvOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv3pPQa1atf2nqheieQkf1Tv-ugA5TnO4BgPP_1b2FLA&oe=6ACD120B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uupm_i5WoK4Q7kNvwF3GNgb&_nc_oc=AdpYyivFN2jjXzQ2N-9VDs5K2jmVGaJY7Ycrb6MCUBmgq9AsStuR0rxXSc2Gi0CpcQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIy8KM1BFc13RM0g_F70PaWTEerjwNkvkQASOvOIwNQw&oe=6ACCF514"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbyrbm0ZkCsQ7kNvwGq2tzI&_nc_oc=AdpLzvmk8Zx9dG-rgMwAhb87s5XN8KGS3YhIxMQvoYa95Q5anaHYZq-0qf7-6ewy9VM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIN7H48h3z3P1gHk5cHu0Hw5vCLyqt2pjCLf5ZiBAb3Q&oe=6ACCF78A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aICxWdYMFcwQ7kNvwGYT8tq&_nc_oc=AdohB24ZPt3YRvNT2oOH395Mnn2LhW7HnlA3RQtSGxoepjPo4gKBPvGTN1sDAhTog9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP-kIWoEe6DP6SndMOMavoJUepEovUEcH17daAk0euQQ&oe=6ACCE782"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
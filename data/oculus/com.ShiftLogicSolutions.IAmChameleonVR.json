://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6LrWivuMyIQ7kNvwErPSZt&_nc_oc=AdqOCP-j436EpQEbmxTjNX8yeJbMSDow8zyVeX2Wyl_kuBwkAC1rgN2yZlNV9vXyI60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCyDTrkf_YfThZB5f1aR9cYFYPC5ZdFRNhuG7Bdt958Q&oe=6AE491C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je6QEwRNaU4Q7kNvwHWI-0v&_nc_oc=Adq3sp3o1plmd0ltaNaZsBiR2U_ETecBFfvzqAHLwy7ury7kCmYejzEyeex0wVKmTW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo35TYjubkUTIHzAI-qnS7PWT2GBqssyq6V5SxdBf2JQ&oe=6AE4B447"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ncE-wYm8DYQ7kNvwFRH9so&_nc_oc=AdqJMfZtXUwC5LOeGrjWfGORPSZZE1O2jofn-wahmGsVQ4AotTWgvx9_MB-D6KoCrYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFObqI3RXBb_AM-XDb9F3wd2lXZtL9H4R1N2N71EDnSg&oe=6AE494CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjDTcgCwA4sQ7kNvwHSWWyj&_nc_oc=AdqhGnvsoGlIhIblfh_KZBL-qr3-KC9ynqO8qJ8haL8d9tuOp4VEysAfFPBqJMdpVXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ9FNrWJyVbfBsTP2qqlJ3avaG29FbDOVUAS2zVDsHCA&oe=6AE4B014"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAdFacjJM8QQ7kNvwEDzzDR&_nc_oc=AdofKk03X8DAOXjp2_kPKoRquYzKuMQj3QQQtMBb_5e0lOpw8IyzzEybmvvJWWB6qq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSlzUmZEe-VDNUroukmZCSw00fBzjpjz9Zy-cPqPmp3g&oe=6AE4B28A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u9mbzJNFikQ7kNvwG_Wgqn&_nc_oc=AdolyZ4gPaGaMT4ZbCIxHnMcVM9zz1yn754OUl_dx51ENCAmI77JllMWzFWanGbyQMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvP7zB5Gx7UtSKPtLlM2zRabo1TBMy8ZVoYSFA9JoMCg&oe=6AE4A282"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF0nLUKy5b0Q7kNvwGcg3lo&_nc_oc=AdoAq2ZK5161su0JKSTPD8IB4taxaQ-uiXJJ9_cQpB6n6p_XNONfHUaKH7r18hVX5vA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwSHLMRIsoQiH8slgvRElL83cwBvJgd0cA96f8IZePBw&oe=6A92D4C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EFYrwrB76IQ7kNvwG8JXwG&_nc_oc=AdrHD4mtuC-8bPoI9EaRyrqy-zpCXDzGcuKs2YXCt3eyLgzR4nEfhN8wrwyiHz9AS3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKbFSRMmlA4wjm__Kxk6I8-hgbWJj0DmEX_S3QaPdrVQ&oe=6A92BF07"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqscfBAET2QQ7kNvwHBuUOw&_nc_oc=AdqA4NrwdISQYwBKTf3Fx3-kPH1DaqWXtxoGm7y3w1BSSIVHHeyD5ZSSfatsat6KJBU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpo_8FwcMDkC9cmL0sXGf9erxDH-pHfdQGbthxRp5rsQ&oe=6A92D7CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNrD4WncFygQ7kNvwHOATS2&_nc_oc=AdpGKHpoLmnd8no6Z3z0rE__pzuc3Ce29Fpumr9SEHnEo5hRWCYYFhDd-H33orimNe0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL0sV6aTDVt4E-gR7kjvk6Xx9D5WyYlraUnYQyhtdE_Q&oe=6A92BAD4"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM5ElIrVgtEQ7kNvwHFTwDg&_nc_oc=AdoS7D8WIE_ZECRjvKvDASj6PrKZnmOupwmR76nVJh95aZQgh0-Tm6yfuNNcVyy2RXE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJgt8HWvuW-73t0BJqJxeyBWveZMrM6Nd7uxtSf1Hyog&oe=6A92BD4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3q3SEjzEWcQ7kNvwFGrDvZ&_nc_oc=AdqaUrIv94xg3SPF142FUleRCHvcdI232rxOXh-r-uPKLZIH-GWelQ21xVLit6QDmhQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbxu5DyfiMZE5xlVfzfS5kNEpzXxuEJsGesqOXLwZ_BQ&oe=6A92AD42"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
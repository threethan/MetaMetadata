://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa5QgLPRkjMQ7kNvwG9UWPN&_nc_oc=AdrSH1IK4oph8xAc1q3MBLfWUR8XOJGzPCmqYdL2WcZm0guamQ0jXnSO_avtOq7Ti5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLdxHcDx8yv1mbcN0KpfskAK_D7TlWS2L66oWwvdgrAg&oe=6AD25501"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUQsVeYzDCsQ7kNvwELiYYp&_nc_oc=AdrNFrPvsTJqkzCH1JfFgmS4-yF3eBbO3a_Ijg8yff73WOaKn5Y5CTGWcqKZe6LM05w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_72yYgsPcj6-QRXgUGcBuL8J7BljbQz1gAeQ3r6Oy9Q&oe=6AD23F47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsWWhY2PIlMQ7kNvwHr_pV9&_nc_oc=AdpadIGM2ye4xy6i7AUkUQkMUqejM_VgSD-MjMjM9AaKiHUbNzbxaDn3OWWtfoHXbiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnj4twzmeLBOsv2YdT-c90ZVL0JcN8AXtkN_6AcyRFAA&oe=6AD2580B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaNimfLwFKoQ7kNvwFM8xQ-&_nc_oc=Ado7gUb_bAI-plY72Cbo1M9dUhA6sEvQnxNH9jAh9ioFRDweLNJu1asqRUkOSYA4azM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvGEbn0m3yPEbFbGC789VC3rn7uPTpsjYTaGlcEaOrbg&oe=6AD23B14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5wxFsdgDTYQ7kNvwESgG7R&_nc_oc=AdogoWq6WLe-bm16U-72UjX4x6zFUpjgvolQAhNVVNBPj4184UEd6p6ePUeOR3hJF7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEOIE_ZU0Ne8zRzJx7gYn7IltGDYhPZSGLqHZ-Cmj7wA&oe=6AD23D8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2TG1skE7VEQ7kNvwGz1Rwx&_nc_oc=AdrqY4AOktSHOLaV-xaVo6C3TFZgxuAcCqMdkesdQ726XMcL4vGdQJbyqkSTUNGjyis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt6QF5YMNkuxTlCflAMpmbMtYu804ZHhVbmgKNcr3w6Q&oe=6AD22D82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
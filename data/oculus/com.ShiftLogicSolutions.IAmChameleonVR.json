://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa5QgLPRkjMQ7kNvwEmw1Fp&_nc_oc=Adq6QOHDu35xtYJ5p6BwyWktJBRipCIbdh7F2cpunbmiXOfjZB4NXMzlIP7Z06J94HQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeyOLQ6j5ajome0iMBcGCsBjWJVR894y16Hq4kMHSlvw&oe=6AD3A681"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUQsVeYzDCsQ7kNvwHx46Dc&_nc_oc=Adq83IAkd9y61L4-Z0H5_qqWAZMuMZ9DXHIldf3Bbccxrq2tOsRrfpy7IhQKtLo4d4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMTtUgkxgsPIPcvLTgaTWUkE_Pd0GBmqb8cCj_ElZdTw&oe=6AD390C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsWWhY2PIlMQ7kNvwEk-wJB&_nc_oc=Adrfbbo6dxY65wbiVQAeuazULIjMLQxsRnlpMItW3spd49z7ONNnQ0mN0d3zo7oHptg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRkG2lzQCaJDvwQp_VL75hpEt7dXwjYONOmjFt9f7EvQ&oe=6AD3A98B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaNimfLwFKoQ7kNvwEUSSPc&_nc_oc=AdriHL3MOp5YQJHrz7l92KGooUj_f97RcKfT--0uVsroyJC-4FejqFO6pO0qq0-Y7XI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYGT2J5JPcKI2dm9EDfPsdzH76aWspgDxtE6410pwSMQ&oe=6AD38C94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5wxFsdgDTYQ7kNvwHB0Aff&_nc_oc=AdrfTThSXwLo8sBgMkPrzx0PEmjR5VuBrV4PDnOPVL5dWFZ_ii-cszZRdJcsclbsnEk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4tIjH8eF60PsSITrp-XPNCoH4AOAoXIAqp1BQf9EbiA&oe=6AD38F0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFEJp0_SGWsQ7kNvwH1VNvK&_nc_oc=Adqyqa4beyUnTCsjTQeWIvoFGDHkKmi5oC-VHoMUH3Ae-oY05N0gIFrPtXewFQeBtXM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzkDTawK6z6vVxnrvD7cAXWoBAU2G9quuZ85JSqq3wZg&oe=6AD3B742"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
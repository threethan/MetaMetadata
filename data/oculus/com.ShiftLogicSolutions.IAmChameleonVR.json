://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4CFlwN9zIgQ7kNvwGSN9ew&_nc_oc=AdpD85NwWDOtWvKctZ71ady6RZPWHXLaW-cQxmipnWK-TIDmOy88iGsQRXkgcAyWzX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS1YqQklXz4XvuMd8DcjFCJSI5tya_3DEJnKiAB3ZEWQ&oe=6AF49C01"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb7YYdD6NjYQ7kNvwF6U5Uh&_nc_oc=Adp8_Fy-Vi5JoSf3P5IB6rKwArnCU-sH_lvEMBWM96GF_WkfpCmGzhyTqKslbhiZG0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAx7dpwplhvSkcGkjOXzhl4NzsJrigmM5Syw1laFHA5Q&oe=6AF48647"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrWpQxxImfoQ7kNvwGYPZ61&_nc_oc=Ado7l-RaJ4fGuDI3R65Sfp1TPfLaPlJBeYPsRrnBYFVU0xs3lNtcfNxLYbeW3TVW6dQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsVQxiNkRMQcZq_WwWJWS3CvQVI0IOcS4RKTIFI8YM1A&oe=6AF49F0B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz3_5AIcrLQQ7kNvwFyDfhi&_nc_oc=AdpQPn2SxcyT1Bmtnl6yyGplwKTarVteE__WBUniVFiOSuJbMJ3fEcB5-glSo-vz12g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRkSKe22E2PUUPIKiubopqWWxL7we00-A22pn9jzQrAw&oe=6AF48214"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YnDw0PLoH4Q7kNvwGtS4WC&_nc_oc=AdqqrxieInGcGN0aE-SAl4ob_Xajt2tDtGRPsfcoA5sdhL_ELBj9MXg7bt0aYt868To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkxErgYgz_W0HmF4eX9WskTVYg6b2Dvm8TpSL_fmIvOg&oe=6AF4848A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVpcSSy9gm4Q7kNvwEqgM-4&_nc_oc=Adp3u6KEQMNZwuwpWWOK577j7ABfD4TKbCpix-0a8q5rYXfAuvohy2piPFnrcGj3mc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBqAifLrGMPB1WIyjBajxgTvjFhyd744SZNt5yx5bdmw&oe=6AF47482"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxKEEp8S_SIQ7kNvwFw-1fa&_nc_oc=AdrxiaN_3GYZNGW0VNf17b1GMgXFdEr7gk98ZEI-e8dT04DeA4ICc-ZAoUTOTl-N2Ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWZsuMDIHn4X39qV59rGHLJywBcDw8wf3rHdBB7OXwvQ&oe=6AEA1001"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwyJUrQw_fQQ7kNvwG9zRKc&_nc_oc=Adrswxz3FhxUgEqehe7B8gPdCd0ivbaQRSexlwAAwLJtTb1ACHFZcMPx1U6y17nrMVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6C6Gpvf4FMEIkUVpvbxrWZ-p8VhnwoAt8P9aOk0MIAA&oe=6AE9FA47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfkRALiiRZ0Q7kNvwH1Pszn&_nc_oc=AdplCtOhd28cynAsgV0OhGRmoXwskPhRK9VpuQkRBclWwNNknZDd4JKhanZqMI5q1vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR6zRFIsV4YEaN3qnOVngBXPfW1uStVh9gd8Ti4cHnVg&oe=6AEA130B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7DFGfS1l28Q7kNvwG2paBL&_nc_oc=AdqubsK1gc-J6z6bQjdZSEbw1fbPk3KO8a56SEzwK3-Jrh1YXZHYWDwubctpIzNvSn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiBz6eKcuvB8XhrKtIi5R0Boxo6rdZayDI08y4H2dI-w&oe=6AE9F614"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnDrdl44fwAQ7kNvwHSrjL9&_nc_oc=AdrKOXXPi0cK14t8sczRn36Y40TPVNtVDTax0BpGNM1toWqeMFXXuFqOnI16OjJyJJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXoGCotR6QHjXlhSGPJRRlht_lzRBdlmzsqyDrlxzJnA&oe=6AE9F88A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXpTUcKTVgMQ7kNvwFKdCah&_nc_oc=AdrXqi8Hm9ns2QGRY1eUyWjn7k8v30290Vyx5Wj-cXH6uID988nZrrZaF3pNrgd71mA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWeDvqtQLNzrQ9JZjLba3vw0yQ23r2Z-yin-fYKO-luQ&oe=6AE9E882"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbEpJxTg0GgQ7kNvwG2yzxC&_nc_oc=AdpdcMLqZ3ExNvl4cnWVGp0BGxo084a3OK0cWuiuH6UtiCdmseGuCXoj2ehHrcKqouM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYbk8nlx2p8jyQHKH660AO3IpeSIY9APCXyCQGL748vQ&oe=6AF1F901"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4h7Cgv6QH8Q7kNvwGyv2_3&_nc_oc=AdotE5P8j2x0xryGWpuhykX-iy8m4RJmLSPmOem2UQAjBEpppSaPeFW7kUrJvXRyacg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf64SwgjAgPJwSXmvnWqrQjiBjW-jXrwkHnasrf-yA9w&oe=6AF1E347"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWJoPeZD4JcQ7kNvwGofZl_&_nc_oc=AdrAxgb4qfIqq9LNUvFb12SJjNQikrYNVpyMasbN_eBV7XdLy5EVGJDDnooKEZqVW3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ92MuEyaC9BfGiwvbnA-6xtstbVGeXihMsc9Q3LB-yfA&oe=6AF1FC0B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkpnpkawoy4Q7kNvwF-AcwO&_nc_oc=AdpTeYmu9LdEbKNmM164oiF5qXgRdeZIoohrGAKsh6tNGh2-cO9jSFBxwUqVhXiM0X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC4IxQbOpoSvd7zPTv9uGJBUsp3klFuIoI3b3mK3TxRQ&oe=6AF1DF14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YnDw0PLoH4Q7kNvwFuDqN0&_nc_oc=AdoJJ5wCknnsjMdnEDmRrIVDWt0Q5VXJWotYr7P4rxbrjx6W4BgZ56wWzCLoCW4_GzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRprpcYM7mIMfs9CwYG6szM6TiaBtbuKXPDn2WF7bUsrg&oe=6AF1E18A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4B-oEk_xAUQ7kNvwE8wboC&_nc_oc=AdoupqTntE2Djs5cHiF0ZlTfFjDMp40cgo3kFaXdQMXEnV0ejBSqnUO_FtjFAc2ke8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCukEaKcO8T_CnUqg3pvC4S4ngOhDaLwO-O6emI0DjXQ&oe=6AF209C2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
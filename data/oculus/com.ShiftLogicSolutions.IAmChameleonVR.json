://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1av2gNsFRkwQ7kNvwGy93t-&_nc_oc=AdqGYOI9-ppwbpt2tG6UpbWk3fl2XEqZl9WeMdXeuHmaEpxKlXCc85HOuaRmKmhinEM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9yGI_NG1CKPq41JTAyZExtCddJJ4Fw0R_fLP6F59F0w&oe=6AF9E201"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3AXdA7L3vkQ7kNvwEyFS_u&_nc_oc=AdoHgEDZvM9puKP9Z445DOTrt0ewdJzrgaPm8lVFWTZxiZkgZfCBZx4v17EC4sEsMXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj9JWCMga94_TBMjHW-eL11TfHAnQ_zSKU5Xd9ZFg5Bw&oe=6AF9CC47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvVGF3pnsfcQ7kNvwEuGLpV&_nc_oc=AdoN6hCFPI62vyZ2v72VzAVBVICXYp3ronhZ3Ejvp6KpuWsp2R6bsFinBDiJE1k-20k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE6GR2A7IIywqZSB_7Ma8n_LNR3c8QFkLswwg-EwIDEQ&oe=6AF9E50B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsMfmK565B4Q7kNvwEo64nh&_nc_oc=AdpFF49usyx99frxK_TwX_XmLi8ekxgPNdEKGNpCH-GIXpnv83sjUt78RH5s_2tLryY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8fi6rEBHWOUoJrkIpUOt7aUamKICXlzP4c5tz6SYlBA&oe=6AF9C814"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ul05W6TpInQQ7kNvwGH2BUO&_nc_oc=AdrCxGxnK8JQfkwd1R3W0_hhKCleZF9T0fA5H8tR_nx9ErLg-70wSHXHgPVewk9Vmac&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_iHhA2f5pvpcJJLgMYd_Biv-33rkBvXRcHICOjYpcWQ&oe=6AF9CA8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_lbPmIwHToQ7kNvwFU4HKN&_nc_oc=Ado8vKIWoGHiNjL1vPQp-ARSuBVEnzaCr9VuJTrVUw58Bt59RPdt04Cu93EctqKsLBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStHRXyt3FgorJb7CquYxPe-6KbR5P_HiuCii9O8TTxcg&oe=6AF9BA82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
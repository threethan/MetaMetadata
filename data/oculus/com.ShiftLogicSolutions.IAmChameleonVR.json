://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeOq_Bhl9WUQ7kNvwFXB4l6&_nc_oc=AdoWJPkU_MAbx9C6txgmD1cR0TkSWPFj1XZdTgxr97RkFNZ-Q0z5xMXXuCE5eBd0fSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoAUewJdnOSIuozP_djI0-mIsDbsX2YWhzakLJVqnmRw&oe=6ACFB201"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7LRwYiZvlgQ7kNvwHwwYyA&_nc_oc=AdpZrBugRbHTac3o18xg6P5tWqNe91asZv3HcecRXMJqBnrKFp3U1MU2SVqfy0YNOhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu1NArUzCwoDbVthPJVR2TLJvCnSO-eAeMBq-esG_ucA&oe=6ACF9C47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_-4We355YEQ7kNvwFHTwjV&_nc_oc=Adr0b7GKsXH5BYVZfOAVFFXxFtAjTOcMMg9Cwe2NQRFO3uPUU-nuK-EUzUEN91jo1d8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx2QGuH4t3d1OAnLpzrNqm0fzd5WLo8ziw-ucvwUGe3A&oe=6ACFB50B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uupm_i5WoK4Q7kNvwHY_en3&_nc_oc=AdrdQm3E_AQ_-hdYatwmko41wenTvl2uS9TcoAI4ANbbI5SoQPT4yp3My7OKoVEN-Rg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoDAOQCqav5UhRuSFgt7ix01Ug4wFHmsikoIXsFU_Sbg&oe=6ACF9814"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhBqs-suQ94Q7kNvwHfqNLM&_nc_oc=Adp6VF2wB5c8D-ZCxCugOK-omiLmJ4LhbrN5rPTWaRIxTo53nd1B7QiFkuXC-QqwFdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq9z2JW6NcksMikpMeAEai5lQHIO-Gmv7spAsdD3sVoQ&oe=6ACF9A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2TG1skE7VEQ7kNvwElcHmr&_nc_oc=AdrR_Fs3vaEe2HON4ouW3H30Rkiw8-mC7po3dLC4YFidxUUciwNvqN4RRYbBEu7RV00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5rrsVEi51scGe8mjtReoIEE16BUWUNHJSYQWXtxMIdw&oe=6ACF8A82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdFzbFsqX7kQ7kNvwF3t72Y&_nc_oc=AdqFRkBqAiyrvPrV3ufpUnB5ylBtmrABExkeCJeZJwjS2ZY1lrHiKBVa3LcnVi5-u3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlAqwSX_nna5VAmYVnd_yRWL95MWXxQHka8i9-fQiEUw&oe=6A985301"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkDcgvVdKQUQ7kNvwERhqyQ&_nc_oc=AdqsV13tZWMdz3iLCPTYbPNimwh_ljYtMyoHCfybo-_L_IZlGYQvNCwL77ehp1E5-Zs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITXJD6TPMMk2k2YLktJhYivDVorHZIN66-MzaFHjgBww&oe=6A983D47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmXbMnxufE4Q7kNvwFfij_2&_nc_oc=AdoyMoqfDLinbT-t7eIJEcE2HGWu5Oys1MU-B6E6ZI69tpca96kFeVgA3nXzFqJfcWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnGSFzR-UXw7dFH5Idn940KudGBbzKfvcjVQ6OEpKF0A&oe=6A98560B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyjGrc4R4CsQ7kNvwGO0hU3&_nc_oc=AdoJgMJ2BfrI9lxrnPtLzAgcTdBhsCfE_EelSYliWV_-A_YR88vQEZ71rN2ywBPgudw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7SQiO8_lSJnGnuD-Wk2aRR1LI1fMpt7ARxJ80ZuGUDg&oe=6A983914"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O88RTj3ehXUQ7kNvwGdA31P&_nc_oc=AdpWZVhpZynBLdspuGp-i8DuUY46DoQRsjNZFzrBhY4Q2Tw3dW9iQaOTUbG5Nvs2hdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgyAONDbUbfUQM4I5FCkYGFMPEuPCwNY2FbGKUHMlrlQ&oe=6A983B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKymze1cLOgQ7kNvwEl2fmU&_nc_oc=AdoB4_LGKvRyCS767yuSWPy5OURaZQV9Yk8WdIhEliN2QtbZuLp-MAK72zkkVPV2raE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMDDQYwI0QmY3UYgLL5w2IUlLcJ2m9kJ6QyZem4WtQxA&oe=6A9863C2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
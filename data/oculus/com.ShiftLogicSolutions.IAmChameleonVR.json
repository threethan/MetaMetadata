://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAU6JlrzUZ8Q7kNvwFRr1Vk&_nc_oc=Adofz52ZvY_pdCTnrSQKzkF2yqkSAq8TE5kWRJVzbiYQ05piBWxfIZ4Bu7AcmG0VPcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX3bhJGlbNjWD1aGn8TZ-rBfaZj3n8pwXVK_5Rk1klYA&oe=6AB3CA41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6RImCfHznEQ7kNvwGHgRHr&_nc_oc=Adqb_oBxPiR3cMjpY_P4QE4Sec6yzzbTiZBHI7mz7mfiaAiZJCudoxMMXcS-QHh6MYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMkDINnDayYQm8LDHFWzpgAVIyyBl3W-Ut-st3qRUFuQ&oe=6AB3ECC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu-RyDT-0tQQ7kNvwEuEFDN&_nc_oc=Adou_F0S6LhCpLWx-ZuSty3wWVarAeLGYQr5q8irwVJ3FCoQcV4TX0Ci7ryAy77ZazA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVvpWlB_0lCKkcl3P9s3r0q0XZWB4SpeyyzwlNIsOItA&oe=6AB3CD4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpgJiAABZIcQ7kNvwH4buDw&_nc_oc=Adq3QcP2ukMbmPGlqm6Zo1aSnFKtvEsS4fUb7jmHyx9xD94GpQiTsqFFI2LILLOtsHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPjVLWh6WBl7HOognletiJ-HYXh1JsZVz9dOLk61EnUQ&oe=6AB3E894"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn-L8eP4RvcQ7kNvwFLnQx8&_nc_oc=AdrlEXFvGvWJbjqzlU0OnXg9aOOnbHxuQfpTANSraTT-82-c_anERzm_a1F3-19YKmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8CqJA6hG-PFtY6YMoXkQoutHdwvE3AENdnKs1qUY5lQ&oe=6AB3EB0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfma58IOGo4Q7kNvwHBGIiu&_nc_oc=Adqmctdxijh2WtsxW6jeHAANWCs5ZtP5ccNeHhf3bJwvxJIkjbL2E04fHjf9PXbqnEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbV-JwlNa2cauRq-0jVD1AmcWzpFdB4XpbXfNk9ke4Ew&oe=6AB3DB02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
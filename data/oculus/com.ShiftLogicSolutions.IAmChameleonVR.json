://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4CFlwN9zIgQ7kNvwFQcm8y&_nc_oc=AdqGcDcv-VPik6UOiXUmYyBzh1ie7Bewrsj0ltL_qBO7uSbbkgYNf2pvfMQLQX6dx4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7fQiu541zayn2gKTagLABBcaA7VkH7eVYLagu4-shXg&oe=6AF5ED81"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb7YYdD6NjYQ7kNvwEhSFoH&_nc_oc=AdqJDhmbDdegFOsu24SfYr_gD4A-Z5Hnawr68qSwuzNKuKCBRV8xLOpqIAMGGHiZ3pY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROwHcStngY6Iv8cQ0Rm6MFArRTbid5hlbFTdK5CP50QA&oe=6AF5D7C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrWpQxxImfoQ7kNvwFJp9bH&_nc_oc=Adq3OMU9V5TbkvNK7ak8nHO3pwTn1T8jt9PnpeLWfuuAN89eyziwEGQJZriyySW1w_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQngRsduXMEA3jUWqr5CnArX7MTcDaA_8JDqwTifj0rLQ&oe=6AF5F08B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz3_5AIcrLQQ7kNvwGpUoYq&_nc_oc=AdpwV9-epiAbN6BPgltMFDaCdp1uF1ONvM1BtNrrDcKR8d8dXdZSeicg749jXaW5XBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLMHmlNScp0GjG_6Ig_-R7P1_SOs_oB6IFU5x4LpRb6w&oe=6AF5D394"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKbUyj-AJ4oQ7kNvwFIkBUi&_nc_oc=AdrcXBx1L4cpBAmcIayH1T7Z7gogunyCZnbM5Dv7tBUBDib_1ttiYoACa19AONZMORI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcH6qODcbWWhh23VkBh80-ChTn5Z3tmCuX8HhDYwUt8Q&oe=6AF5D60A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVpcSSy9gm4Q7kNvwFMoHAp&_nc_oc=AdrLkS63puMLdH8vhQR6YOvwvxNfhlm_-J1phbvhH_l4aPoUuwPjYnuTwpFEwoR4_4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU6-fVJ2KEdrABdYb24I5-69oM5ZQqKefqe-vg1b2g-A&oe=6AF5C602"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
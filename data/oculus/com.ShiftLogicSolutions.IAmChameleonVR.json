://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdFzbFsqX7kQ7kNvwG3AMZv&_nc_oc=Ado67gC18_nE75a28qp-IRqGE88LDFQhLBBN6G_MKUP2WwHGRR-EfRMwSd6a5Jm3ix0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQLQ-d49d9kma512gaS9cFxshZqbEnH_VsYGLu0s7Mg&oe=6A9739C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkDcgvVdKQUQ7kNvwGhsJoC&_nc_oc=AdrECANgmsEEOvYrQ46kQxthSm6UeczvM7kvE3Ylo9SbSxX4xU6X7Eh6anjjz_3F0oo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG42xmncKgu_HyJ9xw2QY5_S7tk4ehiFbkKdH5uKIZ8ig&oe=6A972407"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmXbMnxufE4Q7kNvwFg6ArQ&_nc_oc=AdqYteqZ2r-6IVS2rNIPdLjT26I_faaR87d1Jv3hSMX5Bxpr9faoUQDEt83KxYfRn2I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPVByhAHVvuEx4_OQyvgNzi87aSLstOofvr7ACyiXqXw&oe=6A973CCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyjGrc4R4CsQ7kNvwFVAe5e&_nc_oc=AdriO2ZX7SkKInCrxkpk8OaSWRKUhNeImm-vnWX9A2Zas-TSxpn1fAI5KeknAxI_ZpA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPHD_P1b4jsufzmbY7ym8a3j1Jsx4OTh8I0McR8lC7PA&oe=6A971FD4"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O88RTj3ehXUQ7kNvwEKvPuS&_nc_oc=Adoaio-hgSD4hIszuuVeagLqxjDs5EcSfeSI3Hely06wXg82DY2vqtwUu8fDkmby6N4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLQb28RrJTNE6_4xdWx9ALYZYE-he-oTTHZTorwVgiFA&oe=6A97224A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwQ313-KDYQ7kNvwFiNzkT&_nc_oc=Adog414wrMWYGFXMgEiOQmIHthrVJBckAFw9CksZNTZN-47mpExXlR1l-wia1Mia-hU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf2PS-gP0WCHKtlI-cReO5hkDOLRqdYxRxDQivGbQv1Q&oe=6A974A82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
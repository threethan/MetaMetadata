://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtPv19UAWpEQ7kNvwEpP0YC&_nc_oc=AdpXhXVKk-LRRJRq_7ObfKtXDcNfHSkiWSNUo-64ykszsytfbA8E_nMmzq-MsBhsIcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQSxJ0uKDqEzhKbl3-tuF0irNYwDH--TJcFmM6NQ8RsA&oe=6AA7ECC1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVvwLnSK13IQ7kNvwHP7nzi&_nc_oc=AdrzRZPFgx263J4k70kXOxkWsDnGD5Ip4A7IL-wN4_VTZ2fAaxapK29yawgrVa8g7ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8ChqWAbA7A0HtBgRjt6rzuRmacHacJYhuQ3wJJ2aq3Q&oe=6AA80F47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVgkDi0eKUcQ7kNvwF0IzwO&_nc_oc=AdpKU_HsGhVbRQSv8iHJKQoJmnEO-eREkXKyXcGOkKvrfK0wp20zf2Uyxcvc86T4jSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2rycfaAojFvWI71OdQY6MlwSqbvqR9QpQKFtP7xhavw&oe=6AA7EFCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU-9UT3F2C4Q7kNvwFupRcM&_nc_oc=Adolkjqwm_36XeR7C9LZxkANe0ACH4yn7u0IZ7E-0-aJxAos72o4k4ypnIRgsHYtP4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT40FfHQOOqO6BtMJS17phRCGy0SW7ZoXffwbTeKkJbA&oe=6AA80B14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vunky54ll7QQ7kNvwHENUTd&_nc_oc=AdofMnGrwJX6f07_PT6kC5jtMdX-3m6vbEv9zvsOAcV_v3wn__NbmykM_FJxgpt337s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa0BRp3p-aUJfHUwf-8E17DjGsxGJsu3bi3u-3HB1DLA&oe=6AA80D8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUL8UMvjkcgQ7kNvwEjWpqy&_nc_oc=AdrD5RAOn3G-Fo_5yoq53yBrT2F7PvliqG1ZTp3OeCbDdwfzr5QUshQrmkEDBTGkLcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwg7mPECqcPPa-Bm11IkvEtNqrYsBbPgPNLMx71GfeIg&oe=6AA7FD82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5lOB-8EoMsQ7kNvwHyili1&_nc_oc=AdojxBTiGTQavrtsH3_YYMGq_rC6RtmENeKjkMVe1QuBG5bYCAf7Zo8wASc9-c801Hg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLJTnwO3DOPr_BOh6-i_jWkqWoJHdESMFoC0j1tD-iXw&oe=6ADCA8C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZt3jdpzX2wQ7kNvwFjoDYS&_nc_oc=AdpWkObo-cN4LVrKbb8An2ykZCPoTAf0u22IlovoSsGIp6OURCTmnHLoIMnlpnUlf8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN53tyxrg3EbjoLDjA0dbBRcP3TBhocLCBExwhOQndzag&oe=6ADCCB47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IAdBJlJ088Q7kNvwHbSwnr&_nc_oc=AdrANYXZAlmVKpXUwXNDveEIV2AD90GtRKLR_GkbzDayW4ABd7PWMATvE7Ci-IfpN8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdht23Gzc_PpA-cI4N8aRcXPDfZ2gO5XTOkoBVXjBR1A&oe=6ADCABCB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQqYIwzMZvoQ7kNvwEODI7p&_nc_oc=Adp9p4hTSpm9pWk422ujBaomTcKWi7LRyFYBEKZnPJzLo9LqXfdOFVUtuPkhG2i8IWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy7OVtUf4uX6LFZ9VSf0au4_sh7oLL4I_hDPBa06Pc-g&oe=6ADCC714"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi9WHJg6BOYQ7kNvwES9kQG&_nc_oc=AdrgPHEYdHSnIQDv9PH4-kDk9NFmaUx7B0dr8Oe0G57fWdY7sQJXO1_cb-1SwzUKRlE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXcDuUELFDBf4bdBH5H9Vk5cCF6-APP_nGbHPkkJjQqQ&oe=6ADCC98A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrHUGy7ZnssQ7kNvwHcm8jz&_nc_oc=Adpw9Mn-H-OsavymiI0Fs4_-ANztKMQJ34ObKPVubXOhhZ7ekm8nbn3xNuqCqecBLyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVi8k0ngMGKWJgM2IWyUgZP5yIJScyUzFzj_epAgx6BA&oe=6ADCB982"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": "https://discord.gg/iamchameleon", "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1245579761969258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_2235777820552704_5090708819474035322_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLuf4_X6Ha8Q7kNvwEC3ESS&_nc_oc=Adr_mKlwhznu2SyYoqhuhhylGhpFW5BZ3natKB7Vv2Itjhh2ZP4o4sRlCC1qDCDXyDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkV9WMXbQDPApeUASSJ6b8YECzeubT8-z3y0Rm3ttrkA&oe=6ADCC961"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Chameleon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"
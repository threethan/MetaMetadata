://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF0nLUKy5b0Q7kNvwEsoBQK&_nc_oc=AdqNrj9MWJ1iBNf-L-t-oA0uOnz9u3zrjXwdjmmB4XRa_KAs_B7RDTaCUmvxYx8epQo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYupu7IAtQkt0FNtYotvXEqHRo05GXvCuSSe2kgrSIuQ&oe=6A942641"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EFYrwrB76IQ7kNvwEtPNFC&_nc_oc=AdpgoG-ePPs1TCSwl9n766XmXoz56-gQPvJnc2ITyFIEvsks5pKYs3cSfZzOEbW_6f0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-DwKpi9oP5RBjeDoIeyzvikMMmiQNrJu3XORb8-U-pw&oe=6A941087"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqscfBAET2QQ7kNvwGfFpQ-&_nc_oc=Adr-7gvWsHw0hjCrX7Zu5T50XTtCufzIZnwl7awVTqQqMg3Z8ia9zKdkQmasZtTbQRQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ3oW1w2oYjNu55FQ59ILUcyLkHvo01l1o3qOaDzHWpQ&oe=6A94294B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNrD4WncFygQ7kNvwH93sOI&_nc_oc=AdoAXUmWLLR2Y_nM-3vKPQ-ZwWjqQhKdx75MV7DxNqOZcPgkdVFl3mFdC-CdNNzIR7g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8bNSf4vRtkOr4hSK0_EUybC5uZyxbVArvL28T0XNSIw&oe=6A940C54"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM5ElIrVgtEQ7kNvwGcjeC_&_nc_oc=Adp9N4qsIlmx9PN3S9l6bU6PhAH4OD-pTsNpZIpwmbvvKvkrxwQAR-5IOuS_Dw6MmNY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaf990vb2GPRHCHL8TNasmdaG_qCdgQvMpUGQR8fWs5Q&oe=6A940ECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwQ313-KDYQ7kNvwG0BI8d&_nc_oc=AdqDIT2ke0LtcDDQhQFsWu6_jBRV1nGuusU2_2kt80Z-tanalO7LrWF91EXTwa0DjXA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZGQUisabAHa9ulqcqeA5glWPoJpbcCUUMTy2XUZXerw&oe=6A93FEC2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
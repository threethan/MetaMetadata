://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxbqrNh1QUMQ7kNvwGrOXwc&_nc_oc=AdoChj8N_TsGK0gDhGq3DrNW8Ny4pa_wfF1rL3aZgOkOP2CSoKK2XAQr5kp7Cvb243g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6lblW1sfUUziwRPMR7av5hMOQhQWNBGhbbYupZVXWCA&oe=6AC52601"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koiz6oXa3zwQ7kNvwGGddjO&_nc_oc=Ado0mKmK7pSQPHYp7hSGOUn9tbwkCmFiP7vwK_mbyYxs44ARBCsDLUrX-tMd4cgRFgE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNLmRladQGllXIm2gGW-AWOlN8Xd0UBU8laLl8sDhBxw&oe=6AC51047"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noJJB8KwWMIQ7kNvwHMPMJN&_nc_oc=Adrrl20lhimQYunYrgjDNVOkAiDi8PxU0-IAkL00-_z0meA21kMiyxk2qVE2E-6UpCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvcJo6EXUkw7MmyVbbSMIwtlxo2ZQTPpfzwma6LKOZvA&oe=6AC5290B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayRsos7ZrXoQ7kNvwHnKP_O&_nc_oc=AdpuM3aDRU0dq319c-SV01AS6cKcwJDqCLrS2LWTNO4DeC-hMfTFfFpSlpeDhfK-shs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1HyHWWXRuVTDUnfckE2MKxuCP_JEqaEorOY03nvYrQw&oe=6AC50C14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f1ZKZa8VvIQ7kNvwEnArse&_nc_oc=AdrGwUW9g62CEvXa7LBjS5aBhikmd7aANDZvsnC0TaA6pKJlCOd3YZab7mG3B2V-yIo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONKYFipXX9w_raIhKmBqAGp6o0seMGW0Bn7xQyaHHd3Q&oe=6AC50E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTy0RjFpI_gQ7kNvwGAXq0t&_nc_oc=AdqdJNmCiPG5ewXV2M5v-lYrXQW1l0Hem9fSXysgESSJPV15YvRvdJPf1x9Epypmv4c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPELA6tAkhhNfueB3F9je3F0dGuBJJ6XB1nJKVj6QeJkg&oe=6AC4FE82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
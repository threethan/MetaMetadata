6B0B23D4"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVsho4KYb4wQ7kNvwFHECE9&_nc_oc=AdqN8hRM3OR_8tG210IhrgGS8wFt3vGjv8XrCy-PXUA1cdUGTA8P2Mex_LP0E5IFyak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRe3_EfNyyhImNxfDNC1qxlRDuob-34NWW46qMSDUqyqw&oe=6B0B264A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4Mm3Vzb9KwQ7kNvwGkeCdV&_nc_oc=AdoKHwGmfY3XR2xQ8lUocszFRvyfUhic9FsiL_T-zdNvDEAGYN5hExp8NGTQXc2zqhI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0FEM0xn1QjZ53CwRYkb7qWFa3IVZY97NbWQpSDsOrzA&oe=6B0B1642"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": "https://discord.gg/iamchameleon", "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1245579761969258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/595112037_2235777820552704_5090708819474035322_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du_zTfD2kucQ7kNvwE-NOK9&_nc_oc=Adr_Q9PV6kgl5VHk4CEnZbh2xLKg9ixxihdakuluJgIXHr8tXWCLzQE
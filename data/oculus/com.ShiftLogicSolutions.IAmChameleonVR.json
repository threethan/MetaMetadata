://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdFzbFsqX7kQ7kNvwG4r1JE&_nc_oc=Adq24B_7K8BNKKKg_AsBvckM0nMy-p10IZw39Cf9guQrGkCDX8hU_H27YcqSHzlLX8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYh5tyj5O0UsuzzG2YvnWAacuBCnl4HrHKHfUERx7NXg&oe=6A95B001"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkDcgvVdKQUQ7kNvwGVGDw6&_nc_oc=AdokfwDK5ejrvrkLp78WqgNc4So8GrS_ZyjsLTHHzB5BH-1-ocDtli-VNb8hywInNhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrZQOOUnYRuaHZ2SVab52ZfXogFaJE_oGW_ZfthKbaqQ&oe=6A95D287"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmXbMnxufE4Q7kNvwGKHpC8&_nc_oc=Adq9amicJ5S8x89QkUZItHiClqgCDEBCRBkBw5XF23a4Hgu8MUKSAMc_tCHdP3RBcEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhoKTpL2uVY363cETfDF2_UcjYg3w1B4QPAGfA-OVIvQ&oe=6A95B30B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyjGrc4R4CsQ7kNvwHGfvmV&_nc_oc=Adq6G5snkwrY53b6SV1StYyds9x7KtyDEKLI2zJOYXhmm076JI_r3vq_ArPpZQ3Fe-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDmFKqA-6PislEQqsFOdmIY3tRo5AB8ifQgtEPEqORgA&oe=6A95CE54"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM5ElIrVgtEQ7kNvwGWcYJt&_nc_oc=AdrdogOinzVhgU4Pa_jT2mqlNT7T249hB0CvhCN90SpQroXYY-IQbMWH2jgMNVQEWt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW1Gu9vFhohLRe3aaqRtxbVAFHEIWWhfVriAq1J85hTw&oe=6A95D0CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwQ313-KDYQ7kNvwGL48vf&_nc_oc=Adp8CJYBLTpln66vyDXVcF4OQFtxH0pdggHOpgcjl7QI5lHo7Tlwdkvq6QcR_c6tG1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQyc_f_nPBZL7yMsqLADNTg7DWf54XEd9umaGYcz7HoQ&oe=6A95C0C2"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
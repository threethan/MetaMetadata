://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxKEEp8S_SIQ7kNvwGTIy-T&_nc_oc=Adp-CIEyZFm8jSovMReUHIBQd03-CRgEo_N1L6NQ51h-KOXiRujrUuDCwDDF0VUFy4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtU3nUaESWIbfSXkCZO1ed4WFx3CN_an3qTLsJoZkLTQ&oe=6AEB6181"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwyJUrQw_fQQ7kNvwFhpXUK&_nc_oc=AdovZB6aYh77TSgXlbQBBf0in5kNW4nIAqPWAJZSTgzhUBhd9cDrn45C82hYYX14iDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBJL4EF36XbHWFSvrcVo7Z4gi_vapGFvvolCtsZpLsOg&oe=6AEB4BC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfkRALiiRZ0Q7kNvwG_MjDf&_nc_oc=AdrSXjgnR6v1_SNJm6aGceuaTqQT4gzk4e3Zgh_LeUdM5h_IS0kSsSmK8g_sgeRYo5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScvokNlTxpxkN3QNStq9sVlFQRkTghYy3Ct1gRPgc7Tw&oe=6AEB2C4B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7DFGfS1l28Q7kNvwGw4hEa&_nc_oc=AdqWeG7omz8NwaQIyuccWJTUEG6VRodgjg6oaxIhQ7u7o2nrkFTP2bjY-5f1bCLq-Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQICV30z5QikRnHwnRE4ayL-Q_Eo47PGirVfSsury7Lfw&oe=6AEB4794"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnDrdl44fwAQ7kNvwGI8zjx&_nc_oc=AdofL_fUpHar75RXicEzx7bO3eTex1IqdI7y4CZLo5Tvc3-RUzhFEj9ZSRh-0xifG2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvz1FUN-EE7r1CBguYPUWGx5QI8vzVlOh7TlbQgPZcbQ&oe=6AEB4A0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLGWrpEFLZcQ7kNvwHHHoPu&_nc_oc=Adqq6O9b4U3gKKUZ_BQTBUTlD4_Js3KvcTzTe2VjKbE9AZnFl9JJAHoWJEDYM7VGugE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlMsXcuOuT5xKeJmu4bUo25MC_MqhVIbGZhhI83UBnAA&oe=6AEB3A02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
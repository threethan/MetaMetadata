://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJcKCTRQOJ0Q7kNvwE8e9VG&_nc_oc=AdriSlToVO9izjl8PHcbd9c88lxFhz8ou627IdT6-_UU2WqG5g5WRu7_pIIg8kpEkM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgIKQ9uW3NfO4GRGS7zXFzr-manBF3068mWzxVQZOf2g&oe=6AC91A81"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixd6SGbHAusQ7kNvwETlhju&_nc_oc=AdoXdPkBSDotRt2ejZa422UQvpltzu-9_mUhNBts-QpwZjtoHv3L79oPwuVeUMT8DY0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtjc-fydhVqLfXRn6HWyDZM5F-8vsEcc-AxKLJgnC0Gg&oe=6AC904C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Tc_Z8iCDUQ7kNvwHM7jBi&_nc_oc=AdpmjbD8JZkZq83wVj22oYLJA2PO-dMc0UfIdTy8UcS0gAcwbuO-BKMFimqImrmpMJQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlc1Miyhu96K6OdiDCWmQyRT7tNHQ2X-AtMwFv4_HZNA&oe=6AC91D8B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMruh37e470Q7kNvwEzwv9-&_nc_oc=AdrutEWogDbLpXmrUED1PSlBw2qyfhkeXfkEY2fzRujMcZJI2Mr8QetriSBb247E9xA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi7rBFSc26L7YUVj1zBcBMR_o0oZ79KXbH88mfDOJZ_g&oe=6AC90094"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PnaOi8G8_8Q7kNvwHaDuEm&_nc_oc=AdpBWWdvkyzFmxS70XzXqVn_ckvSDZNopjB96lc6RA_vGAw4P0MLbnfksTSRt_ocC1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLnhPms2PUBRjblTGyAkwGI9GNc5-8SFxtZEGsc0VU-A&oe=6AC9030A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alhiA7RiYL4Q7kNvwH_JFzq&_nc_oc=AdqiISbzgHFxtgQtZ6lYaWLHlD0ZJkZK265_Fq5g6no1WzNCtshR7bMfhIklD3hT0E8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYmhc9YrQnl8WwCxTEfCszgi2tGGgT_CCU8zBDpomIiA&oe=6AC8F302"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
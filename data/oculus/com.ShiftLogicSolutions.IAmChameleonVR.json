://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwQlQlGj_uYQ7kNvwGU0-Tb&_nc_oc=AdrTycbfKSo_uh5C4LiQpc6NGfe9tQsctJb1mS8zcKcmm6CVWUXLeZ03Ire3mGus8PA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmqKpwDzsjZbFy23n7xV6oQ39Wr924vtORmuMtDkrCag&oe=6ABE5641"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8wT--N5KMMQ7kNvwGEFpvL&_nc_oc=Adohs38io4qHFy2nhIgiHvwtuK856QoaXxuRtdDVmjFEbsLlDzx9o-4_x2W_gwqpy14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKargJrS0FM43s4T4YZfZAwrA79kCvLJz21ZRMilBih2A&oe=6ABE78C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ9ISMGqWyYQ7kNvwGqMPqA&_nc_oc=AdouuX2RpRnJtga1sYImx-NT_t08MRAulXzzJ95m7NsJHjkC8Iyw56CzpIqrCAxu6lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxJRfC4oUzXULHwhKY5NyN94sIYHdLt3NlcGMEOtteeg&oe=6ABE594B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aPFkR-hrPkQ7kNvwHSlRDZ&_nc_oc=Adp8fvxjWtlOJQOmNBEGSCwqa_JUcNq4TgdxhjJgBeDp0PgW2R2BJKGXhcgPiG-4IQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRgtr1aR5nDT6D0djmGGwrg-FKG0NlllHXH8Wg-pwjjg&oe=6ABE7494"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSSrITfRp-cQ7kNvwFCUHOv&_nc_oc=AdrmoTLfATWzZhSBDzdsLGxK6egl4SoteASu2a7ie31f8L020XdcHhaoOhYAYtl1FkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8dGOZMVMZ_QNdAXM4s4D3vaEWz087n6CRNWzhIC7W_w&oe=6ABE770A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WocNu4nd25YQ7kNvwHNZl8l&_nc_oc=Adq6Hp1rJeA4u5zDhs0qqlwbIkBZlq33fWnAlGrADssUCNCEIr4hnal3twNhjf8fFME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLwvmQM3KH68pgoBlJq-ZN8YWImLTlv_Ha3b0WsiwJqg&oe=6ABE6702"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
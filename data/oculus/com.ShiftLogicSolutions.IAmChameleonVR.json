://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbEpJxTg0GgQ7kNvwEkDB_0&_nc_oc=AdoZJL6mNdby1SyVmJBWoPXtgUDs34YnobHZciKLQvbuuHAm_TIIqXzIoJ2rAI72Mj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZlI0LVeCunaP-s_5pWxOH77W_3i2BVhDGtd8EzrWKRA&oe=6AF34A81"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4h7Cgv6QH8Q7kNvwGaQFV9&_nc_oc=AdrwflQ4L6bftHMW7TReRL1s5riJNc4zaW4GFqGW_beZ1KBEhRJyzdPBGYJdminaZTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUNmSRTxAUMDLX4beY7rbZrpoiIWsZtO4h5Muz6ylMNQ&oe=6AF334C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWJoPeZD4JcQ7kNvwE1EceD&_nc_oc=AdrtevlNVsnlPmerrj81tywQ38OxrmCoMEOUVYquByMq_VkpRe9rOk8PNeZOPlxGclU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl3usL50rLru3tfP4rwwkSWpYTAGi5A3lxRKhSM-j8XQ&oe=6AF34D8B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkpnpkawoy4Q7kNvwEPECNJ&_nc_oc=AdrOnVSsfx2ldTbhU7luU-CoSEk5pQiSDaB2niMXrCkSpFE1E_m_GHMx2-dsF9xQ4-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE_B_uqhGNSmOknTcpHt649hQVrJIx6qHsV3gx0zOwBA&oe=6AF33094"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YnDw0PLoH4Q7kNvwGaN7Le&_nc_oc=AdqEWpuM3KBASMX9DLqgk58mPnHdz-La6AKDjv2ndPiPjEAu0SYUCIxngWKjap4CmJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAGQdCbaNsUBtkbY4av10Gb-KvarQ4Wmef7_0ax0vW2w&oe=6AF3330A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVpcSSy9gm4Q7kNvwH4zaVE&_nc_oc=Adq6OdXJJG0iUap0me2fWteNJOE1vj77XlYwYCn6i5mbuVXJf0UWTYM96G52partHr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUmZ6GVt9FzQXqpcLafB-u_QC1VZvb3wXGzYOoWwlCPw&oe=6AF32302"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": "https://discord.gg/iamchameleon", "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1245579761969258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595112037_2235777820552704_5090708819474035322_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xORbq6iu0bYQ7kNvwFw6v7S&_nc_oc=AdqaaAHDQCKgArrbAty-nE3gmg4ugQW4gCHMxUoxYZKcibYqIX09iXJ4grH3XRLZNig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmbyrWsdXYZ36tTkRT0EaCatHwH1oo98fJkWX-k-5cbg&oe=6AF332E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Chameleon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"
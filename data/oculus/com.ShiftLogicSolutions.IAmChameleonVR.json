://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruK3k90bc1wQ7kNvwFCF_Pk&_nc_oc=Adps_X-ffWSvjz6YQVYUQBYkjQKdN6a6NmtK9F3REWZxZNrE_pZTLB_M2NzbK2tgMqs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYu3FG3xkOdUWkfpW2FTnVYzryF6BHAhdADzTD8cYALg&oe=6AAD32C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch7-Pu-FXfsQ7kNvwGDGrRz&_nc_oc=AdqermiK20o4KeCnVX81Tq19ieE-N5sV1UwO7EqakdURN_3h4C5zW-Z6IdXSME_DdDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDEclrBcZyYZ6Bz8OhSVsI3BFu_8nfKQ_FScyZhufE_g&oe=6AAD5547"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zr4WT8kn4wQ7kNvwGb7H0A&_nc_oc=Adr75whrrQoFpW3Oi4LqpuIssobgY2N1pmaxSCkgSg4affGAuTByAVhOZSXwZs0OgZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqwUiXajY1XBteh8tT7VXuLTX2-jD4KAWQrshTFbt-YA&oe=6AAD35CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlHsHpWA1yUQ7kNvwEwzlqv&_nc_oc=Adol1c49xcPzVN64kevG03RYpxgvCLOAWahYwWhz_bH7XOWmV_o0Pdx4lf7vYV3_3uU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN01azmEleGdyeYmCkqyvWGebMYoetRxbxgISE0Fly8Q&oe=6AAD5114"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciCdS87xWkQ7kNvwF0AYLr&_nc_oc=AdpmV-EkAKUYHvAkQoP-QodWDuZVKhJvkA964mO_mPycws-LvGT6hCiHmocQr_HT4yI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxSgtxBsz0Isot-Wbe6uqGs1m-3Q6NNAYOjiuSlyUBtg&oe=6AAD538A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnfeJ4WDz4gQ7kNvwFTKNd6&_nc_oc=Adobl1RRvpHIKA3plWd56GXQIigM75exA-mHaLvIE2AJW0PpkNdI1Segjgwv13AQ7LM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP-mvKKHc60fTu6pTMzRt8_KWA_I-k_MvmDN1lXZT6aA&oe=6AAD4382"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYMJ2N4D1DUQ7kNvwGK39cN&_nc_oc=AdqewatCQoACJ9Xl1hS6PnwwSM97vwl1qTxsSEorUnE8f6lThI5f5Zmte20nMyBq-V4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzVmBuxqgxQD4LZgKEa8qYo7CA55ie_E6dXiuA1uRl3g&oe=6ABBB341"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kDOCBZ6aqAQ7kNvwE9l5wC&_nc_oc=Adr7xA2aG4yaOQP5u_J4T5R-zVGz4HKv7DcI_NW6StlWdsnq85eYdtrqVZdeWRKGmoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyLz8pcdheIxW7S7jRTCWqtrhSIjRfn0i9pNUlauKjbg&oe=6ABBD5C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqExygtRJ8Q7kNvwHpvbVK&_nc_oc=Adp-aYmCAnzjvVV5zVfb_7R-rkP4YmZs7eSndVbLOPyybP_5MN15YL_5iuP6Odd2JPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Tre5Tnop7dFfnZ8CQ02fUt5btawXTrncwSylboySvg&oe=6ABBB64B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWBMJpWTU_UQ7kNvwEgBtD2&_nc_oc=AdrFiQdYMQBnIskLPmi_koe7uAiExGN9u43Zz0X8XD90VZ6XMBYScBrjdqu3Yp0SckA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwdBjnsE6LlGAo-ssqMJugBsvuLDDiK2t9f48FEB2ZDw&oe=6ABBD194"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRUAhBVmwBgQ7kNvwGTPZyk&_nc_oc=AdqoUqKXHHRif9i7dF0uW7xLDGyzx15sUIXWg0gsV8v2D4iDo5E-P9VlBEWtPIDIbHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAuUt0qdVmKm2QGbP9ztKPPKwWuKyqExFQzEZA00aPqw&oe=6ABBD40A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WocNu4nd25YQ7kNvwGVTuMs&_nc_oc=AdoxIvvIoTH70qW1knlaCH-bT9z0ruNfrz_CXlP1asQdniLmoEpSBbPAufflgJUhvpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2Ff91ECu9ZItd3FjlEQP0VsZnXEb8JPGcWGVACE_z4A&oe=6ABBC402"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
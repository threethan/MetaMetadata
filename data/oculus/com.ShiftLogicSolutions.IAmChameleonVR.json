://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=habNTEc7fLsQ7kNvwE89MFR&_nc_oc=AdoHqZ5-dx_PqyzA-KGfj1dkgsf_yqnwrA_SqGZKrYqDRqlHIWlK-i8WKOkQhzCE_-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYE3t6PQP8bwIaOSPE1NxXKmQji4xxQR804j0J73D8Lg&oe=6AE09D41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKjmldSj7mMQ7kNvwGGxYCD&_nc_oc=AdoipkTuncvMYLfdDvwoqyw1ArinrYUZjMz6s_VL710shi58IhZlEO-sqgrT8aPRv8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW9ZkWPfWh5Be5udTQ3YK1XDLiPEZOIIKU2QE2rpg3fA&oe=6AE0BFC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLv6tzCJF8kQ7kNvwGxvIuL&_nc_oc=AdrEegTCe1NUMBjdXY9trwFcM36jHQ7YUW7aPAHt3SHBBCR1rRNOPObOierZhr7zNds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoRPZLKV_9soFafpJODbO-p1lRSZfsdeWZCwArfWNiQg&oe=6AE0A04B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZUFj3HBEIMQ7kNvwECqBWJ&_nc_oc=Adr6SJ-zLtgmxZGqp4KMbFy3veWF6YkdR0C4zo7iZKH2TP4qqZCUo8ZksqWVReTFpV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsymwkQYoTZNTqRXjuEjShaCOhnCK20ihteTChRXgbZQ&oe=6AE0BB94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MogV-of5SYcQ7kNvwFqwqJA&_nc_oc=AdrS2Qj3e1vqJkH29gNEjD4H8VlHrRELC3Qix6Z0sLhuNZbZMqfoZaVye3mjvApHo6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr5jetV8koO-1nalBWKIJcvClgvl-lGwujn6ukZjM74Q&oe=6AE0BE0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSObJ0c5kKwQ7kNvwGZIhr5&_nc_oc=AdreSt-wnEm9sl_OH1KhBfletlOV4gCXEnbCmL8LlOz9pB3PpK5vvbWeuoPdnWP-Hw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd_mxxZDb4e5iqjOHsJcDwBgKEhrS42Z3Q6PGDHvkV9A&oe=6AE0AE02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
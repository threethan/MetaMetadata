://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7_mSI4EkNMQ7kNvwF0lChC&_nc_oc=AdpPNiyU0aUqseUFhmxcTUIWausy5lpT75uuQ8fcyMJ7N-2AxE888VzKxRrvcexGOms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA-7zTDFNcY-ILRPlvyFZT2PnL192p-qmNfLlzl4vFwg&oe=6AA2A6C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m9TUgtBU20Q7kNvwEO_W3v&_nc_oc=Adqymiz3jeXCPlu194yC8FDA2ZFMT629St4TK9KJ_BZVOGunOM-7MIyWbyqvuqCEX7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPV3JRdSmfpX_Ry_u8x2vZO94J6bSGEPtq0lb7qMuLXA&oe=6AA2C947"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4UKc6MAfjYQ7kNvwHU6Dzq&_nc_oc=AdplIPiuacnAnHrP3nMsK5nOFA7OsGs7dLT6xxtZYfpqoEZOT5kjn8uuWKa_QmGa6jI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBVCjvymk2A9BfnAvgdU2garAZtk2kOUgoTV0s7EXIfA&oe=6AA2A9CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ48h74Nod0Q7kNvwFUWQxc&_nc_oc=Ado_4yfL8Batvjo0sgQptKcs3ytCuy801kxgADUN_h_Z8nUIi_BZR1UqugUXEf7FHIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBAAiJNsQqIjM8nQmSdJ4h9MmeUnL13GWk0XUwE3wVAA&oe=6AA2C514"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNSe1Fcyr0cQ7kNvwF1dNLE&_nc_oc=AdqNDkVi1FsCZnYSc0njFcOtPYX7yU-YfJs5zkBTqa_37asnH4TYEr9QmH0lH44pXao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ2bts47Uz5HD_wDLA-Jis4eQu0qid-MM3vm6S21GIGA&oe=6AA2C78A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmAu8yO209kQ7kNvwGBi3Kr&_nc_oc=Adof4RsDmQjeTOIIGBycS3L6k_bz86mu9pqincqiTWKbR_t2w2eTFqdQtd8IbBIV8nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVYtWSvpquLrxZkcnf0xklVx8gUqpZ_FJLrbMPPhxvcA&oe=6AA2B782"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
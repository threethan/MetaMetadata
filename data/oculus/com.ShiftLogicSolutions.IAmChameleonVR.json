://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI0trhkc3sIQ7kNvwHsZ0bx&_nc_oc=AdpAL-w8fRyi659CEINUnBGaFKje3FxuWKv9BcJAIE4fei8Vq-x6QiyhCTYC5MCg1Fg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqx12_AHo6GRWfdTLqE7w27rZryBK-9nQj_mqjYQRzMw&oe=6AB66D41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW0ckS3zyX0Q7kNvwFPHKOD&_nc_oc=Adobnl3yDnvElsRNZJkSjsyZlwBif7LEuIzvfgCvQKN0EchBQu_Qv2uE4tgyIwl7Txk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJH5iJGYRLLCm8CG8um3N41IDVvwjlVZAtl3KRTEqCwA&oe=6AB68FC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yCn6wmWlPoQ7kNvwH6Ictp&_nc_oc=AdoM3FNBHKC51Z-jhK368u11nBoidGjSY9T1PFRUB-BspSDEkgNkItKuW2IAwQBpH5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkNpj_BHR0HIs3JXsAgbjufdoWJSkP0axuOEv1uM0Odg&oe=6AB6704B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MGI1T1sU6MQ7kNvwGnCBXp&_nc_oc=Ado_tWEjv5JewNH2MWi7vqYDVhY-xsxLQOzmlME_yaC3x4PzjI0c0RZnsEm6TqOVhzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCz9iOz2qpwZALKLAYT396X6BGH3bDobtWJafawOLMog&oe=6AB68B94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9PRBy9aziwQ7kNvwEwLP9A&_nc_oc=Adpdf0bcCGiN7pK7_1XhEmAAHXluntGaRjhOy6fv3XlmYq_gRglzCM1eNxbdFdlIPqI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIctBnzf8KvQH29R9ONLQPZeKrtKUeeX35vXKA3DaLrsA&oe=6AB68E0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfma58IOGo4Q7kNvwEFfahT&_nc_oc=AdqvmPkwIHPrJGgXwgXrLQMa90IXrGYYH4RgSzgX4GUWGjYkqN5d17BzqDVVVbu1zkk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvnEvh3HYw6_ahZaghU7NZ635jfE78N-IPQ_ghoD6WTg&oe=6AB67E02"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
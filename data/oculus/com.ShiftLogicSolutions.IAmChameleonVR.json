://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI0trhkc3sIQ7kNvwFpH5Ln&_nc_oc=Adpd47nYm37ZEmEgQtL70lSFYOXPo6xlnGa54t0u91KyfzJFlA0aeILWYxlXP7QNMbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKOO0aXSVyNiVGh1ozndNtRl9PVx79kX2-Gh_6sYrcVQ&oe=6AB7BEC1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW0ckS3zyX0Q7kNvwHNU9RG&_nc_oc=Adou4jV5q33In0nTcaPk65NyLGTNw7xQs8NXeA7gQXE5uySwhbLuPkQAq5Lct4zBHDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqzQaM1WtMavjGeYBn8WzcLa9s5ZLtjGMAq0iTW7Tjbg&oe=6AB7E147"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yCn6wmWlPoQ7kNvwFj-8e4&_nc_oc=AdqSLMHUgfs5ms8yhL8wfV8xAs36zrrGBMdHFQAChyig4L5tOpoKg-56GknZHvYa2qM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6aYZDs6sAM3lsyXFOukvabVTxkwqcSvJ0rnfspmvBtg&oe=6AB7C1CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MGI1T1sU6MQ7kNvwHJVstJ&_nc_oc=AdrAu21tPA_gzeGEyJ5kqZNEesUW0NL3K7U0_U94iXgrIL74YLtQavmSW_KO79-56-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4luwlutjVY2XAn5MicFVQa07rrupIMilRVAtrMt8EbA&oe=6AB7DD14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9PRBy9aziwQ7kNvwFxedpv&_nc_oc=AdobOwlsfmk52zev2xe1cpq9zU0qfe3rAs_f5OKS1hI6u-4SUi2zEXDy9kO-BE87ZIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDZsyVTZqCP8Q_uhlfRHtikZ-_pChBnXkYycs3jzM6Q&oe=6AB7DF8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGHBQv7Xev4Q7kNvwGDQ222&_nc_oc=AdocQ60ND13-Id1SCSd15NoqBxi2W7du1rqp87VZ8I3NPejhe1TCPC7IRakvB0FKhVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHNGjiGomBmXtsu94_9pa2VaRu5dzYNi1jpV5FAepYUw&oe=6AB7CF82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
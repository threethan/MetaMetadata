://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwQlQlGj_uYQ7kNvwFrR3MV&_nc_oc=AdrrXW5EW0YPG9WKgJi-7m9BvAfDWwPXRV77gtZzbkvUhfUM7Zibtl5aCNlTiQ9U68g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh-lH501qy14Xun7SdoKSRBbxnG_g4lXTauaUmGOBPWQ&oe=6ABD04C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8wT--N5KMMQ7kNvwEGZ60w&_nc_oc=Adr-58KxMCg5MVfpX1g7CCGW3Pogqp4dqZK3VUkRlOhi31xfX7_JgCVMoAoBoIRLfrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHaWxF5Wul1Dr0sL37nHqt1Hc1Y7urUY0y3JvYpoBgLA&oe=6ABD2747"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ9ISMGqWyYQ7kNvwGrJXlS&_nc_oc=Adq6TGQ7rjoTrdl76gLbSNltBRi3YSNyX0pJihKyT9ukNlba83zr1iE3Rdgm1e7qWYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC8EndXlNJqFJAPKafl6p5_AFVNzasrjrLYL1pBcF2vA&oe=6ABD07CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aPFkR-hrPkQ7kNvwHkbEsk&_nc_oc=AdoDKfQ5QnbAAmaVSNKJ9DExjiwJvEKmjul0bI-db-ielCipZXeQMNzTFPSqEwYf8Ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeVHEW4wOK2q_bJpvTfwr1h6FtEGysC1xlAemz2xSgUg&oe=6ABD2314"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRUAhBVmwBgQ7kNvwFSGhCe&_nc_oc=Adq_pIM4UZb34VV2AiPB2H3nvWGyTA57-_dJJFh3pNf5WLJUr-ncKJwr2oWE4yM5uXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_vaWZ4y0javALYvX2iTpMbjZFlJROKck_u1222_DBcQ&oe=6ABD258A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WocNu4nd25YQ7kNvwE2kfMS&_nc_oc=AdrNCkKWok14uRx5tmiHTtjUGXWM18b7yda7OE5Fq_ljO9t265NFiYAjWTAI-3bz03E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCQ0qMQR1Sw7VK0gMyorsSV_4Q7xhjHEqIyaaMI50dkg&oe=6ABD1582"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5lOB-8EoMsQ7kNvwEnKhq5&_nc_oc=Adq2inR6caT03EiH-q6Px18XjdZDo2Sc5kdlBng-2bWf7O2GZFWEX-2Cgk7OuQIG1Y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYukzl5Zx7SBjSxVM4rcPuebY0cyEIiQjTao_mWrkMzw&oe=6ADF4BC1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZt3jdpzX2wQ7kNvwEnOXJT&_nc_oc=AdoD7dx9ljFP51XRF2EWFTSJ76SFDKSmUEOnVig28Re8H_V1UpLv2bC4kR1VJCC0wcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi5MlrdJ4CmM9jfcdQcCkitVRKvQq55PPl9Km-wT_bQA&oe=6ADF6E47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IAdBJlJ088Q7kNvwGYrTqg&_nc_oc=AdoyDqKuzLZn6bmLklhHY82Z3ecb1A0iE3VFDML1QKd5BxeZvSORzgbkErV-h2VlU1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-05c4vXXqgPFV-pxsrHZ3gJ1P0eDFEpuA3s_A5CXYKw&oe=6ADF4ECB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQqYIwzMZvoQ7kNvwFQLzLH&_nc_oc=AdqMRgLZ1H23QvC-D3fyeCxXP-2pEc5GX3lH7BbhdZBdN2SfNphXpC08L6mBytdXxBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5-GHxAqySIA5ZjNRRAU5WJQqKkQlqcG71Qyp5jbtU1Q&oe=6ADF6A14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MogV-of5SYcQ7kNvwEXyqIl&_nc_oc=Ado74BxS-mKIVNKN5GJclO1o1tPt3y_1JeJkn39u9alJr12W7EchXKyaHheab_fFE7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZmutcmgLs71gjQjo3cInd8YYVdaPAbpok8RsXBrz-Bg&oe=6ADF6C8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSObJ0c5kKwQ7kNvwHmbOzH&_nc_oc=AdqdmXqJRjwnelYXUQjf8zsYQioCttTWiQtMChdykg92EBqqyZTweTcuTJsaZBT_KDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmEZjVEbyzHUjVT5tRYvInk20GUMeAT0sugIZaApTnjQ&oe=6ADF5C82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
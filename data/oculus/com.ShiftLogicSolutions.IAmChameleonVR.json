://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxKEEp8S_SIQ7kNvwHsosJM&_nc_oc=AdoZDIg8mSwdE9WLiq617fEwQo1AQJgvsdL8spYktg9rKC70NhLWyRSxg1LMzrwchXs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDMLyBWrzNvcmRonExLaBgMiYqYMuIZhyb0Lkd5mE59Q&oe=6AE8BE81"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwyJUrQw_fQQ7kNvwH2jcvk&_nc_oc=Adou3eM_EmigTl2T_SbOtCrvkyFFMeR_eBaDA5BEocFjsUJrgctVN17n4a8khkl-Bvw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB1DzTsgp-BbTzP8mutF0XAPCTHbs692qNQSWf8pkNeg&oe=6AE8A8C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfkRALiiRZ0Q7kNvwEFUg2Z&_nc_oc=AdpraZE1oSY5lnHcjmIk_nH16_x0IlLbDNBnRzgI-lNUM3RhHmkbIoLG_zGnM3ZCtVA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwpj_zLOTdPrP8Wj1rQ20elEjvrgcx5Vdh7SY46Gqk6Q&oe=6AE8C18B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7DFGfS1l28Q7kNvwEve8U6&_nc_oc=AdrJT8JtW_Y25OYIls_nM1u7LAakFnWgzD3JsbDdRplgs2W6jmggmF5WFMfJIYxVkfg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEOqQ32TQE8OALqhGj0UtXN6ydyaX5Uzq9XS-DnrcSqg&oe=6AE8A494"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9pRfn5yp94Q7kNvwHsJefq&_nc_oc=AdqsX6FzbSkS0qnUE9wkDtk0CHs4uN3uVMMf4e1-iJKA_iwWOMUexNb0-gH_YEoDnJg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKG4w1H2x_D42oK6lyigevEAt8SQwOc8a-hQU9kzzzsQ&oe=6AE8A70A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXpTUcKTVgMQ7kNvwHC11eC&_nc_oc=AdqxwMMzi0JgZPavqNCsEMuxbsB__tXgiPQ_yNoYaWb_8RoxTlgqJCRL849WLVb1qLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD7monn6ZSr63ZH6t1hPBUSgJ8AyMgCqyYJdBPX_uqZw&oe=6AE89702"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
cdn.com&_nc_ss=7f20f&oh=00_AQRC4XelCAy5TvBb6IkJwgLF1vIqh0A8Qr9sr6Y4VaRjzQ&oe=6B085C24"}, {"file_name": "SC2.png", "id": "1253313613402591", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310646_1253313616735924_4100123582290774432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj1-mZNKuiIQ7kNvwHKARaz&_nc_oc=AdrXfODSCGC7qPhq2x3PA7BhmEzsSQjXwHHvKB6vMdA_FynNSPUh4qgmyh6G6zC317k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStiOnSCn_WMWuVM0VfWgtAkQjSu2aECwaMjiOxkC-R_w&oe=6B085555"}, {"file_name": "SC3.png", "id": "1928269847872490", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_1928269851205823_8434264680361748878_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdg7ZBDnyvIQ7kNvwHlEvOY&_nc_oc=AdpQ-GUgO3Zx__If7QT2xRxMcYthwXIBW3qVRlpWZts3pMnSUIFAeL8zG_sHVZ16Vwc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIuoW0uCUI37nGydHF97vH1zHFH_vvA9XvR9iIehCXbQ&oe=6B084970"}, {"file_name": "SC4.png", "id": "879061081387166", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312470_879061084720499_7568711587934158013_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb37ZNvV9e4Q7kNvwETQtIh&_nc_oc=Adr-2G3KTUa3KhHKtl7xHoVJPokG06LgRlVuXhh86nsqdo25NqdTq_aVZRkyvNsGEkQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP44ipSiesF0DS-A0Tyq5_bo2sqovnH60DkwTAZ6GE0Q&oe=6B084A7C"}, {"file_name": "SC5.png", "id": "1521691042166546", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499311597_1521691045499879_1196373838991986073_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X16JIDi6QroQ7kNvwFI6O5I&_nc_oc=Adoj_y4FjBEEdHURAyDhpunX6bVClo55BC5dpebJhEZcPe9PIDmarotkxSdCcpO5o1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxlS2dLcWWzdPYxdrG7Cfb9-u2NF--oY_F8s-BuzTxrA&oe=6B086EF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "multiplayer", "gorilla", "animal", "social"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a brick wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.", "short_description": "Blend in, climb fast, and outsmart your friends in a colorful VR hide-and-seek game where every wall is a chance to disappear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shiftlogicsolutions.com/IAmChameleon/privacy", "developer_terms_of_service_url": "https://www.shiftlogicsolutions.com/IAmChameleon/terms", "publisher_name": "Shift Logic Solutions", "support_website_url": null, "website_url": "https://www.shiftlogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category
://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa1hlQSa1VAQ7kNvwF9-zuw&_nc_oc=Adrw4mqsgypQdg-Rm5XJA8FOBo_vQQMQMs5tyOb3XoUBxMwIONJLYaJH_QxWjNvJT8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImL0gHwFYbw1CNenbG0rD1rzqg1evgN9h85t9kZ9aynw&oe=6AABE141"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-eDjc_JjUIQ7kNvwEOVPeL&_nc_oc=Adq3tmLL_JMmJ9Zas7Hv_Wp0KQmRonO7dqhbKcoF4OeJ8_oSiLWaKf7q-J6_HmEGsVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhuC-gCFdX-hw7-QKZUytlQxUN96f1Kc3DOcoByrTxaQ&oe=6AAC03C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz7V7XyLZC8Q7kNvwEJZ4v0&_nc_oc=AdooiPkzyJOhH8BURGRrG_7Ysnpl9PVQO-OPkWmvIVGR-Fe5FzTPnL1714Ma3YJQqSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzJjAdgdt2v_QmVOGwLZUZ0NCWdgEmEEV7MxDREWq3HA&oe=6AABE44B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2bHe6BrojIQ7kNvwGeagQN&_nc_oc=AdpmIEyW7GPD_t_25plqw2ZYE1Qes2IS92DEYXMgs8UfCHe6hn5mOfGlgynliqkIxPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUgTni0aGdA_DlMZn4LqT_3wcCQgvh-t2PCKQEWzRWMQ&oe=6AABFF94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciCdS87xWkQ7kNvwG2Akr_&_nc_oc=AdqcY7zKqVqCQ5Q4vvg2RQTsUaTZOFHdfWQrgzombYI64VqmqK8MW00DvamkKJxfDbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC9LRUAHqrkl6_PCUld-KMNWsFTL07A9if3o73tfYrQg&oe=6AAC020A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnfeJ4WDz4gQ7kNvwFyZTAr&_nc_oc=AdqUoJ6A0LruUseXbyMqM5SBqvpVCIEQsaalXgDUYNpgsMJqFGIwLK1oVGzeAhUQ6R4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFag03yTCHJJYLEg7kpJb50s4QAddQTw4FAmVBOpUVQw&oe=6AABF202"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
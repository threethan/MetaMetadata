://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYMJ2N4D1DUQ7kNvwF6keuS&_nc_oc=Adppl_tpwKcrReEGjMzdOEG3Qi-hklbepspgajU4fR4MID-2nbduOPZ52fOcfHF9JB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5l28U0KsxEaeK7OXFxokX_rAcE50yaellELv9T6lDeA&oe=6AB91041"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kDOCBZ6aqAQ7kNvwHwoNVj&_nc_oc=Adokw_UTWBgBPQvJURTG1vIovrGU3FGxGYujuXRc2ypIo5eEMV5tM8w28FF_EzoKLyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEujdw7I1PdRVqKXs8OMhuJ5g9VncK2sng3U1PPnYFPg&oe=6AB932C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WqExygtRJ8Q7kNvwHWUwPK&_nc_oc=Adq0k7pl0wT2a5t64gN6meki3SQ2mEJam9ao9hLij9dT64tTG-06iXhIfUGVlVSJN4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPAcCySEKAqD42oFT1IqVQ20OhMiTsvBCX7idTx1xmeg&oe=6AB9134B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWBMJpWTU_UQ7kNvwGPt0uc&_nc_oc=AdpBnSomzUE6oVauJnT_yRFN9HdyhwbGjM0NZ3cTB5HZasP5FW-ec8AVB1mFZ0uVlJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3NTeZk9UUwSvYB_g9CcYoHN4RjPocguO0RzA4f7BHaQ&oe=6AB92E94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9PRBy9aziwQ7kNvwFmvt8k&_nc_oc=AdpHJjFnsHku5No3yEizG9kvBnPYZDy4QUD8Nj-tJlKPEP2-LymD_jaYTTA8QPXic8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvqRp41zB8o_8eB9Ml0DQMys0Xb4hFFjddcSnkr6ODxQ&oe=6AB9310A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGHBQv7Xev4Q7kNvwHw53yG&_nc_oc=AdoRIr2GmvbsfrBgiStgZyP5M7KRgCIFVNutkW60yESWjukA-JjlCXfZfnV9Cln4lUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWNx93DgA0lfFzemvSSz9t-PWzF6NTkbNZCTmhO08Obg&oe=6AB92102"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
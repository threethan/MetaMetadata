://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7_mSI4EkNMQ7kNvwH61EZ_&_nc_oc=AdpoI0tXN73XUafVqTWPklS1LPOFn8pL7_Liw7TI9_khAiQ7shGbtkWD8AyvHT2rbR8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL70BEU3nwx_wyzTmX1_gxPDbQkmTwtu5NMkVlrIb0yIQ&oe=6AA15541"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m9TUgtBU20Q7kNvwEQ4Exx&_nc_oc=AdpAZelZUn8qZ8C8q3cz07xr49PGaIJDG_EpEilAhoHaj2rfcd0S8-kSX92FTRMu2ag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJELFUTf-OHe6_I9uANhhxYRxiX53BSdYv79qhB4gbopg&oe=6AA177C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4UKc6MAfjYQ7kNvwGHN_BY&_nc_oc=AdpTeGwdHjwdqiKB5n_wrFAyRn38HjZ6hRimBv70blwkE-Lxs2R7OZmMyxIzEPdIf14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHEGOc6ktAwUJEov8pgEflMNGO7PfPt_FDi7jJlkPrtQ&oe=6AA1584B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ48h74Nod0Q7kNvwFT2DYA&_nc_oc=AdqCBA7l2wH0Pn3Ya9hYSEoLwE9cvZTQUiqByAThnltWB3sdKtjcdiXyflY0k2US8s0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF0irH5ZB7vwXsBth-Xy2W9LfJsmWrUyJLgynIjiG5nA&oe=6AA17394"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV9Cj1S426wQ7kNvwHF7CIJ&_nc_oc=AdpSEjMQuDyvDD59ADva7Nev8DuIt_cMzHwxoiZMuhvhV42Q47T5_9w8eT3g5OLOoUg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWs3AWVqexex59TY1d0FnJjh8jskicmSkZM_5W_CEl-Q&oe=6AA1760A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmAu8yO209kQ7kNvwHQOLXV&_nc_oc=Adp5kXTCvKQaImxNFJ-0xR4zm251Q3oHbbUqsyM_-vLJmB7o7ihnwZ8wQThtEK-I4AA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMA7AD9mOJrO6dKZ6qDKeUjSkaRIiiihzt4TdaJjTktA&oe=6AA16602"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
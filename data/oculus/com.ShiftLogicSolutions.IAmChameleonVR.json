://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZLCRISaSR0Q7kNvwEVuANc&_nc_oc=AdqF_hmOj88p0d4gypEPXYfsGlvzFkRpMB-USl-uYUnEhquv0Cm49A_ZRWxswZ6xXZQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOpdx0UFUDRvKbUqLsKMmn2olsvruBVWdFyCjc8v9xqg&oe=6A9031C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fiddlJ7mosQ7kNvwGdZDDC&_nc_oc=Adq6NjVI7y9DVhGSJYw_SsLRhaorkJlaYXaIZYTogC7dg1W5OBD4DLymnQFDu8WYjLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE39o1AWK0UvA9SZu3QQHrLVDNdZKw7msky3_pliUTYMA&oe=6A901C07"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GWcuebXiEwQ7kNvwH-nXMa&_nc_oc=Adpfo7hINUWDc9xZt1R4nHwgZM87-oCdB_U7QUrjo_KEVaJ8NNZ-BRYlPKhhBpPq4PA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ__PEL_s-fx-A21uZu8Es24nlrdgYJJka1uyGtJqFag&oe=6A9034CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkwoGWTsVPAQ7kNvwEPV2aJ&_nc_oc=AdoBtIqvBMmx9e_TD3WnQLHVPRE8n4Nl-5uFbt3Np1aohNl9um8xz_myQREtOOpITX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv4LbPNoLCAozONrxHMSwEPUVNCWoYu4XFY2UpUnWBKQ&oe=6A9017D4"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP6uYaul9swQ7kNvwHOlw0m&_nc_oc=AdoqufpkYmdGsxuJKmlu_k7W9DwI9Eo0JWjeoe3cg3M2IzL94HK0tGDdeo5dDL7KnYc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaz6mO3Z_bTSsNQfWZANg_hBv3CTMQueHCd6zQOMdhzA&oe=6A901A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3q3SEjzEWcQ7kNvwGkw7mO&_nc_oc=AdouytODqONAfPqyhNpV9mzP2RbwalcjmGeeSMtCTj7mlmEs19DNxHLvD8x848RTAMU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyhrYS5N7ZP5edXt4zdYBhpr_toezxIlm4_shhXhvbJg&oe=6A900A42"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
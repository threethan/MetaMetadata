://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1av2gNsFRkwQ7kNvwEg85lz&_nc_oc=Ado3ZMOJRz295ZP3VJny2ju-u4uVjWrkhGjBLRXe-7ecOlIgsg8Mf7XVh8eomL_v3bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlXo72hJXVdx1mk9stW39dnJnJtksr0s4MCwcyvBJWOw&oe=6AF89081"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3AXdA7L3vkQ7kNvwHDPhQF&_nc_oc=AdqLPnmUbBvIVyxGs3JiW7yCFt0es4MYOwunfIfMRg0fT7NcBTav5mh4HE2PghcOKaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0J6Hoa9Q5-GZkYgmeOqDahUMaSO9nN8HfV-JWbDl21g&oe=6AF87AC7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvVGF3pnsfcQ7kNvwG6E4W5&_nc_oc=Adqkh0dEV1TuTdigX_2b8fG1XlO2pU6mP8fW7vpHP0W-tZRXJdWrWX_Ou9swG33Q-j4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgVxRFKoC6d-ukAA0AFAkUPHNmJCsauAOekQXrSpjscQ&oe=6AF8938B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsMfmK565B4Q7kNvwHKNJTE&_nc_oc=AdpQtxr5G9RLmwjGD6_Cmym2XQOIypxkJYY_D4TIuzx9CEmy_e1LdVzRY4BRbGWc6JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNbTWJaZdMOB5ZlTPP9BgaEThZiJeNiu_XzuqGcM4Nng&oe=6AF87694"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKbUyj-AJ4oQ7kNvwF-Y-6k&_nc_oc=AdqyRcDzRJCyhvbnT4Svf7luFcicYDBv-qGzodbnlArsCZekInsfzfdQvDbNN1LGrps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbOaqix23KwsabqFmx2n0s-1IEDhV265C9tIzYpfWzeA&oe=6AF8790A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_lbPmIwHToQ7kNvwFEsRHP&_nc_oc=AdrQ8YEEuOy05IZOHhuEg3I7LKoqbipx-kEUpxL14ilVHsmhdNCKDsx6G1kQjO_6QCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFzM2RHgxS2VraWXD7KKWOhoxPj53cuFXWgyFP7k7vdg&oe=6AF8A142"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
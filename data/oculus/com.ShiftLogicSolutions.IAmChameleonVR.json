://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnhTa7XLYGsQ7kNvwFPe9eH&_nc_oc=AdqtRlKt-u_hVlPmywSczuyhB878iQWoDUy00rDlb_fRhkXUiezHS3YKqQHdBluqg64&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgkdWoB8dhfsk56rDqKmdQomc4SPnxjnhkkZHejiaL-Q&oe=6A9AF601"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaCxGdFUaAQ7kNvwECRShT&_nc_oc=AdrJ1LrZ_qJbydiM6T2AUWh_JUQcEAj1XHl1aBAMAJrwKonv5qyWyy3nZBlZO3OgbMs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHjx9M0r6LlmNYZ225e5i_ctJtHZs2Z9kctsAl9wTQyQ&oe=6A9AE047"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOyfG46iS4QQ7kNvwEHBSB8&_nc_oc=AdqX0nWlWzoqXLRWMgejEx-ZaLMm_EMUk0qC5dxj_wlWpus1SuiJbKf_3_tlEAf5Tdg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUZ_zL7HrAJLqz9mwAMG8Qj-e3g6yna0kgmCAMoHEiIg&oe=6A9AC0CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN2EXRyu3VoQ7kNvwEJNynP&_nc_oc=AdoLy-UTZ4xmgQ9pIAlgNU0QtslH9KPttSze2V6SqNEz5zQ4HnurBPsqIIErqZCow6U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ23zfJR6Yn9EweZwQf1hNybUPtTOFb-78VL7LqyCBEdA&oe=6A9ADC14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_VY5r6ODWgQ7kNvwFxI8ws&_nc_oc=AdrFRo9bpu9R9wB8AXbScnA8fu5HEx2Ymu6yjClAabJz5bOQg4IL9KHJ34TJmK1q54o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLUdg5N0mP6J5EHVUApoWRNMMLg_4Tig137Szue3Wf1w&oe=6A9ADE8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKymze1cLOgQ7kNvwESuVbR&_nc_oc=AdqC5y4fHOTRMtr0gnL5Q3OgaZlIgPl_SiQPfTXBO1HbZB-9fEY3hqr3MLZxgZzcJr0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIrs0JZjqy4HIkKjuMMPx1jDtbEJ891LI_vjst0xHdeQ&oe=6A9ACE82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
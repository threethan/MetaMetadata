://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6LrWivuMyIQ7kNvwFv_B5M&_nc_oc=Adp4J8PSu-ipCabb-FeX9BcvDXuC5DLa6RazuVpPvFnqCZa552w_5eHXuR0JMhqhK8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnvAvqpCT7rqYBhM_Eb0i55z5sO7nKtcMBxepODlBRUw&oe=6AE5E341"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je6QEwRNaU4Q7kNvwF-BW6Y&_nc_oc=AdpHqfQ47PWNEv_OVci2svdkMdvbDbx312OijQt8kzxE8D02lTvSmSZpxQ9219ghKMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx89iG0PcS89IbTkLZXfFXTFh1Vx0iQbYLIKmmGMZ3Mw&oe=6AE605C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ncE-wYm8DYQ7kNvwFCDnSg&_nc_oc=AdpgPk0LgFRaV5QCcSk98_jYp5eb0ScZjhe3eQF4CIEmBFldh3EqfxWfihWrK4Mqats&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr2N0zEZ2XV3PjTdvp-ZEAVObs9FzviUjVbCtej7JoQg&oe=6AE5E64B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjDTcgCwA4sQ7kNvwHd2lFH&_nc_oc=AdrrP0FiF1LTA3cpxhL2HXTldxOAdn19NJ1M-lGMdYFS5Bi4f-7I4Pr8KOFYLPr_BHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuF2LfSXY1Gmy_MCmA2mmGng_XpIxGPcy6NNgG6Q7Yug&oe=6AE60194"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9pRfn5yp94Q7kNvwE62ZJ-&_nc_oc=Adr1tFpdesM5xpcpDDqaxf2PEb3HIqzBmaqbe38rfK-OTPW8wBmlnUNJCShQcNRpd_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz1OWJ_LKCEWAVzfmmr7qHDme8oKWgKSMbdTzvX3n4rQ&oe=6AE6040A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u9mbzJNFikQ7kNvwGQM7SX&_nc_oc=Adp7g7IapUxx4zuZK8RkPNhY4gVoyX2HgkRZeWPu9f5_zoHpa4PX9FH-ggFmZqXi2EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFU0Lw-tyruAxWk74nA2ZKSVy3Yw0EydXiRkvv0FvBNg&oe=6AE5F402"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
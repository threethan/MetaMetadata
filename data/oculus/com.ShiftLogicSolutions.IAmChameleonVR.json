://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX6HcPxcC1sQ7kNvwE-7I9Z&_nc_oc=Adrvh9yxTXpOjw702XkvKWjHMUe62S_Elzv7uYNnOkwZXEJWTU6jMSMC5-Yf7cgsusc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPZAlJNG_09Ob-pA-Ta9GcEZFHNrk8vcJlTiMeMxseRQ&oe=6AA003C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oi5cc6WMA3UQ7kNvwFfPDxX&_nc_oc=AdoAl-lu0caKA0VGqoHlJ4a7oeEWX3lFb9Q7qfn5ql7e6I76qdG5YUjzpO48zQP4OjY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzHH46RvWGccPaO2VDsUl967MbI2RhFqc2Uke5uVauZw&oe=6AA02647"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw_N0sH7Ae4Q7kNvwGX3glL&_nc_oc=AdrHD9zvKCOlinAV6PA5d8uWWBxS7zczqAz_vrtnyBLcmhTd02LraImweVlQwHLgvtE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD2xfSlCvx3bfx29VCRqXU2omIlCo1IWmBOLoGaL1UcQ&oe=6AA006CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkYvXOltDAAQ7kNvwGb7QJT&_nc_oc=Adrh-H_jxh-D-x-rFqonB8Ac6Ry02F_NbFqeNowpC_4T2lM4KspjZRDKIIoGNY49S7g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZJUoL0smHK45Wf6SrSE2c0pvnrVDO81FkvGOlNTw1DQ&oe=6AA02214"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV9Cj1S426wQ7kNvwEEpvmI&_nc_oc=AdqiZUyAXDLMFFmTSDA_IiemDiJIEs4RJA5DhnFCNnpwJ8msunqhr-AZ8PMWz9LglSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_FMOD2jzcfeih6aUk9PLgjQKJGDygVezFbIWAn-ennQ&oe=6AA0248A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmAu8yO209kQ7kNvwES1BpP&_nc_oc=AdqFrbbdckuUDjNQPSoyRrM6yHuFOmmr_v7DSzjwBrL6pBfjkb0--Z0daRK2Q_99fAM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg6lcNWeCsAJICALN5F_hkBWHJ9GfTZG-tUzN2LP1rZg&oe=6AA01482"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbEpJxTg0GgQ7kNvwG2I3c1&_nc_oc=AdoDgqfCE-6cN07l5FOJXOHpigJKZtH1AgSZFE0QKQhjRFJPg6gXLPQBJnnXiPkFlbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdHjMo1QYBPiAsF-PT8KQczbRZ7t_9Yt-rMb0kXZ9tyg&oe=6AF0A781"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4h7Cgv6QH8Q7kNvwEXnnXL&_nc_oc=AdrMlsVoBa1Utg8H_LxIEWEytHz2YjehrICdtdLIGvD-FuY5CCMvuHSrdKmSYedteZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-3-Vrd3wLACUV08Rj0RoVBj4giOywoVBif4E-cMQUNg&oe=6AF091C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWJoPeZD4JcQ7kNvwGJgzK9&_nc_oc=Ado1Li3HglzT6xGaU-XNPLt0z2bCsiiMzH5MB_xhaiYIhKRJHha6y5Bvzq8MaO_JhZ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1tvsLhVoals620kRrNCzXyJR-iCcDojii_N2Mw05zbw&oe=6AF0AA8B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkpnpkawoy4Q7kNvwHK5PFC&_nc_oc=AdobVid3ux1i6asj2I6V92kGsaTQpZcwBpoeMwzoirB736ca6Ms5lJn3fOwhPnbatB0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJhwo4Ehngb0Nh_qtztepKzIZuD38i-8E-J8futNZQPQ&oe=6AF08D94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTyC16rcbMsQ7kNvwHIM8aw&_nc_oc=AdpfkRP6qqvwEoeWdQuJvVqpkIKCA2M1NzM6HNlVq3sZwh0MSEFxZzkv8eouIn8F54U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWOm8YZWG9lPQGX4bHtP9Tt9UgFYlQTIbVYrWQ1n-Zvg&oe=6AF0900A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4B-oEk_xAUQ7kNvwF2Be57&_nc_oc=AdrMnj1LRZ3exSocgTwVDbe4OrR0-p5cgC5kVwsHv6xkiLPrzeUjGCZfm0z2q12jTXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAa2TwDgst1mUH3aYnMdoAGFDLHrbOQtvZXQICwPJ_bw&oe=6AF08002"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnhTa7XLYGsQ7kNvwHaEOHI&_nc_oc=Adrz0sL0LAph38-iPCx6h6ZAuqkGFdRAqYe8dtdTknpALNnQYKc7t9L6qWM949495y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV1wVhnU6i-1ZiTDl45ckD8oi9heeQLJNyfxZN0TPZmQ&oe=6A9C0F41"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaCxGdFUaAQ7kNvwGBDA_z&_nc_oc=AdoxXLrhyUCfuf5g2a8XLfz_K-4DPH864dAPARE97WV4J_5-qf-58ARSGNZNj4_cflA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS_YO11U0ucxWNu9jpmvPYlohnvTz1NO5TrJSPK8pJ9A&oe=6A9C31C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOyfG46iS4QQ7kNvwGOQIvg&_nc_oc=Adp2eNm6JiICjPMYUs7YGEZB8KINuQPB2G9R9GOaQ7egZhK01m4QLN4bCmHZyzRrhxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLZTjUvIaTMnkptvd2dCBQEvAdZtKsRjbWqMAucinwlQ&oe=6A9C124B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN2EXRyu3VoQ7kNvwHY7KRr&_nc_oc=AdqUKNY2O8fLYCFkHfE4esqHBNAO2TmbFLnHpIDsz5v8GvSy-Kf7Hzo_ddkxg8yyhsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJNgVXCFxU1JrTkT7n6scdc5lXdcPy1afixm3kidWwOg&oe=6A9C2D94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_VY5r6ODWgQ7kNvwG3JZpf&_nc_oc=AdrQ3zQcCYEj-NpnljCuMpvVHDXQuolceUKUwQQr4QPadR6wa5k000TaaKtjbfCe4uU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLKLvf1sXY1HsRN89BySOlX8XrGWuokUUqu93vtWtUrg&oe=6A9C300A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEDRq566T4gQ7kNvwHXNBN6&_nc_oc=Adpz5BmwerB7n6WqwC-ZoIXmBgHVLD_adKYAVdGtE_AZMsiMM61CBY4D6aNmOY-lrHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJClvqJG85yiqQYP78jPL6gEdbjcZP2Ry65ArGiUyJwUA&oe=6A9C2002"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
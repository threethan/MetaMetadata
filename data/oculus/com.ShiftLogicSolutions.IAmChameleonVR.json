://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX6HcPxcC1sQ7kNvwGWyy2E&_nc_oc=AdpcGoJ-2D8ZEbpsO7PtgM0QH37b2wjVNo8CVgzHnthWmb43-bMpVw2l-i1Ur1Jeo2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtkFSviglhPnz_EOsKxBB7XAdBR1UKNgGd-BJWNKbllg&oe=6A9EB241"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oi5cc6WMA3UQ7kNvwHrRZJx&_nc_oc=Adr_z7enV5NSvCrFbVf8vURq0ERljHKuxxXVcFx6Mc52WiHjwxtKxyDlyWgU-OdYbTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFS71AnQ37kaI2ntqiYcu5iKZyrcGzKRkdnymvbHtcSg&oe=6A9ED4C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw_N0sH7Ae4Q7kNvwHNEZwB&_nc_oc=AdqW77hnDQ0v4EY1ummyorsZ0gcZG5_pzCQLDSKlLK3wDtnkKtW_9g0SdMzEoqjye6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOirREmozNHJ5v_v1l0qVutTriCdlSvNr69NrKylOgqw&oe=6A9EB54B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkYvXOltDAAQ7kNvwHgLSqx&_nc_oc=AdpSvY-iQx653oDx-Zlgxok1nzovS6xClX7wmfF0WfoyEGZ9-3peg7iqpIFeqANVfxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYVLYETl7dH9Sm1Hx7s_7d0EqfbPxiAs6tsDlfI9K4QQ&oe=6A9ED094"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV9Cj1S426wQ7kNvwEWOaFR&_nc_oc=Adr8gZwf9R0oJ41tu64ZqViuIvsf71EnVZ2NT7RGu_7OwO1gkV-d6fHrdvlXt-jgRLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpBZZWYgbPuggOKxjpB0lc-Dk7KXqoheNuEEZUdpazNA&oe=6A9ED30A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEDRq566T4gQ7kNvwFlJBSc&_nc_oc=Adq83vW5zJrhFcykyM6D4DioN6f3-52gLKuRcQDxEPP2kMhjgnmPZMAxI7t-ADsmRgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy2r3Wqqjl1FHftr3WOXHcniBOTyl28ZKefCCz_9AkSg&oe=6A9EC302"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2_WfB4pb4Q7kNvwGEzhhr&_nc_oc=AdpJXdKriJJaSlj2nAvvR1knBcVLk2My1ojpV7MeyGoLkKVk5NIFxruRopIsFJewpw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwAE6Be0QPNaBPfNZbGCY_sqeYife0J21p2BKuPdDUUA&oe=6AECB301"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gPo2cdKzbQQ7kNvwFA9L7C&_nc_oc=AdoiVaVtZbuMaR1qfkpbIrRlMHyO3-non0sM6dxKJ7K8yJ6XzwrKyXCDMDOxdRVvrNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBZoKpLy4vcoJpSfU3Zr6-j0delFeeQvLdcoou6kL5zw&oe=6AEC9D47"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1wS3LAXEl4Q7kNvwHn2j6B&_nc_oc=Adqmu3wQ9DtmuCN88iboT84trzFNWsRds6LUDdJ2gUQdRoDJ1gOWCwLrUOw_rj6YWlU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw2GiWjhfqVVqgVWY4uBQ_gDvStRIQA0Jy-ix_-CAsrg&oe=6AECB60B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brHtlg_tbp8Q7kNvwEP9Gc6&_nc_oc=AdqtcUHDPAUhgjJi4ykVxRx8YaTNP3p-0kEuPavapWnA47bgVoGpYzFKWIl3GhERDdw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo7bAn3HNqWAxkkv21bK_6vofhME18bX45RaKSD891og&oe=6AEC9914"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnDrdl44fwAQ7kNvwGRgATM&_nc_oc=AdqnpXmor2OcsDSVl1B39-iGW7CmNKZg5jR9E0pyOXo3iYwFYPBPNFk0zEdFp-LJpXo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaKM9xuGmD7wDct2SCohqxS_XXKp--zkfia7eP-LbmBg&oe=6AEC9B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLGWrpEFLZcQ7kNvwFDkDsG&_nc_oc=Adr4_Wl9twKCc_DTM_8UynM1bE7y8zF9doX_Ei6YMCKu0C3rno6HXljk7PJaGWTsXGM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxvQWGo2DX-Ox5FwfWemvn3AqCQF6tDjCgcC8kg6vNZQ&oe=6AEC8B82"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
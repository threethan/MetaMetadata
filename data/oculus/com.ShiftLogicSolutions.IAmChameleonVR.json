://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX6HcPxcC1sQ7kNvwG1tBIn&_nc_oc=AdojSEAGvuN5vURRjH25TSYm0Lo4sXKi6o6uJvWVI4OTcg84I_Yq0EsUlmSE1HqYLOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOQYaf1KLAzBiqLDg9IvDWwKnGjg7hnsKH64eOuoFfuw&oe=6A9D60C1"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oi5cc6WMA3UQ7kNvwHkhwUF&_nc_oc=AdoudWo3ikV6JaJypskSwJQDkrGbkXLp_CmZEU9XKX34wBjK9KUAMIuF3gmAGVNCoH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaWv1LhXMDvW1UMEhAEd_eDicKqh5QPFCr_3oeYeEeoQ&oe=6A9D8347"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw_N0sH7Ae4Q7kNvwEIHe0J&_nc_oc=Adp4ZkuNt2OKoTNCal9hRDy1by7LinKoAQ1j3JrGYSZqO9JKmTrF3ecLRIzL_01k5Ik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdQolr1OjJ9RZ4U5Glmu3ryfoVRItcqeHPRoP5fEb3dQ&oe=6A9D63CB"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkYvXOltDAAQ7kNvwFqHGlt&_nc_oc=AdrP4JWqM0BpzrirqArzjkP-_T6x6FvbXAuy--SpQx3fK3sCg4gg4m7OLQSgA_oANMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKORdaP0WONWF5034w2cyfJHwlkt8joscRVXAM6RQcgNg&oe=6A9D7F14"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_VY5r6ODWgQ7kNvwFNB4Lp&_nc_oc=Ado639NbDQo4zXCt2Zv5EPXokfoXezuFRN1xYzpbIxrjVnQfYmQ-z-ggwSeSVVPn2A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe_bQlQElBtUqAy117yqezw8P43OslnaMHHh1MKA-wSA&oe=6A9D818A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEDRq566T4gQ7kNvwEgp-3e&_nc_oc=AdrnhbX73jTk-qTzCv2t3zBU8Dw9JcDS99QS2wO8TV8GCSzjCauyUKpVJPu919J0Qg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqemPPUkeGOd9MaS-5dhF5kOE0gIyd52oP2zu1C_ca2g&oe=6A9D7182"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJcKCTRQOJ0Q7kNvwHYtt0f&_nc_oc=AdpEvHnM64LIeaYX9Hy602RXvRTssBWSgrK_zgNlVsv4FETgPdH3Otf5u-5dDSM7DnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmeRrd6g4zD_jaUTedK7A-kKfnvO9k28qKOtyHcVYk2g&oe=6ACA6C01"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixd6SGbHAusQ7kNvwHnISN7&_nc_oc=AdpZquJ9KMIS0Gsc9klYSVHfS-mxPa-c27qgrJDZIQSrJx1HnFkW_QKUZJpgqTda0YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdAIA7kQErJOCEG6Yw2fe-O_cUtQw5XNSfyWy8EoV2fw&oe=6ACA5647"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Tc_Z8iCDUQ7kNvwEVAGH4&_nc_oc=Adoees763UYSuM_KoF3WgcxQbBWSFPhkYR3YB_FW7Iwh82rlFyXcScJiogwI474LXWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCnq6Ibn_m8y83opbEilWsX0WGTlyZ4L_xMqntXtqZvA&oe=6ACA6F0B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMruh37e470Q7kNvwGCW82h&_nc_oc=AdrP4QJVYM9KYSjgtJVRrSgDEp2SwOwttOmNz6R-VBOoAxiPO36Ji6_zWVfXjVhYMb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlcB_WyupAhB81lqGKrFz6jnxE9Cmtm9Lv5f90ncvBJA&oe=6ACA5214"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbyrbm0ZkCsQ7kNvwH_4SU6&_nc_oc=AdqTNSeNgx0f5AwqAsod5pWBj4vKStgh40n68If7xwAy6Q-GZm-NCHdHLkhbJhgaZbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTPaq0Jz0c5ZnP98VWe3j60p3WkuN-9v094ALXrBulMQ&oe=6ACA548A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alhiA7RiYL4Q7kNvwFpkFnH&_nc_oc=AdoJfhePuAkXjor2kHJ4M4aLYAzwQsHMn60mI7KuDqFrOdFxbu5Y8B-GM6sovReWba4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSCvP4npVTC5k_1LEo9jtRlQW-rqTNHAN6Zrn2cUvhIg&oe=6ACA4482"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
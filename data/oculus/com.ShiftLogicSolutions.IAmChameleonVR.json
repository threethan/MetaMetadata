://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=habNTEc7fLsQ7kNvwEtZxYi&_nc_oc=AdqIG0LNbthgAnJv0uAxU5wMb1Db9LRK68C-wEZp_7iG_0C5Vk5wNL92SpXob5rdk00&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJx55AqLOBY-MBRotasveFL21FgJrlMGInNUcunuHErQ&oe=6AE34041"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKjmldSj7mMQ7kNvwHsnr2-&_nc_oc=Ado67snSgr6wMl9k7O8EUyGejbNAd9yz4621nvS5fTy111UPBS2prWWJa2Ima_UWXp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBOGLr0BQVR9GpB18P-1G7U-JEq0BEWcWIyqGEGl7NZg&oe=6AE362C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLv6tzCJF8kQ7kNvwECbyZS&_nc_oc=AdrK1zYcw7pMA_9W1g0iTacAz-8l5SOraC0fA90PaNfj8Il8SiRJvGbffLb40oMGojQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcCCIsGQ335AIIPjb25Ak-YDVdnRMR17Wrq6QJzeFH7A&oe=6AE3434B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZUFj3HBEIMQ7kNvwHLwM_-&_nc_oc=AdoOea61mH0BdPA6XJ0CSa39UCFS5Ngndgsc1pdm2uKH_fvvrramaoxAJYTLw1WRwBk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5KrXUDe6_o7QSLMuGNbbuuBO5P8Fp-J9RaEGRJGloOw&oe=6AE35E94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAdFacjJM8QQ7kNvwHh14e4&_nc_oc=Ado8xiRQ9zKX3xg4krFHKlPQIK7KFxqM_JbjaIp9ogTsgDvu7_nUtwdh497Bhh5NMBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ7iTp3hekFQW4zZ8q-XBADAmh2Jr_DlRrVzzRRSwB5g&oe=6AE3610A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u9mbzJNFikQ7kNvwG_noUR&_nc_oc=AdqUZSI1wEyGNG4F_KAi88Bl6v4EXP2vRqxWhcIv0FwoopeudBaBEUAbfpR7Ct-hzko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_fHRMC_zkNNuPG41gaucR0xDp9Ar-JEWNDNds-U1uCg&oe=6AE35102"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
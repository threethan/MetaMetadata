://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1590197009331689_3918667823615946329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxbqrNh1QUMQ7kNvwHuVikW&_nc_oc=Adrumqe0ymzJanNF7m7baeOeOTqMkdoNnHw2RZNrCMOJrJ-B_yS5yuhJNENiCTAc6Pc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPt2-CcM_URoTfzoct-7E7txZhpZR4te_3kOw3FApAGw&oe=6AC67781"}, {"file_name": "SCBR.png", "id": "1335802562043566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1335802565376899_6726612453908285919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koiz6oXa3zwQ7kNvwH16zr9&_nc_oc=AdrBR5SSwGeljkBrq60AmDLsaqpN3i0f2DyEQSE_Do-pxv6KWXGnHpniJFnkjjL_nXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZAeM3k6BJOVH3xycH0AhbkiUyQfRmBt3JxZkCwVIMsA&oe=6AC661C7"}, {"file_name": "scdiner.png", "id": "1014260431231321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1014260434564654_8565030446383429163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noJJB8KwWMIQ7kNvwH-Kn_X&_nc_oc=Adoen25XRjHSaO4A3RIvhlBz_9DXeK4wXSYix7bYak0Fgz6tsyWWiFCxoFPW_oal_Ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODN9KNVatkEnU35YdzGY4YdDB01iiarFi3uL814GnCtQ&oe=6AC6424B"}, {"file_name": "SCWH.png", "id": "2258652971579358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2258652978246024_1674631870934416725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayRsos7ZrXoQ7kNvwEOl-8R&_nc_oc=Adq_CIHXR4NlzvdKz29XACvzeXVkVGCiG8RH9Ehnvph5scFhop1sC5oHIxNcBvaywAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDqcvYPW3yA0nxuOI75XbbZ8MTVNGqt1BygYaFatathg&oe=6AC65D94"}, {"file_name": "IAC_2026-07-17_20-01-43.png", "id": "1779416460083488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1779416463416821_7848114382926707803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PnaOi8G8_8Q7kNvwF3ZDBw&_nc_oc=AdrdfLzC10dy_DDaQiYqc7o7fFmQZX9wCgYtRz_dAqI0ffRqaBYlD_mTIi7lOBQtQWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7XzNoz1pJbF2K0jBWLXun1eGIuewUJGqvYSTJlHNokg&oe=6AC6600A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1003235989273673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1003235992607006_6067771007415352643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTy0RjFpI_gQ7kNvwE-BW29&_nc_oc=AdplbJj1sJHrJyZ8_fUyw6IUtgIRVdr6R9x1e80QH3iEO4MI8qfiXTHuxwORGIqxnNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcC4DDJuP35P44Y_UvZsHlIXXD-R1RD8iPaaMqxaTW6A&oe=6AC65002"}, "display_name": "I Am Chameleon", "keywords": ["hideandseek", "chameleon", "paint", "iamchameleon", "drawing"], "long_description": "**I Am Chameleon** is a fast, funny VR hide-and-seek game where blending in is your best weapon.\n\nRun, climb, and scramble through colorful maps using hand-based VR movement while trying to disappear into the world around you. Paint yourself to match walls, props, and textures, then freeze in plain sight while other players try to spot you.\n\nEvery round is a mix of chaos, sneaky hiding, and hilarious near misses. One second you are racing across the map, and the next you are pretending to be part of a wall while someone walks right past you.\n\nThe better you match your surroundings, the harder you are to find. Hide in obvious places, make risky moves, or become so perfectly blended that players stare right at you and still miss you.\n\n**Features**\n- Fast hand-based VR movement\n- Multiplayer hide-and-seek gameplay\n- Chameleon-style camouflage mechanics\n- Colorful stylized maps\n- Funny social VR moments\n- Customization and player expression\n- Simple to learn, hard to master\n\nWhether you are hiding, chasing, tricking your friends, or laughing at the worst hiding spot somehow working, **I Am Chameleon** is built for quick rounds and ridiculous VR moments.\n\nHide in plain sight. Outsmart your friends. Become the wall.",
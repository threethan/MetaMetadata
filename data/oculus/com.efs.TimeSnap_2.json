_AQVTKHZOZuyD1bdAMotny1aRt60X-YYKry455nsz3NwdZg&oe=6B0F08F5"}, {"file_name": "Screenshot4.png", "id": "1070156503424585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75469631_1070156506757918_7031058127640889978_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ePtrM6pg1UQ7kNvwEEEQGZ&_nc_oc=AdpvtJYqZxe4cSiEIEMczcsRQ_DVEdoIdw9qrmYJndM1R_TAPGG4T7Gnp7IscWR3Gco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZLJ_O2qBygW67ndKb2rcmJfFi9fFAEYrBIVHyaHtkKQ&oe=6B0F0CAE"}, {"file_name": "Screenshot3.png", "id": "1000999847085802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195903_1000999850419135_2011633253615363177_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMk_IZRUqVsQ7kNvwEfYqAc&_nc_oc=Adpf2pXDe6SLKJXIg8Kn7-wsjO5eBVE_EIA3YcKMn_Q949f0-VWYtEu9I5WdgI-4P2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9_D5qa38qWhkq45S2Bi1zud7NdlC8dKccJEtho70Y8Q&oe=6B0F06BC"}, {"file_name": "Screenshot5.png", "id": "879129436227444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001692_879129439560777_5455312085885919108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOgUm-IbDVYQ7kNvwEhuoVk&_nc_oc=AdoMpRxRz6Ff5nf668DvrliG_cWmUHuRMaXZg3JjJYbmmQ3jVBm2Lq55pfwnWhdPMmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVUs-1amqpEuo_lNFKYwIvixyYUbuyemAl_4yqOlrTkQ&oe=6B0F171D"}, {"file_name": "Screenshot2.png", "id": "369456564394412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75312296_369456567727745_7681999050644774913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnnLqY8_NOsQ7kNvwFQSaL2&_nc_oc=AdqNA6Vr-xrnfRzi3du_-BjvlzE6_zMuV-xWcawmK0M7GsUjKbIDtqa598SepNPGlek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvM_o9ZdcsFu1YMcmlntzCsTD9yxpSEqsejsqs_CmRBg&oe=6B0EFA90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Fugitive Slave Law", "keywords": [], "long_description": "What effect did the Fugitive Slave Law have on communities across the North before the Civil War? In this TimeSnap, players investigate the far-reaching consequences of the law by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from three significant sites during the 1850s, players identify a range of effects, contextualize responses to the Fugitive Slave Law, and explain the law\u2019s role in the deepening sectional crisis. TimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people. In this TimeSnap, you'll explore the effects of the Fugitive Slaw Law on communities across the North."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": null, "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
_AQR9aq2ofeD2bW4j5B0C0LcxPnx-jOlUVg0US3hGw5X6CQ&oe=6B0C65F5"}, {"file_name": "Screenshot4.png", "id": "1070156503424585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75469631_1070156506757918_7031058127640889978_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDi-g0BZPk4Q7kNvwEy7Sgi&_nc_oc=AdqWo_CjkQso5eAdwgG9DDpx36PdhCC6Vbz3nVYZbf45JeyNffqamDUMDWnePh5Mq0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEfYW3WRypIl1JotFEwTujQ-6bgbLREcaPDJEh7yWDRg&oe=6B0C69AE"}, {"file_name": "Screenshot3.png", "id": "1000999847085802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195903_1000999850419135_2011633253615363177_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Jq_tIdAo8Q7kNvwHq0MbP&_nc_oc=AdoYwYgkeiQop3zVNP69tgc_IwX36PBq9KsEJFNye8FmWgxx1bWnLtk4jDFcXvJPPmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlwD1ZqBAPK_iq3uGZkScx0tIxDzDCM2cELMTXQuK3wQ&oe=6B0C63BC"}, {"file_name": "Screenshot5.png", "id": "879129436227444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001692_879129439560777_5455312085885919108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3RjL3SkheUQ7kNvwG8IBMN&_nc_oc=AdpSKRK1w2iKVm1K-Wt8gcvk4YZWkqU1OqwRjbRMkmdK1FAvcd_L-_lMGvvw08GUNqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5cCzG8qCwGF-n71kbd13f9CN7OOzVhnvTZHOjyb2FTg&oe=6B0C741D"}, {"file_name": "Screenshot2.png", "id": "369456564394412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75312296_369456567727745_7681999050644774913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9VASfXlhv4Q7kNvwFBXb48&_nc_oc=Adp5VTP4oP6uswkQ5nr680jeHu2CRzWjVALRPuHxKa0Pnz2Nekx8PGe7zBB_h7OKoBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjmCM1CwaFWQf2OU5nOLZZ1xN83jCJ7IbQmFBAp7u-Kw&oe=6B0C5790"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Fugitive Slave Law", "keywords": [], "long_description": "What effect did the Fugitive Slave Law have on communities across the North before the Civil War? In this TimeSnap, players investigate the far-reaching consequences of the law by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from three significant sites during the 1850s, players identify a range of effects, contextualize responses to the Fugitive Slave Law, and explain the law\u2019s role in the deepening sectional crisis. TimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people. In this TimeSnap, you'll explore the effects of the Fugitive Slaw Law on communities across the North."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": null, "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
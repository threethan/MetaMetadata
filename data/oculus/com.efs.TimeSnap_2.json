_AQQpx9SV46mlL-do2MVM1x_tDI5GSX3iSZP8C750xeyvow&oe=6B047CF5"}, {"file_name": "Screenshot4.png", "id": "1070156503424585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75469631_1070156506757918_7031058127640889978_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny9Xtv2KC9EQ7kNvwG3a4zB&_nc_oc=Adri_8muK3sViOLhYm2G-gpIN04GiYZDvPDr8EYG4kc0uPzz59pwqumteSa57_9tlyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPUfZ1G3Psn2gPjb_eQ1PFtjTx_Pw0S-GPQJC7rhZRPg&oe=6B0480AE"}, {"file_name": "Screenshot3.png", "id": "1000999847085802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195903_1000999850419135_2011633253615363177_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqOBpl_Q-iEQ7kNvwEipJ9o&_nc_oc=Adp5x3H7c2ff-C3uqsN4XccOC-aqRbn1uxR-8q-kXnEOissduuEXnMjVudRXXemJJjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbphsdi8QhmQjv4HV6bKJGnJUA5lRwesAjWqiiyFd5ZQ&oe=6B047ABC"}, {"file_name": "Screenshot5.png", "id": "879129436227444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001692_879129439560777_5455312085885919108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGFrOk9ta-IQ7kNvwE7EUiJ&_nc_oc=AdpEOxJnO8bWDwxvVMcGuKUdEjYLYOCubAHItJdJum5aBmVgf1TLNG13uUzUPAAjmmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTarn5W2zLH8L7eVKt-g1V-VuiECyj_-F3ZfiQyQCgbgg&oe=6B0452DD"}, {"file_name": "Screenshot2.png", "id": "369456564394412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75312296_369456567727745_7681999050644774913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jZ_SrW6x2MQ7kNvwFME2AS&_nc_oc=AdryIaKXoXincKGm5qDmPWHxvm5CsvdTCCw1p0pmSFOR-PPR8csQYL3IIRj9eHLD31s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ9e14xCgvtyQLwBDK3owptOruq2Ju36TWCMqKbsiUWA&oe=6B046E90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Fugitive Slave Law", "keywords": [], "long_description": "What effect did the Fugitive Slave Law have on communities across the North before the Civil War? In this TimeSnap, players investigate the far-reaching consequences of the law by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from three significant sites during the 1850s, players identify a range of effects, contextualize responses to the Fugitive Slave Law, and explain the law\u2019s role in the deepening sectional crisis. TimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people. In this TimeSnap, you'll explore the effects of the Fugitive Slaw Law on communities across the North."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": null, "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
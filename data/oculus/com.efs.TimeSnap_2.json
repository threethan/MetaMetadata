nc_sid=6e7a0a&_nc_ohc=aqOBpl_Q-iEQ7kNvwECv2OG&_nc_oc=Adpj2QvCPQCF3mR-pC24aV07iBgu4kts1sPVcGdRIzdAgKG_L4qtog4znwuU9D09c0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5n-r0zutOJKkZg6h1YxpvUmSxyLT1Cuv1yPdvI0EpA&oe=6B03293C"}, {"file_name": "Screenshot5.png", "id": "879129436227444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001692_879129439560777_5455312085885919108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGFrOk9ta-IQ7kNvwE66vSG&_nc_oc=AdocDSjYjbxSj1Ke3-vqtNdWrAxxIpb0lfcot2_Od_twyz86LHfnYhxZ8zsjd84MeoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN4_33b8mNDCZ2TN2BUddCEVp8VStybac0QGdOex7ggQ&oe=6B03399D"}, {"file_name": "Screenshot2.png", "id": "369456564394412", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75312296_369456567727745_7681999050644774913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jZ_SrW6x2MQ7kNvwEBNC0K&_nc_oc=AdoOcYvZdxdKMiC1yYk70X6aOV4sEM5QxEYGeX5Q5bZ1CNvSpo4jHhUsZVAFGii01As&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOJTYuyVy5mPW6jn5fvp5IjvnLdZIrrFQnNX9rTh0U-w&oe=6B031D10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TimeSnap: The Fugitive Slave Act", "keywords": [], "long_description": "What effect did the Fugitive Slave Law have on communities across the North before the Civil War? In this TimeSnap, players investigate the far-reaching consequences of the law by listening to historical figures, discovering primary sources, and asking probing questions. With evidence collected from three significant sites during the 1850s, players identify a range of effects, contextualize responses to the Fugitive Slave Law, and explain the law\u2019s role in the deepening sectional crisis. TimeSnap is a 20-30 minute experience designed for use in high school American history classrooms and includes full lesson plans and materials from the project website. It also makes for a great standalone experience for history buffs of any age.", "short_description": "As an agent for C.A.R.P.A. (Chronological Advanced Research Projects Agency) in a slightly dystopian future, travel back in time to restore the world's understanding of history and how the events of yesteryear reverberate and inform today. You'll navigate rich visual scenes, discover historical items and documents, and read the minds of people. In this TimeSnap, you'll explore the effects of the Fugitive Slaw Law on communities across the North."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wnet.org/about/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WNET", "support_website_url": null, "website_url": "https://www.mission-us.org/timesnap/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4752818291502033"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "206681337683051"}]}, "baseline_offer": {"id": "206681337683051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1607623200, "status": "PUBLISHED", "id": "206681337683051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4347235371959999", "version": "0.6"}, "id": "251904766252664", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "An
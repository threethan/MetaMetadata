69EE1D5F"}, {"file_name": "migrated_image.png", "id": "563928967551082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982656_2480206575364368_5307941586233982976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNRqjkV9fCQQ7kNvwFTpvcn&_nc_oc=AdpzUFHXW_EyGXG78cEQEv-lEHCEwQfIXsTUGgMBxkSWExSBV-vzawKfH6YH4nQy7oA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37dMgJPx8j4CrQgCczAc7lXa8Fx-Qzvjg44sT6GCF43w&oe=69EDF25A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RlMNPV", "id": "430021804447533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974760_430021814447532_1107669858025209856_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vBE5eiJHUoQ7kNvwGw7Ojq&_nc_oc=AdrrBKZP-tIJXZ5W3GMcuR6WdX8w-trQG4IoNejREscr7kGaPREvo6pm1NS1gj7tokY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qZ-7tgF1Bb0eKauGsunGs1YhSnrJj5mQ5fzpnf8r27A&oe=69EE1AE5"}, "display_name": "DeoVR Video Player", "keywords": ["vrplayer", "360player", "videoplayer", "vrvideo", "movies"], "long_description": "DeoVR is a straight-forward, high performance video player for 2D, 3D, flat, 180\u00b0and 360\u00b0 videos that has been labeled the \u201cKing of the Hill of VR Video Players\" by VRCircle. \n\nDeo has a clean, intuitive UI and includes a wide variety of features and video adjustment options such as:\n- Stereo Offset (IPD adjustment)\n- Zoom\n- Tilt\n- Height\n- Playback Speed\n- Brightness\n- Contrast\n- Saturation\n- Force monoscopic view\n- Fisheye support\n- Subtitle support\n- Support for multiple audio tracks\n- Clean and intuitive UI\n- SuperSampling and AntiAliasing settings\n- Streaming video support (just paste the video URL)\n\nFilename Conventions:\nInclude those markers in filenames to enjoy autosettings for your favourite videos:\nSide by Side: \"SBS\" or \"_LR\"\nOver Under: \"OverUnder\" or \"_TB\"\n180: \"180\"\n360: \"360\" (270\u00ba is technically 360\u00ba)\nGive your video a filename like VideoTitle_SBS_180.mp4 and you are good to go. It Doesn't matter what order the markers are in.", "short_description": "DeoVR is a straight-forward, high performance video player for 2D, 3D, flat, 180\u00b0and 360\u00b0 videos that has been labeled the \u201cKing of the Hill of VR Video Players\" by VRCircle. \n\nDeo has a clean, intuitive UI and includes a wide variety of features and video adjustment options including brightness/contrast/saturation, IPD Offset/Zoom/Height/Tilt, playback speed, streaming video support, subtitle support and more."}]}, "developer_name": "VRFavs.com", "developer_privacy_policy_url": "https://deovr.com/pages/privacy", "developer_terms_of_service_url": "https://deovr.com/pages/privacy", "publisher_name": "VRFavs.com", "support_website_url": null, "website_url": "http://deovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "UTILITY", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_GB", "en_CA", "en_ZA"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "834244384639204"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "486459718830957"}]}, "baseline_offer": {"id": "486459718830957"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1565283600, "status": "PUBLISHED", "id": "486459718830957"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "266406067
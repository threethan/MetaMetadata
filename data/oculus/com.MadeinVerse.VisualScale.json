25/473393325_1140633331311607_4755148940050128248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCwmtITK-BcQ7kNvwFS3zkD&_nc_oc=AdpSOeLa_jtW4zWMOi5dYI2iCFa2jWEmI_0xLS6AN-mXGguBNM3fGmd5_3gZ1ZNTy4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TLmJJ1-NYEorJwsC5IR-vGmxzacYZk1u5cPsVQGaFKw&oe=6A1EDDD4"}, "display_name": "Visual Scale", "keywords": [], "long_description": "Dive into the fascinating world of architecture with our innovative real-scale visualization application for Oculus. This revolutionary application offers a unique experience by converting architectural plans to real-life scale. Now, you can explore each space with unparalleled precision, allowing you to better understand the distribution, proportions, and details of each design.\n\nWith our application, each plan is transformed into an immersive experience where you can walk freely through the spaces, experiencing the sensation of being inside the plans themselves. From spacious halls to cozy corners, every detail comes to life in a surprising way.\n\nFurthermore, our application offers interactive tools that allow you to make precise measurements, change the color of the plans, and customize your experiences according to your needs. Whether you're a professional architect in search of an advanced visualization tool or simply a design enthusiast interested in exploring new ideas, our application for Oculus offers an exciting and educational way to interact with architecture.\n\nImmerse yourself in a world where plans cease to be simple representations and become tangible and immersive experiences. Discover architecture from a new dimension and unleash your creativity with our real-scale visualization application for Oculus", "short_description": "Experience architecture like never before with our real-scale visualization application for Oculus. It converts scale plans into life-sized models for exploring and understanding spaces with precise dimensions. Immerse yourself in every detail and experience the magnitude of each design with a new immersive perspective. Discover architecture from a new dimension"}]}, "developer_name": "Made in Verse", "developer_privacy_policy_url": "https://www.visualscale.xyz/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Made in Verse", "support_website_url": null, "website_url": "https://www.visualscale.xyz/landing/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9018104574984176"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1541635643177502"}]}, "baseline_offer": {"id": "1541635643177502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742306400, "status": "PUBLISHED", "id": "1541635643177502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26539326982435331", "version": "1.0"}, "id": "3342367702733040", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7277826565678661", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26539326982435331"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "L
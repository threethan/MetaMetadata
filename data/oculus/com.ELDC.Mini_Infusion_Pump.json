ogI4j30GzMdUeFtJQ4sHWLqZwZ0VJeehwNG0-KXTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UBRAiyjRfT__Wp8cJUAqPAoEmNAkPLpywMkfcwFVimw&oe=6A071329"}, {"file_name": "2.png", "id": "534442306234665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tW38aXyA3sQ7kNvwEdsQl9&_nc_oc=AdoYTTxxFkKJg6monm5UUYtZjRPhgIaJhVgph_YNU4rXRxKTd3uc8P6dRdK1DWr4Yug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sBan5RMeGuhw98q8HwN33GKXFcyW-PB_Vv3caUbpHuQ&oe=6A070E4D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxslFU0O__oQ7kNvwGm6u9I&_nc_oc=AdpkhITqa8bABlOchKwbgY59ml5FXVFVCVMD-dhJ8uzh_iJryiYhDgF2wrYkLl7kUsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NUi9Cv1SzPI-zMgBKcL_5cg6hsIjyQkv3-MDmb0vlsg&oe=6A07436F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g867mrTD_UcQ7kNvwFlApYd&_nc_oc=AdpFZVASbmONhavJ5GuGzmEncC4sLPOwqcEHRu5M1EsRcyz7NY6eVStaTSBvU9aVOjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zgz5rbmoxJGZPkoVOYgi4YT91PLK6X3b_dqF3xbzEdA&oe=6A071A8A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjtlIndYhGUQ7kNvwENLzrQ&_nc_oc=AdrAM_V11h7pq1tw85GkOJbaV-choZkQ8-0stNr75byf_ip2dLfkrgTx0K45BprLp5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uRoU3_lLhOHbBRE-CaNNgUriNIHAlBfuLoMEH19RVEw&oe=6A073B7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
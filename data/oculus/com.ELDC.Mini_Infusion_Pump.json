HsblwAUkCo2Kzqqgc7K5TJpf6F0INShzOVagOivsmtAk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4viKxUFhrZOyOK54UX_YvKGYCyh4PK2jiQtn7_qu1weA&oe=6A119F29"}, {"file_name": "2.png", "id": "534442306234665", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxFQSGh964YQ7kNvwGjl0xC&_nc_oc=AdpUUG9DbVg9mWq0ZkPYcczdLD8bZv5NCO24dewR3HlvBU-c_c-wsiyPaEgIRtgkjCY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40pEDUDlbco-AInOuqH-i77EMVMR90teY2Kk6jNkpmXg&oe=6A119A4D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdZ6Rf0DTZcQ7kNvwHSxjfl&_nc_oc=AdpbzO_bq_bseDfhm0Wm7rD8qXQ32VgOWq9eALup44gCtcNhDi5YlVQBIFEkdEyPH30&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UGcE6Aj90DlDVUXqw1sDkDI7CskPAwEcQH8P1Wu_RrQ&oe=6A11CF6F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoy_oSnLWeMQ7kNvwFVyZVz&_nc_oc=Adob0aBuNyNDRTUtzeGfjjgf0_WD7LAYONoD9fXYtA_J8NbWGI0NjQIL_JWJVOEsylY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FbJ9gSBlN4fIbkV_-xm0DgLS776TZp7cWPbW2C-e1vQ&oe=6A11A68A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIkhX6-6YTQQ7kNvwHRkyWS&_nc_oc=AdoKVWdlSs2FUwJY_s0j1ciYTHkOMM1YuvOSIW_op6X2WBzHOxtUUXEKxj4bp3gzfnk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A4poxTdJeknk-6DeVx9dZqn_EQIO2eaAiJ-oBck-okA&oe=6A11C77D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracki
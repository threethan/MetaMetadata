culuscdn.com&_nc_ss=7f20f&oh=00_Af1ntr_BI9HGletnI5MoTlUruvpNpZ73WXF1X4X1Heov9A&oe=69F347CD"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwMPsE9A7wkQ7kNvwGsHHSG&_nc_oc=AdqjZbpO1F8Haf6LvAj5fH7yK0QZ9gh4Poq7dySVQG_9XC7ahFw5xEyo-Yo8nOsBqlU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cr038pstPsX6rhC8zQDKmGZPLbkxAWTF3FbQhBscvIg&oe=69F344AF"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1DpXgUbL-QQ7kNvwFabgCO&_nc_oc=AdoxfUs1DQCsr022dJ_-YN78HOuxjX_t3MCKqzrCrgabTi3ZMea0Bv7oTfWTBt1TmNs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CmdlMd0B8FagE-roMMnHAptWz0YviKE9KcY9mVCl3Bg&oe=69F3540A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRcp1cfwe-4Q7kNvwHzQqrP&_nc_oc=AdqolMsmZfEgxfHyqB1Jn9rDY5-CMXtbv_HXVr5QdPKiFpYoI4xcVLCpciMVp0sGwCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kZvaa05mOCBqFxb_BbF1NYHzlbF3g3wuqvV-SrfysRg&oe=69F374FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30991226520491607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295992_1396193191670148_1217231747554975671_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERzIytb18SUQ7kNvwGBrOOx&_nc_oc=AdqeawLcmGeGk9YRbtPxqWJa8LPhOpOqSoH94hAmKG8hQWNWRta31vXRIHMB8hCUqOc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Oc1wqBEYDvzrAnY
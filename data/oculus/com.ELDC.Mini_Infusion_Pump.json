ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx2Lrnyir9c3Wf_EtFZS7IDosdHvqWLHc8K8DxoVEEPA&oe=69BD372F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-HSNJKm-GoQ7kNvwE03FzL&_nc_oc=AdnugHvb3un3-Vh8fhsu5MbIy7qs4z4U-5dP_UsiZ3K0EZlBxN5KL1JI8Q7lgPShKlA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIFiOAgaraCTIMRK_qnKUIJMy8csRmyeOCXxJ33u-6Hw&oe=69BD468A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPqxOl6QjKgQ7kNvwHCcUSX&_nc_oc=AdlWrvcI1GbdJrM6a4svOIzQ13ndu17lsAC2CO-hQTVfzBfTWQgbNljKCWd4H-Olm6c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfythF4gan0nGaJO2tMCHio2Izqsg07H8-PZnWfkHJ6zrQ&oe=69BD2F3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. 
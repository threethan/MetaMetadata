": "1.png", "id": "1767906510686456", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86653846_1767906514019789_3623033798016026605_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmINzL5ND5kQ7kNvwFKIr9-&_nc_oc=AdpGjgZ750EzPJUq3hiLdOrxLiMC93_jn5LZx1fEmwO6CoO_mxFaf4DFC6cTf2EgIfo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfP3SrXk1_hRtKS9fOXt5AmEo_ddJEEkPMv8DUD5sSvA&oe=6AAE81A9"}, {"file_name": "2.png", "id": "534442306234665", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRRtITYW4_AQ7kNvwEt4PB5&_nc_oc=AdrY9ajdpd9G7mqF-CqM0r8go_XZN3O3FqRiRjrBU3Yc2d5PeOqOK0_sFWK9V2K3UlA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvfnLooVLYXjZfZIjm_tw9X-yautp2eGbzwC_QjjJRQw&oe=6AAEB50D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyaD0bFeOBgQ7kNvwHdpbrH&_nc_oc=AdrYURo5oMAp5ozWfWnUtUhys6ZutLwboaFX_NI0MpUWfJD6-Zpbw04GGUppqfbec_U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVUamxREofuDcaZVKyWN1yEDc3ixarsuQjFx4XTcWZ0A&oe=6AAEB1EF"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lliCH6AV1GsQ7kNvwEjHHhg&_nc_oc=Adq7OLtaUFG4YYWWBJ8PPVRPrb96YnUsm__d9-c0X520SZqcDas3vyrt41yQMRVCdJI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrKUzUnkcEUQHo1oaCw_bbkoquzLftLjULaFaeQ_FA8w&oe=6AAE890A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4P_kFZY4UkQ7kNvwGOqFk4&_nc_oc=AdqL1tIn-MPOyatNVdEOn2DqSxCVVkjSH2AqpZlegDewyI5Xh2e2dGai5Hf5BlX-FjI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ96tmG_S-wGvpsW1lYfGLOOkO6q30a2i3NL7C2HwtnpA&oe=6AAEA9FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT"
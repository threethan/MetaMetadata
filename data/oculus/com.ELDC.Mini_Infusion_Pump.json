ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGXwoWVzCaGfZDPUvxvT9nq4bVW6HxaNxCk9aBPHwQcg&oe=69B54E2F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GshLzpnfo_wQ7kNvwGoB76M&_nc_oc=Adnxy_VI0Vy_lA6ixKdN1ZRnTGOD6YFA7nXvok91bpAo7OWH_gK5CbQBSEWK1OVjoL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBBByG6N_E_KOUrYBmb5pQONDWbcH7ZdYZCK_j_6LVpA&oe=69B55D8A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBKMEaTWS0gQ7kNvwF0gBrW&_nc_oc=AdkA_MVCFKTnXcky181lel73uYMkBRJwb_cW_KEloPlHHBNoeQWYCCTPDNBXif9uevQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwucp1QFA6Rn1C1-_Vt9JB9evEVHH_jm9kh8kvbJpVnww&oe=69B5463D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. 
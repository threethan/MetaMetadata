ng?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auNNXYsYsasQ7kNvwHbCV8Z&_nc_oc=AdpuTeSi9xNGNLD9FIxMfgM-E6sCUV5oUJFFMU3IfKjMSVTj-di_QmdEiIchioROb6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwroVRNpQh_AV8aT7ylkljdDekXmRQYDveDZOluyGjxdQ&oe=69CBB7AF"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRYqKVslfJUQ7kNvwGJsC0f&_nc_oc=AdoDfyh2ixPXE0CdtvtSYhsjNId_B9Fp2afymjqDlgLDo5BT6ti66exP-maZA-RlD9Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtFCT48aZHdSlBnkVLEg--dHK-yXV8w-2WiwIFhRD7Bg&oe=69CBC70A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS8gEE2ifXgQ7kNvwFExwdW&_nc_oc=AdpZLBgRLLP2DDFsJgoA2kvKM9hsgEUOnSXX_I42m8O7qhmNsnTCq-tyA0ZbX8M4dHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybMUJOPjRpuQFVTVIRTY-itTehW74yEPf2Zx4mrExnyQ&oe=69CBAFBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30991226520491607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295992_1396193191670148_1217231747554975671_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fErJLUGamoQ7kNvwHoD9dm&_nc_oc=AdrpFeVLQzT1W5cIxmGG0dsJ2b8jRYe5eL5bVA3N3925TvAdH_94NV-Gh9sxl5NJxGw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7JAJuvWr9DkR1Ou76-fj7cEdxHmSy1tibQ3yp3V5z_g&oe=69CBC31E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mini infusion Pump", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"
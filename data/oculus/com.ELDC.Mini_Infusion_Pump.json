mAwyCSQHzD_8705Duv1K4smeTzH9wd8lP0AZ74rNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5buFh7p5wTmc2LlmaMpMELu2A5CWUi405oNZz7WX5NMg&oe=6A198829"}, {"file_name": "2.png", "id": "534442306234665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp_IbKIDWLIQ7kNvwHf26VJ&_nc_oc=AdrffHRZkEpOclJF46aEAmV2nknDBKiKV1f6hQWSN0nDsS7Ll2DPqCNuiMAceyQ9SmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69pACaizZWBFR7FHT0EulkAEh2wEnQf4yCZIoH2YC0ig&oe=6A19BB8D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z-zcKISmJAQ7kNvwFTeWSl&_nc_oc=Adp5Ikyds5q6guE0aXw_gcCK_x1wcnIgNl142Wg67-rIp8kVBMKUdC0i_atLWHQVRyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7boKYS83MQ3wCYeR8R_ybQSjDYxiyMArRknT2J5UvU1w&oe=6A19B86F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIfE8NBscOMQ7kNvwHefELU&_nc_oc=Adp-aFNZCVlBNlx6tJRs76WvUDDfTSrk1jk8CAvxMNunGjFT4PQPjejSnkAVFT0uqn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dWn1rtqqgJ9edM5jnaDffOPqgA26BJuqS5q7sFcsVzQ&oe=6A198F8A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBT-sZrp_qkQ7kNvwHLjPPt&_nc_oc=Ado3Lg5cPbwFYYChxocucMUReIurvc0rEwtRdGCbzqAuF9GT_a-0nnlpjdVM9CBisfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aUgw7XHsxXxE1qoSb5eUyWXHGJ4wYqKl2IFSquaBfVw&oe=6A19B07D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
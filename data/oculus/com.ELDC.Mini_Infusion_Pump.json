A3bAIQ7kNvwFV1LOB&_nc_oc=AdqRi9fYt0M5GOzESLT3qQmzhp5NxwyDHZKTsLuQd4_F1XgQRfLaDR9AgQ4dJle3PNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SPygvqzAk50-jHqFtztqYzNd9l1e9k2Eap_fWT57teQ&oe=69F88DCD"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a6uCx8FlYUQ7kNvwEaje_w&_nc_oc=Ado8Hi0GkcovJCuleJwW4Vuw-RjbiS8mbNz74HoiUu35N_OxTUAMsRnHZ5U3ViHwaF0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WuZ0OFENv9Sam_UvjLWo1z1fno_BqpOtr2akOnog2CA&oe=69F88AAF"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI0IkI1UAKkQ7kNvwEjkuK1&_nc_oc=AdohBMkXRYDQA68_tO4A1ncnI0eW3lbRVk0X_1kr1NRoT3a6bGFW-NecBHFoPPkDQMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20b491dJcM6xtqkzYmpt4UH6M63P_6oNhuiP-1nGBNYg&oe=69F89A0A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wppweYXjNrYQ7kNvwHpOHtp&_nc_oc=AdrKQHJIh8Xe1HKrFPdlnLzFnQ4opC8p_epl9G8OgWzFEEHAElzUeK45UGmeyrh9OBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SV1DlOgyAXL5QCU_-oiQYAf99jVhNlRnyUYQBl3XDxA&oe=69F8BAFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30991226520491607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295992_1396193191670148_1217231747554975671_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJuw_jziAAwQ7kNvwGHB8oz&_nc_oc=AdovRsVstzHK5vqhVSN_c5m6I
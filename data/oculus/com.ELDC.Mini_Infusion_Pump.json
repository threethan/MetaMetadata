.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbw_rh9-q7wQ7kNvwHA96B0&_nc_oc=Adk0CxBkj9JYWZ8puKx_QLMTWdpj_P17Sny6-qRHabNVA5OzIeaEDT2sazNHQWHCt5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHSz0_1_Kj-HmuKVdtjAbfyuxhDvR3SrfZj-g6fs2D7Q&oe=69A2DC4D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEjn20pJDeMQ7kNvwGVwbw3&_nc_oc=Adkg7dB9wgnnBbGi8yZqh3l1FksZnnSyC4373jln_Ml43o5n573kLyI5rqJ6CSjD6nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumGhYvlOwkzyj1T9P7_krbnFbVz6-0KeaY0Y60Mb0Pkg&oe=69A2D92F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YebnVhFqG8MQ7kNvwHgOhyI&_nc_oc=AdkITXeLMmJL-ZhdDjtg91R9KspLalKDfO-fCbbj7JNNpvZWd61KNj53eoBIC2b7arA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPhnUZ24YjnBhRLTivCRCAl27tUR_S5IWCDrcxTJxQFQ&oe=69A2E88A"}, {"file_name": "5.png", "id": "556063783727270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_556063787060603_1209360275626248268_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UCWprJpFegQ7kNvwEWwg6I&_nc_oc=Adn28_kYk8_5zNKOAM0f3hcvLxWmOIND0X7-0xkxx57nG-pqRBID4KlDhFwFEYADuwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5Au3ISs1FDbhGkrhJw9KRYidyTCYvOaCGsJuuWjY2kQ&oe=69A2ECB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27770626719218286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "475688711589422"}]}, "baseline_offer": {"id": "475688711589422"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731910260, "st
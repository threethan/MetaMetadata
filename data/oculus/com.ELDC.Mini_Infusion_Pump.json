TWyA9Gw9hWjb0Wo_w25Ks-JGHYUfdvfJBjgaSL_FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gV_bizxz5VuQtH6I3c2gJh8i8mnLLPc-d81HQ2JgUcA&oe=6A047029"}, {"file_name": "2.png", "id": "534442306234665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031626_534442309567998_973908041681072365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOHwwoAsMNkQ7kNvwG-xN7-&_nc_oc=Ado6gNkuV-GbOP4rXAQnr5YKj7BWbu_OcWzAsCGlYsoDWwRlHbwv8ii5vuj_PrmybvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bs4_aaIg9bU-nOknjq3BIAnmyw4Op5YB1WNcwCmkVpw&oe=6A046B4D"}, {"file_name": "3.png", "id": "1519638675421055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974696_1519638678754388_7079686955806646037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxslFU0O__oQ7kNvwF-xGpm&_nc_oc=AdruBcegJjykF_9er306Nt4nzNRH_XdCywOMszmA4uGoNyQmZJyPVQTWcSOtpDSxpIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z30E8qsE-nOtOrgq6kRe-pAzOeCQESe1mUmrqgJ9zIA&oe=6A04682F"}, {"file_name": "4.png", "id": "934711128562039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569472_934711131895372_3520633111538779453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAHDqQXcCbsQ7kNvwHjfN-k&_nc_oc=Ado6Lh5p_IJuT5WOumLvwuekrEB663Lackm7x8tBYh3-Hf2VaP6GY-q3gNWP2fgwZss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pVEKFILA2ffFCdZgcAtd2UqZ0n2IumtBPydG_Lx_CFQ&oe=6A04778A"}, {"file_name": "3.png", "id": "9832458550187453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624744_9832458553520786_8487099639663963570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je21VCzmyygQ7kNvwGE7Dn5&_nc_oc=AdrHiBwCYO-CLFfIueCuLax2wCBzZjOuCT44yHHtVRy92ZlaJORlYf-F0_UM-WofqIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kVgOJXiQ-nRy47ahaF94TFZWK7HE3ldengovCXecuvg&oe=6A04987D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini infusion Pump", "keywords": [], "long_description": "Edna Thornton is 68 years old and is suffering from a constant, sharp pain in the middle of her back. Her doctor has prescribed medication to alleviate her pain, which is to be administered using a mini-infusion pump.\n\nThis VR simulation involving a virtual patient and a virtual assistant is designed to help healthcare practitioners practice the procedure for setting up and administering medications using a mini infusion pump.  Learners will practice the procedure in a safe and controlled multiplayer virtual environment. With both training and assessment modes, learners can perform the procedure and be assessed on the knowledge they have acquired.", "short_description": "As a part of this Mini Infusion Pump VR simulation, learners are expected to identify themselves and confirm the identity of the patient. The learner will also gather information on substances the patient may be allergic to. Before administering the medication, the learner will educate the patient on the medication, the possible side effects to keep an eye for, and steps to take in case of any adverse effects of the medication. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
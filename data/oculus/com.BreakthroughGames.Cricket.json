akmN02KgYSlFNgbIHP8Ds5sejMBK9IHWE0Sa98hRu7BGHHlnCW16A9pepYqo6wlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT811h4JQZT3tIgQ-ezuB-luCpsob64uA6alZ2vclzHNg&oe=6B0C5EF3"}, {"file_name": "07_gameplay_wicket_huddle.png", "id": "1853294245716342", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771252_1853294249049675_5789169174548580586_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6S09pLq_pAQ7kNvwG-AaM1&_nc_oc=Adoz6vQbltgL_nPBwqsTMNicy-WUm11mnK_HwTxluCQWVbaAN3kLfexWcRn_Wkw6Q6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSD-UIknDP4plZw3qgQu2qqKTVnVRoMeUHrU7vou1Mijg&oe=6B0C813C"}, {"file_name": "06_3rdpov_spin_ball_trace.png", "id": "2048778525782658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771287_2048778535782657_571935040364407472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTmjukI0EHsQ7kNvwEbVQKn&_nc_oc=AdpCKEElvkFeLpWlO3aOuUCMDlj4v5A82W7HiD55oft9ZYtmY1QJM5XxBDHuphfFQBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7In1uUjq-yLIVl5UpmqY52FTt2KNWSJGi6B_ZDAHTlg&oe=6B0C7154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot_2_2560_1440.png", "id": "928125172988393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_928125176321726_2032970985863418197_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifBnSuO2Rj0Q7kNvwF95fCo&_nc_oc=Adri9qD6DMmQMBEId5j6NR_UPWQvI89s53fMFRP0YGZnUoVRrlhvr7ZknoDji3uKcWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSc0p5tvZ-KA6VZ-G_6PorU_vwA3_Bct15xJXvupS6rog&oe=6B0C61EE"}, "display_name": "Cricket is fun", "keywords": [], "long_description": "Multiple game play modes, one for everyone.\nTraining - For those who want to hone certain skills\nChallenge - For quick fun\nT20 Match - For those who want a long game.\n\nIn Training you set everything: the bowler, the field and the pitch. Challenge gives you six balls to make your mark. \nT20 Match is the full 20 overs. Real physics drives both bat and ball, so every shot leaves the bat the way you swung it, and shot tracing shows exactly where you made contact, or missed.\nPlay it as a relaxed net session, or as serious practice before your next match.\n\nFEATURES\n\u2022 Training: choose the bowler, field placings and pitch conditions\n\u2022 Challenge: a 6-ball challenge\n\u2022 T20 Match: a full 20-over match\n\u2022 Real physics for bat and ball\n\u2022 Shot tracing and replay for every ball\n\u2022 A traditional English village-ground setting\n\u2022 Plays offline, no internet needed\n\nTIP: keep your controllers in the headset's view while batting for the most accurate bat tracking.", "short_description": "Bat on an English village green with real bat and ball physics. Train, take the 6-ball challenge or play a full T20 match.\nRealistic bat, ball physics, that actually improves your game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ukanddroid.github.io/cricket-is-fun-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Breakthrough Games", "support_website_url": null, "website_url": "https://w36sol.wixsite.com/vr-world", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28934367106235139"}, "review_messages": []}]}, 
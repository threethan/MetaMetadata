/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_835199459534154_1124995270065241102_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYgV5ZJ2EW4Q7kNvwF231nG&_nc_oc=AdpGJbsvxJmaVrsxvaWlRZQao1mPKMB-n9vzoTpBA4_J3rSqFabIInidF9_t6JN8WSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMipLs6yjORaEiN0eNMnn0zKW3QYWknI_jDCg4LP8qig&oe=6AF87B52"}, {"file_name": "cricket-vr-session-menu-2560x1440.png", "id": "1986452702024825", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1986452708691491_7758555522176849873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3pLepYV0IIQ7kNvwEssd5A&_nc_oc=AdqUPgNbyGvH7LCkttJnlGYq3AEfAi97cToNE_6dYbzsPuu7aT3EInZcoGDYSSa1Vbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFxJlin3Up4L4j7zKQPPmwGjMO1tZYI73bfvQgYq1GLA&oe=6AF8A6D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot_2_2560_1440.png", "id": "928125172988393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_928125176321726_2032970985863418197_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrVMF9XKr2kQ7kNvwGlOKRa&_nc_oc=AdqB6X07-Rm2-mUkeJjAgdF1AmUUBTQixOULvP6D10Nxc4490NVEGDtvnXK6YRHy2cI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFf4ZjCHjYIMWgY77pEQMfRGxaq0U0stGGzRUdQv11tw&oe=6AF89B6E"}, "display_name": "Cricket is fun", "keywords": [], "long_description": "Multiple game play modes, one for everyone.\nTraining - For those who want to hone certain skills\nChallenge - For quick fun\nT20 Match - For those who want a long game.\n\nIn Training you set everything: the bowler, the field and the pitch. Challenge gives you six balls to make your mark. \nT20 Match is the full 20 overs. Real physics drives both bat and ball, so every shot leaves the bat the way you swung it, and shot tracing shows exactly where you made contact, or missed.\nPlay it as a relaxed net session, or as serious practice before your next match.\n\nFEATURES\n\u2022 Training: choose the bowler, field placings and pitch conditions\n\u2022 Challenge: a 6-ball challenge\n\u2022 T20 Match: a full 20-over match\n\u2022 Real physics for bat and ball\n\u2022 Shot tracing and replay for every ball\n\u2022 A traditional English village-ground setting\n\u2022 Plays offline, no internet needed\n\nTIP: keep your controllers in the headset's view while batting for the most accurate bat tracking.", "short_description": "Bat on an English village green with real bat and ball physics. Train, take the 6-ball challenge or play a full T20 match.\nRealistic bat, ball physics, that actually improves your game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ukanddroid.github.io/cricket-is-fun-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Breakthrough Games", "support_website_url": null, "website_url": "https://w36sol.wixsite.com/vr-world", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28608403435498176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_26544546538463743_7484617894333526472_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M10uPOwDgLYQ7kNvwFwMyY8&_nc_oc=AdojbcE2RHHu3F7XyVwdsgb-pghRXQBh65mjyB1rrNPOM3B7d-R5CZ0On5nLjXzOjtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
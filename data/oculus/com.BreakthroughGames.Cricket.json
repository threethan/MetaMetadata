mVPLy2DAYDWGBlQ8i-RKPF6YFpeffBUrB1KKG34e4y5X6ktSuy2qFi_fGKk4AlDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMf9ai3dDmdiMqsl5_GL_283MM81BpnRpAqD4ni1BRsw&oe=6B105373"}, {"file_name": "07_gameplay_wicket_huddle.png", "id": "1853294245716342", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771252_1853294249049675_5789169174548580586_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCu98Gvv-acQ7kNvwEhXWjB&_nc_oc=AdqD8XWoxmk7Y3HLOJq-twZoODjiAarfyWxravob9YXvZda173LNVf7vYiU5wo0brog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTdIhmolZQLpYD94o_nGokdes31JDfSasmmsfTRLyeKw&oe=6B103D7C"}, {"file_name": "06_3rdpov_spin_ball_trace.png", "id": "2048778525782658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771287_2048778535782657_571935040364407472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFSxMeTyujsQ7kNvwEd0lAl&_nc_oc=AdqgrjoAguOkq0r5LVwNWbyVOiNAwrz5-gVMrRrza8-Ovk47Pkcuyx2ZmpJr73Q22t0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjBS_VP805UARGvaBw000AqSy074p9pGMzmU5n0aIESA&oe=6B1065D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot_2_2560_1440.png", "id": "928125172988393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_928125176321726_2032970985863418197_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AHFdxCBaOgQ7kNvwE0ktyE&_nc_oc=AdraxDVLbckQmhn_XaUoM79-r24tAlUKRfb4S2JUsYS9A_qvGoIYCVF5GhucILxb1aA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrtbFTYNKwfN9dC3Z2QOaLcq1ADhzNubjmCTu7jjepgw&oe=6B10566E"}, "display_name": "Cricket", "keywords": [], "long_description": "Multiple game play modes, one for everyone.\nTraining - For those who want to hone certain skills\nChallenge - For quick fun\nT20 Match - For those who want a long game.\n\nIn Training you set everything: the bowler, the field and the pitch. Challenge gives you six balls to make your mark. \nT20 Match is the full 20 overs. Real physics drives both bat and ball, so every shot leaves the bat the way you swung it, and shot tracing shows exactly where you made contact, or missed.\nPlay it as a relaxed net session, or as serious practice before your next match.\n\nFEATURES\n\u2022 Training: choose the bowler, field placings and pitch conditions\n\u2022 Challenge: a 6-ball challenge\n\u2022 T20 Match: a full 20-over match\n\u2022 Real physics for bat and ball\n\u2022 Shot tracing and replay for every ball\n\u2022 A traditional English village-ground setting\n\u2022 Plays offline, no internet needed\n\nTIP: keep your controllers in the headset's view while batting for the most accurate bat tracking.", "short_description": "Bat on an English village green with real bat and ball physics. Train, take the 6-ball challenge or play a full T20 match.\nRealistic bat, ball physics, that actually improves your game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ukanddroid.github.io/cricket-is-fun-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Breakthrough Games", "support_website_url": null, "website_url": "https://w36sol.wixsite.com/vr-world", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29016037684734747"}, "review_messages": []}]}, "cover_
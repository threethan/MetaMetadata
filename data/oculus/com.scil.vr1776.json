Zdt&_nc_oc=AdrJVzw93EEYnyvjhqwb0SxzcHAZDuwBh0LHQHFy-bpK45hZcTQMmhzjM7rlSe0DnL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JO8HsUJx9GZ3j0zaWwFsoCmO8CERGr4PT0eD25NmRqg&oe=69FDFA71"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuk6ySApB1gQ7kNvwHLHCcW&_nc_oc=AdoH1obie4QOdB8dTI5ijwgLQs-Z_k4b-UtA-YErdn83t7yYZCvYDWLdWUXtXxa9Uq8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HCJcceMfEwNqb2_U1IY7Bx-sYym5svCLCmISrQQF5XQ&oe=69FDDCFF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4lQ5eUpRWoQ7kNvwF10pFz&_nc_oc=AdowLf3O01q43zrHs8ZGUZM8durgD4VEKTb7vDug-_HRvMz6elfZ7-ZoMMGihscWf90&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HxevZn-i5e4fXrBPjcsQVa7z-q4j0MNelZVXjvE5_fA&oe=69FDD5F3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-JwyTA08k4Q7kNvwFHlvZp&_nc_oc=Adr2dJ_0j2_fWCtOUVTgZCf4Kj2Toj530gp3AnVOzP98VlOCujGyKsh_qEQxVW8bdtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48N1VDBTA9DsK_8m40L5jEca4cP9Y7NrTsyd8pK_uuPg&oe=69FDD13E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MggZCDdIOcEQ7kNvwGLAMME&_nc_oc=AdqJjMELXjrCyjcKdlVLbsaEoqTroswCO5wCV3l-sZayQlfYf092kQlXwvW4N4-ktog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K1yMJE8yG-MdJ1z-ve2GoIcj_IeX5tsA0yTTRzLGwqA&oe=69FDF390"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
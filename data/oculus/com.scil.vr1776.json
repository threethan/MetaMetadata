64.5771-25/499307931_1977219072875831_1114393920592825093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1K1We4-zWUQ7kNvwGGzEXx&_nc_oc=AdoKCmDXGZMmYHScZURES2Gwtrt8p9II4SZu-lUfYOYai9JnIIXiFLmicTBZj0PZuTo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfJw8mCjIW-f0osk--oetZijulZNFJMwtnnt2XQhNCvw&oe=6AA95D71"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTNFsb2w9tAQ7kNvwGeqcYE&_nc_oc=AdoyUkj31n5eJLROLoB6FHu-p2z28iTeAxetc58wzmtAEqLFhBSqhwpqUymFqp0DeWQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaeF6zB-a80-PLd_fQ6eG--XFrWuBU8fwafkuCvqDqxw&oe=6AA93FFF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0SJZ_sIr84Q7kNvwEZPz99&_nc_oc=Adp8GWXHWpPJC9LR_52BfPE2P1CG85ZC2hky2DY27O-3rmlqIlT4pPi-gl3uhZJ0Jpg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkWtmxRDItHzGb_cNxdAaPP3QQnrthQBP31lg57qd8sQ&oe=6AA938F3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWEPYnPcG4AQ7kNvwGKw4Kv&_nc_oc=AdrAt4AXKR6jFRQlskpxtMAms9JUxOT3Ee0e3aRT1vehRI9rdR-YOjo4WRUn2xwRyIE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgptlKTsm___Ecu2YKKGKJ8VmqPI9Qg3bhuRM-jkQUYw&oe=6AA96C7E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcDRzvFGQ2EQ7kNvwEg4fk2&_nc_oc=Adq-Ts5MQdkrDLThUDJNi4y5tNf3VEQKmyZ5QuYOnV_mAYe9OHBsEsZ1DeLqKc2IPFQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOXm1HaBDN4dCSzx3rFcOd_cb_rp55BhwqRDpaU2hhow&oe=6AA95690"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genr
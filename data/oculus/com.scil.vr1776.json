XwK&_nc_oc=Adpr4qyM39QV7CVY6ajgGzGAG8nuKi5y4YIkBEm3gT9WTV7cTdoPjD6iLVfHW_F5PA0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v56SYXFdnlyYqt1sODWH4N7EvxtnAxLNC5WmsV6F0PQ&oe=6A1AFB71"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U--ih7uaogQ7kNvwGOKqWz&_nc_oc=AdoZguqCJ1gOioai-tz3AOjwcSUHKyAjKFfbObzonATXtO0fU2eJOTpp0If9vKomzHg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MaVKqY-Dcu_7mR1O-RO6f0a2gdcRA7GtAV6J8l_WYmw&oe=6A1ADDFF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhD4cXy08WMQ7kNvwHMpSFt&_nc_oc=AdpDNPOAt9H654Yb9LWgTEn6AHEZsHD6csQEKaJj01PpNVQGixvfTIW-kEbI9pvs5qc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FM_vN_dyurOpuH8jaC6UOjgNrrsVmJj8u0j5yhY9pcg&oe=6A1AD6F3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9k4gtlSNFgQ7kNvwGBGXBt&_nc_oc=AdpehV3QIVPWL_44riqx6400Io43R9p8FXBPmaElV8m_ikINC3-YkU9q392m8SjBB04&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cNQAHuJXrGODh-TAh_Xqs6vz40g5O7H6IdyZhPfgtwQ&oe=6A1B0A7E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATJQJT86NZAQ7kNvwGyWmis&_nc_oc=Adqfdq52jbVSFLCUYImgxUcZAicmwe3l1SO7bQ4o-7uU1sMMiyX589lWak2NuXQOBhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Kjp7YTkURWZrnPkpkGlyCmzfgHMTRkWdlfNqVY6oPA&oe=6A1AF490"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
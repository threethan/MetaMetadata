.5771-25/499307931_1977219072875831_1114393920592825093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOoV4xMqk10Q7kNvwGZ37yq&_nc_oc=AdoOD6-mouJh24AVJCRlBGK-jXrQ_i3k2A0696eKBs2_r3Bs-hFg9iq8UAUd1WYQi58&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X-iQVohQ7LhSAm43A9LWVg9ruRiOQ3WuqivYAVLHR0A&oe=6A2C1EF1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUsTRR_2sRcQ7kNvwFLgCkz&_nc_oc=AdrQdqsBMna-AW_ai7-KPuoaD0KD_m2VOzPPaJXgcscWBp2wOOs9U_png9rcaItxsFA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SqVOwrVuQ0oH_obBHe1RaMz4Wy3uWMxdBkyDjjCDprQ&oe=6A2C017F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQyQlm7upXYQ7kNvwGmdf34&_nc_oc=AdqszXNa_g8p-EdSzK5jfh_0IAYuuL7_ztAIAZeTNr5hpGAhRA8Cza_uYyYp4l-Y7G8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UOSx24BQdzkiUUz_53mhLbaCsrHS_FHE8SL7mLsanRg&oe=6A2C32B3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hj0UXL1BrAQ7kNvwHu0GfW&_nc_oc=AdqqEh4lmcnWtCdEbwXws3gGQ_KPLLpN7dCU9Yjs-Yzbx2EKOU_7gknitLBLcT-P5TU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HNyI8XHvWZsBx5TXU4AYlDkFDiAsU5tM3pDPvmbZx2Q&oe=6A2C2DFE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHk9hGl6TZAQ7kNvwHU5-6g&_nc_oc=AdozX43_XYS2Ae_NmhfG4bP7JDdOwcf65KZJPT7hK7IHZPm63TN6GMAjpGVa99UvDfI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VF9VO_kzUQ8BGfJNRLLICS3vfa5gjOqGNKn7nxaulZQ&oe=6A2C1810"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
7BD&_nc_oc=Ados-vMi-XJ6OpU7yBd-itUswQdd0Zq01Bu9AIrQGDQcu5UixqGYE06YFnuAh-FXW5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nmbKM321ZCOS0DHv70NWTRcN00YsF-3h9lyisDeMOzA&oe=6A1706F1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuFz-1I2EqwQ7kNvwFMrWuK&_nc_oc=AdpRdF_9nd9hET-f-lIN9Gcf79cKQxo8mjrnakeNwziakYnjSRiYWTaahvKIy0LRSQM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CHFkZZITf8V8ux6p_ikAXUAMUYFOxwywQKMzP5j3R3w&oe=6A16E97F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6w4MeygscIQ7kNvwFa8sO1&_nc_oc=Adpm8MDEBIMcnS5cbl0anA0jLb13NdSbPzCKek_aF8IT7GFAOsdeBiLTdopo1iLtd04&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p9B0FsCrCcxs3mD4UzBNQwqat-ITFP1t1O-ADNlr5xQ&oe=6A16E273"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtInbt9E5yMQ7kNvwGPsCPy&_nc_oc=AdoLyiM02UOxwDkCpIPtVXe9PnF-P12ELiArLAJX6j_SyH0Km1WiIgXgkFxpDp5FhRI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zoB54cTKN8xEK9UI3h1ZBSHPTdbfHWpP--YDgYwqYgg&oe=6A1715FE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ-KIbuS1AUQ7kNvwFnmzgO&_nc_oc=Adr_Ihdq2TUszAxNB77MuVBu4QYXOmb6JlDZ9M3Vf8wP_QplhDQvLm_s9cCm99RH618&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tbg5eFAc5tcTRbFCZihiqa8wV_li9rGFvo4uzLf7srg&oe=6A170010"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
uzQ&_nc_oc=AdrY-jHUKxTuqUu2ZSbFXjqOdk3wIhMr9eiMKn-z5rmfqk4HKLTI8iqO27SG_mtqSns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4swoVeXTgWHquf7QB5KZkSvnfse8iP-rCZCrVPg7wWTA&oe=69FCA8F1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGoKK3BwWn8Q7kNvwGqflyx&_nc_oc=AdrgYgtRJoRmo-EshZ8Agfsrv-d1r-YqVc5yrlbhSAhho9SutFS_nN-8bKdbQdjFVQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_y3zwpswV3sCb5CC3xrHunDKTbnJquEqRGmtZJ3G-8g&oe=69FC8B7F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I1JRbLEnLMQ7kNvwHEemlB&_nc_oc=Ado32vtK-3pspWcaWusMHG3W0BWaq9rW5tw8dGANPB_I_h9mm9nU9xIv7wZ21CgDh_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HtL6gNA9jCze_ZMog5CHBzCUP0KcaFNTqRvT1Evij2g&oe=69FC8473"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-JwyTA08k4Q7kNvwECsPTB&_nc_oc=Adp6dRqqQKEEiU7bT2J57lFw56msS8_hgOtVnGOdmArmejHNhrPqzjt_axoqA0sF6VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NKSIaVUpST3alhw79ijTGw5eFxg3gY-q27M8yxj7ipw&oe=69FC7FBE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgSHxUbH5qEQ7kNvwEJHcXE&_nc_oc=Adqtooogx-jXusooXj3BsvTBaO4vsTSQ85sTj7Sdr9jQKqdvVUAID5L1fQrMaw4JnJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d7i7qtwAZwz0t78g60O9mi0Fn8WZKmvJ8SYPNk6Ib_A&oe=69FCA210"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
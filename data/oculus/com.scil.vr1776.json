4w4Q7kNvwEpRZSO&_nc_oc=AdolPX08XHknLtJXVHaPEJHjjDXZX_pFkvO4iv-73SqKG31pM8Qr2BatXLcXMbCtU4k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ib-tFIO1nWN4DNyTGniK3N-jC1F2Av5oltCCAcKqO8A&oe=69D78794"}, {"file_name": "hero.png", "id": "912333321708602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307435_912333328375268_8597055687008392185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgDabTpCVhYQ7kNvwGsWrSf&_nc_oc=AdqkWPYmmgSori5KlHqsf7YkmkvMug2TfbXAHa5t3VweSvzXK27Tl847U_L9iQ87C2g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yCKSSsqZDOFdG-OhoPL-0-naWd5PO8IUYkKdr6zVz9Q&oe=69D7A7CD"}]}, "id": "916889461233866", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1977219069542498", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307931_1977219072875831_1114393920592825093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVK39YkptF0Q7kNvwE01KgF&_nc_oc=AdqqB3YZnQMExepBmDpEZyUB7kkeHY2pIXQm1ygM4pjLlU_LyZ781b2jck0cmPrf6So&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xEzuYiJBhOZ4pjK7e5CTaBguXSM3-xMsUNgUHb_VOzQ&oe=69D7BEF1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_sUCnKxgPIQ7kNvwHl4ZED&_nc_oc=AdrOfIMROHGFHyhZe3Z68miKxgZ4WsHe6_jJ-u9zPWEgdBKGzOOri-shZEu8w91cXjU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11-zL9Qo_X--F6d9cOlzBGBDHR12xGYHhvLxrrL7uLXg&oe=69D7A17F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqvTPNdCStMQ7kNvwHC4eLl&_nc_oc=Adpha00dpRC0JlImVoeFWwGew7utKaV1fSKoJjLJLFP4VYdc_43CrMwJF17mebCZnoU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m7eFelNnu2tsbO3aH0GDi0O8k_wvc7WlLJcJQx_R2HQ&oe=69D79A73"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKFM73eNNXoQ7kNvwEn4oya&_nc_oc=Adrjw-z5qBP6Lf3s7Cw3F_GefmMob9Gb-3M59y5fhYuL4SmF1L70S5BsGpB1974xLGg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WCo8t3J9_B-VA-TmpmW_ozA11U4a22KP_rl63wxS42A&oe=69D795BE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gauTSUYV7hwQ7kNvwGX6jym&_nc_oc=AdqlhcvuxdNfyLnKj79YkNDMLWkn5FV1jtJcJOkUpQBjW6f1fMwxfMzukV0_BYw7y-8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X_MlbTTVz7T_x4rzGeVhHC8MdQ0VMQDuZiIeol5RUTQ&oe=69D7B810"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26170504519279592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308131_2138162840279438_4169102127195183705_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b3KlnHRGrQQ7kNvwHa-nd3&_nc_oc=Adr1aWxzle4gdXNak3F1cI2Dp43TvaJSCeRxG7wnN7bZYTSOg0TBA_RJ_Z1OylhiSR8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pf2qLAs_7wUDilCMHqI0k3hUCZ0FWX3F0_0kIzaFQ6A&oe=69D7B185"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "1776", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_da
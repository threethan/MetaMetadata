L5A&_nc_oc=Adry1iA3ASZlVciW_8Z3VGuTSxCXurj2TkaWhvT-yHWh1zPr_T0B8NFZEel3bZgVTi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aapERe5DDqeGnOvz2YJrYr8uZ5gT1JNQHo6OXcOXqAg&oe=6A0491F1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOutzs_ODIgQ7kNvwGOeeBa&_nc_oc=AdpCZr7p9sp4BuwH1ydzTkFf7Euc8lZoxuQMB4hQ7o3OTlOtLBnTwRZTveJRsap68Jw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tqq7MGeW3lIZ3IlaVpfc40HVblzzqvVvvrjtOhBNXgg&oe=6A04747F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXuhpubk5GYQ7kNvwEkbai2&_nc_oc=Adp2YDh99MW8vYWLoC25Jd4VHqckyuQVUmy5h5YIuefHdLowrg2c-mCd7ICTrO1n11g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xcErP3_3HnYmD4p3lnUrO339Bk4ghUKXzJeqB5TEkIg&oe=6A046D73"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnuKhPzyO5MQ7kNvwFKXiMS&_nc_oc=AdqtdLW9FlrTy9Qy9FzPqHariKn-BGlDIH6W7_7UVhTHUf9iLKMfkHVy0m_yA2X15lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5If8oddb-AKtS_nz_wt45xX9rr1x6o_Nh0Z44BiyJVNg&oe=6A0468BE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6hGa2oMst0Q7kNvwFueDmf&_nc_oc=Adozh45F7Hh6lqmYD7NeXA1Eyw51um6d1tzsMJyRhdVJIFz5anYL9CNqsOo9hwI17UQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af422OWqzlOuXo9TiwJ-JwL4NFqX9P-FH-ODvkOYzn1qPQ&oe=6A048B10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
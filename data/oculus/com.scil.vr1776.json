vtIQ7kNvwFCnsMm&_nc_oc=AdqTlM3uoLSULl3mnAXJKH-8Kt3sl-cQAN8canNnhLbBjRyvrp8DquyrPL44FRs5LpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p-0PY3dDMM0zjDNloV7e4i4dPpBS0nxyn4pWpcIjh6Q&oe=69D4E494"}, {"file_name": "hero.png", "id": "912333321708602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307435_912333328375268_8597055687008392185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhK8srHF2mQQ7kNvwFZn6Pe&_nc_oc=AdqZzRsekz__O7hkrb-B0sepLGDVdoK4U4D8ijkpP405NGQ-_STtz3HSE2jYG6v_XaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OiBpbLo6wIlYEDVWB740Wz7_JjF9nIVtWcg6zwt2XXQ&oe=69D504CD"}]}, "id": "916889461233866", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1977219069542498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307931_1977219072875831_1114393920592825093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVK39YkptF0Q7kNvwGzkYX3&_nc_oc=AdpumsI8BUZhuCbuGB7uHIq6thh3doFeUXEQXLkE8F7KHthbbAKPO9udocPwnXLYkMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00kVM10E7ytSYQe0S7pGCU4mJzuwYqL8cO7nVjvDOZug&oe=69D4E3B1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1cg1OhWLYEQ7kNvwFnovRP&_nc_oc=AdpHDLxc_0hJPDvnOzlbL7jx8-Gf7RRgCpO-U_3mkelvMbNu0zntyGZx9M8CuJDxZME&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YSes-tSAbgb7zLXk5c02nLElwkOiVPEX7Rocdhclalw&oe=69D4FE7F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM8dCy8Ca6cQ7kNvwEZcBkq&_nc_oc=AdqlgdKoIs5ZZ9mQttcb2BKSx-7YH_KrBC81i-rQ6p_z677NYiZI86KEAhqw2rlVIRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37vZn-hfh5SPRoPolzesJpj2rL7C6c1kRvn0P5egV67g&oe=69D4F773"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKFM73eNNXoQ7kNvwFGQylB&_nc_oc=Adqs4WPZL_aOZ3EWuY_DAA173pk_w7eRYak6wMTjNYH58NbezT8Uec21jKyNpPqD8Sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24yZQwRCXdu7kMVapF33hdRWTbe0kPQAp1vE5IT4YV2A&oe=69D4F2BE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI3thEbrM3wQ7kNvwHzoUHj&_nc_oc=AdoK8hrEzIsP9QthUXRs7PVQU3plDyZc0oPgBroSVU3EkMcGCsvVk5MJnAzdOx1-sUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GkcWKC_YscsAIVKxvvzuq8Jc2PhwxRYwdfLDO2Js0-A&oe=69D51510"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26170504519279592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308131_2138162840279438_4169102127195183705_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTjmiJ7ZvSEQ7kNvwG0vp2g&_nc_oc=AdohytmbO82P_bFvSmuGR7ol85OUjnEBvx_Sn531QqsVWwGJMcupuZj9J062fsgEXjk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hvsrWNOGKjCb_V6ZiQvSI-_7Kgtq299jmS04ycMlQ1Q&oe=69D50E85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "1776", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_da
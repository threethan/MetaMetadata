hj0&_nc_oc=AdpMUijaTav33ua-aJDWbwqfdF7eknALdo4PWEOF3iKS9iWDsS4hEQMOEAXOl4kQz4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50uYkgFcaysgZqIXYVu45Omk8jcf11GBqrvEcD7XCWTw&oe=69FB5771"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGoKK3BwWn8Q7kNvwGGtbfi&_nc_oc=AdrSXPpNcAUDkCcfGED3mep6J6-WtDS1M_qr9umO3lxI5p--5VxdOoNhZy51Gcle68g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73rINLWUZrikpRJ1rESzQO5RdWAZc5xFLpUZIniftwvA&oe=69FB39FF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I1JRbLEnLMQ7kNvwEO5Bsu&_nc_oc=AdqVqaMyGI7NZFi43S4dYJ4D-AcDcLrICbz5AheqGsB8LdpyDo32Vuly5pF2yL5wl_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71dy1IDt7XgIaJ6qfvMZAbAgqyFTnexf6T8zpeW6eZKQ&oe=69FB32F3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH_-2ChFYEgQ7kNvwFj3wPr&_nc_oc=AdpLMcqu8Ov87h2b6YsU6RuID9Ye6LAeFRB-hQBdfZ8EHiIG0XfAqXqI97KFf8ef9n8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vK_nMUctob5Vo1C40hj9XIvG7z_Ko1iAh0WTov3lnUQ&oe=69FB2E3E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgSHxUbH5qEQ7kNvwHjutd7&_nc_oc=AdryodslSb7WrSyQRhPrLUsHTbhAWfgS119l2IFxBCMRTTxx21CtCjz1J_qQagiQT48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dix3evxjN4L_CHQYj7G90ls_sRcY63V0Uv_C15h3Lzg&oe=69FB5090"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
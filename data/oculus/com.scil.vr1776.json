6q3&_nc_oc=AdqD8uvN8glKIWab7Jce_CxL2BqOKORNfuye8JNNpD28Us3L2iQbAcP2jlNtNQO3qAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DJ2pp2V6OFtXspeHVLb3ttysqx_zA7Nxcj_zIhJ1ISw&oe=69DF6FB1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXCrbs-US38Q7kNvwGZAmsT&_nc_oc=AdrIZnRWEKeiIRKZ2X8X2NdUS8rRa0maw1R4LgPgqU5s4kYWD8S_3Vtxn2GTIBNfGj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s1WFPUgc39L4tO1ViCp3ozoNsUcFnrnYq2amMOAurgg&oe=69DF8A7F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsMehOjrjpYQ7kNvwHZ43hb&_nc_oc=Ado7wp14FjGQNXt8lPGQWUl5KZL2mJKCKTodOGNP84lqS5w5yAdGCVmWq5ifr_JOeZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YC7lQr40rxujSEFg1GD2e1rLYi-jvj7mrI08NH3RGcQ&oe=69DF8373"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMHf7GjPcBAQ7kNvwEber5T&_nc_oc=AdooOpIpnKKBURaai7PtXkG1EJpP-5hvt9artccf0Zp4VoPzKKua68MN_-BG3jaVTp8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qY5PIpXbEakr9WPx9cZ4JQhYRQKNHft4zAdjLe0yV4g&oe=69DF7EBE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4Q5Tj33VZAQ7kNvwFzDDhA&_nc_oc=AdpcdDNSsftMdLxOIlHC0XqLbUMM3TD__VnVzgAAeQ7oApUt0tAW5BsYGpi8s4Yh6gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UnTJcKO5FZ11-EwI8hw-iQ6GJGbBMx0nbr8PD1Snn3Q&oe=69DFA110"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
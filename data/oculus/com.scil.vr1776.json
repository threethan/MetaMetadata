Yp6&_nc_oc=Ado3gv04lHag2NVuqURuwohciI7y2YFUcxeSrwIV5d6ZGt03qcbYJFQUqdd0d0k-OiU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RAHWdiUJHBqgt0XHt_y12BaLKZ76Fjcuf-qvQuQ44Uw&oe=6A106F71"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzaWXbs-CfsQ7kNvwFGyLus&_nc_oc=AdpIa_SjmIJ2X89JO1vL60hL11QTghxBDTjyeQD9ky2qdUmARrSmCFVa_29PsvdyQJo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rQXoftjAzZHR6aTS4tPcBB6A8lnIA92krYV-0d-gq7A&oe=6A1051FF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Jzlo4-Y9M0Q7kNvwFPpkKc&_nc_oc=AdqpRKa9OvGPKM10QhWclFuP7cRYTC1KCvjvL2IcwHW8a2rTUKlbuXs3v8dK5bBc0K4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sTptLBf8_QmkX46O-XGAaLoWrPqRexD7rPAXjEMYnkA&oe=6A104AF3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PE7sPnjXLoQ7kNvwFmfVMZ&_nc_oc=AdpvociVPomwNNPFSURrLwReVynWqBRDYxYy6jzUE6qO8snG8DMfx182BqhjSk8KBeI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cP6l4h1TXsZeZ_5OfwrJZy3Y6DnkSWXccayzc_WeYRA&oe=6A107E7E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHpgt0ZF4WYQ7kNvwHcpi3_&_nc_oc=Adq2jqxcHw1y83n_jAnBpOKaAiGwgwVp9IhSEX6fpoL4jokNk_8tLXLUMHy8X0L9Png&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fYs0cqmlj9UvAZJ-WkGgH_cwONvyDsY-pQKwGtPwzUw&oe=6A106890"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
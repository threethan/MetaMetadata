.5771-25/499307931_1977219072875831_1114393920592825093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92uI8mjLYkAQ7kNvwHwhzZh&_nc_oc=Ado8YuwPURDhr4CXGaud3orcUMrqAjtVFtlPLlPP9okwmxvTnnllAkIAe0ww3PCOaEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh_b5D_GOGt4fcs8eAS9nY3FF2ofV1QfN2iwdw4P1PkQ&oe=6A9ED171"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxcWvxLhJ_QQ7kNvwGDdk6U&_nc_oc=AdpnVe-aZ5U4AqMT-ppU5aIPpHAryhuPSiSawOkFl5YHtngzCaPz8B0DHVC2PjKHR08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDb97rhV5N0loUaK0qqXiWOjsOr9qxpABpLfcrxBGACA&oe=6A9EB3FF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voJc_JJbm8UQ7kNvwHP0ijC&_nc_oc=Adq8CCs74aT7gYp0mxjsJo2ef6NpLpNuMgoxA45MNlS5R-2emI1O-00KShBohDIXW-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHBZDKzv3z4AT4L51uSzT6e0jRQayBMonanKuIEf-rCA&oe=6A9EACF3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TJz_iRVlxMQ7kNvwEInROE&_nc_oc=AdozWA233K-qDRiXgOxYUi3ivK8oG3FPu1dGXc8CFl9Slx_ci3rU6-RWUY6cRY3zEQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUOfAFnJVKV7uJ2DbF9SfkdfOJ7-0s4xk_4jlRyZyqhQ&oe=6A9EA83E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oArtby4VRqUQ7kNvwEWEgg5&_nc_oc=AdpiLvUtz5wdPU5YQgZKe-UZjZJcwHxKdrCX0HRxsM7_WIZgQUFqhWf5RljdcnvIkug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwU_jl3BOi0kxSXwyuMqhr7I3pVYxhFNCV8aSmwFkdLQ&oe=6A9ECA90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
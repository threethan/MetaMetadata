W88&_nc_oc=AdpAwt_YhinRA36qsbCQpjMeHZudUvICxqrbM9MWcPNrg2ABuJ_sWgyv108efFlskCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dYtxWAV1scO7Xsnoc44b3OrDrq-urNFqnR-2Cde9Org&oe=69E4EDF1"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3eClc_EuUUQ7kNvwHyram8&_nc_oc=Adp7CeUIBE5PTdc4qtTCjr5DabLOx2GTXcWBWNlr-Udg3B-CM7JwI8cgif08VRNc9LY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e0FxKml3_DdPIxb7kGK3x1a1vBdstiUOMz0XbVeNMkA&oe=69E4D07F"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2qzxz9_i_AQ7kNvwFiYKO2&_nc_oc=AdpE6egvn4S1xr8XjxOh0rLR6sU8H81mAxdnUSo_CRjGERDOl3xV-vjmXynZW-qgDEU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27UA7GXBxG-GS9XSiW6NIevjD-fsSuA0C8qgZrKvjGFg&oe=69E4C973"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBRxDQ6Dw7UQ7kNvwEhgV9z&_nc_oc=AdojPNyWoBRHGecXR9xB5p1yGuzvad7V4zcaHGQa8GXfb0heWEDjWgiwgO5JI3ZFTsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0arTUvPzu-XjZ1vsnPxC2da6l7Rlco2_X0yaJZvJ8ayg&oe=69E4C4BE"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHpLgR8ygbMQ7kNvwFQ9-JK&_nc_oc=Adr-LOcjsfKjWWxn65-fwQAf2lXP6j7gCysCXGeXlmzwJMnrpP0bT3jcArHaTcLCiDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CvJAGMWWInyG9oIF047uo-MvGhuWW7uR-qctlqd_TXg&oe=69E4E710"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
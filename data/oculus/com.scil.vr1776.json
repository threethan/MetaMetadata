Kmt&_nc_oc=AdoipGD5c80PcnbMvkLB_jC4CwfXkT4Y63SA9XDxD4ImfQ3nTIYpu0kwoA9xuQZbeDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e1NLbyChVgbp_FduSzRi4qxN-kuQh5ewnoQqllkq4dg&oe=6A05E371"}, {"file_name": "screenshot2.png", "id": "1586131932646424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1586131935979757_6415443282323813694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVaiSvdLMUUQ7kNvwEmrboI&_nc_oc=AdqYx3ThrCHUm9tdGpiPbAP7P3thuAKl9wYe_zEygMxbt5Td4JEYdWBb04fAOqWQFt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zc_hK3FfDRKdBKPIojrza1Li-lhgRpAvdc2T0rbpC3w&oe=6A05C5FF"}, {"file_name": "screenshot3.png", "id": "1276805391070056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1276805394403389_7019576909797764731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iFOJEow48wQ7kNvwEpZKkW&_nc_oc=AdrcSn-m_sAipK9q4MX637698PjzQu92hwu8PC_O2E18EVl6GQHPfNHkdW4l2_KwiRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XkX6Emz1MrtFdEeLA0TZBPe9pDUlwV0oSq85WwARFHA&oe=6A05BEF3"}, {"file_name": "screenshot4.png", "id": "25850572411305127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_25850572417971793_7930413203846720992_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnuKhPzyO5MQ7kNvwGEs5Sx&_nc_oc=AdoD3W22-J7KnNhXGjiwbGITi8LnGnj3ecep8CMvFf-b8pMKMP8DvulBw78OS7tZQks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hNn50yW8M7CdqNgEnJv7_lo9NmkcUC_Xh7ViyfWAHew&oe=6A05BA3E"}, {"file_name": "screenshot5.png", "id": "1944511563122854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1944511566456187_9216020481621606368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bHM4eyO_YoQ7kNvwEL7jOn&_nc_oc=AdrfkZNWuwYyBVldbP_59Qnf49PfAKnMgFvcAKaUrxGD3pB3kWVt5tppmu3z8VMiYMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bumahVlthvWqYHQ-wmbL65q18vDlrj_NhQVweCIKrYg&oe=6A05DC90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "1776", "keywords": ["history", "america", "museum", "USA", "independence"], "long_description": "Have you ever wondered what it would feel like to stand inside the room where the Declaration of Independence was signed? To be surrounded by the people, ideas, and tensions that shaped a nation?\n\n\"1776\" is an immersive virtual reality experience that brings you into the Assembly Room of Independence Hall\u2014not as a distant observer, but as a participant within the space itself. Through a series of interactive, museum-style exhibits, you can explore the documents, artifacts, and stories behind one of the most defining moments in history.\n\nMove freely through the room. Examine the words that changed the course of a nation. Discover the individuals who stood behind them. Each interaction offers a deeper connection to the moment\u2014not as something to be read about, but as something to be experienced.\n\nStep inside history\u2014and see it from within.", "short_description": "Step inside the Assembly Room of Philadelphia\u2019s Independence Hall in an immersive, interactive experience where the people, documents, and ideas behind the Declaration of Independence come to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
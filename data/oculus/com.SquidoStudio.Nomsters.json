c_ohc=hZ6oCHMEEzgQ7kNvwFb2Hah&_nc_oc=Adpo41OZpAwJDux0f2oQAVnCIPKhuEQCcavI1JgxHv8RDuopBn-M_e_CLCmfN8Gd1Xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFbfjJzYdDn4XKaiQ95JHAADac_iGuknBUE1uD1XkBTw&oe=6B072019"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVGUKXnA5kQ7kNvwE-G32h&_nc_oc=AdrNeoL7Uys3p3IyUMCpzeOBlahqlF1Na7EP4cApZYroXLq9oQriqumsAF8fs-_Nn3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUOtH7k4AzL461AVG8x7HxgWTi7dfQo8jdHK0B4cYHbA&oe=6B06FEE8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww8-WG4IwPMQ7kNvwEq3zCd&_nc_oc=AdqrN_zrv2kQFzz3KU98NTH0ng1Z4UagOviw4sdXzlxgSnANqcbcHbUKofJWRxBs-9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBM0oS4DKJ8vkZzsTL5bP7wbZRdadgdNVJ_oAb60VTig&oe=6B070138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clZUH9StAKwQ7kNvwGht82n&_nc_oc=AdpCcD4JVYIh1ATYLChdCt6qP0OYZ68uwiZsDd7hMoZmzlPO-wBrmQCuf5Zr1gdzvro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaCSZsJTjFUI8k2FPJmIgeQFarpQNGR4mkJNsJfAP3Q&oe=6B07148A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
c_ohc=kW12BgCxf70Q7kNvwEnKgGU&_nc_oc=Adp742WW9Vs-t5fnbmamfZSNGkRdDqWvzIMRZnT_ze1Z3Yn4aZRQR0VBefSbFw7qLkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdqk1sCMrrgxZ3cdWgEc67VM5-V1wuU_PMxj8Rd4229Q&oe=6B01DA19"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFqZyDDp-x4Q7kNvwH1YWSZ&_nc_oc=AdpoqwBSe70F7yTzRmVFdCymHcFRAzRTCokAZOdMve-qjIWeg-DAQ_fSqwLdiU21rV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT21NhtgOTqvtGVgDl5JIHIls8VY-r2M9YyUEc3BUukwA&oe=6B01B8E8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v9DRN0B1RoQ7kNvwH5IXWy&_nc_oc=AdrgHR1m0usjTMUK_bK8c5BpuqI-cQLSaUh-Z-RgQLwprjthahvFfeCn6TiEh5Um_WE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoji8MlHaWpxWJixWkmwg_D8U5c00J8YdO2j4Bs6IY0A&oe=6B01BB38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3pBDHOzzhMQ7kNvwGwF1lo&_nc_oc=AdpzzD4t-zW3D1qlE_hTR7J6SSAiLGEwWHDBYDslBc3SOhsgjY0zFtxBxyKv5I1I8-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7df76BY7L41_d08oKmsElHRFuPua2klIH7bXXrYuyAg&oe=6B01CE8A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
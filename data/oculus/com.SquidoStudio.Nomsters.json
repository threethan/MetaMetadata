c_ohc=JGC0m1RLqFIQ7kNvwE4kHti&_nc_oc=Adrx2-ABqfberJZ3PkH1PR1lwD0_sNjL1DlKokSEVvoNCATniqkAr4EwmMFcIhDEDMc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWDWWIPXDaeCIkuowAUdKyTcoJacyrgG_Yj4v2TTMoOw&oe=6B0B1499"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LJD2ewQJ2oQ7kNvwH2Vgwv&_nc_oc=AdrPH_SJ9aax3lpsf-zIUlwdyTgwiV91aN_n-MoQr_JdJ55ahgUkF8uKz3Hooh5R0o0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-IJe5HoJna9KRKq4ziAPrbfozWU63_3WQOx7gekijXA&oe=6B0B2BA8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWoHHncwqrEQ7kNvwF8uEMw&_nc_oc=AdrT54hfCrQ_1cw1kSrxRDj7zCDrE9eqHkiSda31SZd7388z53rp1P-AcRjhw_W5X-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPkuMFfD_gY8K6uvjsi3czEYBvK5KBlRdQQw8hK1F1DA&oe=6B0B2DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4AkOch43gAQ7kNvwH4ImTg&_nc_oc=AdoHY0oyT8Qd0_klNurIDPcQUC0V1TWuruXr-bPHo_7K3ss6EcN5XIg_a48mb-hY1v0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVBrR8rCtERR4wQO6zpjlEtAEji3x4XuJppfjUI_qVmQ&oe=6B0B414A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
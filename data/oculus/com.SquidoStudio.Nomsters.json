c_ohc=_CokVmYA4ToQ7kNvwHBEvQZ&_nc_oc=AdoXBJ4L1P1IJzlShMfF36731tK9x2MrT1kPWyfeCnk73ivJ8OjTefFaDT3omciX8EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJgHWORi-dKRcw1J7QUrOcbgrFC4Y8hLI4Ab2cw8tNMg&oe=6AFDE599"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZXgqxHX21UQ7kNvwHfNTI5&_nc_oc=Adorp23vF6tNzwzVwi1gD-_iT3r_Nnm0guDzlP9lErtinU7dHDiWUo3ngSjMxBb1K0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSHe8S14u0y4CLd8yOoExKfaKYWF4FqWE8uQQLD08ehw&oe=6AFDC468"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Xn_RQ47dEQ7kNvwEnLFg9&_nc_oc=Ado2hTazQ6AIlsPEM1i8haSiSEMQBvUsY-SnGlYeasrMmjca-iQ7sHOpsx2XZBSm_4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEmK-iCU6U8X00R_wwkkuS_EHp-YDXLrxRGd9SnkE1wQ&oe=6AFDC6B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjX_Mkfc-7AQ7kNvwE6SW_S&_nc_oc=Adr6emNXasoDJQrbFtiXQ3jTaKp_9kG0GakuTP0xrKSquw1Ghyh169nr9Pxu9h1cA6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgM-sISJDRI1HQ8LWRvLsCnHfqPl1vWdGb5eF82Nsy-A&oe=6AFDDA0A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
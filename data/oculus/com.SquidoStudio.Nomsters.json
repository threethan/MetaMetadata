c_ohc=wjg_avwvMn8Q7kNvwHdNJ1a&_nc_oc=AdoH9goefAgkEeQ8HYlMaSB8dhsO00nhk8Af5eFQLNy_enFoNkCaksV3MlP88wFwNUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKMq2RSb2IG6I2wVxkbxKPtka2fzmG1LeQs6eWdrNSnA&oe=6AFC9419"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNfxwogLtyUQ7kNvwHDnATk&_nc_oc=Adrf21wKdRyeHonGfHNCYHGS29k97Ik1DNgIZ2_f6tWLtcLiBzISewxkBC571mDel2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThVJGxYpRa7wGaE5ORvcpYSHNb6ZcHBh3AYI3zQTFwuw&oe=6AFC72E8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Xn_RQ47dEQ7kNvwG5_aIO&_nc_oc=AdoY9cxOTsbGI2xQlu0Oos5EZvWmL1tH9nLwd14TA2Nx4BgBfH-mSYzy6J9gyWuATV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAKtvGNljTrSVIK0CRtMNagct7Mc9NZPZA9aeDzMPdZQ&oe=6AFC7538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjX_Mkfc-7AQ7kNvwGPzdEk&_nc_oc=AdpVh-6RJaLw2es4JY57l5nIWPLUYGs_oDt_NRWd1qsHNf2gxPy0Xdbp9YJV-dNhQt4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0SLv94Sz1R-OEFbYdy2KqbbHqgcCHcvact3GmyA0M2g&oe=6AFC888A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
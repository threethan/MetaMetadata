c_ohc=MfHVXdDzgHoQ7kNvwGe6ceo&_nc_oc=AdqACd5kKiMgjjXstClQkN_YM7DFgB6F-uub0n3f3eKD2xTKULV3hctiGLCUx9c0cKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjLmTTWo2kEuxdk4xtA_QhK9FCzd87kreyE3XJ585D0w&oe=6B0DB799"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErAO8EnEto4Q7kNvwGTqDRj&_nc_oc=AdqHhhQy20QSKuKImwy1CDtP-pJiyaca3p-Ho5DVX4n6thZCZZobfk5asof3Lez1p4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR48fzJu7uFH-uWI56KM0ztL9-_EyBUmx6vSku_bl4zIA&oe=6B0DCEA8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo83QFFoMEIQ7kNvwENmnQe&_nc_oc=Adoa1RYwmIoMvYdPv2FD5GkAnV1ENdkBhUvWoa0kO_IbXgSRsuJPY_WsKiwmrGd4z4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI6QDFvy-BvoLSMdP_2b82bTj3DDA3jWUZglB19HpQRw&oe=6B0DD0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4AkOch43gAQ7kNvwEmugJs&_nc_oc=AdpIBjYoGKd6SCFehJnwRs7YwiAIKoxVdFBr95gRT8aCft41SEiKzF4hvqTJwY_FkXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsv5m95GMXFzVvHYBjL0nHG08msxdNx9eSPdsep_u9lA&oe=6B0DAC0A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
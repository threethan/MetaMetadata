c_ohc=hZ6oCHMEEzgQ7kNvwEpN9Tz&_nc_oc=Adppe30UHFte9OM1DXmKjqjEBusFDqqJd9Z-faNd-kevMSaugy05_ghLU7a7xKPRpeA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7nUVJIE3YKuySbNl90pNi0HdVD7JMVqK3AWOnLaXrjQ&oe=6B087199"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVGUKXnA5kQ7kNvwEILq5l&_nc_oc=AdobpBU9FSltirn3VEeoqHFq1kViw_0h6oT_xY-E01XRi7pL3deEdiajaPwnVZAyHdA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYFincL39V9W59XMeUP-TX74dItu5AKrxDWXMwEXsdHQ&oe=6B085068"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWoHHncwqrEQ7kNvwE5EStV&_nc_oc=AdoZCe7UODdNtq1YEULhzAa2gHrRzRjMvX8lFjJ0olPJbIF0MjtA8vaXXzBc_hiaB7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXXlqjUqwG0vhskBOsJ69M7ftgy4jAnyIGsX3dIVuONQ&oe=6B0852B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clZUH9StAKwQ7kNvwF3dAe9&_nc_oc=AdoxI3OoGKuBzmekBrWOjZ2xOejw7SFteB4YDG13VbUyr7iHpseFQ01lfA_hnk9P2eI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW3aOH3Yr0Sbluua6Y6Mj2w37eY_W5q1asr_f2loRcAw&oe=6B08660A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
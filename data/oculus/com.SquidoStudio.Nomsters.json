c_ohc=kW12BgCxf70Q7kNvwEa2YFz&_nc_oc=AdrDmM-l4Oqc7rNjDpTwgrFsfWOqs7yy58zRYr5SFbN4gIR10NE1tmFqvG8tSLgHsks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFk9Rnkd4YtiHHSw8lz18a2p18pTsaR3yM66n1T_Ht-A&oe=6B047D19"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFqZyDDp-x4Q7kNvwGXuHSE&_nc_oc=AdpRNjwWgStFNAIyJFshT_-O2ViHT0JhXLRhGlmmX4q6AOCRi4VzHMmCwvAg3lZFhPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEYPeGVGJbmu5CS7J0537BQ0gD7Ee2AVhrDZu_5li1mA&oe=6B045BE8"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww8-WG4IwPMQ7kNvwGSpmxg&_nc_oc=AdoskpAwYFjfIXBjQhDN96iebngHVvPtevteQvYzAgufDtE0dr-2gzUV7EgKFtZPRHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH90gMwLoRd7MXhVUCcS2sH8p6EIP1ZsOf5Z_TWcOTVg&oe=6B045E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URsNpBzzuzkQ7kNvwEmAtn0&_nc_oc=AdomHfxh9vi5TBS0CTG2FVcNLS9iIu9DBUf0h5lFFpAnoxSBnGbCnvDhYxFdFfFeoWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLawwUEOMia4dTg1rflbynil4x7sIavgZxiAMfLTsBVQ&oe=6B04718A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
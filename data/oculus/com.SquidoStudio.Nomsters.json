ontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPNADOEO8RgQ7kNvwGphGKn&_nc_oc=AdposEC62Q_Zfbcbj0WVaYMzUErvbi8PrkkiVsa8PX0z8RC54fFSjM7rEwl9Js6P3Eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkZY5inVqVo3fPWRWXjDMrTGMm5qD3yHBJu8RIlk4C0g&oe=6ACBAB68"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw4oqzuGoWMQ7kNvwFEq_aO&_nc_oc=AdpAyF_byPAmzzzhWR1TWe5GU4GMqc6eMesserRVQibv5Az6Lki1freSRzFCdwW6ZDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUeOUe-okatQxO43SqQCpSbcbDZmeIDAtVmCzrKmWVZg&oe=6ACBADB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nomsters_Key_Art.png", "id": "1430376912358320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1430376915691653_6591388710931394295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEV2XXXI-dIQ7kNvwEmVO6J&_nc_oc=AdrkeyZbiETi6BiPBCBz0b6Uh9bCh7uzt3wdMfPHQzYaLRpDOCt4cv5sS9gNVyHyj8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP13SEmPgqkNzXPRlaCYeRIZBpg_tXsRGkvUZoXma66Rg&oe=6ACBC3D1"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "https://www.squidostudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in
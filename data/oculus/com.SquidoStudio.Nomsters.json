c_ohc=wjg_avwvMn8Q7kNvwHoh93c&_nc_oc=AdqP_lRsbMQ-qapoypFUEYiEVnfjg8Qsm0nMyIvTd-h8OYVnw5OhuDIMKpfqYxjnHYk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2PShT-yCRHnukcLV3DEK_iCqi0Q4uesW7dJ8AxnvC2Q&oe=6AFB4299"}, {"file_name": "12.png", "id": "1068362532489121", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_1068362535822454_6230875394400575060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNfxwogLtyUQ7kNvwGFSCgX&_nc_oc=AdqylYgdmfqFJIT5dHbT5-lhOqorurIeDNJlWHU-taAHRBXJXzBkLRUDxrzg9a6cMMk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRopWoFwdkq3-LLHlnxXnncBk12SPnuGXC1OiP_aQ4VOg&oe=6AFB2168"}, {"file_name": "3.png", "id": "2002471743790232", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673751957_2002471747123565_4843422407617544862_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl2v02H5d3sQ7kNvwH1B1os&_nc_oc=AdrmqmzKidytqY0qAcFpkxLX5dIC-u626H-kqWqVAqMFxLh5GRnjM8Qr5ZdBmhH2id4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF-H6cu50ISVSDRY5TLIUuV-hU0RUVZEhW9oVxSDPu8w&oe=6AFB23B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Key Art 2 - Landscape.png", "id": "1797263227990161", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620341_1797263231323494_3691304083327763660_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjX_Mkfc-7AQ7kNvwGGqe71&_nc_oc=Adq543AW8P7L1-AOuBS_VGotWIERq4Bzj7ZS_ZuGw5Lqs3KwNXCgFivvkuqTtxXB7TA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt8Pt8lkikg2SfAH3fQLM6VILiA2ycJ3frk-dciYiAmw&oe=6AFB370A"}, "display_name": "Nomsters", "keywords": ["pet", "collection", "idle", "multiplayer", "social"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                  \n\n# Collect. Mutate. Trade. Rebirth!\n{2480966755724977}\n**\ud83d\ude0e Become an OG, Join Discord:** https://discord.gg/nomsters\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!\n\n# Key Features\n\ud83d\udc3e **Collect & Mutate**: Discover dozens of unique Nomsters across various rarities. Experiment with mutations to unlock rare, powerful forms, and build the ultimate companion group to take out into the world.\n\n\ud83e\udd1d **Trade with Friends**: Got duplicates or hunting for that missing Nomster? Trade with other players to complete your collection!\n\n\u26cf\ufe0f **Fun Game Modes**: Put your Nomsters to work! Send your companions into Mining to gather valuable resources, or jump into Defense mode to ward off incoming threats and earn exclusive rewards.\n\n\ud83d\udd04 **Rebirth & Grow**: Power up through the Rebirth system. Reset your progress to unlock new abilities, boost your stats, and upgrade your home base!\n\n**Ready to meet your new best friends?** ", "short_description": "Collect. Mutate. Trade. Rebirth!\n\nStep into the charming, cozy world of Nomsters, the ultimate relaxing creature-collector in VR! Gather adorable companions, build your dream team, and take them along as you explore and grow together. Whether you\u2019re a casual collector or a completionist, there\u2019s always a new Nomster waiting to be found!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": null, "website_url": "http
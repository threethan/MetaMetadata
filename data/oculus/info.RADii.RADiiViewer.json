5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVYGNIJ52tYQ7kNvwFX1nH3&_nc_oc=AdmrQkOvzJYlx5wpAsWpUayGI7D8nHc-wGCJZYI8XzqrE_wp8C9q96zs80928iOCS3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftB9cTOmhUCdaW5cDDZZoWlEtF9Lqne9S3wqr9Ue-itZA&oe=69A41F9B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGUt3f9S0iYQ7kNvwF64WeB&_nc_oc=Admbfs5oR9vh6fZu1SPLDnVrrRQkLy-exJ6twDBcSjInbHCbT8xg33LHrlf4n6iWtRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvdnoQWkvT0aRXApDRaBJvngHucPrHn2EMPcRSnjdhfGA&oe=69A42D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igYhIjvydkIQ7kNvwEZbf7g&_nc_oc=Adnv3_Nn0-DLxmcHDl8il-Fs7D_xSIyn0BC2TZGPRrRSgxfn31hZp6muorxM8e3jET8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs5nxyACkXwM07lrpHeEInUemsWTIdiBCFnq2IcicKVfA&oe=69A44236"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
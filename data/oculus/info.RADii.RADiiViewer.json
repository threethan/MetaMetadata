5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_I0dw_VJp8Q7kNvwH64ZId&_nc_oc=AdlUNOcoD1Hw9BRkeE3-GsLpWwfcCJdHipBOYsbwBBGvlpTNS9Pk16Em8nRQx4S5BI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPoE0vzVqmWaROOnbyz1mM_fKKhtTnv7x-PI4KlQwU0Q&oe=69A2CE1B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGUt3f9S0iYQ7kNvwFZyIQn&_nc_oc=AdmnhqRO7_NDx2SU3iy-kkC587lBBvVXozZkLaY5HIJv0KgZidXglFcshu-F4nc_wcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9mvhotihxec_TwnryVzMoaFStvPPRZb7cpEOERMpuRw&oe=69A2DBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfxMPtbXZ58Q7kNvwEr7W1L&_nc_oc=Adnn7id11bm_CFna37PhNg72fmRvoOELNxqW0WFpx9MDtRx_DspREGeXzU56GwK7xlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPy2JZE6AXZY5JcmWYmGhl9RpKVmZqHBrrYK82VKHTRw&oe=69A2F0B6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
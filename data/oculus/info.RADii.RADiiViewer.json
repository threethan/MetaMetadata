5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_I0dw_VJp8Q7kNvwFC4TjU&_nc_oc=AdnOdYGsnZKpUwtU40NK_ZK5F0Pu32j90CB4TNxJIZFiFK7ZUhV-4fD7Zij6Iw3cuT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCrGxZ2aUvKsfbAxRGI_XoD2EGXuPpHRWjV-xJ1B-kOg&oe=69A02B1B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAV0OYieua4Q7kNvwHLbgAU&_nc_oc=AdmvR7_ItACSfn66GKEitd2q9nyHm2rWreITUL8uHRnjmDKkR-24SMxJHJsYZqDM7tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhwHnLDxeX_rBNVFsLle5mueR4H5O_TPnMOfQSZ-cHRQ&oe=69A038D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfxMPtbXZ58Q7kNvwFj-tyf&_nc_oc=Adn85-ymKoMWYN_kOsSnh4u4m-muNXk7q0EqdUAtZVAhJUtRecg3Y49az4zZzAuxXVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7Wb1lai2LhHwkjONMUdDppBzkapSjgQGpCJn_HbXeRA&oe=69A04DB6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
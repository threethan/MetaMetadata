5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfFYgJVQvtwQ7kNvwF4FAam&_nc_oc=Adk3T-0oQuvKpZXOewRuJLSk_tNbgfMKijjdHt447W_zIJx8fgFponBvqeFQ3p4cQfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu4B9BRnOSuIsCZh3WuBtzC4Eq5oAXiYfXdJ1ck1bUFhA&oe=699AE51B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_u-7UrodBsQ7kNvwGm4H5T&_nc_oc=AdkgONp6vU_HXXaEjCc9AxYrG8UZ6BAeLijtkK1PhMPd0ECYN7_rRnnFptyUsL-s0tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuDIczLL8csj9ccTj4ZBTAqFI6xCRN_pPHpfIT9E6HO9Q&oe=699AF2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HUlbtgF5IUQ7kNvwHXROqi&_nc_oc=AdnPAWQAtDsvNzaKM1EhG48xskww7ewk27-fr2CQE_qPEcWkzk3p2wgwvE3YEiWTuY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuaxk-wY9vgtej_SCVOM1gKJvrC5Y2WR_CoVcsHQPSiKw&oe=699B07B6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVYGNIJ52tYQ7kNvwEdsIfD&_nc_oc=Adnp6YikYUwCZmQny6kGHPAoq4FE2ECffGXEs8tMN7jFJO88h3Lz9lM0wcdtkv1R7Eo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsPS4_yTTuFpH1nTkY8ghjjWLI8N_lIS-WaYkHWKS5Pmw&oe=69A5711B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGUt3f9S0iYQ7kNvwG8PT5K&_nc_oc=AdmVIwEKmNa2iVPrnMZ8BPeUaT6i2RRnJQ_v6unur_UyxXbAJx_ChQ73Pr7mz6CE_TA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftSonFbwBOF-mumfE5v2r-qCVHHK80mjZUjK34FlhIyRA&oe=69A57ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igYhIjvydkIQ7kNvwHUdgLZ&_nc_oc=AdnlYZmNF7URaM5mlB75cHjYCoaQ5yrffZmr4B3sArXBZTg_j1K8kq6Ti1sZbcRqRW4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuYHroMSUK0JTsjrMc2PoqvQgqkNqlMUK8_r99nIGvM_Q&oe=69A593B6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
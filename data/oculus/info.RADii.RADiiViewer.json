5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfFYgJVQvtwQ7kNvwGkLL8e&_nc_oc=AdkkruASfTMEsfflxt87wbhGzDlJWibp5tzR94_7M563rdn4NIDtR3ccqpCLro64MpQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuu58kcwRQrEp10zAvK82BTF_449bKahse7VDCrum1Rug&oe=6998421B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX09PcYmGmgQ7kNvwH0fgVS&_nc_oc=AdmnxB2_wgRoFnmJKEXoa-t5sGbxNaype30awJ_73Ef6XHyOaRl0HrkN7vJUn7SCnro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftuGsYRvJ3qmJauAxGeWl6XMnCbGXnyIyDG24ZzRoweSA&oe=69984FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HUlbtgF5IUQ7kNvwFV7XJk&_nc_oc=AdlNtuZNTHOIcv7zlAx-tQfl1UgAualFVcjT64wa8rfyZduf1Sv699NF6F5Zhf40Tns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsSNJfsgaKJtFONRaXXXL2qS812PMAxU2DMmD6qvn1gjA&oe=699864B6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
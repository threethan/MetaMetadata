5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVYGNIJ52tYQ7kNvwFDSRN2&_nc_oc=AdlLcAD_Ue6GpzMvp156Ft4JrH7-FE47L0wAM-MZVRv4AFDaIt9iG8uMZUuiLiMHH-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftshKITJAKHyJYAp8aAHHBDYSIcTbWd-egPr9NVgW_L1g&oe=69A6C29B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt_5E9JzpJIQ7kNvwGN9RfZ&_nc_oc=Admru7kd1HA14sHnDdWnLBzPTFYm7Zj3_rXfF_S18-AZ6YLoTwbwBRuYGoDDa7ihJd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvcepWAIWcUpWKzK84fSBZOTpPS4fj6-svOe5RwSI_1qQ&oe=69A6D057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igYhIjvydkIQ7kNvwEJdJVw&_nc_oc=AdlHeFC8E944NsL-1a0DICIIK5PtxZ5pLovEopuUaKS_M4QLkoRz6scp_Lw48uPGEas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWVe6aQf1nvWCplvTbFbH81KziGBWp236xEUns2efKVA&oe=69A6E536"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
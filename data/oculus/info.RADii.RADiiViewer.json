5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPdL0ZCtASIQ7kNvwGulsgX&_nc_oc=AdmgOCZPk84vILsKb5msaHf_JFR2mCqwjaTnd2pUmGYWcf_Se8LiDWFxkZs0s9xchwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftb_1_7rh6Zd_vNbEPL8EZ6Us_imS1tFt6rl5J0GttQ1A&oe=699D881B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_u-7UrodBsQ7kNvwHcjlaT&_nc_oc=AdnuVPHSxM7xzdaEkk-FuWK6nMUEEfMxbbl5ai42dE5Y3x8NONwASBd77t7LR9uGp0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDCHe5ri_DASrRLUcU9cDBC5WqSeMZbU8xPj7B8I_BkQ&oe=699D95D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWIstOusUr8Q7kNvwF5QMbM&_nc_oc=AdlpviYli8eOYV4MyFMR1DBhtl7J1Oyc5f5Wt-2UzGZv5-ln18vc99yLkCVZTOaVNWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1u7Inx9RXeEyXc_QM4IG2gL7OXwfF33BCRADyP200JA&oe=699DAAB6"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
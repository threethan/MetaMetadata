5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzhgMHeqBJUQ7kNvwFCNSOO&_nc_oc=AdpTCE-9H_SCLCI8gshuBy7OmRVtfevOtSkGlQiauSyEASr3wvADnw51LD7CAI-jXiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1HQOQbOT7WD0q-RS3yKjubLMWdhH8FRDNvw6tXB_aeFg&oe=69F0CEDB"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HaYYV8tqgQ7kNvwHqFyAU&_nc_oc=AdoJUzeu5CquZxseFeWxenNNl4RLX06P-pWTr6Ch9h2PyniJWxgPoHY_N9sXJXEMSqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Votf8LPTitDbSnf81cnbVZuzMJuWzXi4PPFelpi7maA&oe=69F0A457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1T8i7hGAfEQ7kNvwHsVDHC&_nc_oc=AdpHJgXMwPIJxdYuKOJabOleRK58i5wagNWgYrWFU5o2ZablTQbXFoT1KWU9tyLObNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0yd8bPaOBsEwdw-11gUUeTQidaYHaFy5jcAmXTHygglQ&oe=69F0B936"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
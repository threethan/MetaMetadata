5379_1090100975944916_4049034355931690420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPdL0ZCtASIQ7kNvwGunARq&_nc_oc=AdkEQ7tbC9xMBoh7s5-6QSQbVjElnBUJwhsYsgpSDobmz3NL4WmCPMY9Y8ta_yWtKyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afso7cFtgtnm6CSMpjEdI61BvR6K3fo0Jpi47gjegcdDfg&oe=699C369B"}, {"file_name": "info.RADii.RADiiViewer-20241127-205255.png", "id": "600543612544660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_600543615877993_8724840556345744964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_u-7UrodBsQ7kNvwGXAWqV&_nc_oc=AdlNWjMbZjWMzVIlmm1nEzGU24wEDtA6h3Y79VGtK3FaUZKNKrysAaqZ4HdV3Bdvsuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs8RsaOZxIFHiNXHhX2PHQEa1JeeL7z3soGc4_otovN3Q&oe=699C4457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "912014276666263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001675_912014283332929_7520689346952586388_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWIstOusUr8Q7kNvwGTBwiE&_nc_oc=AdmCfigPo5psGG0pIPO-HCEDqflQWiu6y5_oUr8A8zJgv2q_dcejskpZzz4AFSYA_Zs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssHWjhll0NpSF8gn6xUyY344XBesLlwI9ybZYl4Y1I6g&oe=699C5936"}, "display_name": "RADii Viewer", "keywords": ["Architecture", "Visualization", "Collaboration", "Rhino", "Grasshopper"], "long_description": "RADii is a cross platform content distribution and collaboration platform aimed at designers and architects allowing you to spatially explore and share your designs in real time through AR and VR. Content is created in Rhino 3D and instantly published on your channel or saved online and later retrieved from a cloud server on demand, as well as saved locally on your device for future offline use. Download the Rhino 3D publishing plugin at radii.info to connect directly to viewers world wide.", "short_description": "Viewer for the RADii Rhino 3D plugin"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radii.info
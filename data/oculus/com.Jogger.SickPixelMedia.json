splay_name": "Jogger", "keywords": ["Endless", "Runner", "Crossy", "Jog", "Frogger"], "long_description": "The playing in traffic simulator, with aliens!!\nExperience the thrill of running through traffic! Dodge cars and trains to get that high score, but beware, you are not alone. Run fast or be disintegrated!\n\nIn Jogger, you are the controller! Stand up and jog on the spot to move forward in the virtual world, giving you the most immersive traffic dodging experience around.", "short_description": "The playing in traffic simulator, with aliens!!\nExperience the thrill of running through traffic! Dodge cars and trains to get that high score, but beware, you are not alone. Run fast or be disintegrated!\n\nIn Jogger, you are the controller! Stand up and jog on the spot to move forward in the virtual world, giving you the most immersive traffic dodging experience around."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sickpixelmedia.com/", "developer_terms_of_service_url": "http://sickpixelmedia.com/", "publisher_name": "Sick Pixel Media", "support_website_url": null, "website_url": "http://sickpixelmedia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "219185110427324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727868_1490472167649417_3804321377545093120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW19kMUD7G8Q7kNvwH0uHxk&_nc_o
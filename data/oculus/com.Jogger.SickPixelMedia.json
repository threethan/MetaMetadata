r": null, "video_trailer_thumbnail": {"file_name": "Video_Cover_02.png", "id": "116971469031166", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_116971472364499_4277944360626028544_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOUDHOW4WTgQ7kNvwGj-A_K&_nc_oc=AdpmOk80ldUvtlitqn4BHo73ui100FezAlN2cWROkJ0GCcAFDbIgswVhuZEaxY14X4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT90aRK5tEDRnUxqTXowBuChDZU_xMd7GNL0REGL1w28w&oe=6B0C52E8"}, "display_name": "Jogger", "keywords": ["Endless", "Runner", "Crossy", "Jog", "Frogger"], "long_description": "The playing in traffic simulator, with aliens!!\nExperience the thrill of running through traffic! Dodge cars and trains to get that high score, but beware, you are not alone. Run fast or be disintegrated!\n\nIn Jogger, you are the controller! Stand up and jog on the spot to move forward in the virtual world, giving you the most immersive traffic dodging experience around.", "short_description": "The playing in traffic simulator, with aliens!!\nExperience the thrill of running through traffic! Dodge cars and trains to get that high score, but beware, you are not alone. Run fast or be disintegrated!\n\nIn Jogger, you are the controller! Stand up and jog on the spot to move forward in the virtual world, giving you the most immersive traffic dodging experience around."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sickpixelmedia.com/", "developer_terms_of_service_url": "http://sickpixelmedia.com/", "publisher_name": "Sick Pixel Media", "support_website_url": null, "website_url": "http://sickpixelmedia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
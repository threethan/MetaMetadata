6zdKEeq1aKudTX59SzHxB_2zaPT_wgbGicfyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6OqBUbTY9Brx3aVBdxYlFTC_PWGKMw8VfF2aHBUJKFQ&oe=69CE5621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "288845444875343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162695_288845451542009_977113993371975680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iUGt1ELv0YQ7kNvwHiIZAl&_nc_oc=Ado_ZOluL5PcNP5meICP53Iw3VQv49EDRg5RT1fmPIqoDAjAaQauEAyR6K6ctqVf-p0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrOKFYJdjVSsnS6pC8EWToERCV9pZPZleXIp6OHuJFUw&oe=69CE756C"}, "display_name": "Jigsaw Puzzle VR", "keywords": ["Jigsaw", "Puzzle", "Game", "VR", "Fun"], "long_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay.", "short_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://riseangle.com/games/jigsaw-puzzle-vr/jigsaw-puzzle-vr-privacy-policy", "developer_terms_of_service_url": "http://riseangle.com/games/jigsaw-puzzle-vr/terms-of-s
0C68F8"}, {"file_name": "migrated_image.png", "id": "559380688004783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_279159535875167_5284321155891593216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djXRWIzdJAYQ7kNvwH6x1G5&_nc_oc=AdoDLBbh9iOud_gN6PUOzC3ni7lZ4O5Fz-Oil-p8P1lYL6oLtkFwkVBpMRmR841ZZFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbYdbe9dqDs29YMWf5G4WodyjRCwAyRkNU6Dc9xaumWQ&oe=6B0C8021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "288845444875343", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162695_288845451542009_977113993371975680_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLTPSdTnHNcQ7kNvwGhNMhe&_nc_oc=AdqhOg7SEhVgGJ9QbxFe4TygR5UPvhDor8_Ijoq3YY_qMq5_6xJ3I0IMaBRelk662VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuDJDVottRWEJtYo6UwZvtgI5JtNeFIb8HHnBAwdD8lg&oe=6B0C672C"}, "display_name": "Jigsaw Puzzle VR", "keywords": ["Jigsaw", "Puzzle", "Game", "VR", "Fun"], "long_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay.", "short_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://riseangle.com/games/jigsaw-puzzle-vr/jigsaw-puzzle-vr-privacy-policy", "developer_terms_of_service_url": "http://riseangle.com/games/jigsaw-puzzle-vr/terms-of-service", "publisher_name": "RiseAngle, Inc.", "support_website_url": null, "website_url": "http://riseangle.com/games/jigsaw-puzzle-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "648796216321020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_120006955232128_1966309742632501248_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAydpclh_GEQ7kNvwFHWB4p&_nc_oc=AdoGzbfqhkXJRwd0KqvKbgSfRvVR383IqMdsW6t0RFUJB3Fi1mWHmmquM6M9eaHetLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQVW5zPrG7YM85duJGZQvQZjntGC5mbEx9Falwfbc3pA&oe=6B0C7182"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jigsaw Puzzle VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499294650, "lastRevision": {"nodes": [{"id": "272638999845778", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1476293569079509", "is_first_party": false, 
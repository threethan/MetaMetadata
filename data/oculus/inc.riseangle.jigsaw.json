0F0BF8"}, {"file_name": "migrated_image.png", "id": "559380688004783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_279159535875167_5284321155891593216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LDYi9VphN8Q7kNvwHdzMrn&_nc_oc=Adqrtzd49D4dlCEvLq9e1UyRYvwhW3dWcbWOBp94J7ISOw5LMasE4RNIp8OWxB1Z12o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQ39SxjwDQKwuJy0R8tTtPRr-qEBTMEN02HsxiPIsL4Q&oe=6B0F2321"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "288845444875343", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162695_288845451542009_977113993371975680_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVr1UGPaLHQQ7kNvwHsPOG0&_nc_oc=AdqK2STfXBVcuUdqccN0_IoFGV5ck9ejROJUev0Ba4znFpGxGWyTvE660l_sRRN6zRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPWQFXCwf80dJo00sAXvZoMYnO_EDMkO8E6QTwr3oUmQ&oe=6B0F0A2C"}, "display_name": "Jigsaw Puzzle VR", "keywords": ["Jigsaw", "Puzzle", "Game", "VR", "Fun"], "long_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay.", "short_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://riseangle.com/games/jigsaw-puzzle-vr/jigsaw-puzzle-vr-privacy-policy", "developer_terms_of_service_url": "http://riseangle.com/games/jigsaw-puzzle-vr/terms-of-service", "publisher_name": "RiseAngle, Inc.", "support_website_url": null, "website_url": "http://riseangle.com/games/jigsaw-puzzle-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "648796216321020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_120006955232128_1966309742632501248_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st0AbFhfBI0Q7kNvwGCZC3v&_nc_oc=AdrSWhdy7zThHmHrklO4HJXGNibkC7Ze1s0oouYs68q3mgkEzBkgODjpRrnW4NoJAAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeG-B9nvRNuo-ks2NAt6p1HDseGfDWuSAAzPce2DaKUQ&oe=6B0F1482"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jigsaw Puzzle VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499294650, "lastRevision": {"nodes": [{"id": "272638999845778", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1476293569079509", "is_first_party": false, 
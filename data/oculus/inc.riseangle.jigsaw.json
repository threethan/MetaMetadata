rV7wH7H0M93VspJ50vDoZVds8BleEA6ymZKuw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rkzwSleVHO6Nzx0WTGMGB_xw7zdA5TgWKFacbF2INDA&oe=6A3FEF61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "288845444875343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162695_288845451542009_977113993371975680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXRGGsu3pkcQ7kNvwGE1ODs&_nc_oc=Adp16YOsJ5XHClkDHaSJ-2qxbznOgtvcbVh5lXpNccqiPuAXhoOX_WSKz1GsXz7LbTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p26HShnnyJqwX6zwD2QEhk3ECS8O8zoYtXeP6o5PfeQ&oe=6A3FD66C"}, "display_name": "Jigsaw Puzzle VR", "keywords": ["Jigsaw", "Puzzle", "Game", "VR", "Fun"], "long_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay.", "short_description": "For the first time ever, you can enjoy playing jigsaw puzzle in real 3D and in VR. Jigsaw Puzzle VR is a highly appealing game for every gender and age and a real catch for jigsaw puzzle fans. Enjoy playing 25 different puzzles from fantasy characters to cars to animals. Start a relax game with easy mode and challenge yourself all the way to hard mode created for hardcore puzzle fans. Finally have fun playing the game in eye-catching environments designed to immerse you in the gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://riseangle.com/games/jigsaw-puzzle-vr/jigsaw-puzzle-vr-privacy-policy", "developer_terms_of_service_url": "http://riseangle.com/games/jigsaw-puzzle-vr/terms-of-s
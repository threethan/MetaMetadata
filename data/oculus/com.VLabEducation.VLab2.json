oe=69B6A08F"}, {"file_name": "heatcubes.png", "id": "400111065793350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569457_400111069126683_8965847202104538532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReG9YsgsQcMQ7kNvwG6rkhB&_nc_oc=AdmHi_m2XeGifmlos8tUKXfn_8egJZ6q2Bf_84jNK9ZNLrIc5nP5l-35veL8dzQLJiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxenfKElDOF0lPcjySKFGeiq47xE8BhsWY55xbxIc8wJw&oe=69B6A9AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_V1_2560_x_1440px.png", "id": "730301552383804", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982678_730301555717137_7855222203358388011_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaE1TEvwEWkQ7kNvwECnl6f&_nc_oc=Adlr00-GRSGBpwLzD7ja-Q0okmu7tOsQQCKPQSLfi3SoRWYeR_uNd6SXKlM-8h7LREQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydeNXRBxPlyM-kkcoB4sOEYQ8TDHS4Y12tygNoVEInpw&oe=69B6C0DD"}, "display_name": "VLab Education", "keywords": [], "long_description": "Welcome to VLab - where you are the scientist. Experience the thrills of discovery in our high school-level immersive chemistry labs. Conduct experiments too dangerous, costly, or time-consuming for a classroom from anywhere.\n\nKey Features:\nReal-World Labs from Real-world Scientists: Perform realistic experiments designed by professional scientists.\n\nOpen-Ended Experimentation: Our reactions are designed to accurately continue regardless of mistakes, encouraging learning from every outcome, especially failures.\n\nMolecular Insights: Visualize chemistry up close in a way unachievable in the real world.\n\nSupporting Resources: A VR lab tablet to record data that can be paired with a VLab Education account to view your results outside of VR. Supplemental materials such as Safety Data Sheets (SDS), background information, and pre/post lab questions are available on our website, www.v-lab-education.com\n\nNGSS aligned: Our experiments are designed to cover key topics of the Next Generation Science Standards.\n\nWe are continuously evolving, with your feedback, regularly adding new features and experiments. Download now to become a scientist today!", "short_description": "Dive into the future of STEM learning with VLab Education! Experience the thrill of discovery as you investigate real-world phenomena through the scientific method. As a VLab Scientist, you perform true-to-life reactions, collect data, and analyze results in our simulated chemistry labs. Vlab allows you to unleash your scientific curiosity and witness the unseen micro world in a whole new way. Transform the way you learn by joining our community of up-and-coming scientists today."}]}, "developer_name": "VLab Education Inc.", "developer_privacy_policy_url": "https://docs.google.com/document/d/1bNtqtFbpU9pryj9HiD765Gx8m7lbqq4v/edit?usp=sharing&ouid=104461742025002327164&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "VLab Education Inc.", "support_website_url": null, "website_url": "https://www.v-lab-education.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6903511273091041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "391706209896564"}]}, "baseline_offer": {"id": "391706209896564"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706815665, "status": "PUBLISHED", "id": "391706209896564"}]
oe=69AD660F"}, {"file_name": "heatcubes.png", "id": "400111065793350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569457_400111069126683_8965847202104538532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG8XjVoV8XMQ7kNvwFH3ola&_nc_oc=AdlD-Wb5WnEhLyEnL6qnNZhkNTwjlV8kVuhxaPu3Ai_rWHGhjOw30Af4uD0D_zzA9fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVL2UH72GbT1BUPTesPtCHR_yuD9-3NOfRRotjbxt_4Q&oe=69AD6F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_V1_2560_x_1440px.png", "id": "730301552383804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_730301555717137_7855222203358388011_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXohJr0mOAYQ7kNvwEdi9dq&_nc_oc=AdlLU5jmCJHXO-Z-0Xwm229ogrkyql5ig16A_9lyOm_uvDI_5jBA3dTz3x_3OQJSzaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhrzJX1vNfK3XDBqvA8RolurVN4dy3PUy5K6gnpwPkQA&oe=69AD865D"}, "display_name": "VLab Education", "keywords": [], "long_description": "Welcome to VLab - where you are the scientist. Experience the thrills of discovery in our high school-level immersive chemistry labs. Conduct experiments too dangerous, costly, or time-consuming for a classroom from anywhere.\n\nKey Features:\nReal-World Labs from Real-world Scientists: Perform realistic experiments designed by professional scientists.\n\nOpen-Ended Experimentation: Our reactions are designed to accurately continue regardless of mistakes, encouraging learning from every outcome, especially failures.\n\nMolecular Insights: Visualize chemistry up close in a way unachievable in the real world.\n\nSupporting Resources: A VR lab tablet to record data that can be paired with a VLab Education account to view your results outside of VR. Supplemental materials such as Safety Data Sheets (SDS), background information, and pre/post lab questions are available on our website, www.v-lab-education.com\n\nNGSS aligned: Our experiments are designed to cover key topics of the Next Generation Science Standards.\n\nWe are continuously evolving, with your feedback, regularly adding new features and experiments. Download now to become a scientist today!", "short_description": "Dive into the future of STEM learning with VLab Education! Experience the thrill of discovery as you investigate real-world phenomena through the scientific method. As a VLab Scientist, you perform true-to-life reactions, collect data, and analyze results in our simulated chemistry labs. Vlab allows you to unleash your scientific curiosity and witness the unseen micro world in a whole new way. Transform the way you learn by joining our community of up-and-coming scientists today."}]}, "developer_name": "VLab Education Inc.", "developer_privacy_policy_url": "https://docs.google.com/document/d/1bNtqtFbpU9pryj9HiD765Gx8m7lbqq4v/edit?usp=sharing&ouid=104461742025002327164&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "VLab Education Inc.", "support_website_url": null, "website_url": "https://www.v-lab-education.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6903511273091041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "391706209896564"}]}, "baseline_offer": {"id": "391706209896564"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706815665, "status": "PUBLISHED", "id": "391706209896564"}]
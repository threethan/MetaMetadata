QSNC8dJJ_7lzYZT_Rr841JfKq_YU3ES5B-ejXImIB5KEQ&oe=6AFF24AF"}, {"file_name": "Sc (9).png", "id": "390992580445626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75356793_390992587112292_6715904973060394483_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JykgGUGjDTgQ7kNvwGlnmTk&_nc_oc=AdoeBD_T9VUNjlF37_OACiVgVWf3IkPCOxlZBHG85HFqie_GprvpNg1wXdDaaWGPR3w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-D8tnqIM7G5eQzWVkH3fCIreoJvI4m7Twpk66RT60_A&oe=6AFF178B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_2.png", "id": "3649084812046998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982453_3649084815380331_8801844208824933901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3bz7VNC4psQ7kNvwFk3gDe&_nc_oc=Adr5Ww7WicptVFAruCJAf81XnWGFNAkbiHfZDF2F85kUv-U9hLCtVQB62uFpaIxL5GQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIGdJ6xsMuVrSAYezMAiXySVldnnPLgJmot27AFgVqsg&oe=6AFF11AA"}, "display_name": "RAGER - Demo", "keywords": [], "long_description": "Your battleground is arena, your enemies are cyborgs, your energy is hard-hitting music and you are RAGER! Immerse yourself in the adrenaline-fueled excitement of this melee combat rhythm game!\n\nMaster weapon of your choice \u2013 sword, mace, claws, hammer, axe, your own fists and many more! Pick anything from tremendous arsenal and unleash the chaos! Time your attacks, blocks, and dodges to the rhythm of the music and cause maximum impact.\n\nDon't let cyborgs to swarm you from all directions, test your skills and reflexes. The immersive audiovisual experience will keep you on your toes, stunning visuals and spatial audio technology puts you right in heart of the action.\n\nIn RAGER, you're not just a player \u2013 you're a force to be reckoned with. So gear up, warrior, and prepare to show the world what you're made of in the ultimate battle for survival!\n\nPlease note that this is free demo and some features are not available.", "short_description": "Immerse yourself in the adrenaline-fueled excitement of this melee combat rhythm game!\n\nMaster weapon of your choice \u2013 sword, mace, claws, hammer, axe, your own fists and many more!\n\nThe immersive audiovisual experience will keep you on your toes, stunning visuals and spatial audio technology puts you right in heart of the action.\n\nGear up, warrior, and prepare to show the world what you're made of in the ultimate battle for survival!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://insaneprey.com/privacy-policy-for-rager/", "developer_terms_of_service_url": null, "publisher_name": "Insane Prey", "support_website_url": null, "website_url": "https://insaneprey.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7057709067684955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "929937805451846"}]}, "baseline_offer": {"id": "929937805451846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711389600, "status": "PUBLISHED", "id": "929937805451846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24571720799190511", "version": "2.4.0"}, "id": "396392502994142", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only":
HOFKAJyVzPDiQi-s3_efPia89sui7C0tlVSeS5QEUXN50mZHEDPb2nrz-BtYUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YvCZuPvUDhqWN9X11D1EfInNhNvMfTLYZ-eL8MZKHEg&oe=6A281623"}, {"file_name": "1MixedReality02.png", "id": "499706809547743", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_499706812881076_8989077553614121565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIo0BOmdSFEQ7kNvwG8D2rT&_nc_oc=AdqyXVjz52Jw9FSKMh-DRx5hMq51g_58FD0XRAqC1Dc2eU_jHllvne_AyhE7xJSITXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84oDtOsEGTU6S1kiecj8EWkkhOVUqB7JTTq4i-PKJucw&oe=6A282EA1"}, {"file_name": "2Volcano.png", "id": "499538472678770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974561_499538476012103_1699400711606468059_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGjfvODP1k0Q7kNvwHNrhwy&_nc_oc=AdoVuWIwytRbe5h4COqKWm286ZqWHMttHzavdf4iay7l7TH7pmffF7fqKogLyNDYCMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fgpCdiMGpIiyaaL3MaNOhVQMBXbkrR4R4M9kpKpV9A&oe=6A2838F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DjayLandscape01.png", "id": "551601700614125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86621364_551601703947458_7489035832832299094_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pREwyUWVNpwQ7kNvwF1WHPJ&_nc_oc=AdqHEdPnoNvaVL390FbfPEeD8Ykjt1tquXAByIn8-e88qXF6nh9zunfy7qjp6K09LnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ls-Cqk6oo4jLXvp9CPkZ4my-ViSx7GkB_rrnQyJxLhg&oe=6A281336"}, "display_name": "djay", "keywords": ["DJ", "music", "party", "mix", "turntable"], "long_description": "Experience DJing like never before! Completely reimagined for Meta Quest, the award-winning djay app redefines the art of DJing, bringing your favorite music to life. Whether you\u2019re a seasoned DJ or just starting out, djay empowers you to mix tracks on lifelike 3D turntables, control effects with intuitive hand gestures, and immerse yourself in environments that react dynamically to your music.\n\nFrom the energy of a packed club to the atmosphere of an arena with thousands of fans, every mix feels truly unforgettable. Get ready to mix, create, explore, and become your own DJ!\n\n\n# Top Features\n\n- Extensive Music Library: Access a vast library of 5000+ free songs, 100+ million songs via streaming services Apple Music, TIDAL, SoundCloud, Beatport, and Beatsource, or music stored locally on your device.\n- Mixed Reality & Immersive Environments: Dive into immersive settings like Club, Lounge, Arena, Balloon, Skatepark, Volcano, and Space.\n- Audio-Reactive Surroundings: Experience dynamic visuals and light shows that react to your performance in real-time.\n- Intuitive Control: Use hand gestures for seamless interaction.\n- Spatial Effects: Move your hands freely in 3D space to control multiple audio effects simultaneously. \n- MIDI Integration: Plug-and-play support for a wide range of DJ controllers and multi-channel audio interfaces.\n- World-Class Audio Engine: High-quality time-stretching, beat and tempo detection, and low latency for professional-grade sound.", "short_description": "Experience DJing like never before with the award-winning djay app for Meta Quest. Mix music on stunning 3D turntables, control effects with intuitive hand gestures, and immerse yourself in dynamic environments, from packed clubs to massive arenas, all reacting to your mix in real time. With a vast library of free music and access to over 100 million songs, your creative possibilities are limitless.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.algoriddim.com/privacy", "developer_terms_of_service_url": "https://www.algoriddim.com/eula", "publisher_name": "Algoriddim", "support_website_url": "https://www.algoriddim.com/support", "website_url": "https://www.algoriddim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "941374250324918"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "951457836828011"}, {"status": "PUBLISHED", "id": "1017280272990606"}]}, "baseline_offer": {"id": "1017280272990606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734372000, "status": "PUBLISHED", "id": "951457836828011"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26190173947324334", "version": "1.2.0"}, "id": "3428744490746254", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5577676049000759", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190173947324334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3428744490746254"}]}, "change_log": "NEW\nAdded new Decks mode\nAdded new sea view environment\nAdded new tunnel environment\nAdded support for scrolling vinyl stack\nAdded support for cue loops (cue points storing loop information)\nAdded new button to quickly enable/disable crossfade FX and select crossfade effect type\nAdded new button to quickly change effects for FX cube\nAdded option to use split output (left = main output, right = precue output)\nAdded option to stop playing audio on app pause or continue playing\n\nDecks Mode\nCompletely new mode giving you more fine-grained controls\nSync mode\nCue button\n8 Cue Points + Delete\nLoop Controls on controller\nBuilt-in Display\nInteractive glass display showing all relevant information including key\n\nIMPROVED\nTurntable\nImproved vinyl visuals (correctly show game reflections)\nImproved placement of vinyls on turntable\nReworked turntable grab handle (improved visuals and allow distance grabbing)\nImproved overall performance\nShow placeholder waveform until first section of waveform is loaded\n\nInteraction\nAllow picking up objects with thumb and middle finger + thumb and ring finger\nAdded system to keep sliders stable while releasing the object\nAllow interacting with UI with both hands at same time\nImproved stability of aim pointer\nReworked login process into music sources (now uses external browser and redirects back to app afterwards)\nFixed issue where you could not solve puzzle to prove you are not a robot on logging into streaming service\nAllow to switch between Vinyls, Decks and Midi mode while controller is connected\n\nEnvironments\nRedesigned and improved club\nRedesigned pool scene\n\nCHANGES\nUpdated Media Library", "created_date": 1779817822, "id": "26190173947324334", "version": "1.2.0", "version_code": 2811, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5577676049000759", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190173947324334"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779447
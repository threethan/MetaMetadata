k0Q7kNvwHNrhwy&_nc_oc=AdoVuWIwytRbe5h4COqKWm286ZqWHMttHzavdf4iay7l7TH7pmffF7fqKogLyNDYCMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fgpCdiMGpIiyaaL3MaNOhVQMBXbkrR4R4M9kpKpV9A&oe=6A2838F9"}, {"file_name": "241007_djay_final_no_logo_no_text0254.png", "id": "1175603361358415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1175603364691748_4470879264429582458_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE6NpRqOgF4Q7kNvwGdNZSv&_nc_oc=Ado1Yav_ZGT2MlXrmA_ckdtBCkIOm6Pa1kPJbKcnrqGMePWsO42k6ZoqqrDQoJJzhOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PSkJeTUBVa7ju6i9Lm98ShrojbYA4qK1am6L8SD6vhA&oe=6A28376B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DjayLandscape01.png", "id": "551601700614125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86621364_551601703947458_7489035832832299094_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pREwyUWVNpwQ7kNvwF1WHPJ&_nc_oc=AdqHEdPnoNvaVL390FbfPEeD8Ykjt1tquXAByIn8-e88qXF6nh9zunfy7qjp6K09LnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ls-Cqk6oo4jLXvp9CPkZ4my-ViSx7GkB_rrnQyJxLhg&oe=6A281336"}, "display_name": "djay", "keywords": ["DJ", "music", "party", "mix", "turntable"], "long_description": "Experience DJing like never before! Completely reimagined for Meta Quest, the award-winning djay app redefines the art of DJing, bringing your favorite music to life. Whether you\u2019re a seasoned DJ or just starting out, djay empowers you to mix tracks on lifelike 3D turntables, control effects with intuitive hand gestures, and immerse yourself in environments that react dynamically to your music.\n\nFrom the energy of a packed club to the atmosphere of an arena with thousands of fans, every mix feels truly unforgettable. Get ready to mix, create, explore, and become your own DJ!\n\n\n# Top Features\n\n- Extensive Music Library: Access a vast library of 5000+ free songs, 100+ million songs via streaming services TIDAL, SoundCloud, Beatport and Beatsource, or music stored locally on your device.\n- Mixed Reality & Immersive Environments: Dive into immersive settings like Club, Lounge, Arena, Balloon, Skatepark, Volcano, and Space.\n- Audio-Reactive Surroundings: Experience dynamic visuals and light shows that react to your performance in real-time.\n- Intuitive Control: Use hand gestures for seamless interaction.\n- Spatial Effects: Move your hands freely in 3D space to control multiple audio effects simultaneously. \n- MIDI Integration: Plug-and-play support for a wide range of DJ controllers and multi-channel audio interfaces.\n- World-Class Audio Engine: High-quality time-stretching, beat and tempo detection, and low latency for professional-grade sound.", "short_description": "Experience DJing like never before with the award-winning djay app for Meta Quest. Mix music on stunning 3D turntables, control effects with intuitive hand gestures, and immerse yourself in dynamic environments, from packed clubs to massive arenas, all reacting to your mix in real time. With a vast library of free music and access to over 100 million songs, your creative possibilities are limitless.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.algoriddim.com/privacy", "developer_terms_of_service_url": "https://www.algoriddim.com/eula", "publisher_name": "Algoriddim", "support_website_url": "https://www.algoriddim.com/support", "website_url": "https://www.algoriddim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
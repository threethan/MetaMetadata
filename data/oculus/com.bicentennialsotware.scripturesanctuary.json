qse3mR0zdIu6oIKsWAqPb3YGs4mgvxN9NcygW-9gm_FILK1pkI-w9TYeAmYm0mPBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNUzfU_JtpsSlt7i5a6v8cBK1ggM7pK5rbgIsqC5eRoQ&oe=6AC4FDFA"}, {"file_name": "ScriptureSanctuary_Screenshot_3_2560x1440.png", "id": "956664360377994", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310651_956664363711327_3359630014451433237_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuOOPy2ls68Q7kNvwFydH79&_nc_oc=AdpsERhMjU1jK3tknQF5_mHy10rD4hg5s_kOFJxzIiMDCBhes8weQxfkPD0l2iCgdwA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZZUeBb88DjouK2rsKG0l9SgNlyyKEVLVt8UEsu5yf0A&oe=6AC521FD"}, {"file_name": "ScriptureSanctuary_Screenshot_4_2560x1440.png", "id": "1730269181280925", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295661_1730269187947591_7435921527397277471_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Nkp4eW1F_8Q7kNvwEgVelj&_nc_oc=AdqjhtQT6fLrQdEUJA7aOFtBIZ46lxd4MUWrExHFJeycTZkXbp-g0x1DDdqWyanXcwo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWn-aKAeHciorP3vElc6zjfen3mQmGNDnyxlsx-SgBoA&oe=6AC51935"}, {"file_name": "ScriptureSanctuary_Screenshot_5_2560x1440.png", "id": "1468717187994067", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307311_1468717191327400_7302735962779797579_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkOGpyA-NmYQ7kNvwGOseKw&_nc_oc=AdpvUJMpj4nu3i4iABkMB0yOfaj7UCuWJLEJCYXDPPx2G57zTQHaJaSoHuiWOyyswdI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMGsLmUTSWi3nIecr2sh2TiOj5YYGhjAgYC81swh_ezw&oe=6AC4FB7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scripture Sanctuary", "keywords": [], "long_description": "# Scripture Sanctuary\n\nScripture Sanctuary is a peaceful immersive reading experience for Meta Quest, created for Scripture reading, reflection, and devotion in a calm virtual setting.\n\nRead from multiple **Protestant Bible versions**, including the **King James Version**, **American Standard Version**, and **World English Bible Version**, as well as **Catholic Bible versions** including the **Catholic Public Domain Version** and the **Douay-Rheims Bible Version**. The app also includes selections from the **Book of Common Prayer (BCP)** for devotional reading.\n\nSave your place automatically, create bookmarks, search the text, and quickly jump between versions, books, and chapters. You can use either **Touch controllers** or **hand tracking** to navigate the app, depending on what feels most natural to you.\n\nScripture Sanctuary also supports **passthrough**, letting you blend your reading time with your real surroundings. Personalize the experience with adjustable font size, bold text, visual themes, panel opacity, time-of-day settings, and optional nature sounds.\n\nWhether you want full immersion or a more grounded mixed-reality experience, Scripture Sanctuary is designed to help you slow down, focus, and spend meaningful time in the text.\n", "short_description": "Scripture Sanctuary is a peaceful immersive Quest app for reading the KJV, WEB, ASV, Douay-Rheims, and Catholic Public Domain Version (CPDV), plus a separate 1928 Book of Common Prayer, with bookmarks, saved progress, and passthrough support.Scripture Sanctuary is a peaceful Bible reading experience for Meta Quest. Read Protestant and Catholic Bible versions plus selections from the Book of Common Prayer. Use Touch controllers or hand tracking, save bookmarks, search passages, and quickly jump b"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BicentennialSoftware/scripture-sanctuary-site/blob/main/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "Bicentennial Software", "support_website_url": null, "website_url": "https://github.com/BicentennialSoftware/scripture-sanctuary-site/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
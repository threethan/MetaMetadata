1360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVhS61s7HnsQ7kNvwE0KkNQ&_nc_oc=Adp56c5eCyMO77YxHglpxrJ_H8muOfk7UYJI4CQRz75_HABK3bOOZrUUitkoCobLS5k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BUEvtjuOPqF3ewgLc6CQem20AZZHnu-6e-q-A0NPz7g&oe=6A11C140"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97J7u9yJYdAQ7kNvwFUYShR&_nc_oc=AdoQi-tespFq4yVc5Cjj71aOsi8BgMJWV8uORCZ82MrNRSHSEXDbJA1-jy_QyBZ1OFs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ecF1BNa-v0X8Vp3jdrfLYyln5CD2mU_OX0MPx08uz-g&oe=6A11A946"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUJQml_0g10Q7kNvwEV69Xw&_nc_oc=AdqmGXfm6oaibfLMlqyOQO9V4glIgXr6bR-S-q5aA7JJ8Jeh6INDXjxt08zG6W2ZToE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GNtB4X3G9sWjaSsoqZp3O1jMWaE9rnu-bLsxp9WXYLA&oe=6A11BE01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site co
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj97Fnlte6QQ7kNvwEYyLg1&_nc_oc=AdopZXIdRZQG_7fUmng9G9mnpziiVz0Ftn13m6BGy1UcR9Fx8dz5hAItENf9gjZgD8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR3CaJ8O4CUnVt1iNi10SPHw-27Lyr3V8O6gQeIWq4FA&oe=6AAAAF40"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4m05hWPDCMQ7kNvwFfepQz&_nc_oc=AdrVXZ0m01GU8y4kj77TIvfjUR8Hz7d75tqJ9c-JB-zut-0xINtywmXyY_dQcRohH4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcoW7GUWH1jMgY8cXit1kfzGO0S6HDTDfAQFuzy1-cpw&oe=6AAA9746"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15izVHbJuVIQ7kNvwHaJO4h&_nc_oc=Adra7DFvmgFt35RseZlq0W2QvoH-wxgcQ-OiCdYIIfmXmrg3TaNw7oLsl3NFwCmsc5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1lgl6r2BmcTEehgeV8FvCgU8ZGjMnTgardXMjQDBSOg&oe=6AAAAC01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site come October 2020!", "short_description": "Meet the Expo 2020 Dubai mascots and explore the futuristic site of the upcoming event in Expo 2020 Explorer!"}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.expo2020dubai.com/expo-explorer", "developer_terms_of_service_url": "http://www.expo2020dubai.com/expo-explorer", "publisher_name": "Expo 2020", "support_website_url": null, "website_url": "https://www.expo2020dubai.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "298923405444008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223480_3439050352773551_1531269584642899968_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ4en8A7f_AQ7kNvwEWVd_m&_nc_oc=AdqRgdcLkBoKTTMuffxxc-iQfkOBT3kvIKfhRYOfK0pwx1KO2uyX5tqFKMLvdI6VMSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPh9HLI3swc2MVMX1jH63_wvmP1tycKCxxHsQdjTDHKg&oe=6AAA868E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Expo 2020 Explorer", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1574964021, "lastRevision": {"nodes": [{"id": "147509369957774", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2528862540515417", "is_first_party": false, "enables_in_app_ads": fal
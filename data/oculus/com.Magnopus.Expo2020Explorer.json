432173711360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaQ_bs7GrpIQ7kNvwGQZs46&_nc_oc=AdqG44g6kPGhGb7bLkm5vsZewcJjySx1FBvCyMIz5p3fbnei0G69eZk9UCztK0KnA9w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAjfyO_ge3YNdDaRcAii29DL2o1cyVhED1r7dko2lxig&oe=6A8EC780"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p9IEzWXysEQ7kNvwHpT9As&_nc_oc=AdrmZ-4x-P_sdPmSvgKmPieqwX7G1muB9KPBjk67O8-dHkVB0JAtCCNMVvOheKZM3_M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRz9WcOOqHSBVzK9P36Vj_Ztnvkh6Q963pMDa7kXtUoQ&oe=6A8EE7C6"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzhebQpyatYQ7kNvwGkMfXq&_nc_oc=AdpkYSOPRrHG0s-nz6N8QYMdVP3GOSZLRAyNLWGt1h2HzvQ7Z7X67ncn9pI7BgRl-j4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkejy2c1C7GBAeZczyBxL7uLLDWhUnAlddVbXrgYIu7w&oe=6A8EC441"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) sit
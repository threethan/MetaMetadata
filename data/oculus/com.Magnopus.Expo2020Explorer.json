1360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C1y7O_rqJQQ7kNvwEdeNHU&_nc_oc=AdpzNMghiZ9emHpriJaUy5TKY8WnGNAdyUviFvJIzwSAdCKiZ58t34cil7L5jleAT14&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu6U7SS0rwZypAO0w8x9N6qWBuUoiEXD4PLTsBg8v8IQ&oe=6AA417C0"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTwQlM000O4Q7kNvwH8ePk5&_nc_oc=Adrn7oNQENUhYESZZYb9Q0J-amzvSFr13s1enXOgh2z5IeaTk6l0RWpZhGpBmQbS5qQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOa5sYLSpr6FlRTdqjPYwKsAW1Z4r0-wpX7Y4qgk-cvA&oe=6AA3FFC6"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1bhIE3T9QQQ7kNvwGSIKpy&_nc_oc=Adp-2UZPwvenPl2uT9eg1wBaDH3fFQUhC10DVYQ4cTBTCrBIPKNVUuyRgoeFLjk9O1Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKij2Mw2sMRPaXeuawZCvVQQsVb6lIK_alQfuNj31uQfg&oe=6AA41481"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site co
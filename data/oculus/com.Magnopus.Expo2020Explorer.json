&oh=00_AQQzP8dunI4SrGKFYLnGDOi74vSSHMDO8CmZ88d4CwrwKA&oe=6B05BCAB"}, {"file_name": "migrated_image.png", "id": "266574351017076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982649_446036859299040_5164168432173711360_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piIRy0vmiy8Q7kNvwF-JLgv&_nc_oc=Ado3ubd312rvS0Nvfjmf0iugTtU2UOA_1kFrftsUEfG05ufTVafcGj-RkUMsHU7pgms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSKzIId8FmS_7yiV5Z61CDGJjt8ET92zF56Rt4jkefMA&oe=6B05A6C0"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLMk66LyVvsQ7kNvwGyfDVY&_nc_oc=AdqYG4TwNVoYcyf4nlG_NMal0HLvTwI2tuPflIGNOwA48jbQZmDcxkJTNw-5zaY0NMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl3MsTSn5xaBpYTkCXVxRtVBCivkq8Qe9o9yHRYBK-cg&oe=6B05C706"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Iujm9Q2c8wQ7kNvwGMTvH8&_nc_oc=AdqYaROEAoXq0Tp9pvqoW813fLx0GJDwWBobbgQMtWnKFnVeVe3GjvDb0w4N02wxpJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkZDCiOgTCjEUY5XHBWZ3pHR6HExIBYGt2fBWCC28h2A&oe=6B05A381"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site come October 2020!", "short_description": "Meet the Expo 2020 Dubai mascots and explore the futuristic site of the upcoming event in Expo 2020 Explorer!"}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.expo2020dubai.com/expo-explorer", "developer_terms_of_service_url": "http://www.expo2020dubai.com/expo-explorer", "publisher_name": "Expo 2020", "support_website_url": null, "website_url": "https://www.expo2020dubai.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "298923405444008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223480_3439050352773551_1531269584642899968_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E_Gw2GR6EMQ7kNvwEJghrw&_nc_oc=AdruWmDEi7McEfzpTiFqBLHo51MZvwSdj-E_WYXTsOzCO6AHhPTyjQj1pE_ORF3IjcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHC8ZaTIEITERD64XJjg_qizmTwxZd8UBHIs5cwkOjpQ&oe=6B05B64E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Expo 2020 Explorer", "platform": "AND
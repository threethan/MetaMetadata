_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj97Fnlte6QQ7kNvwE5dYRi&_nc_oc=Adpi1FFh1fyGH3MvUxgOyRYRaYFpjWutgTy4zNWEe_huOZ4loaLTvSU56ybVeQRRPt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbrGjhDl_p6fxKknkIYa_Ra29Gcr_vvByf13MeYE-T6A&oe=6AAD5240"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qgdnj_4hsgQ7kNvwGGGaMW&_nc_oc=Adppkp9j_E6_ApSuxuRnitYliA62XPT95PMtevN2px_4G-HaolPkCHau_SKSI0fEWNs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS6R8vNr_VJKKOW9jR-V7LVBoFo5EmUpDeIwdluVYLLw&oe=6AAD3A46"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4bas62jYyoQ7kNvwH43lGz&_nc_oc=AdoyIcO0AeL3g9ecOhI7rDMZ4hC0P5R-DLt-aj0wM9tDcg0LBJ4uefZGCDsFwyyEdmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYkX9IGBiREyAt4pluFyHGmvGGe_brbbVJoRd4afN1aA&oe=6AAD4F01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site come October 2020!", "short_description": "Meet the Expo 2020 Dubai mascots and explore the futuristic site of the upcoming event in Expo 2020 Explorer!"}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.expo2020dubai.com/expo-explorer", "developer_terms_of_service_url": "http://www.expo2020dubai.com/expo-explorer", "publisher_name": "Expo 2020", "support_website_url": null, "website_url": "https://www.expo2020dubai.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "298923405444008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223480_3439050352773551_1531269584642899968_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGkpOj6THvUQ7kNvwGk9613&_nc_oc=AdpMcm8SgglAMyILTeB-UK7h3GWd3F1_qH7Vik_7iUafCnh8O5cxeqbFC3IXXbKAcsk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM6zyaUOKy2BpInP_gO8-DT03T1YujTF_LZ58v4k0eKA&oe=6AAD61CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Expo 2020 Explorer", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1574964021, "lastRevision": {"nodes": [{"id": "147509369957774", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2528862540515417", "is_first_party": false, "enables_in_app_ads": fal
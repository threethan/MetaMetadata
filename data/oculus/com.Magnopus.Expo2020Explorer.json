&oh=00_AQQ3M6K_xAclq8SstS4IuBDWOVwu25cm9ZOWlU0L9fvvCw&oe=6B0319AB"}, {"file_name": "migrated_image.png", "id": "266574351017076", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982649_446036859299040_5164168432173711360_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i9Ck-i4feYQ7kNvwG4Bfc4&_nc_oc=Adpcdecdp3v_PJZhLEG_NA4CbGYkcO5b0qEp7Mg-YBtC7kCZNqv-Z90WzinYhPakGfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE_EnsMA5AU6Sk8M8YNGWavlzrUDwYDjiyf_pKN2gejw&oe=6B0303C0"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LNRKQKjFjkQ7kNvwHSCieS&_nc_oc=Adoc4qQbHMvYoHvnBGFtrwCB2T6wdJkLIupvmGVPer9N2_qRYGk4U9Pjo_5ubDVQsfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnC_tCLl0hfYqUqLC2ANApUp2GTzQmcV97R5JYpokKAw&oe=6B032406"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Iujm9Q2c8wQ7kNvwGoOBt6&_nc_oc=AdoKtqWJA7KLDeI5dDYG2NHTQ_sfLMyi1kxb6AFCFycMSq_wMfPl04iU5wlMHRYxyLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCQX_uP99xblf6Y_KTmQEWJdmcdv4BJ05WVFoWiRk-uw&oe=6B0338C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site come October 2020!", "short_description": "Meet the Expo 2020 Dubai mascots and explore the futuristic site of the upcoming event in Expo 2020 Explorer!"}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.expo2020dubai.com/expo-explorer", "developer_terms_of_service_url": "http://www.expo2020dubai.com/expo-explorer", "publisher_name": "Expo 2020", "support_website_url": null, "website_url": "https://www.expo2020dubai.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "298923405444008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223480_3439050352773551_1531269584642899968_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX8SK-CQSVwQ7kNvwFRoW6n&_nc_oc=Adp2YDeaO0dF5Kfz_Gh3RfG_JxElHqKo4sbnRz56JBiCZonpHVlGs3W27yrnHQXE7Rw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWYu8gVIuplVNJxb4HQUvq_NK_pBw1UiT6ZfFE99Hfrg&oe=6B03134E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Expo 2020 Explorer", "platform": "AND
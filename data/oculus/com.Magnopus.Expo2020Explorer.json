&oh=00_AQSYeRz7yl_EnNDt3kviHZfc8Tpfh0yRWEeJscptk1DQGw&oe=6B070E2B"}, {"file_name": "migrated_image.png", "id": "266574351017076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982649_446036859299040_5164168432173711360_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piIRy0vmiy8Q7kNvwFAcBBY&_nc_oc=Adr09fZ9OjMYbpMDcMcju6h5RkcFXEDliB3D7u3vzUrZUQXTfQBeng_I73a6ezisdX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTAuDVj2fHBq5MoFk9027kuAuFIOGQjPyCgy7dBEo9mQ&oe=6B06F840"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLMk66LyVvsQ7kNvwGY834a&_nc_oc=AdpnzEdJvCs2KGgo0PmZ2LYU3bkaaeFgvhfh4XgSRLW9gpAgodNGNQU-B38rJJIRU0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR50aOO27kj7leQdkmnWYFDOXC9PApfcakoGVPcZV9NA&oe=6B071886"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArUFvzDnZ_QQ7kNvwFYXsTi&_nc_oc=Adrzhm6eu417kFZZWgIYhOzsp5opXw8aV0FlEw2DKg0tisT4hlAPCndhP_f8yQYppio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvYruHgMqa4p0fsKWFoOc4FJJZ8BUWRzZk09RBslrNHA&oe=6B06F501"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site come October 2020!", "short_description": "Meet the Expo 2020 Dubai mascots and explore the futuristic site of the upcoming event in Expo 2020 Explorer!"}]}, "developer_name": "Magnopus", "developer_privacy_policy_url": "http://www.expo2020dubai.com/expo-explorer", "developer_terms_of_service_url": "http://www.expo2020dubai.com/expo-explorer", "publisher_name": "Expo 2020", "support_website_url": null, "website_url": "https://www.expo2020dubai.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "298923405444008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223480_3439050352773551_1531269584642899968_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E_Gw2GR6EMQ7kNvwGiypdE&_nc_oc=AdrfdSSh7e56QBAmXbY2UwCj_DG_i9Ppg2DTPeJje-SvLrGYnYsqgT7dgKrBR8oSqFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn81V4cFxi04HNaonvsgqUXrS3FzYkUSwAQJa04SWR1A&oe=6B0707CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Expo 2020 Explorer", "platform": "AND
1360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjBX0H-IrZAQ7kNvwG_bRhj&_nc_oc=AdqmWVhSk4KFqY-V96YFcHtdlhNT3weca6Ln2gI9V0KE_06_9tpoTXQfK7Jzaj6I48w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKA4G3g9SpgX9ZtO69HpQ67a5XqfwEazC9c3qsGfZyZQ&oe=6AAEA3C0"}, {"file_name": "migrated_image.png", "id": "2521733714810799", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974645_2428296804059646_2367992839549222912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qgdnj_4hsgQ7kNvwE3e8_o&_nc_oc=AdpC_M9DbcUAK6geT8N1YW8xlL5g9us7X60DCuh5bMtUmqfcRpMJWUB5APycor6ALSg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ9xx1UqyI4RRGp7jRUz2Hj1cAKlTHdcMwuWzinppH9g&oe=6AAE8BC6"}, {"file_name": "migrated_image.png", "id": "193933155387276", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982632_542901866563058_7071168125307191296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4bas62jYyoQ7kNvwE6-22L&_nc_oc=Adrtm2vpdwzWasTi90GBUUxqEF1m8YPuVO_K1CKmvIQtSFBvuDWkII9KvSTLsO37HGg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxCVZSJn65fk1ZrUNhgNljelenYmPck8p-LfuIpo_LPg&oe=6AAEA081"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Expo 2020 Explorer", "keywords": ["Expo", "2020", "Explorer", "Dubai", "Fair"], "long_description": "The Expo 2020 Explorer app gives users around the world the opportunity to learn about the offerings of Expo 2020 Dubai UAE. This virtual tour is available in both Arabic and English, and features simple click commands to navigate a map modeled after the actual site. Visitors can stop by the various Expo pavilions and districts (Mobility, Opportunity, and Sustainability) as well as the UAE Pavilion and Al Wasl Plaza. Each site features a brief explanation courtesy of one of the mascot characters. After visiting each and meeting their new friends, players will be notified of their completion: they're now ready to explore the real (or virtual) site co
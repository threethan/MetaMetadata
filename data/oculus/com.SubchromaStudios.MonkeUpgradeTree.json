dn.com/v/t64.5771-25/499308090_3679042809063625_6974153856875859747_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33FrdgIHS4oQ7kNvwHiPh1L&_nc_oc=Adrf4t8pZPcor-RAjiJgNsJ4rtV2UjJI6PVQ0Un2fM1l0J62lLt1_8AuIcsed9dpZnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYYawGejtM9vrNX5vN7F6Y_qqnpRiSmA95weTimvHirw&oe=6AF1ED33"}, {"file_name": "MUT_040D.png", "id": "1275280110179361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820980_1275280113512694_3651962422243467588_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38dedKN95jMQ7kNvwFFkC-R&_nc_oc=Adp0DXrcZod8lbfW5k-jcVUHu6NiEB2YiFCkqQrxeYbyAlJMWhYdXobPdO8_6RblVFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaQo6TckiIfz51kU0ilDhUbHyaYuA6jArcDV-_edB_Pw&oe=6AF1F25B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Upgrade Tree", "keywords": ["monke", "gorilla", "runners", "animal", "incremental"], "long_description": "# Monke Upgrade Tree\n(This game is currently in early-access! Please report any and all bugs to the Discord!)\n\nEnter a calm and enjoyable experience in the new and original VR game: Monke Upgrade Tree.\n\n- Buy upgrades and unlock new and exciting features as you expand your tree.\n- Earn achievements as you progress, or by doing challenges.\n- Play daily for extra rewards such as Coins and Cosmetics!\n- Compete to be at the top of the leaderboards.\n\nAnd most importantly...\n Have fun!", "short_description": "Expand your tree and become the richest player in the brand new and original experience: Monke Upgrade Tree!"}]}, "developer_name": "Subchroma", "developer_privacy_policy_url": "https://subchroma.net/privacy/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Subchroma", "support_website_url": null, "website_url": "https://subchroma.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
dn.com/v/t64.5771-25/499308090_3679042809063625_6974153856875859747_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayc_09hhCeQQ7kNvwGYPtI2&_nc_oc=AdrSW9ngTeegJT-Ab9xjjq25K2JLFKIEAJ4Yf58vjytPXJohavkzm5i4ujoCHLQtpxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL7CYvRSGdZEEzWSbsvc7CsNp-8c2dxWJaTs-pxDNPvg&oe=6ABBDFB3"}, {"file_name": "MUT_040D.png", "id": "1275280110179361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_1275280113512694_3651962422243467588_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyPm-68yIDwQ7kNvwGpxThE&_nc_oc=AdoTkQCZcSpauEjWU1iIGsqdUVWxCENEqxFy4T7QvUjhCN_3KQjmHns41MUAQg8TlwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkOFuilxpIKydcHWfrmND6moKMaVmgas0RvB4Lq7dN7w&oe=6ABBE4DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Upgrade Tree", "keywords": ["monke", "gorilla", "runners", "animal", "incremental"], "long_description": "# Monke Upgrade Tree\n(This game is currently in early-access! Please report any and all bugs to the Discord!)\n\nEnter a calm and enjoyable experience in the new and original VR game: Monke Upgrade Tree.\n\n- Buy upgrades and unlock new and exciting features as you expand your tree.\n- Earn achievements as you progress, or by doing challenges.\n- Play daily for extra rewards such as Coins and Cosmetics!\n- Compete to be at the top of the leaderboards.\n\nAnd most importantly...\n Have fun!", "short_description": "Expand your tree and become the richest player in the brand new and original experience: Monke Upgrade Tree!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://subchroma.pixelatedaria.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Subchroma Studios", "support_website_url": null, "website_url": "https://subchroma.pixelatedaria.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzl9CpkH3XWiE_lDl1Gb5mqEiPOQity41cioCzV2tJXA&oe=6AA2CB30"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL0N6mQmh_UQ7kNvwFCBAaa&_nc_oc=AdpWLKyQLVYIY38QYeYoOV2RzFp-qDdfBQ2T3bJGagnX2E7qh6ly5gAOXF4gjuaroNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_wiS_52mkg8h1KNXB15Mcdn03MXHcMSN_ZZ3dgRpBIA&oe=6AA2C912"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_servi
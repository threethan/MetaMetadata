7&_nc_sid=6e7a0a&_nc_ohc=q5Vh_6GqNzAQ7kNvwFnwxgN&_nc_oc=Ado7jBtP6-lcE0TOTQII75xyjpMw-v91yRMr8fPDaoay_3TGswcgVyUfbV5oZOzUT98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuHqjPchEFp28N0YuWYBTTMLo0kinHoMWtnz4_dxJdpw&oe=6AA29DC6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGUfWxUgeeYQ7kNvwE77hXl&_nc_oc=Adr3NusrxOrY_5Yey7cedz9CPIcnhS0jiPKbZJlwIfgBPx8066ScRrZQ9A8rqOivLmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKORX_508SyDK0ZRdVUsJ3TSJFXJL61bnlDYZ1kTLNiEg&oe=6AA2CBDD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CdewKfkxcQ7kNvwEqWPsE&_nc_oc=Adr3kHul1HVfQjLC7Y5LZ6kM92_qGDflWZHF1bbgV6WeOG0sv7XrEJd_sZQTuUnd6k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_S3oy-SVZgtvJmD_k9OBRmF4MLDDr5zitn2fPeuf6Qw&oe=6AA2B0C5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ay4VBbZzMf4Q7kNvwH8P7Qg&_nc_oc=AdqdmzQqm6oQ8sWDKlWkB7DRHhO1EKuku_BVEsxdnguHJ1kcKE42TXMvUBic7OMhT50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzl9CpkH3XWiE_lDl1Gb5mqEiPOQity41cioCzV2tJXA&oe=6AA2CB30"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL0N6mQmh_UQ7kNvwFCBAaa&_nc_oc=AdpWLKyQLVYIY38QYeYoOV2RzFp-qDdfBQ2T3bJGagnX2E7qh6ly5gAOXF4gjuaroNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_wiS_52mkg8h1KNXB15Mcdn03MXHcMSN_ZZ3dgRpBIA&oe=6AA2C912"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
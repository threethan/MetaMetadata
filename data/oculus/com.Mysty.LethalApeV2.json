7&_nc_sid=6e7a0a&_nc_ohc=-u8Zc6gHAYAQ7kNvwEG1RWR&_nc_oc=AdqJCx7OfnKRiCwWfS4zqRUA7dpl_eaNEl4BBJhY822PaPKl0I807yBnxcb_eLSYYPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPfm_z1niz-yuldDFOVYwGeWCUpaC5VwWWE7fULpTR7A&oe=69D0FF46"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN6mBfZGnQ0Q7kNvwGjqRPk&_nc_oc=AdqjzgL7VP2_lMdfZJsUNdPodJT7Wa9sKm5DtSdk0loGkaPWVDhjxUwWm8X0fkUsHGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzn1niiMps2y-5C_8dgo4j4rBOzlA2cJfhNGHL_TPKyjw&oe=69D0F51D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I22lWVsfGFMQ7kNvwH_nvzG&_nc_oc=AdqVS4GBnbAKket7fFrAHJkquHQwaEDuPTTZKmc0f_KHQIO8akqAyiNfC_I6L0j96_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx91BgXx9RAhGGdHG46Tmcj0xZOB_bPsSzuJoeseVHSnA&oe=69D11245"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYnOS7gO1OsQ7kNvwEarZlE&_nc_oc=AdroxdANfETTyPOsN3XceWxLZwKiiWPOAnRKfjvl2uUcpf4SUSLzzP7JNwLG_Hj7Bzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnsauLIPQrIf8B2zN6EpVrpEcI3Vxb2r15kJJl7uzPdA&oe=69D0F470"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzAWxB6nKWkQ7kNvwHhhu8i&_nc_oc=Adog6IdI_QDlVGJIqhP8FGeOfvwQqPoEiFTGH2nXeqP3ifm-O7r487_zbCBxiqNAtO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxvfD5OxN77HO1XMtYHnFhMb0nQHaLj8I4560AklLO7w&oe=69D0F252"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
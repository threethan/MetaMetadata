7&_nc_sid=6e7a0a&_nc_ohc=KuON-xXUJN4Q7kNvwHs6Pom&_nc_oc=AdpW-iIJohsqMk8h1CXRFwhRUUSnkF86nztC9iqy4ba_Uc10PeWtPLmEiAWW_Ka1yms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o8skUuENH5qejKBGc4KrcolRq2ZCPDSddqn-moUYPgQ&oe=69E4C5C6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8-V1ZfpjbMQ7kNvwGHBwKd&_nc_oc=Adqe-PS3ilT9VC3Rgoc_315Zvb-6XpStGgaPsrU1YpEkpPJ9KEag91Fh7dXCJx805Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k1CjUc7HCUlxkghOwPWpKBkA8L_c--vZP8NJVQh_a1Q&oe=69E4BB9D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo4MzEz22UEQ7kNvwEX3YRF&_nc_oc=AdpbHY-YAnMmV3UL4IBc4EmTfUjCDfPJ2XN1-xWd1Xr5s9wcwkU76ov2UsQWrdtCPbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16Z0ctD5YlZb8WnET_5Tff5lRbw4q7TYlWxBtQdDfKaA&oe=69E4D8C5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlkQZgF6fT4Q7kNvwFXTxAk&_nc_oc=AdqzBWyVwWL7KWiwTW8Py87NZBw6G27Vto_jSk6Xrpqy_0WxjQaElu5m0TOLzKoN4yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cyn6VPPBF54YErguExfiZHlt68hW29en09T0f5I4zmw&oe=69E4BAF0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGZ7q4a5O4gQ7kNvwF5TS4r&_nc_oc=AdpaF7VbnEbV1jTralqdw3uky1M5rukU95IVikVuKmVo58MrlyUdlM846PGbg6XIrkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31JzeefraEV49t5MvLwSxjxvzd4ZYGw0R6QAFNWB7yZA&oe=69E4B8D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=o7B5542TWX0Q7kNvwHqOa1T&_nc_oc=Adp1R6qaj4wGvgOyrbYKc5f-lgPmZQXSd8CYj4ELN8muXrgVkups53C56Co1T2nhMMQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WgsbIeHpEAu1QyN6oyso5BK_xAZ9Yk81CsLht6dgTVw&oe=69D796C6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc58QhNLm04Q7kNvwFTZX1c&_nc_oc=AdqL6qhM8GDKjdSp8pLZJoSAqYUqP2spuGQeBCK321zD8LW5eKnXWTFnJsqIpej8VBc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yXRgI1l40GOAT_-tmgpeFf9Ry0EpRwLJ3kZU7-VYsFg&oe=69D78C9D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfGJZP95pn0Q7kNvwGuWKhP&_nc_oc=AdorG6gh2YLI4X1tQf6_cbA9xFs8U3kXQhGNTTliDJHiw5WKxkbuOvAoEN8uEJSYeoo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OZkzE7XpFji0XZ6N39er9cc0ZVS_Z6IPn7O5gvCmLjQ&oe=69D7A9C5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPQiDD0JJF0Q7kNvwEU-HZd&_nc_oc=AdoIrBpRMYyKXSLO3Qp-YWofujHtMhvIasAjUKdpRc3y-Trcv27-VqEeEcXHHdxTFXA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tx83h2Yb0th0_gAUGK0k8ARrcjzzvWMimnALVDvJnug&oe=69D78BF0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GCXGP-co84Q7kNvwHjUsGi&_nc_oc=AdqG_xn1-5VkiDfRYGQXt7ySijRjF9qhhMWHd90zIdHIflr8LXnP4TSAlbC5IYwaVN0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vv1dFivjXPR4L6KoPbMFs_3XKNkO-Ntn9O_dkpfR4vQ&oe=69D789D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
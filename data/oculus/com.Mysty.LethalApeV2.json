7&_nc_sid=6e7a0a&_nc_ohc=74hU-bjUsCkQ7kNvwEPc9eD&_nc_oc=Adrnx3EeD9gZKdAeP1pkKo1VyxqTZFyL6_T_4eqCS3yoBTkBvgCwIYtRJg6Ss7PrGLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RhHzKGhXCkXOPSGvOxOi_S7DUYpxu0e8k4o05X_Bb9w&oe=6A007546"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1-0JhCkhIwQ7kNvwHy4XZI&_nc_oc=AdqvSZdKLvuY-nfOgrlqDzQ78aJokHpKWn4uA0_lyUP1aKZPzglz75lwoL9MjBztcDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63SCVxHC4odt7HahD0w8ZmdBe71dXNtYvjCfkT-5MlqQ&oe=6A00A35D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20jZHPrwLmYQ7kNvwEL05WR&_nc_oc=AdoWLlLx-E187ztBhsriboeA3gm8DlMSrllwyDGxWBo73XqRu4H4jSxdj8zpaRxznPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E4idLOe92I4sUPgtgT7D9Ahwc75BXkB8QwqVjnNUGAw&oe=6A008845"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw8TXfsQHUYQ7kNvwE8Ni24&_nc_oc=AdoJXMs0skl33WAk3tqmVT3m-hozujR0WnVYSugiWY0QkHMQo2NWLRtY4vO7D4opTGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ksf8bfMvpyV9giEwm3mA-0tAlLTKeRwjrB3a94q_mow&oe=6A00A2B0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKnT6UuG2kUQ7kNvwEDIIIJ&_nc_oc=Adr0uyWpKNPnceF-ShtkoAPzjOY5o7Nnju75-o-BIKke9XFCo_mqWz66zZaWYk3Ueiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72VEQVwzd2UsYVc5QTk1QgLFORsUg3cTiVb4MZNgq3gQ&oe=6A00A092"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
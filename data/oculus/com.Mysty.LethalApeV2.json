7&_nc_sid=6e7a0a&_nc_ohc=8cg4Mk5D1iQQ7kNvwEneX3c&_nc_oc=AdrNcag8Ra6XG0xkyzZEeErB2KQwIk4cPaT7UIKpi5JiICq0igWLZbm17lMbiWwG11g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBiEJp34KU7PbDfcACwalkoqQ4FH7GKTNAxbQv-hidZw&oe=6A5F6146"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02TpAGiKFiIQ7kNvwFcVGCn&_nc_oc=AdolYlVN-w95ilHq5tiaGZOHzjqwVK1F1UK2U527DwLloer1U6uoTftw_byV9CwC8Is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpGSwyrFmvYfMHo6FaRr2PvZHktS8fYaj3bMHBDUNDeQ&oe=6A5F571D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1-FcHAd-u4Q7kNvwF252em&_nc_oc=AdqHu9anuj4RQ7lVINqF6Yvh0VFabmjvJkyv7mvXHj7aTVWqQSkGY3o1keEKPRx60fY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiMCo1-vHpJ-qXf1lu8Wu83y_Z-IPqpXnZDxR6lWC4BQ&oe=6A5F7445"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoxTxMPM9GIQ7kNvwEjQglO&_nc_oc=AdqBi5DulPF9hnYbyHBjONvYbcGl9K4deW3sUvIAArq8v9_EEEzIK54-z_bA782rrQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7lOp8EhUbaYX8hH68lbtR9aqczmrtgPNhiG51xRcZQg&oe=6A5F5670"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0TffuNCxqQQ7kNvwHRM7Yq&_nc_oc=Adq7kL5cuHUXlIt8vNmjAkwteff0REoK6XkMQ17r_iXvoxAhAyZIp-NMqLkay4ncQpg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-nA-U9PEtL233MbZNVUpuRcpbfmKXOVFOyYzTZRw4IQ&oe=6A5F5452"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=evdJqXa8k_sQ7kNvwEcsvtX&_nc_oc=AdosK0UmQ7pRQWBjD-BamuuTHWPKx1sEchu8jp4IwguWEHpYxX46oXF6YKxgmZswS-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iBxPbOAqF8xYC0OzCVGN0RQc-neBq8soLHMvxugbGtw&oe=69DA39C6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc58QhNLm04Q7kNvwE9PZpE&_nc_oc=AdocVYI43IIRazZlaSyaybY3An578rsvZtSsz9-i7dM3_zuGJgvUc6TwgMn87x2IIvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0esGBQfR-dd4HiBSuOGqbMB7TXSi5VdoP0fNZZ0pSJOA&oe=69DA2F9D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMiEXq3_py4Q7kNvwEyndQJ&_nc_oc=AdrqTgPgFPkeftUIHtz6BbBDDvFJE2HICR4nVhw1J5MMfs-JaoLmsgj3yLTsyhQjozQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1meaU4mMFjpDw3YMu9rePDtrxctRZ-l1BqLtC9ismvUA&oe=69DA4CC5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zrc-finT0kQ7kNvwHz6tWk&_nc_oc=AdonfZoeVHYK5n6runGEYVEFh8FO3NAccCU252NcINryjyedsbz7SWV9qGsPmR6sVDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lJJDtzdOH6VHOyBI_s54sCditUNPjNtNSkssmiPXP0Q&oe=69DA2EF0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RimliHZob94Q7kNvwGjHfJ2&_nc_oc=AdrvlHbZGj2M5NRTigglgKNFQg3Hqn6d9rqm2m3KLEO-A3tBmOfgjp2VoyUvH1X_9lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BPpjif28NmuBB7UbF9PfRytqo-u1e0Ven_FILeDVLPA&oe=69DA2CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
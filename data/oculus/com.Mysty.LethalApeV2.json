7&_nc_sid=6e7a0a&_nc_ohc=evdJqXa8k_sQ7kNvwF5bUdl&_nc_oc=AdqVPfjnoLn5lMjHSum_QH1FbyfFk7juDFR_MeACoORcKWUpiRIJmuXWlQ2zzeDgoYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af107fK9ZAAMVNkQsy1-YdFM7U8fgOHUpkm27dUC2SMegA&oe=69DCDCC6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2gyatBzVCUQ7kNvwG4vyl-&_nc_oc=AdpmlX7f_YE1BFi0tsQu32dM4T3LFWTdccJN-rFFDPOnRXKcm_MDmmlhcTOhn95VAxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FG-cKI6ifAF34KSgW0qBvpCznaiae4z_iIvY8vIgaqA&oe=69DCD29D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMiEXq3_py4Q7kNvwEMkAHZ&_nc_oc=AdrrmX7tDto2ha4E-z7sMupJjrZ8wImF6n2gm-HBmXnmyo2TCVh3HeCWkONv2Y4I0OA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af236Bh6DBx3vInmFUNHlzO4p6tCKWvYM1j2m09NEWPg9A&oe=69DCEFC5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCO0kCPyFd0Q7kNvwGU7AzV&_nc_oc=Adq0uHfK8fZgK6S3nd1uvpAI-4Uvt_3T3CDqqlucyT2-1Hd9DbcjdIKx9_BfVCzwOyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37f4Wg6ujeZ9WsjDkgPCNeKkHPZZtXW5r1HQyClJG4hQ&oe=69DCD1F0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sZF3TEHUIoQ7kNvwHmLCti&_nc_oc=AdoN6Btp42ilet70UFbiD404NM0crpPu7a_zUV_3J4RikK41OHwYzau54gvL5_emnLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cO8YDHMb01jWOUIbndZ5497Kk0rkwcDistDY45YBzfw&oe=69DCCFD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=2NmCWX8XWDgQ7kNvwGd5q-6&_nc_oc=Adp3FlxUQjL8yUvvhoilL2dGQ5GJijX4pReOSK7K74ryuJghxFK1LWwWkkYwBo4xT0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F4t-rUmzQCd9hhehAl7pdAfThAvMKZL2dcCrlol0e2w&oe=6A147406"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNd48Hd-6xAQ7kNvwEcaxQ4&_nc_oc=AdqO_0LK83jpEiYT90xk0H-cZ_XWJmZ8O_abgebwS3ug-Ij8SphlqGjPQIEdkJBV8lI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cW3qD1ddt40Yo_8vks6_JLpYiEksXGpRa95_7dIUcTg&oe=6A1469DD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLimQRL2gVMQ7kNvwFQk5FA&_nc_oc=AdokgApvy6ftxLyPU6Dg9aamzDDv-ni1roMoi0H9aaq9tN4cqd_6xXAVa2KMetyolYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cdkBnLo18mMvWGVbdAIk_K4oSZFp9A7vve1ixuBTx6w&oe=6A144EC5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AibTrSv4Z-EQ7kNvwHTKqeW&_nc_oc=AdoAP3xvUW0soCGoUF1KzTBL71szXdAv2fhzWq8i4JhNQUdIsRmu8Xa4P_6EerTHAn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SXY7MUv1mhuopWRLs6Bfc-_xbKgopQ0tmkU9XeSfxwg&oe=6A146930"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJt11rzeNwQQ7kNvwG4V3n1&_nc_oc=Adp8Tjw_ri00-G3Oxge2qrfdyLmV2qOvgf032mgT97TFCnRMNh_bjpudn5XqYKjeaD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c-7jm6y-1nI9F862GgOp9slGj15Cwz1YbHVLBmiwp_g&oe=6A146712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
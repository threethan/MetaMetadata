7&_nc_sid=6e7a0a&_nc_ohc=OlJjs9xA3DsQ7kNvwETJaDR&_nc_oc=Adqh4NXsWG8V0ZNqLegeE31SezoriDXX3K3ktizlDL7oBn0PbGbZGgsZyk3R6rH9Mp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yLnXkEwEOSzP3-3FJkWZYYPJ6kAej_AA8pU6Bb67fTQ&oe=6A2ED206"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ynIEgTSc-wQ7kNvwGxUE3D&_nc_oc=AdoyDsGElKMDw5DUZ70uTX_nSOroYmfUHRSmjlfiWwXAvFP3grAZI0W_4N4v_Aw_51s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kTp9huKjUqFqNXsJdaH76XopI4tsrJRFq7BErBie2hw&oe=6A2EC7DD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwRK5OyhWDUQ7kNvwERGv5g&_nc_oc=AdqBsMB2dC8ENWrNTaoZZ-q1hqVUgxAykZHkBqm8ZT97NaaZF5kqk5psDmidRzu36h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lIqQYqKyGLx97G3t0-OQyGIiOWIoQ6Tx_-Yo1JTkfgg&oe=6A2EACC5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sGBV2z3HTAQ7kNvwGpBJIQ&_nc_oc=AdrjW5q_Eb1fsDlxL5MFk5IEBBOi95RmcnAr3nnK5Ziu26eWcBNdUHBr8TcNhjizaM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sLeBmxer_3r2X5nRo5pFc9PN2kl5cFW2F9nzwZ_d5-Q&oe=6A2EC730"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63TBfniZytQQ7kNvwHmIKAM&_nc_oc=AdqJWNF11kug_D-_CdIu8EKBY8f_YqK3cm1flGt2fX_hLRwTy4hQbrt2pdrc9kZQexI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l96XQ3WRGwINnCpbolJ9jKrI0Pw_F-7vtGJTB6xK8oA&oe=6A2EC512"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
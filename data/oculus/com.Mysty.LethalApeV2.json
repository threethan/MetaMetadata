7&_nc_sid=6e7a0a&_nc_ohc=h_jhGcDC0ecQ7kNvwGpHhFw&_nc_oc=AdqLV8k9YN-d1oi-qmHUxJfJC3z0Lln0mpNYLzAzCm5TOH1wUwvXA9wB-P0B0LN8saw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92sqkkMxdcJEt2QilMHAlHDs6QKMSlgcNuKr98xjLsiQ&oe=6A2ADD86"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16hnjvfnxf0Q7kNvwEeqIP8&_nc_oc=AdoK6WC-6anooDxpQ_QRrnR6Vr5UKSA-uLmqZYdjAe_PVMsFfqQfHmk_dm3oxuKbXjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pp4_J3T4ZmdUXTlXpzjUi4HTlZqDxZZGkMpuTpf3U6g&oe=6A2AD35D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nimPr1IIdaQQ7kNvwFRxjh9&_nc_oc=AdrX4vscavQVaXm6SOKXGZhY6D7rtK3F-Weg5LWnKZfAPjz2_qgUb2XfBmTqKPUO3yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8wH9cOMYSwapHJrwwL7GNjUJ_wQOC16jl0YBs9Mhc5Q&oe=6A2AB845"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roEfO6xMwHoQ7kNvwF9TtEl&_nc_oc=AdoM7uNg5CEFKl7JS93LtfQouEi5V0L4HFntoDsDrsUxW_OIlj4dgBIrHlQ6gVQHa7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--LHIzn209RHi7TrV3k8RRlgIdMmvLdxJiCSaLKAWN2g&oe=6A2AD2B0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Fu_0HgZPkQ7kNvwGm8xYn&_nc_oc=AdpYhdT0GC_OcgsN8Le_s1jvdCVfBQQY78f_g8hoyUwbW48k5DsDT-dkIBhQAlsBHso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8grXZp9KwXDnqg2xFyuqv3VXt6luWXsm0krUXwPd3sQQ&oe=6A2AD092"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
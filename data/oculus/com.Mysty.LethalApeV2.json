7&_nc_sid=6e7a0a&_nc_ohc=yMPHbdqG6OwQ7kNvwGN4pOq&_nc_oc=Ado-dLvwFkJiLZG99HIUvVbb40vw2YJ9_0jOnm_naiDe0iws-OD8pIGHhQRRLK96shk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s7FIEL_jFpoPOBf2-ygVBNQKEMbNm0lCyVYaR-UqkzQ&oe=6A0EF5C6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STPi5HpR4EwQ7kNvwGGHVAQ&_nc_oc=Adq49Kiz5oUHd3qUThmBJOY_OONDCB_8V422-qhB77JnxL0g3hCnFhYayisfZGZ25tg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ece3huXCQr-JsOFNDGF961kDRh3YTNK4_jEgXmZ-eWQ&oe=6A0F23DD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6reeypn-0zsQ7kNvwHaLocC&_nc_oc=Adomkw313CsyUTabBjh0L_64RI1dGJkQ4Gz2LoYmOkp0XDCxNHNXpkkbKoEJgD1jw3k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PIL2PFNjzXGnVJGI__3Yxj7LYvyFQaK9G4J4I-jK2bw&oe=6A0F08C5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYLYzH34ub8Q7kNvwG6x-zC&_nc_oc=AdoB-ZHexyDfSKFLpVQlDfKaLU5-2pl6hvqtlz5NrH3QbSxKZIW_VltUvBHVpV2H3aY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40lQO9O3x4Srcv1D-tH_jSJ5bvz353RX1811FHu_tkPA&oe=6A0F2330"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWByIz2xmIsQ7kNvwE5Slag&_nc_oc=AdonzXaR-SuRxCROFHjKxl2wvJoGY-w73MFv_guYFyLyAfkWnYdoav2F9V4MhMH0N1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wdwv-zWJxR5BaFSTLntIz_JSWn6NIwoZjy_13EpK1-w&oe=6A0F2112"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
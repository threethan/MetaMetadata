7&_nc_sid=6e7a0a&_nc_ohc=Y5VfqKDvrDkQ7kNvwG147rZ&_nc_oc=AdrOVD1lTE_YqyjxKmfugTGPSIW866ZC8WsGMjbHdpAu9zJ31K-4GvULCRaSyX3XT1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8symCD8S6bEHfqOAeSA7egN5MPmUNMCIMyPeV2FU_Ag&oe=6A674A46"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpsCKURZRnwQ7kNvwG7uY4v&_nc_oc=AdpLdm5ldDBXoNyq-ogfr8QzjGpL7byw_7jJeRNoD3u8ImGddKrZwjgN4GTouLIraZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHLKbs4v59rP94awq_2yEfeFgs-QdtIbOLdVUnYF1sDg&oe=6A67785D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDsySdx5AQwQ7kNvwEHYktI&_nc_oc=Adr6YvCWE2CiYaXuX5-gNyJ8jIbm59BHksBBDzvnlDKz1_YXa9f9nPYd8T49dNEz5H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQZWz5yJXo81nFL9zcupBWXT5XQq9tf9amoiOMsomz_Q&oe=6A675D45"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td9vsAS18FQQ7kNvwEhDKZB&_nc_oc=AdqBz_49knIQ1mwQ1C7YMVzSW9hzljLjYZr9Y2fuJmfD2r4F2K93WCQ13luE37Z-HZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvUncv1IjQIJKCsJWPpzXHzJ8J5nj0xav0ZNMl5xeISg&oe=6A6777B0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bmwIZyPqX4Q7kNvwGMFP5U&_nc_oc=AdoFfqI8yX1JVQaaEwS_x61OBdC4He8nUPbc7diVy6A9TaVKykRVaGr-2DeE23fW-SA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmNO_lhReAFNiBy8CBsQROsnum5W1maU_3NpZSsZY5hA&oe=6A677592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=LxuvqJ0Go_wQ7kNvwFzFdIf&_nc_oc=AdqD--sg-bCbZmUuvu7O9H7XIqOaLUP-lAGDEIu1gOwnE1daD6U5q4vtgKebAFAocpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX167f64Nf28fnvJ9j5DREXJyLCW3IKvXz62A0AHED1w&oe=6AB26FC6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n73-4LVmXMQ7kNvwFq8i1c&_nc_oc=AdonTwh4g_Sp1o3xU9E1hb8xoGP8wS983gESuHFp4_mtlP-mwoPT3MWc3SyJ-MkQnnA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9XuWK3mpT_HoqpcyEZeY5r7KJ-zfTPBUU-L8pJIRBpg&oe=6AB29DDD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK4XzxrsGE0Q7kNvwH_I9sS&_nc_oc=Ado0gSRr3RfTmPfEVGMVCcB_t7XMnJF96N7dnKej3mwk8jnCAcWEvd6lZO2xFoecpvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtnLIR3Dn0yNvHs-_fWlACFeE2QvAFvHoXyyoGX3M5nQ&oe=6AB282C5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHXxi7dhHUEQ7kNvwEJBD8q&_nc_oc=AdqzZAquqXbw_GBW8RTnU0rX1wmNVgGojvujMAsLxIMNt-JH5f1kJbIAUJSQmt1EWrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdtXfaS34xFKrCQl49m8xJ13Kx_BY8-ptlfvZWN1IQLw&oe=6AB29D30"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic9gcc7HD7wQ7kNvwHZh7Bg&_nc_oc=AdpE5oVQkzWUuuhX_0GqGSvrwDxTsgG6mOwrRftBok6-BoiduVWLYmcPz5R55HREgyg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVjGfqFOZ5w44B2yZNfLVacWHo7k0Rt4E3_slW0Tw8Ww&oe=6AB29B12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
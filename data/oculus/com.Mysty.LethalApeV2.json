_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wLs71sm3v5aWnO05w60DYofJvUGkpqUpFQ6iF8rGYog&oe=69E75DF0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGZ7q4a5O4gQ7kNvwGFU1Gs&_nc_oc=AdqSPKrEK77FW6vdYyI2rLDJsneYntpKmwNj1G0NOOjHooj0CVNB0L6Np-RWg7SwbX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_YrB2fgWjvodk7F1gBdHtVDk96QA2gWvvGMdj9aA9hw&oe=69E75BD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_servi
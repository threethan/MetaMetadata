7&_nc_sid=6e7a0a&_nc_ohc=OlJjs9xA3DsQ7kNvwFEJthg&_nc_oc=AdrlJhRzF_mr7b6edW2no6-U-g4CM95umj5NeIbMVmvgT9Mf-C0DiwaoB8plNYLVaUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8sxLdLXuYoaPI-gZYXwnGM44-Bt6NSE2U7yoqGaIg6Q&oe=6A2D4846"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16hnjvfnxf0Q7kNvwEJ7X3j&_nc_oc=AdqjkM-JzYbZyGlUqI4nfMXc1ldEba6abidVU6q8AIyx7fSfiU5mFuO-oY8K4lbEeL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3svQNmMssK5rcjTG4giUYM_9hUICBnrKf8vVVeGQh6A&oe=6A2D765D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwRK5OyhWDUQ7kNvwG39Rn7&_nc_oc=Adov2C6jUtCc3qYsNKhYqfOAVTIRF75BRrhXUTL-6sSrhKc8YhMXiq-91vBU3qxHg5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gOhtwUpwWaCvu05cpM-_IEzriDpumWVSGiMJkJnkgsw&oe=6A2D5B45"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sGBV2z3HTAQ7kNvwEm9Eij&_nc_oc=AdoPUP8WKV_7sRLbVFcD-cOZKU4s79xfve46O0rvORxgyZZ1a7HRnCZR-cNB9E5rhOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95d-ze32stEtz9BkqElD6fGOQx_sQpgD8ID0u0zkbdZw&oe=6A2D75B0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63TBfniZytQQ7kNvwE-a0GA&_nc_oc=AdrI2a0ECNI57XBytDVmkEY1caLqGZRPaaxJ1c4YmzsUTFEt0H23iL6WSrwqpCCaRA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88BF6zshWpUd8y1rZhvbK7DOZp9Im8mq4PFVkpyTt6qA&oe=6A2D7392"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=q5Vh_6GqNzAQ7kNvwGD-H1I&_nc_oc=Adq8yZZIMKlMZZR3aXSDklkTJqgeS5t5gNu6Snzv-ZTA9FbJQ3qPA8RE61JI-d62FuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrqI_OXZQYPfsTTTj_4vuMpEVmK5cZdm4AWYy9qeFqNA&oe=6AA14C46"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGUfWxUgeeYQ7kNvwFQQPdP&_nc_oc=AdpDllRCOe_iIYMW5F5zf8Dv7ogEAtzHGkeeLILnP1EcSUrsD6_MlGA5WioUrj6s_SY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfEiEIee5O2bIrFXOy_hdPtpTePmWGQ7mQMhYodcsBXQ&oe=6AA17A5D"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CdewKfkxcQ7kNvwGGeVze&_nc_oc=Ado7rbES_O9L6RsnQhvpXha5IBo5U-SNcBJIA256QOC11vFGuSe-8P45PfB8Ha2oagY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmtrUvmtWL3RZFd2acZ75Fhtdx4Oti9avIrcE8wzv5Tw&oe=6AA15F45"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-hNxvUtszgQ7kNvwGKVwEO&_nc_oc=AdoN_2BoPwAxqeX21IS306Z7ffgtoOPXH7BHdIzNB5pGKRpt29X_gQaa9J_59KB7RI4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvnA7OcHb8uqGI51eOIfc5TtvPzpvSh0MiShEefV6bsA&oe=6AA179B0"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_I3ODqqVewQ7kNvwHf8q-k&_nc_oc=AdqegH6tlMdZYSEDXsir5QzTb0sY7z85eI9LlDXW_aXpuofk2KdvmnGr4Fgoenf0Dzs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzGWSoHtNyDZkv2vSqyh2MBwF_F-rOyKVWLnhiL3R0iQ&oe=6AA17792"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
7&_nc_sid=6e7a0a&_nc_ohc=fJIF8rCxmbMQ7kNvwH1EkUL&_nc_oc=Adr4AwNx4EtHZfJ7VvAcceHTjX7vQVvpebo2llR6jt1ETMQ5MkrE2jEkTCvlFrLBNrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp6q9-Nzat-ScPyWc6zejgBZzkEvaJ1sax-qmfd0S0bQ&oe=6A75CAC6"}, {"file_name": "image_2025-05-03_132310199.png", "id": "24361405006780399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393567_24361405020113731_2137258680547778957_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoyviIvAflgQ7kNvwEK4qP8&_nc_oc=Adod6kyoY1dEapQv1g3p-6imzftAe_lNC_0OguKjw8Ifz3MFF2y-1f9hoc_NvyWzYFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElmRV8nfbY5dxCcE3urePtce1HXWERye0nz1Uq2BAmJA&oe=6A75F8DD"}, {"file_name": "image_2025-05-03_132313994.png", "id": "992026726013574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_992026729346907_255115329278270610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqDsHCaJX-sQ7kNvwFc7iGC&_nc_oc=AdpimTpOE6ak35yIdM3vg5F-yhnYdYIkb8L8Fn7u_OFxhx4QzfzeVxvteefQuHi26CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC5UXiwqpUKvt8A4sMQwgSTOk-_QBABQz_3edN0JjcBA&oe=6A75DDC5"}, {"file_name": "image_2025-05-03_132318116.png", "id": "9981868888511460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_9981868891844793_1404490805843131427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUlIJUn6VSMQ7kNvwH3b3Bq&_nc_oc=Adp4H4TmkawsMWZh2n_0IiVpsXjzr8uYCN5yABX7vboKliS2Tc5zVYyJHHqOpuZRPhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj-l3CQElkNYm0saCwgiBpL-yYaOqqMPPVXGp9zG_xyw&oe=6A75F830"}, {"file_name": "image_2025-05-03_132322824.png", "id": "511190895281288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820178_511190898614621_7322044776208894703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ii9yRiTa0wQ7kNvwHrg8Il&_nc_oc=Adr8C3zxIO-W0TpIAUF8WTq9ouiPXpM6qZb9cRhVN5Iz0lh1FsD62C7MrfEHArDWZRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH162zUnzY0gGU1jwKPxDkRntZ4FvphGdhg12fcsfoZ5Q&oe=6A75F612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape V2", "keywords": ["Ape", "Horror", "Lethal", "Tag"], "long_description": "Lethal Ape 2 is a suspense-filled survival horror game that immerses you in the aftermath of a secret experiment gone horribly wrong. Trapped inside a decrepit research facility, you must evade a bloodthirsty, mutated ape that was once part of a classified military project. With each creaking floorboard and flickering light, the terror grows. Scavenge for supplies, uncover disturbing files, and solve cryptic puzzles to piece together what happened. Every choice matters\u2014hide, run, or die trying. Tagging will be added in the future and more horror and ape things!\n", "short_description": "Lethal Ape 2 is a terrifying survival horror game that plunges you into a decaying research facility overrun by a monstrous, genetically-altered ape. As one of the last survivors, you must navigate pitch-black corridors, solve environmental puzzles, and uncover the secrets behind the failed experiment. With limited supplies and no backup, every sound could be your last. Outsmart the creature, stay silent, and escape before you become its next victim in this intense, fear-driven experience."}]}, "developer_name": "OmnyStudios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FRl1vxV4BtM0ijPyualmHyLnXFG5gFiywUQeUqQr8d0", "developer_terms_of_service_url": null, "publisher_name": "Mysty & Goober", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape-2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKadDRDkN2PMlC9zoWKC3liaOJMdZ2WWvPLCKTFkXZJg&oe=6AB3CF8E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrED3_8_QaIQ7kNvwGl771f&_nc_oc=Adr43x9fcWSlnAPKCM4KYchfJ1ENMsKxOLzRspCuNciMD_oi0sc5KzZjZNQ7v_fjxBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv73vLVcsJakUoiu_JXCI7Imip8kD-8d1sQNmTog0yLA&oe=6AB3DBD1"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAO0Xwgol38Q7kNvwFEudB7&_nc_oc=AdqaIOYQyFfcKfVyD-oUK8JVqEuKPR3Q4QQXD1aqH1E9HemboYlRJcTUO0HlGFmDcRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvvN-6qfeMnqTL7rlwcbCfebfuAvxUrR9wuJhUMXPbxw&oe=6AB3E167"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeIXugRydhAQ7kNvwHPvWFj&_nc_oc=Adpmx53X7-C5l1eRUjY1Yjc9S9NAikx_6n2lXxcCoHmu1PNj09AZR-hN-OSfUw-4Tig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr6SmrV1RJpYFG6_W9EazpfSoKpYSGf2HZfO_m4vAFNw&oe=6AB3CFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2lsSHljtZYQ7kNvwHF8FSS&_nc_oc=Adr0HSH_Q-FG3WV2bx5lc3r3VUlsO7inESAxo9SaA8HTz-PulLQZtJfI2O9bwR0Vwcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgdT3ckWn8lmME93vv8gu-0l49s1C9pCkia-S4uBaoRQ&oe=6AB3C9E0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
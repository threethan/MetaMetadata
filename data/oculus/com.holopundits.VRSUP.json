ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIcWoKffWysJCwf7WE6SR6yDASCHcuqM_17RoSymDrOw&oe=6A899F8E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83GBQw65oHMQ7kNvwEMyzV-&_nc_oc=AdoeZaCMvRO3RuaDMPVmN8DWmEXCTb5iqtdu7BHPOoW4LQykMxp00yF7kVgabsTSqQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxoeem5CTkkf25fyGHiwtzRKRdFBkC2OLdEo_-Z00YVQ&oe=6A897391"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHhgZBTIBrcQ7kNvwGNgO7_&_nc_oc=AdoeJ5JayRJC34318-cqmP8QyAcUqANeeKMh-xeGLKn2GQ_lfzRNO-rWzCw3Oq10DJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWIZAMifipVISdnu6SZA3ZrNhgcg_zR_Eh_ERN9ajCBQ&oe=6A897927"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahWP8K9FxnwQ7kNvwFSQ5Bu&_nc_oc=AdoJXIp-HXeyGESV6dWaYy5ZtqC9Y_-7eziM54yySpD62UXsDNkmd_J1ClJF9f3Ju-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG07gAKpmWaE0S2rFYHREjYzO3mF8qrTmbuhXCPS19nZw&oe=6A899FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVUHg7tW-9oQ7kNvwFEG3j9&_nc_oc=AdqVqRJ_FihZWF-HNxcrY4jfAUaf9zmT0mXqy1jo1KzpdjFBjkchFvCtBG_Y3_nizHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMZYtaDzSi3ZRpzTU8uStqVKI7OTrY3zRLGVRT8rF2vw&oe=6A8999E0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYpDXX3ub9CLOZe2cfd3cMSL9o5-uXVrvItGiPAAHl0Q&oe=6AABE68E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3IzvuIhazgQ7kNvwFTHuLn&_nc_oc=AdqrCTyi0zOo7unT6TZRcZVd1x2WuxU2w9XpADiPN2AOjkrSKFNg30ffAbSJI5OQPAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiBneayryZljL_p6rNOezPqoG2dTUffD6gWawJKN7nhg&oe=6AABF2D1"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq7SnZHUyrIQ7kNvwEojbgd&_nc_oc=AdrbWZTCDmEee-WznVO4FqYjrnIwKivE6QePr6ELOMlwBSN2zXdXpx4gKG2zjAg1ZZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtcK3_ilMxz9U2ZbsGF50iwCS2xU37eTjnSs2QQ9h9Aw&oe=6AABF867"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI1Ipd1s-_AQ7kNvwFJ4Qn2&_nc_oc=AdqUUs690C-_qd7AmhCUJ5HngIv-IQM1JP4Ynqzdk0hD3bsKghDkob6rAdCQ67FfX7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHmoUOCSBfifCi29k_tf1kKO0kXfCqDGgGHwzU3128Gg&oe=6AABE6F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCbIwBITm8kQ7kNvwHEWxE2&_nc_oc=Adp9HlHhREE6iGTc1J8I5G2j8cArgUPr1XEwE_Ruld6R7GA5Pf_aAgY_SIR71r45Aa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv35KQCR4q2nGThHWvWFJG1uXdufqADkRzja98BcVleA&oe=6AABE0E0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
97_246796517703428_6670063398055006652_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEl5htF4vrYQ7kNvwEY7zTN&_nc_oc=AdqnxgPEam6yYVQpesYKWV-v_h31vCUxugvcW0a2xEQYFmhGd1Fx8pW-AbNnP087ipI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjFvSYGrn4aENpFlsezygLEXTUflCr0A-J8rCEZY1Hsw&oe=6AFC8A4E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec06tWEC7z4Q7kNvwFyLpFG&_nc_oc=AdpcnZ_psj8CFQOaDu-Di1uQ0xcTxA4NOZOXc4fhv4qHUxV2ZDhAF6R0C91P9F0oPNU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBz32ZmhdH-0JsI7VEKcxJarij_iyyXkVINad08SMdYw&oe=6AFC9691"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m7qcpkRG1EQ7kNvwHIzO-Z&_nc_oc=AdrI8lljV4I5Lgl4K49LQ8_BqpIl2kAUHdnBq4df5jhBvk175ldu6_a-3byl_AZZwxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXbZfW-DyAvUJxbju4hPMtcH_jujvkIx_Xj75XLouj5Q&oe=6AFC63E7"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xaxcdS3s6YQ7kNvwHbmGMH&_nc_oc=AdpJ0b647zfNRWEgCEMQNngNUbZvmHYGeLOaCJsZZWqukPDcjNR50u1O3t1QQGFr9i0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQXSYY1SdPqPYvrAJQFSEMNtcgg_D0eqDV6cNboy3FtQ&oe=6AFC8AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI_9OchEWecQ7kNvwGC4koA&_nc_oc=Adr2KpjQroYxSdOiS55fz4O3rhuuSrbQpwVpYyi2sDCgs4EsXmp3lua0FQU4t_XagHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgeY7zAcXAUp_2QslH-EGHb5LN1-VgxN5XNLzBWpj9lg&oe=6AFC84A0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "websit
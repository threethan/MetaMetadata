ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MyfQYfPMDu8ZJSa0au-UoYDcZ7YueT_RTOM2EabfeHw&oe=6A2D568E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z24kJ7OE6qAQ7kNvwGlFYBg&_nc_oc=Adpz0uYvUaGzViCk4DryZvP1FWnBu1GmJOc9ouGJOGT8vUhSLsENyVXo3cLFfgs_XzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88wnRcsdefhRrp35XkddBEYDFvLALbBLKMew2gTlrTmw&oe=6A2D62D1"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSGrKVXSc54Q7kNvwGNBcl8&_nc_oc=AdrWkQZ0fG0oIVxcSqhz4_K9iocUPIr6TGhA8zLa_w5LjvY1VZrtpfJQvhZSMBIIahI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88f4rXwt2XC1a4ESjbwKk7hLfJhEAbQK2fSBPN4tOuaw&oe=6A2D6867"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44FG8GgXFaEQ7kNvwG7ewYj&_nc_oc=Adq3LBh5SD4aaxPjW3MVeFDL0ryAi8Ct38xGruzP2MfpKkHtGIp7hSMFn3JEZiWp4Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EnN_JyXsTKGPf2hOKj_Es-FY21tKt7-YfbvYRxr2Pqw&oe=6A2D56F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyMW96BdISQQ7kNvwEF_LnD&_nc_oc=AdrBYTh2E3jEkVtlHp-oB561W1YJT98hLtSiGsqedBTMo1E_XZMqJle1qr9_x-1YxBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af856ghyeO6q7ri0tqI4erDWekiAOf71bZw0VxoFzZ_leQ&oe=6A2D50E0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
ent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFFerEUj5AIGr-VTN4yoWWbdHFR_5RUiQRRrQvF5-lNA&oe=6A91888E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzi_flXy9YwQ7kNvwHQpj6X&_nc_oc=AdpG8j5x1lrOedVct2rZRstLbX8bVJlPW2cTlXJEKtBGz15lM1yVjP8abWBX6aghbs8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkVF_T6Aft5muVQyH62VdM1V6-8aSLo1vlOxt24gQKcA&oe=6A915C91"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDh05Cxy7X8Q7kNvwEpyXOc&_nc_oc=AdqxB0_lccXdMrFfnbyyqxIddhB0gQseSJ1YE2dHOLoD8rKq07POZ7WfL4Q2b1sbQy0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVi4XqQNnX0llPRvsqld3Fe4g2bj5W-a4vaWLKA3Ptyg&oe=6A916227"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jc-YLdgqCQQQ7kNvwGlJb4d&_nc_oc=AdqtpBIkiKFOMAC0WznQVaY0Hm-1WyehobN69pf5N8mB4T-NpQZC9OGcpkrtF9ZUB2g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK0MQIi0JF61oMXkQTZuD0aH_-tP_L68ltABZOHE9gjw&oe=6A9188F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0rAPsdy_lQQ7kNvwFMxW_f&_nc_oc=AdpAFQdDW7Y_nFFjj1v9sE2R9aLdayZv1wGxRhT4y_y-eja-8ygNt2k7bFdDe_cOV-I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYOkdA4OD2dmbq4Nq9fMxe4KtuEhXveYzyMkX0Y16oYQ&oe=6A9182E0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
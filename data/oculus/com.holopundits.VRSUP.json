=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwPfoNYFz1PSm3qvzJjZMtATPPj9-oEwceZ0s3btxuwA&oe=6A8D940E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p-AaPVW_jcQ7kNvwFlg4tG&_nc_oc=AdqVcKth0un0U5s06-9AwVmrkuAvqdQ0sIlvzO3kEjuQ--nBOtmd0GR7T8C0tMDTu4k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS_2nVcGWjtW1kDLGTvIFlB-QEMUoV9DuuPRRbLvWLAQ&oe=6A8D6811"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC3YFtlJw4gQ7kNvwGjVQLc&_nc_oc=AdoXdEG5cDKCculol3A4jd5sMxxZ3ObIK1XYLqptUioVEtWDaGSJLPWognBGihMK1ws&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED7OXh-06ifW_SV6YOwTSzlBj_sz7m7BDT_pO5MbGuoQ&oe=6A8D6DA7"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAz29LHbSesQ7kNvwFavtrC&_nc_oc=AdoOOafyLPiLWJItPg2dmLMK1TPpjQjeFs1fRqDcZFtylMuuc7iBF0rc8tutKzwXu0o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1wqw6g1_XaMgEEzesl7XPjrzmKPpjArvDveS_04YOeQ&oe=6A8D9474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6IM9tmboEsQ7kNvwFoEhct&_nc_oc=AdrEhHmssrPbHU0LfvhLs9t34OmkemXdnzqmMR4oma-MmKwtrOUIAKpD3WFPvcZlFX0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGStNykqADLzXk5YiN_FJ8P24QnWq2EqqkGsXm7yZhStQ&oe=6A8D8E60"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
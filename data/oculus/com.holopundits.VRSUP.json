ent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z9Pj0zXmSHuSGG43TDkLpaCfy1MkbkKY32NsByH5TeA&oe=6A2C050E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z24kJ7OE6qAQ7kNvwEXtB1P&_nc_oc=AdrM_5ZQjr6DNGJZyqEa_xok093m26FIZq-i_z_CoOyDF28r7jbAgBYxPvHMqBNQuXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9k-KJqA7wjQvciBzK6LqBtsi8IphfMWDNroe-UHnuvg&oe=6A2C1151"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSGrKVXSc54Q7kNvwFDXwTz&_nc_oc=AdrB247_1fPFxbPWTkeZGxdhgaWdDcXJ5CdfaGO5XRUK9L91k_QSMc4ims-Fa4Gp178&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CazNf2Dn51psYYxnqMg0KjDiBBCMESXlFOtzn4FKHCQ&oe=6A2C16E7"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44FG8GgXFaEQ7kNvwHw0VLt&_nc_oc=Adp0iB_Gn60O8qKEgA0g39QIsyKnDiOJmrFwsmk0L02Gbptd1_Oxi02H6F8CuwgIE1A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x2FT5ZI7p1J9ohTH8prvCp8Xvyc1x-Erq8s2egVIeEQ&oe=6A2C0574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyMW96BdISQQ7kNvwH-er05&_nc_oc=Adr3_EiYjR1tC4wy2MqeX-HDDrsJrIBxvo3AwEeuc1da3AyrV5F8aQfu9_lsAoq7fSw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hBrixYw1otr7Vk_4Itj7Iw309cAKP6yzjoDGZKR4_xg&oe=6A2BFF60"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
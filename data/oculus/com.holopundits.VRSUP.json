ent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk0dY73NqSxRv7zy5oHk_0DLr1529_qNCqYWi0itGYAA&oe=6AC4F30E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJC-vxnDh-QQ7kNvwEn1QjQ&_nc_oc=AdqgEY2asd_YJUnSGfHoMfS2QFN8m-Jf4qxRdpGQhz9r6lMlS_xtGrHebybImgAJnso&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKiVL9xEgSMJu6VisDWKbUzL8w43hCH8UDECtp3ge4uw&oe=6AC4FF51"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EMxPzvWX4EQ7kNvwHD6PIV&_nc_oc=AdopCcIpMWyEU-6u1-sAbNAuxbTRGvnLYT3XDG1tgwfwKfiD2NwHgtJo1hN2dX8ZE1E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeyZtGD7xqRRmasrmfH70UuPTsEJvP-Rch1EcVXz3pbQ&oe=6AC504E7"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSWkx-4zLc8Q7kNvwHAXrkt&_nc_oc=AdpMlpu29gt5uJipWp82z4phiF8KAhejAU0UGKxap2e90YFXUQQpbfKVXYtg7wqDpak&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOytyGMfcYbxiHLp5xNdGlkPRIIcQNJWNlNPiQUecRvFg&oe=6AC4F374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0r64u5bHWMQ7kNvwF_7ybX&_nc_oc=Adq3hV7iXWvyPqGWJ8lhmC2LykZFE6lCi-3O7N1qPgxCHnz0fbYBelT21pRwNFgg4jE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOPekHbw95_iFWSygWmlfIOkjuEKBuU9c_i2pQMiIX7w&oe=6AC525A0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
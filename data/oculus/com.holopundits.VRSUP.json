ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB8pzgM7Gq8gOr4K22gagadUxNz3Vr1zRmxOscA63ogQ&oe=6ACA714E"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "1491932784677073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031346_1491932788010406_577406407159841891_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gnu0QUikxX4Q7kNvwHYzh1f&_nc_oc=AdpSd_0XtTVWUYeDtgcYThQXMwCS9Ya_zLVFgTFclScvAtAYrt05gGedvoqEzh-JvXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIKiIjaL16fCp9WEsSdR1W-FWWSCB9Y58uEXNiuDbTbw&oe=6ACA4551"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "170550285385662", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_170550288718995_4159135805628350243_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPHVFzWMB-EQ7kNvwH3t5w8&_nc_oc=AdrJ2HWCVQgg98vIhxsc2_8bLyGi9IOs6x1NBmwBFkDkErFlJ3_DJBSBbQ6ZIWATFx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHrqBLyIxq5o-sFQZ5H6qSjjMWoVXV4dgGxMPFqtVyMA&oe=6ACA4AE7"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "757567075939504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234365_757567079272837_1193157604052138362_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zb-m4vGjw4Q7kNvwHzd84G&_nc_oc=AdoMI61Smv4q4P7YbiTep_umoMB-4fsFpVtXpZi3PLjFySIjPAb6-2ybLEbDPlkBfFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMwNsLCLlNDabgXqTl44q3rgbE9_b7y_tCOrejnD44Ow&oe=6ACA71B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02_2560X1440.png", "id": "1414523469084831", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974859_1414523472418164_250160287908959841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE7kl3MQg3cQ7kNvwFro_o4&_nc_oc=Adrefau0ao5iAaqs6PwJmgTIC2pzf6cZnttQOOv81D59dj7p4I6p8U0bKeob85iZDGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5nxLM21Z2acoAeYNh8iFvNZLP3jowjufc0LIqcYttcQ&oe=6ACA6BA0"}, "display_name": "VR SUP", "keywords": [], "long_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your SUP to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves paddleboarding or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \n\u2022  Realistic watercraft, equipment and environments \n\u2022  Stabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \n\u2022  Paddling skills that can be transferred to real-world SUP ", "short_description": "The Virtual Reality Stand Up Paddleboard (SUP) simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR SUP brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
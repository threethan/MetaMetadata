=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-xUAbSSxIgQ7kNvwFiX2lg&_nc_oc=AdpguJQNtA1OWv0nOdOG8MGbo9_19pqDF5InZq0_eYsICpNTNczzkIglRD5DZcY9k9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxnFfv9jNlgmGZ8NhDBE95LqHbQmJbzlHtwgzrVfYiaA&oe=6B03257E"}]}, "id": "141694408890793", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "219826737442331", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395603_219826740775664_9204199416196457591_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5FwKmRkBeIQ7kNvwFJ00fO&_nc_oc=AdpEHb9BhvAPnQU-dMWgvH1deJhFkGPRi-pRhLcIZqyhGGRJUVEfN7WD283T4Q4ygZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9wxYzfv92dlZKPj0r4DjHrP0xtuA_maZrQdjpwiY-Jw&oe=6B030E83"}, {"file_name": "5.png", "id": "256373443538152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035430_256373446871485_7118511692191908212_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH3amu99W7UQ7kNvwErnYZL&_nc_oc=AdrvGsCiUvgTBZLRRII-fwjoX5YFqPVO-h4opWDY1HBUymD9BsgSmm_Sm_Zi8y2VXeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd5NNN9uATVv0RWLmwdd-7htWnrCCfE0R-2cvHOLQ2Wg&oe=6B0322E6"}, {"file_name": "1.png", "id": "901359694304292", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974918_901359697637625_6465399393883184217_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vy1mgY6zvEQ7kNvwHIlcl0&_nc_oc=AdqLzHp3ZHpjNtcQy1bsyyDq8kRfWgXPH6ZV_9iseRxiaG_s9PR8Vx5jqxu_aQ_b0Ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTn7xdpelGNU73X6cl2lW5eHjGm59v1-r1A7ufbI_V5w&oe=6B032680"}, {"file_name": "3.png", "id": "184123384169653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003226_184123387502986_2935445828151185624_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsKtHC50GjkQ7kNvwFt48XI&_nc_oc=Adq4QcCQNBTcSmFVlL8CrZvFkipo5iOfYscJ9hY9CCNVv4K-YiOoLLlM9UhZhlJmnxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKw8WvTnYIHUc0v5LLOhnA3J_7Dyol36ZBS84iIL9hwQ&oe=6B030E84"}, {"file_name": "4.png", "id": "1315535709035562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974809_1315535712368895_2610547595902106290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prOuzhmAegMQ7kNvwEOIPlI&_nc_oc=AdpqBygVB2kmX7tFFBsioNLWw0nbbP2iASIiegzf_3VttFjY58l6PSjyX1MwvJs5RP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNwwbUER9212ja_lkKIKlPRoTlWVChDQAvMie1WQFFSg&oe=6B03342B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Soulr (1).png", "id": "203512685833758", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_203512689167091_1607168940753799765_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7wZBpxHUPMQ7kNvwEuaMJs&_nc_oc=AdriyPw9MPoiNmRoNkm1Wd3xDgMnumf5oS9bnZBSEJQAiI71OxK7SgJKWBnRHdWrEIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxBKAzvO1qEkmVbHrF2Isc6ADoJL5xsMQnPTQpWo9FvQ&oe=6B032F66"}, "display_name": "Soulr", "keywords": [], "long_description": "\n\"Soulr\" is a fun and challenging game where you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. You must catch them by jumping around, but the souls won't make it easy for you. They'll try to evade capture by moving quickly and hiding in unexpected places.\n\nAs Soulr, you'll need to use your ghostly abilities to outsmart the souls and catch them before they cause more mischief. With each level, the challenge increases as the souls become more difficult to catch.\n\nBut fear not, Soulr is up for the task! With your help, he can jump around and capture those pesky souls, returning them to their rightful place in the ghost realm.\n\nThe graphics in \"Soulr\" are charming and whimsical, bringing the ghostly world to life. The soundtrack is engaging and immersive, adding to the spooky atmosphere of the game.\n\nOverall, \"Soulr\" is a game that is perfect for players of all ages who love a good challenge and a fun adventure. With its addictive gameplay, charming graphics, and engaging soundtrack, it is sure to keep you entertained for hours on end. So join Soulr on his mission to capture those misbehaving souls and restore peace to the ghost realm, one jump at a time!", "short_description": "In \"Soulr,\" you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. Pop them by touching them and return them to their rightful place. With each level, new challenges arise, but Soulr is determined to bring peace to the realm. Can you help him succeed?\n\n\n\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://twocrowstudios.godaddysites.com/soulr", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "https://twocrowstudios.godaddysites.com/soulr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "143043522089795"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1779200943432915"}, {"status": "PUBLISHED", "id": "1367597068763339"}, {"status": "PUBLISHED", "id": "991306856727929"}, {"status": "PUBLISHED", "id":
=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es54tL74kCgQ7kNvwE5NJjr&_nc_oc=Adrsm9miQZfLOkw7LYAWjnHKkgQ_bh2dWYpkScZLSUu_zsV1mTG-SwIn68FKFOhuQkw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7GbNAHvpTZV8kzv3_wZWXtfNk-cn4ChXL9xaCMmIZOg&oe=6B0B46BE"}]}, "id": "141694408890793", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "219826737442331", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395603_219826740775664_9204199416196457591_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Go3DFjD0wQ7kNvwFVBnxV&_nc_oc=AdpKG85UOUDyzY8DhGNEIo-om1GRY-xmMgSZUn-ijt5lloV2RRS5JRLEEcjOKZVkzWU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQU0e5J_D7ay5tVOZ2wrXmXx1PJMvom4BFAKW0tRRBviw&oe=6B0B2FC3"}, {"file_name": "5.png", "id": "256373443538152", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035430_256373446871485_7118511692191908212_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQwrFDJwiy0Q7kNvwEUmIgp&_nc_oc=AdrotdTebALJz0zC2IUzGV9duUWGFWfvJTmTr4fkUj2E5nvG_6vUHrnXhmsWWDXmX_0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNmByrpgvn_eXTByfYfIgtw0n3VDjYDvkCwFAVYvD2Kw&oe=6B0B4426"}, {"file_name": "1.png", "id": "901359694304292", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974918_901359697637625_6465399393883184217_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mboHg9fSUIcQ7kNvwGx54A6&_nc_oc=AdoQkp6SSucLkPnuqZixCPgHxE8frf-Y6_VfHrl3Z8kvAEjpboWhIUNse82Z_kS7Z2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScXglA8QSTk7KuzOsqDbMYV1vycvm7VM0y7P1KnDYO_w&oe=6B0B0F80"}, {"file_name": "3.png", "id": "184123384169653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003226_184123387502986_2935445828151185624_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQz1iJPjhhUQ7kNvwHB1UuU&_nc_oc=AdpezV5VZoL6Ns5izg0psxy_EcYowIIFlZDYu9BtcboJ-GRbjoWI0ECDrIl7tLU06Vs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSm5j2bR0R3dasSmAPNiGYF9bIZWnQIumsXLnq98ZkxDA&oe=6B0B2FC4"}, {"file_name": "4.png", "id": "1315535709035562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974809_1315535712368895_2610547595902106290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9JQ_DYDmxwQ7kNvwElYIPf&_nc_oc=AdpZEHJSAuaaZDqGyCC0iDanWv6WVw3yInuO9dg_H3GTCNbwoUHCduNlnZNJIcM-0R0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPlZcN2-I8x-hH5Z-XsT8HXjkY1dluSIGY_lQl5vpvdg&oe=6B0B1D2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Soulr (1).png", "id": "203512685833758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974573_203512689167091_1607168940753799765_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wZgMNvVU0AQ7kNvwE44Zn9&_nc_oc=AdqYeZqHWlbl3o8PamvxpY_wjRjRXaUf-sZb-NScQ4aOWK5EXbNyIR58928tL4vASdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSd4rI1NZq0QxjbCUi7TVzGgA56WDHCJkxXNSL76EKXkQ&oe=6B0B1866"}, "display_name": "Soulr", "keywords": [], "long_description": "\n\"Soulr\" is a fun and challenging game where you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. You must catch them by jumping around, but the souls won't make it easy for you. They'll try to evade capture by moving quickly and hiding in unexpected places.\n\nAs Soulr, you'll need to use your ghostly abilities to outsmart the souls and catch them before they cause more mischief. With each level, the challenge increases as the souls become more difficult to catch.\n\nBut fear not, Soulr is up for the task! With your help, he can jump around and capture those pesky souls, returning them to their rightful place in the ghost realm.\n\nThe graphics in \"Soulr\" are charming and whimsical, bringing the ghostly world to life. The soundtrack is engaging and immersive, adding to the spooky atmosphere of the game.\n\nOverall, \"Soulr\" is a game that is perfect for players of all ages who love a good challenge and a fun adventure. With its addictive gameplay, charming graphics, and engaging soundtrack, it is sure to keep you entertained for hours on end. So join Soulr on his mission to capture those misbehaving souls and restore peace to the ghost realm, one jump at a time!", "short_description": "In \"Soulr,\" you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. Pop them by touching them and return them to their rightful place. With each level, new challenges arise, but Soulr is determined to bring peace to the realm. Can you help him succeed?\n\n\n\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://twocrowstudios.godaddysites.com/soulr", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "https://twocrowstudios.godaddysites.com/soulr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "143043522089795"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1163884779370435"}, {"status": "PUBLISHED", "id": "1779200943432915"}, {"status": "PUBLISHED", "id": "1367597068763339"}, {"status": "PUBLISHED", "id"
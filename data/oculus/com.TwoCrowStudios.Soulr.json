=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es54tL74kCgQ7kNvwGWSCXV&_nc_oc=Adr9PkAsyJJIF4nuV0-oOQF1DgelSMLgzYLt9zeSu0pRN9xaXYpNHvAhO-qRk21ePEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_7c7WagLG_zBVgNVxTZRdQC-9EWpd_lH1Wh8ur-nB-w&oe=6B0C5FFE"}]}, "id": "141694408890793", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "219826737442331", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395603_219826740775664_9204199416196457591_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Go3DFjD0wQ7kNvwERNnTv&_nc_oc=AdpMm263cXZDjg2jy2FgnNTgtX8jvjIwkr924oq_GtrVd2wH-Ez7ulZ8c4aHmyOeyRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDn_0RpxP6Lj6MbixxZAmfI-S4kD4fX7k8HQpXAPyGWw&oe=6B0C8143"}, {"file_name": "5.png", "id": "256373443538152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035430_256373446871485_7118511692191908212_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQwrFDJwiy0Q7kNvwEk459s&_nc_oc=Adq1uRblQtPO8dOqyFTfUUWoa9482LYnHslh2ef9TK1vxBNw1fGM_K1sO4RrqjygbMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQH1A12EPGQV5kEZyobE035-y3rebGxYMWjmEJwGmgu4Q&oe=6B0C5D66"}, {"file_name": "1.png", "id": "901359694304292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974918_901359697637625_6465399393883184217_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLTkaM5FoYQQ7kNvwGaZAPB&_nc_oc=AdqBpp0fHwwRnkhNy-euMg3OLtO7a4Pm5tJ_Kd68i3B-xtIAKEalo9Mj08gb-UOc8Fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD1usylxqASIsvtPiSrLoLaY22oYu4ZRG2Sqjg0a9KGg&oe=6B0C6100"}, {"file_name": "3.png", "id": "184123384169653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003226_184123387502986_2935445828151185624_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hco3h8bgu0sQ7kNvwEYT8Ov&_nc_oc=Adps6SMwt8F57kJ6v7b7PuP_TG0_8KcWFeFbf3Pr-baya6E0Yv4lY7Zo9jT7rRuQgRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjOK8LDOIjZSi6J03_4k2-JHvUu4wMVSMZ6U1yKk8q4g&oe=6B0C8144"}, {"file_name": "4.png", "id": "1315535709035562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_1315535712368895_2610547595902106290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9JQ_DYDmxwQ7kNvwG1EJUq&_nc_oc=AdqZAgh-Nby-e0B2x1Pxw2xwA0XG62mo4VbWCwIrjWKSySrjD4J5b0tdXb82jn_DtOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdxBnrQ4JYXMoknRcwc8uN9WGXoWjce3ZpXNdLvL3Ogg&oe=6B0C6EAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Soulr (1).png", "id": "203512685833758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974573_203512689167091_1607168940753799765_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wZgMNvVU0AQ7kNvwE9Evji&_nc_oc=AdpvzA3prB_7a8LnJAc6nTEsu004BFIoztNdI7E5FiDTp0doAt4OB5Q0HS-fduDcrtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkg1iXuqoRvXLXNijih_z6mQ2ow22YnyGdfLswL3FEYw&oe=6B0C69E6"}, "display_name": "Soulr", "keywords": [], "long_description": "\n\"Soulr\" is a fun and challenging game where you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. You must catch them by jumping around, but the souls won't make it easy for you. They'll try to evade capture by moving quickly and hiding in unexpected places.\n\nAs Soulr, you'll need to use your ghostly abilities to outsmart the souls and catch them before they cause more mischief. With each level, the challenge increases as the souls become more difficult to catch.\n\nBut fear not, Soulr is up for the task! With your help, he can jump around and capture those pesky souls, returning them to their rightful place in the ghost realm.\n\nThe graphics in \"Soulr\" are charming and whimsical, bringing the ghostly world to life. The soundtrack is engaging and immersive, adding to the spooky atmosphere of the game.\n\nOverall, \"Soulr\" is a game that is perfect for players of all ages who love a good challenge and a fun adventure. With its addictive gameplay, charming graphics, and engaging soundtrack, it is sure to keep you entertained for hours on end. So join Soulr on his mission to capture those misbehaving souls and restore peace to the ghost realm, one jump at a time!", "short_description": "In \"Soulr,\" you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. Pop them by touching them and return them to their rightful place. With each level, new challenges arise, but Soulr is determined to bring peace to the realm. Can you help him succeed?\n\n\n\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://twocrowstudios.godaddysites.com/soulr", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "https://twocrowstudios.godaddysites.com/soulr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "143043522089795"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1163884779370435"}, {"status": "PUBLISHED", "id": "1779200943432915"}, {"status": "PUBLISHED", "id": "1367597068763339"}, {"status": "PUBLISHED", "id"
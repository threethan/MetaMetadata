g?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSQTxMa_kgAQ7kNvwF_g19R&_nc_oc=AdobAS-SmmqWIWCi4GSJ4z8p0wxtHUlQGu7_Zk59MwRo_IraDfFGMAQffS8VM2TqL0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76nMFWzjaSGEIIybEZVcWdTaSrvfHlD-xSBez_q27YNw&oe=6A0F166B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Soulr (1).png", "id": "203512685833758", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_203512689167091_1607168940753799765_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk5F2WOveigQ7kNvwH9-yah&_nc_oc=AdrbX0FvHvshh5Q78uTs2WS4LR0fSFOUTrhnAWGwmXCT8VUVvPZBtMJuA6uXS-P7M4E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uPvrFiTfo1MAt9NRbB1dGo8A7nK55zEdpQYsMNp0ygQ&oe=6A0F11A6"}, "display_name": "Soulr", "keywords": [], "long_description": "\n\"Soulr\" is a fun and challenging game where you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. You must catch them by jumping around, but the souls won't make it easy for you. They'll try to evade capture by moving quickly and hiding in unexpected places.\n\nAs Soulr, you'll need to use your ghostly abilities to outsmart the souls and catch them before they cause more mischief. With each level, the challenge increases as the souls become more difficult to catch.\n\nBut fear not, Soulr is up for the task! With your help, he can jump around and capture those pesky souls, returning them to their rightful place in the ghost realm.\n\nThe graphics in \"Soulr\" are charming and whimsical, bringing the ghostly world to life. The soundtrack is engaging and immersive, adding to the spooky atmosphere of the game.\n\nOverall, \"Soulr\" is a game that is perfect for players of all ages who love a good challenge and a fun adventure. With its addictive gameplay, charming graphics, and engaging soundtrack, it is sure to keep you entertained for hours on end. So join Soulr on his mission to capture those misbehaving souls and restore peace to the ghost realm, one jump at a time!", "short_description": "In \"Soulr,\" you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. Pop them by touching them and return them to their rightful place. With each level, new challenges arise, but Soulr is determined to bring peace to the realm. Can you help him succeed?\n\n\n\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://twocrowstudios.godaddysites.com/soulr", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "https://twocrowstudios.godaddysites.com/soulr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "143043522089795"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "991306856727929"}, {"status": "PUBLISHED", "id": "1259046476382745"}, {"status": "PUBLISHED", "id": "1942896650445478"}, {"status": "PUBLISHED", "id": "1453397849716123"}, {"status": "PUBLISHED", "id": "894337959812629"}, {"status": "PUBLISHED", "id": "4074579389499440"}, {"status": "PUBLISHED", "id": "1492278951821329"}, {"status": "PUBLISHED", "id": "25238205449099651"}, {"status": "PUBLISHED", "id": "1067987591245822"}, {"status": "PUBLISHED", "id": "197764503044375"}]}, "baseline_offer": {"id": "1067987591
=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-xUAbSSxIgQ7kNvwGoUbns&_nc_oc=AdrDfmUHeZo8HCMdGZu8C34e9fsCnqCtX-D96omhcPjh6YP0Eo5eMwu3zsYNY3SXbYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMg0JMlld8d0egERIhQF7U0L2pwaZPerW_7IqgdMJ7Ow&oe=6B0476FE"}]}, "id": "141694408890793", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "219826737442331", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395603_219826740775664_9204199416196457591_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5FwKmRkBeIQ7kNvwESlVbQ&_nc_oc=AdrR3cvQaOrmxdm4H6uao4g321AnJy6jBRp5EZUDHtpJXKONtQjNvbge1b8qWGaNTUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBMgfbebQWzA3GoBZQY7XodhycM3t4e1nuYH7hA7Oc8A&oe=6B046003"}, {"file_name": "5.png", "id": "256373443538152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035430_256373446871485_7118511692191908212_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH3amu99W7UQ7kNvwE9HmYw&_nc_oc=AdouxaaoVYMcmBqLHEqzmHH1XmTP0nuzlbpFPkl6NZNQkjeQfAr9xTMIibojJeCblP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8haah3EKPFOqUHNYnI2xeQAwpbTY1IUS1gzZmL7Iaog&oe=6B047466"}, {"file_name": "1.png", "id": "901359694304292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974918_901359697637625_6465399393883184217_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B-x7sbvOoQQ7kNvwEmXgA6&_nc_oc=AdrJuHqd9c_N0SyiI8LJhA7buImRaxL952a2QwXnVGAGRdQO438mEDDgsJkjg4sOF-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF-p4NwNd6iI9L_Krdi3HresccScY2RQHQpq4amE6wSw&oe=6B047800"}, {"file_name": "3.png", "id": "184123384169653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003226_184123387502986_2935445828151185624_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fYYI5GX_lIQ7kNvwEg-t6k&_nc_oc=Adr5LNJ5K72tqvMJIek0bbEwaaWC8qZJQ4QdrxtTppWpXYxmV3EDjEXfrGoMWtUKJow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjymreUZF2nzScCWfsFX8mvg2tAAfMl-a4ydqmpePwRA&oe=6B046004"}, {"file_name": "4.png", "id": "1315535709035562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_1315535712368895_2610547595902106290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prOuzhmAegMQ7kNvwE-TvDq&_nc_oc=AdqLN60ulewwRc21VvzV9satMUSsAQL5K89eEcBwwHxswvzPRdjID_tKZMhtooPZUYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Y45Gaia-dc7kbgDhFX2UeZh1q4dw2J8Wmz70zGkq8A&oe=6B0485AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Soulr (1).png", "id": "203512685833758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974573_203512689167091_1607168940753799765_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7wZBpxHUPMQ7kNvwFAtS7B&_nc_oc=AdrLHJ6z5uH4ZP1rWhSupM-AM8h4ZjpRxa5Kipi37cD7ZRCrnnOlnOygnvf_WVpNHfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSeVCH5f0t_UPV-Q41zC4Nhc9Dl9xWW1eSrOpjdN76CA&oe=6B0480E6"}, "display_name": "Soulr", "keywords": [], "long_description": "\n\"Soulr\" is a fun and challenging game where you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. You must catch them by jumping around, but the souls won't make it easy for you. They'll try to evade capture by moving quickly and hiding in unexpected places.\n\nAs Soulr, you'll need to use your ghostly abilities to outsmart the souls and catch them before they cause more mischief. With each level, the challenge increases as the souls become more difficult to catch.\n\nBut fear not, Soulr is up for the task! With your help, he can jump around and capture those pesky souls, returning them to their rightful place in the ghost realm.\n\nThe graphics in \"Soulr\" are charming and whimsical, bringing the ghostly world to life. The soundtrack is engaging and immersive, adding to the spooky atmosphere of the game.\n\nOverall, \"Soulr\" is a game that is perfect for players of all ages who love a good challenge and a fun adventure. With its addictive gameplay, charming graphics, and engaging soundtrack, it is sure to keep you entertained for hours on end. So join Soulr on his mission to capture those misbehaving souls and restore peace to the ghost realm, one jump at a time!", "short_description": "In \"Soulr,\" you play as a small ghost on a mission to capture misbehaving souls that have escaped from the ghost realm. Pop them by touching them and return them to their rightful place. With each level, new challenges arise, but Soulr is determined to bring peace to the realm. Can you help him succeed?\n\n\n\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://twocrowstudios.godaddysites.com/soulr", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "https://twocrowstudios.godaddysites.com/soulr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "143043522089795"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1779200943432915"}, {"status": "PUBLISHED", "id": "1367597068763339"}, {"status": "PUBLISHED", "id": "991306856727929"}, {"status": "PUBLISHED", "id":
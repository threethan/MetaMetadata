_AQSefgofvRGjZzb98TY7CRut49q6DkH2swAUcK03poD9jQ&oe=6B086E80"}, {"file_name": "space station 01.png", "id": "589178533057493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974456_589178536390826_7134851481677367858_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS_hIK22kZAQ7kNvwGpg7B2&_nc_oc=AdrMuaigQPiA1yeIUndE3XzjFBtqho4swrq7C-bRVG3L_4dYQ_iSd_T_Xm6sGIdqkKg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSEgVl774LBhLsYkMCa-_hhOMq7QrKU3l8Nn-ZsnEceA&oe=6B086370"}, {"file_name": "minin 15.png", "id": "743730747067347", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974779_743730750400680_634832097062743088_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS8snmg71K4Q7kNvwHXCknP&_nc_oc=AdrZw8pOSfvJiPtMgq12GWlKdvd3QIyMg-UJeOjVos3u27-tYVBPqnd6VKH-LqXEmFY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTbXA9WLRzSbDzUqcQANvhCa0KS9mp7WSxXy5J_KbL0w&oe=6B085EF8"}, {"file_name": "sundus 07.png", "id": "5717632874971383", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974798_5717632884971382_4015957583982588407_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAXylKc-Rx8Q7kNvwFBrPio&_nc_oc=AdpPiRDD05y4U-a-mOYDtDqki7DzqngPVLrdkhhoVGTP9jD8nFIwdOkn2CRi-BTySQ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS91AKnLmA0kjuxI0Mqpk9gQ4kvwNJXiqWDmpTwYYLkgQ&oe=6B084136"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V-Art Virtual Spaces", "keywords": [], "long_description": "Discover the next generation of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. This app showcases all-dimensional digital artworks from renowned artists around the world, carefully curated by experts in the field. With V-Art Virtual Spaces, you can explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art.\n\nV-Art Virtual Spaces provides an unparalleled opportunity to engage with digital art in a way that was never before possible. Whether you're an artist looking to showcase your work, a collector searching for new and innovative pieces, or simply an art enthusiast seeking inspiration, V-Art Virtual Spaces offers an exciting and accessible platform to experience digital art in all its dimensions. With its cutting-edge features, intuitive interface, and vast library of artworks, V-Art Virtual Spaces is the perfect gateway to the world of digital art.\n\nHere are some of the key features that make V-Art Virtual Spaces an essential tool for anyone interested in digital art:\n\n   1. Experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment\n   2. Interact with digital art in exciting new ways using Meta Quest\n   3. Create a personalized account and customize your experience with ease\n   4. Create your own unique avatar and express your artistic identity in a virtual world\n   5. Connect with friends and explore the galleries together through the multiplayer fun", "short_description": "Discover the future of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. Explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art. With V-Art, experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment. Interact with digital art using Meta Quest, create a personalized account, customize your avatar and connect with friends in multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docsend.com/view/99j47ys9pkjfnihq", "developer_terms_of_service_url": "https://docsend.com/view/xawcb9dfzs9crgg5", "publisher_name": "V-Art Corp", "support_website_url": null, "website_url": "https://v-art.digital/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36269221144
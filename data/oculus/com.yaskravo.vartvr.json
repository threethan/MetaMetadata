a&_nc_ohc=Ll1KdgchHOkQ7kNvwHzJM8n&_nc_oc=AdnyBuWvGycDKkGg2iGCx_ODwyq4R3XxOfQ2kBhmdEUlonYjulcLwoWziVNp0hqm4Ks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb0gYfEmJ1LvYs04829OLKw3l-KsM23loMBg98QXN9uA&oe=69BE9430"}, {"file_name": "minin 15.png", "id": "743730747067347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_743730750400680_634832097062743088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsZOoUg8qDYQ7kNvwELygUW&_nc_oc=Admufgv9erNvVz4vy4KQ8teOVRDIlQ1UYfHvDnTXVAnbaDddtdaUQgYJFCdPk55j0q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6p3-k7x4_r2ywlDUVcplhL79APQaWxz8Ulo9TVKFLDA&oe=69BE8FB8"}, {"file_name": "sundus 07.png", "id": "5717632874971383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_5717632884971382_4015957583982588407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1Ny9NbiX4AQ7kNvwFe_rkn&_nc_oc=AdlNMqZ8hlubmryzBZwuEKqO07TSeOWUKHufim47ZuLSHSyEx3kNNLRSdyfpt_up7K4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTbNRe16-Qg7nrMeLuvIL_037g35U2O82soR50vvcrMQ&oe=69BEAA36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V-Art Virtual Spaces", "keywords": [], "long_description": "Discover the next generation of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. This app showcases all-dimensional digital artworks from renowned artists around the world, carefully curated by experts in the field. With V-Art Virtual Spaces, you can explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art.\n\nV-Art Virtual Spaces provides an unparalleled opportunity to engage with digital art in a way that was never before possible. Whether you're an artist looking to showcase your work, a collector searching for new and innovative pieces, or simply an art enthusiast seeking inspiration, V-Art Virtual Spaces offers an exciting and accessible platform to experience digital art in all its dimensions. With its cutting-edge features, intuitive interface, and vast library of artworks, V-Art Virtual Spaces is the perfect gateway to the world of digital art.\n\nHere are some of the key features that make V-Art Virtual Spaces an essential tool for anyone interested in digital art:\n\n   1. Experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment\n   2. Interact with digital art in exciting new ways using Meta Quest\n   3. Create a personalized account and customize your experience with ease\n   4. Create your own unique avatar and express your artistic identity in a virtual world\n   5. Connect with friends and explore the galleries together through the multiplayer fun", "short_description": "Discover the future of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. Explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art. With V-Art, experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment. Interact with digital art using Meta Quest, create a personalized account, customize your avatar and connect with friends in multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docsend.com/view/99j47ys9pkjfnihq", "developer_terms_of_service_url": "https://docsend.com/view/xawcb9dfzs9crgg5", "publisher_name": "V-Art Corp", "support_website_url": null, "website_url": "https://v-art.digital/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
paces from the Early Access section of the Oculus Store\nand experience digital art from a new perspective.\n", "short_description": "Get immersed in digital art via VR. Experience all-dimensional digital artworks selected by eminent curators exclusively for the V-Art platform. Meet a new way for artists, collectors, dealers, museums, and galleries to exhibit and promote crypto art globally.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://v-art.digital/assets/Privacy%20policy_V-art.pdf", "developer_terms_of_service_url": "https://v-art.digital/assets/TERMS%20OF%20USE_V-Art%20Corp.pdf", "publisher_name": "V-Art Corp", "support_website_url": null, "website_url": "https://v-art.digital/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "754268705712523"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1099178637686806"}]}, "baseline_offer": {"id": "1099178637686806"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1660593720, "status": "PUBLISHED", "id": "1099178637686806"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24711266895184432", "version": "1.0"}, "id": "3145246645689544", "channel_name": "LIVE"}]}, "is
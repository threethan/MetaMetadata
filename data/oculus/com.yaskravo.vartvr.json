14meghFyyk37eX6vJ4A-doL_ysU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4XGPWfcF60nehoqMIcOTk5xnbkx4GG635l1IQYcmXhQ&oe=699AFBB0"}, {"file_name": "minin 15.png", "id": "743730747067347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974779_743730750400680_634832097062743088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-Y8BzDp-boQ7kNvwEqoV0r&_nc_oc=Adl6F1r5K34U9m7cL-ob5pbesvdOXuKAeQ_0Jc5hTtGvPeJM99HnWagrv2tAP5nxz8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvM9CUikruA6ckXg6IcFgHqsdT3lMC2MY9kJ-T5rFGJ9g&oe=699AF738"}, {"file_name": "sundus 07.png", "id": "5717632874971383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974798_5717632884971382_4015957583982588407_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1E-s0_G_yoQ7kNvwGxcntU&_nc_oc=AdlSxCb87hthoTbKdBOkQZGJ5Pa6acPF9YZ8jLyl0F_rNPADFlO-Imf3Z_bg8kCR3kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsPe83a6By4U3FD_Nw1ZdB6vvC0hnSmLvCFk_hbYd3uWQ&oe=699B11B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V-Art Virtual Spaces", "keywords": [], "long_description": "Discover the next generation of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. This app showcases all-dimensional digital artworks from renowned artists around the world, carefully curated by experts in the field. With V-Art Virtual Spaces, you can explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art.\n\nV-Art Virtual Spaces provides an unparalleled opportunity to engage with digital art in a way that was never before possible. Whether you're an artist looking to showcase your work, a collector searching for new and innovative pieces, or simply an art enthusiast seeking inspiration, V-Art Virtual Spaces offers an exciting and accessible platform to experience digital art in all its dimensions. With its cutting-edge features, intuitive interface, and vast library of artworks, V-Art Virtual Spaces is the perfect gateway to the world of digital art.\n\nHere are some of the key features that make V-Art Virtual Spaces an essential tool for anyone interested in digital art:\n\n   1. Experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment\n   2. Interact with digital art in exciting new ways using Meta Quest\n   3. Create a personalized account and customize your experience with ease\n   4. Create your own unique avatar and express your artistic identity in a virtual world\n   5. Connect with friends and explore the galleries together through the multiplayer fun", "short_description": "Discover the future of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. Explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art. With V-Art, experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment. Interact with digital art using Meta Quest, create a personalized account, customize your avatar and connect with friends in multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docsend.com/view/99j47ys9pkjfnihq", "developer_terms_of_service_url": "https://docsend.com/view/xawcb9dfzs9crgg5", "publisher_name": "V-Art Corp", "support_website_url": null, "website_url": "https://v-art.digital/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
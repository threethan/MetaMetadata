_AQTqT6rJMp24rxIxZrqPwP1XSjGE7Q-yFXYKEXpy0xnfwg&oe=6B071D00"}, {"file_name": "space station 01.png", "id": "589178533057493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_589178536390826_7134851481677367858_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbsYj9GOyHQQ7kNvwEwTTot&_nc_oc=AdpJMAhcFEKhwVO6nm5R2PfET07iCfkgaCnNAgF3a8gKfF216HkFC7Z5rzdkXM0O5VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThSa1vjpRTyRHYUCCC2y50iZjzM8RWSABXYbYkR2oDOg&oe=6B0711F0"}, {"file_name": "minin 15.png", "id": "743730747067347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_743730750400680_634832097062743088_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS8snmg71K4Q7kNvwF6-MUt&_nc_oc=Adr0cUgkOtPFNZnbJHCXBCtlLYU0ETx-gq5tn7g42VItKSpzcbbXXDPHmDMujACj9Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD08BbPWuDdNmQt_3E2qfeFvdS4L14KFzJ8pOh0QmcmQ&oe=6B070D78"}, {"file_name": "sundus 07.png", "id": "5717632874971383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_5717632884971382_4015957583982588407_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIy8tJfHJ1UQ7kNvwGGy95G&_nc_oc=Adqe1-jVkJEXzPvCtG-gEkSUIeyKyy_t0iXe7aLOFQhzWLzgCpDS6GSRsWqMJgQYmZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnUPNLZR4lqA73n25VQk0pezxcFcrs__Te9lKnUdWAOg&oe=6B0727F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V-Art Virtual Spaces", "keywords": [], "long_description": "Discover the next generation of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. This app showcases all-dimensional digital artworks from renowned artists around the world, carefully curated by experts in the field. With V-Art Virtual Spaces, you can explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art.\n\nV-Art Virtual Spaces provides an unparalleled opportunity to engage with digital art in a way that was never before possible. Whether you're an artist looking to showcase your work, a collector searching for new and innovative pieces, or simply an art enthusiast seeking inspiration, V-Art Virtual Spaces offers an exciting and accessible platform to experience digital art in all its dimensions. With its cutting-edge features, intuitive interface, and vast library of artworks, V-Art Virtual Spaces is the perfect gateway to the world of digital art.\n\nHere are some of the key features that make V-Art Virtual Spaces an essential tool for anyone interested in digital art:\n\n   1. Experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment\n   2. Interact with digital art in exciting new ways using Meta Quest\n   3. Create a personalized account and customize your experience with ease\n   4. Create your own unique avatar and express your artistic identity in a virtual world\n   5. Connect with friends and explore the galleries together through the multiplayer fun", "short_description": "Discover the future of digital art with V-Art Virtual Spaces, the ultimate platform for art lovers. Explore a wealth of virtual galleries and immerse yourself in a vast array of stunning digital art. With V-Art, experience exhibitions of both experienced and emerging artists in a fully immersive virtual reality environment. Interact with digital art using Meta Quest, create a personalized account, customize your avatar and connect with friends in multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docsend.com/view/99j47ys9pkjfnihq", "developer_terms_of_service_url": "https://docsend.com/view/xawcb9dfzs9crgg5", "publisher_name": "V-Art Corp", "support_website_url": null, "website_url": "https://v-art.digital/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36269221144
.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xryMDzZeCoMQ7kNvwFl-EFZ&_nc_oc=Adqz7Y2X9397alv904WLj-fX_63HW2BP_JGC4yAM_F4HUlKi2G5bF65u-RgCRHiQNT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrWbGcIqBX_Gd2f-vB25DclYxdz5ol-PbfAhEwEoHE3A&oe=6A64BCF8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6jQPZGHZEIQ7kNvwH39q8x&_nc_oc=AdoXF6QbMEAeJFBMkvem0amz_BY0RgTexT9elfZMj0QAYvKy8KBUf_kh9oCG5Lv-9Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoIoRexTcYyh65ppjpm4lVAj7vWOcyZagkPIW_GNuT6A&oe=6A649F28"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-mZRZV4Ng8Q7kNvwFiwPNQ&_nc_oc=AdoWTbHcioKD-2bbdA5SnyYqHSiDYLJaXKr5caHXzePH_JI5M3bBc8SO7M-r2elqcsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbrxHboO1ooAkAC5LBhSBU68bumL55mQMKo32Ibzpb4A&oe=6A64C001"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs344QG2PsoQ7kNvwF1J6Jn&_nc_oc=AdpnwoFB7g0LA4AuUTb-rVatPsYSabXHwDBRphjPAsQjgvHS7LmKC6KfWI6DtF81H6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWaZM5Dk9Qn7vOu5mjsIKHf2iC6YTKPY8aloa51IwtdQ&oe=6A64B5E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ivsadphz3cYQ7kNvwGIEkxo&_nc_oc=AdoMZ1LZ7vMh1CcSpnjvE5BlmbwfkglKOGqVICugMjCd0KCtLhXnKgDp8ppp2B4HrjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkGiPTkRVNXZIpbpoX2O3g21INMayLEeMI2ubZq0ti0g&oe=6A64AEA8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5-AjSGy2N4Q7kNvwEjTtM3&_nc_oc=AdomamQqwJATV32T3cOwZZrD6wtX-H-GOHsUtRaytspVwBBb8BIONRjMY2fSay7gIvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvto5Vrr_XV6I2qnxNc9jYNTGloDzb5n7m_lBkMgDGDQ&oe=6A64B7DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReQWf3rcAOsQ7kNvwFOemvx&_nc_oc=Adq-A1cr8byntnsLda-77SjGCeZ4oFehTFVUGx4siVR2yigFrdYJ9iheuZBmPogA4U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBQzAl29e49DRPlnBQSMukha-gU6J58Z2X6ZYO7pgoPg&oe=6A64A0B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N8gcmsTfRwQ7kNvwEDkuou&_nc_oc=AdoVvj0vVZMQTsda9EVqTrbho8O6BIvn19YzALlhqKes-WvvwcVNQ0cIX3dwnx14ang&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNWdsN9e6fIknPQwVQefxnl8CRTKxKrZQ97RuDa5edkg&oe=6A64BFB7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
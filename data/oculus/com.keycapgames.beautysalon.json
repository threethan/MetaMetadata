.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRBw-lkLqZwQ7kNvwF6e3SH&_nc_oc=AdoTNW6F9IfEZAVTrXVwfje0oiQvUgfyxrh5dfiNveho84Zl55IRAwZjSuGs8v8nMQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcBS4IddolaS_wpO3-IGHRLFryxs2TaeAeHvIXuxwWPg&oe=6A8703F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-okl11PkWUQ7kNvwGKRf5F&_nc_oc=AdrxTPV9U0rfuKDklZCTweeD-G40oAmtGgywsKSw6Uyymey5IkOSn7FKpLA5VblU1mE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkq31CbX68di1E1-cAsfh6HRsXPGpPsZMEBcz1nJAJUQ&oe=6A86E628"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_MFFt3-3pcQ7kNvwERSzwL&_nc_oc=AdqbI9gv2aRQiJ3SoNfxxz9tzatU3rN-wl3lQY3qSLF2SGQG0BmX0p9FIbdGEUJHsYI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMfSQSObptzyWNww96AtRxHg6ZEwpz8ojFuUZdCtWakQ&oe=6A86CEC1"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZSptfvvU8kQ7kNvwEw2KSw&_nc_oc=Adog3VB8J06rifHk1KHeo6iKnOKLCXiCZdRA9b-9S-SBmug85Sbm7X2K9bmXHFhc2-A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAWOr4Uzhni121yeb1pkNl40Ewr0VAVMW8IkUs5beJ4Q&oe=6A86FCE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkwYN-sPIRYQ7kNvwFN-A4j&_nc_oc=AdrOecuo1aydpMgv4IMJLaI6twIxTUAGZm4RisRNPMsPojfSNETsVSyLPKCc4XxLmU4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq9Yu2QmUdp4KLlWK9uhbmrnUXHECNsKBdbNK7yLC_AQ&oe=6A86F5A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2VqDmI8xyAQ7kNvwFjB0E-&_nc_oc=AdpKRPtiK7aiui7ANZrz5oUEKPdrmE4dpZBYfxtsUzFgmssXlVXFVUBX7L9exxEpgv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcu3mq8X8b-AeJhUSlsvRdT-U6cSsmK1fRV6QFpCUrDA&oe=6A86FEDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFUQnf24RfMQ7kNvwHowub8&_nc_oc=Adp4F3EZ3xX0emQ5S4No4SosajEbH4onZkf892aHs_H8XqMAhsUiqLSLoXzjQIW0HrM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGid08rfdthlL4sRmLfJVyPnAgW7P3KndhXHj17UOAYeQ&oe=6A86E7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a6s5Vyfal8Q7kNvwHS61CZ&_nc_oc=Adqrr9lRhfW2l_faczjDiomxqkFRfkIyFI22QI9S7rgKSeNCK4Fjnd-5yRVRjwksld0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXwbLiGfQ-QhgOB2NS_TsBKyga0-l2EMy9HU6PSB_IkA&oe=6A86CE77"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNJulzQ5AOsQ7kNvwEFxaS0&_nc_oc=AdpyaTRXJ6YeFei2XST25KW59qEXcC1SvCGBj1jwZ1eBMzm0PbUH5fBA8f2USvuvC9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8pQgUoxH1dvGK8qs9Z7ahZQ59K7_L3hJ0LfV1BmtsMQ&oe=6A86D943"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fal
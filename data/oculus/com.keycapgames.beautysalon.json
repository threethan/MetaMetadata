.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqSj4vgTvkEQ7kNvwHjiL_P&_nc_oc=AdqnQeM-tC09pDb_CtBThM2t5OTvOITxkMjYA3laF5KLe4KNUWDoRfWc0IHcQQ3ev4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACjUvIUEIaOYeckaV2UlxyLElDNfYl8taphidjre1kWA&oe=6A60C878"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qBKiEkSSagQ7kNvwEP6u5E&_nc_oc=AdpZ2nnKnL38rCSIm_WyHSPKZOZI2eV3ZDnBb-b6YAul1IalNZtO_Ppb9dmDCO-PDQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFQHkJG46Gr64pA1Y6xp_Bvw95bKcM97Ie-mr0iA6pDw&oe=6A60AAA8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTaecb8OJGEQ7kNvwG7DRN1&_nc_oc=Adpno53KGH9DZTfqhyShxz9fOGu7Fya3V332DILOKP-pEmN7EJ1GU3GiiHGn4oOM7zY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGeL6SpcN23OctnAUKZG-cTMeNlIjh1kSwEo3Wv34uug&oe=6A60CB81"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbwOJethX_AQ7kNvwEKAHao&_nc_oc=Adphs26r2xTcj6Qqqlgr6kIqcb0qYCXxE5HEvuCNuYoKEc9dq0EjYBDofOpSBLEgDz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP94pzRbiEuTZfZ4g8iUfx0eX_mGhQL55Fdy9r4NTPWg&oe=6A60C166"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfdem9AmS9AQ7kNvwFr-_-j&_nc_oc=AdqKZCjTiXdZypcNmQP8NsL1off04gXRJxJsrSr-ixxQFCUbeBZbOPHzZGBqj-Y0Uxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvDXcvVIoMD4lqBbkfwU7GWDE6w2i4gWuM4_TQxe021g&oe=6A60BA28"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3lDLRFaUbsQ7kNvwG0q1xM&_nc_oc=AdrBzdZenc22OLHIschns2X_EENnYWDUS4kAs5HtnCHDwQkJoYpHjmNh4veAklmPbG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVytgav8iPxb5P-pQ9xwCqZBsl14vq8uCLpWPeKAhtKw&oe=6A60C35F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9tHHLbpNzUQ7kNvwGRBDfV&_nc_oc=Adq9sX-HXcbUBKvylpvxRbNtv6ux9qV3O-xqIAVuHIrGTf3RQgiNfCXkPtcYzdvBQsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChR6An-CnTh6ItLASw_ZVhyzs9keL3sq6p9KBhk2JYpw&oe=6A60AC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr1YxlRUEEUQ7kNvwG30BYr&_nc_oc=Adq7wK06hQKDfWC2oGKPvKeGEoVOQhnhMBzFFTSFvboyijCaGSxNlm95BELJtTAURIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdU3cqzEGXhcs91ZpEn7zl757G6xotpTw-WH8hdyji3Q&oe=6A60CB37"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3sRn9-Kw6YQ7kNvwFKpZ_c&_nc_oc=AdqrgaBmztwXmq7twABtO-_U_Q4kN3QiwZMu603hchSm0bGHkZ91bk32K7672Xykfdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfxDmeD9FRzyGbcnNs2ene7vvz2Y3Cl-G4sRVWDmgFaA&oe=6A60D603"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
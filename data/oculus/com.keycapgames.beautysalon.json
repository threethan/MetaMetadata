c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubA_W6akkdUQ7kNvwGXo9cJ&_nc_oc=AdqvRbXHgO97EcQS0P686ACE1WQAnM2DMqa-ckiLkTE6ya39QKNUhos6UEDWC20qKdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3ndKH3sLWyMAy3fGiDioCrMiGNGunub3qacGwQ4EMexg&oe=69F0B1E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPTuzc4dh9AQ7kNvwFLcOZR&_nc_oc=Adp-Btl-KkOzHF09ururNBg_W7diUR4I-25bhLFT8R-LNWB7nvYS0Mj_qci9dgM_Xkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1MH1OkxAk56q5SR57u6BN1nE_acnJaXNyRqzMHu58hTg&oe=69F0AAA8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSR8e4QSZS4Q7kNvwHEwu9Z&_nc_oc=Adpfbp7eEJcGNVFfmjvUImoI-W89a5hpAPw6xuk_wgLkAYRPMYay1Heq_h3wVIgMaag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1DBl59UcstcChWStPR_YeW2ZUh9bKFJ55pH6pVsvepVA&oe=69F0B3DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l77ablM2JroQ7kNvwHpLEN3&_nc_oc=Adqwb5A9k486PYlxDtKVubkkgRyKqu6qWmUBDr4_IfXcGiYtJxN-E3YfeSSbe3m2Z6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1dIdXcEF-8ZY-kptIA_a4iWu-pavPEvLObgF1q3UzmvA&oe=69F09CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1320556889188298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391898_1320556892521631_4203757094769070119_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnaYSlNd2IoQ7kNvwG5Wbr_&_nc_oc=AdpITXEzUs2VSwOKhLdnc0hO245oZEu-IUpAuySp7SOZXecP50G_XgtJQjLvVEUFVyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Drq5fOkbiFP-BMjHnCBCq2sxYifg0tNjZOH_KyIswmg&oe=69F0C01E"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Creative"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{1280831073127338}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{2095491800866025}\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{631845462860833}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9277866902234028"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2062152911303341"}, {"status": "PUBLISHED", "id": "2752584691800245"}, {"status": "PUBLISHED", "id": "1584610699208555"}, {"status": "PUBLISHED", "id": "1109320164457495"}, {"status": "PUBLISHED", "id": "2344529512643377"}, {"status": "PUBLISHED", "id": "1659579814711781"}, {"status": "PUBLISHED", "id": "2834411333613368"}, {"status": "PUBLISHED", "id": "962850759350701"}, {"status": "PUBLISHED", "id": "1823034991602004"}, {"status": "PUBLISHED", "id": "1314725843287051"}, {"status": "PUBLISHED", "id": "1135756744876897"}]}, "baseline_offer": {"id": "1135756744876897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17764
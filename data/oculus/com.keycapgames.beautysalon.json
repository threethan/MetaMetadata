.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEyebAQkE64Q7kNvwEqukbG&_nc_oc=Adq1puYMvr0B8nPJCwF9y_mVVPeBQpwxrZlb6gS9VY-yXcZ2nVLs7MbNz5Sdw6Cw9Uk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G8wtDdQiFf8q9NgKk_7kVReTsMvowalC020EcsU5ebQ&oe=6A22D1F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCltm-v_DP4Q7kNvwEMRUvL&_nc_oc=AdowSNIP159iChDHPojRBZZNndFivgZmUQQokb4KQcbB26Gs3wArQ2xD7FCA6U1mYM8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__9IXI36PnpBVME40RrMxXb9YHohQJUqbiUtPHN7ypoQ&oe=6A22EC68"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z3jf7XlcHEQ7kNvwEwAjeK&_nc_oc=AdqpqzRRH3IqXM7q2_H0alFA3c71vQzlSo3pgjVMCyuvoVfND7Opi_CJEvfe4gLdpT8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZN69OaixbRn0kKq0j_Aa5P6gPCf9khjyhli5GwhDqCw&oe=6A22D501"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc3VeNtticYQ7kNvwHE4dET&_nc_oc=AdqKQiAL1gqiyveYmhenqIvPP51rE4z6QD6CXSp2QTbv-ev81h3F7NBE8o_AlSVidss&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JNrKI-AW9g4qsqmFQcNXRkLeh9t4nwS-GBzmcKlHnRg&oe=6A22CAE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7xQw83tJncQ7kNvwH2xheo&_nc_oc=AdpyyySfGW7m4MCevCV9mope0F-p8T0KEq8Rv1HuL900ED5uWHUh4bn4D5glNGvCnR4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aSIrNgB87AQSQNWnTS1Hv9AJMh46r-uGzqMWHYrJe9Q&oe=6A22FBE8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRiOaPoo2_AQ7kNvwFjt-Ir&_nc_oc=AdqPXGp40a6LNPDn-e2mmRoZTJG_OWXs5gmFoqWBfuocj61rRUhJAlswOivYQlJ4y5s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dqcK5Fa4BaxB12jC7FfFgPe4tCCDOZmYL9mQ54HexBw&oe=6A22CCDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqmF8FReOtMQ7kNvwFrjsBK&_nc_oc=Ado6QgFFZcvpPG0mvHs5roHDpErhmUMlg2VnttsDXD55YFqVxFZpnHETCRAlhMCPzaY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GhqY9Uid8iML9yz_BifR1BzQ4ad_lFn27a3hNNaVDrQ&oe=6A22EDF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U51h61Qsh8UQ7kNvwE2bt4f&_nc_oc=AdqS--DetKzLm7hw02pa7T1lU0P2A2SY7ZSSognm-59wrzD-2rI60B8IVs7dw_FG5zk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oWRHTALdxhkTIiclJDkliDVJUR31IDHo0tp5ncNB8tw&oe=6A22D4B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKcT2_WPHcMQ7kNvwFhRdgg&_nc_oc=AdqMkiOBCx18ztc82u84IezGnKXstWSrS5om8zXh-5a2jSa871S4VefdMP-EBy_Ta3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM-vmNCk-VabSnCmKUYrDVygVDMzH8EitevpTmudeDmw&oe=6AB28578"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHm_zOQ8z64Q7kNvwEgC7jU&_nc_oc=Ado6t9w5L21Q6-1H74fCYkKPl-iOvtn77JhbZMgJiJ2MYLbw3lovVyb2YaExM_sHruE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl96UZvIC31uweRXM8I7I7lROeE-aZIf6HR_IPoR_VzQ&oe=6AB29FE8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xilNoJ8VQcAQ7kNvwFT9a54&_nc_oc=Ado_xTA9ju_qSqHsoTtAcaLm18I0sB7pLbzfed8_Wxd8lRyAaZN_1TnSRjoCRcgcNQI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlRvvoJTWR8nBBSNg1tpp2P2ylPHVFB4ngRx5bIYAmZg&oe=6AB28881"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwxGtSrn4qsQ7kNvwEQyX_R&_nc_oc=AdrdcJoilqjaO7zILzDNoz_v7TNpYbijH9bZyzk2SHrIJh_J64WPpgcIR-Wags6AhBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLItsCHef4g1jUaaW3hGgHe1Sbs70rgKUj4JmIu0ytj3w&oe=6AB27E66"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxU2_U-6BD4Q7kNvwEZCkJq&_nc_oc=AdpaWHaASZa866VCOo2vPSy8N0C583MSwb_ihCtE-nzjZp9gHXPwCDCsjWkxYxsUxFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnd-5zfGH1PYA2sSW1loC2Rpi3J7YLwJGV-wTWMrMF3A&oe=6AB27728"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJu_XJGeJv8Q7kNvwHaOo78&_nc_oc=AdoIOdEkkVLLfjlFKSAQtAYwlVZr5xlHyJKpLc_7oI-KknOG65f1A-ruN7jEaZmC8hA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHdAkWGAKc2eqUI-aPAZQjlpiQqDYZ0AgDekcvW-MYBA&oe=6AB2805F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZD1S1Sta68Q7kNvwGFaI1K&_nc_oc=AdokQAiTlwB45HKWRPwCORs7R30aLyMaW98Uf41knCgttzxql02xU9nX4zeBRjJcu-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhqh2MTXUTgFPV3D5Wss_6RxKrSAtQBlL370ejFJJVJA&oe=6AB2A170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDaRvEGLnRAQ7kNvwHKSIhR&_nc_oc=AdrbJ3I6xP5VUJK0lzOwUBl8rPyUDnn2bz6r1SjY0-E7zmTMRR6m4Cdj2ahKTFqoI7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2dQJX6Cw6erMDv4i9rfGUUPpdF_iloY40H52JP1JSjw&oe=6AB28837"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07ywUInA1tsQ7kNvwGFb7n6&_nc_oc=AdpTKtcUeYM0lNsmjqNFc5O82EnVQXop62AdtpZv5ShfispJa_tBPyZfV5PVzy7bP84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiM4QVW7lmU4laS3ANh_FHHz6btDPWj5i3rh5mb-HRMQ&oe=6AB29303"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
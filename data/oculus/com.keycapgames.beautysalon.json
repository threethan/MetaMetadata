.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbAqgpEhl7YQ7kNvwH8eUa_&_nc_oc=AdrtF3B0tZFc_ghi7FeukPI0nt-93kknJIORr4GQcoeD79xroYnX4XuW3-UAbsZpT2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqHuYusYNIIvqugofIYoz-vLOFWMwBkeQ2b_iqrlqwyA&oe=6AB133F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N99KuRObsEQ7kNvwGb0nwl&_nc_oc=AdoTt8BI_0Jnlbr0Q9RbIHz7NfV6bK22RajhH8QCdoYLS_raquUe5MyFdVj3LfUQ97Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8hvwbB-tt2ODOFaDWqBRRMYDDE8Q5ZDIXDnyPHbifA&oe=6AB14E68"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xilNoJ8VQcAQ7kNvwERup00&_nc_oc=AdqB_vwmEDJ11ZlncKEInxn-YNxn7dDacZXUQvsygdHu_fnn7dT2juG3_2OxtnN3rt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiND9mOvHAOTvrgYRQr3E-zJP3NgzqhzpjQHoKuSrk7Q&oe=6AB13701"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRdRpHrhYzQQ7kNvwGMhj_q&_nc_oc=AdpgoSrHy5xjnSQGFiR3io-6lb9ePDPUGVivyfSaChNBPBWQ66DJ2F5XsSPjJVQL-EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8X9coCVLf1iA5ykS0xXhAZrqPDf3nIratipOqcHyz3A&oe=6AB12CE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxU2_U-6BD4Q7kNvwGj0sGy&_nc_oc=AdqEdluPPK4VW3JsBOcCCk4AiOh_YhB_-uLTyp2FXDKdeI1w83faT1mV2Sf6rrHKW2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_NXgDh6frENpjS_9ArmF9dHd_n3pT69oYkLKQcleFtQ&oe=6AB125A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJu_XJGeJv8Q7kNvwHMmbSH&_nc_oc=AdokT2IMtnwTFUAidZ5z5Ce21yA1xGrRHw3CkuFKSBQ169YQFSznz9gGG7wy6YuqWoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYS1su6DJffAyzYNp-nL-aWwSDSIh6aRk7_QwqQnz1ww&oe=6AB12EDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_7B3SNfc0AQ7kNvwFjmCJb&_nc_oc=Adp2UtDOkVplTd8SfJHYrDNuSejsNmFF9VzlLqTFyzvjII7UiRRDFuxbwwlLK4uXMJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImBd97Nxn9JcsXPEJHQfJRo1cSsNFgZ4bT2uMt3lwL2g&oe=6AB14FF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDaRvEGLnRAQ7kNvwFnc5-K&_nc_oc=Adpwac2mpFBR2FIKJHScWAk1kS0Tkg5jFktWuZGKHS7VMjPU-_5AJ1hfTLc3Fo2pIOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxIdiezPTJa0youm6BpKfRXCVNYuU47-hpAQ5xFbGATQ&oe=6AB136B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
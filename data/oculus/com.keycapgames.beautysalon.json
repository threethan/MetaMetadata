.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3CQBLqmTLIQ7kNvwH0goJv&_nc_oc=AdqIK_8Z77rDgektSPu4GmpreBc4_AK13mjf4vsJG7WEttXmq3l_kU41pdtUQqrRf8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CP_iKLkSrv3aP3A2o2stEdw4ZqFeuH7I5aoFlbTz_0A&oe=6A0DB9F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVxQx1d_1fYQ7kNvwGu-wT5&_nc_oc=Adom5bVvSi-mRr6jUHRqwcp0v1g4LrLWbwqhWeq1ot3tBLG9srZOLAANRSZ7oljBvy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_YkRGOoUKBID0RQAOnwE9l3WqG5zXyD3Zj3e2bx06qQ&oe=6A0DD468"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA-IKCdFdAIQ7kNvwEq-ro7&_nc_oc=AdpXLmuqO9yH46eRqCwHJ8BYh2A5LaqzlV9F0cmHMaWiK-viiQE_iSXZI9K6y7_ry64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dXsU5A27VqSLMOF0cyN3MWbGzDJBjlaGwVAbLLztX0Q&oe=6A0DBD01"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InZLbLG73gcQ7kNvwFErj2P&_nc_oc=AdpoeK8SPZOPFr5Kn9ojupkrpcfinLv4KKI-mEKN9I1bx-XjJrWAeCUUCZ67V39cM0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qqj_SV3gMTP7sMP6b8N2DW1K3RVFESVfZgU67XAYfcg&oe=6A0DB2E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi-n5NZeUrMQ7kNvwFhMJkf&_nc_oc=AdrOXrAov4CVbqNbgiXxmndLSUrJguGFVb0tmB9Swc7YlrnjLiXuKlOY7Re2JyUKSvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_9YVzqGEYe19AZ5R6OmhkFtfa9TUHgtC9uN8qWFKF_A&oe=6A0DABA8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCMkNZXR20IQ7kNvwEhObwq&_nc_oc=AdrpgnSyOQwa6rzY2OmdJtS4Oq9FcHCWp0FcaaDMsBqJbljHF77MVXMVIR_XgsBcQuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6894j0N8xoG957M2XTyaekuJ665Qhzmbb9Osc0dH8y9Q&oe=6A0DB4DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kymQIt7EbmoQ7kNvwHq9MIA&_nc_oc=Ado36c3-UiBQ4aOc0ZoYx8GeCWRNC5UGWW1bvnqGLWJY5U8zlDVr5yaTUb1qhmyKvjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BCSvzFjj6FJtFuHJPGwZSZ-EGm9vzxqaGQE6xc40gzw&oe=6A0D9DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI4UwAEWCQUQ7kNvwHeH-J9&_nc_oc=Adr6ktiI2x7E-1MiMtORfEwbaJiXcwaC4goaX6GDf0QpiPAhm4gdCVPrGy9bmFoLyyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HrkcWY3RBz77CJKcEOboDdO1t6xy7Ev99k9Rolg4xkQ&oe=6A0DBCB7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
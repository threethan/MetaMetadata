.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njV19M1GAUYQ7kNvwH27t1X&_nc_oc=AdrgoD03Uxqyxj5nVU8IWvpt_lBMWWzz2TR-ui5FOwBfyESYxhf0gnhhsVkTKHQG0Lo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z94oM79MzkAz936soUisW4IUyj_kYLsKkbLsnqJ__Lw&oe=6A393B78"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1dMCj78x2YQ7kNvwGwM4bh&_nc_oc=AdriPaRvfpBakRMJMk18bvxiSeyrTFHaCBwhv6tXF6XthJ6lhVrDyFpdTEk3VpOmJxc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uiCrahk5TPTCuPzwcqOndqlMZkDJbr8pua55m3qZCKg&oe=6A3955E8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHMRsm6WoKMQ7kNvwG7aBlc&_nc_oc=Ado0kC6GYZoorfZmL132k2a1zfZrEZMOrsic4ZxENTm5uUsy_Tm1ex0UPvUqpXFmRsU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ONmxawOKhncHvuP5F8IBqnAbeAZ7bibReUZnS1umYyg&oe=6A393E81"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyaUp794dPgQ7kNvwFx5i96&_nc_oc=Ado4uCeRyrQOea93G-2LkfrcHy-wyr4u_09f_3QhFMxTinKpwhqY6NUdUbqbuzZ7niA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gcEPGVw3GWkEYxaE-MQHAoxwKwFvK_5u52_ogAIiESg&oe=6A393466"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hFPfe7w0Z0Q7kNvwHvPMqB&_nc_oc=AdpwcZh9S1eUpWhDevpH5OmdWW9Ay7XxRqVtQC330NIqE-q3mbNseVqKRZR2N2FBc4g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SlCjRwUUTXSzmV3WSIYqhXBMcI40pm4a3ES2rlR_Shw&oe=6A392D28"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yedgCd9P1k4Q7kNvwErBAeA&_nc_oc=AdpUhDmgnq9xk2GymujNkQlOvnrGM8FRTB8QnhPAWgDWFiaFkAga_mEQEnMtjOZiEFA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vs1-JoLuj_Hx4bo1cHHpL8Q5TwePRjkHc63if-p_bqA&oe=6A39365F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joyuOXDPaIgQ7kNvwGu2yd9&_nc_oc=AdouBJZYjvkLeocj7nCAICRym6SgGTdNOBd_N0852mwbDf8S1IWWDvUtZ2eFF0w0QAs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ynAJFXWh2j8s3SscwLI5pfK9JNlAL_HyMHZW1VxJ38g&oe=6A395770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dee3_Ata-tAQ7kNvwH2eemm&_nc_oc=AdrxmgDb8O_4s8N7ting9LiJTpH7ffjbjmrxY0ku7bOnYRjD7T4DuMx9_9lOAxSDdQU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4aQW6111oJ8fe1_B0kUwtlhEfl1fSE4MV6vR5iIHcVA&oe=6A393E37"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
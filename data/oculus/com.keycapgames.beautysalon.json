.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gaz0dEeQH4Q7kNvwGahKmu&_nc_oc=Adp_gzDZ8foB1Sb-h-sIIgfS6J40T1TIfx4wwDpTVlHGJrV21pcW8J5bghYcChF9kRo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq58cSqaPSJ818Yi8EjZ76Qzm5eMA4fLhDiXCmpdh2KQ&oe=6AA94AF8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aefDsTDOdbIQ7kNvwGb-aj-&_nc_oc=AdpmzF1J7katmR3pdG_VTnDH3IKVdJ2nIUgeMkFGFyJbEOkKEJFmD9TwVOP6nogCs8Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCE69MsA-iTOxXIJiwdbCelE8qe9piATUQiafCH_SH1A&oe=6AA96568"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og_rhcIBm4MQ7kNvwEtXpXR&_nc_oc=AdqKJ6C9Te2j5rSc7RF9HCrQr5LH4addHoxDGID2wC_zpOKq4NyEMxQBpz6RQm_oLrc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_h4HBeHJ60ftzdNj4jQns87nIM6596X3UV7qXvzsu9g&oe=6AA94E01"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehbm6NUbYdsQ7kNvwHqAAEc&_nc_oc=AdpjgCTLkNI0oV4naXORqYF4lPJie21AOb9juy2ror-EtrWQ-eeyLwf5kapCkHbccEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3qDtvAc0M16VPUONFC4kzvjKCyZPhNzmoZlh9FshqBg&oe=6AA943E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk-YtUwmlUoQ7kNvwGLTpAP&_nc_oc=AdrknHcqrspOK2wi6bwbMruCn2i9eudRtzRYy3XzJwtC9ZqUaDD4CP4t5-k9XAAnjqA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4oAGg51ZXvzez5cfI3XaR-dnPGRITiVYPkEmeWDoBTg&oe=6AA93CA8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOPptjKqoQAQ7kNvwGYKmLL&_nc_oc=AdobyupMLTj5gv-VhpaERev6oWtcFvJGspk6DAW0bUAnFNOg_Z7sLZwP2u9wV3nSF1U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfrxGjhz639AwkPWl1MSJFhKaF9eMJuSZ_RYPE_ltBVQ&oe=6AA945DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztM0oQ0Nj3sQ7kNvwGxvtAn&_nc_oc=AdqrWOw-JnxK8IvfAG7cBl8zZYsp6eLe9JHDzz5YaZFU7D6-o3eEGEuTJ2GuLdfStFU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIExy-vvzLmhV8fZXfl7L4-ENnWVw-sDHF3qFs_hkKMAw&oe=6AA966F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft28sRAcD6kQ7kNvwETwtGU&_nc_oc=AdpC_on7qPvoJLVBXzo5j-bp4E6bW2LyGnLdt3Bw8ey79HP_19RNhDT6Y4fVbSphn3o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL419GP5pY0VnywBTtmAOfwxlilscXwsssNKxGg7ZAsMg&oe=6AA94DB7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
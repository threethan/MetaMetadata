.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlO9EhWWnmkQ7kNvwHAZrX7&_nc_oc=Ado73g45Qo6KglgpNc_p-pa8HKb_M4QIPpO7WcCnC6Oa0nZc7bw32E3WIwqZ1mi3gJ0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQS1ZPeTD-3ruiBWzN8tI93X0gKL900Kuv09IcEYwXwg&oe=6AD3B338"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkALH3Qr8GIQ7kNvwEYpq2n&_nc_oc=AdpGuf564D3agaCh1Sq2WRstA9g8b5TNpzwePH47BmTGLUjyPFOshvLEb-sX23Tlj2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrjbcyh7QqMUGbo2QZ0EuXYtHIhlfKwFs8clL2URQsiA&oe=6AD39568"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxmR-gWSQEEQ7kNvwGbCbWE&_nc_oc=AdoN2ze-jHovgoEksBJrsEYH_s3LE1WENr-1CmBfsDdr0OPaG387oeqMSKGd4qg3DXY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnMvVM38LgUfq9Om3JU9CKAK7nplwDGffPNldmp5dtFQ&oe=6AD3B641"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0o_5f6WUGEQ7kNvwFo_m2q&_nc_oc=AdrhfqmjBMKYYK8W4e2VOuVHucBXZqC8rST0uhaEw-mZJqFY8t7fi24Gwv_5EwojD5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj4-kNJCphvPTkWpxR4wxEi7pI1kA7Q7INk3a750lE5g&oe=6AD3AC26"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBzYNDxc0WEQ7kNvwHZxTTe&_nc_oc=AdpNO-qSeTifSZbS1S5A34BRkDyE8vw9mmi03I7Hrdvh39Wxie7Hi8Wox1M9Qupqsqo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWU-P4YsuTlDIrBjdjiyk7VDmIHk1D1x9HFa7eHEAEIw&oe=6AD3A4E8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-T736lNLgAQ7kNvwEAyhTC&_nc_oc=AdpCTjqIswU_2OS4IJL5E0Dw5nP6w10od4xGmy0o9NFdn0frpjv7JqEkLLlb_6j_l8Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjVq74ASGCkrBiPABNIM-9XFN5_JlHpmy8KfGECBr5fQ&oe=6AD3AE1F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q9xW7PdnioQ7kNvwHXEraf&_nc_oc=Adpn3XBVY46BChl8IFDJcR52gzBstwAAX0HGSQ-qGS6XnPnaX-9Bx_tYNmy2w0CKEyc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLgWmxLabkHJaIK0Mxc87_xt_pZO0tjl5U4QFFvrHfuA&oe=6AD396F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXUq09ZT07gQ7kNvwG5MTQQ&_nc_oc=Adqwb8PCSiRRNdYl0ocdgvtTxLS8t6LkIWSjaCyMO1Edko83IXrclIPEVymprZ8lzSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIPXuJv_yQ7beETdjqfE2Fx9UBY-wNSIyZwbiRQORaiw&oe=6AD3B5F7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
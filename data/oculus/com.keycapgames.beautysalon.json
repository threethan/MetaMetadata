.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwpsmGP_OuIQ7kNvwGcg4CB&_nc_oc=AdqkxJt8oypxFu9Yk0nH3c4yLCaIeBxJjt0X3Qwd-cBTo4Vjb8cStV6Brg-PemziBdM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4EXUBVqm9LD-g8eqhQ6_1R0zMXRuE1FsMOApnVQ2Q9g&oe=6AA404F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln_fR0wpiocQ7kNvwHTmp2f&_nc_oc=Adr1Lgfb6zli-xSFlv9i8OTRLS7Sci0lHoPkhoYr5gaiEptfYOukPbiYEZgndwEl0Jg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkvFqTibpVczqEOqQ4R3jKo7lvMRB4fKmdr3cGaiUqxg&oe=6AA41F68"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEBmoU9UTXUQ7kNvwFrNFYG&_nc_oc=AdrT6EdVSWvtKlV6YZfU0omCUp39711IbX7KdBbgnhPYEYzVGW23gHn6NYmnOL-us9U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlJJNQEopM2SWNGTOdLu8kKxH7PqBlcZSgyTbLN6zs2g&oe=6AA40801"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHXSQqdsWb4Q7kNvwHqb6or&_nc_oc=Adoegg2hatob2T1P1akCT1pC1qDscEkcIQnL6GdvsTqDEHcsAydWWGERwY7yxk56JZk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiL3FgQZOHLTRacurijgiB3wgc-TJBU2Zws3nH68OAvQ&oe=6AA3FDE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOLYk9kN278Q7kNvwHh66h_&_nc_oc=AdofHZcLpjQ4cG3j9eHhQ-Bw9sUyPRn4RY-qY2_ArAvDy5q_XMPMmkPkdBRwaATIIMY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLeeBFlaOI01NQoRTVWCcedFe-YQ7M1_6NAfZYHH-q_A&oe=6AA3F6A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi6SmSsall0Q7kNvwEwcUmp&_nc_oc=Adr0nXUu7syFZn8KpIY87jViz3x8r1GuVb0aPrKhOrorBKlL36UxRYHFXPsbcrenqYw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJSXTxeMi_ITbPcbslOK3t9RDJXFXoxL1suRG5OUe1mQ&oe=6AA3FFDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLp0WwSXrMQ7kNvwHPh9NK&_nc_oc=AdoPZm4eE387H7BBQHiwIoV_npnK_hzh46IOtorZ3CPigwdSAsdduNjLOWwXx_-2H3s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5qehidIwL8OXEk_ggnPJ65HdurFMwPzo3UuO1mlVdaA&oe=6AA420F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My_LqVs9vpcQ7kNvwGbwNYI&_nc_oc=AdpUrUgeUbCZU99bV0-zw7SnPXiDYabSCiF0-hO5qVYYORLwB-XkPj185dEujG7RM28&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2IGUcACjBuHY9JmJcvG__J-Y9dCiN_b88Ru8ZBl3IJw&oe=6AA407B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
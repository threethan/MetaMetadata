.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOjx13xGtj4Q7kNvwFUJ2ZT&_nc_oc=AdrCQaNL7eCaKQKpPDynAy64xKrbFyYL6MAeSSAltVHmbZ8bAAWem8XVpS-XNaQZf2M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZhrN16rTMXzKjMry5S7xnFMC4FrIR3CH4aJfctmunOA&oe=6A369878"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAaqYLL3OuUQ7kNvwEuL7Ch&_nc_oc=AdpISYI-_tkHeJK1SnV2QJInRVmodQJpMt9Gukof_dXPUaPPXyE1DlNeI4Snyt09v3E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ejuNLE0bEIgkZxb-Do1tfoDP43jMOmnLhNxQcUjTlRw&oe=6A36B2E8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHMRsm6WoKMQ7kNvwGrmN3w&_nc_oc=AdrgiJggHjd213SqdpRoGl6UwVWFCb9ljSp493dX1nLeQ_kFTbqWh7JMHQ0HGRtc4Js&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CAITnQ_oQ4VoNpEBwHpNjkKRivcpBzCyApeem25tnOA&oe=6A369B81"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJw7NoTPTSMQ7kNvwGVlkse&_nc_oc=AdoCT0wwsh1clOYE3Gr-lP78sQBRDuPQ6QVpyTCnkKsxwm3pnOzxbl7Y1K4Bqgjk-2E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ep9aY_5Clo9H7EyrgDsIPUA0ba_xQ-CZupXGyEpelfA&oe=6A369166"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx_JcpWROD4Q7kNvwGCxQIO&_nc_oc=AdoPzDr3l6l1Gc82Ljn4mPlpFK_Ixhc3LUdudB0MfcH-deFj43BjIMUktVldsajJD5o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ngk6bRqdXinzpnxCXADSPanBZqjsooiPFhEUJsLljuQ&oe=6A36C268"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yedgCd9P1k4Q7kNvwHxujED&_nc_oc=Adqipy8g0eKB3C2sn-Udqa9I4aalPWcBmO4Qw7M9LpXIESDbusmMz0Cg-7YNAJQkEaY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XsRY0NNmU0yzwLBJ-borbxXTcKHhchsHHml0wUbuooQ&oe=6A36935F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Ji8i7vF8kQ7kNvwHF2_nr&_nc_oc=Adpi-q9oYBulX_bgWyO_dU_NmM6jnzWR3IDqL3tQM2dzU5IvbakH_GKYoKuDaIjPcdQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7jQghDqZ-cxV8xHcquuUzgArCIw2Tlh9YIqJNrm_Udw&oe=6A36B470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dee3_Ata-tAQ7kNvwHB6t7l&_nc_oc=Adro2Y63mRYOmP-lskNjMDwTmhIB2rK04Js1jM4ZcVdFZgE_7nARfxlBxWlRxQD7g3g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XkKIGIe7COg8yvIUkiuMVnBQZqwkUnN-tSuk_71XUqA&oe=6A369B37"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
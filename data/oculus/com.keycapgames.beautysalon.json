.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5knDvMxcd78Q7kNvwHu8RZC&_nc_oc=AdoV1g3wwbuVDD-OiHlFlywvYCCdBeeF49OpICOVrxVQymZvg4j3fv-0pclx83458Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QLO8cyJI0mr4rFK5pnK9pRK_o8KVPNn0GPyUvXRA-uw&oe=69DE43F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LvJO6opBGkQ7kNvwHRQYRs&_nc_oc=Adql-y1qRuZwR3UV3P48b7MyyqBSD9N93_2Gtl54caTOhmYRAg573FMsIKUskPqf_LI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZHfy_7nKno6nlojC6nv8PLXsBiPMY4l0EgRBUBljuQw&oe=69DE2628"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXnqluEqlU4Q7kNvwEFchUg&_nc_oc=Ado7VsyEuY0wjCjdMZD6ZYO--f6yePk9QwxdAOuCC6YFL0LsdkBiFgH5-lvJKMbsfno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04Rbfq-pJEQ1OwfZ8f8y8kUO8IfqBtNvw-mzpthVKHQw&oe=69DE4701"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHelPYMI-BkQ7kNvwGGAsdX&_nc_oc=AdpbaVumCWyIMgAeJdNVjioTgcGJ8yyxYvD7Go6doMgP1Jjz8kP6MCsLVCKhMMMHVP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_0vjok8gNyA3BtR7sfFJbKukLNXLarBGsPKjh-0fk4g&oe=69DE3CE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4Xfg7mPwPYQ7kNvwGHlXJ8&_nc_oc=Adr4RSI5ZBFKcMIBxC82vDzb6r6P5MMlPwO2z36twih1t4zpjZWW8IXYaI-GT7zwB5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yyYbSnHoUIgjuPrTInK3d6-LfeJycGX8QQwmGA_6w8A&oe=69DE35A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2YMhBTvfWQQ7kNvwF1M5La&_nc_oc=AdqgQ_ikpohrpbxX-D_9kEMJeKJNNgy0qgsZyTznIIxUfr6tiqn9E7DnmS3AJUnNao4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21gHiCxarJm8cjls9Ksx8SxhFFULAg_KqThukN91JR3g&oe=69DE3EDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yey55dtF98QQ7kNvwEeJ8v2&_nc_oc=Adoj-lB2z_o0Pg1rGN7jCc-_-BnMv9rAaDoe-3Q42NQUUzOHgf2grw-caz-q8bnoUGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uWI9OgCG41GhlIL61MIZu2_XpaHIyymx75PfXcf-oIA&oe=69DE27B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO_yLuvjrvkQ7kNvwF8qidQ&_nc_oc=AdoY9v9AAic9Qz0MFLrZ0yuHmW2MIR9s2kCB0xLN7WBpDUwPOOY2o1Esl5gfQLFKrKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cs1mFXuwba0vCs7869po_Xt0maBclLJUWAVqJ_IbGLA&oe=69DE46B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
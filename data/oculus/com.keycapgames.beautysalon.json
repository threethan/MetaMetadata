.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwpsmGP_OuIQ7kNvwFJVsX3&_nc_oc=AdrOU49lELqpRH6QMmjG5VTfiXdUX3LT2s6G2Kfl0lbP_ERWaigEVtUTBE8cvUNsStE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMC7iZ5xC-PLfOOCtye6vv4g0KzZY2qhnBFIcbXaX-4Q&oe=6AA2B378"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln_fR0wpiocQ7kNvwFztieA&_nc_oc=AdradynYWsobBvKZDSC0qaQV41utTNTXWSP2yIV18sP5K6jbNyX4MA1URVxhfJBzAUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2r6Dka1FxOkCrNQmG_jjlAxL-hQUqVaWlbAsHfyd_3g&oe=6AA2CDE8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEBmoU9UTXUQ7kNvwHaBLQT&_nc_oc=AdrK6_U0fhwePqS6Q7TocYDzn4IuE0Yj1dRFRgd-Z3wcxkWgs56Iwpn9hjEs4uhOV-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3aHnUllOoSk-c8hPgF7PBglj4fp0VER3G33_W9qwxpQ&oe=6AA2B681"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHXSQqdsWb4Q7kNvwEAGtKS&_nc_oc=AdpAeYktRF9aMqbfGX2nTeHQYeaVQy6sUdghO4ypUJjuXpDO036OYAxIvGWah5-7In4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdI0dMcHr8-jvOmuYa_MDgdJhtDUIGYcIONo99nD73kA&oe=6AA2AC66"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha-KeWsqMoQQ7kNvwGf-b1y&_nc_oc=AdpxeydV-Sg4EWAwhLT3Rs7k25CiJCJcE6RHr6B13_g6WLmrChyVcdf5ierPlrJRPwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk4EFm42lX58lvmmGv5s3jNDKs76Wf2O3tVGaQFy0Iyg&oe=6AA2A528"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi6SmSsall0Q7kNvwHf4Dar&_nc_oc=AdpvriR_TqS4XHBlNFkjH7NaSrzVAr6H1pgM1KTos7IdbwBPoRxwa7mJ0l2Lt1amwU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp5P5JoimzTXRBfxnLQTaPca4tzUxIuxk0Z3VebOSGRA&oe=6AA2AE5F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLp0WwSXrMQ7kNvwFl7u3p&_nc_oc=Adq2MsZV0SRFrANsdXi2Y_qAg-sHTQyXw_NwmKe1nxT5RK8YfjMjENJOO2nEHap-GUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV0LmsZ6Qf-NwXpOjUESP23s0-AkkzZe5F3lavKiNaMA&oe=6AA2CF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My_LqVs9vpcQ7kNvwFuCuYd&_nc_oc=AdqksrpQ_2o_TQ91-Y34-B1AnhulJ3PSejkwvAGLBgDGoj_eQASsRNqZ1Eu1kTMqBS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGbiBGyGIJPwut_eLYsfQSvugHrw0bPh0hbTZYwK61Kg&oe=6AA2B637"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
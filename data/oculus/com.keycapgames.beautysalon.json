.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwDUhoBu2JQQ7kNvwGUZncj&_nc_oc=Adp-8OMAUue_XcrbGsXVjM4jKNVbURsgMluMRf4EQy_gIS11ocXuiXi-zZkNerVzudQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe4Z271WRP9oTUjgLnRhfUZZb5mK0JK8ie2TZ1qzbx1Q&oe=6A7C77F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkJmhHPaftgQ7kNvwGq9XHv&_nc_oc=AdqxvlrS3prw-EWfe3O-5nc2AQIaTIvmNlXjnfpwybHAvHNLCYNOOXKvyqPOxa66QII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhnKreqg3sL6QWMK7I20H4acsvjkv0clr-sqZwhv8o6Q&oe=6A7C5A28"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGYR6v1FdQQQ7kNvwEyxIpn&_nc_oc=AdoHVW7eLs0-D_QhV4lCwVEXiEaDhTXkOaNSQUF_hhaGrd8gkegd31XQwFd3kTSpvq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsIZF4tYDshTw_RarlyUG7F2zGQfsMfskQITvyMyIGRA&oe=6A7C7B01"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUKvclfgQSwQ7kNvwEPLU7j&_nc_oc=AdpWhMoiY6b--AIMoaFTW7JMJLtYFS-fY4ZNUVIjsPGsIrBuLhT1zYGWB3QzKME1wPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy7Bh9Dwj26kV4fmaAyeYNULH3pogQ70Jrw9bsdnDGNw&oe=6A7C70E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFA4K4dizQ0Q7kNvwHEUkA0&_nc_oc=Adoub4FSjx3fw4s3EQYrw6i4_GlAu1VIo-_DNKGcoNEDRgUUyMT7NWf4eMzndoK2wcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6zXfU4F6a76M-O6jNl-AQvu98a7tGf9UaO7BN7Vtk_Q&oe=6A7C69A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiANWIOLkBQQ7kNvwFnc01X&_nc_oc=AdoIyWRAbNQGLVWmdFA5kSwozlyy4-04exTesUI0z9ddrG0IYT3DrCo9YFgaWSx9Nik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBfcNcsFET9HpaNt16uOXdlZkyleu_OMMMJCZrW0NOEw&oe=6A7C72DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnJwYL9soFsQ7kNvwH8rxqu&_nc_oc=Adp6W5y6BWJw46DhkyNHLb0CQYyJ7Xb0T_FT2NkCzhAjV4iPDAzuBT_cN5WNeyP4yf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8i5xAge0jd4ipSvEXND7BqMB6HQMHK-wNDBRBDiGE6A&oe=6A7C5BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2tnFrlFKhcQ7kNvwGb6gW-&_nc_oc=Ado1l_0_WVfrsR1Gw-CCtjZ4uIdMpqQDJ0pbUR2FjQeXJGmQeqYYR3k7zPYLFvXQQRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVdZa_6VHrSOrJHnTNyYnqCjS8KEGJ2IYdnq6M6Mvr6w&oe=6A7C7AB7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD3htp7qe-cQ7kNvwFiudhe&_nc_oc=AdrP60jWDvejjlecwFuEtBPzy0UPFOt0zKYOnCtnfbDihVJ5qGsGDvqV9PdL40QMsOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYHKVxU1kqxwRavZ3_LL-Hao2spuqLLVB-9gmsVWC6Bg&oe=6A7C4D43"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iGwf90keMcQ7kNvwGzptTk&_nc_oc=Adr3-k0sTp5HAnWWeYAC7IdTq9cwMySQ52YMZosFbl3kP-ZE1P4HtWXnhzWSFfWz7EY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2OjJZQGwzbEe_N9mlhjq_5zDT_rz90rL4rWDfiAAIoA&oe=6A5A22A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcB_6f0XKXcQ7kNvwHWhIti&_nc_oc=AdpwME-HIXR6qxWgEicfUnvcA5dqvRXvRfMv4Tv-NDzGcD_8GZrUjQpR0EktFtTjzJE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH6o9-kMoMy3ozTmCXhEbYgLDaQjN9cLJSA8ebNIpDMg&oe=6A5A2BDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KkYvmcRXIAQ7kNvwHCJI6J&_nc_oc=AdogppGJx9d9-424M_xs-Jg1XBeUcFm7uqepl_eTCvmfIw3uZ6JmhZZbipBKk-03fZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIALGY_GdUsiZd03lwjyovr1gH5HBwYe4oJ-tiKg9H-g&oe=6A5A14B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oqa6rcmosuAQ7kNvwGxKKvt&_nc_oc=Adrb_JsgIy69iCW1ShG2nyTpPDuVJxvz9XpU6ZQr_IzHnqJJmmYZcxaaD81YLgtb_mQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwRAe8FD7DNi5djy8Jj7LOGtgSz66H6hFTAMIAIaHSXw&oe=6A5A33B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=624v_-o6UfsQ7kNvwGCnolj&_nc_oc=AdrsASoQE_y3jN5OQqnvxnOKVz-CMObO-EUfywN6HV2sroYIJ7NO801PWSMRfQ8tU-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4-hoJSW51-yMzsEDhtZjMrQQhuR1QGeftkSFGHa-B5w&oe=6A5A3E83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
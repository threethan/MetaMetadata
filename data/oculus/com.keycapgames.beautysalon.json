.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UBLrsn42OsQ7kNvwFxQTh7&_nc_oc=AdqyYgiAuvB5nwaPNhlYxF8VmRGx4ggcYaAdnXkLnyGUrB3v7eK-WOuY6nKQpwa4oC4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6g-JRk7zZAGINt4IeBUdAdqU5O8Qosz_IAAhjZqmmQg&oe=6A918FF8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c99JO8vlysQ7kNvwEYk5_7&_nc_oc=AdrZu04YFRquZe-9qWDbKAh5p2_ZMy0MipuTdo4mZYI6mF2SOr5mJa5WNrJH5hCNa1Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOOolFfgtZoxDiqf6pDWxo7QEPpApcrVuH-w_7V8jphw&oe=6A917228"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRREVALsRgkQ7kNvwH7K1a9&_nc_oc=Ado_YyzwawxPtVcBApdXjvPi_9sgjVDsI_UPI98yI5KFqNTuxNPCFCNf4ybeSfozFmw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYvPNAuS_XXU7Vyvii7KIefg_eBfDkmQfbPGqHZSwR_A&oe=6A915AC1"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpyrwEGNXl8Q7kNvwEebvqu&_nc_oc=Adq2JuMppr4G2IZS2PKxQU8H35CLmbSIDha-Ag7VsjvRU4SBTnh8c-Ac62XjXRDXZ14&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgZ8DXNpeDP4T4rJnMCQuQdVjGJ2zTyTPH2Z9uySDV5A&oe=6A9188E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHQgh25_oQ8Q7kNvwGoUSfK&_nc_oc=Adow3jGsMPEq_59BvbmoTXvpYqWVgLjUwTXLiTcaO-4M2Ot7MNwNevA8IK3y58RAjnA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZz-0Wu-LsORKw8PxoEsideCajIMlkaextdhwFbvmdIQ&oe=6A9181A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6vfDKpTpHwQ7kNvwESdArN&_nc_oc=Ado8MJIhwJFvsD2zMRJ2pE94WWcxjPa4fXZAQD_vwVPgw_Q5WQNaG67oQNFGXTZkL20&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwHn9oQJNg77VGGoRCaTKn2Lb1dya3Y6E-HzR-WSzYYA&oe=6A918ADF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2VyAMzqm1MQ7kNvwGX-888&_nc_oc=AdowNpljt0BXQfKAIca-K-K9EvHDEB2pU_uCnpVBGx03eAhJdjjA7WXS58SZ1aUNle4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7xwuKaOz-Ik4I0p_jOZUps0a3I2_HuF3VMOVrVPrL8w&oe=6A9173B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFNLg-IfN3QQ7kNvwFMmSyQ&_nc_oc=AdrfQEpVkouv3heiMkSr-EITQj4_7ME-RvyNFNeBfZEst_xDGZsO14HhSupOkZ_KcRU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFOVZ7vA3MLGGsL8QS0p7fzu3RHVuPdMePTg2ZslTZRw&oe=6A915A77"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vUp0W_gtnUQ7kNvwEcD43w&_nc_oc=Adq2hcorEvz3EKyLZ6iKUlzOeRoW6hdYKuWlk7STebqMNnLU8cdYjDDx50FCnDE5jrE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXM8haTu4B2WdwMMe_CsovrwcxUNRx23oZcyMmuDKhpQ&oe=6A916543"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
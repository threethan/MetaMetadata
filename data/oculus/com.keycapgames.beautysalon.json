.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADi9uxQXvNEQ7kNvwEGk-9u&_nc_oc=AdokcBxjL1optpinC34VUcQ0lByYurd8k-UEERHRHerjvWjVZxIjjPQsBikipoP3jXE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fD6ydXe33TwYUJsrJmg4IYF74uCTn9TvwUpNc_StMGA&oe=6A11AE78"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk9-f4iXRO8Q7kNvwEZGFBj&_nc_oc=AdpjoWATrGGWskfmgubJO_KuSQAM7_SDrypVIHlc34aRlUdytCne_c2EsWBc4rdIBog&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Es2oSZzi_Ax5ssYR7ova9YblfZ5s2snK1f_hM2Vi8rQ&oe=6A11C8E8"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObZ_snVsbUkQ7kNvwF30dtx&_nc_oc=AdoDUkgSGM7k5jFHO5b4EnI8nvfckblIdZhaIiHK09GEtIq6XHxlQhNBZH09WbCJfvQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GRyjTCamwmXNibmVPhIAqIVuCTA24YszlzrmzsxOdUw&oe=6A11B181"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yIJ4pYeutgQ7kNvwGuGLP9&_nc_oc=AdqxT4zhgG3O9TOnlxaA76FbWmR-I0h6jgAeQ5f3CGipQXPowfCnLtZV41Gnaro2kmw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cGB7Z6l4GweY_uycftDYx11t40hHsp7BhI70gOspoSA&oe=6A11A766"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wANWCFhI0PMQ7kNvwEyLdAU&_nc_oc=AdrmXWwHF7jH7ssO7gq5d2upgcv2u-vFya4m10USG2AsSwLZpIp-d06fszedOwqnJ94&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TeC_mIAb_y5a27fTyxgk3PTKsnQaLc6p2qvTCPmAuVA&oe=6A11A028"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVq5XhjFKq0Q7kNvwHXGHWA&_nc_oc=AdqfJRhQ9SqY6XR1C44JJsT4k8mkU3YmvnNSqGROa0PxyZTOnKNb5HnyKA6Q6lbPXkM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YAYOz7IAlHjCL3U2_dD6Mp_UEeNBUSVwFshXWuxMDog&oe=6A11A95F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGMdAlETdnkQ7kNvwGDeHV-&_nc_oc=Adpl7_D8Cgq4AzZgAvZhzcUOsv_xQNEP_9rArT_oUeihxWsRu9q7vh8_G7bIfYzbXuM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ww7S5pEvNvmjsBVSFsSgPHSKwFkQUU48nYd2kus2v4w&oe=6A11CA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCUo96pEL9UQ7kNvwGB1STE&_nc_oc=AdoxyFdMI9BhgvnVvJ-dRF6Tu-Y0FzDHy0Fpx-CQ8ndZYeS_ePUbx2JIOUknBEyZQ9M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50O1aoy7Z3FQ3ZBtcxXUWjMiLce5q1WL92cx3Xey0wWA&oe=6A11B137"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "d
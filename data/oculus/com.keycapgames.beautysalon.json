.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ktkp1fs3tOoQ7kNvwEve6HT&_nc_oc=AdqelplxhK5rxgXEPkw2vxi2H6UCChp3N6oD-tBXSb2eU0CKx-bLl_jOjFgHx6mYV5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MZRt1yT7elElkaiKuQenMA2Ud-Kze23ccXvFVU_6BWw&oe=69EB72F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SREZBmHw5IQ7kNvwF0sBE0&_nc_oc=AdpqXNmwEEW0-MXqRjDye0AkUi01JMEviAz0DYFkTD3VdcALDaxXRNFHh8xZloDqB4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I_ehFB7yLhf3pQZjFk_SirzdPvi0RI5cOKYnKh8nvEQ&oe=69EB5528"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_fXdmEo_d4Q7kNvwGmrGIQ&_nc_oc=AdqsdTylHItrvQJhifCmQvrZ6oQ0NuL1rYeFoAGHT8QZD9Y4vlP-EfMMhncD-BZtTqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25ceZikInrarPV2QZJZRiCwnbLyk2XQt_s55Si6Vf2Fw&oe=69EB7601"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWTCj4TktY0Q7kNvwHVOXHT&_nc_oc=AdoB-US119NITKbgyedytJMmad0l7BMWzaQFbqpCE6iRRHj9YK6odpaNXiTqGkHnxoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j5U7qYbQ0Dzin50bznBadv3uXF1dLT68Opk0MnUcMug&oe=69EB6BE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUxLJhta1W0Q7kNvwF1wgJd&_nc_oc=AdrCVZCssHyAa_wQr76JSAkBEv33OKOlveqvV0Im_AjM74cYdWuO4QO2yxnjPxxBVBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LcWDdxWn9QhFSv9HTHWlu4uOU1dzCMrqUNP0HRg0DSQ&oe=69EB64A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRsa2gYT8VEQ7kNvwEavohp&_nc_oc=Adodw8kkVhxGQv1ko5kHmtQeBtrW7XlLlshi1TGGD_TtMtfBfnNawzg8Kyykmou1UMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q9NAbNqVYn0IrH57iOCLz96QYZl1Fg2vrq2P9OC1BDw&oe=69EB6DDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azCv_aIPYPsQ7kNvwFOsVdE&_nc_oc=AdquKtS9Pii4KscGPUxCMHA26pEfOcmKx6L55TYfxFwZdc_X6emKySQ6GNKI1eh4EiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BAIzP9qC0NGDAqBFvpT-YL4HSYE81b5ViVjPh_mEg6A&oe=69EB56B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZVs9dcxeYMQ7kNvwGiqelB&_nc_oc=AdrOoqyQEDqHCOHZ_69pxHR7_AE1Gfp-Q92Xj9dfJpvi_72tTRkDsvBDNONq5CJEpj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D8LdU8OUxOcjLUg-3tvo9OhR0eJsfv-q6T0dU4RbHdQ&oe=69EB75B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
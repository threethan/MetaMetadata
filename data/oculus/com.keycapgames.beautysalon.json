ntent-ord5-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFYf3RJV5MsQ7kNvwGk2r2n&_nc_oc=AdrWXIpKYi04CZr0J85101Ie-qkowovFE1YIhjxRiUWzMIy2n_ZHz0L4zVKrc-hc9HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrv-VxHhgiSA60q7neUBLZ3FG7tzWPCDU3cpdLNE7KsQ&oe=6AEF5468"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFGWbVBpjgEQ7kNvwFgH2f7&_nc_oc=AdrE9JFKM1q-Q_IlFJVdxe8lNIDhJ-cx2FLP46XWhg3ZEQlCRV1YHXhx0zCS6jEv3Co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY3r20QQNxyPZwlRDXXaD9Ufud9_eUB0geJYeqcm0hdQ&oe=6AEF5D9F"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYYnxZiq81QQ7kNvwHkKzMK&_nc_oc=Adr-CLHtB8qqWa-CI_Hi_yFbxzkqpwdPohTqS7kvliPbVkYx6Q0dMjDG3_VhU5BfhVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD0pEJF_QgLYiIQwpX3qlMQDe8v5bDfBElZi3ERHk8CA&oe=6AEF4670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8WO4HoOdYIQ7kNvwHGS3Ga&_nc_oc=AdrhPdY6qX9ivp1jvi08T6UCjFKZ1FbczF-qA7xGVuZduki1VuLxGrv7TXS-YSk8e7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMSq6xlEroUITOhW9fuxJeuBCx36sQonBOYV9OIf511Q&oe=6AEF6577"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-policy-beauty-salon.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24584589331135203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400237_1602278167071662_2557481947675652540_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpUXgQM3M7oQ7kNvwFXuSuT&_nc_oc=AdpHZ3xdJkGdLn6dlgqpX3mKiTb8sU_nK1jJFx1ml_tZ00ttY51SbMFisMmgQu6dufI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD7eHMyMAdRm-ISKi4yfqCgBzDBxHOv1R_0mcR0kwneA&oe=6AEF3803"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beauty Salon Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1738623540, "lastRevision": {"nodes": [{"id": "9277866922234026", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277866888900696", "is_first_party": false, "enables_in_app_ads": false, "is_concept": f
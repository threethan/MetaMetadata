.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsGi8aq0dXMQ7kNvwG-l_5-&_nc_oc=AdpjxES5yVKIRyZqXrMjb1ZwWCDQ32noRaiC3t6y6gloxKeJi4wBC0_gVDTMr7D1wh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-osxYGfMpHXSKxVHrW5A2Yd8IVnPOzWS8iDAJWXCc5aA&oe=6A2ABAF8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlXfn2Nr4LAQ7kNvwEI0Mbe&_nc_oc=Adp9FkIqTIO1x8sBqZCztPwq21GAR9fVO1xEWBlF8X7Hl-wqzFJgHYPK6MnXm-sHvd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--4kefkW4Nf-jjzqVBAj6iqmFsatLR4K8x7SiozEkyNw&oe=6A2AD568"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S-dLyzfaJcQ7kNvwEtmRCm&_nc_oc=Adr_fhRxXqbAjynKOZT_XbWhdOzyFapCVA51nhE97JY_CmVO8UEKSWf1bLrJu2_JB5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98S76FfCaommfsOZ7QsT22EOJPFgYlzK1TgPLX14TWTA&oe=6A2ABE01"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDfs2ocNof0Q7kNvwEd3haK&_nc_oc=AdrN0k_HU7YOHXpwQX4-Qd0P1K1JMe-ZvoafUkbXf2prlQBSTj-YgKqsmICE4nZ772k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wtgXWLf8vkn-nnkpauNaGGJEic8NfahlQgRfj29eImA&oe=6A2AB3E6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYVIROBNBkcQ7kNvwGRG1kn&_nc_oc=AdpWW_JzxlhYpt8vHCRaq4xu7wG_8v_0N0JnBNNni2YtzKlsysRC59eXzgQTD7SwcpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X6wxAYeZIe9n7Sjv-F1AomKtiO27intIFknmY-8vP_Q&oe=6A2AACA8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxuwur-IYhEQ7kNvwHja7fl&_nc_oc=Adqs01It-liDMtkk3YyQ1qROjuMgm8JVZo4qJv3LDPK1fZaIU8sslvthwjeUMnxYZvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Gmfo21Swqa_v54QDtUHnhwk3TqEi3qGSN9VinXRwig&oe=6A2AB5DF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlVhVpYXW7YQ7kNvwEeIQmx&_nc_oc=AdrUCwHGWOg9EFwibmCiq6mAQsfu6SKfJDBuDR0Ge3MnsC8UYqPJLNiquIFbSfmNgkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CQlW8nUqRBvfBBEKkoDQyeruRCtS7XdVJYv-mGVveJw&oe=6A2AD6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie6w9FJDt8UQ7kNvwGMDel-&_nc_oc=Adps2Vu_tFifWJvwFpcXhi8F30FGrfz_6gN_R594Qbo5-Ykpj1cZuTvhPUU6myjzY0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F5Ye7ZW1WxMJxPtJQq-8fnnt-EWPcdh4xp-dsGDeEvQ&oe=6A2ABDB7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
.png", "id": "601163856129974", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392003_601163859463307_2912029382375061944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv4VwKzNuecQ7kNvwHAcNlQ&_nc_oc=AdrgI5E7tJx-A_Of26SZaAt2ow0Tho5hEQatDVgqzpUetpmSV9hUM1t48N_Iku6WJ0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pUto2RrkWs9PxzbYsJri2o3YyErPP3zfDOgi_USH7Cg&oe=6A0873F8"}, {"file_name": "Beauty salon Landscape.png", "id": "598807939682111", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_598807943015444_6165353311321110163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMP38GbJnPkQ7kNvwH-M49V&_nc_oc=AdrKroPtRlvtQDZ9wO39m_KoHj0ojm7C0yoJDcUQEe1yTA3KgxoXe6wQ4rsjnWJFOK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V0U7crOPtcVQTRIuO7dO2UnEuGJAgioyJkrfhIo5Yiw&oe=6A088E68"}]}, "id": "4148856942068344", "locale": "en_US", "screenshots": [{"file_name": "Untitled design - 2025-01-27T010738.614.png", "id": "631361879341242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394043_631361882674575_5739349984879630095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seAuJOZz3koQ7kNvwFzaY_o&_nc_oc=AdqJqONEfIetpoTM9sEqAiYaIhy2BNdCxoDX5BaajHUbqt1IgVFAhuFEq9DzPhR120w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AyiJqyBNd-vhkd_0bMWabAgMvsc_9TPvMUYAhXuZ07Q&oe=6A087701"}, {"file_name": "Untitled design - 2025-01-27T011753.784.png", "id": "487288381069581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_487288384402914_1503056743130149930_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIQNoMjtIooQ7kNvwHLfYY8&_nc_oc=Adow9g3cMzhaQkTR3VEXyV7UYxePkLIKfD5BOLaGxFVSfE5DTNPi-aPcAFNJaXV6VKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tE05xl1Bx7PYaMiSSA3shYSx0kC3Nqft11Yk30gXEbQ&oe=6A086CE6"}, {"file_name": "12.png", "id": "1738699837061898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1738699840395231_7219042639569130772_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEwYdLXtk4IQ7kNvwEuTRir&_nc_oc=AdrUG9JOR9chjk2ktAq6EQL-r5dnPSuN-JLv8GwQCW3KduOjEyC92EDF-26cNmG31rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4opJVAUFrhsVObGYG29NEeuR7Oqeru_at6SdKQxKRcxg&oe=6A0865A8"}, {"file_name": "Untitled design - 2025-01-31T231303.164.png", "id": "943494907976974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_943494914643640_3531812979695030460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlSFQ68aEmcQ7kNvwH67o0i&_nc_oc=AdrOKCE3GJ0pu5ANlLG9RneDGqM5BdzVnc4lsO2t36uRPieCDoJQy7tT3KSOlcHQwBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iDGtvkL2LFylX7yqGLIZ2pVp9zWeprTHqnOwvBLZ6-g&oe=6A086EDF"}, {"file_name": "com.keycapgames.beautysalon-20250126-131127.png", "id": "640972868599630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391902_640972871932963_5436091301397640580_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yP1CTz8M-QQ7kNvwFciIBP&_nc_oc=AdoEeLPtBKArN7eIo7mfx7jIg5nBrSVTzMvk6v3qwRQMqsAhc-ltcpl5b_z6OyJckVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZyEgPqUiloBhRkh_GEgSqvoopwdDO3zl2xOLO04EGqQ&oe=6A088FF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Beauty salon Landscape.png", "id": "1315695026239959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1315695029573292_8593302982734425761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdirMBE5PCoQ7kNvwEzWqSR&_nc_oc=AdpC9W0RurNWDEzvtNi9SD7pNoTFNP812F4Ks-zFrxC689s5Nx-GNlsNaggErCoGaiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59HqQH-i8LcPDMph_2UdwgsGW7kf-ocgoerPyqsGO_Gw&oe=6A0876B7"}, "display_name": "Beauty Salon Simulator VR", "keywords": ["Beauty", "Salon", "Makeup", "Fashion", "Shave"], "long_description": "# \u2728Features **Three** Main Sections\n\n# \ud83d\udc84Makeup Section\ud83d\udd8c\ufe0f\nStep into the role of a **makeup artist**, offering a wide range of **cosmetic services**. From applying **blush, eyeshadow, mascara, glitter and liner** to switching up **hair styles, brows, lashes and eye lenses**\n{9684685488230550}\n\n**coloring** hair lashes and brow, each look is yours to create. Enhance skin with a **scrub and steam** routine, experiment with **artistic markers**. Top it off with **lipstick** classic, glossy, or glitter finishes, and personalize it further with **accessories** like **glasses, lenses, or nose piercings**. Every brushstroke offers a chance to **explore your creativity**.\n\n# \ud83d\udc85 Nails & Pedicure Section \ud83d\udc63\nOffer clients a relaxing **manicure** and **pedicure** service by **filing** and **polishing fingernails** and **toenails**, refreshing their feet with a **scrub brush**. Take it a step further by attaching **stylish nail extensions**, giving each client a personalized look that truly stands out.\n{631906926192569}\n\n\n# \ud83d\udcf8 Photography Section \ud83d\udc57\ncapture your clients' final look by letting them take **stunning photos** with a **virtual camera**, change their outfit for a unique style, and use a **green screen to switch backgrounds**. Adjust **poses and facial expressions** for the perfect shot, then **pin and store** your favorite styles on your wall of fame to celebrate your best creations.\n{552888147793719}\n\n# Early Access\nWe\u2019re planning to continuously enhancing the experience by adding more **customization options**, new **styling tools**, and a wider range of **makeup extensions**. Can't wait to hear your feedback!", "short_description": "Step into the ultimate virtual beauty salon experience! Transform your clients with a variety of makeup, pedicure tools, extensions, accessories and outfits in this creative and relaxing simulation sandbox. Customize every detail of their look, snap stunning photos, and let your imagination shine!"}]}, "develop
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyXmzPKG1qsQ7kNvwGlMZF9&_nc_oc=AdqtW7_J3PSya1kGONNHYSRi5hMINmI0Vm6hph4fV-Wzt04A430TZouJsnZeOUs6XEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTIpWMq_u2jb4bXd6xk86auBNTN1NLYnm3sQ4NlWBoaw&oe=6B104457"}, "display_name": "Pianogram", "keywords": [], "long_description": "Pianogram is an augmented reality application that allows you to visualize notes on top of your piano, providing a visual aid for when to play the keys and accelerating the time it takes to master your favorite songs.\n\nIn this app, you can:\n- Visualize notes on 3D space with augmented reality.\n- Connect the keyboard to the headset and play in practice mode.\n- Upload any MIDI song from the web to play.\n- Change the speed of songs.\n- Create loops for replaying tricky parts of the song.", "short_description": "Pianogram is an augmented reality application that allows you to visualize notes on top of your piano, providing a visual aid for when to play the keys and accelerating the time it takes to master your favorite songs."}]}, "developer_name": "Oscar de Lima Rodriguez", "developer_privacy_policy_url": "https://pianogram.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oscar de Lima Rodriguez", "support_website_url": null, "website_url": "https://pianogram.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "254067
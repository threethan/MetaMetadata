m is an augmented reality application that allows you to visualize notes on top of your piano, providing a visual aid for when to play the keys and accelerating the time it takes to master your favorite songs.\n\nIn this app, you can:\n- Visualize notes on 3D space with augmented reality.\n- Connect the keyboard to the headset and play in practice mode.\n- Upload any MIDI song from the web to play.\n- Change the speed of songs.\n- Create loops for replaying tricky parts of the song.", "short_description": "Pianogram is an augmented reality application that allows you to visualize notes on top of your piano, providing a visual aid for when to play the keys and accelerating the time it takes to master your favorite songs."}]}, "developer_name": "Oscar de Lima Rodriguez", "developer_privacy_policy_url": "https://pianogram.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oscar de Lima Rodriguez", "support_website_url": null, "website_url": "https://pianogram.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25406765262241095"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974482_2880187082115660_6503140359584693202_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKKhaJeTFF0Q7kNvwENkVtz&_nc_oc=AdqTposgORfpw8ME9aoaEQ-y9pfyJSiG7UP4JMuA54cSmzXhC387OXHee-FkKssiu2g
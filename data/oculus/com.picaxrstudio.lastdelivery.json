yPbP9K8Q7kNvwHVamYc&_nc_oc=AdpCBGuBadAC3TrqXRDC2TepwNiSFMV67MnqqgdarBiypQoFEcI4lV5c7OYBDtNlmV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRdFrlJpo-lfTHL9WtI486IsE9S_kDbTUZutQt9sTDng&oe=6B01C3BF"}, "display_name": "Last Delivery", "keywords": ["futuristic", "adventure", "delivery", "story"], "long_description": "You arrive in a futuristic city to visit an old friend, only to discover that he is nowhere to be found. No one seems to know where he went, and there are almost no clues.\n\nTo continue the search, you need money, so you take a job as a courier. By day, you prepare and deliver pizza across the city, meet its residents, and explore its unusual districts. But with every delivery, you get a little closer to uncovering the mystery behind your friend's disappearance.\n\nWhat starts as a simple side job slowly turns into a dangerous journey through a city where the neon streets hide far more than they seem.", "short_description": "You arrive in a futuristic city to visit an old friend, only to find that he has disappeared. To continue the search, you need money \u2014 so you take a job as a courier, delivering pizza across the city and slowly uncovering the mystery behind his disappearance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grigorovalexey.github.io/last-delivery/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pica XR Studio", "support_website_url": null, "website_url": "https://grigorovalexey.github.io/last-delivery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
ppearance.\n\nWhat starts as a simple side job slowly turns into a dangerous journey through a city where the neon streets hide far more than they seem.", "short_description": "You arrive in a futuristic city to visit an old friend, only to find that he has disappeared. To continue the search, you need money \u2014 so you take a job as a courier, delivering pizza across the city and slowly uncovering the mystery behind his disappearance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://grigorovalexey.github.io/last-delivery/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pica XR Studio", "support_website_url": null, "website_url": "https://grigorovalexey.github.io/last-delivery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323307380868572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1614900177025799_7844482969667800155_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JNAFXZfmVYQ7kNvwFn8qJ3&_nc_oc=Adr8HcMfk4n8H4MEgDe_80ZtWRahJWAYjJGLX07nTdGmeuHDSap_A0sR3joMOfi1MbU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnGKEiefiTOOMuk3-HsttZj4BiBFN2XNGGHBhgbzPuzg&oe=6AFB40FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
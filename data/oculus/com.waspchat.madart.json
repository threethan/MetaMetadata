, or even Salvador Dali himself painted it for you! Use this amazing photo enhancer to create a unique masterpiece.\n\nYou'll find more than 20 filters and effects for pictures in MadArt\u2019s art filter library. Aesthetic photo editor MadArt has a great collection of different artistic styles to choose from.\nFind your favorite one!\n\nJust one click and let our AI handle rest of the work for you! Download Now!", "short_description": "MadArt - Quickly Convert Your Regular Photo Into Amazing Artwork With Our Powerful AI"}]}, "developer_name": null, "developer_privacy_policy_url": "https://waspchat.com/madartvr/policy", "developer_terms_of_service_url": null, "publisher_name": "Abhinandan Chakraborty", "support_website_url": null, "website_url": "https://waspchat.com/madart", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669952425179997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035382_758111699418203_361320611689477261_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEni9yOB35wQ7kNvwEEFKgz&_nc_oc=Adp_lyKWLYoCNXNS8I8Cdfl1NEtJj9Ca8Acp7C3hbS-lQeLcc5a3Jlr5IsM8gBPOqCQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kFGhoRjMaW-4Isqibc9ffQ3ab8_zon5UxOkp3Jlr9FA&oe=6A468CC8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
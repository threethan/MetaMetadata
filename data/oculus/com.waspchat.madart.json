s for pictures in MadArt\u2019s art filter library. Aesthetic photo editor MadArt has a great collection of different artistic styles to choose from.\nFind your favorite one!\n\nJust one click and let our AI handle rest of the work for you! Download Now!", "short_description": "MadArt - Quickly Convert Your Regular Photo Into Amazing Artwork With Our Powerful AI"}]}, "developer_name": null, "developer_privacy_policy_url": "https://waspchat.com/madartvr/policy", "developer_terms_of_service_url": null, "publisher_name": "Abhinandan Chakraborty", "support_website_url": null, "website_url": "https://waspchat.com/madart", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "669952425179997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035382_758111699418203_361320611689477261_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgF7gDX18l8Q7kNvwFW0Qf9&_nc_oc=AdoONuJEYd4pYbI4x1sCDdpDA7adGNDbJy1h4Sj2kknzQiQO6P-8dmfCMpF-k2q9Jgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3gvelAHB1YaKAZ1zdFP2t-UXLMAm0sop3rDOeoS9zy7A&oe=69F0A308"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MadArt ", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819
ed to be straightforward: plug & play, immediate response, and a clean environment to test your input and keep practicing.", "short_description": "Piano Prototype is a simple app to test and practice with your MIDI keyboard. Plug in, play notes instantly, and verify your MIDI input in seconds\u2014perfect for quick checks and daily practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitale-duif.nl/privacy/piano-prototype", "developer_terms_of_service_url": null, "publisher_name": "DigitaleDuif", "support_website_url": null, "website_url": "https://digitale-duif.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428220630108335"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1015279707948845"}, {"status": "PUBLISHED", "id": "892104080124360"}]}, "baseline_offer": {"id": "1015279707948845"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786013640, "status": "PUBLISHED", "id": "1015279707948845"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27117856427811415", "version": "0.8"}, "id": "1481938806700826", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__is
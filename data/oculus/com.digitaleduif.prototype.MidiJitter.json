], "long_description": "Piano Prototype is a lightweight, no-nonsense tool for testing and practicing with a MIDI keyboard. Connect your MIDI controller and start playing right away. Whether you\u2019re setting up new gear, troubleshooting your signal, or just want a quick practice session, Piano Prototype helps you focus on playing instead of configuring.\n\nThe app is designed to be straightforward: plug & play, immediate response, and a clean environment to test your input and keep practicing.", "short_description": "Piano Prototype is a simple app to test and practice with your MIDI keyboard. Plug in, play notes instantly, and verify your MIDI input in seconds\u2014perfect for quick checks and daily practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitale-duif.nl/privacy/piano-prototype", "developer_terms_of_service_url": null, "publisher_name": "DigitaleDuif", "support_website_url": null, "website_url": "https://digitale-duif.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428220630108335"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "892104080124360"}]}, "baseline_offer": {"id": "892104080124360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771519080, "status": "PUBLISHED", "id": "892104080124360"}]},
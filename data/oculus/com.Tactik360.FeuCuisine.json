1-7&_nc_sid=6e7a0a&_nc_ohc=XSq1p2LcpbMQ7kNvwELdRn8&_nc_oc=AdpsNKkMyRemwXKyR2daZf1IhCg99cGL-eYq6v6gQTeZLYLo5C0DuVv1GE7dtW9JbKA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yHcjXwGNUcAAkjDNbr-XPfJB-q0MVImdHHmOU-Bt01A&oe=6A1C4F05"}, {"file_name": "Screenshot 4.png", "id": "1307582650911340", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617687_1307582657578006_8310716375044268474_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uZ8otawXRsQ7kNvwHjviMO&_nc_oc=AdprhnQklO3cq1tITdKkwnT3w-xTgiGf7uJhALGf8-ri_4WqWXeQR-Wqo1aY6rxI2DI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qOaDZ58WP6WDvO7welxr3St0pW_W1WI9vWWcNstr_yw&oe=6A1C550A"}, {"file_name": "Screenshot 2.png", "id": "812331301235587", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831580_812331307902253_5657402476208993058_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fbdb9BJb_cQ7kNvwEKoP0L&_nc_oc=AdpGUAuCiYezyCjWpGjXkMTU1aAadIit11pQjaqJJ3N2FrhEYX2N4VEikPR8OjI9ABA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tqKFanLnJj3lPWrJMy6nfNm8gRzmEepB4hXzucylI3g&oe=6A1C2F94"}, {"file_name": "Screenshot 1.png", "id": "1316762516461430", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304229_1316762519794763_8278052543469655791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F235qVk9uekQ7kNvwEzpo__&_nc_oc=AdpY2mtxZbzNC2QbDmBY2ut5tY6WYWBWH2lkdSnmbiLSZ-JDwCv3BySlQM_kLgGRMOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4schqhXWvGXz8H-Jq7d_by_ZDp3M_t24zjTJfrY2CVvg&oe=6A1C5078"}, {"file_name": "Screenshot 3.png", "id": "1519699529472297", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299745_1519699532805630_2939314906525659742_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sonorzvTPAYQ7kNvwFVPk1O&_nc_oc=Adr9I9dzD_0wr1mGIxTmWTgeG_2j-BCtzFF-dAnmko5fKEpmtEBO_BgYKbnMiEZvwhE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sqlnb30TUBa6LTYelVH_U5XXQWZ9tfr-XZ0zRGt5hqg&oe=6A1C3C4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kitchen Fire 360", "keywords": [], "long_description": "Fire prevention has never been this immersive! Our virtual reality application places users in two realistic kitchen fire scenarios: an oil fire on the stove and an oven fire. In each situation, you must react and choose the best way to intervene using the tools available around you.\n\nThe experience highlights the importance of making the right decisions and even lets you test what you should never do\u2014like pouring water on an oil fire. With no real danger, you\u2019ll witness in VR the dramatic consequences of this action, creating both a powerful surprise effect and lasting learning.\n\nEasy to use, engaging, and completely safe, it transforms fire safety awareness into an interactive experience no one will forget.", "short_description": "Two immersive scenarios place you at the heart of a kitchen fire: oil or oven. Make a quick decision with the tools at hand\u2026 even a glass of water. Safely discover the consequences of your choices, including the shock of pouring water on an oil fire, and learn the right reflexes that can save your home and your life. Perfect for fire prevention activities."}, {"images": {"nodes": []}, "id": "1329758465212678", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Feu de cuisson 360", "keywords": [], "long_description": "Pr\u00e9venir les incendies n\u2019a jamais \u00e9t\u00e9 aussi immersif! Notre application de r\u00e9alit\u00e9 virtuelle plonge les citoyens dans deux sc\u00e9narios r\u00e9alistes de feu de cuisson : un feu d\u2019huile sur la cuisini\u00e8re et un feu dans le four. Dans chaque situation, vous devez r\u00e9agir et choisir la meilleure fa\u00e7on d\u2019intervenir avec les outils disponibles autour de vous.\n\nL\u2019exp\u00e9rience met en lumi\u00e8re l\u2019importance de prendre les bonnes d\u00e9cisions et vous permet m\u00eame de tester ce qu\u2019il ne faut surtout pas faire \u2014 comme verser de l\u2019eau sur un feu d\u2019huile. Sans danger r\u00e9el, vous assistez en VR aux cons\u00e9quences impressionnantes de ce geste, ce qui cr\u00e9e un puissant effet de surprise et un apprentissage durable.\n\nSimple \u00e0 utiliser, captivant et s\u00e9curitaire, il transforme la sensibilisation en une exp\u00e9rience interactive que personne n\u2019oublie.", "short_description": "Deux sc\u00e9narios immersifs vous placent au c\u0153ur d\u2019un feu de cuisson : huile ou four. Prenez une d\u00e9cision rapide avec les outils \u00e0 port\u00e9e de main\u2026 m\u00eame un verre d\u2019eau. D\u00e9couvrez sans danger les cons\u00e9quences de vos choix, dont le choc de l\u2019eau sur un feu d\u2019huile, et retenez les bons r\u00e9flexes qui peuvent sauver votre maison et votre vie. Parfait pour des activit\u00e9s de pr\u00e9vention incendie."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24469142342670293"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "328946209452
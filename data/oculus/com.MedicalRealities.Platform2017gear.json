tent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZrgFzDp2hlRl-GNIttPKZ9yIkMau8gs-CLcfEMntlsQ&oe=6B006651"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medical Realities Platform", "keywords": ["medical", "surgery", "training", "education", "health"], "long_description": "Register at www.medicalrealities.com to access the Virtual Reality medical training platform Medical Realities.\n\nWhat is Medical Realities?\nMedical Realities is an award-winning Virtual Reality education platform for medical students, surgical trainees, surgeons, and health care professionals. Our mission is to revolutionize surgical training across the globe. \n\nModules\nThe platform offers a comprehensive collection of surgical operations covering key syllabus material and includes assessment. Each module allows immersive learning with full interactive features including anatomy and pathophysiology.\n\n360\u00b0 Video\nWe have captured high-quality 360\u00b0 video of real operations. Immerse yourself as you learn.\n\nInteractive\nOur content is richly interactive allowing you to test yourself and chart your progress.", "short_description": "Medical Realities is an award-winning education platform for surgical trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.medicalrealities.com/", "developer_terms_of_service_url": "http://www.medicalrealities.com/", "publisher_name": "Medical Realities", "support_website_url": null, "website_url": "http://www.medicalrealities.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB"], "supported_input_devices": ["TOUCHPAD"],
riendly planes. You have unlimited ammo at your disposal so keep your finger the trigger.", "short_description": "As a World War II pilot you have to engage with enemy fighter planes with an intense air to air fight. Select from a variety of World War II planes to fly and different maps. Nicely replicated real cockpits and flight control will give you an amazing flying immersive experience. Good luck!"}]}, "developer_name": "Skippy Apps PTY LTD", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://www.skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25697229863246037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1211814961014394_5827159048633185375_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7gZg3dQUQUQ7kNvwGzyHWt&_nc_oc=AdoAwqPCdXGol0uZMqGi6dejRAEFoVdzQc3S_zG8L_gH1VVFx28CeK3zspRb6T2Ys-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF2KCxmSGXUE19Sh5JZrMpjb1C9YBWIBG_m3wQG0AEvA&oe=6B01E0FE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
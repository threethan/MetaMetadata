ile_name": "Screenshot 6 LOE.png", "id": "2229023690861354", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819396_2229023694194687_335090428864454662_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfWD1gpag8MQ7kNvwGOTJHp&_nc_oc=AdrN2kj2CK0Rt13689ZR1Fo6VnQiz5NbJ3Pe0XUFDRxid_4Z7f7WtkqkR7bqE3cVsDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzEhdbqOpQ0u2c33KWw2-C8LuMpFrU9x03q8YtvY3E5g&oe=6AD3B661"}, {"file_name": "2560l.png", "id": "714670268304054", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300910_714670271637387_9193694070835888451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnfQbeSzub8Q7kNvwHm0myZ&_nc_oc=AdrETOg2n9CFHa02yhuFgKsfATzSGftVYhu1yvK91zEuC5bdXHMBfWKWKgfPHMYdlVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJKQtWzvS5A0pUELoSD5q5xVVZtSudpxSevVqf_wz3KA&oe=6AD3A858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560by1440.png", "id": "1334385538287145", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819476_1334385541620478_3826906618145875518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzrR293pwB4Q7kNvwFdU5Tx&_nc_oc=AdoUjvjsKm5IuisiVUkzScZoVu2k58eT7-J_ejvMvs56QJheZWFMnkbIx0J8n-NiNBw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3znLEoRPYsql-RcCHhxn-mNbQY3k1Ye1RnJnBDMzblQ&oe=6AD3A178"}, "display_name": "Legends Of Escape", "keywords": ["Escape", "Room", "Puzzle"], "long_description": "Test your mind in fully immersive VR ESCAPE ROOM style scenarios.  Defeat the traps of Mad Scientists. Run for your life through the BACKROOMS, or survive nature's fury and crazy hillbillies in the BYEYOU!.  Decode puzzles and traps to become a true Legend Of Escape.\n\nHello Legends!\n\nQuick word from Jamal and Rob:\nWe have spent the last few days identifying some improvements we could make on various aspects of the game and making the changes.  If you are joining at the Early Bird price we thank you for trusting us to continue to make this game as fun as possible with ongoing tweaks and upgrades.  \n\nAs the game expands into multiple scenarios the Price will increase so by joining us now you will receive all future updates at no additional cost.  ", "short_description": "Test your mind in fully immersive VR ESCAPE ROOM style scenarios.  Defeat the traps of Mad Scientists. Run for your life through the BACKROOMS, or survive nature's fury and crazy hillbillies in the BYEYOU!.  Decode puzzles and traps to become a true Legend Of Escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.musicvideotrainingcenter.info/privacy", "developer_terms_of_service_url": null, "publisher_name": "TMVTCi and RCM Media", "support_website_url": "https://www.musicvideotrainingcenter.info/", "website_url": "https://www.musicvideotrainingcenter.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31666278473018164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830032_1280478880218893_4290275741572898519_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwCAIfchm0AQ7kNvwH9BZAi&_nc_oc=AdqbjtcmWEAVPHM7-MVlrH8dzmWr-n6QbbbtkIDjn8QehyVZs9-67UT1pQJ39LZGjQg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=
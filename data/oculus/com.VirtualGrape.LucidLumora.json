_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAyrx4X-MzcQ7kNvwF2sYhj&_nc_oc=AdmKUisXLK-eNC2T0G5q5BHRd9U0G34uOudcSejqDEEZh86TODtuf4et8a1ufVtqBMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWcfRkJZQZI0fpVPXL-rOjyDiuLIJK7CPGQ5QgDESDDA&oe=69A2D0CA"}, "display_name": "Lucid Lumora", "keywords": ["platformer", "Abstract", "Lucid", "lumora", "colorful"], "long_description": "Dive into an immersive VR adventure like no other! This abstract platformer transports you into a kaleidoscope of vibrant realms, each brimming with unique challenges and dynamic environments. Solve intricate puzzles that change with every step, leap across gravity-defying platforms, and dodge ever-evolving obstacles.\n\nWith high-contrast, happy colors and mesmerizing geometric designs, each level offers a feast for the senses while testing your reflexes and problem-solving skills. Whether you're navigating flowing landscapes, leaping over shards, or timing your moves against pulsating patterns, this game keeps you on the edge of reality.\n\nStep into the unknown, master the abstract, and experience the joy of motion in this one-of-a-kind VR platforming adventure!", "short_description": "Embark on a vibrant journey through abstract worlds in this VR platformer! Dodge dynamic obstacles, and navigate surreal landscapes filled with energy and challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2024/12/privacy-policy-for-lucid-lumora.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": n
spwTG1mES36tjRwfUZ-K7ut2FOzeJbnR7e0l7rW5kRwr0YkZelE7STdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6vWmhKSsnE4Wa2BSsuLpDg5W5CjAer6_rTe2NWl4_CA&oe=6B106304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "931629572401286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974681_931629575734619_1033692583919468300_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ElnZCPr-f0Q7kNvwGvBBpW&_nc_oc=AdrOef8v8SHICrRL2p0B8cajQomjes1VcZ9e9VfDkVzN0xb2A2pqI_40zPWYGmwM8_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWezMiTE3Sa95w_RD2N0CZiO4PCG8DtboVFC861hMCrNQ&oe=6B10388A"}, "display_name": "Lucid Lumora", "keywords": ["platformer", "Abstract", "Lucid", "lumora", "colorful"], "long_description": "Dive into an immersive VR adventure like no other! This abstract platformer transports you into a kaleidoscope of vibrant realms, each brimming with unique challenges and dynamic environments. Solve intricate puzzles that change with every step, leap across gravity-defying platforms, and dodge ever-evolving obstacles.\n\nWith high-contrast, happy colors and mesmerizing geometric designs, each level offers a feast for the senses while testing your reflexes and problem-solving skills. Whether you're navigating flowing landscapes, leaping over shards, or timing your moves against pulsating patterns, this game keeps you on the edge of reality.\n\nStep into the unknown, master the abstract, and experience the joy of motion in this one-of-a-kind VR platforming adventure!", "short_description": "Embark on a vibrant journey through abstract worlds in this VR platformer! Dodge dynamic obstacles, and navigate surreal landscapes filled with energy and challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2024/12/privacy-policy-for-lucid-lumora.html", "developer_terms_of_service_url": null, "publisher_name":
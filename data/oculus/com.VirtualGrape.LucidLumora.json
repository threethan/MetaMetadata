culuscdn.com/v/t64.5771-25/86652082_909530037915604_6901801542836554231_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2dtiC-WrGEQ7kNvwGssTmu&_nc_oc=AdrEiUkUy2CKugISMQSnozAB_cHeO195nNbKCTJxlfT52OZ-odJfefDSH8E4ES4zF8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0oFqEfN0wxmMsezinGboSaZCnRJ-fndZJgSp80dHgqgg&oe=69F0C1B4"}, {"file_name": "SS4.png", "id": "460150650471793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_460150653805126_5219058051304768179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a609oMaSJ-IQ7kNvwECo515&_nc_oc=AdrlQdrB_-iioUMqVfci-ggYaZLjQGI3h1B7Zi2KcAutST1Fs7vEiTR863yaVy9KubQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Mu6zyqVgea4PMhb0VMrCDW5eVCjxMhYhURdpBprZW7g&oe=69F0D338"}, {"file_name": "SS6.png", "id": "1846077119469949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_1846077122803282_3360136574038895937_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1XPa7_RS5UQ7kNvwE8F0J1&_nc_oc=Adp62RI7Bd6YSjZcIV6qPr4jfqv8kA5P9lQe3iDNPwVP5Ahzp1NGmwmd8-21f4DIkcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3aUwtmcSCK2vRmnoqulyx8J1Zb2iC0OxQXrJudsT1NGQ&oe=69F0C3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "931629572401286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974681_931629575734619_1033692583919468300_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMwt22O6kzIQ7kNvwG3mSJF&_nc_oc=AdobCYgEBJREfIzjbrO5FP9pLBPb-c8bkL3oK3ws-qOMxh6Tc0NBtxAQSTq_AI3ev_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1f50kJWC6lFRG7Qh5SA7XxwBMQoeG8NSpmxkAHvEhFTA&oe=69F0D18A"}, "display_name": "Lucid Lumora", "keywords": ["platformer", "Abstract", "Lucid", "lumora", "colorful"], "long_description": "Dive into an immersive VR adventure like no other! This abstract platformer transports you into a kaleidoscope of vibrant realms, each brimming with unique challenges and dynamic environments. Solve intricate puzzles that change with every step, leap across gravity-defying platforms, and dodge ever-evolving obstacles.\n\nWith high-contrast, happy colors and mesmerizing geometric designs, each level offers a feast for the senses while testing your reflexes and problem-solving skills. Whether you're navigating flowing landscapes, leaping over shards, or timing your moves against pulsating patterns, this game keeps you on the edge of reality.\n\nStep into the unknown, master the abstract, and experience the joy of motion in this one-of-a-kind VR platforming adventure!", "short_description": "Embark on a vibrant journey through abstract worlds in this VR platformer! Dodge dynamic obstacles, and navigate surreal landscapes filled with energy and challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rajavelusrivishwanath.blogspot.com/2024/12/privacy-policy-for-lucid-lumora.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Grape", "support_website_url": null, "website_url": "https://virtualgrapegroups.wixsite.com/vg33", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9157727620916409"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2112651189143079"}, {"status": "PUBLISHED", "id": "2620237871668091"}, {"status": "PUBLISHED", "id": "172039217866
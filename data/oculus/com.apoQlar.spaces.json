=00_AQFVS9DlSYyDg_L7n5cTCVsuaKfrtFSyoHVRsdssMobv8g&oe=6A82F0D9"}, {"file_name": "or.png", "id": "1394824326001370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313072_1394824329334703_1705896066286149109_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veeD6ixQ3_QQ7kNvwG_Scq2&_nc_oc=Adq4DSF9MwhjBBfKqefyFJW-KyYel4FzhOvw-bkOuHjjedykoqXUw4xF-s-GC8eeAME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyHnFwoSSHpVw-wYpWfqiXP6kGamF93kHfjaeCnAQT0w&oe=6A8316AB"}, {"file_name": "horizon.png", "id": "1579081460308841", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313107_1579081463642174_598684834220144193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJIVnMBm9c8Q7kNvwGBPSjt&_nc_oc=AdpyX881bvzpASVohTIBpGkOpkXc_xSLD3_NauKDdewx2AVAbsjigBV85XtK9dLJjWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7AYaaZtd_GiPdfxku4OReHFIXijM6ruLsSaw774Y4nQ&oe=6A831745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloMedicine\u00ae Spaces 2.0", "keywords": ["medical", "social", "apoqlar", "holomedicine", "spaces"], "long_description": "HoloMedicine\u00ae Spaces 2.0 can simulate a wide range of scenarios, from routine check-ups to emergency surgeries. Medical professionals can practice their skills in a safe and controlled environment, without the risk of harming patients. They can interact with virtual patients, diagnose their conditions, and make treatment decisions based on the information presented to them.\n\nVirtual training rooms also provides a collaborative learning environment where doctors can work together to solve complex medical problems. They can communicate with each other in real-time, share information, and learn from each other's experiences. This collaborative approach helps medical professionals build their skills and knowledge, leading to better patient outcomes.\n\nIn addition to clinical skills, the virtual rooms with various environments can also improve doctors' communication skills. They can practice communicating with patients and their families in a realistic environment, learning how to explain medical conditions, treatment options, and risks in a way that patients can understand. \n\nOverall, the HoloMedicine\u00ae Spaces 2.0 for doctors is an innovative and effective tool that can enhance medical education and training. It provides a safe and controlled environment for medical professionals to practice their skills, collaborate with each other, and improve patient outcomes.", "short_description": "HoloMedicine\u00ae Spaces 2.0 by apoQlar can simulate a wide range of scenarios, from routine check-ups to emergency surgeries. Medical professionals can practice their skills in a safe and controlled environment, without the risk of harming patients. They can interact with virtual patients, diagnose their conditions, and make treatment decisions based on the information presented to them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.apoqlar.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "apoQlar GmbH", "support_website_url": null, "website_url": "https://apoqlar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1228796255027646"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36222345880747213"}, "review_messages": []}]}, "cover_square_image": {"uri":
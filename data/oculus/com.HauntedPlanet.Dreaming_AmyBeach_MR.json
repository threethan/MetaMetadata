dn.com&_nc_ss=7f20f&oh=00_AQRw5J8wmBAPHFDn0A-z-ayVbZ-_AVGa_xoIUQigPvYzfw&oe=6B031C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1345670102989077", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1345670106322410_2365697592768080109_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I-N6rS-wlcQ7kNvwHHSw1I&_nc_oc=AdpzWGFvveBqQw5QZLGNqM_cvxNWsr5cc1cit6nmzh2pwJE23CF3yFk567xHeMibRYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfnK1KSU0xdLkdIPxA3554O74e6WnkHmrbpfGUdmTlig&oe=6B0301F6"}, "display_name": "Dreaming: Amy Beach MR", "keywords": [], "long_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892).", "short_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/amy-beach", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "categ
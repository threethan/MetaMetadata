culuscdn.com/v/t64.5771-25/39031574_755118063082037_6113616444650817911_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1a4LxDf8qkQ7kNvwH_Vxjx&_nc_oc=Adqv1l3Bv9vPfCMJVJAsOfXnRt9GTPskFA5IRaPknhyrJ4wcmalMDtGi_sXEHZeAyzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbSwMn7vvDhfPa2tdgw9nnIYm6s4RZAVbqO-vS3JUqTw&oe=6B046D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1345670102989077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_1345670106322410_2365697592768080109_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PYqjicW59sQ7kNvwEclac8&_nc_oc=AdqjecPqYSQ74EdZeRoG6k8oGJn8gfCQHcmMoTT9D1QwnwLf3oVyj1XO83xW4pIY3_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy7xz1pY3ttu9M1iXJgQmlUYpeYxYb5n5w8ZkANMUc7A&oe=6B045376"}, "display_name": "Dreaming: Amy Beach MR", "keywords": ["Dreaming", "Amy", "Beach", "Haunted", "Planet"], "long_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892).", "short_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/amy-beach", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28888261987485305"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036675_1002603447859303_3056798506632563043_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js5ED2ZUBYcQ7kNvwHXCUBG&_nc_oc=AdqGHqirtjCWKIKdlVBkt9uo3TwWTFoD2SomdUHCQ0JtU9FLQCffgXCMXQ7SHpDjplQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkTCG0L-FOKC9elze2pYiTqlRBuBQlWbFZjMxp3NYeoQ&oe=6B047A4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreaming: Amy Beach MR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1704232023, "lastRevision": {"nodes": [{"id": "9679476088790516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale":
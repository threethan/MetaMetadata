?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_glgSCw1UsQ7kNvwFNluy6&_nc_oc=AdlAcmwdvplbaeVGsXbN88ZVtq3rptyEuViAJvMZ0ilHLvf1vc0Sf8f1XmIg5G8emD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuwFyoP0f3WTKgRj1F0r3na9k22L2Y6Ona2orAUIZVz4w&oe=699ED4B6"}, "display_name": "Dreaming: Amy Beach MR", "keywords": ["Dreaming", "Amy", "Beach", "Haunted", "Planet"], "long_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892).", "short_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/amy-beach", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
culuscdn.com/v/t64.5771-25/39031574_755118063082037_6113616444650817911_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC_5h-W2PxoQ7kNvwHV6eqL&_nc_oc=AdoaiMovXJ-kgOo8CNz1gH6c3_yw4Ohi3WhPggYQlNdKsW8SPceSM9ljne3Xm4cNvvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoiXgnK35wqPzBOs1cypi8eQ8ieHIb3t1PsCYxQhuOXA&oe=6B007916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1345670102989077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_1345670106322410_2365697592768080109_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I-N6rS-wlcQ7kNvwHfu7VG&_nc_oc=AdpuWc42s6vKkT6CSf-vpaGd-V8GGd3Rzq8yL03d_--KX79VYk3WAJw7ECcmnk28XRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQynrXY6XCyswK5k9DZIv-1K25uWVfXEyUdYlbarQM4fQ&oe=6B005EF6"}, "display_name": "Dreaming: Amy Beach MR", "keywords": ["Dreaming", "Amy", "Beach", "Haunted", "Planet"], "long_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892).", "short_description": "\u201cDreaming: Amy Beach MR\u201d is the first in a series of Mixed Reality experiences that explore philosophical concepts related to dreams and dreaming in music, literature and science. It is a short, meditative experience based on a composition by American female composer-synesthete Amy Beach (1867-1944). \u201cYou Speak to Me from the Depth of a Dream\u201d was the quote from Victor Hugo that Amy Beach chose as the epigraph for her composition \u201cDreaming\u201d from Four Sketches Op. 15 N3 (1892)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/amy-beach", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28888261987485305"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036675_1002603447859303_3056798506632563043_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl2icrovJRUQ7kNvwHCT7ux&_nc_oc=Adph6Bv-VJB4xxKxk8nSN_jjT7THfCJKLRWpLo-bSHmC8yOW4dTtZ1lVa7DBYu9bYTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuQIefmQTrtoqTscmIYkbmeH1inFF4MoELJiD6pEV1gg&oe=6B0085CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreaming: Amy Beach MR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1704232023, "lastRevision": {"nodes": [{"id": "9679476088790516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale":
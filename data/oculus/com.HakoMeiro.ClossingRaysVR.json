n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2_AHof9g0EQ7kNvwHoEfhm&_nc_oc=AdnqK_q42KUZnhWHET2Rel4GePeiAekYBfhAf0Bf34E3-Z6Z_alp-YN8a9SoiGX7Cq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUVPMlQcDdnnzW9GU9Y8_1BdP6vc4gkEjiwtYtIlY9QQ&oe=69A2E9DA"}, "display_name": "Rays Floating Maze", "keywords": ["Maze", "Puzzle", "Ray", "Reflect", "Float"], "long_description": "Would you like to solve the maze that floats around you?\nThe biggest feature of VR is that it reproduces a sense of distance close to reality by using binocular parallax.\nIf this feature is incorporated into the game, I think that a game unique to VR can be created.\nIn this game, we will use the intersections of the rays of light emitted from the left and right hands.\nAt that intersection, trace the maze that floats in space.\nWould you like to try your sense of distance?", "short_description": "Would you like to solve the maze that floats around you?\nThe biggest feature of VR is that it reproduces a sense of distance close to reality by using binocular parallax.\nIf this feature is incorporated into the game, I think that a game unique to VR can be created.\nIn this game, we will use the intersections of the rays of light emitted from the left and right hands.\nAt that intersection, trace the maze that floats in space.\nWould you like to try your sense of distance?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze/post/_%E5%88%A9%E7%94%A8%E8%A6%8F%E7%B4%84", "publisher_name": "\u4e09\u6b21\u5143\u8ff7\u8def\u5de5\u623f", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscript
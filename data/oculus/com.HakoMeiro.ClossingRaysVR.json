n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4fw3shV_wAQ7kNvwGGl_PM&_nc_oc=AdnV2oJfeO30cA4OM2YsX7xt-IywSyDrSq3Ihkv4verd6QoQpqC7hKQ8kgMNvVjuxW8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afui-WE3B2GqPl-V0mx6NTTg12id_d51knnMKMVFRyvsWA&oe=69A58CDA"}, "display_name": "Rays Floating Maze", "keywords": ["Maze", "Puzzle", "Ray", "Reflect", "Float"], "long_description": "Would you like to solve the maze that floats around you?\nThe biggest feature of VR is that it reproduces a sense of distance close to reality by using binocular parallax.\nIf this feature is incorporated into the game, I think that a game unique to VR can be created.\nIn this game, we will use the intersections of the rays of light emitted from the left and right hands.\nAt that intersection, trace the maze that floats in space.\nWould you like to try your sense of distance?", "short_description": "Would you like to solve the maze that floats around you?\nThe biggest feature of VR is that it reproduces a sense of distance close to reality by using binocular parallax.\nIf this feature is incorporated into the game, I think that a game unique to VR can be created.\nIn this game, we will use the intersections of the rays of light emitted from the left and right hands.\nAt that intersection, trace the maze that floats in space.\nWould you like to try your sense of distance?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze/post/_%E5%88%A9%E7%94%A8%E8%A6%8F%E7%B4%84", "publisher_name": "\u4e09\u6b21\u5143\u8ff7\u8def\u5de5\u623f", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/raysfloatingmaze", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscript
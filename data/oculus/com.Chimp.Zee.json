FoHYOL&_nc_oc=Adpc_SFSksC7PIW_RNyTKyixTPNzN9sc7rNjlt9bS3PElySzxWyQQPZ3xAyr8r2SvRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKAYVXzLqCBOsIXIbYKSp8wIFGs7Q-kUVAOOJ_EoJzZQ&oe=6A983648"}, {"file_name": "Shiny_Gorillassss.png", "id": "1035017409306453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_1035017412639786_8488208877022903899_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6cPFsOGI8gQ7kNvwEWP4CE&_nc_oc=AdoEEXd9e3T_Zez6k50G9WlRmYKSf9R9IgJAnajIgmvN3Ek61zcZ7LddxLgHhVTY5wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdQKvmegmqw_4iZ0SwsJVS2U-wmzw-LjXpHAtcejPwgw&oe=6A984794"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Taggers", "keywords": ["chimpanzee", "taggers", "tag"], "long_description": "CHIMPANZEE TAGGERS\n\nSwing, run, and scale your way to victory in Chimpanzee Taggers, the ultimate fast-paced physics-based multiplayer tag game! Created by 4ever, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "CHIMPANZEE TAGGERS\n\nSwing, run, and scale your way to victory in Chimpanzee Taggers, the ultimate fast-paced physics-based multiplayer tag game! Created by 4ever, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players."}]}, "developer_name": "Onion", "developer_privacy_policy_url": "https://docs.google.com/document/d/1kXqwtGWBD9fWiW06yY0FcuBgGJd_TOTDV5AA-TJrFNY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Onion", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1V8eTZp7zPJ1Sf_aAXQgh1DtI5fTk_KH0KaAY4bznG38/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252365271298652"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311585_894356947078251_5223645150201175070_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxVx2IGZ-RYQ7kNvwH946MC&_nc_oc=AdrYIj4FtkBLYGZuaAXB3v_Olm_pPRn7c09wfeAPgIXbV9SXFoJ1KY1pJkRtQdsw0-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXGKwmsmMzYtNG7XAP1g8I9LhIKgAhkfbtoPCSxbNI-g&oe=6A9850F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimpanzee Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics
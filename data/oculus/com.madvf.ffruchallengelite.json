dn.com&_nc_ss=7f20f&oh=00_AQQ8HsNudVnL0hGUNrHs3Tljaayha-yQ9C9XSauhbVoCiA&oe=6AFC8121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "853376622811205.png", "id": "1401552418753615", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824292_1401552422086948_294771410787707601_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-y5j9Rj1TcQ7kNvwEbmQwl&_nc_oc=AdoVXIoCQMhwHf4CBoNWC1XZfEaKw94XshTWA3uaETCRfWGErYvOcA2vK-1qqbKH2Gs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn_jHKaFbdPTmQZY7AM6z2XT_vleC6TELgPoLXj1ZHAg&oe=6AFC8202"}, "display_name": "FFRU Challenge LITE", "keywords": ["training", "combat", "fight", "ffru", "mixed"], "long_description": "Every match is a completely unique experience! Enemies spawn randomly in different positions, driven by an AI that decides whether to attack, flee, cast spells, or reposition. No two games are ever the same, and you will definitely break a sweat!\n\nIn just one match, you can experience true combat: throw real punches\u2014the faster your swing, the more damage you deal!\nAlong the way, you can pick up weapons, or charge and cast powerful magic spells.\n\nCan't move around? No problem! You can play seated, moving with the thumbsticks while throwing physical punches or slaps (simply touching the enemy isn't enough to hurt them). Jumping and kicking can be easily done using the controller buttons in this mode.\n\nImportant Calibration Tip:\nWhen entering a scene, remember to stretch your arms forward and press down the thumbsticks to recalibrate your avatar. This calibration will also automatically rescale the enemies to properly match your height.\n\n\n4 different game modes using the main menu checkboxes:\n\nVR Mode: Leave the main \"MR\" checkbox off.\n\nMR Mode: Turn on all 3 checkboxes.\n\nXR Mode: Turn on the \"MR\" and \"Avatar\" checkboxes. The virtual arena disappears, and you fight enemies in your real-world environment using your virtual avatar.\n\nAR Mode: Turn on only the \"MR\" checkbox. The arena and your avatar disappear, letting you fight enemies in reality with your actual hands.\n\n\n5 difficulty levels.\n\n\nFor all other details, please refer to the \"How to Play\" section inside the game!", "short_description": "Every match is unique! Enemies spawn randomly with smart AI. Throw real punches. Experience VR, MR, and more in this intense combat game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fightforresurrection.app/privacy/?platform=metaquest", "developer_terms_of_service_url": null, "publisher_name": "Cecchini Fabio", "support_website_url": "https://www.mad-vf.com/", "website_url": "https://fightforresurrection.app/demorc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1732227521166517"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1584912660092662"}]}, "baseline_offer": {"id": "1584912660092662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790773800, "status": "PUBLISHED", "id": "1584912660092662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1728136371575632", "version": "1.0"}, "id": "1360124549435622", "channel_name": "L
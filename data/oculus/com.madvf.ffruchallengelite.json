_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_WGqZmyeOcQ7kNvwF3Y60w&_nc_oc=AdqZuoGJS8CFuisSJHBBvWKbP9FCJNW0lXdBLKhTK2PwP04ZLfK3ixpU8PPuCh2Uh-4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN2wmx2Mxz0Sv5TsqjTz6x324RuzXKbvGc1jBYMODDSQ&oe=6AFC8F0E"}, {"file_name": "853410135742469.png", "id": "1406101024963999", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823905_1406101028297332_6674833607643407397_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuLdIVonp0gQ7kNvwFzDDlb&_nc_oc=AdqiKIilwyhX5dITvikubrXsv-vZbfjS88EFs6oF_VPKhEn8IsOnVg7p23FKXNs-z98&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGDHcPvz99mvG1ZdNLmU9h_CWFE6s9fHrbbQnI2VCKRA&oe=6AFC689D"}, {"file_name": "853409966437765.png", "id": "1767846427596943", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821796_1767846430930276_4160415717967942672_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfP9RCO5Fz8Q7kNvwF7BFk0&_nc_oc=Adqs50ODdEh2MGiXTeAjBKuQM-Y3UnIfgrx0GgG7Lm7vsfZGJzQWeakQEjBdyL32wAw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpnB9CdJlg7UVO6yBWEhZaOCtIEY5Ho9WyrHf9NEWDGQ&oe=6AFC8069"}, {"file_name": "853410203174469.png", "id": "2966802883653771", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827626_2966802890320437_3652387157353313607_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eVQYtZOH5oQ7kNvwGQHzt4&_nc_oc=Adr0yEhIp2KxjMFViWcvFOGl0tpuUFFxxhsM7ZW1ohwvjbJtCiIXyIQnBNiaPUr2t5w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ04YadlhQ8zowxjPq4phTMP6FNHeLjo_Czh74UFEFXiA&oe=6AFC7BE7"}, {"file_name": "853410097432069.png", "id": "1383232963926442", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827585_1383232967259775_7027805344545421737_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbe3ZqV_oSAQ7kNvwG-yJWJ&_nc_oc=Ado6D_fBeBG3S8PZTOE7g1QZxdlVTMs50PJTkPFlBF0JKwcTuuE7ppBohTNgcNVHobc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8HsNudVnL0hGUNrHs3Tljaayha-yQ9C9XSauhbVoCiA&oe=6AFC8121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "853376622811205.png", "id": "1401552418753615", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824292_1401552422086948_294771410787707601_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-y5j9Rj1TcQ7kNvwEbmQwl&_nc_oc=AdoVXIoCQMhwHf4CBoNWC1XZfEaKw94XshTWA3uaETCRfWGErYvOcA2vK-1qqbKH2Gs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn_jHKaFbdPTmQZY7AM6z2XT_vleC6TELgPoLXj1ZHAg&oe=6AFC8202"}, "display_name": "FFRU Challenge LITE", "keywords": ["training", "combat", "fight", "ffru", "mixed"], "long_description": "Every match is a completely unique experience! Enemies spawn randomly in different positions, driven by an AI that decides whether to attack, flee, cast spells, or reposition. No two games are ever the same, and you will definitely break a sweat!\n\nIn just one match, you can experience true combat: throw real punches\u2014the faster your swing, the more damage you deal!\nAlong the way, you can pick up weapons, or charge and cast powerful magic spells.\n\nCan't move around? No problem! You can play seated, moving with the thumbsticks while throwing physical punches or slaps (simply touching the enemy isn't enough to hurt them). Jumping and kicking can be easily done using the controller buttons in this mode.\n\nImportant Calibration Tip:\nWhen entering a scene, remember to stretch your arms forward and press down the thumbsticks to recalibrate your avatar. This calibration will also automatically rescale the enemies to properly match your height.\n\n\n4 different game modes using the main menu checkboxes:\n\nVR Mode: Leave the main \"MR\" checkbox off.\n\nMR Mode: Turn on all 3 checkboxes.\n\nXR Mode: Turn on the \"MR\" and \"Avatar\" checkboxes. The virtual arena disappears, and you fight enemies in your real-world environment using your virtual avatar.\n\nAR Mode: Turn on only the \"MR\" checkbox. The arena and your avatar disappear, letting you fight enemies in reality with your actual hands.\n\n\n5 difficulty levels.\n\n\nFor all other details, please refer to the \"How to Play\" section inside the game!", "short_description": "Every match is unique! Enemies spawn randomly with smart AI. Throw real punches. Experience VR, MR, and more in this intense combat game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fightforresurrection.app/privacy/?platform=metaquest", "developer_terms_of_service_url": null, "publisher_name": "Cecchini Fabio", "support_website_url": "https://www.mad-vf.com/", "website_url": "https://fightforresurrection.app/demorc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1732227521166517"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_5738175626408592_1613263873011455050_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sJlWF1v_yUQ7kNvwECtqvF&_nc_oc=AdoABSWXtbEGBmBYpIyC0POKOU4coMkhcySZpi1WBJNKOAZ-F8lkC2Yxboky-FoFk5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f2
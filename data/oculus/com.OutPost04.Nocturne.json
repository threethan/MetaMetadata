nw_TzauF_nLcGoQgrBDU01NH4dCzJBwqXyUeCuKc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQW3b-c1-V20DOFQs4H0piBNMv65hfxj0qBypPYgbZrg&oe=6B0B277F"}, {"file_name": "Screen Shot 2021-09-03 at 12.51.17 PM.png", "id": "552156426049238", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404371_552156429382571_7812536757711413272_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT2G3hNVzZgQ7kNvwEyJzym&_nc_oc=AdoIK2wOjJ3nSOqp8HTkRob055jyofd6dm_rFiCPtoFOVM4GZq19wUsWA2zPrcdLg0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-_59wwX0FMLjyD1KVWFYIICX4w0eVnkrVhbzOGw014Q&oe=6B0B14D4"}, {"file_name": "Screen Shot 2021-09-03 at 4.28.38 PM.png", "id": "358146369318936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572934_358146372652269_5732987876579801012_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW-sEPKsVncQ7kNvwEVSduo&_nc_oc=Adprb8dj69Sgyy7IomM00l8xjdHQQxSeKTgWoabI8-hIjSbI_IFLtT4o4jaOwtpolq0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYtU1wsRzVj_OyfkjkAgRIxBB0f7Itv8YcAePkVhWfIA&oe=6B0B260F"}, {"file_name": "Screen Shot 2021-09-03 at 4.33.22 PM.png", "id": "569114160799286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223479_569114164132619_4526970410455479504_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnT_kPgSMAIQ7kNvwFLtTuT&_nc_oc=Adpc-pdTFy6MgsElPBE8eOeAVA6yHtm1ntYFHgZsfDeQjl1REohHaDVUomUFAWu51LY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgZ5YdsrqMrlvtxjUoJDpQBlEedBLGhoib322e9JFp3A&oe=6B0B118A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nocturne", "keywords": [], "long_description": "The magic of making music doesn't require years of practice anymore. Nocturne is a virtual reality music game that allows players to perform a variety of enchanting melodies with the wave of their wand. Inspired by the theremin, Nocturne provides the challenge of rhythm & beat games in Play Along, while encouraging musical expression in Improvise.\n\n\u2022 Play Along: Train your ear with a library of songs from beginner to expert\n\u2022 Improvise: Explore the connection between music and emotion with your own compositions\n\u2022 Voices: Play with different sounds from strings to brass\n\nNocturne makes playing music fun, easy and magical. Start your Nocturne journey with a familiar classical composition, or try something new from the original soundtrack, specially composed to teach you how to play.\n\nJoin us on Discord to stay up to date on new versions, new songs and share your compositions\nhttps://discord.gg/JGTuZcK7au\n\nWe\u2019re still in beta! send us feedback or bug reports @\nhttp://outpost4.net/feedback", "short_description": "Music with the wave of a wand: unlock the magic of music with Nocturne, a virtual instrument with a whimsical interface based around the design patterns of a theremin with the supplementary functionality of an analog synth. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.outpost4.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Outpost4", "support_website_url": null, "website_url": "https://outpost4.net/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "95672159
scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974742_1121736138707856_1564944447042476389_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Smzhd2FlLi0Q7kNvwFVkAhN&_nc_oc=Ado5U2zq7FaWiFJky2CH5Q_-mkrIJUwiWO5Nf5dU3ZVUkIAkkufk-MOyDzq0ol5BkRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnYLyDcwlhaIpBov2YBRuSOUZDjrtqMhW5twqp1FH_AQ&oe=6AFB4A1C"}, "display_name": "Nocturne", "keywords": [], "long_description": "Nocturne is a virtual reality musical instrument which is designed for emotional depth and power. The magic of making music doesn't require years of practice anymore.\n\n\u2022 Create: Explore the connection between music and emotion with your compositions.\n\u2022 Songbook: Train your ear with a library of original songs to play along with, rhythm-game style.\n\u2022 New: Customize the instrument's shape. Play with a linear keyboard, circular or spiral keyboard.\n\u2022 New: Choose from preset sounds, or twist knobs to further customize the built-in voices. Take creative control!\n\u2022 New: Record your creations to lossless audio and overdub them to create songs and soundscapes.", "short_description": "Music with the wave of a wand: unlock the magic of music with Nocturne, a virtual instrument with a whimsical interface based around the design patterns of a theremin with the supplementary functionality of an analog synth. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.outpost4.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Outpost4", "support_website_url": null, "website_url": "https://outpost4.net/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "
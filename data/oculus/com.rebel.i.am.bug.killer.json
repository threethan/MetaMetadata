q0qeoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREaIAwala4_Gx8nRM2Xd0CqaDXHbOYvQjUFMzMnR66QQ&oe=6AFDDDBC"}, {"file_name": "Bug4.png", "id": "1082258324386051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_1082258327719384_2389802132933454696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHvsSKgzzZUQ7kNvwF3Q1jt&_nc_oc=Adq74koTV-LPepnGqoLOPKwRyiB4N_VG2LRcdXJFMDr_9qEiR7_x33IKmDsamLduP6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGoHdi_xdvKaTgz69B5Xzf37rp9uukyRyy4IqxBEf4qA&oe=6AFDB9DA"}, {"file_name": "Bug7.png", "id": "1607058727624609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628092_1607058734291275_9052810569345657569_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UphC-27TQkQ7kNvwHJrP2x&_nc_oc=AdrTlFkcESiKzrlm5HT1u-fa8H0e2kTAxWWi-QEC_-53XV2rqaQo-k-nitdPm3iYmu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0wd8BF3SumRg8j9GOzwjEwP_z0S4Rg9e3HnzClDvu9g&oe=6AFDD273"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Bug Killer", "keywords": ["bug", "fire", "killer", "cockroach", "hunt"], "long_description": "Step into I Am Bug Killer, a chaotic VR bug killer simulator packed with cockroach hunting, pest-control action, funny physics and unpredictable infestations.\n\nBecome a bug killer and hunt cockroaches, roaches and crawling insects across homes, restaurants and other bug-filled environments. Some cockroaches run fast, some jump, some fly, and some split into multiple bugs, turning every infestation into a frantic pest-control challenge.\n\nGrab different bug-killing and exterminator tools including slippers, shoes, newspapers, bug spray, a vacuum and an electric racket. Choose the right equipment, react quickly and clear each area before the bugs escape.\n\nChase fast roaches under furniture, react to flying cockroaches, stop jumping insects and deal with bugs that suddenly multiply. Every level combines VR action, physics-based interaction, bug hunting and fast reactions.\n\nFeatures:\n\u2022 VR bug killer simulator gameplay\n\u2022 Cockroach killer and roach hunting challenges\n\u2022 Fast, jumping and flying cockroaches\n\u2022 Bugs that split into multiple pests\n\u2022 Pest-control and exterminator gameplay\n\u2022 Homes, restaurants and more environments\n\u2022 Bug spray, vacuum and electric racket\n\u2022 Slippers, shoes and newspaper tools\n\u2022 Funny physics and interactive VR action\n\nI Am Bug Killer combines bug hunting, cockroach killing, pest control, exterminator tools and chaotic insect action into a fun VR bug simulator. Find the infestation, grab your equipment and become the ultimate bug killer.", "short_description": "Become the ultimate bug killer in I Am Bug Killer! Hunt fast, flying, jumping and splitting cockroaches across homes, restaurants and more. Grab slippers, shoes, newspapers, bug spray, a vacuum and electric racket to stop every infestation. Chase tricky bugs, defeat cockroaches and master chaotic bug-killing challenges in a fun VR bug killer simulator packed with pest-control action, funny physics and different environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rebelsgamestudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebels Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/rebelsgamestudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
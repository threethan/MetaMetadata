9816776429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgW5tKU0m3cQ7kNvwHO4Lsy&_nc_oc=AdpYwlgUsO4Uqdcsp_-WkluYyNRKCw68xzKoQU0JiztVH87rZ4qoKbjmPxGrNK0wVBs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DKQxgBn12em7Soc94ghgVxFepFK_n2RzElRp8tJ9Pjg&oe=6A243B5A"}, {"file_name": "Image_07.png", "id": "631499246046362", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396247_631499249379695_2524943255012224270_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTpxRXXqY5kQ7kNvwF3qtK9&_nc_oc=Adre4UIusfVNeDsHRmIDeoWCuX8GVyno0ZUoKENOMXXlVZjPXFPSpNbX9EQ1WgycwkU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mY0pFcFO7tS-qCfkodwy8nwQp-MGEox4ntShWv6S4Uw&oe=6A241707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOCI COVER LANDSCAPE_16x9_2560x1440_1png.png", "id": "8810539005741805", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391986_8810539009075138_1779180937678519073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ohTwGDuc_8Q7kNvwGYcA9Z&_nc_oc=AdoQLzeUd2lbwBahfEoxBxUZnDF-KUgTU5ggCsvspRp3EKwDiRRd8HEO88QT11RqHcs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ejVgNqKQwKQl9gZ-gnc7C6KWS_frDn9PxM2DJHb3DPQ&oe=6A242C68"}, "display_name": "Shores of Loci", "keywords": [], "long_description": "**UPDATED**\nShores of Loci has a new chapter: SkyHaven. This update is free for all users. Enjoy a brand new world to explore!\n\nThe Shores of Loci is a single-player narrative puzzle game that can only be experienced in VR. With compelling characters, beautiful cinematic scenes, and surreal worlds, the Shores of Loci will transport you to other dimensions to create visions larger than life. \nIn this multidimensional story, Giants and Villagers alike need your help to reclaim their lands and rebuild their cities. Complete your journey creating a universe where puzzled pieces are assembled and transformed.\n\nFeatures\n\u2022 Intuitive gameplay creates an all-accessible inclusive experience while you travel through the Shores of Loci.\n\u2022 Adventure to fantastic places and find your place in a story larger than life.\n\u2022 Calming audio encourages a relaxed gameplay as you bring your environments to life and help your new friends in The Shores of Loci.\n\u2022 Cities and villages become populated with unique characters as you build out your creations along The Shores of Loci.", "short_description": "Escape the Ordinary, Create the Extraordinary. A Puzzling Adventure by MikeTeevee."}]}, "developer_name": "MikeTeevee", "developer_privacy_policy_url": "https://miketeevee.com/shores-of-loci-privacy-policy-february-2022/#", "developer_terms_of_service_url": null, "publisher_name": "MikeTeevee", "support_website_url": null, "website_url": "https://miketeevee.com/work/the-shores-of-loci/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34890586523919969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392025_3013924878760045_1715415417439156080_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04fcNYZd7wQQ7kNvwG9wtxJ&_nc_oc=Ado2dFDFZsJQWq21raLEKOBBOfWclRqwbxbG1_LllA-9WKr-6_EIKVqIZPmb1Ied-K8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_lR9jJ0HLEBSoya6d
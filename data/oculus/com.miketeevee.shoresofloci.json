ykds76AxvM1Z4UI9BCE2Bp7v4d5UE-RnOg840QLNdUwd2_LCS3bBus3GYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1VLX7Mnv4B2qDNt5R94GqCPPcklgs7Zgl38uDT0HOiQ&oe=6B0B3EF7"}, {"file_name": "Image_06.png", "id": "1334909584299418", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393393_1334909587632751_7057709359816776429_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjdB60fsHMUQ7kNvwH6DuSj&_nc_oc=Adp12DdO2LSPFTMzExhPCsjQLAYEfc8IU_2fNb3xOEZDOIzCIG6VFXj4bQ9MhodGX-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTspN3t-L4Dw12MLIN12d2RJ80iR6pvzwTB2YNGVKP8KA&oe=6B0B2A1A"}, {"file_name": "Image_07.png", "id": "631499246046362", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473396247_631499249379695_2524943255012224270_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gSSyAPKSu4Q7kNvwFK_a8S&_nc_oc=AdqAH4KOF_X0brehQNF7EZ3KTBK0a9xXLgMDtwniMQpMDBR984s5fRbyIvHHlRKoc9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_090pqG44Jz_rJdr_RlCwaMaHKQ8h_dOQ6etqKak8vg&oe=6B0B3E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOCI COVER LANDSCAPE_16x9_2560x1440_1png.png", "id": "8810539005741805", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391986_8810539009075138_1779180937678519073_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbil1pFtrUMQ7kNvwED5cr0&_nc_oc=Adqi3X1ifLZBttJldj-8Q0TBPzZw7KxVZxJkuN9wvTJT3irCV3AsVJQrlYEec9njknc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpA6xXopXdXq7WJjUjSVzX7vmaWFAoh4XUqXX98hvDHQ&oe=6B0B1B28"}, "display_name": "Shores of Loci", "keywords": [], "long_description": "**UPDATED**\nShores of Loci has a new chapter: SkyHaven. This update is free for all users. Enjoy a brand new world to explore!\n\nThe Shores of Loci is a single-player narrative puzzle game that can only be experienced in VR. With compelling characters, beautiful cinematic scenes, and surreal worlds, the Shores of Loci will transport you to other dimensions to create visions larger than life. \nIn this multidimensional story, Giants and Villagers alike need your help to reclaim their lands and rebuild their cities. Complete your journey creating a universe where puzzled pieces are assembled and transformed.\n\nFeatures\n\u2022 Intuitive gameplay creates an all-accessible inclusive experience while you travel through the Shores of Loci.\n\u2022 Adventure to fantastic places and find your place in a story larger than life.\n\u2022 Calming audio encourages a relaxed gameplay as you bring your environments to life and help your new friends in The Shores of Loci.\n\u2022 Cities and villages become populated with unique characters as you build out your creations along The Shores of Loci.", "short_description": "Escape the Ordinary, Create the Extraordinary. A Puzzling Adventure by MikeTeevee."}]}, "developer_name": "MikeTeevee", "developer_privacy_policy_url": "https://miketeevee.com/shores-of-loci-privacy-policy-february-2022/#", "developer_terms_of_service_url": null, "publisher_name": "MikeTeevee", "support_website_url": null, "website_url": "https://miketeevee.com/work/the-shores-of-loci/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "348905865239199
9816776429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMJNbcQ8iIQ7kNvwFGfeLX&_nc_oc=AdpDZ5DKb8ZXEWCJ486V-42ixNmSQWeteHGCmaU_86n2lbFPgkVw6rSczf2DGaMqhRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcfBT1ZXxubJ8bP45GSebuTZnIeUFdK-mM7gjT-lFamg&oe=6A6777DA"}, {"file_name": "Image_07.png", "id": "631499246046362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396247_631499249379695_2524943255012224270_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BKA4WT5ffEQ7kNvwHBzsyg&_nc_oc=Adof3ZMlDvX7ZHUk_4E0hbrwVH7mHCB1JN361qzzFHQnFP11qxkzWZpI9--teSQiDv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsSxEVjV20oBf9qD-ksHCMcR3ftmyw8-OqndTPAtLieQ&oe=6A675387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOCI COVER LANDSCAPE_16x9_2560x1440_1png.png", "id": "8810539005741805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_8810539009075138_1779180937678519073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlPklx6q9oAQ7kNvwHhLJWy&_nc_oc=AdqF5nBVLWEp4WfXoX1MPgTAI1c5SvagFg3oGikp13rNxLzNQxvZDqbAl5zd8JjNPiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIYgZGCENwbj7AF_do6-48q0zPJHNawdqU28qoIpdcVg&oe=6A6768E8"}, "display_name": "Shores of Loci", "keywords": [], "long_description": "**UPDATED**\nShores of Loci has a new chapter: SkyHaven. This update is free for all users. Enjoy a brand new world to explore!\n\nThe Shores of Loci is a single-player narrative puzzle game that can only be experienced in VR. With compelling characters, beautiful cinematic scenes, and surreal worlds, the Shores of Loci will transport you to other dimensions to create visions larger than life. \nIn this multidimensional story, Giants and Villagers alike need your help to reclaim their lands and rebuild their cities. Complete your journey creating a universe where puzzled pieces are assembled and transformed.\n\nFeatures\n\u2022 Intuitive gameplay creates an all-accessible inclusive experience while you travel through the Shores of Loci.\n\u2022 Adventure to fantastic places and find your place in a story larger than life.\n\u2022 Calming audio encourages a relaxed gameplay as you bring your environments to life and help your new friends in The Shores of Loci.\n\u2022 Cities and villages become populated with unique characters as you build out your creations along The Shores of Loci.", "short_description": "Escape the Ordinary, Create the Extraordinary. A Puzzling Adventure by MikeTeevee."}]}, "developer_name": "MikeTeevee", "developer_privacy_policy_url": "https://miketeevee.com/shores-of-loci-privacy-policy-february-2022/#", "developer_terms_of_service_url": null, "publisher_name": "MikeTeevee", "support_website_url": null, "website_url": "https://miketeevee.com/work/the-shores-of-loci/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34890586523919969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_3013924878760045_1715415417439156080_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rv1rZz0IrcQ7kNvwEYVAZN&_nc_oc=AdoHCjYp5TaTO8nRZo2og-zHWIiVstsEhkCfcexqP_75K6lIbnuX9aeG-WKr_eyxqfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa5hjwgaqmvU_6pICn
9816776429_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhz4POcuRdkQ7kNvwGKkYU1&_nc_oc=AdpJL99D5-XpYbGOpZSXwJJIM76AsGS-y5MPvWg7CFDWecyFMYzSWx65KJt3cy8vj5I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F5x_v7cUKDJLoQ9n84pVV-tsS7_CgN29d8bJSNko2zQ&oe=6A09DD5A"}, {"file_name": "Image_07.png", "id": "631499246046362", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473396247_631499249379695_2524943255012224270_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXYriR-tTaQQ7kNvwErYCmA&_nc_oc=AdogKKIJIbSTRg0nMGoskB6THqSXi-jaOcHm6lueXj5T5Zx6JYPQnMVFmYBg9jXEcTY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z3cJTyoR7lI3QXV3wodaWBhIRgd4XF9EbeVSuCRsRpQ&oe=6A09B907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOCI COVER LANDSCAPE_16x9_2560x1440_1png.png", "id": "8810539005741805", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391986_8810539009075138_1779180937678519073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPJHNixWac0Q7kNvwGbazAh&_nc_oc=AdrVjhkRSI0gEFsa6Xswdf33D-XR5rnF0Cg-Cqibo2yPj4LnR-aI3m2RodMw24vR6ck&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60KQhxgbDsVK6GWGP6v1qLlkz1ZNXUk7CXO4hv19DUPg&oe=6A09CE68"}, "display_name": "Shores of Loci", "keywords": [], "long_description": "**UPDATED**\nShores of Loci has a new chapter: SkyHaven. This update is free for all users. Enjoy a brand new world to explore!\n\nThe Shores of Loci is a single-player narrative puzzle game that can only be experienced in VR. With compelling characters, beautiful cinematic scenes, and surreal worlds, the Shores of Loci will transport you to other dimensions to create visions larger than life. \nIn this multidimensional story, Giants and Villagers alike need your help to reclaim their lands and rebuild their cities. Complete your journey creating a universe where puzzled pieces are assembled and transformed.\n\nFeatures\n\u2022 Intuitive gameplay creates an all-accessible inclusive experience while you travel through the Shores of Loci.\n\u2022 Adventure to fantastic places and find your place in a story larger than life.\n\u2022 Calming audio encourages a relaxed gameplay as you bring your environments to life and help your new friends in The Shores of Loci.\n\u2022 Cities and villages become populated with unique characters as you build out your creations along The Shores of Loci.", "short_description": "Escape the Ordinary, Create the Extraordinary. A Puzzling Adventure by MikeTeevee."}]}, "developer_name": "MikeTeevee", "developer_privacy_policy_url": "https://miketeevee.com/shores-of-loci-privacy-policy-february-2022/#", "developer_terms_of_service_url": null, "publisher_name": "MikeTeevee", "support_website_url": null, "website_url": "https://miketeevee.com/work/the-shores-of-loci/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34890586523919969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392025_3013924878760045_1715415417439156080_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkeFsnpbp3oQ7kNvwEkja1a&_nc_oc=AdodbFvU6sIhG_hVPwXxjncKDIZ6c4T6PTHXbjKXuU5VmMN588kkHVwNpWZILSBeyMk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PMO_7DBycVHJMhd-y
_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "1213448525846233", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_1213448529179566_4385881716347353030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_mpgOfe1DUQ7kNvwG3Amj6&_nc_oc=AdndcHUyOdTin59jwfxb5hQej75DBwgoWAv5RncXnOBItbz_LUkpBdIgTB9kA2DbSSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft79A1s0ubhYIng4jtyTXua8am2v_i0FscHi-6e0ajGjg&oe=69A6E72F"}, "display_name": "Shores of Loci", "keywords": [], "long_description": "Join us in our Early Access release of The Shores of Loci! Purchase a copy now to experience the first two chapters at a limited time reduced price.\n\nThe Shores of Loci is a single player narrative puzzle game that can only be experienced in VR. With compelling characters, beautiful cinematic scenes and surreal worlds, the Shores of Loci will transport you to other dimensions to create visions larger than life. \nIn this multidimensional story, Giants and Villagers alike need your help to reclaim their lands and rebuild their cities. Complete your journey creating a universe where puzzled pieces are assembled and transformed.", "short_description": "Escape the Ordinary, Create the Extraordinary. A Puzzling Adventure by MikeTeevee."}]}, "developer_name": "MikeTeevee", "developer_privacy_policy_url": "https://shoresofloci.com/lociprivacypolicy_feb2022/", "developer_terms_of_service_url": null, "publisher_name": "MikeTeevee", "support_website_url": null, "website_url": "https://shoresofloci.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "RELAXATION_MEDITATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "
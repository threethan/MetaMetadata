361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Dy7lojGobUQ7kNvwGMT0Us&_nc_oc=Ado0lNVA8a7KMn6pZaltI0GPfb5172pNGK5FgJ3Q2kZ7aLDHmZmN5uW7ajxSq5dzoNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW-cnpm2hWskhx6sRv45k5rQYBVsraD4cjAcF9m6HL2w&oe=6A9852C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAaOGC-HilYQ7kNvwFm6pG-&_nc_oc=AdotIbuuSkb1w9OvGaqq2ca6YWmemyMErPfgUJ382sttFryjq9O6cTkzMpuLVBwJrXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR0EI7yjcDm09sviFNJoGwDlITJGLUrCy3i8y8-BbUkQ&oe=6A98374C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlCOYSJJ3H8Q7kNvwH7l8AF&_nc_oc=Adog0qfeY1YtJ75Fma5SPbt8Bt9coSSuidzxsw6bzlfwAR-bdpAoDezAjKSGHRbQSmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxplGSGsLV5sM5kC6PeJI9RBn4ueRkEL75yjntgRkPwA&oe=6A984BF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
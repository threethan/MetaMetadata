361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGCRNvJ_z18Q7kNvwHJtl59&_nc_oc=AdoVpUeKqt8mZLVzYIlBKq5DsCQtlyh3J4spvDgrDjRQKg8nXLm_UpDstVovAEojpNg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0NBwWtg6q4n8mWv732hKl0wVFQqchdj1vlBVOWYpyHg&oe=6A918300"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4eoU3oTMl4Q7kNvwFrXSte&_nc_oc=Adp7MSX3UYlvShdrZ_OQ-152xf6NSODkQVGK6eSL4zqoDJXZJfKmKBMVjbVS37vTyY4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm_WXPxjzjYjfuaDWF7lWICS6k9TGnNFYZwYtjc9yJsQ&oe=6A91678C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OW8kICceBiQQ7kNvwGPoEg5&_nc_oc=Adq1ydzVzuWKLrlBVsoX5x2w3C0SL1RMmDuAJz6uI7ioOLQQ1z37BBy09aWtGuJdjQM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL_a0sWg89gHls1F2wrUC1MTLvo2ZrmBUJxB9zqUkpjA&oe=6A917C30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTS07V9mO9UQ7kNvwEnec9v&_nc_oc=AdqHvBCNJSG1cM6OwN5ZmjcP8gVVyim5_oGx99ikisJebVYl9mJg6ahRSpAdXZxu68Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8E0BIflPJoRyR1kYEfyAqYJeCY6KjZ1VoFzBubLd97g&oe=6A8C3D00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJEmdbeZe50Q7kNvwFuiLhF&_nc_oc=AdrZF-Z-fy2T1gWygNeegJ1DOC3mvOGxcnqbSmPbx0Hv9pMfgvoExBZcHzDVNHISy4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqSIY5vduuVAFisXUSB7_0CUPIhJhJauU9vMr3Px9w1w&oe=6A8C218C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKgGNSUMbj4Q7kNvwEncPwJ&_nc_oc=AdoDZi2GsRQk0RcyIsoI5nT9spF9qL-lt0EQ9Mcmzz33FnglZ18knYGbg3I_7ofOEMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVlrw-iMOWRDcwvMD8UJa8nuzCEzm8nseXwikHrPx82A&oe=6A8C3630"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
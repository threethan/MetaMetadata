25361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkN0opzF_y4Q7kNvwHXc0I-&_nc_oc=AdqOvQ1UU9KIRWg_XeITa7yAtRcdlsczJU-xvoKwa5UBsKoixWchLzR6eJYWL-sm2EM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpLSdiLyIdpH9zYIrbRb3vckwpnEsCtA4bbwJHbqLsFQ&oe=6AA93E00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuQJW_WHk6kQ7kNvwGHL7kM&_nc_oc=AdoQOQXKVQ4GJJxCQcpN6QH1RAMNgOs48pqkxR93AOzs7CjrRsKWfDLw6THWdtDqKxw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO4y7mFG1KJSEF45vd42ONJszIBXYzqwec4lqHDCcZDQ&oe=6AA95ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_O_6KbSJe0Q7kNvwFKfQ0Z&_nc_oc=AdoJy0DFCW0OneltiX_atDCbZYtor0Wx8jzCDc-AfrwMB3sRnDnp--WfrCFvjPbgh34&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhp0k3869OBkLCwbplvhepHkFoHzFkJ0SYiHIHaS94dw&oe=6AA93730"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy
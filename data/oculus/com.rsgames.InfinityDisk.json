361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtF2d7Ac-RkQ7kNvwHaJnhE&_nc_oc=Adr52ePqiWD8LccsysjBTiRuVmdMTmcA8CXR92bUo0sKuUqjc6w9TEWe6ZuX7At9Xj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qg9bB9bL2jAS3Twyc9kD9ziE4bJVeiijaW-eoH48aBg&oe=6A16E780"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pY00RKtSSUQ7kNvwFBkfH6&_nc_oc=AdrP4b7LwuCTMWo7jGg2tDit-0DJNbghTH4GBTWg6pd6sItuJIeZnDuGuGeAGypC9qU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yulN0csC7bSG2NXnR3Iq53b0RFQ-6BA_k4S1NdSInaA&oe=6A17044C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s54M0UTDoLkQ7kNvwHIsDNA&_nc_oc=Adp_Ic8xds82r2qFWjpO7B76xJP9N71RgqQvr3CM3u7KvUkfvDW6Pc3AeqaXKTbaA9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Xqezgf7lwbfRQyEdWzKf-wsiz8zQFPCWdGxM9aP5VQ&oe=6A16E0B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
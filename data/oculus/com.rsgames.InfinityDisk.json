361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXXU5tWCIOkQ7kNvwEx6bgy&_nc_oc=Adp776emVTw82mHe-Tt0Dvnk3TYHuPmw4ETnIayh5BYPtfTaFCEAF48pZ_YR38VmhMU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tR_iXxdJ6hneiUG4aETi5dO9MdSZrgF9SSqpnZ5scAg&oe=6A1C2D80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTRVsAOhrRwQ7kNvwHCpigR&_nc_oc=AdoOkYmgjULHha4r88qdCI5hxYdTpe5EcVzb0mMbYHCySeUG8sS9uHW0vAD4VL-nZqM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JBFWEHilHDo61mAzqrUteQNiMaNqyTbi9q2fe8VSgIg&oe=6A1C4A4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCUOdPkrY8MQ7kNvwFG3Jrk&_nc_oc=Adrc9rCKlG8lO60ZYcNUP_hNDD6Fz9ZI_UuX96rRVlW4At_X1AWQmYkZuC1WGya7Xe8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-u4cVHo5U24YYANnvWCRSvAwapkb0BI4xcitT1Yd-ug&oe=6A1C5EF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k_4bbuT6DQQ7kNvwGKIDLT&_nc_oc=AdqCcJuMf1ltnx4WDyn5ytcR5yaK-rUAd6kx4Frlr1nIBmTzAVmTCdcbIo0K6YhZGPs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyrJhOXjRqplQIWZvUz8Xrd4CYSuH_ppq2BZwfSxO4Mw&oe=6AA15500"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XftmaFdkElEQ7kNvwE6gTLT&_nc_oc=AdoaGbzg2YxqPuJLnuJN0HyPDm3KPEUsQHcmT8vjwt4zox4yhgrcSD-tUrwIXkNTSwk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrwFgaB-nN6DmQo2YRx_CdXvkNpeAsVmkXGWrnOhkzkA&oe=6AA171CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPk9FZmE8Y8Q7kNvwGzzfAs&_nc_oc=AdqFq7nNERxSFsdRFl8sFkdlh-KQC-ioDBBa2y262iNrpPYLnm7Pv2_EtV4Z2KFmWEs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-FuYnRQCGLN1pm1s5S_BRX9hSZdWSOvZjfr4R6a2LcA&oe=6AA14E30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
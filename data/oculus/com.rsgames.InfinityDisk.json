361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnp7gADHmkoQ7kNvwGVQ9dN&_nc_oc=Adq2VhkVKF3Y6cia19Ogy6_4COhdu8PRcTIj4plJkYgAwZobfa5761Zi2uTQ2ZUTaU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxeF5K6i2vffN-ba8wM2Emzd-TJwjfijryR3gER4yDXA&oe=6AE5E300"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auxn2wj96kAQ7kNvwG-eGpr&_nc_oc=AdruwtYdLuJMaseh95WiPRPrPlbwGKcKe1C0cgOvLOkoRC-SxevLSgwdZW-SjdYLEVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXJaSJp8HXI-DOu_lfY8ACmvs6Cuk-Z0KyFL0RPdS-tg&oe=6AE5FFCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8tWL_GFPLoQ7kNvwG9xN9e&_nc_oc=Ado5rbPYMg81J_oHdvKOpx5Otl3Aev69FHe72sGrF4NZBUKR_6mlpGWjIQvxWjOLRQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTvYbvgxsMNge98RmTPXeeKhV88ovcS8XQ7sWnXPgjQA&oe=6AE61470"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
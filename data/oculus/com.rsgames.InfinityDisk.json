 environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_url": "https://www.chillspacegames.de/privacy_policy_infinitydisk.html", "developer_terms_of_service_url": null, "publisher_name": "Ralph Schaedler", "support_website_url": "https://www.chillspacegames.de/", "website_url": "https://www.chillspacegames.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26499485909662101"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1949041519332526_1737563644670690660_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtVYFWHGM-YQ7kNvwG0YTm-&_nc_oc=AdrskPDxqw4s2QI64KMVFImebFSdTqu49RHiG8eAUy423VnzEQwzIX1UVbR8rFm_Kwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxU_vHXsrv-biKUd_zf2kujXup9EVc3J0TAhQUYTG6Cw&oe=6AFDCF2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Infinity Disk", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "27765422860
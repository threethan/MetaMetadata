361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Mz-6vrLEUQ7kNvwHPfoou&_nc_oc=Adoqerblk-soiYr8mmsK_Ca9gXkIpl0rMqHUuqrWj3KnJAYAVPOh_FOHahAxE9jTKVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82XMk4S6sTrPyvJL0g4BFJlsXRFUSpA1AIbDVwArEOFA&oe=6A3FC600"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjjghMZhV4Q7kNvwGP6jI_&_nc_oc=Adp3ugQk7NS_M9UVMSKcQndMy5Qvoxja_36AockeJnDJZJFOkT4q8A-WO4kloaAp0fo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_46DJ-nwGchpW83__3tD0EPcBviJ4tMslSFIRUpgYrLw&oe=6A3FE2CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vLh4sm44PkQ7kNvwEH0Xr6&_nc_oc=AdrR0TsqxpwGiAkAtUm1mmsmh5wXtlkw-xZCKkYTqIpQ7tUVRZ78nlVZ-LwpeMr1OdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-msSmdauhxJbOsRlhwmFg6XbYPNofIU4mq2B0KJIF74Q&oe=6A3FBF30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YJTVmhW_aYQ7kNvwEZJTS6&_nc_oc=Adpi-B8_CqTr_EoSVQpEv26rQ0d7xvzJxI6Bmy--a9jKBXW1UxKo1EqNmF7vt2IX8vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6dZ8vKoBh37ZXQepiaEiDWtbvlFameLnh7hGOF0OCLw&oe=6AE09D00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6axG68AwTGoQ7kNvwF8yhT2&_nc_oc=AdpWPtRiZzL4RCwLKynIzh3mAIk99O9S8VZvd6QAlzBk7S3WA379w8PI-ufsehQcnLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv9w5YHht1SEj0v2Jus6YGk4_B6wK_9OYm83NTxsXDyw&oe=6AE0B9CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz0bnAxKvckQ7kNvwGabSg5&_nc_oc=Adp6ICX-VlTOtgPpDHDlkiYCPaAUSUAGUGEanM_SymJQ5lkUUNAXDHj36F1dWPm1OQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmsiLP96D3K-IVkDPSRhWZVBUIur566IlptF-hVK88WQ&oe=6AE09630"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
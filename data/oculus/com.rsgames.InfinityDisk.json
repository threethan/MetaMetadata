999443992925361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGCRNvJ_z18Q7kNvwFZkaQh&_nc_oc=AdpI0cPeVx8KWwyiawvUNWkMrd7MTAmk9F7EFToi_fYX3r21Q5EhctmOPJjJPTBCJus&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJFz_kxcdgGS5ziDyHS7sSEa0v9ki7yLSKTzqieMhaMQ&oe=6A8EE000"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4KcWh8siwAQ7kNvwFj7tvO&_nc_oc=Ado-tYn7sk0gBdofvptvZe5o7mNL22bh9xDfouhMiiks29UBVYMqPVn14mkdyb9Ea2Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtz7rYEJ7BV35Fc3_NwrnHxMWnTPBasAaiHcvxagoEsA&oe=6A8EC48C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKgGNSUMbj4Q7kNvwGOSbGB&_nc_oc=AdrViooNK7rXvPrYAYpqLKHEZ5O-sY1MLrCHFx6rwy-hv4hxpwojjmmIo2D7hexE2uY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbvluCVKs46QUC2LPvyLVG_4QvfS7sY_IFFa2QsE21xQ&oe=6A8ED930"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_priv
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdBLOc9FZpoQ7kNvwGHeFqM&_nc_oc=Adpsi69w3ot0-wlrCna9yiJwXcpyT5BvHsN5_xkdE3jsFqZqLUGNlGlGUsdRZjPGoLc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qHjYeWt6_epFLIUecGNjFiqH8vZ-X-aL8ypsuY4rBPg&oe=6A26B980"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFdojjspCc0Q7kNvwF3iYcC&_nc_oc=Adq0MzNOw7B0r_N_vPbcu_aMLsvEu-q5ibBjIYN5qRSYnfOOroHkbF3ZhYZrP-ASJJ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fiTDD_4BeGlS9ecHo0BnJmly8Za3daHDXGk6J26X3ig&oe=6A26D64C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRLQyznDsQAQ7kNvwEAI2DV&_nc_oc=AdqPl1LxcE3O79TLXLvuTsivarBGfVORpXUbfxUlNm_9o_Qa1lOjH_Ccatu1bL3_P3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A7f3kHURrw2CGNhEm7bfoCDF8szasoVhsi1VSHimKdw&oe=6A26EAF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IBbI0bo0P0Q7kNvwFQb08u&_nc_oc=Adr7q6LRduTr728FV9KQ2ljPR_KOOatwxffu85rTdXR09aWdit6ekV94Ejxf6u5Rtsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvUd7P3QNjCPzj8aEMK9iAnl_N592t3JY-G0UBGDELnA&oe=6AF1F8C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJMEhJkJ0iQQ7kNvwHMehLY&_nc_oc=AdptCSgwqOW7yxe6hQSoXKJ5uIvogCURnQtLC_ILeSBnAo3PLGfIUZ3-emT70_bT7uQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYj7i9iYRmLPkYiIBD_MPARsA3EgAdlsP81y3t1tk5ZQ&oe=6AF1DD4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF4dDeOeODkQ7kNvwHqn7HI&_nc_oc=Ado_jJfXE9Yw3dts4lVV0DwhdBVaFKRg5KfqVnP3tflsKhdA4oisKlBCMmqCTK9qBFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAfxIj_Cw4lOdG9tdlyOzFGNuZ4zLQvN2j-_6k-321Lw&oe=6AF1F1F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
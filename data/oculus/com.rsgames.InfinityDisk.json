361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJSCmly7TkYQ7kNvwEzA_Gn&_nc_oc=Adq1VX2D8WU94CUdIfyOHf8aInH_yxhgGX2K2AJnopUMUKVA4Jc20tVcUTGYhccSpsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwg_T7rVlz79lOHJ4X0cTe0c1s0ffT-TInH9WJ_AU_dw&oe=6A620D00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8iosKS50aUQ7kNvwHO7bsy&_nc_oc=Adr9TJ3iGVcAA54gNkkSSH9tOsyLI227F2LyLzU0SpsaFbBDaQvmh_9WU9RFCsNXH0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_28nMjUkhhToc76sGNrwDTgWNMrnY8ATsaVfSK6lKZg&oe=6A6229CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t94q_wxduqoQ7kNvwE2Ge6a&_nc_oc=AdpzLXjmViqgNvl1em9rp583uTb7z2oEv1vg4JjPg0-0gkTaA9ydTAsu2hFi9lRTLAk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8_svJIOpb1IsiDmNyWGD8xdoPPXnhji6dHAaCkoJ5Jg&oe=6A620630"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXwQ2GWopkEQ7kNvwHOP7Og&_nc_oc=Adq-WkKkXkrFvdMBzK-uBCZTteOMM-mDkyFvaoJlrg-ChxJLs4uLm3-1oST93B6Zdh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBpsTFGu8KcDeA-gKkiKyKbXRFNW5OB3sncft11tx0iA&oe=6AAD3280"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2CSAUoaMkMQ7kNvwGzIexu&_nc_oc=AdpRYQC-4XU1ZT_Iq8jQ5GFmPb1zq-0d5mdb294jy-eC7PL1Q7F6IpShALdUVfrkSOA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-UM4wMYpvWXcYTV358xUZxWgQRLVB-zpTvxljOl7fJA&oe=6AAD4F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjFgZwsPl3kQ7kNvwE7J5JL&_nc_oc=AdroTCckalpCoOebJTxHpMZtghf8gnvXEABl4o03b9zCxemt0ck3v1IgDdUipWfu24U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILjV4X5hIIEMpBZAUvmKOisIWw5F8ETaM0RuxIKFECNQ&oe=6AAD2BB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDE3DtUtWjkQ7kNvwG2wOLa&_nc_oc=AdqyaToiYMY4XI0sR6iYC8c-vVvN6U-TgqPSk78vz8WQcuxBf30elUfV3Yhs0lKRC7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgpqvkuXa7u-GoW6gHn2I2olcw2b-6PvIDhRZ1KmawJQ&oe=6A95AFC0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUk9qPSwBd0Q7kNvwF-yGaf&_nc_oc=Adr1w7BK0BYY2hOopVhSJuC0tXdCh79Uhq9kKCA6rcu0iSHJqZ1LayJod7nwDIfX-CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-zI-UtTrsuCcAB1p2UuhxKXWGoFznlRmHbS593m8evw&oe=6A95CC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbY-Ev8TlysQ7kNvwFFEIsW&_nc_oc=AdoO5lLyeup9QVPKFsgAQVJz7T7L8HRnlbV4hAUtTBiZqiuRFOD4XAQQYYD0BR70eHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoDWv6Ly3h0bCNQtmU2JY65dS_p8XLMyBH8PmtV3T3BA&oe=6A95E130"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
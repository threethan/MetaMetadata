361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXjSwVcfmvMQ7kNvwFtklzi&_nc_oc=AdqpF3sqJLUA_b2X01G0Cw-zkS1iC-iUN7CVuKa2bAYOOh-Xx6LYPMCTMzXFgqckceY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7ylfA-cLnimpDuY3j_jjzaZS9ObFiKtkynf3CeHAUhg&oe=6A4F9800"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrbXPoQRvpcQ7kNvwFD40Tz&_nc_oc=Adp0ajnhp_MezKfcKxFbbWUn9CyFeZg_fIRu5vjSYDzt6VlsUsAUtuiv5HE2QjD7UYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLgCY8YBfQqB4lE2FxQThOsc0i23wwqPKqFqI-m6I1qg&oe=6A4FB4CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWoDXMsD0PIQ7kNvwGSlXNh&_nc_oc=Ado1RWcKfDRr1th0rsyltAZOHYg4JTiOtM565xQAevi4L-Kdl119441IdY7S3j4mGck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChPoHGS1fBess63KAHlk8ggqusP7ATARZGMaAEXH3qxg&oe=6A4F9130"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
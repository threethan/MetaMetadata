361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UWNJhMLPGUQ7kNvwGGg1mt&_nc_oc=AdqgJ0FQ203GWlWqNyp-GYJtIGlCAKlnSQ9QmhkVFo6-DNo4ESuKTjBDvLx7AHXOiQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiWPc7YC-csO-93MOckYAY4GTi5lbXB7YqTR4TJ0BsXQ&oe=6A6C9900"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LfrRRdKCzUQ7kNvwHzbpS-&_nc_oc=Adrsv42ke26HjDopVbZ7eW7f026xXvzpi87X3_DwOWtGN54kw16w1fjtjFwJpbieub8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVQPATpG9AFdCKhNzWQD687HMQyupszK3_ih9rVrCwfg&oe=6A6CB5CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItbhGa06OGwQ7kNvwFW3Kke&_nc_oc=AdpE3vMfdLRvPz0WCdkLtS9h1_qsYwx2HTgOoE1qRwuCLET6E2Fx80btRGkxurOHJAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmD0KcRd95P1kBgNY7IA8YHWtGRTwrJ43iPH03wyt7sA&oe=6A6C9230"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
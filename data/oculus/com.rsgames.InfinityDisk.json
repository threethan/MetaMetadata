361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXb7aQikna8Q7kNvwEAQS1W&_nc_oc=Adq83IDH4Nvu0ERZUsoQ1SoEzk_vFY8sYFoG0_MVk9YlddGvtO-LDCPh00K0bRnEr3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAum936dqs2lOXwm7YV6sE3-ebaBxGvhgnP5l6ybl5JPQ&oe=6A5CC700"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G45F7yCZrDwQ7kNvwHXLmc7&_nc_oc=Adr4sztpiprmTyNsUSdFy4GXOlpekTBW06aSxQFVLodFDvPeEbedZP5wE4f1PzeZg0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzS275QfmQZSI-Zwu5kHC6a21OrBnnPeeqSgSXPL_-lg&oe=6A5CE3CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTfGJV3zsMsQ7kNvwGyLLii&_nc_oc=Adr47x7gnO_3Ob7pf7GDpNX4ZhlX8siQHvQYT_z8uU_ENt-Anx10baTME9xJE6KLfEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGvRqRe2ZvnZ0xPXy-PF6J1JU1YzVr9g1Tkbp2rWeJoQ&oe=6A5CC030"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
25361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_BDFe5we8QQ7kNvwFQ1CZk&_nc_oc=AdpbnRjsEshnsDl_u157to6AnZ0N4fxBRW6ZV8ZSog20PC-EQ8FYkgGRiy0t2MeTjak&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_GrYFJKtC3i9-NK7J9se_2IAvRurJmeFY-EC2prMJDw&oe=6AAE8400"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2CSAUoaMkMQ7kNvwHO4Qrw&_nc_oc=Adr2cKndeVnRhBETvx6SpWNQ8hjOrHdTp3MLB6xyqoVgKuNEDmK5jnw1iiuTlsppqeM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzTlZiIWJ1FxulBgWARHEAqLyolclZX_awERjfNWs10g&oe=6AAEA0CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjFgZwsPl3kQ7kNvwG4seAE&_nc_oc=AdrarDJJO6Gq2XRA-BUwklD7oeMyZPxZusiBG4WHUcVaVKDUnk-DVlmvN8FbVzLuVBs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvaLGTOw1xSRgehu2glURMkwBPDY3zPzQHZxSf8FQjdg&oe=6AAE7D30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H544HYZoeZ8Q7kNvwHae281&_nc_oc=AdqhAmQ1jaP_hsCIG6ekn7PYH5tMgb-G-fdtxq7TKrFOK8L-_7ifVdTwVZnZlQBAhXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wHlFpRcGfIS2YdhfrmJux77UnnxYe_T3KjW-mGdrVuw&oe=6A47AF00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd2rROPRnKAQ7kNvwFq-RZb&_nc_oc=Adptnt2Rwru-9o0fgRAvxscZtJr_4nWhTuDKereYzW-DkE-GptUstlzVEuBReDp1Owk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R_iyFIpr2kK8lIIhq1OpNZnhOwMpYARflN1Xb6mUsDQ&oe=6A47CBCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NUxS6n9710Q7kNvwHvYWul&_nc_oc=Adq6qQE0DEk_lSvRd8ZIG75F3gXh6vcymsalCjNLvvIfGRmwywi_8adFonPa1FfBssk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hdk9x06I-UlLxTG7MzeZW1bxPtQ4SfpounXCtq1E7kQ&oe=6A47E070"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
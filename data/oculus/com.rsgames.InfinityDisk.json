361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u31TstrWIycQ7kNvwEc3WK6&_nc_oc=Adp56eiKpHAmFR3qxVhia1AFfOWAYkOBFJy3U3vriocbTJoxf0N-5TULEkvZo9qxl8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFllGqmopIk5oBf1F1Gq5T7cAyXW0Lua6fZYnZLvCBwMg&oe=6A86F700"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lwLyARzWEQ7kNvwERPCId&_nc_oc=AdoMEWC1t89L0L-oRdfJn2guc_QnPb_FsKWSlakDdEGoTSD1dyyaEn5BzinHBBc-bmk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPb4aVvZV5eKvJwhBZCLDfdIwZy86XNCalkzZS6ovODA&oe=6A86DB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gUvKNwE3nIQ7kNvwHqhBRJ&_nc_oc=Adp-IdCUf5tWbcZiSjockKfxufP0hmGk3tVA1Fbp24zf0h5qJ-AbdIRPblCdynhQxd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr-Owrx97fS6Ucsp2-ytbDKvrjMcIdEB0BkTX_BtFTYw&oe=6A86F030"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
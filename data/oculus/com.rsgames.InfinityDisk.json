361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzyTbkxuMbYQ7kNvwEMsRAq&_nc_oc=AdpRxQWYLHSEOR5BpUw7CFNmMH-YZ9WpeQBGhlTkdglHj04U1ABBhNvGVV7B5l2qrb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB96Lqt-wQw2hdxTjCYWAp3KScYGzip1Rgl4ouC9S-RPw&oe=6A4BA380"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCEYs9E_12sQ7kNvwGXIrC5&_nc_oc=Adrc0Rf1F9AzK67-dmL-YmN5f65sA7p7aEpbGN3arAV06B4pNWqPqa6Amz0YT5SuikI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOpr_6aADariKX2G9Y0vq8PNwC0yu6klT5zlIa_532CA&oe=6A4BC04C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPEf5x12QfQQ7kNvwFHyXSL&_nc_oc=AdqUJ3Wf053p1xDS407ezpa9AifKGDRA_IRnL8-PSdmYyVCi7g1VSsVdrILMZtvxyYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBerpSvET6L4TGqnxPyGGBStsMgeFvhlCepwLfglK4yxw&oe=6A4B9CB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
25361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru5LkNM2xcEQ7kNvwH0hCto&_nc_oc=Adq3iOE2nxJu6BwAzR9E0QLnU4qEjWKHOELmxestqkiqro3tJaC4RDk4rwtbERB1-0w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j0VvQT_QkaEPE7WD8UCZVuMFe2-cqpHUZf-YrJxNmJw&oe=6A36C3C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7lykxQ7AlEQ7kNvwFkRfpk&_nc_oc=AdqbckTYQ5qT2udOts5YqRS9CEi2iszZPl2rnIVGLuwXa2n-34KR1yI5J-JGhew6tJk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fC0QTOBW2Em5r0oAa8FiZF-pbtlvyf-jFSIEMI0lkoA&oe=6A36A84C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW1heaMC518Q7kNvwFhSFxJ&_nc_oc=Adpyyeeb8OWpJ9QX9GAtEH3YWj9KHqxu7IDFruk8Lb5RYo1_QdICVDpZVnroYGzQmNw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NUvAt4YhhsU8T3BpIMtjK2NLGvCn38TgqYlDnhiH_yQ&oe=6A36BCF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy
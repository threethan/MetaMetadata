361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H544HYZoeZ8Q7kNvwGvSYsN&_nc_oc=Adqx-MX9zmFsnjZ4frC1jGpD_NCx6oMZ3PZtkOeKa0DmGPXzWDL1lRRjLKUR24Xm6gM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAibpRaLWxpxpRSBs9gSyQEMx8MYOQ_aitlF7r8Ot4_jQ&oe=6A490080"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd2rROPRnKAQ7kNvwGZFj1E&_nc_oc=AdpM-T9jKw5jt1JVY_cWLGSnkUoMcV_UYMM5PtPIboAjlF3XPtBRShMEbCcHJHgHeqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKcyb6t_c_WpeePM68NGEl9H9nKz4ZohyR3iakbzueXw&oe=6A491D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPEf5x12QfQQ7kNvwEmp98Q&_nc_oc=Adqrx4D8zkDiqFpJgYzQSZxe--foU-AfgSBhP4AwSFUsXym9E5dish_okxwQYF2EmU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0FILHdF4w7NLBAy6FW4RDh8l7y0DB4XZuQ47ye8hHDw&oe=6A48F9B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
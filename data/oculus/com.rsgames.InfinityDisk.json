361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0_SQtZebeMQ7kNvwGkZMiJ&_nc_oc=AdqQcA8J-MKUtJkqHUMoFd0HUX3gf8p08RmPuk-z2sXjmJ89SOXccm7Eo-Rj8FCkg-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeoQnKXnoBOnVvl2iqhdEaRXjmirrP4cPhoS3JwtT44A&oe=6A830280"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXzlozCsMfwQ7kNvwGdYABr&_nc_oc=AdpQve7a-Vf-te7ST6fld3HU7HiR287sSXjwca02XXBC6nH4i-XUlfNTLUKSUzHLbyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXXzq82qilq-0LaAtt0BdLpKgV0g0ghKVfq65Ike7mpQ&oe=6A82E70C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9KveDtG_joQ7kNvwHKvdt7&_nc_oc=Adr_7AzO3bfwu_iMnJqBRTM6tR8CYPBUJGt_GLBJsBzyCNtODzEEcGAVuirIcFk65wM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRJFiiGf-UnGC61u2Ar43Il07_Rw7iNQyPw9zNx6_bZg&oe=6A82FBB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
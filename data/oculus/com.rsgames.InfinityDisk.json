361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCTshibthS4Q7kNvwGmKikT&_nc_oc=AdoOXs8pUNzwkxjINKWlcM9X_5qXHrn1lS7fj7k0JrzcMvkEMO3VJ2EaVMHozR8mfK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iuQGvQqz-bneSibCmg28kUKrX8p5Za22AP-POC8Gnnw&oe=6A202200"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpLI4TgOT6wQ7kNvwGp4k2m&_nc_oc=AdrBowMrhNbqx6y2P3ln9dxYh-EB4UZVUZepCv50C09bpMaox8rRs7AH4_vXbNSRn00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B_ozd_LJqKQA2ppr8Tmt9dYzR2n3P3d6khi8NyhVmFg&oe=6A203ECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAMDa_LH8uoQ7kNvwGEZzyB&_nc_oc=AdoUtnFeUr-TE5bIADwvq__YRmO9CLG9Jk4PlsHo7EXKtyWIHSwDqr2pjkIboxhCDFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BBw2CXmTqn9HLDQ0dmjUYUJvyXT8tgQYw--3i7WgIxw&oe=6A201B30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
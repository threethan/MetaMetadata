361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVcWzlVSoGYQ7kNvwG7eUha&_nc_oc=Adp4Rd6YTYsAyIMXrYb-usoDSTYx2bteN5ENEzCZjdglHFSz9P64WByO87fYOqrCjVw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_R7-LbjUn-M9L-U85uGLH1ArdW3RNOmdfx77lTerU1g&oe=6AC91A40"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrLFczUWHt4Q7kNvwFyXbPN&_nc_oc=AdprqMwVOzlLt2_rUnuyRVa857sKTqAGu0YPFFNehJwgewmnb2ybsQnoW5330l9mTXE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS4JztA_4sOcNzfQ3l0mKbeYWza38X6UNSs1SpvuDJLA&oe=6AC8FECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_vvv9Jf9BAQ7kNvwHa2b9q&_nc_oc=AdpYV4K73Ex9idolAM9ykhl5_xv7iSVEZvqk6G_660WoDyDsRgoo3IqrsR86UDQQtIQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD-DMjyfdUAxMJwcgRtkOROxMwGrsIREDq5vUnkYP_Cw&oe=6AC91370"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
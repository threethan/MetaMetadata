361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWtQpj0NwJkQ7kNvwHE8W_M&_nc_oc=AdqaLy4QPHZUPr53HRRTN4pSJUNdD8CwNlxbuhBRtYcOEqCksjAZUb3Vtv3kz9i95iM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qb17yoBG_KGyeXNWbXQA2H88mV7ToI-c-RhlCqsKcLw&oe=6A183900"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pY00RKtSSUQ7kNvwGVF-1Q&_nc_oc=AdoS4YmgivPk4Lo8_uU-f4dwHSJML4yuIa6qJMmxYWti_XwypDzEkiF9DUVQChAKgNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FjU_GiDMm5bfpyeXDcFJNnWOHqPil7Sv01WTK-Wc3yg&oe=6A1855CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s54M0UTDoLkQ7kNvwEwh-Sh&_nc_oc=Adoj7w4mu6EwvL409GHWAi3EPJl0i8VKi3GstC0JNi7VEApHUP8CR6pWPYM6HAyIESI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pVAp_Xn2U6dGgidnstAR2nOp6hsB8o-9YareuL4O5og&oe=6A183230"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
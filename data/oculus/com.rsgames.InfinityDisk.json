361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVz3T1oILYsQ7kNvwFf4Sb9&_nc_oc=AdoSRq8ywu7JNPW1NRSExUM6iZBvF66wpTMJp0JaRoa-zEAL2c-V_BZWk-BdMtFhjpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNOgZhAX1T1IDkyZYSGJCVWMcz1tkPrFJ5R1YdkgdpwQ&oe=6AA54980"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYVYOlZihXQQ7kNvwE6jhlT&_nc_oc=AdpNCi7y6Fc8Nt_jE4iHQymvbQJ1VLX4wUBy_fRwYDP-6jdw8ZwH6NzS4gRWRLqXt5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImCvCkEc2yazb2fVPqyJTIdcE5X2_gVZuhIruPe4eybQ&oe=6AA5664C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97KkuznNwjAQ7kNvwFJhE-b&_nc_oc=Adpp8CllOJsQXcTZtS_o7mB2qAvN2Za4H6uJwPCq5g3i8bZTWtNtiwsww9P4pTk0sw4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR4U6EVA1Hvr207ZtRGqqgtk0tIB2ZRbBsFxoP5ochcA&oe=6AA542B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
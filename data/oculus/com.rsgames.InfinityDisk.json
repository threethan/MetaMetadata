361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YkwUz04G78Q7kNvwGKsDXx&_nc_oc=AdppBkmhkPBQaQdL6lS2Gqr883hgmsY224qDjkGwlAbmNL7Bu-C6B1OXlgJ9DcAyBQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RX9lkbiiLaaDQUzrriutzEg_zEw1Ji_65pDZ8ELz0Ew&oe=6A3EACC0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjjghMZhV4Q7kNvwEJvXC2&_nc_oc=Adr5wOSlJBC8df0Z5g3DItxdPoYvacgL4_-1bufJ5HQK8pkRityPDaXQZM0c_aXoXQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rWLVuPB0-FK5xF1-1_T5g0w1WfQgDJhyBG_wnwNSsJg&oe=6A3E914C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vLh4sm44PkQ7kNvwGld_Pu&_nc_oc=AdqJKs4DT4XKTx2ww3mUmI8nze-JMP48p2xLZgQrC3bBvcl9U9o6ZfXhnSIA1O3RFzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80mpFPx0wSul4joRX-yufiLzLu2ytwDgcZWP7G_-v8uw&oe=6A3EA5F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2febomLrwVYQ7kNvwF8aW9R&_nc_oc=AdrUP4QTAjoQi74FDI_nkouP0OzzfWp_hrjbkShgMmfOFYELC9zJusbINMClCdsrcj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvr9A-XvknzRrLY5a52VlCnFMDBfL8R5Ynpfp7RIBJdA&oe=6A7F0E00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_dKoPwtlw8Q7kNvwHhd0oE&_nc_oc=AdrGilN3chC7NYI2uxPtXMyy1KqxGeeK65FjxnY_UkzT8wdrAf8oh70rYcI9CvfeUh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrks01H3IaADbN1r4u8c6FUNzpqeylM6_o6T1m_tCcuQ&oe=6A7EF28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pCJUAkZGp8Q7kNvwFPaoGG&_nc_oc=AdotorH5_z8us0xF9b3Gt6Z2UoVzNF1A9_h3dLVwlr4St7DxcLslyAjQQNhzxlNjWjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVGrEc2SZowpo9pZoMGDjk1O0USvi0InTraAHaa6XQeA&oe=6A7F0730"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
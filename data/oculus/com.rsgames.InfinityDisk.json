361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5P0GwKr148Q7kNvwFug56w&_nc_oc=AdpPK04SsRiM11I5vaPNHE0Vpp7G1RkQJYiql_javNwn9GTRTMZL8tOcM5ga3zCCxSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzZ-6s75CHPTFObe92vyBw_wu7tkAr_E4IVyy3KwQSRA&oe=6A64B000"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8iosKS50aUQ7kNvwHYLTzi&_nc_oc=AdqJ4F1KoEzwbtDGPJ7__w7L3DniFgAkrCRSIGyMIZo3Vj_s2z3j2KAFpzJxdqhayCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC_YD8FDUOWGvBZXzSCs4dlUretOVtlO-Xs1kH4QQOMA&oe=6A64CCCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocmz2VAEZQgQ7kNvwFh7rT6&_nc_oc=Ado1D5v6zLY3YCPQGe4IQ73FKsp6zDyXUYSpWP4f7Qx1-eNE6lZ_pYHsKLPtFwBoeTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtsBEg1HfPpW5qKeqsIMUOVie2eChg4eBnxARbAxhf4w&oe=6A64A930"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k_4bbuT6DQQ7kNvwEJrmiQ&_nc_oc=AdpmM1alfWWEFujryTRqTxYqWv0Bw8FSNPhWUSp6H12J5NBFSK-rerj4WPXz6Rxse5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeYPed-crL-3J3Vj_PRqVb1oMqaIAYWf_a2Ezn6g5Nhw&oe=6A9EB200"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK7263Sc9E4Q7kNvwF-Bam9&_nc_oc=AdqIzBDadGXVzLXN9rlDf_Y9rP6scd4bOyv2R9QXwUMjHcOFDqazVXAwd2GIlWgQymU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQpOSZoEpKzZFT5KGTTojAZ_Ztlex2UPCZqVLoEoV0dA&oe=6A9ECECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xiB-Ir_fP8Q7kNvwHD8Dhz&_nc_oc=AdrgOMYPDC0O8rplIdMM-6KupwdB2Fc7bxRjcYYiEpqEzV1oRoTWU834sc6RPiH7VHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK1h6fX1g9uEntp14QBmULfztAdwmwxI727SIxrNtB3A&oe=6A9EE370"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
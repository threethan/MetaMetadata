361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6BAzPQU6fkQ7kNvwGk5pbw&_nc_oc=AdqJtRIiImh9E5GuaRhQYWs7HaBnG3d0OUAY5oNvLz9jVLMJqBQPL8QNMJZJZKv3Atc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rewZfaLItm_HJVdlWZcVmLQYtKdxFp4HMm6y_k3W49g&oe=6A05C400"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn7bVku-jdkQ7kNvwHOTCVA&_nc_oc=AdoKSMSy1-dQFfC4KCF128kw3zlQdA81XMGgmiUS0VPoejx-tGEpcb-zTCknCs--12w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OL86eKgx8U30p_KBG7DL80wmWqk72Y8LmWUZGp-2CKg&oe=6A05E0CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4kkxdqnlK8Q7kNvwEo-t-M&_nc_oc=Adqg8FMncObErZZRBYL0EQVwcJdH5A68a9IDNPEVXQ_THCY_ObVBNph85WXTeliOtbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T_pDSCglNssRusDgmTdvhM_5jA7rkNqrgGbDi58WNEQ&oe=6A05BD30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
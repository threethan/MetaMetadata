361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLHOlF1DySUQ7kNvwEiuS1M&_nc_oc=Adqa1U1yBuN8wOEA_3iP6I_SNKsFTuWVmAK97c9OPnYaz0LD8BtVp3xhvJiix-O7LWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQqzBLUCw2_DnkDU7masNfl7ayRmUmvdLj80nz3Vg4ag&oe=6A9AF5C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAaOGC-HilYQ7kNvwFcbg3o&_nc_oc=AdpI1KxK1A0_ydsTvYoJlC52J2p4NUOlzUieNfJ7O46CPQ8OZjl3Z3MVKgHQci249Hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq261_p86N5hsRJqaMpibb8aOqeonRbbqc9PvHsvFccg&oe=6A9ADA4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlCOYSJJ3H8Q7kNvwHKI1TU&_nc_oc=AdrDM9GS3F-jriMvh4Fav5fc2nlprpiooPw_Pw57-8897GOPpLJX2Ee-KG4vrvoq3rI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBsdldEGY9fp4TQYV1Rp-ZBdXvPngfJsXBTXFzXVegqg&oe=6A9AEEF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
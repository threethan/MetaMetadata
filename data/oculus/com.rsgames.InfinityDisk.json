361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDZY4_b1AdYQ7kNvwFBWyDU&_nc_oc=AdquMVPF7ITs5c9MNrcTDJbZrn1D4i0FaGVysDLZkfPg-dzbOHMlVg1Z9-1FyYTzgP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUSBbQPaOdeJX0pW9F8TzW59aE0a9p1EzN2OLCyte7oQ&oe=6A748200"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f6ZtbW2B_0Q7kNvwH3zqQh&_nc_oc=AdqWgT9KHZYQs7NJ5F196Rsk4yhTVvlyhAe3ZLQcDcWlJBygdTg1GzCEt9tq7-GvB-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj1wbi0LmuVZ5osEwK5Wrj_-DJekXOd7hoqBbkW71COQ&oe=6A749ECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMAUYeyVNYAQ7kNvwFt9oHh&_nc_oc=AdqISjTtJLfvB-cN3-hmnWNUxpdtc3OI0w5q4_pnxTGEKVM-DCboOf3n1O3ScrRP7_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlprPq5feqeXA63ltaOTH-g7LNrHMUNRDJzziubCqUNA&oe=6A747B30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
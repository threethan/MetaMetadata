361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdKii2X_iyYQ7kNvwGBX7VW&_nc_oc=AdrsgaOMoM8AdlYl7w-lHwigsgmP4lo3REFLdWlwHJwjWg2Pk-cvWx2P9YEXkAXuLTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWUDx_iQ77X_FndJsktINuArbIZnQ0__huGpji3OO0kQ&oe=6ABD0480"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUxG6UyaiOEQ7kNvwGjFBp3&_nc_oc=AdqtrXVBv_MHS6GU_AEueX9WzUGXthRlfQwMnEestWASk_6StRFbTwnP_2GRlQVHWT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTLQ5K4pOcumh4y7qbIzxHtmiAYWYqoQR4N2SJ3VLbLA&oe=6ABD214C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ-EISkt06cQ7kNvwE8lSEW&_nc_oc=AdrThRXKDWYxjGMldsfYYizzWwY4-Qro2Oc_NYKSX693EgzXCsUBFk3_FzPvFdciCco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0EGh4NGHeXfN_zdmMpSX51jStnj2VZ1LbGYuzJDwIjw&oe=6ABD35F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
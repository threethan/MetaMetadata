361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VseCChnjncQ7kNvwG1j0JC&_nc_oc=AdpTcGidprpw2ZycB7vO26h8A05TAZS07LkCwopvUCDr1uCQfKIKJN9ARsHYyDpUwIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9oh7gCZdxmxnc0tg7QgKGDBvRSpSwq8v1aaeeHsyZig&oe=6A578100"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkpdwGgc6_YQ7kNvwFMQgEv&_nc_oc=AdoSES4JHCi_TMQM2_NFWf_qeGFT6RlQtGihPt8ZkIyomHnolxudRmeGjmVkhEzWKoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmzKzDRc0ZHnqvOrFSYRiNcbBWWKVz14wCwquQXOqNNQ&oe=6A579DCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idhGY5Am8qsQ7kNvwFkRic1&_nc_oc=AdrQb3BsfAZgdckNXNl2H9piBdD_p7rW9qdOWtE9IR8t0Re2q5sm6Zq5_VL3yp_MSrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD68m6WhmiUAYclMtXyfNBOoKffE6ToqbJlHGWJvUAa1Q&oe=6A577A30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
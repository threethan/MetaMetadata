361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pulT_AQBFyEQ7kNvwEUXs5m&_nc_oc=AdpQ02On-NA6oEmB4_r9n9aiX5H994evyCUMDCHkO3iob5cfRXtyjF96yGRNH_ks9WU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn7ydW51Exyght_2N3VXcK4Ytb5qs7Z8QfPbw4XXCmUA&oe=6AE34000"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6axG68AwTGoQ7kNvwEa1YIG&_nc_oc=AdpSGm-qyog_pubRrCjHzOpxpm3EazfRr3uAq69pWMMt1Q-D46ZBP82pEUrRAmsVdc4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs6pkZKaqI-V4RS9j_zXgAB5tWVd1p-0BsZCoLcIFSxg&oe=6AE35CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8tWL_GFPLoQ7kNvwH-SEmi&_nc_oc=Adoi1X3N_BKGppzTEoz7hi6fQEdgqy5md8ffgVfW_Y3p08ts0Nc4C7X6Ase6Dtn-FY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZlLLJprsjWtOCipLgfaqe-cOD5rUYV-YAeTl16SlF8A&oe=6AE33930"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
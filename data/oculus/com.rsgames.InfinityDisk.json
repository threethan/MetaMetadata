361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtF2d7Ac-RkQ7kNvwHdYG3Y&_nc_oc=Adqw3sZeCI6n5Ys27kIReYs5Kfehl024vHPwLxxsSvIL7k66oyoEU1icBIAhM4sFrtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fm4LML7sVQmi23arTRAqo2gPVO2SbtpsUjPtFU9hVyw&oe=6A159600"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKGOoGKY_t0Q7kNvwFHkEGv&_nc_oc=AdrLDaUTACHzt37oNk1UBSVfXlqhsW7VWmWuC0x5Bv56IHAexqvKfrMlyOm9wK3H7P4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dw0ylPZBcHoszIfCLsRtRRMxdTe2_FMaJ5Ap7e-M_BQ&oe=6A15B2CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s54M0UTDoLkQ7kNvwEerW-r&_nc_oc=AdpmFsHY_0hS_qIx5Zrjr9sT-X96frP_4-c04r16U2Wyn-WiYIBu65abeTCoJRMYX5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af790jZ27sCaKdvPyc48AlUkDVYcHNAjDne8xjSHG3S4qQ&oe=6A15C770"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
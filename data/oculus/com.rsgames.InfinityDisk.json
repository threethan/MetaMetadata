361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdvCFamnwYEQ7kNvwE8Fepg&_nc_oc=Adpy4-ak3Wy98a8SfZNMXRILZeYt_73MgW6-m5Z8r47mWkA0oU-lqQOlF07khzWRnIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__HYLi8Ldtpjh0_bMH2uUmMmZhutbxV8KHYZtc5WzeeA&oe=6A2FF400"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQU6p3GIJagQ7kNvwGC-oz3&_nc_oc=AdpXQEltGngCLeI0VO2xyIre5P-tucmrseqvM4oFdrsf3vD3aZe-P3-6Hl5usOiTK8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2kfcbtflYb1xXwMQg1TeS7uAdBUN-PXdMIoiTpl_28A&oe=6A3010CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agH5py98MyUQ7kNvwE4VjXT&_nc_oc=AdpEgbDJhIeY3BKokpsbMdOOBNZt3bX7ekVL7Ev9g5GlJo3pClqPr6xDgy4ZrnwoMno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VvOCib7nZlnw6-mTQiZV1cv340mQPvpis9W6Em6BcEQ&oe=6A302570"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
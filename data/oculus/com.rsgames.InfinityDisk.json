361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYFWcCazeFsQ7kNvwE45SPN&_nc_oc=Adrjx2nestejTr6yKoqTLK0VqYN9uu_SzGqlQ4aGevhZoTKJ6gO5rf0qKLv-JkSoTJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UbnqzOjB6AWD_67wyFx18BNCx2CKdfP--mnJ0QMIXmQ&oe=6A37DD00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7lykxQ7AlEQ7kNvwGQ-Ph3&_nc_oc=AdpbqG_JEah6EKJyD785nBJ6pXquTDYO1CPIb-Yt0qRAX8WifvTQIgUZDHqxAu7pr60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gnL2HRmt58bY_IZL0WIPT2Sex6xMebN2OUyR4z6lD9w&oe=6A37F9CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW1heaMC518Q7kNvwGkno0F&_nc_oc=Ado4N8bQ9v4ajZZ6U9B5yRsJn7Jn5hUYPDnOAenQEPWWl5nXtEPCqeJCco_l-FE8rms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FxiPjEZsIIu-pYuyJVQazkLTK8fSI6moLbnyk7kcs5A&oe=6A380E70"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
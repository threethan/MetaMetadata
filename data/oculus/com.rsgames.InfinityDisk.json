361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct1NHdlEClMQ7kNvwEW9NYR&_nc_oc=AdotpenZaMC9ACqtTgDPVuxNP0dE5Hwjmj1_Zu2wOPOsD1A-Nz96mAL1cZeq640JsXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPMw_yczhx9v56IIEYP30jb0T71J66VAd-lc_4X645nQ&oe=6ACFB1C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFszTI2n0iEQ7kNvwF6Up8S&_nc_oc=AdoKL3ynRc_kXGOS77MlU4pBE9Nhwtrne-FWw5s8mn2l1nMv3oiMNa5qS7XmlUJcgKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhmzfRgmIgL7pB2WWFUzdYkKJqYliGDOF6JyPex4H9Ng&oe=6ACF964C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwVI6B-Fm20Q7kNvwFqk_rR&_nc_oc=Adp06lxvwHzfMbFhdRzygdrwg-Zncw4LFGtea5dQHY9CnVklQ4oqNJukC64-NEpg8B8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoLy7xopBsF62GYHfLCJss5PhJ9DnP1q4Y0rwAJXnKuA&oe=6ACFAAF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXb7aQikna8Q7kNvwFGutIa&_nc_oc=AdoVmJTrz5jWHNvAwDeYgnXUpS5PaWsT23kN9sw6yg6l3Fom4cSLOSTO1A5i7UIlDsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwMpYheCbkSF5Yq5d6bEFEDkU81LY0VOk2JjLgKKiaSw&oe=6A5B7580"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G45F7yCZrDwQ7kNvwG2ZHsI&_nc_oc=Ado1BGuovEZWEG_HTc_eu-efbHDuAbNh-3ibtGM8PhREw9s52IjpVf2p8btYIe-e_p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjFUhR8SbdY2dBpRCfb7SZ2W5k11nGzsYgUEBLXqEAAg&oe=6A5B924C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CArS4_QiMZUQ7kNvwGnQe2I&_nc_oc=Adodc_W4sEMQkmQ_TYCNvsqjKJmRZgmCLC6eThB--YRaRQXRaWTd6koNcPAlLzOLO7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZc7B-iSo4wUrJIsHKvOoQwomxqKdR_R4Ux3neOoke2A&oe=6A5B6EB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
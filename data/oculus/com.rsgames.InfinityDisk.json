361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SttH7sjmVeMQ7kNvwGe4Hlp&_nc_oc=AdrJxVR8awe0wDCDaGpOopLmmp__5rmUm3JFHxF7IqA1yAaGePIx5MBqnPBihKylO3A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ofw7V8OFsmwnhTCMcjimskrIB19g-jTjFzRJM9eLBuw&oe=6A09B880"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q68hjeUqbGMQ7kNvwEGcjGa&_nc_oc=AdoKYLhA4PtWghbNofMo0jtPkaXhVhTL_EFu2Ncv6vY4lwFbFoRcUqyH9cpUvugDtCY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aahMBUAw6_9kP_nYjl5m30hVeDJutDpXonNYC_WKRQA&oe=6A09D54C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn_SfyaKRVwQ7kNvwFgOU5K&_nc_oc=AdojksMiJSy92HvWk0rq5zgDyb_lhoqU4FGR7VW7UwOKt7FjS7dkU5m5-kWkAXZd_fc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hB17DN6nFb5sZcqHy8xumQu-JeO9PynvQdL03JoEnLw&oe=6A09B1B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
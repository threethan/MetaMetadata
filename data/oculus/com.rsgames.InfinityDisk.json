361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct1NHdlEClMQ7kNvwHftvoH&_nc_oc=Adoou5lBFFVYw1antpDoNOEI4HjhxgkDiextOt7-IhkJFMnpTTAOWcnSNQvXsMhEPmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRaMpT46IvrC_1k02poi4je8tPZrZN3DRE-h5y-gSjCg&oe=6ACE6040"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02p56MNq2uMQ7kNvwF5_wLe&_nc_oc=Adq9WI8uCVc1AFiseQjWtarU33no44h6HXhRJ77mSwu7RbbxPnWNLAGMM_eFIeKFrRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqS816e_FabhWoND-MRqc0MpSLdRVxBOZyIUVMZaxXaw&oe=6ACE44CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_obMleJD5NkQ7kNvwG1mKcI&_nc_oc=AdoE60BSlAEJB-yH6tO_A6NQJHVGdARClTtfdmhx8d5LFSsHj4I_wu7CuJ1Nzt7n_rY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNuqpFwSGuvOdMlyogpFSO0kxdyiANUO_8SAU36pLLGg&oe=6ACE5970"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
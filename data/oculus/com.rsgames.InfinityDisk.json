361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=244mvH8aMHAQ7kNvwEq5y5U&_nc_oc=AdojCVCTecj6B6FWuw79NCgWfZn4xIGzOfMUDlscci1dVCHmEY_7Ccm4Ue5ZYXsjEDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FBXQV2QACtsxcVXTKVyVJHx6OLvs-lll4MQkAgolFLw&oe=69F89500"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdbX0izuGDUQ7kNvwHQBr0f&_nc_oc=AdoJaC5QfJH3sukh-Fi9FB9Pa4WutAJJqcYzByS9MJ60V9tSt6IqY5h48czOhzyfjEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0W7tOIKwqDWvsVagv_0PsdXm_oxHs_U8NsP73MQtAPPQ&oe=69F8B1CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnQoQhgjfEgQ7kNvwGXzth2&_nc_oc=Adq35qi1kuDDxhHxMCWHBtUk1FvJwlwXz43Oi3PHjbCSdvaxnSt7wbKlOyDBsIO3TOI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z8_4CCFpmdMz-YQWpnnzjQcIqnUZPedqnxgq4EeN19w&oe=69F88E30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
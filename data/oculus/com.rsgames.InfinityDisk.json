361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01cjjO9P0HAQ7kNvwFt6py3&_nc_oc=AdpaGrazEK2hHPp7ybtI9Enf5vka7y8sG0UH19z-WUky484PT-7OzokfHbjr-W4y3uM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLriuSq1c-GWeLNVc8z-i1geYM4Mtkw5BCyRqQpmFengw&oe=6AB66D00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4LSLqy6sbYQ7kNvwGV-Zqg&_nc_oc=AdrJeA1GznznN-kg74iJf9XRtKVMI8Ccnh4_U04WypzQeeblMYsCj9PTRGVyA9-mD0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI548K9X-dQiw6M_twSwZtoVNWW5JMTkGq7GZgesa2McA&oe=6AB689CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmNwOrSY8iAQ7kNvwFXr-fN&_nc_oc=AdrAuVJ8Ix4dx8RQ92kgDm3H1z82f8q0MQwBHElcQ7jky1ryQIsZv1-9P_SPH-W8BF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcqcux_qGtOUtRgZ7PYPZfwFW6WFZtHy0rdD6L2ruztw&oe=6AB69E70"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
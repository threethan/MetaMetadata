361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC0pW21B45UQ7kNvwEKxjF3&_nc_oc=AdoKx-r8GDNFrVVkbyerGlHgYjlrtcuE_V0zRwFLiWbFfNFg4fcyMKZowslrIvdwGn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o37-b8EYEiXSdmXrM-Avdad79oZHqaA8VbysMAP2EmA&oe=6A450C00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoZxBTY_aDAQ7kNvwGvIfk7&_nc_oc=AdrI-e2SIClxDGqcvvHeBMVOob0nsQzJ1LL4WSnEKM8I7Yiew6lUbetY0SNLXEeZzmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8874uDDJjkkJPPa2aaOYhlJUN5Q_yvnX8T4RCtW9plYw&oe=6A4528CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NUxS6n9710Q7kNvwEdqfW9&_nc_oc=AdpcUGIk4Tz6cLrTtXO5QE0zfxb5Ei1_J64I4x1FFb_wJUr1JlE-7guCx5_ynOqIUJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oo8rVMbFpNiGX5PGwyfPM0Zq2zOqmLfzMpaEXfOQ1lA&oe=6A450530"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
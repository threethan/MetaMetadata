361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXXU5tWCIOkQ7kNvwFFvTL_&_nc_oc=AdrJ11puvJAoNGIUfIuuWPdWFZD2bL8oiziYXYwPvD5Kftu1XaXD1CDNDc2egSLklZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af739SYQMELJzuRNEH58qD-yYN0VXYr2Rp0Y8spnT9altw&oe=6A1D7F00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTRVsAOhrRwQ7kNvwEOHjB1&_nc_oc=AdrA_2LcqYpzoBS6bPJffJl5YYbfHkx37SmzH0KeWoubqYMgmBOE4tTgmK3v0HHxLew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ayyNoNaMkX3JeHWl58FTg03G1lYh1lN7NgX99moM4eA&oe=6A1D9BCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAMDa_LH8uoQ7kNvwHsspio&_nc_oc=AdoQwxTAkbsNERrPWLB7nkQFl0RGciNzbjbbKWsc5-o0LhqrheUi3C-esr5owOKXMWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67D2FY1VCIe6GRwgVhXrqTYTj2E3bY2LUCTKi9_DOR2w&oe=6A1D7830"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
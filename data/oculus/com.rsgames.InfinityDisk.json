361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_BDFe5we8QQ7kNvwFs9iDn&_nc_oc=Adr5Q62qb2ntSrhNhpui1XJM7NSZ1uxk7sNC-oPcnSpAsq24lNiy9uolph9rIQBhRPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4fYMeIkzCfTs5JnH8zDckkr8URt4YXj_NNHQT7O5okQ&oe=6AB12700"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01OihkCjfVYQ7kNvwGP78X2&_nc_oc=AdoJ6BrOvbLRn5-CGEy4kFXNLUaGTg844IhR6MoNdocDyegjNu-LcWQHP3-JX7pWvRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ5XdgIz8iV94ZFeUtuRJNqdzrXXu9vyor_dGN6Mwc6w&oe=6AB143CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULbfsAj-TuMQ7kNvwE2S5hc&_nc_oc=AdoT3MUGi7H71C61vZ5jsXEab2FKzvnnJ3Ao105sARCa_CVEYTx5MR9LOOY7lZBlkEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBUYh4eCuR-Tm7dLLuxjEtpnGtUUEQJxssE8A2wQ2lng&oe=6AB15870"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
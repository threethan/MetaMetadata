361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRvryA-nPCEQ7kNvwGnjjGq&_nc_oc=AdoENgc1cjqA4yY1A1w2k0LvMKymbxmDN1JB_MogAzLd3DFIqIAfNenwyeoepItTRnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPmgFjnHLeo2WnLdCwaRe8QPcxfT6yWRB9jPhqsQrK0w&oe=6AEA0FC0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9_0oG5F0woQ7kNvwG9am6D&_nc_oc=AdrPhy5xszQ4IjvFgL17ojv0r1adpeLJjTbtzk5iR1T0fCNLfmUDIfClxx2Vo7fjobY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7UWXrvxOfDC3Ymu2cJ0T3f_K18QrksswsJZVS54RgsA&oe=6AE9F44C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PErGWPICk2kQ7kNvwFv_z2L&_nc_oc=AdpD1ORuAh_HcCiMba0U1dnuINOwjzPr9i6RIwqHPWPtyDpWjt3YbtEiAAmhPFdmIY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx7qp4xM4Lb6WZuziuCXVVsSMwWoMjIecJYaQ05VuouQ&oe=6AEA08F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
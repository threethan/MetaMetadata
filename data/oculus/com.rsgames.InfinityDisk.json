361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YCr1eABghEQ7kNvwGKTC2J&_nc_oc=AdrCQbHU8YP3h5o9BnSy0vNsIx2PlnccE7ktaDcYUITKn92l8OHeWi7rBXLOIYlK1i8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zh27eLOWUSQAeWPXx8G-Xw9oxbdC1s0K9a0alfcF3cA&oe=69FF2C80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKVPUO724J0Q7kNvwEo9KV5&_nc_oc=AdpJ51tCT3FuwfCmOC0XbXskqxYwzu24r1IYikChh1opp8FvegpHOHSBEACzX-eJlME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nyrr_xyFVQqftoSWpKNScJtt6XsffRVyP9xaifzLIoA&oe=69FF494C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1zzBkyTnFQQ7kNvwFbCCLx&_nc_oc=AdoUBB21ZhqB35dT9SYIP9IpAyXGuFZIreB75yLNcob7A05SlOwXLL6eKFvqLr57WO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TDhZrZ4UuDgHwiU4P4EysCuTpbwbUCVppAHlTi54gDg&oe=69FF25B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
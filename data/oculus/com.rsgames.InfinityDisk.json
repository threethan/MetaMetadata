361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDZY4_b1AdYQ7kNvwFswiLQ&_nc_oc=AdoaAVCEaqmNGUmgTd6b6muWwPyr8eyl7Tcsuy5eb3LnYakTZc2FNCNxZ3eh9zknp_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE43gnUyWrmPxrWgcctugk6uImGiObG0ZxOKBnWyaj5ig&oe=6A75D380"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3CIL5YIxXYQ7kNvwGKviGn&_nc_oc=Adr3NgGRJx_IQ81zCc48JcmBfXejDwr4gR6-NP3S1xR7cnbXqeKoF5FuLJN2gDCKY7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc0dQjWYXY71kK0c-xCnkyEhhLyB2fsDnblvt9dmORNw&oe=6A75F04C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMAUYeyVNYAQ7kNvwEbVepH&_nc_oc=Adpp7pEk6bkZECMBBwX1p7cGq3ty6vOGgzhm5ih2kQyhO3bIUDVs3lgtSUHNgKgTXrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6IT7mvDqSjlRWd9-dB8KWf0iXcxCL3Lpyv6SK2m2Ogw&oe=6A75CCB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
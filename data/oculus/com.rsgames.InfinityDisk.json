361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR7eAwubgr0Q7kNvwEjoUdH&_nc_oc=AdpjnlLJqmquABPNVR8FEwm-dkzkQR_AwRu7-XPV3Xqw5bo0m_k2LuSK6YOgH4r40Vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV-AHLl5fxnksWdf7oxOWM7scZ3FpgSyM9gaoFZCCAnQ&oe=6AF0A740"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJMEhJkJ0iQQ7kNvwGbGW2U&_nc_oc=AdrAtnIN-SVQl76EztA65rJp-zznk_QQHkxRofmfRabT6ZpPzRudSbahpJBPQZva_Xk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpFYjIEXKYwJvDJEQbP9FbV8MuoGB00O2M4m9l_aaE8A&oe=6AF08BCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF4dDeOeODkQ7kNvwE27HYG&_nc_oc=AdrcIt73_1EHKGDso2ypAIKg7DD01Hk46cNmMUW-T4SvkV-wEvv0p9xVu_8s2-BtNmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuiITB9-zXpfp6ukeGoV6pZ9VmGehNr8wY4UJ2NclU_g&oe=6AF0A070"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
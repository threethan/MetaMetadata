361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YkwUz04G78Q7kNvwECbFxc&_nc_oc=AdqYO7Gtz0qqZjQ2_G0BeC-ncPRaSeXYH_jZlUTFTRgMNLNuKs8VrZE2LzdgwqI_jKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nYkxHWMvVaSUZC1m3dL8RMzsdruDIv3hnQJfdHrdtiA&oe=6A3D5B40"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DbFDxB5Q4AQ7kNvwGD_06R&_nc_oc=AdqCYDSCQitzcCKS6bCuC2diVgS92P2tjzA_wh0DmBCNCrNWyep3lRP-6kJQao6UhRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zHTH8ClpG6tSLI-J4dzrqsLV-CeQwdg3RRmUBbMWx7g&oe=6A3D3FCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vLh4sm44PkQ7kNvwFJT0XY&_nc_oc=Adr77-ODMncWtz8l4Xh2i4eWbzk6lWNWMxsKuRlg82xdlt4XngEDhzQEKx4kUcsnrpc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hxJFpaeGd-uW5BtmOrhDGh8T7HeCtgmJnnF4-s2M5Pw&oe=6A3D5470"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
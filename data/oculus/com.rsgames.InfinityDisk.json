361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwecseVvRPQQ7kNvwEam8CO&_nc_oc=Adp-iTuJpxaTGlR5qIxraqU8bYB9DfOfNV7QWZthAv81aw3paBACzjdZcpbi8N5FYrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBJIhaX4H844O34ByY9YxXwZGr_VD2jCsUCOTBzqWURQ&oe=6A708D80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtTpL1qZ1LYQ7kNvwE707_r&_nc_oc=AdrEkY4hYqu_6pqvvVqV45Ht81Rcey6mHAK6yQm5S_1Gj0ZohkB1kgY-_OVqDA3KNRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvHzSQ3QbM5q2l3QALHYz9NcOz8tltzBMbNOFyxlZU6g&oe=6A70720C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7a5r29SrD3oQ7kNvwFuPQYW&_nc_oc=Adqhgl0M8dekQ8n7vaBm7nurIjmZJQaOHNBJu_LWD-rvn79gJI8W5YXqp8I2RPTpCtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcAJDFm5VKgyqc5DjOEDiojVOGLHBdKZxLhWLLnG3aJw&oe=6A7086B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXb7aQikna8Q7kNvwHNyiv8&_nc_oc=Adrte4hzVBSR74pu3JiBDkUKHL3XE3xVl_S3seC-fZd6USGF-w9-kCfL5YdUQSnucyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc8WdMHjzZvjRCFGeo0h_fa-xFH234rb1SP362TvRghg&oe=6A5E1880"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7mOGLfem5QQ7kNvwFkg3zf&_nc_oc=Ado5yEFDoZyOGxi0P4iQa68wXxq2FN89JoHTAdUrdk3tVRwxoYPqBVlqE_2H7AHbjnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf1DLM5dwA-ZG_MtOqydZvxp3sbI61GAgpu2F8VgFqFw&oe=6A5E354C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTfGJV3zsMsQ7kNvwGfpO7E&_nc_oc=AdrliCod3QKso-A9NOFULlTdsYNjp7nDNDdieMYIu3JjiCGn5tA0MWhIhPi4NGykHdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDacf_ZJ-OkhMkxWl6J72zgMT_NpAuCzU6Clb-MUKB5Rw&oe=6A5E11B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
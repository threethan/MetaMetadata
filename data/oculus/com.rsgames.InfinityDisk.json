361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YkwUz04G78Q7kNvwEmMTzQ&_nc_oc=AdoE1Lo_g2qzTSeMU9s6Nb2i2tMj7CtXYLlCAlT2L29VL8TpiKRnC1Oj9jXL_VnsUF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tHiTZJxqF2-Alqa-SBToVYCPS9tASdjNzU33ulXiLIg&oe=6A3BD180"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DbFDxB5Q4AQ7kNvwEBNxBl&_nc_oc=Adr2homdj36gtiBsyaAKSSuP2AENYg5as1wlbk2mT54m5SYTYww8biD15I9NJVBZ1h0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pRrNTRd0MPSR77rgczljCYG4RdU42-KBNwbmPFXVhvw&oe=6A3BEE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F7iDILb82gQ7kNvwGMpFEc&_nc_oc=AdoGUACMxlkTgWjxKeUYSxyJwz7oYNzOLGZDJmtIrxlXVZcXJT_TfQ6bSJvu9uqBg80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ArakW5gzWe_FDt0Qo_H8NtL5vajgtvdWIXuvONiuc0A&oe=6A3BCAB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
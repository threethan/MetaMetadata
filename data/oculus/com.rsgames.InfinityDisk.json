361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct1NHdlEClMQ7kNvwGxc9BF&_nc_oc=AdrMOqAGDHhZRMazfPJO7T_YRaMplcV9VvlOsA1787D2nv0GZDuvJOFt8S7bqHX7WbI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy-R75sZznX6aRRczuNmS1UjKrbWDyz8WiLy9hBr0zCw&oe=6AD10340"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFszTI2n0iEQ7kNvwETeeLE&_nc_oc=AdoPMCOuZxEx228HxRpSIs4c7h3A89S6IYEdm0cyxugBibMQURZtZuKPTpLsWDB1-uQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1MJXYK-u2N5ZhgqlBGergjH1XUwlggzArIeApOTO40Q&oe=6AD0E7CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwVI6B-Fm20Q7kNvwFbpTTx&_nc_oc=AdpSgDfaerKHQQr5CVfDJEE8wx5TM0GQ9pNVx_cdkC1a7iN9IjPcLZljO24J52GSBCU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrJIlJzsMCN82g8K2uJsf5jI2OmVHpCMpCo2gPurZBeQ&oe=6AD0FC70"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
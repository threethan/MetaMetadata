361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2febomLrwVYQ7kNvwHBQ5nn&_nc_oc=Ado1YDPUPjVMjOPVY99CN985dNqXTFDidJPpfXuLL2UOK_5JAA0LmWq8mOEathxCinU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX56L12viwqtkwH6azgOpJ-IP8vtfxAJxTzeYwSaWmuw&oe=6A805F80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_dKoPwtlw8Q7kNvwE31dH8&_nc_oc=AdoZJN9Z-qXS1TBzh-eeIzZq_SjKFlv039fimCSNKr-J8i31B4n53TgECgtOwpe4Yd0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_qDupJC3VjcNnEVaONdEZer653O_I2wCSyzZMwq6Gdw&oe=6A80440C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9KveDtG_joQ7kNvwE2sErq&_nc_oc=AdrixB7liQFa5Aj8D8qnokK4UYfkaxDS5ZmM5PGwsQE2Bp9ODboWCSfsbHSpKI8g6DQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7A181NuYDeIia8HUfFV_aWIzTas8VPcIZH8z05SLTjg&oe=6A8058B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
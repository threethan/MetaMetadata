361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6T0rP1ogR4Q7kNvwGzrkqs&_nc_oc=AdqbnUWvqV0Vb5ZtG8RAUom9K60T2qNOv8dWUHTV19_Ug7NkWjg5ZNqnk7Z_e-sG7cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpi37T_X3TF_BKznLHCXSROZ8zoLOG_pD39KBd-32rKw&oe=6AB51B80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4LSLqy6sbYQ7kNvwE0zAYX&_nc_oc=AdocyIwjzrqit2IHgQCxtFP8KkVNt2iLixXveQaZlPOlun2Zi0Km4WbGS_hKYGqyNfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK78lXpzy_BQGJ9p0GoPDeCaxKLMB4EbEDqvjsW4r6WpQ&oe=6AB5384C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmNwOrSY8iAQ7kNvwH8vi8U&_nc_oc=AdppjPd9Us-Pz5cuOR2ni_kVuuCU-lyXPnKbHj5Asc0M4NuiGhj-TC1T4T5Mpy753YY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKyCC3Fi-a_rY-GKkps01L5XgCGVphMxpkiPKY01Vr1w&oe=6AB54CF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
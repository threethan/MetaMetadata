361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Mz-6vrLEUQ7kNvwEBw6YH&_nc_oc=AdrWrS_E7hlc7w1QzzraLAHw9kS1hy8UkZSH4ApcRhlF9mCJsfagbbCyMQda5sH8ygw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nIhnoG_SW4SWc4TAHqC-Z4I2_SdAl4tSPAv8ADVmhEA&oe=6A411780"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjjghMZhV4Q7kNvwG9NhL5&_nc_oc=AdrYZz8tBct8menJt7PqrfaAUWCZHyXb0cmNZQLAKTU9_bEkZ-sn_-cDecuxQ3xJZa0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qbpBgNWldT8SYHpw3uBpKvPPA3ktDIaq5ad1nbitNkw&oe=6A41344C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNNoXHgjSdUQ7kNvwGK7B4k&_nc_oc=Adq_640C2-thHrBxkkFiI6cxiP3zKCqdCwbCl-r9CwTULmDcVpk7OFShygfGPaSTpC8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n53LlRJcqFqttMZMgC8iNWjPIi8MSZy6Zpv-eVsmuvQ&oe=6A4110B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
25361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-pN4yBjQq8Q7kNvwFuqvGd&_nc_oc=Adrn9qr4Ch7z8a9Q3ITmT8UVrutMJU5rZfOWF_0qlQDwcHg9fRrusvVsIqM_Os7XMAU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66UHwvG63bIgWNYfcKqiCrTqlvjLd_21CcDdig5Zvz2g&oe=6A11A180"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4HeGM--c_sQ7kNvwE2Nwj_&_nc_oc=AdrPuqBtM3chiv73GiCMEbDG5MVILCQouR2m2GoLck9SWnlQGJDNeuF9En0RxsOo968&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iPXW95zkzqNNF0WSDxdyZ2zM7sbhkLA2BcV95ZV3P8Q&oe=6A11BE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxFuMFIZUhAQ7kNvwEZIICN&_nc_oc=AdoivPa0Jnc8o65feqgatY1pap9ildHG_H_8NljYq38BlL63y5yy0p6YF87snpZrX44&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yeDUtb1lpOIMKf7g9NtolVUH7p-2y_LY8nKBycXqzUQ&oe=6A119AB0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy
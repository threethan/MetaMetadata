25361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_u-jbJSYKcQ7kNvwGJF7cc&_nc_oc=AdrKAXhZ4PleD4eTiHmJszEI8V81dcl5y7wYkYMp3XAzG7eGtMzvwFR246jhUxw94Uo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeX0XLFYOdO8e3onZv0jwedKlC8hdNq_fxHPKwGTZwzg&oe=6A7DBC80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_dKoPwtlw8Q7kNvwFsFjOh&_nc_oc=AdrweI5MxBMIvPmkXvzKPmO7oMm-pEYueX0qS_9sAP9wmYmpVFHFrv4ZgBM7zFISAto&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVqTN9kU2_25TEtpdc7vEWNh_xpFIq2ylobn0HZPK1kQ&oe=6A7DA10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pCJUAkZGp8Q7kNvwG8W_4j&_nc_oc=Adp1dZN9zyHc_XdXn_TYRoESdHTaHMEfiZpSvRnyt0IRgCwaesmUynqHExuOQ6mQGM0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKX3er_5IsQPnqWZUnbTtw9XPnVikKm4l85FpdIS0NRw&oe=6A7DB5B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy
361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJSCmly7TkYQ7kNvwESoHhf&_nc_oc=Adr3MgpyQvdmkEzdlckMvw2hsGAXdZOtfZxkzQV2KcHovYgHgK0zp0nb9jVRHfTNBrc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmlEcpyGLlW1frjavSS0U6HJ0koCUgi9cY1k0dsc0vOA&oe=6A5F6A00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7mOGLfem5QQ7kNvwFfhdVW&_nc_oc=Adr8GaqqcYsodIK8uuaDUqZ1FuLBqISGbSiX8u_p-b84bEl5_M9Taw9RnSPWYGd45Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkYGMRa0drwPhYng85SmQU91Qs_CKJDGrovyDnQfjbFA&oe=6A5F86CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTfGJV3zsMsQ7kNvwGUlDZ7&_nc_oc=Adq8MvicqXpJv1XqWIf_0INzKt9d322S-zPN0TRN6RCTt42G039BuW8BqM8Iy6ya2U0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0ktXLt21C6KPQIbQACSnemUjyH5EzK4A86zeDwx3aFg&oe=6A5F6330"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
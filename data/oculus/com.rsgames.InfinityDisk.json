361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UWNJhMLPGUQ7kNvwFbZxyO&_nc_oc=Adr1TFFB-lycWBdKQklOYRcz5bKM6Zmtcr-GoR57hkJmrrmNcQjRKUChG8C8lUS3DHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2lDotG-FlNAtLS7KRWgj18m_akjk-WhLTU3ixGOq59A&oe=6A6DEA80"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtTpL1qZ1LYQ7kNvwHR8u7y&_nc_oc=Adp7ZotG3PmRbLfXVT1uUSgstutoBUf5IIxGi21OTWVgdqq1B2SvCkerXf-OpUphCjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDnGONn4NlHJP4AND6KuY8R2mqYRspqm4qYkcIK5yQkA&oe=6A6E074C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItbhGa06OGwQ7kNvwFuulOQ&_nc_oc=AdpgGV_6vnT4KaPTntq7jBVxcl3CJYFsL-3l71RNV9TAhd-Uwr3gKcllfLm7wdEJrs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC52R2vwn61daoZxjVQ38ri6xLja8G3GQeymWCsRj1dAw&oe=6A6DE3B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
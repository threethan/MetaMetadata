361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON5G7HliVmoQ7kNvwH9dYFV&_nc_oc=AdrL8lCFdLwMqRzT6jBcDHORiU4gRjA8TFWXg9EdLe7unPxSluEE5It3JXam3QMwMBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC08s7hhXNfd-PTuDtOpdikfC3Hd-FPJWa2ZiGqbb0LSA&oe=6A69F600"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LfrRRdKCzUQ7kNvwGqka50&_nc_oc=AdrOA1MR3S6V1A7ml1dDMB6Kqbl2g5lfTNhhXrq7xlxxYgfuW7pLVnXmIhQo_AtQVZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5_DaEv4vDLGQGxcW4Amzktmr6rISQtA_F0tXbAHhjPg&oe=6A6A12CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3BqJ153jKMQ7kNvwF8WSRp&_nc_oc=Adrf_BN1gUL4rdwY7RFumJOu12Ri30bqGLFcsd4LSzXg6_lxNYwB-GDRHmhLxiwoS8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuI6G0lRYcDZxbVo9QaFuqDjZrgT2OIGcBaYZU07-13g&oe=6A69EF30"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
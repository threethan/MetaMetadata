361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLHOlF1DySUQ7kNvwFnGzY2&_nc_oc=AdrPRafZ6EyudrxHKPK-Ck7BAgdrKVdd8AVuxXqJTeJoK60Yfx4rJ7_ZuExH7s_7_i8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ-V2h2q9rB7iFjPAeAPsGyMfK6bYDY6ExlXCeSRqNtg&oe=6A9D6080"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK7263Sc9E4Q7kNvwG70a8n&_nc_oc=AdrsQw7Umhc1o_U25f9Il7Axw8NIRcvTnU2riRQAm9SYCIBPEFxIeNbqUvQJ-wn_0Tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk5uCQwyA1hlPYd7O6qjm1Etr5o6W8O1y7fK57ujAhmA&oe=6A9D7D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xiB-Ir_fP8Q7kNvwGi9--o&_nc_oc=AdrHmdXII_eh7WBkcyOkTXbSktYr7-ZDYiVg_a81-y2sI0GYvjl1Lwawds7R8GtPCjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk-D2l1iu3p7Iunidv2I8jyQuJsjT2kv5o4gWr4ZKN0w&oe=6A9D59B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
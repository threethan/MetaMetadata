361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr_2P8CiDAgQ7kNvwERaPbJ&_nc_oc=AdojdeJPSv0uZmKuc7BcCASBMKPRWu56UJXv7J3EECEUHa7GU8J-yaiJDEtgTB1lHzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86-04kWYN4wnTzmF1Fnd9l07BfDnrQ0ZCHqaKJSHyj2g&oe=6A2EA280"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQU6p3GIJagQ7kNvwEMXZ50&_nc_oc=AdoECY1Qf_w2LS0ehjcl7xfzNGDgKur3NQB2n_DNsNs5hBG0v-dwKkGYXmZXyhMj35E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af966a9pV3n_Z-YFPO4GtLtuJF2Z0jm6p-AHZsVL_nEKNQ&oe=6A2EBF4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agH5py98MyUQ7kNvwGWNrmQ&_nc_oc=AdokgRavGkZBgi_LAyJNTKDJJqZzLNwB5qBHPgmCFfEAeqfwifrPcjdNY-ErqxDGC6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eTSBnzHo8HRrCO62rSfc_pG3lNb0ptEMm8apWTk6O9g&oe=6A2ED3F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
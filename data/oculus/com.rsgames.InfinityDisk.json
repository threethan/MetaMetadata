_SR_vVq2IWsFCdAZ3wFnYnrdNRG0taZvrATVvfg&oe=6B0C644E"}, {"file_name": "04.png", "id": "2418980035222364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_2418980041889030_3741999443992925361_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmJpbFuqjLoQ7kNvwFAaOUK&_nc_oc=AdqY9zKfWgjse-ZW-GzqMsbvJjuQlB3EQrat2V2ehT7EAVNar3PYnmD2FUqYzYtyGfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQY9pL4KAI-l30G_3sdkLWKOYuikdzja5-YWCGE4Oj4oQ&oe=6B0C56C0"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NG8VNLAMNUQ7kNvwHvGynz&_nc_oc=AdoS_cMkd4-YrHPb6GLT0HPBtqgIt5v-fIu4tHNtftvpxIVmcZ9mW0xX8KlxqpqXrTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwg_LSH70a_bZ7oQy8zAGBJ-dXYfcAj-CRN2sy8T_aoQ&oe=6B0C738C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AVJhaNeDIEQ7kNvwH3NoWJ&_nc_oc=Ado21-j6xsDOsid4FMPDZy3UyNYcaLLz7mYr_RDbO2blMjtdxTlBzzVQel-cbxAn8Go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQM_SNAH5ZjJCVNu4yUxCuLyiYEaDByQIqffgr2-z1Btw&oe=6B0C4FF0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_url": "https://www.chillspacegames.de/privacy_policy_infinitydisk.html", "developer_terms_of_service_url": null, "publisher_name": "Ralph Schaedler", "support_website_url": "https://www.chillspacegames.de/", "website_url": "https://www.chillspacegames.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26499485909662101"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1949041519332526_1737563644670690660_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSjWsoJxxvEQ7kNvwHUOVrI&_nc_oc=AdqjSfyWczPDPKRAILh6tGoGGQWeW0sqPhzmRlUdbbYNzU_cQFJInKne4nm6Yskt_dA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbRL-F2mhN58Fs60qHKyHPaBbsp1a-n7Fvz0Sq9HE9Hw&oe=6B0C4FAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Infinity Disk", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "27765422860
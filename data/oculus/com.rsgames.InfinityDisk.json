361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwecseVvRPQQ7kNvwEkzmsG&_nc_oc=AdqVT_cT4L1iD912RjzVVRyV_kNMpfhMDK0z8Y2DytcOELMpYs02DH77jPJE7tuMZVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJeW-nBzMMIwNVntGoFgDULOeBwPpelUlZpuwpIh55zQ&oe=6A71DF00"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f6ZtbW2B_0Q7kNvwGdi4oL&_nc_oc=Adq-btA9QZC51FTdxk0HJgRMQWKfwkSLM5ZARjE62yXe_vPxjBEw-qr8wQCfVdY9J0U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENbTgaAkrelYQKgidWevRFyxhnK1eJLB4flNMzgbSjcw&oe=6A71FBCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7a5r29SrD3oQ7kNvwEq-UmY&_nc_oc=AdpOpmWZHubZ8hQWobb6QSTleSVeEd2FyiVFoR4sPBgE4Pughjzp2OxhL3577er6WZY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4SMRL4KfZLzFc8kDygrzAajL6X1ynSWpheHcyXfIEUA&oe=6A71D830"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
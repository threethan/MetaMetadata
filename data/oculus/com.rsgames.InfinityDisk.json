361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6T0rP1ogR4Q7kNvwEKqvoJ&_nc_oc=AdrRz8xVPN5OAU8F2gUlXyKMmvX1vJJz4q-RCAI2sggJisjErUZCulItcR0UrMn5c2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKGLEMMmnlnIS-t8JWxLjYMOhf_lK1odg7EHGVOUS81g&oe=6AB27880"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01OihkCjfVYQ7kNvwF3QW1_&_nc_oc=AdqEVAoN3NijMW71mcKs9cRT9OFXGN3niwX5FYKgZoOnN0miD1v1899ZrZvb-6m8KzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlYMdQvsbSXTDQXhQ8ppAXfz4Gy1N_eCWw30G3izBQ0g&oe=6AB2954C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULbfsAj-TuMQ7kNvwGS4L3-&_nc_oc=AdokjXpqTPJqFYF-goZIl60EWpsEWf6pCh6Pb9ormD37QO5uRDqdCliwnOyl59KQRoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLys8d6rQw0ZEKWkPMp3d7_SD8wPCH2qPeGXx1UrPiSA&oe=6AB271B0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
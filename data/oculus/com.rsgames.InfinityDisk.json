361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdBLOc9FZpoQ7kNvwEwTUVc&_nc_oc=AdpzPclkD_wRIumLZceLqE1cBs-6e1NIKUdPbXik6HRJm9w4mD63ekXnon6hG0eZ5cY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yKzbezsr_xoa376Irtx9zNfmj72XKSuRsgSl-wT6vzw&oe=6A241680"}, {"file_name": "05.png", "id": "911661707943336", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_911661711276669_7507615326232477712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ715VFUckUQ7kNvwEi2Uz4&_nc_oc=AdqfE-0JCGwPlC7g-E2rSupx0MBBTlSp13_FpRMspbB3Ik1pcHf9zgFWc89veBNtbY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N70rLp8XgAklW9FSUj2TwoeKk78j-m38JXHtyFfLZQA&oe=6A24334C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2019529251948839", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824560_2019529255282172_7373059146021049049_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjkFAcA534sQ7kNvwET8hqs&_nc_oc=AdqIKNqiS83XTHtMSTgkERifhS78EYvvE7Y1p_rdb3z4XUDEpQtjSQbdqqsmB7N4TvA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ck0Tz7lPzpqTFHfzP1jDxe54NpBIFn8rbIYyt-2dVjw&oe=6A2447F0"}, "display_name": "Infinity Disk", "keywords": ["Frisbee", "Physics", "Scifi", "Puzzle", "Sports"], "long_description": "Infinity Disk is a single-player VR experience that fuses action, precision, and puzzle-solving.\nYou throw a glowing disk, then teleport to its landing point to catch your own throw\u2014mastering rhythm, timing, and trajectory in full 3D space.\n\nEach level introduces new challenges and obstacles that test your coordination and creativity. Bounce, deflect, and weave through exciting environments as you push toward mastery.", "short_description": "A fast-paced VR frisbee challenge set in a surreal sci-fi world. Throw, teleport, and catch your own shots through a series of physics-bending levels."}]}, "developer_name": "Ralph Schaedler", "developer_privacy_policy_u
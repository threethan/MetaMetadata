EEHh85iu1t4Pi5DrvUHt99hwg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCO7OliQtiriJSj_-CF6hIEixmfq9eUtYFWPH1LkvOyg&oe=6ADCDB5E"}, {"file_name": "vlcsnap-2023-05-02-14h58m49s775 (Custom).png", "id": "549811347358692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392879_549811354025358_4554113463922056625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkQAlh6qqOkQ7kNvwHH-OqR&_nc_oc=AdrFXiB_hsd6ItUoZ907BeB8ub6mbM0zLYX4VFLbmz9CS9SJgIc4J95ymC9j5ZYSyJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZIhCxUQrgd4ElD8sYaszHKez2bqpTPkf-lfwen2bOcQ&oe=6ADCD691"}, {"file_name": "vlcsnap-2023-05-02-16h43m42s819 (Custom).png", "id": "1303426370254811", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1303426373588144_5578514343959452863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOrMh_FkMCEQ7kNvwFRzBEE&_nc_oc=AdqTrOOkEbxWDZPehE3uPSxQMvzJrMzkQX-bZeMmsz-exf2_AWBojg1QRkbBm8ZtSvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEmE10h-8I9nvF26fOvGH4vSkoaSvVmB886nzy6Vp3qg&oe=6ADCD4E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-05-02-15h48m23s579 (Custom).png", "id": "585488316984012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556793_585488320317345_5113930982071764318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6eDvgSDgTQQ7kNvwHhIJvb&_nc_oc=AdrXlmE5OpyhuoqipCYOE5GhHxtMLaa-FFthTCqWfAv_FoaKMlahUywc1VrZRWRdVqs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODaJrFMr91cO_XqWNK-jFmTDOIhO0R-yo4oyBlLgQ8ag&oe=6ADCA6FE"}, "display_name": "Task Force 9", "keywords": ["Stealth", "tactic", "singleplayer", "shooter"], "long_description": "Task Force 9 is a stealth-driven VR tactical shooter built around planning, positioning, and controlled execution. The optimal path is quiet: observe patrols, coordinate with your AI partner, isolate targets, and eliminate threats before they know you\u2019re there.\n\nAction is not removed\u2014it is the consequence of failure or choice. When stealth breaks, the game allows aggressive recovery through breaching, explosives, rappelling, suppressive fire, and close-quarters combat. Combat is lethal, fast, and unforgiving. Charging in is possible, but never optimal.\n\nCore gameplay focuses on:\n\nStealth-first level design with multiple infiltration routes\n\nAI partner coordination and positioning\n\nEnvironmental interaction: cover, verticality, wall breaches, ambush angles\n\nHigh-risk CQB where mistakes compound immediately\n\nTask Force 9 is not a power fantasy and not an arcade shooter. It rewards restraint, awareness, and disciplined decision-making. Action exists to resolve situations\u2014not to replace planning.\n\nThis is a pre-release build. Systems, balance, and content are still evolving. Player feedback directly influences development and prioritization.\n\nCommunity and support:\n\nDiscord: https://discord.com/invite/7a5QEhuvFz\n\nYouTube (guides, hidden mechanics, development updates): https://www.youtube.com/@gooddaygamestudio\n\nThis pre-release version exists to support continued development and refinement toward a higher tactical standard.", "short_description": "Task Force 9 is a single-player, offline VR tactical stealth shooter built around stealth-first decision-making. Plan entries, coordinate with your AI partner, and neutralize threats quietly before situations escalate. When stealth fails, survive using controlled force\u2014cover, breaching, explosives, rappelling, and lethal close-quarters combat. This pre-release version supports ongoing development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://my-site-48s5awxb-gooddaystudiogames.wix-vibe-site.com/about", "developer_terms_of_service_url": "https://my-site-48s5awxb-gooddaystudiogames.wix-vibe-site.com/about", "publisher_name": "Good Day Studio", "support_website_url": null, "website_url": "https://my-site-48s5awxb-gooddaystudiogames.wix-vibe-site.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25915673871382037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031447_607515264677152_4497742269363069070_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7ytFeudIeIQ7kNvwGToI89&_nc_oc=Ado7fkZZOgQ76lmv-v3ogOz7U2ghITCKipSGN0z1y9jx73-xVKrBuJ365WhSk781bbo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9cxGkqyy86Mo0x3-m1-gPTvSA-z4q3Jsp8oDa2Lcujw&oe=6ADCC4B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Task Force 9", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1691528400, "lastRevision": {"nodes": [{"id": "6476030315773016", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6476030305773017", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1625513467894489"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "APP ICON-0
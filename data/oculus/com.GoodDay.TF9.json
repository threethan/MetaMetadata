 "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75363517_1303426373588144_5578514343959452863_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1wcoVnL2y4Q7kNvwE-ksTm&_nc_oc=AdlhTg3wu8QNVZ3kQt9FZqkZoP_MV1Zs12uTkgvyJhFt_ztysQ9o-SLKc2lFzMLm4JU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvZFeop1W0cNG2zEFzBho1BAYV4jJ2GHjavregMpHCEow&oe=69A57AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-05-02-15h48m23s579 (Custom).png", "id": "585488316984012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556793_585488320317345_5113930982071764318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NF19ODKhzHwQ7kNvwEmTHAB&_nc_oc=Adn0TlmuTNgqE1_wkTw-KsI9WuflqMND94NQ8vJxdjTNSil10N3Kn7M4p6UT-NFBRF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvAAK2lkbG3rLrbJEQlYLYO-saryI66URyxpplkkcd8AQ&oe=69A584FE"}, "display_name": "Task Force 9", "keywords": [], "long_description": "Task Force 9 is a cutthroat VR game where players must ruthlessly take out enemies using any means necessary, whether it be through brute force or sneaky tactics. You'll have to strategically maneuver your AI partner while relying on cover, explosives, rappelling, wall breaching, and ambushes to gain the upper hand. This game is not for the faint of heart, as it it not just one more tactical shooter but we aims to sharpen your instincts in the brutal world of close-quarters combat. Are you ready to put your skills to the test?\n\nPlease note this is a pre-release game and we are counting on your feedback to get better and get the game to the high standard we are aiming for.\nOur Discord server is also available for feedback and support: https://discord.gg/gGYDPZsmVN\nYou can also find more information and hidden tips on YouTube: https://www.youtube.com/@gooddaygamestudio\n\nThank you support and we hope you will enjoy the game!", "short_description": "Improve your tactical thinking in real-time with Task Force 9 - a tactical shooter that puts your combat skills to the test. Take down enemies using force or stealth while controlling your AI partner. Use cover, explosives, rappelling, wall breaching, and ambushes to survive. Sharpen your situational awareness in close-quarters combat.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://taskforce9.com/task-force-9-eula-and-privacy-policy/", "developer_terms_of_service_url": "https://taskforce9.com/task-force-9-eula-and-privacy-policy/", "publisher_name": "Good Day Studio", "support_website_url": null, "website_url": "https://taskforce9.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "212242311543834"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1195757382540854"}, {"status": "PUBLISHED", "id": "2190037521407534"}, {"status": "PUBLISHED", "id": "663734459608853"}, {"status": "PUBLISHED", "id": "768345085843625"}, {"status": "PUBLISHED", "id": "1247125180454711"}, {"status": "PUBLISHED", "id": "835201972136683"}, {"status": "PUBLISHED", "id": "1117800996793637"}, {"status": "PUBLISHED", "id": "592665989342506"}]}, "baseline_offer": {"id": "663734459608853"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1195757382540854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
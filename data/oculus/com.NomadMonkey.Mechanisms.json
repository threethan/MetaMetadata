SvwGZw&oe=6A106611"}, {"file_name": "Screenshot_5.png", "id": "258258963526008", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6kTxBr8n2MQ7kNvwGml8rR&_nc_oc=AdqMsuuJMU7FHvMI4lReFDFF7IjQDpaauq8zNDOmWKGL8o_jRhXu5OmbhAEO6gXRBd0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UiQ5Dis_4b7aPfiFZKYqhrdv6jMcPwnHmbzJ7C6Pv9g&oe=6A106924"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNnfm6m0y5wQ7kNvwG3gEaX&_nc_oc=AdrPDWj_VXieCBgDhynaMvdN6QzOgf_2YL-QeUMWyhm2AhOTgobk-pvmOhv0Z08b5RM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55QSOstmlHnDYCmRehSubRSHWbV7XmMMKTaa52HefnLw&oe=6A107BE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeDW5hYHAN0Q7kNvwFliweM&_nc_oc=AdrooTd97JJQfP6NYqeDYkftIYrjeVvC6lbk0qMVAu6pGOrEZ7fwtZgC-9n78iHx0Rs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af493kaKz6_JHlgPhDfEE8_6aL9H8TNh4Dm10EAzOKFoog&oe=6A1062A7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1PLTuXGFZAQ7kNvwEQs6Bs&_nc_oc=AdpH3dAssY_8clcc7RGpoiS27F3of8aLirEbl0Z-56CRuIqNyG4X4IZVoBiiVWmRTuE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RYveLu0OjxdHhql0xsIy6jSqHfoXE1MxxDuh_SzuKng&oe=6A107124"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
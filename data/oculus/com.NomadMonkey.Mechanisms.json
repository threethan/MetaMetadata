.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bu8bTcdd6UQ7kNvwEzgBPI&_nc_oc=AdoKaB6mAPth34BeFlrMySBcY2dEY68iIAsxnEa1IB-wqm2-BVzM-_p4hwXKbNcNIa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6pOcn_2sdoskqUcWcBeI0h6hZuHtvezTKzpK-z0-Txw&oe=6AB3F5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWPM0AUP3EgQ7kNvwFJiSBG&_nc_oc=AdqyA-Frux2DVaQ85JoeqCRA9ewxMQiBuMOK0QVkwr33jI89Smmh6LAdXLHmrUeMElg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZbw0uFMU2Gjf6CpYfLHWqFPao9RDuXY60VD5AYoh9sg&oe=6AB3D895"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL4_YUaEZjEQ7kNvwGp37fY&_nc_oc=AdrAvqR50nX3quU5fz4IAsnkmfGfW74PbYo4Gnp4OMcqF70M5kyLYjWuAusH79zaCY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZSiR6ElqV6_-deeZ-H2xSQg4bslzX1g2n3aOO1Q4vQw&oe=69ECAB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D1UF-V1URYQ7kNvwG7SH3O&_nc_oc=AdqjDW4L47aZt_E-cPuxAo1ULm1-lJFOhORbz9lucTyfb4OgfLX5VMHLWtueC1BbLw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ypnr9rWJzJLy6ufX-R-d8HBJhamyZKu-1J-YgKhKxLQ&oe=69ECC615"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
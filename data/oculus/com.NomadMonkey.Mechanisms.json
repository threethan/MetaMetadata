.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNnfm6m0y5wQ7kNvwErnvaX&_nc_oc=AdoKJSFeCKvM5rhQhYsqRSpzSvKQgb843C2JqcuFOIn0Cmhptf2kA0_Vq4nU_j2x1nU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-zQr_gx0EtbmKX47vTMW0ot6zmT3J-jWoyA8yLEb3lA&oe=6A0DA0A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbFj6SGmh0IQ7kNvwFVFhQg&_nc_oc=Ado3irqI_EdBN27ALSB5eguQZN_cWCCPFkD_0Gl20iAtOG3MJ0AyVU1npXNs25KugtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MVTgAE-XBZzwCPPTFXkAj3Zn1yiaacJX5coy5q1o92A&oe=6A0DBB95"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
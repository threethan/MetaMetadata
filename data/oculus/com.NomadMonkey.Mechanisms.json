.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1oCZJmC8F8Q7kNvwFtEiNb&_nc_oc=AdpCCuGYnOLTRCgCeCcntDdq4aytKjOeAQTKqZhvdLcIAKG6pjT3NIK8ctEJRXGULeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKlxzsjdsGLPHHEsJbmjJIB7xPXf9By5w9TRG_AN2peA&oe=6AE0C8E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txiA3yrWxewQ7kNvwHB8ctz&_nc_oc=AdrAuFd-5IhkIvRk8oj4CKxAKSuFhK_xDMK_Fq5i277BwRQ54WIsHQLrdtuD0Crgby0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSpYpeYpQC4pnyxXkQkokINPnSq6-6CoaZGkhT6B73NQ&oe=6AE0AB95"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
uscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IfXXrY5L-IQ7kNvwGsZ4Lp&_nc_oc=AdlA_ZVHPYCw-8dqKoqmPG3Y-9ss9yBbX7QlVozCutALAA5jZ6TFqdyhQ6qh-aSonPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9e0DjD0SHwzw9UzIAMANncsf7uHYNiafQTSYZ2ZqeiA&oe=69A6F124"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wml3F_bAI4IQ7kNvwECZPg_&_nc_oc=AdkbSCtm3AyKJySniKPZ3jclTmMYmz9R2hsOCs-HOddK5VsdhYxRzoXPRJsQvIBn7p8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0NMavITUeSp93Fpk78JU0emOHS3h_CszTzge9R1oOiQ&oe=69A6CBA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g96ZM-zJZNIQ7kNvwG-oHIR&_nc_oc=AdnK0jwwWFY5QObNCSI-NpKB-c6bwowTfkzAnCh6rxHCLWJf1HXn1XxuwBJJxjzRlyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsoo7d-d7Jqq5TzAA2Dj8D60WHMzniFyd9uXIAwk55spA&oe=69A6EAA7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQH3pkCNTcsQ7kNvwF10UN0&_nc_oc=AdmV4fkHzDrjE28g0qMJW8aZZKcq4YLhbyTnC4is9AsIac2Nvmo9DvVDilDxpkzUXo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1mUX7NASfmqy1er1RRFH23M6CsskdKpYz22WbCKzDtQ&oe=69A6C0E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1686
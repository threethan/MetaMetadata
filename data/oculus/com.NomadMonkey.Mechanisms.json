uscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IfXXrY5L-IQ7kNvwEYYq4t&_nc_oc=AdmXLTsIp4VXxAsNVc85aQY3P138IpV_GQ0P2cnE20KvBkQXgl36h7Nf8gjJDmnvnZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsdcjrmSZYGEoGt42FJosaqHHSHQ_IngkOzKQfA6Hi5hQ&oe=69A44E24"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06_0Mi_zehwQ7kNvwFlESDG&_nc_oc=Adlxf_uc9Uyb_bwWIdlrRMC61vdHOEW53Rj2yGinEpnsyb_GTObpEQC-S1ZaC1AdEM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afue9ob-vj2ltaKH04HGQmO3s1BH3oJfvJtmN6cVFqyQFA&oe=69A428A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1quIML8Y1gQ7kNvwGM7er3&_nc_oc=AdlHtmJFToSQm7cVd25cBN_shBZSmedpJ27U3IGdG5UK-2WGiOfaw2iqByunXifoVpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfupzlWILf6FMtMHuOpKfAqEZfvp9IUP6mfl4jyZ_EQdEA&oe=69A447A7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJpqS2GTCDkQ7kNvwFQXBoL&_nc_oc=Adn8r05gL9ZZV_vobDu_83-flcz72sSDp4TSrdunqp1u34r1tNAXTFAmqfAb-cJiHjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvd33IztYMRy-Aip4OYcSnXaID1KHQpPf_Rl03YDFp43w&oe=69A41DE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1686
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOENE6ywIJ8Q7kNvwHwXAsG&_nc_oc=AdqgM3VOOrZwkLjgYp_YgiS8aCYXAR5PTsN7zZegJnbUENvpC959S5CAA4P5wubDgaU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOC8UPX1oOqIvfnWT_ghXxk7Jn2CFFM2jj3Mwr2iw5zg&oe=6A883C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOYoatB90J8Q7kNvwF0kkUJ&_nc_oc=AdqUfsNOYmqSALC3GRyKhCI84XVN9FWZhHiqlig3UPaVf-KbN7JptZqIReWEExS1ylI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0U0FVj2OGZYPi4c3WEQMhnlgHoca1UOykpA-dFFGnLw&oe=6A881ED5"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wuVCKp1juwQ7kNvwHjWGfo&_nc_oc=AdpGEYYzjK48tlu2__zksG4144MDny_ZK69Xmy7yuixD9tMN8RUq6Ys-u5AAUDJ99oQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4r2fY_U0VTjSz__g50xcC40-QIyc3eU6CQlqq4OoRpg&oe=6A4FC3E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X94Ps7RxVrQQ7kNvwGMLaLN&_nc_oc=AdoJ_GiPeyOSupB-Es4QjhBJDYp-dbmQqsOo828Armg2oEl3UhAvxAf0VrnNB3J4jCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyuWlT-p_Vx6_5LfUlqmNZ4gq02f9pL3HfGJzxXWr_uA&oe=6A4FA695"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
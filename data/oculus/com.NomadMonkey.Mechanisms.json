.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaFMlTV9y34Q7kNvwGTzP1w&_nc_oc=AdoHXBZlsEd9Ma6EoHmeDxjkwMLrC7Eha9G0mAlkZ9GbDgR5XL-Mea2s8jD3tCxXsDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl0Wz4Sk7MgH_O8vtqNfQmO1CC28-KPJ7FfbSzBfm19g&oe=6AEDF7E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8B03gIc7eMQ7kNvwFFhTy9&_nc_oc=Ado2Dycormdlgao2UZh3T-AXmfRUHp0-4c3cWVCru9wSMaE13u1ZU9gE2ThkrknTlrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8jiBr72e9UUC6rjCz55qTsc5RoVEj9UWvUfbSTN6dfw&oe=6AEDDA95"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
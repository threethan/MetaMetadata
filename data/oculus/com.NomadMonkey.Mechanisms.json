.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYSX4lRr2Z4Q7kNvwH8-Nzf&_nc_oc=AdpZy8u-q_vEtVucYVrq2U_896J2zAWXxrLZNOUcYEkP8u1mFqyyXcALpa3uniJpdN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx_owY2ACOi0zjqoNT6KD8TMiR2Dq3KkUPsq9z7M0Mfw&oe=69D0FBA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bswkZYMIWCMQ7kNvwHmVaTx&_nc_oc=AdrviKx5KONoZE93GnMWinWq1lpiZLZ_sszmfL-YmC9f6IONZadYDIB12UjwN-XEDko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHCXKK7xDGMDQPvviMEsYmkBPvbNdng9Ldc8iwCloXfg&oe=69D11695"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
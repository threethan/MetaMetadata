.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q3GzGKa1ekQ7kNvwHscA_R&_nc_oc=Adq2_czG73mqTB5VAwn-MHCEuWLxethpi4O721c3aiQyIFqadAJeWPBBq48VUK946s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYIj32J7hpZbNAKN_xWNzoxf9pV08lkZmlYCoxhXuZPg&oe=6A7475A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggAjgvSmdwAQ7kNvwE59vDo&_nc_oc=AdpS8C638uYtcWdiJWetcdSVI4zsjx8Zs7elfR694SMI8a6f4f_q2b6HrDaDViJF6qI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv5-x2tLnTCwkJdSWXMqUe8m9qoPBYQFnaSjTHWmNDGA&oe=6A749095"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
MZsoVQ&oe=69C3EF11"}, {"file_name": "Screenshot_5.png", "id": "258258963526008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCm97DI1QmsQ7kNvwF_hLw5&_nc_oc=AdrLciSLVVHOw0X3_2embtPhmQXzYjydDzFvIiaTWSzm3Q6-IFY0V0fEEUCg5H5CNuk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzo8sSpwI9E2m_4V_x4MslVoBUyOvjtfK1PkH3tU9_wQ&oe=69C3B9E4"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygQ_QnVSGDgQ7kNvwGFsOOZ&_nc_oc=AdocIt2wtQfTAHkIaMCcX8HzbQkJ4Ni-jjStAWSmFeMAANIVLbxdiZbg_wYn1xz9eRs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWyUMfSDUQqrVeY2asW_60LihJTuQD6wQBBt9_cQksjA&oe=69C3CCA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_tCqNPINF8Q7kNvwGJZEgM&_nc_oc=AdqRpXyzX6TgAHPDcoHwJYdkT5ZzMdaAbnwf1NZVO0lrTAzRbDC0pkE84NwGk89aql0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3qafdrWCqVSzKwnjOWhAGpQADo8ZRALbUm4efsaTTfg&oe=69C3EBA7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBwpQEPJ-3QQ7kNvwHtTjHW&_nc_oc=Adoo0R0mxZC2hzn7lWaKJm7Smh6PODYAOs_qN6IjCkBcEC3pR7iJ44c3KJ3XPUyGFd4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj7zzDq5rmkkAS_YyqAkgZ0hCz4F4a2UnmwTB7Rfl9lA&oe=69C3C1E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
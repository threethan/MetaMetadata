uscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjxRObZAbscQ7kNvwHgCDmM&_nc_oc=AdlwuKciVE0KjLR34WUWCWCtJKdC-R-mioNf-WjxTi-o9-FU_BPUATLTP-1DonsVlIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbiJod8_f8YZobzXBZkAahzhQnOM4gV5fcMPL1nRsC4A&oe=699DB6A4"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcvDuR2nal8Q7kNvwFnB339&_nc_oc=AdnGINyvvECxLVm6W3DKgLZU0IqicDICkTkF_VUGy3VldfVEA2OWY9sxCWU7kySUwR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1yzNyPrI4o2sW7Z9FO0l53DTG8PZ7djCnjyRneoKAlw&oe=699D9125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbgLEn739ZsQ7kNvwFdlKzc&_nc_oc=AdkfDyuJbcieO6n3fd4-jh1f9FpGX7I7npSOAQ1Nqst8MB7Cj1cHaJcBwDMq_PGQC44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftr0gAEoQAsRD_6jCKofD5USUUsnEIZ5EQRU9erO_DYcA&oe=699DB027"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wj3c0GyoU0EQ7kNvwG9p_HL&_nc_oc=AdkL1NUcZoM6ffD2BJKqlnWqzMwLonD7C8vFPkxLlOu_MhGHhOet4v02hOakqcmHTzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqA7dEmwSXNFVhwJPjbZ2AwCjVeKBsNeYd1QGL4S5WhQ&oe=699D8664"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1686
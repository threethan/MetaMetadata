RPhhVQ&oe=6A203811"}, {"file_name": "Screenshot_5.png", "id": "258258963526008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5TAtzLq1u8Q7kNvwGNss6_&_nc_oc=Adq92BAnBHkLKOlP3YVWtn0ST0EZEOvT9dX_3bx4aG49sCYP2fKGWrIhVSuVSBxFkeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7giZ4uONgTkQW9xssLB51F1nwIlBk7UL44DdDPxVG5Dw&oe=6A203B24"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rad-rf-dgqwQ7kNvwH5A0dD&_nc_oc=AdpnfYI3X_LcJoXLO1JEHYfBmAIw4uj3oUNTc7I4dKH_D8SBAh0u0Dw3beZqZUuMS8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af545Yplnwn7oEPUielos1kUsX52JlpDD_QshW9Rk8rSCA&oe=6A204DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndu_izvI3jsQ7kNvwFK1aVo&_nc_oc=Adp3C6G0kfMEXuZBdq76EdQRpupqjujvjvPsQtR6fwzddyf_5cAbWLwH9Js2olzJY8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iGXNSwn6O1sLHwwlQz2WTspKeNYxOPX6fXHBeeMX4YQ&oe=6A2034A7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X037KjlQ7cQ7kNvwHDvF0m&_nc_oc=AdqoZ-PX_cD81CVfQgH6AhzE5ukWmHFWdGMJjRzfptFUEG-HXNalST4VSMQaIbhrCOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g83Iq8eFVCHLidbopEEeRplRJbyaZybaaXVHXfsA90g&oe=6A204324"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
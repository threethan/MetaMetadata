.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-IGJFOWHJ0Q7kNvwGUpdv7&_nc_oc=Adr6Lkhc6tatxlQLkog-BbiCOoLzadueeV34dxMktcJINRGItVAet1ir_cTQ5Fm_LDk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZvZpSLFVs8hYdubv3RF5g2k3cCsfDwjzHa90GKK9-Rg&oe=6A171365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ftASXxITtwQ7kNvwFiO9aN&_nc_oc=Adr13hw6RHUtpfZk-BPkn31RQm1SwdfK40HjyNiqL3bZBsfkfw5C1vASLkVIse4An94&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oKjaOdAhMFzX0g-4fuFkY7fkO_uXGt3EF32qgdfGwww&oe=6A16F615"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2d_B87zzgIQ7kNvwFoX5ym&_nc_oc=AdpcYECblvd-97Ny_YthKRJQT610xSuVINQMo9nxduYdW39PiBdTdDpuLDplWgBIh4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eRdRglckxfgn8N17HmkZY-aUJrehldjj3V-f4C6czxA&oe=69D4F025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilS_4J5cvjIQ7kNvwHiGUT7&_nc_oc=AdrUFxLZd2POEHG1z96k5BBiOaTrcR3tHQJN10vD2Eih2diAdcjJnuZcjwynQrtHXh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04pXTrSeQfznlUHeSjqJXuNq0S2-U95kGyyNODlJ9l0g&oe=69D50B15"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
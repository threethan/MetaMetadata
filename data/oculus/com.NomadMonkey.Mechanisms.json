.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw6BHFDCRrIQ7kNvwH1nRnc&_nc_oc=Adoq_lpdoNUNX-b1bFwxHApB2j472fV84eiGebXV8TUdw9ojfAyzOVcEyhRIPr_XKk0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3HWJ9K1-hIsloQVmZzo7-LY67ml_Mm7gxCpIQeHS4MQ&oe=6A5A17A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CANmxg01wlAQ7kNvwGDpW0A&_nc_oc=AdrImb_ZGvPG2HO41fnLyqKXi226mmjnqzxZQ_K9Iyecem9NApZf69I89vulQxRsYbs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBel1CPmx3FzyJ6e7A3a3zq_YdGnDcJtfH0tCttvgRCjA&oe=6A5A3295"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
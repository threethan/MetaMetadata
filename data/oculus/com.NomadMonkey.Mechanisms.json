.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzkfAqm-FiIQ7kNvwGygncC&_nc_oc=AdoYcNRNKUytYySBWofBAP5YUH4A-SCXgbMCzFpUnCLIqcz-O5VuSwdvBF94Dhszfjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi-18HkPDxBzkqV3h9jhVSUYXPLWBgC0OTMeHkNjdDrQ&oe=6A7C5EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvuPJKbIJWQQ7kNvwG166Bl&_nc_oc=AdpyFEi4mUbLkT4W61-RGZ70U0nqyiwlt40MxGHZRrBNNBVSKdWNiUUZPn6fCrndQM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaPT4lhJPaaA5UQLfqFHkDKqAS2AGku8hBA2PV6xNMVA&oe=6A7C7995"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
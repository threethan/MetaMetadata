.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl5FK9daVnAQ7kNvwEYcDks&_nc_oc=AdpNJ5WrrAY1rxoW00fF6qEbtsmsGLMZzzsenia_5211LQ0As0n9-9G4degdFZwfjmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MG74iX_y9YU0ImF9hbtucdsge7cdGG8FD3vLp1KYtag&oe=69FB2BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MechanismCoverLandscape.png", "id": "764110168513308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_764110171846641_6491232908856313930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnfCATHfrcwQ7kNvwEKkNg8&_nc_oc=Adod9nR3ZDxTIxKEr2tb2y4PJfHqpf2kM5MQnPTJRfGAwCo5EVK5k5PgONtzkbfdJpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m2pnwTiXmM33X90eIGiiqp7ZieblYQuS7sqEQWNkjdA&oe=69FB4695"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve T
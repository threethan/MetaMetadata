e6vf2g&oe=6A452211"}, {"file_name": "Screenshot_5.png", "id": "258258963526008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031333_258258966859341_2025895060861390566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaDZG4wRop0Q7kNvwHOFGEE&_nc_oc=Adrq0SJSB1o_rztDqCKzuQFUCQrZH77El16fucxv-Ads9MxXw0HtHsvt0ABjbGPowrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ww1bFeFceXJAF8i4ztULWe1G_s-UhfcCmtEFwZuiYtg&oe=6A452524"}, {"file_name": "Screenshot_1.png", "id": "1141186123465615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031503_1141186126798948_2969020863239030497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs-lNOPhv88Q7kNvwFGkfay&_nc_oc=AdrXlLZfYxNrqVeUjC6A2oa7173osx8pAjmoz7-o5gllwFgz0tJNHmkvVKZnpfQYLW4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wk0jC2nRE__51034L4nbjfGuRJ6zfosRDX-7LK_tXBQ&oe=6A4537E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1450194279099949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974585_1450194282433282_3022546673964820815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE3YfYYsEOAQ7kNvwFCK87J&_nc_oc=AdpG-OP3QNVoOMIeKkRsu2Y09OX8ZUP0hLObCfNbnNTmxR2-wCeJzDG0USxKsqXNA6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pMupq3VXC524hpmkUJyAXPnTq5tHkNRUrVc7nWzugzA&oe=6A451EA7"}, "display_name": "Mechanisms", "keywords": [], "long_description": "Step into an immersive VR game where history and physics converge! Construct intricate devices using historic gear mechanisms created by real-life professors, in a stunning workshop environment. Players unlock the secrets of centuries-old inventions. With authentic puzzles, masterfully manipulate gears, levers, and pulleys.  With stunning visuals, become a true master of mechanisms. Get ready to tinker, experiment, and unravel the mysteries of the past. The workshop awaits your arrival\u2014let the journey begin!", "short_description": "Step into a captivating virtual reality experience where the laws of physics come alive! In this immersive game, players embark on a thrilling journey, utilizing their problem-solving skills to construct intricate devices using historic gear mechanisms. The meticulously designed workshop environment transports players to the golden age of invention, evoking a sense of wonder and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygamemobile.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25505997485729925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223483_310275928398831_7477001229791538528_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymOQp2SxovgQ7kNvwELRn7p&_nc_oc=AdpkcSNyERDZKLhb03lidVFtU1ISlBGPByw86Ps7WhBT25oxCbtYnzktDbqWpMNl0ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hgt5x4kK7TEvFGXakVfLHPwRobxQxG0AXIRwo1Hlcjg&oe=6A452D24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mechanisms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
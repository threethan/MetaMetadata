96429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wQqmBA6jVgQ7kNvwF4D33r&_nc_oc=AdrPFGhOhen6LvdKcZasvZGAhDicXV9R0wtbT1g3vDGkQ8zSoF-pe6Qx02JR_LCqmwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0rAyrET96XU89cI4YCbG8cbKAyVDBmbxNGo9U0nVuJQ&oe=6ACB962B"}, {"file_name": "Screenshots_Raw_3_2560x1440.png", "id": "742032705664355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303198_742032708997688_500542088959863620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mcgYgc0OJcQ7kNvwFC5KL5&_nc_oc=AdpTE9k_929sNU3pXR5YSO1ilmaNVoDCQF1sEH24GcBRRgcWCcJ0dWGrKBQnsu32dXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt9Xg44iZU1GTogUBvvcUtMg74zUZl8PGtnxgDbVuzmw&oe=6ACB9F25"}, {"file_name": "Screenshots_Raw_4_2560x1440.png", "id": "24320291490931113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830032_24320291500931112_2872659330642091701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06Y33h6sQuoQ7kNvwH7IBMr&_nc_oc=Adp37-LrMEy0rLzTB5-A3LZEVStOLriLMlGtffQs49o-qFoUxqHMqXASpOXws0R_MEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMMItfj0xOntN9saiaQRxPj99-SNVJyKMot_dscbiQxA&oe=6ACB9252"}, {"file_name": "Screenshots_Raw_5_2560x1440.png", "id": "746434034869914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299808_746434038203247_3401603558708594373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd6PA40yfnkQ7kNvwFPC7HJ&_nc_oc=AdoAVaIS38bL5K827FS8wJiRimNJ6psxAO-qqU7eRuBqO0zGNZ423nsfc2xW05ZY_lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW4emAHgy2TQWsgQts4wjVt_pXh7iiAFOqOTUQdm_Xrg&oe=6ACBAF49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_AppName_2560x1440.png", "id": "1925545418286666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_1925545421619999_3616037182490950950_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MILuY0w2pUMQ7kNvwEps90P&_nc_oc=Adpw6tnUWRG5bnq71DyXYpEUqa6GyCBDNy4fDFHZlCjml4uQa104UetyMelYmLISHyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_2mIsnhOU4kRiB6nJ7_OJnD3Zi4Knl2pgNt620PSjcQ&oe=6ACB9403"}, "display_name": "Difficult Climb", "keywords": ["Climb", "Clamb", "Climber", "Physics", "Simulator"], "long_description": "**Difficult Climb** is a game that\u2019s frustrating yet deeply satisfying, wrapped in profound philosophy.\nThe controls are simple\u2014just wield your hammer with both hands.\nWith practice, you\u2019ll learn to jump, climb, and even fly. \nSo, climbers, are you ready? See you at the summit!\n\n# Key Features:\n- Physics based climbing\n- The cable car at the save point helps you save time\n- Easy control, deep climbing mechanics\n- The more you fall, the more you grow\n- A mysterious ending awaits climbers who reach the top", "short_description": "Wield hammer to climb."}]}, "developer_name": "Resharp Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1I0DuWHoDtrx67RyeURza1uNKJbxhE_f79hQd7vTk9cc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Resharp Games", "support_website_url": null, "website_url": "https://linktr.ee/DifficultClimb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24812470005037706"}, "review_messages": []}]}, "cover_square
5V3eEfnBAdc4buwfIpTO_nvQpb8XEOaqM3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDni6SqOhLUY-r5UuPvuTT4yHIsj-rm0k1OHbOWVgih_Q&oe=6A579003"}, "display_name": "Difficult Climb", "keywords": ["Climb", "Clamb", "Climber", "Physics", "Simulator"], "long_description": "**Difficult Climb** is a game that\u2019s frustrating yet deeply satisfying, wrapped in profound philosophy.\nThe controls are simple\u2014just wield your hammer with both hands.\nWith practice, you\u2019ll learn to jump, climb, and even fly. \nSo, climbers, are you ready? See you at the summit!\n\n# Key Features:\n- Physics based climbing\n- The cable car at the save point helps you save time\n- Easy control, deep climbing mechanics\n- The more you fall, the more you grow\n- A mysterious ending awaits climbers who reach the top", "short_description": "Wield hammer to climb."}]}, "developer_name": "Resharp Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1I0DuWHoDtrx67RyeURza1uNKJbxhE_f79hQd7vTk9cc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Resharp Games", "support_website_url": null, "website_url": "https://linktr.ee/DifficultClimb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24812470005037706"}, "review_messages": []}]}, "cover_square
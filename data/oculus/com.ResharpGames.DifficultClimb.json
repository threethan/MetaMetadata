96429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j4Y03-M3dUQ7kNvwEXDWw0&_nc_oc=AdqXqnhMxVqWaLdCIX6JAA5Q5uvpEJXAsyFhYE4P97ZauuxjxkX8C1njAYKstZM7VVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW8nm_haWYGHrpfjllKKFgnImd7e4H3dk3X9VvtK2YzQ&oe=6A4911AB"}, {"file_name": "Screenshots_Raw_3_2560x1440.png", "id": "742032705664355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_742032708997688_500542088959863620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ_ISPb4oI4Q7kNvwEzX-bn&_nc_oc=AdooXFQDueMe5HCWvVjCbYMghNwPtSI2cG5iTuxFGsC93Yb5Ai0DqYrWnKTshpDJj0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF6Hnspl7_wCqRAlO6PjbewhDzYuQUfgUAK7HqEJ___w&oe=6A491AA5"}, {"file_name": "Screenshots_Raw_4_2560x1440.png", "id": "24320291490931113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830032_24320291500931112_2872659330642091701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksrmD8YsCggQ7kNvwEiue7w&_nc_oc=AdqIQT2GWRoOmqTU9n-R3dEYuWMVCqS-BmIR9iwCsS7TLg7nsczUtzQepXpboNrjZBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT_G8Umfn3qWG1GB9xDS1g6I-X51foKAdw_ijQ6zGN_w&oe=6A490DD2"}, {"file_name": "Screenshots_Raw_5_2560x1440.png", "id": "746434034869914", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299808_746434038203247_3401603558708594373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7Ia_ZSGPnsQ7kNvwFrDfDL&_nc_oc=AdrGgviof1druSyFPximdiJLD1ilYBjjKmgZPqydDqPizFsil7Qz61E2ojBH1KOZqZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwijsYq6IClv5nlCBI4LFsqFan2osd1K94jRMCQT6RkA&oe=6A492AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_AppName_2560x1440.png", "id": "1925545418286666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312257_1925545421619999_3616037182490950950_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxX3uoTDT6sQ7kNvwE5xC-z&_nc_oc=Adpf8vV7i6pPQxbTTwsFLyxHRgyo7akI8vPA4fsTzyoDz_DKdPH-NV_q7Oa6wohb_z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQY6h38U1i51c-MYbqkpgK6s08svTYE10zYOQ_ZGVqMg&oe=6A490F83"}, "display_name": "Difficult Climb", "keywords": ["Climb", "Clamb", "Climber", "Physics", "Simulator"], "long_description": "**Difficult Climb** is a game that\u2019s frustrating yet deeply satisfying, wrapped in profound philosophy.\nThe controls are simple\u2014just wield your hammer with both hands.\nWith practice, you\u2019ll learn to jump, climb, and even fly. \nSo, climbers, are you ready? See you at the summit!\n\n# Key Features:\n- Physics based climbing\n- The cable car at the save point helps you save time\n- Easy control, deep climbing mechanics\n- The more you fall, the more you grow\n- A mysterious ending awaits climbers who reach the top", "short_description": "Wield hammer to climb."}]}, "developer_name": "Resharp Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1I0DuWHoDtrx67RyeURza1uNKJbxhE_f79hQd7vTk9cc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Resharp Games", "support_website_url": null, "website_url": "https://linktr.ee/DifficultClimb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24812470005037706"}, "review_messages": []}]}, "cover_square
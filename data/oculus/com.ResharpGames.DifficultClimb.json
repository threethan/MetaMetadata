032_24320291500931112_2872659330642091701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHQG0ikw6p8Q7kNvwGp5xX4&_nc_oc=AdpZoiKNg4XznYbMW1oE-Y4NrfMg_wCCSBjAuv9dJFC2jD6SZQ_LAdXowjyDOcEJtNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1E3EajrtMuF85OtL0-f5Rr8d-Nq9liebPre8mgXynxsA&oe=69F35C52"}, {"file_name": "Screenshots_Raw_5_2560x1440.png", "id": "746434034869914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299808_746434038203247_3401603558708594373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTv_2MiIcdMQ7kNvwGLq3pp&_nc_oc=AdoyhCTMXpfn_RBzzmcTGAZvYj1YYb5Y88DT1cCbfaj13mPIP-Ly51AzuwJ-jd1qb_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FYKdPDW3K7vbsUlmDfwjfBsTEnkFxFQTt9dh1wCKHoA&oe=69F34109"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_AppName_2560x1440.png", "id": "1925545418286666", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312257_1925545421619999_3616037182490950950_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH2a8Z0bas4Q7kNvwFUvxXM&_nc_oc=AdqFsAuytHm6j39ndAVa124wcfOhlPSmLumPOKNfOyknim7J86dpMANceeFqsuLcNog&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33jKOHq9o_s2y-sx7DVAIyU3Zxcuy0uGfDxx3IW5Th8Q&oe=69F35E03"}, "display_name": "Difficult Climb", "keywords": ["Climb", "Clamb", "Physics", "Gun", "Blade"], "long_description": "**Difficult Climb** is a game that\u2019s frustrating yet deeply satisfying, wrapped in profound philosophy.\nThe controls are simple\u2014just wield your hammer with both hands.\nWith practice, you\u2019ll learn to jump, climb, and even fly. \nSo, climbers, are you ready? See you at the summit!\n\n# Key Features:\n- Physics based climbing\n- The cable car at the save point helps you save time\n- Easy control, deep climbing mechanics\n- The more you fall, the more you grow\n- A mysterious ending awaits climbers who reach the top", "short_description": "Wield hammer to climb."}]}, "developer_n
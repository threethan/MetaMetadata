96429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wQqmBA6jVgQ7kNvwFnhpva&_nc_oc=AdoXpnEyrGSKYx9qbYsc5vvcPgzz1nbb3qmhXenMWRPa46wI8A3jCFGtv0YPfpDA-pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmGVo4M0te1Cmyfjjuv9qPDAW3AsOQQvs0GxM9ujikuQ&oe=6AC8F32B"}, {"file_name": "Screenshots_Raw_3_2560x1440.png", "id": "742032705664355", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303198_742032708997688_500542088959863620_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_7rQN6qSsgQ7kNvwHikFfA&_nc_oc=AdpE2vN9VoZO2SGq-9yWewy1MV3xVRQU78qbDWXjBB1-X-wNdsNFylsAPlV4tsPrJWQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf7DE_ffV_nyzUaaFPGjEoX0g-KBVE3ptI7h2aYEv9bg&oe=6AC8FC25"}, {"file_name": "Screenshots_Raw_4_2560x1440.png", "id": "24320291490931113", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830032_24320291500931112_2872659330642091701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v54JWuet3rkQ7kNvwFQUjkb&_nc_oc=AdoX8fr6s7cnGRgZwvOXEkB0EXh8R2neMevXTVQK8KuScfLvmALiibvwRT5CsgP_njo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoX8Oy1tfN1j2JXv5WLNMYCTGBD2srkQnnyP21UZmFhQ&oe=6AC8EF52"}, {"file_name": "Screenshots_Raw_5_2560x1440.png", "id": "746434034869914", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299808_746434038203247_3401603558708594373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GaDyoDNJF4Q7kNvwH3jdQe&_nc_oc=AdpkIaDDrDw3ywk120lHfHiyw38gQBaFss0FImryhtXcelrzr_uDDRBZVRVwo5D_Irs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOor3TB-aPpR0WwEPCgXdc79EKfbHLRqsUacmlxC7nZZA&oe=6AC90C49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_AppName_2560x1440.png", "id": "1925545418286666", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312257_1925545421619999_3616037182490950950_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_72Il4TdA_0Q7kNvwGl2mo3&_nc_oc=AdoPFo7hbva8FJ0PhRf1oQc28hB1IAruooYQPBNp8N_IG4WJRXvsxxYoc26zy50pFe4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEMPqd4vSLRKEBTAnlTEmXzXsiEgGJGkTb15tGNBzHTg&oe=6AC8F103"}, "display_name": "Difficult Climb", "keywords": ["Climb", "Clamb", "Climber", "Physics", "Simulator"], "long_description": "**Difficult Climb** is a game that\u2019s frustrating yet deeply satisfying, wrapped in profound philosophy.\nThe controls are simple\u2014just wield your hammer with both hands.\nWith practice, you\u2019ll learn to jump, climb, and even fly. \nSo, climbers, are you ready? See you at the summit!\n\n# Key Features:\n- Physics based climbing\n- The cable car at the save point helps you save time\n- Easy control, deep climbing mechanics\n- The more you fall, the more you grow\n- A mysterious ending awaits climbers who reach the top", "short_description": "Wield hammer to climb."}]}, "developer_name": "Resharp Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1I0DuWHoDtrx67RyeURza1uNKJbxhE_f79hQd7vTk9cc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Resharp Games", "support_website_url": null, "website_url": "https://linktr.ee/DifficultClimb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24812470005037706"}, "review_messages": []}]}, "cover_square
c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twi5h-asRvAQ7kNvwFT0lyc&_nc_oc=Adk3Y_eRTq9UWyelOx7hJo2SZ9lzm3H_lcbceRH8VOq7N5m1GzvI7OcT9aE-Fg51Ps8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfywP_tkDwhSThKsJjZJMMgJ-3n_HXZp1dNdH-7kvgDCTA&oe=69AABC3C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMz3br2BO-oQ7kNvwGoM7Ai&_nc_oc=Adm5KW0vPVK11JmQJgYY0TESsShSCiunxm4Zo3qIfIsKve9wizL0ZI3dKTIa_MUcre8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdJo8DsC40jPuNGMZED6hkyE69qzVhs0BhJ5x9bIuMjA&oe=69AABEB2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SsPvNAxsWkQ7kNvwF22jls&_nc_oc=AdkJGu2N_vw6sGLKzTc23UrevgURaULTBQK73hBMlTw713E71ogN7VeMjF6nQJIAOtI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9dQrKsAG6c81pvCKZ1v-vfXhBz1lyycdXCxQjVlyj1A&oe=69AAC7CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcNTVGheDDIQ7kNvwE2LJm3&_nc_oc=AdlbMXlQDRdrxpZtW3Kt3_v-jq3aJBi-z1yi5JnickUZe7j9qcbU_wQ4q5Ng8BTkYq8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCrcfdv-cH9u92mOF-c9wT9ek6LDgsRUvf90vTZKDUuA&oe=69AAC283"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_da
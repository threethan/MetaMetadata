5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugqCbj35TkoQ7kNvwGYyd_M&_nc_oc=AdoKi4CyxWteu2J-urUWm7Pgjoz6kzvccsUZwIfua-BPk5-qbzxYu4QZKEHapnxuZt8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Z1S1rhZnReuEpWSIdFBmTccNM7g0GhATj5Oj3rrumag&oe=69EF4A3C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxa15ZnhuLsQ7kNvwFZnCM_&_nc_oc=AdoSh4N3y_RxIYv8wM_3uRjtKwb0bsz-vH2_WYcaJazzvSTOneWndlrx6sGfWCIqjTY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LEhOIR4evuMFkJic8JjXg5kNDFSubwiI_0F1fhOSe6Q&oe=69EF4CB2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlxKuB5KwmgQ7kNvwFL4y9q&_nc_oc=AdoHSeYOElsp3M8UDvr2UHNacMYrKsEgwEOarOKItcud4WLgiiLkLFNUYvzJusuWJos&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XbS4m7ng_4jFft_S0FiVViI4IVxKbvQXN8jkUeOxIuA&oe=69EF55CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1xyT4zyYTkQ7kNvwG1lODx&_nc_oc=AdrQiwNvh-AnXQ9JkzoF3ZoJ3G4-WmJtQyYjxLDGXgxGfrIDbPakIZZcTLp0FVKVt8k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29ikoXuqOOjdgqswRMcHl0DE9ZMkU-QKfp0CDbLgElNw&oe=69EF5083"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
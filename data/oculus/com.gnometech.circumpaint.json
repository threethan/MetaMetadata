5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja7iT3Dacc8Q7kNvwEfB90y&_nc_oc=AdoIOitZUr-6NNCnz87Qov3ONvTB0Ypm13GVrWNLA-CloQWkcmC89Q6p9moGHP_x_Sg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpq4A-0LODWI_EqnLIloJ2v9b_hP5BIHT0cxqhe9VviQ&oe=6A9AE57C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArAfA-Txv5kQ7kNvwHAZqw5&_nc_oc=AdrSgyipAslWgvEUivncwRuyqX_HC58JMvQS5xrPNDwrRg422Z1fnsBBwmSzzMiSwkc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvVmyYa_Ac-ywzzuQ0gM3h1HyrRjvdQZDCB-93C1k6Ig&oe=6A9AE7F2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WG1BfN995cQ7kNvwES_LQ3&_nc_oc=Adr8Gdf4ujw5Q7QRU4e4zY-FcVoyyZDKNzf7LEzyw2n2JQCHUvACTDLTc9gTjSjqQrA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInBWt6om0c0MyFkUi8t3o3UIp2BurLuIubYif5sixvyA&oe=6A9AF10B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbFe62TrifIQ7kNvwFJAUB1&_nc_oc=AdqoZaQ_J13wyPwgqujdhoFufBvnsUhnvYlzQ-J8hw3Fvm_Dd-ai2fd0mjfVYmcbWUk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQGXkqHwdmtLIQOFNP-eyRi621jqMoNE-GD28V5nwB1Q&oe=6A9AEBC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO5PndoB8wYQ7kNvwGuKp2y&_nc_oc=AdpkAxNMlNOXP5naZGOmIaWy1qv-fEExJmBMDem-9X7GyV-CoRWcqeJb1D0UBxWNHuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5FkNIkmtr1v0upQWAtGpEqmpJ4KWL21HN-uiKy113qQ&oe=6AEF457C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPcb55HhrzcQ7kNvwFjcZ-k&_nc_oc=AdoELTd1EO6WRlrCvG4UmWEqVPEVFLb1Zc7M2V4Jm5PO1kbSw-dBWyv-bI8josFO0mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQWi-hhQGE9fiIRabaAWecFz0GVtMsNtG9sCf57ruidA&oe=6AEF47F2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq29-yxfFTAQ7kNvwGKmRRM&_nc_oc=Adq4qThfhfZeDYJlFqMLmqf8OAbGB85_P_1GNvlugxxmh8r1DUDwvObCOmi6niAC5nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYHzs-IdCFye87LhElfksTNqK4s12ipmNbIJ7GhsaoKg&oe=6AEF510B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HJIVWL1BnMQ7kNvwHxKU0Q&_nc_oc=Adrua6l4-wrmlH3zWBLBTvK_SKhk4iZnkvmLw_9FUf-2PtrhOwv2YtGiDCJwgsjiWb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3W2W7TIq4SKNwUGw4Fec1xy3Ct3jkG_5tSaozss-D8w&oe=6AEF4BC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
12138835_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqfBEtXrHPUQ7kNvwG0L2l5&_nc_oc=AdpAd9RAkvy8BAjavPn306v52FBfq4ekpaR5gBRJFUYBHXgFh6a0Q20DbKAlHl_QLB0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCvUi5RI2pKubrNO1ddO0DeHuxRcriHOG4lqXtuW0pg&oe=6A8D7E3C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8whYzU8FEH4Q7kNvwGW_fZ3&_nc_oc=AdrUmvSFCVsyDr_uAMDvfrInhqIzuuFkS741Hikq5R-P_riHkSgGFVlC5tzcDA6U6K0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7eEm78u2ofbLraLjlOGaAqYLxcOjO2KEWo4s4uni_tw&oe=6A8D80B2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUdZVo0Re9EQ7kNvwEm7pxR&_nc_oc=Adq7op2TJROD5BBmmBdlm98KJ6D91iD2Bv5It9o4_nqt0pza5DbLUx4Sf3eVrsGsp2g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbzOhqoqwWtD7TYq6Osmk2kKVRSkcrLlAfvqyxPcEGsg&oe=6A8D89CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=661q_qb0MaEQ7kNvwEgJuN_&_nc_oc=AdqL-i1Nvqcypbw7EsZRHWv23A7Gpr5Nr_YOe4qm4P8q5rPThOAEFcLzho1jAOt4euA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnDaimZSjG1aj6_Mb2pslwTUOl57dgLDsK7ujEXce9JA&oe=6A8D8483"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID",
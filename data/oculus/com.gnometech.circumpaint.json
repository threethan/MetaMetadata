12138835_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqfBEtXrHPUQ7kNvwHdDAt0&_nc_oc=AdozVv7LbtpJklrJrFCdY3xdSHp8nvZmSsAF3LSTmaGNWrQiv5-IL1c1hu2Pu4bVudA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtA1TI1ZGAC3AErM77KXidwZld-SWVpNIkHSVXD6yaAg&oe=6A8ECFBC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nongg-W2vlIQ7kNvwFGGMLd&_nc_oc=AdppEcsNgDMPFWmNmfUJS_bm78TfTo67IlUqcJFfJG-bcGrli4k0RZlJly5d0uZ1goM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnKWOZyylOBx9Lgr4Fe2bEkVc5qYzlav6x4zQY1osFeg&oe=6A8ED232"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDHYhOvppf4Q7kNvwG6Hc91&_nc_oc=AdoelnI4UszCNEYBgDrHNtZ6oUuIvobBNGVKMysPlfFz1cY1sqLHfEg89_0fJ3dpPm8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHrsUJ4rfMcq6xmMoOqaqGOve2-pXc2Z2lkzx1oXx66w&oe=6A8EDB4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zan-euRGRYQ7kNvwEKomyK&_nc_oc=Adpxd6os0OgvEXcXqyqY4XhRJNwBUKw-Z7mpv73SZU15iEmMyTvVn_5tB-SHUdQbZts&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjqHNJ8fNa3caSnmdhRds_fhTZEYr7GIAx3-qskM-3FA&oe=6A8ED603"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID",
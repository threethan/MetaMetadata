5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piAoRwCZrRYQ7kNvwGcRadw&_nc_oc=AdoKb7tZm6OjDqCBY4Mz5GcJ06a2svQP71Tr2CK64tGRXvsXRszBK5mBh6uSbnyO7mA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFanjdo9e2A7JKQBDe4-k198_i_rScw35uypmdCfsbrQ&oe=69C3C8BC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo_7FHwsGD8Q7kNvwF7Aey-&_nc_oc=AdqzYdGDoZD3YmgeOVLbq0cQs_0ynCW6uSyXPnwC35N3xsrGtO0mWYeU1L4W3Zwq6U4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvdmVx-0lrTDR1bFgN7L3HU9kh0N3iShKbJeV08B5QoA&oe=69C3CB32"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K5k5-FAyUkQ7kNvwFgf_MP&_nc_oc=Adq-iVCkOI1bquhg2jA6Hyik3zKhlSVOvoIFU4BMfrJZXmZIE5lwQrjYPxVTNAew9oQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT4u3bO5mL-4rhqRznm0gOb6nSi7Mezhs_cid6JXJhjA&oe=69C3D44B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQLgqdzQfRwQ7kNvwHqqKRV&_nc_oc=Adr_P4uvSi0HiAMR7AMoYrd_glRyDdk12BWdhNG2CfqUNq3P0fPWq1Xq3P2rb07yPdg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb_4wY9UV_iwRKnXEsBTp1splv3btqy6d2dAVqUdpZuA&oe=69C3CF03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
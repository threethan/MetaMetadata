c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW_zUEqFlZEQ7kNvwFmWb48&_nc_oc=Adn8OJd_xIiXk8_z3_hnDMs_irm4OBSIuwFFEuQUNWdqlkVQPhkzuz7WIkgHggn-41I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_Bc-Nsi3XBAZlBDEA2Fe5lRtz5aRfHD7hdv_jDU7EKg&oe=69AEB0BC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVGdW0Iz5i4Q7kNvwG6qDyX&_nc_oc=AdnUKgyNPBA41YkO0Tac6EwCPFO9M2NhJeQwGfSEzmgr5MbYE5PX7sqTKxgwE8ipUAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiAmkzLifAWD_ODIs9nUv6D3Ek8-kw1RE3SN-Y2_S-XQ&oe=69AEB332"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKq4i-4h3d4Q7kNvwE_qfTD&_nc_oc=AdmcAv48k7_ucg_IQYcTI5vhBayAMgHNR5y1FKJJaCXWsxHTHqaZ3rW33yV_1DBh-To&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymSiGpcbyWpnL5sepZ7WJUmuDzrJBkt4EIm0GhyypT8g&oe=69AEBC4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O7KUpjm56IQ7kNvwHKhNPk&_nc_oc=AdmOVYIPZoXW-ueTmelXkC7DWbS9frQ_1WG_A2GioEq48hFIxAyZDWyOROcT3iFeq2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO15jWa667RSjweT2uM0f1T6p08kAS8oOlrctWjeKRtA&oe=69AEB703"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date
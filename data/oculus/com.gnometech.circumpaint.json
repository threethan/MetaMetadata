5AV8fA6u6CH0xF8UbU8YnZy4knw2OtyJEdfLiJhAh6rrBStWeAAIalkMEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afte1kBT8SnVXS1ISy7mn_0KFxQXW_oMPXeoJpaIwTIn2w&oe=6998473C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSuc2iE-r1cQ7kNvwFfg9Jo&_nc_oc=AdksVFtaUKw6-3kWGNdwaq5_LNcrUMDtQy9C2VrLIJhcP1J2y95vXWAof2vFLNGO6N8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft-TqXRBHt1ebxpX6pbIIYxJx2wITCOwxC0tzAkQnO_dg&oe=699849B2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sqUMH22SK4Q7kNvwEe9IHW&_nc_oc=Adnspzqhvrp5B4658S420gYIRRSEF6OpThHfP7xRtVDIB5WG0NH7nyaqhwumsbDVn9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvi3xCI_A8HV1G0gUqpxx7JS9UbWYh-orADW3QDK-UsjQ&oe=699852CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCeMUy8GR8IQ7kNvwFwOxTW&_nc_oc=Adn-2un7sjFde36kunlQeFU0x44T7s7wXDsajZecZpvj5oTk-1SEKSS4FpHrIZMrZ80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvtXCe233LIKN0-syvaSzp_Pm7C2jxqWl30KGsE3euK0Q&oe=69984D83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1459321200, "lastRevision": {"nodes": [{"id": "1231072823587927", "release_type": "SCHEDULED", "administration_sta
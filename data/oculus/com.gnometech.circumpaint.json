5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFwvHGC4k5cQ7kNvwEA7ApA&_nc_oc=AdqO60mGETslvMnaKGIFED343KWUb9Cj0xkTVLytrTdwu_wT-l41jnoWPEGOX0rbAmA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GvU3NHnrBnB9krJ5c7PZC6bHkn1LI1q_PWSovuTxi1g&oe=69F619FC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghOxdsjpj1YQ7kNvwGuw605&_nc_oc=AdpdW0cu5SJPVBk2sjPcVs3n23XbqJ4A2YQpXcWfgP38ar-Mzw6cIWdxSHTWA_PGFgc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NvMWZ6TAVPJIdc-wAr73kPskZ4fwOY7BxXUd8I-Dihw&oe=69F5E432"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQXaNYXoyAUQ7kNvwH05i2q&_nc_oc=AdoV6BrTxJRX6xhxtYd8jNQpkrdv3UdA5agXzrdWrKDgI_oUTLpi0uQV7GTCk8P9iro&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JlwihuUPNtQOOcnHqPKiXgYhBSBURDPesSQJLUoJhBw&oe=69F5ED4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqZzz6VODwkQ7kNvwF_0_YJ&_nc_oc=Adp8PPzhrqrIZEE9djp0ZoClNXE7UJ_hU1e1OF74OZVX2zqaFIGtLNZPz8p-qCeRVBw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ugczwskXFxAzZ4Fz9Nw9RP610E0hFDG09Jy_JSyWldA&oe=69F5E803"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
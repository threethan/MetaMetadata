5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja7iT3Dacc8Q7kNvwHTpMUt&_nc_oc=AdoMsflDbBkuaqqySUyKqzIzXeNQ7M1LQ16VyHWtDNlRn1O7uRKIR5YoByxf4rAYT_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGWTYSqv1wk-7Sd9yDDF5sRgrKXbmsVPt8LzyajGdmVQ&oe=6A9993FC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArAfA-Txv5kQ7kNvwFqUpe_&_nc_oc=Adrgfe1LywARkQLIKdJeqhzJzWB0w4Y-G2u6EF4OjEDHnzioW2MOv0kGDNSUHrrZ-GA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL02YTHV2gc8Fbx33UG_BKCBPKLU1PZFgyc5YU5OJ6Ffg&oe=6A999672"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v65FqxyrnAMQ7kNvwFKvEnI&_nc_oc=AdoTbSmRDXMSCgxw46SMR5x8aunJdxvRdgyBrwjEM22HehoEsMxDwW4GTA0SHz5hsrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRMS8lGaqhVAzVSvrUZyFWyq5lIs5oYvn4mQkIKzqKHA&oe=6A999F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liAnlw_z2j8Q7kNvwHs999_&_nc_oc=AdrjyzjceZF8VKpnlS1CUVSIBb_cmAkPBnQkQuiKvHbzya5NHv3N_30Z8ybpX6H_vqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIubmxUD3f41OdpjcDlZ_T9MDtsj-oCla0_6RyOo6a28A&oe=6A999A43"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
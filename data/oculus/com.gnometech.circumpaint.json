6XAxGP67eXZ4ZZaovl8QIOCh9B9alm3NLxOXBvdGxFevlbNP-b5Epw2Epw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqZb530FlBfQX7VvIQiRQoLs0jceVIHhmX-jtS5HWhLw&oe=69A424BC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuabXn7oHA8Q7kNvwEECUZ_&_nc_oc=Adn7JxjR89qpQIV0tP5DgMp1JUOILpaBUryWlg-4bqIvkq8BlU1wJXQNP9Ny3jPbsAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvJaPo4tWoijLKKZltKUOxDrl7OOivtYie3At6HHTlF4g&oe=69A42732"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK-LLmqfVJgQ7kNvwEqXuAo&_nc_oc=AdkOVTLH07of-I34OjuYBUv20T1TKRGoTKFBlWIR2LktRZU8TzYCVYo_Ygxs6I5Red8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvS-jvtU8nbFnR6vR_LGkAuop-FHZmmW66i-llUMmaQsA&oe=69A4304B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjnf0zD75BYQ7kNvwFcTPZr&_nc_oc=AdmqpSjQbbuHugJKyZe4UR-USS2PpaU53Bv94kjfBH0ZBAsXQDov3UQFLyYAoIMOLyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMxdAwSfcPRCQi27W-jiXtLM8Hg6T_2CpfPnyxk6VYjg&oe=69A42B03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1459321200, "lastRevision": {"nodes": [{"id": "1231072823587927", "release_type": "SCHEDULED", "administration_sta
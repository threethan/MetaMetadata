o1KP_V8TYlTcSAaVtggvjMiFMk_34r1_m53SRpAZjqyG7Lv_8xRyIIksLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftUrEmciYIQmFUORISvTqAq4WU1xaYuoxrTnEWLtgZYzw&oe=699C3BBC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trLBXGc3FN4Q7kNvwFI1QDq&_nc_oc=AdlKz7iHL0Mg0g3ltoEo5jYmLMwknGpRtTY-3WXeInXM-CHBMk2co-TPSbajRNJfXMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsT5gfOU4blM94qTEELyk3ODvYSMa8bs-uFRz-ZjUM3nw&oe=699C3E32"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtQZdm_aljEQ7kNvwF-ghqY&_nc_oc=Adln-rJfqxLxYJLs6eaeR4nBEjzEaPE-rA-30g3GKeBOj1q1N8METhbHik1GhUSVKuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvhfnWP8D_5GZGvmCGaGlySp1dlAtyAZbHwpklN4LBe0A&oe=699C474B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KzpgnR78JIQ7kNvwE2PMNl&_nc_oc=AdkTdQ8QhpiZ9JjbP7IzF-JB6VYJ0o_0EELX3OdxE27YF3Nx2wROygDLtZ01BFNwPY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsL8ujGRYHalnKLawDE8vqUxdwgBz7gYlfC2eHnejT8Jw&oe=699C4203"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1459321200, "lastRevision": {"nodes": [{"id": "1231072823587927", "release_type": "SCHEDULED", "administration_sta
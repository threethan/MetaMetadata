c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW_zUEqFlZEQ7kNvwFo8NWD&_nc_oc=AdkCzX6ENkRthQ_ISJFOTiM8QARN_KpNs7gibW_UZFl072cGbP8baizc8XJU0mEUhUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz30i5w8KlpN1SNFAMC2rof6T0EKPqBpdR4VwbWZGqn_A&oe=69B153BC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfBrdlTqB4oQ7kNvwGvuiem&_nc_oc=AdmI-x10fOKnKHIerd6b93dUoXO6-fAcG5wCIYE4Vg4FEBZEhYXbd9ayOPZpNCCXjnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4VbUE-d6jzoxXugjdS9vZseLaVnljeKQHlPMWQdv7xQ&oe=69B15632"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btjk7DF5cKIQ7kNvwHRpJmv&_nc_oc=AdlmOZYU74XyHheKVNu7zPxZ8LCZme2jgppMM70gsxLOQcX4PpTLYWFo_orai_FgyYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI9GMVDFZVnCui27ykdOi5rzHoTl_H9m1TX2RQcWbFeg&oe=69B15F4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LP38zFSTKkQ7kNvwFy1s3z&_nc_oc=Admtu21yHhNkmcoar2kj4oJNeORz256YO4w6oajLD7BmqNZJ04ItonhSwTQcZe4W6NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPnrz5fFGW3CY2MilIiFurPUrAJxikcypRP_Tu8_jr5g&oe=69B15A03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date
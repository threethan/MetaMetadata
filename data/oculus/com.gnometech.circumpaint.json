5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98Y0LhPytzAQ7kNvwFZiErR&_nc_oc=Adq3SbBs5x01sUVbN5nUappojp4R7ASaKF-6viHLb7gHsCMKYgthLtPPtE8z1IrrgdE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBXfRKhWD_cZr2TGhCNTZksfN0217rrzFQg_4JbBRPEg&oe=6AF9D17C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3jtGcF3HksQ7kNvwEBl25V&_nc_oc=Adrv4DxwNdP5gw9rNyskwCvgRnmelvDFKld0qBVFjpuj5LIapWB6huTcN3dLjWC7ZTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLMFRLw5VVuD_zXCapTe98cIfk5saTXFthv_lBl7sg4A&oe=6AF9D3F2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b56yb6YWvxcQ7kNvwGoAGBb&_nc_oc=AdpqT7kqk7OgsnmrSOdxnJd1gUl5x81bQ8tBKB6mY3pl04Kx9wEqaRpzb8FQua6zR7M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAc8PTrqM4b1YXuPNx9CTiwPhhMBfWTP-CaVxUDIlEAQ&oe=6AF9DD0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XYfQXHjlNgQ7kNvwFjndju&_nc_oc=Adrf-bKh--vwgd9F3Fh58q3Ll2cDRV10oroZGM-A9gBKluNqFIldJ09yBVh84iZs7aE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvAxMiR8QpAaWn-oFW8UZIPc-xaEl4bz1KER3Hnty_dQ&oe=6AF9D7C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
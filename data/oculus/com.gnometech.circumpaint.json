c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuZtazzZeTcQ7kNvwFEiHuw&_nc_oc=AdmdTDG9oskdQWV84tQU2xJRE3Y8W3H-9IJiYdv8A-up6a7hw51eLvIPH9vo99V7nE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq_swlyGse7yVx1Pv_IIy2k9q_ztTNsMxbVYprg7V4KQ&oe=69B699BC"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCaDiBrSDY0Q7kNvwFGgm-M&_nc_oc=AdlvG8VzsSunnb6_JPfd-F2roLTk2Rh7Wlslp0F53xZBGVREtqhHdgNcSUMj57UrU1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSlTNfk_FdMsBvGWKOTRMLQY23Nd_czhxraaJC0pLx4A&oe=69B69C32"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtz1sx8mhAAQ7kNvwEkdMkF&_nc_oc=AdmmV1McvAcshuxmKNWbh56wLbCMqsDyv3kUTHI3YUu0QDeCEiUtv9jMPRkF926z_64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9Iq5A3kZ-QfL730ODBIJSKbpL2zvoqm3042eAjvV9qg&oe=69B6A54B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8iFwQS945gQ7kNvwHaRj_0&_nc_oc=AdkCH5BZc5oPwUQYOgQPhh-Q4_px7tSW2zD64K8Fo_IHTxGRqNeGGEiYrPoCAOLOGD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTHY4WocPYEnaq1E7-osdeVgN03axCtGt6a5_SabeokA&oe=69B6A003"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date
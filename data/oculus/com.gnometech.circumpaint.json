5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5s6lPn_QMsQ7kNvwFnBvem&_nc_oc=AdoqRTp4_hy0qk7tZXnxvhMOyT8NCRBm-1uNbH1wLlkaMj2OqYj9q_RRg5bzPISuFbc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmOldelM8qPnbk6yaZra_vCyOEBqWO2Pd2yG13jkH6dQ&oe=6A804F3C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzmdPiGlEwQ7kNvwHGhFa0&_nc_oc=AdqCIdFL5ngTQtKW6ZPKSWUPdI26gHO4Y5LXq4wYfIdcSZ5t-wGp9u9dCxavgu4tsqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJwjTEsEE7jQKSq0xKWzWoBUuF6pMpEKNyxWpP_BU6UA&oe=6A8051B2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQibiSphMlwQ7kNvwGqBk3d&_nc_oc=AdpOycz_jQxwyKnyZuUx2MWn_rY0YWzcMUQItTwiW_aTSMMb49zGk24wavze8TPtvak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJtN9tuHPR9pM996WJufcjxi-SlLAi83pOaww-qoLfEQ&oe=6A805ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT5zyOY9ZQYQ7kNvwFYIZhC&_nc_oc=AdomyH1qgT4ZzdABwqfcPw4aN8bPInjap_qpr0Pm763chFKcq2xDWmfxkUTJKHZKUs4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJNDVfhrAPoPXWbsWZ_09ZbkIywRTEBOrb5Vae3kYRzA&oe=6A805583"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_
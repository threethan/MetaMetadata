c_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twi5h-asRvAQ7kNvwFZD6G3&_nc_oc=AdmOcQ_TW-Dei1QDfDJMqG1S8ARfmDyJUPuZRwnZHZsIAKm14p8ZRHRaRdt88GAdv44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE-1JfUZUz0joHMpMQnHialTNclc-2ZWoNA7092hlo1Q&oe=69AD5F3C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVGdW0Iz5i4Q7kNvwEzTTqT&_nc_oc=AdnJciKDzlhagT8vtgJVBOaDdQkU1jzLpQ0CZrKPHvQUyktquw7nZT74Y-b-OcVstBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6ekNWH9eIoNQMbZOSICrjLsCG1Ca2sSYzueD1sibBYQ&oe=69AD61B2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKq4i-4h3d4Q7kNvwGvcild&_nc_oc=AdkpHGH2HxhzEANDyTCjU898vEX2s9kCHfF_icWa97v9lsP14EKAkAmU5NB3Wn_uDN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHZPzQtPTD7Zqo6CEVjvIylGBYx-gnMNoOMOOqZMs5kQ&oe=69AD6ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O7KUpjm56IQ7kNvwEOI_r_&_nc_oc=AdmnGynjFOWUXg9so6zgvKaLTJixGphOJDU5a3b-0Npg9vT9ewRgf1ycvGQltZSNH7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiIo5l_ppyrfkTpiq3k8fp_kleRCaJxvcHdkGd0NZdFg&oe=69AD6583"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date
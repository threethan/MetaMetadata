5_138871743172121_427903153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0h_Ze7dHGMQ7kNvwH-8EK4&_nc_oc=AdqIq_tiOdzQ4JVdXOKiKKT2IPZX7isCPuLAAVVYPyYSCRyJzaLc_MSWY3htNvEKw4Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Rujx86WgMiAvu0AySHFFxVIDuPApNl_b2jbUAajjDg&oe=6A46857C"}, {"file_name": "migrated_image.png", "id": "842978329514789", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12448838_565722626920262_1461928055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8e49J4HeNsQ7kNvwHKoUtp&_nc_oc=AdrhpuPkeaKNldeOzndB6ZKkKp_9yP2lo1fBrJ8Q0k88T5nI9blbatGXblif6d99ZkE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cnl2Iul9X_2Aix-K4tXg2EZ4-rdIQ28Jof5PcBEXx5A&oe=6A4687F2"}, {"file_name": "migrated_image.png", "id": "2758563970892907", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138838_1570418616610271_304446665_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbO8kzzJ9sEQ7kNvwEGwb4h&_nc_oc=AdqCVMSJ7puII5mzRhqnJgZCU0OCaSs88NiLQvqTP9VPN6khYKeaBdxMw2IsGlvE73M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SfoUZSH9kpBqu7th7Zeujl25zobxF8fFaBkxM-JO3HA&oe=6A4658CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circumpaint", "keywords": ["paint", "animate", "images"], "long_description": "Do you like to draw? How about animate? Now you can do both while surrounded by a 360 degree view of your art. Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more. The developer clearly understand the limitations of trying to paint with your head, I appreciate the choices that they made to deliver a surprisingly satisfactory experience.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n", "short_description": "Do you like to draw? How about animate? Circumpaint allows you to paint with pixels on a hemispherical canvas with you at the center. And when you're ready you can move beyond stills using page flip style animation. Uses the touchpad, or use a gamepad to access shortcuts.\n\n\"I ended up animating a pixel dragon breathing fire, it was silly but cute. It made me laugh and want to play a bit more.\"\n-- Brad Herman, Head of DreamLab at DreamWorks Animation\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.gnometech.com/circumpaint-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gnometech Inc.", "support_website_url": null, "website_url": "http://www.gnometech.com/gearvr/circumpaint/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "804494104407719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12448837_245889619076926_1879686965_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZT9HTpJ8TgQ7kNvwGAnSbZ&_nc_oc=AdqjaAP1O3DYkrobaWMLiy_TJ3_hWoc9VfVHPQCVvcfsEhrdRwFBWwDYOTHirpTWrJ8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_36ofZ-2I-aV70_9bELPg3pnD24-whwAwVIXt3B1Yz1Q&oe=6A468BC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circumpaint", "platform": "ANDROID", "contex
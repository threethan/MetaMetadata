C77"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyhsuBIt8mIQ7kNvwF7oNXc&_nc_oc=Adrs2zjsxD_0xRY-NcqzwIeXHa0TMkTWZ96blos0swj3ndYjAnQRcnfdIsVN2aUDeO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fX9iFV7UUTMQnbv50tbmCMsxD7CVNMWe3vfEuPTXoKw&oe=6A429056"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdwS45y0-DQQ7kNvwHSUBwM&_nc_oc=AdoJTPe9REWlDWqHMan-4r7mLo0BOZEXe32kLfYN72KNJd3RR5eSKnz9cHVjOTvreyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sqy24hzKJNGYvL20PP2Aw_oE6Qbc3s9YyAnvFlReijg&oe=6A427859"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To5Gj8kcUF0Q7kNvwG4dRM6&_nc_oc=AdprF20U6fhFBHyGz5HQEsfJPWPyMB8jmFaIvwCHJjGs-pgxHJA5c-2msrNW1UchY98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I5eUiTT61D3Iw65UXx4maqpH9lPsQqmtw8T28V_BMaA&oe=6A428EE0"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIO8Kw6XwJ4Q7kNvwEo4IiI&_nc_oc=AdpR6OKqRuQ5QhnGGY_3WcDIEmkS4obeKEAkQ8y3W8Eba2BoWoWk7BaYiCoVlXeT7Hc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z4e5oabaTRrGO8b9EktFSxFtD54WgyCKYmrzZvrAn4w&oe=6A42813C"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uUAmJ96BGwQ7kNvwG9_EnP&_nc_oc=AdpK0Wtb_DucQkmNjAdGfeMvEG1jaSra3_kgZ2WB5FWW6thCe6ReEHcXmC_nPhxvDD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XpWRNGcB5kiXjMApatFahr2ydQfytyZ9ly5Z329xZqw&oe=6A4262E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
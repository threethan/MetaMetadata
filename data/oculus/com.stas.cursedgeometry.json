dRF4AESc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVNATeJGBzQg7QtayhGSEMwxwlylajJFDLmnn8UR2Pg&oe=6A3400BC"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo3TGMpHwvwQ7kNvwHMiwGx&_nc_oc=AdoDGLpSKsjQR8yR5tedCgF_EBVieCyiAIDXqP9d_HxJWrGGerugz5b24fCfK7T76Ow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M5SDgoPgdjan8b5-1RdY-jYU9TXfGWRm_jItVIA6niA&oe=6A341AA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "su
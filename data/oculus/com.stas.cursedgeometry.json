FF7"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RutDhk6QOoQ7kNvwGaoxcY&_nc_oc=Adr8zE6mu4rmG0PCvR2bc3-pan6Motkjap54oozu3SMt7D5GsIlxXTOARzezjBBk1pg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uMv95lRH_9QE4yqC1jE33VqyV0ItSWUYfko5s5YfO6Q&oe=6A2983D6"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_JuzWRuG-EQ7kNvwFRhd-I&_nc_oc=Adpx0EsDRXETMN1hQrHQPm_yBkJSX7lUcCbwjDU2aQQnmZgTApxyx9QeAccywX7LuUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C4kEAewGlUNTDwbt870Qq5IEdY_l9sqA5FMPJiuz9Bg&oe=6A296BD9"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k9UBZwTk-UQ7kNvwGD5dHH&_nc_oc=AdpnGe2xUScgirol-ayWyJ3FHskueumJjr9qSiO9sBgwQCPLNL0jbsHqZB3p0sF-IbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ENLPpBEcygcHKKDSHzchRCv9V0L7QyiH-JOD_z5Rcaw&oe=6A298260"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prc8xhLzsJEQ7kNvwG1dqDQ&_nc_oc=AdoLorcuj6qQOz72ifHPBBX4skU_1ZTQOQG3VM29OqK4dWiA51tj6ixYMwZh4bxotkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Sfs7EtyeLVANho9diEvoPv-4Oo09TdVFzKbe11Xn6g&oe=6A2974BC"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOW5u866e0EQ7kNvwHl6eIr&_nc_oc=AdrOXvonXh_6xHfoWNUz0IgOrz2uSPX_2SceuGCMXSmumFyThAgUjJgPQgmTQBpoJSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F23L8uekLW59z2DBoIXNzngW0rQNkd6U2iaLYDcBSFA&oe=6A295662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
BF7"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7l30OhrAQQQ7kNvwEeLoWK&_nc_oc=AdpS_GsazobUvpb94SkVIli7ur2BYkXfAR-rhypGQUpl1ouZOEgYQyp3Se_4r76GIno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TfprPlnflDLvd7TJuiEhRhjed7Ghya4rLhsX31xRouA&oe=6A340FD6"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lby_Qn6f9UQ7kNvwGiqbGg&_nc_oc=Adpw_DaLoZg-s8h-Z-FPHe9HCDgUZWRtzMhD_-hdTx_dgORClF5v8T55lz84MTqLhfw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZJxpHKfyciXidfZ_loQN_n3L6wVh68Os_TpRCl64ayA&oe=6A33F7D9"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9AcFROuNXgQ7kNvwEec1iv&_nc_oc=Ado0M14OeTAHlT6lOBaYcMkaVddBuTRVnZjcKWClBiYursVui3tjbLY1bPp5CIiMGRw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82y63SJAweTPSP1udjYLfX-3gsVY-D0Dtase9vnoBMyA&oe=6A340E60"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT86nZLpSpUQ7kNvwHK9fT_&_nc_oc=AdoGXoVbm69nyyWKyue52NrZZXyZa__ZuJRX7gpqH1H3VRQC4GSSHhcUwlQdRF4AESc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVNATeJGBzQg7QtayhGSEMwxwlylajJFDLmnn8UR2Pg&oe=6A3400BC"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo3TGMpHwvwQ7kNvwHMiwGx&_nc_oc=AdoDGLpSKsjQR8yR5tedCgF_EBVieCyiAIDXqP9d_HxJWrGGerugz5b24fCfK7T76Ow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M5SDgoPgdjan8b5-1RdY-jYU9TXfGWRm_jItVIA6niA&oe=6A341AA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
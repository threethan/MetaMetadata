CB7"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9m_ZtSZzhQQ7kNvwEodmFe&_nc_oc=AdpQFFaTSoRGpW2Nu5QI1whPXe-vlnUDyocFHc5GQVRpuHhJ2W-EZOv41egDfd4mIdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnp7zj0WI9jiq_MvW1-RafuC1HhyCkIsqEEpIkKPx5PQ&oe=6A902096"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeQCLXprVioQ7kNvwGhg_e4&_nc_oc=AdrgTzlIVOwV3EQUfwd0T1hQpZ4k6eKBQ0y1MufVtnmyUGFjILCcyiUM-q_BasnRS5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFAWSxtSzv7aJyz2KTpTTdGvAt9s4etoOvy1B0PSiJOA&oe=6A900899"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JNBUU6plDkQ7kNvwHIca-Z&_nc_oc=AdoKL7F4OZdNq4EZ_aO857aNY1VRzTbBrw2lC3VCk798PD631qoHgLettWm-DqvBO_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3GNckRrSbSVAPmiDrTJfs-hDcNCVOs_VRL4zTLSFBJw&oe=6A901F20"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtCT88TyJ8oQ7kNvwEJiAP-&_nc_oc=AdqWxpbwlmpcGLWSNK7bEFeLfyKV5abre3Pq-Pla6GAw3oxoH16SDeyAhB4bw0OhS_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1EPjASftc0tfJwDdpta6vGx8KYy9aKFnVugL25JdqQw&oe=6A90117C"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgvBJ6vxQKoQ7kNvwFtuItn&_nc_oc=Ado8VqsQWJiZ4crzTkj-OXm_LNXkGRAssnkZN0ffccQiuW6HNSzj9TBndr9itKAjTcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHesVVajOlOCrvvejWHfhcNjb797_N8kh8wbG4ySEwRXQ&oe=6A902B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
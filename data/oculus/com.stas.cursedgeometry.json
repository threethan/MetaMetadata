content-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWqoGsRxLJwQ7kNvwEtGo0C&_nc_oc=AdoOkEDKuzdf9zszlDO1PENMQISWN-_CJ6fi7LCGtr47Bxhay9IIBdtPbFNl8BexSAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTluXmO1k1f_jfaxQ2mlrcLxPvxIo-cGaVmigZV7x97Cg&oe=6AFC7260"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iomOaRssTqwQ7kNvwG90tlZ&_nc_oc=AdrB-IpZrj5HPHFOy85r4Ubw97hWocihjgEfIxel2ukBAF5FuVoBDjcvJRp0sASIFyM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBnXcMx8Iyie64KGDPJrdkBdY2rZD86Ufz97rhWBBkvA&oe=6AFC64BC"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tADMkPaRRTkQ7kNvwFbgHna&_nc_oc=AdqdfOq13hye1b7sm7xotwOIY1Q6SWhAAcjEFHrlpyADUOlyHl9IUpPzqFKncuAkG5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwzC5MZil5AGy23NnzDC6Rt-tVK75t0iy2BjNpLtYYaw&oe=6AFC7EA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26773323395641594"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2483182298813596"}]}, "baseline_offer": {"id": "2483182298813596"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778533200, "status": "PUBLISHED", "id": "2483182298813596"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26
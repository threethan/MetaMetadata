CF7"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06qjRNVGVCEQ7kNvwGdzVsN&_nc_oc=Adpj3W90scnoMLnaySdQ3qBpMVk4YktwgiI7slwduQMAzsV6kqk8fI02GGKIgVXvLW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuRG9M_0keQXT2MK4PuVoyrd6nw7yFTk8JJiVGJEkOvA&oe=6A5110D6"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k-WE5z1WEkQ7kNvwHJosCF&_nc_oc=Ado-ORc8LBsXJbLaSNuLutDKeZIgHTsrNGEErPMufV1wNnxsi9JD2y5-F06_wJSgxJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB6Xjpown2BwvrOYJC9QQ3Clpf74ygtYu3LD5XwroXVQ&oe=6A50F8D9"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4MucwKF71gQ7kNvwHYrvso&_nc_oc=AdqWWcvh2xtYZlkmY3Wl2ERvnDrSwJKOQsi9gBo2R-VzhgzLlRbCyWjSoZ-tNp2NMPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzpzcfua5z1ntYrmGOWPU3IkfrIf66PYSiKlB9W7mjyg&oe=6A510F60"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D486Z1EtHRsQ7kNvwFdm8ba&_nc_oc=AdqoJbE5RJexNhCmv7k6jbsQaiWVBF4ATFdQ6LUy8pmk71U2lE92d2coILnfYRN_200&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTD9zYwX4siYSR1XlZzcPsdUOf3NizvjkUAYu15e2qFQ&oe=6A5101BC"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmDbXnop1h8Q7kNvwExporL&_nc_oc=AdoibVf6ItQQLqzS7hzDz6CSWrCpRdLy1P-DU2ccfEmyPCQbtBPqyg3VpJrdXcw-B90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlHeOfkBwxmgPTlCCbie7Btn_wlMsWvCZA3_xfJ_rWEQ&oe=6A50E362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
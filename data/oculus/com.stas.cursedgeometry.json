C77"}]}, "id": "1855137868463352", "locale": "en_US", "screenshots": [{"file_name": "screenshot_03_2560x1440.png", "id": "961404460089590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820496_961404466756256_3786759435069064537_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AhR0c-q9hMQ7kNvwFBH3zr&_nc_oc=AdqaW3GebBKAqjpiwGogW6fffkLbGu2Gth_jqCDEhsfIM41jIgzolVlo4mp_kenhe70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0CwTexaTtfRYwTjuUMIxfv6O5A0Z60p7q3GVOzo8_Kg&oe=6AC12056"}, {"file_name": "1000015976_2560x1440.png", "id": "971463185500400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_971463188833733_5431294426200999655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVENjn7mSSsQ7kNvwHPzDwj&_nc_oc=Ado2Kre2fPO_VDyZCeA_MNnSe_en8ccq4QWYya1iTh-FwJShlBpmdhFsRPmK3wr7N8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9k47CESMD97ACqcuYKbtj4tgPaUe-ZwRwHxkusnRMug&oe=6AC10859"}, {"file_name": "1000015986_2560x1440.png", "id": "961229580155171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_961229583488504_6832907061984328810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXDMEZmdRFMQ7kNvwEvF4r3&_nc_oc=Adq4SygbxZTIcZdwQNVIygCjzUxzSzp90pyEK-7Df67vOCgHkH3L7Ko1r83Uh4OjgCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR54kXDN8RFi0ISJol13-lidjk7UmPBH6QtWcHqLmcdA&oe=6AC11EE0"}, {"file_name": "1000015994_2560x1440.png", "id": "965679162990316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_965679166323649_1929560441405203356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9EfKva3iDoQ7kNvwHqIekk&_nc_oc=AdqSreZg51TU8emcQ5VTjbBIOFb8r38sUmiBHIPxruHREyCusp0VoFNeHCkdtwGAYlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY5DLcUmp33EL8oEgwPC1PA_G1wwcbWMwD55WdUnNJkw&oe=6AC1113C"}, {"file_name": "1000015996_2560x1440.png", "id": "3911251435846122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W444HgcnKVAQ7kNvwEHz9cv&_nc_oc=Ado7TBIa_VnvgxgIzQZed5w6Qfq08wj1L3H_g4wf-elpC2e5hPfqQBiFXHPY5Ap5XWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORv1ysPfWjgaR67ia1fUXrRPBYExzcE_kUFKkJ-AuYJg&oe=6AC12B22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
54_3911251439179455_8855863240273253345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVyLAWv7tY4Q7kNvwG7ramf&_nc_oc=AdruX4v0dhd3ztylIzCNp9rBtPzy2KbmSDwKeXuRoXskvQRXe2CETEBLEyQ_9hmUH4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIUVUBcioR7km8CVGYipTpMuohZVR6q_mN1QrhVKbK0Q&oe=6A8993E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Geometry", "keywords": ["shooter", "endless", "wavesurvival", "questgame", "leaderboard"], "long_description": "Cursed Geometry is a high-intensity single-player VR wave shooter built for Meta Quest.\n\nFace relentless waves of geometric enemies, stay mobile, and make fast decisions under pressure. Every run is a battle of positioning, aim, and build strategy.\n\nEarn crystals during combat and invest them into upgrades to shape your playstyle. Push deeper into the wave loop, improve your setup, and chase your best results.\n\nAs you progress, the atmosphere shifts with changing environments that keep each stretch of survival feeling fresh.\n\nKey features:\n- Endless wave survival focused on replayability\n- Fast VR gunplay with escalating pressure\n- Crystal-based upgrade progression\n- Environment changes over progression milestones\n- Online leaderboard/progress sync support\n\nNo direct multiplayer. Designed for focused solo sessions and high-score chasing.\n", "short_description": "Fight endless geometric waves in fast-paced VR combat. Collect crystals, upgrade your build, and survive as long as you can.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursed-geometry.org/privacy", "developer_terms_of_service_url": "https://cursed-geometry.org/terms", "publisher_name": "SkyStas", "support_website_url": "https://cursed-geometry.org/support", "website_url": "https://cursed-geometry.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgtzgZEpGxcQ7kNvwGaWHYF&_nc_oc=AdoaxkLtfTZ-mnYMY5siwIs7lHRRe8tHL_hlFy-vd2eAFqkcsKWMr43hxux101IkwJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XRtu1n9ecQDcYgd9563224J726VyaOqLaTBU4mfHskg&oe=69DF8757"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVmFRPbvDX0Q7kNvwGIfpu5&_nc_oc=AdpImKHEnGV1AhLcDR0cSsV6u73hJMVnKA1iFajBNpx5YxwwUqDF1HQGGeZMkgt97b4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ggLdtERvxo69DKJIYrWXMOB5uq7mEA8_j563P2cMvSw&oe=69DF8BA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Pd6p36k1IUQ7kNvwE4FFyY&_nc_oc=AdpPebr_RkqyeD1m6xBUP3b9tgHgUM_GL7E76tqGFgeSSobi2kLc-D8YjlkKEJmEU0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ht37ojyA5zKAdHUMzl57V8MAxntcxTRpygd3nQc77yw&oe=69DF7EA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5oDV5h550wQ7kNvwGhR1e6&_nc_oc=AdqY8zIuWGMQhvvMeqXJ4CudvYLUGJGA8zxMgeTbx0H9hx54XpvWOwlBEW-e9Uq__BI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OBH6wTGWKKYzOqt7EX4DxjxWD_r16zOgMdUcrFBwwYw&oe=69DFA252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w7w9hJzDwQQ7kNvwHrRP3p&_nc_oc=AdqWk6RbbX9e3PbgTF-Bx85-2aReF1vDWyzKOoy5aUYNpuKCowtTZdhUaWYzYMaBAjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vdLn8NjgdVLyfB-fnZKKQkLuFt4chG10zGCXZpYXBUA&oe=69DF9690"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
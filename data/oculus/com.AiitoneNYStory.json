.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4Cg-P9y0wQ7kNvwHtTDYn&_nc_oc=AdoX0ormkCYZWMkyhayO-e2Q5NB7isS5EWT9WBuNS9xhLaca1oqAeAa2gYhzFEMZhAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz-FlvvwV_1aJRtDGrsJ-EYF-SJhiWM3rRdTLAYIgl4w&oe=6AB51A57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_d8U3q57fkQ7kNvwH30PGf&_nc_oc=AdocthnRI1Scb9r_QEZktWtZy4zxK0RvdUpRSNh7GhE1WRsipGBAjcPyyQ_iYuMov3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWonSW5B-GB2s3R0HVaD1LmzMk66tfG0puCwBaJW92vw&oe=6AB51EA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlv6Fry-4c0Q7kNvwFqEZgg&_nc_oc=AdqMcP3EAx2vq8YQ_q4QmtYstT4g_gEC8A3gpI0s65l5Xdg9Bu0FrT78kdNpdLjqUdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU2PudAaCXW9Nhe3wu9JQR-68y4R2QrCd-SYHD40EYsA&oe=6AB549E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQJGpHqico4Q7kNvwEuMAJi&_nc_oc=AdqRklZ6yuhRFHEOybCansPsKdcoXQIqwihQNsE14jN_2NRiCda2Qs0R8OV6oM90Wj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKebxIJU3X3H18TEIU9L6PxXECN-QS8Ln4WOt80yNxBUA&oe=6AB53552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0cBbuE7z64Q7kNvwF3mt8k&_nc_oc=AdqzIWwMNpn_Rv7a75LcwOIAko-AKjj2CnrgvnqEZpKWv5gZbdlEdtfGvGdXc0LKyKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdFb-9ecuPzIvbfa_MR-kjWhvK8nsIwHAHwvc7OrJ70w&oe=6AB52990"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f2cq9RB8_IQ7kNvwFFLfYp&_nc_oc=AdpP106fKm3vYq8DqqORnRSGMahVFRwAEU2DDRwSwbppDUvzQAss6rbf0k-DivqPk2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3yGB82xixSV6op2VnkWydyXcQAx8zT0klgt2OsLuMOQ&oe=6AAA8E57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5Xz2Jaw_lkQ7kNvwH8Dhji&_nc_oc=Ado3QeZ8dGHL3--SUOjDBrYjyEUqo1gnCDtuHGk24yysSYJuHxO62o3RzghDXyZHOQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtrvYzL3xXUup7F7Gn4bCpZjGQsTSaWzlFAH_C9e5PVA&oe=6AAA92A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1PxKy8h2CIQ7kNvwEnmvQc&_nc_oc=AdoYywP0NzEhYF1t3DYJrOXUh_ci_TKyiAHCMtCojnr84PTwvOdl_HKS8VET8dzFVks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqXfVzR50xrN9uRkwl8FM6hD6ce_perEG7afZW07PEyw&oe=6AAA85A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLwCk9Ty7ngQ7kNvwGoMsGy&_nc_oc=AdocxBQCT7slzR8_ntASAUW5yyny6k56Mg_5Gs8Hdg_bHqokIFTxbmbvOtAXhXtBw60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbywRDFjcb-2ge0pydFk-B5YjDOu0vPE7jq042YWdq1A&oe=6AAAA952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=er5CkY6wlAcQ7kNvwFNVaWh&_nc_oc=Adr4EA92WkgJvJybGvrPwcsJQPruPj5PUJ3bgXZlTeEDbWb-_B3Ih6c2daEsJVxXnn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrz8bUVtpN89OPXLPjWqK6_b9B5nm2ttl4FQWEoPCpPQ&oe=6AAA9D90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
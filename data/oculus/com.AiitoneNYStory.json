ub825\uc744 \ud3c9\uac00\ud560 \uc218 \uc788\ub294 \uc74c\uc131 \uc778\uc2dd \uae30\uc220\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \uc2dc\ub9ac\uc988\ub294 60\uac1c \uac15\uc758\ub85c \uc774\ub8e8\uc5b4\uc838 \uc788\uace0, \uc21c\ucc28\uc801\uc73c\ub85c \ub098\uba38\uc9c0 240 \uac15\uc758\ub97c \ucd9c\uc2dc \ud560 \uacc4\ud68d\uc774\ub2c8, \uc55e\uc73c\ub85c \ub098\uc62c \uc2dc\ub9ac\uc988\ub3c4 \ub193\uce58\uc9c0 \ub9c8\uc138\uc694!\n", "short_description": "VR \ub274\uc695\uc2a4\ud1a0\ub9ac\ub294 \ub274\uc695\uc744 \ubc30\uacbd\uc73c\ub85c \ud55c \uac00\uc0c1 \uacf5\uac04\uc5d0\uc11c \uc601\uc5b4 \ub9d0\ud558\uae30 \ud559\uc2b5 \uc194\ub8e8\uc158\uc744 \uc774\uc6a9\ud574 \uce90\ub9ad\ud130\ub4e4\uacfc \uc0dd\ub3d9\uac10 \ub118\uce58\ub294 \ub300\ud654 \uccb4\ud5d8\uc744 \ud560 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \uc774\uc81c \ub354 \uc774\uc0c1 \uc601\uc5b4 \uacf5\ubd80\ub97c \uc704\ud574 \ud574\uc678 \uc720\ud559\uc5d0 \uc2dc\uac04\uacfc \ub3c8\uc744 \ub4e4\uc774\uc9c0 \ub9c8\uc138\uc694! \uc815\uad50\ud558\uac8c \uace0\uc548\ub41c VR \uac8c\uc784\uc744 \ud1b5\ud574 \ub274\uc695\uc758 \uacf3\uacf3\uc744 \ubc29\ubb38\ud558\uace0 \ub2f9\uc2e0\uc758 \uc190\uacfc \ucee8\ud2b8\ub864\ub7ec\ub9cc\uc73c\ub85c \ub274\uc695\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "Square.png", "id": "1050794265409135", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035428_1050794268742468_3680544553532420616_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE0MHubrnWkQ7kNvwELonBl&_nc_oc=AdrjPI5SLsxdiFoRuVPH2YRPLTO754D514pg9KYE5VEaP5H0BFEUmE-c_BZB4mOV-YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWN0Cs56oOytYM0_cGhtGUQFTt-l8aitFcA0x53zWW3Sg&oe=6B106B4E"}, {"file_name": "Portrait.png", "id": "476756833501511", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/
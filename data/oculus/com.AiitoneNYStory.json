.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITmwuStrfP0Q7kNvwHntO_U&_nc_oc=Adp6jP__6r-jMCdycMYQALU9C28jNwaTmfenJ6taAUAt-dz-BTH3lVsDc73_a8IewNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LTtKimeiVx1c_0smdTfxo6Behmg4Fkj-TU3P71lb4jA&oe=6A357117"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMzMofXNw0Q7kNvwHyA8Ld&_nc_oc=Adp370QAbWTxAHyfyQpFqShAOgTo9PFwqvCCBobPINoHRuSpMdtK-xB_41ERVBtjNsg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PeAHyZJgTNR2hVT28-KFEW-t6LwbQasCRydmTTj8ORw&oe=6A353D28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXc-NehdM7oQ7kNvwGKrBil&_nc_oc=AdoZxIJ_N6H-8oLuaRZNJMHK9fozkIBAPS1OjFeskgg6XNygOw8tEby3jkjNNNvB02A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ma13uJAQcqX5PWERdAesY0dndo1sXYyJaD4O47FBF2Q&oe=6A356867"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoAPuyg1qz0Q7kNvwFp0ZLz&_nc_oc=AdpFf2OldvjDNLVSnw9CdNhq9J4_xVIIFvH63fDdie1n28U2odD4LHCJnrhePQW5E24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fi9y-1voADLTewR1t2a5PnaeNUMm7tnFODGyAA_kJ5Q&oe=6A3553D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzumr0hmIZ0Q7kNvwH30dt6&_nc_oc=AdrIFPdeH2ghqaDPlX2v1dSb2rZwG2oEG_v9r6I6C3F9gtzAtOcvuDTPO3qkJ_wf11M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gthKqhvXKuMBnkXdaQe87E6YUaTpyvZhNTJPwI9XS8Q&oe=6A354810"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
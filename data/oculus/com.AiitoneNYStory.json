.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dblnwvCvaIwQ7kNvwEVnShX&_nc_oc=AdovgojDZT0vKvvPdH6HEebmmdFbOShWBvOABM8j33JTmWMJgvzoT7Ha0WPio37vx2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Huzo5XIkBIUlSxp6GpNAEnLolqGEBSsWggkO5oVhk7g&oe=6A3FC4D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Snjqq82sC0Q7kNvwGn833o&_nc_oc=AdonLz-qW2usTnHv5RM2vgF5OYpkjCeUB7jbdsnAD7rMFSZWZMLli8vu2taoEWGABcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p7lqS66YMb71dvmUGax1wSqF_XL_q-SEaR_TEQc7tqQ&oe=6A3FC928"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_C815nzK6kQ7kNvwGb8cwb&_nc_oc=Adryvg3zNfCv5OupJAR3jKVkxqNcl_fyO3taGGhDfIiw3TD1tSpsJxehSmF7jbQdvyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fYa72hojS9J4mCPqfsdLr2x_dIkbfeL1DHDzsgfWtUA&oe=6A3FF467"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WavCeKVay3wQ7kNvwFwN18N&_nc_oc=AdpzjJZz7T_XM4NciUtFVyHou4VzixNHJqmIqjKa9dJ7V5xngIHa6V1M5Xbd8a9PJq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_50r8PqgE7vLsnMOAmCFyYJMdpS1QmiV0B9nf3bP4m2w&oe=6A3FDFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhZ_N_KkWN0Q7kNvwFJIzCw&_nc_oc=AdprOmJ1fptzkl0fSzj6EbGCaNw70_FcQ4meXIQKvy7IEjMGgYj2KBTHw2ldGVDAL_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9On8uW3fThRMd8JKdXG6k94ZxTxjKOBzxw5A6S7MRwXA&oe=6A3FD410"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
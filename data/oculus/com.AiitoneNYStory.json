.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnTfT6EKQOMQ7kNvwFVo4q5&_nc_oc=AdpqxfQVHroCQvlsIuG6L7Ox3O0fjPv7Z7poIjfvdUdvVns4vwBiPCh6dA6hW1y_Vtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjYiQbaIBHE70ca1PG_t9ZKpyet_-lGoYJ6Ll-xtDfxw&oe=6AA699D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpCxbIiwirYQ7kNvwFATIRB&_nc_oc=AdojPfoi15zHZNaDftg13Je91aXa70hgwC-zVLXIz6Rap5urG5z-KgNERt48koqN5cM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpecM_sATS3bXq_DC2--F50T_Eq6BZHpHE7EDm7rOcVg&oe=6AA69E28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm-t04w7KdsQ7kNvwHaoNgT&_nc_oc=Adop-Dlkx0pkjKVsR1Qi_JkEauTcwtbFCU8EieFTXl-vfZRksLOAnO4fSJtyUx00Pew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi_7prvvrd9-oppNInRY5fODbOKGDkRoIsczS2TIPzew&oe=6AA6C967"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74sRy7zjsNYQ7kNvwHT7TIO&_nc_oc=Ado5ScwMHLeoPG989FkPWMuhp33fMVuq5JLLcOe62LzoKP19g4Zu1MmcC5KYPdkiRU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt4RQUIqiA8w73oi4j8mdnLI_2E46_kiHh43XNy3f5iA&oe=6AA6B4D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acoQoJQTCdoQ7kNvwFFo854&_nc_oc=Ado1Bjk-LuuYsIWlHAillMkayhuOcdhEymh2l1Lx80kI6_8bzx8GEPyTrRD4fpFZGC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMthlZySib2nmLMoAhsWMCH-RATpPhuzBAbY9w70bU7w&oe=6AA6A910"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
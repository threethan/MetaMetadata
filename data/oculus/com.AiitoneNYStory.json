.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn9uIUJSs6IQ7kNvwE6R3YG&_nc_oc=AdrtX6UYvguLRc1omDQYAotB1_SU3fLyMz9FsvX9t7hRl4SE9mVecFsO4sYKQ0VpsL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJLnSQhVJABW2MvEhWJ0uVPgWCniVm9sNC44HpY7yfPQ&oe=6A577FD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8FcfnwqfJoQ7kNvwHZC-qq&_nc_oc=AdqsccUDTdW1RfNDvIT4iMI2GAlE2syFGOS4yE4Jva8hVsX5dUCc_VXdmB_6n_IXTFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJaPhQcwCIPiwXSrPxm5t2H7KH5poDDspBzygaUZTSDg&oe=6A578428"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=941W-xx23nYQ7kNvwGjdZ53&_nc_oc=Adr9beEmxFUd7GACHDgWZVxb6NI0oGeFr-cA4TqgRML0hc9uysyP3dHFyZ7N-ziZy6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUkjeLzNHEsEiKHPjv5moEpp9FuKAB9uWwkztCxY7cbA&oe=6A577727"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB40XKesIxcQ7kNvwGTLM9-&_nc_oc=AdqxEidNDvSCs6tOZli93kTS4lidipPl6Wbll245r8fxvHhNMrA93qJoAQgloopGm60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7dDtdsy2CqwKnvfnWSab7bfmrkxtCA77rN5RXOPCwtA&oe=6A579AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYHboNZWkEgQ7kNvwEwYoF6&_nc_oc=Adr501lsGMNj8o4_btsWVkkooWcmjAY2Ly8FvTQa6EZsN_981oBDtbfvyzxwYU0ZvPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU6gjm1xgzNcjG_HTIPo5FiJX_yR16vwfQ_vrhlWO6sQ&oe=6A578F10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uLl7-l8GXQQ7kNvwFcxKO5&_nc_oc=Adm3dtLkYbraGtD3hRfw8mA1T4fMwmzH0oeM-mv0PvcNQpBOEKB2eMiFyNOBoC_Sdog&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvEGhNWg7C2A59RojoeaxWVxxp_HkHiFe8dy4VF5YdzVA&oe=69A589A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-NS9t3oTHEQ7kNvwGkgstb&_nc_oc=AdmaRJoKijqsMnkfJBjYyeJYw-6QEYG6SILjiw5pI16PbQhiOaFy67KPaT5TLf0v-vA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsc7TSiEIzqUdPJxcofrEprOyQcWmrOxtSflvgrstdtoA&oe=69A57CA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ECVpjAd5EcQ7kNvwFxt0tR&_nc_oc=AdnrbfNL6vFvbSU8pN5RsdnPMuSSM6lrNlUZ54K2YtXiKi1pKktfu1Jj32TQShIct70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvhKejedcLHg_V6lnjT1fT6tLbTF04Ixf7RnK6DtgHiFg&oe=69A5A052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN8z6Pw2H6EQ7kNvwEFdNjm&_nc_oc=AdkvC8I17awT9aka7LD5AdDOiTiaPs92kLecs3PGYgjC8AVBj8N8D36EX3gp67-oIkM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvmvT3-nKeE2zCYMDG7N-sfwWP-wnR41rhxA180BYQ27g&oe=69A59490"}, "display_name": "VR New York Story", "keywords": [], "long_description": "As a total solution for English Speaking Education game, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. With virtual reality technology, you feel as if there are truly in various places in New York. So you can move around everywhere we've implemented and do whatever you want in dynamic environment, not a static one.\n\nWe provide 3,800 sentences which include 240 key sentences and 720 core sentences, and Sound Recognition technology to evaluate English proficiency of users. This is our first series that include 60 units. We also plan to release a full range of 240 units in order so you can count on what's coming next!", "short_description": "As a total solution for English Speaking Education game, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR game enables you to visit everywhere in New York and feel the atmosphere of the place with your hands."}, {"images": {"nodes": []}, "id": "504845473867746", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR New York Story", "keywords": [], "long_description": "VR\u7ebd\u7ea6\u6545\u4e8b\u662f\u4ee5\u7ebd\u7ea6\u4e3a\u80cc\u666f\u7684\u865a\u62df\u7a7a\u95f4\u4e2d\uff0c\u5229\u7528\u82f1\u8bed\u53e3\u8bed\u5b66\u4e60\u89e3\u51b3\u65b9\u6848\uff0c\u4e0e\u89d2\u8272\u8fdb\u884c\u751f\u52a8\u7684\u5bf9\u8bdd\u4f53\u9a8c\u7684VR\u6e38\u620f\u3002\n\u5728\u865a\u62df\u73b0\u5b9e\u4e2d\uff0c\u53ef\u4ee5\u53bb\u6e38\u620f\u4e2d\u5185\u7f6e\u7684\u4efb\u4f55\u573a\u6240\uff0c\u5728\u52a8\u6001\u7684\u73af\u5883\u4e2d\uff0c\u53ef\u4ee5\u5b66\u4e60\u4efb\u4f55\u60f3\u5b66\u7684\u82f1\u8bed\u8868\u8fbe\u3002\n\u6211\u4eec\u4f1a\u63d0\u4f9b3800\u4e2a\u6587\u7ae0\uff0c\u5176\u4e2d\u5305\u62ec240\u4e2a\u548c720\u4e2a\u6838\u5fc3\u6587\u7ae0\uff0c\u9664\u6b64\u4e4b\u5916\u8fd8\u63d0\u4f9b\u53ef\u4ee5\u6d4b\u8bc4\u4f7f\u7528\u8005\u82f1\u8bed\u80fd\u529b\u7684\u8bed\u8a00\u8bc6\u522b\u6280\u672f\u3002\u7b2c\u4e00\u4e2a\u7cfb\u5217\u753160\u4e2a\u8bfe\u7a0b\u7ec4\u6210\uff0c\u5e76\u4f9d\u6b21\u63a
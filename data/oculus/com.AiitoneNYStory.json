.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxs_giApM9cQ7kNvwHmQA99&_nc_oc=Adp8iACO3W7Z2xeT0h6QkL7nnjVkREHDPAS7tp9oR_c6HA2pU9u3D7z0M4O5IUFzzQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHgyxITnSVLLgZ72g96Ri21UVFc1o6J0uGdi0xEUsMVQ&oe=6AD25397"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW5THgmt5UwQ7kNvwFDh2P0&_nc_oc=AdpyiSUnZmaZ2_NLSzrdcKhij3COLMw4T8748jqn4GwC91W3tHs3pNrWJDZPQfMawKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz-MDyZNgRY0GCW_UENXgTLQviFznqWNkPzcD8uiMVng&oe=6AD257E8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0A61UzU3KsQ7kNvwG9MYm_&_nc_oc=AdoBVwXeS4EiSgH-vBwEmpwiEOahIotDAVIoZXnegnX8GS6GWSX5ug30T_OhTKz74bI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfdaRG0A5AmzTKf4yoEsLJzd7JM3IjHe61QidXZUJd1w&oe=6AD24AE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWQ4xN0wmmkQ7kNvwHDfklR&_nc_oc=AdpL_So7m3FL-jpZ7XD9gNkehfoxNkY_GxQ-jVXGx6LKrb4Ix5yEtS2Pue2dX7bLb-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1OcMEbYyxCCcQ49mGRt2cULkPG4tjqG0QBBGN6GjJ6g&oe=6AD23652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K69s7oGkP-MQ7kNvwEHioih&_nc_oc=AdrGIqP2NrI3KAdiQ2WpzKD_p_uZdRzktPucaeWynHR9cqNj_6y6sQ2p8hk4QzaZT5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj_I8tdYs3SRlGBkrbOj5awWO5brEenMkLM6h8nCwJpA&oe=6AD22A90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4Cg-P9y0wQ7kNvwFv9PQz&_nc_oc=AdpmnyJ3NtXKK2WpvjrnzaOzeBIN3hy0RPPC-hdJQ50ew7JZROf3WdK6DdSEXTkhhLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTCrdAd04DWq741M55d9ghixYed9dWbsgJDBwbsPgFdQ&oe=6AB66BD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_d8U3q57fkQ7kNvwHnARqz&_nc_oc=Adpua5AO96Wh84bzIPYkkGs30zJS6M6HQ-YdncIcagk4OISkhbKGdS3uk5lEIzeV8Bo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1SQYEDEMqaP9333Hc1R100rqZKT1NytyUoyOMT2K6UA&oe=6AB67028"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlv6Fry-4c0Q7kNvwGNqPX3&_nc_oc=Adq7kLSdkdblxkSkHNIpN3WtvRSusS5CtpE1kc0tPby3EU8q2Dh-mfzzcxUmH93fB-8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-1JDmJgQWPzUJx9icNLgRKHB266jxiv-n2AC8_JA0Dg&oe=6AB69B67"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaT3i2FMssgQ7kNvwG_Scof&_nc_oc=AdoLKDDEYfORTyFOY83oh-sbdwLkSfqk-nod1Pu0v8FFxEXDz3xwI_76meYSEeAC720&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgNeZ5bjxEytz1faCndB62InlYCADp22qhH419Owux3A&oe=6AB686D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0cBbuE7z64Q7kNvwGDmiUo&_nc_oc=AdpDIyiCZF1UIEAh6AvykSGZWyRvi8vU9aE4VEFDZBn_QDmT-cZs4y71JHL4j_TXra4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8KdiMweU5MfgJTvZ0XoiRaexAZAaZlQTMDn37Sm2zaA&oe=6AB67B10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
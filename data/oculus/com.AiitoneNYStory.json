.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5vpquFxtC8Q7kNvwFAZUOV&_nc_oc=AdqfhLRLoehNyAQg3nlLINnLLON53xUQRP1z5SzKlLV8O8vdyx3ekq7oOGoqjXZ492E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyChUG7fQyvUXZF0AAw-zv6ceYD9NpqHbEohY_Dxr3F6w&oe=69C28657"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnmOFbB7R7EQ7kNvwF_uoFC&_nc_oc=AdoX2qkorQCDFqKmURuZXIJsgRpubq3j52LiRwXO2hKVF0ENvQUEzDcyUibiPclzsMg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afygxafj2Sp6Ev5JifUQqrosHU8fw8csIKWh25FtPx7X2Q&oe=69C28AA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js_jxdIdgjAQ7kNvwG0XAUi&_nc_oc=AdoRNdH1e2SJZddbq1mUf8Jdkd_p1osUe7ZDfhHk2j1tvOu8JbUxdCo3GlWO278pXVg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdilkHa0fqcJv1LNDIH83BA73w6eC0RgfmUSM7BVpLvg&oe=69C27DA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbPNIrfqAJsQ7kNvwFW2X6L&_nc_oc=AdrcOsK9paqSd3qc6gD6tkHfk980yHTNbq_A-keHOQM_JQ1W-OVrHuvlHc8A0tgk0Z8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxcsn_-EmruxVvaDhRIDqWFxVK2028B4N9-6IswT0uzWQ&oe=69C2A152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSJ05gTathoQ7kNvwEP4af1&_nc_oc=AdrEaxMeDrYRbDNpvkortSNPuyqiv_klcXoCNC2oKt2Gj49B_q9UXCS8ohgXvCf1Jw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzToNb65UP0eUuSJbfJ10bS4OeZXrkcPTyt1kcB97-ADQ&oe=69C29590"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9h7qBiCsWcQ7kNvwFZxmSp&_nc_oc=Adpxn2c_2gCM-L_C1ZtBFmXHMQNNuioBy48vcxtznCazAX7cd1az3Lnm9qimA6Kc0Z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBY53yyQIQByDZKxRFTqjr1Ogh4Ljajr4IbNBsCmC-5Q&oe=6AC7C797"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElnnP084758Q7kNvwFO-1WF&_nc_oc=Adoc4d0rREgQ2I12inJsvRvYI1QRFP6YeAiP3-I3-0zNwD6zW56xl_2QsMHsSneuSzQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM12aQlM8w9XTWQTOX7CMfldxMiWJJr7M689TIvm6OGQ&oe=6AC7CBE8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp99weHG9AEQ7kNvwHXc23z&_nc_oc=AdpcJe2DaT3vc2ibj-h5v9XbzHaK9pgI2RzHq4mJr9tzZeMT5MSJcAYZ7ffD1rVgzFw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpRcUvddes9Iu5TUU9nOQ1l5fHjjLt_Y6ZlhKoRhw21g&oe=6AC7BEE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD97KtPJCREQ7kNvwE5F1uM&_nc_oc=AdqQ3Imy66Gu-y6W01cGaqTaAlgknnKyXqIoyHzg2DxDQw9xhS5qKXrdHJPlHtC3dzY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyS0-vbezWAJhLtumUKodi7ZDb43ZN3J_JX__YARnFSA&oe=6AC7AA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LDg6Y7sU1kQ7kNvwFAkg8D&_nc_oc=AdrwOqs4_vtBTDZsEJyB6mxTtIjxvzpezphaN663RRbwAs9K5vlKeZF7QI9GuEtOVmA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNDk-uetrakV6kRQMwUa23SZkrLNLDNoiJ5do2LTOfdw&oe=6AC79E90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
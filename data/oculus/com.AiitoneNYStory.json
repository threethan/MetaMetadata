.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73yicqr2b7wQ7kNvwFqOAIf&_nc_oc=AdoFoP-vLKac-cTCuk__dSe2ecDiGbcA3ZARcRIowPnkzMF6mYP8WuNFDdArOyM6sWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFMkyIZzN-k2RwBCe82i0u3Dtp6bVdZA-dznMxQjbgoA&oe=6A787557"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTYRkuyA7xYQ7kNvwFlaGhA&_nc_oc=Adp7R-CJ2gim782KbkZdPaDVl2ZEsN2xbX6R3-ok7TV9WMVBjTtgtgWd-_DEYsv0LCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH45IVigf0lCmA9wtnj-vSm38YUAY6JGwObqlwuc1uQFA&oe=6A7879A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJOCLpi5hbwQ7kNvwHPlNIY&_nc_oc=AdoTInOP4F8qi4BDeaUiN8Hjryhd7wMPHN_nL9OrxumIzwHaeBOR_BgXo3sARnqLsQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9dm-TYGCY0cbsLLymZ4SsTAA3thyr_4UiRB0Ev1uG1A&oe=6A786CA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvGqQs-VVsMQ7kNvwEcyGnv&_nc_oc=AdrulTD2fCZOwvWlGdZ9a1mETucFKGFpZikEnIwweY-cJkSdK4nmqGY9PsPB0pA3GBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxWzoS4ldg3bVi8ORYFzST8XJd9ZBY6BB8dyTlPciuDA&oe=6A789052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4kkObXveh8Q7kNvwFttKa5&_nc_oc=AdrL7aSVYBMq8T4k-4wDaNVcOjlY4pzB3uEE9oAEO7NM8IQXtB2SJO6_C3CtLrCSdQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoW_tsKaUAhcBS0Sfmz_dJj71Ot-lptixwxT50dIHBpg&oe=6A788490"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
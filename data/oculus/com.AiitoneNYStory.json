.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwHzHkYA9UQQ7kNvwERCeZZ&_nc_oc=AdqtBwvsn2T8A0hihQJiTrybXmTECLve1SqV_d6RzyHLN3GBFOpquYIS3CkgIKN-TFY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAu0PJT_vEZE2JNcsvDfFnqYKV0DDMx7cSX1P4Yu8CpA&oe=6A81AFD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Fj3TC_hZIQ7kNvwFOXTex&_nc_oc=AdrFCAvFJYODXSuFJRTgKaWFGUPFPMdYlb5n2QdjJcyOvI0e2hbLNvDp6Xdu1CTVe1s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA9txI5JVnlM-u5VoxD4Zav1xQan6P_jPZZcBsJG_IDA&oe=6A81B428"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpU7kujdw_MQ7kNvwFLy415&_nc_oc=Adp5OqeEYWtJivYKC8ruhSOs8C8BsdjKX2XzuO0tc5dwprVP6CpHEhPGZwLzty8O0bc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkWysS1bkjXbVhWD19U5NSnV1N-hm2jAnKRFzXKuKjCA&oe=6A81A727"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rP-IuPGT-gQQ7kNvwFOqB3v&_nc_oc=AdrB8A5A98MAYwrqcQC3FlIbhSxG-fR7iXF25XNTIbpPlESSaElszJluujEOwFqESGo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGDSpY_W9ErdZiqT1pabvjunip7_8MG88weRXbhI09cw&oe=6A819292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWHAPWeCHd4Q7kNvwHKMfxH&_nc_oc=AdpUmP2F-V4YSREY7UU2lFaJLF9bQ1X03kEBAYYbxnq73lV6oQ40QcuU8E4OXxXrSb4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETAECZYrH6LZgYUR9hMjXv7a9fObzlzdhPUBLnskhbyQ&oe=6A81BF10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
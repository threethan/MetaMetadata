.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vKCdUAthsMQ7kNvwEQsGK6&_nc_oc=AdrzH5TAP8GeHv1LkXmjnfsksE8sWgutaA79KSlzu9zsunoSnoHcMFo64Vnn06r9x4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UewOMQ4BORLdxvi6wbIIChr9g3MUy5bYY4_mGbkTI_Q&oe=69E77057"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYUDtO3_9IcQ7kNvwGtXgD0&_nc_oc=AdqT6VOxn2l_17_422UYbYI09eDk6X7dDVpZDjYPfy_fIAVy1gfjnUcs6G8DN8F09tk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FsJ-emTZUxEVDRtaKT0sJO46jKsrAOrOBrBIKTEWHhw&oe=69E774A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ul48SbdLFN8Q7kNvwEDu2bk&_nc_oc=AdoRrTV8HTZXBfcvQkFmMc_AKmiZigZls0ZsrrMswPVie913DKpd7c-vpMcfmjRzgm4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bb6UtuUEM5EDenIQ14Ogh2GN_m0D5BRpTZMqEn4ZJBw&oe=69E767A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6YKO0V5BJ4Q7kNvwFO1kaZ&_nc_oc=AdpYSMom5YyFH1BE6mwe8czVEV_B-eZd4Ene7AxSrqbWwvCoCcNUyUTiEi9c8AD77Oo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QnAbPREcjz64IhEUp94Y-kKtZATNz7ILLww-SKtQeBg&oe=69E78B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6iSKFNC3UkQ7kNvwEhhl-B&_nc_oc=Adozm0cG_OKPHJ9-7WGwwsf3CsIUJebRBEv4T3E-Z5PzjojNs_3XYTrydoaVEmc1N5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PSykmIAlzzDgFZR6wOLXUFNTqR_PMSg0wD7cH_fYnZg&oe=69E77F90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
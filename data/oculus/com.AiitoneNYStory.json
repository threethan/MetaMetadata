.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YefV771hxQQ7kNvwH4J4_K&_nc_oc=Adq48tqUd378aYppuSwkQBk2AAlGtqgEtk9OoEZBqhHFnE2yNB2Gz8h8YZKDwbuCEoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tOK_KdtZtX4aOlzkikRH3Z9wIqkhSPa-ikqQhJqmN5g&oe=69D3A9D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4twZmxosv0Q7kNvwFgLLJd&_nc_oc=AdqZdcZGo4KvO9PVvPFyFCIxGgcdpR3oCzN44H7QQHJrU6M9A8FihlUz8txyLywnhaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-kohm1IRZhhUNGNM1QsHp8AHW6X13nYeO1x6mgbrhOw&oe=69D3AE28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMzxXN8PmB0Q7kNvwEx8GOa&_nc_oc=AdrT7oTV21_uwksXSoVMofB-kB2p8vq6gwgp96EgmRxEa2U5bG4-Khyves44SXW2QY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10y08O6zhYZ1yx04fUyd2n1n7BUc8YB_8O64sPdoYrJw&oe=69D3A127"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk2i5kXniskQ7kNvwGlEt-f&_nc_oc=AdqenVQEYQdaNMNNC0Gx9eZiqVXZwZwc1gWQFF-bC4V6oMTuh-Mz0UnGaa6RKeuH4zk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SR3WfQyj_QbZEFvl91-Zeb6kVPAGk3jKshjSK7_gEiA&oe=69D3C4D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP_3mnEIFicQ7kNvwE8_R3j&_nc_oc=Ado6E6i-mZHMThn17RL1FgiNHVhvuBPWjuQnxbuGqCnbvc7pA8Fmy89YWsjlGi4FK-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YXwNAX7wEUtULjeROI1RdRowxx3FsxohXG2SrYnVrAg&oe=69D3B910"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
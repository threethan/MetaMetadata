.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nA1RU6vskkQ7kNvwFhQhI5&_nc_oc=Adq7XwmfkUstYsTH7vIg-vuE_smy3mpbN6OYy5TNBut8cNPd9-7YmyKq_FxpuKaLHgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBHFJHE117Jl6DroRjfl9J_UzGJT3skvSBn9ZbtWk1JA&oe=6A538B57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWYRjQZcsJsQ7kNvwGy-SGR&_nc_oc=AdpeD_b1F_oifZK0CthBRBSZZdszulfcMD50yaW99dkxPnOHKU-SFJ58XYFGJYA9qio&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg_pN4HwHk9GPGW5Gz6D8X7UT0Lx7qAs6muNBbHYe8QA&oe=6A538FA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm63qBQqwhQQ7kNvwHZyRGJ&_nc_oc=AdoQCOlE76IWH9SCGxBW5a2D2ms-6oi2Zhyz0A7YTFzKXDSYNihc1SJ7bAJ2wxS7BPU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4jdEE-fnFW33l9gcrQn9K4ovlrwdAxL9qsyq3QWmQAQ&oe=6A5382A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOtAJPvJvxwQ7kNvwEuo8S3&_nc_oc=AdpkN5bFeLk-C35V6JRR3j_rM3g7RrtvjenMDYa9rwFAM8Kbv_FI_hDAqCh4-GhhtXg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDodg01ORXqGvlfQEhNT23wwN333Aqu0qeuBp1Tc2wRqw&oe=6A53A652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0KpMtSMmbUQ7kNvwHWtV9I&_nc_oc=Ado3Z9GUK3i2G3nal-FZUfTAm5spWR8QmsUuJsGUMhoemBwvt10oXw9RCCj4BG1kyTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT-EY3u2uuTvFQAGnQAWWSKtfSdzgXPLeXjSAgdvfxSA&oe=6A539A90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
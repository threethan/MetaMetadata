.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auv_wMdzM_wQ7kNvwH6O3u0&_nc_oc=AdpPWCwL1gf0eksZCj9JkCM1DleoUOA9DItNkR7g5geiTtBqI1tDefEEl6oNUsD1X-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCeyMx-amyhtD9Cy_fAPQS8Sbr8V4lgVsuwn7zdfyCLA&oe=6AE1ED57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9harFzA5p94Q7kNvwHgOxLi&_nc_oc=Adp375ExMajk07EUDRZnbitRqQPcODy2x0I5BOMD1A2Nx4v4-lyhrLYz2YnrNpDglLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvAM_x7ydS1VLWqJKSoPj235QN4afjydqhesfx0moHGQ&oe=6AE1F1A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR4InZ3n9J8Q7kNvwGzYatT&_nc_oc=AdrkUgv0wacoS02Bsgc8qWHjlxJn5cb4JEtRnR-NcyIm9dMIU9LBAOPdAuzBJccdxYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX3rtuR70KGhJM0J-CtGWSLD2k489L3rXMowjUAV9eVA&oe=6AE21CE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXUCHMR4zl0Q7kNvwGxzLkr&_nc_oc=AdoxcQAoNbs_SK2La-B97hA8CPY_XAW0fvEaZbMKxbFXvkqTjz5VYGogK3XHBJNgjrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3v5a-3aqUbXs7CQcU4khoUtXl7YI5_I6QvCl_-duINw&oe=6AE20852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGN-QCntGrAQ7kNvwERaLAV&_nc_oc=Adq4MUTQAVRCNrHjtTsSV2RnstcfPvtQhGfmtXfsgVFoFoDjHnlpE3w1eU5csYd1fkc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm7wnL7IwJU3C_0HwI4yt6CYEeJYh_QxAzWHCnez2Ywg&oe=6AE1FC90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT3YWmlDKRoQ7kNvwFP5qRq&_nc_oc=AdrSznqx84lMaTcHigs7-2N2UcU0LL1UVzTIfWdlm_NxYgp37sz1BaCfy1n_Qphakpg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESB41lxYZKT19MphWUhJLywB_CpCyE645MM8xFjKZdKg&oe=6A732F57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqW12nQ0vLQQ7kNvwEFBeGf&_nc_oc=AdpsFisJ74FjhOutXF22E_lwbveZN6wHtqKdK8icTHIzH0NfrKfo_Rffdrzcr9wuM00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW9890vCcW-vJHHvQ7UOB9CTqZ5V0F_jv8CjkGLeJdDQ&oe=6A7333A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaBThzLgOZMQ7kNvwFqlcAG&_nc_oc=AdqCPdS5H8y_pz67H0NgierhLGbdUSAlEtt-FXJ7ptvPrZzpBv_d_Zo5BWryu7dWkTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBcjpx6uhysB4sJRyP3oG6iRw2D8p7hLkOvwFw4TWu4Q&oe=6A7326A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYSloqm19_sQ7kNvwHqVc1X&_nc_oc=AdpXKqZIA-4-8oxCvJa4QZskYHDJcuGB55_Wgg8QsfQRK6kq5r6jEE3GPqR4gYOLuK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGACo95BewkYxrKFx0UDt7dk15v6PswMYpYqXR1lf_x9w&oe=6A734A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwK3x8z2FO0Q7kNvwGD438W&_nc_oc=Ado4PuqQVtxihhjcV6-INK68h8LY2EcRO9LYEKuUxyY580KBv3cRVqEAPsSVssX_m3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD0f9qU2GNOXEYE_H_9a0TqFCnqX630KUb8BlEzyCmQw&oe=6A733E90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
ntent-sin6-2.oculuscdn.com/v/t64.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3D3GQQUykUQ7kNvwGRePo6&_nc_oc=Adrdl8X4dc41mbGEIvK12cLpskF4Nx18VCG6LmvTfR2CBHcF0Hapw_eg0o7bLb7SzYU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8HQOH9XGAXUruAHxWKeQoF4SDx0I2riS6lPAU7jdQrg&oe=6A36C297"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMzMofXNw0Q7kNvwHXURnP&_nc_oc=Adp3v00UZwK5OHG8BlKeRrvPOtMDifLKRvbnPzJauXonK9pi9l3nhbGeTZx3Cpi1CeM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mTHwDRWQJibFDf8e0JWqU_IqmtsHb_g7P5Bm2G8XpfQ&oe=6A368EA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZehSbqH5KpQQ7kNvwFe5L5r&_nc_oc=AdqTyp_ZkYH5eAA8ldtunGy9ZQGHC6gKtqcYX7LZf6KNqHcekVSk9ROeUxTHqaI5W6U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0sEriYeyD4UEQQhd9FA2YYadaRi8WfUh9Gxx8Td3tww&oe=6A36B9E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoAPuyg1qz0Q7kNvwFUhVWL&_nc_oc=Adpv0Jt2ZcVL-5OsgiDiOS4PB9-B2OXmprTjRzm88uEZP14uMBBuySSIp9bo-0HM28U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FlD1z8D37MlTWjRatDluXBFyOcWscsJnNKtjOlprhAw&oe=6A36A552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzumr0hmIZ0Q7kNvwFUE-mJ&_nc_oc=Adq9Gv7WoSirp4zJuAK_TuX83SqvXvvKan5Psl4pkzeOEwUc1YIezT7gD4HCPEFTdrw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hYmKFQpdJfC8TJ0ZxLvLnvt1ZdWWXa_d0HMVheZkMrw&oe=6A369990"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfor
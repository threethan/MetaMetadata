.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blTir6-VZ14Q7kNvwENZKBi&_nc_oc=AdqvEwjJzfaFBziDTQMlePH1pqqIMeLAvV6NGAND984KOTRoJq3U3rOTx4PPzaFIoNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwebOwYFRPNIdKmXfvtMScMyhf_AhB_KazKLg-YkyOEQ&oe=6A985197"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQrwLIrM_R0Q7kNvwH1-SH2&_nc_oc=Ado4W4dW9rCERKVi0aKtnlQ6MFTRmHJsGL0tDXvMfWCPVaaxk9l9XEaUi44H2_YdzN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGboI7Ea4yRe9jg9iPjL0H_K17LkIur1eQK66m9A4Slw&oe=6A9855E8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQaa-NDPwdIQ7kNvwEWAVm6&_nc_oc=AdouYeTOoHQB7zUQLOOqEYtdx8YRdphBQ0QeqvoDRJFwQJpfOOWUvyCWdED8RU8YFio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsJNkcivAzrywGucqjwDDWqzObc_3xqpi650245VlnKA&oe=6A9848E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zprn66-357AQ7kNvwFnmBtV&_nc_oc=AdrmbZSJYClo2VLo7DtAklPcdAqVz3XModIA-224qdHAGMtCLOQvhyausal1kGeKsVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjgvTwYMMhqVMj9olQR8yEE4aUgqT6QKPg5-K9SQx3Qg&oe=6A983452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjMlywWuKbUQ7kNvwG0u5xA&_nc_oc=AdoMW3hLcgl2QQj8Wy3EvgquiUTqoW0seDhFqD53VmEGQmEeXOaYDrpQGuUbejt5gCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOFhefx9gDiZqnla9_sa6dnj5n9nWxOYvpf7ew400UVA&oe=6A9860D0"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
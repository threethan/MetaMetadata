.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88jsF6_YEmcQ7kNvwGhr3zN&_nc_oc=AdqUhTSbZF_rRJXG_oHiGKEWAq5l71X0IpDO3OSR_BaxfkSpFbWgny6mvqgq0C29NT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9mKaDGUiX1UAmzbeBD3ynunK4ohyssHOIpScNqtotCg&oe=6A620BD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8n9afjBp8oQ7kNvwGKb2QU&_nc_oc=Adq_mMqdMP5GVx70fBAgCpGrRJvOw6LefCDRStwq3pjJbsWYe8CvEHXlLkcmEkg26p0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDery10RxosH8yJmdj4aMTmMljEI4PtJPNpNymj7izesg&oe=6A621028"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk7B-EvbcEIQ7kNvwGekr6H&_nc_oc=AdrwZ8i4GeUjkOHpSnDe3oqa88fPbJhmF6b4psM72yDB41B3_VaevAoicOARrm3YVcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX1eMEaydtYmpx_upwA3P9Jd_kAY1xoz7mDqH9qm2Yrw&oe=6A620327"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=579OrgRGkPoQ7kNvwEbu0MX&_nc_oc=AdpoGKyb4RIJSkyZT2grc04rSLWeH8cldgosz8zkSRPTvJ6lJhWwpeD5zc-M57VWIUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrn28RGvzLui3BdALPxKUGe7jllFpdIKzyJZwSK19ZLg&oe=6A6226D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNlmFzlU1CoQ7kNvwEBGyKq&_nc_oc=AdqDQYMPNBDpX670KWajsYaogHg2cu8EkSN88T4OcgwC0ODKdOgWmqYfKz56qz1yi-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkC2OQLCKrGFv3jl16-Km__c9jO19G9G5YhNNVj9naow&oe=6A621B10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
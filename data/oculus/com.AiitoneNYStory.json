.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMzF4VK50JEQ7kNvwHSlnmn&_nc_oc=Adpr7zxFpeELepUHxxQUFnH2W_640i6YKDjZD8ef8RsyS9OtjC3tA6p8dhlHdfPxbwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw79oSyQ_8h_5J9bPagxIxnHN-tCdrKhcUBXUeDL_WGJw&oe=69CFB557"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJyfp73KmUkQ7kNvwGbD-mr&_nc_oc=AdoxgS0so2T3HGa2fbiq0EKlo111jLKvhkzbi2KoGqj-ULflizfc2z1ezRUfZp7rZiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJyb5rhrxROFOx0uouM0No_fCiOxQvWn8HVyLTuuWYKw&oe=69CFB9A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqnOD6dRDvQQ7kNvwGU7UdJ&_nc_oc=AdqL4_R2_hGC0ZXHbtHNGg9O_IHIVkG50VIj3cwDQwTUiWyJ100GMx93HPAXad3d_Cw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWH10BxrO1OMY0Ve6FLx0Vz2_hH587vFVQrzhsSF-I-w&oe=69CFACA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm597d3yhp0Q7kNvwG08kEU&_nc_oc=Adolo3EEnL5bJ0dXg88w6DGNPzl36_bNTDTmmA4UMlpU_L7xI5PwjjsiBjdvzrU6jGQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnCQZI7PqlE_h8hTyhAyLZY9A2UFFAlYDcDMeqCbUCiA&oe=69CFD052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VzifbRA2CgQ7kNvwECtbtB&_nc_oc=AdpjMLXOK08ItFJRq27N96Q0zXheQHN1tfiZtfxdSCCHJ1BXVAxlljCD2l7wtwIipOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4rndmsHFMoVInUpbJWcwHyEsHAmPajsYP40C4ZWsfPg&oe=69CFC490"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMg46aRKg2cQ7kNvwGuzKEq&_nc_oc=AdrB-ipCZIn-co9d0l3S7bxocJHw5Rsc0hH56Pi19wumn0gmLLhIB0N1tpSAN4Ks2_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd1ZJFfzckTrQCaHBe5dPMTBFcsIH0LPlDAa9VsMDVLg&oe=6A4F96D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqrbY6QIXKwQ7kNvwHNrETE&_nc_oc=AdrCSRMO6jClV_PucPWeo3qeg0P0XCHToe4Aj8crDZik9N1iS7xaCT7WYQhfewt0wRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfPxfoBmvQNnl26L7dfyJeLHET6-n4gQgCr-v2Rv_Pcg&oe=6A4F9B28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXWTlDlix5kQ7kNvwFPGnG0&_nc_oc=AdqO5VZTNAvCohoERwrDkux3zkZGG6Iz_rDHa06Gf5NfocjjKdBlqcz56JYOIAxxFFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgDzNlupEyDZsxu1i8g_Wp9q_VUf56Vr1j2XuRln0qkQ&oe=6A4F8E27"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkSFkDWGissQ7kNvwGWsUw5&_nc_oc=AdoAd-A_VLC6tZ5I3jtrOUKb-i8gty1yvSumKeCwXqJyAfaCLxVda1flD_fOQvWtAeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHpoonQPa6TuSfBKfPdDtk66kZnK5LxN3HoHWxLiwaLA&oe=6A4FB1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rChlfDZbHdgQ7kNvwGsSi6M&_nc_oc=AdqIlewsbHFUErRLdFkqMelfg02KdsBHCWUXmqTb1N0Bg_dyH7JxqKC3TRc1owczkVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqX1eRqDd0nSLzsCsN4HSPxvtu_tTPUh6yoFYH_Iqsig&oe=6A4FA610"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
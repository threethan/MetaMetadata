.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4CVh-a1SLMQ7kNvwGn9q9e&_nc_oc=AdpBLdAQmaGWkSE0zJUp5vB00lMiBlwlHpC3Ii6IhYFsovRzSUhI5cucv8fLk3REf6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vZGI8vna2N38bNBKYpJ0b84h724c43tpuxojw_BcPmQ&oe=6A1D7DD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-9Ifoa2tSgQ7kNvwEKf_u2&_nc_oc=Adr-3QPCJsALoax-P2XlMIiJ7DhYTiauqvolKkslA2PWYF52tTFiTShzHjW1gqTe7Ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-FEycB6lOTDBx5qoPd5TABGb4b11_BUm8zY0XNuaoXw&oe=6A1D8228"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxqX1tWHscMQ7kNvwGC7gD_&_nc_oc=AdrdDe-Pjc2CDhtYhfYBd3jZWV2rBsFzg7dYKqfRaUmnrVqZWiZZhRIVusrF524RcnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af720sT8IJwZ_-9GyE-20MTTHDiZkSFJjeS1SGwo7ydK7Q&oe=6A1DAD67"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sds2jL9YphMQ7kNvwHywgzh&_nc_oc=AdojI-0DBtp_NebfhtCrg62n9PU9GLzOoIBQaIwNWblUKYLxyCGj8pc5Y3UA5pZWbtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ptg_5MEXTvMnsdkkeN56IMHoudXs8K26paHxlkxG9nw&oe=6A1D98D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_CDGtOfwbAQ7kNvwE_fCl6&_nc_oc=AdoNRCIPKIfW7qMM9_EgINNHv0QQ0uPg9kRk84S0zMr3m5IA3N7gpQiOlDfbXwjBqHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TgVErAcaFJV7aYgeDX7ZAIHhgu1mL5Pb16F6xDg9-tw&oe=6A1D8D10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
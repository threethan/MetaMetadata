.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn9uIUJSs6IQ7kNvwGv94jh&_nc_oc=AdoO6hz57PHcCVSNWEzPRmRS3BU8vFII23-AhnR6vJazHNkUvB741pcOoMjKtPkI2V0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHMiAEeS44S2LDPixxXLvAxE4ANEAITg7OdlLCLM98Ww&oe=6A58D157"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nywKYIWyblcQ7kNvwGFeBgA&_nc_oc=AdoCyK1Ro4eG_hlqDgYa29qAA3YoVcfAOUNZe8g6q5hS6rSlMGlQPK-UiPvSWuFUGjc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu5BcKTxN-HEcT9_DGaL84nZU3EQHRc1XG3JVAVGLJqw&oe=6A58D5A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=941W-xx23nYQ7kNvwHfW3hL&_nc_oc=AdqFEGimuU3y8CvVPzJqAGrGynsP6b_OKxW_9pWjLkpV3kD0YApUZ1-gCsR3Mc1Q_EM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsvm9SN9otZu7vezNhRa0x_Fu2h4pURpWWS8n_zGIcwA&oe=6A58C8A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB40XKesIxcQ7kNvwEMsQST&_nc_oc=Adp1WcFKDe5qc3o1DJv9fGd1vs2LizOri6aF6M0aC-wuRsSYBdM0CDFsIyCx-NzL5YI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaQ9ripQ5N6MWSQ97qxtKwHbYGRXysKSJjRKnVHV4tKg&oe=6A58EC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q27qqMfSHgQ7kNvwGe97hc&_nc_oc=AdrVPI_LpWRHVTqcYcDVXtAoVYTf20_2CxFopt6ZHrDeKL6K2mevJulc0RsI9ZnIJPs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxQE5OEDSnjY2qW4gzrlQU0sNKEbSRTo4rz4k2CGhhYQ&oe=6A58E090"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
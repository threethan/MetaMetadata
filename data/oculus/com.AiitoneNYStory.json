.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2y2X_HXUE0Q7kNvwF1yHNu&_nc_oc=Adq76LnoENln5J1blRHPRf55kQcpKNySbmhP6C1d5tsbtGONZjinWsvmVyjDpo55uY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wsDN2UH-tnVzkzq2NswgOqakoFrlrOu4sAH4cWyk31Q&oe=69F9E557"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5i15CIPDU4Q7kNvwGztoNp&_nc_oc=AdppaqpGKSRsYhtW0DvJgzuw78Gn_59DM8dsm4pk9sVxcwG7UBKBm2TtFAjCIjYDZew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VZt6-c8e0bjX6BLCBPxuzm4gIWzh6Te2jBDclrST7VA&oe=69F9E9A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gWlUBLbj34Q7kNvwFOrjIZ&_nc_oc=AdpIWu6zoEVvHPZ6a2Ab05Hfp7jN8Cp51Bfuj-kUN6krEYUFpuvCUMiBlyXOF5oVi_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73heTk0ROGBEporwcfXwxHL0rrHg_JAitOqM2NHYI5SQ&oe=69F9DCA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vrQ0IngcJsQ7kNvwGZNED5&_nc_oc=AdpZq8R6Sg2rnt_DKO_W5n2o5nQJldVe7tp3gF94P7yRDupAdrjHD3sD8aKFGs3Xru0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TsYoiaP07JtLPeY61N2UKbhQKIleYKA_vwGojKLw2bQ&oe=69FA0052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzDlAGMoRLUQ7kNvwHa-P9q&_nc_oc=Adrgo6TEc9d-PXSzAUkWTnwFeObqf6KLCvEM8-hJBrNPsw24-WsC4nXCHHAJ0rSrDu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QZTD_V76JJ0kamqVvqHth5n09mzo6GC-z-WgLWkRAgg&oe=69F9F490"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2x_dFcpVP4Q7kNvwGndLuI&_nc_oc=AdrIMV0hd2Arxul6zNS3g0F8xXxiU6bgcBPurIEuxyiKcqJMJboHK_R6125TA89iu0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hcfd3cu_QWg4BzStY_2nhc62_Wp3Cs5QZ8md8VoNOlQ&oe=6A314457"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc7TJpNZ5FsQ7kNvwHweCBy&_nc_oc=AdptuPFhlJI1dZZ7z4ZfVAxls3Amp08jfJVSGT0UtDyMDi8hPCbmHMmAkq-gq9aJR6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0urqiZdb4B6AWh56T-sBteXhqBGUJJgyHY7aCEW3Rhg&oe=6A3148A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3SxM6EmRiYQ7kNvwEtJLFn&_nc_oc=AdoEaP3IeDQKNaxMSdDj5Dgk6jW8iqK4KR37x4PXCwGeM81YNJtX2eJeBRoybEfoiIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Abhyn_lyf020pXt50v8jOYWudX1cWkjcjQ0EQHW65NQ&oe=6A3173E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebX6GXsvgDwQ7kNvwFPGl20&_nc_oc=Adr0KlmH8vt7sUAkB2dyvXoW3KZ5VvwDOfXMDTm5f7p3BBulu_fh4emkKycuz0BfD88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zlRQ-9q3px2Y98qilfbspIHXcCHEq8OPH-hm1YDXltQ&oe=6A315F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5w4bSbkcJgQ7kNvwFJkPb5&_nc_oc=AdrA5_PwB3sM7Cz1DV9RgbCGJftH_BRN4Y5SRYFFF_nCUpczzHB4-1Vym5hWR_RRhno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rg0qsqG5dPcw7lG442_mjg_s8lAzAek0ShrWUnnIxkg&oe=6A315390"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
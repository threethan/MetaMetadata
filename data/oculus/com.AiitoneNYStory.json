.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TxkfaFeRHgQ7kNvwFwq4i6&_nc_oc=AdplWdHVbdVm57BcRtzx0o13_FIgSFTjBsNqL7scKFFqRJkery2VuG5PfScjKenug80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n_wjlV90g6uXS6Ej2gS9ec4YuQw9Xxf4g37ffZa3POA&oe=6A071457"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI-V_zlZQ8IQ7kNvwFFgNFe&_nc_oc=AdpKl2W6E5q16gNPh2sMj0hS-JifKMS7Gi0mcV0HMH_cvijKRd25A6SUyxvPc6ucJys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-vqFoYunpYzUIBt1SU5z-V-k9E1DLSPynPAtgFbej7Q&oe=6A0718A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR2OEUQeiVsQ7kNvwFQobLb&_nc_oc=Adp94cLH8raAmVFaPGhPx3aEE2Vo7_2OvXFWggVgZmwNBshGxpRsTHk93INmkCOd2pQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4azlnxRVBfWZEa7nyk0tY0mJXkHxkSg_DfEy242ZtG8Q&oe=6A0743E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtVP6gSx_XUQ7kNvwHWiDDU&_nc_oc=AdoA7_7ySeD9hxxcinEqJzg20hnCOs9acIiNFbKcG9knoN5ynv6SsqF51rA6bpJ1D2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lv0V_zCYMhV4Q3eLKm01yIfosgD_1_czOXzq5OBZ8mQ&oe=6A072F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_tVy6qSscoQ7kNvwH0BR8v&_nc_oc=AdpUIwC-78l_Kgxl20Y87IoNjs2ZviHZYfmuOimRFObH5sw2geYVhPNQXrhtno63qTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fCbCKrtgbAShLNNb58U7QRRXu2jC-5xF2ofrIo9i1-w&oe=6A072390"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
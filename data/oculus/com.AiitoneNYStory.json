ntent-sin6-2.oculuscdn.com/v/t64.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQbmKoCzu0oQ7kNvwGDG2i-&_nc_oc=AdqQ0sQM2x_69kq8dWP_kwjeNN9r-aVuImfs-K8uePxdlaonh9vQn2AotjnMxQ66zNg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-hHiL66SqZpKh_3koJICNszmhtCvuCNfYYt3Vc-lXg&oe=6A465C57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75OnwTls76QQ7kNvwHOLPuR&_nc_oc=AdoXIRD3FWClHxJk6VmFbdgar1EWmIQUttB8d13pNeE4Dw-eEfPVN-EP1KyYV6duSvQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MbGIgvFUh0M4znVQ9EfdpQfoH1RAKw3d6YLJ-6T7CUg&oe=6A4660A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-Z-CtfzGf4Q7kNvwEq-QMn&_nc_oc=AdqNKBx0hX2WMlX1zjnYCHWghWYQDJ-C22JPjQjHgxvkP0LFuNU8jQ1XKvOm01bGyPw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AnS4kXqq6_iGuO_5RotPGub8PYrvZEBNMJuxrRt1xEw&oe=6A468BE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg2QU42NYqAQ7kNvwE4XnjJ&_nc_oc=AdptfuLyfldLGSxyInup4Md9o5Mymw-Tfpss4rmcjRGxexxIWf8hjKEsJomECj9pjwo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g6hRGAoIMf7JaqNcS3BrH8kMwvmmPOdFhVjySAdnAFw&oe=6A467752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtojrCHCdQsQ7kNvwGFgk8h&_nc_oc=AdokUwJOVI8BVLUYCk_lPXSYreXK1p7cQbnAYqFH64hVkmHr9wOeG-bA80yQdaHHCDI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R6e_slQlP6ZktyiJ0gc9vE9VtE6hO0kPXYxI6uN1AQQ&oe=6A466B90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfor
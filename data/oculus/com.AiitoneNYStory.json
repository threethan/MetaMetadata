ntent-sin6-2.oculuscdn.com/v/t64.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3D3GQQUykUQ7kNvwGCS9mU&_nc_oc=AdqWywqpPw9oxxitgBh7kKBJbFOFAvaNXe8sCoQ-MTnzcWWp3EAkJ_JdA9j4I0f37aQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-B5uJMwvGKvfBMW3o2DYZ2zoelrzFUVYp2N0j9AT3ZQ&oe=6A392D57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i40QZ9ZgXlsQ7kNvwFbdce9&_nc_oc=AdpPrBog5z8VbXfBwOqWLGoGgiviGSwZ1Eu-WmUFWUPOo_uoteTgHR6M2jtK9t0idMY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8pePi2hk25rWVDKFzHlSiJNni8pdttGwoIBcIqV1acQ&oe=6A3931A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZehSbqH5KpQQ7kNvwFXgNND&_nc_oc=AdrjV0n0EI2xyoYpncthXdRCImaSmGl5U8AXLQdNl5ct1CX-5Z4VjHcEAbZizlESyFc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vabLC0VPY-YRLWCSPJUa8IPZzDoRMckwj237ZuCfWoQ&oe=6A395CE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmi0_fruwYEQ7kNvwG8wNEC&_nc_oc=AdpbC2UZKKwrS-s1DIPmfoY2jGFX5Mo1ZNIIuy7NULcNrw9WLlC5F7NCoep2ITf6noQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HNWO7GcN1SBtJEB8Moj91CJzPDfh6fIZv_vqJHJADPA&oe=6A394852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGd4E_NjA_oQ7kNvwE_fKws&_nc_oc=AdqjaZ0e1WRBA0bPQTtfazlb4ru7Iq0ryfMcQjsIo-cNY6P3p8_8DPNpXi5ZgSx4Wgw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uYa206esAv3LohS5dA3NT4EThXhTx0SNmo1tDyJOJng&oe=6A393C90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfor
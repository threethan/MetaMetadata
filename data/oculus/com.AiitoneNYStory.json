.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIrbBoEKKvEQ7kNvwEC_kAu&_nc_oc=AdpHuljrf0BgmpiUiPAXbsi-A4g1U83ovfEnONIKMkcbsndaiqzQgX-S9qanljWHGgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1YScwQLBaf0rrzntMbwZ3nIgI7bEMcSt_EPR9H6dclQ&oe=6AAD3157"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_xncsAzY3oQ7kNvwEC4DVK&_nc_oc=AdopyWU2j0VI2PT1PrAZIerYbHjjArz45KxFvVw9TQFzE3Nq3X7gzs3YwfL3Ap6kJ5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrm_Ge9ChhL_thq90_CiaYLd_ogLtvOURDRpvsT1MF2w&oe=6AAD35A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1N7qOIQzpUQ7kNvwFinIjf&_nc_oc=AdoO4JmbtTVGSv2DxMj2RcHMFwOM7Dt5Usihm7oZn1d11gdcR5IFjWP4H8PnW9NYYHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbe324QLFUWxzUcAUYRNiAaILvY2FtE0_QztAs5cPxcg&oe=6AAD60E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLwCk9Ty7ngQ7kNvwGCI-FU&_nc_oc=AdrjrMfCWozUEaqb6ULcXBs_0hYdY7XrBrrDNAvDn3c2VA31HmMQG6thwiw_ez5KY9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdnNAlYGR25942nsOsznn9NCX9EzkX7k__RA6dCFtbGg&oe=6AAD4C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0DzCKEs9KwQ7kNvwHwPI2D&_nc_oc=AdqssjMasaiHW7iw8I-AXQHS5ECuNXBNAy4YIIITSxwcu7G4kKYuI4ldKCN5nnY0pWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeT4YEWISmOk_lI25zepghsB26hDY-WwzgWzuzH_1wjg&oe=6AAD4090"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
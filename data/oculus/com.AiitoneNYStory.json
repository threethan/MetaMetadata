.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFACgYsBX4EQ7kNvwG6N2XI&_nc_oc=AdoaPRz858TSNgv-gnbaVvcP8qyq-blhggm5LLDI5ZyEEnujcKF5QpFCSCZjSe1iQDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxSBYBL8N-xSYPOE7wR-xy396UevC2KLUvFfczAK-vTQ&oe=6A60BA57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8n9afjBp8oQ7kNvwETEeV5&_nc_oc=Adq_CvNiaroINvAuRARzxyd6NMmQGy-JIze_PLDSyca4Be_8Dg1W2z9Q5UIxFzCEeTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJSVeAQd1MajCpmdfTJF2j_Y73n1WFeq75FOoNKVn5PQ&oe=6A60BEA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH_5iIHLwhsQ7kNvwGjH4DL&_nc_oc=Adrv9s5t7Kq3PX7ngViArEJYnWsuTkTyC_e6dp1Ff2UHRNTvZD13-9khF1bPBK0q8hg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybWeq18-x-Hx3vbetvEH9fQelTYCYllOCYoFgeoQ38g&oe=6A60B1A7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=579OrgRGkPoQ7kNvwGFHVh1&_nc_oc=Ado2c5ShC_oiHka66UEzCxD_H-_wVqKBYeFhWNlHFH7xjAb2pVuH0_BaFbYsyQwEUtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxNCXcvpeR35NvvZR56HJMJw3qfGK8wvrV_Xqh3MLChg&oe=6A60D552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNlmFzlU1CoQ7kNvwH8B61S&_nc_oc=AdpA35ZHGg2Bc2VZO8P1gf7lMFwq7K-nU7G4kPHEQ-xXigNgE496ZGt7wwXLDUWd13M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW8qUTdapoV0N8eVpL-7nahyuaX6cBHLQ7j8LLPbLzZA&oe=6A60C990"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
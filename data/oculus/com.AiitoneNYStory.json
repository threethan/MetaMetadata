.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnTfT6EKQOMQ7kNvwE_kLWI&_nc_oc=AdpG-8OaTZxslsDjs6ZTq__qFqVtYXnkVowH3iZTugs6MbzuKgQwVPzIupbRcStMhU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS3daxc3-LHz3DuzY_Tquo_6ofkuSo_pv_k5-21od-PA&oe=6AA7EB57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5Xz2Jaw_lkQ7kNvwF3nT0A&_nc_oc=AdrYvdDBz0zQSzLLSAyngvRDpc7l8NdsYzBx3b0CoPNsaA7SkEIQhUYsiZe5HbxX89o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfZm7rBuaAigbB_Mzd84MFjvs2zqtuT90FI0fU-AfByw&oe=6AA7EFA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm-t04w7KdsQ7kNvwFKv7Cf&_nc_oc=AdouaUvjRtmstQjmdRpFPDAL9D1dVDiIkDftvCUGkxpJ47d6nTw9w11gB-Ho3U0NJjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInbnbRC-XA1xh_u4JgASbxpkN2aNccxCpwpK_8564ikg&oe=6AA81AE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74sRy7zjsNYQ7kNvwHLFCDC&_nc_oc=AdrllRe_GsFatcnshoKX1LsGDmsjwd1OAKw9HlFud4J_rc0htie291fu_V7_nLQ5ALI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMJowbTNBGN1gYfa2ZmmMBrF2c_rmU79mg2EKsKQONlg&oe=6AA80652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=er5CkY6wlAcQ7kNvwEsX9QX&_nc_oc=AdqDHVh8aEBHj56BiM1rW8FGFmFZnPgMdHSVqxqIOBUYBUdnHL-8yu-0BnDS0CHrbZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4t5uwYiW1fBkzWkqGapqImmGS_it3m6ATbWGTEEcLbQ&oe=6AA7FA90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLGmYOyIg7MQ7kNvwFfl01F&_nc_oc=AdrlK65v6oQtb70U1s6XW6atVQsHSAgTMqIjzu5rFdeI9ZlYUiVutHlnvCu7Kk-K1bU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaotJRYdwYJ1328fM4IERQj_0X-crtghlXFKvUe1bl7w&oe=6AB3C8D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_d8U3q57fkQ7kNvwHfAubU&_nc_oc=AdrNS1Tm29jH19uN47dPKNQs4vEDd-GSDNJwqA9ou-Mh2zPGzEPh2x04G8haMaT23aI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlAN3X6K1_z5se-6wMg_pWspDRfqf1l74UC-65gKEozw&oe=6AB3CD28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77w2zfTm_coQ7kNvwHotKEO&_nc_oc=Adpe1DPShbJfWiGGluzaSXJO07BRwlo7VRRhUeNxUbNGaLjBF5RfATDcpbGpP7LaNEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsbK2WY1gQDNWITDu6HdLDdUcZtd40RytWktzvonLM0A&oe=6AB3C027"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQJGpHqico4Q7kNvwEZ-9lt&_nc_oc=AdrIb7eXlQidqURBuNiCZJyTfgI1aGctj8y-uHYN5BrixfzS8umtiAbWSpH3H6dAfVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwY3N1KM3xkNawx4sefXo8BQjQPmDbyRYs8Fxbea00VA&oe=6AB3E3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0cBbuE7z64Q7kNvwFqBtXQ&_nc_oc=Adqj_LeVSOGiJpdrPLKzzJy2in4jFX6c8MsVHWTZc7F2-j5KxLs5Fr6yqRQHwpMonNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCNohxcqxJzW2CnCppvwR6jgjPLOxGYeyTjGNS0iOekw&oe=6AB3D810"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
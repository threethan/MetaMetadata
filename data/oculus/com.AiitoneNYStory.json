.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdkDuGJiIz8Q7kNvwH7HPlX&_nc_oc=Ado5IInT8rWpt79c6ZPv5MhrCAX6-umm5McqofAqQ3gEtRc0NNyxhDSC-0xC7ZCOH3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oFeavUr-cpVuLU0oITro4GH3dgVUyChVuiyjXXQJcew&oe=69D8EFD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ol5Xcam9cQ7kNvwH3ialU&_nc_oc=Adpys6YV_cL5wPtx57gXWbx1IZj_OUuILKkL8KmmPfI3TWUUkEe-id7gzl7ZrFt67so&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33fEoDyfUcxQJOXCETDAuAaz6vzn9gKpbc9_OW-KvX6g&oe=69D8F428"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUWFnY68-RoQ7kNvwFCRyj9&_nc_oc=AdpHHi4RxoV-yXFv_We7c_mtwv_R-3IrWlfrIGNu4TySOgr2PTGmIPBEFLp1LQIg4Ho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OnVIeCs5dcQDrDyEnUeR9KMY_KPLVeOq5j0JWtBYUAw&oe=69D8E727"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcxUFnpmjCwQ7kNvwFlTg_X&_nc_oc=Adoa7sD0awnBQWPzaV2n6H5-MoZ-f-V4tnf4M_WO85u1h3TF0vKd88bBOnSXZWFY9pQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Koa_imblDdnkJoQD2zowx4MNKnVWVM6ICGE_TBKSIRw&oe=69D90AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yXtl-5sU2cQ7kNvwFpMYIu&_nc_oc=AdrAgGHnepBJ76CobM_j9gZaqz-tsKHZMB7rqjc_rskiaconU7eV9L8iOIllgvWRUgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3It-76EjZN1Dbk1efqEmpXzPhtI0aXoJtuTVZ9QLXjYQ&oe=69D8FF10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blTir6-VZ14Q7kNvwGQdBka&_nc_oc=AdpgwOqfxpJfDLOdn5hMz9NS6vgY7MuQp_LCghSXuC6YCzgiXKFuf2dGl2J_dO05RU4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQbeS1iqSfFWxQyz6OYR3okRtLdlyvRTc2NymmLRAsOw&oe=6A973857"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6C2ZVK_R1wQ7kNvwFyZZcq&_nc_oc=AdotmwyYyWUWh2pQ8fe8YoRSFzCfw36Sdl2Gwh5Rxz0wZ7fgwBYEz7h_LvDSU32r2hs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhpeaX4oZECw2RXE7yEYWIgHGn8OS1HsqGHZr6_1lyZQ&oe=6A973CA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujjgZj5uNZgQ7kNvwGEaYdl&_nc_oc=AdpwAqnsE5PyZfmoRXSwSOHaSNjYqcC89_WaUaafBEuWZ_XxAbQVV_6vPZH_eG7zmYE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyyycteoKM2LkRkiwi5q6OnoMNTv8UfEZVZ1cj9emVjA&oe=6A972FA7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zprn66-357AQ7kNvwHKwOGM&_nc_oc=Adqrq6hgmBPu8cfozH2CdwKbQ5mW_YmT5FAUaTJ8dqzNdjlJxHf8YVecE4dKdOgiswc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEADhBUTfrVAlwPnqmnN2GRbyrmNbaB5SS-WsW3ZNGD4A&oe=6A971B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjMlywWuKbUQ7kNvwELCAlr&_nc_oc=AdomfIbcRJeAUrd59_OP4_TAy0Ii5Ke0COu3TIniOJFRl6R84YR43sNEib9FP6A9eI8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAEbaNy-oC2mudP59kvxv_rSL7m3xuJejZpDIIsp68jA&oe=6A974790"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
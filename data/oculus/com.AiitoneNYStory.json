.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmTm58gjjbIQ7kNvwFwT2oO&_nc_oc=AdpqMF73g1YOeEE3gX3OF7pRrRFlnRAGeHxf2qg0zsPULPNqh5XDGmYTlTRIlP0aBkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB50iYUpYEKGVzamBEazso5awElAYPJIjm8R4BCn4Ucg&oe=6AE76B97"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCNKFyIR_sQQ7kNvwGYbd9G&_nc_oc=AdrDMBwWBhHnT1IEIOHBoPz2DvoU__-Erf0ZqZHUPt6qYKw3GcEZffr0tD1rbtZL9g8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYIIZMegud_tP6XpBvfGcZIuOR07GeSkn0zXTRezwGpQ&oe=6AE76FE8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcIoeVjLbb8Q7kNvwH64K7C&_nc_oc=Adrj5_xkOgQMdCPR6wArg_I4F92KppGCdgVXh1iRs_YWC35UjUTtyq4w67g17QGEFas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxMWdypJMZ91O35QpUPtLGZj0tYNW3NENWgiJPO_6Hw&oe=6AE762E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54TpBoJ5OQsQ7kNvwFfWx4p&_nc_oc=Adrt99XoG3x-1nCP2WuNdqNNvZZRj4zAKJDhCjiFMa62Arw5_jmtWoMa8b0MrK3y0nE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEBQzmB7nylHB6cK4ziRH0exM3G3JBSERIegkOb26-YA&oe=6AE74E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU2BU9pv9Z0Q7kNvwGApwln&_nc_oc=AdpMoLS5mIEkGvzufvbfr5C3iOED6ani1cLfFO6JLHAkK22vDs0tfBjyJeEROfaqrjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1YAdX5LW2U8tECwzVFWBd5FiZvf_AzTcs1KiQX5sKSg&oe=6AE74290"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
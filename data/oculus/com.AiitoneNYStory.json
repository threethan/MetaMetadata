.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4CVh-a1SLMQ7kNvwGdy2G7&_nc_oc=Adp-_y_V77eAxNOzK6VPVbFSta2AQZq0h-IeB28wOy8r6bZJfXPPYzsVyFKajDwZQNY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G1gM1EI5f0cb0dLo9Xc8mTCdMKtQ8eV8Q7voTHXaLzg&oe=6A1C2C57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ8EBCCr8-0Q7kNvwF5dfoC&_nc_oc=AdpG_-VXM58vk_C531ZeEYJ-VoYI4sm_-0TlJPEv1w_X6dT-0BL5tyUgIXJyOkiZZ_w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xP7uiIGTme7O9IY4_fj0bIlhwpfANinanko5QRGQNWA&oe=6A1C30A8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxqX1tWHscMQ7kNvwFLQMn-&_nc_oc=AdryyNBzoKevJmb34yZZoCJxPKzbIF8l1AXLvBtpuTRg9HgsV-kQW47Bvxhz4VJF47k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7npJDf4VQ7VfBZv4qLtgpIbATyK4BwaYld1MHRc7MJAg&oe=6A1C5BE7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sds2jL9YphMQ7kNvwG9m67W&_nc_oc=AdpTyYd_AULAvzPZNkmsn8IUR6ZEI35Ia0bak_MGGihN4fTSQvN1UzrqGGLa_NUNtlA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mH79d-i9F9IAgMtzHgwuJfxF8yh3POpKcaxymaEK3UA&oe=6A1C4752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0RHpJPnsBoQ7kNvwGK8ePJ&_nc_oc=AdrQvQkkEa4YF12rUBaMWIfZ7nRUHUL6OjVepNEmY8HIx4qpOg3k9ID407wTXhaSznY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DgNVpPoe2ZVDTttrKFciCtyQ7Cpxqw95nweW0umsBsw&oe=6A1C3B90"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
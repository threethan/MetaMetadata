.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3da1PJ19UQQ7kNvwHreGYU&_nc_oc=AdqwyEXGwf0eGZ7f_Uk0v9F1BFAiBoNNJfVCGIoVWucd7XTQtuh5ySiMZR7zejxzKqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJosivYqMTg9nA2m7ChIAlG616DFk5vxNs6cpT5SQ9-2g&oe=6ABBB1D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbLro4dEqugQ7kNvwHTGoqP&_nc_oc=AdpQHIFtl_2MspnY31TFZXPyCJV09nH9b1czulihXyfh8YXPkvUxDhwBKi6NjozuVCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILDHkOl56jUGDeuwb8F7Qw8rMvBm1izlfzUa4lTU04Aw&oe=6ABBB628"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCRrF7wCh38Q7kNvwGh-vm3&_nc_oc=Adqb38PFMGJGYEoV-LkG8V7u9guJAPIAfGB5riDUj-17iB_Xi21wUqtweJoOi8pCu8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQVt21hdDLpTy_m1RLuZ7k1kM_ZNM7ox0Srg3TZFTXow&oe=6ABBE167"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Jla_mNwDQQ7kNvwGYa-tF&_nc_oc=Adprbww5Y0dtMg8r4ZHB9r-F6uzLjzJc3rqRcvoK5j2f5JcxWChpRSqrfPS5ekrVgLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAp3GDOBYO1PeNRRlZ3V7UpmVeE7EYMIFqqPP_r7wmoA&oe=6ABBCCD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npba8VCHtxMQ7kNvwEI3bkl&_nc_oc=AdoCiXt5nob_HWeV9y_x7clZxoUVpfcsx-J3djGVyrO02cqaNUUoJb15W621mpynUqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHAEcASrWwN1ox0TvYgjmouWOxv4cjLZLy3zHRRn4QJg&oe=6ABBC110"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
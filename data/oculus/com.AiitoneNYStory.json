.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33uJ8QM-BlQQ7kNvwEkrr69&_nc_oc=Adq1zmHThUn8oWP3V6y89wcM2bMhUxf7qsi8HB_ogasEnfm87aPKKB41PKHwz__z5BI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU9xMUJ-iiBogixf_3heY5qOGKdJkqz1R9VZIwVR8Ozw&oe=6A9181D7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeyfdEzZVOkQ7kNvwHL_9JD&_nc_oc=AdoCSvVtledi4-SWryIm4voatnvd2owjjJ3wxLEKGTA0gHIPtxxvBZGPn_AOyu4SnUs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETf7adYl-KstPXgHrnea-KC8j3uKOad80s6BlvwVfgRQ&oe=6A918628"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-3vFatuCj8Q7kNvwE_m3-M&_nc_oc=AdrxnGZmOjtmKT0RAKeqHM2_LrgDTGHTxZbi0QopxJEQR-sK-gSv46iYwB5EUdvOHv0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCj1C-h6r-19tBA1fEUKlEYqZdkdZC6vzmHWUC-U9zcA&oe=6A917927"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE212Jx_Ig0Q7kNvwF0BxOj&_nc_oc=AdqII96B3WunZLqjG9mEV-vuxqrBCnzCbCV4bFK69XJc6hnk-HFGE8KWoRd-Y4FsLPs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfShwXE-TAluO19Jp1bP8-SdOTIwW96byvpiNY317byQ&oe=6A916492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDjQc521CoMQ7kNvwF9eRDx&_nc_oc=AdplMV0Qa5PjTOFPpzGd7YxhIKh7kAn5Qu_lCUwLsoAiRx6iQs6NxgKcRSOx-37KTE4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiRd9kvHCPUIokKwcyYHho-v86zKCPp4NG0Cd6zgm-Vw&oe=6A919110"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
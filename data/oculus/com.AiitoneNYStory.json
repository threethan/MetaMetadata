.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hilMQUFAAZkQ7kNvwEU9Yi7&_nc_oc=AdqguOX_QVICYHyInyyH_O4Y8YIGyZWoQWGEafslLgj37eQ-cDpXp6ezfZG-EbBkn8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRko-j5UZ3oD16iVyB8Xwo11bdkHK1-2J0372s0bC1TvA&oe=6AF49A97"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pJrouy-jnoQ7kNvwEBiGEy&_nc_oc=AdpXIxnyWfyzVL2OcYgfmoxCYf2LcCrr29AnfirX_SA-AhkZy-VhpAZ2M3Tg1l6FVjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYyAj-UsL4J3hfXNcRPUQz1KvZnmXYDeFuQnxGH_g9Dg&oe=6AF49EE8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1W3Slg8EU4Q7kNvwGaxSP8&_nc_oc=Adr4rrBnGm0R24TvtJpPGsMkMBR5ik4lDsMV8YOkVlGiVGsxj6njqbWodQ5JryX17tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTST0a40YqjCutKokZUNh_Ftk-UeiguMHFFzzqkHx_ZiA&oe=6AF491E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo0cw2GlJ5YQ7kNvwG7V0Bx&_nc_oc=AdrT7Z9qiHtUNUvj2UvENOWYVqUIv0XBpTpyO1hVqbYvMVcnec0LwgpF_cMIQR3uM3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQOoA6CP5q1YnzxV1ol-t-JtSFeQHB1uhf5oFxg7tN1w&oe=6AF47D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH2jRmBSgB4Q7kNvwFV111v&_nc_oc=AdpeJBC260c0j5CoygiX3uRYKwDjp0t3rn9p-Gg5n9X-kjTUFOqIn5UZUgvdkzSH_W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwEuU15AD_3DnZNW2mG0fuoYdDQz5qa6lwobYPh_TLbg&oe=6AF47190"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
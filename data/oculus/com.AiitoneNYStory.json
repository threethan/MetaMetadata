.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLGmYOyIg7MQ7kNvwEAYRh4&_nc_oc=Adpu6aUGeRirD-ZDd2h8Lpc7kELnb1xEVVMlVPTKCXGA4j5houYr21qOE6j8AgIi1tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXawJ8IXbN_XkzOdkSX_-4HZFaFOZ6RHRBLgV4dKV06A&oe=6AB27757"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0EFz9rccAYQ7kNvwGQyOt0&_nc_oc=AdqjAjSiudH6P15ledbEmeQdhKpAyLsQiYYJyKlh_8UwUHLbkdYum4Y-oaOXfhz1j4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI7djsqF0qILFWglQqWk9EcEQ69OQh43gu-Nk_dsSzKg&oe=6AB27BA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77w2zfTm_coQ7kNvwFW0O27&_nc_oc=AdrvY9NaA5-i9D2MN3P4ABrvR8e9xCUg9VyM7usF_vHo_mvt_RkL3k7EpmghEJmaTUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1M3T5zlLep01-Y9NHc9RtbYsF8QrFZ3VDCuPHyWaz3g&oe=6AB2A6E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQJGpHqico4Q7kNvwEn3XVD&_nc_oc=AdrKE7hPVVLdfgkWwD2GRyru2MSxJDz1fLBG3KQU-8gVucgdhnoVoUs5fWINm7NJx68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwtWVfFD9GnbDcuibwRILM7sdNfjGIY8NLMt-XvtzZAA&oe=6AB29252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWibtiiCTlwQ7kNvwGo5DIc&_nc_oc=AdpIGuudItow_fP-AG4XwXKxR-RFyK1SosgGa0I7ax-H26OBJR9z4bFj0J7E951ZRGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINNUQGcs_fT6aFoMIkva2nBx0I9-QYxHCX9CZPk0bYLw&oe=6AB28690"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
1 \uacf5\uac04\uc5d0\uc11c \uc601\uc5b4 \ub9d0\ud558\uae30 \ud559\uc2b5 \uc194\ub8e8\uc158\uc744 \uc774\uc6a9\ud574 \uce90\ub9ad\ud130\ub4e4\uacfc \uc0dd\ub3d9\uac10 \ub118\uce58\ub294 \ub300\ud654 \uccb4\ud5d8\uc744 \ud560 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \n\n\uac00\uc0c1 \ud604\uc2e4 \uc18d\uc5d0\uc11c \ub274\uc695\uc758 \uacf3\uacf3\uc744 \ubc29\ubb38\ud558\uba70, \ub3d9\uc801\uc778 \ud658\uacbd \uc18d\uc5d0\uc11c \uc6d0\ud558\ub294 \uc0c1\ud669\uc5d0\uc11c\uc758 \ubaa8\ub4e0 \ud45c\ud604\uc744 \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\n\uc6b0\ub9ac\ub294 240 \uac1c\uc758 \ud575\uc2ec \ubb38\uc7a5\uacfc 720 \uac1c\uc758 \ud575\uc2ec \ubb38\uc7a5\uc744 \ud3ec\ud568\ud55c 3,800 \uac1c\uc758 \ubb38\uc7a5\uacfc \uc0ac\uc6a9\uc790\uc758 \uc601\uc5b4 \ub2a5\ub825\uc744 \ud3c9\uac00\ud560 \uc218 \uc788\ub294 \uc74c\uc131 \uc778\uc2dd \uae30\uc220\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \uc2dc\ub9ac\uc988\ub294 60\uac1c \uac15\uc758\ub85c \uc774\ub8e8\uc5b4\uc838 \uc788\uace0, \uc21c\ucc28\uc801\uc73c\ub85c \ub098\uba38\uc9c0 240 \uac15\uc758\ub97c \ucd9c\uc2dc \ud560 \uacc4\ud68d\uc774\ub2c8, \uc55e\uc73c\ub85c \ub098\uc62c \uc2dc\ub9ac\uc988\ub3c4 \ub193\uce58\uc9c0 \ub9c8\uc138\uc694!\n", "short_description": "VR \ub274\uc695\uc2a4\ud1a0\ub9ac\ub294 \ub274\uc695\uc744 \ubc30\uacbd\uc73c\ub85c \ud55c \uac00\uc0c1 \uacf5\uac04\uc5d0\uc11c \uc601\uc5b4 \ub9d0\ud558\uae30 \ud559\uc2b5 \uc194\ub8e8\uc158\uc744 \uc774\uc6a9\ud574 \uce90\ub9ad\ud130\ub4e4\uacfc \uc0dd\ub3d9\uac10 \ub118\uce58\ub294 \ub300\ud654 \uccb4\ud5d8\uc744 \ud560 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \uc774\uc81c \ub354 \uc774\uc0c1 \uc601\uc5b4 \uacf5\ubd80\ub97c \uc704\ud574 \ud574\uc678 \uc720\ud559\uc5d0 \uc2dc\uac04\uacfc \ub3c8\uc744 \ub4e4\uc774\uc9c0 \ub9c8\uc138\uc694! \uc815\uad50\ud558\uac8c \uace0\uc548\ub41c VR \uac8c\uc784\uc744 \ud1b5\ud574 \ub274\uc695\uc758 \uacf3\uacf3\uc744 \ubc29\ubb38\ud558\uace0 \ub2f9\uc2e0\uc758 \uc190\uacfc \ucee8\ud2b8\ub864\ub7ec\ub9cc\uc73c\ub85c \ub274\uc695\uc744 \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "Square.png", "id": "1050794265409135", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035428_1050794268742468_3680544553532420616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp4c89zj4GkQ7kNvwGACSy7&_nc_oc=AdkU3IEaH66h-YP4UAEWwWDJ9DlP6LEuipUJvYeWAMIOY6V9M-7BbINYcy66sKwqLz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6fy2cBMwHNQ4BDSvaf7fS-E0F2aWS7ffxDoGGWkP5Cw&oe=69BFCC4E"}, {"file_name": "Portrait.png", "id": "476756833501511", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982622_476756836834844_2861411570546577743_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA9_7hhAff0Q7kNvwGNfpTV&_nc_oc=AdkN5c0lsVCZP1dIGLcaCAAwkNy9fSGo9kojpDYiCRjYFt3Fz0AtJJth97cuGxy53iE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaEus_DKXAo_-mVjUqcDX78Mie_4Oc0D8CyswTFzK4Tw&oe=69BFF61C"}, {"file_name": "Mini Landscape.png", "id": "452754142581166", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036605_452754145914499_3196844746571875619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6vfN7JCR64Q7kNvwHYOY2X&_nc_oc=AdlB4_cC4ztU7vWGIyAbTXDj143DcZfoWTuMqx0aHMpK9OUHSSVcgXD2W5Prv-JXZMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR4ezr4QTuWuflUhaBPdpyUHmlxivcMBLhL_eInbIjzw&oe=69BFCD5C"}, {"file_name": "Mobile_Icon.png", "id": "418301066095998", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036605_418301069429331_57164963259767082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTejMKXJkAUQ7kNvwFrE6Y-&_nc_oc=AdkfNqiT8QUhohu3W-FcYnIKz4kh_s64AYUe2Q616boLAJQaIgj28JO11oXR3VExOXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd5V0TgBty-F7mXwri1Z-M
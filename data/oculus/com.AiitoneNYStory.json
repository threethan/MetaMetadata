.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8PhNaHmKsMQ7kNvwFYvY-V&_nc_oc=AdpdFB8jfdCOw0VQSubp0QNdmweSx1yGc7b6rE9ucCBNCBWKBX9UFbtWYFBkUSo5A28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6PTmBd_o0NIOefoo-A0oE7SdOa1YJ1tVBzGA4fIhilw&oe=6ADF4A57"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9harFzA5p94Q7kNvwHYFuu3&_nc_oc=AdrDETD6dNnc_c2lvnx0VsPJTWGLGfc2NGGpjsmvINP8JXk_mcJc5oYSjG6rnFjCVvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8vPKrUMOHN0oiwT5Y0Dp7LulDcLTeZufzxsKCHExVxQ&oe=6ADF4EA8"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tthwnBvUA8IQ7kNvwHq1MQH&_nc_oc=Adr_3fZrFvJ1nArzjEUze5lpzF_XJsg89uShPTG7gzWfc7STPqAGc_SnRUCAhN0eGWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8C-gfcsFju9FxjkU_E6j_o3a1wijvz1xdcCsT9_UQhg&oe=6ADF79E7"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJEkZDfZAHkQ7kNvwFlJmRs&_nc_oc=AdpV2UoPVXgR-G4sU0huSbb9vx89PJ-b-yByUR6vP5TJsQs4diD29pt_q8-23TiKQR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsD_A1yb_R2tDQ5ISZhH8HIbO6qLwbkSgp3rJVswfVcw&oe=6ADF6552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGN-QCntGrAQ7kNvwFn4eb_&_nc_oc=AdplEnzrfmyr6eImUTrbWWlWTcnRQ8C_UkTRyqXHWVd8o5HnwujZv_bhrc-ljT0hW_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnYQz3PDnCUMK9CdwD1ge_aVPIR1fhtjg3u1NYj7526A&oe=6ADF5990"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
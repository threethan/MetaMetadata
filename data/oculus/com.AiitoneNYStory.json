.5771-25/38974876_176724807272999_1907376285138155174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIjIL2IVoQwQ7kNvwHrsev0&_nc_oc=Adq2C0gDBOFVhQb-TlzasvSaZX0nZJKCtloZu4SDDsyyUInbHHe88JY76qNGs7ThQw0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYjK_KUn453C5HyWgaMstq06d6zqjVoBbxhOqy7UFSUw&oe=69C67AD7"}, {"file_name": "07.png", "id": "707443609951539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572918_707443613284872_3422591151930594066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-mSy0jBuFEQ7kNvwGGlKIv&_nc_oc=AdqeEj2B__nj5RomNUAzUAVMEOGk0bdONgoVVBihaR4gTLkYzDTsW-UK7xrhtqEkuMo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxb3FVNpzvDEfYEvggXYVs2yNrwLBxUYPap49L9DSZ6nQ&oe=69C67F28"}, {"file_name": "09.png", "id": "423296202083013", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982666_423296205416346_6572123320491667633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8osx27BW3KwQ7kNvwG-eDWd&_nc_oc=AdoGwrpfX6fo3yV2bSdBLgaky9tEF0-n3QtFOCc7K0ytfGmqsoRBos3ZtY3Kjc_IHPk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_Aa8c9UfSx8C0tugYwqnkQN1All-dfAQ4bplwiqAF-A&oe=69C67227"}, {"file_name": "15.png", "id": "709563269707982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_709563273041315_5461420241404035025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVbJrx8r8QsQ7kNvwEORZWO&_nc_oc=AdrG1caiDkleva_YKkNVdHAB00AbQTAqyDAxYn7jyaSh7FHWduNdWXfYX5jn26IW360&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZvdat1qeGo58JBjKLjdIurenUO5PXjgFfwWBLOerXfw&oe=69C695D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466543267834311", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195909_466543271167644_7584934116239430174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erw5XEDD9xIQ7kNvwFD2VRP&_nc_oc=Adq-ah41QYOmTK0hX8gdLHcD5-ZG7ba0oF-sFY7ONcJl6R0ktrE9C_lICf_fuBno4Nw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnqq-NO22hSuNnDAt4MRguUIofVB74mhrw4Uzzx0HpGw&oe=69C68A10"}, "display_name": "VR New York Story", "keywords": [], "long_description": "Are you hesitating to go study abroad because you have a tight budget?\n\u2192Experience studying in America virtually only for $49.99! You will learn how to speak 3800 different expressions in English as well as enjoying on-the-spot experiences i \n\nAre you still hanging out with friends who speak the same language, while studying overseas?\n\u2192Communicate with 32 different foreign 3D characters like Sam and Barbara and become real friends!\n\nAre you too nervous to speak when you bump into foreigners, worrying that you will make a mistake?\n\u2192Don\u2019t be afraid! Practice and enjoy daily life conversations with various characters and gain confidence!\n\nAre you stuck at home wanting to travel to New York? (I do!)\n\u2192You only need a VR headset and once you make a one-time purchase of VR New York Story, we're all set. Off to New York!\n\nDive right into VR New York Story to check-out more episodes including traveling, daily life, life at work, having a relationship and more!", "short_description": "As a total solution for English Speaking Education Application, VR New York Story makes you have a conversation with Characters and develop your English speaking ability. People who want to develop their English ability are not required to spend time and money on overseas study anymore! This elaborately devised VR New York Story enables you to visit everywhere in New York and feel the atmosphere of the place with your hands and Oculus Quest2."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.aiitone.com/aiPlatform/newYorkStoryPolicy", "developer_terms_of_service_url": null, "publisher_name": "AIIT ONE Co.,Ltd", "support_website_url": null, "website_url": "http://www.aiitone.com/aiPlatform/newYorkStory", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort
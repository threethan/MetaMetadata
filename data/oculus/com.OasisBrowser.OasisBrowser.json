NSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftviGmgsUPYlE-rB5Iagth1Pz9525YBnptA93CRe41SPA&oe=69A429ED"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-Ria5J5gCoQ7kNvwFg0XO_&_nc_oc=AdkubRSRxDW8fvWPAzbF7Dk2Bf8osKk53JaHguxZzGXUxEy_v5U5JqniDEguMAAPbbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuUDDNemdsYKwvizYhghkNTUyJhgLx0ORfYrZo105ybHg&oe=69A432B1"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrAN7hD_s6sQ7kNvwF2_Ju0&_nc_oc=AdmOykFr8cQfyLFl6OPmevPmwDSIB94msYdUsbiGhW4Mfz9nGr1M4o8eLFUbyH8sPiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsVWY8UEn4iqgf1FrEXHsREO3mxN93byRJll3h39Z_uTQ&oe=69A42887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG2rgRw7OXoQ7kNvwGgMq_x&_nc_oc=AdlzBH63u40bE2wSUVp19ViMbrJTUCGLSdq4hWHbR7qyfuhbhPBaXrFq4tOSUYgAAhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsAlZ17POn7OdoqC2lI05_e-aVKVQ7bwJvT8EM-CloVag&oe=69A43416"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary.\n\nCurrently, this app is in its beta version, and we are adding new features to enhance usability and increase the freedom of the virtual space. If you have any opinions, please do not hesitate to leave a review.\n\nWith Oasis Browser, you can freely construct your ideal virtual space for various purposes through the browser:\n- Relaxation Space: Choose your favorite space and enjoy a fulfilling relaxation experience with videos and music to soothe your mind.\n- Efficiency in Work and Learning: By placing multiple browsers within the space, you can work in an environment similar to a multi-monitor setup.\n- Ultimate Content Viewing: Enjoy movies in a dedicated theater room or play browser games on a large screen, significantly enhancing your entertainment experience.\n- Customizable Interiors: Arrange browsers like furniture, and display web content (such as images and videos) as virtual space displays or murals.", "short_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary."}, {"images": {"nodes": [{"file_name": "storecover3.png", "id": "1275576786385775", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036605_1275576789719108_4735332890343089726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViWjO1vXIaUQ7kNvwFODVrr&_nc_oc=AdlZbfmW2f7dgl-seqxPyPUnrIZBLbl3hkFpe1je-1pfUuQyGqRc8zdvigyA7N48FqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsO4CdrwkFpqUuPsHiMiHjmEI4gMeU1ZYMRa9aS2zNPfw&oe=69A44522"}, {"file_name": "storeicon.png", "id": "1190240844983913", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222944_1190240848317246_625707758757251907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUQL2xccD4UQ7kNvwGA9FJG&_nc_oc=AdkbZtdJ-D1KZcm1h6zEV08iN90RugVc2B5KGiOcFV-NmmgCQMfMnuoQwotTXjnR_Z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu79igsaqOWHzxGlxl2Q7qzA23mAfGJNtCnO8Ea3fzQ5A&oe=69A430E9"}, {"file_name": "storecover1_4.png", "id": "680291394017029", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5
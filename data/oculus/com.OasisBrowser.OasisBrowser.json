t7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs-iepZWlDfEjs4DCoFJV_q1lUeOQQIczwJ_6DHLbjHkw&oe=69A57B6D"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-Ria5J5gCoQ7kNvwFrvT-3&_nc_oc=Admhywo7340soPqEeD4j2lhk0UJxCoRHBVhzkI32A3CY1tjrgXs3w5CKx7R9i-3el7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuh8tJ1K5uOoKnqpEKwydOIuZvBqUhCiFiO9Tubk2lVTQ&oe=69A58431"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQiKLlTYeqQQ7kNvwEEaPTk&_nc_oc=AdnWAivEDsfftDlKERmCVaGYDAlqTys56DstgI2xSOHwJamgHTUYx5OlU1fVn1WyKU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuq2QwDCpWaANBqpXFk3anZBkPvLAmUHUbHo8ZLeF77PA&oe=69A57A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG2rgRw7OXoQ7kNvwHoP6UJ&_nc_oc=Admhzd-mQpsJRoNAtvLlhrr767dp7Mfr2arWmH5Og4dvPBX4_QczvhqMCq1-JgACVXE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfszrKkbZNzCALGZoJX_VGM9LLZDcTF9ru2Kls9xA0XiZw&oe=69A58596"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary.\n\nCurrently, this app is in its beta version, and we are adding new features to enhance usability and increase the freedom of the virtual space. If you have any opinions, please do not hesitate to leave a review.\n\nWith Oasis Browser, you can freely construct your ideal virtual space for various purposes through the browser:\n- Relaxation Space: Choose your favorite space and enjoy a fulfilling relaxation experience with videos and music to soothe your mind.\n- Efficiency in Work and Learning: By placing multiple browsers within the space, you can work in an environment similar to a multi-monitor setup.\n- Ultimate Content Viewing: Enjoy movies in a dedicated theater room or play browser games on a large screen, significantly enhancing your entertainment experience.\n- Customizable Interiors: Arrange browsers like furniture, and display web content (such as images and videos) as virtual space displays or murals.", "short_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary."}, {"images": {"nodes": [{"file_name": "storecover3.png", "id": "1275576786385775", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036605_1275576789719108_4735332890343089726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViWjO1vXIaUQ7kNvwFmuAMb&_nc_oc=AdnPtp3sgurXcQqUzW5fF_B6EfLRk4anNkTAVUDiI2J0wEuPXSF2HzyiGl7QIIGiL8A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvxN5E8Y8w2xw632XfBnVMTmOgO8rUYRLmOgdH7cUpuxQ&oe=69A596A2"}, {"file_name": "storeicon.png", "id": "1190240844983913", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222944_1190240848317246_625707758757251907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUQL2xccD4UQ7kNvwF4hj5C&_nc_oc=AdkIXsCSKbAHg57_H45BBOIx2csmbCbCEPmACoUxv_C8LIFRzGVw62OjnsjfbKfvsW4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv109rtmuNu-A3E3CrZDr60umWI3vv7YQC9oO4OMZMtzg&oe=69A58269"}, {"file_name": "storecover1_4.png", "id": "680291394017029", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3
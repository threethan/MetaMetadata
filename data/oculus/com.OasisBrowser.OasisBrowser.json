DrX&_nc_oc=AdqjMhjHsvhrrcnhRSIIngUNEYn6las5GC6ajLsMa0R0vpRxsJ_7wmT4Jb5Iv8SCYvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHorpWyiqLkVpyxlW5PqYWWs8mqQGUa2ZK-xQeSzzYuA&oe=6B01BFAD"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74PnALtTCSMQ7kNvwFtsAzx&_nc_oc=AdrcQ5BEU3fP_adqU1gRVHnqalZLHpmImS24AsrJym0J_yxJo_2HbRpIEXS7SWNH5C0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB2bkE0ngCEKUQaxh1OVlLlWxIDmXCUPaAOQxosia2Gw&oe=6B01C871"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2DB_9ETF2AQ7kNvwGpVuyC&_nc_oc=AdrKfLDR4o1wJXyMxMPCgEer2Igr7KkFj1xP_kS2i3E2rFnZtmmOJmMWyTcZ-DYoia4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyVBAvf_gKXe0TSC5AMJGYuSx53Gk5T6ZkYCxXOSnyBw&oe=6B01BE47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mfmq9umBFkQ7kNvwErFaUy&_nc_oc=AdoN6np9p6LPj4ZiLxSa0jZR0UhiT1_Yps5EI-qtYi4FL8-q_3eaaWZIZVrfto6kqm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPj9lpLcx4SZPBw8CNnFdqOeqr0cKpORtxWrtrZ9RLjA&oe=6B01C9D6"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an application for creating your ideal virtual home. By freely placing browsers in your virtual home, it provides the ultimate browsing experience in your ideal space.\n\nBy using Oasis Browser, you can create your ideal virtual home for various uses.\n* Relaxation Space: Choose your favorite space within it for a rich relaxation experience.\n* Work or Study Efficiency: By placing multiple browsers, you can work in a multi-monitor-like environment.\n* Content Appreciation: Prepare your own theater room to watch movies, play browser games on the big screen, and achieve the best entertainment experience.\n* Interior: Browsers can be arranged like a display or a mural.\n\nFeature\n* Browser: Freely place browsers in your virtual home and explore the world of the internet.\n* Room: Choose the skydome and interior according to your preferences and purposes, and customize your ideal virtual space.\n* Hand Tracking: All operations are performed with hand tracking. All you need is to wear your HMD.\n\nPremium Plan\nBy purchasing the premium plan for $9.9, your use of the virtual home will expand dramatically.\nPremium Plan Features:\n* Multiple Rooms: Create multiple rooms, and switch freely according to your needs.\n* Unlimited Browsers: Open as many browsers as the performance of your device allows(up to 2 for the free plan).\n\nAt present, this application is currently in beta. If you have any feedback, please write a review.", "short_description": "Oasis Browser is an application for creating your ideal virtual home. By allowing you to freely placing browsers within your own virtual home, it provides the ultimate browsing experience in your ideal space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oasis-browser.com/terms-and-privacypolicy/", "developer_terms_of_service_url": "https://oasis-browser.com/terms-and-privacypolicy/", "publisher_name": "Oasis Browser", "support_website_url": null, "website_url": "https://oasis-browser.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
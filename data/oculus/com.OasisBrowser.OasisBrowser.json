067\u8c4a\u304b\u306a\u30ea\u30e9\u30c3\u30af\u30b9\u4f53\u9a13\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\n\u30fb\u4ed5\u4e8b\u3084\u5b66\u7fd2\u306e\u52b9\u7387\u5316\uff1a\u8907\u6570\u306e\u30d6\u30e9\u30a6\u30b6\u3092\u7a7a\u9593\u5185\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30de\u30eb\u30c1\u30e2\u30cb\u30bf\u30fc\u74b0\u5883\u306e\u3088\u3046\u306b\u4f5c\u696d\u3092\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30b3\u30f3\u30c6\u30f3\u30c4\u9451\u8cde\uff1a\u81ea\u5206\u3060\u3051\u306e\u30b7\u30a2\u30bf\u30fc\u30eb\u30fc\u30e0\u3092\u7528\u610f\u3057\u3066\u6620\u753b\u3092\u9451\u8cde\u3057\u305f\u308a\u3001\u5927\u753b\u9762\u3067\u30d6\u30e9\u30a6\u30b6\u30b2\u30fc\u30e0\u3092\u3057\u305f\u308a\u3001\u6700\u9ad8\u306e\u30a8\u30f3\u30bf\u30fc\u30c6\u30a4\u30e1\u30f3\u30c8\u4f53\u9a13\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\n\u30fb\u30a4\u30f3\u30c6\u30ea\u30a2\uff1a\u30d6\u30e9\u30a6\u30b6\u3092\u5bb6\u5177\u306e\u3088\u3046\u306b\u914d\u7f6e\u3057\u3001Web\u30b3\u30f3\u30c6\u30f3\u30c4\uff08\u753b\u50cf\u3084\u52d5\u753b\u306a\u3069\uff09\u3092\u30d0\u30fc\u30c1\u30e3\u30eb\u30db\u30fc\u30e0\u5185\u306e\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u3084\u58c1\u753b\u3068\u3057\u3066\u5c55\u793a\u3067\u304d\u307e\u3059\u3002\n\n\u6a5f\u80fd\u7d39\u4ecb\n\u30fb\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u64cd\u4f5c\uff1a\u76f4\u611f\u7684\u306a\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u64cd\u4f5c\u3067\u5168\u3066\u306e\u64cd\u4f5c\u3092\u884c\u3044\u307e\u3059\u3002HMD\u3055\u3048\u88c5\u7740\u3059\u308c\u3070\u3001\u4ed6\u306b\u4f55\u3082\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u3002\n\u30fb\u30eb\u30fc\u30e0\uff1a\u81ea\u5206\u306e\u597d\u307f\u3084\u7528\u9014\u306b\u5408\u308f\u305b\u3066\u30b9\u30ab\u30a4\u30c9\u30fc\u30e0\u3068\u30a4\u30f3\u30c6\u30ea\u30a2\u3092\u9078\u3073\u3001\u7406\u60f3\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u7a7a\u9593\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30d6\u30e9\u30a6\u30b6\uff1a\u30d0\u30fc\u30c1\u30e3\u30eb\u30db\u30fc\u30e0\u5185\u306b\u30d6\u30e9\u30a6\u30b6\u3092\u81ea\u7531\u306b\u914d\u7f6e\u3057\u3001\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u306e\u4e16\u754c\u3092\u304b\u3064\u3066\u306a\u3044\u307b\u3069\u81ea\u7531\u81ea\u5728\u306b\u63a2\u7d22\u3067\u304d\u307e\u3059\u3002\n\n$9.9\u306ePremium Plan\u3092\u8cfc\u5165\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u30db\u30fc\u30e0\u306e\u5229\u7528\u304c\u98db\u8e8d\u7684\u306b\u5e83\u304c\u308a\u307e\u3059\u3002\u3088\u308a\u8c4a\u304b\u306a\u30d6\u30e9\u30a6\u30b8\u30f3\u30b0\u4f53\u9a13\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002\nPremium Plan\u306e\u6a5f\u80fd\uff1a\n\u30fb\u8907\u6570\u306e\u30eb\u30fc\u30e0\u2026\u8907\u6570\u306e\u30eb\u30fc\u30e0\u3092\u4f5c\u6210\u3057\u3001\u7528\u9014\u306b\u5fdc\u3058\u3066\u81ea\u5728\u306b\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\n\u30fb\u30d6\u30e9\u30a6\u30b6\u7121\u5236\u9650\u2026\u30c7\u30d0\u30a4\u30b9\u306e\u6027\u80fd\u304c\u8a31\u3059\u9650\u308a\u3001\u7121\u5236\u9650\u306b\u30d6\u30e9\u30a6\u30b6\u3092\u958b\u304d\u3001\u540c\u6642\u306b\u69d8\u3005\u306a\u30bf\u30b9\u30af\u3092\u51e6\u7406\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\uff08\u7121\u6599\u7248\u3067\u306f2\u679a\u307e\u3067\uff09\n\n\u73fe\u5728\u3001\u3053\u306e\u30a2\u30d7\u30ea\u306f\u30d9\u30fc\u30bf\u7248\u306e\u6bb5\u968e\u3067\u3042\u308a\u3001\u30e6\u30fc\u30b6\u30d3\u30ea\u30c6\u30a3\u306e\u5411\u4e0a\uff08\u64cd\u4f5c\u6027\u3001\u5b89\u5b9a\u6027\u3001\u89e3\u50cf\u5ea6\u3001\u51e6\u7406\u901f\u5ea6\u306a\u3069\uff09\u3084\u30d0\u30fc\u30c1\u30e3\u30eb\u30db\u30fc\u30e0\u306e\u81ea\u7531\u5ea6\u3092\u9ad8\u3081\u308b\u65b0\u6a5f\u80fd\uff08\u30dc\u30c3\u30c8\u3001\u30b9\u30ab\u30a4\u30c9\u30fc\u30e0\u3001\u30a4\u30f3\u30c6\u30ea\u
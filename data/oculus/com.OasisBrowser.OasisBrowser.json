NvwGJSSAk&_nc_oc=AdkCQbyECqjroZc_c5zhxeeLxPchLReOloXUs2HdBiGN8akvZM9epfiMjKrN11--e2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4tkAG884ddOcghj7d0lVyExMxtBoc-ii7OQuzW8gcoQ&oe=69AD646D"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46wVK6rIT6AQ7kNvwHGRCz_&_nc_oc=AdmdZnM_KHrGJUww0oOmpw0IZEKYfBDFNrPd7SenfToTqh4E1wMxRx5uR6vwufFFBQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTtpJrMrOI-52M9Z0lE8rNtqXu15IzooYy-0ezyiOsFg&oe=69AD6D31"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IGWflRX0C0Q7kNvwGWoSFt&_nc_oc=AdnLAXBj013HbR61AqUQsGDphpezH_hMvbsCXK0KbJ1qsLvlpGz7zCJL5fd7CKusTfg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwFEP-DVxiAgk5beUxfsGkUAXBx6ODbK8wk6d0fnciLg&oe=69AD6307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRmhLaiAm0oQ7kNvwFtBrDU&_nc_oc=AdnWpcEPoxrAZHYmt9rQghmrxjLKY7U-2Q7MvunzHAuHIX44ARWrbijAF1WKwmyjaHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhNgmFZfbGEzmAZufIYXxsJecFV4IZ_NpNl0CVb9PGMw&oe=69AD6E96"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary.\n\nCurrently, this app is in its beta version, and we are adding new features to enhance usability and increase the freedom of the virtual space. If you have any opinions, please do not hesitate to leave a review.\n\nWith Oasis Browser, you can freely construct your ideal virtual space for various purposes through the browser:\n- Relaxation Space: Choose your favorite space and enjoy a fulfilling relaxation experience with videos and music to soothe your mind.\n- Efficiency in Work and Learning: By placing multiple browsers within the space, you can work in an environment similar to a multi-monitor setup.\n- Ultimate Content Viewing: Enjoy movies in a dedicated theater room or play browser games on a large screen, significantly enhancing your entertainment experience.\n- Customizable Interiors: Arrange browsers like furniture, and display web content (such as images and videos) as virtual space displays or murals.", "short_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary."}, {"images": {"nodes": [{"file_name": "storecover3.png", "id": "1275576786385775", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036605_1275576789719108_4735332890343089726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfLtdoHWruQQ7kNvwEBte5c&_nc_oc=AdkAZS9SdLic9jRWRBuaoVmlNJv-3bcXQsR0Zdt0txs6knZAZdkIavnaNcylZXFZxKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvg1khRqv6KwyQBj1EcpWCGhMfqjw_P7IhTzgvLgz5zg&oe=69AD7FA2"}, {"file_name": "storeicon.png", "id": "1190240844983913", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_1190240848317246_625707758757251907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4ghDq00UPUQ7kNvwHbdFLu&_nc_oc=Adnu8NqZy06MPQoSBNHBBZCkIKsnB4ux6EUQUm4C7UT96eS4xx16siXFZCCd9QbUn-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_YMNj8xr5LxXHBnhrMJEgalZTpFf15K-i4syiMz9gjQ&oe=69AD6B6
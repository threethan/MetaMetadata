RDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvx1mGXcW_dUGGjRJGFZgZIdE-mwFHWO4oDqSnhjV4ynA&oe=699C40ED"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWryFxElNLgQ7kNvwFgmEEV&_nc_oc=Admnrq9RwRoY98RWxwYcYwhqv4O0LWnILRBJkF4s_XuZu9BFw9AJrW5laMOEJa-RRc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGarR2dzASw8Uz_-Sw8sAQs0zqa_O0Br9EBq2affC9Pw&oe=699C49B1"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXf_foGl4VkQ7kNvwHwcj9C&_nc_oc=AdndApheQ9uRCbh20LsnUgxVZpc3kAq77a8Ih_-2gQ1ZzrWPORD5q8rfjJI6-4LuhqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsgIVqHp30gBPslSlnbboO07-MMDbTuvkZneECffFMv9A&oe=699C3F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu9JIthaUHgQ7kNvwGxjedN&_nc_oc=AdlQUQug16sF4cBIV9vcZ3yx_0sv0ywa_0-sxQrlkvmQeabzQxuG1gOKzGIkE9NIUNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuLXd1fXbkiJHBZo9EF_5V-t2OOcKOVRqPFS3I-nbN6qQ&oe=699C4B16"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary.\n\nCurrently, this app is in its beta version, and we are adding new features to enhance usability and increase the freedom of the virtual space. If you have any opinions, please do not hesitate to leave a review.\n\nWith Oasis Browser, you can freely construct your ideal virtual space for various purposes through the browser:\n- Relaxation Space: Choose your favorite space and enjoy a fulfilling relaxation experience with videos and music to soothe your mind.\n- Efficiency in Work and Learning: By placing multiple browsers within the space, you can work in an environment similar to a multi-monitor setup.\n- Ultimate Content Viewing: Enjoy movies in a dedicated theater room or play browser games on a large screen, significantly enhancing your entertainment experience.\n- Customizable Interiors: Arrange browsers like furniture, and display web content (such as images and videos) as virtual space displays or murals.", "short_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary."}, {"images": {"nodes": [{"file_name": "storecover3.png", "id": "1275576786385775", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036605_1275576789719108_4735332890343089726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq4GUa8oahMQ7kNvwFh6Imj&_nc_oc=AdnjdxOHgmhxtPVDHEM7ASQ_F6iBx4oInNiDmcANv5VqgpHWoWhp3sS1FGfKgVdD4ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs7PVr-Ri1dedZsUjYNSxei_gEvGAJezXxys45Irr8iBg&oe=699C5C22"}, {"file_name": "storeicon.png", "id": "1190240844983913", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222944_1190240848317246_625707758757251907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZZQ1OL_7D4Q7kNvwFIIeid&_nc_oc=Adkow2CTm35sd1B6OTDRKY01pGu2fFzwMQl8HBL7o8VzeKtcb3F7vi2roBPRaJNhM0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftPHVO0PWyBfuvW0gBg9louiBQUFmo0pP1ieMcRr6FodQ&oe=699C47E9"}, {"file_name": "storecover1_4.png", "id": "680291394017029", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5
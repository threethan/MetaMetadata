EFj&_nc_oc=AdqzZJjVg26wUhqK9QyWNwmQZ8JXWmra3_O2liOUkZvxgX3Di39zFKaFTf-6Yr7MSwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMJMAkkxByUevmnZM1BWjZK5RaBvE0GXZ6b2vjzxGpvQ&oe=6B03112D"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74PnALtTCSMQ7kNvwHXh6D5&_nc_oc=Adq8V2tCRnUME9_7cyTGe0zLBcOomH2MMdZuCNRvJd76QMwtojl_LE4_aOGKNJXqwpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG0m1JcE7hP8tt36LHhDtTkbxxbeOfAHmqcgAnMSdr_g&oe=6B0319F1"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2DB_9ETF2AQ7kNvwE4JoJC&_nc_oc=Ado06B7tkfHs9wdO2nz9434L3IUf8s0JVsNcgGxUOQGlb1GHzRmpsEZkyjeENvUAJiY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz2Elg_iusv3YNzKo0-kNwqLfsyWkTVk3SBzwy7AaOuw&oe=6B030FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovYt7VBVDg0Q7kNvwFX0392&_nc_oc=AdoW8K6LXNm8KdeG6xqHdd2QRrIXreI_Y5lyd9aDfqSqUFqGoIvMN4ipv_1aGMbXfdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrH9ykNKldbLpKX-fSdbMuCdHW4u4i1wYHdnakNmIKuw&oe=6B031B56"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an application for creating your ideal virtual home. By freely placing browsers in your virtual home, it provides the ultimate browsing experience in your ideal space.\n\nBy using Oasis Browser, you can create your ideal virtual home for various uses.\n* Relaxation Space: Choose your favorite space within it for a rich relaxation experience.\n* Work or Study Efficiency: By placing multiple browsers, you can work in a multi-monitor-like environment.\n* Content Appreciation: Prepare your own theater room to watch movies, play browser games on the big screen, and achieve the best entertainment experience.\n* Interior: Browsers can be arranged like a display or a mural.\n\nFeature\n* Browser: Freely place browsers in your virtual home and explore the world of the internet.\n* Room: Choose the skydome and interior according to your preferences and purposes, and customize your ideal virtual space.\n* Hand Tracking: All operations are performed with hand tracking. All you need is to wear your HMD.\n\nPremium Plan\nBy purchasing the premium plan for $9.9, your use of the virtual home will expand dramatically.\nPremium Plan Features:\n* Multiple Rooms: Create multiple rooms, and switch freely according to your needs.\n* Unlimited Browsers: Open as many browsers as the performance of your device allows(up to 2 for the free plan).\n\nAt present, this application is currently in beta. If you have any feedback, please write a review.", "short_description": "Oasis Browser is an application for creating your ideal virtual home. By allowing you to freely placing browsers within your own virtual home, it provides the ultimate browsing experience in your ideal space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oasis-browser.com/terms-and-privacypolicy/", "developer_terms_of_service_url": "https://oasis-browser.com/terms-and-privacypolicy/", "publisher_name": "Oasis Browser", "support_website_url": null, "website_url": "https://oasis-browser.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
7U8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvo2QVadgolwstHK8YS3N5fhEkmSfgnS2dSSuOTUitQEA&oe=69A2D86D"}, {"file_name": "screen_4.png", "id": "1195167941881423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974732_1195167948548089_467822141341740848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bikUF45dQE8Q7kNvwEUX_9E&_nc_oc=AdkjyJKf-m-sM83TeOcUnthQQx6M_ZEUwnJLBTBoB_Gn5dTTpUAcRQKsysm47ZF7Wfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDXMuWkVu5aQZjU2_y6DX_S5l_MJypYbzidhnV4uT0Wg&oe=69A2E131"}, {"file_name": "screen_5.png", "id": "6208657872543990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_6208657875877323_466584569315061068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrAN7hD_s6sQ7kNvwE9yXr0&_nc_oc=AdmfaeongGXdwRKETbQcyb-03KBd5kwCWM0MNtf_NK_4J4HDTzBXtrdXArFb9vNojhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYnFqy35Y3xSmvne4DW9Z4IWoQ88dGdcq5hxDe2ubcaQ&oe=69A2D707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "801860524838418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974756_801860528171751_51630421722202083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG2rgRw7OXoQ7kNvwH4Qomj&_nc_oc=Adn0dXkOtm7zVxZeX3miQp0U5VoaWq_50_0UdbHVVOg42qPyz4wiPHSeFBFI5t0hWSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKCeBx2BxaReCf89eAfibkRzou5r4ht0zj_ugCRr7q8g&oe=69A2E296"}, "display_name": "Oasis Browser", "keywords": [], "long_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary.\n\nCurrently, this app is in its beta version, and we are adding new features to enhance usability and increase the freedom of the virtual space. If you have any opinions, please do not hesitate to leave a review.\n\nWith Oasis Browser, you can freely construct your ideal virtual space for various purposes through the browser:\n- Relaxation Space: Choose your favorite space and enjoy a fulfilling relaxation experience with videos and music to soothe your mind.\n- Efficiency in Work and Learning: By placing multiple browsers within the space, you can work in an environment similar to a multi-monitor setup.\n- Ultimate Content Viewing: Enjoy movies in a dedicated theater room or play browser games on a large screen, significantly enhancing your entertainment experience.\n- Customizable Interiors: Arrange browsers like furniture, and display web content (such as images and videos) as virtual space displays or murals.", "short_description": "Oasis Browser is an app that allows you to freely place browsers in a virtual space, marking the first step in creating your own ideal virtual space. All you need is to wear a Head-Mounted Display (HMD), and nothing else is necessary."}, {"images": {"nodes": [{"file_name": "storecover3.png", "id": "1275576786385775", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036605_1275576789719108_4735332890343089726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViWjO1vXIaUQ7kNvwGKwL-O&_nc_oc=AdnHQgVxqGSRpXadzrP1uZ-KTbZ6OLFv-0V6xLT_lrKu1q1l6w-1BC4rNxqRdtcAIfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteBhinvoPwhP7mmYfU2xxlMJxMoluo4fLg8d4NJT9JhQ&oe=69A2F3A2"}, {"file_name": "storeicon.png", "id": "1190240844983913", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_1190240848317246_625707758757251907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4iJDM6o7Z8Q7kNvwGvm7Zi&_nc_oc=AdkD-B1YHXz00HLTwuwSoaBK3jRQAmfYz1EnaDdUFJNIaft7En8nnfO9WPBNhr1sW8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwvcoP4OYg2iYJwKVMYlCFmlOboJfIRQ2BPfDGxLQs3A&oe=69A2DF69"}, {"file_name": "storecover1_4.png", "id": "680291394017029", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3
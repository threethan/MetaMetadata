RLdKwkh9ZHoKP1oY4VjFcr1a4YYvkTQHIOCq9pvQVUhg&oe=6AFB302B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EF-VR Oculus App Lab Cover Art Landscape.png", "id": "252965883002072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035424_252965886335405_7319811021161173829_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU1MXhAD_F4Q7kNvwGX-a0y&_nc_oc=AdqHeyV-WBufluJoUXoP76YKORXl0Wr19GxcmXW3q_WMaWCWqqhL4WPUjzyXIHU8fOk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ78hVo3RKU8Pgp6qdQGUpcKBfuOMXic9PY-JgGReovmQ&oe=6AFB4B9D"}, "display_name": "Edge Factor VR", "keywords": [], "long_description": "Edge Factor's Virtual Reality Experiences are all about experiential learning. VR takes this to the next level, giving students a closer look at interests and industries during their career exploration.\n\nLearn about industries from around the country. Experience tours and demonstrations with industry professionals. Interact with objects, inspect life-size models, and discover a whole new way to learn. Explore gamified experiences with quizzes, challenges, and experimentation to ignite a passion for learning and career exploration.\n\nVirtual Reality  =  High Impact Experiential Learning\n\nAn existing Edge Factor membership is required to access.", "short_description": "Take experiential learning to the next level with Edge Factor's Virtual Reality Experience. Explore industries from around the country and ignite a passion for learning and career exploration. An existing Edge Factor membership is required to access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://edgefactor.com/V5/pages/PrivacyPolicy.aspx", "developer_terms_of_service_url": null, "publisher_name": "Edge Factor Inc", "support_website_url": null, "website_url": "http://www.edgefactor.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_c
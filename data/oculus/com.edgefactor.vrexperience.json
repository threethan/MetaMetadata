_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PXrI0dn1F4Q7kNvwGobeai&_nc_oc=Adq89o7uIRjSIVlfWMmvSNGNS3U7OUvcGiUJLXqBkh-CfGladzGpDPo4klfiFOcmdgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPSd0SaARt0yqR7SK5uPz_6HnK0qsM0p2U85V0SI98FA&oe=6A5CDF5D"}, "display_name": "Edge Factor VR", "keywords": [], "long_description": "Edge Factor's Virtual Reality Experiences are all about experiential learning. VR takes this to the next level, giving students a closer look at interests and industries during their career exploration.\n\nLearn about industries from around the country. Experience tours and demonstrations with industry professionals. Interact with objects, inspect life-size models, and discover a whole new way to learn. Explore gamified experiences with quizzes, challenges, and experimentation to ignite a passion for learning and career exploration.\n\nVirtual Reality  =  High Impact Experiential Learning\n\nAn existing Edge Factor membership is required to access.", "short_description": "Take experiential learning to the next level with Edge Factor's Virtual Reality Experience. Explore industries from around the country and ignite a passion for learning and career exploration. An existing Edge Factor membership is required to access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://edgefactor.com/V5/pages/PrivacyPolicy.aspx", "developer_terms_of_service_url": null, "publisher_name": "Edge Factor Inc", "support_website_url": null, "website_url": "http://www.edgefactor.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
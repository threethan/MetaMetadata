scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA9Iwfod5g1iRR7uKyrabYqw18j_JyYqRzQal5DmRGZg&oe=69C52383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mini_video.png", "id": "145148237432263", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458095_145148240765596_7795154181803167711_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqSv-Kt0WEwQ7kNvwFMnP38&_nc_oc=AdoK4byq_CLZqvcaNxzQ0KKoqtISotovw_z6WxogpXIoAt24vasn0UorCNALmS0gmK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVg53dkcsFof1mq3Cec7jeEqXrQR0PWh-QA5sGGLN6YQ&oe=69C5226E"}, "display_name": "TripeaksDreamland VR", "keywords": [], "long_description": "Tripeaks Solitaire card game with beautiful graphics in VR!\n\nfeatures:\n- Full Oculus Quest/Quest 2 VR-Controller support\n- Three difficulties\n- Smooth graphics\n- online high scores\n- 150 levels with different layouts\n- 5 languages selectable (English, German, Spanish, Turkish, Polish)\n\nMp3 Dateien im Musik Ordner unter \"tripeaks\" ablegen.\n\nUse the Touch Thumbsticks to control the music:\nPress = Start/Stop\nUp = Volume Up\nDown = Volume Down\nRight = Next\nLeft = Previous", "short_description": "Tripeaks Solitaire card game with beautiful graphics and unique environment in VR!\n\nFull Oculus Quest/Quest 2 Controller support!\n\n150 different card layouts!"}, {"images": {"nodes": []}, "id": "132448825394132", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TripeaksDreamland VR", "keywords": [], "long_description": "Tripeaks Solitaire Kartenspiel mit wundersch\u00f6nen Grafiken in VR!\n\nFeatures:\n- Volle Oculus Quest/Quest 2 VR-Controller Unterst\u00fctzung\n- Drei Schwierigkeiten\n- Smoothe Grafiken\n- Online-Highscores\n- 150 Levels mit unterschiedlichen Layouts\n- 5 Sprachen w\u00e4hlbar (englisch, deutsch, spanisch, t\u00fcrkisch, polnisch)\n\nTouch Thumbsticks verwenden um die Musik zu steuern:\nDr\u00fccken= Start/Stop\nHoch = Lautst\u00e4rke erh\u00f6hen\nRunter = Lautst\u00e4rke verringern\nRechts = N\u00e4chster Song\nLinks = Vorheriger Song", "short_description": "Tripeaks Solitaire Kartenspiel mit wundersch\u00f6nen Grafiken und einzigartiger Umgebung in VR!\n\nVolle Oculus Quest/Quest 2 Controller Unterst\u00fctzung!\n\n150 verschiedene Kartenlayouts!"}]}, "developer_name": "Daniel Ali", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/a91d69a4-a73e-47e8-bbf3-bfc66283ec47", "developer_terms_of_service_url": null, "publisher_name": "Daniel Ali", "support_website_url": null, "website_url": "https://discord.gg/tNAsJzz6", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "tr", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3138829343066719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75542967_168920248076077_4195368207170033729_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKCbuaTVah8Q7kNvwH7zeiJ&_nc_oc=AdqZsb_-XkfsRqKvvQHnF5STI3TswApW4P_2y64NrWaiCJYBTs3nvIs6Km97YCpUAJM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG9uytsJbppd4w7pF7iZU5e-RVyuKC8sqjRZMU0QqTmA&oe=69C53F15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TripeaksDreamland VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES"
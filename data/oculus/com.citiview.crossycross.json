9567533050347348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjoflKph8PsQ7kNvwGZZsu9&_nc_oc=Ado31RAHnwu3YlP_XdrzSPcuR3da_nzE7ns4ZmuA9kbRDgOGEqDiqenC7gvMSViI80U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqhDZY6onCXZy5gyBqTaUL7dyGLHH5H3GG3TrnSz70HQ&oe=6AFDDC11"}, {"file_name": "screenshot_3.png", "id": "1415666383988938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673558985_1415666387322271_222868901245530939_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QttH_q7RYsIQ7kNvwG14zzy&_nc_oc=AdrNcWcDAPNrClDHhtP5aTYUoR-zRSY_haHvIHS1uF1R3OPF7Sc085jAs3V_hvewWQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwDq3qFLSHHsiY2pN-pcoQvBbAJy9QmKBtr6Ix16GzoQ&oe=6AFDC845"}, {"file_name": "screenshot_4.png", "id": "1457470112914208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1457470116247541_7955604284412297563_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJuIpQFl6pAQ7kNvwFcQqcG&_nc_oc=Adr4trWitiha5kUFEV9YXI9UmhTI4JISDX38lIPUXGM2rGAcrFbIYOgNlvxSuqvlBCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7IyRZTuGxkTtuldfPgmIh3UtuHHfBNF5WjHoNHdEJiA&oe=6AFDD337"}, {"file_name": "screenshot_5.png", "id": "1405722011684542", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673645340_1405722015017875_495561512466988472_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIh-H-BRoX8Q7kNvwFOO_Iu&_nc_oc=AdqF6aOaaDEPODS5ATV9ZG-RgRPKsDENbnYtViZmhWUS38gpdB1nQo_qT4D3ZdBgO1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzf2MvES2UTZvI5qAQlALJp28IAPr3GcuuGNGvb-TI5w&oe=6AFDB10E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1895812798057467", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613094043_1895812801390800_2087063905974255061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbe_VzmTDg8Q7kNvwESBuJj&_nc_oc=AdoPwliOE3WHp8q4_IcxJUtWFnGQvgVqKvlm9oXJtVR4Jv6TnZ5X67JgN7KOOmO7n4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnuXWxic4z0eFwP0SVcX1cWsAptO0ADp2700c0dmz37A&oe=6AFDE35B"}, "display_name": "Crossy Cross", "keywords": ["arcade", "traffic", "highway", "crossing", "casual"], "long_description": "You are standing on the pavement. Six lanes of traffic are between you and the other side.\n\nWatch the lanes, find your gap, and walk. Three lanes run each way, every lane at its own speed, and the pattern never repeats. The painted line between two lanes is a safe place to stand - if your nerve holds while a truck passes a metre from your face.\n\nGet it wrong and the world drops into slow motion as the car throws you down the highway, traffic streaming past underneath you, before you land back on the kerb to try again. No lives, no game over.\n\nScore is the point. Every crossing pays a multiplier that climbs the longer you stay clean, up to five times. Near misses pay. Gold coins hang over the lanes and pay again - but the safe gap is rarely the one with the coin in it. A hit costs points and wipes your streak. Clear a world's crossings to bank the run and earn up to three stars.\n\nTen worlds, ten skies: a country road at noon, wheat fields at golden hour, a motorway at midnight lit by headlights, red desert, a city at rush hour, a snowstorm, autumn woods, ash fields under glowing lava, a neon city, and a dust-red planet with the fastest traffic of all. All ten are unlocked from the start and each keeps its own best score.\n\n- Six lanes and a median island to rest on\n- Slow-motion launch when a car gets you\n- Streak multipliers, near-miss bonuses, collectable coins\n- Three stars and a saved best score per world\n- Comfort first: stick walk, 45 degree snap turn", "short_description": "Six lanes of traffic, on foot, in VR. Read the gaps, walk, and don't get it wrong - one bumper sends you down the road in slow motion. Ten worlds, streak multipliers and stars."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/crossycross/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/crossycross/", "website_url": "https://citiview-games.pages.dev/crossycross/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253060281233278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/748437750_1745588756744514_6529258798729973324_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvBZPX-5DhwQ7kNvwFPyY0O&_nc_oc=AdqbJh6ANSVS7dw9EAn4NMZGmUsD_jBv7AAxJKgsfykE1DyRqhMztXbju7tXiD8uBrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI2pkkn56MMJl7c6gLnHrRgZmiUNE_2DCt1eEH_IdIwg&oe=6AFDCA15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crossy Cross", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1792074900, "lastRevision": {"nodes": [{"id": "125306029123
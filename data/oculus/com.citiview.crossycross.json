9567533050347348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjoflKph8PsQ7kNvwFwMQBK&_nc_oc=AdrEd6AVeIT42tMpxGgGcbJqT7WRltqIJbraNRgALs1mGGvtdm3inifU5eSSBeOdShg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLMc97Q1QS99ltBwIcnDMAQDDwInwgVcBArWqu7NGzQ&oe=6AFB3911"}, {"file_name": "screenshot_3.png", "id": "1415666383988938", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673558985_1415666387322271_222868901245530939_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QttH_q7RYsIQ7kNvwGc_BWy&_nc_oc=AdpWQZ97BKNqORXoMbsWDeX9AjNkLFCwt3sYybU3F8osNCdX4nnRaz-nPIVHQccPeI4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyfFw-6dDfn9zqdJJvvSiDKZfxrqnRMplYQ0iHHHQwPQ&oe=6AFB2545"}, {"file_name": "screenshot_4.png", "id": "1457470112914208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/596149727_1457470116247541_7955604284412297563_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2cSoz3LY8cQ7kNvwGp7sRi&_nc_oc=AdpErPaIfXSLzWW8YTMKCtUPK_Fb-Ib3Tlr495crAPPHwC_JopLBGwZCqQzNm51N4UM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8FQk__QaRuV5mqJw1qrzLN_AbREe1yHAeT5TnvZjGjA&oe=6AFB3037"}, {"file_name": "screenshot_5.png", "id": "1405722011684542", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673645340_1405722015017875_495561512466988472_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBotkDWCBN0Q7kNvwF_qmUe&_nc_oc=AdqDlWudjMupPYslEGcZ-eLGJ2q3HzHR30FjrdOZF1v8tD_SbtHMNG7dj41e3-U2IIc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6Z5mfEulkq2aIgCGJ7s2o-xKBxNLcZt1_t2mdLoV1jA&oe=6AFB464E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1895812798057467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/613094043_1895812801390800_2087063905974255061_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbe_VzmTDg8Q7kNvwHfiLqu&_nc_oc=Adpt9zgft1m4kgAbwOuEYpt-zHjq1kTOzR65g7o1vDIFwgVOmDFL42npTjo0fY2Usqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ABNhWnJj1eHOSpICE48ONGr3Xor-hX7-91RVZQ-P-w&oe=6AFB405B"}, "display_name": "Crossy Cross", "keywords": ["arcade", "traffic", "highway", "crossing", "casual"], "long_description": "You are standing on the pavement. Six lanes of traffic are between you and the other side.\n\nWatch the lanes, find your gap, and walk. Three lanes run each way, every lane at its own speed, and the pattern never repeats. The painted line between two lanes is a safe place to stand - if your nerve holds while a truck passes a metre from your face.\n\nGet it wrong and the world drops into slow motion as the car throws you down the highway, traffic streaming past underneath you, before you land back on the kerb to try again. No lives, no game over.\n\nScore is the point. Every crossing pays a multiplier that climbs the longer you stay clean, up to five times. Near misses pay. Gold coins hang over the lanes and pay again - but the safe gap is rarely the one with the coin in it. A hit costs points and wipes your streak. Clear a world's crossings to bank the run and earn up to three stars.\n\nTen worlds, ten skies: a country road at noon, wheat fields at golden hour, a motorway at midnight lit by headlights, red desert, a city at rush hour, a snowstorm, autumn woods, ash fields under glowing lava, a neon city, and a dust-red planet with the fastest traffic of all. All ten are unlocked from the start and each keeps its own best score.\n\n- Six lanes and a median island to rest on\n- Slow-motion launch when a car gets you\n- Streak multipliers, near-miss bonuses, collectable coins\n- Three stars and a saved best score per world\n- Comfort first: stick walk, 45 degree snap turn", "short_description": "Six lanes of traffic, on foot, in VR. Read the gaps, walk, and don't get it wrong - one bumper sends you down the road in slow motion. Ten worlds, streak multipliers and stars."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/crossycross/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/crossycross/", "website_url": "https://citiview-games.pages.dev/crossycross/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253060281233278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/748437750_1745588756744514_6529258798729973324_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvBZPX-5DhwQ7kNvwHe35MW&_nc_oc=Adpq1WOc2NvqZAo0YyLtr9iigtYJsicrhYn9m1AwnRxr4Yf1VzWU4_37G4Rnp66KNFc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVhFYj0TjkyKu1lp33jnzO-AnmQj5noNDyTLPeryQxDQ&oe=6AFB2715"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crossy Cross", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1792074900, "lastRevision": {"nodes": [{"id": "125306029123
7B399"}, {"file_name": "SampleScene_Custom_._09.01.2026_18-12-42.png", "id": "1975868566694855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308307_1975868570028188_201881406722845581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8vkMcVgNq8Q7kNvwEl3r6m&_nc_oc=AdpGOrkpg10quAdx9lbKc2rSWzqMF5Rum4XOdSASUjo8kfwkQRQN21zAMYFJK40wji0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U50dAVw-1VunrKkH_SSP6XjjoQXOSPsQZswQRvXu-XQ&oe=69D7BD16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outbreak Dreadwood", "keywords": ["OutbreakDreadwood", "MultiplayerHorror", "FacilityHorror", "SurvivalHorror"], "long_description": "Step into the darkness of Dreadwood Forest, where an abandoned containment site hides more than just shadows. What began as a secret experiment has spiraled into a nightmare that no fence, no wall, and no soldier could ever stop. In Outbreak Dreadwood, you are trapped in a sprawling facility that leads into a forest shrouded in fog, hunted by horrors that thrive in the silence. Every creak of a branch, every whisper of the wind could be your last warning before they find you. \n\nImmersive VR Survival Horror \u2013 Experience fear like never before with full 360\u00b0 immersion. \n\nDynamic Exploration \u2013 Navigate abandoned outposts, blood-soaked trails, and hidden underground facilities. Unrelenting Tension \u2013 Limited resources force you to make every bullet, every step, every breath count. \n\nEarly Access Terror \u2013 Get in first, survive the outbreak, and shape the future of the game with your feedback. The outbreak was never contained. It was only delayed. \n\nAre you ready to step into the woods\u2026 and never walk out?\n\n\n", "short_description": "Step into the darkness of Dreadwood Forest, where an abandoned containment site hides more than just shadows. What began as a secret experiment has spiraled into a nightmare that no fence, no wall, and no soldier could ever stop. Every creak of a branch, every whisper of the wind could be your last warning before they find you. The outbreak was never contained. It was only delayed. \n\nAre you ready to step into the woods\u2026 and never walk out? \n\nEarly access terror; more monsters coming soon!!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/outbreakdreadwoodvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5StarStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/outbreakdreadwoodvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25854770600824520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1630673598366308"}]}, "baseline_offer": {"id": "1630673598366308"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770318060, "status": "PUBLISHED", "id": "1630673598366308"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25904659392502307", "version": ".32"}, "id": "2135672217229876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
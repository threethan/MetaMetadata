_nc_sid=6e7a0a&_nc_ohc=BdwnCpHomlEQ7kNvwElGLzU&_nc_oc=AdphLiuG35lRXaATIgzm029N8rAEHz27881gfCBs9OCeq0ZpeyXS4YqnxU-Dq6DshyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcnrh539ADjnXBcC7V3ugdrCVXWhoJtAO_XT7NDCRxRQ&oe=6ADE020E"}, {"file_name": "Hell Hazard Map_2026-02-19_16-56-01.png", "id": "1257906562949930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308090_1257906569616596_5415881241101624630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_ypVYHn3cAQ7kNvwF5c9le&_nc_oc=AdpbnP_THv04yOcB1vr8CNXCkTFvKaDvtkXKXS4t9he83VTz9YA7O5fl5QCm_fqI9Tk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYjwVMHD2XGMJaiBpzq1JRHp-0aPMtYAeHVlyGwRedHQ&oe=6ADE0700"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hell Hazard VR", "keywords": ["Hell", "Hazard", "Fangame", "Horror"], "long_description": "Welcome to Hell Hazard! We're delighted to have you embrace this unique, heart-pounding game where horror meets fun, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a horror master. Whether you're chasing or finding monsters, this is an experience like no other, combining horror gameplay with an immersive style of movement.\nIn Hell Hazard, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of exciting-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure energy. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Hell Hazard offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, horror, and fun blend seamlessly. Welcome to the game\u2014let the monster chase begin!", "short_description": "Welcome to Hell Hazard VR, a new Virtual Reality horror game with controller propelled movement! With scary maps like Caves and the Backrooms, Hell Hazard is a MUST try with your new device!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1CjGejTKMYy2aC0ARUkR9HOHXWfxaLrCspLcMIaIECuY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hell Hazard Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/hellhazard/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26655915290662544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300678_931392172757510_434232163906242381_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=683am101Z38Q7kNvwFfk80s&_nc_oc=AdruEb_PHQGYsxiwHPmRvAwZdCv8lF7rf0WROgE7a-pdh9GXwSWlFMfcVK9hIpCJeqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTeacSPw_pyBa8lpigmSyOzmr
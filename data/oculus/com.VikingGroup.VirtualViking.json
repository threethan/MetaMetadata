23918609194422323_1307554009599085009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEflZWbz_SkQ7kNvwHKqjas&_nc_oc=AdpS5Ed9JhAsihQUIKtu1HUVHwu0fCiHxOAFKgRW7YCdHSh7JMS6FkK7aanVI2OUiQk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-do8Tcz_LhAgl7UXOyiyFbltM_qkZ4StsU9lwPxUNH6g&oe=6A22CE8A"}, {"file_name": "ScreenShot_FireExtinguished_Meta.png", "id": "703065362078941", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499329485_703065365412274_5978245389301661359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyCvM317AdUQ7kNvwGCp3--&_nc_oc=AdoJyPumHSQEuYLD21PktiivVDkN0TLUsiG2Qb2WWFuhlmlBBfvg_nTwaffAyLN9Lp8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dbmJ3x11XVG1Vtnv7yTm82V2oD4XfNlt3pAYnacyG1w&oe=6A22FB15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Viking", "keywords": ["Sprinkler", "Valve", "FireProtection", "Viking", "Training"], "long_description": "# Watch it *\u201cburn\u201d*\n- Experience a fire in a building and how that fire is controlled with the use of a fire protection system.  \n- Explore the operations of various systems including Dry, Wet, and Pre-action systems.  \n- Learn how each individual component aids in system operation and allows the system to operate effectively to control the fire. \n- Witness the importance of proper sprinkler placements and their role in controlling building fires. \n\n# Get hands on\n- Learn interactively by placing a valve in working service.\n- Get a feel for system components such as ball valves handles, shut off valves, and internal assemblies by interacting with them in Virtual Reality.\n- Train yourself to operate the various interfaces of fire protection systems. \n\n# Trusted above all\nFor almost 100 years, Viking has led the industry in the design and manufacture of the finest fire protection products. And our products will be hard at work for the next 100 years and beyond \u2013 providing the peace of mind that comes with worry-free fire protection.\n\nVirtual Viking is for training and entertainment purposes only, it is not a replacement for technical data.", "short_description": "- Experience a fire in a building and how that fire is controlled with the use of a fire protection system.  \n- Explore the operations of various systems including Dry, Wet, and Pre-action systems.  \n- Learn how each individual component aids in system operation and allows the system to operate effectively to control the fire. \n- Learn interactively by placing a valve in working service.\n- Train yourself to operate the various interfaces of fire protection systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vikinggroupinc.com/privacy", "developer_terms_of_service_url": "https://www.vikinggroupinc.com/virtual-viking-terms-of-service", "publisher_name": "Viking Group", "support_website_url": null, "website_url": "https://www.vikinggroupinc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10022324424514011"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2761641997557047"}]}, "baseline_offer": {"id": "2761641997557047"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747933500, "status": "PUBLISHED", "id": "2761641997557047"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
-25/499296027_704858235928899_1490460010222515890_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efhpa9-OZ38Q7kNvwER8m9R&_nc_oc=AdpUstV1bUSjSAQ2NwLbMBJ34KF4MQinNWZeTYkpD0VypB0TOdlbZ5HMHkBCBUGpbmw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF10rduebx5PtSBrGVRWQ928RMc8UFQmS1AlfQZQq6whA&oe=6A857B9B"}, {"file_name": "GasVR_Screenshot03.png", "id": "1164284932238004", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830411_1164284935571337_632668846500735183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqSTcyQQw6gQ7kNvwGwBRT_&_nc_oc=Ado3naXZ_6LnVpx6qlqpRPrPPFcBOTLc0S9zMYV5o843lsiSp64eyxdx1QRF7oeU7HI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLunaj-dphTV2Rdft72QQbFwsgJdyt13VcOLnVe97t1g&oe=6A859F1F"}, {"file_name": "GasVR_Screenshot02.png", "id": "2051048835467035", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821923_2051048838800368_9184841817902953017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2H9ZGTiqlgQ7kNvwE2oYCY&_nc_oc=AdqBIwK-tDLXVTyxPaSiA8KXJFWt5V08wfiUzA0KATLFOyJgg_wex1Jr7CLQGn1LuAY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY-k1qgAAdNEftNt2qw6IaM-8UM81m03CKqkLGQ3pFVw&oe=6A85AB4A"}, {"file_name": "GasVR_Screenshot01.png", "id": "1267371081916835", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296209_1267371088583501_1390588770590342542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNGPtXpQYDUQ7kNvwFUu154&_nc_oc=AdrZTxx6KDtwLCLC1VBJa3HTOAkSDDBodO0DgMO8tLBAOTha4HY8peyZKEYz4eBvY_I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTIBT2BEFPh0Na0ZEt4ub5LBqePqYe1dQdZUhDdgW9IQ&oe=6A8596C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Fireplace Basic Diagnostics", "keywords": ["NCSG", "Chimney", "Sweep", "Training", "Gas"], "long_description": "\n\n**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools.\n\n**Gas System Fundamentals** \u2013 Learn how common gas fireplace systems are designed, including millivolt and electronic ignition configurations.\n\n**Component Identification**\u2013 Identify key gas components such as valves, pilots, thermocouples, thermopiles, stepper motors, limit switches, and shutoff devices.\n\n**Electrical Testing Procedures** \u2013 Practice safe multimeter use for voltage, resistance, and continuity testing across gas system components.\n\n**Operational Understanding** \u2013 Observe how gas systems operate during startup, normal operation, and shutdown, and how failures affect performance.", "short_description": "**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From The Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIR
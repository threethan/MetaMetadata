&_nc_ohc=71ehtokCI3wQ7kNvwFhmvfz&_nc_oc=Adnk_Uo6IHNGF7RZl2FqjTvZSBY7Yq1_jMRRIzpPKwCRKlHxjlSKzqoOUrVHePNWUsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9QvUYmBE1HD7Kn2C8Zj393w63r0s6UXe1_v9UstGcww&oe=69A837DB"}, {"file_name": "GasVR_Screenshot03.png", "id": "1164284932238004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830411_1164284935571337_632668846500735183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2GKDuDRlsUQ7kNvwGAvboY&_nc_oc=AdkgS4QePPzi2Uffc-3-ZGlnaoutmSVsZbQaZ4Gqp0ZEEr9kA3eMDvGPjz7BX1vtQ0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYDqTNwjkGWjV1IA0OtbciYfpzeyItD_79sysIKiBhmg&oe=69A8231F"}, {"file_name": "GasVR_Screenshot02.png", "id": "2051048835467035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821923_2051048838800368_9184841817902953017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKMiSoaH8YcQ7kNvwFXuRuD&_nc_oc=Admjvirj0Sz2qtM9BJp67V5LATkdGDF33gogPWkbCzU3gK2CqIYnM0navIENNo5ELCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_uWgvUXZ0TF--16ioPRD6r8e3QGUNNix0PMmNKBgMHg&oe=69A82F4A"}, {"file_name": "GasVR_Screenshot01.png", "id": "1267371081916835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296209_1267371088583501_1390588770590342542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L9hSNV1T1QQ7kNvwHxhj1W&_nc_oc=Adm7WTdsOYbH0YFHh0C65FirydjSqv9r5LbOURChlhmHGLo5Euwpf8eLwbcAPeuT4ZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugN--PE1T1rsbFCZr9Qn3RK48Edo6Ie6wAM_nym6Tx5A&oe=69A81AC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Fireplace Basic Diagnostics", "keywords": ["NCSG", "Chimney", "Sweep", "Training", "Gas"], "long_description": "\n\n**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools.\n\n**Gas System Fundamentals** \u2013 Learn how common gas fireplace systems are designed, including millivolt and electronic ignition configurations.\n\n**Component Identification**\u2013 Identify key gas components such as valves, pilots, thermocouples, thermopiles, stepper motors, limit switches, and shutoff devices.\n\n**Electrical Testing Procedures** \u2013 Practice safe multimeter use for voltage, resistance, and continuity testing across gas system components.\n\n**Operational Understanding** \u2013 Observe how gas systems operate during startup, normal operation, and shutdown, and how failures affect performance.", "short_description": "**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From The Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
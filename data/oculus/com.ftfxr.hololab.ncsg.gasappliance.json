&_nc_ohc=JKr7QyQyFiMQ7kNvwEucYHM&_nc_oc=AdkPIY7zBTEDiKGZQJ9k5R7MRGoU33AKR3g8TcI8Rn37d-Iwy7HwG_hevwjb0Go1-l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKJLem38b-otc_oRIEzDYiiLsHrg5NdT8ApiGez6IOKw&oe=69BBFE5B"}, {"file_name": "GasVR_Screenshot03.png", "id": "1164284932238004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830411_1164284935571337_632668846500735183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWqNnHZATrcQ7kNvwEAWtuk&_nc_oc=AdkhkSS9r17VBGvcW4w-6H-ohO3sb4YmrOXzxv7wGIua-C8K4K-RZ5QDuSGA-uFabdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfQdw7MZDy2omr0tsf70M8sEPZbXZbdPuC7G-unEnBqw&oe=69BBE99F"}, {"file_name": "GasVR_Screenshot02.png", "id": "2051048835467035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821923_2051048838800368_9184841817902953017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JNLer7wVEIQ7kNvwFKU84y&_nc_oc=AdlYFCVHxIJVKkkuK0L41OpkJtkk5-SMI1ZAYshQ3-UMRJA_XKidJ_ftzRP5T6Jvyy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afye2wPp-miBTr5FTJ04UVFhsk5jho0DXOboaP5_JRJxhw&oe=69BBF5CA"}, {"file_name": "GasVR_Screenshot01.png", "id": "1267371081916835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296209_1267371088583501_1390588770590342542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVocYDXmVtIQ7kNvwHbA9e1&_nc_oc=AdlUUgVdeDRBQLJfdxDEYAS-zxuJLFiVBe6mKO6rjFM025Cz74cpEuyeSRzEE6H4u6c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweTNZgh4kRgNR-UuDpDAO1SSIOSlKXPKMxZhZqBT33ag&oe=69BBE148"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Fireplace Basic Diagnostics", "keywords": ["NCSG", "Chimney", "Sweep", "Training", "Gas"], "long_description": "\n\n**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools.\n\n**Gas System Fundamentals** \u2013 Learn how common gas fireplace systems are designed, including millivolt and electronic ignition configurations.\n\n**Component Identification**\u2013 Identify key gas components such as valves, pilots, thermocouples, thermopiles, stepper motors, limit switches, and shutoff devices.\n\n**Electrical Testing Procedures** \u2013 Practice safe multimeter use for voltage, resistance, and continuity testing across gas system components.\n\n**Operational Understanding** \u2013 Observe how gas systems operate during startup, normal operation, and shutdown, and how failures affect performance.", "short_description": "**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From The Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
CA"}, {"file_name": "GasVR_Screenshot01.png", "id": "1267371081916835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296209_1267371088583501_1390588770590342542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_v7Axy3pHsQ7kNvwHpy3K-&_nc_oc=AdqxX8RqWCb2qVNoTHVh_D-1qaqjDhMuAp2ZBjPLVA67569fFNjD1i-9YzY33XvG_n8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F0V1BsoMENm3a5-K7B0VT_BEYkBXfvyYa7ObJLay3Bg&oe=6A301D88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Fireplace Basic Diagnostics", "keywords": ["NCSG", "Chimney", "Sweep", "Training", "Gas"], "long_description": "\n\n**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools.\n\n**Gas System Fundamentals** \u2013 Learn how common gas fireplace systems are designed, including millivolt and electronic ignition configurations.\n\n**Component Identification**\u2013 Identify key gas components such as valves, pilots, thermocouples, thermopiles, stepper motors, limit switches, and shutoff devices.\n\n**Electrical Testing Procedures** \u2013 Practice safe multimeter use for voltage, resistance, and continuity testing across gas system components.\n\n**Operational Understanding** \u2013 Observe how gas systems operate during startup, normal operation, and shutdown, and how failures affect performance.", "short_description": "**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From The Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25854345550860801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831792_1401475774549177_7009866145100854233_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N298jm3F_vYQ7kNvwEXU_O4&_nc_oc=AdommA5b4cNIFJkp7aCKWtsfl0mZ98nbUrJseQl2CfVehY0hIdIIhL1N2mQJY0fQK-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BcyYjfHbwWJ1viNswyDLWZJAAItd0ITvnVRuTelChwQ&oe=6A30200B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gas Fireplace Basic Diagnostics", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772046300, "lastRevision": {"nodes": [{
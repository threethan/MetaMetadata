-atl3-2.oculuscdn.com&oh=00_Af3hsnO03_SAXnsx1uqVg2JGY8o4R1JXdvra84aMXunyZQ&oe=69F20BDB"}, {"file_name": "GasVR_Screenshot03.png", "id": "1164284932238004", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830411_1164284935571337_632668846500735183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XWVOyFclTIQ7kNvwEqmdYh&_nc_oc=AdqgklAHxEVDRCFbj3x8nKS6qG0NucpQGJbnXt5Qdi7fT1w5QoiNLyge9LcFWl2fnXw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0PbZFUhODLyEAP98BPLqwlPDE2mTuB8lSbxPvDdu2J2w&oe=69F1F71F"}, {"file_name": "GasVR_Screenshot02.png", "id": "2051048835467035", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821923_2051048838800368_9184841817902953017_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsJWxxmVxIoQ7kNvwFshIxj&_nc_oc=Adq6dPBxG8fWsT5O_UBelzF6Me_SJtjFpqpmschWU8n0YJDpW9mTOp-5NcT9SAebtTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yEtee6y-0hH-tVEsozkCWy4RZkWkiDHPrfUkK7tZhKA&oe=69F2034A"}, {"file_name": "GasVR_Screenshot01.png", "id": "1267371081916835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296209_1267371088583501_1390588770590342542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2lD7GHyB_gQ7kNvwHGXyw-&_nc_oc=AdoLyDoccwxXtcrTb2npzLE1tXMg8M8aMHSbWz1-fYmdSR4WZ4KRw0N8gymGaT-8B8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0g8wt-j0QdiCFEi4Snk2-YqYh3M7oeb45lUjybrNNLmw&oe=69F1EEC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gas Fireplace Basic Diagnostics", "keywords": ["NCSG", "Chimney", "Sweep", "Training", "Gas"], "long_description": "\n\n**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools.\n\n**Gas System Fundamentals** \u2013 Learn how common gas fireplace systems are designed, including millivolt and electronic ignition configurations.\n\n**Component Identification**\u2013 Identify key gas components such as valves, pilots, thermocouples, thermopiles, stepper motors, limit switches, and shutoff devices.\n\n**Electrical Testing Procedures** \u2013 Practice safe multimeter use for voltage, resistance, and continuity testing across gas system components.\n\n**Operational Understanding** \u2013 Observe how gas systems operate during startup, normal operation, and shutdown, and how failures affect performance.", "short_description": "**Gas Fireplace Basic Diagnostics** trains users on core skills required to safely understand, inspect, and diagnose common gas fireplace systems encountered in the field. This module combines guided instruction, interactive activities, and hands-on virtual testing scenarios. Learners practice proper procedures for identifying components, understanding system operation, and performing basic diagnostic checks using industry-standard tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From The Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_trackin
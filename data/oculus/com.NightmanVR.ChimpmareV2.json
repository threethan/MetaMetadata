&_nc_sid=6e7a0a&_nc_ohc=5UnrhRImdZoQ7kNvwGZfRhe&_nc_oc=Adrqq4aSWNRaMIydRfS-Cupqw9-JHjSxowMi-ryJgEBrMCMZgghd7XVMT1IPP1hlMB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU8icYUGVpgLhfojnB78uqymMYoF9vpDPzSn_M1VjD_Q&oe=6AA2B4DD"}, {"file_name": "New Project (19).png", "id": "852221154255446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619635_852221157588779_3748152565920441350_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_sFtsx00SAQ7kNvwHdYGIf&_nc_oc=AdqOVRoPbrNNfIi-Nc09gSdUG6nDPkOrqgM4Hll9ZkkssyM9R9JoeekPCYxnLU5nE8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8e_51zYsd1fRW5qfAJxAm4zZ_0CVNtGQpUSdb85XnVA&oe=6AA2AB4B"}, {"file_name": "New Project (20).png", "id": "2255240444970795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_2255240448304128_695445062799858852_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA3rNY1hOVAQ7kNvwFznlmD&_nc_oc=Adp4E-CfN8tKBArVbbP3GVgOCL7Nve8hP54ARohUSDWuiwfKK7GtlM_V_SH7z66xUqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7MD5sVtbQDI-aQFwaTSKi8RynxpqAWtHz4ry0ghdtOw&oe=6AA2AFCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monketeer", "keywords": ["Monke", "Monkey", "Gorilla", "Chimp", "Horror"], "long_description": "Monketeer is a multiplayer horror game that blends intense atmosphere with fast-paced, skill-based movement. The game features a unique locomotion system known as Gorilla Locomotion, inspired by the Meta Horizon app Gorilla Tag, where players move by physically swinging, pushing, and climbing through environments using their arms rather than traditional joystick movement. This system creates an immersive and physically engaging experience that rewards precision, awareness, and quick reactions.\n\nPlayers are dropped into dark, unsettling levels filled with environmental challenges, puzzles, and obstacles that must be completed to progress. Each level is carefully designed to test players\u2019 movement skills, teamwork, and decision-making under pressure. As players navigate these spaces, they must remain alert\u2014every sound, shadow, and narrow passage adds to the tension.\n\nTo heighten the fear, each level features a unique and terrifying monster that actively hunts players throughout the environment. These creatures are designed with distinct behaviors and movement patterns, forcing players to adapt their strategies on the fly. Survival depends not only on completing objectives, but also on mastering movement, coordinating with teammates, and outmaneuvering the monster as it relentlessly gives chase.\n\nBy combining cooperative multiplayer gameplay, physically driven locomotion, and immersive horror elements, Monketeer delivers a fun and immersive thrilling experience.", "short_description": "Monketeer is a fun, thrilling, and frightful VR horror game. Monketeer creates challenges for players to test their skill levels and beat different horror levels in game. Download now for a fun thrilling experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monketeervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/monketeervr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_
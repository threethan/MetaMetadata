60236956095_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea-KhppB5aIQ7kNvwHMU7C9&_nc_oc=Ado8h3_h4v8XXW9-2ed4qZR0N-HqStcr8JBAla4T72-CRIA2Ga1q2uU9ySyt-jhEsCg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX3pNAYu3mq0Ak4cpFfSFhRz7ZcgHUV5uRyyreTfpvIg&oe=6A8ED52C"}, {"file_name": "Screenshot2.png", "id": "2769929456496227", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974858_2769929459829560_1129074312432297003_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkdhGvOzExoQ7kNvwF1A93T&_nc_oc=AdqxzKYYLGBLd5oMLC-22FUV4q6E1bJbNBA4NZtylisO62drYEd4srkpHNq74WK0bEs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw8CWwF0fQy5eaqPOJkzo73f3Y3r6I3A7DZ1mkljk0fQ&oe=6A8EDB60"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJVS6MgpHzsQ7kNvwFX8qYM&_nc_oc=AdpJYerEQwe-LzabEyA6vX0ftzxcAXNUe7TXmHiW0bnqJmV5MnRmMWIM4lPrB9fzrT4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_biAaqQKR5-kczifKg3rt2_4Pe0cc0zssUZwUXsjb7Q&oe=6A8ED39D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqa7foUbPsAQ7kNvwHS0BWp&_nc_oc=Adph20oOhytqBN2GGB2T3XMQ2owHxuEQhmjQtyAiOEAUHTatpITjy0WYmbsSb3g71UA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl7RoDiLy1SWygF6Lvpl7LZM9zMOhvAK7NOzdTEp8pWg&oe=6A8ED50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT7E0HAargAQ7kNvwGI4FWC&_nc_oc=Adqq6ISeVvAdraeiEUERflejZhSZaYl3WqOrQ1mpBUA39y42P9WgLeSyCVda89hWWvk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUqmiKUPdTgBlwdRWpDkWJEX6vaQF0uQqv6FLGksY-aw&oe=6A8ED4FA"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371861312828335"}
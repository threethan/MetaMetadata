DjVFZiODrP3lpwqQRqf718Zf8vwE6NUw&oe=699AF573"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=604Ic1t7EWAQ7kNvwHZB0vn&_nc_oc=Adk2Q17ZQDq3HdHjUwCNLrJoNJYKm_7KNsQgv8KdtHEYTQNDjFeBn3v_VcG6GGHioyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFo3pbNQjOoSxPckVXG_g8v6GRiOASwqI-82GwfLvU2Q&oe=699AE139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmKXarsR92IQ7kNvwGkljHV&_nc_oc=AdkHZvQ7x8Gt4Vce9OpO0_ybYDanJR6D9JxkrZlLxrOYTkJhhvTgVKD1SJ-vPHYQXZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEQr0W7LMqo0RgQRwzHfqYK44XRO97yr6P7roKeGUy5g&oe=699AE788"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy
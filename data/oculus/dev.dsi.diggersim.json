cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZvGTolQTYIQ7kNvwGkyWy0&_nc_oc=Adr3irwIOt5nNRmHB0CRVOCEbPcUpCqJcDybhVd31wMR0BFh4mqtUZAP6_xTvB2XVso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnQ9RdS-f6ZKw4FZ9TZVAWWH0kUydZeLnXMkbP1V8PWQ&oe=6ABD305D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAjbdb3hUjAQ7kNvwFxfpaD&_nc_oc=AdpR6VAwgzUosJlT_Agcm8btAT3XC2CLDAFLO45gFMDs2aARE4SlfgcJ0ZeumtU9zpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDDVLoxvFi4u4OtuVpZXNdXib5JJXNXC8zxFZRIAxH5w&oe=6ABD31CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWD-6TlkMUMQ7kNvwEawwBx&_nc_oc=Ado3_jNGdms_6p0OeJCMjw3-ql8nTUXEAQqmNGfd4xrLudbap_kLPjzp6iVDoAw11eE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqzmPjEn98dUnvwhLJZtYkMf7bLwAD_u8HI7aIa203mQ&oe=6ABD31BA"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx1sB6Qu1YsQ7kNvwFSOGYk&_nc_oc=Adq-GU1PwXAsvZdlFBZxuoKYhFW2i6Jg8fpUjPc3LcUNpAae-vcYFym7cSc7xfRcQlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsbqbObdahjSkf7jeUuwooe4AbRmVEz-arpOJLnDz_ow&oe=6ABD21BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1713371580, "lastRevision": {"nodes": [{"id": "503770374381331", "release_type": "SCHEDULED", "administration_statu
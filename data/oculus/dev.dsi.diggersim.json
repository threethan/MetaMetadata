&oh=00_AQQjD0Rw9jcorpUojuQpcIizEjdp4uBb6q-ycwr_waiqSA&oe=6AFC8020"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BtyKs5CG4gQ7kNvwG_cnv0&_nc_oc=Adq4w9c1sxy0g0m8qHA6ypw38-dXGQYwzZX1nW80Jkp480gm3OHCP7-LEUQIpwORoMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqxibspttrqZjwR5jeGXHWKE8YKaSwVuzl-OByER0xjA&oe=6AFC785D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PDxf3P6a9EQ7kNvwG5O0pp&_nc_oc=AdqM-3n3PhovOOczvP8Ep3B_HkR6c6U0NWZUwmlJ5r77M3tCGJrumMP3MUzgPUmoTjM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl1yoMp9a2C-Q0d_d1aVf7N6_4DTmfU1gfJTPjCI2uhw&oe=6AFC79CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl9uPtGrU-QQ7kNvwGuz7HM&_nc_oc=AdouIvbpuOnpmbuxI3Jh7tz62LDzHeD1-CubJrbG2mPHRvw5zCL_LcacSLdXOV-AGV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS0aLe1JFvAi682plXToz2P0We6u5vm9e4fhonn8YjLQ&oe=6AFC79BA"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2R11br0wToQ7kNvwEgdAj1&_nc_oc=AdoBpSBkE2-NGGT-W8XJVLg53BtOnKQZKGWg2MSIgpBZyePoxVVli1Yydsws_FmpKWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnowWv4NFXZQJjXU5Vsj3o7hwZFO-WkuqbRjg8YVjN5Q&oe=6AFC69BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
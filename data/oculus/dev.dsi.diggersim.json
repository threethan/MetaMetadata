60236956095_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDzaDcn0sFwQ7kNvwFLGKzx&_nc_oc=AdqnkmnHeHt8FfsJBb7zP7QGBCEZwViHnBn_gd-9_vwucnRZ3RZ1PbZI3zpsklET_rk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM5Ew7JdSkTLugttOzS_8ZVniXsf-aDy-ngtRQYT6_pg&oe=6A8D83AC"}, {"file_name": "Screenshot2.png", "id": "2769929456496227", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974858_2769929459829560_1129074312432297003_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkdhGvOzExoQ7kNvwEu_2s6&_nc_oc=Adqr7aVlOcUGhUlP_Y31TbEswzmLwF0dtfCEQJGt2r1sda0EhlwtfprvRM9IrFgmtn0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk6o7xTsBd3ul3DVY9PFYaWaKIunHRT__PFU2iKwW9bg&oe=6A8D89E0"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJVS6MgpHzsQ7kNvwE1rKCu&_nc_oc=Adr8cYoKwXqV29XTIyD0QQbZl_8TcEd0cYlkenw68_mRy3ipOQD5yfeIcQi8DeOySFU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzxhI-RNq_YeuS9oF49z13iYd4sM1r5646qzzTkdJozw&oe=6A8D821D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqa7foUbPsAQ7kNvwEqMiLt&_nc_oc=AdoqC-QtOZaiPn_Hfgz8Cm3kjfyZLqBpkxNL73Wr5TevHsp3JozOeTj0g6ihZJtZjD0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPc1hL5XxB2S6H8JB7BX7f-fSRZL0AOtEk0O6JRPX6mA&oe=6A8D838B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODTYVJM3ILQQ7kNvwHfhbSu&_nc_oc=Adp2nKeumAdlkJIqsTk5TJdas12RAVC0We61uBykjQHY3hEdcwIKRa0abjiaf0MUvBo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgaWwSL1EKMbHvEBZHFuwu__-bIrKb8h3I6yuJihOx5w&oe=6A8D837A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371861312828335"}
cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLktO6l9DGUQ7kNvwH7yrEG&_nc_oc=AdpLE13lQ5BUhq5Q7V-k-7KCjkSKuCXn7dzdwGo5PZFBDaHs80BRbqFH4_opGPlohIo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDfcRdQCylIdPZOuuAS2DW31a3-z34TtegxhbWNQHV2A&oe=6AD399DD"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YulHvWRghRsQ7kNvwEKHqoX&_nc_oc=AdrbNrpziCqNVo2UbwUOMValC2c0RpfJzwfvtEGsZSI7KWwR7yAvhxLcTQwb6zhvt20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn34e5fhYj5RSlzR6PMgYNQqrsNPZcrvLo3xqFiJeELw&oe=6AD39B4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLv0y_BORSwQ7kNvwFSyvi2&_nc_oc=AdqwX02I00tmGcPxoPTdz3-xWj02AMMtDZlRnyD9ChcY_YUISe3LB2A-l0F-qQ3JuHc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ3uDsSO5SxD0sKHj-YAq8xRgrbw3x8oFIeyqd5GbcZQ&oe=6AD39B3A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOG5VRCBopEQ7kNvwHp_EQp&_nc_oc=AdoCdqwucfNACyl1ThazNiM2-HxgqrNpIm3MmsNdVo-z7cGpQU9UUOrk-JV3TS4vVds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA12PNkAsGRZN2fve4v8a037dtMZZLDYIjxVh27CM7Dg&oe=6AD38B3A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1713371580, "lastRevision": {"nodes": [{"id": "503770374381331", "release_type": "SCHEDULED", "administration_statu
&oh=00_AQTvwRXX-nSeOrO3VrouVOCcDP8Gaxa_jprTUkuEfDDgWw&oe=6B0317A0"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fmro6PyprnYQ7kNvwE-74oI&_nc_oc=AdqvCvu4Sb3O-qwnks1fL8jJejtuD7-K_7nJaHNZ7Pumr73vDFZEwPNsiJ7Mnas_5Is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWEDgPTlAoQfISHa33-tVzqj2uyEdMSePMEQB-B4ncyw&oe=6B030FDD"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP7sQz6XF5IQ7kNvwHKdrhW&_nc_oc=Adq2ncqz7oQVf57A0FAxrv2cX2aYnIPTUVqA_GPZtrGUudmt7Wcj6i-GNbTsSbYFgss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRAzNUcLIhPk8s3CSvRaqK8Co3h3cli1PD3AQNhWzKqA&oe=6B03114B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxiuk8B7kZoQ7kNvwFqN0_J&_nc_oc=Adpc8hGK4eq1vAC1ZFdsTuG1BCarQiapnjlnbRmw2muhCtNKx-7tdb9xfZmpJtvbDvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS52u96L1um6nlj5iMAmvA2uTte24ONjakJw2dAUu1Atg&oe=6B03113A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B9-ujJMw18Q7kNvwEeSlAn&_nc_oc=Adqn_ZLdwLFn3IjUbw2boW5LaajWJt6EeQcsXwTpsRobd_vahYsyWyehB6-DDVbX2a8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKEAyrJmevl47GrUY8Mwzxx4X2S4LNdfeFkSff3tMcXw&oe=6B03397A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
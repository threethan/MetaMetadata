60236956095_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQLvMpcHOM4Q7kNvwEvhgWh&_nc_oc=AdrARO5gaAx2oWTz742gOHJHU6MwFY8cOWi67R3hyuQXLbacxe9PHs7OuluJ6E_Xp4A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdcFM14h1j9FHG4Qqnx2ieHnfolR8VJZHdEyOe0WMRbg&oe=6A859AAC"}, {"file_name": "Screenshot2.png", "id": "2769929456496227", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974858_2769929459829560_1129074312432297003_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCwr6550UT8Q7kNvwHReya1&_nc_oc=Adp9aRVgrVXCdiHZVP6yx7A_3p2qUB5QCqs0KbZozmrIQKi7TnQBiz9g83KBHEu8gTc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFFy4nDYP66NPvcZe--ul3FZuBJw_i3UEmNlaJ8sMCPA&oe=6A85A0E0"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SzOG8p-GTgQ7kNvwHYq14Q&_nc_oc=AdoChyxt6_1YM2AsKlqWVduPfx6dYR70aePrpmF5XwEgDo8r0LPGIyFkFCvh4L569Zk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXG_T7gTt7CWUdbt6xSeonnFc4_19wn4JhXzLA0nNODQ&oe=6A85991D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6SQeK4mEKoQ7kNvwFVl_AZ&_nc_oc=AdpQce7aEu8JjwmIytujsyQ0drL2aTq0XZun6B0m06qS761HF1JrIDCG33W_xIptwKg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE9zdU6VojrDQVxdI3b4sV1jxZZJ-1f9t9smrUC1xu_w&oe=6A859A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONTzie2Giu0Q7kNvwHOJ-Jr&_nc_oc=AdoLLKoNHua3lTCEpDwXfPvkQSaZ7vmkOxS2LX_Z7L-ni4L-2ZGAFTx_KDXiW-U88gw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwJ1aRgI62qCsuqpiJelbaiXozq660KxOSarNXMuc_pQ&oe=6A859A7A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371861312828335"}
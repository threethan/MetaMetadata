lVvuZEWDgUie21zf24kILpeY7K_lYjjA&oe=69985273"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-XRZ3UFJkEQ7kNvwFJjBMz&_nc_oc=Adn0-UShoSd3fcanpUd0edMUZJiLNF_oUfWMn31K7nKAzNeeJlVlhx_HwArpHay4_cM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu7XE1XzO2N44wK11kHNuHslSp5xOVQ3AvmEJUv-3rExw&oe=69983E39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMiC3MZUi8gQ7kNvwFhjbjj&_nc_oc=AdnrJC1iSUnqWAIg6uZe_UK0n57OJmSs27cfHA8wms_ENOO08PWbVsqkKTz4tq_CB_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8ZfCwjeqsdfb0jcnj45sN4ZL9F8Wt2oog5hfVnPIWcg&oe=69984488"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy
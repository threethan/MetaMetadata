pmNqhlQTOf51m8kG1shm2Brxu6VbOPpQ&oe=69A2DE73"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEv_7YheNWQQ7kNvwEMnrPk&_nc_oc=AdlcLRlyAzca2QQrin9Al0pqjrThV-lqE8LpeF6A9YuNjiUtRe1C5GPyd2DYET9r1pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveuuDaaW0nqKmldtGJsmo34bXASgKM4RYpKgb12aDwMQ&oe=69A2CA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XF8IvfbuaYQ7kNvwGQTUX7&_nc_oc=AdlW9gU-X8Rc0cxDP-fIfti3M9uqMkrojLLQ51T5p-fJhbiDmcpq38IV6BUedqQRNZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQvCG-sFJXKtuctFXT9IkK8gz8Gix48bbNcv4vdcETdg&oe=69A2D088"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy
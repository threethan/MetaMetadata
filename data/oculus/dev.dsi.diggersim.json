&oh=00_AQQa45BdKX2l_u2877HHtW9s9Zn6VVmZPlgvQrU5wC0Qig&oe=6AFB2EA0"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BtyKs5CG4gQ7kNvwFd-zkt&_nc_oc=AdrwWhgcE_ih4fw0cYw75EBcSXZqrA3PUK3pWTZJr_oEeiZTwTVMaKf7Tc0cjgI_kc8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgoVFN7UdyefRDXcDDKR_Tt1GII3cugojXC8hvcNXseQ&oe=6AFB26DD"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PDxf3P6a9EQ7kNvwECk6nC&_nc_oc=AdoGUcpX2NRl9NXxzoclcoWU010xUFUjTFgtZ7-HpuZOAfhULjsxbHOU4j7cEIwigfI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlm7COhu2KkJvcSJBCij1IQfk-H3S38eZLJrYX6oSyUg&oe=6AFB284B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl9uPtGrU-QQ7kNvwEuHzIh&_nc_oc=Adr7ewW1olgQ_mp-6yRroX7RYZcai7UD5xYY3RMR7Dxvz6owpqx961FLfyXM-Sz2r60&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU9jBMn9fBjKAWBJL05SHMA2pwkZHImhZYRK8CEpw4TQ&oe=6AFB283A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2R11br0wToQ7kNvwFUfv9w&_nc_oc=Adp3V3f5kZSiJ4HaH3cOr6n3kJ80m2gDEIYVTEq-KsyfpJEGyvPkdNpy3Dazz4wjEGo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwGAyEls9TlalAaV8SJ7fT9PGKiB55pgOrBkQA8HF57w&oe=6AFB183A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
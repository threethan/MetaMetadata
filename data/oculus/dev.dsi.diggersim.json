&oh=00_AQQ7MgagG-GQjMT13WGf9fdIBdBqF5FaJMa_HRHVaxymBw&oe=6AFF2320"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDpW6FhvFB8Q7kNvwE_mefG&_nc_oc=AdprdSRl-BKNPnVGRKc-CJ07Ub0tZJ1btaQh4lz1oXJvPPBGGDecAsWWx3KSM3rcJWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiSXq1czA5dweSHLojFNN4NT7s19mBowISp9HP3viGGw&oe=6AFF1B5D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGZXXZWLGKgQ7kNvwGgrybY&_nc_oc=Adoe1x1nR8oDCT0JMUXNcpVQ3zfgL78MSd0ym1YGq4L4NDTGg9aH8LBAd5FgGYsKjjo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAcvYN6F_QeJnSYZq0JO_wj0z7O0n04XzgcRjO3TB1iA&oe=6AFF1CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG0RCP80seAQ7kNvwHyeMva&_nc_oc=AdrtDc3Jv8VIQISBiSHygJpVS_ny3z5wKVYyVAPUmK26UXUt7BpSUGBsrngEjZBijA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQddRgRsrBC5_Ajnzz1jwi9qQVJgm86JlMQ7jnsagvsxQ&oe=6AFF1CBA"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSIFKgDWmToQ7kNvwFZ-nBJ&_nc_oc=Adq9kY6c_5Cy4fSgG00NbfMONaApB5d0gX9IQutNaM4u1a1q4NgyVF4a1VuOb1VbHRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXbmRcMA9KtAB_zvkp7iBRUjmKnpHBhiTGbPJTHpzjOQ&oe=6AFF0CBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
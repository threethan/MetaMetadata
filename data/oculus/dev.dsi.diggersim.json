d7sLlJKdUHCf9z3-nmi2CC3VZ3d_t--g&oe=69A58173"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEv_7YheNWQQ7kNvwHlJ2Cr&_nc_oc=Adm8Av-s4PKI6Y04Zvj5dI6FnVYHlooIXBFhVYSTlsIf1tImQZvlVxLWaZD5UUdoZ4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu10bvp0yqsRk9cNBpwkXXLJ_XrPVdd5AiqUQBG8okPzg&oe=69A56D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv3ZqdATeOUQ7kNvwFdYXB9&_nc_oc=AdlOIm3xyrSMNbMLwp_0-BdJ55MwddXyHul8SQ3MMNmwcXMedLlYg_fXCd2vnzijLtw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu0HJrIiGvl3yHksMQsGH1Ap4C_qI5hz2lmaf9D6NI_3g&oe=69A57388"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy
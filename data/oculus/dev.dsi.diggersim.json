&oh=00_AQTCvyBqS8P18u8yRAxhudEGJAF0BVrFhwNtJ7BwRp8KHQ&oe=6B085DA0"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeikcp6U7-IQ7kNvwHsbmE_&_nc_oc=Adpy-3BSoR4ikRL2EBG8n337QicFMtTbIyLBK8FWWs9nDkH_7Q4fW8HaSi50KV_XPpg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk4WzRi2bIEBhQd7xKoyInxKTq0ltKs27PZWl3NU80JA&oe=6B0855DD"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzQNTzF5lOQQ7kNvwEfmmvT&_nc_oc=AdrXMnHkUH1wG3YL7vdzElPzDhraMvtx_NBtpwAakyLx5mxMdcMxs3fmm5XcDmIFgso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeLYLSeNZD_q_WxjfK9_VzegZjb8uhDID5MFh_ZSwRZA&oe=6B08574B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr2htE5MrmMQ7kNvwGrIJwy&_nc_oc=AdpuUxJyBz5nbfq1rJajYuNz36J0wVIfITSVDmUDbQRSZjdL-cqFp5iWBAW_yODEnp0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzbS_6bl3-86kpdeoPaoddl3k_QAZowXPPsni1gYuEWw&oe=6B08573A"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyD0CLtnCasQ7kNvwFXtAw4&_nc_oc=Ado1sKDOTzcY10sKRC6GKcxLkxvh04yQpmrjicEXdlcLQju_FxZE5qjhMPns7e7ikfI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvwR4DV5xLZtUiqmhU0J30I7S0KBZhocHnjx7ZTXNyeg&oe=6B08473A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
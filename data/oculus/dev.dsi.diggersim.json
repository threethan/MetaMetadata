, "id": "1634716480603761", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75469622_1634716483937094_8892917174639453908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhSx-f6fDtgQ7kNvwFpJ8al&_nc_oc=Ado5XBzZnouJ0a2HQaJdGvB0hk1SguJDL5kPCKdHRdcd_rebQEz7F-dclIqXZyJr1sU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrHiP16jqPuEzwL_gbBGBtkMcg8kNHTvu9Tkse64haWA&oe=6A8D8973"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjK7Bp0RrSQQ7kNvwFaMR_B&_nc_oc=AdphGLlM9fNGUTWNyoygECJHiCgqw0o5pfJsK3f5mRVbAcnBa3WdW5x62CNkjf9Nq8s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElggZuSE46BCi18k__XSiMq2m0prp63XbfsQzE4gpw0A&oe=6A8D7539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87n79s13DKgQ7kNvwF8n7FT&_nc_oc=AdpSQMgFTUYH_JifMZwDOI6xXyeQNb8Ai2AekSx4_6Q9m8ATUv0--kI2uPsPlCcLC1s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTKXxfV5QuB2T_dIkLzYnXR36fxzZpXYL-0NHleX62iQ&oe=6A8D7B88"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8116547131693099"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1420337579983244"}, {"status": "PUBLISHED", "id": "1052104317241593"}, {"status": "PUBLISHED", "id": "3410681335902144"}, {"status": "PUBLISHED", "id": "385659157697381"}]}, "baseline_offer": {"id": "3410681335902144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1420337579983244"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9371819102832556", "version": "1.5.8"}, "id": "1000966030308187", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andr
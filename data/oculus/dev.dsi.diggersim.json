&oh=00_AQTPS0-MZdnAMy9c3WyANZPU8Hshp-b5uzSselzHmFyWcw&oe=6B0C5220"}, {"file_name": "2.png", "id": "1061162195068655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031577_1061162198401988_4134341022642854147_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKnBUYH_GxgQ7kNvwGTLpN4&_nc_oc=AdrJbhzQVhAaDO_y_wu80H3KUFO-AC8fECxhB3LUmxxUiL2EQXxD8zLocknRaJyvwHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPIZHYh45e5wQwU5CJJpMxOFrS6DO_0rBIXSwsMOuy9w&oe=6B0C4A5D"}, {"file_name": "4.png", "id": "1467926187220788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031447_1467926190554121_7104792733331649556_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5--vHPiWYyEQ7kNvwGVE2ep&_nc_oc=AdotGeDAYdT-xFi1ev6BHYwFeUUelVc2lIssFDOcJ5A13gGdu8lOXvSKJI3nPmmXpR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXgf5Ug-vD47XKTOtnAcMvcRW3VGByoW06HgtH-ASuUQ&oe=6B0C4BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape11.png", "id": "426630206672975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75322596_426630213339641_1591649370607133838_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUJboOtb-3wQ7kNvwFmfZq3&_nc_oc=Adr6zvCL2B7DqrpVSjdNFa1gAm1CfnsntQ_qjormNGRjG2wJGxkekcbyN3H0k4dLANw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTalJ94lVQsHM64j4IPxj_Ee6aeuobYae4CAiOSyn-ERQ&oe=6B0C4BBA"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "DiggerSim is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, Digger Sim is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29267390306182141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269161_513443118150538_8900344969466554700_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZImp7peZWBsQ7kNvwFPEFpu&_nc_oc=AdqxorCxslZFjYoKwY3X3txwUqojiHM3mBfypxAAPmjkxtbIa6dubkguw0hqj2HgnmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAoaGv5VBqb-coyA8Ph7zGFZtmVftN-r5haPxekNIuKw&oe=6B0C73FA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DiggerSim - Excavator & Heav
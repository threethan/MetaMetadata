8_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWoH-MJyC1UQ7kNvwF6Iiyr&_nc_oc=AdnZbgB6-ENEymIelXgbM7EqVTLCFbQBI4s9GNoxdeH2jB1zW5G11Ig5uP2ArStSLvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftkAaWS644XSSIr3YzTZHTmKf8JbOgMeELINnEUXs_fWw&oe=69A975F3"}, {"file_name": "Screenshot5.png", "id": "1557636064811119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75355156_1557636068144452_8966300487237368107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IrzJNgV9RQQ7kNvwHTkRSR&_nc_oc=Adnw6ELdlg_g7A5sYASab8YqrXGZYJD4ZZqVgy5LSr_VHkmYphcDKU5PQ8N8-72Mnr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZFfu8HEYnluk5EDw3PDFYigmHgkgcbbYR5SADpav2ww&oe=69A961B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape.png", "id": "844161867746207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974692_844161871079540_4176021455143514163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeAIT2sGv74Q7kNvwFVQH8P&_nc_oc=Adm3kfWvZ6dNjng-sbaRj_ieoQ14kIZMzRu9r7vR5nSmYCF_cBOs7_yjJt15kecBFrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuSPHgAHdkWnzK9IisWMXgl6zduluIK6SgKAhzPItoJTA&oe=69A96808"}, "display_name": "DiggerSim - Excavator & Heavy Equipment Simulator VR", "keywords": [], "long_description": "\"DiggerSim\" is a thrilling excavator and heavy equipment simulator that puts you in the driver's seat of a powerful excavator. With realistic controls, you'll feel like you're really operating heavy machinery. In this game, you'll be tasked with completing a variety of excavation jobs, from digging foundations to clearing land. You'll have to carefully manoeuvre your excavator through tight spaces and navigate around obstacles to complete the level. As you progress through the game, you'll have challenges that will test your skills and abilities. With immersive gameplay and realistic controls, \"DiggerSim\" is the ultimate experience for fans of construction and heavy machinery. So put on your hard hat and get ready to dig in!", "short_description": "Virtual reality Excavator & Heavy Equipment Simulator for Oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydiggersim.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamsoft Innovations", "support_website_url": null, "website_url": "https://mydiggersim.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8116547131693099"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3410681335902144"}, {"status": "PUBLISHED", "id": "385659157697381"}]}, "baseline_offer": {"id": "3410681335902144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729070940, "status": "PUBLISHED", "id": "3410681335902144"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9371819102832556", "version": "1.5.8"}, "id": "1000966030308187", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4482360755111773", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9371819102832556"}, "release_status": "RELEASED"}, "binary_release_cha
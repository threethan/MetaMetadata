sid=6e7a0a&_nc_ohc=x1jDx9dx0pIQ7kNvwG47jyh&_nc_oc=AdpCA4M2c69W984ZecEA5yNihbSS5u_tDDATcaEXLm-ZtXZ-y_iRk17O_1tl0M8l26g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWTjMId3wuIFhim_7LqGx55quVBmMSKgBk5Idq1bJ78Q&oe=6AA93ECD"}, {"file_name": "\u6e38\u620f\u8be6\u60c5\u56fe (2)(1).png", "id": "6761567930533832", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572954_6761567937200498_6881026506492167484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfGScAjNG5kQ7kNvwGZx0Yg&_nc_oc=AdrpfILtdRgDZkPuEEgBb6cIESIa-fBiSUkFGaH-rTsd0u0j-6FW-jsjpR5vAS-NTJ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRpmxmkUepxi0s5AdiuCkAf3YRoEsyrjKMtDfklH6ing&oe=6AA937F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806087587561383", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974661_806087590894716_7705167288221311871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFqSGIZdu3IQ7kNvwFTzXQZ&_nc_oc=Adrsh85YBTcOZGg4YMJYZg3Dn2Nq_NnxKzPJG2CUsuhwtkb8fGdR2kEhno1U24geL58&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp8iIktjlbzL4XxiA9RsZ9RarKFCPxir96TWV7VbN71g&oe=6AA93D50"}, "display_name": "SchoolMaster", "keywords": [], "long_description": "Funny brawl game with random card-drawing gameplay mode.\nAt the beginning of the game, you will spawn as a child,you need to collect EXP coins within the map, once collected enough EXP coins,then you can pick up weapons and skills to upgrade!\n\nAs time goes on, you will acquire various fun props, such as a gun that shoots carbonated drinks, super high jumping shoes, spider silk gloves that allow you to fly between skyscrapers, and even a boxing glove rocket launcher that can punch silly NPCs far away!!!\n\nThere are multiple battle maps to choose from, such as a school gymnasium filled with sports equipment, a park with lots of amusement facilities, and even a city with many tall buildings. They will all become your battlefield. If you are a beginner, then start with the first map!\n\nControl method\n\u3010Move\u3011Left hand ThumbStick;\n\u3010Accelerate\u3011Swing your arm, and you can sprint;\n\u3010Jump\u3011 \u201cA\u201d key jumps;\n\u3010Shoot\u3011Both hand \u201cTrigger\u201d key;\n\u3010Grab\u3011Both hand \u201cGrab\u201d key;\n\u3010Menu\u3011Left hand \u201cmenu\u201d key;\n\nPlayer communication Discord : https://discord.gg/knb4fe4qY2", "short_description": "Funny brawl game with random card-drawing gameplay mode. At the beginning of the game, you will spawn as a child,you need to collect EXP coins within the map, once collected enough EXP coins,then you can pick up weapons and skills to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atombits.cn/privacy_policy_en/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://www.atombits.cn/school-master-vr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1980826315643306"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1844584773375719"}, {"status": "PUBLISHED", "id": "1317248950262575"}, {"status": "PUBLISHED", "id": "1722359545584243"}, {"status": "PUBLISHED", "id": "1763524818036359"}, {"status": "PUBLISHED", "id": "936947035870488"}, {"status": "
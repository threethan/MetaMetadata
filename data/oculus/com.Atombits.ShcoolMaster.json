AdkGLGIuC7IhpRTS7AA-oCG7iaNlgb8CU7IFchYSTnkSguLExnYBlcGvu61aQsOmGOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvWJRZayJUFvqX1Pw27yRhTlyIxiasee0VS1cBwdz4kA&oe=69AD704D"}, {"file_name": "\u6e38\u620f\u8be6\u60c5\u56fe (2)(1).png", "id": "6761567930533832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_6761567937200498_6881026506492167484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ9Elz6ZcPgQ7kNvwHMMsl0&_nc_oc=Adkblo6fxNyYlBo1RdaK0GetR5SOrEFALeA5dioz8b3LL3w82wj_da_GSjNaHgCS1yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO2kgyvIXuu3QKndOxJHgQ_lqo8YUAdBeHmU3zgRb-Mg&oe=69AD6976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "806087587561383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974661_806087590894716_7705167288221311871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jv9Y64CRRygQ7kNvwFebcrF&_nc_oc=AdnTxKUvfbMsLi5zzhe0UH5yjOWQLMQx740LoxXIyZoe2u-2QcWlxYGbVgmLzZ1pdA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3AI5xfhrb7ceRsvdlJrQpQ0bU1Rc6BCnGMEuBqVhRLQ&oe=69AD6ED0"}, "display_name": "SchoolMaster", "keywords": [], "long_description": "Funny brawl game with random card-drawing gameplay mode.\nAt the beginning of the game, you will spawn as a child,you need to collect EXP coins within the map, once collected enough EXP coins,then you can pick up weapons and skills to upgrade!\n\nAs time goes on, you will acquire various fun props, such as a gun that shoots carbonated drinks, super high jumping shoes, spider silk gloves that allow you to fly between skyscrapers, and even a boxing glove rocket launcher that can punch silly NPCs far away!!!\n\nThere are multiple battle maps to choose from, such as a school gymnasium filled with sports equipment, a park with lots of amusement facilities, and even a city with many tall buildings. They will all become your battlefield. If you are a beginner, then start with the first map!\n\nControl method\n\u3010Move\u3011Left hand ThumbStick;\n\u3010Accelerate\u3011Swing your arm, and you can sprint;\n\u3010Jump\u3011 \u201cA\u201d key jumps;\n\u3010Shoot\u3011Both hand \u201cTrigger\u201d key;\n\u3010Grab\u3011Both hand \u201cGrab\u201d key;\n\u3010Menu\u3011Left hand \u201cmenu\u201d key;\n\nPlayer communication Discord : https://discord.gg/knb4fe4qY2", "short_description": "Funny brawl game with random card-drawing gameplay mode. At the beginning of the game, you will spawn as a child,you need to collect EXP coins within the map, once collected enough EXP coins,then you can pick up weapons and skills to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atombits.cn/privacy_policy_en/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://www.atombits.cn/school-master-vr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1980826315643306"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "936947035870488"}, {"status": "PUBLISHED", "id": "834301332757817"}, {"status": "PUBLISHED", "id": "1902811320311420"}, {"status": "PUBLISHED", "id": "679473511209912"}, {"status": "PUBLISHED", "id": "1082995803577965"}, {"status": "PUBLISHED", "id": "2099676947114505"}, {"status": "PUBLISHED", "id":
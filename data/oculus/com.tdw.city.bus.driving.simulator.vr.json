e=6B0EF878"}, {"file_name": "city bus simulator3.png", "id": "1124181943580851", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842212_1124181946914184_7661554495536843464_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqmZKdEw1_gQ7kNvwE1NvxZ&_nc_oc=Adp9kUDbPVHNx3mR0F5Ag7n0Cm3F2cmkO3qVM1r5-TG2PTZUDhP8GKBOhKGpJOqEEpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNzITKNw8gA6loeRhl5ouyqZ6zUWyQF4VEdjaGJ7dMZw&oe=6B0F03EC"}, {"file_name": "city bus simulator1.png", "id": "1692607752258232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908850583_1692607755591565_7851007103380895905_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vIVFifPOaIQ7kNvwFMBPfb&_nc_oc=AdrQByFoP5QPjdEygoMKjwvXojllqXu8FY5k-7R4uhT-5H7z5GqNiLuDGm2HLqWCO40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuDErW9C8dintkUjZNqSyCxo0hvjZP_iMvkZjC11XgAA&oe=6B0F0484"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Bus Driving Simulator VR", "keywords": ["BusDriving", "CityBus", "SimulatorVR", "BusDrivingSimulator"], "long_description": "City Bus Driving Simulator VR\n\nExperience the excitement of driving a city bus in an immersive virtual reality world. Put on your VR headset, sit in the driver's seat, and enjoy a realistic first-person driving experience.\n\nUse your VR controllers to interact with the steering wheel, gear controls, dashboard, and other driving elements. Look around freely inside the bus, check your mirrors, watch the road, and control your bus using immersive VR interactions.\n\nDrive through busy city streets, highways, and beautiful countryside routes. Follow traffic signals, obey road rules, manage your speed, and stop at designated bus stops to pick up and drop off passengers safely.\n\nStart as a beginner driver and complete exciting missions, challenges, and career tasks. Unlock new routes, improve your driving skills, and become a professional bus driver.\n\nEnjoy realistic driving controls, interactive VR gameplay, detailed bus interiors, challenging traffic, and an immersive virtual driving experience.\n\nGet behind the wheel and become the ultimate city bus driver!", "short_description": "Experience realistic bus driving in City Bus Driving Simulator VR Drive different buses, explore busy city streets, follow traffic rules, complete exciting missions, and enjoy an immersive virtual reality driving adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/team-double-wolves/home", "developer_terms_of_service_url": null, "publisher_name": "Double Wolves", "support_website_url": null, "website_url": "https://sites.google.com/view/apex-orbit-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1391843390685761"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839659_2275803270013789_6703234732529551390_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPsd_vh2kD4Q7kNvwFz3g1Q&_nc_oc=Ado7aSIAe64fBEeE7IOM2KoIQWSCgCQ9atKwMLb2BmzL0imcxS3ybV3CxEtlMUyWqNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxhVp5mJAD26LX7IkJnt1P489Ev8mwb_DQIV-TylpEOA&oe=6B0F057A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
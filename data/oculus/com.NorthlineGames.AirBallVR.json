899846505978934_1104078759806543836_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvkmJb_Bf54Q7kNvwHSfJ5i&_nc_oc=AdpAq58GQWQz15Ti4RgeMpNdD6B21TgkyQharxBWmWX3SpPmy3wkdGeErW840U9VLmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeKif8x5iga9YE1Tuyg1JnqlKlUJMzfXOyYoo6wG9pQg&oe=6AF723E7"}, {"file_name": "MedalTVAirBallSpectator20260727144930394.png", "id": "1552632049679796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298281_1552632053013129_6475585712858011228_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnqh2OcHWDIQ7kNvwHpt05k&_nc_oc=Ado9zt3WGwfZtCEyef_op62miCb2XBJEV6Blf4kdnzB2cROu2RdlEtHKvAtoAwYEwsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ5XBaqrxGiWxLNMVr9TDMH0_5SD-kSd1S5r5QIncnYQ&oe=6AF747CE"}, {"file_name": "MedalTVAirBallSpectator20260727144953112.png", "id": "1032925756332691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_1032925759666024_1496414249810512204_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNmUZrHQqVQQ7kNvwH002df&_nc_oc=AdrZtA1wDCm0iTH5R9BDHxlWfdfMmztyb-gQGFdoi9-l_0sIKfJeRb86o1DI4uqFY8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsiOLS9oCofcf8T4s1lar2MLlck_Z_iDRyIjC6iMO-lQ&oe=6AF74638"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AirBall VR", "keywords": ["ZeroGravity", "DodgeballVR", "MultiplayerVR", "SocialVR", "AirBallVR"], "long_description": "# **AirBall VR**\nAirBall VR is a competitive and social zero\u2011gravity dodgeball experience built for fast, skill\u2011based VR gameplay. Players enter floating sky arenas, dodge incoming shots, and eliminate opponents using precise, physics\u2011driven throws. Every match blends agility, strategy, and VR motion to create a uniquely immersive arena sport.\n\n# Core Gameplay\n- **Zero\u2011Gravity Dodgeball:** Move freely through the air, dodge incoming balls, and land accurate throws.\n- **Competitive Rounds:** Each player starts with a limited number of balls. A hit eliminates a player and awards a point. The last player standing wins the round.\n- **Skill\u2011Based Combat:** Throwing, timing, positioning, and movement all matter. Every action is driven by real VR motion.\n\n# Social Features\n- **Central Hub:** Meet other players, chat, explore, and prepare for matches.\n- **Shops & Quests:** Earn rewards, complete objectives, and unlock progression elements as you play.\n- **Community\u2011Driven:** AirBall VR grows with its player base, with new features shaped by community feedback.\n\n# Multiplayer Arenas\n- **Multiple Arenas Per Server:** Jump between different sky arenas hosted on dedicated servers.\n- **2\u201310 Player Matches:** Designed for both small friend groups and larger competitive lobbies.\n- **Smooth Dedicated Networking:** Built for stable, low\u2011latency multiplayer sessions.", "short_description": "AirBall VR is a fast-paced zero\u2011gravity dodgeball experience where players compete, explore, and socialise across many servers\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacypolicy.airballvr.com/", "developer_terms_of_service_url": "https://tos.airballvr.com/", "publisher_name": "Northline Games", "support_website_url": null, "website_url": "https://airballvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SIN
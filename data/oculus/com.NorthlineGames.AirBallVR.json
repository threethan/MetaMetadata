M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsUmlIXXl-EMvOjU-8WkNIldCiYMRD0Y2fbQyRxci_Hw&oe=6B05B857"}, {"file_name": "MedalTVAirBallSpectator20260727145100546.png", "id": "899846499312268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830467_899846505978934_1104078759806543836_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCD5mT8ZYOQQ7kNvwFYGtah&_nc_oc=Adp1g7H01Ja83Vu5bJbjauUibvATDSdaiQZKY6FZ9vNS92TekYP6ab4xmFN6nbw63ps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr_cxlNxSBXVt_dqvohU801hQh9Eg6P_mB3FIoLH4FCQ&oe=6B05A467"}, {"file_name": "MedalTVAirBallSpectator20260727144930394.png", "id": "1552632049679796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298281_1552632053013129_6475585712858011228_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1UxEYqFzNsQ7kNvwGtRFJ3&_nc_oc=AdpWvVc-xTPgTeNXpfGC8Mim5Ce-K5TDl7XBVYuMnraAH2I52pgkrCdAHc-GLaePiq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkZghXPo3c0xI-EXiow2n-X1r9MdVn0GGDOcXxQcr4KA&oe=6B05C84E"}, {"file_name": "MedalTVAirBallSpectator20260727144953112.png", "id": "1032925756332691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1032925759666024_1496414249810512204_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lby6jbqRj2QQ7kNvwERqc1b&_nc_oc=Ado2zQeq_HLq9GrJ1FY19BJs7wR0j08RfQti6qjJWK2MWGf25v6T0L8PmXtLB2Sfd2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLQ7-wnmrubUSC6OzldJOxCC1BezXzgwmaie8y6R4WEQ&oe=6B05C6B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AirBall VR", "keywords": ["ZeroGravity", "DodgeballVR", "MultiplayerVR", "SocialVR", "AirBallVR"], "long_description": "# **AirBall VR**\nAirBall VR is a competitive and social zero\u2011gravity dodgeball experience built for fast, skill\u2011based VR gameplay. Players enter floating sky arenas, dodge incoming shots, and eliminate opponents using precise, physics\u2011driven throws. Every match blends agility, strategy, and VR motion to create a uniquely immersive arena sport.\n\n# Core Gameplay\n- **Zero\u2011Gravity Dodgeball:** Move freely through the air, dodge incoming balls, and land accurate throws.\n- **Competitive Rounds:** Each player starts with a limited number of balls. A hit eliminates a player and awards a point. The last player standing wins the round.\n- **Skill\u2011Based Combat:** Throwing, timing, positioning, and movement all matter. Every action is driven by real VR motion.\n\n# Social Features\n- **Central Hub:** Meet other players, chat, explore, and prepare for matches.\n- **Shops & Quests:** Earn rewards, complete objectives, and unlock progression elements as you play.\n- **Community\u2011Driven:** AirBall VR grows with its player base, with new features shaped by community feedback.\n\n# Multiplayer Arenas\n- **Multiple Arenas Per Server:** Jump between different sky arenas hosted on dedicated servers.\n- **2\u201310 Player Matches:** Designed for both small friend groups and larger competitive lobbies.\n- **Smooth Dedicated Networking:** Built for stable, low\u2011latency multiplayer sessions.", "short_description": "AirBall VR is a fast-paced zero\u2011gravity dodgeball experience where players compete, explore, and socialise across many servers\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacypolicy.airballvr.com/", "developer_terms_of_service_url": "https://tos.airballvr.com/", "publisher_name": "Northline Games", "support_website_url": null, "website_url": "https://airballvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
ent-sea1-1.oculuscdn.com/v/t64.5771-25/38974568_1316942652539387_2327934449094201360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwOG0QTmI9kQ7kNvwGni36m&_nc_oc=AdoKvt0zbuBwudsz1gJcwfaz1CqgrK0GXa4a3EhzPkuITMVoD9meVdU8oKIS_ZU3Fbg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVpnAHcibYMwxE4ZOTLXvYL_wucuktrGhEwdrsgEpjGA&oe=6A901EC9"}, {"file_name": "brain.png", "id": "1973529146341418", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_1973529149674751_8129589513827476835_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnFyahxBJfwQ7kNvwE-aoRH&_nc_oc=AdqbVos38aaYDyNHRJmNHhqfdOy3h_n3GxscP6WDj6gca8Mnyalaotj9t5ZODj0GmNA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSiPrBWLIIt1usXG3qL0fiTpn9KgyN-4t-r2IlCZohoQ&oe=6A90208E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1495291897671744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031398_1495291901005077_4394067877235680841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQNONMnRBw4Q7kNvwHuGLA6&_nc_oc=Adp4v-3uZ4fnNtJ05Nw3Fk94a4Eq3K1GVWZuTKxpQrhFDH5CL9UaSUurF57p6fxaR_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt4hlxj7DO5Giv_MfRh1ECehnzq1mnHy3ul3kPdE5LHA&oe=6A902377"}, "display_name": " Dissection Simulator: Mammalian Organ Pack", "keywords": [], "long_description": "VictoryXR\u2019s virtual reality mammalian organs dissection software is a hands-on dissection opportunity experienced through the power of VR. This true-to-life, hour-and-a-half practice thoroughly covers each step of the science procedure that students would take if dissecting organ specimens in their classroom.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications. Schools save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement.\n\nSchools can save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement. Learning pacing is user-controlled to ensure maximum understanding of the teaching while moving through the program.", "short_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Mammalian Organ Pack Dissection. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.victoryxr.com/policies/", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7108523722537222"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1556707564913375"}, {"status": "PUBLISHED", "id": "945781556682144"
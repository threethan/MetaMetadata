Q7kNvwFurot8&_nc_oc=AdpoRA8forcH7GbTlp87YGxX2t928_jc0A1HOh2rJ6PTc5jX2OmhArMB_YgU317lysw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp2KltIKlWF6YK3zsmWI0eTRy_Tm8d88szEZxlbWrOnQ&oe=6AFDC453"}, {"file_name": "h4.png", "id": "1316942649206054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974568_1316942652539387_2327934449094201360_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwaBQajg7yYQ7kNvwHPO_HN&_nc_oc=AdpmiGmAHazm65PpCTSj-uuqHcq_RkEnWimoDdeb3v7f4v7N0jzxgyGujLJyQHXcvKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0VYE223stnM5DF3srWluKDf3jtaTCWubXfo9qBhKP2g&oe=6AFDC389"}, {"file_name": "brain.png", "id": "1973529146341418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_1973529149674751_8129589513827476835_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfmhDzodygoQ7kNvwGHVoJa&_nc_oc=AdqCHaWd0XiXCeT3G89oTMvAUvdN_ZdiiL3KxjwtKpZImTKKUwIGRLqhnTt6n243J18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5G0A39ypYTY9tkfctT2QqGi3Yxwvo2C7gY04kcdif1Q&oe=6AFDC54E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1495291897671744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_1495291901005077_4394067877235680841_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIPvuappMTwQ7kNvwGDN4IP&_nc_oc=AdpUU1neRcO8vK-9uhZJsx1pJFiWDEmlg1tML3z24aiohtwWFSlrP4RD1VJPlSb-Rqg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXIllfgC0jo6x62pU6MtplwOFgOn6fFKNCCESM9vn2vg&oe=6AFDC837"}, "display_name": " Dissection Simulator: Mammalian Organ Pack", "keywords": [], "long_description": "VictoryXR\u2019s virtual reality mammalian organs dissection software is a hands-on dissection opportunity experienced through the power of VR. This true-to-life, hour-and-a-half practice thoroughly covers each step of the science procedure that students would take if dissecting organ specimens in their classroom.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications. Schools save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement.\n\nSchools can save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement. Learning pacing is user-controlled to ensure maximum understanding of the teaching while moving through the program.", "short_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Mammalian Organ Pack Dissection. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.victoryxr.com/policies/", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
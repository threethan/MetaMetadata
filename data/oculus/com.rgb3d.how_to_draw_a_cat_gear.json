dn.com&_nc_ss=7f20f&oh=00_Af-QhVJuDUtoOg3JmqE3tmJXQYhLcUuYulhxzaG_NAZksA&oe=6A22E185"}, {"file_name": "migrated_image.png", "id": "837716500028020", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162741_1607347632630716_6997416849570791424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt0SO8U0fkgQ7kNvwEYXm2l&_nc_oc=Adq4Hu8fmEMlj10Iwdgr0P5OusphSAjL31a_y2u7Qn_3pRIVhqk4pYmWNkaawiToWYk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93vJLp6qDa3JZnHRbbXuDIJ6lIEov8li_7vpa06E6XCQ&oe=6A22E3E4"}, {"file_name": "migrated_image.png", "id": "802503983604346", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_155670218322579_4378642325602041856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiYiIPgO8wQQ7kNvwH2D6Zl&_nc_oc=AdqNPRJK6gfLH3q09EsIo7MW-D0HGjMqRDk5gHIssoXF8-E-q-g91jVhx2zpL2hWYlk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-guuGuENwU6lnNzya4e3mhk4Z2AdFxTYjGa2u1PELjQw&oe=6A22F1BB"}, {"file_name": "migrated_image.png", "id": "214343636342570", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_497742730559265_2601682250642751488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KWhWAAyoU4Q7kNvwHYrEM_&_nc_oc=Adp3Pov46lXe7C6l7tprr9qaoyIhwpZGxfPu8NaS9nquALH1q96MD11F6CSi7ECR9OA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WM6mxcwQt2EgGuQukdrSZ0nvuf0jDHDLKvzuqN94ocA&oe=6A22F619"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Draw A Cat", "keywords": ["cat", "stereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649261796330686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162730_337569563356247_8711676741380210688_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMJFibGVHZYQ7kNvwGLDMTQ&_nc_oc=AdpxCtBUh0qAAszhqaXxJHHlxj-DeuYf8S5ovwK57wTWwMGL5CIB-Jw3Ng5-tHWjyYQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wR7t-JR3nKD4Fs6FEbJtmoR8cMF6JkqTtFzjw0kLd6w&oe=6A22F33B"}, "is_concept": false, "is_test": false, "is_tri
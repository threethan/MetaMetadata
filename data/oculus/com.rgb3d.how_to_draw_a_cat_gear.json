dn.com&_nc_ss=7f20f&oh=00_AQLUaO5eOnCxl8uvFnaoYeEEcL-4VnYugbUzqKfGflVFCw&oe=6AA95A85"}, {"file_name": "migrated_image.png", "id": "837716500028020", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162741_1607347632630716_6997416849570791424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Rd5TW2jNeIQ7kNvwGzvuRJ&_nc_oc=Adp6Dw_XHeXZFGiNzYnVfv-Se26BTczOeOrMEkRZKZou2LlzC9e3e2GDugHkJO-X39s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTUXDEA3DHl1bjVzpxUonpoVwFOyTFZsKtI8dT01ZREw&oe=6AA95CE4"}, {"file_name": "migrated_image.png", "id": "802503983604346", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_155670218322579_4378642325602041856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I9EkFCFDSMQ7kNvwEKmS86&_nc_oc=AdqyS_nnAZz5kAsoO-5gmXIpBfIoGkmewy6MFeLWTTQJgL8WXsGCwyCgC8NPMduW_GM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNARPEEP9BNiAdz6aXO9FHpntKmHQsCop9BWzS-_R53g&oe=6AA96ABB"}, {"file_name": "migrated_image.png", "id": "214343636342570", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_497742730559265_2601682250642751488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10A6qm6-lzYQ7kNvwE57umW&_nc_oc=AdpNxl3ix5Wtrp-Qhoq8dQuCwxUhLwuLd1JOBoaWpcAnSy7JkbNPHNAiPjiKMWCNt_w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrvTvTenncuUeYe6sj_Dg3ZIgOI91UFReiF5CCPeorzQ&oe=6AA936D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Draw A Cat", "keywords": ["cat", "stereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649261796330686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162730_337569563356247_8711676741380210688_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylmZPL-n41wQ7kNvwGEFLKP&_nc_oc=Adqt6wl-nHFzUuSFfQXC-paV1TysS2qs0Fw_n2lW2XQaeeQj9MlaXGaoCETMSsbwsA4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDzaVz5kpxJShfdLZxQ8tL-41WKtN3VWyRloyC-X1jhA&oe=6AA933FB"}, "is_concept": false, "is_test": false, "is_tri
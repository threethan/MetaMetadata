ereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4417023648404362"}}]}, "scheduled_off
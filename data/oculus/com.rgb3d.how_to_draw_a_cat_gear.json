dn.com&_nc_ss=7f20f&oh=00_AQKtzsuMacH46Wv_jQ48jKjfvHMRN4TWB9wRc2g3bk2n5g&oe=6AA41485"}, {"file_name": "migrated_image.png", "id": "837716500028020", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162741_1607347632630716_6997416849570791424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CodGJ8NvcMQ7kNvwESS0M0&_nc_oc=Adq2xCvZWMrBEU66RXbN-6W4r8I23YH6KjiXuWJ6kk2MaqsyXPr0n80I1_KbS4xa7HU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3xTWB7Cnt_p7PWGrFr_R7wO_9K3b4XOU22ENGEKLKxg&oe=6AA416E4"}, {"file_name": "migrated_image.png", "id": "802503983604346", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_155670218322579_4378642325602041856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijruJ9wrVPAQ7kNvwHTk3n0&_nc_oc=Adr9118qopulxD85W1tRCH1ym6Im6h85-BTExeIkDkbsQZs9LQb0lRE2pKn_o0Go2u8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvoFY-2jLbpKYfysoObX2-XLV_dqe2MBA1831UKVOSRw&oe=6AA424BB"}, {"file_name": "migrated_image.png", "id": "214343636342570", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_497742730559265_2601682250642751488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggekOmD1k14Q7kNvwEFx4B3&_nc_oc=Adr8avawrnTbUlQgQQ_KbfpOwtLAChxeDTtfPAmgYppMhUOJMB-v0E7qIVNwhzFvEYU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOC38i5n44y_tsjQPNo5Q-_-fgFc0fhEEKJjUdE9i_5Q&oe=6AA3F0D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Draw A Cat", "keywords": ["cat", "stereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649261796330686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162730_337569563356247_8711676741380210688_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUPcTIBJWk4Q7kNvwFbnxe2&_nc_oc=AdqncQVWHEXUpEr-BswDBvM-SJxtIdAiVmRU18LP6lESjC_miA_CzH-nFVRJ3e8q0yI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsMaD7bC_2V6I0sX1GVKI5NHtX4RvejXCqCmLJ-KWI4Q&oe=6AA4263B"}, "is_concept": false, "is_test": false, "is_tri
53980493168640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eicqJg76jJoQ7kNvwEEzLqN&_nc_oc=AdoyLR-VDc_Xku7ugaQPYZW8v4sizRMcVT8LnJuSNlUJvgCeLyL_4K2MIFaeENC031g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTogGQTX4cUASfkTWghP198FK9Id0GMRnZUcj6WBEXL8Q&oe=6AFB1785"}, {"file_name": "migrated_image.png", "id": "837716500028020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162741_1607347632630716_6997416849570791424_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJFBh8Lm_LYQ7kNvwGyMIXD&_nc_oc=AdpQiNK4MIk_sLlf1voZKYvuV2JI8stXidzSotMjRtD9znHX0Y1ctVyxFvAHbtcPV20&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5kNMoRq74cRPpvgklFGL3h-7vueCs5FPo189aIMIHGA&oe=6AFB19E4"}, {"file_name": "migrated_image.png", "id": "802503983604346", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162694_155670218322579_4378642325602041856_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_cF0D1YRFcQ7kNvwEwFHmI&_nc_oc=AdqOVZECygCPRYdFMievWkePw6GmCuFUI0RGEKUyu4cjOiIhiyHXp87Qanv-L4xxWWA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ldMMvF1A0AbdZGCsU58MGhkijW0DPEi0R-5x6-6LRQ&oe=6AFB27BB"}, {"file_name": "migrated_image.png", "id": "214343636342570", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162737_497742730559265_2601682250642751488_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SKDjBOX3LIQ7kNvwETGhFF&_nc_oc=AdrPwxkbecpHtk0DkBWYf6zNW5AGGR2nsw1Z2j5kmW-IihNFZ8KMb_I18XipEfkBeHE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsTTLnu9a5ULxrR7RoeHbIn1GguQJc8BKYtogRMOth4Q&oe=6AFB2C19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Draw A Cat", "keywords": ["cat", "stereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649261796330686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162730_337569563356247_8711676741380210688_n.png?stp=dst-png_s360x360&_nc_cat=104&_
dn.com&_nc_ss=7f20f&oh=00_Af8jfXnmTIRm35L1Gts2sgmM5IQBQbRewTctsR-3Cm-3lw&oe=6A467A05"}, {"file_name": "migrated_image.png", "id": "837716500028020", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162741_1607347632630716_6997416849570791424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO5IcHsx6ZwQ7kNvwG_6wY4&_nc_oc=AdrMHysv-xvoyc4xkHGcZS7XJG_o3AmIZSlaaQcPylkduncgAtB4FFijfZhlgCTJYZw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6aoc7Ldebxw1ZxvmmkQYZp5mHGwkztquLpffFC800rg&oe=6A467C64"}, {"file_name": "migrated_image.png", "id": "802503983604346", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_155670218322579_4378642325602041856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_62FZFscLoQ7kNvwHegkjw&_nc_oc=AdrpGfWJ7T3RIYQyvM4uVrtRyourSFnc8dECoD-QETtjEgQljNRjZ5BFDnWRFU6UU5Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DvV90fZonlHvCIlUVA3XL-yH5sw3pcq7ONGR4wovGgg&oe=6A468A3B"}, {"file_name": "migrated_image.png", "id": "214343636342570", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162737_497742730559265_2601682250642751488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfKoRyPI_2wQ7kNvwHQCacY&_nc_oc=AdpjaqZtfCZdXapMSaRHKSLymrc5g3hIkx7gbqK6UIdOpXedGimVnL7HT4lCN8eQPFE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OraU1gGelN6Y8B92wGT2jmWNQTRKnoqKb9TPXxo4fDQ&oe=6A468E99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Draw A Cat", "keywords": ["cat", "stereoscopic", "humor", "art", "Bloomberg"], "long_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nSecrets of the art world revealed in stereoscopic format, brought into VR with customizable theater seating and environments!\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes", "short_description": "An amusing battle of wits between a frustrated artist and his reluctant feline model. This delightful 3D short has been a hit with festival audiences, won the Audience Favorite award at 3D-Con, and was an official selection at the Mill Valley International Film Festival. Using the secret techniques revealed in this film, you too will be able to draw a cat.\n\nStereoscopic Movie in Full 360 experience\nCustomizable viewing experience\nGreat for a laugh!\n\nTRT: 6:55 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rgb3d.com/", "developer_terms_of_service_url": "http://rgb3d.com/", "publisher_name": "RGB3D", "support_website_url": null, "website_url": "http://rgb3d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649261796330686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162730_337569563356247_8711676741380210688_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ka65eUm7D8Q7kNvwFqSnJh&_nc_oc=Adp9TGnUVc_ghPSsz1tzc6LdROfUK3ep0nbQbSMqDtDMOkmCJcXSiLXIWHZlOyHe-rA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k9PklbqL1E90hyZ1cqLLFzPC_eXl8UlI06oPObOn_iQ&oe=6A468BBB"}, "is_concept": false, "is_test": false, "is_tri
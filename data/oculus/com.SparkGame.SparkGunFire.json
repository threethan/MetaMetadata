71-25/75644992_1347134939159470_1412293465414882188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdNOXtp56mMQ7kNvwFC7sxf&_nc_oc=AdnUpoVVfkB35B2yiVM5FE2hoG40aKoLxaVu0HPvOPnatvR15Rbm6szOFtWUrrGrT2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv12h5rJR_IJgIg0wmG2OW8SPYJcXRAGLghJLdFvSAR2w&oe=69A41F66"}, {"file_name": "6.png", "id": "1835968650107840", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974585_1835968653441173_2048436170298619646_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONtKNhSV5NAQ7kNvwH2V3pD&_nc_oc=AdnoxlR-EHE9nTs4aYMDSUX5omWpM8pN4nlBbjhTTSNH-3egKx2hV6z8CuL1AwOWi20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvhA3laKLZuQtnX445aZU4tAkgenYNyVR9BE1qcNlL4Q&oe=69A448A4"}, {"file_name": "5.png", "id": "1324076238352441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974634_1324076241685774_6491516265444031547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwzG_aTBnVMQ7kNvwEd8ZZd&_nc_oc=Adml-lwrokgmbB_CZhuw0HBd8CH3yaQjWx1lR85MJeXxAlCYhbfjfRXZAv8KIfZWtQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft31n8NrtGHnmUnN0PwdSXJCqkdfHzHp7tywcVYfydZSw&oe=69A43E7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "575408754156188", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031340_575408757489521_3544856705457314205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3iYNXodih4Q7kNvwEipSmY&_nc_oc=AdkThkbUHnWzKffvOjsc4Wwy5DtT5kIuj_4wsEHxsEpydWzwTv66ku2jL0M1ogSAIK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscckNqbDlYiJ3GUN2o9YZQx3PivFHord4vxV7OYxQY5g&oe=69A44754"}, "display_name": "SPARK", "keywords": [], "long_description": "SPARK is an immersive first-person shooter VR game with different game mode. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nGOLD ROYALE: Gold Royale is a brand-new game mode in VR, where players can team up or enter the battle alone, search for treasures in the battle, get loot from enemies, and eventually, evacuate within a specific time successfully, or you will lose all your backpack items.\n\nDEATHMATCH: Join the online battlefield with your friends in high-speed combat with up to ten people and beat back your opponents on a strategic and tactical level. \n\nRIDING BATTLE: Experience the unique Riding Battle, and conquer this world together with your precious horse!  \n\nWEAPON RACE: Fight with 12 players, every time you successfully kill a person, the weapon will be upgraded accordingly,  be ready to become the weapon master!\n\nSPARK is still having the beta test, if you find any glitches or need any support, please contact us: hello@sparkgame.com.cn\uff1bDiscord https://discord.gg/hUtVz3FdFA", "short_description": "SPARK is an immersive first-person shooter VR game. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nSquad up, then explore this world fearlessly, SPARK yourself in this SPARK world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sparkvr.games/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SparkGame", "support_website_url": null, "website_url": "https://sparkvr.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
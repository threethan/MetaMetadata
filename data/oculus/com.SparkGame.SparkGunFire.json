35826137", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75644992_1347134939159470_1412293465414882188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhOgmqbQQa8Q7kNvwHk5G2W&_nc_oc=AdpiJxFujihiEIGkpIwhb7FXu6vT5CawMuHA3jFeSlT7AmPJNKvqcI-u0Lhr2wzHrVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3k5nX0Ksjv5-d6D7ZTShds_630CUf2Kl7Hon3igbY8UQ&oe=69F1E7E6"}, {"file_name": "6.png", "id": "1835968650107840", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974585_1835968653441173_2048436170298619646_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYdw0Cr219IQ7kNvwGFmklI&_nc_oc=AdoaZhuhCQ-DCg8txRCVCe_3AgNGlD-E_6yfPuvtJMY5CA8EcdSdNRaY34xOZ4ERCs0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2xzb6vF2_uBxxTrCmxjeJRcFTZi-Iaoob_qH2m0Yo2qA&oe=69F21124"}, {"file_name": "5.png", "id": "1324076238352441", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974634_1324076241685774_6491516265444031547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJP_dw6KerYQ7kNvwEwte_F&_nc_oc=AdqgSldbbWTZme5nPlkYAnZ9NelXcmrFmsaMaEegtDwetxeirAIhagfUyvnFhNbk4OY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3StcRPhcun4TueKsCjZielPFl52Smb4h8N2Qo359v8og&oe=69F206FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "575408754156188", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031340_575408757489521_3544856705457314205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTWR3fwG1OUQ7kNvwERUqDq&_nc_oc=AdqwxI91KdACHaqpkq5kj8S2ONHvzEaDoUBmeVhjhJGK-ScFJHmIEoHxeNYylnN4RtY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0xzGeVYeDAvlcoXDMqpULb1XoIskOuNkcYO-eag92SQg&oe=69F20FD4"}, "display_name": "SPARK", "keywords": [], "long_description": "SPARK is an immersive first-person shooter VR game with different game mode. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nGOLD ROYALE: Gold Royale is a brand-new game mode in VR, where players can team up or enter the battle alone, search for treasures in the battle, get loot from enemies, and eventually, evacuate within a specific time successfully, or you will lose all your backpack items.\n\nDEATHMATCH: Join the online battlefield with your friends in high-speed combat with up to ten people and beat back your opponents on a strategic and tactical level. \n\nRIDING BATTLE: Experience the unique Riding Battle, and conquer this world together with your precious horse!  \n\nWEAPON RACE: Fight with 12 players, every time you successfully kill a person, the weapon will be upgraded accordingly,  be ready to become the weapon master!\n\nSPARK is still having the beta test, if you find any glitches or need any support, please contact us: hello@sparkgame.com.cn\uff1bDiscord https://discord.gg/hUtVz3FdFA", "short_description": "SPARK is an immersive first-person shooter VR game. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nSquad up, then explore this world fearlessly, SPARK yourself in this SPARK world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sparkvr.games/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SparkGame", "support_website_url": null, "website_url": "https://sparkvr.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
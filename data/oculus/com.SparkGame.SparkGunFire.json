5g&oe=6A119F48"}, {"file_name": "4.png", "id": "1347134935826137", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75644992_1347134939159470_1412293465414882188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h7JIAj7EuIQ7kNvwGIgyZx&_nc_oc=Adr2outd5MLnrNqT8DQr1Eu23kSJxKv23Tyy1LeUgPQvi4RBbNxo9d0n_8VgcJwU8as&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af776zD7qFQZk6WJ0teMX5eLT9SWAsI_zocUAcTH7TFUsA&oe=6A11C426"}, {"file_name": "6.png", "id": "1835968650107840", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974585_1835968653441173_2048436170298619646_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkiA_cCQxKkQ7kNvwGlJeZs&_nc_oc=AdoVGkyKaGX_C7YbrtHiH5olBfkNaz8LZCLmt_gQaKQ6by7TFXGMhHaRsI0gtryu0nw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gg1nTYgsfmoMCMeAzwJ1eODvZ45En1mzx0QNTFPBt3w&oe=6A11B524"}, {"file_name": "5.png", "id": "1324076238352441", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974634_1324076241685774_6491516265444031547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EkJwmL_SN0Q7kNvwFOEwew&_nc_oc=AdqvjJfdFrH8dPozbBx_cP28pSdNZ7dN8jhdRaWjxk6kEpMLj5kvPNnGVaoxSGZc8bU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GWA7dWygwjc4QqFXXSpamRiU7m4NjoByc7yIqKZIJsQ&oe=6A11AAFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "575408754156188", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031340_575408757489521_3544856705457314205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phF09exztoIQ7kNvwH3J0VY&_nc_oc=AdpQcQFRI0pcO5b1T6L4rAuY5aBJqielZEFz_KfCSukMOXFbx_0PIDV-u8CVCtKdpew&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rlcG8HSwbnHaSfirUKhrH9XpvaC7YhFCvlMlCItVbgw&oe=6A11B3D4"}, "display_name": "SPARK", "keywords": [], "long_description": "SPARK is an immersive first-person shooter VR game with different game mode. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nGOLD ROYALE: Gold Royale is a brand-new game mode in VR, where players can team up or enter the battle alone, search for treasures in the battle, get loot from enemies, and eventually, evacuate within a specific time successfully, or you will lose all your backpack items.\n\nDEATHMATCH: Join the online battlefield with your friends in high-speed combat with up to ten people and beat back your opponents on a strategic and tactical level. \n\nRIDING BATTLE: Experience the unique Riding Battle, and conquer this world together with your precious horse!  \n\nWEAPON RACE: Fight with 12 players, every time you successfully kill a person, the weapon will be upgraded accordingly,  be ready to become the weapon master!\n\nSPARK is still having the beta test, if you find any glitches or need any support, please contact us: hello@sparkgame.com.cn\uff1bDiscord https://discord.gg/hUtVz3FdFA", "short_description": "SPARK is an immersive first-person shooter VR game. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nSquad up, then explore this world fearlessly, SPARK yourself in this SPARK world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sparkvr.games/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SparkGame", "support_website_url": null, "website_url": "https://sparkvr.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
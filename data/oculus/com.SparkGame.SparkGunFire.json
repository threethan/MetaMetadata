AA&oe=6AA3F5C8"}, {"file_name": "4.png", "id": "1347134935826137", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75644992_1347134939159470_1412293465414882188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBSymTRjM4AQ7kNvwGfJokK&_nc_oc=Adpq4XxyGcEy-epQLNT6_NDPunOjeB7Uvgm6JJxiMWcJIMgZ46kJ-EQRvuk8MfEHi9A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8Jfxuls1szntwFG20h-nzIlfN42j5MkYKXO7nZGn2yA&oe=6AA41AA6"}, {"file_name": "6.png", "id": "1835968650107840", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974585_1835968653441173_2048436170298619646_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPfa5SdYFcIQ7kNvwHtgjI_&_nc_oc=AdrsVGC1L_at2KFA7CTroby94DD1jIfU-k6wvwfdpT8fvmr1xILFXB48rXTi7JOemVA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1XWXZyTij4DT1TL8RZexMxVGq0NysyJZpnBWwD42KcA&oe=6AA40BA4"}, {"file_name": "5.png", "id": "1324076238352441", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974634_1324076241685774_6491516265444031547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b08uGT_DgdgQ7kNvwGj_N-Q&_nc_oc=Adq0sXb7qXec3Qm3NSc1cHRUEa2n7-ngLZQFI8EssvWRVsdq42zP-KXo-R7nCrfQ-u0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF5oNsGYzYpWesE9O68I0getyq-xvWXIPAYxKw_q4tAw&oe=6AA4017E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "575408754156188", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031340_575408757489521_3544856705457314205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFPC9KEKxvkQ7kNvwFVF1Mt&_nc_oc=AdrMp8H2RWx2ZawSSLFzfCA_Wp9ltpSftDzMP_n3_YZXBLtbe4d8lmpigonsG4weJUU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQVAS0uOFOB-4FXEvJHTH7OnlrDJSFrAcxZsoH8K9ZJA&oe=6AA40A54"}, "display_name": "SPARK", "keywords": [], "long_description": "SPARK is an immersive first-person shooter VR game with different game mode. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nGOLD ROYALE: Gold Royale is a brand-new game mode in VR, where players can team up or enter the battle alone, search for treasures in the battle, get loot from enemies, and eventually, evacuate within a specific time successfully, or you will lose all your backpack items.\n\nDEATHMATCH: Join the online battlefield with your friends in high-speed combat with up to ten people and beat back your opponents on a strategic and tactical level. \n\nRIDING BATTLE: Experience the unique Riding Battle, and conquer this world together with your precious horse!  \n\nWEAPON RACE: Fight with 12 players, every time you successfully kill a person, the weapon will be upgraded accordingly,  be ready to become the weapon master!\n\nSPARK is still having the beta test, if you find any glitches or need any support, please contact us: hello@sparkgame.com.cn\uff1bDiscord https://discord.gg/hUtVz3FdFA", "short_description": "SPARK is an immersive first-person shooter VR game. You will enter a virtual world named SPARK, where you can join the online battlefield with your friends in Gold Royale, Dead Match and Riding Battle. \n\nSquad up, then explore this world fearlessly, SPARK yourself in this SPARK world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://sparkvr.games/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "SparkGame", "support_website_url": null, "website_url": "https://sparkvr.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
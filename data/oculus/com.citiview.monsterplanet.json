oc=Adr7-1XVubm7q4ZYwP65tvefoRUJy0XVw4iNhRP5rC4DgxUScvmMu-S3lVo58KZ-G8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSN8H7P3dJS6AipU_E_gF2QWVECHYnG_ztTMv2XEftbg&oe=6AF74823"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1713676346938563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1713676350271896_159265706368260484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGbV6feBxJ0Q7kNvwGkOv7T&_nc_oc=Ado6oR3IkYIXvKeZ_DGRSnRIhS8U-arSfTU3B3uhh9u6LCxAiyH9FsF88jc6-pb-i04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGpvzrY7KJFbKPRjv4ImSopYadGRZpSE-yWXBoM0VLlw&oe=6AF71CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1146060991099938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1146060994433271_5726412788252528211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYuM51XrgagQ7kNvwHtQxrM&_nc_oc=AdpfTfuKTY98K_fpzPirnJpK7ApecujojTwazDue2dacuyH7zZcAoAhCOmZ_WnsVsV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkWRB674uZhKk3TQI4yD4F7_XwX6QoChMXkalK54CDPg&oe=6AF74A1C"}, "display_name": "Monsters", "keywords": ["monsters", "shooter", "arcade", "space", "blaster"], "long_description": "Monsters is a bright, fast arcade shooter built for VR. You stand on a small outpost deck on an alien planet while monsters pour out of glowing portals all around you - so keep turning, because they come from every side.\n\nA BLASTER IN EACH HAND\nPick from 18 sci-fi blasters on a circle weapon wheel - pistols, SMGs, burst rifles, shotguns, a gatling, a plasma cannon, a sniper and a rail gun that punches through three monsters at once. Y changes your left gun, B changes your right.\n\nMONSTERS FROM EVERY SIDE\nWalkers march up to your rail and pound the shield, blobs bounce in from the portals, flyers swoop around the outpost and dive at your face. Land head shots for double damage.\n\nPOWER-UPS\nShoot the glowing orbs for SLOW-MO, a NOVA BLAST that clears the field, SENTRY GUNS that open fire from the corners of your deck, and DOUBLE POINTS.\n\n5 PLANETS, 5 BOSSES\nRed Rock Outpost, Ice Moon, Toxic Jungle, Crystal Caves and Demon Desert - each with its own sky, monsters and a giant boss: the Mushroom King, the Yeti Titan, the Frog Emperor, the Blue Demon and the Demon Lord. Every planet is harder than the last.\n\nSCORE CHASE\nChain kills for combos up to x5, finish a wave without a scratch for a FLAWLESS bonus, and earn an S rank on every planet. No blood - monsters pop in a burst of colour and gems.\n\nDeveloped and published by Citiview Studios.", "short_description": "Hold the outpost against a planet full of monsters! Dual-wield 18 sci-fi blasters from a circle weapon wheel, blast walkers, bouncing blobs and diving flyers from every side, grab power-ups and take down a giant boss on each of 5 colourful planets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/monsters/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/monsters/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1244818462057460"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"s
nt-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1101491312330199_4873821791758456325_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_lacAzvJr0Q7kNvwGqTbrm&_nc_oc=Adobcw5rppQhAp0ZepQUbUBdc6_-3reGPlSAvD8qmB4lGZSVruqRIm1iFkOpHv0xy8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOcK00a450HzzpCw-aUvqgWCUat0U14liL4ou_NcNPlw&oe=6AFDB093"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1745742496654629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1745742499987962_1564920129776159859_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btPVUyzoBTYQ7kNvwHiVpVc&_nc_oc=AdoxbXBGhLVrANzajuqlwpuygOahz6gMccSR61Xx7kMPb_qFHAzKt-lcr8XNXcSKOcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZiJbWSFzfakN9t1-FxFYXuld8gTz9_Wd1nlEfB6mSlQ&oe=6AFDB886"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1403525241195720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673525341_1403525244529053_4033633881925914257_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7axSobs9Py0Q7kNvwHE5IUH&_nc_oc=AdrFCk7WqrDN8RxPs1O5hJNOc5geAI73z3iJnG3ZWO3JS1BzNp8EvY-aMaSULtknJ-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-YaJXdsYUe7kFu2KswuUnzbeasxP04TFAM2AmJs55jQ&oe=6AFDDFA3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1713676346938563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_1713676350271896_159265706368260484_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uCXgj4_4N0Q7kNvwGFyMpL&_nc_oc=AdqagQEYmkIyDTFf7g93sucuMr6vVa2z-EdRTJgid5GTL95JMVTzcEsfzmOQu3kolI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBljdIZQfI9gI0S65a6FbWtID03szR_O1GCJ8C8KnC7A&oe=6AFDB476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1146060991099938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1146060994433271_5726412788252528211_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzWeAz708GgQ7kNvwFa-Y8a&_nc_oc=AdrVvQaXvwGqkbCkNbAh0yNTWVDIys_Aue9TlQ6NUKVxWjQYJivtwLNMJlKV3n1QSqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzWmMyruROcgG38hjpL_Wy6PP_OgUdHy3scIlBZixbcA&oe=6AFDE19C"}, "display_name": "Monsters", "keywords": ["monsters", "shooter", "arcade", "space", "blaster"], "long_description": "Monsters is a bright, fast arcade shooter built for VR. You stand on a small outpost deck on an alien planet while monsters pour out of glowing portals all around you - so keep turning, because they come from every side.\n\nA BLASTER IN EACH HAND\nPick from 18 sci-fi blasters on a circle weapon wheel - pistols, SMGs, burst rifles, shotguns, a gatling, a plasma cannon, a sniper and a rail gun that punches through three monsters at once. Y changes your left gun, B changes your right.\n\nMONSTERS FROM EVERY SIDE\nWalkers march up to your rail and pound the shield, blobs bounce in from the portals, flyers swoop around the outpost and dive at your face. Land head shots for double damage.\n\nPOWER-UPS\nShoot the glowing orbs for SLOW-MO, a NOVA BLAST that clears the field, SENTRY GUNS that open fire from the corners of your deck, and DOUBLE POINTS.\n\n5 PLANETS, 5 BOSSES\nRed Rock Outpost, Ice Moon, Toxic Jungle, Crystal Caves and Demon Desert - each with its own sky, monsters and a giant boss: the Mushroom King, the Yeti Titan, the Frog Emperor, the Blue Demon and the Demon Lord. Every planet is harder than the last.\n\nSCORE CHASE\nChain kills for combos up to x5, finish a wave without a scratch for a FLAWLESS bonus, and earn an S rank on every planet. No blood - monsters pop in a burst of colour and gems.\n\nDeveloped and published by Citiview Studios.", "short_description": "Hold the outpost against a planet full of monsters! Dual-wield 18 sci-fi blasters from a circle weapon wheel, blast walkers, bouncing blobs and diving flyers from every side, grab power-ups and take down a giant boss on each of 5 colourful planets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/monsters/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/monsters/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1244818462057460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_1024853360602692_809504692441203122_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co4gWK2dYyEQ7kNvwG6OPay&_nc_oc=Adq55SWiRaKPqsQBsON8gZf6eGUPcwegNNQn-XoCQ7ATkshpni2hXxsGKIYBboBYGcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP1Yo-pQuYdvNo0FKwhdfFYNcT4nRMIPUhUppsuwEgJQ&oe=6AFDB6DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monsters", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}
WCUat0U14liL4ou_NcNPlw&oe=6AFDB093"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1745742496654629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1745742499987962_1564920129776159859_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btPVUyzoBTYQ7kNvwHiVpVc&_nc_oc=AdoxbXBGhLVrANzajuqlwpuygOahz6gMccSR61Xx7kMPb_qFHAzKt-lcr8XNXcSKOcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZiJbWSFzfakN9t1-FxFYXuld8gTz9_Wd1nlEfB6mSlQ&oe=6AFDB886"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1403525241195720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673525341_1403525244529053_4033633881925914257_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7axSobs9Py0Q7kNvwHE5IUH&_nc_oc=AdrFCk7WqrDN8RxPs1O5hJNOc5geAI73z3iJnG3ZWO3JS1BzNp8EvY-aMaSULtknJ-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-YaJXdsYUe7kFu2KswuUnzbeasxP04TFAM2AmJs55jQ&oe=6AFDDFA3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1713676346938563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_1713676350271896_159265706368260484_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uCXgj4_4N0Q7kNvwGFyMpL&_nc_oc=AdqagQEYmkIyDTFf7g93sucuMr6vVa2z-EdRTJgid5GTL95JMVTzcEsfzmOQu3kolI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBljdIZQfI9gI0S65a6FbWtID03szR_O1GCJ8C8KnC7A&oe=6AFDB476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1146060991099938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1146060994433271_5726412788252528211_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzWeAz708GgQ7kNvwFa-Y8a&_nc_oc=AdrVvQaXvwGqkbCkNbAh0yNTWVDIys_Aue9TlQ6NUKVxWjQYJivtwLNMJlKV3n1QSqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzWmMyruROcgG38hjpL_Wy6PP_OgUdHy3scIlBZixbcA&oe=6AFDE19C"}, "display_name": "Monsters", "keywords": ["monsters", "shooter", "arcade", "space", "blaster"], "long_description": "Monsters is a bright, fast arcade shooter built for VR. You stand on a small outpost deck on an alien planet while monsters pour out of glowing portals all around you - so keep turning, because they come from every side.\n\nA BLASTER IN EACH HAND\nPick from 18 sci-fi blasters on a circle weapon wheel - pistols, SMGs, burst rifles, shotguns, a gatling, a plasma cannon, a sniper and a rail gun that punches through three monsters at once. Y changes your left gun, B changes your right.\n\nMONSTERS FROM EVERY SIDE\nWalkers march up to your rail and pound the shield, blobs bounce in from the portals, flyers swoop around the outpost and dive at your face. Land head shots for double damage.\n\nPOWER-UPS\nShoot the glowing orbs for SLOW-MO, a NOVA BLAST that clears the field, SENTRY GUNS that open fire from the corners of your deck, and DOUBLE POINTS.\n\n5 PLANETS, 5 BOSSES\nRed Rock Outpost, Ice Moon, Toxic Jungle, Crystal Caves and Demon Desert - each with its own sky, monsters and a giant boss: the Mushroom King, the Yeti Titan, the Frog Emperor, the Blue Demon and the Demon Lord. Every planet is harder than the last.\n\nSCORE CHASE\nChain kills for combos up to x5, finish a wave without a scratch for a FLAWLESS bonus, and earn an S rank on every planet. No blood - monsters pop in a burst of colour and gems.\n\nDeveloped and published by Citiview Studios.", "short_description": "Hold the outpost against a planet full of monsters! Dual-wield 18 sci-fi blasters from a circle weapon wheel, blast walkers, bouncing blobs and diving flyers from every side, grab power-ups and take down a giant boss on each of 5 colourful planets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/monsters/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": 
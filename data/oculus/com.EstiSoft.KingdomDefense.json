5/491820887_1590302885647813_254915159854129297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8c3A-pKzQYQ7kNvwHaSMsp&_nc_oc=AdqXTtkTdqf_nIK7sSu80z9LSA7SQSGA95UhWiFJkF80VeS0g4uTG3F1y8ReFxYew40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mAcQ3Uic4MkSUwbIlYoL-y6vHwrqCbNpkTmMWF5IS3Q&oe=6A21843E"}, {"file_name": "ss2.png", "id": "1149741593983602", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819281_1149741600650268_5774635502717696152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rly9ca9nTAYQ7kNvwGVJKPC&_nc_oc=Adq97HNFna2qaT8PNMwLO0zVk62kpyO2Qmh7mAz1UEcNcOe3y77eapDl7x2MNp17m2A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mHCFZQ1KBjjnH-yizf9ZqZ_wfKwT_r6awC4n1fFoPAA&oe=6A2183A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1378111223784786", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822307_1378111227118119_3144963070520417325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1SxKBB3gJQQ7kNvwH37P2p&_nc_oc=AdobyU-blgNTE3UAi-tqZUh6ZTXR46ZhYPGx16f2Yu6SISv-0nCIG9qER8NEgj3OAY0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WgD-9qvy20KYOabduBchKbIQ1o_uRqjvIfC357n9JYQ&oe=6A21928F"}, "display_name": "Kingdom Defense", "keywords": ["towerdefense", "action", "strategy", "hero", "fantasy"], "long_description": "Kingdom Defense is an action-focused defense game where strategy and reflexes come together inside a colorful fantasy world built for VR.\n\nYour goal is simple but challenging: defend your kingdom against endless waves of enemies. Pirates, monsters, and dangerous creatures attack from multiple directions, forcing you to think fast and adapt your tactics in real time.\n\nDuring each battle, you actively place defensive structures, control heroes, and respond instantly to threats on the battlefield. Resources earned through combat allow you to strengthen your defenses, improve hero abilities, and unlock new strategic possibilities as the difficulty increases.\n\nThe gameplay constantly pushes you to balance offense and defense while making split-second decisions. Every encounter feels different as enemy patterns change and pressure increases.\n\nWith its stylized visuals, intuitive controls, and VR-first design, Kingdom Defense delivers an engaging experience that is easy to start but challenging to master.\n\nCan you protect your kingdom and survive every wave?", "short_description": "Kingdom Defense is a fast-paced action defense game designed for immersive VR gameplay.\nBuild your defenses, control powerful heroes, and fight against relentless waves of pirates and fantasy creatures. Make quick decisions, upgrade your units, and protect your kingdom in dynamic real-time battles."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621996094051014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831279_3797893337020900_1007116630344517669_n.png?stp=dst-png_s360x360&_nc_cat=103&c
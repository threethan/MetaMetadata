5/491820887_1590302885647813_254915159854129297_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kpXt-sNKV4Q7kNvwEf5JEN&_nc_oc=AdopMkWTG6aBwu2VXlkEunhLsyclHhDsFlTgXBnUuJ1vt9OV273H2-9lyA_Q-MmTw_s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-E1hwZatYHUlc3YvJJieiv2MeTJSFg6tOdC56tO14qQ&oe=69E630BE"}, {"file_name": "ss2.png", "id": "1149741593983602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819281_1149741600650268_5774635502717696152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj7Wu6hDDLAQ7kNvwEM5lMS&_nc_oc=AdreDj4JKlbqDasQ4jLsFd8ipsHtwVZasnWn23z1kMuwYw7ePxpYbEMzWgvdIt7444M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LbgVbQrblGVp4978roc0pdfbvCak2ms2NRX1T21yTEg&oe=69E63024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1378111223784786", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822307_1378111227118119_3144963070520417325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3990nHQuSIQ7kNvwHkDOsY&_nc_oc=AdoN6G5CQ6qfrtkY08X3kuT-WpkC-kvb2rbLxCblGhMJkOrztt_YrXNrfC-3Fnhj1LE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3onHAhuCL4keFf9OoTpOPlS8Q4Br3YdK_zQ9Tt2ECxDQ&oe=69E63F0F"}, "display_name": "Kingdom Defense", "keywords": ["towerdefense", "action", "strategy", "hero", "fantasy"], "long_description": "Kingdom Defense is an action-focused defense game where strategy and reflexes come together inside a colorful fantasy world built for VR.\n\nYour goal is simple but challenging: defend your kingdom against endless waves of enemies. Pirates, monsters, and dangerous creatures attack from multiple directions, forcing you to think fast and adapt your tactics in real time.\n\nDuring each battle, you actively place defensive structures, control heroes, and respond instantly to threats on the battlefield. Resources earned through combat allow you to strengthen your defenses, improve hero abilities, and unlock new strategic possibilities as the difficulty increases.\n\nThe gameplay constantly pushes you to balance offense and defense while making split-second decisions. Every encounter feels different as enemy patterns change and pressure increases.\n\nWith its stylized visuals, intuitive controls, and VR-first design, Kingdom Defense delivers an engaging experience that is easy to start but challenging to master.\n\nCan you protect your kingdom and survive every wave?", "short_description": "Kingdom Defense is a fast-paced action defense game designed for immersive VR gameplay.\nBuild your defenses, control powerful heroes, and fight against relentless waves of pirates and fantasy creatures. Make quick decisions, upgrade your units, and protect your kingdom in dynamic real-time battles."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621996094051014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831279_3797893337020900_1007116630344517669_n.png?stp=dst-png_s360x360&_nc_cat=103&c
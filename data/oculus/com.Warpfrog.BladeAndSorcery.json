JWj1m4czr_GvPKYQveW8g&oe=6A47CA48"}, {"file_name": "hole cc.png", "id": "2075857779239822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_2075857782573155_9122727236454616172_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YeBkhFVRQgQ7kNvwHls9BX&_nc_oc=AdosRU8ck6xq4tFtsJYxpD2xXdxmlFUyX_pVkgWJxj03IZhGgHMc4go-zJQ44VOiJ4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M-hHr5dIHcDjyK18F3Ciypra9dsfKC9RBgp9P_cyQcg&oe=6A47DF6A"}, {"file_name": "dungeon sword cc.png", "id": "282029897081919", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001692_282029900415252_4974564925784914357_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDQIxSTihcoQ7kNvwGeU12y&_nc_oc=Adr8RlDjVExy5PtP2DB-awldR3XID3AI7mAx6-flmTaH7aYumQstzjMniu2CbDmdyj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pLMIIQ-h6XMtFT447VBDFpuRaE2KCgt4gYL57iH-W9Q&oe=6A47D8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_logo.png", "id": "1050042049126333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569485_1050042052459666_4399707948180398893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLqOR0Qhn0IQ7kNvwGWxD8h&_nc_oc=AdoI8TScinLPHSthcs-FOxPYiBdppDwxkFI1ZBFvWG1A1MTKrAEfRp7t_ThKzqKF_1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hKPnXfnVEJ0bjJUA4uqse9cR_zii568vFIsHvmqNXrQ&oe=6A47B60C"}, "display_name": "Blade & Sorcery: Nomad", "keywords": ["Sword", "Melee", "Medieval", "Physic", "Magic"], "long_description": "The era of the VR weightless, wiggle-sword combat is over. Blade & Sorcery: Nomad is a medieval fantasy sandbox like no other, focusing on melee, ranged and magic combat that fully utilizes a unique and realistic physics driven interaction and combat system. Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Blade & Sorcery: Nomad, the combat is limited only by your own creativity. Choose your weapon, choose your stance, choose your fighting style; Be the powerful warrior, ranger or sorcerer you always dreamed of becoming!", "short_description": "Blade & Sorcery: Nomad is a built-for-VR medieval fantasy sandbox with full physics driven melee, ranged and magic combat. Become a powerful warrior, ranger or sorcerer and devastate your enemies."}]}, "developer_name": "Warpfrog", "developer_privacy_policy_url": "https://warpfrog.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Warpfrog", "support_website_url": "https://discordapp.com/invite/bladeandsorcery", "website_url": "https://warpfrog.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3138085263116987"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "970829305688689"}, {"status": "PENDING", "id": "2169084010589693"}, {"status": "PUBLISHED", "id": "1302758204936810"}, {"status": "PUBLISHED", "id": "1251613176559533"}, {"status": "PUBLISHED", "id": "290074426308729"}, {"status": "PUBLISHED", "id": "1095796905584118"}]}, "baseline_offer": {"id": "1095796905584118"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493
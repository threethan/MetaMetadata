ReSpmuBmunyjYde1F-B2g&oe=6A05DF48"}, {"file_name": "hole cc.png", "id": "2075857779239822", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_2075857782573155_9122727236454616172_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEFMf_7r3dsQ7kNvwG5tEt1&_nc_oc=AdpRmSaYuP6zY2C9lV6DRr4lal26-kPzNTDdQQIZ8-sEHjNJzVVkI2fvxyPehWFFLDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KYJabLRB2ALAEHCNBrIvnVrHS0wdRNBOld-q40fdYgA&oe=6A05BC2A"}, {"file_name": "dungeon sword cc.png", "id": "282029897081919", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001692_282029900415252_4974564925784914357_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIUyrHI6aKUQ7kNvwH7PPX8&_nc_oc=AdondyvsR2mthTVyllOIHXg86B5Tam8hqtaczDr86aie3eIj9D9mb8RR4yTWDKuhMSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mjAQhAm3mmXMhsyltUaGpHZ4-oK1JeqNQTacUQuTpRg&oe=6A05EDB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_logo.png", "id": "1050042049126333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569485_1050042052459666_4399707948180398893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd6FeGaEZjEQ7kNvwFTVesD&_nc_oc=Adp-XpAx0QKznamZGGwQk4mGK7me68_hVKXfVRGEturNSNaSczsXYL6qKfC68jv2bKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65Ye6qH8x-rsnZgPitQ3Ow31wtHSIFSIYdPB0hGXCJIw&oe=6A05CB0C"}, "display_name": "Blade & Sorcery: Nomad", "keywords": ["Sword", "Melee", "Medieval", "Physic", "Magic"], "long_description": "The era of the VR weightless, wiggle-sword combat is over. Blade & Sorcery: Nomad is a medieval fantasy sandbox like no other, focusing on melee, ranged and magic combat that fully utilizes a unique and realistic physics driven interaction and combat system. Built exclusively for VR, collisions are dictated by fine hitboxes, objects have weight and follow the laws of physics, creatures have full body physics and presence, and blades can be used to penetrate soft materials or deflect magic. In Blade & Sorcery: Nomad, the combat is limited only by your own creativity. Choose your weapon, choose your stance, choose your fighting style; Be the powerful warrior, ranger or sorcerer you always dreamed of becoming!", "short_description": "Blade & Sorcery: Nomad is a built-for-VR medieval fantasy sandbox with full physics driven melee, ranged and magic combat. Become a powerful warrior, ranger or sorcerer and devastate your enemies."}]}, "developer_name": "Warpfrog", "developer_privacy_policy_url": "https://warpfrog.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Warpfrog", "support_website_url": "https://discordapp.com/invite/bladeandsorcery", "website_url": "https://warpfrog.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3138085263116987"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "2169084010589693"}, {"status": "PUBLISHED", "id": "1302758204936810"}, {"status": "PUBLISHED", "id": "1251613176559533"}, {"status": "PUBLISHED", "id": "290074426308729"}, {"status": "PUBLISHED", "id": "1095796905584118"}]}, "baseline_offer": {"id": "1095796905584118"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2169084010589693"}]}, "liv
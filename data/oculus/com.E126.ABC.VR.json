.png", "id": "492367270128963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221317_492367273462296_4000725602861274718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4p6VNs5SD4Q7kNvwHPVMY6&_nc_oc=AdpJWQF6npef8R4B8I-tyaiYVFMOSYHxXcuWH_DUc_3L0vbP1sIc-S50ZOkUCI5K75g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1iAZ4VMN9BisOC9d7VdkBYqpvMqSFP5TnzRPp-seCztg&oe=69F0C07D"}, "display_name": "ABC VR", "keywords": [], "long_description": "Let the flowers bloom. Take over!\n\nStop the opposing team with your teammates!\nNot only the opposing team but also the moles will bother you.\nThe team that captures more tiles within time while understanding the terrain well and keeping the opponent in check wins.\n\nAnd use the watch on your left hand to check your team's status and cooperate.\n\n\nIt's more fun when you're with others rather than alone.", "short_description": "Action Shooter in squard-based VR team match"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.126e.co.kr/policy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "126 EAST", "support_website_url": null, "website_url": "http://www.126e.co.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7766872480093593"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126798988394183"}]}, "baseline_off
am with your teammates!\nNot only the opposing team but also the moles will bother you.\nThe team that captures more tiles within time while understanding the terrain well and keeping the opponent in check wins.\n\nAnd use the watch on your left hand to check your team's status and cooperate.\n\n\nIt's more fun when you're with others rather than alone.", "short_description": "Action Shooter in squard-based VR team match"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.126e.co.kr/policy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "126 EAST", "support_website_url": null, "website_url": "http://www.126e.co.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "7766872480093593"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982575_856140099699983_7641027904561475584_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgW4QsYUI8gQ7kNvwHbOZL4&_nc_oc=AdrzZqnCUQ8d2MDVw5MQZtWgVvI47C-LVrtGuWPeCWl7TJ5AU3_3Sp53OfVZ1i8Rp64&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ap0YqjIoGF_jirGQbL6geYoeBbWDG4H2FZBFrIp9cYQ&oe=6A36B955"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ABC VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "
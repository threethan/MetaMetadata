t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59GwQOiScnKEc3H3p55hetMjlmyhjLQT1xWX2Tf3hjoA&oe=6A1D9BAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTNF7t68z2sQ7kNvwHXNMj6&_nc_oc=Adpw2--GYFY3F7TFY-ilPAW8wpRNXfa3xGBu7-R3-F8vpznw08xWyxeFCJO3_0ebD1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xxrM4lj_52viyOYYaed11_XBrYss0IgBzEa_mcQ9eeA&oe=6A1D7D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vetYk-O0q4cQ7kNvwFTxmkJ&_nc_oc=AdpwP3I3jddXe-3zM4gmnXowy8eXn9iqyedXGUVUseSzFAR4u_Vb0rYC6zgvjfcpK58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PowLsEh_WEtbgxyt1L0530QIsXaq5z3H-rE0m-YUQVA&oe=6A1D7DFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rhi4M_ayQoQ7kNvwENh6Va&_nc_oc=AdqVswptbfRSUPZHXncfyijNmxicEZLL6tBun8SHxXazLkR0PE0jibdL0eDc5luA85Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7payigZfqeKTUjdAhzTrDcSXULq3Hdlnneea8O_xtIBA&oe=6A1D804C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLZPDR2ev1EQ7kNvwH_CQ9p&_nc_oc=Adq2J4W5Y96tMOBkCd8abJB-h3WeNw40mj4ww6-1t1UUX3cll5San70OaS5vdUsvzzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CgYK0q_yXJFSh2zjjGtrztMX0aPMXpBdFzOPI0piiiA&oe=6A1D897D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XHCSkMiaZYQ7kNvwHIwUTd&_nc_oc=Adrs13N7krhB3NTUyrlONdMQEBZiScM0WPCCaShTVQvlAz2St1zWHegNezrJBpL6Tbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-IDzUnlJM2g-YWEYArXp6ZVYgFUyxOauXDiRRO_Loig&oe=6A1DA7C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj2SyrZN39oQ7kNvwG90eDF&_nc_oc=Adrl-CmjGd9Vlw_ExCJExStb8-dYmjtIjlEFfSB0m8XWMuyKOOKAjmgos6JncEq2i3
t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FT5dzkGMSjIYdq-81mKBVCBloKkBCMLg__89K4tXSDQ&oe=69DD022C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm8iVgblZ-4Q7kNvwEhTbsJ&_nc_oc=AdrTDhZPGUUvhs9JrzwprIsNzXN5VqeKM3KvnjymfwBuEHmCStyxQ_kRQZwuEOPMtE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-sp20U3MRv1NTKHjO8vBkJPjfiWqNEXJTLWx0N5stYQ&oe=69DCE3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMZkozHGOHsQ7kNvwFAdypU&_nc_oc=AdpbhBLSpRgoGRiZjOT6zGPspggOk3M52Mhv7AUcrKIGkbGisAPXEogBkHRXnMKlOCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23rQmqsOEYSe3LKXufFhQxTNoLt9sN79iUikemi3EEgw&oe=69DCE47E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38JFSbq5x1oQ7kNvwEO0sww&_nc_oc=Adon9BDjnTSxYEhUHkV_wU9Vf1WxgGKbEy2QcfeggnmJYwPx3Vsw87ERlZACIjWPp2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10avxqYHGW8Pb1L0dnBGlYW58Mo1rXmzThhD8_GhFMQw&oe=69DCE6CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFXU1AK_CD0Q7kNvwFheCf2&_nc_oc=AdrpQWRuqWDWOTCuF51scxZDVVjVvUlhE0T8WCrsns9woYLZlWYIUGc2-L74T_FeRhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HJ3kYB7cxLfyk5EtOVbpyPDOnjcRC9PxSqhtpT_M1Mg&oe=69DCEFFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBFDflt8zpUQ7kNvwEVgsbH&_nc_oc=AdpyLHPKDn7Rz4rMPrkcgd1FLrKkxW3Fhg7w58_XOPIDRcYZXfr8ANsb0xy_pqdKVmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32I8WVOTItb2zATOFaBK_q8b3CLa5CL6hjpwvNC5QKyw&oe=69DCD609"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSTkGDVpu00Q7kNvwGt_Vik&_nc_oc=Adq2RNNWa4bOs5mjjms8Zolk48zi-kQbg4JvEqa7HzxRbJRO2INf08hM8SH-wBKdrr
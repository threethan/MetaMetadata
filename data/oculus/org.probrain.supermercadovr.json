t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N4bWaYrY2ie_jBkFiz84a7zEUipVlF7v5nRnhDFQx6A&oe=6A1EED2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0paw_gQljf4Q7kNvwEnuIKY&_nc_oc=AdrjRkpb4yDYysGsoKwIpfRi4SVLwrXz-HTDZ99orV0fRwkdBzR5J_xn3W4MFClw1Yg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45zBQZSfpomEWbkh4-cAP4VkiIMKYfNCGipBv0EK6R-w&oe=6A1ECED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ttje7Y_waMQ7kNvwEA7nep&_nc_oc=AdrCneBzI8aF470GEK3X7X02Nb3jD6VxRKUzMgmYGq4v8wgTTpTEZs2y1RHpi7yJPPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FPz3CK_cq4_9uVarRO8BN_1wfwbWsBvVulV2X61frCg&oe=6A1ECF7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rhi4M_ayQoQ7kNvwGIAnDz&_nc_oc=AdpJRoqQaiFbWBiyhA5F0m2T-lWf1tWDk2r73A702PoioG1_eZJrSQ3-lRKM4KUpizk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V--kfa0gflM4vhF1QIMIGBsIs6OOrneImrzalkBM2zQ&oe=6A1ED1CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLZPDR2ev1EQ7kNvwEqRQo7&_nc_oc=Adr8TUFfuFwfC70h6HyApc1f6E2Wr_nFbUvHc5AsiTqKkZtR_Sdp_OaD9nzZRdJ_fzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s1DpBWAoMllGK94jjwKved97T31bjyjrTjrIxzaRIAA&oe=6A1EDAFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XHCSkMiaZYQ7kNvwGRUeqi&_nc_oc=AdokxeBeOUU9KKnZ1muNPzFhpFTifXOQ4pTJewmsbnR1tpfkPcrIdyVYhJK9EFEQW9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jkTAYbIWWosIYOLgaDRvue7YaAAWwhFikWHuqEdZqKQ&oe=6A1EF949"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj2SyrZN39oQ7kNvwGaafrP&_nc_oc=AdpIHf-CH4m6lBcyT9lLJ7iaFXo3sdA4gHXosyWB-Mc2RHr5-Grmvzxdh-AIsmYQzx
t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21969jSvAFTlzbJzmWqSoyOp2nG_35-Y9lsP670mVA5A&oe=69D3C7AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2d2l0oGevAQ7kNvwEerBkW&_nc_oc=Adop-nEseu2cxA1szQRXnpwR6aFgmROUKkk9GEmcb7Kswrh5woYz_8_mg3V9NK9gTcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kWbauPkRqo7EXBRxBiOX9HjZDxUUEI2D2BwP0blpFqw&oe=69D3A953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCCGz2jha8gQ7kNvwHhWcOa&_nc_oc=AdrCpjzyKz93AX2T8RErIC4_Y7StcuvUggK075e_g_uFANfO1oHYytHvSmRMiNqBUHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HmJ0SGCa3VdWkVQ2h5cslB1Sq81jpTMnGmtMizVoQYg&oe=69D3A9FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8_ixAlA5uwQ7kNvwFbRZUq&_nc_oc=AdqxPPNVjLJSJepONziUuD4OTelPH1Gk5Woh5hYFT3-A55HW7DFLQhVvG-K9V23LMmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27b2UjJnZFibTvT2DvpClT-wprb3boPNU72fDTZoeCZg&oe=69D3AC4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY3QqUmhbfcQ7kNvwHP4N7O&_nc_oc=AdopvYWkYp3DFL1xu4ghr_QHuZS66xtCl65iAC8D0Uo4Cr-ZCaADwkNF66Em_RD-Qrw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mWd0zryApm3rORkTN9cw1F_dHy9tJqZ2Ru4PS0nVxvQ&oe=69D3B57D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmBwO_eC1LEQ7kNvwH_DjV7&_nc_oc=AdoVpDUIdvS_p0Tz85HQY1EoM_U5J1lwoEIISzI3Hnekx5vdYOr38uRj59rkpzs9_cI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uazkNUnM3lheeVB14thmi3s0NWKesCPbb7Y6L1ouXvg&oe=69D39B89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7whUITb31uMQ7kNvwGFsVv7&_nc_oc=AdoMNuQPuJPysYtIMUNn61-bzj4OZJSF0WMIhGv9h7vCp7pv9PuSCyJSqGD3aaph-q
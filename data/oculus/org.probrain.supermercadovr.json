t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEfqjiRSAAM7SlUU94QRBjEzR_soBS3RbhTRLj59FIjA&oe=6AE4AE2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49tkz5VWYhAQ7kNvwH48OG7&_nc_oc=AdpzsMU4Oe3uTbDK5zwuStrIW2LEf32do079meG5zOF5vFW_6P6zHYPIGLsPkTIkK0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc7yCa1D2AWDIga0Gq_fbaiIRBjZ2KAUsvlw1v7sLdqg&oe=6AE48FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6htLFwCvVxAQ7kNvwF6oxVE&_nc_oc=AdoEQdIbd13RwV0TPskDb0PnsGsFw9UpHkUr2EcmPT1QQewug6XfvdaoB1l_9kq7eWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODpT3bJhtXx5flERUm98f9p0h06yqvMixpRd3leMOSfQ&oe=6AE4907E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGOTqYPZ4ukQ7kNvwGNbclL&_nc_oc=AdrHV2E-cSrxKaMXIgM_8rrm2_9xN0JPPZSmh7HgzW2krv2cqfv4r9P-ZWh8TTdx_iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmrgdb76vKkRpuxlwITasBM1Qm5fmDIPG2yBkaO9HiYw&oe=6AE492CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqRKVLo84zkQ7kNvwEZoewq&_nc_oc=AdpBYA264hsqR5wG2sjIV1HNw-lLzXDSBdBwyCsr49eRFjp9Y8zQoqHiEzs53CNaj4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPWxnRXXGKRFz6QfsbP4gRb2DAOSfs6G349KJ4a1UcIg&oe=6AE49BFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu_9_UA4yqYQ7kNvwEHwFN0&_nc_oc=AdqwDxyQkXWa92PXVfdmfaPLpcoxDEvCSpq6j3k0ggyYkgOM-47iCT0UXiH4o7PGw9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCGpU3jL5v6l-xXB576ljcsw-N8R8Po5beCjzVZzAUKw&oe=6AE4BA49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dc6QpbKQjQQ7kNvwH8T7d-&_nc_oc=Adq7h8JE16DR43nFcmmsRuaWvLqANrpN-a2vTD87-EFSRa_F4zAkRRUdxe-GrPFOP6
t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oOEv1r-Y8IwtIw8HAalSXtuvc-CID09dqyc1eFsMceg&oe=6A3A9CAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paYusnCkIvAQ7kNvwHbzV7_&_nc_oc=Adq2U-SKxAfvCl7Rd_xgvAXELCY8pK1FRXnAa9huPBlIVbUKF6lzkfjBD7Iah5WDrqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d1cElPDPaRmrWxSZASC_KPAb7Iy0ObWDSJzWfr8Bp1w&oe=6A3AB693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vl6EdVwyMkQ7kNvwGwAYHe&_nc_oc=AdqDhHyzwJ2kMR5Y-04pph16r6ZtDJ3zqPHB4_KIZG9UsxzLAtDj6RM9TtDwngVbWS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GeIk2aGkMkl02CkeUIw3VbFIa47UtUUC9U2ltZMrK1g&oe=6A3AB73E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiKUPyu30FAQ7kNvwGcoZib&_nc_oc=AdqbZFEHzlP4kiLf9JOcuQPeYUIiFMVxx6xqaWeUpMpwEyPbwijzh7v1aIcR9PJGRlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F3dGr6HK-4sZLA61_Fmqnmo0N5J8ST1BursV3G5d6EQ&oe=6A3AB98C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yMNFwgXSacQ7kNvwGL9MHL&_nc_oc=AdoDfv8Cg0R8D7TkbToF29ncf3ikzL_6BCl32sEw5PCCPGKQ_08H_8Ky_NJi7b3veY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M9UbPrGSbGKFQS5928fdDgmZbn4I9AkiQZ0XocqzQAA&oe=6A3A8A7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27R-SlVqWskQ7kNvwEEg4s-&_nc_oc=AdrRMWQtvW5bhuNSfMlOtQaFUs4IlTsCCBmOGWrzdv9Qa_xqe7-fdBaK7pjhqXizW9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RPkvW6QfpAAewE3XMEmAjqkd8u0lAygO5H33lmNtjIw&oe=6A3AA8C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-6ahT3xoBgQ7kNvwFWP_kZ&_nc_oc=AdodyE7jhs29k7d0-oJ3sppsBpSSV1AkB_LmyRo__-3Pt0ef1gXpGC9lFwakEdIEwD
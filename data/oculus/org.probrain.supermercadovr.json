t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzPsNEijFgAYMZ7auSN12_b3ijMhdkxtF4OadOhSSY9Q&oe=6AB143AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsx5s6CaxrIQ7kNvwHENwm7&_nc_oc=Ado5ugyVG4Vm4R_S3SX8KSzU-tyzbtF4VO3lG-RK-qXxADhB-NQn0pYXl6P9MrB5YEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO6caTtDLYo6v-3VICww9ioZlrKlpl0uPcskZ4F7rj_g&oe=6AB12553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7QOcaK5wSkQ7kNvwGKtOyO&_nc_oc=AdpRetkxRs8BbBtTY9ElKWcIcX2nEmQYsosTgX6g89es0rM7DsXTXBXRPsHJ7uXVZow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ78wGxM8TRimlytIYwOIE1fC2VqnZdGI8hTrTWbaS8w&oe=6AB125FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6cr6hnW-XoQ7kNvwGlhSI9&_nc_oc=Adq09qBbgpDAjAOFu1oc_vzhVuhRsxR8IxtvHZr2MTDAX3yAma8hULMN8uilW8b0vf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdTNlReLycPCDMaKxel8C6hA6DmtFq1IVWJVtEZfj73A&oe=6AB1284C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkv_WqQ1Y-AQ7kNvwHEyDPz&_nc_oc=AdqN-x38ktJX2dqh_zqZWqGHrm-vtNsk4ucxKCqLK3X_hGjUsfNWlJm6GpdTLFBAS60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4RERSTtxAWmsM4mhNNErp2jfiLIP5gcXEtWd98Wj9pA&oe=6AB1317D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE1dch97frAQ7kNvwEx3ITH&_nc_oc=AdrtEwf4ksAG4PbCEcYmRhP71XMClGHgHWJLMFYlUBHJAmc-2f7WjKspzUtzYyU4WXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8eF7Tx8OlfoQHXQDZS9UIdnQWGKxdr_1o5c2lbPYd4Q&oe=6AB14FC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1gw8ElVn9cQ7kNvwEg-Z1s&_nc_oc=AdqrnRl2WJmYL-saxQQJu5KiYuLgL_sbsNad3HResOG-knaPmXzvsBXxwTZw66mSjU
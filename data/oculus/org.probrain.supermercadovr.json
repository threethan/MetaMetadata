t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkaBov4Barb5XmS-up9xv4meMDXTY0vLLRHl3E1oYoOw&oe=6A60D82C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwjt9s1EecIQ7kNvwHLHtkT&_nc_oc=AdqKgSZdvZVS5XSgzIL7TVvZ2pZn2ki3fUhTKBJGm_2niylXVUAQ65eLyuvMaNmTA-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR_qdrr9uqc6UZTS_txmp6N_Y67KcO5nWRAWY3kgr_sA&oe=6A60B9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCeTbzEnD30Q7kNvwEsMRUN&_nc_oc=AdrIMCAbsY_hLqh86uqQO3Pe4dQph5lieyefQ0huyj6OQ8CYHYVoN48j7X4Rh0ADPH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4VJXOkft1WhBLQTCxBtsm-wpqtgLv0dmdSaOc0Z2NCw&oe=6A60BA7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkvOzRjTAhMQ7kNvwF2DlCc&_nc_oc=Ado0aIIWr04encdU6FzsBfemLHo16z5b9FR1bG6eUyO3yjPBsM2D_xyLpi24mXc3qq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmIef5gI2BnYvPnK2K4y3W1QlZ1yx1J2HBMSQJ-lCbaw&oe=6A60BCCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CLx4nVUdQ4Q7kNvwEIWkXk&_nc_oc=AdrHqu_YmuSyecCpeCKfJgcGey3OpLTHj2yB5_lR9LLwU8jOK0so7wVqR3gv_hj0zHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1nDyV7znSJJJXA38z0kA_Rn3bZnnk2O20P0YDlwTK5A&oe=6A60C5FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGQQwGrBJ-EQ7kNvwEel-7Q&_nc_oc=AdrZG2jZ_j8pzVkNPJ8ZcnFQIH-oLao0NZt5LC8PuzoGJABwL7qIBU_GLcmu2xRrni8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3JdEIkiTmEtrdGIyRl7PWLqa5Np7rsCkRWoGziJExjQ&oe=6A60AC09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBVDWZBpMcIQ7kNvwFROVJp&_nc_oc=AdrLerw7DTa_dyQ4MZGlX1bgkQa1Uv5MQP2jwXtqAeukvRDygLSuaofRsLJPpl9rw9
t-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30BxLUZY1hSKfeM8B21HJAhYvGvJT5SbXIRwBzajxbHg&oe=69DE53AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm8iVgblZ-4Q7kNvwHHvH71&_nc_oc=AdpIJDceEZiVLnojHq-1B60ecJqMzo89cvlupQII8Ti9eLbkeTilKiiChKmsV8N4jDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ImZ0uSi4ZqougLz6lXpUGkR7g7sjxgdGIYOOeuo3JSQ&oe=69DE3553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMZkozHGOHsQ7kNvwEtxmrv&_nc_oc=Adr48taJgr17VRVbW4t58A-Jp0NXRtI__xorJjm858ZVNEe6YoOE19jfgR2P3uRXLzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N6W5BIkymFyQjUQ3KjpPGCpmKnUK_J67YIigPA6LdkA&oe=69DE35FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38JFSbq5x1oQ7kNvwFwTEP3&_nc_oc=Adok36BIhpCXSbtk--b3NH1ByuHl7UZ6wzl9sWGKYQU9mC7AFob7XvCy7mnGNlXgGkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P-8Q-9olWHeAFvROY-FpgUOpSP-n6j2at8ZhG2MC6-A&oe=69DE384C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFXU1AK_CD0Q7kNvwG58Ql3&_nc_oc=Adp4_G-RC1Bk7JQ7T9FkphzFdxISvhb5kz2TP9lu134M8VyvlJh5djjz5C9FCnEYDhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2alK9HvBCogNYx69xfA9R2CvCblHfEYwdQaC8FrL_ykw&oe=69DE417D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8s_HwPzUaUQ7kNvwGNRL5K&_nc_oc=Adq4oCHLzq3UDxtMN_i0XXrfXS7hsJxhUfnqDC5-XjR0k2q4sW5kUvMwI9jwYpSwALM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DFH2VTGVnZGn0aFb4Ef85kCgjNiCTdsWM0MqrtCs4Hw&oe=69DE2789"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uWtbdpN7mQQ7kNvwGk6llh&_nc_oc=AdrLw7vk88Pq4pvK5UP395NXjA3UAsSWtucRCq2b9uUX3w4oqVKb_xu9Tn3N_KcxS9
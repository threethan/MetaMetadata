t-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjPbXkXffysKxmFwtZeLdzxLKo_al6R2dlhGkLCcwg5w&oe=69C5472C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi8mGnEJZDwQ7kNvwFlD7FS&_nc_oc=AdotgfxLB3evOU5qsBw83txkBoI7Stdzjt8-HtJIZL_gBY36pgAEqUAr7ZTx_jiDCZM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaLvVj9cKU_fTK1FrWdI7D0dmeedLYjOOh73Ke8GSlKg&oe=69C528D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl1IPvH5EOkQ7kNvwFjagZr&_nc_oc=AdrZnfGr_6fFwu6QVEKM_6OHmKnercr8jZroQfaaJFbf-aKb2Hq6W6s9WZ1Q88L87Ws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdjznjBePyi_WsxlGYEPox3dxJ-pVLbkSwrv2DxpQFsw&oe=69C5297E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCuBIVS-d-YQ7kNvwG992Zv&_nc_oc=AdrDFlvy48CYZEglM4t8Kc9yfNdD1ODT_xo5okgolz2RurPLnBJmb1Dku19jpw26l3w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoBIQLH9lfpwkvV2r0mweRBo545vUVmVLNqmdjGSc1Tw&oe=69C52BCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5oOLbIwO_cQ7kNvwGxrx_p&_nc_oc=AdqsXCMsdNFj82ZgkCHIps-ZM8--43Wx7lDut5RwFqGPQZTaIcQoYDcYpwtCJHf_I0M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwiy3a7YhxCwn_v320YzzyNzv88M9Zt9sPOIa_kRR22dw&oe=69C534FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_9OjJ6cKBMQ7kNvwFFY_Ad&_nc_oc=AdpackHgfHp2G09MZijLGJA63-XNm_HBb20ZX65jQXArlhra4cXSfXXEFkYujFOowZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyykDWQzXGgysQ-0v2UZ8-LEf4nywtn3nd6w-u_pXI43Q&oe=69C51B09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWjlcD2lQ0kQ7kNvwFlK8um&_nc_oc=AdqHngHtjvnIn1rN3DW8Fn7Mf3aAizyPUT1tzS6b-5jlUCdj8BBuQwu-rBAifYU3rd
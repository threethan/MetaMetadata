t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpciMlHTKb5o-taw9_VU4nDRb4nSAQBB8dkx7G4Zf1Ig&oe=6A4E632C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waP4teRw-n8Q7kNvwFlnseR&_nc_oc=AdofX3oi2yf9bAb66bB8m7jZ01-KEk1PEl4KJnJIZZyrPGf6Pih2K24hSfNqAeouT2A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPaO-5urbRQ7sLR_3Cq3na0kabxJ9c0vqbdtDU64qEXQ&oe=6A4E44D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaIcCcO39ywQ7kNvwGh6Jok&_nc_oc=Ados71pbu7OK4tE6WeB6IV5z0IEBhh6AUQUOvsxqzHSE_nAy27ITYU5BofL11h38hhQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB66PCgFjuuoz91uXnxDmpaJgIDncJSYBkRqsK_Fexx0Q&oe=6A4E457E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qopJlAtuNskQ7kNvwHtf6AC&_nc_oc=AdoT8fEDTQxC_iq2LyhHMyEz_GQ3ykAglXi7ftHzhSKdbqPCl3Hdqr1fLIEEK0XSxlk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZXP92i9eV4RmSKIf3_HHMsStbeSDL9YlVupl2unkHbQ&oe=6A4E47CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR2ap7RAZAoQ7kNvwE3XLYS&_nc_oc=AdpnGtFj_TGmJgZ9qGKnw_e6yWiuhk_90IR_Bl52j8iwQv6LVunN3rmJgW4Uj7NPk5I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGHCc72Zzpzy3_HX-55RRPqZO7hEm4ccW50nsdhjFbyg&oe=6A4E50FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrRhGLAY5lUQ7kNvwETHA3P&_nc_oc=AdpKBX14zldpYGxEuO1j4uljrtrgbkGg18r12eBfssbgi85K2CeaUvshPfKMMif4B3w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqcJRhO1icwlINC3q_098LujaklFiCaRkcM6s3dyoZFw&oe=6A4E3709"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bomd4q8378Q7kNvwHx68vE&_nc_oc=Adoj-svzq-QW5jNHduKFBCG2nljOMWsb8pEKh2s02HCJQIttXzl2cf-NeOxqk6ReUh
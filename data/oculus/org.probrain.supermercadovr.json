t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nA4U7D3_Z1gRQNyrE5aUjQp0MNBD8I3a9WEPl-EOIKg&oe=69FF492C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73OAGwLOiKAQ7kNvwFb0ZFR&_nc_oc=Adq1RheppmZWUXF-sLWygcD-ZHrEdG0IX80FT3jFboN9XYkiS_9ED3gauN6HaLsTVQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rR5twxmXv4n-8xQGU7aqcK77lemJKy3vZNMeEVTaf4A&oe=69FF2AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k90TLMvFZMwQ7kNvwGrJPRm&_nc_oc=AdpAeR2oOlrcQqLJ_VKMkfGdoEEbFyHAnwd1ItTxB9dgtTUH1RKWAhmA6LcFrzJEPMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y-7pjFn0E7cLDMEzt6529T-chrxCcI797IiYY31FLEQ&oe=69FF2B7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKdHEHo5tfEQ7kNvwH07KRv&_nc_oc=AdoYvaQRs-sFuh9515rq6vVavxGrjVj1AXdfcTW69JHBBhwt-VBGJb7kdhR-Qjw-6ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WyQ7yQr934MtheddGI8I9RJbO14NiK3pkM6vkNihaBw&oe=69FF2DCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkxY3XcSycIQ7kNvwEjAo8K&_nc_oc=Adp56BK7TaU1R5kEGSOhwu1lLhh_NN_mTBiW09wYiQQW7OZoDQA0dTA-5NjiqozX3gQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vRnk_T_WBWd0r1uWIwP-jspIJUtUATbwQXTANiTeS2w&oe=69FF36FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLSVRN-KtzMQ7kNvwFfw0_f&_nc_oc=AdreU_kMSC_v1bGDaoODjdrsj45WBEGndg1BZ1scE3M9eWRGl_T5HSma4z8LlKKDLIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dhvCqWEzeRXQteo-AeeeQEw5OKsfwHqH-EhKAUgsA_w&oe=69FF1D09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xwJmtyoni8Q7kNvwG_YEXJ&_nc_oc=AdpfrtfI3-P0ZtgFBV5CXJkRbYyxk2Dzx3Mx_C7gYim19R17sDQSfMxmc8lnQl_QkL
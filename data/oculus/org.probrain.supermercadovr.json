t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rW5xaGCSE9wNxAdmagMwJvNpIj2sQOrOPiGSt30P1lQ&oe=69E4EB2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyzae09-acsQ7kNvwF_9Xfw&_nc_oc=Ado7Iu9YkmOZo3Vt-_8nPRN9bgJUPatF1kIfpiZQpBzGe-2zG5Q7MgrwVZ1krMDuisU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KztJTwswRxTdGXSoS9AWRXgbMPijxduMG5ltxOBcD3g&oe=69E4CCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuXlxFYpIMUQ7kNvwFBZEKr&_nc_oc=Adpj0a9hjNCwViMKmpkBzr3-L76zNvWow9kBeVVWgK2-c6UlChx1JDJZA2MsQSKe3lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2URkveCHwPlckp-B8o8dP240HM1dcPvJcoIw8771OLBQ&oe=69E4CD7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n84QossicbAQ7kNvwGSNshh&_nc_oc=Adqv8TiNU34dh5o9xXceOa364XDIMLz787Eh1ZGZqkT_mRHriVu-XA3dPR7tzlW6wjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_xz0nhqekP0Brf9LUzTXxqeeGTYyisbNd3JDcoDgRWg&oe=69E4CFCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdAU1R_rJ8Q7kNvwE6bPHT&_nc_oc=AdozpOWCVyfxCwIlRU71t-Eyyx_qro6DXx8dchoW7mxbgQW2SDpqyU_01SoHCKVYZ7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oOddRdJIMSaGFM4_SaEk7tCjIr6RuRzNEktSOVQnqeA&oe=69E4D8FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xat61WGp4DEQ7kNvwFPwzs0&_nc_oc=Adqrf9x1tt0o64RBM-ig2l1NL8nrjgH77LawwQCD7EnhvnvPadJD5D9QKqnSgbZzlxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p2FZfBKNcBGb6IINzBoRvuol-xL5Zy2U7yKWbQP9PAQ&oe=69E4BF09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr4H0dBvdfAQ7kNvwE5G_tb&_nc_oc=Adq1JNGZ3NRdMJ7cTRxZKPc_eI6XDVYbppUNnkOtoU4p9qFwHzV8kxhuZiKs0znmLz
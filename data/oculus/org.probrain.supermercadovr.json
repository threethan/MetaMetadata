t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzBjSxfjIhhmhL5b8cJFRBTlTSRSqxDTCtoaM1AIDusg&oe=6AB92CAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwvV4tfHsSkQ7kNvwETCmol&_nc_oc=AdqrksPNV9as2LJtGqjQLtXR1w00kAdCO_IELgKDVWbV23vFHRX0JhJJkAl_S2Z5eYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLChZqQEqvsS2IckdxNrnrfvx01odlsB7bqWYeRG5P5xQ&oe=6AB90E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80SBmG28X4Q7kNvwE4lt7g&_nc_oc=AdrAVOkYjhAC0obsXykg2HNUo72z_E5pKQVmkTRl_pSYjc8sD7pkp3x7nW3sbx1KImE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnJfYU3vZPDSu5kVDrOW-UZruk6uLiaMkvBNzK3X52lw&oe=6AB90EFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOR0FGNBMIUQ7kNvwHA9INw&_nc_oc=AdrfvhfSxTdJrAieRXQoYjnCinpk-dRmX_0Ht2GpGYvscyQenPDOTuu0-zZdZRCdSvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3H_6qxyf6Bl_khoG7i_NtJl2rGGFXeurKtoH3qFCrXA&oe=6AB9114C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6KUdXFOaS0Q7kNvwFRAA_b&_nc_oc=AdqZVk9bTLlGdxEmYY5FRSP89FJ-dNlcfNikjLK3XsX3n8Z0KN_biTO9-SvHFFpCPZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPALanypbA1gMRyp3s6pCYKVEi_CH00-t2QRf5gk4CRg&oe=6AB91A7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxkM_uc4c9AQ7kNvwHnKt0c&_nc_oc=Ado4XS2BSBBdZAa_BJ6B85lR9TwhyzVjSOor333wgkyYS6fsDCYz21rgfq5pRMbGdXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfR38DmQ8X49gfL0ReFbHFSjqX-drpWHTvJx6rP43JOA&oe=6AB938C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as54nrgFLkEQ7kNvwE8_qR2&_nc_oc=AdpCBc7TUErcQ7nA1EwDnbXsc2qnvMqpAOYTq44fvyHtHtEimPlXXqrmr6LRjHlN4H
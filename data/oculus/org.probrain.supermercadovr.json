893955", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7-Xgvaai1oQ7kNvwHrEU32&_nc_oc=AdkhVJ91vgaTImIiFhh4D60HgIU-_WtRtdn-Y8ghy1ePjv9jkwpv5zjagWzpEbolF-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuFJQKnehmwUwIS4-MU1qKJZKcGStz85uP2HtBlSNSgOQ&oe=699EE408"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inNvfdEXlWYQ7kNvwGvv51j&_nc_oc=AdljXa6k7KIi_rxEqgISD7-3nFWBfdK06TR7vNv1ZWx_Sdy7nCor7yrwryomIV-P6G4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvxzmnC1s9S3WIQs63erDQ-fLJFr8TWlDIN6rPvAZthzA&oe=699ED509"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6ACXh62MrYQ7kNvwHVY8ci&_nc_oc=Adl1sqoHBgbHaW-LES9ERixnZevnFOua7mAeZQyDBvG8VgxolCTadJ69MFaRn48o0zQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXuzTBOFXbJrMpGsWn9Behw4o9CwkDpQP8Fr9nsAdBew&oe=699ED36C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gFfcuWsFjAQ7kNvwE3pt39&_nc_oc=AdmkpWwDJJWt0B4_J2oJy9AsW18-OMipITKBJBwPk1vaOBZbf_7zsvgQCKePxMMrelQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZ0PtloWPjMDPqNyVL4hca9Oncf5C1Dbjq5taN2aRteA&oe=699EED53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6IRjtO3cQ0Q7kNvwGZrG62&_nc_oc=AdmV-OnihGOnn6enImQt_iytMyk9oFuFpxzaynQawc0JE1y-l25Zcxr5kao8m53hJyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsEmR3_aLrHDxy9u8fDHSctuGg6UZ-r7i-WrogujcxCoA&oe=699EEDFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upHTDxYP8soQ7kNvwFFbpf3&_nc_oc=Adl1NgTODAVg6sFhHq-eV4K0TvLZgxdJpY_Fh9wNAV2ZXF0ceez9SYbCYWi6k4ofNOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvhMApWezDRsTWcYuysbO62hZ-HWow8dlR1EXGmaGEe3g&oe=699EF04C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
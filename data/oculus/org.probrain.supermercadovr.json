t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6g9qsScxgU_G359eSy1a0uavj2XRKoVHQ8gTSMG2KWQ&oe=6A9015EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzaCj7MTIwYQ7kNvwFUbiUR&_nc_oc=Adq9p1b6lb2ZHigj8ivg7ZD5PtLPM5-e2QPsopk0Xllv3iPqSGQtORyLEhzd-oIk27s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFnLNk5iXdLrB_JSkEbhf-aNTbJi-Z4dlL1xAG5jX5Ow&oe=6A902FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpXjx7YqdXYQ7kNvwFZ9hW2&_nc_oc=AdqY_diTG-i1VNSTw4oe5FUNAHWkvxu93CylqHGBfQAlt8YrO7kTD3sR0eROZpOT8cs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbJfj4eQNvrNiprnOz07oBe9A8YDb1J4x87eXfI0euZQ&oe=6A90307E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEO_9_uE1iEQ7kNvwFHFFht&_nc_oc=AdqYvZmtAo36n7p0ZFvh4OssNkeHPPEUtWWcynSHqPVcEOohZIOI4cx5CRV2Sk6Ikuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkLfKKMwwo2jJrrs5T9yOamxykaLiwBy_dJk1AhT4TTA&oe=6A9032CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKGMzthf3lMQ7kNvwG7lVyh&_nc_oc=AdpO0IOjiapWBR6psI588E2jqcYJ6xY0avKi4tJiDzZPzbcVOzJcC47g4hEyv6GxJ24&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx1XhiB2wFABQgVx4G-Lkz-iMKXVQ_-okG1V2Y8DA0LQ&oe=6A903BFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFUBb8-OpPQQ7kNvwEcz6Gq&_nc_oc=AdpJc0aFIKnXfFPS6VV7dMLxvLonRR3G3CJvjN9aQF-TmVYwCAw5sLCR88XacrRx5R0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHro0An5UlsZNDuYLZ-qUVVI1CV4MWv6X3XFjiVdmXaDQ&oe=6A902209"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K437pgrR9aUQ7kNvwGztp7E&_nc_oc=Adpx0jb2nA-8x-kRpQBppI7Ybyc9gsJag1sdCjaZddOPmjOwSiR1faR6gMgS9GWw-J
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UdpXWtyQwTv-Wb1XeWwHt9Eyif2jTT9lpWzisovKY1g&oe=6A009AAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73OAGwLOiKAQ7kNvwGQr4k2&_nc_oc=Adoz-cP6ebwuF1DT3t9ZF5-PzHq-rfVl8fW-ojlxXXNz72kmqdZIF-10KydcGXHfbaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c1cTils9_vFC0_1rVf-pUsZuG2ScoTOMVZgAZpYKSmw&oe=6A007C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k90TLMvFZMwQ7kNvwFtWy37&_nc_oc=AdpU76Q6gndm80suHXybvdwTWoog0QS-w3Znb3Xyj-9q2UszLrqNxQxSvOGrjtSsoWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j2X1Hm-qtfNYtZ9DmoYAILKfLFjCTzxJYP3p-7hfHXg&oe=6A007CFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlH8Zn0kuscQ7kNvwFhZorn&_nc_oc=Adr3ms8YnYFNL2_kIo-ceSLShh0tqAtkKdjPLeMEWVgBu4QEnYVeqMYpTEroaFzDtpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af465DrfGA09aK2qY1zCozQxBqoQRJnGcCGJQKO2ssTRnQ&oe=6A007F4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plFhqRukBI0Q7kNvwGsmHB0&_nc_oc=Adr1JNC4v0iqz8RT5uMDuCWtnBOLd6ruglok4DkxdWAUxhUvKZ0-b2wD-59rVGfOQX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dXtP-OtR2RqYUt1OvjtF7mwT_kTyIHq-YeA7Ak-GfXg&oe=6A00887D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLSVRN-KtzMQ7kNvwFFygXg&_nc_oc=Ado8Vn-jxioGGFPMCqLMPSmslt5WB3g1wl_7rfoG_E3yH5boi0ZTw9q4axPGE5xlfKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48y6-r3q-0Z48CbCvbn3pWiPTtFLv5NXN3q7GSHej6Sg&oe=6A006E89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xwJmtyoni8Q7kNvwFpkruG&_nc_oc=AdrYaTgoA9naTahOV8M9-TgBE_AXZL_L10ufVCCvW9QNKXMlyZRDZ5bDb2nmylPtP5
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sn6AIvTnQFZanG2ky2y-2o3dYg6fm5W2hR_7dYMIT2g&oe=6A0DC9AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7W0N-MHVG0Q7kNvwEurhv4&_nc_oc=Adp_yYeZYNaf6WGzRwyX-kEIEEIK3bOpzAS8vZVAViSHwXO3PiAg_6pvUNxK1yNk7Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ydav5T6wKc4t13fp27GM5RCxKcBj5Xip6s9laFs0PmA&oe=6A0DAB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxE1Zb8sfsoQ7kNvwF6svKF&_nc_oc=Ado3LYArxrFkwoKBfapR0RN2NlanFMdVfAFkFthdNXPEXamK1bISUHEuryEmQKxYzBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KqVCtnA27669vyPfxRrdh9tpXf_5gkHdk7OEHa2hhyg&oe=6A0DABFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odJk_uGnYYQ7kNvwFYEJzn&_nc_oc=AdrVA3AydtyxD4Qlj1cFAmjLzm6RDpbDLw1DNNliPy6IMYLkdK_IFNHoridK1TWc408&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43StUsv4bz6MN8nntIFtiGmsg0cjXdUMGn5TnCIQS8fA&oe=6A0DAE4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcx9g2QKCzMQ7kNvwH0uwvC&_nc_oc=Adoi4gHIoneFUPnqG5m1ar8ziLG6-6SgD3LtjafTYFsBaWm7pcQUTMzjsw14HiUHJk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79zuKIL0VpH4iUUU-7YLVix2yzv5yc7whp8Inm95iBzQ&oe=6A0DB77D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uICekZkCUMQ7kNvwEDZZpz&_nc_oc=AdoKP3JwEUHfjedx894mWb3PsPbGvIEz-71vUTxfOeEw73ak_ITkg2jQpONlqYAhtlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MUeK_028n_3rrRVqjcpU2_kAa2zkllgLl9Q0zuNGMAg&oe=6A0DD5C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpT2DzXsVdMQ7kNvwEr_CO1&_nc_oc=AdoYxqvtZNZx_d6yr2AXArnQaoLTZM9RqMMFJh5riJOKejMPsnwKvdjCAehJoA7GJU
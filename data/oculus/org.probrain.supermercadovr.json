t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RJ7bdjHw9CIX6XW-1iLCWfTY41xVsioYu6gpygx12JQ&oe=6A3010AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrrEugcaeJIQ7kNvwGaQ0FC&_nc_oc=AdoT2Set8LCs7Gl1tPAU0HPd3kKYtIlMHmMzUGRDQbpcqeIZdMpDOUosWLd05rcsOLg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89xzvPmynzUsjx6R5qyOpoWPQSWaOJTxuc2StK0LhAdw&oe=6A2FF253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EElOEeULB-QQ7kNvwFPfLSV&_nc_oc=AdpQFP4yi6pRkr7zX-mDW1_hQ5a-H0wmsjcM2ii0RQy9h64PFANX0OYgKYgX9Z_6LpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lt18N9bGSs2oScBhiv2apbdTV3PGvsWAz8nRPNxWNVw&oe=6A2FF2FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjG4QQPn1ukQ7kNvwEqgLe6&_nc_oc=Adp7o-ivnvju1Ad52-MhBdxF7h6fjux555U6PsvBFexTV7TXc_jzDwy_QBkJ9BS7cEA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VMAalCMPtEL7j-ZIEKfWTaSZ62X8cOVEQYDvU3aaY-w&oe=6A2FF54C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-LPssD4GIQQ7kNvwE_NIPD&_nc_oc=AdqUDGatTC4u_NvXWlfQNviNBb8d2YAV_XZLcLCMMhHFgEJWm_27NLzZ-kzCzqEMx9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EJVYNPCaFmn8DHOi1chq75U0BUbWeuHSjR0B642ltqw&oe=6A2FFE7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZmswbZ1xhMQ7kNvwHiuKpX&_nc_oc=AdrbTuIIV19MDknmRrRDGlT1qG6HbGBjNzpTIEGvrEyXv8mONwZqJKzyM4Qjos2cvJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kuZ_FIiKlezV97Bqg7868hOO7prw_sfdG9Cd30Rd5zw&oe=6A301CC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ7HVIKmogoQ7kNvwF-8fUz&_nc_oc=AdoRKDK_K3ecnYmf1RnOZ0aaChWgfbskQ3fiGrpHxYRzQZGVPKHUtIlJht6ZoDDi7a
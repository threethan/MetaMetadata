t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLHxH65-P9giHZdu76jry4QS1BNswbssiazjZsIX20cQ&oe=6ADCC52C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5De5RBEDEYQ7kNvwEtlsb-&_nc_oc=AdpzENtkX7fz6sDanwgXJb0zx10wZQNKkl-dK7ZNRbfaAxa9_bukMc3m4PjiKWN5TeE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMv7ITDdheX4-wlU5NXC1wdG4hD9Jbx8H0X0656See8A&oe=6ADCA6D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRmZEnoWbecQ7kNvwFQEn9Y&_nc_oc=Adp5dJQanbeMzEa05-jQbMkhM3EgN6hhxdkVgRN5MZF1qSwpPQMBw-kUROA01Vqwrb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU5QnS0FhhcN1FXSnIxX9teb8kjAN6JI2jxr6aJVellg&oe=6ADCA77E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHuDpHckJekQ7kNvwH5WOik&_nc_oc=Ado6gkvXRCJjj-7ELQP1pr18aF_okAx6SykOqVtHcWIw9NYRFlOyE6aTpKnT_VnsLUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNb2LcBKUwwek82y9qI0Ne05Bhj2BhrhO_N9Y44shgvg&oe=6ADCA9CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTxrrCbB83AQ7kNvwHTnRnh&_nc_oc=AdpMF51mRNjDSt0f91y2PKKkxdWJHf4tVOKJuH5EKUHwFt9w0G-PYHQGF-wrqqRDBYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5jjWq64rsMNqcsHQb7-9LEJwabX5XF7Uq4SASXZJrbQ&oe=6ADCB2FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD9BEKUIrcIQ7kNvwGzp4WG&_nc_oc=Adpk16JcafxAKtjQnkvTZWM1drDS7RPZMMBWOMW9tZT_4dgxGelNa9lAxAKoNOkxgho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsEEpIXO5_U2m2F5CwEAdiMHuyWE4fOUSldWAVElOokw&oe=6ADCD149"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq5MJ43kWXMQ7kNvwHeONk0&_nc_oc=AdqWFuzCgIRxHAGUM5FcIJLPevqODxrUrXUo9S7thzKWpBNIp-1UN9l8EVJaEH0l8T
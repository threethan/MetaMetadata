t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToVWUPpFAWl8RVoToTy84lFu-6Dgc3Ls7HMecS8DEucA&oe=6AF32EAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sM4MglFnwUQ7kNvwEiPPx_&_nc_oc=Adr6hCSnLG5CuiVe9-nL0fad5O_YihVSoTY1cjFpyZ6dIHs3Hs-eBz4LtNPnMtLU3yk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqhd8mg0S3XNg7kmKdbq1s3s19iy8hQ0EGkhlX0Yd31A&oe=6AF34893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynaZn_fmoEsQ7kNvwGyDxnb&_nc_oc=Adoz4ZAyLsMqTyKQ1iIkSnB5KCLJWD2tGv7VGVSoerdP9I2kC42e0L2ffgsxTTTSA_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCIKr_70DJNrFVhfoEJ_XiqyZOK0MROZVI-JV_sC4t_w&oe=6AF3493E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd2ZqywJdTsQ7kNvwG_uaRm&_nc_oc=Adr_m9XBtM7YLTXUUSUlSwbfSvzCSSNoEtZmQX0kbw0tXvI6py8D-Wa_PrEwvsl4jFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC9zocrLUyoL7bj5GAMJ9tIJE2FqOH3Recyr44DzrOCw&oe=6AF34B8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPKsyjwNvKcQ7kNvwGUBUSU&_nc_oc=AdrQPSSEWtunsUBv5KoJA6MXWXGuE1R3PrajEeDV0fFu7X3j2cPGjU0gGisixj-rwrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_C6rJn7dI91yyVhBtsqJVlLUKps9i4oExqw7-Ke_kQ&oe=6AF354BD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umToO2hPhhgQ7kNvwEKfEGS&_nc_oc=AdqlYXAUy0l4rRFP2UGxky9TrbJEtUvdVZQf3USY5pDfnot_IUa13Tar51vGI3pmidM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk2XRn2qwSQ6TmUTEIda9hLdPn1oeZHpIYxGlnv8AQ9A&oe=6AF33AC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i27C5ZjIGsEQ7kNvwHW8oy_&_nc_oc=Adqxf7bWyy_IHzQtIY-bG5YxhBps4LCANSdSMVW2qQYCCbdWLrjaANK9jpR3aLEYHs
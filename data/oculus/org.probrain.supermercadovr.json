t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMRxu6V6CMsdncG5lHZesU3BZFHy9-ALnBRyIuu_Q5Hw&oe=6A9D7D2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BiNSLMsI0Q7kNvwFczEYF&_nc_oc=AdpmuHnW188i9Jo0_QQzyeKhpijzExrGrnuWnTebEY6eU4NmaqIz-bamqmm-70VPHx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3p5NnoT5-tJHQ9nrBeiH2vmNdB0LbtntQNUlE7EL96A&oe=6A9D5ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WPk--cXVKcQ7kNvwF9Y-yS&_nc_oc=Adr41Xk17GVJ3jVbim0c8NfsLLuCy951aFgIsnnu2ZXSy544DNZ6OIbe_wFleUJUZ_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp79x42YH7PEQldaOTet7BaTzKrjgDVxYVk0AyKYXLoQ&oe=6A9D5F7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08uQgPKk4lEQ7kNvwGHYeeg&_nc_oc=Adpntl45k-qd4buta_t0vH_rc4EwMkDFg5OLuKkqK90fXbXlxdkRL-3JqSp-AevwevQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI20qkFt6bl7yN2-uvT178yA3CxJuSv9c-Nc1QC0rEhVw&oe=6A9D61CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtYVivOzvfcQ7kNvwFgrOEj&_nc_oc=AdokXeh-hSVxiueCpQMH0QEYx8sOgwmrNVLUisWhCHBLBw-z_FWVR-bK_y6k39JWmGw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBJx78HgPEQDWzWeEQCY1FfjtNTCWRnKpY4C_kQ0tE4w&oe=6A9D6AFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPjYJacK11IQ7kNvwE6Evji&_nc_oc=Adp2q6XGuHIgZdw9Kre4FPZq7YWUJd9Ni_qFBw2da7xZ8KfS2gg3RnPz1ZZhOQeoRf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiXuI9Cbv4T9ZYgTraOz1qUET566gnbm1DYso2eX8mGw&oe=6A9D8949"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj1uJeOQySQQ7kNvwEGb0l0&_nc_oc=Adp9aBi1DmbFW1TdcSg7YHBPowDwk-epCMEfVpMFXuclvKDRRqWVMqbKQs9lmevB31
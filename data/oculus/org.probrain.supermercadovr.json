t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ja458sSnf7btuG3D5yN2aSZMOJ6KVnhkRRa1d4L7uag&oe=6A3FE2AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coNHZ32aUdQQ7kNvwHmeQgD&_nc_oc=AdozJTEeKlPDGrH46Og3-WE33PwXkxxLqIjpzAOXsdxEANXyl5fOAlU3zaGjAxmIP68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z_1WYBB8ppPfjWCN5dyOg-Uq030Xk182td5WCtNOq6g&oe=6A3FC453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n6GLz6eG24Q7kNvwHGsQYu&_nc_oc=AdoeNxLJvJy_x54EG-6EQGNqlvvNoclrXKR1QzhL0Pu0W0nBgUO_chHLWxoqtOkuxz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H_G2HpinqM73CHhTwFZBeeQJL9UbytDhQLaTLEwrE6A&oe=6A3FC4FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaERTAj_i8EQ7kNvwHJuGWJ&_nc_oc=AdrdaeyZwsi07XBPokWnuyd1gTlZ4nYQc86_7xq6fnj-5HgI2pod4PBdQgf3zEbmW-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hbnkHgbaIYl_yZj75feG3p3ZF8QPNJJ_IDmwSuMFkew&oe=6A3FC74C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7NhwfX0r_AQ7kNvwH4K0_Q&_nc_oc=AdpXtb3IPs7HPK0OwaaFTRkf8WyQtHTUsbhi5LijObNSANEzjmwLiFxfiO8eNDrDKiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97RjPda_6qVgcfOH8dLRbCco0PMzCRVXlGHAYtZXi-zA&oe=6A3FD07D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GllGGYumBvcQ7kNvwFk3uWm&_nc_oc=Adp4Y2_oeYU4OBBr5TH46Kd5zCY1Q8ilzFiSq0R8vbBogga9ADDpvE4sy_LUv3uyPhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QuIwam-GmIruFaAs4xkYQFdFjAyFnYOWmq_zBwkHzZg&oe=6A3FEEC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAOtb-q_y10Q7kNvwHegFY6&_nc_oc=Adr40nnVoswdT5gTd0N1BIlbDU807nzfK-8eUTnMJ09dXHIY_JgmvyDo5dilK1c-LD
t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdGh_7wDP8yHZXjFtSOUbcss4Cs0jnipBbFyImajrf7Q&oe=6A6E072C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amXWXgBRLWwQ7kNvwFwxOm9&_nc_oc=AdpWcRe26bcPZpxZeQaV_j4nFu3EAt2CgyDAGpz3diWrKEF2yEVCNOLHfVDLGFpDUmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASViXcUKV24QQ7kT9u_ivWRDrARQtrq40isZjWWwlF2Q&oe=6A6DE8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q6A2DBjUuIQ7kNvwEY0Aqw&_nc_oc=Adq9pUa51I7KfX_NptAghI4Q_Q_JADRmUk843zTd1QQ2hf65ReyW3GikUdM7-bXtd-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDazDVA8VMF7a830hBOKPGtznpbDyJslaEAxIngsMUgDw&oe=6A6DE97E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alVsT0Wymr0Q7kNvwHkpedO&_nc_oc=AdokFaCNHnn-aD7oKZuKofjCnDMBsrYLv1NP4zRc00cbNYaQviqd8LewsE_-mjq7McU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-jn0XGC3aZh6Uv8cE4Zv-OzKVx0MghlpH5BsjXPEkww&oe=6A6DEBCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYEjRLWw29MQ7kNvwHlJWtT&_nc_oc=AdoRJEP3PQUVH5SS9HUE1kg6LJ7zvPRYV2GPc1qZyz4YWxYmUVf-sWw6LYg6aeJpAjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWcZWZS8tMYGpwaU8AGBMWCn5s6Nqgm5BGJ3_e3aqh5g&oe=6A6DF4FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u3T6NqScbsQ7kNvwFhb1C1&_nc_oc=AdpNdsi8WWo30WpssFJVOK-aHWaUb-Owl056uzarx7H6MKU9kUaHJ9ZsMzS52ypqmrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdqCT2eeYSN_eP-lgbeWwi4OeBg2bo6o2eWNC1Rdk_2Q&oe=6A6DDB09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fquhqRB4gIEQ7kNvwHJkPFN&_nc_oc=AdpJHvPSnoODcRTRSej_NJbruxJmSuxLRQTEZkEDlqmhIEQjVQA6hMpbGAIRnsn2mA
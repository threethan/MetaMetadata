t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJfKm38V6s1bX2JN5fgFOhuEJ9tvtkVTAVJBb3q-15LA&oe=6AA8092C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLIZxtosuP4Q7kNvwEmM6NZ&_nc_oc=AdrKp4whCI_VtFkufRfMxua2R1a2MPBYYPriDRwtpgcimEuHrV_tJFhK6BeuG7HcuaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd6CKxd2K5nKXukC8NdIQM2lwnIqTqxTKmsL974_Ss0A&oe=6AA7EAD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3SuBxePFesQ7kNvwE5ueph&_nc_oc=AdqcJsnCC9AjUb0OwBfc-V5EzJ29ZxwzWb3eCldjd07JW0NnpmUNlBkv7LPGkR2PBHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLir4OA2RyB4tDmEI4oqYW-veQnyhF5cV0rpyIp9beBqQ&oe=6AA7EB7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQXvOZoR9qsQ7kNvwGMKkhy&_nc_oc=Adr3zJN_3FrVG_igjRbZoGA59bjETYlnySl4xGZQf58OhSltycXRj0QgmnCpvgGIt0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzuRfsRLAPC4KLJZrRzaXcAG4m7N8dhADQwuj23Fr0EA&oe=6AA7EDCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcgbsUmGAUsQ7kNvwGBkU7w&_nc_oc=AdodYx_yKy3vKM5aLx5hqKiQiVveKIdWv7UwCWAl-KxEEoMihEYiqKaN8voGZR2Ch68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj0-iRp9yVRRukrfHck5WK-jsUdynPfDzL7i0EfhaFPg&oe=6AA7F6FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5uxKznRmHcQ7kNvwHqjN8j&_nc_oc=Adrv9i__mWR3-Rqboc4FkUfsLWtCEoTY8kHJinXeY5jOPjenGrPmVMKy4o3I3f5Jk2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDG82N7l_U1sX8IZJuGxufrKuIDCWWViTDlpGN9isUAg&oe=6AA81549"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnM55M0bmtIQ7kNvwEv3swo&_nc_oc=AdrRIAFDz2e1sYsZWOsSwvQsPJJglTG-sczCjV4Eseq6-xs__2gB9KKCfs4cQSZThW
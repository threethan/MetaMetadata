5/39031430_822755342681989_6547546103932091171_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUXRCC6xW-EQ7kNvwFUy-V-&_nc_oc=AdkbVUAlhzRpniJrgds2LGlenBg743c5VOl3ny4hZo7QZ6rc0q8qzaQvLhPhxxgCnzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-2mS-KQi-OE8PBqvrvLUNkhhbwWM8BZQbAAKEXuRO4w&oe=69A6DCA0"}, {"file_name": "screenshot_4.png", "id": "332652799210032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_332652802543365_2480158436641273391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_4ggkkQhz4Q7kNvwGiZ_Vj&_nc_oc=AdmCcUG3aO26ykVc2awTDvNAYvGcIlM3DfMUHEJcz1tDc4dI1iyuwV-OqccVIqiVElk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswI0Ge9x4HWGnW1H0_yYlqCWFC37VIDO7p4I6ZlqroUA&oe=69A6E195"}, {"file_name": "screenshot_5.png", "id": "699474982224730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_699474985558063_3453974348672181496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcWbGJHk1BAQ7kNvwFp9-NQ&_nc_oc=AdndIl-KhT7YUf0dg52c8S9hPpodMmEMQRdDzVLIiGWxk-082ME02aVtCeGo8VcKt4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmMzPm6rw_2Mc5UxqhHy3RdFvDcb661bgxChjR7rnbyA&oe=69A6BAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "3483732985208245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_3483732988541578_4502993567047372991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-1OPKX9ljYQ7kNvwHZQ9pI&_nc_oc=Adm0RKWPZ7cvSNAfKWz7JDSZV94B86bbnadBDcxProDQiCQy9dRMm6Ih9FmyGIM78As&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumS4m2TvsMJ8KLa_rMMprrhdM9-BpywT29d-8N1X2OHw&oe=69A6E76A"}, "display_name": "Supermarket VR", "keywords": [], "long_description": "Welcome to Supermarket VR, the supermarket of the future! In this immersive VR experience, you'll travel to a space station where you can shop for groceries.\n\nSupermarket VR is a fun and challenging way to train your cognitive skills in a virtual reality environment. It's perfect for those who want to improve their auditory memory, auditory-visual association and listening in challenging situations, such as understanding speech with distorted sounds or with competitive noises in the environment (auditory closure and auditory figure-ground discrimination).\n\nThis game is designed to be challenging but fun, and it's perfect for players of all ages.", "short_description": "Supermarket VR is a game that transports you to a supermarket on a space station. Train your cognitive skills by memorizing the names of the products on the list, and identifying sounds in a noisy environment. Fun and challenging for players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/policies_eng.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564857710296707"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "986659505945754"}]}, "baseline_offer": {"id": "986659505945754"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1695405981, "status": "PUBLISHED", "id": "986659505945754"}]}, "liveChannel": {
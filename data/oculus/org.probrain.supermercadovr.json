893955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4NBmGGTy4Q7kNvwFw62Hq&_nc_oc=AdlDCArAV-SsYFGR2HETVKhe8lgVkPGjYiaTW72lSKjXC6749rxQv6ATsWB14DLx1n4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuhq34uVgrf-vV7d50vfhvyU8eLD_dlmVEGQsq0jg1X4w&oe=69984C88"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM0CPFHUMX8Q7kNvwFv1kCL&_nc_oc=AdnD3jmSH1Ai8UhGaEDt6sbaZOTzsL5KcyHmjctcaaUOFxRNSIazShKkJBaoJyiPmJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftyJ1sDJ2rvSsMousmjB1UXQcrjgnD0OQhyGfblFRnI7Q&oe=69983D89"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOAmxKYbk7YQ7kNvwFjSjFp&_nc_oc=AdmZlc-lfPDvgdAvyUxqhdfP7wlI7_clVLSmUM5Ltm7fZSJq22wLexAabtXoEZhOQqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftCuBtaK2_N679ULK6SAQVyijIlAPZNx9hzOmUFKsvoNg&oe=69983BEC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtvsRclR3WwQ7kNvwEvLpGM&_nc_oc=Adm0_LdRe3Gn9ysdVWhxONvRAIhlUH_A1ETGhLJpMQtEqc4-womppKY5T_jKXuvQmPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftQPzDycEb1Ljo7J73OCR1s4uQWoKeWdnUR5oIy3sQOsg&oe=699855D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAXInP29neQQ7kNvwFsz5sj&_nc_oc=Adnu4pDM6psnQVZSM6s_u0m3z1XRTVDx3IEAx7bgYpSYj8DL-X4i7JqPpplElBmD1ZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvL8glFjXh9CwtA_8ISNN-YCdL8o5LFDQZWMUawAU6adw&oe=6998567E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm0aryxXnfUQ7kNvwGSSmWz&_nc_oc=AdnXdDWJHzpswQfe6Q3cTphcsilCYmyOI05VQ4KVCWKWEo-URxknfB3hqGssT9YuNUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfteFfVZKm25IaUjfo0aJEkodeKW46_WY_TppTxOfbx09g&oe=699858CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
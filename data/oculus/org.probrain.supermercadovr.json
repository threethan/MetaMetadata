t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cu811lig2nzU5u8t5gZC-VxydsdlHlX_i-V8MPqTpNg&oe=6A3D3FAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paYusnCkIvAQ7kNvwHB3vCd&_nc_oc=AdoMuOr4YDm_ZPxanZrSkMKXcL2HeXqFPW7KWdG9ODa43CDZfdivWO8YLAjf93AbbXU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96AtZUNold6J7D_pxdxjZS31Sq-ubYZCed3AWa0X0Oag&oe=6A3D5993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vl6EdVwyMkQ7kNvwHQZAeP&_nc_oc=AdoABSrksvIKqu5auZitfX7RoWUmb-v2gr9EKGNVw38pGMWGJQeAYuldn1umB5Mu2Xw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vbQITbJECiRbUfHSX8aj4-8z9pff4J7vHbMwrKcbKUA&oe=6A3D5A3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiKUPyu30FAQ7kNvwE4xTGd&_nc_oc=AdrHG0LCi4_2FjbXXrZw7M7YiCXxiHNib3EUAxAjgZPtRfdRdLg1XYBIosL0O_6qz0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vUyYjELv1zKaLfT95ppJXXk0xKnG0r6Tyqfb3YUIk6g&oe=6A3D5C8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVzdt6Jzmv4Q7kNvwEIj5mg&_nc_oc=Ado7xRf2qWCpHg4mtjVjeVGa0Rl1JVipptDHMEW4q4W6fYNsELb0V0mJ5K_iBDtVNtQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OgaIGKHryR-eqzTJCkYIEIMbdmO9lgMSWVF9VVqOzYg&oe=6A3D2D7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GllGGYumBvcQ7kNvwG8YHMZ&_nc_oc=AdqVWfCLKUCimDKzdbRB64kgOwErTLxc-FORml0NEc5d9K1F2ac_MFBVUSvWiUFwAU4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fBP6oHaTxFcXwWH71LeudzWQhjEb_Cx5Cvl7SWTtZnw&oe=6A3D4BC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAOtb-q_y10Q7kNvwF5q-1a&_nc_oc=AdrCkpTiEcuglaSn7Cs5ebMyCoQiZthG_EIPqScq8-FmDNoNIfCWaTcjerkf1X6xZe
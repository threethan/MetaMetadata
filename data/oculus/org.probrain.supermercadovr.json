t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA39xiDtr7CTw_q8he8-PfOpPXNdhslNNogOESMdaUyeg&oe=6A5B922C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmV-twGylfwQ7kNvwG7YzED&_nc_oc=AdojBoKuH4JQJMZ8RCGVdXTywdT1iWowD4Lv0Sf19jXb_7LRPWHBP6kC-3aB1OKVT7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRVwxtawzPcBjnzhtoKBLNeMzF_wULAlbkdtvpU-KD7w&oe=6A5B73D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7K9qvjS7r0Q7kNvwF8TTq-&_nc_oc=AdqXyD4fD4WP8MkeNYPapfQByr4yZtoQCcm4_gYURxlphIzhBpJEakYn92BSslyrbxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp5RMWD-0q7hKCtCYCJonOz8sEOh6uZzh8chb1iXtxYA&oe=6A5B747E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ffbho2HopgQ7kNvwG9MPuU&_nc_oc=AdrmRonO13iEqzM9vANVib4_5xmUhamM18azVQG2JpomQqf74P94QKc3uKgPPDbdlvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo5m6n7bHumVVXLVtKoKNrhMrT48A6YPXWGs_ysJTDNA&oe=6A5B76CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIS568OQmjgQ7kNvwH3U4CV&_nc_oc=AdrA6h_nNy31GfhcNdd6T9bHNkRaWs9iwG_lBOP0WGkzAKlVUIMY0VNitIURfUAllcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjaymTqCTBN3sv15Bwdz9bg2079ugPA44ouC3fD7unGw&oe=6A5B7FFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkIpB-fEF4EQ7kNvwFhHR5S&_nc_oc=AdqntHZOpfIe-JuwmkLm0ttlyh105wY-xhgSfNRu5JzHAF3CAGdkUWW6D3jL5pJJPkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArmDQvKAwp2yvxahz6Tu2Lc5JRcqNxvK3IHKGV2sySLA&oe=6A5B6609"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68XJMdHFVaMQ7kNvwEZYbta&_nc_oc=AdoUrxtzlDB57v-uY2Rkm3sfvAbkTEZ1c31OOWssTFUQ8_YOxvCXRKwiwdleien6hS
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQMtp8Y3R_seHfAuX_tfttePOsbhvgxfLQFrX8oEAU_g&oe=6AC7AD2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMyTQQ6f3PQQ7kNvwE6549W&_nc_oc=AdoNCFeZ2ZUIl6dwaglRb1SCfSGwdAxrSwhuyhAy4IkwcdXxJ6Q3lkUcDMc6z89NNQg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPjDTwfgNfiGfL1bvrJJvTSED1i--v4aU8OUK_bYZiSw&oe=6AC7C713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brpULQbtkp4Q7kNvwFjStbI&_nc_oc=Ado_fagE_CSxbVy6MZZ9gsjNXI88DqC4uNmm6ULaAuaihQegRdREibOJEhyzOr8nEOQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGint9kHAWnsnA2uGHTv_n116vPTjFO2ey0cdTcyzFlQ&oe=6AC7C7BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzJM6mVs5VUQ7kNvwHA3cHA&_nc_oc=AdoDSjiWpTO8YrEEIKvhcUHb8eTtawkgKjATwTao8m6-MfKRvthRhLdrTgczfxksDxs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpk2aiK_Y997N7jU0gK1edkTtVDjq8GQ-Rfe7HLyI_sA&oe=6AC7CA0C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoStyvOzG_oQ7kNvwH-fChN&_nc_oc=Adp2NuPgBTh4AuK7wvdnKSTu5OlFmLOdP7u8QtjffsealWSIbiqa9JcIbhbiNp9IXWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiczc_DJLcK4vLSDuvNAJzk6leHadeoQ-6-eBBXgtC7Q&oe=6AC79AFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgvSikIbxmkQ7kNvwEtnbqO&_nc_oc=AdpBDWs19_HZONXn9_0Q0ky1JV-z2Td03JI6ZNVgp3xpIArMuC439P7_Q11llR2DA8w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPdZIEaTFlk_03oJFsI1H31FRI3eqDn3gLOJJ18dQwiQ&oe=6AC7B949"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-0t-RvsmJkQ7kNvwHSxMQ0&_nc_oc=Adq7G4WMFjVXfFbPfPym_B059OjL4vdBIQgkBfBsnyxNndxBIqwuP5_UjLuEEM48XB
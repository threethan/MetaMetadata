t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AfG2DzgvI2s8Y5rMseTtTHODDFSLg2nStEVCclw7asQ&oe=6A1855AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LSkdpk5EtYQ7kNvwEzsjV3&_nc_oc=AdoKMrBxw-Pt4Sv6G1imBRJzZhXnRvpBBIvFWvUsQGhdCZg6jXOsVELSUqk03WbgFqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60VqyjV6tXzV2Qva0yLeJ1_atxu1ApfCVoi83ksjct8w&oe=6A183753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQkcjqhDsdkQ7kNvwF9OwdX&_nc_oc=AdrQogz26es1_Jkzd8AMDsWn9aKZbZMDzWFviYrbw8ufgroEz5vOIICAE8LHk3PnW1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71YV9xyEyz8zaYfZUUzEd8MiKsn54uinn72oLCXjt2dA&oe=6A1837FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZUjxrsYdvsQ7kNvwHEJLYB&_nc_oc=AdrFinZGtmwMwGYvXDOYcyWB1JJlNM8dekC3XgLUFW4PKaWpVu_RZP4w49Q-Axv7mWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sx-gDpAMPDbPmcKhy5b8btRwhbs8ioL3-CG6tXp-pbA&oe=6A183A4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8sRlqBtN4wQ7kNvwFDFsca&_nc_oc=AdqOpQSqctGNPVIClBDTCJUjGbSFyRHEquPz04U-pueGtpz8lWljFK_RdokcFf-4MUE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nMGMFTvSuUyBXVnLEf_KgymZmSeFOkzHcYN_a2uajBg&oe=6A18437D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz8MjOD5c4MQ7kNvwGsa5s3&_nc_oc=AdpvqZvkWkVcfXQTY5JZ8RPC8x3uJO81OdsIWExd8BgYpmdw4clnJy9AJDjNUKMSLtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RAcp-52K8kVaXecMdM6AysdjoB-3OEp4IOPElqKR5gA&oe=6A1861C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKrbLLmqFwcQ7kNvwFKpo97&_nc_oc=AdrZbFoQNeCGUQxhGLBGAUZRXqQRmSBeuGjPAvoxaxnlxVBCTBaY4zOdt0m8nbIwZm
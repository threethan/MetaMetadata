t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bxA4HsBWhldS9YhqrERb25Lr-GiqzKkbos41fnjJ4oA&oe=6A41342C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coNHZ32aUdQQ7kNvwGiHE2a&_nc_oc=AdoEuMnR0wGIXWKNBFDFf_YFEqRRHggpoSSSNQDXHnF6tyL3sXgJTE6kGjmtMowVxhA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vqvWTdjCopK1d7mAysjo5uGWH4Tau-ZI95TasTlWutA&oe=6A4115D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n6GLz6eG24Q7kNvwEwEHI_&_nc_oc=AdqfMVW-_fKn1ZVClBrQMFmEGD_395pDJ4xCa_6si3AH8EnU_Im7Qhdq14vxKodklFo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E_ZXeRwaeqvKKa0Yg7LdCLhudxJZpO-RYF4PJbrGydA&oe=6A41167E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaERTAj_i8EQ7kNvwHA7DxZ&_nc_oc=Adr_cSp0TSOq5jQvrtMFgy1pQ55RFNGeIfKFQoX3XtiZ-jcH0lJE7-dg8s0G2X-aALE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XXWMNM-N_pE5i5kbLWDoSndqIo2-g2U6zn6-5zht8hQ&oe=6A4118CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7NhwfX0r_AQ7kNvwG8-EZ7&_nc_oc=AdokuSGBlbaBjFOe0LEAB_ED7NHFYTPrxVbA_1m4HDbQoZpGfCbNwHWPHYBGLVEvG4w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8CTbVngLNfZHuHTZGlPOEQrU_7nGwk2coQF-IPRNpfA&oe=6A4121FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzl-tGO9yz0Q7kNvwFu2KNY&_nc_oc=AdomSTFsX0CpTRp1MGZ90WfHQ_0h1AKjLU0f7DXmYzLu9ZtlndHhuXA4Q8PSEkoiOjw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94cizKrxy_KyDQIS8rYFAxNrpRLx9in1gOrysOaep0FA&oe=6A414049"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkoCdaudSnYQ7kNvwEIFU33&_nc_oc=AdpWANCQeEHjVfO7pGyp8x7b4j_R219xGjJDSXnrkbCBomveIdzCkAAvskPLXCDNDN
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKaKrBMJUuI_06jAzfy7P8vV15LNGB8BWfAaZSHVUH0w&oe=6AD2392C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEAroSbq5BQQ7kNvwGNs0jU&_nc_oc=Ado8l0LUs8kR8MtgpVkli5H-UYGw8SvZvnd6dF0j5N4bU9OjDRi5z2hIwpjnbNYMQ3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3Yc_6DoY_teow9gRYeM5dTjevYEmTs-Wf3YwM4RPkew&oe=6AD25313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IS_AIMN8g0Q7kNvwFdsqMm&_nc_oc=AdoXjppZIHT9dnavW9RY2I1G3WfNW3nzSRAEjfzEwTptS-Zp8oRhLkolTP3J2yub2wQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU3o1AtRZCOdYqJkVXI4MTV8WoT-G_c9-Ixljy7q7usg&oe=6AD253BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qd1-GFqWoYQ7kNvwH047hE&_nc_oc=Adq8yqAlNQvXYgbYBc2SDsxLl1l3pS464GQVaEzJr6cIkvfQdwEgC51_SQN8aFKKTuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7QIq7BhCFbnNXLxHYFUDDR-fWeGPmKT7DqvGBLPhu_w&oe=6AD2560C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU6KBD7TnlMQ7kNvwF2fNKR&_nc_oc=Adq1S4YFT59LP4MFTgrg1YGm-LLl4MbrlQe1pP5kVBCeEdegVtgCGLVOASnChob0iTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6-vWgtZBe7SFxESa1Og3zMTExP_6BvIRWNLoohsMzEA&oe=6AD226FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql-k3eqc0DAQ7kNvwE8_GSF&_nc_oc=AdoGpCI8g9olhALFFPbfTkrgsMjlS4eHBANTvWEMsObvDpBYiGTxow2Vb54nNzouF54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzY64pKFZTj1TENEMG_H6ngLdk_29Jvu_fa0_mqAOCIg&oe=6AD24549"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyCXOvVikVcQ7kNvwFiOn1l&_nc_oc=AdpRdEq9WuDB7Zr9w1rUozNx_Aw7-IS2WJrRQyaNrMA4sTamTMunMzYF-hfBvG5YGA
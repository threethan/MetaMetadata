t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WbKayFsXcK7Iqkxd3xxjJk3HbC-cMcmriENqX2Fv-yg&oe=6A3E912C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coNHZ32aUdQQ7kNvwFtxTqc&_nc_oc=Adrio9UufVGgEWanGnHbcojcru6QmDxGTfJMUxDIF0wcbZA-dJ6ILX1MfKzj1kZSjAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kUJxUFbF25BaPDIhIw1QHXW23qAZi5-18yOZwpzcbHw&oe=6A3EAB13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n6GLz6eG24Q7kNvwFefbhq&_nc_oc=Adqxk4md1lObkVoNyoxxszkjlbcjwnpk4DuZW138ZDmwGeyl2kjRarBkpPpoWeR0Fck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sk0f47qUIeJ3zQCG1Bg8w_pbYzJcNksnH-6WOkKLS4Q&oe=6A3EABBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaERTAj_i8EQ7kNvwHdT5it&_nc_oc=Adqlxrgfk4Uv7L0Qi8q895T3nJpaI3SKx-07x8KV4ekI-1ZIkQQlxdiOlj6tuKRdTeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86W9BLq2vRc61m71ck2yFYbY_Q10-pyf_g8uzVnKB1yA&oe=6A3EAE0C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVzdt6Jzmv4Q7kNvwGMZozl&_nc_oc=Ado76AnOpg84fO_S51h1SKWjmcqtWPqoCEBD6xccADgYpBvvyNK6OzkL9sUyjN4GFqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pd6qh22TBEnztluxcq08QYcsRJjKpMFmmLqoEvTFrFQ&oe=6A3E7EFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GllGGYumBvcQ7kNvwGoE29R&_nc_oc=Ado556rXfPHrnV6tjyX68G2RMQiE4MfnQj693NL2bIKX4KMz01f8l4XmN-Ozp_mkUAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ICgVumRBDienbqPvOeVJrdWyxmH2xmOFRPdCSO5Bvfw&oe=6A3E9D49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAOtb-q_y10Q7kNvwGwjrzA&_nc_oc=Adrq3wx0rotl9hwAPfpZ6IuXdUMLuQ5g5a5dA0F0_5Av-diwZaRMiPhpD7e65XoXNm
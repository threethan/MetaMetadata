t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHsA5TIvwPCTUFJYGOtHiN2uI16EYmEaWnSAimFj7eeQ&oe=6ABBCFAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwvV4tfHsSkQ7kNvwEqvlOi&_nc_oc=AdogBdyiiI5vvcxTpOAPqs-YltJIFSlswOrmIoOdrIyzFkSiD32q4cLt0OqMJNmqmD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEwJ4kAw67Ir-hSQGlLPhnCS5E001XqTRnfEtWgVOomA&oe=6ABBB153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80SBmG28X4Q7kNvwH3CTse&_nc_oc=Adr8unoipKD3imxlBpp74d-vqSXmv0O-YJzsYBwERa0qvIQo4aBTpSeVZ_Bwrj5p7D4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgwoa0tUwQkJSHxII87BcXmgsYS5_4SiXYx-kvgMB75g&oe=6ABBB1FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vlF7A43ydkQ7kNvwGPy9hx&_nc_oc=AdriylhbKfCiwH7ZTn8Oa0bRkybCKWrc-B21Ap8008oEN8rWgC5mRiRzX7Eg44u1ZfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKU35EcBX8BpFb7nOIssyGF05KDhaDTjdgYyKsN-wifg&oe=6ABBB44C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHLuuxhSjgkQ7kNvwFUqCCr&_nc_oc=Adpi_WqoVXS78DtwA1TP8SZBQtn8oAAr8AC3xtxXcXbf-79Q-kB6L7f8wiJxqtvH23g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJzAIt1T9ISFiaiuFHdrycJbrxnzyAQ_lW4LINwjdtyw&oe=6ABBBD7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4skkClbHAEQ7kNvwG0-_kN&_nc_oc=AdrxnOkzaX7JqGm8w_dkSpKZ0fAoXORXevNtCIOlhpVp6TU7OnbcBccSCZqiBHFgLbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJr0wdRyEgVQrxbgQjWZrPoIjSRiPZL10LAshpCSA_kQ&oe=6ABBDBC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMoee-caniEQ7kNvwHkpjre&_nc_oc=AdrVdCqOl37DBHYYqhemrxWFGyOGibJYNGlttJwDt74kn9k-Z-bDQ6Fu9yU-yCpze0
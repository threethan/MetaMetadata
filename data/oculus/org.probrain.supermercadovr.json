t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB1wiNiMnsLUe_bEQWEUVIuJCjfFLe9TLUWsSVajk8xQ&oe=6A51062C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waP4teRw-n8Q7kNvwHkrosj&_nc_oc=Ado_2ZE2_uHauZQatQ7-Q4pMjybjj6iRsR64EjjyT19z_OqiaDlAyYSHrEQCCxCSpDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3x8Sny71o3snU1IlNoWDU85C2MfI5FUHlsq2xUkP4TQ&oe=6A50E7D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaIcCcO39ywQ7kNvwFTQ2N6&_nc_oc=Adptxm78ttw9bEr6ZCDM00O5G72iH5JB2t2lcSQlyyhastCodX_PjfY-HkUcKYNMZXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiuUJqoC3x9PuViFMpZesAmXqpczrCekh-qyTtmN6FFA&oe=6A50E87E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG10wD9yu2YQ7kNvwETN4dn&_nc_oc=AdqXi75x8N9Mz_F_muQ8ujMZq9BOn3NBaXqSaYtsrE9FMxxGkQhqLGjUvep2yS9pVXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSj_28Esc0VttyiB4VXLcQByGncAUIJ1XKIpyy9fhxRg&oe=6A50EACC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thA83TQrYIAQ7kNvwHIh_RN&_nc_oc=AdoQwzfOgLoFNsAZvMjJju-86Pkc3J1YqHidJU09UH3gVUT_J71c56VdHVnLfUjKJKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEYb5cSyXhXCV1zYplzy2Ll_FKIu0FrXS9zY81nYEDsg&oe=6A50F3FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP-8C7Xk3bQQ7kNvwGdTOnK&_nc_oc=AdqCLLDbprJ1zDBG1Nlr5QRP2R1zKI2UOH6nF0BZHdUBBrPnCTvHqj-crlQKghSJdu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcBQic6SE5jeW0CDdi9tTRqlGt9n0BaAZX3OEqYR8iZw&oe=6A511249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Acu7YDUUZWYQ7kNvwGXVVFt&_nc_oc=AdqtHBGiWT6R40E3d37YlGa3yN4qLLMJIH1F_pnA1AuHIxeq7KuG_558aLyBtySaSQ
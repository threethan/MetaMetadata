t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAj0oApGffbfAbat54HRovh1IKagH8zx72ozsitOhaXA&oe=6A95CC6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVtnPLgQ7jMQ7kNvwHZ-gOF&_nc_oc=AdoXNI4877Joki4VnDUKFlphn3ISsxBOLv5yrDInAmx3H9c3tAvr3gdoVgIKBB0pdoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4yqQz52QirSMObqqZBbKIGvkw70Sm5xaXgJmzwg9j4A&oe=6A95AE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zegjQZMNWEQ7kNvwHUUlZO&_nc_oc=Ado9yN8gRFKV0RxOrq6FQwhAvb3W5talnXZwsOz_ESn-34v1wYtleim6eW_8Ib_GDLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL8aBTMQxLEkQgGMnxjF1yE48gQCSwntOiggjIP8jbKQ&oe=6A95AEBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIYpErHp_B4Q7kNvwEm4nKn&_nc_oc=Ado7O8xM8H36tGGmsd93DzRCjfBPTmhR0lMCG13v_MLNcHAuRx_6SJwTvX1bhaSZS6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU2lrFjVekg-BidSqCcsGoIdJV1OQPFqjhIF-AuNa2fw&oe=6A95B10C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2npVZX9v23cQ7kNvwG5D95r&_nc_oc=AdptoiX1cSIVVHQB8BYhk4rRbJN2NdoaWiUb7I_M43FBIbImyHdwOat4wy3xyN16jG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6SZOIDjmomnJs-m0gCPk3tLFVCICDb4kc12NRHjZYyA&oe=6A95BA3D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQF8kv5VCQEQ7kNvwFz3Fy5&_nc_oc=AdqeoJ1fPTjUfnychZrJg_fD0ewKQuUsVs8NLH3aco-0iJfoMvKT4PJUhgpkt9A5x2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKQPYfpEbwaiKG1rYTjZoeznUYSJHwuoQEWZ8XQ0MLSg&oe=6A95D889"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN49xH1isScQ7kNvwEtQBQH&_nc_oc=Adr8jwsYxtKgrU8EFF7rLcOZNaxXm2SOU0P_ksrJ6fF74FbLeOSbmpQz2xec38PuEv
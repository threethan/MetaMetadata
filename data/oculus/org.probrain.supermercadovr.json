t-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fMGmRl2ziATO695B8evLGhUQO68isskn1BJjZW6D3dg&oe=69E63CAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyzae09-acsQ7kNvwHDlEcZ&_nc_oc=Adop7yTusLvvTYyKtqRSNxV4KEpwdtLhffLYTBUIwnMUyRRA_y46Ax4u92iqEMH77Mc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36ZB3AtvhL3ZLFF5TSwdyQLiOAAyvrvgPxVeEM-4wmmQ&oe=69E61E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuXlxFYpIMUQ7kNvwEpHLaE&_nc_oc=AdpXZ6LtRTvYHv-4dvBv3HNjOBLMcy0ZbEeH60Pylho11PlD9_M905R1RfetssP-EWQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U8bKsxcpr-g8keWJidCUvy10qxL7k3hIIKDrM5GvpLA&oe=69E61EFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n84QossicbAQ7kNvwGzKv-u&_nc_oc=Adpb7rl_tcCi8R0TtP0nR1gOypAc0EVGlHslVTvMOf3lcD6hDZ64cVnR14pD1Ncx5c4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jDayaLHySIEkivHYwqmZ0ZAKppsbpr1J_6fTfLbp7yQ&oe=69E6214C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdAU1R_rJ8Q7kNvwG75t_h&_nc_oc=AdpTmE-9Jll_O4quWO1BPy6cxFbnp3z8J5XsarFapTPutlL5ArT3fnAIo1oeEGiirQ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vbxoHHU8SR85527GJ4zLaaw96j1A8ehqbWnsK7-WsEg&oe=69E62A7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-MqF44V8ZoQ7kNvwExDAuY&_nc_oc=Adr-ezhiwK6BwqcWt9jFkL1bfuPqTrMd6VpLXbMc1kuAb89vWG2v_z7MKfMZZ9fwNIY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rCxFIVkNR211himOXbPRh3tQ3Bci0gQSVQCMnjQC_WQ&oe=69E648C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR1tYhYid9gQ7kNvwEOMj1L&_nc_oc=AdqAKgErpViGvExyympAXY8MyG6SWVh8lK36gwsrC2dbE_xfuLjD6ucPAZ-Es32XrZ
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUs7k4sI3UKmEwqWutIicN9hovG-8HqKZlcCWkKx66Kg&oe=6AAFF22C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R9QSkLMhhQQ7kNvwES-fc7&_nc_oc=Adp0y9q1Y_FBhFdmc5dLqTvAZMOZ4eOFcOKbRitzIOvJ-UHDJ4XOgr611bu7hwqINmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL22NAHfYocJOsPoalTaOB3-qKD0bKF3e2IZi3Py45_g&oe=6AAFD3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvZyFN9zZRcQ7kNvwF4HekP&_nc_oc=AdrHa7eWU2PSBJfVvo2j1G6825v56-Z1USXenmiUMRQKtUhAI45LvGH_Hz_paf0As6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMaw3jq1hwoAmyGGK8L2DBariiIgkFEv05xf9ETad52g&oe=6AAFD47E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6cr6hnW-XoQ7kNvwFOyOBZ&_nc_oc=Ado8iGBxm3ACfCgQUbr6I_G9diCKiaZRufB1cJp7AJJ-NX5mXCBMQhdfE-XAKCHVmC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMjAjdACt4ATE-H1rBqLOuoVd00P23Sm42xbjx8xr-iw&oe=6AAFD6CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkv_WqQ1Y-AQ7kNvwHDgKoP&_nc_oc=AdrdFYD2XgyLztWF3uxxVGU7doX4tPoY38iM1NE--wfeTqybmjL1LmEe5ieVUBZ10Js&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiT4fioFrCTGv10TxeayJTmWgHgPp6LYHw0GR43Wh_Zw&oe=6AAFDFFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE1dch97frAQ7kNvwH79OEQ&_nc_oc=AdqltXSOwCryZH9Mcs6Pk_9PUMFrwi3gIklumYYfqr2eUIVIT3UdPhJ19o5CTZisJO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ68jUnD8pI_iMOhGwd24Mc3GVPdhsCU-9wYRUbm2TfPg&oe=6AAFFE49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1gw8ElVn9cQ7kNvwGojNZg&_nc_oc=AdrkhzBwz68qfvfOP50NKTi67AvIng4C8GxugZckuU7i9RztL0RM3E-kSWHBj6JGIC
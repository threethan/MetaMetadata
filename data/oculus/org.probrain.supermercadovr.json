t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F8BsrjZnq5IX82gZA9JA2RNioMKAlziPFCRONNUP8bg&oe=6A01EC2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73OAGwLOiKAQ7kNvwGRfFuw&_nc_oc=AdoJiE1c4Yh-Kwd3Pvht20e1_gYM2Ah03N097qf19uhrK_-DJFK9UjiNL67oafSGLus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JmLzf8q9Q9_xvzQ43DuuBQrCNLwAt-f3O-kvY4FX3Xw&oe=6A01CDD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k90TLMvFZMwQ7kNvwFfMNdW&_nc_oc=Adp9mXAKERuA3MIMdCS_L0RRbF5-rQFLYWcmansVuijrlZR8XsEmR_vtFAaPdpVcrZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gnXzfDYjO0E_emcsCGYcjmypT5EdBHXL8HHzeus5sqg&oe=6A01CE7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlH8Zn0kuscQ7kNvwF07s1E&_nc_oc=AdpVD0MknT5B6ootNQWp7_wqOSvz8lH-V0NLLVffyuNIglvCTNJtuq3Fq_r6YvYBd9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Yfrsikp_5CGYhFhszRjisdcxLwN5NA1pqepBx8dWHg&oe=6A01D0CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plFhqRukBI0Q7kNvwHfBFfO&_nc_oc=Adp2knHBvubwT4_b5hVaFD0rD1RBvjyjPS6A14af49uCFxol0i1jJpT24VL2wEzR9hk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JENJT-R5ZOJ9hlGvyxkdvTm1WBCDxWBFqZBawyK9ppg&oe=6A01D9FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5dJbz26664Q7kNvwFfHZfV&_nc_oc=AdpHm3zLrYaXMu0EsRkjVMdH_xsA1tgTO2S-BBCFKCe49gfJ04Bw2DxG21L44fuMJ44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dtBQ6Pn6zdlwIlyZn8xgoZ_K-hZRcLSsTVl8VDjL0hA&oe=6A01F849"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wiTr62CtUEQ7kNvwGihMjr&_nc_oc=AdpvLrCuy4UnVcovTb-b4igceOXbvjuGYih9aBimrZ1DKVhufnAiQgjHanXQpFOQ2n
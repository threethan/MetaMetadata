t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9zVv7sstpninkHJnMavJzl77cscU2erJme-zj4fkAMg&oe=6AA2C32C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3L-dkC2uxMQ7kNvwE8zy5f&_nc_oc=AdrtdIpDvC3jlY0XcM9C-HOUSUxB9xhQAvV9tUI_TF3IOe8YfIypbweCoxG8h7CbTj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw5oJuNMiktw4hB5l5qCAyvGMSPDMVZOm79UYWnrGj4w&oe=6AA2A4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW_R8k8Jve8Q7kNvwFjseom&_nc_oc=AdolceONakS6MlYh46Cc1WUxqaowgy3xQ9bM5nUbPPxQ5Gvn2EphAcyk-YLbdFfLYuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6L4RiCiVonYf1BqKAWhOBvhIhBsuvSrxdlcYFEW1WWw&oe=6AA2A57E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwARykDUilMQ7kNvwFVMSGk&_nc_oc=Adp4rYl5uJQ739FQVEYJC5IkJVQ1I981M9NjNhGQB4AePEhux6LbboUGGCI2T3_Zl4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkzKOQephfQR225XT6Q49WZMGMayty2MbQvtYkmGKnrw&oe=6AA2A7CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWtP_-0tc8wQ7kNvwHzCvS-&_nc_oc=AdpfAYcAa513gks1hYzr8vJw74Hhswy2mFp9rn0IelbJJN3UTT0ShYWWzRi0JcUBJlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO4Lhz1vHaqvAi6QvnPdLIaHu4G7J6K8O7RCKgy0etGQ&oe=6AA2B0FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bdp4geZFar8Q7kNvwFyj7R2&_nc_oc=AdosVV6f75iYkrLVTJrscNqy6stLefTFjPsF-Fb2ctSc-0fNvj4_vyoygZO5xYTlb74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkxiiPzHk_RUFk-naqF5j61FhOvrR2LFx06EUJzr-yVg&oe=6AA2CF49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PbZTp8pFNwQ7kNvwEkabK6&_nc_oc=AdoDf5rENr3qiXZ3DCGMuqtJfeQaKxon8H_LwNWYBULB9lp_fofYdC8AlLY6h9gdAI
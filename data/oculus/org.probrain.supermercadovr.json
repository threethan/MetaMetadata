t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW7OJ2OpTNuOAGm5qsuyHXASl-X2095BqsyWtKngm3aQ&oe=6AAD4F2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R9QSkLMhhQQ7kNvwHDwS0A&_nc_oc=AdqOe8JtgYyYmgvNQiWB0iyCMWjaLDj0u7sqsGuxqdbGXkoslE3M9qODNIGOBeHz4fM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJd3R_2s1maZwk2PZRWrjK1N2GHHRQWeZkWAM-rV_ULA&oe=6AAD30D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvZyFN9zZRcQ7kNvwF8TyK6&_nc_oc=AdrzHeYFQ1Y7opdpz2y9TrIxFysIwxaL-IlqkgEmyGFnGRbB0419-Ol-k3zOhrvZBco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1WzjzKQdsfp2D_MQkNzqWSW-CIvsDVyqNNM9gLPdUhg&oe=6AAD317E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXYeIWjz1zoQ7kNvwGh1lLH&_nc_oc=Adr5WJ3irbDecWB9DnCjKfzCA9RMh1GdKxL8lnAhOQiA6kg5tdmPCMVX0eNun8ElNH0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSYUdE4iw3WDb5deYa2ajtb9SBGAuq3R3DJheJ6JndcQ&oe=6AAD33CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHHbom9DmwkQ7kNvwG7JPUH&_nc_oc=AdqFETX1d88oDIoCPev-ixfz2hqVCBrC5ESJJdh13xbii2yp1fPz6RAEzpy9Oj7Fo4Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBcrxFxuo-1u17JGCOSGqBD6gopoHPep8NG__xXs-nsg&oe=6AAD3CFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts45OQqi-vsQ7kNvwG90My1&_nc_oc=AdqePmqxGAMBQRHc6PY4hFr5SHbpkmqN3KB3Q35YP3iukGlE40t0TlmPiyM8S6X8XH0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyHppkh8R7slc2McdV0wvZ7th1MMzyFaLLPf7PhY1UnA&oe=6AAD5B49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78vXgLxG5y0Q7kNvwFVsZw3&_nc_oc=Ado-25iSoRWLsVrq35X9fBckK35m4oYPOZPZRLXHDMDxf3tLB4hC1qEWYswqyauNAV
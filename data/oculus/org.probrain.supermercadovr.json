t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTnO-XD0HmcpTuO8n_vBHdKVpmDaCEG0yHAfN9h1et7w&oe=6ACF962C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE_BVyzipDEQ7kNvwF3AvwQ&_nc_oc=Adp4pXkwv6y1SYUb7nG6cW86cuL9xhzXMs4hpkVagJ1haLBz7OoRiFHwed_-9z9Xsgw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPE-KBhFGH1f9dLSpTMtTX16vEquhPg7MG6i8tWbHBvg&oe=6ACFB013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rL2Tq8OAJ8Q7kNvwGWb3rH&_nc_oc=AdpTBWkeJr0HzSZx0AFVP_SC473Lh6uL8gvrXRESjsBdoJrmVyL5UpMyrtvpql65wBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO23qKOCWablOdiB3SeohTyLTU3AY_g1yjtPODq40UMng&oe=6ACFB0BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_KwBkY78WAQ7kNvwEGK5Mk&_nc_oc=AdqSooPzlabt38-PDYAIeHYnQ820i55If_DHHOsxFl_iKcLeQGXnXtZaQL2wLoZliuI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhm4ALOQMu13WO4mg_nfdAfI7ZzAirMNZEMCEQu5Gk2w&oe=6ACFB30C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNg0tx3MivsQ7kNvwHG7xPI&_nc_oc=AdpHyIf8hVLreLc9MdbZTWfAaP93gvOLPyTiVbFWt6jDTDc3yF18nUx9scVlyl8Xs_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHfgFqvq8xOPLJY-g2ihTBKSBsg29xU4PWr-WN3R78mw&oe=6ACF83FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql-k3eqc0DAQ7kNvwGjo2mv&_nc_oc=AdqCHQYA2a2liqWiUgUsERGBqOM5zJe71vPciwoeA8HybYhrwHpHsuqk0VKtQ8s1eMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNGyL1S_FaV2HsrMRd-JDPca3tQtWTs8F0c_mAcYXkAA&oe=6ACFA249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyCXOvVikVcQ7kNvwEdPgtB&_nc_oc=AdocG-om319WKXqMOZbhdNdn2XXm-xrx2YmtOX1a8NU6Ya_mjgQpqPV5z2gMfU-pgu
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyRf5za2O74Fy5gSsaUKu4xtmry2EwN4krUnT3w4PR0g&oe=6A54FAAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT_XlucKiHIQ7kNvwEpVDAO&_nc_oc=Adq-pTeRQMc55qcvb5sWhYNAJ11qeZoRV4TtoDwoKU-ITWa0vxQBKsw53P_u9qbOOng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ7DaZo5pcNfpbZXN2Y1NekNzzFofqXtXBN6TADvVF4A&oe=6A54DC53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP9Lx-00wjsQ7kNvwF4KnJx&_nc_oc=AdoF2mGYfW4f-SmFCFkleApX_lmY_D0qlhTdoXSPvCClKmTy-POzpDgxDFRnpE7mFlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAflPtPzX-bbxtOFr_rbiCMkBSBgXPP6QeWM-gEKcWlwQ&oe=6A54DCFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsFZyts4S2AQ7kNvwFMITnn&_nc_oc=AdrBYSZz_Eef3vuFi27Bis_4Y7xIpjjyq1hD0rLfb7GTH8_bbHS-Ku29DIEBC5yy2L0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwQaedodMoy-jDut40NCFevs7KcXzhjNnbu9BAPLN2KQ&oe=6A54DF4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbzCBE1_IdcQ7kNvwEVAcHH&_nc_oc=AdqfKmRrPfS_0yaSdryLszlUpa9dnCBAd05QxHYfyv2XL156JiWhbe5394MRHIkAKpA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbx4zvembo428swShzOQ89Dkqp51Xl6XY3iBO4O_y13Q&oe=6A54E87D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbW8ttg-R4gQ7kNvwH8uaJm&_nc_oc=AdrLojO_ziNiDggPvZlMPFvL7b3QqqAIRcHUcBfbdiMCrBvQUgMmvlR4XFn5iNk4YZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCv4_AMD39jEkOqKmJLSLER5VPuCE19SvS7Zj_MGQ8gQ&oe=6A5506C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFGSyBcFCtYQ7kNvwEM37e-&_nc_oc=AdoozJctJT9AcEt7lFHWPFjo4eP99wk_U5-y7akG4ByK_pJCdGDR0EMWiz5AnlRAtI
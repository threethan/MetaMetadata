t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWDpukbaFdExo-bUtiOqzLVQbHvAPFy7h-3uuTt8MbCw&oe=6A897E6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K19s1eZS5UQ7kNvwFFJoC7&_nc_oc=Adqx7u5_SVdWoUxQ8JN0Nol0x3IjxVGQw8e1PV_YFNCCYUWBJuXBnNAsDPvIpV7_2P0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlyMIlgmNpFjbqj-Xnaz1ZqsNEph5b_CLENFsjS0NXrg&oe=6A899853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPxM1RfBwoIQ7kNvwHo8j6e&_nc_oc=Adrz5pZmubOSdv8jv80rJ9WONvlWRmGvcpUyp7CF2QSGnTPkbi-XTKqJ5g_dBSia2x8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRLOgQMwIzvUQfQVAo8d7ahAFlFDi5qd_xv97gkYytQw&oe=6A8998FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqvdvk8qUzEQ7kNvwEyfHhF&_nc_oc=Adrv3v4dN2i0AvViEllPK9eYTRU4uTeQDAigs3HOUp7xBmNUuZejIs_sF8lEyjpQqVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdPcDaih3eXHWf3ycHM-kACjZriqJB3oMHcddrm5C-uw&oe=6A899B4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0L0BOgcJqAQ7kNvwFqeTg4&_nc_oc=Adpz5dlLpW9aCvScrdfA0gvAQFpWYOwlqeAKzZC5yCdjtoV8Fp-YMJZaMT6IulLmba0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI9g6B4FgT_IDhiGPtSp0-TIjUEUEapj4qwtob8cJrWw&oe=6A896C3D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0du2GUsKyAQ7kNvwF4krhh&_nc_oc=Adp9FrM0l-O1h_RhNaECshnlROU2-AH2N9v8WGdke0nmlPKAcZDKoVkjuMWKylpiJjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe2X8W6pvYWMwxmLLNOvpst8vVquKj-iz-Cu6tl1LPWg&oe=6A898A89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC3Jp3sdyNYQ7kNvwF7EUWF&_nc_oc=AdrztsTQq-QvyZuPTlBCeaNo9SO3c-i8l_POykD1GwwpmxpQQEJwNXWkPNWxWcheHC
t-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vM6HW1JUztM7F6A2LIM2-dQ2opR7w6EwAB2Njvo1IdQ&oe=69E8DFAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVdHN-6b9I4Q7kNvwGngF8n&_nc_oc=AdoBS0uNeLW5gIFneIQEq5-wDZksQMTqNqe6JK_IpQ4pm_6-p8Tamdi9uR_v2T1E4dM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GR2jtVR_rCsdWqmJi-EG5uLEdfY52tNbKJDhhL9WFsQ&oe=69E8C153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXaxqtqkTsMQ7kNvwFJUcbM&_nc_oc=AdrTrNcUGhyI9_tlA5P4X2xfyDPxIjpObypT-QPgQhSsepbJcQGG3kal74U_HSqR77o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yX4RpB13HsbDHMf_j6LjIp6fIjgeKvc3B2vQ27MVd0Q&oe=69E8C1FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBNu_ag38mEQ7kNvwE9RMum&_nc_oc=AdpRK1SSWWYv3dpMC3STS_8lxYZeh73G76zb4t1V6_DV-OvfdG4VvYef0IIEBrJVm2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ggYFp_iqVhsCM9wW8FpymY9vz7jHwb3igNR6g8JJ-fQ&oe=69E8C44C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJV6jx2kbG8Q7kNvwEJnlgd&_nc_oc=Adp98kIpr2w9_HOCWB1Z_zKdn8ggXqyS7WR6qiKwwe2LDUOBzaAMzuOSjUH-UkBXEig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09EX1m7xgLHiAgqcyaImNCVFQV5DC8OXzesxzK9XgYCA&oe=69E8CD7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-MqF44V8ZoQ7kNvwG4dPgM&_nc_oc=AdqJad6_TPMxtcR-lqitZn_1OHUZTTACxv1Uau54AEVQnf85KOPXaBWdK_ciBlbdpX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38Mvn3-F33nIQVuBsI-q0gLIpNYYh9mUHcHACH_kxSHQ&oe=69E8B389"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR1tYhYid9gQ7kNvwHjxb3Z&_nc_oc=AdqFZ7wLcFs4LCb7jcGRVeWQKd9RagIPmCxmfP-0vyAdqHIXp6Kruv7DYuR8iC5-g-
t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmZLgdXkGwWohs0NzhlNUWf1iDhFe26V31q00S5N6Pvw&oe=6A6F58AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amXWXgBRLWwQ7kNvwFI6Raa&_nc_oc=AdphVXc6UIaTiYxgKGv_8MPGp6-qycROzO-GIJ9mkUAEHP2ri8sAUw7NX0nrg4RywBk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBrF1IC_rCJfMIcI_pt0sRv3k-BmJi4CB6tAHD827uAw&oe=6A6F3A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q6A2DBjUuIQ7kNvwFUWIPV&_nc_oc=AdqvMiLdJSjC98zzAOI2J5BF46rapfAet0KN1Jk1uN2stn6WSnDUYGmIr8vnr1rf2-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-FKRfHwEYrntcUlD8QdyLeK1d5uv99TNrzE123ynAYg&oe=6A6F3AFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uc_FFBcDvcQ7kNvwEQH6-R&_nc_oc=Adptq0ZE8mhOHjgwW-N6CDL_qJ7UlpcrWgKO7uwRxUAfQDc7e0iIR2p9PSfYinVWIWQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9C_aH2hm7mOPGe0VBnu9ry802ZVy-biT4Vqdqv_0yPw&oe=6A6F3D4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enDUJgfsyE8Q7kNvwEVSOmc&_nc_oc=AdquG4QPx6KZ3thzojDkbHnlYyW9MiyGF9Kf5huQbzsfwLd7vOv-_lGtDxWZ0AIGlSA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnpGUlZsHiPbiAQHhaG8Si3r6O61jgEVsjM0SDHDjQhA&oe=6A6F467D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u3T6NqScbsQ7kNvwFrk7Cd&_nc_oc=AdodYNdIBNkVfJcjWJM9CZbWBz0k3bjbkVIjmCt-v6epJxo6vurDbMNtauNeZ-NdTXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4x0vanXAzCCNYgAX2HM2OgGhu3hab8NhpVscWd7zuLg&oe=6A6F2C89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fquhqRB4gIEQ7kNvwGCVRns&_nc_oc=AdpwVH7dnph807vYM7DyhSA0zr6QnuoPlyQXoNxCZzy6rGd5NXrDZAMa69k-defdJr
t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOsbWSmaQHJt416frV3-9rOsA8QjOdXwsuK3fLF5XOiA&oe=6A58EF2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQF-wcTCuI8Q7kNvwFtr8fa&_nc_oc=AdoBPqFdRZDQDJz79_y5FeYco3XMn4WQGr5yI5k3tIDKPU4HwKgYLgc8LfBF4LTU-7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUHoDfkHHDziCOVmy2J9YNlMo2IlwTBg64Q20FMA1LIw&oe=6A58D0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2YyBRRCaa0Q7kNvwFXV3tu&_nc_oc=AdomDzPrlqVL7yMu20c7lWhqwLieRSdLXHk77BOs29zk8poL9_TUPln7ztIXj-0ZByU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_NwCB--njtRxO4Ps5NHopgKJZvKoBSf8E-c_xMOW_Cw&oe=6A58D17E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR2ZqwI0dSEQ7kNvwHW-IQg&_nc_oc=AdoUL33srXPqMcOTD6UpMLNSiM0N7bvu7s1YhIoB0DHKUqzQvSqfIFjlHdpfNEtuaGU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp-2Cw5LtWbLls1KK5TdaC8iBOvGSl_IVkudW4E6dxcQ&oe=6A58D3CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-xbVu5CUL0Q7kNvwFRbeq7&_nc_oc=AdrcMC0U4RRJw919rv6jc9ts3oBzH4BiYbX3Al50H4hksPM3rtyaYYVKB_54wGFc89k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWrRYkVtG9PSqcvxTqwG_DKqa_suNGCPGmUP3Tj0aDIQ&oe=6A58DCFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkIpB-fEF4EQ7kNvwHl8Fc_&_nc_oc=AdqmwDfqg8YRz46yhe_JHLhCM-qGcTwgzr23sEqBc6NswnY-S7UpHhhVmIF0x-LeGTk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVYThLcTz_W2SHUy_1jNcqMT2VsNbuIA92V4DXC6tm3w&oe=6A58C309"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68XJMdHFVaMQ7kNvwHUJpjB&_nc_oc=Adp_Bxurxe1jAcJP2IZhcFg_UGaoCCJfOUzdwr_uQj3Z7bAsDdd_uVcq8sSebypEhH
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOovdm5wl_tYQvbhpK1VzmqUAvV8iasjltxJcxBIzTyvg&oe=6AC8FEAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeRiq8S-UnsQ7kNvwFXWKiS&_nc_oc=AdqULU4jEqLq5tCzEyVkwvvZZ9JBHHgnZUO8Azf3RFcyKvDM4KrbXt0Y2MBx16CPdxo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO420dwSBVlfy_bSY0jGmMzDTH-IQr3hpxCdmNeBW6iQ&oe=6AC91893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9CX6MQo6VYQ7kNvwHYA8r7&_nc_oc=AdqGilugSnQRV-1ZRuenvO-Cu3Qw6al9KS3G5AR-h8AGmFJW1eg5mizQxwnnek6fsbs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTUYawgX6-iIl_3ECMkvPD5MzIaR1FbrfhmetJzY7XBw&oe=6AC9193E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2npesjDMM8Q7kNvwHqLD8D&_nc_oc=AdpQhHT1gMkNG9TcX88vv8Cfzu6mFnWm6ostKqLAFipxVt6XjVliIZyOQBTIqgBWec0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLSPENv83JbOi4NXxGb2xIxXInoI5COjDIsk1OzfYP1A&oe=6AC91B8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoStyvOzG_oQ7kNvwGjIfy3&_nc_oc=Adqg_neygL33_LzfAEWPlZFgyvBwFOYgIKzw9JJqqeJ0TsRCljHmwWePJyN01e2Ng9I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-OJCp9J8QeDeWBvtZwyqOMTn_uMMvmk3MLvalTbzTMQ&oe=6AC8EC7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgvSikIbxmkQ7kNvwGhDeSC&_nc_oc=AdpAa2aveW2ofpe-OplIq_AnLL4ntENRCK9y_IXZiiRLoS3SpZ9khZemMyOBoT1Bwh0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCKWB8fQw7Qe0PamXeHW6nwEbr_WRU030FyWNB9UPr_w&oe=6AC90AC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-0t-RvsmJkQ7kNvwFTZeDJ&_nc_oc=AdpxeNhg3ngOfQ1GX3sYztqIN2OlGSxO3UDjKLBIBQWUh3yBnWvinGiz2nHubUJ3eL
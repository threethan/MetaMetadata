t-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHK2D8pgRSi5xalWODtQIXna4vttcK2ObqTJJ6Hyl2zw&oe=69C6606C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi8mGnEJZDwQ7kNvwF-lRtS&_nc_oc=AdraHB_DAi7t8mB94qi4ZpGLIEhdtH4LEYsXOvPPh0aib_bL8pKERHw_LLzNvMyEzgA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTouu4-CBtifwKrrnMAEbiYUEXpPQivw_s4DqlzpTQqQ&oe=69C67A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl1IPvH5EOkQ7kNvwH7QH8k&_nc_oc=Adr09jQ3nCbIUjSsx8KdnUeG19vVu9nSceDcKHoOeKqQHOwDtUuXBXbpcDBF3LL1ni0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEvcZBBua_rjK0rOHgf140uMA_R2gOXDQkkfeWQgQPsA&oe=69C67AFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCuBIVS-d-YQ7kNvwG3paM5&_nc_oc=AdrNo_AsPWdxOJFt_vAYab9_4q0i7LCBwBVfYXrL10QzSRvZV13tK72f0EMnObm3cmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyaq0W7Pdvhu9NuOumRvwplmDy4catG57bKsuTaxZhkmQ&oe=69C67D4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5oOLbIwO_cQ7kNvwF2V1XU&_nc_oc=AdraPbqyCWpmDCk-i5VQXtiANCEzUxGfAL4l3YzEtGUcoD8oCdfbxPT6hvAF4NUvRFA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2-2CzKbwuf3u9escuVpP_rcZb84UNCkxi43lVggugsw&oe=69C6867D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0bgnJl_VmUQ7kNvwFMWTKs&_nc_oc=AdrIi45ex0XBYlzvuwKVBCyUKHJbiLmXqNTaYaSM1KJxQVpfpC-NNyoyLEFQxb6wdHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1Iq37Nn33wdb-giArQpk40fh4dldQbPtV2dU7PhuDaA&oe=69C66C89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRQI56XGY64Q7kNvwELOnSo&_nc_oc=AdpVuIfHdma1ORLMwNXRP4sg5RM284438DsIBfDyKhZ3TbKIqu7mYdKUO2Tt3lFdsb
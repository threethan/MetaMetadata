t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sm6cr2BPH_y6H7OxKQwgZziRTnSW6bMlfdJ_tbiP-ig&oe=69FCA62C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJIjh-9SoQQ7kNvwGR6JH5&_nc_oc=Adr3tRH_H2dPfl6b7oGmuY8Thet7clj5LiJJ_dSg7u8HrV1euU9_4ygB-1cqkjVM3vY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ki_pUUvM11aS_Ak0glZepkykGjbeclv0ZUYwsmNfMYg&oe=69FC87D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa67thG4170Q7kNvwFWr21I&_nc_oc=AdqF-X3-MlTP7rHQ87N2GsY9rgBBfMYYbzDmtWDT2smDYhSp1EZtmDKZGqrVLF6nJC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VaWEabrq3JjdGdFED-F5VJQ4Wbxl6qZWa3dgAGPslpw&oe=69FC887E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKdHEHo5tfEQ7kNvwHWb9Cp&_nc_oc=AdpsswoCXfSDay1JRg6gXGRJ9XMgOxpiTMgrQPMzL3mK5ExHeta2CZHurEZWs9Hc5lk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zmsCj6vGPppBz3sNQ1buPk-0aCgwQTGwRfHKFznw9Fg&oe=69FC8ACC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkxY3XcSycIQ7kNvwE3k92m&_nc_oc=AdpdgjZjtiWEyStSrw3NkHnQuVTbsInoorWbEtp8N1SO8urip3sDK0erQ-LQcheh4OU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FFESEVf1MRe7r-Qb4qjbDQXsilOZalc8zvJ36Qf9ntA&oe=69FC93FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUTstrxUJMQQ7kNvwFp43z0&_nc_oc=Adr9n9O8T_ssBa3cDmSU3sS6-KdlfoVwFOKlu5O0PyhFKr3mihcvj5h8ZzFlNOW6hc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7la4Q-M5lcE2AmlvMXqu7DV4zCMFiFW5XzxInRxKdaOQ&oe=69FCB249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXM-NjB8mQ4Q7kNvwFwcuEa&_nc_oc=AdrnTstXhwiJeMW3LlKmQJ7yqsv2cktSyU-Vj-xmdiLJLNvyVHb5qmEZ6LxvUStdR-
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgsKLHhdP9SKX0VPQunUtnrCPYmu-fXFGBg44UwaXvfw&oe=6AF1DD2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sM4MglFnwUQ7kNvwHst3lO&_nc_oc=Adr9SixPNS0_QaXfS4y4LOjJpejlED_Ns2qVuDokKSYPwOZfPAUBX6Hgmar-5REjuhI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfPlTUxdTa4py4Zu8amUyUYQQ_Jc-ANXJqxOSLukIy6g&oe=6AF1F713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynaZn_fmoEsQ7kNvwFQvXCl&_nc_oc=AdqtxGMODbzjtdITCJuzXuY8kPYz1kW8ZUXRWK4O4XjELxATSlcREhT8NNOy61Cg97Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR68puuTEhYHscceB8mvhQpjSBHaxxIUlizpuE5Vf543w&oe=6AF1F7BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd2ZqywJdTsQ7kNvwHXcHlA&_nc_oc=AdoWBpsjUUyMzYRzjCfyRitVDfemJz-OXi_cE30V_Cms8rGTY9s69UzOevo0MhZAZpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXvO3WgK4WvIy0KTEVFiy8WOjOLp9Rj7NE5d8P5Tv7Xw&oe=6AF1FA0C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPKsyjwNvKcQ7kNvwEpGss0&_nc_oc=AdqdM0N-2Z4RXD2ewRKypoynGaWLOeDZMLF2IOZbhVBhrumZEMZ9MbI-wtnYHMEabJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdRY_NC67_NI8NXR5zfXmF6kvYT_okSAqT8m9u7eG-lA&oe=6AF2033D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe9EfUmu5D8Q7kNvwFunEN4&_nc_oc=AdqXFOA8U_HQbEvtxI05V5q5zKIQuGqpKzKLarWP8ZBdt_KAWpPIuE-_MhC59QL-3KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5tIkA-E3kcHfRp5DIorO4sgbHb3WEhhoNNmgloek-PA&oe=6AF1E949"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaqlVlkXopIQ7kNvwFNYahL&_nc_oc=Adqq7BHz6SBzKZ5-mE2Cq4grOjL8S22C419IPOE-2vBMuA8ZIs3_hNhZyIyj-CjBGV
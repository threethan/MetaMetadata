t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpCeJOvua54tlB7uJCwOUnqvon3RmLYCO4rrfXQK0_Mw&oe=6AEF3A2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNT3nEI29zMQ7kNvwEv559y&_nc_oc=AdqkilVM99eyuGMZkSRNmlHoo03lydXDSDWtnOfHMr-FCVBXCcObffVVMyEDm8Vshv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDh98tu1tC4Y-fVZFKBMfp5kwSaVrtYmgjF1dWyTDbnw&oe=6AEF5413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWDrTvAnYDEQ7kNvwG-iFxh&_nc_oc=AdpJml1IggWd6hCGU2FiGMriil6g9zRF5UE7PBRcB4gDhSZ27Y1UA_TsfF8wZ6hiRpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7PbwrjFO0x81LZ1OEihsdybOjwj7HgurA1BbNON6dUg&oe=6AEF54BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nks4Zc9TKA8Q7kNvwF_ZybU&_nc_oc=AdpWpc4Y0HTr_sNC_j_GgeCXiwVip5t97tWq5ZBovOxBRTw5q2IqWoAoLjA8e0n2O0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqZnyaJ6ZOBzOZDxe3tjU8t8ATAsMd3savpT1ISDfoWw&oe=6AEF570C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVwJKBZUrzkQ7kNvwEgQTZ0&_nc_oc=AdoUBCIkNP6-4TL37hNJY1eoWFXFyxBLXN3GY9HXbR5JLuP28D9fmcayPXNGr47ArNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMtxIMAvSLwcx70DyG_pTGGxPrcnLtdZFMwG7MCp5oWg&oe=6AEF603D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe9EfUmu5D8Q7kNvwE62psA&_nc_oc=Adrl80qGFe0o_VOumN61emTWczzzO_Sy5SN5ugyUtbWFEYT3VbEUoMjeDrIpwB5ybvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBzmOFlFc_7g6pXnFsmBvGSyqaOixhKyuKSDSrsSijGw&oe=6AEF4649"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaqlVlkXopIQ7kNvwHylv07&_nc_oc=AdoBUuOM1zSYFwjZkzhw6HsdQXzHm43bWcmv01pwOy7a3may-T5hDVqaykehDAaemi
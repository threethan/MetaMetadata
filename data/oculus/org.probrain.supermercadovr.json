t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc58gClZkcLtWnQ_zDhvbphMUtg5MDqv2-jLWE56wOCg&oe=6AE0B9AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkehAoITih8Q7kNvwFzIsCh&_nc_oc=Ado9D4K9z9hCTeeqNuHbj6U9Vet8-fTcjmF9wwSnPAfDsyvRpzmKUmFi2SBhDw17msA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAfI57vAVgsa8jQdHjqQqVKmifS9SsEkzOpUVofXcYXg&oe=6AE09B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seL8y1x2IIUQ7kNvwGlq5G3&_nc_oc=Adof1HspYN7cNQE5jwOCn12BFJr0Ilhgmb5fxK-O7Mz9EdpjMg04Dr2r9MQrYEmpvbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY4dfpwTd-W8d-MNLsAvtQ_2RB1bSiqRDfIqkly8k2JQ&oe=6AE09BFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P5t86vIw1gQ7kNvwFQ7vpA&_nc_oc=AdqKcHsjL9eLYAR_BV0WcJBH5yBkYGQNNKJh_4aWK44KY5g3P9CZqCyIcvtB95zkW8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOV91kbjmwCQYBZMDglOuFF4n8_lMR4Y7clLjn1nV8CA&oe=6AE09E4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-eoMoZ2-nUQ7kNvwEAPWef&_nc_oc=AdpcaJcQVHl7h3biTLJbcNaP_Mx2RtTtkAbC6c4J1Y78u4wyA0tn5kmuh_W9igCVgTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMREizv325UDpDkKV3Ha2sOrp7ESze8fcZdyLOEzg4-Dg&oe=6AE0A77D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoAmOmC15XUQ7kNvwG2CLXQ&_nc_oc=AdofOXYWSWPK-ehiRrsouNXKZn6ippjqgfDh1uFFRCAY4mNsMAh3_SiPKMtT50DYk0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSihC-z10ZNsuNd3sfNvUNJKkdm7Gkq0UUG1FNpgwPZQ&oe=6AE0C5C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxdYdr171pwQ7kNvwFzzDNM&_nc_oc=Adr3ZH4GkQwRQZ30l-DtDIPmnFWnax4bHGG5Lj45UBaNL8b-Zv7S1ZpspvevKC4J8I
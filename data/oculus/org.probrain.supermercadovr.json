t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB40AV3dPeA67zKTzaHGXzQbMht6LPabRPi3yYDsi3nug&oe=6A579DAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQF-wcTCuI8Q7kNvwHJicZk&_nc_oc=AdpeS17KUzaOZDEMhtq_UqcyIhyAOJgitAPM63bOHUMOMQz6gJaMPajJ8cH2vd4fYhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEkWEHC2y8GZJSmhkyhFaFvxc4xBpOoXcSD6w35ACYSA&oe=6A577F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2YyBRRCaa0Q7kNvwFqvW4H&_nc_oc=Adqjm4zrQpqWQsjbGkgqXiVpbOHXxNIM9ca5cbTUSCgRdS9OU1lyLJLUB9ZEo9_6UJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvaGTm9eSj5P_BYCtf2bg9JNg6kRZk5dGQAQ0RjnirBA&oe=6A577FFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR2ZqwI0dSEQ7kNvwGA2NEl&_nc_oc=AdoMOKNrDfonHaWQ38Yh-Lx8ugrCCGSV4FhOm7YG-BnxWIpeEBF7ixm_64thoN7u8iI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMAl8n8JzljUIQk7GFz7pO1-oKtEv25_p5VYsCvtUU_w&oe=6A57824C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-xbVu5CUL0Q7kNvwH-k8z4&_nc_oc=AdoM8KGMkhvqy_zJuNyHc2u8E5KVM6r3HjuUY6b42b_Hz1R1Gl5edUjqI3F1opoXMwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCByyUvVk7BzX2e9jpPS1p0cAvqEt9QBVXEiTw0Hkbk1w&oe=6A578B7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbW8ttg-R4gQ7kNvwFBTTZ5&_nc_oc=AdqOQh9Trc_cIHlTWjHlu_22GBRI5ZJE5QQ_aLQcVrn7eMwKn4rb1L31dwWmSMVyVwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiVjxRGD_q1wGel57xyK3YsAZoZd5qqLcRMRnmidtTXA&oe=6A577189"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFGSyBcFCtYQ7kNvwF2shJS&_nc_oc=AdqnnsP_j3UCMvek6eT5zsTzFw621-H8ItXe2-erWMLzRGbHJAsp-7btSftcjL-2Kw
t-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W47pQl0jMErkQidlJ3ogdc6pQxc-DOhe1te8uJMxYlw&oe=69E2482C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbqNZvLTEMQQ7kNvwFaFTlt&_nc_oc=AdpJ72Pyf7A1naAYwU2akcFqoqAZFsl9qJgvzmz5IN-Lp6GtKasmkK5gSSBa8dU04og&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IUzDMH5JXdihYZjHHO6NNTubH3P-Eo9IdhhKwqCN_sw&oe=69E229D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcaKmuNaAjMQ7kNvwHzU_ul&_nc_oc=AdqWwonhnCxjW3RryLsW9v91GzkuGqDLBZ9wtuYEIaIOHgCsgwrCphPCwjLVMbFx1So&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_X4YblbgMWEvgDijvNHslbCIrQVv807gYXeyW9bWVrw&oe=69E22A7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xxeob9lrTtcQ7kNvwGVKR1A&_nc_oc=AdpGF5_AL7-qV0JgIVBs8x2oxb76HIAwxD-3Murh8PulgCK7k4a4LzrQILiWOB6Ap6E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pEp0lArDPaLgFz3qdSqwTcdi7XIAwkCYNhhRnl3N6bA&oe=69E22CCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56sokDmwgQQ7kNvwEUcaDD&_nc_oc=AdoFvwpzkwYoXpWMFSB6Q37Zu0_H27Uf7i_AVQiIqzHyucmTMQQlsz-GGAW3enL94NM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fMRgpUjk9qE0QWMK9_uItv-jF5MMCrcWoU8cSS2pI0g&oe=69E235FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xat61WGp4DEQ7kNvwFvJz_W&_nc_oc=AdosvoWfkWppqarcqC90YTsuWrX0dirn8KMb45MkvSTeZ4B9KUhdbeUsR9SR5waiKF0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YpnvvwmfrRAwxtF2puWer_JTYlNv_Vd_ZRdE-7-5ANw&oe=69E21C09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr4H0dBvdfAQ7kNvwE9pI8l&_nc_oc=AdqztGgYdK49PiJRKBG5mxRRPHOZAq0y1BuAcricurLObx8se7qtevbEhSdBECr9HZ
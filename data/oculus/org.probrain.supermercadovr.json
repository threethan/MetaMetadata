t-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DfeX-Oc0boisqhGNFM8JWaH3BCFrnfu8CpX1LgpE1-g&oe=6A106CAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVkuUqTJF3oQ7kNvwHUIfPp&_nc_oc=AdrpiG8FKa5pUp2J4XRERf_DKzYx_eulo6-BOMMtgtgHONZNWSiEreebQBtVK78JMbw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZNtjL2epzxi002bkixitJFhgtnmqj7zQfdxN4grVHFg&oe=6A104E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTCmRmK2OBQQ7kNvwEYQGzm&_nc_oc=AdqD8tQc7Mlr8LtooBMwt6c1iFBBqcCtZ6VkXLtDTHW9Z40GrYhX9NVsJORsrWgot-0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-VLtC1hdpPWCF_YmmgfTekYaRbt0WrU6Y6-yEtu1aRw&oe=6A104EFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-pUyYcvyQQ7kNvwEr7yXJ&_nc_oc=AdpiW7-OF1k-kQny5dWdKWeh264z0wu_5rLvrJoOmP33z6vOxrPk0NbzHjvwGaQ4bEg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5334aUBObiqH9mQiOVqZeEPvyjaQYNdcN81Gp5SbR-Dw&oe=6A10514C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf4gYxM5FHYQ7kNvwEF_i3X&_nc_oc=Adr0pVJSnHGEO0voA3E41cYSucqenuIjRFE4RpPLb0kOYiuNm1QC6Em1gT6LhBnVxi8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uMRZ-jEX22DQBuIhYFYIo0ffAwF_Vwm9PCgOeCBY-OQ&oe=6A105A7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uICekZkCUMQ7kNvwEFjkyp&_nc_oc=AdrM-ZMKIe3-wKc31xjDg8NK9HHtS1LnVb1Eix0xz4p4XZGCpm_6hXIwr2_qKS-8Pac&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XzwTcOHaiPRYiewITAR3iLaGFjAUtfjapWIswfaA1aQ&oe=6A1078C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpT2DzXsVdMQ7kNvwEHEul4&_nc_oc=AdrClr7SWbZtBsC3hPcF3kEHX1D6qHkUtENMZNSdxL0pTnWEyQpp0OjqfzqHZ2yr2I
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I2iSZGBThDvFY8WtltpL4Sm8nbZzU5WJ9p2kQfY91jA&oe=69FA032C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rm9_UyKttcQ7kNvwEj3zGg&_nc_oc=AdoRpg5ovJ10RtAr0ZgfGKrokVx1Qek_TLbLqyPr0555G_blPmQ1NS9dvzGDbWu7Hlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yKKuhaN6qPqygAym9a53sRxafbVL6I40o5A_x2RxTgw&oe=69F9E4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF5Wf2OZDUgQ7kNvwHNtqDZ&_nc_oc=Ado3gcHANKVAUrZ0MOh7PlhvgCI07kp0Y_RXUuRfQ7zEupHhId7blgckAilz5BghjsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mrmU3s2eTL4tPLyI2aklt35YnDQ07ur_92Du0O4IGbg&oe=69F9E57E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18U_b1BIWgQ7kNvwEU2yNc&_nc_oc=Adr2--AWFI4OV-ODUlB4iqUTbCe63b6nhzpZ_2yvQahl_XajqbzSWjTmCMCzle4Q_F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wuF8IS2ZQlc6UMnwPtB8SP5ipGDbAmTa4IgE2cvGh_Q&oe=69F9E7CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9zR1m5pBzkQ7kNvwHUsqOJ&_nc_oc=AdqYnwpVTwArrymho2AoIHSWWE4-ytnsH8Se_e2hr8bWvfxmBKgydq_D_wdlUuGTmVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GB67Q7z3Jy-kJDw2b067OAFz3QBpR-jMF0Q46BZ-VWA&oe=69F9F0FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUTstrxUJMQQ7kNvwH6ysCl&_nc_oc=AdpmZJAKhILvr7c3sLj7C5NhLU18DVOrGuG93OLEMtYWqVdTXQjvvs2Doje6EWtX9rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tbGNPWYmuWCWiDF4cT_C10uh5tJgvhSVpLhauCmYGzg&oe=69FA0F49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXM-NjB8mQ4Q7kNvwFMAr4H&_nc_oc=AdomJjae-8zIyHE-68Owfe5qq-4QB6cnQL_WoHHgnw9e6S-ThZqelJOjdXebxTUcHm
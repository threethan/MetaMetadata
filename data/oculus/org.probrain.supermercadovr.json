t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQcHY9MsRIbOMIn9dFIUNOtNapE0z9J0YvMU6OS85Bqw&oe=6A92B8EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01U_fVeP37sQ7kNvwEYac21&_nc_oc=Ado53MiLATCxDkaRbKgcZEneOfYvU0DgQHKNMnAD-MM5-xEA8wr0kyw3ywmUnMv5lKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp3Wcald09dL4aOwp8yDEqxOoEaSdtgzKqmG_7ozWIug&oe=6A92D2D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Riz-FzY-ogQQ7kNvwEUmts3&_nc_oc=AdpaisuVcmKb-qFqFRdIBAfKEQPWoLRSko2InRN826oLX04AAvV-SrD-VOTtTgiR2kc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkBof0vynulzRc577U_hbo8cHAgfRt-Y2Rdicmvr3yDA&oe=6A92D37E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcnqC1kFkAAQ7kNvwHQh6Nu&_nc_oc=AdpIbOwctvadskGdRC50izy4FirHNF6EsXII0dTArWjfnRjMfVJH6a6b7BUc1cwb5fU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgIgOoroG8fTBli_2HWajPAFmvdMqaldqAPFNpedGKSA&oe=6A92D5CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2npVZX9v23cQ7kNvwHfg24L&_nc_oc=AdqtgaJKItfc-cIr-XsZVO3Ng-d7HdhKNmFSd3Unzk3Qgr7SPM9VGQdHQFHHMllROlE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtO0G9-F3goCFeXTnqlQpcOYHQ3s_8g5uG7-wuyYuhGA&oe=6A92DEFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFUBb8-OpPQQ7kNvwGXMwYU&_nc_oc=AdrMhOodJMsurwhyvW2RotjJcXFfj4EXyKd9imcLM9Exwl-el4gBN9kXm6_kj19aHIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3hS4q2k1XU160rbC2t45ceNIxxlhaKfI5Bl7UI9MAuA&oe=6A92C509"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K437pgrR9aUQ7kNvwFgvh9F&_nc_oc=Ado4aDF01ree7h-HBlpGLxt5qv3X7L08KYGaoItXGbFBHbluiN2QnNIfCrx78gnhvz
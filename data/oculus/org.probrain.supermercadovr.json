t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3yXtiKnuMvWvwrXaPNdB7nHPCwSSuVAaL1nzRcSVCjg&oe=6AC65BAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMyTQQ6f3PQQ7kNvwH-pfhH&_nc_oc=Adqw37MU6ib1mn9xl2iF3WbUKyeT7B49gpD_9DkFztG9xlL-E0PCQ6_4fVm-n9iUsvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND8XLzYC3WAoTG4UQbwVr7fVHjueEkqZTIkJzX7EIvzA&oe=6AC67593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brpULQbtkp4Q7kNvwF1tYMO&_nc_oc=AdoE4fn6bPvHC-QcWC-CR-zMBg8SpvCX-I7_9CWNGx8qFO7D-7QILbOObXYMNAhmq_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpVlwkpwbMk6ktxlSLjo-nG9blfs2sX5F0ccLrkAkYFw&oe=6AC6763E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzJM6mVs5VUQ7kNvwH-m-f4&_nc_oc=AdqpWM-ZM0pigzLKSUGeVU971keDEeUrRoEXN6_wCe7L09gv7VF-KP9GYsKCZpyZlb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcGjBEj70KCllQNkjdGknLTD2r0QfsYm4jYisRNRmOZA&oe=6AC6404C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoStyvOzG_oQ7kNvwH6KwoC&_nc_oc=AdodEDhwNL75HLjV9rp1JNQSWq9rdERdeMr9XWdLcpwk8D4oMrtiIo9wCVh1KJsPvz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz4NaqELcD1XJLpUujwm7lPjkdvf4rRCF3YqbDbJnOAQ&oe=6AC6497D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7ym1WcD04Q7kNvwHU_p7W&_nc_oc=AdoA8DEpi5z_GmbLa7Bin3wVlDn4XHTr6YoO0cpuS8C1X_ZR6QwLyfTJ6WyJ-HXfhw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKNp7escGsUqfOZKZaUSMzBx_TWoMwH6t42CBmoXvfDw&oe=6AC667C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFccHqGfKSUQ7kNvwGBYXeq&_nc_oc=AdocOfOWHmsfPO7vbub7jLTC2OFUYrzrkD9tD6vQUfBzy28ZvTP6Ya3Sdl7lk-TJAC
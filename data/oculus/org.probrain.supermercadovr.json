t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kt-1cH9jK64GTTcPLtLzm3ThQoKe2a3AJ8X2rAupk_Q&oe=6A0B26AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7W0N-MHVG0Q7kNvwGEkWPX&_nc_oc=Adp7Yo97vkZMWiT3glQNuSwcJ2XlsljlmEiu0JEIWlo9KrVdOUSH9Uhv4mSVV94h1RI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YKYqhuzBjmQ_fH2-dHtV8U-IcuEiDKEzRFVx2FZBGbg&oe=6A0B0853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxE1Zb8sfsoQ7kNvwFR69im&_nc_oc=Adoj6yI9hRWOPx9VWdmTuKttfFaD87b88zq68YBSoOrvCEjpgv4LCZLdd0W9lc-odxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sVfkQ_Ttlrwf7dg_66UZAocn8EbDkjy0ob-Cnu3ThpQ&oe=6A0B08FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kJrt_AYG24Q7kNvwGixKSP&_nc_oc=Adqe_0Csteqzols6yGSta3UNMllHhBUd7lE8k4n0XO7jTiq6jpHNV2_HCsRAwM7irpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wH5K4yMPzXfVU9djyIXKSnq2zEmshDKWFeAvSiJqrZQ&oe=6A0B0B4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuT_ipdzolQQ7kNvwHlJa_q&_nc_oc=AdpbVAmDjD_-o8MFO2Ye601Pl_sG1z4bmK2wy_Wk28nGLvH_NgOxBi2qO6vxIrrTzwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sWWh7DQm7BqyvngowqQ7bzntClFmEhLs3JcOB1xTovw&oe=6A0B147D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SZgUk3mV4Q7kNvwGt_Kjf&_nc_oc=Adq8m7VbkHtO3day_53DAcwo3c1S2OjQ0x_UfKGfgfXA_D-A0qNL3yYFHi-VajRUans&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NB0It-PxZeqj-TfZkXDau342TTEEphB29GEro1ZsqCg&oe=6A0B32C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej9azlnhvwgQ7kNvwG1Fahp&_nc_oc=Ado4ayk1kOxIxStwdsAKUQs2n8lBJOc82Reyl-v55ym_rN7PyQRf6UZPWn0m6lHUNE
t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NkbZfTkFvqUHUzxiFd3IhJHEmWosXPa_dZ3zDkQ2xtg&oe=69E399AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyzae09-acsQ7kNvwFNcTPf&_nc_oc=AdpktenvERpmsy1jdKdKRT5P358OEUta5YqkkOKdU74h-5QoZufg899iRYxoOyTZ6_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af222YImACoWhl5sYNrlSrwUlGb-gkTCYlZbT5QVOWU8LA&oe=69E37B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuXlxFYpIMUQ7kNvwGgSW75&_nc_oc=Adr-9fptFAA5ytmKi-Guy5Rv07xmVjWJnC0O_392J75sn2xXtY_mgxHAnd9XXyeYfwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2upOtkPcIPkebYxghDnQMj9xeTIC4DNn9YH6kAAbdzwQ&oe=69E37BFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xxeob9lrTtcQ7kNvwGJushm&_nc_oc=AdqYMnpeeMniEVLSxi0OHYFAqKJjG2r8r89lvkakSmL-eGglEGpNt1beLCOSKegttPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ykb2KNus7F8xLNe67ocHRbfQklRf8ugP87YKBMT1dWw&oe=69E37E4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56sokDmwgQQ7kNvwEMaCcO&_nc_oc=AdqlzwCORPSR1yTw1CmiNJxBz9CdcoNsMKNoT5TkBU0dtpIOuVlMuCoVWuNolhcj2uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32qU1G8hx-sXYM88VapbPXHhcrMUfdG41CEmfQ-SjPEw&oe=69E3877D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xat61WGp4DEQ7kNvwGMAWz9&_nc_oc=Adp6h3A2jFh8lfHtEnUKcOJpJA3YzeNu0ZBR0wsS5WLPWj4WW14p9rViBJVxq6IZQPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25FsYxWyv1McJJL5AOKgF3sGeM2xdPKotmlOav3YXPhQ&oe=69E36D89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr4H0dBvdfAQ7kNvwH8Aavm&_nc_oc=AdrDjTRjXDWgzx7wn0HGkIP6t09SczGiyzhBqo0zaqNRy4uY2irCuMfEMxwb8DjH1v
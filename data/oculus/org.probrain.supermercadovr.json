t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM8YorLHHyRSFHA4mg0m7UOQGAhPsbOugzOx7R3KtMBA&oe=6ACCF32C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE_BVyzipDEQ7kNvwEgu1S3&_nc_oc=AdoLC9SrVNnlv8PpI73SxyCC8yHRA2AdCCP_pUhwm0WnwtbCAsp4hnY-7s_kPQt4IMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONr6WbYUgxSB8vnAkk1ckTV9Uqe9yI9uQAPJKqjRoabA&oe=6ACD0D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rL2Tq8OAJ8Q7kNvwFTh7yc&_nc_oc=AdrgNU4zJ2wQDk439EoZ8hv_l2Mq7xA7Mc25VWhUnEMGiYe3Z3wOU_lKZkrwty6dvRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaj0L9P21wdGvXXchDG-nLgdxt-fzFh9iVtbjKMiknDg&oe=6ACD0DBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_KwBkY78WAQ7kNvwEYKLjK&_nc_oc=AdpH94zCew2t9vIaYXdjkWZirrsodQ9WDhcaydVQBrjNmBuJOhkq5RVz_Kb3pWr4ma4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIm3bl84Cs92Q3m84GXxyJaiyvIWewQeRLjR_n7VPmvA&oe=6ACD100C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPeOSHDWtGIQ7kNvwHbasqN&_nc_oc=AdqxW96j5VUV7Oyg3U79vw-JPDDEZkXhV8WohryYorDFV9QtLLxSmfWK1bbOMTEWpMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWcXYDR60VfcYaPnkXleNBH1lLmkGh2pa044fJDjD-TA&oe=6ACCE0FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWG_NYGGfM8Q7kNvwG_Z2u5&_nc_oc=Adq8SPQA2Oqr5onELCDE0DzUnNo46_pdsysNAvJKmufVcLTgEmtN7l-q1vc4Q0HptBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC5BrsLtL1VhfGcRKnm-82hTOAd7UOOf9Cnd4Wk4FW4g&oe=6ACCFF49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiaAfvTxprMQ7kNvwHZ6iAS&_nc_oc=AdqyHa8FdKrjptlTPzg00U59Booa9XJuSZo1Js34BZErwPDLoYjqL8H3B1DLKnGP5y
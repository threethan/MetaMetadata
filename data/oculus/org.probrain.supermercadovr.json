t-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6eRZWNCgrmfLWwFAX1C53d1ln7BIKblOn1rSnmMN9_g&oe=69CFD32C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wEtUJL9XkUQ7kNvwG62vbL&_nc_oc=Adriul0E2k5kIB2bmtpJFZjOGYCoFK6o8nKMbmgtCIQZlE88xGPce_X4IcWpOk1KpLI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw08XNHsHuFI9-51QvQoclou7ofzxofQ5xfhwnEFtHjLA&oe=69CFB4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLv5BK-D5hEQ7kNvwE7XU60&_nc_oc=AdqiWPvur4Mv_68Hb9Zhq-KQ-73AA0TNjT-ef2Dva3xWdlBjAdx9vTGcHB4_NatUbj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCPR07OcTv5LuvuKc8Q27ur2C4sdoZ1r9mPsGAdoIJvg&oe=69CFB57E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9Aovs9oiOkQ7kNvwGjoKtG&_nc_oc=Adok3IWv1sEgAQPWuCKy-F3Z4vV3LqGKngjL5XkWv_uZh-zQqQyry1Ne2yiJHh9CaKo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXHwc7pFRjJk-T0enSQbYeZ1DHqtmWHGLmbxT3gCO4_g&oe=69CFB7CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGblK7dZtxIQ7kNvwF-lH1z&_nc_oc=AdqpN34LPgyGfGFvMFAnJD4hTOy600v_liQ2sMfj9soOtlVpF5fyX9RWEALnyo5hKjk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3nwOqRLewi4fT4Vwr4ij4Sgaw7jQdd0kDB6WDf__9yA&oe=69CFC0FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR3MRFV-524Q7kNvwHAs-90&_nc_oc=AdpCv493s_FDnGTqPqcAsg7tkoCJPN4MiTWO0n6fhic5angA7a-WtkgOBRHvFIgHvE4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNiFJ6NEm-kvlXTCvySMct5M2Jt2COmOfjt0BU8JJeKg&oe=69CFA709"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vQfsjYXCNoQ7kNvwFmtj9g&_nc_oc=Ado30ITtwDLR2bWXUWIkjExRQcei3haGIzVNKHw2rKXA45XS4cBE8hox-Pua0YP5NF
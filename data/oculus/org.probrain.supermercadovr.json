t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yxti-3VwmL11nHC6wartu4teBTLJVQh1bPnZjRrp3Jg&oe=6A4285AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJxuRa8ra9QQ7kNvwHNpP7A&_nc_oc=AdoSN2q-avggxicuwlfBFMeyCmImBeDSqGo36JZTht9SAHoVG0y6GKoJ6wEr6UOP-Bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-blQdfDQWfP1Nb-jM-FAHp5awwVhvJvnXIbqTAwdKxoA&oe=6A426753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDfIvF7L670Q7kNvwGtOYPm&_nc_oc=AdrWnkms0pY5-TkmevXGYdC-ysdOghgb8rIEF_ChFa8XbMMf3tqYjKH5awJnxOuV3gY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Y0koZYLgpi7i-6URMHLmZLcTQcilIy2LmK5tzvHhDQ&oe=6A4267FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaERTAj_i8EQ7kNvwEwt-dX&_nc_oc=AdrbpVpAP6HuJbn0-BGMZiTGV2ftAXZBw46STPIjNvziDrgaHorSU20uzAHNBqx59v8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VR6U-bIUYXbSkj6QKHp8BeKlRdikQ8r_lajYygoTceA&oe=6A426A4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7NhwfX0r_AQ7kNvwGuVrGh&_nc_oc=Adr8zxwVhUIDDAvdOptmo4ZTzECIWsBPILAn_xDKkQ26UMeSzSttSBbJ_NkFtBHmDQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H7MSgdr6QcD6OhfIDlMMCsBerRb83fSnsfzlvUSMbog&oe=6A42737D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzl-tGO9yz0Q7kNvwHeNeF2&_nc_oc=Adq-9xkfgHtZaImrhbGlRN4btgrfx1YHAHRDoU_5ROgqnQoK7QSBYycRNhKhmCOnF8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hQa7E5ALsVWI3QBY9Oh1GLJ_0AmPPuXIJKjWbSisWGQ&oe=6A4291C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkoCdaudSnYQ7kNvwFEEfta&_nc_oc=Adobj0Z0SH0H91AaGOrpZtsrZbZe7wHuqMlyiao7YlvYCEi6ol_zxj_zet4_LurXM6
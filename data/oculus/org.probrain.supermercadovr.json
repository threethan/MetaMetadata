t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4t2403XjBKSZpBkbh8W9aOXTpPXns9MIcyEWU-5DmhQ&oe=6AF08BAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sM4MglFnwUQ7kNvwGgRry-&_nc_oc=AdpKiyUeMFPUynPShkxIBjHSuKXV1EsTRCj_edo355XQ96Cr58aONjCUlYFQUYxPO7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIr_TNuJbz4QDNdos_MhtdeRpsOpeFGUNZXiv5q8GTuQ&oe=6AF0A593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynaZn_fmoEsQ7kNvwG8yrTn&_nc_oc=AdrkamJzOR-MkQgO3nVPw9Ti84BSAwoc-CuhhqEk3oGk2trtqa3xxTKSsX_c9j6a7lM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoHeFOAYiWsn82OrFMtJaqFAZ9bx7ie3d27rCIKc7R0g&oe=6AF0A63E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd2ZqywJdTsQ7kNvwFr9Dku&_nc_oc=AdpvmgIhgbESc5TBDFv68mt-lbCtJi6e-oY2RIxmh8UjtxX4zZdjaax2qABAr3cYXeU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgyvxVrnshQ6pCs7yOZr_rqhAl0EPejLPrfqzvlr-5UA&oe=6AF0A88C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVwJKBZUrzkQ7kNvwHdSsqJ&_nc_oc=AdqooXrpYV8QVIiGymu8S23UzBbWw75hKQnQ06GeRrM63YWQobED_UjvK6Ws_c-jvFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiBRkFmfsuPmGw1BXOQJTWUWDJIM-xzLYjzVEExqq8Cg&oe=6AF0B1BD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe9EfUmu5D8Q7kNvwELgn77&_nc_oc=AdopKM2OTMgpij2Z97NBF4Az2VI-UQRmXB7DZaP6eampWyvMU39A-TQLgDFJQxhCPgM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ81MUOcjtSiUfY1FRXqnpDvjsRGiNIt7772RvW-_ELvQ&oe=6AF097C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaqlVlkXopIQ7kNvwGhuc_e&_nc_oc=AdoMNyr_o-48F2zfXklf9bhDpiFySWxLuTZUQW1cuS8cYDAg7Q1KHeSOCJr_lBGz6O
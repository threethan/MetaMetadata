t-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ELPIaVlSfHjUQw01cGQdF0kK-AEmROahzmYMhJ8dB1w&oe=69F4BD2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6AogVasZ1MQ7kNvwFVsEVg&_nc_oc=AdqfRC5AHgvyypH4mQaaYjg2zpdH3jXLBDjDIKrOJHgppp2YIi3IpPKIpR5rhm57TKs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tLw9RLdYoUeHRLT0MN6nQNXEnDUKHO9LeHlSDaDiAWQ&oe=69F49ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx2nrKyWHk0Q7kNvwFfTFeg&_nc_oc=AdqBHGPRkZlwzb5T3qVG84JBs9FAUu8VWM7xhcom88wikAK1L7y2MYj39tyvbBIRMqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ySDRebH7VHUJxmyQHrFai-yPDr7lGOofpS-1wS78kjw&oe=69F49F7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rr7sTGamJQQ7kNvwFMWmXp&_nc_oc=AdoOVI1_HgGb8LdjLYU1m1Q7uMAtzUXRECouczi91xbHRKmsvq9zgI4EuzqOHCyohnk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VeEN30Hn2fiIBuiw_2HfXQYkdfQrCzrWpLzIu47NKmQ&oe=69F4A1CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK8gbdotW0gQ7kNvwGCMLgn&_nc_oc=AdrJtPLftBAxR25be01WNz5OyIw8NyhSxxPPvkTqOkFSiw_AoaEYRthPozZF3E10Zfw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MtbjOdNudtA2bTjW03QwhC25mHpppb_NgwV-_oo3-YQ&oe=69F4AAFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ncs3voNsXAQ7kNvwGR9KSC&_nc_oc=Adr54lVJgqTfdXENbGx-Y_pwNVJ_lGKV-ruV9q4zakTP0QEFQA3ciTyY6eRH-ux3UHs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kFwQrJtAS1LnVekv8LZEX7MGgB7ziBspX-FnBCISpiA&oe=69F49109"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNkFRavAUH8Q7kNvwHqG0fa&_nc_oc=AdqSzHpGp7VxVS-H5GYOwzFPC3LEt2YLriLm4W6ZHIbgSVJs4P1R-JO2s_QZzfp2b6
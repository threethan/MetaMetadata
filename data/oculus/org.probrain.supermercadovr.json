t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFmVpQotXKai-j3SJW53-1Yi4caiFYFMblIpqLh8dDwQ&oe=6AABFDAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiOlUtMmaAQQ7kNvwFYxdAy&_nc_oc=AdoeHvfE78lYCbGF1MGIveYXlyUEOdjwLdfjFvzRFjrzoupxM4LDmw_cRoJtbCvoF6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOjWkzKglkyxWoxE_67ZaqcyiV9rsPRJCH3dnBPMsS6g&oe=6AABDF53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJAUjr6UmE8Q7kNvwHGJVor&_nc_oc=AdoxN7CKIuxRb0ftpW94qJZhlsLtdJQrSffteJq-g3YH-ZprSs8gjUQ16wwjO5k1iTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZhpVxcFtCgVH0ggboGKw6EuMwV-n41KK4qQabK_FGUA&oe=6AABDFFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXYeIWjz1zoQ7kNvwEtLnjz&_nc_oc=AdqeLtil3dzUD2Hpk_1khSEwnXSe44eZCpIGGNX9TO5QPnS0F4U7tp4239dKIiC726w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDdFQXlkE0MCR1ztB9znnlgBjP1Bs0RMhiwRsJGYOrYA&oe=6AABE24C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHHbom9DmwkQ7kNvwGjbwoS&_nc_oc=AdqKK6-X2m9nl2mhOg2i1-pnKfFlynFf3c22zfXU_Z9ESl4aXPJA-YqRhfs0pRnO-K8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5Q1fnDLLAsOeML-tHPyEAf-g0bg9Phk9mJpUJTeyfVw&oe=6AABEB7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts45OQqi-vsQ7kNvwH9OG0I&_nc_oc=AdqzSDjPtu-EOegcTxdCOjEhVyBArqNYxYJARvq4rYAuY0fLExkepjl7X6VOrxH-n8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrK9ZNRAtj9G7LAfEwgA-fr-x9a1RuGqT2XKccvzhuxw&oe=6AAC09C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78vXgLxG5y0Q7kNvwFQx-Et&_nc_oc=AdrCDOjDyXQip5ea6nsU-GSUf97Zbx-pf1OVRunQr_Iuo7gQUdJYzIndPb_m_Vk3iu
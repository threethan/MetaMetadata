t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2zwETsafgfrJWOaZhtV9a0KeOSepwdXBPXix3J7DWHA&oe=6A564C2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQF-wcTCuI8Q7kNvwHXvd2v&_nc_oc=AdqFxP-aew-SjgGt_9MXf43QaXAAeFZWq-CJaxaDxyorfykJejrYXUSsr10S_6cE8Mk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZwhy2ZcflQEjaiYrK7HFH8jvLiD-u0DgA7NsnD9enDQ&oe=6A562DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2YyBRRCaa0Q7kNvwEUNBfi&_nc_oc=AdqMrw6bMcVlz1mP0mYtzbmskuq4Vi0UK500R20wN8cVShf611E5tj27fIlE75LxcN0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVlhgifYrrNn0aB4Gj7MTKVmlT0Z8PNFu4CAK_yQ7_-A&oe=6A562E7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsFZyts4S2AQ7kNvwGNKmKZ&_nc_oc=AdqjkJKop0IPVxtWHjQNrydEH3pALEe6nUCs860ff8Cok9cA5DlLnHucl_1uA4jAzfs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8jnbYFVgyOeeR9eCIlVUyX4P0eiQx92XL8hrjau47IQ&oe=6A5630CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbzCBE1_IdcQ7kNvwELfUa1&_nc_oc=Adr9-qce3xXuEVLpPoLIKN-TLBKYPfn7B902xLg_L4t6yROEGPpNUG2qEh_vrU3NQUk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhaliEz9mcFDL1RnJhiC9fz7Zve8uNSxHVbSPC8RWYPw&oe=6A5639FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbW8ttg-R4gQ7kNvwEytN3X&_nc_oc=AdqQF2IwU6nPc0vDk3F5D1N3g-STOk1XngrQShDxjyusuOFLSd-NcqvfI7fqyf3zk0g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1il86RBlbmmlKTevD0e8UhL6LIidl5AjpHU_DDTpMTw&oe=6A565849"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFGSyBcFCtYQ7kNvwEJrVyC&_nc_oc=AdqqH8L_-OTEzgoD7ueBNne3oQWdd8sXd5coYPFXhcWoSw8fOC42WU-ivGoAZXoO_M
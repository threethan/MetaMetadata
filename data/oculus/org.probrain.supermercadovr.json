t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g5EtjaYtIDJ6Uj4cv2j-HkHjQ6HTGaNRLuSzyrmtHJA&oe=6A07322C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPiYslikxvMQ7kNvwHlG62n&_nc_oc=Ado8t3GwKOVy_6H2iixXF4qsAg2Q9ec-mbdN8FFeW6sHaQmHIGUdqi4YjHhcLU57B28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bbyd7fcx11dfuas-MBsW8aqeoevAQafPMgKuBAMb0OA&oe=6A0713D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBO1UZV-QoQ7kNvwEwVb6g&_nc_oc=AdpQC5oq5e6oC8eJgrh9LSvhlSXIDrNbJ_Qy_iBG_eJeT0tR5VoRGm5pgolw3-h5CuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QdQf-buKuZurmxvEA2o_zG6WFwOUps16xVa0J3navuA&oe=6A07147E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Psdaci10-MQ7kNvwEdSsEg&_nc_oc=AdoLKzW8Yn37-SI6HsGLpUQRefpyzEclPTAljdiAV8MWcpOXyrurT1zvhhESG5em3S0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aU-kHCGH06HfCGV1tZnC__BoV6zXz_z_lU8z_Rnio2g&oe=6A0716CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zwHGJO9F-kQ7kNvwFtPYZ-&_nc_oc=Adrsp__kyGHA2iAnOsY9CINWgdq91Egiyz6yUnmDTp7PWCIJ_p3zx7jkFcBZmoEUZHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YwYjmyqJ2J3HMu2DgNK85S7gVC9r7fK0I2GmofpgGBQ&oe=6A071FFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMLSp7ImF1gQ7kNvwGtzzYW&_nc_oc=Adp5NwQdUlh8tP3YAKQSgvRGQ0bRvTjMxY3wL_KdqviIla7ODa7BFFFHqJpA_NQMsSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u_PXR48WyiwYzHWoQ5WCJMyA2WHFi_uo6XO9LHz-bUA&oe=6A073E49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOXjhNU1tHsQ7kNvwGZNbTF&_nc_oc=Adqk51YYYVH-Uxl8z3pj0Y6sh9kTuCZwAhQxQ_S12W0HALl6DR_RL87Er_WpIX9zAV
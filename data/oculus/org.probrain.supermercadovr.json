t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWnVEGDtpL5dNGz29UKK31V4esNW8TI_Klj30e6ANo-A&oe=6A70AA2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amXWXgBRLWwQ7kNvwHfw3GX&_nc_oc=AdrmyOtHC7Uz8hTC-wFJf_I-bXfMmBm_6zj4t2sIHnuDsjV2whE_JfuxiFGdpS5amyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFurkZNtQQou5ZLqQYe9Cp_BVIg_4QTTqFI4e_0NWMKfw&oe=6A708BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q6A2DBjUuIQ7kNvwEEFIY0&_nc_oc=AdpixtiSkTDJW7PTldEy0GHKcdwAzK8C-YGMLIVM2dx7hO8ZKdCW3xPF6Oiq5zDUabQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc7Pd_fyTGPqtEV0RQyT_5IFYYPZ67WM2Ju5Ofl7ie9w&oe=6A708C7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uc_FFBcDvcQ7kNvwG5cLL0&_nc_oc=AdoXMxKFxDA4BKDJaida3UrYJzcQ0x4Vglxn4ugQHoil-3A-ZdVHWqqMffMQNdBaqYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkTjL_46mSQTe03SP4BHAKupx-W2pP1OkF-pl1fv1bkw&oe=6A708ECC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enDUJgfsyE8Q7kNvwGO7RmQ&_nc_oc=AdohXmqNwJQt4vdxqSO096RfYGd8vDMgV8AN9vxpjkF93gvLoSZ8_d9P2y7Y-Zh0U3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUOZ76dd6M30JYIUhCm4Qw064KAR5qeb54lNK3lOby0A&oe=6A7097FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haVRKwb1ltgQ7kNvwFXFoPK&_nc_oc=Adr-_K_cBzBi5Wdsyfd12x-Yku_5vP3Ou8ysKrt23vjqm_7jqeA-6O16s4_SgCvKVfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIsMmO36qUyGplMU69fmZq6w2DC_ZK8x7JXfYNcZSJ5A&oe=6A707E09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb-fOdKQlzAQ7kNvwGu_OKU&_nc_oc=AdqCRquGu3yLFBZphHLX81gXda5pIwUbmsXlqt4-DJhSqNd2NVA5CkZxThi8_1y926
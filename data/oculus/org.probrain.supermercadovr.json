t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n9SGyfxYurecYnLGq4FTZY68dUOApDcDjGn1_VbYLsw&oe=6A31622C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrrEugcaeJIQ7kNvwGq6fj6&_nc_oc=AdrjkwMOhEVOgZQrrYx2957_EqXXenol3xZ7ORHnZuYMfcn3Mu690xtIV-g125zai5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NOnXOkUQ842Oc29DYpuxYMRg89q8HUBRog4W7mLIlXQ&oe=6A3143D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EElOEeULB-QQ7kNvwEcS19o&_nc_oc=Adp_4h79zjpOhj38QlhaLuuDWQy0RyrF1MhKa5isa1YOe4vFZ50V7bGt_YMlW9033Qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ycgb7w0_egjhh4q3K66E6Ktoh-bNWj3qBPwTQrw0ejw&oe=6A31447E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjG4QQPn1ukQ7kNvwGTIxjA&_nc_oc=AdoVToYaP75mdHUH9BCMCeJk7EweHKcw4PK_siUMwUJZh8vUvbknOMFClJ6idbq_YTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aBA6XniUbAkzmv_QyT7QDdRDpnstYrTNVHbNjdLNM6Q&oe=6A3146CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-LPssD4GIQQ7kNvwFBLm0b&_nc_oc=Adq2s12GiU60mti6HEiRMisY8CFdMgYRw-BJ3KPWBjWQZYUl8nDiygWwgFcZFQMtbP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dUkaj2vbwfy95OggmsiCTYvpd7J3VHT1WLEudYsbbFQ&oe=6A314FFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYrPYDSSYEQ7kNvwFk730c&_nc_oc=Adq3Iws-KT7Q7HyZYo1KePkHp_8EibORW_nraaVVlSR82uUwvpU7x_cjZ2A9eN-Hbwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_q67zSWHIZi8QXf5POiq0LVZwolU1ZSJHk10-woIL4g&oe=6A316E49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNCyTlZlgkwQ7kNvwGdKv7X&_nc_oc=Adq5F7Vq3JNcODAjuY4W_zxtz7R08d-fgGif559WNySeeZBlADec_Bfq4sfS5_DghN
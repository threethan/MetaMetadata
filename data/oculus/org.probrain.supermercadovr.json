t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsaf5kglHLw3tzAsmUqSZOvChedmgbs8CSBqKHTwjKTg&oe=6AE9F42C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcSzIhdi9U0Q7kNvwFU8nhI&_nc_oc=AdrxI6WRD3pAJJeTANm5TZ0IQqnM57nanIrlNG-mwncuJf9CSuQCxHKmr3MKTrjLq10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkB18p8xIIAg2gfw4yxfRWQ3L7YBAQVAt2KV4aJdQ9Gg&oe=6AEA0E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KSRO34Ip_gQ7kNvwFkeWHz&_nc_oc=AdpneOhJNJglbg4Tmyin6Mr3WOLKGah3HNrtwCe45TO9uDfxRP919IXPf0B357AfLOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsvezS7w2x1Oo_WoVl2vTMaZZ_hgfJMtO8Zew-iLv9GQ&oe=6AEA0EBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNH1Qf0bLUQ7kNvwF-KlmO&_nc_oc=Adr0kYPGyOEgBBSJvSAiNfkEg9vM_mPTNcjHF8B2HS-gMqJwQwEjDPozwba5ULOyp2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsyIKgRsklGtvy6Xsc71gqSU83dYuzAwHCrXJ36EdQgw&oe=6AEA110C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPpmWJhZzKcQ7kNvwEWQa36&_nc_oc=AdqdMGhV9CFpsKknAhuY-_W8UgDP8_gHSxp3ShVbwqUxjKE_Hi-_-wMRTSGArt6A9iY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSChtNQtmJEuRS8p10Io6vMUEi3Fhjy1iAjEAP25SFiIw&oe=6AE9E1FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeQ5I1W5UG4Q7kNvwFhyK_0&_nc_oc=AdpythVNxhLnHIJxdUqxUFw7fGmFG3gNviXUkH01JkZMfksf0nNSUtNZHSOsRqjqCgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTusD5F07DEkJ6k5UO8Pa0LcWC4MZzGnGs86rReNfzWIw&oe=6AEA0049"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8RITI_UaoMQ7kNvwHcq5u0&_nc_oc=AdorDtqBA7gLqMOmggU38X-4mjtQ0fL4myCRS2jAviEShaAntUs4R6m-gy8qucEN8h
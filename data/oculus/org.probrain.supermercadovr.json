t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeW_oCs9sY62YuggVSKgZ6DBN7U4G49jDc8niA2USNZw&oe=6A71FBAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQMOcmOqpDYQ7kNvwHG0CE_&_nc_oc=AdrCbLjZ6TfEqwuzFBlJS7IJkyf31eoNRifpkcWfzY7cRwvZqcx8G325cGamYaKcd5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH26UdArkoPdEOYNmPDCn2RYdtPIQUsKZ05lzS1nnsREA&oe=6A71DD53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8LeJ3ddqm0Q7kNvwFZJUiC&_nc_oc=AdqWRITdB2ILj0aG5RCuoiroa22DQ_HqigraEM6FGuMvj-y5cFOsTbXilESin-CxSFU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMyvl0161LYT5QlbVwig4MFl1nZkOQRYSkDV4QlASwbw&oe=6A71DDFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uc_FFBcDvcQ7kNvwH1rORb&_nc_oc=AdpvYYU9-6-P38rsSpUwuEQlajADLVY2vgeU9I3zWgPWpZTtKXtTLPd8bWS6Nm7zW80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5EkWqALnFcYvRS3HJ__mo-1cOIDcyyZM527ySj1Mzcg&oe=6A71E04C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enDUJgfsyE8Q7kNvwGbU_7r&_nc_oc=AdrO2D537l3VSVLAJ67km3SaDt8alk8UQ5GHWQ2a0dT_4k0ecG2BFIP63Yhmq8Um3rI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXR3ievGeG7-BFDv2I5u39nmULbJgjMGnD5vtLdEkz9g&oe=6A71E97D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haVRKwb1ltgQ7kNvwESOg-Y&_nc_oc=Adrr5y_BTLF7zF1iesZwgxJV_cyEviDQ-Oxrg81FGlTl5lyWG_NWoKwy9YViajpZVK8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb1aulpr7ss3oisoB2bTNZQ0rbAhF1Cm9wKuY-oQ8rCQ&oe=6A71CF89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb-fOdKQlzAQ7kNvwEUnYzl&_nc_oc=AdpWxhsqfRRDLaDegILuakKPI6O02Qv_UGPioebUEEMt-pJtJoTPuE6pYvAOLx8j9C
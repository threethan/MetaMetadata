t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_3PulmDI_69kN4T97q09YTYoWlqACLlG7G4iR-SgeBw&oe=6AD38AAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEAroSbq5BQQ7kNvwF5-BAQ&_nc_oc=AdoyYfqMcVCk17zyuAQQwU4I_nG8bFtI7gn6xqIjTU3i2a2ETcgecUL5F0uRsCb73Uc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2ZJzeECSi7pwv--xr-2q59o1E1ePVBnDJhxyS125x-g&oe=6AD3A493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IS_AIMN8g0Q7kNvwG5EAhn&_nc_oc=Adp_UFSCgWRF5cnJO_bSqf2k3BF_HLd-GH19yqefmB6ZhNepGKc6u51WaLoKKvsmX1w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSsT0Ey7F8cMH_A32oq8RQ_1xz0atBl7ifeaxIOiWBrg&oe=6AD3A53E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qd1-GFqWoYQ7kNvwHC8gqH&_nc_oc=AdpHPceheHAYw-Cd6Ju0N7zWVNWg9cnVZ3AZiACWTzFpJIORPfwwVBBvLKsLM81B5qI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5yIw8VNVl9dO1gz9l3WJNh5VGE8HebFWly07VENvnOQ&oe=6AD3A78C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU6KBD7TnlMQ7kNvwFWMO9b&_nc_oc=AdppUUCn1DXk9DPVJFfJXebAgOTGx_c1A52ZLFbQ-rHStmVmpFnq8w6TfR22uveXn_0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYOfU_6cLgvb27NhZ1w7q9QNcf3jgPNxJK7QnGNmkwBQ&oe=6AD3B0BD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHRnNOQZJyEQ7kNvwELHXyF&_nc_oc=AdpMrKb8SHK4Zr1LEgxcmuotwRNhiSMqAwlikIsfX6waEGRt4R6BNEOrwi_NqhCeOwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ4pT_DPwbK-YBDSdCwgn7_42ojzj0XF-HPdYHh_IvGw&oe=6AD396C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrZadigK-8oQ7kNvwEACYBB&_nc_oc=Ado3Thvn7QF8jcPxTm5sYiP0PhzsZkDp9GV3N5egVW-2J4MoJ2ia49hbTA0jUGcQcr
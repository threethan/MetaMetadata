t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25pqTN9xE2ioXGMGbz6vNX0f0WfAfC22CMxr2wMvmEUQ&oe=69EB82AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naUsFAx1H1EQ7kNvwHyH6TN&_nc_oc=AdoWQ73kEIKiwjViRt6iGKWOeew2nqVokoO6rnhJUBf34b5qdpMb5UVs1YnltddvM0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mRn9t8KHbpOkfoVV4p-83ZXm-4PqjKlO3r6OqkOH1og&oe=69EB6453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6ZH7DKHjrUQ7kNvwE5CFfM&_nc_oc=AdpXpwTP7Y4AGZXlXVwZC38fD8B-0wZW389kSo6wqrglAnmF0C4znQ7yJn6nfpUCFSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xgOtO3fkZk6St4EG2_c7FbAIEcDb3tIGHUWSpebZ2OA&oe=69EB64FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBNu_ag38mEQ7kNvwH6ku-k&_nc_oc=AdqfE2QuNtJq6q2KlAR0hmaH9yKv5IHOmFZjZxW8-o_mNUKnvkAm-3LoGIG5iPtOXc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zp63TJwh3mMrINZudR4wCv-aap0xhJU1nVTRXCJ8qPA&oe=69EB674C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJV6jx2kbG8Q7kNvwHPlEvK&_nc_oc=AdqG-ZhqzbOGLlCZL6IsUQ81HalU7MHHe2oT4KN8BNCMESTnehbdiLmmu4-O1s4xcIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ms9gdXk-epv2XGJVRq1H3Z5v7NGgc3nHEl8E80E0qQA&oe=69EB707D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpEq1oStO6MQ7kNvwG1sA1G&_nc_oc=AdoNoD4iviBH85W4LyTJ3mub58kUmG23ZNgBPVjc2Lxx-BAM4Q8WYWkvgFSbSO1LNAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_batWZffH5gs71K_n8sTb5udOTBnqheZZ71GftbjLJw&oe=69EB5689"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QVyYMRLyPcQ7kNvwH4zygr&_nc_oc=AdqhbHEan5EsCRgc78t3-7Of4IZJEBiwmCDvFwT2myHLp_MgOgf3ue1GKcCRJf4n97
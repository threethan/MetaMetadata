t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwYt9l4moQmwVwOKd4oIiw-dW6-YvkUQydF2iQ2JYpdA&oe=6AA0202C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BiNSLMsI0Q7kNvwGM0-Ke&_nc_oc=Adrrj4RD0E8rqfAj6Qj3_d-sndz2OU_OGvJndKanLOtCiSEeX7BjWghScvRWFw4xLR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr0Ay5_QXY9rva7_4rZtObHf-izuO5TBh-sW2-kJXAsw&oe=6AA001D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WPk--cXVKcQ7kNvwHHDahs&_nc_oc=AdobiNC31Ycta9Yo1HjlWtihBxn0p0koCNWG-cViWlVMngAfRtdtCrDXmDQGiPqfvzI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzJ-cqLeEktYCrua0cqREdQoUBZkDxpZjGmwC4ezSmDQ&oe=6AA0027E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBl3re1YaicQ7kNvwHuIQcX&_nc_oc=AdqRz8AI1aNfu8GZ5JaUkntGrUHSzL5vok4G3vpjWYwE7BGDlyyqiYQEsBoIX9l1PgQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAVG4Na3hLC51CQbRKkrQZ-2-eVlyo5fRsOs_AB09REg&oe=6AA004CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woz977J-TYkQ7kNvwFx7txn&_nc_oc=Adqbbrhq3PwlC68aQLYiLEw7FpP3_Hm9Cjyy9bagBdNLaydlKtxBUT_MGkUWJmT-msg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZq8olh2rHRgkZUr71APTk0EGGn9W3NxIzIgFz3MFcvw&oe=6AA00DFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bdp4geZFar8Q7kNvwFU8dHn&_nc_oc=AdrPM9lqCR7_mxllk2UmhvxXMrqd76-1WwIT56S6ToSvirSM5b6pJzhx278g0LUVYKo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZB7Krq_0kVu0SiJ8jgVebD0LCsdXajC1D0KAj93e-qw&oe=6AA02C49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PbZTp8pFNwQ7kNvwEa6ZSs&_nc_oc=AdrnL8MHWokPg9EJ29KcwMlRIxRIj5qomcy4qA_UvxThKqWWUYw7Q3p3_8mSTVbFQz
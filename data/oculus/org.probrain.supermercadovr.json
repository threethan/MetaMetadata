t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtqB24PndF_p97UoSd_wv0X4YJdL0EaTSqnMDUp7h5Bg&oe=6ABFC42C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo8efevYYKEQ7kNvwE9c9q0&_nc_oc=AdqP_M5jtW-VN2vqB-SGysrPCojk1pV6raoQ4HGCw17XgRhgNrYAKfRGM_29Nl5hv3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa1frcOfg2qSBxKvnI-bWGYRRDfkiY4ImgEVLFNzbUyA&oe=6ABFDE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWFxhlFdG8Q7kNvwFq6iEP&_nc_oc=AdooX8NvSMzQl0hUIxeCGboqzBWTXNEAHHjwva6T2X5G-zBwAxkCF_gtIDFzIk6mARM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb8jvBd5qrA--8Efk9aifaSFwSab4vJRHwSKgo8JHHtw&oe=6ABFDEBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUfxEMXbjmMQ7kNvwG8MGok&_nc_oc=Adr119S1cE08DcgBfMB9wwE-2OQ7RM6n9OOHSi3eA8-DJC2E2-9JcpohCy_0GT4JuzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGFpJP92N95YRKQm8nUdJZbxIdWWz6X7_HpbgVzljIhw&oe=6ABFA8CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee9Fq73jBsoQ7kNvwEH1WR2&_nc_oc=Ado69TuQVE7z22pfcXok6bZPbjFRRPMxSbWVdLvQJrB6Xsf5JL2IpQdYlZceqFS65ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrvrB2_XEUP7CB4kWgQXLZcV3xUEOj4Cfl7ZRGqCv7Vw&oe=6ABFB1FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjKIUVtj-_sQ7kNvwFOLc6h&_nc_oc=Adq9OjHLR8Ysd-QA1xRWuLbQLDQD3s5K_b8I-ktLjwgIgbqKG2EVpVYixeant158Lc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDp1Ac14HhDGyedkzYZM_eHJj6lwPjLqCo6mxT6wczAQ&oe=6ABFD049"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmjTUGXq23kQ7kNvwFhkY2w&_nc_oc=AdqHS8KeaE9565QLIHUvChdek-5NLyDBfNk758jSYu_jng047vq6Sz_k3AZaIfS9w5
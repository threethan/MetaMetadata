1H25VFPyGOCiEHhAmIL7s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi0Zsp7_Q2tfflqV5jNlHlkAKJh7iPHvctbPVZReHO9w&oe=6A8D72EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzaCj7MTIwYQ7kNvwGn9at1&_nc_oc=AdqTm5uKQDyPjlUM0H7rEzkBM-XYsX2LrK-5KO0JrJmKGy5671A08xw9gcSw_HL2N8A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEswbtN8uR7oTmFzFIfXTz7eN3ZGlCoalAVKoOA9klMcA&oe=6A8D8CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpXjx7YqdXYQ7kNvwG7QyB4&_nc_oc=AdqZNOyOiYhePhaY55TEDapRQGyHD8DtMaFpqYZ2KwnerR1SuYLXq19nT_hJK_0g0ac&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Ts_hnnIAWMj1nIOzDhfy7mqLEyzy24BrT79siOzB0Q&oe=6A8D8D7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea4y-yP2WE8Q7kNvwH8xYd3&_nc_oc=Ado7iZNmfkoR0OnsxqLjbtsx6dGRVXxTXMrBHAMwikKk2qdXNvq9UgnhTy16Hpt8zTU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExgz4SdHD9_CA_iEGfgLo887dOVuum80LL2Bt4kE4w9w&oe=6A8D8FCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JHAVNM0SCMQ7kNvwHgeyaT&_nc_oc=AdqxbigHI1WZNXs4kotW-H0aijAkV7WZ9KuQY-F33aQPRHmezG8CboRrGqJ141iLIh8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEfYb-QeKfGncIzgSM50_E3YEgefo8tJzbSLXlPuY1OA&oe=6A8D98FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRMWFNMmKT4Q7kNvwErpAw0&_nc_oc=Adr_nB6vrMvnoA5imF-aXF9b13ITgZwbYhT2_jEYcdWKICjvnGYN-rKghmr9djYN3-I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfPfGfMlw5c8OLL7oUq8o72oQ8Nyol3f480RMnHqsxVg&oe=6A8D7F09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iovr73gBDfMQ7kNvwFOWaqT&_nc_oc=Adr5jxSjI-gi1nIOH
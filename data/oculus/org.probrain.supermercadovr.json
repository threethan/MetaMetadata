t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ekONbIKK2KlBRozvYC1Cf40A3Ma9YIcK8nhEJ58L3Uw&oe=6A09D52C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPiYslikxvMQ7kNvwHc-Kfm&_nc_oc=AdoMakjM79JIaUSVKmj0XCcUUUD66ovpX5VgLqvF04nE8Og54hmsLmtGqDlNYNrIOo8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Acj-bftzXUXQTbkmmafA7ngpAKZMsFdNjYPg1gaQORw&oe=6A09B6D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBO1UZV-QoQ7kNvwH1RV9E&_nc_oc=AdrjFHdnkJSHGCq7pkyBdLWc7hG00xb_Q66X5JRIMTGGvVZ0MwMQ4J2pE99jlvJrii4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jl7v8mq4dYeHpEoEMTWyCrkK1JdudWNf7Q9DCVXydXQ&oe=6A09B77E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kJrt_AYG24Q7kNvwFjHvUf&_nc_oc=AdotdFDFut0IVR1YQOcZElXRjMHM3tLlZw_oHJ6TUZqskm2iWdg9xoLphvQoZGeQzM8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sikMOviuPlytgMTvwwck28W7pifIYBDeomfrg0r29lA&oe=6A09B9CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuT_ipdzolQQ7kNvwH96sbr&_nc_oc=AdqOnAbB5y9_hrPVeFp0v5DkIkXHhYrw0RJ1_YtnhkEhlSsA9UTrSVWLXn42BXpBLOY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lP3PL5u3-lccfG6sMWfWXfLObt3Zuz1JCJLCNI9rZVQ&oe=6A09C2FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SZgUk3mV4Q7kNvwF6Blfa&_nc_oc=AdpC2ceRn8nLsnPPp7HjfwsFjFAkxksh1c_K8ORMlZfZROAtZucV8KvpZjxs6JN_qsg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wfwv7QUK2wXkt-y1sNddvoLL7oLb2953Hd8PNuyRu9A&oe=6A09E149"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej9azlnhvwgQ7kNvwHgkM4x&_nc_oc=AdohKidQn-snSE2rtc7IqfyT3RXZh0BtwZY7xhpoLcPGbimSHg4wMKKFBv0EG-hOWG
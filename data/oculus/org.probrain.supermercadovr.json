t-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af819I9MeAbII3XGfWdDqobk2BkDRRuFaSSOT0J3R9e18w&oe=6A26D62C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5p3pVuhTZcQ7kNvwH8i8yp&_nc_oc=AdokmgTSA5_MrrCJmXYbWMehLVpyYqYPchkxb4xKbjmqknPvBaIk57zh8F_zQNvFBcg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aqTVXRZJIJeXqycWoAzSAn8LxoBGMP6y5jo4KOUDhlA&oe=6A26F013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCwJEbNRVhcQ7kNvwEJVC28&_nc_oc=Adr_grPGeRGkDaX5JNPdoW6QI2opLtfZxdtGDrEy_0Cz15JVzMehSxxNWCp7oK6V6JQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NmFNcUe_i6Z6w3qdBCmbXl8IEYKVuVD10KysKfE7WXA&oe=6A26F0BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGRghC-9ogkQ7kNvwFblfZU&_nc_oc=AdqYsWkE9gOb9ENUN40Qcd4vb1RgrfAAmJtkOciiUFIjHlFPWY5EFjV8go_Sc_iLkNM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rfcyUxYm7zVMGgvLqiqHZ_3oO7iSMDRzhdz5xC-U5Kw&oe=6A26BACC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeozlhIDigcQ7kNvwHYURxV&_nc_oc=Adq_TCn1-cUWwyNjVgEyKCJEkoeQ8i_oEKPwOLt0zGTN67nrwzyNgwGNmURTFeFlAMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lpe7vEYcSD_LZyWUqqsUG0b3F3WuVMxzsa4UHGK2twA&oe=6A26C3FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGEuILjFiL8Q7kNvwEzUfZ-&_nc_oc=AdrMCQrvI6ttuEjv799faY7bSAumHzrFU2z1xYDxycCSdzNwoBpbLdOaAjWOKBg4Noo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lJYiNNbXHI9VRKzr0EdNSVKzfzBQ5VYxJZloIbsqsUg&oe=6A26E249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbDGVeCazE0Q7kNvwFT0tAP&_nc_oc=AdoN6J7AbKyUrUdSJotW0q8HmR0_rciw0LXPjVYCWAZ63AtXbx1smMMEbd4yAWhJSi
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr79L-7NyAFTj5vmNCZAo4SELlj8jTNHaTHZemSiEGiQ&oe=6A75F02C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV-qHLX1knYQ7kNvwHHtNJW&_nc_oc=Adqj0uVY8GTEkgACXXqy44czQROuJ8407wU7uAkipMV7tBZcbp3iidYwflZ9ZY2HMTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLH09Sao7AWwCJqw0_-l6-Rr_9jSoUfXz0qp7MhWvIaA&oe=6A75D1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBV7l2y_pv0Q7kNvwGQ0gM9&_nc_oc=AdpHKWTgwVrjSwneSG1V1-9ASqnpTrdUg2GJamJ3a4Ing7spYfJRwuyLuoDCqfQ8rAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuYnl2gvymc-Fi-YLTwnpMt7-PkftLfUvNs8x0zdr_iA&oe=6A75D27E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKqerNFQ9asQ7kNvwGkgIHp&_nc_oc=AdqIN0OlVe8W7RLNpEasJLpBvLtiHl9W8bJ-keKd-_75mEPafHd9PUbTOI-No-kINPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6a8Xd22m0vcAXQBXBdFUpvQCiRyQ9_qUimwLsCrYjgw&oe=6A75D4CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu2AcX1ESmoQ7kNvwEyKKyh&_nc_oc=AdrU3UGVRIKyL9trR74MgGZUZeoG5x_WcXifsiSLLqHelcLpVbPtYneiCfBV98K7BNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJdTAm6on5p4VlFLx0EPIykmQaaAA9-o2tXMCVtTSYjw&oe=6A75DDFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVhvMzRbe6gQ7kNvwHbemMW&_nc_oc=AdpYlKoz1MOTa7I9R1IPXxwjlJsAp1pzHrO8xvbjEo-PYMcCQMhdlI3Zx2XEFiYnXZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvWsmATyFYCS2LqVMSHH7q5kXPl8j6nfLmQKLNsrNbww&oe=6A75C409"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6HsCfkbsT8Q7kNvwE_4P-X&_nc_oc=AdrPl7wmEEekpb-ljsOzJO2atQWNqD3EMGdiZHHp4FuP5x8NBq2GzUJH5vNDMPXGHU
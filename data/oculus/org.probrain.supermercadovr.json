893955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7-Xgvaai1oQ7kNvwG-9FQU&_nc_oc=Adkx7kKK-oR9Jqye4HY0AUqLnFJeuevIMWafIqnusSkBbXiD1r3ZJylT0CqPyK4B0WI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftV__4qblsO7KtOqgHMEKTRgeoFwGc9R9ogx1g8PoHg_w&oe=699D9288"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inNvfdEXlWYQ7kNvwEiSjcu&_nc_oc=AdkBTgs-ZdVsQvaZVbyoh0PdriSg3zopyoTbVYyLA7_Kd723NKH6iqwDvTeVXu6BmJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCxLdaKByDDusTXIut1uavnRhhoANvcc7uCroYCIg37Q&oe=699D8389"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6ACXh62MrYQ7kNvwGjfFF8&_nc_oc=AdlE_e6fyZhIXqtaJ1N1HIynEN2cKeXy8_dWGlHOwQE1wFgWa7eJLYLVUa3fI7vRj4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftq4icJSgry5Nri9Sga0K4aCsWZ7MXtNz1zBu9IHp5z-A&oe=699D81EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gFfcuWsFjAQ7kNvwGVK2yD&_nc_oc=AdkoiQUpjP0jGJ9m8TKm47zDQOl7izCIaXChi5t0Ma8qYVqHai5DaKq_XccTV2T4TzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP_cvQ5CaW7ipHNuPMmos4BUgFcCOcvZ0zof2tFXMDiw&oe=699D9BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6IRjtO3cQ0Q7kNvwEqQq5X&_nc_oc=Adlhh_NSKRLaZ2pZk1bMKKiRyPhnUiK3RaPfk6_PW6AExmCSr9NnXA2XlvYp1a9xRyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHu6jkP47fVFfmE40jzByjKbqbAt9ys7jwqhYfitcrIA&oe=699D9C7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upHTDxYP8soQ7kNvwGod3_5&_nc_oc=AdmWBqixKwG3MmzpSyzGGVzPsAhKqJS4JRNfxpCPTUYbj-TJUD5ttdgsGENC1ogbebE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFdwT7L7x8G4HrA8R-jiyTmdaXD6nQXcSdasZ_z5h29w&oe=699D9ECC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
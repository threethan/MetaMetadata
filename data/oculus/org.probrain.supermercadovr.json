t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx4qUFFoU4MQ-eYy50__o3vOnJDkGhgD_xpzn-fLDZEg&oe=6A7C4F6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTv_o4DeNXoQ7kNvwHQWap0&_nc_oc=AdqDn0UQ8F-J9iy2qUbRQuGlHYD1KpmeCwnpJMFLp7YWGPWO5GOQUaZ1Il8CZMW2YIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpHEhyB8_79S0sriA0WjN9tmgyyg92Tx-3JHkXqzi8Kw&oe=6A7C6953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhXKV2pK7fsQ7kNvwEwYvrf&_nc_oc=AdouzkqD8HJHntsJmtTCR7fbs_Tagq63mEiGzL3AnL6oIyoWnQqoaVrP8c4DSQGC8Lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm85jqr4Aow9-9T4TanZuea8M3JnjLvL5vA3uIN2gsAw&oe=6A7C69FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEl1VIXOuesQ7kNvwG6pLwr&_nc_oc=AdpGtjphlGdU-sagabH_zXVj8X6uyIDc-7MC8lxjB2qjGTnqZH1RynicfabjIU0iXOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSw2XMM-bkf5T4BqPjQK9lRqtCZgs-x1hXx1ul0-ZQtg&oe=6A7C6C4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSDcU_ZS9xcQ7kNvwEsEwMX&_nc_oc=Adp0-aJS_mcnDGL17Soja7zU0H48x56j5hZR03iXvNT9ak0fPI0temXy45QiOeSGy7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbi0Zu8iqsFVHIw8zTGI_XGaZwy-AaylAlqVZ5a2auDA&oe=6A7C757D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHE30cOYZOAQ7kNvwHjDVoH&_nc_oc=AdrTs198NLYEBAFK8IXkc-5YxZJMksGedx9ai6zrJiLoXLen0mVHG5oFsYoMaS4hu1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRvCZoWBDTVQSgA7CMDLsPjEuJ7-ghdm0k8Q6oHTLOKg&oe=6A7C5B89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9vSXUCmoAgQ7kNvwGGkuME&_nc_oc=AdrW3ONca3V12NdkT2yMMOlokh2FXy5g-mJ3jTj0VMR5Obob8NmUsssSeFEprlpxJT
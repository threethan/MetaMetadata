t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5Q55jRPU8GGrVNoMOE0cA-lm3AQyFBSlGH0DYaKYKXg&oe=69CE81AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=marTDbvRvIwQ7kNvwGgiGQh&_nc_oc=AdqluIUIV4l7wL1-IhrbiWhkF0RA4tCQc74GucHkPVOj5kh8nrF7n_im05weXhbQBJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyLZr-AECNsj6GdMvlxVucPIDcOiG3mwdkxScnfo48dA&oe=69CE6353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2WvBIjamGIQ7kNvwF8F2IR&_nc_oc=Adq0HL9U18F066PIUfbbiPMKoyg_zrsZ0LC2PDRMg4Yf0fsAPq1eMSEHVk1wrI1Ep4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvdNUrtyYobwRm3NV6vlZoxcWM6rqRAvVQqMEZmDd_BA&oe=69CE63FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9Aovs9oiOkQ7kNvwF3PaT4&_nc_oc=AdrqF4tm1vqMbDhg3VZPpMTeDgunDmMIBGhgrdSYF0GvoSIlriAM26G7Fx4Ihsgq548&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjwUsWUYoxheJAOSWAr7QOzp0I4Hgblgfdk4L-2h34zQ&oe=69CE664C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGblK7dZtxIQ7kNvwGgfg7y&_nc_oc=AdruIdg-_6JsVT6LKuGNqT-vrA9tYM7S-a5yOnuWSJRlia0o5UW_sm2-jOMpZVFyU7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNFkSMTZcYfpoAg7LfQFS4gB49iCoVg6EnKiF05jjw3g&oe=69CE6F7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR3MRFV-524Q7kNvwGTu10d&_nc_oc=Adp2SE4nK4wE_OD5wg8EmVM-wdFhG3Dg4O-hYIJwHOWVh0zA_T1gOZzbXqJm2Z3uRe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGtKDsN5mz5TnwkZV3Giz9zfLPZGWUKdDmkoDN6UHFKw&oe=69CE5589"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vQfsjYXCNoQ7kNvwHrhy4w&_nc_oc=AdpNYEA-Z-fbGVhLH0D13-IPeYTz1HKyAWyvzeGnAN9_ZT3aZZAnQbZVY8KIA3sDHg
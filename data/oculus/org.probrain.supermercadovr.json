t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ9OHWR6PelC3K4qbBl_JmYdgOLi9EfHhn-cLnnD2C-g&oe=6A53A92C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT_XlucKiHIQ7kNvwHk81Iw&_nc_oc=Adruu6aEqxWjOVhkXcW6LVV8H9yTpbPGyYB9XC8plylf-uvJEJrxUwWa1FCofD5_wCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3Rxh8jcB_3uB9CVGvRHjMNWd-4rw0AyAoyIp6x8ge0g&oe=6A538AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP9Lx-00wjsQ7kNvwGeyEIJ&_nc_oc=AdosTrDfigCEFg_4no6efkYUUIK-aAQ02puADsZK5AeAdZVBHAwpjs5DF5BSme0gpYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU5YlAeeTDSdBs9Rx-ETChk09DA_REzTC3U-8COB634w&oe=6A538B7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsFZyts4S2AQ7kNvwEoyCyN&_nc_oc=Adqc5cpmwPW57PSDnt_xD4bdl9vtIcBYQX0hdTqaICfLH260YhqtJq0jMMbY5-GgrFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeiVOkOdiA07pC_-SHs-EqtMRqBb7uUWj9Qjr-UH5VCQ&oe=6A538DCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbzCBE1_IdcQ7kNvwGHej7G&_nc_oc=Adqi7hFTKcEe6a4PpOgdFkaftXSd8E-4lG98wUCrXswlgxx9Fb6y2qWJMtHCXkCgFcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTlZUtPg2oyu4hNojhYGc7wdRCWkhy86vIBtPGGSYKdw&oe=6A5396FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP-8C7Xk3bQQ7kNvwEbuPET&_nc_oc=AdrvIm37qgNfAyv-Q_1mmBPgPSxc0fjg1vWhTr24m-0qeOwBCt3TS3orywN_hWNuW4M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABqk02K4_RGQFjkgH5Yh8MBD2ZWBDepmwC6psm4xhYhw&oe=6A537D09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Acu7YDUUZWYQ7kNvwFd96SW&_nc_oc=Adom11qGzp_hTsHhZwC2_WXgqipAUPktRLz2JZbpMBG86yyOzP7TyGMuiDz-lKLxRg
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBON8Z874UvNaXVe-AMIhOfPvaD8-x_gpJU6WQpstXhww&oe=6A6A12AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is76fiFWrVsQ7kNvwFU3e7H&_nc_oc=AdqDNUKtky8m4afr0msFoZ2rK-fPvroEpTPZKp7VZFtEeIN1J-QXtwJI1tsRrsl8SbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfSzq9ZSY1LqB7AdX3I4R_UX2BqsPEpD2nNvve-YXnpQ&oe=6A69F453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFP8xN6No90Q7kNvwHcH9GK&_nc_oc=AdrH6f-ArhfwX6On75NhfijM-iRRlBMYy6xgBrgkIfsm8184GaNyD3miKly6hgpbotg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3lkeB6Sz5MkqSmQvTUCi4K3vOioxxNPsvk4i22fhWlw&oe=6A69F4FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znnuGcS6RsYQ7kNvwEyb482&_nc_oc=AdpVxxEFAN9WtV1Gk7XoLD8Z6bqgqRTCdl19HA9kMvARgL1bDc_Krz1_kJaybWqw9Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCruuDQchS4R_aZAcCLgJRgrAFiRli7ZaGH3Gt2216yxw&oe=6A69F74C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDP2M80sxMcQ7kNvwGuThzR&_nc_oc=AdpJ4HtdD2wkIKpBIHoikgXH1jEiFMyMgiwK5_e5BGgoZc8yvtIzSD3qjv71XWvxhUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAId2a3OtDoG3jdU0cwysauK69hGxP9BOt34n0xI8vdcw&oe=6A6A007D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dACZFZOGQAQ7kNvwHvrDIj&_nc_oc=Adqav-eG0IhceV88tU--RlEi4nVjhJ9s7Je_WaxFw3diUmpzEopbO5K579n7ADhWmVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIdzG89eP6slmBcGvsXOkCfWz95kff0KbnjCW0ET5tNA&oe=6A69E689"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9ozBUPd2I4Q7kNvwEnskYx&_nc_oc=Adrcx3s_H_z7KfWModZqAlK28ZTdIGWeNb_cERqNtMsUR_U8gA6PfiAEJHfSoDRf31
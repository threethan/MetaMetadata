t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tpMjEQ_pbhlzXRoOXBJTelOY1UnDrGU1br33C42F3CQ&oe=6A05E0AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyMQsfEDQ9IQ7kNvwEq2Vcs&_nc_oc=Adr3KjbXTSqYN4ymLidl12D2pNSteWGGd8WS8tBCDurAlf_dNgqTN4DEoBnxxrIIJVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KbwHY5gPSrI_xBEoUr84hVRuFAnqxIWpaGW9sws-D9w&oe=6A05C253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIt4X1TikQkQ7kNvwEgE4qg&_nc_oc=AdpHP_GWDQTxICE-Q9Llhj6FuN8XOHKT2iBD9YSX4gsLXXV9rClw9OrjaO4R5y6B_i0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N9sAdzX4O2vVkCYG9hHxhvMYL7013X_xFCKhQX7uE9A&oe=6A05C2FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Psdaci10-MQ7kNvwGoSYuu&_nc_oc=Adrfav7DbDlvyPCsQOSdMzlrsXj412cXCB8RX29SJBzOHjlYFk1dFuPx17ar0X77_N8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61a65n5lPNmoJ-6kwMcrZadmVB1iY6PBvZMSMSpNfwDg&oe=6A05C54C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zwHGJO9F-kQ7kNvwH8I8ad&_nc_oc=AdrG-daZqKZbliIr2Fc5AtN0PpXtnVEgr6QxZcT3xSg7lG5lOibRKEsMaTspPBsZ7pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QkI6H8auW8-TgVZn1B9x05zbfGfC1v-BEjcHExTRqJg&oe=6A05CE7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMLSp7ImF1gQ7kNvwFNGELM&_nc_oc=AdqzS7xrMRAhG-PivMm_qE7a3o9vapkVWcVDiK0g1EHF6XYaEw4Ht8-p_wn64tUg0mM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zfaFIYXmUFK9sY9YlDe5n9GYk_XvjbJh2j3qTR_1m8w&oe=6A05ECC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOXjhNU1tHsQ7kNvwEWWxwX&_nc_oc=Ado-sgq-qQM-QKM21KuTiQm1FICLDZpNmI6icwJ67EzUpZy2cuSmJwuwIZIN3L9rN_
t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9VqvHURMbZ3DK2dqxPY5SxLLBaMiWuCoI1i9D7k43HA&oe=6ADF682C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5De5RBEDEYQ7kNvwEppD2x&_nc_oc=AdoFpacSu87KhFseU2WchrVu-T7WwUYjUXQR-3apiGH3rL_ROdNqntsa-SGhYduawNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN6OK0byb_qa1AH7eK_BtGXSHB_YeIlk5aT1F2QZTFAw&oe=6ADF49D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRmZEnoWbecQ7kNvwEZ8C9r&_nc_oc=AdqLfnLzRe8EiRqKiXP7xENnfwrFS39I2Ip4luxXayGp8RZYJk5-8QKA5e3cIZmjNzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO81QLuRbp_Uiz1bBeAucIdwXo6pORmHCMV96wnn4LMCg&oe=6ADF4A7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P5t86vIw1gQ7kNvwHTdE2D&_nc_oc=Adr_RsV_M5FgoryQLiLNZqLR25V3q81Kd02RJC-wBuHDjuhoR3lxTWepr-zC2W67dyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBdTn-m44WExl75ycPwqz1uQjhiHQp9dN8qKhPGTiFtQ&oe=6ADF4CCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-eoMoZ2-nUQ7kNvwFdKwt0&_nc_oc=Adp1BXamceyGpBQCxuK5lT2nyAoOOazmWFV6FhbwAkgsp7FACQGAGBFPHTbgJk5u7Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjDMUvbkPWQjg3l3xZh-glmYdHWjjzq1xDH62VNcDswg&oe=6ADF55FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoAmOmC15XUQ7kNvwGIejAK&_nc_oc=AdqeDsxIQ6_aAqVXYWsHe2ncQYXPy79hJo-Yvy6r0ff9MQP3WtCBtS5zqNIJli8ZT6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH5iary15pbMXDnkx7iztZVn5vU4xkfcsgbuW3EILw7w&oe=6ADF7449"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxdYdr171pwQ7kNvwHDZ8nR&_nc_oc=AdrBEF4hfYcBT2_Cng1mw3lWBhFhMa8ROCjS_6uURSY2XVE_68nHps9phahRL5-QOe
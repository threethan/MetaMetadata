t-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sD566UDfNsjDxhr6O8P3PFmSboNMpOBcrQqQ70E3yWQ&oe=6A0F1B2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVkuUqTJF3oQ7kNvwGn1xFl&_nc_oc=AdozJXWODzQoNoYSYd7o66csOJTwz9HUFG3JS4iz0TL1mh9WLG7yqzGXHjbx9lSTsio&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af428orms7XogFApz9KsylnfCWb9ucBbO9syNI5SxAIjgg&oe=6A0EFCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTCmRmK2OBQQ7kNvwFK9Mjo&_nc_oc=AdqCET3xwdqmmvi5xQzlueFjd2gLb1d4c-9xIz5Kh_SMjyHQfVwQMVLoFhY6Q_dBEm0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZtIHTu4mlJENjZJzAfjG_tDFKS1RHCLeoXt4FCS9p5A&oe=6A0EFD7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odJk_uGnYYQ7kNvwHzSAUV&_nc_oc=AdpusI9jxgVPsyad7T4rVthLOjfOztDa39IPVjEPoBnolYICLOUw67JNMSrVBFTdCfU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pViC0i3_TN79A-riXNQap5iaOVwTbCRK_yP70VPAtmg&oe=6A0EFFCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcx9g2QKCzMQ7kNvwH7bEMr&_nc_oc=AdpnNim8oWYPJyyKeDuS4fB5C-qa0Daj32yFzua7oywFVp1iCCSp3ZNhy47xLHfBXkc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BHYYbheSH-V7tza-5JShx_rv55ZS19e92sRq4DrFKHQ&oe=6A0F08FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uICekZkCUMQ7kNvwEyVFcQ&_nc_oc=Adrbzm9Juzm3Hei3roIeC051D5Reta1d531c8rsJ4mMKvAGZsiCTOF3qendxU6ayzMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n90c4086cS2aCKiEGvHjyTTPCMjDbrlG435KpesMwOw&oe=6A0F2749"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpT2DzXsVdMQ7kNvwF-8h9V&_nc_oc=Adpe3kS3j-qensb9ublUjvefm9mwPoBGt0oWSvsEyGW2yyi-VY_4lG55ZlI_IYp68a
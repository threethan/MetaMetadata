t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF44PTUofVXGm4T6X9hxrXZka1J_aGvFVhMHtMApskFtw&oe=6A82E6EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlHwMTpAHgwQ7kNvwFWS7YF&_nc_oc=AdpPUql4nfuvKcKDnFVF_Fn1ORQ60e-DeXrv-dJo8A-NAAQesptRd-bECxIfWmt8jfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvJD8KLWwKLk4EBkmLUA30N3CWv6PWPjoRtJkpCdZWQQ&oe=6A8300D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUvFgLQuH3kQ7kNvwFw8Nuk&_nc_oc=AdpOqQX19m3ss4ZUqKg3jJaMw3v7zbOgf9vH3BGwaVyBocAd7TRuIXC2at5KHJwAC-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGyG_k_9D5ibLYWxppBr-vTVhEIfcu_gzy3QPqm2tNgw&oe=6A83017E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1Nd1aSLBFAQ7kNvwHi5FOu&_nc_oc=Adrcwf6gl1TI3nH_hA2uOQ5GFE6SZNe0TxxSPtsojiB8x-7K_6mYemlgT4cwGdZtK4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7nyOo1vnRpD7WggC1y5gEoXW9rPQ-vYrw-iz6fH8Myw&oe=6A8303CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhk43ZLCHCcQ7kNvwG4YGX_&_nc_oc=AdoHr6JN59jdOwTtV_HkHhDYTgoRs12f7UmkZOHmanXjGEDl4MMDAaRCP9bCTqI_6Gw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxvaivs7cMc1gYouihIONUBN-6ptDigjsha0YsavkGCQ&oe=6A830CFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sm1xpbOicYQ7kNvwHTfX0j&_nc_oc=AdpHyfhllkFBD1pSo6atg8ijDNrsntOGJ96GyQ-IM27deVMD0dCBAEUd-o1pWi13h7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBAT7E1OnPGzi_rZZlqc5WQVP1nM838kySBByV0OyXLg&oe=6A82F309"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTm9hdjRfM4Q7kNvwH7cWBS&_nc_oc=AdqT3Lv4l7Sb_9N0X10wHgjaZSOob2jYnp-j76LO_L3U7JwNXZz8GOwOETt1f_cMbW
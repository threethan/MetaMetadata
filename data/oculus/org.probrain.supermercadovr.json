t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9Lk8w0oBNho9dUlxzLe55og_vQLcgt1mbvfaCGsy-rw&oe=6A661E2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pZzf06jaNIQ7kNvwEjDdIL&_nc_oc=AdqozVKe8Ecx7JJsdFafGJL98p01yTBqQsGjpWm1Cg0UONUgoWWqFWZwdPhjQzHqP-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUiB8EBmGyY4z1mtJuseBbVH6dCxhogs-l3dYKj54m-g&oe=6A65FFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXpZJI-fdlYQ7kNvwGqGRpm&_nc_oc=Adq_McJ8LLMuGWOIb0TnQjv-yVH2b45Fjek0IiC1vHE55cQclSs4UWW67UHzK1eQaf8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFGHVeiunF_LWYjLA0C1SH0072WOdOVEHld-IRIs6xNg&oe=6A66007E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3zrNUG83KwQ7kNvwFUDUzt&_nc_oc=AdpOG22U5ePrWwZmupinAiClTzL4W9fJazWM7PJRmiYzlQTpblzyB93v6eq-G--f5Ws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAEmYuyZvYiOEXvrIaLwPQs7aEEn-wOt8fLJgdf53Xew&oe=6A6602CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p6YUp9CK44Q7kNvwHsJcOB&_nc_oc=AdoYXg5t8QOZ_20Fmy0d3CmHaM_QIjnZNsEz2XqTnfbFejNJU0XnZG2g-4C27r4BxAE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNNaUi7z7Vm4YrqBe5vjBQ6ZAX7i7rVuTRShzVJs5KZQ&oe=6A660BFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_UrFLmrlsIQ7kNvwHHszrP&_nc_oc=Adqho3R7NZI6orNnKzXjYTQVeJcsk98tB1jN0sHOiidaeL46dxMujxyj_rS6acgcUF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc97ogHXEqzsH1GD54KqtrMsL4QiAekvYJYN_cTO-eoQ&oe=6A65F209"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIHb4zxRhbcQ7kNvwGMMRmM&_nc_oc=AdrTY3eWWTjTZicb_fzYSmFqzLIqU5qWb-tCW-s8JIC-N_KKIR2-NSkDXmVjHC_Su8
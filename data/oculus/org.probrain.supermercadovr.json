t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_0ryxXO18H1byZcTgXYzkR3em7QWmv8faPsDm938D_g&oe=6A033DAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyMQsfEDQ9IQ7kNvwGyqCMR&_nc_oc=AdpIW8metcBOhWIHlgsSxsVEdfZsjIb6rMEfGswfKsO89y4dIo3QxRj3_dO0A-4Sk2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eu8AL20OaiYBn-uRRpLagU4demUojAR_OcBULd0PL9Q&oe=6A031F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIt4X1TikQkQ7kNvwHEVHXd&_nc_oc=AdppWPY0j8h4u-bYgrm-ZJE6dt7oLNHbiGZWPcs6XNHDul5XBh5E01Zb2kk_UQ8H6lw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75OgZ0EfhEL3aqjosfIHvnsUoiqDOKflcVXSArEarAgw&oe=6A031FFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlH8Zn0kuscQ7kNvwHzkJ9s&_nc_oc=AdqnUmghvtvsei1GTHLnP7EMWkaihKYqfmhKtVloaHUFOViFeBhiVLKwlPP4BXVRCQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z8wSBjuIKj7zZPWq1lal4w-QMZLvpIl9KhWXhBhOzPw&oe=6A03224C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plFhqRukBI0Q7kNvwFKHxFV&_nc_oc=AdpdA_zVrLuiudVLVQkn-38zOwLpRU5smfyxjQrVkzF4a-Dsrd8UHJdx9syO1secuQc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SFGEqzd5-gTf82_E1Nd6LXQ2-EA0LDFysK1zhSgSx-A&oe=6A032B7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5dJbz26664Q7kNvwGWY88p&_nc_oc=Adq1pZu3Go0ewLUSBOtSAjtDoCXc__APBhjH1DXKtUx9s_npocutHEcLqy9QpwnHK38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zKIG39zxuUJcNj6You_4C53fDnvEezl9JWnERdZkk5g&oe=6A031189"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wiTr62CtUEQ7kNvwEbC8bY&_nc_oc=AdobAkgrQnBvGXgVgvffnXxvou3CNyzkDTgwyJBIVvPUFhMt3-YcXKXU3T6-d4XlFz
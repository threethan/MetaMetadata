t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERTrMcGhyHCcM27Jll7C-7O2Xetiqk3lD_IE7-G1a_Fw&oe=6A81956C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlHwMTpAHgwQ7kNvwEHhrqa&_nc_oc=AdrDQ6SmS4NvBT0JwC_oPXk4T946ray9GZ_0sWVxBzpQu3SJNSNQvdWBRym72b1odaQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERWSTB2zLeOfYEHxHnMNLpmsGXabfUEQRrjhACWOOaLg&oe=6A81AF53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUvFgLQuH3kQ7kNvwEIcGRV&_nc_oc=AdrBCjQrZFD6Py-dWX_jLS3vC1Yk8P_StAiJjcue-4yydXIQyGWoyuP4jLw_pPqComU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlPLSB1an68LwyEnTCKGLPCUGytb2icIsbkgSqa_1E7g&oe=6A81AFFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNxe-7FBvPAQ7kNvwEP9tHm&_nc_oc=AdofrHgcRNYNIW9rlPo2b2eryukWjVM5l6q1kTW9pMPIcWDQioUi91OFn2T6eBKSWv4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmtQGSDtHoU2jpWqGdgsBaX3wLqJL7VcUmXwjY9NnRGg&oe=6A81B24C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY0v_K2cdroQ7kNvwH-OfsX&_nc_oc=AdoqHJWf_mVu544TsYLsuX6Bv_nThd1VZKz4mCnqNbni-mvgy3r2QGYwvMYDBl5EBDs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8GB82hw9MDHy5mP_pX0TIjW3OkSKx5orzFN6EKh_09w&oe=6A81BB7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sm1xpbOicYQ7kNvwGlO_JG&_nc_oc=Ado3MoG38P1QeXrf8LjwT9mfsGqGPK8_PzmWeEETzGHQcRvXPwZXgwbSScoyrWY2lTk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDp_WgMYd9rZkNGB1qusGu1L2PnrFhVNGV14A6LMvAaA&oe=6A81A189"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTm9hdjRfM4Q7kNvwFTgvYY&_nc_oc=AdogNKlB6OmJmiPxV_9A_UDJhE43Rf1fZOYDKO-d7fmkNhwlOYaeTv9-KdTc6Lkq_i
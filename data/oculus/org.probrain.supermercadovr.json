893955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4NBmGGTy4Q7kNvwF0MJ2n&_nc_oc=AdkcAhcqzXFwpllzB2zN075E1NKAv5DW9edvaTUpYImK88uMryXK_lTrrB_dRejc6WA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWrZswt13DzxQVqafsudAaEnbu3F6fuHUAmvhqPDljJA&oe=69999E08"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM0CPFHUMX8Q7kNvwHRDqxv&_nc_oc=AdnBpyqJlQFKNLLxLC-zGg7l2xfrAxE1-Qub_Xwo4N34GeDh9kJazhuC2jeRrNG8Xfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmXVHQPzRAUhV3Z_ORn5o3oVMgzSnfwZgZi_BHRno6PA&oe=69998F09"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCjDdZIiiRAQ7kNvwGP2udK&_nc_oc=Adn02motbqeEybMmJiYULUunJCUlmye0sNxUpQH_VulWEz8c6744HVyfo2xXfNZMv6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_gPbwOdOuppxoLXWFhLtgaXyAEEozvpKSmrNxQqw-pQ&oe=69998D6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtvsRclR3WwQ7kNvwHj-3c-&_nc_oc=AdnAuVON0GtWZOg_T-P5dq2YmoMA8SEnDv5-qGgOWU35iJ2wUgfO1Ee7xTEyFHMzBYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJVx3GQgr6XMPpZ-7Z0vYVwcUmEDnDADM-xLy40Ge6Nw&oe=6999A753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAXInP29neQQ7kNvwEkU-m5&_nc_oc=AdmluFcguP74ocZyizov6y16XiaR9dwNbQq37YT0rFIoeuz-M-NWGV3omKXxiAq4R5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLGtdBr94J4Kk7VDcz04nppQV_FqRuMUACNUJVHap6ng&oe=6999A7FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHzZIANonUQQ7kNvwFnwM7a&_nc_oc=AdlNugU1kUPq7Gvai9n64d7h_uaNr9Laq-cxSnuy7utlOo04hNEX2C7AK7B9Nb-JqOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMUFdwp8L2SMegPl7eVLE9Da9qJIkuODGMes3yByLp0w&oe=6999AA4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3VlW9jtAGnpBLjq-vLQIyjshG9UraFqFsNubzFtgb2w&oe=6A84386C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlHwMTpAHgwQ7kNvwGe74wH&_nc_oc=AdofK1WOKSl-yZ09lUtc9HFxkcmd_9FoR-qXrD_UYSL3CO_VkN1QdrkLkQuPlXxeY1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVTqDLnHBDKy6JfeN9spS5Njs_msYrZZZ9dVRnlzhIwQ&oe=6A845253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUvFgLQuH3kQ7kNvwGovue3&_nc_oc=Adq6If0RwJeNcvM-49cMDgTjedclqK9RPpDqUoQ-3CKFtWbRohGWYEkB8Buhf4rgq18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbqUF6hG2qCVeGQ7bS4Z09W3NRKrywjFCzEtD89n0LKA&oe=6A8452FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1Nd1aSLBFAQ7kNvwGiIMKw&_nc_oc=Adp4qpfS5HqJRyIiwalmogEBohmCEz8Ph0Eb2b1UVifm8mjmqTATCvWxygR2npt6SEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgQElP7Rka6xa33hYIg52caNObbl2KzMOtBNwSAcE4yQ&oe=6A84554C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhk43ZLCHCcQ7kNvwGBwfGw&_nc_oc=AdpaR9M7KRhu40mUE2o3KFdPPSVfesMgPDN_QtycUHze1wEL9UDbFEyUyWQlOr7n-XM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC8hie-ZvCarRZKjXU9sgM1whTb0BdTpFJMnP4Zw4Acw&oe=6A845E7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG_vbQgLtJQQ7kNvwHQH5kS&_nc_oc=AdrPNdjBAFiVtJPR098c648JIy5bEPE4ElQBiPC2JAzZtfPTLqWmt_XrmxTWegySJqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDUrfN6cepQ-nHMGYHbxrVKsUJ99Eh_CY-z-DUSPtMTQ&oe=6A844489"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bQaXY3GHisQ7kNvwHbQvtk&_nc_oc=AdrnzQZ870Ehrd7VujryJBanjcEBALQ6NsrAHB3-HzEPMMBOcGF0rVQuNbLWjSAlDS
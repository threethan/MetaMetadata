t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_cQkydyuwPfhQGOxkVhgaccEMD8KjVucIcb2_xVlH9Q&oe=6A637B2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUCKKewI_ccQ7kNvwGce-s9&_nc_oc=AdqCJuLY8ClxQGhvZ0mjDgY43dwLIbTsWjI4BLAEZMDy-UVy6gLbAy6aJYcYR-JXNZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjLYT1bxKqXINtIBlicYhW2IdpihB21HerGCnoB_NfJg&oe=6A635CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgiG_kD31lcQ7kNvwEXNiG-&_nc_oc=Adr4bAg7uUxc1fwcKfiK3JRSESJT0VlcmLActIgisvmWyDsYML8TWQjRznmVk6yFccI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmiO6e7-ozOy0JUE8iFzVh5B2HOi3OFTVZJLiWDnxr-g&oe=6A635D7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3zrNUG83KwQ7kNvwGSn6uW&_nc_oc=AdoLATPxpF54bTpAVNkfswPYfJFqx9rMMCejizdbZjJRA8kc14cSjEvMGwBs6AP2W4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlbwAiK-BGhZUgItFOKCSdy6X1GtGzB_nW8F5q3X7Hug&oe=6A635FCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p6YUp9CK44Q7kNvwE4QoVR&_nc_oc=AdrQByXR9a511MqjYnb26ZINdt8ug_gkgCM8DltSyYKHoXdfrCvduQXbLIuegLgxI-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb6plFhMcwJYf79jM65J7CBRcpLrMtxpOjPohB7w0KPg&oe=6A6368FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGQQwGrBJ-EQ7kNvwFnFoOK&_nc_oc=Adr83gI6HARN3V5ONDccXQdHrx9WjRLVjiiV205bpeJutWe2mX3ekTFuC3HAgczWeEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQF2oFY6acTgIoN6DpOA45eKsYvR6Y81B5ZBUjbopMbA&oe=6A638749"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBVDWZBpMcIQ7kNvwHk5lkd&_nc_oc=AdrTUBE6ozX78a7FcRo6V_9dqT_NikSc6l0hcwZH9OCV3fuu5cp-L-K9iufv_J_-e3
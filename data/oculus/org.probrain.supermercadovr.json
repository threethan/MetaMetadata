t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8fEoVVKCYJlOV9o_kPAgTS2O_mDqGwDL2Pbw2ctmXWg&oe=6AB2952C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsx5s6CaxrIQ7kNvwGsyRJD&_nc_oc=Adrkj0kKU7EGsx5nBdTXBKgDiNhRMf0RWj8LACdlr4dOoo4EztE0rUrNfvMWQV_6oeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRlIPWepAsFcFILlJBnGyBE0HiXd2HI6ok1yGUGHYp3w&oe=6AB276D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7QOcaK5wSkQ7kNvwEcmR2v&_nc_oc=AdohZ1Pi92REwuMwwSVwCxQuAvJ6Ob-g9whggvm3BLPZK850cWEutc_88GgCXKxtFlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6MyNrq7dAlOWm_pu1pb07_aBCOBZ_t86QmvsYtXsGFQ&oe=6AB2777E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enr7ogkFFysQ7kNvwEp_7t2&_nc_oc=AdoNp-U8AF78aQnpuXWT0fcJxBOGIrdmPIGc7XU7i989FyO19EulyUqj7YDR-5o-pa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7XiUv2rmzfA7rv8Zc4ONFmBMG8yW1UOottnwAr8pgeA&oe=6AB279CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AW9r_5RzY8Q7kNvwH7flJ-&_nc_oc=AdoMXLRrqQOcvwz_PlqqyUiRbkbtLATc6d8KNauTBLA6K14WisP5zpOfCEdqRcLPyo8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYuuFiLbhJcW7vAkrk1Zay-rsfWAbMJ94QC2ROkuFpeg&oe=6AB282FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE1dch97frAQ7kNvwFkR_n2&_nc_oc=AdrigIvdpimSc7jhdhFiuuOwugkSz5Epld2DicjbjCfAlf6FSgPFyDd_zXZDgJziRDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_CArdGgBCAkDv2kHEJleY84ZWTrSEzj81imQuu58C4Q&oe=6AB2A149"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1gw8ElVn9cQ7kNvwF8V4xn&_nc_oc=AdoP84MWbdC2hXRWQUktfbqiWgyJi0k5VsSMBn2jb10NfQGZHP1LV6TcI8MSfQL1bR
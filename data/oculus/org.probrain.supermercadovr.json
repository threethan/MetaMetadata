t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf3PBqaYRlssDwlvICsPAdnEoooJdBFZRPoQKG8jHwVg&oe=69C9036C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kjYSgMgKVEQ7kNvwHshYNr&_nc_oc=Adqx2gRPLTHDosoQ7B9b1FuiEJIH37UlRxYCp1Gy4Fo0js2wrl1KVnGLqhdkBFVG5lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV2w3Dp-aj7Vfc2CZuck5sXJCPtd1hoLoxhq13j5Ft3Q&oe=69C91D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWZiUphHr0cQ7kNvwElKHez&_nc_oc=Adq_3Dw6Ok03IIZL9_DknDrKfF9QvaGqwbAlq1q-16r5zIL5_KHiSSsCLUz0lpY9vNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzn9Fp0xvPa0Kn3slDtBXWU2OgAeSViyc_13V1ZgPhDnQ&oe=69C91DFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kflcomvRNPEQ7kNvwFx9DHP&_nc_oc=Ado5nCyd6zyQTmwzjXIfGoXnShRRDTT5jni88eHIburnFrtSIq3iRakOZv9t74EXdMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmUbheCUU2KytRPSNrtRWQMn0Z1SnRdXHhvHPQ6omHQQ&oe=69C9204C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELwgZEmpE0Q7kNvwEgA6GG&_nc_oc=AdoIvSss6F8_zmNgvDP1SeCVNXvXpwER2S0-a0KMNcFbT3A9oNHi_cR9NLpfhmRVgWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvMmRPnHl0QCifcsf8blPEg01bWDvXTJ2euLaPGYyDlg&oe=69C9297D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0bgnJl_VmUQ7kNvwFDETgk&_nc_oc=AdoFbdzLPDXYdT1zKPngJAPZZPvJpYwFB1eNCOsoFFheDCItf5MIeS-Sfc1Hw7-8SIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxewXvDPoExyY6meLB5457kabWhTT5V3XsWeMolPZ2HXQ&oe=69C90F89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRQI56XGY64Q7kNvwEfKFOe&_nc_oc=Adoc9RKtv6Za82QXIfBB4ry3m_L-jMyJGZc1Tz-MWwb1PAZ-J2t7q0_8m88RvdNdEz
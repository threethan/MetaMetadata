t-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKZsqP2yVujhBP0ch5yR6R-QDHGNkn4Lf_hbIYlTMicw&oe=69C7B1EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kjYSgMgKVEQ7kNvwFs0CmW&_nc_oc=AdpmyCr10e0eZJIb83i-tYkKwWKm3Zoasin6USN1s_MGiB_62_UCckESGQrX8Pps4ck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb0zEMIWfDvWvpDrzRD6qVWz7kVEqP04dkXuNpDk-2FA&oe=69C7CBD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWZiUphHr0cQ7kNvwFfhS-t&_nc_oc=AdrpdB1_QkwTa97d85GZFQGF88fPK8SH0zPJ2Nu94M8rpYhd8fA5v2x_vuzGg--AWPo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKD6-O-MIe0OOr5yCgJq2zPGmi4rOWTkxscWeu3_vCMQ&oe=69C7CC7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCuBIVS-d-YQ7kNvwFKqwQG&_nc_oc=Ado2t8pFpfM0hEziWkPWDjONsbTjsd0GMH53WTNT1cZMp9E62I5hM86YsOnP1s3MllM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2PDgeyOX1kXFRHsf_omORQ96a_VtOAyBHr1dhP3Iopg&oe=69C7CECC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5oOLbIwO_cQ7kNvwF2Vi8B&_nc_oc=AdoGtVJHOjFy7MZwE9bVzroC0xvnOgbSDKMl8Sm9TbQ7i7TgUpoSn6lTFpwWbAXVL_0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDdKhfAk-r6UrUCVganjypNT6iO_IU8vD-R7DejfLkyA&oe=69C7D7FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0bgnJl_VmUQ7kNvwFCPTdW&_nc_oc=Adoyng67QUgwdXN77Jza2muqiHYCEBXbCu6OHzDoVAZPCoWzj5XAuZRS_MVBG5yniVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywymK1gxo9QewaHZplL7wFj7Z3QJn7mDmAYwpYPPSiMg&oe=69C7BE09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRQI56XGY64Q7kNvwE6vVum&_nc_oc=AdpIoIg734RcgypPEEb7w9fqy8Wwbtm5W2Ed2PXjjwS5ZJMwNCyqbZosNlbMme1-Ny
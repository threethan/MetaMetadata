t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vp_ooCGMN8ztAtaqOCEwWKIeNunqMJwibFVt1ljbLXg&oe=6A14612C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aPWKVYdepoQ7kNvwH-Fo5v&_nc_oc=AdqrXiA8pTLeNUzveAXDybGwOsOdnvgB9gLDlzPNNByEC2COWB0-YPm_oimUaMncvOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vPHofd1C8DxafON98cXMub5QIsSa06-kCdWDpGOZDcw&oe=6A1442D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V9bAWZfDuwQ7kNvwGYCzfa&_nc_oc=Adp-jNvtW_gtXl4QJ15JsFuYIVjBCYCQZ2Wmv-lkABJIVxtqjJTp6WT2N43nUDe2d_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af446ka6YYbXpBUVxW9vIZb44RscaQ3hid3IAOqd1VmZ_w&oe=6A14437E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Z5gf0GkI8Q7kNvwHpeJTU&_nc_oc=AdqL25gwDW41IK_8ZtHuVjJshv17KirxLAELJBZrrf232Uxp0pHRs7iLYOJ1R4jLLBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OKR5bxjKT6QEtPuhj0CEdMXpBwuwWlkBaKuvwPCcXuQ&oe=6A1445CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNEvJJEVRggQ7kNvwG6gdpD&_nc_oc=AdrzfY_yd2AjNDaOOr_19JUlZcg7GPW1EzYtshbmhlus279j5cXVuEIpQrJNDeMYDo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66sJo2cS2qpmwMaQ4_Zl_7OrrhhAJiCismjr58UVAS_Q&oe=6A144EFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBr8C45ky-YQ7kNvwGpNIoK&_nc_oc=AdqNGbCQwwrjIJYZNoyWc9HP6yjclvVn5DuFSaVjlM9U-XmpNralKl9D4-2h1KktXpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V-Kr_6spSuvEtAclirtSasqkgTh_K3cschprf8oFRvA&oe=6A146D49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1HzdsTj_QgQ7kNvwG3eLim&_nc_oc=AdrpLkYIYHhaLWNw2Yd00-3VZON-pH1C0F7ADDPH-RzJyL75MpAZyoF0eXXLQ2aquS
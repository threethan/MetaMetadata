t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpSpDlpv7gAnhIKsEB38LgF_JTBAsDegJm02GOIyPtXw&oe=6A8ACFEC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K19s1eZS5UQ7kNvwEdShMq&_nc_oc=Adq2-Bhrs0-E8UatEljKeSLNDAFemKayVzq4IXLxL0Rn1y-0pyYGYkslS6ZXqvxBfcg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJv9jMdKvZMpdEgzmElzALF7vwll1MbBmsJW52x4Hggg&oe=6A8AE9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPxM1RfBwoIQ7kNvwGAJ_uz&_nc_oc=AdrWYQdzBKFIKI28ohzyj4D1rwq13xznNHpvGHesr9yZXk3bopHMx-POC3yzhkg8bOQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHKKCN1nFsVTDXXyG-Te3gQ-VUWOCf0VR_ju2DDJvmSA&oe=6A8AEA7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea4y-yP2WE8Q7kNvwHPvbG-&_nc_oc=AdpFrr2jgNEBRUCkHBHUf_qRlPNPDbomM5tAHae2AJCxk-R_-BjUJuyfN2PmvAoXVRk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYcMh90JqDLlFemM5BmgETm58CYDpqNuR1k2_p8GaNpA&oe=6A8AECCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JHAVNM0SCMQ7kNvwEor-cM&_nc_oc=AdrnaN2t_WYoejMtE8v1cRwBTMtXDqbKb2lukxGBiAtYeP1CuIQByPBKo2nmCs56a44&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6OoDGJLviBsl4sh-7Lx3dVukC9bV1CAi5I1kvQEM40g&oe=6A8AF5FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0du2GUsKyAQ7kNvwEil71e&_nc_oc=AdriZQKBI8I73CyPbxUCpE_43d6lVLfyR3be0p7ynrp8ZrxlCAGWMRa03uGceDW2yMM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzxJQHj0dMT-t3VyGrUjpHrszDFxTmISBwkI0QStBsXA&oe=6A8ADC09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC3Jp3sdyNYQ7kNvwEGvXf3&_nc_oc=AdpR0xDZi8WuTIRkX1WqrRdyU5ecL2N8AgvvGXgQb4dq524i9pddL5FpFG_bbDylKC
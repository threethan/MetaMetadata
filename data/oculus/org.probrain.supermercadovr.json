t-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-OWp99nI814YQA-HhMA2FrVIsdwFAVsUEQQgmYAoQDA&oe=69D124AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wEtUJL9XkUQ7kNvwGyhSs8&_nc_oc=Adpu1JdFZgIH3zS9xHW2Rbt6aSgW-Toz3KXYM3a2rqzUm_rAUB1d3dTl7F1exwFJgYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZOYfhk6QIFLAM3-uXlMUfZiB42JdkLg7UAa9VTkHAgQ&oe=69D10653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLv5BK-D5hEQ7kNvwFa6Sil&_nc_oc=AdrQ7fEpFGq6oTHfJPBH8uPqxE5h2r63yR4zZSAgmBLRc3xcl9KiV2GyXZZhs5qxJXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycptMn-OAioVHHihngtbw4eBJWFvGEJ_1XjaxERO0vkw&oe=69D106FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8_ixAlA5uwQ7kNvwHvYwZ2&_nc_oc=Adr5nd7ahjBxBhhZjJeWjUsqC2TA_Ny8KX-OmEbqPFVOy9ZvszIXuF7iw3xeONExYp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGbLpoCM3o3jg_r660YzAteDWhp570G9qgFbC8c8Q_JA&oe=69D1094C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY3QqUmhbfcQ7kNvwHlb99i&_nc_oc=AdoW6P_nvwIiOqKa-5x6y_mrZq_4wKyQl4zYnOacrTY8vU0Gak5WneTkCFXJPYP_Y9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPp-Qq3RjpMisC_tuo6-Q8MCpLhvOHAshrgOa1CWRHPQ&oe=69D1127D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR3MRFV-524Q7kNvwFHWKeZ&_nc_oc=AdpKmoTHeUfHyyM-CafZnU0xIAAuY2jd5pnVsfeL2R10LgpYkjNOpgGvnSGpneaz0Hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzleQZL50rrvk_-X-shqGmgAPJjVD2-85t2AkI14D8i5Q&oe=69D0F889"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vQfsjYXCNoQ7kNvwFzXGI8&_nc_oc=AdpacHA42SOYs1iRbsWRLRSbMSZqhI13sTKQH_jt-zaZEtpimX3K4IU9aHBaUVHNsq
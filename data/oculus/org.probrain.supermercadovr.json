t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdCUm5OX3LSbeTUqFbHIdBDX7i03DsdjvxKHImMKxGlw&oe=6A5257AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT_XlucKiHIQ7kNvwHE8Ti2&_nc_oc=AdrzCy6Ufxu7zM95kaA1UcV2V49yUpnBOvbDjwvngAGqnjGxrQjXF30X6w9WF3pJALQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAof5RBCE1eUVxm9j_y8UfXOSGa7x3lR-PszKw3FfvRCQ&oe=6A523953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP9Lx-00wjsQ7kNvwHxJmgQ&_nc_oc=Adr4mHQoL088hswumSleZiHHJub_UWNOWox7hmYwRmHQtiWEu9iokojbG7g1_Z-ex0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApi4-f0WqY5pr61q8upSYmnsO5H-ZQqC_nKW38fzgl0g&oe=6A5239FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG10wD9yu2YQ7kNvwGzWw8V&_nc_oc=Ado3P1aDGxD5I6FSscIbcKfFjI0gD01nuEbDwakDjmUUvXBXsYIsJbM27ZsYv9Dz1ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfsYLZjZ9r4ZPQJ0EUPISvgTsJa3pH6nbTSZyRSPRLbw&oe=6A523C4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thA83TQrYIAQ7kNvwExRAKE&_nc_oc=Adq_Ce5tPZJ1TNNfZHaebRr3IHA96O1KI4yKLm1mJdZ_0XYrdBFJ2Lfrf4hD_aH7NpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLgRyuTX4LxQJWAMXmXUZSkLMkoflp0FfTpJn4s_9-gw&oe=6A52457D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP-8C7Xk3bQQ7kNvwFFoL9-&_nc_oc=AdoJi4eoZd1nBRpBQr5OQVDOaP7bNCvDum_piIYtxRknRuzljNGOwI1EqUqNuU6Np2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoW_oF0AHx2DwOleG1rt5m4bCMfHYI7fIHA5TtQYC3uQ&oe=6A5263C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Acu7YDUUZWYQ7kNvwGMGuZq&_nc_oc=AdoNocQRvgWxLSmOuK9AZm4NhzCtF0tFh-WnzfVWnj-nTY9AgftdniRguvklb4CraG
t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbhEiiVgqNApTqhLROI5PFt8sC3OObOUw9ZjrHOiWnnA&oe=6ABA7E2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwvV4tfHsSkQ7kNvwHS8wGx&_nc_oc=AdqbdJYXhIk9Fm7AeffJSf0qxhJPB7h3B1qnyvSqCGYaivoGzHRm6c7G-Y9cKDE5f0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJUqkSBepsFywdYJaS06GYo4JDfQPY13iwlX4r67phgQ&oe=6ABA5FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80SBmG28X4Q7kNvwF4cZPT&_nc_oc=Adpilk0x080pr_zXX0mAeeiqCcveIfFLYYtXRrbPadaalkMpSR3YzY2RFHY2vKoCe_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQkOOnvqvQMsYO2kylIqw7AaxK0tmThdP3QJNm0FO0Ow&oe=6ABA607E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vlF7A43ydkQ7kNvwFxxXaf&_nc_oc=Adrti96ovuoOHt130JzvW4g0uuQiAK9WWC3NcDSDOa74dTLyqIeAyWWntNZBlbiUk8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcTnCRAGsAeIQOL68N__2aBOKY0wD42vHkQR74uZZhEA&oe=6ABA62CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHLuuxhSjgkQ7kNvwGKHKuk&_nc_oc=Adp7hpbFK1LfXlk6bLXalag2I12cfEg4XNJKZtOtdRWhmgX_GJsVm5k_tnamcCv0oAk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvyctybqGv8D2PuIeMIj5q0EXu01Xyb9TSt55vhqu8gQ&oe=6ABA6BFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxkM_uc4c9AQ7kNvwGoGJ20&_nc_oc=AdpYUCS1zC9mVEjWNtv6QvfwjFxQxgsF9C6RT4_tsCyBNzBLHWf_ekNhRhoI0t7RK8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK95L42RI1o7RN7gcnJut4kOm1bC8wyv7dHd53XYJRXoQ&oe=6ABA8A49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as54nrgFLkEQ7kNvwH6LBVl&_nc_oc=AdrigNZoHFa25D4F5zZi_fWlNUbbI4JmMQy9wwYu2pAE0xHlYCU0BKEU_57WhML_qG
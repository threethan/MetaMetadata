t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL23alZvx_X-pNmtVWH_8Pwbk7lm8TgwnkTXVX5O9BRw&oe=6AB689AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmYOU4hua_UQ7kNvwEBB6bV&_nc_oc=AdqH5XywWq48qtaMa_Bc_o9ryYV9eg1W5hsVn_aTSDJO5gHQ3a_35cpVT6Ykh_Lg_Ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdXNsvIeDV-VtV-oLrJX7cC6BnizkUNuf7YDjwtHmdiA&oe=6AB66B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNeQOjEtO3wQ7kNvwFvV1mT&_nc_oc=AdpPwuqttyk57G0z4IATcbbqOQ8F1DfZA3LFTQ2cIs283RuuzOYzq-WQPeVpUyoB0fo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdyPGKJv1dJ70s6FpYhcpY-BJ7lXcDjPRoBq5sVJ4Eyg&oe=6AB66BFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOR0FGNBMIUQ7kNvwHNLIVY&_nc_oc=Adozysnv9vD5SULaY1TSzzIxw6juh2FYbnC3JcWXUePskXeqWK945IQBjDOqxMXK3oQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW83rSGiNSG0nX3U4plOGs-I-qafXPnO_cslZTo8vl-A&oe=6AB66E4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6KUdXFOaS0Q7kNvwEeOaAu&_nc_oc=AdrZleTsyTJIIej3J6qp5p53y12zC6LpcFXBlXO7orfaLe-uypSaQmWEIRr6NVgaXbQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIivgScjm3Ko9h_c4eorzr67T9oUNetmM_T_tkXV6NF9A&oe=6AB6777D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFanF2GTbywQ7kNvwGBfSGm&_nc_oc=AdqX5qLOMbMA9N_ATlF4zkACx0MaeK6LSYflv2QJnIPhYhSfxH42-RfYivMPjCkWibk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLmeCEJrdgKVpE3u4q1BaCNiQnNnNPCiDp7XO2huS5Bw&oe=6AB695C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HZbbYggB4UQ7kNvwH97QQr&_nc_oc=Adr2HnoYveGy6AvOjh64h__jOJKqRBRzE_vdYQDqZCUEoTWegjXCvjPEiuHBZ-5FiB
t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rNb196LMAL__KOKAiJOlJx_2MwE16rIct9whiE1CyuQ&oe=6A2ACAAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o74zSvx0OQUQ7kNvwFKX4cs&_nc_oc=AdqAcBKsGjmY1nxFLzZQqMPgJWRarKD7eApU90Lnj5nOEegp69HbSjCa5a5fYs4i8ws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9inizVvmdgXbLjCQoukgKQvWTlkp61lNKMlVlTYlX84w&oe=6A2AAC53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FyI-Xtx8PYQ7kNvwFsj6Tr&_nc_oc=Adqe7ZG644fpqW2z-UhEbDlTMbTj6gWrf5AmTRWRGN-B2fFwswZpCuCCw6hhDmcMwAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CPbFyGU2FdtjsyjHJQIdUgdYkG3NiFnR1xgdDi4mJlg&oe=6A2AACFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klTTlTlgdhcQ7kNvwF_jnsZ&_nc_oc=AdohVvh0lDg2mxf9ArCqeUkwGhSxr5CwM3hars8w8nyfn8_4wmzHvsobwrAQaFfjnx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QFlNuVVb6JOBDI77B7zgqLdyD-CAwqKWBtfi2LvBlcg&oe=6A2AAF4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDuDFi7oO5gQ7kNvwEhYhPU&_nc_oc=AdpYOMXcpgdz86VC8wPBsLwyt9B5Zwm8BQbi59JmOgSXwPTrfxNOwX0pU4hTdOM2IRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wBht3edwiGdsDjWTvG_Qya92Vg2Wgi84aJ49Sy23uAA&oe=6A2AB87D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LD12UPdjYcQ7kNvwHv0F5L&_nc_oc=AdoKXU8pgbLjGY2e1vnJPos69o7jE36xZ2ltsppa_gOa3uQ1WV58HdWBUzCsoJvpjTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dvZiM8GKdqehJjBoZzts1rltBIg3ZDBWd4n3aEeYS7g&oe=6A2AD6C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcQ5ZkIrY5gQ7kNvwFIipke&_nc_oc=Adr-hcd0i5MLXXqExdtOBsdHTV6mzBkYD-TeQkld6SE-CjWl5DjfZEdxB-SZqGgiNF
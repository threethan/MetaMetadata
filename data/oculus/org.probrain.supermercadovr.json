893955", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LUyXylvF_AQ7kNvwF_KmRW&_nc_oc=AdkqZekdRga-HIijN4CoiNxCcGEC4YwbLwHGR9nlEnb62na8CAaDZJ8Nvvp8fAQmdVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfufF_mbsf4Pzfk4Cjms-Ddzgs903-B61ME6BqvOrhJ2Kg&oe=69A42A08"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI1evgBAkdgQ7kNvwFKJqMH&_nc_oc=AdlfTPFX4s_bHgbfwOhHfPxpmLomn0LpF6sDlVMWCQm5ypyYwD6hobpwHtEus9hj6-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8EMUv2nSSHO4HnmvjcMu4_TK1fmJiIRJpI5vIRlyV0A&oe=69A41B09"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IQ-HKHfBgQ7kNvwFB52Dj&_nc_oc=Adn7JqVsamoOaq4l2M7dWQncj6TowbxLIBUuD9tLW4bh4eFgZ4IyzxHmzQqeJKe9emc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvlE4_zfGKLQ7tRdhpfToJEJw7WK3Ede-vpo7WZfin-vw&oe=69A4196C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XgZUCQf-b8Q7kNvwH-Zbv9&_nc_oc=AdmjJO-N467HsicRw_4iNiDMv_jhg1HEUXhzv8_ia5QjCybynYvC4HHl8NCJU06IEK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftfsSiZW67rL0_n23J0b8EYbOgp6DFLrzHyhauNcAnqBA&oe=69A43353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5Up2-v0-8UQ7kNvwGso64q&_nc_oc=Adm-Z6zgi1303VIQruhyK9_6fwh8oSvpWCnOQo0H5X5gwGDla3rN2PiVyve9ZRAdek8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsIXazqBKdKrTobYZoysAz4pb5tPfXCvfGE2mf3O5Fo9g&oe=69A433FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vD58IWh1KgQ7kNvwE0hmdD&_nc_oc=AdnUdpXPwus7nbtNGM98vboo768SYqiI7bYwIYMzk-X9pR-rERDycvhTnZ6q87mBDTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6hcl1iiPuoLfRvdJ6bdmm9ZSmofNPO8dNZU0Yr0vbtQ&oe=69A4364C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvRvC2lW39CXGUod-CQ3-A20VsJf3ONkSoGZZK2Epp6g&oe=6A882CEC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSwP4XJvMOsQ7kNvwG9B-ht&_nc_oc=Adqd3mjMGmHhwsnQf8UTk3Mx1ilt67GXWGZI3sgdk2hSyIciD7gCErw9_l9nbUf_m4A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYWx1npLE71sDcOf2OMGsnxNx-evY_Gbc_f0ExphEdbQ&oe=6A8846D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbckvhldg7AQ7kNvwEldq9G&_nc_oc=AdqjcahhYqBVW_G0qXS22LV9Todx5SUvlBWbBamUkFVnTzXUZJ73bWmIIO_ZsSYdlO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFZPqab2JppOgzE0rnYVQr4ITTMSZjksXccsdEnJMgrw&oe=6A88477E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqvdvk8qUzEQ7kNvwHkFtwG&_nc_oc=AdritsM0MokAtS9qdbByz2WjveZOlU59b5ZTcV-Sloiu6BrpCgS0uKlQRTFiZpy2Uk4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJL8I6Bq7Rrh53wo8-l4ZATKZVlxOX12fIlbI9y67kGw&oe=6A8849CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0L0BOgcJqAQ7kNvwE7bQ3O&_nc_oc=AdoKf6AwQ01fiqSt-iG2LgNA9a03fEjy3h6hEKDYRRBca2oxvPyZyhHjX2QsivqzJn8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjjsZilm1d3hke8sPy9I6NRHZ05-P9DhG2l4uvHTQnTw&oe=6A8852FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0du2GUsKyAQ7kNvwG-XXKH&_nc_oc=AdpIIR_0uHgRG0n3BipNzW5zI3QtcneDCJ6_YH3qR_KIh0crIFzhXqSqgCAvRmTHkkQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhrZNJBbAP4vp3nYxJiTDQx6orXI3YRLIY8dZSbBNj8g&oe=6A883909"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC3Jp3sdyNYQ7kNvwEVKyYu&_nc_oc=AdrZLpGjUGMkJI2xClJcJjf2oYaBQrpEKOy7KEnfX4JN0YmFw6AdEyrHTfIlcTTS8U
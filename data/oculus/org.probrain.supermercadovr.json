t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzijMs1fc94evyd3Utaqc7z1MGxNnmdkxkaRPkUa601A&oe=6AAAAC2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiOlUtMmaAQQ7kNvwF9IfGD&_nc_oc=AdpV1ZvfUhZwefwi9TYdtb8Yl_UPiUeehs3kgGOU4UHH-tRLDOJa0LPEIgzaZf4yFXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVBm8aApRcb5liRSg4RFv58NcUuWaPmsdjW9Zfe_r1NQ&oe=6AAA8DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJAUjr6UmE8Q7kNvwE3BZaq&_nc_oc=Adp1j75Dk9Xn5ge237o8EQtIgio-POp12nccwC9VWdWkY4cPYxUVtQOU69d26w-mDEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKblO1N4PnBup-P-bSBqcMfvEG4sBZCBvnVVOB0IDpQKA&oe=6AAA8E7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXYeIWjz1zoQ7kNvwHqESWl&_nc_oc=AdoUMdigiduuc4xWVZZtg5bybsigC4PRBhFZyIJMz_nDMqkp03FnbsDMR9fEMHxiVFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM8RVqPWPJVkLtVUqwcpuFUNUUm6lXC9PHjz15MNzzzA&oe=6AAA90CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHHbom9DmwkQ7kNvwFfW-xc&_nc_oc=Adqi6dNLrlt89KjXcDSYXgrHBl47NvjUNmPfjKf7cCAPEL8SJTrWihXl9XvS7AEjSRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3N72Bexy5oZAPT30z_fASDIOh3gXgbDJdu-jhMhIQ-A&oe=6AAA99FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5uxKznRmHcQ7kNvwHLZ38y&_nc_oc=AdrJ6JFnC2VdoSq0K9nuCG6s2bezprjyWLU4mbrJDdkb7kwNEfPjWdVmlMzY_O1PZTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUHDgf_912t69mIWkdRh4cW3MwetmOhmdAV-DSZLOWuQ&oe=6AAAB849"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnM55M0bmtIQ7kNvwH9zNsb&_nc_oc=AdoLJVePuCh7k7KVr7pVEIkmjgZ9mvfcy6FuQmCDUqJxouq5uPsMsBVugorNT3aU-f
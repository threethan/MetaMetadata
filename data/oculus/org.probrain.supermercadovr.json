t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjw6rF5Md6yX5UcvxVE0rebDRTuzOZnxDjk4DQIGsB2A&oe=6AEB45AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcSzIhdi9U0Q7kNvwGGU3lx&_nc_oc=AdrMK5pCnbG-8unNPOKZc7XIwsosiLIoj78H1qwRwiESjRZm4H2HXuy-4b9PnJuTQAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd2jZQ8n8qbCM0EndH5d2N3yqKC9TAvAGcXYvB4KvfhQ&oe=6AEB5F93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KSRO34Ip_gQ7kNvwH6X_mV&_nc_oc=AdoloTKctOBv6T0kq5qTbEh3BO-RF7qKSFgJl-XsKSUA2PM4zWnTr8rBLJZDn079jLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjb97Fwwo3Qu_ZGRXcizaXyK1iX1Le4uEzzacREiJP0w&oe=6AEB603E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNH1Qf0bLUQ7kNvwEbjPHu&_nc_oc=Adrvc8O8j9hjV4adzPKgWWSvRRLgBrRrVMfk0Xa_FxSKDNTA_GXXsUty1wfe0Zv3SkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfRQSjDxhFe42T4asqaNFccuEaScacqZr_n8zg5htomQ&oe=6AEB628C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPpmWJhZzKcQ7kNvwGULgAO&_nc_oc=Adpv6AbQyvJ8mobiLYrw7jhcUWHZeeWoHHBTvDpfnQ2NyXl-Rt9PB7Jtrlu-jltEljI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqtL5astsWiLyG_9v-U2DpIx_69bbvGCvevD0Rh01KQQ&oe=6AEB337D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwsfMuyts48Q7kNvwH1TC0g&_nc_oc=AdqJVAKk7_VjMesZQaBU8zY4d0-C6J0ihu5fmEHxvA2N0G74M83FOovK14mh_nqfb7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPsyfnNvKkE10qicQ4Nfe0oNnok2EKWD2c-EEamYVkIQ&oe=6AEB51C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_totRDQvHmAQ7kNvwGdPQLH&_nc_oc=Adr4H4LRK663MUwHSWMIe5zZskEys1jd2O1bhoYBRNYQuHeMp7WsluHgdMkxb4k6BJ
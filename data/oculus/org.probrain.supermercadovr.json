893955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da_4sK-hynAQ7kNvwEn4vLi&_nc_oc=AdpQ2XSKOaYkWzsN6gt9OI256yWi48kPSd6OVJkfop2t8XUKUd4yA0bId6H_xTyiYzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0syxAfWKMMomGvo3lofo0s6O6i5Mir-vwivUYJzSBViA&oe=69F0A108"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_G_Vp-1Np0Q7kNvwE8x1lS&_nc_oc=Adr9OdjUWILM2rE3aU0mWZ7i_RpNM5PefRYWk_c0gQ6b13xqByjeVh4TuQ7MidkBdO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3f3vi_6WE0sqbYbcGxTT2mv2eaFWysQmxr5RPpXcQYDw&oe=69F0CA49"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c-fS4C0cLkQ7kNvwEZFsQc&_nc_oc=AdrPOHxiwmYRRW5YA2BlpKBJYUgGWy24nn_3QQgCEuMmPZG-CVpSyoaL7gB8-OaMcXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0BCpYCKaIN6nqINpdhbRoOQ0swom_wDi5YIRSoiKkp_A&oe=69F0C8AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0_ck5OXYrIQ7kNvwFCNuOZ&_nc_oc=AdrahNXXUi6VIQ2pch3hGhGomVcBSx4HS6bqQObARcvyz-z7HK6Jch4TTW4HeuRYK6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0-zljDBBlqRbZ3zdGvBoIlmWbpHS9Da22KPQqWocorvw&oe=69F0AA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZy5O1M-1IAQ7kNvwEh7CJq&_nc_oc=AdrO_jBH035vCujItieA686Pza6Txmatd0g4AFHf4I-41FcDoD0NuNXJaxIAZnuPygk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27iDjMrPDY7f23TlGxz-eFnltLd3t7-t3WAddO-dN23Q&oe=69F0AAFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epKY19BmrIkQ7kNvwGg9PcQ&_nc_oc=Adofw9Kg07srwuof83LZ07gNkXLFGkl20HgUT5uJg2AJwCZ5RFvsEy4FL2yCc2-U46s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0N3giXW4AUOYEleJbXB1dh4ZeoWJ6VgcpQ5wI2X168Ow&oe=69F0AD4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
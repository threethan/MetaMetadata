t-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIqSzgMSqgy0uQjZ11U206liA_bAU4FUU5RLgBC7jGcw&oe=6A91676C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01U_fVeP37sQ7kNvwFgAEm6&_nc_oc=AdqipAJyrf1l2FFd_bwJC7_A89pZ5bwGO5EtNIaCUhcOyDCF3rNqr5zRJKW0y2D2Xgo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBg0Yqwc9KFI8uxPF6xzV1bPN8utlS4CKuMAB2Ad_ZKg&oe=6A918153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Riz-FzY-ogQQ7kNvwE-zCaC&_nc_oc=AdpzXKLeAI2CJ6P3Sni2-moIRIIQVJlwIOEdKc8tBJYCYYTlvhvKjcPOxK0ELD_s4zc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM_VIyYBKEyC5-_JpwVsUwtsv6mSCNJgT3naiqa4at0Q&oe=6A9181FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEO_9_uE1iEQ7kNvwGk6oIR&_nc_oc=AdorbhzCExCw49V2V52iE6A1mdnk_iIpmYq5k0FCqvUct1xNaJ7PaMYs8984crJsYrg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc-DsSif_yC0td9IjVUYmvvr5cAcRdwbg6PEiIEjNpKA&oe=6A91844C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKGMzthf3lMQ7kNvwGlarRm&_nc_oc=AdqrEWiwrLToDiJOySR02QtTeYAGLXbhC8lUFWfmYI3aWf03M2GkERz1-D1LujVbzZw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTztxirqyV6Ua_zjb_36zHEy3nmeHz_-2Hqc3xzT1weA&oe=6A918D7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFUBb8-OpPQQ7kNvwE1fPj-&_nc_oc=AdoWgUhvxUJjbQLtwEUQTDCceA5dzI8WGatPIDE-eV3X5ilhZnQMV7g15nktC6FN8D0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZfDAV6UXksiWSl4AGGW7D1-gTK8z9txekzmyYFZfY8w&oe=6A917389"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K437pgrR9aUQ7kNvwFQyYfo&_nc_oc=AdpI1a2rBaEJqGRhxV1XugreTekBNXFF9nvDBlqthehx8aDLCzyH7Rw9e7KtJLtHwZ
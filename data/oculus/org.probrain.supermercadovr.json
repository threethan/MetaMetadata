t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdg-wkpME7PS_KqnCX54oqE9fTVb5VZ7NffnGLgIWK6g&oe=6AB5382C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmYOU4hua_UQ7kNvwG5wOhL&_nc_oc=Adrup0DegkIn-j8p0ugML_-j4x6p4KLyEfwBRSA35w9Sk5j43WI3PTqHEmgu_tnlmmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxsUgfKzRJWAs0sYOji9EE5zu3e2bcmRjJwnuWnemFFg&oe=6AB519D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNeQOjEtO3wQ7kNvwEIyePM&_nc_oc=AdpmvZlSlqzJGH7Fhe9S1Leby6By5idnCPl2ATlEFWVyJYrZwrRd0O0zpUdeULAmV54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIagYmhb2cAHB00tNQAa9sO573aYtWdWeo2ouJF8X3XwA&oe=6AB51A7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enr7ogkFFysQ7kNvwGZOh7Z&_nc_oc=AdpFo9wzjNvBat-siOaM4Zt5YP298mdr8qXxKhcGn3CBh0bcpVWV01L1EhcWo9nrT9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSYsNDlrT4T2iuLS0Z8BXCCG2vLKsydYBnlOwzFiqjAg&oe=6AB51CCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AW9r_5RzY8Q7kNvwHmt6KW&_nc_oc=AdpwRNT6ubzWsf6Y5uq6R152LOpF8hJ7fdtsXE-Ar2fcSTagKKDOC_qRpKMkblZosps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMcaCaAWiMDtppJ7PdcZ9YclnobXO-Hd-aYUFcuNEH3g&oe=6AB525FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFanF2GTbywQ7kNvwEUsCyq&_nc_oc=Ado73oWDt9B4auTi1NyVac6IKwhtLZf-jj3kQVSJWYA1-TpxY5gKpCwf0ebM7bFgR6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwV-fO53ksD8E8IN5bF1xIjrdFb2eMDd-jqNMrMTw2GQ&oe=6AB54449"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HZbbYggB4UQ7kNvwGBhA2t&_nc_oc=Adpv4Efmi0871ab9rSQ0mw5VQxTrhSYo4Fd-4QcXEd7444IoJEgSNZjELp-gYRJ1HG
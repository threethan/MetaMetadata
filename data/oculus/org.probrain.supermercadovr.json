t-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTh6d86PvpWtg00aA0ge52eGbL_S-ODiwnVJFdOH98RA&oe=69C26BEC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEqef2hemywQ7kNvwHXIZFO&_nc_oc=AdoOHUvaNH_aQsveyJce98Kikv78W6IvYkvlDqXv3RUr-Jv6CQ2YvkeQgzC9BnAgW8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2Whk2ZahrcIbLSuE2iKsLJLTvhwMe4nn20di746EFnw&oe=69C285D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwB0j1-QbAgQ7kNvwFbwuOa&_nc_oc=AdrDbrkai5AnxJdVawTm9cE-WWv7Z7JUXU6WkixQnXpKa3HFYoLkNXIgLNEBq3Ynzjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzsy41TXXNWS-QgUxsfyeITGVyYI_zLkiwgZ5m3r90tig&oe=69C2867E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J16oNdFtztwQ7kNvwHAuh-T&_nc_oc=AdoSG8jMcosA9QPlWUo60xYYACIk1DoyZenOtKh3sI8Me2SdAsT7LffyVMfzQYCrAn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA-6Qb-rA_S1OxX37PmhiMqwm9akx_Hsb2nzIWDBb2Eg&oe=69C288CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHVXtFYnRc4Q7kNvwGDeV3d&_nc_oc=Adrse1dDO-XNyXfCgmKl3L5Edj73qfYpaE6bIY8pFCBa_B_m8skvaMBrfR_84_kzWlI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9gvNvgcQNXdU_3LllrO7gSsJStfm8WfSw_ltaHOSLhg&oe=69C291FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_9OjJ6cKBMQ7kNvwE1TR07&_nc_oc=AdozvBk-FmdsWXRR_6fwOG0S5jsZJJirhdA24pkWAbdYKUwTlXOTb16n49blKXBLHZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWqANHSHGX1ZN5rg1QQsYRhkUnVSYKDNMPnAqy_JYgAQ&oe=69C27809"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWjlcD2lQ0kQ7kNvwHsBVf8&_nc_oc=AdrG4ib4Jhe8ffuUpT-y-P6cXeeH3HkgDCeek66n5kXTJwBqIkw08e6GFMGaDGnUA9
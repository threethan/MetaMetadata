t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmUDf1p3OO7h40Q8KOqmKbcqWnocaGxlcfq8U_sxSqLQ&oe=6A4A6EAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPzRoTDQ5gQ7kNvwEoN0Av&_nc_oc=AdofouVRWNYL8nrXNTmEbWO-QOo7wdLQDzsCULqp0XhBAhANM6mJ13rqIi8GyF93Qoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ2bXbbrOv4NLV62hdCjaJui7Lh6_nR5TWhqMWLD5bQA&oe=6A4A5053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8WlKkQk5KsQ7kNvwHtrZzv&_nc_oc=AdprYZWJZ_0zmQ1CDurTl473lAGfffq1APan-B9c1NSjGHOh_w9lfUkfYhzgOyUwevI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB15pz4u5lEViHj-CsPo1vKToCJRQUpjarOv5uXJJ8POA&oe=6A4A50FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4YXjed1bB0Q7kNvwFGi3Cm&_nc_oc=AdoHlwhlzi-VW9TgM1DOcXBKBV4cmz9j1oxwCX0Wjjx3A-YXXkvQNAdsRMJ_45P-f1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKbnlfS-UMRkuc_gsolFJgbNab9o8VAISTTe0uc9G5BA&oe=6A4A534C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1jdQmKnt5wQ7kNvwELRHk8&_nc_oc=AdrCgG59rs1KIEAZO9uukHOZF00Q60SWsiJphVeXkYpfOQH2zoJ43d-0FGl6tc749ts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARoCCwHI18I-mfnL93K8-HsVLoLtidwe_GtqXWw6HdKg&oe=6A4A5C7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNYvzVkn0hYQ7kNvwEK6M9B&_nc_oc=AdogDeY9XGcVM4U_238BukLZDoZW5MD09oopne7PvGeW8CBbtHIOQ9rmoqQN7QExwQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8rH54dxjYBimcm121s4XIltrbr-rjrC8lJ8lm-N8I-Q&oe=6A4A7AC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-pCmYVNMcsQ7kNvwH7zhHS&_nc_oc=Adr2kxfxJbHJyh8Av1XMafH_IUd2pKrCmLkMiw6Rk24Y0VlO1pb4TznQ8wX37vnCTr
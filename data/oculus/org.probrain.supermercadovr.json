t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xkZYnDIElvtirY_3vi7eamCLwow-MWK50EPQblfZ0Jw&oe=6A43D72C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJxuRa8ra9QQ7kNvwEH8zN6&_nc_oc=AdoreDSCBSRrwtnUlQ-EKjDKhQRO2nHlNlyrQ7dP5p3cfHWEudCWU19v1QOr5OccmM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D-Dtb0tsdpKBwXteEr352pnm1bMxIwdD-xTLHSqzRBQ&oe=6A43B8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDfIvF7L670Q7kNvwHjvW2b&_nc_oc=AdoBxHcYHuM25LbJ7NOJQ-PIgPccUm0Vs0xo_sDVO6U-9veidUSP1EixjRe4n3K2x1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x3utB8vOY4_l8VhzsIxWI3E92adNgtYB_A0gs0nhR3Q&oe=6A43B97E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ErJkbYd814Q7kNvwF2F3sp&_nc_oc=AdrjUU5UIjuZny-OlAapiZ3AjSN30xMvNZyQgLk_XPFZFfha0XLRyzcO13SEZKBNIY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXGP-iUZcwxlbN1iNINqA2RcXyRNkc9OCSwaIgSOAVw&oe=6A43BBCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG7uskkohHYQ7kNvwGd_gXZ&_nc_oc=AdpD9OaM-J4ts3OHoOlCbH8hx0LSR57q0SeXPPYLkzhR7R0ybhFGF2WGV9wjOSxTmAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zMbtpzxCyeWVVCU0NjN4CpX05RL8kJDxFWfDEOQDGBg&oe=6A43C4FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzl-tGO9yz0Q7kNvwHbT4G4&_nc_oc=AdqJ2B6LIdbmLcFdHn-uio9bjiDTKt0Yjnf27MA1KQOF637KuRY8If2K_FSJgBsVWDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7FWudS82FmlE4H1qloIxGVQgEqn1iLLNWCYCsDnGMPQ&oe=6A43E349"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkoCdaudSnYQ7kNvwFToqal&_nc_oc=AdoWAA2JLnHUfGhKGQGhFmG_JQn6wN9sM1U_-q8Ad4gb8YdHeC6K_6d0TIkCUMWapW
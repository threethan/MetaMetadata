t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6668CDytLzDuOcvdJWrl8kZp3chRLweD5ZO5OIsDUIw&oe=6A5CE3AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmV-twGylfwQ7kNvwEWzvPy&_nc_oc=Adre1_y4j6sASCD1zWrskaunl3196ZblEGMEMOddYD3R6Zmyo8AAyAAjZjm4neQnMWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4dbNozl3Nu8I3qkHHUUh2uGCk1G70hOcUvZX6TXKa3Q&oe=6A5CC553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7K9qvjS7r0Q7kNvwFqx3fA&_nc_oc=Adob7LH76OS2WZpG-nizBkWTQeyEom0Ih58r6w713L1HBu6UoRPgJ6oiwbGMvL6Ks1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBci-AxtdH56NIgFOiCxB-aNfPs1II35tl0h9Yap110fg&oe=6A5CC5FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ffbho2HopgQ7kNvwHUorMi&_nc_oc=AdqkUDMk-1DnMqoHxsXf8dXgC9KJQ-yM49OTJqBnkJ95hMHxbehKO9QmGloIsZy8-sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnb-eF2Dtsvl0C-buXLT8dRTK9JjDlr21pkdTL8mHagw&oe=6A5CC84C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIS568OQmjgQ7kNvwFDTmKt&_nc_oc=AdpP9dFx7NxzpqXqAIP7qoFAy_BbFFItFrVW8VpYxc3nYBJgTlJy1Mg9sAlJiTcOdlo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmq51WejmQQl0P1ebgxCO8sPqN9ul3WkDMTgHUjYFQ6g&oe=6A5CD17D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBlz4TrswXgQ7kNvwHCvBA_&_nc_oc=AdpKWTub56cMuyfIr33CkSI0FfWtsYYsCEsy8Q91-IqKuOUtFvW_vzs4LAr2q_0q7M0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIgvMtwJD-OIcdKLAl4NFdiPEU1mDepCpOOnI7BF_PWw&oe=6A5CB789"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m4okIWJ4joQ7kNvwFQgcg4&_nc_oc=AdorqHIXjC41Ie-s-YOHDRW_Sp3rIYtZDABvrF6QeYiq9h-TGwXBpzzp_Dq1P_Weos
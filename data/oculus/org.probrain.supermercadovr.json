t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ95ozFQG5cNBDazxSAwH2ykrdI1xcOgp5ayWZih_rQA&oe=6A8C216C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K19s1eZS5UQ7kNvwG5iM1u&_nc_oc=Adoz03q8y1RG3iCakEYdMHYpVOmXpgaYYAn_yxRf8QGx4Q3-IKsSu3VOoxWATjA63Sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsN5h2DbKEH7Pc3FdLhr9KlCo8MY2EjKBLko0wrTGv6w&oe=6A8C3B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPxM1RfBwoIQ7kNvwHfW8ys&_nc_oc=Adruuj9QT6rZOV5rMyXmfY8utiCfqGd_HaRHYKmaX5sHvvp-SdKiIFgYbc1ITuxl3N0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3MRFz7P4Px-b_8DwYyo5rQgeB9nATdvX12t4ft3rxZQ&oe=6A8C3BFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea4y-yP2WE8Q7kNvwGjs5K1&_nc_oc=AdoX9na4bt3Ns6HDM3dVCtns2BkH0Qq-224ZnY6kGWWrvhxJlY-VY9-vq4M2L9FMxyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaBCwq-LOtJxQ7GRzeaq8Q5Zt0M3KSNI1qDt2BItorYA&oe=6A8C3E4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JHAVNM0SCMQ7kNvwGGmuUU&_nc_oc=AdonVj1IHARNz2wDopUJKhns1mVIL82ZRZ6HC77P9mQAlnKI08HPqG-kOw_ziFiLHTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpkfBAOknQI-0lctBDc4sB1nICmNi0b3aJonsFELB-DQ&oe=6A8C477D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRMWFNMmKT4Q7kNvwFCsboF&_nc_oc=AdpM9hPz0k2zsLR4MLp-yKU8YfEtn74EuEqXDyW1bdkL19Pd4zz8apVq2hfp7blkvNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-flKXr_zee1EQ0S1-HjGAGOAJv74GVO17zyj2j2A0sA&oe=6A8C2D89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iovr73gBDfMQ7kNvwFJLM4w&_nc_oc=AdrcGQABTAYkfNplG1yMYj8BsO6rvYzrK9z-_-mJ30M3ujrQuvfSYxzGggSHb6pyhz
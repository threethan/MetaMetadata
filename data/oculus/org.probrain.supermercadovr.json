t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9fyGt3znyVd98MP3GJduaGYm1M0TZ1g231l5nI1Vx-g&oe=6AA6B7AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLIZxtosuP4Q7kNvwGzsZyA&_nc_oc=AdoctKFc1twp2yHrIYjTCeIvlPw-XAUsGuVFKujH8k4wSsScCaV2gbO3RraZsH-xb2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjpqgx1j_OTE1Ia31_Qlc2V3r-A5gIw5VoQ1qvng1e_w&oe=6AA69953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3SuBxePFesQ7kNvwG6mMy2&_nc_oc=Adov8WuTvHLGpNysK2AMxrt3EvR3BTLHBB5KE3sz8nNAkw5tOMyOimSje9MBimyNmj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdUcTOmDGkudBgEhGH80k9nB8Q84HFiTW5F0-0xmuBiw&oe=6AA699FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQXvOZoR9qsQ7kNvwGARZbp&_nc_oc=AdqwKE8kLW2PEbmLl0HjyYLx85Of6byJxZNRF5o7MBOeL0aqNbg-IVCtEF8mMpfyByo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk3D63WV4-5O5X6jL4JPAuZDfttLollwgY67OUx0hPyA&oe=6AA69C4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcgbsUmGAUsQ7kNvwEggJ1X&_nc_oc=AdpPN1l5ceRre9XuWzf8hEH0T9rXFRJMUuZyrJSu-uBzRBBjyTLtUdwcApxyurM4wiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ7pv7ts_YbjsPBEDL_QzkL_ul2Z0kMGn1pUs9fbNboA&oe=6AA6A57D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN7kRIbipxEQ7kNvwHqJkNL&_nc_oc=AdrfQKEWjw37idnTJLTSiG5lMQrddTiEmCfnXMrfTAJWbLsViPHZ4o8wE2_-rYrkeoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlUriUkitk3eQydscAoblMz4ApWGSJ_uhEYwqAWJi5RQ&oe=6AA6C3C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3iJfy3n7IMQ7kNvwG7Fo2W&_nc_oc=AdpNRpOlZoF8FD9WmksN_plRJB_ELECMOyPXRTBvJ4hkB0D8jRDUvNqJXaiBv7KrdH
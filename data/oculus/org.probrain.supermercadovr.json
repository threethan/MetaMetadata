t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bwejlvfpK4UgmrYtpAVfYWIVdI8mq8oJWSo7Z2VtxKg&oe=6A34052C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmxB6R0IMbUQ7kNvwFps3Wl&_nc_oc=Adp-kb6suC0Lgl6EocpJu0PRAzMmeKTGBCTXNud1vV-4QzuNiL4uK3r2OL4C1NSjXqQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N9dTBfcv1EemL-01PrZpAcKV-3jJ7gKYKL4tDbNby1w&oe=6A341F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhttnIc3WyAQ7kNvwE-2dt0&_nc_oc=Adp_9Yum6NAwR8s5YXcijOFUGpupWHHymf5CvNCviUAjCx6cwxzvsOwRfVtyApjt2KU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WfejzsFWIvRKWtikVkpi5UfoZyYFcPb_Hxi-BxJpHwQ&oe=6A341FBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1m6pT0wkToQ7kNvwF_WHe0&_nc_oc=Adqo5XjIErkIZWBpLZP1rMqLt0LtVaOU_VEi-CW3XEoAhoy6slGRAGkihX1FfwqxUOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5p4bo7u9LBgSYsgpFucmD_v9NqXbp6GGSJ2VBX4NZ4A&oe=6A34220C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtjQGqus7YAQ7kNvwEKf7wp&_nc_oc=Ado1NjrlBUrEyb03YB5_Ocew35R0ZjYqGDL0yvTeIDfZUOMyeCuP8kJ-2EmGQVuuROk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6b_JWOostZm48suuNOJkko1FkPMPGhJyb-gOc7Ls10A&oe=6A33F2FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYrPYDSSYEQ7kNvwHBrrT0&_nc_oc=AdpfGj8psBmkGYAde4Sj5DWSmy3x9_Yf_RZyDECKogKnLQw11QNLQ1FV06DjKTmRZAA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qmAe9jGdrXqECLa-NdIFqV9ZYmqWlyzWwjQucUk0XNw&oe=6A341149"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNCyTlZlgkwQ7kNvwGkoS_L&_nc_oc=AdqAg6PBvpsPsXZhSEDMeKqX0693vD3fNqgajNG_RJlEGWBS9-KmJ_gZXVoMlLqrek
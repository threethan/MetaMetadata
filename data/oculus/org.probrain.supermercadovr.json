t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWIVvqEI1v6xEDSkqlJ2sVTWqH3E9D4Zh6eCVRjf01_w&oe=6A79E4AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTv_o4DeNXoQ7kNvwHULyLZ&_nc_oc=AdrN8dfmfTupx4u_CPSiCSRFPkz76tkvkuuOl29FoFozQIAZ2ZRKWe_Hs1o_UfqTn9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxmANtfNnVIX3CF5z79SqUkyj8-IeqLmwqazwoXox1sw&oe=6A79C653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhXKV2pK7fsQ7kNvwHxqz9P&_nc_oc=AdrZXXtopb-auX1ws60Ku3_Lh3XFmfrlFw1Td-2dAPpJPSV6qmF2wT4ffYtxlBEmk_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxAeiChE-BcbsV-wwYlmpw1etsJBHPoXOIMTRYZfQiOA&oe=6A79C6FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKNt-rQ-KUUQ7kNvwER4T0V&_nc_oc=Adpf4Nu4Fh_5HJB6ybR6keId2zrenbZaXnHOL8nWALAtiRv_hjRkDOY1MW7bBNAXbLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUP5m8YrUhwoz2GgVlHkIHP3LDJ1o67LKw4TUqr1Vnag&oe=6A79C94C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9JllO-RRzcQ7kNvwGlKRbg&_nc_oc=AdpYmF6_0iXvbQbO8SqKJshkKutGAss7VliM45gvepIxo-RrJgaVxDaIZ-l_U2gYHXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHii5dGXajdxLG68uBf_88fKXwC9MtPWj1JbQo8WxUf8A&oe=6A79D27D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MXzPNfVmgQ7kNvwE8E000&_nc_oc=AdrMmOfcK1qKyLgMnc4dST_1_AvzEIKHSg04px57n9aX0vX14mrMkPvLijvxiqDZdpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9xxw6OIRT_rRBztiw_dFoZ3LE59yQLRTF8wOPGYoGdQ&oe=6A79B889"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUh6L32beVEQ7kNvwFSop0s&_nc_oc=Ado2NsHTfSxFDh3wTayQPC4U5u0Y9yl3MzH5eeRpfO-7qVK6BOGXVHeZOzaSMsl6Tf
t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiDRVv3yFbdh3SqHetOSPjKaDkIylBP19KOUAMX81RYw&oe=6A9C2BAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWd31veg8XkQ7kNvwGBsTGZ&_nc_oc=Adr5H5ZxgvldEVCnDUQoHCL7agtun9RQX3XUUzI3hI1XDL4ZadTd5U9g0IEQvPL7ksM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWnCfwgFeJBGpTp8fjFAVQnp_fx5n00ngVHrHwGSCiTA&oe=6A9C0D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl7eqhVqSkkQ7kNvwHgqDp6&_nc_oc=AdoxaOecIHrLCcLq1V7PJKh1h_iOGNg0nQ7m1vI9MZQv2hVKgxS8hgMnu7LMeWIZTBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqA7vnbuyCwtwO9ih9g0jj_jrGXhZceNPqJKNnfVRXnQ&oe=6A9C0DFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08uQgPKk4lEQ7kNvwFqs7bY&_nc_oc=AdoNnnu9DC_yXsXty9zYzutxWYXHhtk6EuOPS5xeP79Dz9tiMpI2PXlgh6VHihuZNqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbkqHaXxhy39EL5AXtweWOn7xzGxiUfc7WeCjSITqsrw&oe=6A9C104C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtYVivOzvfcQ7kNvwG0VcOY&_nc_oc=AdpKrQ77g4uTrEFaYFZ8ieaEkkQ8iM95YLwsRqWb270r_IwwY9eptoFiP58zKv8ACXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzis1iOKuOlVfdVLCktWP1ci8KaSSwxLBj2MRwhzg3tA&oe=6A9C197D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPjYJacK11IQ7kNvwGvV3kW&_nc_oc=AdoKXieLeAHCeCVoyaXP6EWGEebRUCcekRnLS-XtZ0X2pwuOXRWbjaxrUujeaSh50-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBOD8Ne0HqiZtbqnlZ4uIgyYsg3UAK4MfEMBQ6puZsHA&oe=6A9C37C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj1uJeOQySQQ7kNvwGZvGsD&_nc_oc=AdqA192SaBqLalUWXj-yLT6j5b2chTXgVu5EmILwlngA2qM5jDyyZu6QeOzCdvMwk8
t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XWKn-7xjxao0cwtslmvr_ZR0xbALO-93G-7z06d0HaQ&oe=69D5192C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2d2l0oGevAQ7kNvwH5m5XF&_nc_oc=Adp2YIEGgPYcKOYybMIu1xuxtQxA5lDb3B65G6gzyCiy-E8qEld-KomwQmrT3T2CQEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sDY8zhp2QsEVVuKUGbRn8JS1dqqrCBh90Fc4qbld3hA&oe=69D4FAD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCCGz2jha8gQ7kNvwHtwlx2&_nc_oc=AdoNYEl_PnoJzz9G4Oc2Kj5zsyKP4u5inBAXMOSi0jkTKV8f-k77QHjQW-kdao5L9hY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ui1VJlv_AgGB7nLDMRE8JoJvXmJ2FB3GiahzPRfY5tA&oe=69D4FB7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC1Nju1EitgQ7kNvwEOHERy&_nc_oc=AdqGrXtOF_j6E7HhqYok9iRNEol74VJbWhm4-9oiFiJ_30HqwxD6hBrXgM0KKA-kNJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30vAIuycyjTvy771eqtM2ks1KnNQ74jbHgLtGNSxmitA&oe=69D4FDCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF8QYmPWm90Q7kNvwGQoMHC&_nc_oc=AdoBh4Xp2TObRr7BIfmg9lD5gVD_kFkUcrSaG4WliZmIg0uYnYACSvA1HN9xXnam_2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l80D70n26BrqVtMw0fsXpWGC1qhREEvyQQP8D3vcf7w&oe=69D506FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmBwO_eC1LEQ7kNvwHtMx2j&_nc_oc=Adqhdlms5NBkOP93xDJFSpzn2FAK_3NXBiT9Juz7gxihFgeHC7UqR_G0l3EpFeqyCvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35R9nhCG5YT8XqjKfdC8sRwgvWZEUYMHQJiFpSprXFIA&oe=69D4ED09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7whUITb31uMQ7kNvwHgJeSu&_nc_oc=AdpvNxkMXCPeIujfcKQ1Kg8niPGuBGA2UspzlMx9gYGeDmD6upHFrlDb9z-eP4J7qm
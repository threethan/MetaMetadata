t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPFvIAu13Z7dx_alvWxcKc3bwSqDrJTLkcbo0tBnN7DA&oe=6AB7DB2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmYOU4hua_UQ7kNvwFI4lnl&_nc_oc=AdpamYLpJmBRZ-wftpcfpow0DZGMUu5K6DdO1K0iaYxsGrkOrTUk4FjR8nRjvDyKN7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8B8mqF7hfV6RmEvx5EWntnkgmVIMX_grUFu_cEjt7PA&oe=6AB7BCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNeQOjEtO3wQ7kNvwHWTtJO&_nc_oc=Adrdo_xN70zb0eYcBqXJMdY58dQxo19iEAGWLSFAbBbuH-uoBKpHscNW1HMwefw1-cA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2AH4rkgZQwD2xUoq4dPhghNxIU6AZg7g7UbzypGOWrA&oe=6AB7BD7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOR0FGNBMIUQ7kNvwGWEsVM&_nc_oc=AdqDv7whXYKSF7oKQ9L4U_WKXBDDB0y2ncdJTKX_yb91jiZqh7TNR9kQ87Gy12v-wZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLG_McVWA_gPNjTJS35Yemfw30UBWM44pHJzmzbVpGFg&oe=6AB7BFCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6KUdXFOaS0Q7kNvwGpoa8T&_nc_oc=AdoOVRkxJCs5dp6Qirr9NrsmlWDNzjMGyFBGFN-CmGlF8YFLjaGG_rV7yvFl2hPIeD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIei4r1tyzxAr3615AVA9dkRUhF6xSc_4oIUmqQE__0Kg&oe=6AB7C8FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxkM_uc4c9AQ7kNvwG22kVH&_nc_oc=AdodI-ted1x2wNmDNrZ8Ub2xuG4iUQRa2YNzyNfPj2B3HmrRwQRcVQrA3jLqCLsEz-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1jhXMtINckrrzg6pyOqmq34aoKG9UaCM07a-hN6YNNw&oe=6AB7E749"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as54nrgFLkEQ7kNvwHApGJJ&_nc_oc=AdrQotYt4CFUUgn3CvMULSdakfC-g4w7ov1rZuH02k9vt2-C9xPuKTx2xwkWODoR_q
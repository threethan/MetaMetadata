893955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQyhNVKOVagQ7kNvwEC8LiV&_nc_oc=AdmEaE1L1noN2Ncs9uiVm88vmUZs_QnR-fk0K3JXY_6mEX3PHC91RduFI5fw7nzx6tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWvhUyWZ0Fr6iom4smOXHhAyv3eHci9v8L97AU2VWaGg&oe=69A2D888"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnIsTsV98H8Q7kNvwHALLfw&_nc_oc=Adl3aEn6engUfdRgB4FH2dM1R1EczgWZv0h-zJL9boHMI62cYA-sMlaZ02Rg2YQ5Uzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLa-3lo16iSfH7PjfzElUOYqUQMsooIlMaphLoa4PARA&oe=69A2C989"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IQ-HKHfBgQ7kNvwF8WXfF&_nc_oc=AdllYRB4DcH8EXgX8f2hVPDA009cSzf-aDpY2nH3-9s13wDfoZMVi-WsQa2kA-ofUag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCPqbUZdbUjFtxe8QPYhGuXGlD49_ZmGHUi80BRGt4hg&oe=69A2C7EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1mlEFZTsDUQ7kNvwFmuQFP&_nc_oc=AdlZKY47_zZ-uwIvzivGtAMs9_HzMVbu2q-mPQ3-W4bJEkHpmpVfxDqZC0kGnVDig04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhwDsMeVTl7QlrXCifzMc1pYxGjio4u47g_yRrBw5hWw&oe=69A2E1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU_yaGB6bX0Q7kNvwEMORk0&_nc_oc=AdmWKoYkiNbZ3gW-WrzCiK5vwPJxPBpUpKYRzll_Cuk2ciZRjGWUSwMr5UbsdsmhTnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBwiaZdYghREZPveGxURdVY484AfNXHkBLdepuCYY6yQ&oe=69A2E27E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vD58IWh1KgQ7kNvwHV_6OB&_nc_oc=AdnBxzm6gxpcGp7cr2TXkTBIpvfkBBsZMnd2dnQYGbspPcuTQM9BvOphFIXWegNwFrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubAkmmkrMDjxbnvK7Fb5IkH8sWpdh0689-2eVnGhB0Jg&oe=69A2E4CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
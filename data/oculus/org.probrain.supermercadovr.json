t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfLGffuYd-sSQsXW8N_scuSx7ulMTO2A9wYBS5ekJ8gw&oe=6ABE72AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo8efevYYKEQ7kNvwFKA7ua&_nc_oc=AdrKGhaZdEYT5_2LraI5rVDtZb_1BxiCloiNhEOTxWNrxef8PsBL48w6v3CE1VkW7IQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXEuoAqcziQXRpy91oitHECjaaaxdZysbj-i8tI4tROQ&oe=6ABE8C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWFxhlFdG8Q7kNvwETVBb1&_nc_oc=Ado4st2zX_Ixf51qvnPgtVbmVKe1TiTmIymrO2NwwSmfROlc3R9xorQQfhrDwdIbTzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ099d5NQRAcKFw-jBawqa8Lz2qj2cqSQ4IGuns8lvPSw&oe=6ABE54FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUfxEMXbjmMQ7kNvwHY1OM-&_nc_oc=AdovPtdXE9RVjNtn9-jmNBVesYY5937s0aPBeIl8iY06H_514ndcaQkKWkB7xRmnTHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2xW7zmjBgoTBMqgJaZZrDy5YfeLzgn-iZisj2EyU5Sg&oe=6ABE574C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee9Fq73jBsoQ7kNvwHfIQ6Y&_nc_oc=Adqh0Th-tVO8asjBONI8xQP_Mmd2wJIPyOjxyxO9LmyXaAXrqhwZyY39C0Jj5m3H2CQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILTYyzZUtAQSrdq7c8YsngGeIqNk38hSGPGXF5PQxsxA&oe=6ABE607D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4skkClbHAEQ7kNvwENp0Nf&_nc_oc=Adp6WS5RYKqEP6a8gh_6QolkhO-L5hLwLCNKU9wBiazcZyuPNSU0psrlTTZMz7e5T00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS97Vqr6zb4vSfmo5Lba6_YcnMkEIdQlE6-2H3AQU2EA&oe=6ABE7EC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMoee-caniEQ7kNvwEuqE7L&_nc_oc=AdpLbnjtBflY0F064Qp-UEc30MfPXdjUb88XHWOQ1hVd6oFxRrC3qU4BemMSSF1FzN
kNvwFebVDx&_nc_oc=Adrgn19ZJsHO6qGQJdChKUHr__n4cn1-zflpJ0M5VZgkI3LMQwDwwqvH2deSsa5HVn8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHusbOLFQqy3RHzeLA3JgpF5HpXOP-mO7O0b5yFV5tFg&oe=6AE0A1A0"}, {"file_name": "screenshot_4.png", "id": "332652799210032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_332652802543365_2480158436641273391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txtcXcVBOlkQ7kNvwFk9a56&_nc_oc=AdqlKPjcrqyn9Ww5RmgWM7wv7716jTNFGr8_uZQCt3OQ1jwox_aQ-IIKbJe018eUyaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPb3dMD6EDn4wRCZWEn8ZvLWR5Ctylt4JW9Tg4ErvSnA&oe=6AE0A695"}, {"file_name": "screenshot_5.png", "id": "699474982224730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982595_699474985558063_3453974348672181496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmNKDsmZ0kQQ7kNvwGNZsf-&_nc_oc=AdqNDHNzkR0UV6FwgOYvY-Hg-zsMTB9ayIT1b9hV5tFt8S_3xCBNdi0CTD_p6Sn0-YI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYmk5NM-LY91k2k0D7X_0qBu-qGJIeSIOBUJl-BeVK6Q&oe=6AE0B7F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "3483732985208245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974786_3483732988541578_4502993567047372991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh93ZQV-IksQ7kNvwFtHFXu&_nc_oc=AdqckWB7Y2DElMt7rCGBAJ7YxlqbuhU-UcN9qXcDAG9IVgS1fLGtPu8bfG2baFMv2js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO5YuxNc9thX7Z4DrthfV18xfYppXVYn1jdWWZ59jPdw&oe=6AE0AC6A"}, "display_name": "Supermarket VR", "keywords": [], "long_description": "Welcome to Supermarket VR, the supermarket of the future! In this immersive VR experience, you'll travel to a space station where you can shop for groceries.\n\nSupermarket VR is a fun and challenging way to train your cognitive skills in a virtual reality environment. It's perfect for those who want to improve their auditory memory, auditory-visual association and listening in challenging situations, such as understanding speech with distorted sounds or with competitive noises in the environment (auditory closure and auditory figure-ground discrimination).\n\nThis game is designed to be challenging but fun, and it's perfect for players of all ages.", "short_description": "Supermarket VR is a game that transports you to a supermarket on a space station. Train your cognitive skills by memorizing the names of the products on the list, and identifying sounds in a noisy environment. Fun and challenging for players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/policies_eng.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564857710296707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-eoMoZ2-nUQ7kNvwEAPWef&_nc_oc=AdpcaJcQVHl7h3biTLJbcNaP_Mx2RtTtkAbC6c4J1Y78u4wyA0tn5kmuh_W9igCVgTQ&_nc_zt=3&_nc_ht=
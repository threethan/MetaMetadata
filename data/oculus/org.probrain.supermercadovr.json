t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI_oEdoQM7N6jSoS0Zj-1AY158X0TMnjfJnqz4Sb3-4w&oe=6ACE44AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE_BVyzipDEQ7kNvwGKP4xr&_nc_oc=Ado7bXlaTsrmrPyzM5CDmylRRokg8s4GfLHPgzGMeRz8_P6vY0BTVpRPyrery3i7NOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWVRnUrgs8fsRI4CKXsKJdLDrysONx4W5Q1KYgNvxClA&oe=6ACE5E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rL2Tq8OAJ8Q7kNvwFo11CH&_nc_oc=AdqzxSan1gzbjVWaAsQzOMyAXel2A-LES-Ib5qVkfRwldz6ipirpDinlDB6mBpSM2Z8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx8wtQCe9I___TBS38V3UC7tItIGYFoP7Wgxp-bz8Azg&oe=6ACE5F3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_KwBkY78WAQ7kNvwFkIBPu&_nc_oc=AdrjzFZHRc0KcQKYJ10uYqlUijr44HLhIKOH4kH6o0gtfTanFPfe8LHil_HB6-PVfNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQwYmczAdENUX8qh_DZQ5rdxFxazJ5apOQt-tvmxH0aQ&oe=6ACE618C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNg0tx3MivsQ7kNvwF1HSE2&_nc_oc=AdrkCZsRJxdik_oVBihWGYDrdmHq2nQdGBVbYPOKjOv_A3Aj4rGd4dDej4CAqWyoeLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdMETI5hTh3RXZCFWHmGgZahAr_OQUKUqlU16NK4R2CA&oe=6ACE6ABD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWG_NYGGfM8Q7kNvwGvEM3B&_nc_oc=AdpxNu71ondoOfZH8emwt8gUIUN72pkB5zoKZBIVMl2IdXDRAWzILbus2rZSi3SG_zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7iBt7iwdr8AglMjhYaghl1DgFVdR0D4Eb3cJ7bC_Rkw&oe=6ACE50C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiaAfvTxprMQ7kNvwE9ZZuh&_nc_oc=Adr2Fc5MEOgxBx0ylNM42iHMf5ZaF5slaA2xW-bUjAOc1wdfSjTeoh8hcO2uypkmvg
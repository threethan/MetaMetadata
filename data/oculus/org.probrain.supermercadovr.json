t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y7i15-J4hhl6ce8l6ID5oo8aZAtA8Bao8cOQyB5CjGA&oe=69F7602C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rm9_UyKttcQ7kNvwG2odIi&_nc_oc=AdptgOyvizJh4CpjYA7uXoX59ydQdX9NCWHPz7y2aVoWt_lNgFRMPi5ECl0xkLW1JAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gk4158JP1Rg71HkUu7Hp9Gzi7MpNyAVEtK7Ld7CxVtw&oe=69F741D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF5Wf2OZDUgQ7kNvwF1V5Ej&_nc_oc=AdrBoy9qWG5I36-FIzbq4IsGqHrNluuYtp8ftWd7-0mqtTJ7wWRMTmH85A0iMu-Qa38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Otfpxy8UK7w5MDWJ-tmSWopLBeXrqzZCUNFoGBrd8ew&oe=69F7427E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rr7sTGamJQQ7kNvwF1Rda7&_nc_oc=AdqNOVlsYFHvvr2lJ0tPhKl1UYhbTRyHPap29WDZBpQKrr3keVnopnRhIR7xmz-m-X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hTB7DWmdrJ8THnDd2iX013EhZPhKb10aYmY9Yb_hKWw&oe=69F744CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK8gbdotW0gQ7kNvwHwtA5P&_nc_oc=Adpw93Lu7dxKRiDoom5VmxN3o6OMh0mZQrPCuv-MAfMcFjyaDd50TD3CR9LUUFjWvPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2prXa0on27GBh8G7OY8ZtY5osQBZY0I-2MSNd4yvBeRw&oe=69F74DFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehgcVLL3kKEQ7kNvwH7yqR8&_nc_oc=AdoNAYBr-INBG66lbx29eFp16EPSfh2uBQevjWpG2YoMNY7HkCXeTyqGjYJiCptwW-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LT0vgquyomEO1kbN64x7L_ZEDSm2XagP4qCtzcgboNg&oe=69F73409"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYo-XxvonqwQ7kNvwFlh_lr&_nc_oc=Adp_ZftdHQe26sF7zOd_kQ1iM1PbKlWctGIcKUy2LcwIdR0cl3xRuliJeMhfCVtZ68
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEktvgCg8FwUI6piA3Ve07vyPAJnwhcF67BPAyPU6QRQ&oe=6AA171AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3L-dkC2uxMQ7kNvwE0TQid&_nc_oc=AdpKZWMCfK3ktVQvM3gNRHotB3ZDC2KlLHiVgcWsZGVxKoY1DBaRPwyze19lKEqrIDc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG8BS9hwrlBcSd_0AUEzfl7KDJOnK9DgzZcg0CAnQbBg&oe=6AA15353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW_R8k8Jve8Q7kNvwErtVnw&_nc_oc=AdqilvHktHWygXt1gqhzQUqL0Q0fYP-oLmZT31iBro4fuYDFFbUnNavEjqDEbcEvuBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSOvE8EFAM1s-OrzRKBgXE2Xb7wyfV4BwdEAy9SVyK8g&oe=6AA153FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBl3re1YaicQ7kNvwGAv5Cb&_nc_oc=AdqydbJjFbCzQlKy2rf_oatqKv6X1YPyseB9mZyygNL80uVQYT_aaSOlm2rd_WkqhZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpg-JspLKIOwLSppAaQugADmRJ-NO5ZOiRVwHHsdMNsg&oe=6AA1564C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woz977J-TYkQ7kNvwFnozjq&_nc_oc=Ado3a0G4zMw1o07jlhKyBPatJr1FPF23jgnPfczcRVp2v6nifR7fjiEp0yZYEiO9Mxo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIINrT-52XUWW66eo-Ml7IzmSJOzPnn5YTIebg3wSZPGg&oe=6AA15F7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bdp4geZFar8Q7kNvwH6pwhj&_nc_oc=AdpZrLmA06BkycEfDJgyYbU3T3-15WdrX52S7yEk0fgPiePQqgbDVzJgA22gzMZF_54&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpoVYozcOaeVnJB6ikWVhZanyOJ5Ma8niMsFZ7JiZi0w&oe=6AA17DC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PbZTp8pFNwQ7kNvwFP43cB&_nc_oc=Adq-jPV3_PborFER2qDT-uMXqh8zkI08PF0Eduu8e-rWAVCMLDPU-fi4XzahBQ8KJZ
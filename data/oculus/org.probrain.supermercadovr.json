t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuC3kekWU2_suNNwkyeEPeoOP2wqwJzBz-p3WDygmVkw&oe=6AF5D1AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDScwktkWkkQ7kNvwG8wKfY&_nc_oc=Adomlsjg4IopR6iiYJNQQaRrCNtooQRMjq8eSrDUvyBU2DhpY6PdMOc9xguxCHwQHv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7iIniYLx7nw8ObfNlV10URv-wRf-xcKEXIuBOMUFuTw&oe=6AF5EB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYpR7_Qb3FoQ7kNvwEnOAzN&_nc_oc=AdptRkCUuDUi39ylcLYsYuY6M6aPKLviImH5FFo5GotLZFBBW6HXv5isXeL-UJpiJh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzJ5U1ip2mGFK6Nkj1IOIgHB54mADBa-EEyLQcdOExgA&oe=6AF5EC3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JEtaqwJnmgQ7kNvwHqXvih&_nc_oc=Adrr9i6MJCd-mCcmb6cCZrTUcOojKmCsUuWIRkf48IR0Eahuflxq7XLQAbswzI9IE5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSrL19jkpoq0fITvPKjLkfv5-fAdVNcFRi8wlKKDv29A&oe=6AF5EE8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdZddFKpoTYQ7kNvwE6y_DH&_nc_oc=AdqLhIdhqE1McNFqXzZTayml1C18kopBgUpSXw_TWg4QE2ny-7X6E4WllZZvfXfHR5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdxyI--cViYZTDC4IT9p400yEj2V2d0BsrD_uC1PN-mg&oe=6AF5BF7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umToO2hPhhgQ7kNvwGEDAus&_nc_oc=AdrffP71u7GC8oq6ZqENHzO8gfUIJYmg6ZX17q1w1ti7Wc3eRIQZBEpGayAuuiRIuHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuXIqAUxz7X0tZMOn7R9I-gQb4-UxTw3fFGmkS4rRqtA&oe=6AF5DDC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i27C5ZjIGsEQ7kNvwGLkMVH&_nc_oc=Adp5-3F8yoL90bMJCaW3xmZoUArBd502WWqXZ22IQHxGY3c6U_4cEd5vkNQ-NgrEDR
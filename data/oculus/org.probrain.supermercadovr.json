t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi0CgR64J9AahJe0OREze-P_HPX1Ol1XhDWefYGBKZDA&oe=69CD302C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=marTDbvRvIwQ7kNvwHbdDrE&_nc_oc=Adp_XgASQiqcv8_KQ2Hsdz_4jvqKOIaB7aD1N-9D5Ltk5sjpw8qhdB-ixZGoeog5Beo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxMzw6CHybeKEcYiJTixSnQJnqF0zE35PHevs__rKHog&oe=69CD11D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2WvBIjamGIQ7kNvwFPabqX&_nc_oc=AdoxvbR_naRdQRUQ5XYhXrCdrnXEnOTg4LwG9z-Qvgx5rS7u8jaU7nmaOUgYd_o2RJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC7muGAvmAh6OfVbbuEc2UpHlumS9slPxnoB1NMGqJng&oe=69CD127E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9Aovs9oiOkQ7kNvwGWtvUc&_nc_oc=Adr6w7Hp7z0EEe5lLLFqXJFxOvrCRUfYVX8BkHm9kx487gENFQqfWik79SU6z5kYutE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLWjw3fg26gL8TsRkThnwYXwj60B-C_sRnEh6JY4Ilsw&oe=69CD14CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGblK7dZtxIQ7kNvwFnCl3R&_nc_oc=AdrLIM5QucGwz679_YDazro-3X1hiw3zzvly7ah1JS22CHPYzaaOBpiaqQhQj1OS7jE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkaua1FOo_9pex3c_v_mVI5b0Qzctlmlgouu1mpXXAYw&oe=69CD1DFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqPR1uwVfU0Q7kNvwGO_53v&_nc_oc=Adoq-dYH8cNvpHePoa-egWdsxR4I8eCzc53kahT56oYpdbixm5HeYXJCWvdCPfoh1mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ7hxhT2AR13FEH74cBe7YSCpJdyR759dO7qdgHFZfzQ&oe=69CD0409"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF9RG4ZSF6wQ7kNvwGhn3pY&_nc_oc=Ado8gnuyDIGP2j2AlUUHMKz1e9cA-1LZanYFWur3bDHt78AnXA2bfXceKIOdh9Dtey
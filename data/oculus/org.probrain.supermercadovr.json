t-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75JC5BAx2_cqBa2D3mQkS0hj_FQRp0Bnj5y2KV0RCPfA&oe=6A1AF8AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTNF7t68z2sQ7kNvwGTK8Ar&_nc_oc=Adp6ovrfKYFb8yT-faD_nfcBIRsEyqMpjjSWE99zJgYYwr0_6ux3TolZWJHyPreB_lQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63TMP3DDXxwEiHWaYxRpIv74wmbb79HT-5XJBrtBRcBA&oe=6A1ADA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vetYk-O0q4cQ7kNvwFQpr55&_nc_oc=AdoiRnvao8HUBb0398J3fiOfitKqbEcBWPkrSJOwookYUHvz1Tp8HK9VNYUowkG4a-k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w-zi_KwJWeIrxVW1rhKvLiYddI9nAesxtl3HaSDb2_w&oe=6A1ADAFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZUjxrsYdvsQ7kNvwE8U6J5&_nc_oc=Adoouh-99v6hIApncvligw1ZbXUegUrI8GHcMOrw0gwfRYZC88r30bETUwajwmOG7ac&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af487-xdPkG_3gj9KfDjIW-dtUG4EnuqXULN0QucIKmQlQ&oe=6A1ADD4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8sRlqBtN4wQ7kNvwGrunnD&_nc_oc=AdqbHAXd8HEQo_hbwnyAbzwUjBatW5DZ7sS3Loueq2dJCvdWTkpEvBzuahHWBcpC_tw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ua9qt0MBe-zesFkHfeGrYNsT61uK5tb9wo0SnAzv7YA&oe=6A1AE67D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMQiIrmzIVcQ7kNvwGSAdTI&_nc_oc=AdrQZmK_6VO2iXImolZPGb06MKU8HOMcRQYnoVStANMLY8HWQ7yerGtneHyPZEZoJ6o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kafTL__x9PwuGZmaT5miCOjyooBxKv8bcuH57IMPYiA&oe=6A1B04C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRLZkSMbUbEQ7kNvwF70aV9&_nc_oc=Adox9-CK8fK6ll3CyxYszd35TJ9uD1RvbQjLt-oMdKsWQiQGhKh4c-_JdprSlLiChx
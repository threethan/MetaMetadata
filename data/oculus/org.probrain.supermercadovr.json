t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVxzl9gk4RLyo2BioSpIyAEltFHknRzhcUHanTJbDb0w&oe=6A6229AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUCKKewI_ccQ7kNvwEsFoJF&_nc_oc=AdoxiydhxDAQavgfazLSSuv8buZdw_RiuX8SNI2oJJyVfOUIQMxhjhrDTBNBQAMIgwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApUmPjBjjgDMOlRhySe4saEJ518gMlfZfvsv7D1hpkLA&oe=6A620B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgiG_kD31lcQ7kNvwG8EL8J&_nc_oc=Adqjoa-B2mw6pLxlc5_z3vqzXRRi-GslklF8nt4d8lddOL5cczttvhgOKJeaEjdb9ts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4WXxtUyv52eOcK0LpFJ-AvAAtQYawYQgKk_U04yAeng&oe=6A620BFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkvOzRjTAhMQ7kNvwGkyT2N&_nc_oc=AdqTFkSjjB_3ZY7DlAlRrKBNDsrImUxo6FPO-dy7AJGp8D2utPsbOmnaoxrrdzNVNyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzTKdlhUAcQuf75aDyh6AmDE_yboo4NO0apgUcxHsFyQ&oe=6A620E4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CLx4nVUdQ4Q7kNvwGVGAAv&_nc_oc=AdpGYKBTUn6OJ2TOFqFRkmGrexoYrlrFyYk9SF2ApU_mK4Bv8E4B2JMM8rdpdIEQj9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG9QHV-WEf8MID87ZpcTFTWuueErOkVQTGPzPojncICg&oe=6A62177D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGQQwGrBJ-EQ7kNvwHpJUrR&_nc_oc=Adqido9VqNZLhKTdNMUJVtl8T7SkuQpSG_wdvZIeJbNDoSg58yNg3vv6GyoVPVM4nD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkmt2aZfEhxH8jXysgnq2Lol1eDZaw25keE0H8rwm1UQ&oe=6A61FD89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBVDWZBpMcIQ7kNvwFLK_r3&_nc_oc=AdrA769ClXdUuxKJiiWEjgf9tU1AZNmwXHtxYNqGkWv1WoMRjeGrBoSYRi3dj7OCje
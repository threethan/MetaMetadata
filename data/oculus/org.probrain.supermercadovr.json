893955", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQyhNVKOVagQ7kNvwE4InAx&_nc_oc=AdkH1ZSKMLQcrd21V0KZUzytdyHFXqZq5vaO4_cCs7dD_vv0bY3lkfL85aFe2c54c_k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftIkJEc5PXdQfY9zqfgszFac37StMkSWKJFqSf2OfnC3w&oe=69A18708"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnIsTsV98H8Q7kNvwF21mqu&_nc_oc=Adk7rp6EttTl0oEvMT_szO5cW9vDlEUzdmB_SY6BWPtnCkRccUkE-AQu32A3Tf1jsFs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvnBnVMCeWemZ9zAn_dc0C0orfDCXAzJN5Axu35VI-dCQ&oe=69A17809"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IQ-HKHfBgQ7kNvwGYGhdN&_nc_oc=Adn_GkHSGiXbHMVfiFUiFWAs2drWdZIAi9nOLJpOmOJll_NhqFywHYOIdqIMdjk6KHg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftPhSESRw3WzqxeN67pzoLDmJ5yvPL5X77QviOmhdYPug&oe=69A1766C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1mlEFZTsDUQ7kNvwGMceyq&_nc_oc=Admy4cVgK6rYrj_mHu3yEB-xLp3BKN5X1h6kFKuVz8l2Mb-fl7cm9HdFt0D0RDsJ_CI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvJBIyPJrN5pX-nq3_lsZKXrSDum6o9V32Ed6zA4Z3o4Q&oe=69A19053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU_yaGB6bX0Q7kNvwFeDDEF&_nc_oc=Adl_roqVP-BUV9kO--CY80-wVYMlnDW6fRN2LEM9Xa0-AKFaLCTI-LSgpOCFGoHzXWE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvnBCgoDETvyG-cEmOIoWOq2Qjcf3hlEYqMfZ6Xo1BH1g&oe=69A190FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vD58IWh1KgQ7kNvwG2e14P&_nc_oc=AdlkNqavUG3WtFFZSRY7RWtC1ylkNQigFvwQtiIeoX7vEwBCVLz9LI0htYPDoXPfeg4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvRPo9XesTit4OP_BoRkXT-usZhFlTgKioB82dMVZPyOQ&oe=69A1934C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
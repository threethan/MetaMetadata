t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZnECCdX0ksy6f2gU5fNVLY4-0uzR6ryIpNTu4R26iqQ&oe=69EE25AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naUsFAx1H1EQ7kNvwHg3Wzj&_nc_oc=Adrr9aIrzJAzDP1vvJdpkY92jWr3Ltxaosk7zFtCXm0mAcb2D6u8VQdL3JNeaxHNFdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YepkkyrqU_U0ZoDrovNkGzim-Norz3j82jlTI0gOY9A&oe=69EE0753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6ZH7DKHjrUQ7kNvwFkffK2&_nc_oc=AdovWz3Z9bdAVTSgv8oNsmEizahTE7E1Qsw5ctVc5nBFgLm-H2F3bLUQJXdeoKPmKY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kfVrqmX2y7TnEo40mzWgYbumBxukvorSE7QtQqgnF2A&oe=69EE07FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNEmXLiJU4YQ7kNvwF20yOr&_nc_oc=AdrSIV7SQIvbO_zMjmynrTvGMRgZM1foyNKwTf35UXsW_YaLn5-NZ63lNk7PzISxsGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qJo652BqdKYCRYE2vIUSddu62mX_cOxU0v2As6BQyww&oe=69EE0A4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNHOpSr_4ugQ7kNvwGK1AKn&_nc_oc=AdoGxFa3Y9mCGh3OOBQnzSWgYKFgyq6edbfmulw6E16u1tiABp5--YLlQ8FLTH3mABY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FYluYLKkNP1oaC6iJ6PPc4hE25w5zfjCILCmwAecPMQ&oe=69EE137D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qMNLEJ-AhoQ7kNvwEO74NA&_nc_oc=Adom7nea5w-8HOPwOHaMfJLWnhpuSFOnmgHRKKnPLK6Abyy9hMptk14_LCHNe6Sz_1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k50ZDTW081jIsXRwY8NLzSEFQ8PaoDHQ670CIYrRO6w&oe=69EDF989"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8apC5CW91dcQ7kNvwEaY7O3&_nc_oc=AdqurA62KXgvX9bkpLEUQJv0dpk8yItcM1n8-tz_L3KoY2lOad_rgQuMoe7y0Z5Ibn
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51XevOS82AapBdcI87qMvsm0H_pt4OXDUsUBgMiA_4zA&oe=6A0883AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPiYslikxvMQ7kNvwGxA_Nw&_nc_oc=AdpPwYr1dPQdYkeJNr_qRh3IapkTEWhuLNB7KIufFt534HYhQMq0gv1fgCymrQdjd9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rvuHwPY2s1VpLFZe2ZfpG8nMs94W6mxdCL-k8Kl7yOQ&oe=6A086553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBO1UZV-QoQ7kNvwFWnyhX&_nc_oc=Adr91AOItGLFcpPI1rFN_09VjJluOB-xdYRTU-TVj22WfZQAIPUtAubIY4Sq54kV_oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ebmsYlfjX0zlrANSCObq6kLNUkO2OSAnhdROIBW6U4A&oe=6A0865FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kJrt_AYG24Q7kNvwF8Q7JZ&_nc_oc=Adp8fx2McucDvMrzUFHBWZykcmoK6JsX0egztR1Fcw0ZPMRc8D-AD2lE2MxCf_DIR3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xVNySgzkQVBPNRhT39YBCF5Wu1pRlOcta_UaHKcRHQQ&oe=6A08684C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuT_ipdzolQQ7kNvwGxwbZ-&_nc_oc=AdqT86lFVTil6BkR4YWs13nHk7x5YO0fvGWgelyXmKfyPuMlUlHv_syCIW6SXVJZxcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nsr0425_qeicBKaRYZ9Lw1vDB7ZXRDeNIUwVoY7DiXg&oe=6A08717D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMLSp7ImF1gQ7kNvwH9MkWj&_nc_oc=AdrhYGJjbRaD7OWLCRdey3Fv20yaRYdRYG42pKmld4DwfYGV8Cpn23XUyWmhnMKLGvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DYUsp-tYa-MvRunel03IvL2BzV9jxyZWAA5kHriOPpA&oe=6A088FC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOXjhNU1tHsQ7kNvwG74nql&_nc_oc=AdpnW87V6Ru_bD_b5mBOwYBSpWI734LfISkVsP_9Qq61jYclbFujDTjYEg9ewmHXu-
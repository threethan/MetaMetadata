t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRCfZKcprIrC-arJCHlzx3wmTaaDzExF4pNaDpL_67-A&oe=6AE8A2AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcSzIhdi9U0Q7kNvwGUnk0p&_nc_oc=AdruDnSVzYltVHCNwKQMm55lzvde58T5PEg4ZOFbE53RLZWjY8LObr0clZ_PyPT5w4w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIiLTSV-Hkhln1R1MbjlquzMPsrQLoWgculSbkHgn8kw&oe=6AE8BC93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KSRO34Ip_gQ7kNvwG5hJ5t&_nc_oc=AdpZ__174FbTcwj6y6NyXoICcJIVsgAy6W-QK6rg9YB7MG8milVVTswraQlCL0xD3Ag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLokWWMIY-P3GTLL5UZ5SGuLLzVUazV0w9oyk9rtzI3Q&oe=6AE8BD3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNH1Qf0bLUQ7kNvwFidf6u&_nc_oc=AdptD20Qu5Pi2lfLH77T-TLJm2SPCYi37oRnOUQdink0DTKBxRu3QoLqu8wIdfMsVRQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjsff-8flKlPCpGxZdYCkOEOGHToXQz5893QpAmyYIpg&oe=6AE8BF8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SqR3tFOJAIQ7kNvwEGHJnh&_nc_oc=AdrcuN8EcFlBQolGazby1VSQAsM1ljW0cATFcSgwb5bG9waufVH53SmNEJi_qvD7BRg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZtpJWuR_B-kfvq_jfhMEhEsr9mF026PK4qDWtUGEXtw&oe=6AE8907D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeQ5I1W5UG4Q7kNvwGYtqch&_nc_oc=AdqwHWnmIF-CXov1kleeYU3PHkcMLGjfe6POlbwsFK2HY60jk8j2Vemkpbvuef2jfKM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROZpVEz-fWwhgUtxOWAxyrEwJrX-fF6Wrbgb-mKNChyA&oe=6AE8AEC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8RITI_UaoMQ7kNvwEZvlU-&_nc_oc=Adr_LzqM-Bed6FS0syHnl8uv31OE4fhbss4RcjdWL2TSBTXrVldU5_m1w96VMZKH97
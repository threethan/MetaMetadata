t-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y6mrBCK1MdVrXUB76jnbj4F5mbm-HnR25mGS1w045JA&oe=6A1C4A2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTNF7t68z2sQ7kNvwF1pb5i&_nc_oc=Adq8Ji5Tq452wXUX56Z2x0YovlnBWq58BGr8e21cDir4Jv54moqCx-J4wSeRAzCw5L8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5detKbBZW6aC4VrOVQXGp79vD9jI8_XrkhxdEjZSfolQ&oe=6A1C2BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vetYk-O0q4cQ7kNvwHOpqPb&_nc_oc=AdoUBomgfL62DjJVV0o_y90RZ000a2bmq-FuE8crmuPQTUrFxfb33N97A-OhPVZ2Qsg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68rXpWor7rA7yHvwhTvcMrtqT1gpvvr1gLJoV8gSkafg&oe=6A1C2C7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rhi4M_ayQoQ7kNvwEhOREH&_nc_oc=Ado5ifqUtOQOkv43jDs2pMSVn2L8mfTWJPjSLO_hG5mgYfjZI3pFkdbsW_XTlDk-rOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SMc-9c6ftAyYLEYBj-DLqr8LywME2oeWLbkg9GZP_Ig&oe=6A1C2ECC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLZPDR2ev1EQ7kNvwH7KdF9&_nc_oc=AdrKyXJIEX_ZtIum_GXHjoFpeLopwXZK1lGyUQZhXbdlEh110I8uGU14Et9kLSG-84Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tKRG5Dgx6ylNdO_nAMbA7TgehKw8Y0F-WRS7nO5wafg&oe=6A1C37FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMQiIrmzIVcQ7kNvwFKmXbh&_nc_oc=Adoy9Tynde56ZGe6_oSvovJUP34hiTf8WPiGDQ9nqbkcizgS2YRn2LF6zQYtGZRXTaA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l8u_p_09b1_vfzc3TkTaoxZ1aIs1N9nUDC-0XWBXuyQ&oe=6A1C5649"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRLZkSMbUbEQ7kNvwGE4M3a&_nc_oc=AdqQDlfHp3bc6RgZU_f2F43TeQ090HIZqG3SFnH-U35d0kzNcmxKS6UraqQkUyHyS9
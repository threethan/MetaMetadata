t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5S5_cLJYP4j9-7byhDjZTHxwQRkLvy_3oWRm04QzaTQ&oe=6A4BC02C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPzRoTDQ5gQ7kNvwE5YvSO&_nc_oc=AdrsxcZUbJAU67773Ri0RxHZ8y4GX0cQiKy-XyaxoxBOJO-j-igo6xODJOkzcgipNl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBB8rgrNQYQ6C_ew1qdvtP_hS1-rROQI2X5vmvN1muvA&oe=6A4BA1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8WlKkQk5KsQ7kNvwHP_KeQ&_nc_oc=AdrdXaMHQERRjulpE5x6x22oVkBUn8mmIYzAD63eP-gofcTNrIWWVyqU22A-PjvhTZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoqZjIKGFcI14qS-4SXQEOHBMCowQhjoWjcl3yHwwZDQ&oe=6A4BA27E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qopJlAtuNskQ7kNvwGr4mli&_nc_oc=AdonIFguvSPi-PzzjsFv7rF7qrKpEGwioamJP3UVSvSwn0lSOxEyQGU82vBYqz8sp2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1t9pbpayzoL2y1nUZSg2s7lvRne0rUZ4dAD8qtqICEw&oe=6A4BA4CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR2ap7RAZAoQ7kNvwGsJxNA&_nc_oc=Adpi4ih18leAZJBmE5DT4pfqTIjxRyvDQXQrx0rvcTVOhtC1-R0Tz0VA7cPR-SotUsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANxkXGHKJeaITZMLloZmfESaV5-zFpwmlO3Lf4RxCgEQ&oe=6A4BADFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNYvzVkn0hYQ7kNvwFNnd38&_nc_oc=Adp0Rrwe44kHbGPRJRqVWqlm42xQjnpuhBBZ9i8hBLwJhD-RBhUcK6ixhMAZznq3lPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9WXiSdeJlrprt9QmY1l6TD8d3IF76HQgQeuKHyO-lKQ&oe=6A4BCC49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-pCmYVNMcsQ7kNvwFGiSNp&_nc_oc=Adpcy5qcdw7N_4MS6l3AfUTtoAPCqDkRY90CnxhF11qq7NKVcSZrwX01oPTu0etl-Z
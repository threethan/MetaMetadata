t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6hXEAg-gGadiy2WGEA3Dv8B2cKaTiYAsjYsNdvILGgw&oe=6AF7232C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDScwktkWkkQ7kNvwENgjaj&_nc_oc=AdpgJ4CW3OH2tgx_j1cAGu5zCG7gzyQslTjiG2UUVe0e86_0mtV6Ill4hNcL1h-n4VA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_Yf-uqce0wcAozYw10frMSsGUOX5cAiYC8dIwjbdS6w&oe=6AF73D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYpR7_Qb3FoQ7kNvwGAJ4hD&_nc_oc=Adr26-vUGflV-CPOku47FqMz-OxlX12UeeC9zMKZ4R5x5BloWdjipoztck4PzHO9Sd8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvYE8Lc0zoUnehb0RB25IlD53lLpohcXCjTnutxVm_nw&oe=6AF73DBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JEtaqwJnmgQ7kNvwHxMEaa&_nc_oc=Adp8X43DC2qcv6hwFJUluAl3jaW7z-vLwGbojasMLRuDWn7ni8zWFj98VO7p4qVS0JI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI2ybGKEiur7UMaQ8P9UDHBvQxRcnGHNMphjPJD_Sf7w&oe=6AF7400C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdZddFKpoTYQ7kNvwE6-Jl1&_nc_oc=AdoK90cOMzrA5oDGEriODVFm7YT7llG1XTbM7su0TKx3_A7QaWQLhnyWUWdWRm1AtZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHpzh_R3GuF700BWTeIaJ7DlESLurV8PXPv7GNn0RtHQ&oe=6AF7493D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iun9pnNxbV0Q7kNvwEyORRZ&_nc_oc=AdpNyM_sw56Vz2LASwAzZrcuQTE3YO3t9iqI0LyqJBRx5HEyxqWPu7qU05dtnPchPeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP8Hl-ea580lJWRhiuDaN29pB2cTgHlqjI5a2R6wEt4g&oe=6AF72F49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jejI6LityO8Q7kNvwHfyvmE&_nc_oc=Adqz8tf3Ynfe-3ISAvtToFSpNQzhaI1p9BAkF4oVcIpsxesLgMHAFX_IZFlCv_MAGx
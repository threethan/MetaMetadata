t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14IZ-6ie-wjRgStZX0woOH5AZC6n1AxiSm6zTIbJ_goA&oe=69DBB0AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm8iVgblZ-4Q7kNvwHcZa1H&_nc_oc=Adq9vVgEMxh9xyNPBrDFDdQbyakPqcZzoBAwMp8AI9T46WzLLAc_LiuoddSriZelrzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I3RTkqnaPjA89XNnqX5HcLuPuQMJTECwxidRk0-XIyg&oe=69DB9253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMZkozHGOHsQ7kNvwH67jeL&_nc_oc=AdqM7IkLEg8jK-wuiBrJR7TJ3PHtbLGHPbTEyFN8GXL_SHPbqXLvwu9rjqd4Lzyy82A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af389QJoYKYMrUx_2Wsb5jyMonDG6yuPmyhmEA6YluKF5A&oe=69DB92FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM_EIKkpgdgQ7kNvwGcqUeg&_nc_oc=AdqZyHtX-Q4XNP8CWqaAbT3DDVm-ie7_ktm4emro6v1xH2fZix_nuVW_wwQw3BIPCGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35CmkWUNo7a-WW7kJV8EiFmAqLTbo0sEakPixQRCYGdA&oe=69DB954C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=239-R0VQwAQQ7kNvwG-l0Bk&_nc_oc=AdqLCyFrbkEME-Mu0JZ1GlNAaoxCd78q4soqnCamscbZw_SYIfc3FA-vc1TyXTg89lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03gMBI0RW5Bu6zXNIXf9_oHF3fHWA0mTLWftUXC_UvnQ&oe=69DB9E7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBFDflt8zpUQ7kNvwHIVwee&_nc_oc=AdrWTZnwXB-9syyN0EWgEixXez4RsCA6suPRleywtxx8CVD8awnkZgzZvXo254f8SF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EAbledajtbsfbazX4cS2Qkzc8ZHz_7ZpazZX2L_3sCQ&oe=69DB8489"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSTkGDVpu00Q7kNvwHkXfET&_nc_oc=Adrrk-zHtrjCVGuwMGz8MZyHe7PCpMLtQNOJTQOAYTW_Do5ouiXzDvpYDY23wVrYje
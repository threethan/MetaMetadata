t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s3bOCw9lgeIc75FhIqC--LRoFgSbzFw-yIGJLDd9r4w&oe=6A2EBF2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrrEugcaeJIQ7kNvwEuQLtA&_nc_oc=Adq1wCeOOeYe1S979PCgTpKD-WmbrUXAMf6ihBZOXZLe262B_e1oStRWpcpYCrRrP4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81wiiJd3eS4yvFnfJ93sGhaiTiIes21csNvz8oCGhUOw&oe=6A2EA0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EElOEeULB-QQ7kNvwFR4hgd&_nc_oc=Adp_3EQKcX1SA4Lv6VV13h-gKyHyONhNtOwJvRhULu9E_9VcWO4CFPXhjFSsyVmuNG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yX8s3KC_heJ_DeHYOdX306yzZwi1JPBM6vOiJzkHgyw&oe=6A2EA17E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDujHj-EciwQ7kNvwEJkeG5&_nc_oc=AdpCLHwGR-7WMkjxFQUGTYv2PXhKwVPRDRBIBee5FPtpJaIKk4OQU9EQFhlzYgdM_WI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ivZLJyQgtPVJ6AWw-zeP5y1xGHplSjYsnRB3MKbulhQ&oe=6A2EA3CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKbExDb5bLQQ7kNvwHgBeVy&_nc_oc=Adr9L8tvuwrhhH0Jq_hnoKJHWMeiEIx-QEG7hXwmlG_DEObSmsroiHoKsvyiVKSE8aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FdoLN_enBSrNVNgCTC9cJrE6zGcUrRthrK4m4WzmlZg&oe=6A2EACFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZmswbZ1xhMQ7kNvwG33TH4&_nc_oc=AdoTFCq-gSaFpxesgi0QpMWsWu5VG5nwuACynUYmFtwi12HLrBakd-Z43LJvqehPI5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98JxJl5LfD839-ntVro2CkZwVutkZ-IEq2JY8MQtxiPQ&oe=6A2ECB49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ7HVIKmogoQ7kNvwE38Hdh&_nc_oc=Adp5YXk7rxB5X3dncN8Isnz0Zx94FzKhHwE7dzAQBZp5O-uV8b7sLy2y93kmorf_gG
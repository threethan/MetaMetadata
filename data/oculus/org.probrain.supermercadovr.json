t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-vFocIh_ZXB_Oo8XxngwGpFCcTKH29VlF7sjBu2u2fQ&oe=6A9988AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWd31veg8XkQ7kNvwEevUS1&_nc_oc=Adp7-qoJldYNtpuXJloP8ykzes4kBEeYfAFDMxzi6go9KzuGFZaREjq315Suoi05Wl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVk4UKCa_Kr4lAEmtQKPUz2XyoJYFNAUKBcfM_ynjsUw&oe=6A99A293"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl7eqhVqSkkQ7kNvwGCN36C&_nc_oc=AdoaPp8th6szn4N0lA7pXqrjvDxKbyWbRfqkmRcKWVW5DV0H9iW83McqNKoiXqqTE2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGJSFnCCUDbF4SknOjIy2kmL4WXqLEbU5tCdy6iiCfDQ&oe=6A996AFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIYpErHp_B4Q7kNvwEuQJit&_nc_oc=AdoxDqR02acTsSEHCnEjhJ66t7d73gWpCYyp-dsayeovb7qeTJlVng8iblU32wjrEXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKio66kX_me1FoVuqeccgV_hrPT0iODwYtLZUAgOOtbKg&oe=6A996D4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKk9bAVnG7MQ7kNvwFLOe-H&_nc_oc=AdrQJNMBnAzLqpYnSHvs_2rQ4_o7BpXMlHRjaCj8iJp6pKGs3P78XStFbs960rByfAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBqiHoMEhjCcbisU93wJcuWCVTSkXgPW9luxJsHuyAgg&oe=6A99767D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzB2lEmvmJgQ7kNvwFiuv-C&_nc_oc=Ado4GzYQERjJ7aBS96mSVg4cZi-nf11feI3iROYSKg470GaaMY_f9qaxpX_16mONYJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1LejCvSkSfkf_BHe6z0FJ1tRcUX2RlaQcYQn3ouZnqw&oe=6A9994C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0fqqa3d3QgQ7kNvwEP_lOJ&_nc_oc=Adpadzfaais283DFbxiEzwUR0ErQqjHH9SYQMGcLGzeTQThAkjwVsoH0iftmdiUjo7
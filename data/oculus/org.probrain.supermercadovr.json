t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxLmOhM0M_paDDbU5k40tq2N9UhM0uR1KDdxrSLva1fQ&oe=6AC115AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnHSBBTOM0gQ7kNvwEMWyKN&_nc_oc=AdoOr3Ql8r8AnrcfrCsSm1yxo_IsfUB2hRAr9oqsgrnXkS8Txun5k5nm4AQyl6y4V44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUZK0q-qntfA6MvaUPovIjqt-UxiNuse8P-dpx8o-ekw&oe=6AC12F93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4jnNjry6ScQ7kNvwGht-Fx&_nc_oc=Adq3IScEj3Y9ukohQvxyi2W64Z9cF3RFsNY-RHpPUSvCP_J7KBXXC0R5gBN1s0Q55vA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXh9uhMJRp5g42ROqye6i3tXpZc53T8Lve9AoRm83Hcg&oe=6AC1303E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkIPGOqwY78Q7kNvwGLcorr&_nc_oc=AdqGGCttfCHe5_BEES55wwHmqYNZqXRswxf8fmbNP3t0ov5SDcwfnNGPIF4xgx8kQz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy6DX5Ff_qTgNbJv23hfn90wJDyryxBrie72KoYNWe5g&oe=6AC1328C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee9Fq73jBsoQ7kNvwEbUb5f&_nc_oc=AdoH_vdb2Hm4mCRJ32ao-VjoC5TSpF6tf0DEyvrpT4upMTYaJezYZL-k78q-YB03Vck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSV1hIjRyeeRSly5rB7kp6ichNrKxvpwUpjrTc5rbnsw&oe=6AC1037D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjKIUVtj-_sQ7kNvwHLW5C0&_nc_oc=AdoDZwtx0C6Al6JC_4Za00zvRVyLQHxaYMi66fUxLFecE8IIa3CikeWacRVvMpFJ7AE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3TMy2JCMZ36mVFipo_gpPjbwDjkHxmTnJbpYFHoTKtQ&oe=6AC121C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmjTUGXq23kQ7kNvwELuvbh&_nc_oc=AdpmTFGFBErBquAyAfd0H7mZYozNDGS9Vsxt6TgHGlx2Fihbjick8R1GvRQgIdxpSC
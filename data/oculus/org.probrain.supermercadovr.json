t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-Hyahu-GDNs5CAvbPTXkQbgQpuIau-Z3-9ob0hzSVqg&oe=6A2D6DAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o74zSvx0OQUQ7kNvwFIhXAE&_nc_oc=AdqoSQ75QhVItksjcN1g15Q85wrMXV9w4q4ulBOb-HpXD6r2bET6sC-6LoVVKC_bpSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93azOoATX5MlUtHeqI7AiErcfd7ZOBnDikduX6P6tTZA&oe=6A2D4F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FyI-Xtx8PYQ7kNvwEA4DvF&_nc_oc=Adpyd_PMMaeSQ7DY8D6MwF24TiSKj_df8tiuk1CZsVo-6CipZTCowCkggB0eZCPaSyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TaNTH8sAO4GD_Se6oaX0xupmg8M_c6B-Zct_wpoAqsA&oe=6A2D4FFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDujHj-EciwQ7kNvwE7hwgU&_nc_oc=AdqjUmH8_sOH-5B7WOJ7CCmElpbdZ5zUQiSwOyq4jEPHPb8ZDborH3mnpvT6n637t6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ilyp6vW1gtYmk_2HK9NcHcPggigPFr_1P6RDUSMVvZw&oe=6A2D524C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKbExDb5bLQQ7kNvwHAeeVH&_nc_oc=AdoPooqzB8OvghIWvxpgfkpvziwoKpLpv6J9y3a5UDXByGRiANtLWT84K4obPyKOHkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P3e2hlqfmoOA61C6NDdE2rZoGEaoLpgcH0OfB_AOqrg&oe=6A2D5B7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZmswbZ1xhMQ7kNvwEYzFzg&_nc_oc=AdqJ3-UmXgnA1WfIkWdNy-mHcjXoIkX_UI_XYDSTZW2J4EgNKpsfly48lSzcDJb3obE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vRYWibwkjtQw69ewH0Jbhk854jSqL_TLpDLFrie11tQ&oe=6A2D79C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ7HVIKmogoQ7kNvwGuNMg1&_nc_oc=AdoyhdGbv8YBpJ0fpk13jgWO6Hz3wWnikKx3PdpGhHRPqmbbnSsv7gncb9_SW4IGci
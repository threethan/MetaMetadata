t-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk4LKXcB4-6hOi_MZHRV0EyES9BA2Ho5qHshCXvv_6tQ&oe=69CBDEAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=marTDbvRvIwQ7kNvwHkAmUn&_nc_oc=AdojDMuDps9NYW1FZwF5ZxyNMuNCESUNCd8_4jK5m2gqm14c1nvergFZS0Y7cLpE6pU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY7vbW0pGzIReItratJe5ogL7FjfqHHi7cPIM_DtERVA&oe=69CBC053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2WvBIjamGIQ7kNvwHVyfbQ&_nc_oc=AdoRIvCLeIQvqHfar8nMWnd6DNVyS0uCzo4u98JsWbY23Eb2apzkbAsGiS9KxmlKiEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPeqpDIC2Lz6rpSd3vNCVQ1YeJTcH66_BsFt3G2n40sw&oe=69CBC0FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kflcomvRNPEQ7kNvwFaIxRS&_nc_oc=Adq7EnD9UKn_XlRo_eiCJV5txrsA0gaeXGU-bOVCcf_DdV2dnhcneibO2RccbLVz8lw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU0H404UDyPLPByry7F3-KVqTtX5WfSRcO1qGO2fwzRg&oe=69CBC34C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELwgZEmpE0Q7kNvwGBgpj7&_nc_oc=AdrUpBH93crdGKMSF2YEMokqeyME-dNq5BUHK_TNtBliSZJj5Xke0iNIy0wUt-lCWG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpR9qvRx44imta-2HzPJM3Lj9OAdmuZGOSeXaNe6ds8Q&oe=69CBCC7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqPR1uwVfU0Q7kNvwFwBIHv&_nc_oc=Adr3Ot21rVfi0k91VyKJcwKaAYgUg-a2eKxXKfZ1KNhEJBnxYdlbzsKnuqMPpPVgqZI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6kip54uLTa48yoFEhYz-E7T1PF5WIJEiFUMGY71nHLQ&oe=69CBB289"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF9RG4ZSF6wQ7kNvwHosgrr&_nc_oc=AdouwC1Ppb6v7qGKSvJMDcSz5YsmXncxTg-SVdDeCLd8oI__2DlIyTpKKJZE4RCfW6
t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79A7SOk77aIOw-l7n48860OgP-kVz8VhYphY7pyKUQ_Q&oe=69FB54AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJIjh-9SoQQ7kNvwFAWSWo&_nc_oc=AdrIwmoSwgE6G5BJXTJKT-J3Eyn7eHI5VSYnuokp2JmmXtMdK1IrtrgV_tnOs6sBtig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79CtZskZEw2HSKZKYiEKpHHWil44wgniJCcx8acpWcgA&oe=69FB3653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa67thG4170Q7kNvwEr7ejk&_nc_oc=Adof-aGSqWl1U7iiNRGzvtRphgt_Tn_lP3Gynr_UmgteZxZm6YVkZOCm85Fln4ncq_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PMWxd-ozbfF6grRXwLrHs-9P87rrv52AsQHfM6DH5JQ&oe=69FB36FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18U_b1BIWgQ7kNvwHsn0Vm&_nc_oc=Adr_URYWXgfNISxdz_QjfCeq2LH0tG6mWJhcY3Rl7DhTv_gKECOBUXGe4CxTtGzVFB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RHrrNXtQcl7-PIKQ-SLlFBnR96zPLgZ0JGXd_zufM_A&oe=69FB394C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9zR1m5pBzkQ7kNvwH0Wia8&_nc_oc=AdpT21AUgxna9tDa7G1w30wgLEqK_ogKmWkiFSTgMNiM_xT4OzutIQ59dykuS5kxfyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5goFAzfkHr2xySNkgW2xzZKXr-4DCB4SHIR8NoKveAyw&oe=69FB427D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUTstrxUJMQQ7kNvwFanxFX&_nc_oc=Adq8BQmMVJhQHNGRYD-iX96bINazugb9cuWQfcFJoS3KBsWSK8K1wKfJEfczQZV_rmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OG-2DplmfkoLr3W1kh2pnsxdCS6qpb4DH90VsLnXuNA&oe=69FB2889"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXM-NjB8mQ4Q7kNvwEtl1nn&_nc_oc=AdoqJykDYQlLuIOODHN_FWTRj8Xrqjl57heWbnncFlrRwUWVeQIZ9Zqygie8hjjl-K
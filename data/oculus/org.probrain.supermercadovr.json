t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdZxO6AwIuschPGqcd9FcgO4dkQzdiqRa-xaVy9oFflQ&oe=6A491D2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYnnqYO34m0Q7kNvwHcQugW&_nc_oc=Adq0bhB5RYfUE_MEi2UlGTBfe4xbFyZIze-NZSxPdQfLboemRZo_mhMB_95eQVMxpV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl7EwLFClmvAjEi9Ay717n-AmptOoz4gLzVwx6CdMFeA&oe=6A48FED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9xZWDfHvRYQ7kNvwFIA3fT&_nc_oc=AdqgCd-kSMlhr6yOe33g4l5xWD4vm36kFbLVcXA2OOxsJqUfYqZPhzRtMHfYkdgT2o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBwCIqvYLlQeKE-NGhv6pLPla9yTBOHJItgbIg_pMl4A&oe=6A48FF7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4YXjed1bB0Q7kNvwEhU3JC&_nc_oc=AdpDYzG1qDAjh3v2g8nRBvOFBIm81Hm9Vo8iQtHLUiPHN19mR3qFmUrTVBbFZ_pv-H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP6lz0R9HLAaYC18IoH7-2zocROmqk_y5giDsEeGULEg&oe=6A4901CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1jdQmKnt5wQ7kNvwE8I9O2&_nc_oc=AdqDpsce-4KRbBErJI7HLWOaHzDDBpKFkNcsZ4rTZxqtN_sffzdP-iSbcD5FwrLCIyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEoh8kNdMLDJgnRL2Fz_bCCV9J4hMVIxGWfXsjUjnttQ&oe=6A490AFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNYvzVkn0hYQ7kNvwFIu3G5&_nc_oc=AdrUVnPws4NhJbg5PsZFKmGfLbpImMOdSSRuHydv_zDlFuTEkT0Tc68B_afmUDonExA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ0_c_pnPnRME-ZmQMmMqStCLGkn5KLH9m39gzWGqHBw&oe=6A492949"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-pCmYVNMcsQ7kNvwG_rnmM&_nc_oc=AdrIDsAjWSnLIAdI0sXnflC6D0AIEE4RBkMgzNcWd1HtxdWuhYi7J9WrBXtMcLSfsJ
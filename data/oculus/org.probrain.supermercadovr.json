t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1HVNy887dk_hPPs-kB9JBi85vJ1jj_PUJPY0S4arg2Q&oe=6A98372C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVtnPLgQ7jMQ7kNvwEffU1R&_nc_oc=AdrE2tNcStnkhFNTLr1O8hDhAcWBVCqmnnH31WJPvnFARuVKdjOPkwAMJC14iHN4K4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX1lsl6gwkremAJzAIN2EXSB0QQDNkdY4gHW33iciZpA&oe=6A985113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zegjQZMNWEQ7kNvwETHynj&_nc_oc=Adr9GSGHBvlMQnZVvwWID8HQtFfr3M2XSmlrnzPn2mbBbudlpizjXAVFBAyqK1KPorY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmRpUUtFAbehW-rlhDMgSSdojPZWUFXTcSrTiVJrUiVQ&oe=6A9851BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIYpErHp_B4Q7kNvwFZeVqF&_nc_oc=AdqFUE0mvklIn4tUGbLoa-q1P4rQm4w_6iVC3ppuA8fyW253MhfYvtkKC-wLM06uPPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCaKtXOBD7rYIb__Bn7JSuECLFoa-JY1IeHkp5oA3ezQ&oe=6A98540C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKk9bAVnG7MQ7kNvwGgBob5&_nc_oc=Adq_Vn88XYTZAX8iCPLG7A7szkXhNLhJf4UOrkdlaoXcW2YYiIxsDvc8HMu0pwOQISs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBAX1mfcdyozC-yAwou9ZgNtlUie-e6ECF9kfqCd8lfw&oe=6A985D3D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzB2lEmvmJgQ7kNvwFHYDw5&_nc_oc=Adrr6IAYSsZtTZEawsuPpFUH8yrUIHUTEY9qdmGsX8RRcxZ3F3SD5psHe5PHTut5V_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrJdXXuvTUn0PMZ1hqonp0HhKDkbEQMccAAYTl8dzS2w&oe=6A984349"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0fqqa3d3QgQ7kNvwHkaTKx&_nc_oc=AdpH3K3hOoL_hr1Z2nKnfYEM4FiVcxfv2LDJqrSfoEO7UW7KYJuUiyPpwpwI-7pyj_
t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m3yIPfpLKLA02you9cjhugGJjBN1LC-WyUkF4TozGJw&oe=69D6326C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2d2l0oGevAQ7kNvwEgGCo5&_nc_oc=AdpAOf4YMISZ2KFNEKHyIU-S8XqenkC7AkMYtJmuHXq9P0gzAXE8l0iHwqyIju9weok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QdQTMoAXG3bt1QaYnR9u5TBnVXNPmmrKBMk9jDUkzlw&oe=69D64C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCCGz2jha8gQ7kNvwH8aunP&_nc_oc=AdrPAJh7agE1Nawmb7vDlAtmfcSxGQgxayjNi-RFCiWtUHVjCjRD7Rtbl-gdfhCyZV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OlqgP9_JcP4A7HCxOg5DN3avZAz7x_GZVTGhRVyNyIQ&oe=69D64CFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC1Nju1EitgQ7kNvwHPo31c&_nc_oc=AdoZkod0fwWSOjqVg5UMWlVw-Sc5ZTlIeBzB5KomyiUKRwxhRzbC3OBQj9ASl3TyxEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XHfH_y2KpzVaco-rFXXof6eH7CcMAwe7dMe95yAywcw&oe=69D64F4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF8QYmPWm90Q7kNvwGxqjKy&_nc_oc=AdrUIHSAVwpOcOXgH2BSLeoSuqTnnM-gXr3qwL0-rBhlo2XaerXozHB0w0qm9A2pPPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pYkg4wIceLIXn_OkiuobKuvzbgQ91rDSyPXTfMLROcg&oe=69D6587D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOuWrt0XuQcQ7kNvwEur3sa&_nc_oc=AdongL0WaC5naeei9fGWuRH7eOvy1Lg0MA5VMR004icuZhnwNWEVxmXgHVGjwD6K50s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SxEokBl6bxF_xfUA2ztMfYnFy6MqbxgwD_KYdpkc73Q&oe=69D63E89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywbEdtqXldAQ7kNvwFJWPlQ&_nc_oc=AdrS7bVJ0797YGUeRz5BAwUv6HesxH4-btr61MZbj5utGNKajhgJ5G3QBgE5oOU5q9
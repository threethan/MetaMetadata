t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GKqpEBmyr6O7tbjqGg1WertZxHDgfJrAKcqGLdFDiqA&oe=69D90DAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjkRCHun3McQ7kNvwFZTZXx&_nc_oc=Adp2kyLjGXSlQFuUbXxBZCyyPZyfTvBUemoDvpSgvbKGdUVFCJzFLElRgwCGyrJePGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xq1aO_RFj6plkgwZ9ysC69Ge0l8ynWiOYwYVNQ06AQQ&oe=69D8EF53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d48LS7UamcQ7kNvwGncwYK&_nc_oc=AdpsjgFDDL3sgKLIYXtrGDh7fDt2K_A3eHudxIhwJJzv2EVKps91BPcblzH2aNTKgXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wGcjI6zHDllcwE6YzJgdhAYOZWG5s1qc2dlgdgIgu-w&oe=69D8EFFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM_EIKkpgdgQ7kNvwGxTFws&_nc_oc=AdqDiIwoleeW21NTKmAMC7sjvLfcJ2Rqm082IYWy2yznEslQNNBlbtRVUWPFq3nLBWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IGGVPdcUR-6dCTbkcqavrTQhj54TJNSEynXbynGMYFw&oe=69D8F24C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=239-R0VQwAQQ7kNvwFpsHxU&_nc_oc=Ado7GNNO46jcg9lLZMtXwb5h3C3pIRCvAbu9UNZnqZGPO4RUDvXSjYSoteZOFcd2OhQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_oPv8tyCwROYhh9G5Uf9k_bsYJOOglmWdvv99dTQ3HQ&oe=69D8FB7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOuWrt0XuQcQ7kNvwEW-cGb&_nc_oc=AdpmHj8JD6uLEwBv6rtnyd6Sg2y952caPtIorr_yKeWZvyWqvcXct5B0ym6cZCz3pFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SWFVna46MIImf0fYI9b4i9e1mAg7Dxou_sTzFlscswA&oe=69D8E189"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywbEdtqXldAQ7kNvwHpBjUT&_nc_oc=Adq4lF-UHfZmmrAdxPOaFP9mcP_sTP-kssanxp3V4fQVJkvqumlDYzX7rH6StLN4Ua
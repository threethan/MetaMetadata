t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Pc5Bb0jEOWpW4hIgZ67kLffXDsHrso-DjJYiIbg8wg&oe=6A47CBAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYnnqYO34m0Q7kNvwHuVMzg&_nc_oc=AdpkomD3R4E4G2dJeZzsA9sowyISafGaXAdF74S-idfXGlw2M6ZihlvJRyBbvPg8nGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PaZBUJCiBL6OV4Kc2LRntDXbhYEPGgwvSI0etO1Dmog&oe=6A47AD53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9xZWDfHvRYQ7kNvwGRJvPV&_nc_oc=AdrdwU39maGlgdDp1TN3UYSsa5vbEm-_y3cJFhFSP5CwfwcRqm_Dg_p0w5jfhp1yFu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rGgobpp26gsbSQvlC0OxXslPdxX3TMwOrs86EuvRdeg&oe=6A47ADFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4YXjed1bB0Q7kNvwHfaGS2&_nc_oc=Adq5ImH3CA058mzywc_dxEl5io0A-ab_4pZMvbmvrVhmFxfvHsmU-xcKjtfuiFPOPo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-c4vge4_en-h8-7SHhARvXjdMLTKMQ-26SdlxF_K4Tw&oe=6A47B04C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1jdQmKnt5wQ7kNvwG80t7z&_nc_oc=AdoVgT0M0YoceyltZ1wH8g02ApVmMT5C253TjW1CgJvwY7bd9lknKtfezFwdj8AxqN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XtuxSbyMdBuWiiyeHBvqgJ6heRLwU2ypveSgE-fvEeQ&oe=6A47B97D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwQfgk0x1v8Q7kNvwHqLmev&_nc_oc=AdqQ4nCUxiqOwvE0prdCzwGcOIDTcACJyaHndo1n1v1AU4g-64zwi5J_iC7n1S6lIPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O1FEdqBWqcelBSZM6BqxECgvvatm1UUxH-hlRpQyHEQ&oe=6A47D7C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdgKgbOo9EgQ7kNvwGupZU_&_nc_oc=Adqoa9HFlkz-V1n4DYsodypcUBYaF3dSA4x7KG3y37CzpKD1xCjN_NDva1m61oyXMq
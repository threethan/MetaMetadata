t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXhYlnh0i5HOZbXzeJC8t80BBp0LlD0pTqEfPelF2Y8w&oe=6AB3E6AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsx5s6CaxrIQ7kNvwHSFhu6&_nc_oc=AdrokJuwXR14XdvLSaplhlxLm5QwjVPqyBsCFggrV61sc5UwGZlZhBrcoaHIRGehi0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLddqMIcvj33DYDtPBQe6--fmrVQf_BAdVabLExos2cA&oe=6AB3C853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7QOcaK5wSkQ7kNvwEblrJb&_nc_oc=AdoqZ5gvkDzGu81OUX3JBTZloG9BBMa7pcUKYI7KoxSG6uHUx4fAQNIymZifbhm8gEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb-8bGIwjrYUP2Zs5d3fBbpCxdTM2Xed5Bf7YKn4SWTg&oe=6AB3C8FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enr7ogkFFysQ7kNvwHQNKJD&_nc_oc=AdpgW-36GehCzu70jG2OWo7cJQ-MmRQBU1I_sI_CxSk5bwmpSWqbDRI6T0W2FPeuxo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDWACWti-0ttS9WqK0JpPJnWvHlGE7Xji7L_4iniAhLA&oe=6AB3CB4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AW9r_5RzY8Q7kNvwHrm4Uf&_nc_oc=AdqKrDi4OJ-svEtQ0EyfQ7ZEUQX932hSuyLl7t2sggGemu6D4qCj26Llvh3eZ52ltg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKStRKk2WNJLiuPgeNf9QMkhuRGWN1xWBB42U8KouIwbw&oe=6AB3D47D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFanF2GTbywQ7kNvwGOB9yS&_nc_oc=AdpDo3EnbMo7zmCWb9T-qVNaV_yOirqN5Xfr2ITtO7pLpLX7Y53p0s3kBZraA5T_ORs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpLD8AHU_n0syaEQ5lnvmcT6-pzWijCRwCbHxdM-xRDw&oe=6AB3F2C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HZbbYggB4UQ7kNvwFlbyDR&_nc_oc=AdqMldWfskbtnwLdIFCMZ2yNx-FnZ4KBeSL03FnsPAAVbUgc1xUQYrYkiZ1HebGFtN
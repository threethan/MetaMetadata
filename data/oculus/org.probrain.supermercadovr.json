t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v_KhT_KtF11TGds_3EBG3ZK3-7_wUMG5D8Pv7OYAljw&oe=6A29792C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5p3pVuhTZcQ7kNvwFQ3wOf&_nc_oc=Adp44SXyUAkM0HxUn-3BJWTIEXDg8Z_Cio3ODzq-T10hcYKbMkUAu5IFeFWog6mttcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5JT34SwG5bhD6p8iEY-0BAiV46QlYJcD5NdGSsBgrg&oe=6A295AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCwJEbNRVhcQ7kNvwFhREOU&_nc_oc=AdoBvBZd-jdNkBvfwvo9Q4EI3RJdxlMpE3oiU35WgkyCF9w6t4DntKSbd2flZe0OMU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gXgvyeqjudMTRLzHuwP5tA9wMGaqcs4XSWhn6ryRylQ&oe=6A295B7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klTTlTlgdhcQ7kNvwGNpwuw&_nc_oc=AdqsXHIdcm0Zak6r_pBfRAkiRgYWGSzwhF6FRMZSo8TkESYi3D-RP47ThUO7_kH77PQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HYQX6uEpqlW3bh7G7PV4jYwZZ23ZnceIK4dWvX1FZGg&oe=6A295DCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDuDFi7oO5gQ7kNvwHBEBNx&_nc_oc=Ado9hvI_aZ-X_Q3k-0DBfKIWjmcsDwtFuhX_k3_TSNZz9B-Ya6GsrXnSH159WTRtz5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fAInPIeht6sbQAJDFVm7uhFk56bNz1M8gZyVOO7NPCg&oe=6A2966FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LD12UPdjYcQ7kNvwEtwst2&_nc_oc=AdoJNH4JJRqHyjNa1_Z_axp6Jw2i5iJfQcphnwpczL1HQC-rHFlddn5fj3RQWhEtqF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OlUpzkwt-7OjHt-Ki2U8QCCp_iMgRRaXquDgo1Rm_dQ&oe=6A298549"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcQ5ZkIrY5gQ7kNvwFqwGaW&_nc_oc=AdrpYlVRtdOvS6pkcx1_15sU_pRmHwTmI-9Oe9Gbf861t2rIP5zcBRDLV2P8HksVE7
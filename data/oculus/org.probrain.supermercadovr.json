t-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rwvZQ_yN-NhqWgBgev2xGFHe9uANxe8sQuTZE-6EYhw&oe=69E78E2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVdHN-6b9I4Q7kNvwGLG5J_&_nc_oc=AdqwdlKZnQyJP2vUKoDo22YHHgTkaVVYbaGfgKx8oQo4joZ0qNdU0ZxOeBUewFj4G4o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wwTyVrWSafrmdMvn-eYb4RvwAqzIpkIXtPgWl-dpE2A&oe=69E76FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXaxqtqkTsMQ7kNvwGo7qQD&_nc_oc=AdrPHXf87ujTXnecSPiisbUI3iCahFx8i5v3owlnTEZXeogxHQlPBG0Th-ZATlN9l9Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OXLqLrWAXkvEcy4mnqF6mFpEywEg-_mF9P6Ckyv2goQ&oe=69E7707E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n84QossicbAQ7kNvwEvfx21&_nc_oc=Adp75829cvoZZbZL1CsGpDXNbcqe9C0iwVWYHccUrE84Uah8d6NAgCnz1UuGwCV6rQA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l_YE726fkkAd7ErMhubYIKosCdpC52GD2qkHJy-vqlA&oe=69E772CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdAU1R_rJ8Q7kNvwHFbSTo&_nc_oc=AdqQ9e6rwlyI28W7BQH20EsDaI2CEEvSVqmFHJmzwRuWXejVRqp6qJW7SNDkIvwCkIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_3batCL8Q-cvIELh_V28rxFxODosBJljV1W57zBc5Eg&oe=69E77BFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-MqF44V8ZoQ7kNvwElkJa8&_nc_oc=AdoHVVdvy9w5a_saHK28G9s2qt3x0kCqE6EaO61v-6wd5N9H0rtloIwLr0AOWdgQfdQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28WXOQ4QtghqbzyD252RmZpdgD7-FXjrNyY6l5rkIA7g&oe=69E76209"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR1tYhYid9gQ7kNvwFrIrLl&_nc_oc=AdpcLRUupBGPwscqWakOidy7yu4eDmZcNvnqat3Z8EFwc_uPKj2JJH0FMKSwRScYK4
t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wHP9loo8dMojb3eDwKZmeaF1c89fI0IiMyUp-432OOA&oe=6A17042C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LSkdpk5EtYQ7kNvwE38XGo&_nc_oc=Adp6gOVPR8q8crG3mpQ30CA6sXyWh3D0zCJziwJ_wLWF-VtruNQVYHJnMDrHT6olFEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T_H__ZNbfI0ZWhoXMEQlyCzoaE4_LWGQWLHeV4A2O-A&oe=6A16E5D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQkcjqhDsdkQ7kNvwFglv4Y&_nc_oc=AdpGuZ4HlQvkvbtvXV46aTPw1oQ5Hs69QAxEJXSD_bPJKEnVkC56jWgir_uP1gLiM8k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66Ot2ypiHuvst09j6GlwFAND4fiMbanKL990SKNFbMsg&oe=6A16E67E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Z5gf0GkI8Q7kNvwGcEueV&_nc_oc=AdqnUmP2zQnAfthC2Pzr1BQxZL8-ufwp0vWamnbsp4JXJCmPXYgQ0ZIKJgTxZXdswcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SpRfsRCilC9qLBSi2T1YLgVP-ecpwuFzVmViuohmz4g&oe=6A16E8CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNEvJJEVRggQ7kNvwE0yL8B&_nc_oc=Adq7zbhxPs5HN9WM6lTC7CEQOk9Lio3Kw3tt9jF0ZcCS0GGwp_4HHzNmi0O-cR9PS6U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mrn6U43mM2Z0Fw3PUo4m74U-nZd7YaNWgaVLsBryjCw&oe=6A16F1FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz8MjOD5c4MQ7kNvwEvALhF&_nc_oc=Adq0dxwl05l36dOxenvkCTPBMkOozDETHRdX0MxalPy2JHF8kC0LfPaRAA24veCXSGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hnW-MpEOIGnwIS27eVagdHlYKYYiTu-iO-Qhhi9RI4g&oe=6A171049"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKrbLLmqFwcQ7kNvwFbZz7A&_nc_oc=AdpRWBO0Z_drp2gED9NpkRncTn0oIeA4YDdVLTfUz0nkIYe6vdYEM5PoeU2_nb4Myk
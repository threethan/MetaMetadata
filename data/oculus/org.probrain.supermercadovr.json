8EpCAGeCkYqZSoEbBa8ec&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEqGoNXDxrskSiV3_4HHNEaosb-GyEFRMbVpdgx0kNqA&oe=6A8EC46C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzaCj7MTIwYQ7kNvwEjMt-i&_nc_oc=AdqdEkkGplpSQxdmGjVF-MoCbom6_wxbuQxG-ZhfQTNOZedGCl7Wa4PEi5HY1bBwtAY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvfjkofJ2PGQzao8OJ3f2M_3sa87SGe_cinMVPz1OSQg&oe=6A8EDE53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpXjx7YqdXYQ7kNvwG85ffh&_nc_oc=AdoAbJa5ZzEibiqfOtskwIda5fkmb7P2mUPR1WP2VnV9GXveqNal4wqb2dCK14WlmvU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvyT95qpj48rLQ5zrCvGWsvF1l2JIt31Co4kFL8niADw&oe=6A8EDEFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEO_9_uE1iEQ7kNvwG0oUFn&_nc_oc=AdosJTFbnQ64hFwvqDnpggToRqUDkT8kbfrQpABdujfyHgnPsCZ2HycxaJe9C3AlIUU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBmmlIQwYOJzSoSuJQutfVxqX55yUoo4d3dlzza_Tlkg&oe=6A8EE14C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKGMzthf3lMQ7kNvwG_V6zb&_nc_oc=Adrg0_23sAElAUdcvMJJrdIUCzJXKm2o4OXcX7T5P51lBntj-zsq_N6dJ8lP8SHC4Wg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_bnjw4B2Kz_0xOjECSDkg61AdRR3KMbwahC-NvXFWMg&oe=6A8EEA7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRMWFNMmKT4Q7kNvwG0pRKX&_nc_oc=AdqBYXQG6DM45qRdOYnVvpEdz_7m01dpjvH-__R5dvzKE_i3CKpQRe-HEebNQ9h1z7Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErvd4BpdaSmy96ZPwK_dvWLCt_2OV8acP-FG0IVGHXCg&oe=6A8ED089"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iovr73gBDfMQ7kNvwFpLFC7&_nc_oc=Adp8WV326SiWnlHhp
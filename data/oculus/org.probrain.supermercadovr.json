t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzwDIOQ_8D_LSdzmqIFaiyaRSanDofWgcHalt2zxA7Mw&oe=6ACBA1AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeRiq8S-UnsQ7kNvwFA1qQn&_nc_oc=AdqaMJa_3M_oZWLZ6NesJTaFPse78fCB87_Y9RY_zuw9oP04MmSBIqPYH6LD1qI7EJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0VrQCS_AMXNj-yNhWrbx9O1-33bR_xVLO_86AAaN4Ww&oe=6ACBBB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9CX6MQo6VYQ7kNvwF5c3O7&_nc_oc=AdoLNfKKQL0FNHX0DYgx5LrOpXW2jdCLMuv8dqBCcGoE-UWb5n-BTKPx4l2cn0thNiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ14xxhCxnWM7vVjOYy_6ReRQnC-ttoRxiNySFpoHMFQ&oe=6ACBBC3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2npesjDMM8Q7kNvwG1sIbJ&_nc_oc=Adr4urE5WC9b7aaQRJDFvc5mZcpS_h9etg4URxLozuEBj2XFpnrV5GkdqOStk_qjMn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWVVBsUaB6Fq8MWEGD420NN-Bi6panxOLOhuvzm9aLGw&oe=6ACBBE8C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPeOSHDWtGIQ7kNvwHUdcEt&_nc_oc=Adr8qQHucMxqpKSMNiD5O58bFcbxtzZRNmlWHv4nak35JTeHtxR40uNaMqsf95jnolA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9nM4G6eq-vgeH6wkfH-vO9NCiAnznOpdGZnvLwv0Q7A&oe=6ACB8F7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWG_NYGGfM8Q7kNvwELyUE5&_nc_oc=AdoQYGGZfQ2Y76KberEGWJ2T_TRmuUjhX0RRT4ctLfyT3G3RjIzcCdh06QVxb53hAAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5i9hvu18KQZtt6IGw0UtHh1O_NINW6sl81pdJqWPX_w&oe=6ACBADC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiaAfvTxprMQ7kNvwGYIQZC&_nc_oc=AdpEpW-iAYzwK3Kpv1SIUsHXfGKNvULdEL_RHneGVoqfS2G7ucjaOaodveXZrrhlK0
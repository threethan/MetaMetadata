t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ij5yycj_7WlOX1Q2cQnp1sMffXIFdiyXSA0SiUQvW1w&oe=6A2C1C2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o74zSvx0OQUQ7kNvwF0tX5s&_nc_oc=AdqVyEb1LtFaU9vSeieIsvVXkc1iNVYwwIYQr0YCxetDRp3-2nWIZX3ovXGqZVTPlT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hOFlP7C9x6Y9-_pDFvKTth2EmROMhGkYhAwDAFoiGiQ&oe=6A2BFDD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FyI-Xtx8PYQ7kNvwFqFJ_l&_nc_oc=AdqugTJmL7k1pWddqPfPp0F7Tpfj81XB6D-mmp9q1xRGoD1Vgl2h8lseAz_BVEF5XjQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97VBLk4H_Ou2KIA5ZFcQesp0r8sgVRjpgwwwRK4WgK2w&oe=6A2BFE7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDujHj-EciwQ7kNvwFs-PwK&_nc_oc=AdrX_XeGCfQBaZXI89H8qN1-DQNb2WyGPBKvjiV51jFPXwTAQ4vvTzXKr_n_pXXoMOU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oKznEkWbDrLOtG0RPm3RTCu4J8V2dpYYNrFf9rPwMpA&oe=6A2C00CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKbExDb5bLQQ7kNvwHJdL-2&_nc_oc=AdqnwxJMXeR0AlmHPAaGQ9LfvoktGP0eEW6exfuC4qyBVPnm_cpveUfZgESeY-izWec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QEpLR2F1tGTHNwFbbOnIwbuIf-5bl76LOinpbQ7h6TQ&oe=6A2C09FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LD12UPdjYcQ7kNvwEePgX8&_nc_oc=AdqsSmfu-8VCI2D9cLPiamIPhg0T-6m8QvzIobK0fEVsio_VKkJWOUmL-xB_-H-uCXY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3hPGh7lbqATQB3LC0hAmq4JvCC9od1-5Z0o4_H9z57g&oe=6A2C2849"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcQ5ZkIrY5gQ7kNvwGHOoqZ&_nc_oc=AdrEidLTGS53fJEArnCUHvviASp1gBZigLmHb4Hk3XwCBedcbvGi0OnBbfOWI_7heg
t-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ysGfHjLpL2nMOHxLW6JsFgjlXdkgwKC99Y9oU7aw5FQ&oe=69E0F6AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbqNZvLTEMQQ7kNvwFkAsW4&_nc_oc=AdpkIWx29LFzrM5KC7j66HJuTWIJamlgqVvm6iueg4ArkJStsD26GHqxDtmBE6WUyao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AdDkZxgTyh3CHWlOckiY3HNK2o2INckU7iGwBQFEVPg&oe=69E0D853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcaKmuNaAjMQ7kNvwF8VnaN&_nc_oc=Adr92rO8O2rRi0tqTcTZuinsGXR8a0nWbL3zJY0IHNasPl3MYXabDxalO2Adxbh9kWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af047pEKP29AIwDcoeSdTbIapE7vAMpMNN4dmdQeotsmEg&oe=69E0D8FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xxeob9lrTtcQ7kNvwGsVVpD&_nc_oc=AdrIjT6jY0UtueuK2EGbgCOdSVD93h1Oc3YBZ0Jo5qHY4xMWGZGezOzRKBuA3F_GE1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VO9CcRWsGw3xECyURUYLS-v04qPcLGDSz1hzTQRaY3Q&oe=69E0DB4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56sokDmwgQQ7kNvwGVt2jO&_nc_oc=AdpMNJuQn7u5On7Tt6JqOSFwYobtp5lbIUFQkpJ6ipRoL0tvbuOiYmT_pDrYq-jP5oU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pRMjfo9dE11cpXY6G2zvRh9_TCpXDH7sVTFFdUjs_tw&oe=69E0E47D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8s_HwPzUaUQ7kNvwHu27qI&_nc_oc=AdqHQlbp1lB8DTgszbMRi_A1l0RfXANVXNRDGy6dvCu0JCfeCCJk8Mx0F2r59s5x9eI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vz_iFdPAGoXMEdmil5nUs0sRG8oEHVjRfGxAnqgLXIQ&oe=69E0CA89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uWtbdpN7mQQ7kNvwE4xyLd&_nc_oc=Adp_whWdiXZ7olH5mdBJ3pMuKKIk2Gs4qpDYajbS67SLcCV8BqxQyF4ocwHDimfh2W
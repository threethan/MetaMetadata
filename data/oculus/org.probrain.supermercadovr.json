t-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af234lvUM6IAUSAdsqxwiknOBiotMhUn_qZZjx1gwd1a2g&oe=69F36BAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6AogVasZ1MQ7kNvwHuUVHT&_nc_oc=Adp8dhcAG_aHM6WBbYqxAIgYY3CzWvWLKz1iUegncfQ-H6wtb5hnVdRiom5ZejqBgEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17VBd4ToLUT5YcCeNlGQ6zCSIR61-s67Pn39jTw0O_wQ&oe=69F34D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx2nrKyWHk0Q7kNvwFMLCI6&_nc_oc=Adr61GwayaLfpIx1QpKS6p5eOt5RJXgoGzfgEnQZIz6sH-InVjrrIF9x3J4qVWNqtCA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0v0fJcv5TjcvaJVK7eI8TEnyW9TORq2BQuPokxnyGO6A&oe=69F34DFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epKY19BmrIkQ7kNvwHjH7ih&_nc_oc=AdrjNATMWqmjIEN_qBlRgnFR8EStIVK3LTdtBLJ15YwycOxTtyC6YOjLcIlc2PD9pEM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F4ZyQSJKT8TkqBZ4Lxb9zGxEbThUd9oDosnLE_7urzA&oe=69F3504C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyZmse8bkDYQ7kNvwGHf_0J&_nc_oc=AdpXGViP-Qe8_em9sdEiTxI6UVpuC0PPI-idGw6J0QIueEH1A3G4n12ViIf4i-eodog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af329KjoxBRa9ctI1IqYhTvPDOWKSR1gebA3tlmfcKzvuA&oe=69F3597D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ncs3voNsXAQ7kNvwHtyOg-&_nc_oc=AdqV91XloxrYmFd1ot1xUy_C9Tm7ioE9S4tHib-4hpaoxblpnvOjoaULXuPdM4_tAY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xheOXs6_TFq0QphzO8jzxj1VgbY-LrbGz5Rk5Z-QqJA&oe=69F33F89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNkFRavAUH8Q7kNvwEgrt68&_nc_oc=Adqa9Zm6LWkimwKDVvqZ10apLymu9CPRL4GPQ31PZpJRFCucB_0fWLM3Gooo8wvYLR
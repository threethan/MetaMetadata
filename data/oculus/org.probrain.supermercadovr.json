t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Th4OmyyKJ5CzuvD89pLqNYi3aKhDBb0sKZ2j9PfgM-Q&oe=6A15B2AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aPWKVYdepoQ7kNvwEGf94D&_nc_oc=Adp3jH7ulZcZt_so2IkpO2dn0E2wEsQQ6nzmhapdfNGIz1fAQgKw1Z4JkeEyIg9IIXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wZKHfSNPC6vO3sPZHJxge51urzRSHNvVZ7qXfHEfLKA&oe=6A159453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V9bAWZfDuwQ7kNvwHnPVVP&_nc_oc=Adp0XYWDx6nnnoRsGph7ZTTcaO7cQy0r7DYwvLUD8DD-s8EqJ0YUivfG8Oop27-W3Js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KQcWQMwqzNT5szvaI7bYIUXj0BzDcGdfO_-IV7S88fg&oe=6A1594FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Z5gf0GkI8Q7kNvwGxysCE&_nc_oc=AdouYreQuM1ePwF6PIC4WWog7lXqubh5Z8lN5EssIY1uWneEsskDpu32TnoIcd_EB24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rPVBLOGMhcI3c1nsVtWsNVlfHVIO3tPTRkRgQPV6-qg&oe=6A15974C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNEvJJEVRggQ7kNvwHS7BgR&_nc_oc=AdrPnLwrOboG0kMY6ONz84ZKDYoVVspkWhVCidzDaetdOOXhURSLLtKhaa78oxxM4RM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-a9h4CBcC5YsQz7HqiwQJxpIu9WbY_Umt5NJugR36Bg&oe=6A15A07D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz8MjOD5c4MQ7kNvwEu6KAt&_nc_oc=AdpJL-Uwv-AGA_JHOZm51jcpa3y04kFUKN4ctyrwVND6BlbarSCN5JNhVMkwfmIubUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZeNKhDDX7cJC49O1SueTMeAf3QXtYzwSDI4F4OBtNmQ&oe=6A15BEC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKrbLLmqFwcQ7kNvwFJodMo&_nc_oc=AdqzX_HqVwfhmHFQV1Ind4J3Kt1MJjG4UuuHx6yZ_BpoytvU_nCg5GgWmTw0EzqcjY
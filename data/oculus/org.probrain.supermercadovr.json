t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ljMzZmXZcBtWL4ENqEpj9c78j0WqC6PjBekXmpfFPuA&oe=6A4528AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJxuRa8ra9QQ7kNvwFMrP7U&_nc_oc=Adrge0Zn5YN6U501n9V99UrjAbc4fJ8-yzMSiTKcGi3pLvppPOOnhpq6qfAZ0Dqlar8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nQs2Apl9zgE71ut-9s1BvWGFbLA2xN-pYCu_101zc8Q&oe=6A450A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDfIvF7L670Q7kNvwFuiD98&_nc_oc=AdrSXbtIeG5lL_D0EwRCX9v-4ScMhlWvG3runs2GfcXtUo_GAXXGsk87XmKrQUzxTgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TuH13bSjvttfk3N7G2zTCPSgI2UZuwOYGY82BWoc_QQ&oe=6A450AFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ErJkbYd814Q7kNvwHW4duH&_nc_oc=AdrWfECtQx_c_VSpHQUcQdR6MPwDx0IpCB2hlhkfAJUEewZiU3I8X6TwNpvKUC2AF58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Q73_qaDcMrwM1RA0rVbY24PLNou6TEyM8MuMoUG-1Q&oe=6A450D4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG7uskkohHYQ7kNvwFVY7gp&_nc_oc=Adqh9UiU0bj6uGNVY-_fK6D-mkz5YEdK-Gwea9t2ijxNdTpCEhobb_ss1Cql9UJmNQk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bvLW6zemZTXJYE6KS-nfhiJ_DLv3tAxqrCPNb6Zn2Ig&oe=6A45167D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwQfgk0x1v8Q7kNvwHnM73w&_nc_oc=AdrqzZ-rQsHPwPM51T47fesgJX2GNV2dWritRqmiHtgXpgcyQQ8BpshXf3f92M1J9Qc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86TlMQJaUIV9moFWXqUJJ6Rec3Oy2OvP2DUtKO6YqJ9g&oe=6A4534C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdgKgbOo9EgQ7kNvwGIWYa-&_nc_oc=AdrHWyWUS6HuDYhOsItFZIt2ep5a2SyiZK8avdxNhFenmRY81sUEBA5DTrpN5sYM8Z
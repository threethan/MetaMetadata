t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNhU3umeK744NErBsXfmmAKsR7sy500pChswbR1QYgxw&oe=6A9ECEAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BiNSLMsI0Q7kNvwFGm_ti&_nc_oc=AdpCZk4hkle2ZxHVRfSdCCABfEoNi7zDNE3nXHA-VqFC3Oqeaq5dONs4nz6ITjYjXK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4L7mE0r4TNtPadoaBvROKwyrshn3ZzDkq2EpSFAr9kg&oe=6A9EB053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WPk--cXVKcQ7kNvwFIMcxl&_nc_oc=AdpU_sRMwLTIa9KvdoYjlOu3kgmURE-3gl4V5zUWo5HdH5e5sfBPmuA-WA6axjNW2pc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbOj63tdWd7wcXYEF6UIHTs4TC4w1tTffsTf2XAccfgg&oe=6A9EB0FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBl3re1YaicQ7kNvwGm9VKq&_nc_oc=Ados0BfPonc7p0UKZ5rMuIgoRwBLaH-tTwrDUutcKQdsjt2nY9LuW1xawdgujCSrBRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzhzuV8H9j4sEjFk_Xcwi8e80JwoYVSdCq1Ga2C1Mn-A&oe=6A9EB34C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woz977J-TYkQ7kNvwHk508N&_nc_oc=AdqEN4Xvny0n8wwDNsatx2XNh9yrY1l_lK13Otd09CvjO_nY9UuXYDoSxcPsq2oWvg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXlswQPA4odZikJAzwKxT_y6lPiEYQNAm8GWTn3PKgkQ&oe=6A9EBC7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPjYJacK11IQ7kNvwFmUvVz&_nc_oc=AdpX2Oprc8aSXEX3m7jrHcq-VsxgijcNd0egd7mJuTxNm26FgP3upTToNqNxKssxCko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOoGk1z2Fft2YPL214uy4EVv0NNkJy5aBZ3p9x4b0uqw&oe=6A9EDAC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj1uJeOQySQQ7kNvwHsuuJj&_nc_oc=AdqUJBdeXiujDW9PaZbaPCetRF3NSHhMOaRRJPwaFRwSkBqEWZE-biQYYG0mdYcazx
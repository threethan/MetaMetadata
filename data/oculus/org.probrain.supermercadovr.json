t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRux0rjxPmcC7jfoKWRJfFsr84kZZ9b0zVv_rChwp78Q&oe=6ADE16AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5De5RBEDEYQ7kNvwHs2T7a&_nc_oc=AdqJocifKK3drhH3z32gV4aR5j3h4jQlUjgAvmevY8-A7Ohqsv_BZ2TZp4sW33s1s4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRt-g4SLAfaeX6VIjgOgH1oaa-gvutlZnQYSgtYIydvA&oe=6ADDF853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRmZEnoWbecQ7kNvwFieEtR&_nc_oc=AdoZxNm7cBw6vkl2nE02c2blyoBgUee1NDAKmA6PVoCJpLUklp36lT6pW6i3RJBTRXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNobSq2fxbiUfjevHFY7hJmAf4KdG2LJXOKbxXRpeXJKw&oe=6ADDF8FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P5t86vIw1gQ7kNvwE6o8We&_nc_oc=AdorQSrZW6zXaoqkitgZvbN_uwWR0jZJIEBzpGoDYVh0IZ8MAaSx9pfiZLZB-cJoTMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNleN-1_xZPMlCmoQ5jIabib6FDeWr-lsvu5TAm76Y9g&oe=6ADDFB4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-eoMoZ2-nUQ7kNvwGrpojS&_nc_oc=AdreOSG-JdKdkbIiHMyWCzpfmXJONidUmDnuQp14vkED-gWnf2ciHYoHJtaPw7dt4gc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0joi2owTr7SUo3OTP4Z5zhGEXtcN1pCmSqZOHJmL8rg&oe=6ADE047D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD9BEKUIrcIQ7kNvwFdgQvb&_nc_oc=AdpO6Jsek5n6UaAp76oRuuMxK5SLDkCeL8kFrE2LeVTQb_bqVQHxNR_D9pFvqvQSavg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3KytgEWcSf0J0lqvMF64W2XVtuYsbWXqYr7Oarc_C7g&oe=6ADE22C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq5MJ43kWXMQ7kNvwErU762&_nc_oc=AdrKk11Y3EhP4tcBQ7s7wpetNwF52Kv1Hw7cu0VHA-YivJAHk4csEKgSGkYKQ5_GKW
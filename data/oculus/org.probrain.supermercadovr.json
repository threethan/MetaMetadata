t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNajTuWWOJD1QMZeVdQ_iZVkAFNjQEIylbIw_wHjMHraw&oe=6AC3B8AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnHSBBTOM0gQ7kNvwFVq_w8&_nc_oc=AdqUgjRQArBfVXcTO2U6EYPYqMDDYk42i1PULlitLJktRC3706KF49iulEyQ-JaOJlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWyclKAo3lEQ-HYHrU_Gkt6z8H0LVvTY2tpqNcbf0_cA&oe=6AC3D293"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4jnNjry6ScQ7kNvwEtklZh&_nc_oc=AdqhtAwqd8ZSWDOjUzRxS7kt2QxLx4CVxZB-w3jd12sOtcaDuyfEBAQIKiEPWfur4hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwUyF7yd6PTNEvJYglQ1txHypYZQ-v2VCoRrU0SsFlgg&oe=6AC3D33E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkIPGOqwY78Q7kNvwF5RdWb&_nc_oc=AdqjR1x5BqhDIueadU77YMEJwyEJqZojKhK7IJFDd6WcN_Xyyo-ouvMK1zcWtEfUOlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9_SGmSq4pc88lGRsyNvqN6W1pkyMa8jy1klG6aXLRLA&oe=6AC3D58C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYYMagjxahkQ7kNvwFJh9sD&_nc_oc=Adr5DElOn6GYv-BzrTvCTmNXRwiLIxZbiYG5NPSluLQgO2JPt5b-YM28rv5Ov4RNuxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAttmNANLxndbTzRba2lIOGEfD4Q4loAmcb94eChOAdA&oe=6AC3A67D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7ym1WcD04Q7kNvwHJW5m-&_nc_oc=Adr5cVXsWN3_axibLP6skLt9eymANvKbAslYiTE8U6OjvzXps4rPKXwHzua5suPUaHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhb1co9anKiYw4l9_j4ANx4Osbu3OrRamte2b1PVMYCg&oe=6AC3C4C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFccHqGfKSUQ7kNvwFtwKOp&_nc_oc=AdqmYUpnvfE4T5vdnE-jVPpD1VGy7BgTB9bTecViQEe8OI4lCovqRSVy5jWd9UWEhK
t-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87bs0BXbCYyESFpRwwXASivbYOR79WM1o2MB32JSZDxA&oe=6A21902C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0paw_gQljf4Q7kNvwHlC9Lf&_nc_oc=Adrlpq8UfLJ0IhudxOtoPGo9_JPY80KgZGHkbHjZ1K7BBdl6l8Njl33qnC1XL9sNU4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iizgzEylr7w-_mM8gHzxyW3F-gXVn9oQw_ukKEzFNVw&oe=6A2171D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ttje7Y_waMQ7kNvwGuVRTX&_nc_oc=Adqa9ZOsdP4KnfBlFW8PN7nW_mxzwbXwRz8-dyQMaXBzkW-09MBzYFss-qQmSVZCUwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vu27yfQO9fErdK1nPCHe9aJ3JNJontH6mBgC07yQxmQ&oe=6A21727E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aos15L2GL8wQ7kNvwEoMTsq&_nc_oc=Adom9liYe5g5SYrNtIOIwO7T-CagIFh1mjHNO5iHcjLDcbRI3-oBfniu-oweKr-IcgU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AQfLLe8Yb9Q79g5kEhX_RJlwR51CCk4E6y-vxf_rkFg&oe=6A2174CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJQ3MjHWlH8Q7kNvwFCOqNU&_nc_oc=AdoukXwia8r_tx0MqbBOKrATHKiAqyRplLMcFOeSNBafmFTLFQhvsgtedddCiuALbXM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CWHnbKDOQLCRmDsCKDOS5n92gL7XMDHMAjTsH4hZCwg&oe=6A217DFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srgZL_k6BIoQ7kNvwGSNhE0&_nc_oc=AdrX2IwQNdU2s894TmeBhcMC5QvRnVfoANtYz0OnFX9JA6Tw10oER95qFUM1W9NBJv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iKcPGpqAh7hgQCN9S7ApbNd3SKhe-EeP_deyxnIIoMA&oe=6A219C49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o38uBd6Df_EQ7kNvwGR1ESY&_nc_oc=AdoNKnFmzZH0vpwxGJxzTPOUF0aG592SjbGXa2Meu98OriZAeiRdAqkTjnzU4YT0_2
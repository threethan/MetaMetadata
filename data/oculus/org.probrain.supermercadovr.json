t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16LhlGqD7jdlRn7SVQB8O5PjyUBdkIogDaVRerFNrQGw&oe=69EA312C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVdHN-6b9I4Q7kNvwHFVkzD&_nc_oc=Adq1d_KbMtlWSY4D7dfzY8Ew4CiXU2lyDzUr1-tnL-8203dHmL-5rVcQEFbSaRFUH4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OlibqFeQYNUjLi9B8oonoaFvR2VhzPCcPygj2hHgFFA&oe=69EA12D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXaxqtqkTsMQ7kNvwHGP_OY&_nc_oc=Adpnv6jcLHvdmWHMDB94VE3CtbfY8AJLlGYkbozckwTJmr4zY9X_xARJudQhtyeIV-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e1CkvI3p-ugrT54fMl-ScniSqMQCrZId1_8HqPO9hIg&oe=69EA137E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBNu_ag38mEQ7kNvwH4AaKz&_nc_oc=AdqWwqvKjr-Vh3WMLmf5Vh0aZT2oXzNcjVKazIkQN746TOKVOkQhcZWhGg9YwAK0pxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sN8Eo3NZFFYfiC0fVwq_sU8dCxCzwB4HSnLtzWM0Eog&oe=69EA15CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJV6jx2kbG8Q7kNvwGJ_4Qc&_nc_oc=AdoWBosgyn5HymrODECc3Jzc1xyK2Lz9LM-LO3VBD9CGzh266D6YHvM7tkk0OHs5H5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k8oOuR2J4s19fgxqZJ5gmGbDBeItOmFeFVAXnc5exRg&oe=69EA1EFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpEq1oStO6MQ7kNvwEUCjHD&_nc_oc=AdqROcpeyGl0i6esTJAdEnf-UKHDWnQEnTT4BDsweLWWDDbBxTgAl7-mNF37OPFCvr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jQkL3JcO8vD-UJOOxaPEDQlaNHhJkPrg7I6ui4ZCYKQ&oe=69EA0509"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QVyYMRLyPcQ7kNvwGUt4qA&_nc_oc=AdrOm79Lkl5RHMz51YIpPIHRRM6xCKvoeeFxR-3tKcuxSD1CA90luAS382EV99N1-s
t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmFz88IXvBZofpsX3Qj49XtHE-hXfC_XQQ6I8h5gXTLQ&oe=6A5A40AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmV-twGylfwQ7kNvwGUxKmM&_nc_oc=AdoyKlyAtqzav6uC9huIgG9HFB0aApXYtNWM1rdZQX-cdvjhUrNs2WMD0AY20CjXS94&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWLz4oX14lf18OcSaRRkzZ_cvifDb2hg76-X9BRHXeZw&oe=6A5A2253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7K9qvjS7r0Q7kNvwHEsMXO&_nc_oc=AdpUigchUJxZe-fXAIcHzCIvFEtnsNPuZ31E6CtudAqPErdlWjdbLLzqGsuYAO6GkqI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZnKnXn34K5v1F5Tt80pRdaVYPNJSmd46LWecmZr3YMQ&oe=6A5A22FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR2ZqwI0dSEQ7kNvwEcg9Cg&_nc_oc=AdoJKeoWlDCjk0TSYp8H2S4CJa5tVp4Nop8ffJoT9Ns_80R-5R3SCU8br-qxptYyX2k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVtu0jzO3SsRdkKAq9PlVWMpo4JeElU65vuoHq3yH5ow&oe=6A5A254C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-xbVu5CUL0Q7kNvwH3KzbG&_nc_oc=Ado_dQX5g3g_MxSgS6fIMDKkF5dyb2BqKZGx_81Q3WxMd0nertGBaAsPrEMEBZGwfqU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN-k4TOs6Ob6LdG63ceApnx0zYrLQZ-53Veaej1AzMuw&oe=6A5A2E7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkIpB-fEF4EQ7kNvwEuI8mn&_nc_oc=Adp4fqF-lblUNXCAmt8Zty4zjVkgRr7IFCNup-P7Q0zbaAdXC8dKye6lGCpDfrPI4LQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBodfazyRo1qQ7gZMLkATHiLYobRjwIMP7EK293un6IA&oe=6A5A1489"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68XJMdHFVaMQ7kNvwG19lOv&_nc_oc=AdoWfNl4waz9S4PSxPrheG5OkmmhB0OyBIPRQkM0L8Jmk5VzK2UEpIFT6iNcDHA0sA
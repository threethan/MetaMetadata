t-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMEVXjteeR4izN_Z6D8mUKdfWwBwciIOwCwm8Dnd4-Jg&oe=69CA8D2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kjYSgMgKVEQ7kNvwGSmKqz&_nc_oc=AdobfNpRojpkMUrOo-4yUqCESzC579FfY-z6oKSd7I7_42_GjFuM3YdSmrcXtVslWFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCi_N1YlzvdUd_9RcaUMpKKBh5zalcQvnluQPWJIzDpg&oe=69CA6ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWZiUphHr0cQ7kNvwFxtHpS&_nc_oc=AdpMDSaoLLyoCnOpQggHIN2ta3opPUVUIDtSdsow33HTfnHaJ_Iwd5R-zUK7ztsT81Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzkd_gYthi1WYzo4aeqK1ba8bHEeXz9N58AH5Mev-pnYQ&oe=69CA6F7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kflcomvRNPEQ7kNvwFMrtC6&_nc_oc=AdoIyVH0a7Bz1HwfjB43kTgFTsTb3vtE3-el0Uv2McWXojCNV5rgPs_v1UoN3koJIDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydLSrYWQvzKiV7RbSOgrqmeMKEOWw3NVAqfCBng-uAYQ&oe=69CA71CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELwgZEmpE0Q7kNvwHGqTiB&_nc_oc=AdrYX2Y-pW2e5bBZNnztods3v2SBeNFXqoyvevKxq0Bf34nRkebyjYhrj97YBsRJCJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwBXkLdjfd_8P-MkENWle1BOK4x0pwTbuQKogZBpUFSg&oe=69CA7AFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqPR1uwVfU0Q7kNvwFEkj3L&_nc_oc=AdoRC41oALDBcWZZ9ymYYxR3ZFNG1PGF7UHpnxCPrx7bGs_AAap7ZpH1e1jcnP23xHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx79AvUdDpYrGAm6xlmHUwUtQgiYv3MD2TpvFFhs_N5jg&oe=69CA6109"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF9RG4ZSF6wQ7kNvwEjbbm2&_nc_oc=Adr0DWxKaYlgkzrEjBsYNELAyO5kzu64-xlmoSNYivC6NwBJYYYyxWjv139ON_jJr4
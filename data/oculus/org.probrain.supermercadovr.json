t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8xsk7FWzaL3snzewUPUc-uCGLPx24ht8HuR18eNagmg&oe=6A37F9AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1RD48beDN8Q7kNvwFIzRh2&_nc_oc=AdqNnPZmhIAQ2OU2MxtPxX6Zz3SET0iUZjTRt7fKXW1UV6LvTqFl4-tK3cYyVX1fpRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ylbKeTcByKI9Flp0YXN-8bck-4ocb-UeKNTAl4V-hGg&oe=6A381393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDmO7jL2wNEQ7kNvwEunWgk&_nc_oc=AdrxHxMpvOo34cNEjV_xqtJ9yCxrFvIw3H4WEhBzLRLdf5uhUvcX3IFjpr3a49o6sDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tgHHxUkX7WwjPktSGMPfQjAwNCxarg1KuD6WRsb_Cfg&oe=6A38143E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3UZwfYe21oQ7kNvwEeF-Dd&_nc_oc=AdpRwRMXfc6kmfsaHUogbQwicsoSLOR48p2CIiadMrSUrkegBqaJInT77gu8GtRsU5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H1-WYrtaEhrdtK-hUzWAK3dw4ruetc3lrWT0nc10AvA&oe=6A38168C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yMNFwgXSacQ7kNvwFQ1G6t&_nc_oc=AdpWgKwqqBj1Zk4wqQZ1rtwoHaVPPvuCdIt9iwAUEfjRVOk1O0uxMs99XIxu-9Rfndw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sTtWeN-U-ZMn_CG3G5D0ch7CWpAqKSXYwRKRXlWupLQ&oe=6A37E77D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY8Goz7kCfIQ7kNvwEa0azA&_nc_oc=AdpPBanwrvpSIRlh3cpyepazTPPCqhFwDrCsPAVJCrjYiqD3TOG8ObJTbXBsLeD3g1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WFWMzyan92ZmqFowfgADbcyhffVBTE8e2FxRnhetNRA&oe=6A3805C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quZOj_Ea4CwQ7kNvwECf93D&_nc_oc=AdqruYcKnxroK6uor8TyuDmzmxlBBiRYXcREBxtEwTc1yf84utSVGJ1pxkEa8hTvpO
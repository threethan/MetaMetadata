t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nesx1y16e_cLXMiDOedie-N7IMqktNNh0spmc0Rz7CA&oe=69F60EAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6AogVasZ1MQ7kNvwHP9e7x&_nc_oc=AdqW-wrhwUooV1rG8gfAo5lrUx23pPXy4rwctNYX0jNwiAYNxQgZ5V276ow9ffQ63-U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BtqmGBJneH3CraYcBZ2HaZV4g7Ozp0xwPKK-NbeGpDA&oe=69F5F053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx2nrKyWHk0Q7kNvwF3yiDF&_nc_oc=AdonBD61VNYefBW0ZGk-3iG0QSWWQ-PVbUXKvOlYeNsAQ4tChGZ2Xe5T4muIqEOSA8s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02wJMYKc8rC0-lFwF-ZBx-JYfL7tOgbVGDhCe_2XGRBQ&oe=69F5F0FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rr7sTGamJQQ7kNvwEgsQuv&_nc_oc=AdoB_hXRLRTUADDoiJoMFLwb8BnmvSwGGlyZ4EIIB0Zy5tl6D-Mzn4nEfgEfc-NomBU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1h7ytkbpu2h8yeGi-maFh1-1Sh5diwNvGDBiCo5E_Ohg&oe=69F5F34C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK8gbdotW0gQ7kNvwFFkJ5q&_nc_oc=AdpUWPy_MJRhY_8VIc6WXkMxEStfW6eZmG6tXcA5BjnAcwvlkDTR7rw3tVJcNN8ds98&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32MJqN5S3g9l91ABsxWVWQKwDmfNOrz_XYn1qPPRtQKQ&oe=69F5FC7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehgcVLL3kKEQ7kNvwGNqB_M&_nc_oc=AdrnRXjNUPBIdl8Ugnzb4zuAEJ_0Udgl8LljpS_cnPUk7PABMHFrBDT2TMj1SUP71sw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05XAHYzaDVx324B7OjYKlWeUQQp03nNidvLaIg2bwiFg&oe=69F5E289"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYo-XxvonqwQ7kNvwFoQM7C&_nc_oc=AdolXQiStM47Edj8cr2-XJhDUgOB4dF5hIMnhjEV18p56KZe3QkCTY7iOmvWK__0NU
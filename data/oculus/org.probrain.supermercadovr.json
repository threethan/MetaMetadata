t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR_Cmxg5hPDa1m9QCZimUNLW1X7QZOYVUFfjBN90O1Eg&oe=6AF8ACEC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmk4fY87_G4Q7kNvwH_Ky_e&_nc_oc=Adrk_BxmVyzOXpI7MmSsPuZA0uoNaZl9903LQ_nRBRtv69wc58HmhS8V8HhMhjErfvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZq2MSo1Y2uTuo9SSIxINEgySdlwhraGXODb5YnmlAwg&oe=6AF88E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKgfewXtL04Q7kNvwGxQret&_nc_oc=AdpAwKoY6ts-k3QEckzhuM1dMc6U1H8cppA6WbQCZq_6cngf2i1OVrTGBvx_nJNgqZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWLBz_Zz4wssYB4RxybkstKU4AB6R7B1ZDrBYu65IM8g&oe=6AF88F3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNfS5oE8yG0Q7kNvwFutrVN&_nc_oc=AdpHiMW_lbfaB3Cb67d2j6GkIo0WsWtexJtDZnhfINBBsc2eJqfeX5Qd-VmpNTi-G-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZshagNCEwb8BTuhEozfKS5mpOUZ6VjKXNRh7g0IeawQ&oe=6AF8918C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdZddFKpoTYQ7kNvwGiyi9-&_nc_oc=AdpCLIjQa4FurclxTNRmmroejP8fg1if2rJnFSr9GaLuxBmIo26eOAXys3XMILqDL9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx0IAdJEh9VVnUqQjF621cG6PZJv_vyoE_jkp4NOjeEw&oe=6AF89ABD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iun9pnNxbV0Q7kNvwGHquHF&_nc_oc=AdoK1Q7OzMb9WmAioumMj7b2f0QSChdgQePmEvuHxmw3cmAXJGRN1icE7fgn0ZGN2wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ZpATjw3nMeRqjJfgIHZrwpzfQurjl3T3dUcj56Y0ng&oe=6AF880C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jejI6LityO8Q7kNvwGc245D&_nc_oc=AdqWU49E9lg7CC6bjs0i5c1tyufI3Y2KWrtBRwIK9Y2yCkdL542y1R7GNd_2GOvQKL
t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDGUkuYFezaQWDYMlPrCVZW4kOmgNUGfEtd6WerqG6sQ&oe=6A5F86AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwjt9s1EecIQ7kNvwFaXWMF&_nc_oc=AdqiA4JmUQNxXL9fI6cfV1lGCtMvb7JSYm8ILiDyH-mohpi_EE05qpg0UUXAp8fggD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3B1fS50g190F2xRGda-8tog7IKnGTIi4eUAF01NpJ-g&oe=6A5F6853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCeTbzEnD30Q7kNvwEMhmHj&_nc_oc=AdqSs36knbTnv-sm4M9a1ilAHWg8tEdA98PlunZCtFF-_HBQLryFSlYUMbmchNIuQJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBorsxBcut3akSKyBXdT9aVpN3-FP71tEly-uaEMqBckQ&oe=6A5F68FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkvOzRjTAhMQ7kNvwFFQr_P&_nc_oc=AdonI-5x1UuSoANjPe6SG3SgpXrrCJM6EDCMeK0SDH0iWRvzuunUoHmjX7UWladR0DY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXGvaTndI_XwZSuRX4LxATdtE6a_IxrvnHasixk8CORA&oe=6A5F6B4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CLx4nVUdQ4Q7kNvwHWetag&_nc_oc=AdoDlqoXRbDfb4uWPjVKxgXH765JLH4V6loL9gfGaNm-i7xpAkACVh4uOUsFwt43JJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fSSmxTAOXJFID2ympDCV4Z8T1hxacjj5osfQoJ_xtw&oe=6A5F747D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBlz4TrswXgQ7kNvwHP55yM&_nc_oc=AdpnhE8kUGDphVDxHWXZPY4ZdJeBQMgIsJV29dkOpPhtzrM2iyeMUHlDmq7KhcYCdKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmSUdiRBK1ldi6vFVQEapu09_Tapb2I90fGHLT6wTSug&oe=6A5F5A89"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m4okIWJ4joQ7kNvwEIPc5A&_nc_oc=AdqKQpuqumUsENEHmyUnCm-QLYXMKwk3jl7zRcaHVKabT7jAtStJA7iOg91vATdFLA
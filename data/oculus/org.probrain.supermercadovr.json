t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr7jKU-6RZqSZRig0Y4s7-utsclFU1h712n2SXMGPejA&oe=6A8043EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6ip1pns1LAQ7kNvwGAJScq&_nc_oc=Adp-ugf7w_6tAyZJ_cFrQkFjUrLOpIE5aSZgZYYAKI9MTE85DGB8YRscnpiHZ5EbVCs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6nApGMrx4YidytRzH_ywvx56vLhh3W3RUP-vvW79fDg&oe=6A805DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF3eKAvF1BIQ7kNvwEpFRDZ&_nc_oc=Adpm1-AXHmd4SUda_7VoyFcvsLgpoQXFEiDMCqD-k6nMuLgYAw-HuWsGRxvsXOVnwWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH462b-sA1ienI2d0JKxPFxxyHLSdoHXOloaDfg7zjr0A&oe=6A805E7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNxe-7FBvPAQ7kNvwHlWkGQ&_nc_oc=Adopw0nmUg1v2hotTXwEqwbhlv-z8zpNr9eis8QK83qYebCHi5FR-buv68aiZ9EIW_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjl4dQ7rlMaOQOH8obof8GMl9bdNNARSwhODQvx_oGiQ&oe=6A8060CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY0v_K2cdroQ7kNvwGwcV9_&_nc_oc=AdrOPRUusStuHkydjUrl0fHIqsS_jLu1NideQ6dCCztbNbnb9HBwp6HUEwKXYYWZurE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX42dtewWE1Vwv5Sy1NWw1fSN9AIiGgAMyYtXSDl9RWw&oe=6A8069FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sm1xpbOicYQ7kNvwGe-sRU&_nc_oc=Ado3kpXsekEB7B4b6n1BBLAlO8KIORv_F5hbJHpXkey-8X5dQdplQYPjJ0XxA-2u7DE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEznMYWswlLnP07N4dHk5VOOs67tDLQ8kZCBisjdVrdUA&oe=6A805009"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTm9hdjRfM4Q7kNvwG9YD2f&_nc_oc=AdpOPjuUAegdpaKE_9Xc-XE2CXQi7W-Nda9fVODFCi6zcRmdiHvX0oNIlonNS-rLME
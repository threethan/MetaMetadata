t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rX-h7mNruk50WJKUNoUZtw48Oc4EfP3kLDT-SnK3zxg&oe=6A203EAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0paw_gQljf4Q7kNvwHaLvrS&_nc_oc=Adp7LBbZWv4TQit4KBOWm85sacpApICvEf_DBfrfgdapKWO9IFz0yPjE7M8E2jGWgPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dYi_dZ3QrOZghT6peGVhDnBvtrdsw6WkoWzYyyQ1qwA&oe=6A202053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ttje7Y_waMQ7kNvwHlH6wr&_nc_oc=Ado-q8Eju5nHOnAffgqgb7isOXUncJNrB5yP7eG8RtrVp1XcXah3YVnzRuu44ewulkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MxHtOlN_jLdnfyAmgn56oQd9uJt71L-q4CgcnwGxItQ&oe=6A2020FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aos15L2GL8wQ7kNvwHV_IyP&_nc_oc=AdqSYbLRx6xwPW8ukWRNleybMNmXliGdSII1Syghemyqkyc5keiWiocfnA_AYdTpe4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lncs0LN01pYHPWcjfrjY4Vdd7o8iAaQdVXypkF5v7nw&oe=6A20234C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJQ3MjHWlH8Q7kNvwE8ybA5&_nc_oc=AdrgPdm3NnuyezRZSvUURuSFZPQOHlOLILzK1lka6kbhQsYoFTfZKeNwdjHbMcoV-L0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-LxN4iyCunlafFEroa1pFElDjGyu_Q9YSrJybu4T_Og&oe=6A202C7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XHCSkMiaZYQ7kNvwE3Nav-&_nc_oc=Adpio6UtiPjqZ3sxBn8avug_M4BbRwc3PA3PAvcyeTCxzQi0N-Pzz-GjqnVA9dQx8P8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w2PzgN16CFzbHelgxLmXG6jpoks20hTmGW2BtZ3Fc0w&oe=6A204AC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj2SyrZN39oQ7kNvwHodHzp&_nc_oc=Adr10M7pphpUtmvRQnyI1a0aD-F-ZbeBdSbgAbWJClN22Z28V7TZIb8c0_x7jj9-FB
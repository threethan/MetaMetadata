t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpY2_YGgKt_AQacpZTWcf7dFBrWjUezdHG9fl8ODIDbA&oe=6AA5662C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLIZxtosuP4Q7kNvwGDreiq&_nc_oc=Adp0PoHMZPp1lFJKbaSDhB-gWEXN_HV1v0PcCOJlr6LMClCJoXRfrO4L_dhKyqLjgXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPo4z-Da-y5PmLdsNfeouDn1GSpZc9hRXXYcCJndjoHw&oe=6AA547D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3SuBxePFesQ7kNvwHsPcc7&_nc_oc=AdqB_lzTG7PHJyfsUiDuFd4P7bfvdSaQGivzDGwaR6G1pKftSaQo-5U8-_sBbXVvtRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuSf_YKz-MGtVpfcBNqKOuqbl_oQSTyqIvMTLqvX6KxA&oe=6AA5487E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwARykDUilMQ7kNvwFgSHmT&_nc_oc=AdoTfhdYJl7VoDPIbJbvtVQqFD7fjrDmAcLBEFLXyIs_x81wLzH7TTSPsgbOCux-XLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgWfNE2hA952hQGKpnzAHuFkA-EiFVDQu6UY-XHyxhYg&oe=6AA54ACC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWtP_-0tc8wQ7kNvwHMVjn8&_nc_oc=AdpC_y0W25xoZy-szT0lohq0cHoHljBYps76beC3ylXhJ8X3_IAa4Lajm0n7QiiWAlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMuQOb8T0B6EUIv2eueR7LGgQeaZ3o2WJR3QTgzudM-g&oe=6AA553FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN7kRIbipxEQ7kNvwF9zZ-9&_nc_oc=AdoaWNBImAvWJdpCkQZsVVZEJNxcHNzChMNgn6dgyDOH1H7f0t5o2DobBd62eJQi-Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrVVHtPeL7Ezj9p-4BrjfVs9rqnaz0dUR4ndWiVBL0Lw&oe=6AA57249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3iJfy3n7IMQ7kNvwEHDOmg&_nc_oc=AdruwF582qEVRKizAkXHh-7V_TSOHCWCs5l3u3Y4usMbT2xnQSB0QkBCeC9hr1_Lxw
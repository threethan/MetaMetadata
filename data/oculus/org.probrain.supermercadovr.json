t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDeqCXEh1-ifto2sE6ALS3BbgTCzkUKO6s7T2N3_PwIA&oe=6A4FB4AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waP4teRw-n8Q7kNvwF61cqQ&_nc_oc=AdoHVx2w23tUS8GLnnr1Wm-PN077lrFRTT3Vuss3B07N-E2mg5rbMYsHXS9KdFHDdDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuGHVmx8XeKz7qQPsGT129zmyOcrygorEi5nGt8r4BtQ&oe=6A4F9653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaIcCcO39ywQ7kNvwF8Ry3Q&_nc_oc=Adpn8wTbP8Db_2LvdZCFqKfD49CitRL51et-bmlvn17VueWd2w38fzSUpXCDTi5EISA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAheq4l4oOiotCHEv6PtCu_wSaBFv9q7PD6XzZs--41mA&oe=6A4F96FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG10wD9yu2YQ7kNvwGRoJUG&_nc_oc=AdrzlQ2uUFicdGVAghs9YkCM_LzlSTPrrFQrrjDSw3DuU75bEUHDX7HBEKeQKeudC_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG0OVstjHeDts4lqXXaAvM1tnFCTNkVBRGAczCItQGLw&oe=6A4F994C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thA83TQrYIAQ7kNvwEB8QxJ&_nc_oc=AdrmgzVrJ9tJdR9d8UwseaA7Pxz4-aabAhNeO90A1CWGFh5hnKqzX02TFKlw7nAx6H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNic0gzUP0czLaXlfTdplpwtw8xYisQ98vJaKIL8j63A&oe=6A4FA27D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrRhGLAY5lUQ7kNvwHrACR9&_nc_oc=AdpBIgSCHpO-SiUDJht96htf96pson-4ejfW-4zbL84RtSnq7c4W35Kb2NTuS4eOxjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyfpWAZtIjMYYB7BcQ4Rauj1IOgRTsBycCrWU9ZocR-A&oe=6A4FC0C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bomd4q8378Q7kNvwEALrf7&_nc_oc=AdoO1igjTEwaD5iup3UEVRQgdF_U4csmqOg4LRjNh0XRTCNwr7L0kDa5m_VH98So6J
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rrUYetFMRf4Zk8LY_6QNlKwDV2uv4ly0HnYtYYhuy_Q&oe=6A2584AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNvI7OpkV24Q7kNvwGYU3zQ&_nc_oc=Adp09wUXsjfKxQMxTTPcHRHCJT6tNnMz8gNmmbt8h5yRL3buLbN1560gcwLpTNiLITU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fq1CpJD5kp-a4o6h31DH7uoWVvG7ddf1K4jWCuIKfdA&oe=6A259E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnlBsbMwx4MQ7kNvwGUBkbE&_nc_oc=AdqTsTKIsctEVLeFgAbg9x7aY1WzVpmhDF0y5PRfJlPr00TZWQn5iUAdiymhRaStbQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CEp6FIfLkP3ArG0Oz3oHAWlaOmvLUJ7DQFJmci1hvBg&oe=6A259F3E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGRghC-9ogkQ7kNvwF0cGAT&_nc_oc=Adp12nM_-hiNKXbHnxskZpzZnsT2OGWhJXbTCCnM2dqS3W3ylFR6Xa7PD-vR3sq7NoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PCbjUX0LOfhUTvA5PUbtrW0pa29CMLqng8JLK69sB0Q&oe=6A25A18C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeozlhIDigcQ7kNvwH-RIrT&_nc_oc=AdqZZAVjeI0GYh_YJdAud8br8dhr_FZhrpBavrkpJk75CS5LZV1EVPzvYOWTqioT828&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VdmDtHZ7wdhi3p0tGdXIQ7JV_Usxf2MkN8WmUQZcTaA&oe=6A25727D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGEuILjFiL8Q7kNvwEzc7_N&_nc_oc=Adpo6vAi1HRPL8ArXphhiztruhxLHtB1j4vkQ3YgG5pWAUORE1A5kijDAQZdLFpTpcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JIG-g-S6NrZ7Ca9Lc-IpfOMDrR-B8IDwcuypDeA1WRQ&oe=6A2590C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbDGVeCazE0Q7kNvwHav3Jh&_nc_oc=Adov0hhwBshY6g4i2Dzf8AVPvjECJZufANRv0GUPczvij95_Kaq3iYLkSKUgFBsZNq
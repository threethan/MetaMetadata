t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMemlnXtoWtIi1_AF8dN3Pqk5XMVhjCn7u-zvcrahJhIg&oe=6AE20B2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkehAoITih8Q7kNvwGCoB0y&_nc_oc=AdogFsfOsRkG_IVEMUAxfJIJ0UpXnf-oDuEsHlL2aBHWwbYB9lCMejitqH9-UzkoF_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg2Zwh7-_jFMoihQzD_rAXJt-ip6N1Ft4aGnyZFHnibQ&oe=6AE1ECD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seL8y1x2IIUQ7kNvwGlqbrr&_nc_oc=AdrHRfqaMKW5XOThVG23noxY9tLUExp2PLdQ2ZT0u4hVbTBIIWs1DjSGXztUXR6eBfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPECkSDMH_6x-MHBh-IWBEdovVWMSciCLjwQHfMO5I15Q&oe=6AE1ED7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGOTqYPZ4ukQ7kNvwHzicga&_nc_oc=AdocfkaTh7HeGOU2vEq1DnB1ectrTnj-KJka77OkQvsu64NC2ZPMgW8jpdGabljYmk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxm6-NPS8ymp6gdDau3IrCOWmrwEVkR8g5CuwMHH9VSw&oe=6AE1EFCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqRKVLo84zkQ7kNvwF1_BuD&_nc_oc=Adq2bgEsGi-6uduN-3guFIEirUbFWKk6SZk9HW4fbtMiFmVHLwLxmHdyrBvIwE83cls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM1k4jx75w0Mhbiz4MBajaepesLS6oXeb0_3ldW5la8g&oe=6AE1F8FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoAmOmC15XUQ7kNvwEGEpDv&_nc_oc=AdqVoqdA2KfMyiTnSWw3pk6XcM7f6Kblip5Fg8MXWvzsag27Ji8ayqP_YblqZCoFr_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvfBW4M-E26F0o7tgyBgleB_SIjUejnpe4-Y-8BKGaXw&oe=6AE21749"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxdYdr171pwQ7kNvwFUKtHg&_nc_oc=Adr0RiHXJVIb8aoSYu7CM7yPS6HBQG4Y0Rh7IGMG3GV_os9W9CcJdmH19DUTCHnh5p
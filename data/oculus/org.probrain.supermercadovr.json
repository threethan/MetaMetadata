t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2neFb_5Bxs3_LR5-hcI-tMsH0CYHbmbxiI9dovMMos8Q&oe=69F8B1AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rm9_UyKttcQ7kNvwHeJEUo&_nc_oc=Adpb6QPcOdKnNTBSzP_AgtfrC8s_qZBEvInQd_I0t2VuvQsnk8OMa1fmyziU7Fz-nFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lw2kUTS6LFC6sfwiHlbPoJtYnyfrP0-2i9De_J7TPJQ&oe=69F89353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF5Wf2OZDUgQ7kNvwFqMxJj&_nc_oc=AdqwrkIjo15UFde4CmrVEU5WEO9DD2BTGb4ATThFONjrenlhR871KBMQfTnWROp4x5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12eXEre0hMwOnErLfTysMM-tIrJikr04U7VIGoUbyhow&oe=69F893FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18U_b1BIWgQ7kNvwEJvfni&_nc_oc=AdrzeLy04LXiTcmJq8G1Wqohb0iOZqQyxBBD7X3r5Fdcesgwdq7aFn5If2liG3AAQWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ExuO9hHinqqILvQvU0JR60mPLyB9KS3J-PU7YFeFInQ&oe=69F8964C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9zR1m5pBzkQ7kNvwFp0iXL&_nc_oc=Ado6FLHdckEb9S3i1RD7ZzOWyxamow61xJXTJlmbdCtn5vUNVSN5z6AwQgGy3O-6mvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JE_ZWY9Xsq-m_5Xn5WeNkkPLp3rTVUs0IYi0bqeqpnw&oe=69F89F7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehgcVLL3kKEQ7kNvwFxNcq2&_nc_oc=AdqRLa5qY20Jg1tRJbdey_A3Gab2WnzL2D-ypjKAWRka89j3SiS41suF2jvhaJjEcDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14iDPfX4fKpPemnLe7O4smMOmr-aszHwFZjxkRZ-e4zQ&oe=69F8BDC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYo-XxvonqwQ7kNvwGY5BbS&_nc_oc=AdqJSsC1Z9Qalr8a2yFAjrF1V9UL7lURmsYyYzpblajtSK2UYt4vaxjDJ2bi8d6tNb
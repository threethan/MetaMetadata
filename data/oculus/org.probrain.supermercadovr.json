t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hgCWnQ6vTeeMqCU1N19u-kZX8G0Jfh6EGE5JcCVeVyQ&oe=6A19A72C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LSkdpk5EtYQ7kNvwHo-uoI&_nc_oc=Adr5BbrIAholldUtdX7g98jdgVpZeLaTh5Yt6VnIUrbNDZBZfvmqwBrMDXrUpNDsZq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-pGrb8IAvKyWKZxCF2XpKFI0WMD7VWXPbsyw2FP4AUA&oe=6A19C113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQkcjqhDsdkQ7kNvwG7-289&_nc_oc=Adp2zqLD08Wr2RvVlYSiBcig2tOzVHIe-ar9b5Z_qRrlY1n7_gN8BelOhnEvEM--oE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5raOUVtcqj6y6exkdYlyl59zDilXibd9ooFbQAzdAR7A&oe=6A19897E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZUjxrsYdvsQ7kNvwFAER_8&_nc_oc=Adr5VRbIcUMleLqeBxlZ13ToXa2YmubjaW3oFt6o__K6xSv2rAHo7BPF6qDmIpGTR5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tf-3iWZJCHr6kuSOfI4V8MUoENj2zyYVU0IAKPFxrQw&oe=6A198BCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8sRlqBtN4wQ7kNvwEqZZaF&_nc_oc=Adrthnbt3OthaA-jwdkYaJFjekL5X9cGre048ypVXWiMDj5p4_KREfdI5FctXhewLaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TQm4SKwFt40_2j8E28sRnJ6gMVKIGoofZJu47hw73Gg&oe=6A1994FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMQiIrmzIVcQ7kNvwGaZv7G&_nc_oc=AdqRSguRCqlksDTt6TqF-YxCMdvUaErBmIOjj4f2eLwKUgV6mu9K3ZvVhlcv7CPynQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EyN3DurQq5-7U3-zrDlyAAWFg81MmfSN0NE6yIkt4GA&oe=6A19B349"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRLZkSMbUbEQ7kNvwG4fNl-&_nc_oc=Adp2kVwUt1JA8EBTP_d8lu7C71XvajFuHihHtNFpODPsl3AVNFSFnOIyLjBT3VORhK
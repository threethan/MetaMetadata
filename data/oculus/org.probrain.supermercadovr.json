t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClvZiS_wW4to4hvZDPsyZ0oEtFvWFrd-er7DVlRu67Xw&oe=6A6CB5AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is76fiFWrVsQ7kNvwEQaHUR&_nc_oc=Adov9t7WalKJ3DdgGxQnKI7MWxVSqckU6Q9-RpqBw2DvIwctzg2a8cHSpeOFpWqHM0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYdx_H5KHGo37wty3v38K8tr0uU0VRX8CLedcoMAZ4Aw&oe=6A6C9753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFP8xN6No90Q7kNvwEbC-1Y&_nc_oc=Adp42G3Le259SlXNpc3Rb4OirpAYK8BayXbWJKhY6hkIv7w791HMaE4w6SkU39sweYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcZ6uy7YEIXYGt_ZR4HNc4q2jmIwvKKUm7IipUjA7sWA&oe=6A6C97FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alVsT0Wymr0Q7kNvwF9Qo3E&_nc_oc=AdpStZ-2ipEx6VV1RTt8phHkOYMsnZzNPzwyD9DMYGrfzciWQ0KEH1Zy4U5MixHk5sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm2weiRLLjlPL-gbimcSFEJPyFJ8wRNfJB9HN1y5zSjA&oe=6A6C9A4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYEjRLWw29MQ7kNvwHV9aPC&_nc_oc=Ado77VY_9aylXmGxxw3bR-0B5QCvj0UtV9xo45SKiKzJ2sQLQqdM0AK8HytWNbdsKyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoqc7iJNiHg9Mrf8NPlcsTOdgeBWEYde2CRSRtSuIUUg&oe=6A6CA37D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u3T6NqScbsQ7kNvwHSlRm1&_nc_oc=AdqPt4LxOIe5YeZ9fcv3Bg30fBuHATLfxdoiLNi91gkjcCeq60maubXQpV7v0s8o3bk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOptCJjPVK-RoJ02sgjI_bi4_Sj6FDPcZ4l-qJkCcohg&oe=6A6CC1C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fquhqRB4gIEQ7kNvwEbe4D1&_nc_oc=Adq0onmguDeAVcIFwhlq6y9AuWSHJHgP9Dj3pk4JBURm5mYzeMnaU2ZtbgGnzQ3uYd
t-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dImjmvcZJDyPXrG45aq30A6p9EpUMStk_04VP9GAKGA&oe=6A24332C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNvI7OpkV24Q7kNvwGHbuUV&_nc_oc=Adoyw5zOG_3qfLGvRcLuHD_ci1P8nxG-MA8bBCRUWTFBKDIU3zojQk--vr29OGhHKYA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z04T9LbuMla_0jYeTyf0RIUodzJQO3-05EWeJTN72aQ&oe=6A244D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnlBsbMwx4MQ7kNvwHRL-wT&_nc_oc=AdoV35cX2yAaClgnerIZVuqGbzk0YXK7Fe2jCzCDvJJ5KjznI8oP4GTEPhFXMjlC30w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wZxH1UAIjpBtMOSrkiCLgKun6oYQAheET14HycwSypA&oe=6A244DBE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGRghC-9ogkQ7kNvwGnLdJy&_nc_oc=AdqWFKU88vRzWemyoK9mWH9zRF_CC7F9z0EF9c_9fQ6knsD08FWJ5vH2Rz8QOi04s4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I8TuL_LJMLj6GQHdI1uVrxDZDJvOVIwH6_OkDJEcm9A&oe=6A2417CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeozlhIDigcQ7kNvwFYMENi&_nc_oc=Adoq68j5m-pP-KTB8ywPLgGTJlGoXZpLP-MN03P0-LYvhhrcGvoCUXHnDV9ABkgKAiY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Clx6Fu85V_QHJEgPdXGjrd3F-2hvao8e6PBOUMA3uEw&oe=6A2420FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srgZL_k6BIoQ7kNvwGasK46&_nc_oc=AdrZefeLWRB8uqU0i90v5goU29hFgZxLBZHfMHGN3ibM4TZSq3KyVqejgCg5PbhxSZE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FektcLZAztPSA0VxfefnPeaX5Bs85UZi8UZkwrPdXpA&oe=6A243F49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o38uBd6Df_EQ7kNvwGbh7xn&_nc_oc=Adr1cJw3p52UBo9pBK_LB0SCtJGwetszYlaOBMiqLT4aN3p9JAWGypOW-bPkbfwXvg
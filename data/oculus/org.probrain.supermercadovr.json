t-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTO71QiqITJAAN7eWp6BbYDiTFMsI9RGgNkWXMVnowpg&oe=69C3BD6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi8mGnEJZDwQ7kNvwHST3m7&_nc_oc=Adp9Q-zJQzX0sXDCAe21tcCT5EBCTqfWPFVxXeUEVdTZW6EYyp7XSMz4UMxhDdoQJM4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxempuccfhlcNn2vIqPHmZj71SuJNH1bDzZnsuDYTxNUw&oe=69C3D753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl1IPvH5EOkQ7kNvwFbJ4qQ&_nc_oc=AdrvWEN2Ba-cYH40IhqCfNvlSkS16tJ-Yro4GdwhJsCA4tc0mHk0A6mc4eRdjnBxtI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwesQvqe6GWqB1PMyb_EibIECQzPFKiOW6sc4sN48Fqwg&oe=69C3D7FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J16oNdFtztwQ7kNvwEGg8ry&_nc_oc=AdqY8niRPTXSWyNt7tGilnSV7eKVw0NAYLXETXGB7EVijh2uue3fDPUHvV0zrQfTv7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkyojcKZnCHe5m0JUu-nLhIJcNY6Ok012MPw0GJUHHMg&oe=69C3DA4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHVXtFYnRc4Q7kNvwHq87jr&_nc_oc=AdquLiTLtWIHlNZ8GCkq8fuTuekaW2g0nfiK8QGdmRf3NXMcMA6pIMwykZkAYX6cXBU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIB6jMWk5K5dy6BBlmt76DWjrX2gmwMTz8NG_c7o8jGQ&oe=69C3E37D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_9OjJ6cKBMQ7kNvwGOuQff&_nc_oc=AdpjxIpcoFkKAwyLTv9nuJDj1oQCrc2hgL0SYRnVmJjTgW4oiQkYs42trLHSYhQDJvI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdWdHwkTKcYMp5lV_pK-KvoiLwzPRcdWuIP_ntyp2CZA&oe=69C3C989"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWjlcD2lQ0kQ7kNvwFToycs&_nc_oc=Adr0gLCFY6mwLUq7UqKrpTGdWZgH2AUPcxRTeVo0xkvUdWJf0ggSaMJhk5JzETlcIy
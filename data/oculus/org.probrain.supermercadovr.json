t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsx8sR3Tx1B-hOf65zFxq_7CEBoHplSNMtEI21Zc2ijw&oe=6AC50A2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMyTQQ6f3PQQ7kNvwEhU2iy&_nc_oc=AdrbIX-AVOZfbOxT0rYmeS7P0pmDGo2OS529iTO6ljVCdihj55xM-jhMkOYp8MY8TKg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaRZelvDmMx47WHZ2dtfQzAxNrQP8KtFUSHmmsNxUikQ&oe=6AC52413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brpULQbtkp4Q7kNvwF9OtS4&_nc_oc=Ado9bGOPah-ij74K2waI-Tm7QCfKODSIcgBKVTZfGIBXsQagPUWxyixxa5oxn4uHFyI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOen1OKZs35mz9BTzaRhy8I51Rpq4vEVwbZ7ZUUdzy7LQ&oe=6AC524BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzJM6mVs5VUQ7kNvwGBbk6g&_nc_oc=Adrw_EtkCgrkT6gHY7FqOrtCGdrq2rKbQDjhukrKXdamPUyAeAdaZL6nQyMuibF7ThA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjjKL3YZTntGVhc9FBpo5gHG6QbeSVmJ7rrroJQ74GmQ&oe=6AC5270C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYYMagjxahkQ7kNvwE4Goh5&_nc_oc=Ado2xY4QEBMKnNPAL-8gcJUtM0aEc2sQ_SksaaQzB2sabbxEDX4NyJ5bFusNP1wILfM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhWvfJNvxbWkkD5EEi-sS5qih4Md4MGyafCspq4FI6uA&oe=6AC4F7FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7ym1WcD04Q7kNvwGxof5c&_nc_oc=AdoyhuWT4NYUjInkcj3dI3Ww4v-85uveaE8xHaywzKlwXBFTbBqc8-AZ5PPYWm5qahs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYJ7JqCFsJYUNURj3uQH9YeRwPJF7aD4cxUETX4nZPOA&oe=6AC51649"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFccHqGfKSUQ7kNvwF9MLQG&_nc_oc=Adrn3FSBD2ovmWrxNdmODxrmwGjIXQ2JCKEmfveiwVroJS26l4Rb4Y8L5a1XePy6hK
t-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4slDLUyK4RISwvS7jGpvmXQggTisbAlfKYpx1Lsz5Hlw&oe=69FDF7AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlJIjh-9SoQQ7kNvwG7H7Xm&_nc_oc=AdrYakXDspk2OVkRnW2pnU5leW0tR-JwTZd77YHVH9ECoXo8GJUfUHH25rZsHsdb8MY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r5pb3XckomnDYLZ-gpgpWECNblPMtEOv4J1Uz3ZaRCA&oe=69FDD953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa67thG4170Q7kNvwGDvMsX&_nc_oc=Ador3TNdjQBFpQ9CmBOfMgOLvJTc3Du4GzngJbYi05QpVctT754BkExL4-ZHifwBiXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S17kfI7retDur2d6jzKXDqrjjrUJlBEebLeFtUz8a1Q&oe=69FDD9FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKdHEHo5tfEQ7kNvwHhCdXq&_nc_oc=AdrShrMqOGnVHpEvP73PjdH-SuR5w1pKcAlEnRJEdHTNAU3JxHL7lvgkHeKQlsa9dU4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H6To3_bhpSqyP8AjhvlkDFQ3DrojmjzCot8_WCrmZfQ&oe=69FDDC4C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkxY3XcSycIQ7kNvwFK1tRT&_nc_oc=Ado-0SxAKP_AyXi0KvzlZIvP0WUQnyPSNItaKfEbZzqs77psQbHivC7h8cBiqeMP4i8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s9eofhX4hhw37rhH-fsATCpVNG8ewaGcETIqgXj7z-Q&oe=69FDE57D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLSVRN-KtzMQ7kNvwEosq_-&_nc_oc=AdqS25KG2wMITn4lGoYon4e-bfCN3MTNs1hGIhMrc3ZPeLb6pDsdU6wN2BNPiZ7eREA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lRO3LkDZ1rWwLP24RaYgKo0SDk7W6iKxMwEIGpmyUJw&oe=69FE03C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xwJmtyoni8Q7kNvwFuwM44&_nc_oc=AdpZ84gnUZZBa6MdXMusWjFtOoAd8o4fpGhjvNUAHtknC019fM95ISHQ-VU3bJSye9
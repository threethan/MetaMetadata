t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7dl01KWgTyU2T-_3oe845dil8uXA0ytf-MWLoHV9Ayw&oe=6A7741AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV-qHLX1knYQ7kNvwG5QpsL&_nc_oc=AdoHx0juhjI_brhBbAsryDRSuVgEa_LvqG2k8kWHhrhX4eUZ2aPDdtL4MY0JCkZg64A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH_soth7Oy-JxBrSQJ3ueUylWu-bdnkIMiifRfIHdK5w&oe=6A772353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBV7l2y_pv0Q7kNvwGwIeh7&_nc_oc=AdrrDcWIm8FzYcLECQDt-K43PcV6QOAnSO_Bvo1TFd2DGVg2cxk63XkiH6wSTBP84g0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES-8EwAMM7C_IqSvpAdie0TsMuf6R01igsebCQe7ZivQ&oe=6A7723FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKNt-rQ-KUUQ7kNvwHFysLI&_nc_oc=AdonsdAwSds9Su0RHwLLh1-Po1Cr2BJ5ZZu9CW6gppqAvNIC0aj1vd3F9N1LSl9GnY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi67VdxFJ4n-sXbDNZGhAvuALawS3c6nEtjH8mRje1fA&oe=6A77264C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9JllO-RRzcQ7kNvwFkinOW&_nc_oc=AdqKLEer4HzigzAyxG7c1RZUDvsnUwtcMUmQbKNMmYnAUj1aCGr4wLtRZWuKEgGHs8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2-TIpe3xakiUhu7a2vCzuhNeNwwnZprWMttNoiWNVzA&oe=6A772F7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVhvMzRbe6gQ7kNvwEtNtuU&_nc_oc=AdoMTN_-7frXx7Y-kTeDmKyJKdaK3HxYeIh3TmKTdRrhkd0baAfILdG27XA7aqepfbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGePinoBHrkxzMSTsQfejk7E9tF5o1X3Fse9WxxTD7qtA&oe=6A771589"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6HsCfkbsT8Q7kNvwEp_-u8&_nc_oc=AdrQ7_9xdG6tB4bMPUxaOGAD4OUYyaFIQV0HfnZYMKhv7Rl5-fcDPzHgEYQmbh6luD
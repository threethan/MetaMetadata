t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCHZYvFbQ5S4btXspk2ef3UVLnDt-HgSJGw3bK8b00Sw&oe=6A7B362C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTv_o4DeNXoQ7kNvwF8o1SW&_nc_oc=AdrWg85ldd5cNfo-2UwuW1ajEmqVMMhYr7WUGgBHrb_NpgDMvq50IS2Duh1DCYcIvqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU_d4jk7Tp2rdSClDpwSzowWws3RvraS2IIAa-7SS-TA&oe=6A7B17D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhXKV2pK7fsQ7kNvwFVYNBR&_nc_oc=AdpczhBQPMSem7oJAFpyhAZP8IeWP3gdf4iS_MFEKs2_zRrUYUPRIY2vD8NFKrrBDHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5daejcbsdMQes1OhheV4pT_lF1cXBw0wh76iRv4cL9g&oe=6A7B187E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEl1VIXOuesQ7kNvwHDhNzz&_nc_oc=AdqtV3qePT84Yw1-pHVy0VhjjO41f6nm09MPbnyrNwESkTodDpnWj0428JowGiG_bTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyCJkjAyUXSaxuoj2dQLd_4Bm-NU8UhiAj0haPZaSwJA&oe=6A7B1ACC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSDcU_ZS9xcQ7kNvwGpGIBe&_nc_oc=AdpT_fkS56a7ddGc5Fi8SYNO3m7qlHwKgnXjl3OONhqbnDvhm7HGv6Kre6QqEQl4NVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmTpDA3N3u24QLuZaLIDs4kycPGgSY8sEgdeHqzDhRGg&oe=6A7B23FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MXzPNfVmgQ7kNvwF8h6uu&_nc_oc=AdruloxJUXNSATpoYNubTRnHFBeQ_u_ZgyWncnE-juHeAOSmmdCByYEdPEvsI6J0bxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGDntKR07cQk170Yaego6JGP0IwiJDA4R_iVfc1Zlkzg&oe=6A7B0A09"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUh6L32beVEQ7kNvwH6s7lG&_nc_oc=AdpwODeD2okxgFxdtKVu3iptHSv9UNLU-pzynRVSBFIQSsLVco32F6QvXXw-23e1s0
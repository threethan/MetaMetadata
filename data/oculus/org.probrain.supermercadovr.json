t-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ePD7whzvptgdnhZEjqJt7nBjdXN3SJsB9D0976oXXTg&oe=69DFA52C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbqNZvLTEMQQ7kNvwGbzbZr&_nc_oc=AdrrQSryrjDTRovryXGJoMOJacSFXqpNkGIGsLEA1UaFD_K2X83TrFTaamIFBJcWn1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ridwfsbDMGRZGkqa46fEDbz30FwdA-6gYP6JJoKgZQw&oe=69DF86D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcaKmuNaAjMQ7kNvwEpuD8i&_nc_oc=Adrjoiusp8Y0SvieLJBaOcZo_4bpGJ0oevU9vpJ7vBfYFw0nnzaMT4TY-CecNZzBfko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af066tQfoXln8u4VWKy2iRVFfbaR1qdS5CKHPkrtSeDuFQ&oe=69DF877E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38JFSbq5x1oQ7kNvwGjfLaX&_nc_oc=AdphYaC5OmpFqA5qcz9tunb2g4AXAr1wlBg1R760rajlot_Qu-zlBJr52lnoGcthjLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h-LG-XqfKBGvxFCmF6geN-YCEhJHPBHpA0Zs1UnyJKQ&oe=69DF89CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFXU1AK_CD0Q7kNvwG-sy_6&_nc_oc=AdpEUCbh-py9CvHxFXaXFRndxyCvOd4KvE8p1IzVxTmsdzq7ZAcldGRSmJUgDogJwFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17EKVTE9-5vYfP14ijIJfU4WuHA3cFclq26H2nVlCStQ&oe=69DF92FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8s_HwPzUaUQ7kNvwElFtTL&_nc_oc=AdrzD491feUPU4eSDMz7Gdbr1VHQSh_FUOL6B2DzG4BvtjbWVtx8KnszPU_6M5ePR54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Gbi24l_slQR8Lrmg0ptBqsQrjAUsTxcL6vFvchmXWg&oe=69DF7909"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uWtbdpN7mQQ7kNvwHcrQRY&_nc_oc=Adqbh8jD4PULdQ-0tY3NI5bDYOfcC1sS3A826f6Ygqqmzy4lhGiZKtn0cmYBdpsPee
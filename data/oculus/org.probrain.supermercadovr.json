t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmhGwJeaateU_wsBy_jeFDqdbLOiLak0FFCxgi6OGiBw&oe=6AE35CAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkehAoITih8Q7kNvwGK_aBy&_nc_oc=AdquR6DOeZTXkQpg6u-VEZp93MiTtDX6aGgxbPLimZdZADiqSbw7TuD6um0mkOVd09w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVU-h7kHksmHoWfWOKdbL-oMBQRozSVkt0BHDNsQNyow&oe=6AE33E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seL8y1x2IIUQ7kNvwFjoK-9&_nc_oc=Adq-zMPLtRf5mKk9XKwLMu5_mG0IefczPWmc7VdEwLBscqRuSyktiDyP5IVU08HSD1c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCV6eKE7j0efiPPDcam3EsCcwb3MXC8wd3_GBOzXOsVg&oe=6AE33EFE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGOTqYPZ4ukQ7kNvwEJ8ydj&_nc_oc=AdoLP8tzq9GmK3uIFCtTvRm05YkKgVSiGlvK9i35SbB-Z08TbaxXJeyEKc6LlvQ7Bm8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL3_4FFfaZ1T4tHjvdj5gMGcJ67nsLHUBb8mIiOnjQyw&oe=6AE3414C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqRKVLo84zkQ7kNvwEWTWeG&_nc_oc=AdrFMMrGpW_Gef0ab6ueadjcsFfXJVx4RmNXvxedWEFfYJ7ABsPur7n8ZL3Fl1iMtZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr8pmWvuY_COSTz_AiDxUejBDcmd9ms2dA9tJiH7mDrQ&oe=6AE34A7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu_9_UA4yqYQ7kNvwGMw4pL&_nc_oc=Adp1IaqIGpZI6uLCVZcUb1HqpTd-FdI_iqYiKkgw6Bem82smnOxNTYad8QDwfEfC728&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0XX3F9E8K8AsDpbSM6ObSuyxbmxeCfPwWmD5rkcV-cw&oe=6AE368C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dc6QpbKQjQQ7kNvwFmDO5a&_nc_oc=Adqbb5GTzN3KXJvzmdd9tmUdH86GYwJkYUgYsJdVRAs2QbBXkj7CP1AZBw4cYJhTOU
kNvwFsHe8e&_nc_oc=Adq5fgkz3dGrdQT1ySQE0Tth-emGH0gdC687Tef2mq3nZ_mGpKuXhUSxhCWrgtVddG8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRXdBSO1qGKtbkMxWPZCfv3qcD3XNJCkLTr-X315fKsw&oe=6AC52A60"}, {"file_name": "screenshot_4.png", "id": "332652799210032", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974713_332652802543365_2480158436641273391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlOtgKkWkdYQ7kNvwF3ZC2i&_nc_oc=Ado0WjhhPDL0cdr80NTkoFZ6saQDZ5f-Lq7W2ysKekWIo6bFFlP5McwlavJaytWdRj4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHAs8ivyfR8g6M7bgHqBbQxd7MYb1254ZMcQWQJ4BJFw&oe=6AC4F715"}, {"file_name": "screenshot_5.png", "id": "699474982224730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982595_699474985558063_3453974348672181496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBvEw8QGrzcQ7kNvwERvZT9&_nc_oc=AdqqAn3z8F_NXe3BVkiEsryFG1zfg1huibfdXjGRMdLFP3epGVVav4-lS6S7Y4KSYl8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFMEzkfrVAA601ED6ZBjFJW3vBBAbFF7VbCN3ss0H10g&oe=6AC50872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "3483732985208245", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974786_3483732988541578_4502993567047372991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Feur5PHwCRkQ7kNvwGLKQGz&_nc_oc=AdqpfDdJ4p7f2vAdLXld1_tpdi18aNrlVvTVBpfMct4iLybSvcMcFj-OJWoqFDpLVbk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIzLHEWxzZopAdlPJjyBsPjGP9uiQVs-34-NZ-XjRPGw&oe=6AC4FCEA"}, "display_name": "Supermarket VR", "keywords": [], "long_description": "Welcome to Supermarket VR, the supermarket of the future! In this immersive VR experience, you'll travel to a space station where you can shop for groceries.\n\nSupermarket VR is a fun and challenging way to train your cognitive skills in a virtual reality environment. It's perfect for those who want to improve their auditory memory, auditory-visual association and listening in challenging situations, such as understanding speech with distorted sounds or with competitive noises in the environment (auditory closure and auditory figure-ground discrimination).\n\nThis game is designed to be challenging but fun, and it's perfect for players of all ages.", "short_description": "Supermarket VR is a game that transports you to a supermarket on a space station. Train your cognitive skills by memorizing the names of the products on the list, and identifying sounds in a noisy environment. Fun and challenging for players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/policies_eng.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564857710296707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYYMagjxahkQ7kNvwE4Goh5&_nc_oc=Ado2xY4QEBMKnNPAL-8gcJUtM0aEc2sQ_SksaaQzB2sabbxEDX4NyJ5bFusNP1wILfM&_nc_zt=3&_nc_ht=
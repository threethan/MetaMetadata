343806702893955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LUyXylvF_AQ7kNvwEBzfFg&_nc_oc=AdkkwlSwkSdtaBNkoV87oKyodMKGz4-DZpyj68QeuGoHWJIuCWwdds4xmTikX7NWHy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEu6j4Jihr8CcaY7cX9tbEJuRO95BD-YvXBUTfKMvycQ&oe=69A6CD08"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI1evgBAkdgQ7kNvwHU4oje&_nc_oc=Adn_WqKbTAlqv-aWoT54FtB1U2myo9f3o_RJurqCwwFuRlXK0eXpAGTkUlDLEoVi07w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVbbTkGKJHhHCe6J2tepAXiEfGhA-VrRN0vkzCjp-VYA&oe=69A6BE09"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOCMurB1t4YQ7kNvwHSXlej&_nc_oc=AdkVseja6lKBN4zMcvEFhkOYxya5RwrMna0AxKRf4cl0y1UALLFQGo0DIg3zdobjTjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsguLxqIWDDLgkymHcFTYkVfa2k1f4VtObkW3WjkzH0Ng&oe=69A6BC6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XgZUCQf-b8Q7kNvwGfDv7P&_nc_oc=Adlvu5RdHteUVY1aTgZK0HQlTStxrSM1bjK1MUw2YUjWD8WwRKHaOzAqX-sKbDvt-vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvz3gOfte8V77Mky9G5UEWZgr9VTlBq47dn0vqFFn713Q&oe=69A6D653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5Up2-v0-8UQ7kNvwH-LqgV&_nc_oc=Adnb9ENsRCuSv51D3Et95hsqL4SxGlZsRbtEG81vE_BK18xnaxsJTWYjLyLD3qzwihU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZEzqK_zU3NQ2b7HbFoY06hPM15iByPlDHOwK0lExQ9A&oe=69A6D6FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcG7y3o8GRsQ7kNvwGU7L88&_nc_oc=Admz127X40vb8jwM2LlI9ghfeFSN4VzRBrVO9kGboBDfOd737SCK0U0LxxoY0_meWQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBDdM-nKs0aW3Xh6V-Zqnb1RzZNmQKbSKlA9YlYK4vpg&oe=69A6D94C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_n
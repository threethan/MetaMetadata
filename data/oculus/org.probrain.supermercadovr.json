t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkBli7dW7ljrw7g5d4BmRlCu5jvmAQ7A4I1lEvtXGggg&oe=6A734D2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQMOcmOqpDYQ7kNvwE8ugp4&_nc_oc=AdqAcayY1mDQKjm6k4EkwXWOIF9tT4_wSB6_Z_ciY8SEEfwvQImzhkRkDy40by8JsIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4mUt7KiUbyf09yDz64E2mQwGA12Mp72-8qNrAQjwYeA&oe=6A732ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8LeJ3ddqm0Q7kNvwH56tzB&_nc_oc=AdqyqsTJZJHDzocp66wlJZsgI0jo_koTqhi0W2EiGvheElJ0RH42RiBG5EFciVXt8Mc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXJw622xp5o5qyKQ7P0v9iS3NrNkEuslbE9ILrRGeqYQ&oe=6A732F7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKqerNFQ9asQ7kNvwF0sRRj&_nc_oc=AdpdWwFDx2BdFMN8RxsRkjia7WmqxFV84OJ67FpvK1jKeTNkeZUTgJ9Zthr13A48Te4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvCzivgF3aLvfeTrJ1RYNcHFki5t18NC_7CGs2yX3soQ&oe=6A7331CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu2AcX1ESmoQ7kNvwF2NWd-&_nc_oc=AdpJCahOkunql7qEghiMH7QFJDsJqk0ak2uQZ0A6JBtXg0xx43_KiA7MYLEZ0qfX0xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7G-OAswTijB8to2zG_7UE4-V2qPkei2bdeqPQoFeIMA&oe=6A733AFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haVRKwb1ltgQ7kNvwGZ23AX&_nc_oc=AdoKJvLtZ_PyiP_LvZiWm3imri41-yf0IAcWwwViaigJ4-3EEOstd20ioJ4J3efyEAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEUMHHYBnfIBSvwuPmLVfQ8utf7nGFOhrh4i_CvSITfA&oe=6A732109"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb-fOdKQlzAQ7kNvwHFCzQ_&_nc_oc=AdoP7XVkg2zwm9LptIyTWu0frWKxIAkTOeG5IfEoTwdurWnnPxLRCC9DAPcy3PrOF7
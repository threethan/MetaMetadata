t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm1-5jdNh5fw53-d-AXzzLdR64OoUHJuU6uLJDi13e2Q&oe=6AC2672C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnHSBBTOM0gQ7kNvwE_DBQk&_nc_oc=AdpLCejG9eijFciJBxUNxRUQ3vMEZxqNXuqeCv6NirDL9ivXHxEdUmgIPEOXC6uQ86g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu83_OX5NQWXRpHp1PWRMilY8CUqNs6edxkWH-SqqoYg&oe=6AC28113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4jnNjry6ScQ7kNvwEtKrln&_nc_oc=AdpldFYNMw66A_bbZ0VVA0o2wCWF1cfUT6UnFjUngv6vuA4ShhsiE2NBdmj_j7j2Umc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf1n6QN2f8gKlp2X9Qa4gQYG6O50GrEiHgrG2OvEE84w&oe=6AC281BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkIPGOqwY78Q7kNvwE5lWk5&_nc_oc=AdoW1nJG30kBCaIRSl--cDBBKZGXCvHBqo8k9DKUUb1P6q91BmYM2vI8IQ0isrjiZj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfnuKqT07X6XCY5hc_CtDFdCOE7jM20hhYV935wSKhEQ&oe=6AC2840C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYYMagjxahkQ7kNvwEB5toX&_nc_oc=AdrBtIRik1NEoaZSc_T1vmJc6yT0z6hOM3GsuGgNttMLYW7kwZMv4s1YGLx0Yrqecpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq8fMxg8rutyJrIiAju--E-ij2A3Smf4mB3btBqrqx0g&oe=6AC254FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjKIUVtj-_sQ7kNvwHhqrf7&_nc_oc=AdrVEuskaadKpGUpNsDg_8huEAVx5wAZ0v--8KlDU97nUl_7Iu4tlNPLSzZDOmVNBS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpr0b6cZO55n9AjGVgbJiNOwkh_1kydLHwLbycEbVS3A&oe=6AC27349"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmjTUGXq23kQ7kNvwF5jbU9&_nc_oc=AdpyTCo7b0SNYk4dEqGvNZy-W2qkmn0O505oA2HKzS-K0qbS1u2o8t0NQMBBFy4DtZ
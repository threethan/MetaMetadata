kNvwFycG5d&_nc_oc=Adp6goOZ_kP95QC0pfE_dKScL2Lk6oCWhaceVMqHuuBhngimytA-smepZt2QqzSQpAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EZ2VYvsXIsEozj5CPEBgfMzNH_1ekP2QgGmUuGALIpA&oe=69E624A0"}, {"file_name": "screenshot_4.png", "id": "332652799210032", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974713_332652802543365_2480158436641273391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0I3EmaXPgEQ7kNvwF-M8YS&_nc_oc=AdosrUPKHEPrS3v1Im5TyRynb38SgAK_Wrkynax_dkOhmbX8tFpG4XLNTg_lqfQrf58&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iR_RmW27vfjfH18o0p49vHayre3fl3CIhc5fncC8a2w&oe=69E62995"}, {"file_name": "screenshot_5.png", "id": "699474982224730", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982595_699474985558063_3453974348672181496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GJa3ny3eB0Q7kNvwGEIwMk&_nc_oc=AdpD0JG9EZvCTBiXppzNQyQvnwb1FP8pNbA02tj4rr7nPXvcSzhAfL2tIp5NXbijlXk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f5qGsZqBf7ujnWqZ63S4OXbGhFyPGEC1v-WEzFjFLJA&oe=69E63AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "3483732985208245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974786_3483732988541578_4502993567047372991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f-sAiYvJ_YQ7kNvwHn9A6K&_nc_oc=AdrfxE8UkWjs82BzAaD8oPw4fd8-D3VcxWmk_4enrWXZzoz0ysM_5E6BNR7ujSX2kcs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oGTI0BVY71qjvN_poYP98BtfY9TIbnS34RSuJAq8JTQ&oe=69E62F6A"}, "display_name": "Supermarket VR", "keywords": [], "long_description": "Welcome to Supermarket VR, the supermarket of the future! In this immersive VR experience, you'll travel to a space station where you can shop for groceries.\n\nSupermarket VR is a fun and challenging way to train your cognitive skills in a virtual reality environment. It's perfect for those who want to improve their auditory memory, auditory-visual association and listening in challenging situations, such as understanding speech with distorted sounds or with competitive noises in the environment (auditory closure and auditory figure-ground discrimination).\n\nThis game is designed to be challenging but fun, and it's perfect for players of all ages.", "short_description": "Supermarket VR is a game that transports you to a supermarket on a space station. Train your cognitive skills by memorizing the names of the products on the list, and identifying sounds in a noisy environment. Fun and challenging for players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/policies_eng.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564857710296707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdAU1R_rJ8Q7kNvwG75t_h&_nc_oc=AdpTmE-9Jll_O4quWO1BPy6cxFbnp3z8J5XsarFapTPutlL5ArT3fnAIo1oeEGiirQ0&_nc_zt=3&_nc_ht=
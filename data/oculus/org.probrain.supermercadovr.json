kNvwHh6wT-&_nc_oc=Adq8nZU9CEN2cBxO4IOouiXDjokyd4XIVc4rOuOHU90c3cx2UelY9z6Vu0wPaHbjh4g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTljxCOBW-vvscVbsllD9vh0LO17zGyYF2Kb5AOajOjQ&oe=69C28C20"}, {"file_name": "screenshot_4.png", "id": "332652799210032", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974713_332652802543365_2480158436641273391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOOUBBQDCCMQ7kNvwG1Z1gC&_nc_oc=AdrMHHzD_zJPTw8FBuePChKaUhiaanR_DUKw59K0vshjGPQdjzFZdsCoVpRZ4hrQKN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx147k83Enzc6zi7M0YmDcFfqW_qiYlZ2xOzSFfE3fv_Q&oe=69C29115"}, {"file_name": "screenshot_5.png", "id": "699474982224730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982595_699474985558063_3453974348672181496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVnwSyaSdSYQ7kNvwFvpzPp&_nc_oc=AdodoxTxhZztifanPL2owAnh641jU_5RPUiBOagWHIc4EaqzEXUQRSDt9us8R2erzqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdgNd05znG2WD5OPjH6ooAKAz9khH51AdYUTvJNQVpMQ&oe=69C26A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "3483732985208245", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974786_3483732988541578_4502993567047372991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSUbQmShDAQQ7kNvwGJ56ZW&_nc_oc=Adowsbi5nk16nj5fGrT7CQSSBAeAT3kUQMPebYO9Eam3TDalVHM9eT-z7ofyKOrtlKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxElbfDQ108UU04xuws2UCbABXp8cQfgOaCKpYRz78iPw&oe=69C296EA"}, "display_name": "Supermarket VR", "keywords": [], "long_description": "Welcome to Supermarket VR, the supermarket of the future! In this immersive VR experience, you'll travel to a space station where you can shop for groceries.\n\nSupermarket VR is a fun and challenging way to train your cognitive skills in a virtual reality environment. It's perfect for those who want to improve their auditory memory, auditory-visual association and listening in challenging situations, such as understanding speech with distorted sounds or with competitive noises in the environment (auditory closure and auditory figure-ground discrimination).\n\nThis game is designed to be challenging but fun, and it's perfect for players of all ages.", "short_description": "Supermarket VR is a game that transports you to a supermarket on a space station. Train your cognitive skills by memorizing the names of the products on the list, and identifying sounds in a noisy environment. Fun and challenging for players of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/policies_eng.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564857710296707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHVXtFYnRc4Q7kNvwGDeV3d&_nc_oc=Adrse1dDO-XNyXfCgmKl3L5Edj73qfYpaE6bIY8pFCBa_B_m8skvaMBrfR_84_kzWlI&_nc_zt=3&_nc_ht=
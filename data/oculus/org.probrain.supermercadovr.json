t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DTnBfCFCqfzH4PjMPansodpdWJJdYG2X7elKgUU6cVw&oe=6A3BEE2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paYusnCkIvAQ7kNvwEZXlZZ&_nc_oc=AdqKgXaw68dWv3qmqRmhwE1Elw4OCCDUuLrw_ruMsuO2-4rV37QKjcpGbK_8RzwhWQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_53TxkX8gFGyF4x_fYVGqkC6XUWVEvMUEuczJLbW0XQA&oe=6A3BCFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vl6EdVwyMkQ7kNvwEBqTZx&_nc_oc=Adp26QtYPkrMU7g_IhoxY--5zl1BlV6Lh0waka3mVvPtPLTFKxpUE2h3cjOI3Kt0p2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82MrCacE-jJfLTc59lRXJNYDmEnLp-30G_jNMH2fW9xQ&oe=6A3BD07E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiKUPyu30FAQ7kNvwEp0DcK&_nc_oc=Adrsnp48K-xK3aGcrnqirt3rWr6WJ_AAUB8PJQmfAiFEJ7VCBl-FOyYp_GDXeEVw3pc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5qhXBZTCDiMYmSxqeIeWLOiNRBLMiFMK7-UXFcsiJhA&oe=6A3BD2CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVzdt6Jzmv4Q7kNvwEftcIa&_nc_oc=Ado3ICv5dAsmFZd7Ipmx0_0t5jOmnokHFEJqFirMjkxRkLBfUTiW4TfWao9HjZ8Ylto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FuRFp9T14q2A8di4lzmjtxt_8Vj5dWeLzLq54GvGdRw&oe=6A3BDBFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27R-SlVqWskQ7kNvwHJKqws&_nc_oc=AdqM5NfNq7ZTjZ8rdw7IPpgx9gPnhPFGwCud7ROqQbIc5kIr6U5FrLC3-KlVtGrFXlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KwFW2Beh0kIZfEnz6YXGjkJf6K8Ip-ZQRANjlMUn80A&oe=6A3BFA49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-6ahT3xoBgQ7kNvwFJGE5N&_nc_oc=AdoG89-SStjIiDzlEHCVD4xfgcHDHAF9FUfC_t0VX3zqF1KZa2bwDlZGx8vzQ7-byA
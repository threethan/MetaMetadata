t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKwMtWp2b8e6IxlMy-cDJ7B5g7t16dOUfnNbl-BJIoDg&oe=6AF9C62C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmk4fY87_G4Q7kNvwHNpuER&_nc_oc=Adr8QhoBH5k5D_9llzYFfot1dfsJgbXhfNMXWZryBQxAarwAWUPhD91SiwsxcdelaiU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvipgXagsDIkSeqqkyl0K7VF-jPKkFslokRzEhO21NsA&oe=6AF9E013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKgfewXtL04Q7kNvwH9Fv5I&_nc_oc=AdoEFqbwOfH79EevmxeO1ArBSCN0pmlLynMclUHsF8Mc8ZRW7F2PQ5DTb8wmakUheiE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlgX_as-mO9f3hIXw5ynn_EHLnHzt9bBgUggM9q5u8zQ&oe=6AF9E0BE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNfS5oE8yG0Q7kNvwFyOFdY&_nc_oc=AdoIQQn_nBJWlUzp04hHaFukb4qB0hMBaf9up9VxH4HWLYfeUKt__j23UWa1lzIh_9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT7SlluHL3mF-h5K6S0sdsmLEZnT0WUM2ttjm62UssQw&oe=6AF9E30C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIYt8RebFsMQ7kNvwHRD71K&_nc_oc=AdomZw1O_Cjil5dtudpFR892PpK4upVlz6hCFBtPD5iGrWN14fD-Tx3c8eI76OuR6Gc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8zNIrgPC00XuHRDeMb_3eb_6pA_AQTvA481lLUn339w&oe=6AF9EC3D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iun9pnNxbV0Q7kNvwGR8SEz&_nc_oc=Adqf5FrGuktg_2FmLMyakmX6ah8dPrTK0Xmj9RRYeVEHvL9nqewYfQPjEX3ADUqZ6BY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ9Pwlrb8Cdtbz72WHY-GqRW0TYCrBeLdQBpbfH_o2cQ&oe=6AF9D249"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jejI6LityO8Q7kNvwE6H1A5&_nc_oc=Adpc3onPuNzxh4E6xtvN-ftGup31Vsv9ajV1S4L_NwTPtLytKNgUMB1-QPftwwU413
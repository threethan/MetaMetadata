t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfZ4kk9KULgHdFAJzBlNj9t3GK9lOO_vXo1nzL40Dv1w&oe=6A68C12C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pZzf06jaNIQ7kNvwFZyfFs&_nc_oc=AdrhrbPYgmCplxpP9e63efzxlKk7yJBQ_CaQwTQmydjRbnXafIwk_A3a7GEV8hYdctM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQYtQoQ8yX6nq96K8d7sIF1yFlRL-U4X4yF1A27ZuKHw&oe=6A68A2D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXpZJI-fdlYQ7kNvwFQ8CNl&_nc_oc=AdqrzT7t94lDJWloRd6hja4gFUL1NhOBLDZ8gxvMxRNg5whumJTyxKDJdetLE3fpnpA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBse3h7A0UQ_U9CeGw2wiWNG4cSNO8QLaMmy5-y9pssNw&oe=6A68A37E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znnuGcS6RsYQ7kNvwGlwVik&_nc_oc=AdqVsnuUyyFWhJZYViz9WYAE3mBLpCcyM3iEH23oMO6UxO6jDI-ibmWw7xiGs6H9YUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1kuVraswxuhVAVyTVGJeqRm28TMAdmei5kJuwuMnEUg&oe=6A68A5CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDP2M80sxMcQ7kNvwEq2UFl&_nc_oc=AdqcrMexWsAVz-w343-XtltqikecNI663upfAeR4kq5w-JiMXQTojq5bPhurFoXy0Go&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByqtPHeLRnBK3VXdwyS3Qs40SB2165V7Iv2P467Tu-Aw&oe=6A68AEFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dACZFZOGQAQ7kNvwGhYqXg&_nc_oc=AdrmGR7_vohhKcflQxoz_JyyromH2syo_X1NB0dQe67yy2RixPjappgVpy1CGuN5H_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy01Nuw6Pl4aE9URCBLDv0Z9t2g8oxbMM0q70CR1GWVQ&oe=6A689509"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9ozBUPd2I4Q7kNvwFRNZ8e&_nc_oc=AdqiDjtFRx_j3UAF3pAQnvpIf17heJq0q50D0nd77c6qCukmFmFPHBSjU-Yvm5heYT
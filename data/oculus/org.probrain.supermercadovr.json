t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NUApVze40Qfn0_kUiuA9E--6c_SkI1Ef409icIRCYXg&oe=6A3556AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmxB6R0IMbUQ7kNvwFDYzJf&_nc_oc=AdpRF72El_nNfmBcQwHKcTVZv6_4YrgHWHkqQOA3S1Nt7fktuGQdmHoVehebaESs-SQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rjbWgDpsjTZV_dnD8b4Z8_pAH-lVCNrxyXgW9VqK7WQ&oe=6A357093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhttnIc3WyAQ7kNvwFFjizH&_nc_oc=AdqVJzupFgfY4Dctuh8s2aUZxkeeyBWcTN7Ow6U-iT3v_oDtVMRlhYmgH_ZgjyL-CWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eIuHSS0dkekJzbutFY_8IraynD7JnOaeQugBeUEioRQ&oe=6A35713E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1m6pT0wkToQ7kNvwEyc9qm&_nc_oc=AdochNBVrm0Y9pyjj8ixommtXxu5sQZ4Et1_Oiei2XmAtXaWLSo7CP-BaGNsmqhozwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LaScdT9WXL0HpwD9b2mkkoLFJogxmbRDuta_Kqq5Y_w&oe=6A35738C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtjQGqus7YAQ7kNvwHtZXlv&_nc_oc=Ado_sDKa0whvwLvfar83pSm7tPX_P8cEtpnwD_4Kg0ssnDPqOb-Hv2Lq7lh6mnlh3uI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4dW7pnlHKoQKPg2QKMxCULO0CYGAoV8vBvz5PI7PRAg&oe=6A35447D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY8Goz7kCfIQ7kNvwG22DTz&_nc_oc=Adregjrsg7VVaDAfFw9FNUB8F57cE9Z64sqeaumLXb67u9yssnCrKOpl_5Q_siE1pY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s9dgLnCarJtPwKFRllsDwnCigxUEAP-A1HPp9Bc05PA&oe=6A3562C9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quZOj_Ea4CwQ7kNvwHa2C2K&_nc_oc=Adp8B7TdbSX9Z3sVX9SKHOu1iddLf12FN_00Ttcvd3nrUlSk4yjOYhdV8LS3d1557r
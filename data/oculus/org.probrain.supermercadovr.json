t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQUGTKxPiyTJeWlHcelTVpTXZYMK3qXdQn5hiWC3AHJg&oe=6ABD212C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo8efevYYKEQ7kNvwGvXdH6&_nc_oc=Adqc8fni069huDfBQuLsfQA8fy7oYy3PyyoFWb3uQIi6G6aCu9F1MaGnpTnwreSgExQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVZK2O8kzNasPos64E_wmkfJsH-xKkx3oOz7zwRaP7mA&oe=6ABD02D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWFxhlFdG8Q7kNvwE3jCjQ&_nc_oc=AdpVUbwK4bNvFQ8nt1ZgZQC18M6-Rec5sKeYk7ogSMqCJGdyjzBNNq9Jrs7VLTmCW2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIddGcqf9_egBI0g9Nj-8WRwL9h22s4BJVHUMmCv1SN6w&oe=6ABD037E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vlF7A43ydkQ7kNvwGdFpNl&_nc_oc=Adrggm8Lcyl0gdWuGQE9m71hmb9nL1F6NSk8CAZNAK4Gc2cqw_3fnAgqf51g0l2nAlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNOaJbIhyoVwa7BPpnKo_LnUwYVi7LgRV4Ja-T2KkfNA&oe=6ABD05CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHLuuxhSjgkQ7kNvwF0DgaR&_nc_oc=AdoGR9wZibpluN_T6hsk1OkyvLiKV91KbyXmo72XRNaUczjweT3qugTxHn6uCK6a9UU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN1lPlcZ19rwa_-N3s497wSHYzRdNkG4Ht6HnY2CqFag&oe=6ABD0EFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4skkClbHAEQ7kNvwFcXaJ7&_nc_oc=AdrIMNlZTOXUXilT9x3imhvJnd7GJC_Q-JWIUboj_djX-G3-4b44fX13guEdiLb_BUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSAYlQGXEt3qW-6n7oHTuF2YGNIjiqtfqX3Ghs_ArVOQ&oe=6ABD2D49"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMoee-caniEQ7kNvwHbpLzT&_nc_oc=AdrjHyn02hYVz7zFK67Eos8UxkRkB6HyunKhCQ0nkZVcWlvhqJmLTwu6dVmrLOfm0S
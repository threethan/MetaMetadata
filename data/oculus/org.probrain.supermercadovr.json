t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJZscbOrUTOUcP6AiHKrGBhdNhenn85hIrV1-zkOlf7Q&oe=6A676FAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pZzf06jaNIQ7kNvwHspkMe&_nc_oc=AdqTgD9Y7szhR-Dzb39Yf8icHxct1Q7hAl0rn3NB89d8y1Vb3RY353GT9HBxqfFFaO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC0LV1osnH34qBIoJQ3mVPpmLPzEDqdlYZJZFeCEpNsQ&oe=6A675153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXpZJI-fdlYQ7kNvwEqHRuM&_nc_oc=Ado84GY-jS9JKUGHo0zN8rWr3x-3JaS3Nm0REUlZc9ajjWog_qGE99xtyXFhNITGVZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOj21uViuwFat2FUusqpISSUvAjoswu6nLf9MBF-fZ6g&oe=6A6751FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znnuGcS6RsYQ7kNvwHn0MTa&_nc_oc=AdodEnxFA6YZV3DBISdzOUCLzSBd9tmWL5mvZaE-8IXEMoIl-F_1_kmYLcoVkNs7VTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB42EpxFDEU62ttA7nI0Kwpffj27__J7Ltx_NYbNz7H5A&oe=6A67544C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDP2M80sxMcQ7kNvwHhJlOy&_nc_oc=AdqYQWVlhN1aKWu8abi18xB9EzQkDR3yOqf-9_601GXh4sgcjzwVbAsYlM1WwPa3B9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDVV1Sivsf2nXXzxWflcywlgl7uugLXz3l4eTWFo9VFg&oe=6A675D7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_UrFLmrlsIQ7kNvwE1eAqA&_nc_oc=Adr78HbYLoPHMvFJBbLJrKnQWoCxP_rR0TUZGWcKdDu7qK9yC5Gz1EeZeU6i3y2H0yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVFnjS9wMY7_rmeE3F16dmjqge0tRDwnleUzpOeldKEQ&oe=6A674389"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIHb4zxRhbcQ7kNvwF2Nwl7&_nc_oc=AdoA-s8BujViY8uoiVev2Q4eDjUl1G2okBTbTbgFU0lxvy4KjeSNSc58oypnpUpxuo
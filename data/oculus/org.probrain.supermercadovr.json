_2.png", "id": "1343806702893955", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_1343806706227288_2270085606400135703_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da_4sK-hynAQ7kNvwEj7-DW&_nc_oc=AdrTabUqixmiEA6D8oNrhI4kzJWKLGpE1_Z0fI-v_PomXi4KLvPRzUmgA6OylqQY_Q0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05o-FxiOj1PQ_4jOxVARqBBArbba3AqSIevZvDJj_aHw&oe=69F1F288"}, {"file_name": "screenshot_3.png", "id": "2764377250382315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974567_2764377253715648_6258493086900244464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_G_Vp-1Np0Q7kNvwGcqPvA&_nc_oc=Adqsu7h0g960lTPU7UYezXlHuHC9tdrbq-o0WQD7J0EanLy1tuTdMVb0wAzWc5kYDdQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UNjGrvBNMehFcW0zfdvITc7ExLTNCvecUBE2CtIUUnA&oe=69F1E389"}, {"file_name": "screenshot_4.png", "id": "1030591067980419", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982478_1030591071313752_4644442574994454602_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c-fS4C0cLkQ7kNvwHsBpIB&_nc_oc=AdpD0BYrvuX57Qfv_T39jh7sFMcbxB77FAscYahtfepDsFmzHPS2BtPHvchz9qTztzE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00kMvhu4WvU5aMPE_nZa846cuaQpMPLzQl2utbGvd0Cg&oe=69F21A2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0_ck5OXYrIQ7kNvwFQrxG3&_nc_oc=Adq8SlEhhbL3ZVCZhyePk4z3CMB0psknSRl53bCGdU1E0BcWFy4KgR_MHQiRyIh07O4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sIaF9FcY8jJGz58jWv6HPXsH-V7XfmjUrPG8bWSTo0A&oe=69F1FBD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZy5O1M-1IAQ7kNvwERBg95&_nc_oc=Adp64AnEa1p3R_amWeyZlzOZ9QUA8CDOay2K22kcR7jtnsBDnZTdimLSJaeTQ99BDH0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1e1aaufpOg5i_2JW-bcWN10pVUGTaPcsqCW39-cMjfXA&oe=69F1FC7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epKY19BmrIkQ7kNvwFoZmgR&_nc_oc=AdozJnFUbZoxoPeMExk8h0senu2V1S-NKpSrebutT_YBxxbl-MKtV78Pek7gQr9vV_w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3Fii-ln7tJUGknkk2jNx7TyLhdzkpaipygiQGR7T8DsQ&oe=69F1FECC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vWQbY80bE6z19TFE5piXcAT_qgLcT0cQwwRxMzSO4pg&oe=6A0C782C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7W0N-MHVG0Q7kNvwEi4mMo&_nc_oc=AdqY8EysspfQjwaSynQtczPGeRvUR42R0uLRf-J_Ek80kDjJEwoXL_bkTBn_w9c6V6M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WTHY8FgI-Y2x9p-LR7AdewQVzRQdi-mMko0x-Z20kJg&oe=6A0C59D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxE1Zb8sfsoQ7kNvwGpaA0t&_nc_oc=AdpwBr1I4le4wv-Pi5YJiRoX3-6LeT-vt9UxHx0jmJXLWjalsqs226YbDylCyLcS-es&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44C-XzZCt6jzOWld8qFMMJ2K19dkVTXpA9BlPoUosl6w&oe=6A0C5A7E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odJk_uGnYYQ7kNvwFwYUz9&_nc_oc=Ado3eeXcMlmQSf4oVMZYFlILAY_3EfwoXqIcQEEIut6CJZkpAhkvkssTD9CLLxqNYJ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60y7OukD588GNIc19-jXOzeJs9z-bjGMk368gpgMpYkg&oe=6A0C5CCC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcx9g2QKCzMQ7kNvwG2XpGF&_nc_oc=AdqCshYJZrof7sY57jnKAGPx_F8xFHvFY3eBma2tJlr6C9lCrNmWfmU-wSoY_ZcLhog&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63xngYJ1HOSUjjvkba-jSveMcCq7RDWnmFjd4U_V8Rmg&oe=6A0C65FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SZgUk3mV4Q7kNvwGFVIOK&_nc_oc=AdrEJOZt9PkFZvUBmmG2D_CuQpxfDnPX90D_8IEez0caZGPCOiiXybJwkyugIpJnPpk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jmmwgHLSy2bqDWg9_d1EYzVAg2Ed8jXNYfa6NxfAiCw&oe=6A0C8449"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej9azlnhvwgQ7kNvwHYRqBb&_nc_oc=AdqWlm_LZK-w3WNgZA0-AtyQhO4cO3wdsBOOcAdLlze-DxK6-EKd71_-c-6aC8flgQ
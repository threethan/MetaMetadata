t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcH_XqGE45RWXKaK5bh7wNsuaj5ebbzcCXhLK3bBxPQw&oe=6A78932C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV-qHLX1knYQ7kNvwHi1Wbd&_nc_oc=AdrZjPL7gKI2_5JCowTb4Baa1EM2GGqcMkBkNpNCDxgVELa-08Xmhk50An61sVE4tnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgQ4_uFUA3RG7ZMRbRacb2dzuGegbteI1WLZE51Nk5XA&oe=6A7874D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBV7l2y_pv0Q7kNvwFLOCnW&_nc_oc=AdpPdlTw6VAV4xEHJgIiKBQmGZ-jeUxzSR37nxH2M2NdSUcP6Aqr_7XyO3VwRWDkeqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2xcKDvxx8Vm2IUZT11WAaCVFeZbVT0pA983TWcGbhgA&oe=6A78757E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKNt-rQ-KUUQ7kNvwHICYU6&_nc_oc=AdqhJ2kpCzoTNFhC-m6IhznO7omqG-HwjCgsb7JsrRbajumreUQGfJvlhJx8v2R-4SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl4w9pUhxwTum_ZPkOSw0CKZUSH7YJLTxcc-elq9-rfQ&oe=6A7877CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9JllO-RRzcQ7kNvwEyuUrV&_nc_oc=AdosQ92INkmu9E01hTspPMG9ozhN_JapAay9We9mE7nm30G-ReoIGuU45J04gaPWans&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh-GIe6CFAxLQUyXiOFhIEwcTW6JozsLKrchQQhAWKkw&oe=6A7880FD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2MXzPNfVmgQ7kNvwG98xkD&_nc_oc=AdpgRcQ4b2rhUs_MwYYvGcGPGpZEblntICyxsrLfFoVc7BhBIbfioRw6WW-bk_Ma06A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh1gTOU-HPCanLFzImIJ7FzF35rNPrd0nRiG1EIrnJ0Q&oe=6A786709"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUh6L32beVEQ7kNvwGlZ-Ev&_nc_oc=Adpq22dBB-_mKyMaEc6zr037sCU4-GQc3sj1iNA7gwvIzxPr5nexd6l_jg4V3hvrsF
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeGzVL00jZJ0Zbkj8Oqn_Z_PJ-h2_Rcy0mM3qab8NICQ&oe=6AE5FFAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49tkz5VWYhAQ7kNvwGHRr0F&_nc_oc=Adrv99TkbqR93i3qPn4QiJFjuYltto0ayQMULLVKUhmEbjThImhSfDsq7lhcCtBTxdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNahcw_CfL0rbBqCvKJavR7pkYIvtzP0EiGRkFd_R53VQ&oe=6AE5E153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6htLFwCvVxAQ7kNvwFfkS6w&_nc_oc=AdpVmo5XDVDej43CUNUO3sYmRbN-i7vXHniQajBSznVnyfQ9kxao2soZpuqar-f2weQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgj3wq4PzFhYc7pvCwKvc0NQ7en41gV2bhGxzp4Qs1VQ&oe=6AE5E1FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jaq6PPgaDZMQ7kNvwGCwkcO&_nc_oc=Adq_7oCKlKCS6yYsclYfVXyMouPp07K0v3cIODeuVSC8bxn9i_QVKFKn0iyqqbOD0Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLc7tZbfZeYSiV8to70B5kncAPWpU0-kf4E0Bi15OpMA&oe=6AE5E44C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SqR3tFOJAIQ7kNvwFUEE_U&_nc_oc=AdpWb7VFKPS_c0Z0kNftxPiB49mZcpq7Ts79CYhoqF7n2NObX0xP4bLALbK4CNU2_y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMZrnso7heFYrrunMvdLyKWZmYVUHRH6As-A-_yN4guQ&oe=6AE5ED7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu_9_UA4yqYQ7kNvwGZ4oPK&_nc_oc=AdpD5hlSTDzaOzh3-WFuvfc8ixg2eZ7wBl0qYTv3hYMIEmPH0MOX2jzCUdQ7SKWB4uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-xd5HUJnRhtnTCPgSf1ysIyQ6dixOW0jsBRrjkoC7Cg&oe=6AE60BC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dc6QpbKQjQQ7kNvwEykqjy&_nc_oc=AdqIuqfyz6Y7_OoealuE0XadNjLGBlLT56hX41ih-L3jAkbdBjD95fv_zL8T6NTXFu
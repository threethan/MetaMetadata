t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-s5RxJeVIcyVhw8gKuNSSk3UfJFdPL40KgKybU9Plzw&oe=6A940A6C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01U_fVeP37sQ7kNvwHV_rEM&_nc_oc=AdrfApJuLKFdmOMaIxJiUjYjna2HCRoL4ESpYlXgdH4eskijI9wKKEAEObFcaWdaFRU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFds_1UWrYVxIqrzaEc3Zz7Jcso7_jU80-zpi0rzA2snw&oe=6A942453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Riz-FzY-ogQQ7kNvwGWYl4S&_nc_oc=Adpws1f_9IMrMLR_NvlhrxYDfjjD_btd6nFMROP61_TJeHuOW0_pnaka7TSWCJ7U5Dc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9bWjvmP2E5ylxuGVZrHWFHuLXleiJqRTpTxQRnyABjA&oe=6A9424FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcnqC1kFkAAQ7kNvwED4YHO&_nc_oc=Adr_eUWUTNNU9smAgAjQPFfgdH4ay7wlMLUpk1Ed_a1yKVzyOTze2mPi0qozt44lwc0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsSMSrNsFmUWc9L5UFUoGwPYlNL0zfWP8ywGmJmOm2QQ&oe=6A94274C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2npVZX9v23cQ7kNvwFt2_Vr&_nc_oc=AdoGTC-NrjTKd7nJEPwbzrBIDorReD4JvX-IZnSRWwk-a52AY7YeKIerCPPL5fBbONo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmgffda8CoekjZtI6iFftCWm8K9wdoeRoUPSQbrZxRNg&oe=6A94307D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQF8kv5VCQEQ7kNvwFJhMpC&_nc_oc=AdrcSD4EVV-YOVvZfLvSqYmkviG5ZB6LzohwXPltTg2oscqOkuePpH46i9nilATMsjU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpL4VfJabEORY1dvJ6GGbqGwj3YccMv0FR00RJWMXfJw&oe=6A941689"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN49xH1isScQ7kNvwE3pLSY&_nc_oc=AdrRoyxlO8KOLbJ9Ltkn1We3t6yozk0wohCRAqwuYL7hU9OzKTRv574L6QYPlkdwut
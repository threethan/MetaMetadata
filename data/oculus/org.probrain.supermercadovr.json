t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHP77rwqe8ojO61BJDq2MnE6LunvRtir22yv88lINbwQ&oe=6A4D11AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPzRoTDQ5gQ7kNvwEvoNan&_nc_oc=Adp080djQqmgYGjwR6l8OPjMi-8wK8e43y3oi2qCXuhhJ4ZpE25GROpAlpUoKyDQYsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxA2MgJYbyLDiQJazf9gfWgaGMJvvb3xUyhmgc4Qx-Hg&oe=6A4CF353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8WlKkQk5KsQ7kNvwGfq2v4&_nc_oc=AdrCY6L-Zbsz8g1Kg35xD_giIAExfuFhSKjQihXCi7krEzeFam8gFtX9IMFh68MG1cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG2Ev75S7RVxIpCvq2oWTcoVSgMQR0UpyHYES63KkAXA&oe=6A4CF3FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qopJlAtuNskQ7kNvwFhK1Rt&_nc_oc=Ado5tSxpeX7bK1kU47yi21UCqPLfzZoiGFpIHzuiMmSqEn58Z27TI_fY2YClAejnN1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXQ2r7qIVJdM-F5CjRKpTFt-4lk_GFxxFpbNiHCTT2mw&oe=6A4CF64C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR2ap7RAZAoQ7kNvwFAjvwB&_nc_oc=AdogI9M9Utw2L0gx6OygpqvEa8p2Pzqi44GkkMCnugrZ7-taFbCoDIt8CWB9KV6FO0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyMjXul97DsU_9btjRv8Gv3FZ2dybEX2fCX2XIssWrhg&oe=6A4CFF7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrRhGLAY5lUQ7kNvwG-dsAQ&_nc_oc=AdojU9TuYemrqsoxeVWKLytVhQxs2vvcbv_tp_2JKPfAgi4DtxDEEFPLfGEunaI6ZUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1ntNQ7HXo5_U9UUN9MHintweoVFmPNaoVs0dANyla-A&oe=6A4D1DC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bomd4q8378Q7kNvwHOJAbS&_nc_oc=Adr4SolmVCbGBbt3uDVC2V8Ijc3RZWDZwyYUV9V8x7pFrB2OfO1_KSxwjUrtpVVKhm
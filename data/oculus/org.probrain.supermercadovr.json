t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dhwDbSZa8Eps3wxA__9FOQ1eLly8EIvSL9EsawpNF_w&oe=6A048F2C"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyMQsfEDQ9IQ7kNvwHciKH-&_nc_oc=Ado5-8Znd704jUDAystU-v4ZFZSeLnJfYTYATb2pVmvxeb_WH1x9hPAGOrVFbh3ZEvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sbDTy9r9jxcPKQ-XnOYVAlACcGc_xjj7jUjDSTNq_Yw&oe=6A0470D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIt4X1TikQkQ7kNvwELNhoN&_nc_oc=Adq3xzs8AVHEQq5jKTdp3CjFZHtSXP9WHpZZ29DBECZ1k2guLg6mKQa19asQ1n33waE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K14Agend7AuFrFkKzBfL_8zb1SPD5kEaD2hZixEA0Wg&oe=6A04717E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Psdaci10-MQ7kNvwHlDF9n&_nc_oc=AdrivFJ8DLLz-RpQ3JL2R9gyhGdqECS4jSmxHhGjYyKiDv2eOZUHKMZdkQV0ADekpac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41ZvlEvTaFJlscxvV0Avw1byzX2hERjVFpLKZ2CxCjVg&oe=6A0473CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zwHGJO9F-kQ7kNvwEYHeQP&_nc_oc=AdrQPR-ZZvdgztX65kLfPYI1lQLI96oBGIMx-iKTxzVZQqytss4Mkh80EvFmOe1i-C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lurlPT2FEc6utRtmZIK9sEB7WUO7RrEm33MtprfjykQ&oe=6A047CFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5dJbz26664Q7kNvwELJoSX&_nc_oc=AdpxYAT-Gh6ZcEOahDB_N1ZZlAQoCwTzIFrWrdxjE89ZEv8s48FQoxbsLOmjXfTqn3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lzNLTEG-LNQKYJ_ww9tYcS4QKyEWwiabO-UqQXyJAdg&oe=6A046309"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wiTr62CtUEQ7kNvwGhr3_8&_nc_oc=Adpmo2Rn8GKRWYv2fcS_HLxTsYknBuPXyzk0qkMG0FcjWhiJbfWI19OoEv8re0YlVy
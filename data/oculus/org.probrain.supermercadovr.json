t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N20xI6XJU5fM3cemyGzX8oDWhZ8_y_kWP6lbgYJYx2A&oe=6A32B3AC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmxB6R0IMbUQ7kNvwHdvX8H&_nc_oc=AdpPB4CrcTkR4ykBewf0SymtlsEOOSlEDvFOf7VXJN-ljCAZ02V3WwNFOr0iRiGOlgM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IdYSecoch82T5ZEXhp-BvadbEqa5BKzgWD3q59wINzw&oe=6A329553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhttnIc3WyAQ7kNvwGWhyL6&_nc_oc=AdrXGAl8r7kUi90W4pNEK7kZXkFwC3QsT08cKl8XBIKzgdfAl-DJ02jIfWtV6J9wGAQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z5eYc4qUuuS5XL6hxkoknrk6PZ1-N_wdewwtbnRDWgQ&oe=6A3295FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjG4QQPn1ukQ7kNvwHpZMsW&_nc_oc=AdoSBPjg6SIuyQuXi8QAAbIyK0UiY-FH7eHTnBnhb_LXD1MPoq-Gq9Z-ievlNu7W5SY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UMpTs8xzSwxMCToK1nvzbuzOcjgFvnlOoXR_x8dkCZg&oe=6A32984C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-LPssD4GIQQ7kNvwGd6pij&_nc_oc=Adr_pu07w1wLR4r-DqAIiNwFkraayqizp5UFBBU9SyAsz0ZTM-988bBojbzZEMQpAhw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pgHZ98bHESfHiSvMEyphC9IibcX9OR_2ILuR055ebAw&oe=6A32A17D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYrPYDSSYEQ7kNvwHuQV_v&_nc_oc=AdpWvC6xyXiTW4fyeNz0p4txKZcEgmdpAfWqzS52zUC9JPGj4FKQQB0d2HoNC8aGhV8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MkC8q3oAV6u2BGYsmxwiREqzZUshyXdv31k8fmt7gMg&oe=6A32BFC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNCyTlZlgkwQ7kNvwF3fPDG&_nc_oc=Adq_C3kjO86i_Ck8RiHgTtq46ZmdjPwfC2c6vtSlxh8INlmGDxdRSxeHExLI2Flbub
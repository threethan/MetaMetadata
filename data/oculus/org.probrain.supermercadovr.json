w92KekLnvBouIBVdNqr34&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFciIhqycbzINWbrPlp9DpE2IIkUt3SHyFTOkva0LmXSw&oe=6A8589EC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSwP4XJvMOsQ7kNvwHoB0H9&_nc_oc=AdpMekpioOsuqPbsT-vAyqa8JUPyPwc7DIot7kSUrlvI29RxAH71EW8ku875-U6VWeY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYI45jFdlhaFrExTgw5aroiRNEkPThhbJAhaH6NbJySQ&oe=6A85A3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbckvhldg7AQ7kNvwHycv6X&_nc_oc=AdqZExkPLjHeHHTm2nohVfKSCAuOwnMj6S_5KjsVwjnQZOG4ylSPcal_HQufxid29uI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGgUkd8hw3URWMgYbOam3dQVL8DBwPMBUIvVfuKGtwdw&oe=6A85A47E"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1Nd1aSLBFAQ7kNvwFGqs7W&_nc_oc=AdrSfb03hM7WQivcIidy72hG45HdI3ojs7l9g18zXJg2LigKt7jf-SlFoIo-87DZ0Xo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFFdYKzJZrPelEIXXPsfOg-jBulBs589XTlbjERNLJ0g&oe=6A85A6CC"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhk43ZLCHCcQ7kNvwHvKEwC&_nc_oc=AdqyBtvIy1oyS4VAyUOck7vtidWlWIZ_ABuYjjg5tZwiXt2z3VXgJJDxJPJZ0yubgjQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8gD8tE5QBJ7BDhkmItYOb6Fp_6pwep-n1iziyxHtLpA&oe=6A85AFFD"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG_vbQgLtJQQ7kNvwFM5kFZ&_nc_oc=Adq-oY4JjotizrJeoE2hXdcDjBpDUJ1PmCwPVX_gvJVxPtlBeeMxhNUF-cP71UtjFPM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgPuAybIssDNtee4kUm5LL5h-MrKOTV7E4QS-JjYH3EA&oe=6A859609"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bQaXY3GHisQ7kNvwFkA340&_nc_oc=AdrKCpS3V3nAAFIpp
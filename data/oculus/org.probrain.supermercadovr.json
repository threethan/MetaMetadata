t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cJp_-Kjmz5_wRD-aLFuiE4j57hC2mjFYVbMJszRVRfQ&oe=6A130FAC"}, {"file_name": "screenshot_5.png", "id": "332784552473958", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982683_332784555807291_4360475011314507903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aPWKVYdepoQ7kNvwFqhp1F&_nc_oc=AdqcpXDtL9BaCetCx1N9C1rYGycGIV-Z9qpjDhXrjpXuwdFE3ax0_eLuLXDnc7DAr8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XYvNCWKsad-C9OAzHlEtxD5mTPd3Hmcj2G6YJiJVsmQ&oe=6A12F153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "1017897066014710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_1017897069348043_4703743327224340330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V9bAWZfDuwQ7kNvwEfP0W7&_nc_oc=Adq80dXSiMy0XXI7drtk-W1MrJEGD9m2-9T4tMt7v3kLAJQ_BT3X9F3e0B50zNqykJA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EZuOO4nsle0CcdGK8AtACuJnHeZn_7c7QUPdg_A6Utg&oe=6A12F1FE"}, "display_name": "Supermercado VR", "keywords": [], "long_description": "Bem-vindo ao Supermercado VR, o supermercado do futuro! Nesta experi\u00eancia imersiva de VR, voc\u00ea viajar\u00e1 para uma esta\u00e7\u00e3o espacial onde poder\u00e1 comprar mantimentos.\n\nO Supermercado VR \u00e9 uma maneira divertida e desafiadora de treinar suas habilidades cognitivas em um ambiente de realidade virtual. \u00c9 perfeito para quem quer melhorar sua mem\u00f3ria auditiva, a associa\u00e7\u00e3o auditivo visual e a escuta em situa\u00e7\u00f5es desafiadoras, como compreender a fala com sons distorcidos ou com ru\u00eddos competitivos no ambiente (fechamento auditivo e figura fundo auditiva).\n\nEste jogo foi projetado para ser desafiador e divertido, sendo perfeito para jogadores de todas as idades.", "short_description": "O Supermercado VR \u00e9 um jogo que transporta voc\u00ea para um supermercado em uma esta\u00e7\u00e3o espacial. Treine suas habilidades cognitivas memorizando os nomes dos produtos da lista e identificando sons em um ambiente ruidoso. Divertido e desafiador para jogadores de todas as idades."}, {"images": {"nodes": [{"file_name": "pdp_art_hero_cover.png", "id": "6800854023305748", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974567_6800854026639081_3236214442737048541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0-pUyYcvyQQ7kNvwFfQt1x&_nc_oc=AdrzSjzhDqM6t_UNAeEWc00_jC23ZotYXcd5SKSEAJaKN3bEWXf0aEiaE3BsfiTzP0Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zh2rZebnX3ThPfr6mgVYGrPwZDsxT28pjGwAZHFJkSg&oe=6A12F44C"}, {"file_name": "cover_art_square.png", "id": "2830046893804269", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_2830046897137602_4393294089462604349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf4gYxM5FHYQ7kNvwF057NF&_nc_oc=AdqUm80KiwL5Lxd2OmZVN2hhKCYQm6LdpJFYgsFSKr2JMtFHYGQnjyIKPbRXqj7xYn4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xGFPHNwOwQUhvU7QOrlNsIKEXCvsu2XYdJb2t2op9-w&oe=6A12FD7D"}, {"file_name": "cover_art_mini_landscape.png", "id": "1763320020794840", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982522_1763320024128173_2643704148316633693_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBr8C45ky-YQ7kNvwG7trbk&_nc_oc=AdpVCSXist6t_x1fXB51eayE0fjo3S5zA0KzKa_oAYT2S-YKW50-l-T6qkUQSstKKms&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CSfZw4HWPPK8ZG7fHBYIA7vNAGwVtdk3Au1EoR1L4cw&oe=6A131BC9"}, {"file_name": "cover_art_landscape.png", "id": "954819855610792", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984445_954819858944125_5209272613340422302_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1HzdsTj_QgQ7kNvwHi-l7z&_nc_oc=Adq1BdLG_pRQmTofhDNJgWIPCDMO1W0tOCwlounWX0giR9MLAZOByFU12nhs8DgEfM
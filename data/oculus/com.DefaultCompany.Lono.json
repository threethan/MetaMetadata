WaWMyrexOAIA7wBLA-htfZrAfYMOGiJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR6_RjRWDmXT-9RLmEkDfUlEE5euo_GEURSwfOl8IVCA&oe=6B006643"}, {"file_name": "03-Spectrum-2560x1440.png", "id": "29598128959773334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_29598128979773332_3028562131116258811_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5WtDNc7FX8Q7kNvwHNYHx0&_nc_oc=AdpH_qBweUSQ2pLozZyHWnKkt3LtCoblJCSLkh13AsCS2PM3lZBHiPhLHr8Zd-heh0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToqCDE5d_7dWNn71vU0e_57h8ldTUxNefy8VCPRLmCCg&oe=6B006C7D"}, {"file_name": "04-Circle-2560x1440.png", "id": "1010642754691438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1010642758024771_5944585832252325034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL0FOzqZ00wQ7kNvwEWCqgL&_nc_oc=AdqzWiNYsjYNiXAgM2KwjuzQLI7ehk-XdXusNXNgTVu8uyz3NsNxAsk-Jbb99UZjc8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDg32SplVCXJx336OIVH23kyr533Wn4IliAX6zdZELOQ&oe=6B005494"}, {"file_name": "05-Sphere-2560x1440.png", "id": "29243627235271661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_29243627271938324_2822272075945475042_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2HPevYquu8Q7kNvwFK33uG&_nc_oc=AdqWfc4PY9jh_0HUFQKzMVccuwuGI47usgRl-7_y9uLOodTpYySg72rH06Z2dDhTu0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa6LfJ9rbXPQ4-HxYnGv8ohVwkB7-XO3WoGMpOxDug5g&oe=6B00632D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CSMIC-Trailer-Cover-2560x1440.png", "id": "2090047764959434", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_2090047768292767_3012677111655512921_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyedbOEG6M8Q7kNvwGsVWFd&_nc_oc=AdoSwRgIArh9BRZ5r77fglZx5bvMTcOAs5Cl6cKnI5oHUoiAOJBMbm3bvejODkUeFbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUFISzjtHmK_Wl9fsd7zb8l-yMuqFhqXC0cLbe-hvKwA&oe=6B0062DD"}, "display_name": "CSMIC VR", "keywords": ["music", "visualizer", "immersive", "ambient", "relaxation"], "long_description": "**Beyond listening.**\n\nCSMIC surrounds your music with colour, light and movement. Pick your mood, choose a track and watch the sound take shape around you.\n\n**Six moods to explore**\n\nDiscover Bright, Dark, Energetic, Hopeful, Relaxing and Suspense\u2014each offering a different atmosphere for your listening session.\n\n**One track. Four ways to feel it.**\n\nSwitch between Spectrum, Circle, Expanding Ring and Sphere. Audio-reactive bars, fine rays, trails and surrounding particles respond to the music.\n\n**Make the space your own**\n\nChoose your environment and adjust visual intensity to suit your session.\n\n**Your music session, under your control**\n\nBrowse with Touch controllers or hand tracking. Play, pause, seek, skip tracks, shuffle and repeat, with playback controls available inside and outside the visualizer.\n\nAn internet connection is required to browse and download music.", "short_description": "Let music take shape. Explore six moods and immerse yourself in colorful, audio-reactive visualizers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://csmic.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Revolutionary Electronic Network Ltd", "support_website_url": null, "website_url": "https://csmic.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
cjPv71a-BeBbhJrDAgu66UA57gKtaEmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkxAqflQ25WgMdV0FyblII-CEERVyDMKI_CTUuakzIzg&oe=6B0C7C03"}, {"file_name": "03-Spectrum-2560x1440.png", "id": "29598128959773334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_29598128979773332_3028562131116258811_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72y12HbelrIQ7kNvwFvWtrD&_nc_oc=AdqdNdSXk8VotTg9SAFXIa7Qv2d4ZhBa8DVsbsjmIWowAiOz29kBrq95Uuc9QOg0fPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpby3ESrs_KW1f7g843-VJOmPOQLEb_PDW_4cOZpHQkA&oe=6B0C823D"}, {"file_name": "04-Circle-2560x1440.png", "id": "1010642754691438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1010642758024771_5944585832252325034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilxKomLujcoQ7kNvwGGrnHP&_nc_oc=Adp4kpKtP1lh6BKIK3iGuvobQtPF51CZGmz2ZYauwH_DovYeQBpILRV2OY0XQVDRFck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRK1J6BuFKX6ZOkA8EuYyUedeKM-B_MviJiO6YJaW6QkQ&oe=6B0C6A54"}, {"file_name": "05-Sphere-2560x1440.png", "id": "29243627235271661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_29243627271938324_2822272075945475042_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1X-xboLQtkQ7kNvwG4A3tk&_nc_oc=AdoWQP9vQP8XoEqZh5K6zXOvwzDqKsvoXtN5T3g4r5GPFaZa-z8PfBbXqcuKhBUfDZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2tiocTjcKdIIaZW9Un7ql6rFFHXBWYe5UUwF4NwOFyw&oe=6B0C78ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CSMIC-Trailer-Cover-2560x1440.png", "id": "2090047764959434", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_2090047768292767_3012677111655512921_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSLkWd8i2L8Q7kNvwFKHRa5&_nc_oc=AdoYlxyB3D_Qr2S6Jp3KTG6NNneDK4iHQXz9rcf6NvGfmH4vuEpG9KqbaEaMMcr3hZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlWM2KbI8uVZon1XvAnYbmKC8oS3RCGzbNKbXveVyB6A&oe=6B0C789D"}, "display_name": "CSMIC VR", "keywords": ["music", "visualizer", "immersive", "ambient", "relaxation"], "long_description": "**Beyond listening.**\n\nCSMIC surrounds your music with colour, light and movement. Pick your mood, choose a track and watch the sound take shape around you.\n\n**Six moods to explore**\n\nDiscover Bright, Dark, Energetic, Hopeful, Relaxing and Suspense\u2014each offering a different atmosphere for your listening session.\n\n**One track. Four ways to feel it.**\n\nSwitch between Spectrum, Circle, Expanding Ring and Sphere. Audio-reactive bars, fine rays, trails and surrounding particles respond to the music.\n\n**Make the space your own**\n\nChoose your environment and adjust visual intensity to suit your session.\n\n**Your music session, under your control**\n\nBrowse with Touch controllers or hand tracking. Play, pause, seek, skip tracks, shuffle and repeat, with playback controls available inside and outside the visualizer.\n\nAn internet connection is required to browse and download music.", "short_description": "Let music take shape. Explore six moods and immerse yourself in colorful, audio-reactive visualizers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://csmic.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Revolutionary Electronic Network Ltd", "support_website_url": null, "website_url": "https://csmic.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
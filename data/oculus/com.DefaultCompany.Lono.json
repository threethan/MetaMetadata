Rch4oYDA-nm58h7dTIXzqivFKKj02aPc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmucKjnBCnqsBHvLBSw3KzBb7_isWbmbrVUOcpYVJ3nw&oe=6AFC71C3"}, {"file_name": "03-Spectrum-2560x1440.png", "id": "29598128959773334", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_29598128979773332_3028562131116258811_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_AumMNqWhoQ7kNvwERqIwo&_nc_oc=AdpQNDBqU0DbAG8io_LsjgTSnuWVGM6-fOtECg3kLlKN2CQA9hypdsWYB4q2wTxBUlQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcyCDlUtoNszXkAl2e05JTqYWVR9LdKBYD7DFCJ7muFQ&oe=6AFC77FD"}, {"file_name": "04-Circle-2560x1440.png", "id": "1010642754691438", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823757_1010642758024771_5944585832252325034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWphZ61-BlwQ7kNvwGBHatA&_nc_oc=Adp23tFvk4WNJMBTr0T2QbuVm3r5Jkr3FlznF_ihXZiho8cWPlHNQmEOyuijCMWiPSQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf-OgGQdedsGN8XGIlbYFnxUi2ke5RKqGnuFU4qFdslw&oe=6AFC6014"}, {"file_name": "05-Sphere-2560x1440.png", "id": "29243627235271661", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_29243627271938324_2822272075945475042_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlFRnO373MUQ7kNvwFlAWom&_nc_oc=Adq8aBxPf1JAxCrYaG_NjRuGOh1Im6Cp9A5gU14pvd4zWPTYhj7KYOXHP4SpAYB8h34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb-7Y28l2bUmYLV3hRQ9Qizf_Hv_Z_SR2PZi5Ao5Yc4g&oe=6AFC6EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CSMIC-Trailer-Cover-2560x1440.png", "id": "2090047764959434", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_2090047768292767_3012677111655512921_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4VlgtM_xIAQ7kNvwFhmJ8D&_nc_oc=Adr89DbAwSH5xOuLluHiYbDvLU7KvJiCkjC0Jf8Z4OEGp-PmSLPRKvvcO__ZLOg2i_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCU7ZGBEjHUubnjtPomknnBdhauiQGjvB_kQH-RqVW_g&oe=6AFC6E5D"}, "display_name": "CSMIC VR", "keywords": ["music", "visualizer", "immersive", "ambient", "relaxation"], "long_description": "**Beyond listening.**\n\nCSMIC surrounds your music with colour, light and movement. Pick your mood, choose a track and watch the sound take shape around you.\n\n**Six moods to explore**\n\nDiscover Bright, Dark, Energetic, Hopeful, Relaxing and Suspense\u2014each offering a different atmosphere for your listening session.\n\n**One track. Four ways to feel it.**\n\nSwitch between Spectrum, Circle, Expanding Ring and Sphere. Audio-reactive bars, fine rays, trails and surrounding particles respond to the music.\n\n**Make the space your own**\n\nChoose your environment and adjust visual intensity to suit your session.\n\n**Your music session, under your control**\n\nBrowse with Touch controllers or hand tracking. Play, pause, seek, skip tracks, shuffle and repeat, with playback controls available inside and outside the visualizer.\n\nAn internet connection is required to browse and download music.", "short_description": "Let music take shape. Explore six moods and immerse yourself in colorful, audio-reactive visualizers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://csmic.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Revolutionary Electronic Network Ltd", "support_website_url": null, "website_url": "https://csmic.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
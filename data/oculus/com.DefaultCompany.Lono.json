uTfbRNvfKFQTLdJK2aqBWmMDPRZOCkGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa547k2jefnVi8dnM1809lrGlm03GJbpHtGbTzoADsMQ&oe=6B084F43"}, {"file_name": "03-Spectrum-2560x1440.png", "id": "29598128959773334", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821704_29598128979773332_3028562131116258811_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3CsEw_8gEEQ7kNvwFhtsGG&_nc_oc=AdqzcqGGEwTrbaWt_J-XiFDJFJG0JGpu2KhbUy7YE8Z1EOIinG3asKQRqIQePuwUQx4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDSeobR89cC11wiZw-Cs9bzcsOrPGJzEaY2d6mNbm7NQ&oe=6B08557D"}, {"file_name": "04-Circle-2560x1440.png", "id": "1010642754691438", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_1010642758024771_5944585832252325034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amv2yo9M4B8Q7kNvwGxtIBc&_nc_oc=AdpN8FmAlnKAfGoAaBpsDhGMzyJr_l_vbl6BlqLimImCVcsuI8I_-5zwk1UhHcYkiaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoIACT9gqfBPdL2QkbLPHCI5JB5vMX9AbbgJE6OQxXZw&oe=6B083D94"}, {"file_name": "05-Sphere-2560x1440.png", "id": "29243627235271661", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823901_29243627271938324_2822272075945475042_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWzOPM5r0T8Q7kNvwHnc54E&_nc_oc=AdrVBE0uKe5cflEl5z-bFi_Z5bDyIt4oztTWNq8bmHSRhmHeIIVFRg2IRn5BDelLe_A&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJB5E1_M3LNWsmktLCz9rYrihAy7cEzPwfQksAC5gcyg&oe=6B084C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CSMIC-Trailer-Cover-2560x1440.png", "id": "2090047764959434", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823259_2090047768292767_3012677111655512921_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z868AJ7PLnsQ7kNvwHFp1Tz&_nc_oc=AdozOS2eBgbJT4G4-1VGKK6vHG5ZFyRGTjgTCLpZ7lBVXeKNana1h67jFCugeYSrKRg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR70i3TOVYxo-isOumZNlgOSajzeQ_z_uDUZ2Lthv27pQ&oe=6B084BDD"}, "display_name": "CSMIC VR", "keywords": ["music", "visualizer", "immersive", "ambient", "relaxation"], "long_description": "**Beyond listening.**\n\nCSMIC surrounds your music with colour, light and movement. Pick your mood, choose a track and watch the sound take shape around you.\n\n**Six moods to explore**\n\nDiscover Bright, Dark, Energetic, Hopeful, Relaxing and Suspense\u2014each offering a different atmosphere for your listening session.\n\n**One track. Four ways to feel it.**\n\nSwitch between Spectrum, Circle, Expanding Ring and Sphere. Audio-reactive bars, fine rays, trails and surrounding particles respond to the music.\n\n**Make the space your own**\n\nChoose your environment and adjust visual intensity to suit your session.\n\n**Your music session, under your control**\n\nBrowse with Touch controllers or hand tracking. Play, pause, seek, skip tracks, shuffle and repeat, with playback controls available inside and outside the visualizer.\n\nAn internet connection is required to browse and download music.", "short_description": "Let music take shape. Explore six moods and immerse yourself in colorful, audio-reactive visualizers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://csmic.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Revolutionary Electronic Network Ltd", "support_website_url": null, "website_url": "https://csmic.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
597115_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR0dyIcTUuMQ7kNvwF62l1x&_nc_oc=AdpNrYRp6W9Ztje0rcCTSsRoWlBjXpqPlM1UeyLjgnbazF795tzZdw9LdWI2f9pVMzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGovqSoUcMPEcnJ6dZU2ahrBzFjufkEJUMJLA3y_V9lQg&oe=6A8ED46E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Play With Me", "keywords": ["horror", "exploration", "clown", "story", "puzzle"], "long_description": "Let yourself wake up in a mysterious empty house, well, quite empty. 'Play With Me' is a student project aiming for total immersion in this horrific adventure.\nIn this game you'll only count on your instinct to guide yourself through this nightmare, but do not even try to defy him, he's the only one allowed to play with you.\nPS: Better played on a rotating chair or stood up.\nPlease consider having a good night despite this.", "short_description": "Enter the darkest house you could visit the day of your birthday and locate all candles trying to find a way out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://marcolorenzo.fr/play-with-me-politique-de-confidentialite/", "developer_terms_of_service_url": "http://marcolorenzo.fr/play-with-me-conditions-dutilisation/", "publisher_name": "c6h8o7", "support_website_url": null, "website_url": "http://www.facebook.com/playwithmethegame/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "PUZZLE", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3101078320133166"}}]}, "s
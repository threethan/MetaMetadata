-7&_nc_sid=6e7a0a&_nc_ohc=bDaDpN0UfEwQ7kNvwE8o9Ag&_nc_oc=Adpqw87v8Xtj3EtstFlqS35HX5ffKEfqjRELkeguwrZx7Lfw6oeOnrKPZ00KJiiuQug&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPJiV1aw8nyeIvAwZTXvIX-ZRg9PoztxMFy4eyXk_aSg&oe=6B086DB1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4qgdddwNsQ7kNvwHa_FIk&_nc_oc=AdqZCVnj9jm63am16MFiXj5ICLxrFTG5jK4hq7pnh3899T-c85u2_Y3-5eijBPOq1Qc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZGbmGJIno3zeHPo0uGLYJ38uYVkqiq7j3DgPCJN14tQ&oe=6B08505A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR_mgQ7Z6r4Q7kNvwHALdiH&_nc_oc=Adr8nW0OW3AjapFWfZLGIvnWXG4RjH7hFd_beajkSZnF_JdgVcjRrlYpKFU4gib5_0I&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS58xbq9iMT00P6DfcSxK3czWxl4KrvklgFqVydMkPElw&oe=6B0861D7"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcsM3_PJeO8Q7kNvwF26Ih6&_nc_oc=AdovJSyCl9zJkI2ZJ97EIsGUgnFA96maNtLcelLB9jwo3luyVDhbFbG3QNMjH9ktX7k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShspWzUs_TPMB3JZCJsdso7U3E85fxMtGePAhBPOnGUg&oe=6B085ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mHuGgqmXdMQ7kNvwEqSBLh&_nc_oc=AdpT5kYAdKIfnvZnwAm83MAerZ-JqJyDGCDVK3rKHsMGyHo5um9VM5JGATROHVDZQ0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdIHIaEdCRZiiIw8PODph4IbUJDQmQtZMYY6yTcYCOug&oe=6B08617D"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
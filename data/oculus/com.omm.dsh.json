_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrs-5kUU8mAQ7kNvwG29kLS&_nc_oc=AdokAUIHBQkBUXCGa-HR97MDYI7MKzY0t4kmM9_nf_cQL6FGxTytEOhN4xi8wvYXcmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKemE79NFCX6MfHaUooRzl0c62CO2Yq2-CrWJtMn5dhQ&oe=6B007C0E"}, {"file_name": "5.png", "id": "4213680111993947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615891_4213680118660613_3546102750087524151_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPt8q4DyoroQ7kNvwG_NdCB&_nc_oc=Adpevw1e9p9JTnLkQ9rIVd3XywAWoQhkjE6pWkxqxqTdfurldh8UBHDPVN0ux4ef1Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSoLDOItpmy4AvPGzjNrptTLKTHzhojZDIVxYONTmNhw&oe=6B0084B1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhleES28L_8Q7kNvwGx2qLP&_nc_oc=Adq92gpEZSy8EaXarp-4ibV9krS_GaaevXnNBtw19sZrH0Sv2-uLK4qKYrwL9WCgiPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStmFXFTvJtO96nm4hLA2y7fNF1C1xyYm6bFc30lJebfA&oe=6B00675A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEJ8JB0foKMQ7kNvwFBTzJG&_nc_oc=AdoRHqs9yUQzOR9WIoBAd3yq8VG4s-TT9EX5kadKyz_LcgUmxck1yWBPPvWWnYYAFkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWlgWBx-3NGPHhkpPvaDOA2nI-i-lgwxhb_M97KwqJuw&oe=6B0078D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "416533082751169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_416533086084502_1168309340535307611_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9A5SbtSY1oQ7kNvwF5Qv4v&_nc_oc=Ado7pNMZ5566Dm6bhBDIsKeGXlON0nByiE-LzqeWFsH-bhIRgS9_Al8kT_T1RsWSzlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtDG7d_BZbwVPdeXV8_pJCNh6DgubWRwewwNhIVBQGLA&oe=6B00641A"}, "display_name": "Warriors of Titus", "keywords": [], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "exte
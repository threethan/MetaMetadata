bw&oe=69D3B671"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bWtjsIPoJoQ7kNvwHDx9YR&_nc_oc=AdppMNYaT3stSeAroYXiSjGj-gCnieIm7BFN3MQzBEQsT_sRaR8I1gX3BN03xtzg7Wc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xYs1mcXH3yZwSojR1jqEsQic8be0MiXXHS37Ckd5LVg&oe=69D3991A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA_rvmc-DVYQ7kNvwGSdb4o&_nc_oc=AdpYEoKA1iVb4oRo7J8SiOKyM2Nzb1OTWsheCm8wPX-Q3FRmZXNE56aEL850eJ5_HTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u5y-6wOEo15n_cUWMGfXkIhhr5_MZuo2IbsT4jfqgdA&oe=69D3AA97"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_YkktrfrXUQ7kNvwHkkJx6&_nc_oc=AdoR_h2-Cl2VEl3m1h7euVM1raVb2sfssIdJpVfsyZXvtyueyXW0_ybZFK9qovUYDRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ar13asU9AKHqLcMQoKQnmXsdxjOMP4WD0Zy2Kx7_Gvg&oe=69D3A793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_AkM_vhIKkQ7kNvwElexpH&_nc_oc=AdoKDpuQvsSoZ2zjzlswGLZD0wzsmWMJEgt5Wc40sOhAbx7bwV3ea7i8HxejrSlND1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QdjKc2XYNlxobLRawePg74wtnpp53rmuaVdYxKu3VcQ&oe=69D3AA3D"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
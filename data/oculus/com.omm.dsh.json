_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWvFZBKWXl0wJoC-2AXi4P7ibRBNVwbChxiasdwJPVWw&oe=6A563AF1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBeIPiZKuQgQ7kNvwHa9I2D&_nc_oc=AdqguPtd_DI1MQfAtRUmy7wlekdeMnxb1DIDUllds06kVGH9Uyo5xE1YsSO1JkfcevU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQwGgOdcW6m2SOPNsVbwx1ySHWrEh6Jweh9LrQdQ6kuA&oe=6A5655DA"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uThg1TUvixUQ7kNvwH-lPUn&_nc_oc=AdrqnuYlJGdR_5aRdlLkW_otwea1BTPgEkAPw7iszv5mdeJYpzwK4Uoobzo4om9avio&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBox_h-pDnxfozLKeq2lMNwzfUlLqahtEKPjkRKRvJ9zQ&oe=6A562F17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "416533082751169", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974497_416533086084502_1168309340535307611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t6Wec9WPQ0Q7kNvwEPOnlS&_nc_oc=Adr7JUavKWJJ2Rl1ylutL58GNIUa_fgmPdeuo10cpBCNcA4X2fkGk5E7ZDcvt3ovFA8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRiiMYjbKXpslrWyvaTv3cuLDiXi-DUARXvyeVAU13Pw&oe=6A56529A"}, "display_name": "Warriors of Titus", "keywords": [], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "679013889939356"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
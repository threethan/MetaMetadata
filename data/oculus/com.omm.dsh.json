-7&_nc_sid=6e7a0a&_nc_ohc=BOCHrea6reoQ7kNvwGPU-rX&_nc_oc=Adr5hbms3COzSPSJaS9GqAxKPZZdmNsJwmItVR5XoEdIkSjCmeOZF-SE92YVYv2Aqoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLbpbfRo-ekgjCqhY8ledd3oUrc9ZR23nN97ve4seQGQ&oe=6AFDE1B1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhleES28L_8Q7kNvwGan-4c&_nc_oc=AdoTM8v5VQAhwmFx4pYCgUjS8hT8Dt4bMI0B7ytQcxRmhZcSih6Lxs0cd2kJK_T0Wug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3MtSgdgKzHFPYJIgXiiqu9JmsUmMjPzhHmTV_0ulnvg&oe=6AFDC45A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJG6po7ryqUQ7kNvwFxfj8n&_nc_oc=AdqyIdMbirnJNWCdGbNnWRzWJBYZarS7GKpk-Cy81Rlip_TrzE7lROftfijuXzy9VEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAOR5BP-_ul7U-4w4s2T12NjELRAoOG2DyOBFusnOgQQ&oe=6AFDD5D7"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_4z7xOtQegQ7kNvwEaGPDF&_nc_oc=AdrKFEHrmx8Zc5cf9HmEc0xp5Nmamo4mTmz6uvgq93MhJRxyoX7ky5Seiu73xgwnkz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREQG0ycE6992-ReTOpJ_DDCrOJku6PYpf5QZ1sylWwuA&oe=6AFDD2D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWH3r3XjoaAQ7kNvwF6nu3J&_nc_oc=AdpsnLsR_PzNG51r1PbKDdNe2VEqjOllfQZiJzGF9HrHrgqJsIAl7R4yQJqXumuBnWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVOtnYcIsc3bG4-ZW-oBt_Q8DkcRDk-k8T3qDsTjSv-w&oe=6AFDD57D"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
-7&_nc_sid=6e7a0a&_nc_ohc=bDaDpN0UfEwQ7kNvwG9tRtG&_nc_oc=Ado8-qXOjt5hZXJjBpfDo5QkaEe5njysn6UZVnqdEn3pk3Gc5XFUhijCIJyidNqDwM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4jO8qMv2hw6evcvpdMOH9wvB_1nL8aMKZcTgdDdi38g&oe=6B071C31"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4qgdddwNsQ7kNvwEzXA9d&_nc_oc=AdqRCtRhvlxtexFKXVAsqlRT7QJq5Bx9LIiFv-Rae3buSVi5JgjAkVfi-vEOP3Tes88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO88_D-C6BQweJ5i0VUaUclQ9_Acx9DLh51z417mSMww&oe=6B06FEDA"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heoMr1iKRXkQ7kNvwG6g9Mz&_nc_oc=AdpfgwMBuYUaWLK1xAn3Gq4__7J-c_OqN4rpo_wLycZlyvFaTpiWgHzqegVQFQk-Ezk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrNYbexmZ9ms0YVVBG7w6Pq2UKkZe-9im62wvWAO7SGg&oe=6B071057"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcsM3_PJeO8Q7kNvwG6l3lf&_nc_oc=AdowzoJS_eCUOz-FoYfjcIsK-7QKiPyZfmlVOOc3gJOtarqezSg2M1BmLYMp7_5-R24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVFB5GQ7BNi-t6rDjF8gJKD0Phg7uGfCGKsRsn4AE6zg&oe=6B070D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mHuGgqmXdMQ7kNvwFN45ym&_nc_oc=AdrO75pgxyO4KE2mdEU6OeZm6DJoDeIRLcdYknk9LXP9XUAQVNan4rXpyKTatwPfzz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcizGq_r0Bq7mu8BG9WkqCi5MYvaAGkoUX9OjWtoFTfg&oe=6B070FFD"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
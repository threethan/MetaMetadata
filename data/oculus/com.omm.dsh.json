-7&_nc_sid=6e7a0a&_nc_ohc=BOCHrea6reoQ7kNvwHrJawR&_nc_oc=AdqwcoSljkuXoumFqiYlz4qmNeVy5-CRBgn6gOwsnEN-SEsd9K3TCkWk_VIPVpqfRBE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH3bwi3Q0mXoE-b7u7o-yJ6CMZnKBlv4kDtcVhR47Q0g&oe=6AFC9031"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8rA8PkEf4gQ7kNvwHMZL8c&_nc_oc=AdrU__vzowjGOwn0eR_arJCY2xmDRowgRcg3NHhtq_4gJNdAlfKOxWr5s4OurmIP2_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8__BFU7oDHq4YpE39_1hHtYKiqcQPx_lCPPrcx_OmMg&oe=6AFC72DA"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJG6po7ryqUQ7kNvwG4MYRm&_nc_oc=AdocS_fbiftmfoq21A1lr5yj7z4DmK2Jdq-MIOTD6MVRM-6fWWsuy0h85nRfc_T1qNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtQskNGbPXsQTeREErwXRxrvhd1FEnXp5Eryh0hTf8AA&oe=6AFC8457"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylteDNLQYxcQ7kNvwFTybXP&_nc_oc=AdoTPVx-b7CY3mExiOsRDHomdl0F8UUMYdvRaVA1DuBrX0G0uiTkLFlQJoh5LuD8tlQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnJCpMzSQ0ze-Djt2D8QGJanTr_8HPsyRNBltKIBkZfA&oe=6AFC8153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxhuBZhrEMsQ7kNvwGivmbF&_nc_oc=Adp_LnXics7u4BFwwslfpXYhZZYOqOxr8trwEGm5TPrQbA45NWrh55c2_eW5VYmXTds&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLo-QTF3VHRo8MZZyJ3iiCsXAfP9QhfUVM_W9ehGvSQw&oe=6AFC83FD"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
sA&oe=6A881BB1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=669R-9XiAaYQ7kNvwHBKD0_&_nc_oc=Adqvg767Yv1qbTpEq6OLT54pK_2ULAVlT7VwbMWqJgwCEDwFvqZV0HtMqSN9k01lbtI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbBY_6aC856pE08kJq8YAahJcvBKj3rKEtpYEkgmeaWA&oe=6A88369A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66B6kJ2D6ikQ7kNvwFArm9w&_nc_oc=AdrntsOMbUlS39ML73-9HvSGVMW35CrHoLjhZLXzNF-3-MH0lhT5dL0PHZjTl_TIafc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkBhl6qTBU7b0Td6dk0r16_OIYC9tVyjiq0zDJRLZn4w&oe=6A884817"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1Cxq4ZJkMkQ7kNvwHevA4f&_nc_oc=Adqn5MtqTYK2X38O_6iza4c2TxdkOVMLjCeX-ERNjtl6I7kc2GvCLaABYwRsdpegRh0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmoohjWleQZbN9KBE_f8w_nDthF8L5rxVQA_4Fk9qm_w&oe=6A884513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9e5aPbPp1oQ7kNvwGbT4uD&_nc_oc=AdpEG4iTJ5uOHwt_4zVmH8nQcJhqTj5qG-E7p_fwSjUCbQpt96Na6eg5MHDnwx5gpQE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDtfznhvwpJlUktz9lKrjM7yBBPlNS6Xj1b5VHIegJ3g&oe=6A8847BD"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
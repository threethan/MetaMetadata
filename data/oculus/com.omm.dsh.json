-7&_nc_sid=6e7a0a&_nc_ohc=hSNSqlP_CuYQ7kNvwEaWatu&_nc_oc=Ado0EOo-iDA0mwVP-5QpZXZWD0Eh1US9ueMnC1M6HgNPLvJwQh5_AJAfO7gLowk7inE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6iOpUawf6lRYyQp44bTWQm2tAPYzmHtJMGAw0abCtVg&oe=6B047931"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyMWkF0iYDIQ7kNvwGynwqk&_nc_oc=Ado3yjUa1EMPkkG_TvlansAuBdEOqPjGp8-lsGGNDY-0cJbuXM16-2esA5nZ8Kh55FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJcIC6B3MxlqOO7X-OPixbUKzbyhFrlYD2CdCPWjxY6w&oe=6B045BDA"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heoMr1iKRXkQ7kNvwFysugJ&_nc_oc=AdqXcPWCPZN7wOOSI7d10R50x2NSYxushmOiZJnQovuhgVlCFd7Zr6BitUYncwEz4Ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQByXHJgtLwZwe8RfbCl14TxUYssrUVmmhpRtla7PU-8w&oe=6B046D57"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxRp3Xs0OAYQ7kNvwEq8Sm4&_nc_oc=AdrN0vRMy9bUYCnA_evUPNUM8m6xGQKrg8JqJUtLW4bv4Y_KwVy3_eqJdtopqLkRiNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfnb7paII-3Gp2DH2tXNEJDjRRqX4f5-F0Il6W8czlsQ&oe=6B046A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHQDAnTMVIwQ7kNvwFPznN5&_nc_oc=Adrf0Hk6goV0wRczbOPEBshXcpfF1Om45i90FMF_tTA1AdfZ4LiRlR14_CpmOU5CNwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXMC8xbS5XonWH5V0gumF9qWH-6levUSDOIF6EC3E5qw&oe=6B046CFD"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
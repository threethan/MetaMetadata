-7&_nc_sid=6e7a0a&_nc_ohc=-EPYtUN5cskQ7kNvwEtVcOh&_nc_oc=AdriWeqRF2JEQsyvPbEtAIqHc4kaexrvmC3rrywS2rUvY_2Hl5YpiOZHbWITITcL6-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4YlG0bWl8Xgz2qQ9iD43pDpg08KvJ-2WYfk3KkPfZ4w&oe=6B1056B1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0B970B1eSsQ7kNvwFx2gIC&_nc_oc=AdroQNTl71wAsanF3tBHZjaz6Y8gTLzhMubtmNL4cf3WrhLjdz2E3qMaOxU81CSOZxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUe3cFml5E_aIQVXvjewxNDHyahMzh4C4zgp4Pl8HSuVA&oe=6B10395A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnUUorMplRYQ7kNvwGDGxRE&_nc_oc=Adrq1hPVUy6uWqEJAXMQ8t-8QUa7JY6OCR6ZZXh2Y2Aitc2H2sZ87EhYAAT-VL6f58M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6ROl0esdNjZLZYslmTS6Xt5pHbSUXDNIkFSNohJs3FA&oe=6B104AD7"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Vf09MjFSoQ7kNvwGINQ1_&_nc_oc=AdrDL7VqTL2GvpKp0GQ4Oc5ITBs7dH0JpGdH-fSnSYGeP73lHYVkAufuFK2w9s9JeCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX76nhL_RGmR7RRTwFMgUipW34Gv7Dba0ImDYwC9DHk9A&oe=6B1047D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM1DdHi_wXMQ7kNvwGmiYUA&_nc_oc=AdphJufml4KCrqWSf9CIv2Obl2MrjL7Xce_tlVTlmx-Jk2bMoFLqwnL0zzlAaajBGto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0ZSutJb6rY6Gq03AV20LO2inJI5uVzdiUEpvSoY7iiw&oe=6B104A7D"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
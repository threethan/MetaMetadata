-7&_nc_sid=6e7a0a&_nc_ohc=BOCHrea6reoQ7kNvwFaZpJU&_nc_oc=AdoBwpsv-QzhBjGPc7y9BzmnvFdlfP4vjtJHXWYhiGd-r1wSUEjKx0Pjlqz4--K0s3M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL0HtpBX4NGjnxGwuKVoX056Ig88onfo0BxiEN6gKNKA&oe=6AFB3EB1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8rA8PkEf4gQ7kNvwEPkbct&_nc_oc=Adq3rBJ_vGly1ApQA_Syfhp7VfYgA4YWmTxLQSWVr2Vb5B0SN-onLz1gyt6PTBZ9eCU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7JNj_tufKgbTYn5pM9LxqDEqOpy7HMUHZf0_t2-jYFQ&oe=6AFB215A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie4BRPx2HtUQ7kNvwFAuaFA&_nc_oc=Adpyqypbr_2G_dRyAgBj2cPsHrHLeTtXabRYO7ED-nMO0tUquEgZDw9zqN7iAyUGBxg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCaxybWlLuZgN5h7MqNFKH3aZHrQOwFzAobor1oUUlVw&oe=6AFB32D7"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylteDNLQYxcQ7kNvwHMpRQ0&_nc_oc=AdoMayBvytix5_k6rbOKlQ25Xn78lTdZoKuImV3ZR7dqQA9pT2dBZmk6mSfVVib5lM0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRMiw9TxapFYZbKreqdzUv_HDhMRJNaV-XgV64Bl-NMQ&oe=6AFB2FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxhuBZhrEMsQ7kNvwG5wNgN&_nc_oc=AdqiSclHsTtbUPuD9IwRdFMPt2ZIOEIKSAV7VKC97GgS1_7bDcJKid1_VqiCNplEmeY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYfte3Xf7QUjOWzDQUdP4N4EdJTDcQqWxwEaVoTn30vA&oe=6AFB327D"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l51tmzsZZlEQ7kNvwEc7oG3&_nc_oc=AdpydX7F4Smqr-NPPpylZsxpLnhIMyFHVXqpfNfF__Fgx6ZcRl7i1uUp62oULT2yKwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTclBiFB47-j1DiA2mBVmyqqoe0vN3s3yUGQ0jr-BmzHQ&oe=6B08650E"}, {"file_name": "5.png", "id": "4213680111993947", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86615891_4213680118660613_3546102750087524151_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDaDpN0UfEwQ7kNvwE8o9Ag&_nc_oc=Adpqw87v8Xtj3EtstFlqS35HX5ffKEfqjRELkeguwrZx7Lfw6oeOnrKPZ00KJiiuQug&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPJiV1aw8nyeIvAwZTXvIX-ZRg9PoztxMFy4eyXk_aSg&oe=6B086DB1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC4qgdddwNsQ7kNvwHa_FIk&_nc_oc=AdqZCVnj9jm63am16MFiXj5ICLxrFTG5jK4hq7pnh3899T-c85u2_Y3-5eijBPOq1Qc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZGbmGJIno3zeHPo0uGLYJ38uYVkqiq7j3DgPCJN14tQ&oe=6B08505A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR_mgQ7Z6r4Q7kNvwHALdiH&_nc_oc=Adr8nW0OW3AjapFWfZLGIvnWXG4RjH7hFd_beajkSZnF_JdgVcjRrlYpKFU4gib5_0I&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS58xbq9iMT00P6DfcSxK3czWxl4KrvklgFqVydMkPElw&oe=6B0861D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "416533082751169", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_416533086084502_1168309340535307611_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOus_WvjX5AQ7kNvwFBid7K&_nc_oc=AdqT9cT3DiYK43RrD1Yo3soiWZLN2MwjqENZGqmDHMgqyPurWS000oUsqfR-qGz9NkY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaQzhfb_FHa71WYyMaJCmU4o4fEOpqc2hXBC599Mh26Q&oe=6B084D1A"}, "display_name": "Warriors of Titus", "keywords": [], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "exte
-7&_nc_sid=6e7a0a&_nc_ohc=323WkiJyF8MQ7kNvwHUYCdv&_nc_oc=AdoFJLPWKDKP1ItZl7EZweu20hMfBO8OBwbGwxhQHhEZwU7q2jTQyarefgM1Jr3Adow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOTs7hVgTwA6KCd-UPxHUm7jQP00WuYUHIU24u2z7I0A&oe=6B0C6231"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq4U0tL4N-cQ7kNvwHtE-bE&_nc_oc=AdrML_35Ul_EznKTr1rrxS5877VRJyrFptihL8sK79vrrnCRok25MSjymFIwk3gd5vY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJ4spcnUKAeNnR40t6GUiskcdYOybrJvRyNvIsesDrEw&oe=6B0C7D1A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TnVbnlVsH4Q7kNvwGn4m9q&_nc_oc=AdpMy3f977c0X-8kFI5dzWh8CtrL8cs-tai3NWe7tYOBY8Mh1byyW9Ok7i5U6045qag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_0Ts7tVRbvbSTWZWAMb-qG88VjG-n7szEDiSQ8XEXKQ&oe=6B0C5657"}, {"file_name": "screen_2560x1440_2021-05-12_15-40-39.png", "id": "220938679831583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647712_220938686498249_7801220752112635356_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qsq71IRoYcQ7kNvwGlX-kN&_nc_oc=Adp-3_C7g_zFmBhQSx-52s1pjD5xqVLip3s5mibdzJpL0rxCYFvFxsDnQu2WfrnauOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPe7rHRRSjalhOywoAHuhj6u6QBLl37RC3oCNk74s1-g&oe=6B0C5353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "135923568529550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974907_135923571862883_3199946231331623829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwG1zW6ZS5kQ7kNvwE-oJD7&_nc_oc=AdrwfXV4EKEEzur0fViih1PROaPxxv5R_zmSTCw5Pf3trP8mDZHOKw9qO7xyzigjq18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDhzLv1B4FYhxOt0uhw7o_c3mOMrYSp7jZX0ZuU_W8sA&oe=6B0C55FD"}, "display_name": "Warriors of Titus", "keywords": ["moba", "coop", "hero", "fps", "abilities"], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy3.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DynHZl4qob4Q7kNvwF81nM4&_nc_oc=AdoqzZi6A-5S7iNZwk4JXsXgP-DwvBO8-FR1czE_hdGpUrq5nhHOK6AuALfwDcI47Cc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXAHdAwGb-pvjgLwu9aX37RsCj5Zfms5nDrRUFZ0Y7SQ&oe=6B0DAB0E"}, {"file_name": "5.png", "id": "4213680111993947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615891_4213680118660613_3546102750087524151_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=323WkiJyF8MQ7kNvwGY-NTd&_nc_oc=Adpir1S2xfrh9A7sNP08xD4xfw4szn-FlH1E7HaDIZkrvehB2wRZsJb_a4fVP_Gk99U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbLBxFHU1YHtw6abtNcuW-o06sdzKZeAIIi9koB2KdnQ&oe=6B0DB3B1"}, {"file_name": "3.png", "id": "447468456450147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75361355_447468463116813_4774713111633019451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0B970B1eSsQ7kNvwFTQ8Ye&_nc_oc=AdpqNxyxlWJz5BsqSN43Azetebneb2ciBoerrOBKX_8E4VKkwZzHtrOR2iU9uUEWWAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQc-l_pXULKxIByObBjrv7BdrsoF1muYTssByr8XBXF7A&oe=6B0DCE9A"}, {"file_name": "1.png", "id": "1857148367766629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422390_1857148374433295_2744357415409395960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TnVbnlVsH4Q7kNvwE3IAhe&_nc_oc=AdpFYCGbY7ajNBYGPgQhmKbf9l0yjlRqt_5KPpEOm3mJyQV33vlddKpOVWYr79kxfQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNmMAwqr1ibeJBwKXQWLeiheFI2XEowE0l37HgqcH9HA&oe=6B0DA7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "416533082751169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974497_416533086084502_1168309340535307611_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8waN2EiRvsQ7kNvwEJ8IP7&_nc_oc=AdrMGPltI0UJ6htD8pcSCj3mK8w-wrUXsjCErKKJCFfqoK7xkuXETtPzGpatBWYx8Jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ8TqFVSASJVRLuAYamLloJPTYTzgw_qwuAf2S8zT38Q&oe=6B0DCB5A"}, "display_name": "Warriors of Titus", "keywords": [], "long_description": "Each match is played between two teams of three players with each team defending their own separate base on the map. Either team wins by being the first to destroy the opposing team's base. \nEach player will control a powerful Warrior. The game features a growing roster of Warriors, each with their own ability set, weapons and upgrades. Players gain experience from destroying enemy Warriors, their defense towers and enemy minions that roam the lanes. \nThis experience can be used to level up your powerful abilities in the order you choose. As the flow of each match will help you adapt your Warrior each level to help stay ahead of the fight.\n\nFeatures:\n-14 Champions (with many more in the works!)\n-Online Leaderboards\n-Cross-play between different platforms\n-Ingame voice chat\n-Public and Private lobbies\n-AI bots (to fill out empty slots or to play single player) with multiple difficulties\n-In-game achievement system\n-Multiple locomotion styles\n-UI customizations", "short_description": "Warriors of Titus is a first-person MOBA (Mutliplayer Online Battle Arena)for VR. \nFinally you can be immersed in a MOBA as you battle to reclaim Titus. Play with other players or AI across multipler platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dshitems.s3.eu-west-3.amazonaws.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Martin Kutlak", "support_website_url": null, "website_url": "https://www.facebook.com/Warriors-of-Titus-106923694682026", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "exte
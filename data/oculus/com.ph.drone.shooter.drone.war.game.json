{"file_name": "5.png", "id": "3977542819203722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_3977542822537055_983184235572884497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYEBgdxO768Q7kNvwHq0--A&_nc_oc=AdpDV9Q7w-rp6mxvjXH_2L58ka3y7AjbUY3JCAM4JUVgmi_yiKfat-bHDje3vBO_oz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMGn-zz1isv_EDckpxXI-Jfa3I3wbEpUc9dwtnYRhvkQ&oe=6AE9E4ED"}, {"file_name": "3.png", "id": "1825859004750226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_1825859011416892_6388971437394123528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0NZymea-hYQ7kNvwH98E5t&_nc_oc=AdrFOIAvhz8Eu4A5mcqt4YoVrTAon7p-r3v3u-ggR8-oYBMjS0C-ScWbbAWhES56-vA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9I8NcCf5PL7ViOEYFhnuj1YQVKkblFXihEm-GcKgOwg&oe=6AE9DE59"}, {"file_name": "4.png", "id": "1624952618535885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1624952621869218_6844654632383014972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H5rw-QpRTgQ7kNvwGLfKlU&_nc_oc=AdoROtWR9pqWm7MzP_7nmed_h0XXV7zqsOhdP-wT_HmtWzV2PSfAmlFwCafQVu1vT5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsk6B5sP-pIVSaYM9Cec_M_83q0Z-HJJvvrzlH9AAh0w&oe=6AEA0AEA"}, {"file_name": "2.png", "id": "1200283628759476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1200283632092809_3354822371624304788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td1X7nH3pd8Q7kNvwEM8reg&_nc_oc=Adoewu0NKBptFIvB1TdC91WmteYf3641Nlcrh3V9yhn7_yewMHjX2cBmsOdXSlvFmC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj9fBkARpS0Yb8hoGl6YCM90bx87gfZaKnYXLh2NbYbg&oe=6AE9F838"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Hunter \u2013 Gun Shooting Game", "keywords": ["drone", "shooting", "gun", "ariel", "action"], "long_description": "Drone Hunter \u2013 Gun Shooting Game is an action-packed shooting experience where your mission is to eliminate waves of enemy drones before they overwhelm you. Armed with powerful weapons, you'll face fast-moving aerial targets that attack from every direction, testing your aim, accuracy, and reflexes. Every mission becomes more challenging as enemy drones fly faster, attack more aggressively, and require precise shooting to survive.\n\nBuilt for Meta Quest, the game delivers smooth controls, responsive gun mechanics, and immersive first-person gameplay for an exciting combat experience. Track flying drones across the battlefield, react quickly to incoming attacks, and improve your shooting skills while completing increasingly difficult missions. Realistic sound effects, satisfying weapon feedback, and dynamic aerial combat make every encounter engaging and rewarding.\n\nKey Features\n\n- Fast-paced drone shooting gameplay\n- Realistic gun mechanics and smooth controls\n- Challenging aerial combat missions\n- Multiple enemy drone attack patterns\n- Skill-based shooting with increasing difficulty\n- Immersive first-person action experience\n- Optimized for Meta Quest performance\n\nLock onto your target, eliminate every drone, and prove your skills as the ultimate drone hunter in this thrilling gun shooting adventure.", "short_description": "Drone Hunter \u2013 Gun Shooting Game is an intense gun shooting game where enemy drones attack from all directions. Aim your weapon, track fast-moving targets, and shoot drones before they reach you. Built for Meta Quest, the game delivers smooth gunplay, immersive combat, and fast-paced action. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27433260359255
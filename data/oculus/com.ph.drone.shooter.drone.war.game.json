0f&oh=00_AQT9I8NcCf5PL7ViOEYFhnuj1YQVKkblFXihEm-GcKgOwg&oe=6AE9DE59"}, {"file_name": "4.png", "id": "1624952618535885", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1624952621869218_6844654632383014972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H5rw-QpRTgQ7kNvwGLfKlU&_nc_oc=AdoROtWR9pqWm7MzP_7nmed_h0XXV7zqsOhdP-wT_HmtWzV2PSfAmlFwCafQVu1vT5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsk6B5sP-pIVSaYM9Cec_M_83q0Z-HJJvvrzlH9AAh0w&oe=6AEA0AEA"}, {"file_name": "2.png", "id": "1200283628759476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1200283632092809_3354822371624304788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td1X7nH3pd8Q7kNvwEM8reg&_nc_oc=Adoewu0NKBptFIvB1TdC91WmteYf3641Nlcrh3V9yhn7_yewMHjX2cBmsOdXSlvFmC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj9fBkARpS0Yb8hoGl6YCM90bx87gfZaKnYXLh2NbYbg&oe=6AE9F838"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Hunter  VR \u2013 Gun Shooting Game", "keywords": ["drone", "shooting", "gun", "ariel", "action"], "long_description": "Drone Hunter VR \u2013 Gun Shooting Game puts you in a high-pressure combat zone where armed defense is your only option. Enemy drones swarm the area, and your mission is simple: aim fast, shoot accurately, and survive.\n\nUsing realistic VR gun controls, you\u2019ll target drones flying at different speeds and angles. Enemies attack from all directions, forcing you to stay alert and react quickly in full 360\u00b0 virtual reality.\n\nDesigned specifically for Meta Quest, the game offers smooth performance, responsive shooting mechanics, and immersive sound effects that make every shot feel impactful. As you progress, drones become faster, smarter, and more aggressive\u2014pushing your reflexes and accuracy to the limit.\n\nWhether you enjoy VR shooting games, target practice, or action-packed combat, Drone Shooter VR delivers nonstop gun-based action in a futuristic battlefield.\n\nLock your aim. Pull the trigger. Destroy the drones.\n\n\ud83d\udd11 Key Features\n\ud83d\udd2b Gun-Based VR Shooting Gameplay\n\ud83c\udfaf Shoot Fast-Moving Enemy Drones\n\ud83d\udc41\ufe0f 360\u00b0 Combat \u2013 Enemies from All Directions\n\ud83d\udd79\ufe0f Smooth & Comfortable Controls (Meta Quest Optimized)\n\u26a1 Fast-Paced Action & Increasing Difficulty\n\ud83d\udd0a Immersive Sound Effects & Visual Feedback\n\ud83c\udfae Easy to Start, Skill-Based Shooting", "short_description": "Drone Hunter VR is an intense gun shooting game where enemy drones attack from all directions. Aim your weapon, track fast-moving targets, and shoot drones before they reach you. Built for Meta Quest, the game delivers smooth gunplay, immersive VR combat, and fast-paced action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25653623240973916"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bin
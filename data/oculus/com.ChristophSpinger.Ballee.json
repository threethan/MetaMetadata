c_ss=7a30f&oh=00_Af1d951nAlu9JxzhMK69c_HVY7QFLH1aMVAe3HVOUvWXtw&oe=69DCE0C1"}, {"file_name": "Screenshot1meta.png", "id": "1802921690583921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824012_1802921693917254_1201217173549534783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p9HWLXqiTIQ7kNvwFd3B1e&_nc_oc=AdqZRSCft966eQa_2yGB31kfi7rNNFyvHrFBAuKSeiGfbz0ufjZgi9glPH_Ovksl7ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ciOTnYoIAqbcP9rylNRkxlm_op2KQQVu10jcyYz7liw&oe=69DCECF7"}, {"file_name": "Screenshot1.png", "id": "1003576345192681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1003576351859347_8199833366450196121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j92n4gN_sIEQ7kNvwF-D_8x&_nc_oc=AdqzCp67Mw3zUlxWChNqgCm3r2N3yJ1k3Q6pLPyiyq3ErS_FukO-IFURu4SEyTy5gXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27By6Y0YM4oR4Tifu_T3xr7xxFS4w-Qdv62dpIdtcQ7g&oe=69DCCFEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot5.png", "id": "1292930059137692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499311574_1292930062471025_7453338022040284655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ue22Y6Zq4gQ7kNvwESDEjE&_nc_oc=Ado9a2JN_bFF_WA7-67O7NrAZ7r18T4_togoDtc37gJCE2MLWesKihaL0Bvm4azbh_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BeR8jdfqyUOyi1PB8BNe04qZGXJKBeb4CSvzz6F8Snw&oe=69DCD6BA"}, "display_name": "Ballee: The Sandbox", "keywords": ["Passthrough", "Soccer", "Ball", "MixedReality", "Sport"], "long_description": "Ballee is a very experimental sandbox that brings any real-world ball into your mixed reality space. It is not a polished or finished product, but an open playground where many things are still unstable, unpredictable, and constantly evolving. That is part of the fun, because it invites you to try out what works and to discover completely new ways of playing. With the integrated map editor you can build your own obstacle courses, practice football or handball skills, or get creative and attach your ball to a boat, an RC car, or anything else you can imagine.\n\nBallee comes with a variety of elements to experiment with. You can collect coins, race against stopwatches, weave through slalom courses, or smash through glass and walls. There are also game modes inspired by curling, bowling, and other sports, all of which can be mixed and reshaped with the map editor. The experience is full of surprises and rough edges, but it offers endless possibilities for playful exploration. Ballee is also one of the very first games on Meta Quest to explore the new Camera API, making it a true experiment at the frontier of mixed reality.", "short_description": "Ballee is a very experimental sandbox that brings any real ball into your mixed reality space. Many things are still rough and unstable, but that is part of the idea. You can build obstacle courses, train your football or handball skills, or try strange setups like attaching your ball to a boat or a car. Ballee is about trying things out, seeing what works, and having fun with the unexpected. It is also one of the first games on Meta Quest to use the new Camera API."}]}, "developer_name": "Christoph Spinger", "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-ballee-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://www.xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
c_ss=7f20f&oh=00_Af8Qb-oF2urXN5fB6ddVGB11fFaLLVt7HTHfmIuoTABAXA&oe=6A21A701"}, {"file_name": "Screenshot1meta.png", "id": "1802921690583921", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824012_1802921693917254_1201217173549534783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4dZ8_Qe2LkQ7kNvwEyqaP8&_nc_oc=AdomGMBz_ZUu7HoogKABEkvaoc1eLjIji0xksmxBd_vu5M1qJuLSQCWPjRFc5W9fty0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yD_w6D9PVHZxJEYG3bjwPF0eu6TY9KDKOU1WO4H4WLA&oe=6A217AF7"}, {"file_name": "Screenshot1.png", "id": "1003576345192681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830003_1003576351859347_8199833366450196121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHg5J8YvCUAQ7kNvwHNtZjI&_nc_oc=Adpjhi1QmyNPq2K3TAmfQBgBc-2liNphKWqomNOCurt20SsfRXZIkJt3jOXWT6p1h9o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VY_mOti7cZ1lLkuaq3sKaC3XESoWuO5bsx_eE78EUZQ&oe=6A21962C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot5.png", "id": "1292930059137692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499311574_1292930062471025_7453338022040284655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6eJyaOVeloQ7kNvwG6ypIw&_nc_oc=Adr-PALHs4fUxCm7FIkor7P_eEYZEr8apd69HfOntJ7D9BKDNLA6GshJzRKMvGeRn_4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yx8xf1zPC-gJ1l3vQzAgmnti-bsXmhSB1U9u4WJWmvA&oe=6A219CFA"}, "display_name": "Ballee: The Sandbox", "keywords": ["Passthrough", "Soccer", "Ball", "MixedReality", "Sport"], "long_description": "Ballee is a very experimental sandbox that brings any real-world ball into your mixed reality space. It is not a polished or finished product, but an open playground where many things are still unstable, unpredictable, and constantly evolving. That is part of the fun, because it invites you to try out what works and to discover completely new ways of playing. With the integrated map editor you can build your own obstacle courses, practice football or handball skills, or get creative and attach your ball to a boat, an RC car, or anything else you can imagine.\n\nBallee comes with a variety of elements to experiment with. You can collect coins, race against stopwatches, weave through slalom courses, or smash through glass and walls. There are also game modes inspired by curling, bowling, and other sports, all of which can be mixed and reshaped with the map editor. The experience is full of surprises and rough edges, but it offers endless possibilities for playful exploration. Ballee is also one of the very first games on Meta Quest to explore the new Camera API, making it a true experiment at the frontier of mixed reality.", "short_description": "Ballee is a very experimental sandbox that brings any real ball into your mixed reality space. Many things are still rough and unstable, but that is part of the idea. You can build obstacle courses, train your football or handball skills, or try strange setups like attaching your ball to a boat or a car. Ballee is about trying things out, seeing what works, and having fun with the unexpected. It is also one of the first games on Meta Quest to use the new Camera API."}]}, "developer_name": "Christoph Spinger", "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-ballee-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://www.xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
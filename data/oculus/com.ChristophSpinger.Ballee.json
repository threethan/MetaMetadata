c_ss=7f20f&oh=00_AQLaxbFBLhkfnPB-JvTTzfAOAvkGBGUBpQRg1HOsTKTTvg&oe=6A999F81"}, {"file_name": "Screenshot1meta.png", "id": "1802921690583921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824012_1802921693917254_1201217173549534783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T--oOqtWoNwQ7kNvwEi19yL&_nc_oc=AdpWr6tZJdtTW4dorMviQDRHumBzgzvDqDOEZMIxiAyra5dGiV0M-QkLg8ZZ40J4Mrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYU4ms2KtJ_238NKdwQVsJ0CcMplgQ9Gsjj6P5Wbr5Dw&oe=6A997377"}, {"file_name": "Screenshot1.png", "id": "1003576345192681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1003576351859347_8199833366450196121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDkLJF0l7lwQ7kNvwEqjsV5&_nc_oc=AdoENdvRnzxtbitXX2ZvJ-gOP4B61F8uSVLj0q2_KYuW19UaDQpaBicH9VZ5fEfrFDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKClwbwARIXgpgEJfX2pC-BawMQdGxRYNlaawgKAiFiJg&oe=6A998EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot5.png", "id": "1292930059137692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311574_1292930062471025_7453338022040284655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2_Aq2GIfwAQ7kNvwFJmRn3&_nc_oc=Ado_DpNR5VuP8IgiKEPAjIM-wclIzLJ1V1fcMU4oBimrkIokH0fCte04xqbNKVoBTgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNBOkUKKqDxDEcykX0OQOrF--oJWxYIUqI426SXvLCrA&oe=6A99957A"}, "display_name": "Ballee: The Sandbox", "keywords": ["Passthrough", "Soccer", "Ball", "MixedReality", "Sport"], "long_description": "Ballee is a very experimental sandbox that brings any real-world ball into your mixed reality space. It is not a polished or finished product, but an open playground where many things are still unstable, unpredictable, and constantly evolving. That is part of the fun, because it invites you to try out what works and to discover completely new ways of playing. With the integrated map editor you can build your own obstacle courses, practice football or handball skills, or get creative and attach your ball to a boat, an RC car, or anything else you can imagine.\n\nBallee comes with a variety of elements to experiment with. You can collect coins, race against stopwatches, weave through slalom courses, or smash through glass and walls. There are also game modes inspired by curling, bowling, and other sports, all of which can be mixed and reshaped with the map editor. The experience is full of surprises and rough edges, but it offers endless possibilities for playful exploration. Ballee is also one of the very first games on Meta Quest to explore the new Camera API, making it a true experiment at the frontier of mixed reality.", "short_description": "Ballee is a very experimental sandbox that brings any real ball into your mixed reality space. Many things are still rough and unstable, but that is part of the idea. You can build obstacle courses, train your football or handball skills, or try strange setups like attaching your ball to a boat or a car. Ballee is about trying things out, seeing what works, and having fun with the unexpected. It is also one of the first games on Meta Quest to use the new Camera API."}]}, "developer_name": "Christoph Spinger", "developer_privacy_policy_url": "https://ararcadegame.com/data-privacyprivacy-policy-ballee-meta-quest-app/", "developer_terms_of_service_url": null, "publisher_name": "Christoph Spinger", "support_website_url": null, "website_url": "https://www.xrchris.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
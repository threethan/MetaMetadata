FC826D"}, {"file_name": "05_Gasolinera.png", "id": "2169737940636466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_2169737943969799_6362261812128133955_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUncVJUnBqEQ7kNvwEkxrh9&_nc_oc=AdpyEBiWHd--68EyiNOToLwgYLwh0YLg3Ya4_0_rHlpPGZkEla2o46c-7YbNh603-4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5psUbYFsCqEbh9dhEtYPTareaMqB1IdG4Jk8udAvJSw&oe=6AFC7746"}, {"file_name": "02_Aliens_en_el_bosque.png", "id": "1849145802743001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831393_1849145806076334_1944039863713550789_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg2q00uoccwQ7kNvwEy2fea&_nc_oc=AdqgYaJDGiD9HP1D7hgxXPb88OGCutBXoTtiT0eEeLDzQzqoqsPn6gnNfpYU9Nog14g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpVizKuTqFH8JH5psp_MIm6qK2407DLLMToLY91B_3wQ&oe=6AFC5F12"}, {"file_name": "04_Todoterreno_4x4.png", "id": "1849553712954289", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604317775_1849553716287622_7706028167004997179_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOrcODdrhusQ7kNvwF1KRH9&_nc_oc=AdrRJK7WoUPZlBlcq97MAAu7iJQkk80JzFs2YQHc20iCJk8_CGEwAFN9J8rSi5i1DPM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD5r7jedefdL_qQnEt7NLrk20VCLLNSEL11RJOM9U25g&oe=6AFC715E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THEY KEEP COMING", "keywords": ["ALIENS", "SURVIVAL", "WEAPONS", "INVASION", "DRIVE"], "long_description": "Something has crashed in the woods. You\u2019re stranded at your ranch, and the creatures keep coming. Your only way out is to call for evacuation and survive until help arrives.\nTHEY KEEP COMING is a single-player VR action, horror, and survival game. Explore a valley at night, searching forests, cornfields, and abandoned buildings for supplies and weapons. Dare to enter the crashed alien spacecraft.\nYour home is your refuge. Close the doors, prepare your equipment, and check the map before heading outside. Handle weapons with manual reloading, store ammunition in your backpack, and keep a holstered sidearm within reach. Weapons you discover remain unlocked for future runs.\nDrive the 4x4 along the valley\u2019s trails and use its headlights to cut through the darkness. Stay alert: the creatures can chase you, surround you, and climb walls and ceilings.\nFind the battery, fuse, and alien core needed to activate the radio tower. Then reach the extraction zone and hold your ground as the helicopter approaches.\nChoose from three difficulty levels and smooth or snap turning.\nGet ready. They keep coming.", "short_description": "Survive an alien invasion, restore the radio, and escape the valley in VR."}]}, "developer_name": "NUWANDA GAMES", "developer_privacy_policy_url": "https://sites.google.com/view/thekeepcoming/inicio", "developer_terms_of_service_url": null, "publisher_name": "NUWANDA GAMES", "support_website_url": null, "website_url": "https://www.youtube.com/@NUWANDAGAMES", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1597758082413043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/759751223_2361479627927210_7484242575591717949_n.png?stp=dst-png_s360x360&_nc
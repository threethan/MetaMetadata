S3PC17lU1cLUe0yxI-wxE0kifvHCvk3xfHVuVRNA&oe=6AFB3EC5"}, {"file_name": "screenshot_4.png", "id": "4441693079437638", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831393_4441693082770971_1068193621388705913_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBThi2BbAPAQ7kNvwGpJxKx&_nc_oc=Adq04Q3wSywIEjey1lww9f8rEWWTQmmKWhBWMVK0Ga9MXPpXN18Qiual1Y-o89LHigA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC66C5ss8CHLEMLca4-U9LCKcilZb5T0MuWBe3Q4-Dog&oe=6AFB1DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2358532194959212", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/596068480_2358532198292545_7950848954643400804_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M1jEROE7joQ7kNvwEdcb3M&_nc_oc=AdqJzOpomJqS-d4rvjmfTeeZAhc4HFoK4pJmMNcfI_C7h6j7TjeowFg38MZtOkeMqPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo1FVwPjTHwwAHxBhB-dmoyWsX2zM5xTlAspvmRQ1BAA&oe=6AFB3513"}, "display_name": "Flight Simulator Private", "keywords": ["flight", "simulator", "airplane", "island", "jet"], "long_description": "Flight Simulator Private is the private jet life: a white glass hangar by the sea with a coffee bar, palms and red carpets - and two long-range business jets waiting for you.\n\nTWO JETS, YOUR COLOURS\nJet One and Jet Two arrive in different liveries. Repaint body, trim, stripes and finish - gloss, matte, metallic, chrome or pearl - and watch it sweep on nose to tail.\n\nA MODERN FLIGHT DECK\nFour glass displays, touch screens, side-sticks, thrust levers, flaps, gear and an autopilot under a curved four-pane windshield.\n\nVIP CHARTERS\nFly guests to the islands. Bank too steeply and the coffee spills; land hard and the tip shrinks. Stand up any time and walk the cabin - club seats, galley and a private stateroom.\n\nAN ISLAND PARADISE\nA Bahamas-style archipelago: an international airport, a resort town, thirty little cays on a vast shallow sand bank, a deep blue hole and six airstrips - including a short strip on a tiny private cay. Day, sunset or night.\n\nKEEP THEM SPOTLESS\nYour jets come home dirty. Grab the pressure washer and blast them back to a showroom shine.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join a friend's wing or ride in their right seat. Voice chat stays off until you turn it on.", "short_description": "Two long-range private jets wait in your own luxury hangar by the sea. Paint them any colour, polish them spotless, then fly VIP charters over a tropical island chain of turquoise shallows and white-sand cays, with your guests in the cabin. Solo or online with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorprivate/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorprivate/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346647045194825"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_t
-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1527425252406200_5516006319916835451_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QvpTqdJyCcQ7kNvwGIzyXt&_nc_oc=Adpt-tpDMN6ojoVmH0sgvEP0GW1adsDQBWizskxLEoJ_9Mq7svokn2WKIItilgLyt5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE8BiY-4QwXTOInttYlR4DWuUzrKPkUAjdMNOGXKEuQg&oe=6AFDB236"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1096929559933613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_1096929563266946_8494349220064071169_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je-G441RNqAQ7kNvwErioAT&_nc_oc=Adq4msOhg9-LL7yZnXVA_58EJvjYg5D1pMpQNqHX1BJXJhSv1lJfZdZgcAcNBEXk74M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp9rZA35rLw_4ZYjX0Q6xekiWLqoxBmVIc5hXUQLCHKA&oe=6AFDC79A"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1100908185738594", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1100908189071927_27349885865431327_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvbrc07Rdp4Q7kNvwF1oZg7&_nc_oc=AdoLdq_v3pDIwJh7cKUyyP5DqVHTaKsHVrciXiD4FVzKepKpwxSOlsmIiwv0CXAAl48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAXYlNNaBBxC-mV88oBSZpG9Fnh-bOcG5CFfdwHBu1qw&oe=6AFDC5F3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1110847971290736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_1110847974624069_8707734217392993101_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q9WnkCJWTIQ7kNvwFrPEWK&_nc_oc=AdpH6Nir3dvn6532oU9-YoZoRnyO5f1_NdYhJRYxhebXwg9G0NXhgnxWS1IL46vK1-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqijU-zTdsdyczOGEKpq1XU2TmPgK5G6YvFWNQ1fI3iw&oe=6AFDE2B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1069143952530085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673652249_1069143955863418_7934088300497871550_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2MlMsXt_e8Q7kNvwEkhhG4&_nc_oc=Ado-eGNxAILfkv9FfnP1GxFCI7VAJspBbqicARAqJIhReInYUb_mWsdH68sCM6ENUe8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKyXhPQPSExvsSq2YbAwZBJaXtcsGeGVPi_R1DAjTb1Q&oe=6AFDBCCB"}, "display_name": "Graffiti 3", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti 3 is a spray painting sandbox in virtual reality. Pick a place, grab a can and cover the walls with your own art.\n\nFOUR NEW PLACES\n- Freight Yard: paint the whole side of five boxcars lined up on a sunny rail yard.\n- Tokyo Alley: tiled walls and shop shutters under glowing signs, lanterns and drink machines.\n- Art District: a bright block of candy coloured walls, palm trees and string lights.\n- Storm Drain: huge sun bleached concrete walls and the piers of a bridge overhead.\n\nPLUS FIVE RETURNING PLACES\nA Brooklyn street by day or night, a rooftop at sunset, a subway yard with trains to paint, the Moon and a night stadium.\n\nREAL SPRAY PAINT FEEL\nThe spray gets wider the further you stand from the wall. Paint soaks into brick, tile and concrete, and holding the can still makes the paint drip. Shake the can to hear it rattle.\n\nSTENCILS A TO Z\nA board of 26 letter stencils plus stars, crowns, bolts, hearts, arrows and NYC. Stick one flat on any wall, spray over it and peel it off.\n\nYOUR TOOLS\n- 8 spray cans and a full colour wheel\n- Skinny, medium and fat caps\n- Take a photo of your wall, saved on your headset\n- Clean one wall or every wall with a fresh coat\n- Six music tracks\n\nGraffiti 3 is a single-player, standing experience with smooth walking and snap turning. No account and no internet needed.", "short_description": "Spray paint your own graffiti in VR across nine places, including four new ones: a freight yard full of boxcars, a neon Tokyo alley, a sunny art district and a giant concrete storm drain. Grab a can, pick any colour, swap caps, tape up letter and shape stencils, and watch the paint drip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-graffiti-3.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-graffiti-3.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328115030381360"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_28484982541150594_1119590961010467767_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCG0pepNhhsQ7kNvwEuhhDj&_nc_oc=Adp0497iD4E0HTv995KC7z5HvQHJSn0tNPXwF-3pEH7smtYTkrvdf6gZsaxXvXULvh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlo-ankAlR28Vq9HyIlLnjCJ9ZKPdUQrAMFHpNtfCdwQ&oe=6AFDCEF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti 3", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1789916460, "lastRevision": {"nodes": [{"id": "1328115033714
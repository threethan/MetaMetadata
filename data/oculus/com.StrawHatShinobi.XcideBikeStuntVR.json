_tvSWn8jcEbL3rFeFC5jrXVYBCEWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlO2RVqpkVGhh_FMoCP5IhvwchE1cnOTBacPGwJve-eQ&oe=6A9C29FA"}, {"file_name": "ss2.png", "id": "9536324133132269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392192_9536324136465602_3163904286964325124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDtcf1Wfz-IQ7kNvwHiHzNs&_nc_oc=AdowCxIYeJ9eZRf2E55GS4YB8_J8O2K3W6VWI4GOeyafL-ahKNH53OJoTVrrZ0EiMBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlNrMlVg_Mg13ROTYnYgr-8lD2HEMVJ-plah7Tp1D2Kw&oe=6A9C27A2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pMV-DPwflYQ7kNvwEw8AR6&_nc_oc=AdrB9Fx92x-BCcWEfBNOomCZ779ExziCIpmpWwOu2My6JcICTs4Y6v_RvZCWw0l6QQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiXJjsBf9k2dQswECnUbxFdlUE07bHdItRHcqhSISCAA&oe=6A9C23E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjfJJ66YkXIQ7kNvwER-Nrt&_nc_oc=AdqmDcqMDQlrrxwAQJ0APGWpwoSNN4fGY5zf3qZtMXmvt9LkHuDTDx9rOqdhlPzPoLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrv0rK7Onrke2o_XMagpxeN7m5JC6CJ1g4MASkl5acYA&oe=6A9C4085"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1058296233265697"}, {"status": "PUBLISHED", "id": "1352963072617053"}]}, "baseline_offer": {"id": "1058296233265697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786276200, "status": "PUBLISHED", "id": "1058296233265697"}]}, "liveChannel": {"nodes": [{"lates
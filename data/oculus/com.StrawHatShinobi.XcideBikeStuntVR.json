SAwHOIhKZNME8uWPrJw9RHyMlNXX4uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwcj9ad5y6IjH7eMU5wX92xOX5bwieQy-sohP2VSLpMCw&oe=69B538E2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXGkrdwh0f8Q7kNvwE6afus&_nc_oc=AdkXGjASBy9wX9_qkmQZQiHUbjzMvh7ijBkkOg3cG484yl2ETySUR16XN4QFG1XR-KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3n4yglSZFyAAxZb6zpxzSt7UJzgv0J_jVktY3EPoRdA&oe=69B56D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4ohSTWUs5YQ7kNvwHzi8Dh&_nc_oc=AdmsUmYDImc7F5SLh4NQx5pB2jwBrW0xaiuenlgejRXidarxPA4bhHR_fi6WrNUz5wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWr_Ag7TR8KA51ddzwpjTI0vzYyX3G8xVqnPqs5BMqWA&oe=69B551C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the 
2EmlFl3bDuXOe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08jtlsKgd3UKEvjWcPSWOwmVEGZ3ZiH6VGMH57IaH_IQ&oe=69F21622"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwb-LptIaCkQ7kNvwFo4OSC&_nc_oc=AdoK6Aw4pWpDOJtVxzzI7oG2d6x4mkmL7BvgZR5q8JS1HpUJnF7mhhIEQVVSA0lUDEg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3i7Q20ibT0v07lgmmzmp6a7raYcn9szMItZLD58KsTFQ&oe=69F21267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycdYJhX6DfAQ7kNvwGYJA9_&_nc_oc=AdrWG2xlbz16IFnzsYC0lyIInpxPhZ8ewLGrTxZompoHVwD-XNljp5TvZU14DTO1jFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0czzoIGxIm-JK1J8Sj8GaP0KM9KajbKOxsvVSiUWR1Pw&oe=69F1F6C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and h
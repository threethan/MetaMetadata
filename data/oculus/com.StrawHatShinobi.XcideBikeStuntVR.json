ps://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392192_9536324136465602_3163904286964325124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZbiIShhQZ0Q7kNvwEn74q7&_nc_oc=AdrhzmeLJKekgWlPXidUKWKHSsVrgClqZDQ0muQPkp3LMwo6o3Mvrdbp9zuWJ5Fyt5Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4pA9fjJtmrGsgaGM9JppkAUVWC_jo8G2WwRh7bOWuSQ&oe=6A8828E2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj6Rrp8DGocQ7kNvwGKqL1v&_nc_oc=Adr0a2BR4QuB3KodqS5hQAAi0JI7IndozO3ZWxtMQIx4T2FCKcEb-qWOnFHm-1k-v4E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPolMC1WKWk1bnS3hHj6h9JxTCjJR6nD3P2Biae9OhkA&oe=6A882527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzcKDX1-rzQQ7kNvwEWiLeu&_nc_oc=AdpTdX6VX-Y6lZr2TGzNnoQ04d3ow1Vd9UR1xsJbhkuNHkMUqii5txu5IJoRky4hP2g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0ZVc06qgYMUTDhAbLvh1tNCKVweDSU_bvdScA8oor8w&oe=6A8841C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1058296233265697"}, {"status": "PUBLISHED", "id": "1352963072617053"}]}, "baseline_offer": {"id": "1058296233265697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786276200, "status": "PUBLISHED", "id": "1058296233265697"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27672057352447877", "version": "1.0.6"}, "id": "623581160458106", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": f
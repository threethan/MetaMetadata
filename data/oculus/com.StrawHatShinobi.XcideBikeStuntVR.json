67", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391946_999037839014000_8087121828713291135_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXdCOZPkfz4Q7kNvwG07ovz&_nc_oc=AdqQbdA-iZfg_y3eOeVPLTY2OertEGcayapXUq3Hng9jnL3PyqlBmuvm7XdAJ53EljM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OPtr88jfdqcjinYY44RcZNrVBPfcivs_kPqybpsFQtg&oe=6A033028"}]}, "id": "1197500725025027", "locale": "en_US", "screenshots": [{"file_name": "ss6.png", "id": "706447998545006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393455_706448005211672_5588674527730837758_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNtcpo7zKwUQ7kNvwEK7v1F&_nc_oc=AdpNciCVbzrjIw7wHED1WXgI505tjueftssGqa576Pup0PI8Zu293sFZvrDTBi-5UpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XNCTl1q-NpaJgLypcSxsIpK247SVEQuJzx5LPko7uGw&oe=6A0316E5"}, {"file_name": "ss5.png", "id": "681557044695517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391887_681557048028850_6529426699921324887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T47KOLYrE2cQ7kNvwHrBd60&_nc_oc=AdqVRQ6PCw9Hbi8z9jMzh325BIURX8WZkMHd4FzKWTe3k4CcbNFbyCwFZTrPmJamLb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af718Pa20yENytIbYJmcl7QwUjVVfy2PhICgL9jZjhjmfA&oe=6A033F4E"}, {"file_name": "ss1.png", "id": "1214013270506664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393652_1214013273839997_2849160465745135704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWsKY4SBENoQ7kNvwHPcnJq&_nc_oc=AdpoVjKfdZpn74DDXo0B1nuuPb3P6N5HOSKdp1iPnwc7yINLJsDy1Z9rPf5OOVIrr2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GhDewEsiBABeEuP-9tnfCGhn8enbGVveKApaTMZBTRw&oe=6A033BFA"}, {"file_name": "ss2.png", "id": "9536324133132269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392192_9536324136465602_3163904286964325124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPXoVjKLEaQQ7kNvwGHUCIy&_nc_oc=Adoq2W4VmDK35kOzMfuaAlREiJDlYMFWRbt0oFBeKkEZ_0HYWKseVuRbV2sOQCscNXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50zSAgV7dvkJoxmK8CQCQMT5DP4HHsYPYfF6sF6BaIGw&oe=6A0339A2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73sFy-qe2RkQ7kNvwEgHoxR&_nc_oc=AdoHEDuHzDqwugetgPMPuRWyEd8ZlhAtKNzzC6Pjo1raPK8yx0z8Wq9Fmrosfg4rRrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ql0fyJ2zQrtDa9RXk5VgCVyhIOrUO5Eo10B5W7-2vGA&oe=6A0335E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsWWpTh3m1EQ7kNvwEUXH7m&_nc_oc=AdopnJCTTzVZtOauoCOlcFUsbphl2xKRUl_6NYfQUlwCZjfzxco7YbzBwqanRtnUJuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xNPd2kF_QfxPc5VH937IsqyPZCV1XKHXC3veFegTU2A&oe=6A031A45"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393560_1473741093607342_8915277864502759367_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_v-SdOtfGoQ7kNvwFtmQ6l&_nc_oc=Adpt_K5f50JhQAP6z8Os8Mmr58f9sCPiQwyxudTLuEwaJqbNfkdy3kDmeql_n75Z-tY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uo_lQ3DwHExAsKn8TUZfClSFeghj3fmO4_U4WDX9iIg&oe=6A032CF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SXM Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name
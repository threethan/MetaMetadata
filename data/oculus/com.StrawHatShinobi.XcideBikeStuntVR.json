CwF9QXk-ZmBSAtU8SJcZxw&oe=69A59F22"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_0aiFggVugQ7kNvwFXfRNJ&_nc_oc=AdnK1P465orFRx07wuHyjRDF4MhUeUJLlnbdhFBVi5IuPecQ9xH6_f7j03_-godRpRI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvvtgRlIzg4zUj_sUjUg66aqjhhJlW46904ZQJ2kEKDXA&oe=69A59B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFG6uK4Ao-kQ7kNvwGJ1dN9&_nc_oc=AdmOTFmr_2bciffWRwtbtrkscA8fbr_HzX1rrvVc-z5e27EVxCNkKMOrD0SuaMWpJQo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft53cdn45vkjXFBtNEYMwLg3glY-KcPtrf9_UbnyCxEPg&oe=69A57FC5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are 
KsM8zmX8aESwNOzgPSuOPNcMJoKQWXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs4dfrCv4_tPbPXprMUY6BcfJ3rGO2X4HUbL46qy9HKWg&oe=69A809E2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Rzc6DuC1a0Q7kNvwFVwbOt&_nc_oc=AdlgMhhYY0x6VX8iMo_zdzZubLq-7SOfBs8MiwqpjAGKNNtxQE3Yfo_rJemt8_YdhrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfubSveKR1cblJVq6_pQBWIbk6lWoIRZRaHwxKlwnfLbQA&oe=69A83E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HdW2JFuV3AQ7kNvwFqeTHG&_nc_oc=AdkVAQJtCbtw-XskcohftcarDi-rmHKLcaWjWnxweaZa5eC5yPhdDHTaijcVRjDKmXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDfPyiRWHuAsvZvaEYLDkAs8WNL3KQjSq37CeqoRdbFQ&oe=69A822C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the 
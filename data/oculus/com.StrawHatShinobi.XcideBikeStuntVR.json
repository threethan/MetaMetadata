67", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391946_999037839014000_8087121828713291135_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u7ueDC3wBsQ7kNvwE2Ingy&_nc_oc=AdoAA19vWFQCI9494TrBjmGLCDftSSf-bXJKOfCn5G_zIqHkHTXrQL2qCtx3kZCxVlk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eXdlFpJqa4Dc1GBjXgs0OBOkx4cZtc65bdgI9drtcQQ&oe=69FDEA28"}]}, "id": "1197500725025027", "locale": "en_US", "screenshots": [{"file_name": "ss6.png", "id": "706447998545006", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393455_706448005211672_5588674527730837758_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXMeRzeqfOcQ7kNvwFDkjfL&_nc_oc=AdqhTqzFJi33XNS353KT0apmBUjzHsVr5lZRb-mLBKAqUYb14AD3BpYHmrpUCbQOWPE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EX9fbna1GmP2NHVDL1Jz3IyGYRYnvOemZZbBzb7HwAQ&oe=69FDD0E5"}, {"file_name": "ss5.png", "id": "681557044695517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391887_681557048028850_6529426699921324887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E-Zx0ztPnQQ7kNvwFvjEXP&_nc_oc=Adrx5SDdt7gya89D9HYPs5qosRCUVzKOEp0fHvIP6a6yujqwYr5PGaZDGbHuym3quOQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EfmpjopuCiGNygR1luTIDZp593gySSMiyLFpVZ3IW2w&oe=69FDF94E"}, {"file_name": "ss1.png", "id": "1214013270506664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393652_1214013273839997_2849160465745135704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeLJyZBiMp4Q7kNvwHogQ_0&_nc_oc=AdpLwBxKe0UQrf1OiTzfoJSQn2LvOIFhtQudP09FfKp5G5B29EiRkNNO3va1NxJy2v8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NmHHiaaNuJlodFnBX-qcLORDHD4aQtFRZ9ccthvF3Zg&oe=69FDF5FA"}, {"file_name": "ss2.png", "id": "9536324133132269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392192_9536324136465602_3163904286964325124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69F_-wPxmw0Q7kNvwEBpeCP&_nc_oc=AdpGJAYMcLzPxQySkgGFtywp9_72jm8VM0EIsZTbouwzu5O0ME575IlTjEsaD43duzs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42ziofmJUlK7qNhRThVlKEs8hMYjXSLNGEguqPYNNhfQ&oe=69FDF3A2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kmF3vpOkZYQ7kNvwFOhb05&_nc_oc=AdoY6E_8tlu2-0btunF20OEd1Oc2fSljUIaHMtwi6TKEVVswLQHau4gomyxAqpFGGpA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gRa-shdwalAqAjPkr20vdGUoqOxlAixIH9bg63gWMuA&oe=69FDEFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHmEW7_b7lEQ7kNvwGFzBnB&_nc_oc=AdoFxGCYzVlHpXx1olTRmYMEb0FwwZ1RAIuatc_i04Xef3nI46b4yS8G5FDt7LOJr0w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YxSUmfW-w5fqvgChuYYaj-hdB6_KV7Jjv5cUB81l5DQ&oe=69FDD445"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393560_1473741093607342_8915277864502759367_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWg9_UY2ISUQ7kNvwE_jqWt&_nc_oc=AdrlRW140ExzWVyW7NIOrZZfI2fOuBfPQXX_LkE1IrDgulCbRzXrMKjsPoHOyr-7MKs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EglkjLJqkVsHLEdLl31oDfs1Ol8a5-rOjemtqWeafBg&oe=69FDE6F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SXM Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name
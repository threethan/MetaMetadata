oG50EF1fzILvNY8mvdyZ6Q&oe=699DB622"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iGUkA8rmx4Q7kNvwEVA3vp&_nc_oc=AdkxMkXFW9OBLgtbyr58r1fjCBrG-UXcPbooVR8oYNLMiIh8GdoNQTXL4YaMztAHBtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaUYqwt49bviy6Dx-U8X_REKRGZVvsNBMVGChVHNpf8w&oe=699DB267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ3myPLjZNYQ7kNvwEIL2QF&_nc_oc=AdmjVEWxmvQim4r3aGSaAAHmg45i9MoQyAqNwBDkLebGnnVpdTN7tu0xbxlfzMDT_sM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGQ7oujhoU_YOrNK74qbbV6bAH5L2REwyPcRXajMculA&oe=699D96C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are 
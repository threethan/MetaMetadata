VecTqBRjPzyunCrUNaOQOlw_1hWo-fE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNwZyIWXempgP1gx5-_gV_d7M0ImaPYJpufu3LP5wefQ&oe=69B68A62"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXGkrdwh0f8Q7kNvwGz2CZH&_nc_oc=AdlnBuedb65diSGMCGLYRs4vE6NJ_GHp70-6seHfYFnSAflVaCiAIMF1V1o_RNvJrtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGc3KRinYngtuBzufiDBlBp9VMxpbTEheYdniSkaiJ0A&oe=69B6BEE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4ohSTWUs5YQ7kNvwGSNJTN&_nc_oc=Adk2n6yy7j-6bEzAjeQ2gunVqanqIPwKs8JduSvKDqjYSRikfNLQ7B-GIycVQ5nPYYo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzOs_rRXrFOYc66uI6a7wAOpk9hVlcH38vIshIo7mV-Q&oe=69B6A345"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the 
uluscdn.com/v/t64.5771-25/491824318_1401271178586387_9042870545167358467_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QaM8PaTmk4Q7kNvwHhBW_0&_nc_oc=AdrZwiyBysYwJ0XxMhB7QSzOzZ9xsNswSXMHqtRKmLeMixvlqpdesrYKqMBfsB7MCWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSM82Oln0neoHEwqOC50gzm3WHWRUMFjA9bt_pxDdy0nA&oe=6B0B17E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1920-B.png", "id": "1773314593683316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312332_1773314597016649_6358416162896446903_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O0IBGXLzf8Q7kNvwEfLIri&_nc_oc=AdoizeoBQo4_TwQkQGH7Y6G0H80fjVAgJcP_1DRnOcfBEWj--8kRqsOcHxQTLdQaYnQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTU5SrJ-XWV6cg-jCasQ-NkBfuYDXVu9FQ3UmKv-kIT4A&oe=6B0B4194"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania VR Motocross Freestyle Bike game. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time! 2 Tracks to Ride and Stunt.\n\n-*Stunt* -  \n     Basic Stunt - Wheele | Endos | 360 Back & Front Flip added in Demo.\n      Mid-Air Stunt -  Special Flip | Cliffhanger.\n\n-*Gear Sytem*-  Mannual gear shift using Clutch | Auto Gear.\n\nEnjoy Career Mode | Challenege Mode | 12 FMX Stunts | Bike & Avatar Customisation in the Paid Version Stunt X Mania.\n\nMultiplayer is the Next Update Cooming Soon.\n\nChallenge Mode Is avilable to buy in Demo Vrsion and Enjoy all the Challeneges Map \n\n\n\n\n", "short_description": "SXM Demo New Update 0.1 , high-fidelity preview of Stunt X Mania VR bike game, showcasing hyper-realistic bike controls with immersive FMX Stunts. \n\nSXM Demo has received a major update!\n- Mannual Gear & Auto Gear  changing option avilable in settings  just like the Paid Version.\n- Include  2 Out of 12 FMX Stunts . Special Flip | Cliffhanger.\n-Interactive Tutorial.\n\nThanks to everyone who shared feedback. We've fixed many of the issues reported in the original demo and updated overall gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28033697822950493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393560_1473741093607342_8915277864502759367_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7j9qAXIIQkQ7kNvwFVsrac&_nc_oc=Adro8-lusTek4-4cI1mu9_9horxI4PxD-sFMnQlUw3PRzUb7Yji5P22ciHt77NVANog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_
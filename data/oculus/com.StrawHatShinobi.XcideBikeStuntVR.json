jV60iwIYVHtoIuoGPlVJstds8Ouayt8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwla8tyJx3qqGTLBTMrtkEFRyAVi8pPZ9fMiQcwLMJ9Tg&oe=69BD5A22"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etIy3YPCgeAQ7kNvwEyBn5c&_nc_oc=AdlGPHVPCgdOSmDo2_IWw7fg6z5td6OnTHPl1LE97tlAGOU_CTyko_IyMYPWF-qakK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXrro3-6P5YvCf5B2aaK4ndrZ1ntu4w3SalEY5WTLx2Q&oe=69BD5667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU0QmvP3ctwQ7kNvwGa7nI_&_nc_oc=AdlxYB5I-KrELkoV9Vc2bvei9vnuK7QL8ehDPLlEyQhMxLGDKwKRgZwbZqBMCCW_lLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzotWr7_sNS1QsTdCHO2xTy4o5JIi9LwSSVJ7SX9S8tFQ&oe=69BD3AC5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the 
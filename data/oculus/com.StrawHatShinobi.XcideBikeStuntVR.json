67", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_999037839014000_8087121828713291135_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-oa2Ow7X0AQ7kNvwFa41bH&_nc_oc=Adqb0GTw5P-hzPHMdy_ElP06PoToBkKnYunaWpntywaVKM-A08xTfoVYVw7FpOEvRuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ID3-p-GIzYOLM25mIi_qcU8gN8hxBhIWxECBJEcw0yg&oe=69ECC6A8"}]}, "id": "1197500725025027", "locale": "en_US", "screenshots": [{"file_name": "ss6.png", "id": "706447998545006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393455_706448005211672_5588674527730837758_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbig_C-R2AYQ7kNvwH0FOzx&_nc_oc=Adr_jeYNbyVInW5egRsfM7cZe_71FTuYhreCcpBl6GL84bo9bMTtPo7DSYN8g2o2GNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Dxs9gAfjLpOHk-fN65rZY6u7pP2k5aY7x2wKtadC-w&oe=69ECAD65"}, {"file_name": "ss5.png", "id": "681557044695517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_681557048028850_6529426699921324887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYFeEBWMePEQ7kNvwGAAT0Y&_nc_oc=AdoMYU4cpAQdEi_sgSFFDHLkvZVf85ZbeIfdVCHcTw9WPSmB3iuvN2Rn2YDlHNxMIa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38XeQcoUy2_cnIxxRKIYd7tThjRgyeWSC7DwfRNXMwsg&oe=69ECD5CE"}, {"file_name": "ss1.png", "id": "1214013270506664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393652_1214013273839997_2849160465745135704_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nFjvluDcVAQ7kNvwHu5pIN&_nc_oc=AdrJJYLxIVOA9dXr2INS0lTH2S3bmuPFSvbAdyjIgxwmt60NHziYDI4LZyujWL16C80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ODgdsKRHez1dahOzmPfbj3DbIHaV_cXLU6AKZ7jdmig&oe=69ECD27A"}, {"file_name": "ss2.png", "id": "9536324133132269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_9536324136465602_3163904286964325124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsTyBUHpSRcQ7kNvwHU1kkk&_nc_oc=Adr_VK3B36b5BwBv-Llba4-bw4vCZgliAg_V6inosGisPoApLFbtrFVa_A68hfILo6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M7iOWyKaVqgxAr_WKJyI6v0jUSSXlGUnIVn7Z4sNJyg&oe=69ECD022"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx-CCCYzWy8Q7kNvwETOxHX&_nc_oc=AdpR8ysWs5QYdSATtPsUWU4A9gfsu7hzFu2pvQkJwQB78GIonw5Sbnp647vpMHYvRm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17NFBYM4W5Eu1pcVq_kiZwF-83lUTFCXYzlNWiHTpysQ&oe=69ECCC67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDYJaVDERTYQ7kNvwFp2iQH&_nc_oc=AdruNqjEMCMXz04EvNz_IrZ4qosDZOUYTSgYL68gY6zhwLE9A19unr1rhilg_4inaSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oCQ5djHEm5_8iwIKeZ9aNe9OIvP854vuzL8UMuGhq3g&oe=69ECB0C5"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393560_1473741093607342_8915277864502759367_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN-_PGKUpS4Q7kNvwFmHpT1&_nc_oc=AdpA0qLxOmoBcQWkyenIB4f5R_09VJe_AIWPaFg6MZhJW0lywDgiX9x86QvsTyRE-Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wMu44Buj2uCKVTi3Aj04M5IEa1ixQnRbAt5D42iuY_A&oe=69ECC376"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SXM Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name
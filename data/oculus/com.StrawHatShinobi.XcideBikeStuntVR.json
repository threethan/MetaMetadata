3o4bePvp9E-5IqJGqcKfJDOWK5tfw-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc7rt9J4myrXZR68UUw-bTC4HT5RBGfenHes8T_pcovg&oe=69BEABA2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etIy3YPCgeAQ7kNvwE9-AIr&_nc_oc=Adk4QsaFx6fJ2AqCNYht4jD8tJH1y-Y6OJ1ZLmhlhIyZ5ApiB2IccVN5qG-UaKUjPyg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-D87_bw5fAfOQyfE42dwhw7HKVPYDqpNeVuFqiFO88w&oe=69BEA7E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU0QmvP3ctwQ7kNvwGDjc8o&_nc_oc=AdmtGBMrwMY9wptDEhVbDUrD7anhTmllzSplUFWk8OFIH95OSHSMsofC-IGS6oky46I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxYjdsSot7sfFbnJ6AORMWlt6U_Ee7hixtV3QYuuM6zw&oe=69BE8C45"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the 
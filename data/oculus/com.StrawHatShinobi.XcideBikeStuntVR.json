aCIz&_nc_oc=Adooov32iwRD7QmfCob64DG0ydr4_rRgtLdvk-5VwBJ70o6lttDbSWxMBv0TeSAO6mE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ixq5tSwh10CP71y0dtS1FEob2CeoYSuaV38b1Oy76mQ&oe=69D3C3A2"}, {"file_name": "ss4.png", "id": "876835481291623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393796_876835487958289_1167777667838419655_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldlTpxMS-h0Q7kNvwEnaA_F&_nc_oc=Adp-HqngdpmEhPz_JGzrZyCQShBBfUh8ceQy2a0767d7iBXxqwg05f8j6VzD0gfU7D4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32PWxfomBCyihKgOKGrQaUUgtTo-ueXg7x4K7yh7T0BA&oe=69D3BFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2920144024826926", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391921_2920144028160259_6729440604000047790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz0r1p0ReJAQ7kNvwEutrg_&_nc_oc=AdqjPMmkKf8LYIVzX-APotfYV0raNT7GT57QcYWBf32qzsr4gxCAEm5pmtTWL2gNnsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tO0F87Wq-BzToDxVh4vUtUvx_8UYCgMOR9L_JBndX1g&oe=69D3A445"}, "display_name": "SXM Demo", "keywords": [], "long_description": "\n\ud83c\udfae *Game Overview*: SXM Demo is a sneak peak to Stunt X Mania. Have you ever wondered if you could go crazy and perform insane motocross and stunts at home? We bring to you hyper-realistic bike controls like you've never experienced before! \n\n\ud83c\udfc1 *Key Features*\n\n- Enjoy a new hyper-realistic vehicle control system, with engaging clutch and gear mechanics and crazy jumps!\n\n\ud83d\udd79\ufe0f *Game Modes*\n\n- *Free Roam* -  No-holds barred, master your motocross bike skills without thinking of running out of time!\n\nFor 360 Flips & Stunts Like Superman | Cliffhanger | Lazyboy | Heelkicker download the Early Acess paid version Stunt X Mania (SXM).\n\n\n\n\n", "short_description": "SXM Demo is a free, high-fidelity preview of Stunt X Mania, showcasing hyper-realistic bike controls with immersive wheelies and endos. Experience the core physics and handling without advanced stunts like 360\u00b0 flips. Stunts like Superman, Cliffhanger, Heelkicker, and Lazyboy are excluded from the demo. Perfect for players who want a taste of the ride before going full throttle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://revrgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ReVR Games", "support_website_url": null, "website_url": "https://revrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9809348172478736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393560_1473741093607342_8915277864502759367_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op_aztXPDO8Q7kNvwGYN1Rx&_nc_oc=Adpln8jg0-uA9jM_sMSB0ZnwHQuDzP7ktMQ4ZkH_J9tNEnUwiSvnp82WCsSc-BB8jTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xr0FJz3m43VfF3BlnHx9Uqs3IRVcpT7wjEA65Fimklw&oe=69D3B6F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SXM Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name
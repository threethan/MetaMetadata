25/38974512_1129876355246034_4204653133633288346_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9av7lnFGykQ7kNvwHawZ79&_nc_oc=AdpeWmS-ZZhIwjP_0ZNx5CTXt4Z2wWRVL9nquHbvS-sNcpZoxz4L5ZJfbw0pnYJnwR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIElCeW5HW4NTg--OhZV2JLs8VEKhmRfwF0OtWifuaWBw&oe=6AB7EC5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soil: Micro", "keywords": [], "long_description": "Due to the extraordinarily small scale of the soil microbial habitat, it is a profound challenge for humans to accurately conceptualize the physical environment that soil microbes inhabit. With the goal of bringing the micro-scale experience of a soil microbe to life, Soil:Micro is an educational three-dimensional virtual reality (VR) soil environment experience.  Shrink to the scale of a particle and navigate through an actual 3D scan of a soil particle.", "short_description": "Due to the extraordinarily small scale of the soil microbial habitat, it is a profound challenge for humans to accurately conceptualize the physical environment that soil microbes inhabit. With the goal of bringing the micro-scale experience of a soil microbe to life, Soil:Micro is an educational three-dimensional virtual reality (VR) soil environment experience.  Shrink to the scale of a particle and navigate through an actual 3D scan of a soil particle."}]}, "developer_name": "Wisconsin Institute for Discovery Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wisconsin Institute for Discovery", "support_website_url": null, "website_url": "https://virtualenvironments.discovery.wisc.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_R
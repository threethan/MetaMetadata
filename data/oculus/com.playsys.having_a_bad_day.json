01&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiUKstY-ps0Q7kNvwFPHVLe&_nc_oc=Adq1UTkeAr_MCa4tpg1zBCs_zQLx2Js6g0Xh1TsiutngGmQZeKiLLXmHvGTBSf6E1vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmMCUTJ3Y1Xh1yEQp482oKxlogoUC4qXUxd-LLAyFeYw&oe=6AEA12F8"}, {"file_name": "vlcsnap-2026-05-26-17h12m54s900.png", "id": "835402275893612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_835402279226945_5858883917921199063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS8qA0gVz_kQ7kNvwE6fiPD&_nc_oc=Adp9OGmn1OTaNJaAz0FbYzpSIq1yU1JhKa8QwWX4czARN7zQwW1j3P_efOBjTvUgdHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwBzGMbAL53htsWDWXMyaOAVVNlmG4K3tXBxiXMiIfcg&oe=6AEA0AA9"}, {"file_name": "vlcsnap-2026-05-26-17h13m09s885.png", "id": "27358468273739221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_27358468280405887_1766779436851509521_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYBvIxsEmlwQ7kNvwHDXZvj&_nc_oc=AdrzafERLl6p0ki6kl9fN8yDfK8InbvWtWlKf5TVFP8u2-kO1gJtjVfTP2_RZnmX4-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5cyQ06EVU9UDoAT-sh_HugzO4yavqHchue3Q0jmf4TQ&oe=6AE9F6BA"}, {"file_name": "vlcsnap-2026-05-26-17h13m24s716.png", "id": "835972815853620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_835972819186953_504342495169446315_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBXe1OG1dwMQ7kNvwHRc2UH&_nc_oc=AdqUe20V9w63EiZWFsfhMdOF6p_ysxUn3ALSHBsmn0isJFKS7vPKkDYA2EReFet6-Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqtY0Gmi8qMsB0CvtMtan1M0npGOolVLnw9N7WjirYA&oe=6AEA0702"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I\u2019m Having A Bad Day", "keywords": ["SmashGame", "VRDestruction", "PhysicsSandbox", "CartoonChaos", "RealityShow"], "long_description": "Created as a compact and physical VR experience, I\u2019m Having a Bad Day is a cartoon-style game built around a simple idea: breaking things can be fun.\n\nYou play as a contestant in a fictional reality show set across different environments. The goal is simple: smash, dismantle, and create as much controlled chaos as possible within a short time limit.\n\nObjects react with exaggerated cartoon physics and clear visual feedback. Power-ups, such as oversized tools or jelly weapons, temporarily shift the pace and encourage different approaches to destruction.\n\nWhile the game is not designed as a fitness experience, you may find that after demolishing a couple of environments you feel unexpectedly energized especially after a long or stressful day.\n\nI\u2019m Having a Bad Day is a straightforward, physics-driven VR game built around short bursts of action and repeatable levels, created for players who enjoy quick sessions and physical interaction in virtual space.", "short_description": "Smash your stress away in I\u2019m Having a Bad Day, a fast-paced cartoon VR experience where you compete in a chaotic reality show. Break, dismantle and unleash exaggerated physics-driven destruction in short, intense levels. Easy to jump into, hard to stop, perfect for quick sessions and surprisingly energizing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.play-sys.com/terms/#privacy_policy", "developer_terms_of_service_url": "https://www.play-sys.com/terms/#terms_of_service", "publisher_name": "PlaySys", "support_website_url": null, "website_url": "https://www.havingabadday.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
luscdn.com&_nc_ss=7f20f&oh=00_AQF3PbI5v71Iz54SlV-yw7D-sNr0zQhFTZggb0xyEpflIA&oe=6A974CAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NSAF_2560x1440.png", "id": "166618027353559", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12504788_166618030686892_5236600667618934784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cummy6Q1ALcQ7kNvwGWJPrV&_nc_oc=AdqtE4eAYSikl9NNsbVR_dj1yuvS8sHfIzTHDtESE37IjyG17YJGTIJD_6CtYT1H9_Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElS4VhRIAkgPVUEZGBaYPa74ecaNT-eeh6qp-3EtqbkA&oe=6A971EF0"}, "display_name": "NeuroSpeculative Afrofeminism", "keywords": ["scifi", "neuroscience", "future", "narrative", "hyphenlabs"], "long_description": "NeuroSpeculative AfroFeminism is a possible future told through speculative objects, virtual reality and cognitive investigation.  Experience the narrative that combines neuroscience and black hair rituals. Hyphen-Labs places you in a \u201cneurocosmetology lab\u201d where Brooks, the main character, CEO, Principal Investigator and pioneer of brain optimization technology (b.o.t.) is fitting her customers with transcranial electrodes. Brooks welcomes the viewer into her brain salon where she is testing this technology and helping her newest client experience an optimized future in virtual reality.", "short_description": "NeuroSpeculative AfroFeminism is a multi-layered possible future that transcends the constraints of the present told through speculative object design, virtual reality, and cognitive research. Join Brooks' movement as she challenges the boundaries of perception."}]}, "developer_name": "Hyphen-Labs", "developer_privacy_policy_url": "http://www.hyphen-labs.com/assets/-hyphen-labs--privacy-policy.pdf", "developer_terms_of_service_url": "http://www.hyphen-labs.com/assets/-hyphen-labs--terms-of-service.pdf", "publisher_name": "Hyphen-Labs", "support_website_url": null, "website_url": "http://www.hyphen-labs.com/", "category": "ENTERTAINME
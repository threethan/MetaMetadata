": "Colorball_Font_32bit.png", "id": "295592758997715", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031560_295592768997714_8139471181231104982_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiiUlgnZOfUQ7kNvwGYbSdm&_nc_oc=AdqJZ8syJseFQICNkPXzBaOFl_04avFsfin1qvTgACX9vBrRRvEjsH_U0LTqWP2bZfI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kp1wfLkHq7p5vPiUCccvDC294wCd-66acS5T65OYVzw&oe=6A11B717"}]}, "id": "993102209399277", "locale": "en_US", "screenshots": [{"file_name": "Bild_2021_06_24_12_24_55_689 (1).png", "id": "140007278238234", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003261_140007284904900_2639424332373869677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yWKXwsJ9PIQ7kNvwHJEloO&_nc_oc=AdpESmN0VG7v1IecYhyTh-kcaa9GoRZbSNxi7xTEpKWmh6NbL6RJCJfWVvp3KCp1Ov0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Kaz5TWd84N6LOEL2twNOU-ezHcnU8h5OA8O8ly46tg&oe=6A11A58B"}, {"file_name": "BowArrow.png", "id": "1049724899654755", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982562_1049724906321421_954447764272983052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM3V7GO6iGEQ7kNvwFxnZ0t&_nc_oc=AdqXbdqF8VNp_xCxFQPKuaN-Bdt8jtjXNs_Frd-wEsZJy5QGpMPcfDqK5TBCYEMSe1I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lTQ8av9FPqMJL2x-DHPP1VkWg0MztEF3cONbwhU-NMw&oe=6A11AF3F"}, {"file_name": "Capture_2022_02_03_16_35_14_933.png", "id": "957241951590401", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001671_957241954923734_735999754316212288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWVidTAjTzEQ7kNvwGesxAu&_nc_oc=Adp1Uqw9Xaqkseqha9jdsJqSFHCrpTGRxokBBo__bb3l6fRVTwn_eKw6SkVNS9-vzOY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U_kl2EmgNmqfaWhmER9J05TEi-DjtqoN8QoquAQre4A&oe=6A11D1D8"}, {"file_name": "Capture_2022_02_02_15_02_29_230.png", "id": "325620039488850", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982658_325620042822183_4022749044917927014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4booh8csyEQ7kNvwEQelTA&_nc_oc=Adoe3iUs3MfFWJDFeQGthUpFiBCJ39OS3HLmYLPCsyjm3-TcbcezTfgDYo9BcKZZYdA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hP4KG9Y3Dp8fr5xUjCKUeM8dfgaQkQ32mzoIhYhrcjA&oe=6A11C253"}, {"file_name": "Capture_2022_02_02_15_21_28_501.png", "id": "518826992790512", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75314849_518826999457178_5527016225714488413_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0W_ys-xvo4Q7kNvwEpLjSf&_nc_oc=AdqGKZ3P2A5XSLoHpFFRfzfS3Mz4rK77eLYS6X4oL49eJIUSgq_4RJtQddtmsHazZXc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CKP4i9OTl72ys30LPQpJOS6QqPZu5lcbb5ibQQJ4V8Q&oe=6A11C1E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bild_2021_06_24_12_20_03_139.png", "id": "1045702576237564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974538_1045702579570897_449312649899389200_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5q19K5ic0wQ7kNvwFdluaB&_nc_oc=AdqY56DenT57k5_37PYlM45tChMePIjf_k1M6P2R8anSZ9fHxj4lqvRJKgmOOflvQiM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nWGoRNyJTel1tNn4XOsCjiE9MfIf4LZqpl9QMH2Px9g&oe=6A11D0FF"}, "display_name": "Colorball", "keywords": ["fit", "bow", "saber", "boxing", "archery"], "long_description": "**COLORBALL** is a high-energy mix of **Dodgeball** and **Bubble Shooter** \u2014 powered by archery, laser swords, boxing, and more. \n**A unique sport that can only exist in VR!**\n\n## **YOUR MISSION**\nCatch, throw, smash, shoot, punch, box, \u2014 do whatever it takes to hit balls of the **same color**. No rules. Just action. \n{1285202396269220}\n\n## **YOUR EQUIPMENT**\n\ud83c\udff9 Bow and arrows  \n\u2694\ufe0f Laser swords  \n\ud83e\udd4a Boxing gloves  \n\ud83d\udcab Gravity bracelets  \n\u231a A slow-motion watch  \n\ud83d\udee1\ufe0f Shield and helmet  \n\u270b ...or just your bare hands  \n{1946423936126653}{1245157829864787}\n\n## **YOUR CHALLENGE**\n**Don't get hit** \u2014 not even once.  \nSurvive the chaos, master the flow, and conquer the arena!\n{1273308487766655}", "short_description": "COLORBALL is a mix of Dodgeball and the classic Bubble Shooter games, topped with archery, saber and boxing movements... A unique sport that can only exist in VR.\n\nYOUR MISSION\nCatch and throw, smash, shoot, push, box... balls to other balls with the same color - everything is allowed!\n\nYOUR EQUIPMENT\nBow and arrow, laser swords, boxing gloves, gravity bracelets, slow motion watch or your bare hands.\n\nYOUR CHALLENGE\nDon't get hit by any ball!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ColorballVR.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Harald Stapfer", "support_website_url": "https://www.ColorballVR.com/#contact", "website_url": "https://www.ColorballVR.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23948231321530165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75334055_1187141712544399_3816924328208247195_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_
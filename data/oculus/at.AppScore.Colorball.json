cdn.com/v/t64.5771-25/38982658_325620042822183_4022749044917927014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anwMukMqi7sQ7kNvwGsPDSF&_nc_oc=AdpPR5i5GrBK1rHSvzwMz7waBlvi4t47eM_gYJbaj46VfEyzevV5Yvq3f8lrT6zZ9yw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WT8pGyEiaPO57PUleObdVIZTSx5gzCtDtyzfY6mCcSw&oe=6A47CFD3"}, {"file_name": "Capture_2022_02_02_15_21_28_501.png", "id": "518826992790512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314849_518826999457178_5527016225714488413_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAPbVdRQUdcQ7kNvwHWbYWw&_nc_oc=AdqzeB-DEiOIi7kyO-SxCU8O1fKjvlGMqPnAd2pcfBADiCy6dNZDnhfELLdABZHrjGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fmJpfSBQEnO5tbndhL9PYjRr2zF3hW4jbddzXiFRMzw&oe=6A47CF67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bild_2021_06_24_12_20_03_139.png", "id": "1045702576237564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_1045702579570897_449312649899389200_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jnELPGQD4YQ7kNvwF5AZ2d&_nc_oc=AdqyrniYwbOznCB15Q2I3N8nnPzOX4Q-HOFPG9nskWIohYyd5b0-wLtl0Mn-QXU0f4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y4PzBV7RYGVwAN8GZQFFnckBIWO0SNkF7kYL4QCg22Q&oe=6A47DE7F"}, "display_name": "Colorball", "keywords": ["fit", "bow", "saber", "boxing", "archery"], "long_description": "**COLORBALL** is a high-energy mix of **Dodgeball** and **Bubble Shooter** \u2014 powered by archery, laser swords, boxing, and more. \n**A unique sport that can only exist in VR!**\n\n## **YOUR MISSION**\nCatch, throw, smash, shoot, punch, box, \u2014 do whatever it takes to hit balls of the **same color**. No rules. Just action. \n{1285202396269220}\n\n## **YOUR EQUIPMENT**\n\ud83c\udff9 Bow and arrows  \n\u2694\ufe0f Laser swords  \n\ud83e\udd4a Boxing gloves  \n\ud83d\udcab Gravity bracelets  \n\u231a A slow-motion watch  \n\ud83d\udee1\ufe0f Shield and helmet  \n\u270b ...or just your bare hands  \n{1946423936126653}{1245157829864787}\n\n## **YOUR CHALLENGE**\n**Don't get hit** \u2014 not even once.  \nSurvive the chaos, master the flow, and conquer the arena!\n{1273308487766655}", "short_description": "COLORBALL is a mix of Dodgeball and the classic Bubble Shooter games, topped with archery, saber and boxing movements... A unique sport that can only exist in VR.\n\nYOUR MISSION\nCatch and throw, smash, shoot, push, box... balls to other balls with the same color - everything is allowed!\n\nYOUR EQUIPMENT\nBow and arrow, laser swords, boxing gloves, gravity bracelets, slow motion watch or your bare hands.\n\nYOUR CHALLENGE\nDon't get hit by any ball!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ColorballVR.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Harald Stapfer", "support_website_url": "https://www.ColorballVR.com/#contact", "website_url": "https://www.ColorballVR.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23948231321530165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334055_1187141712544399_3816924328208247195_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVD7VZh2J
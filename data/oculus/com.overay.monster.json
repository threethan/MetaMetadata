AdrjXNf0hfDGHtlkYe4z-EDi95ggFG75MoJhZzrvLTawfIsNedv4PEa3fO1RC5lkqh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUQxU0-hHlKDG2JFGcBq3uSXIx-VdaYhOYWaqP2hX2Lw&oe=6AE5FE75"}, {"file_name": "Screenshot2.png", "id": "689764596749357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311611_689764600082690_4197248188860665782_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzKU-ovARroQ7kNvwHOSkrY&_nc_oc=AdravC9AVYWZz26o3nSiiXrG8ok7XtfsKxCkCoGOFnf-DXrM8iiRGKj9n_cj2QbVp2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmE3MBj3t2ZqT8EVhpob43-mg1p2rE1sFzJnJixxK_CQ&oe=6AE600EA"}, {"file_name": "Screenshot1.png", "id": "1091091896512331", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_1091091899845664_506168887844826921_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0w5aHBrOLgQ7kNvwFRzmY7&_nc_oc=AdpBnpNRgZZI0F-2rJw0SnHZlaPDD0EAWATuu3wxXd6xAKK3D9BpEYlr90IDzgoOEhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCDOPlkL-VcYXWKmDYxEVdxF-mj7dQ_DPL927lUYUjeg&oe=6AE5E5D1"}, {"file_name": "Screenshot3.png", "id": "812751957760216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819934_812751961093549_8752196657029643728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYR2afWbABkQ7kNvwGrAwdZ&_nc_oc=Ado8Ti0bNmZ8nxPBGuZX1ArFAcqwlndofQQrNcOoCZOVdqr5-iHo-4XSQb-SHw3_8fI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWIIll7Qzj5Qh6dIH636oZ4F3RttiX57xQPxERSvyYhA&oe=6AE60418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailor-cover.png", "id": "1412273356533917", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823431_1412273359867250_7333274914820196764_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88jZWeFb2aMQ7kNvwF0FA-O&_nc_oc=AdpMPHzAD9JnOsAnILyAbj3F96Fr-005ZCEvrMCOhj-EMFCde8s1oDib1Bn_8LIOQFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ8SWODLt6dD6iW3EjkFuydsv6FWW98T_JPqp5al0kGg&oe=6AE61375"}, "display_name": "LittleMon's LittleWorld", "keywords": [], "long_description": "Welcome to Little Mon\u2019s Little World, a MR game where your everyday space and the monsters\u2019 playful world exist together. This isn\u2019t just decoration\u2014it\u2019s the joy of seeing your real surroundings blend seamlessly with a magical, miniature world.\nUsing Mixed Reality, place your world on a desk, the floor, or a corner of your room and watch it come alive. Unlock themed object sets\u2014from colorful playrooms to peaceful gardens\u2014and decorate freely to create a space that reflects your style. Each piece adds warmth and charm, turning your environment into something unique.\nYour companions are adorable monsters that arrive as you progress through quests. Each is full of character, animated with endearing movements, and eager to explore the world you\u2019ve built. They climb onto object, interact with decorations, and bring life to every corner.\nAs they play, they generate Fruit Gems, which you can use to unlock even more object themes and expand your creative options. Object is interactive, offering delightful surprises as monsters engage with it, making every decoration meaningful.\nLittle Mon\u2019s Little World offers comfort and creativity in equal measure. With pastel visuals, charming animations, and the sense of sharing your own space with cute companions, it\u2019s a soothing experience you can return to anytime. Step into a world where your life and theirs truly meet.", "short_description": "Welcome to Little Mon\u2019s Little World! Create your own cozy world filled with adorable monsters and place it in your real environment. As your monsters play, they generate Fruit Gems, which you can collect to unlock new object themes and decorations. Expand your world and express your creativity with unique designs. Featuring warm pastel visuals and a charming style, the game offers comfort and joy you\u2019ll want to return to every day."}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://pear-friction-aa5.notion.site/Privacy-Policy-27337fe5ed8180b2afb6fdf609fd03db", "developer_terms_of_service_url": null, "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://pear-friction-aa5.notion.site/Little-Mon-s-Little-World-27337fe5ed8180b49e94e91484676b6d", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24466249953013784"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "817494067797432"}, {"status": "CANCELLED", "id": "1209501127751616"}, {"status": "PUBLISHED", "id": "4272716276303049"}, {"status": "CANCELLED", "id": "1750700945650429"}, {"status": "PUBLISHED", "id": "2155450254944471"}, {"status": "CANCELLED", "id": "2046110816124538"}, {"status": "CANCELLED", "id": "797554286608112"}, {"status": "CANCELLED", "id": "1798232374146494"}, {"status": "CANCELLED", "id": "1438017207272304"}, {"status": "PUBLISHED", "id": "498563863064069"}, {"status": "PUBLISHED", "id": "763950359943786"}]}, "baseline_offer": {"id": "817494067797432"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764134280, "status": "PUBLISHED", "id": "817494067797432"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id"
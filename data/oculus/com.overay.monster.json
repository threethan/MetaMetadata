_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumbnail.png", "id": "2114665985932632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604298355_2114665992599298_5256304154268619558_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BdV7qG0qhAQ7kNvwE2T7zP&_nc_oc=AdofwUllvRCeYOV4qdxWyD3q_colVvVrnXaqAx9c7kpDIdT6vjE8wcveCLZZ-Fhi-uQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMICXremtg6b_6EpggBbH4tu9aRmD-Tw0t5gmGsjrY1Q&oe=6AE5EBBC"}, "display_name": "Little Nook", "keywords": ["cozy", "cute", "relaxing", "pet", "fruit"], "long_description": "# \ud83c\udfe1 Create Your Own Nook\nTransform your room into a magical sanctuary! \n-\nLittle Nook is a mixed-reality decorating game where you build a cozy haven and watch adorable Frumis come to life right in your space.\n{1356977563247792}\n\n# \ud83e\udeb4 Frumi Garden\nHarvest magical fruits, water them with care, and watch adorable new Frumis sprout to life.\n{1511067870455177}\n\n# \ud83e\udd51 Invite Frumis -Nook Villagers-\nMeet the Frumis, the lovable residents of your nook! Watch them wander around, react to your room, and playfully interact with furniture.\n{1120948483272546}\n\n# \ud83c\udfc6 Complete Frumis\u2019 Favors\nHelp your Frumis with their little favors to earn rewarding Gems, and upgrade your nook.\n{2142358423224517}\n\n# \ud83d\udcd6 Fill Up Your Collection Book\nDiscover new Frumis, stylish accessories, and fancy items to complete your very own collection book.\n{2415693822275221}\n\n# \ud83e\ude91 600+ Objects\nUnleash your creativity with 600+ items across 6 themes! Build walls, platforms, and place furniture freely to design your ultimate dream space.\n{867627209246719}\n", "short_description": "Little Nook is a mixed-reality nook decor game where adorable frumis come to life in your own space. Invite frumis into your room, build a cozy nook for them, and watch them live and interact around you.\n\nPlace objects freely, and create a warm, playful space that feels uniquely yours\u2014right in your real environment."}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://immersedplayer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://immersedplayer.com/games/little-nook", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27780508408254572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623370_2355833828242386_6195512385816529185_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdxpHvhOHmIQ7kNvwFHaQRx&_nc_oc=Adp_A73ALyvTnY37DYq275g4_Iofn7UWP-Hm_zPzDd7MKj5O8PvUwOyPolqM91yilYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhpx9-5956qGaKBn2wA1bs3lSKmWfixCtf63d1yGQ55A&oe=6AE5E635"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Little Nook", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1758852000, "lastRevision": {"nodes": [{"id": "24466249999680446"
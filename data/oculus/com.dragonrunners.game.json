zSY0Goc2dKW4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCsTS0iRPz9VthBR0eRbUFo0cxeVyfzfGvQw-rh76I2g&oe=6AFC70A3"}, {"file_name": "04_guarida_espejo_tienda.png", "id": "1152248103836814", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593716858_1152248110503480_7933035619232436085_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1icTTyS1rOUQ7kNvwHwpReb&_nc_oc=Adopd0_yiE95NpmpUFy6rjghMCW5zpdMZSi0eDObUrvrXYFdUMEpGfG4xt5uTHef4Z0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqnJpHpiRRb73DIpDa08Scw-1nXhpbGTyJ2eVQ1LBNhw&oe=6AFC6C09"}, {"file_name": "02_vuelo_arco_legendario.png", "id": "1845333890160608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624990_1845333893493941_4578013954464131148_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rph2sKq17Y8Q7kNvwF5cwEr&_nc_oc=Adr-dpt8019rMs8YIB2F0CpTlgfFhW7GNa_n27hcrNeEw_1hG9gZ60oQcHuCcHESsSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgYbfVUxwtQ_7GDplVPG__lt0-cm9cZtguNfHl61esFw&oe=6AFC772E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada_trailer_2560x1440.png", "id": "1633450055140580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628882_1633450058473913_9171834561667669026_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E46wSIQniAQ7kNvwHWhb3U&_nc_oc=AdpTOk8p3LvxSLDBUIs0J-QpYi_X1R4BNf6-07yrPhnBEGkmrGk9dbRs281as6bqQ1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJOAqQg49iCpZIUW_Nj4ayfXKDLtLOOQINu1DA-E_v1Q&oe=6AFC861D"}, "display_name": "DragonRunners", "keywords": ["dragon", "flying", "multiplayer", "tag", "social"], "long_description": "Become a dragon!\n\nIn DragonRunners your hands are a dragon's claws and your head steers the flight. Squeeze the right trigger to take off and speed up, the left to brake, and look where you want to go. Land to walk on your claws, hop, pounce and climb rocks.\n\nA new map every day\nIslands, ruins, bridges, rings and skies change daily: sunrise, dusk, starry nights.\n\nThree ways to play\n- Tag (La Traes): one dragon starts as lava. Touch another dragon to pass the lava on and try to be lava-free when the round ends.\n- Race: fly through the rings on a short or a long course.\n- Free flight: explore with no rules.\nRight grip: a burst of speed toward where you look.\n\nPlay together or alone\nOnline rooms of up to 10 players, private rooms by code, or offline against bots. Optional proximity voice, with push-to-talk.\n\nNine dragons, your style\nEmber, Frost, Tempest, Umbra, Prism, Moss, Bulwark, Dawn and the legendary Eclipse. Customize colors, patterns, trails and lava color in your wardrobe. Scales, the currency for cosmetics, come as gifts, online Tag rewards (up to 50 a day) or optional purchases. They give no advantage and nothing is random.\n\nFair play and safety tools\nAll dragons fly the same. Mute and block players, or report human ones (not bots), from your wrist. Voice is never recorded. Comfort vignette on by default; the camera never tilts.\n\nPlayed standing, with Touch controllers. In 33 languages, including English and Spanish.", "short_description": "Become a dragon: fly with your triggers, walk on your claws and play tag, races or free flight on a new map every day. Online with up to 10 players, or offline against bots."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1654191629666872", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622184_1654191636333538_2238873500414178792_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QAGr2C3coQQ7kNvwHrqDdi&_nc_oc=AdpjryDlV9EKr8BXjrRdRNbOx1wtEde4eD1aQwWk6cpa-78AgiCWW1P0CJSjN-AkY9M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjJiVpAvBVxoWYRzSTz4oLxlo0qQrTWMCFrbw6uqNwow&oe=6AFC6D1A"}, {"file_name": "portada_heroe_3
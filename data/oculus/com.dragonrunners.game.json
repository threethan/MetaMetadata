qOlXVL2dRnbwThcm9TsfPeJ-Cb3Lmojh8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxHyujkicyTnVZXUZFNJqpnONbR7c6QTKrOZRhq3sb_A&oe=6AFC5EDD"}, {"file_name": "03_persecucion_ocaso_lava.png", "id": "1764808431461408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_1764808434794741_5804384001628718691_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga5T2Gjz0-MQ7kNvwG3tYu_&_nc_oc=AdrONvr8Ve7OG2pyha79kutrmL7wXgWw54nBfL5wNXX_25B5OJENmWrDuzGHd8QhROw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNwsYWknOcw6MZYBtNGgkpLJ5fkt5NZ7zEACWJ7YpmXw&oe=6AFC7DA5"}, {"file_name": "02_vuelo_arco_legendario.png", "id": "1802869234057289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627379_1802869237390622_28235688743704208_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lrhzkdhv8UQ7kNvwEWzMk_&_nc_oc=AdpperuincqB9TLl8f_oFsxUTBEtC1WODd5JiNyvh0IhbqaByW6TokL4bGYhkeqGNIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROTYuKYvGS5sbcGfM-ix51mCWEKBgndGMInTfhP7Pijg&oe=6AFC690D"}, {"file_name": "04_guarida_espejo_tienda.png", "id": "1629899075167644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624656_1629899078500977_2639051872591902351_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVHPfbTZQDEQ7kNvwFkSP97&_nc_oc=AdogUrzt6GszLDVd2hSiMT0SdfQTgqC7bgCQ5FgrCsfZZoMnuRypnHqAwWo3Ogj_HdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDetDDvIyP8NLoHT3B3ouoN8k8XaqQK226mQDEGVGMQg&oe=6AFC9120"}, {"file_name": "01_persecucion_primera_persona.png", "id": "1455587176457575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628449_1455587179790908_970888301217472593_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMKb3O3Px3wQ7kNvwF9n1R-&_nc_oc=Ado82-BMAK81qCAD7KhH84UlmYI_kubKIzrmaWzgjWxhuoHeTGvazA38QThkhDgf3as&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFGL9o__Z0fj9ceEKe-klw4NOu7CACbwgVxnW_OirHIg&oe=6AFC726C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DragonRunners", "keywords": ["drag\u00f3n", "volar", "multijugador", "social", "persecuci\u00f3n"], "long_description": "\u00a1Convi\u00e9rtete en un drag\u00f3n!\n\nEn DragonRunners tus manos son garras de drag\u00f3n y tu cabeza dirige el vuelo. Aprieta el gatillo derecho para despegar y acelerar, el izquierdo para frenar, y mira hacia donde vas. Aterriza para caminar con las garras, brincar y trepar rocas.\n\nUn mapa nuevo cada d\u00eda\nIslas, ruinas, puentes, aros de impulso y cielos cambian a diario: amanecer, atardecer, noches estrelladas.\n\nTres formas de jugar\n- La Traes: un drag\u00f3n empieza siendo lava. Toca a otro para pasarle la lava e intenta no tenerla al acabar la ronda.\n- Carrera: pasa por los aros, en recorrido corto o largo.\n- Vuelo libre: explora sin reglas.\nAprieta el agarre derecho para impulsarte: una r\u00e1faga de velocidad hacia donde miras.\n\nJuega con otros o en solitario\nSalas en l\u00ednea de hasta 10 jugadores, salas privadas con c\u00f3digo o modo sin conexi\u00f3n contra bots. Voz de proximidad opcional: ap\u00e1gala o usa pulsar para hablar.\n\nNueve dragones, tu estilo\nBrasa, Escarcha, Tormenta, Umbra, Prisma, Musgo, Muralla, Alba y el legendario Eclipse. Personaliza colores, patrones, estelas y lava en tu armario. Las Escamas, la moneda para cosm\u00e9ticos, llegan de regalo o con compras opcionales. No dan ventaja y nada es aleatorio.\n\nJusto y seguro\nTodos los dragones vuelan igual. Silencia, bloquea y reporta jugadores desde la mu\u00f1eca. La voz nunca se graba. La vi\u00f1eta de confort viene activada; la c\u00e1mara nunca se inclina.\n\nSe juega de pie, con mandos Touch. En espa\u00f1ol e ingl\u00e9s.", "short_description": "Convi\u00e9rtete en un drag\u00f3n: vuela con los gatillos, camina con garras y juega a La Traes, carreras o vuelo libre en un mapa nuevo cada d\u00eda. En l\u00ednea con hasta 10 jugadores o sin conexi\u00f3n contra bots."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dragonrunnerssoporte-ship-it.github.io/dragonrunners-legal/privacy.html", "developer_terms_of_service_url": "https://dragonrunnerssoporte-ship-it.github.io/dragonrunners-legal/terms.html", "publisher_name": "AMZ STUDIO", "support_website_url": "https://dragonrunnerssoporte-ship-it.github.io/dragonrunners-legal/", "website_url": "https://dragonrunnerssoporte-ship-it.github.io/dragonrunners-legal/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1354706437723523"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1619099433055096"}]}, "baseline_offer": {"id": "1619099433055096"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791569100, "status": "PUBLISHED", "id": "1619099433055096"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1386803694513797", "version": "0.4.6"}, "id": "1185053910863882", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "
.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIZU4K9zmyUQ7kNvwFYifxp&_nc_oc=AdrQMO1OUhCdMBmcFv3AHIejHk_VEIaaR4md3VT4kz_q2seXmdmZqwQuvuuXcMYuhKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIDTe9zRevQXiB06KTFV0X6nFBNhhVVyKgBrBPEvNJ2g&oe=6A9AC9AF"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUPz8p-X8GMQ7kNvwFTDsrx&_nc_oc=AdrKuZH5UaA9Wh7-UV4EO0PBEXfMxnoWu1MJ5BJPy9jJZKlZHz4AZAwOMCPPrMiGM7o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAHYLATrMV4QQS6ngrlKDXUqkicc00Sn4tmEBr0TZbyw&oe=6A9AD301"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeFBqZl749UQ7kNvwF3WLhI&_nc_oc=AdrkOY8a5p-0Z0JQFeJgC2v1hz_KbQQoS9Rgp3-mZUB0I8I-rfCFEeFwDPEAWgy6vhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-VAZ9TXVH9cjpscaBsWJ2EULDT07QLM2GMR8zIVbOFw&oe=6A9AE7A8"}, {"file_name": "IMG_0620.png", "id": "1547078116625666", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1547078119958999_8403208151240748249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvkcc_XC0TAQ7kNvwE_IafA&_nc_oc=Ado0awNP4YLw4lU3lEsWLnQKQXND5uOarq0GkLoA2Jq16AVGwRiwxePdgRReBGmXICw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI22GbRZaHLr_80ePMjzRiJyEXZFKGp1H1h0P94xDLHVw&oe=6A9ACFEE"}, {"file_name": "HeroCover_kr_A.png", "id": "1544914920259210", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618472_1544914923592543_20439413943043317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AAfvbtRAPkQ7kNvwEzVhw4&_nc_oc=AdqK3ZB9NgUjPRkuzxC9w6MR3q8j_3aiuahTIHWsVcVXPq85D3hTjwL1DuGDzvgrrag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsJYhsDknMQBEd-gggQ7pFAg-FaMaM6IhQj8NncxgbdQ&oe=6A9AD70D"}, {"file_name": "Cover_kr_A.png", "id": "1180716197305101", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t
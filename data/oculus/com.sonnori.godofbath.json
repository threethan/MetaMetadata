c_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdIZhNWPRfo3tarG1eECaYkKCdS8C464IFbFcWP7cflA&oe=6AFDE2FB"}, {"file_name": "GOBVR_Screenshot_04.png", "id": "826037636688789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX9e2QtGlBoQ7kNvwHcYoty&_nc_oc=Adp-i_czhh7jCj65MNy0t2Ty1Djyt4BjUTTB9PDRtHX8Yc9qufja7loS-_UcVXs__rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHNHPP7cZejvMEcBcbLnbmYxYLWOPabltTyEd1y3vGew&oe=6AFDCBB3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xhtdSUnsH8Q7kNvwFxGMJt&_nc_oc=AdoHB-1agu9jWfK8FMiLRfFQ5Y8gu6wIRkpYEzRDIzhOd2YfZjC2xCfBO-pH_2XKYkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxSFKrxxtdhWVyxBRw9-cQexSAJj0hBHoxwVuI24lQrg&oe=6AFDB0A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74nGiYy6EB8Q7kNvwG-r-vO&_nc_oc=AdrnzzUDtAkD_HY6JmflVRfocFXXOyp-AYHsJsLgWGlSfk00_hA1MoDhtNFuO1H3Ukg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH1lNCm732w61DKASwsnWtSqZM4UOngtrQBsZurTG8XQ&oe=6AFDE0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djLt2sXeFbYQ7kNvwGKJpEI&_nc_oc=AdphJUwvLbaiwrgF6AWt3vPs20y9A78nGWwxqO-sy5V6oKMFWFt8YpzG4i9R-qxG4Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReQbKiU0G1CRRirOcsafvbqaZm5ygsebrRXFU9tZh4UA&oe=6AFDBB54"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1_n81gsQ8wQ7kNvwHs7ytW&_nc_oc=Adpq7tYivy2E0JWLO0MKJ
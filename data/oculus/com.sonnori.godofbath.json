5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nqt9zxjoSgsQ7kNvwEpkgx1&_nc_oc=Adp3wi-A6AJC5wTcIof83jGXstplWu7_3bUQsWHs1OZDzZMMCXcjERc3bcu13O5W4O8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd8F9NsyCLq3fAuSS-zsNfI99ZcS87EvUHb7IJzBI0qQ&oe=6A9EA773"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLy6-RUJJawQ7kNvwEkGy5T&_nc_oc=Adov8dID4PfI78BwqYkeZK0DBTt9xSdnuQjPks2RazArCTmgQhRYFkGyfa1RvKHl3uM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKJ11Vpa944PpBvhwg7Tvhez4_UAd1XRXlQYP2B-dK0w&oe=6A9EC4A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciGtylU9ITkQ7kNvwEDq9aL&_nc_oc=AdpBxFfpRt7MYp3tuLOy46Xu8_vHQFMyI3opF9Guno69UlaAw9ehJSN4SEYqPND3Hzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR-IbUV0ZYuWs80t6dsBVlA2DMcYvzoZB7EXATxqK_wg&oe=6A9EBC69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAo1LJ6YarUQ7kNvwGgzY3b&_nc_oc=Adofw8k1wkIJOjSAgy1sXqsEnjyP2s9VKWdn90zp59KxlSOwCpXMMIEDCM-idAcdzSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMNr1zDfY3mc_jXfpozWRZty7Y7hCuwAZ1ceTa2wfAwg&oe=6A9ECF54"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nriAG1u3HsQ7kNvwGWQxS8&_nc_oc=AdqwyLXGJPtBqH3oVwPUAbpIEkB0KzKByTlvpG074SxCQuZxHk3bZhlKpDjPfMp0AUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRCT7HmI5LWP5hDQsuMkUHAPn8VozXtdFv-4gZSlOJ1w&oe=6A9EDC28"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
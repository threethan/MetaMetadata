5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQPYNKiC_SMQ7kNvwElTjUM&_nc_oc=AdrZUX665F0MUDWuyPGkLN65Tfzp1DZDdohJVL00_lEIXbDSyPWeh088TeaMmenNdoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RraUzfCWz0f-13Uk1dn-OTf15Rgh97fV6WYaVWatJng&oe=6A3EA233"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Klm_KpbHBsQ7kNvwFPdHXR&_nc_oc=AdpPgGgHDk9hJPNUz868eCx-79SMdZZCLJbjVDT-a1l95GyfvZzlXVWX1-sj7kHE8Go&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S7pZ2fJ9zil4IUR3Iz1RH50PnA0-Usg-NhGDKaKP3lw&oe=6A3E8726"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x23IHWupP0Q7kNvwH4iOw3&_nc_oc=Adp_4aAWD8oXCJx3wCsn-H5IuMpFdd5xxh_9duv7Gi21Io4mNSLIY5f7xi--eyWNJnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zJqdo6XWWUai9ocWb0r0bHSDY-FMJAUWsHGhEB7MJOQ&oe=6A3E7EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC0wKcc8CLUQ7kNvwEI171x&_nc_oc=AdoV-q8IySuRENRT-yUwFlQijd3fg-8CpJl6hKJB85wCAd8PUqoSTWfXPG5kEVQYwQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7wGrXRLsGKNBL8GZpNwyVs-Ld_AwR1ldfOIzef9gTg&oe=6A3E91D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqkr1lVtwrEQ7kNvwHPW8gc&_nc_oc=Adp_84eCtJmHaDX13TCC6AtFt75gMKYKdU4OYHCG7oOADuFcQQDgPcfDFHFYMqLLO9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f6xuvPmQGgZuqHB0mUW1pdpP3yNBujjAfbNh-WhmhMA&oe=6A3E9EA8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
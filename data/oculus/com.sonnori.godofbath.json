71-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xhtdSUnsH8Q7kNvwG5TH0O&_nc_oc=AdppGw6GYoJ8ktgTDPMAl9_lc0PpPN_PiQ1ysYgBDINoBm5rGrLQF0KVv5Undx394bo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8U-fupUf6STrRYDzCetHr4L9IcgVGcQipA1leab9ENw&oe=6AFB45E6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74nGiYy6EB8Q7kNvwFLIXgu&_nc_oc=Adqb7ZrdRjZ6-rx8TVpvXYVxZeezhXOWAHt9Ezyd0RBD8MFoIlbse2XaSkIadJM2rFk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwpFZbqzM3fL4SyRbwiGhlQ_2g976X4oXMxjWrObNV6g&oe=6AFB3DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_en_B.png", "id": "1393935742074773", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aanUha-nthEQ7kNvwH65ClB&_nc_oc=Adod-s6xMmK8NhSKyKRWUlf9hqSImpz66wvPnNeMDKGPePVaZxRVIdMMg9wNVkzqz4k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR-K2DLuIKge1nwgeLIEeC1mlrgB0pXlp_3TnS19rZcw&oe=6AFB3F6F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bVqyQUjXcwQ7kNvwEt-3BZ&_nc_oc=AdoRhnmas9Mju6Fgl2M-U0oFIMf5loT6ZWclrp7TcVrrEVRDnMSDOs7j49apoS25KKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROgJNBmHzyQwzqH6yPHa-wdmjk-21MLcss2X68ST_Yew&oe=6AFB48C1"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvdP0TIPPx0Q7kNvwGhhK_W&_nc_oc=AdpIBH-WH9AjZg4FSPn5LXAdsDh21tW09YviYK-Nq4S7A9W7x1OHMUO_kKM3taqIMZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKDfcWFpf0IOtO7Uuy6F7on72CwzRO5zUzunR0gwhGnw&oe=6AFB2528"}, {"file_name": "IMG_0620.png", 
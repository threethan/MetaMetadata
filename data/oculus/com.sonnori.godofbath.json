.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhrFzxRDUjYQ7kNvwFlQCOh&_nc_oc=Adop_gFfAHtS4SoUqyggye9ExkM4bwQxiAg1ufGrNDTlx_xXxJtAi94Y3zoLOk-huFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-PSfAiavX3GwtPAGGmtLYWutpZGp7o6ahpt79jbDfdQ&oe=6A896DEF"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9zro3_JPqAQ7kNvwFzFkjr&_nc_oc=AdroA7a9U-q0L8cb9e50YeAwbdGIQfc1YqDiorapMocuE8R43Zc9_UVey94qzOxS4QM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4BfKsR5RRcWfA-xZpU5scVaL2y1qmrSFPoQtLr_VMaQ&oe=6A897741"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFfW1_Qgq1gQ7kNvwF5QtyI&_nc_oc=AdraxDaeZL5XZZ0Y7ofxswjMYS_UAEgNn4Fwi3YzOMJZPwejMB6ee_G1_vD53i3KIkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfrqqyQ59ppTWaAR82_2zTMo97juwO-L9CfiHf58fSFA&oe=6A898BE8"}, {"file_name": "IMG_0620.png", "id": "1547078116625666", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_1547078119958999_8403208151240748249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QeSC-vQtD0Q7kNvwEGw4Tp&_nc_oc=AdrLQx6CjmvjpSgR1BfRpOWNabdMtOMGyqOiiZ0UcOdaYQ9wQYxzY3JZfHUFET_IUno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWrTjCexUtjsXYh9YFyJ-g1HEahbrHklJcwgSa-cF-Fw&oe=6A89742E"}, {"file_name": "HeroCover_kr_A.png", "id": "1544914920259210", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_1544914923592543_20439413943043317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znIF6wCvyJ8Q7kNvwFjTWQJ&_nc_oc=Adqme7Tuj2qjOmLd0z7W1AEz1bqWQ7B-Kvv3MJEcO5vUVT4tLrd4PASD0U_DlVC8K8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUtIp3YOh0sMkfDDFEptaYbMqnsdQtEMSv6nqkS0nQag&oe=6A897B4D"}, {"file_name": "Cover_kr_A.png", "id": "1180716197305101", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t
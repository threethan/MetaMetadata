.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY4FQ2T2H6wQ7kNvwHAv79w&_nc_oc=AdqsBLuB3sorP_cw5gsOkONE-N1sSBRy4HIN_DRtTfUlY2jFxOyHr1TftE71tURwkpc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RFejYmzByXc_N6xm7zJJdYXwc024jryOQ_87wYnD3lw&oe=6A22F2B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4NXO0MWdaAQ7kNvwENdZcA&_nc_oc=AdqpFyXEby5FjJMEeE13oTqp4_jSZlJb5Chz8rnC5logM5BI4w16o2EGwHTEdMe8bJ0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J57Ed7xvmJldB1IWk6Dr1GxS0hT2mIvxG73JISc8-IA&oe=6A22D7A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAVNc8JSBssQ7kNvwG5i_AR&_nc_oc=AdrqATXAa1g0uZSRUuh5acAqCofLR2Oz2ga2WqTpLAz8X46rkwl8fkJMN5txEEguU2c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96VO1jbSfBwd27GdXJsrBF8hqwxNMLDsboMExg7p9JRA&oe=6A22CF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zQj5DXexRoQ7kNvwHuXYRI&_nc_oc=AdoWV3crf8vHXjVb_IvrlBt_cd4gCBs1iSotLnofV2DT6r6a7Hlna-rMB2iTKiMv6Sw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tsnLeIkxwRgd6CLBQYMqfHdMfSv0NJ8pdZX6EZhhG-w&oe=6A22E254"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP9RsUG7N-AQ7kNvwGgz7zB&_nc_oc=AdroXf6x8aYEO20iUFb_FuVDyyCvJdutkp9ybMRqqB9pU4U-A_FIF6WsXQQrSckrzo0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af812G1AyUw8phXWb1-MB3g0kNI2kPmZS8FpfdGMr5gjYg&oe=6A22EF28"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618472_135431524
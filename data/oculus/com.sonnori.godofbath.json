aWVyHLlqHjg-lMx3O7XmSTrmFBrGsSYQ&oe=6A65F484"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1326077842502544", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618512_1326077845835877_8234833316056340159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXHiqCQOZFMQ7kNvwEB_cxU&_nc_oc=AdqYnIBTuvZx2U-pIXaZtVHk4honm4x6-eBppa0xJ2BpTAUoeZLS-M-fSXlDURsgnPM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe8HDD7yEfk4dlAQ8AeDsqz6XnXWIvCHrYvBLiwpArQQ&oe=6A65F058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_A.png", "id": "1140273301593527", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830576_1140273304926860_146687497586925280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1qZOESCaQoQ7kNvwHMop38&_nc_oc=AdpJW32mAhkVQ9Rb1A81r93gRfmWAsFY_4ImNWVigNFTnPafaPn5zspydjEKv-Uru1o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfUAtRT_260WzoRN2SRiWzVVYjmzLS3teHHaIvoNv0cQ&oe=6A65F31A"}, "display_name": "God of Bath (\ubaa9\uc695\uc758 \uc2e0)", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u2018God of Bath (\ubaa9\uc695\uc758 \uc2e0) \u2019\uc740 \ud55c\uad6d\uc758 \uc778\uae30 \uc6f9\ud230 \u300c\ubaa9\uc695\uc758 \uc2e0\u300d\uc744 VR\ub85c \uc7ac\ud604\ud55c \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n\ud50c\ub808\uc774\uc5b4\ub294 \uc2e4\uc81c \uc190\ub3d9\uc791\uc73c\ub85c \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \ud3bc\uce58\ub294 \ub3c5\ud2b9\ud55c \u2018\uc138\uc2e0\uaca9\ud22c\u2019\ub97c \uccb4\ud5d8\ud558\uac8c \ub429\ub2c8\ub2e4.\n\nVR\uc758 \ubab0\uc785\uac10 \uc18d\uc5d0\uc11c \ud3bc\uccd0\uc9c0\ub294 \uc138\uc2e0\ud0c0\uc784\uc740 \uc6f9\ud230 \uc18d \uba85\uc7a5\uba74\uc744 \ucf54\ubbf9\ud558\uac8c \uc7ac\ud604\ud558\uba70, \uc6c3\uc74c\uacfc \uc9dc\ub9bf\ud568\uc744 \ub3d9\uc2dc\uc5d0 \uc120\uc0ac\ud569\ub2c8\ub2e4.\n\n\uac1c\uc131 \ub118\uce58\ub294 \uce90\ub9ad\ud130\ub4e4\uacfc\uc758 \ub300\uacb0, \ud604\uc2e4\uac10 \ub118\uce58\ub294 \uc138\uc2e0 \uc561\uc158, \uadf8\ub9ac\uace0 \uc720\ucf8c\ud55c \uc5f0\ucd9c\uc774 \uc5b4\uc6b0\ub7ec\uc9c4 \uc0c8\ub85c\uc6b4 VR \uaca9\ud22c \ucf54\ubbf8\ub514\uc758 \uc138\uacc4\ub97c \uacbd\ud5d8\ud574\ubcf4\uc138\uc694.\n\n\u25a0 \uc8fc\uc694 \ud2b9\uc9d5\n{1379829726919068}\n * \uc138\uc2e0\uaca9\ud22c \uc561\uc158: \uc138\uc2e0 \ub3d9\uc791\uc744 \uadf8\ub300\ub85c \uc0b4\ub9b0 \ub3c5\ucc3d\uc801\uc778 \uc804\ud22c \uc2dc\uc2a4\ud15c!!\n{3705509663078128}\n * \ucf54\ubbf9\ud55c \uc138\uc2e0\ud0c0\uc784: VR \uc778\ud130\ub799\uc158\uc744 \ud1b5\ud574 \uc6d0\uc791\uc758 \uba85\uc7a5\uba74 \uc9c1\uc811 \uccb4\ud5d8!!\n{1440767961388249}\n * \uc6d0\uc791 \uce90\ub9ad\ud130\uc640 \ub300\uacb0: \uce5c\uc219\ud55c \uc778\ubb3c\ub4e4\uacfc\uc758 \ubab0\uc785\ub3c4 \ub192\uc740 \uc138\uc2e0\uaca9\ud22c \ub300\uacb0!!\n{1134178005549482}\n * \ubab0\uc785\ud615 VR \ud50c\ub808\uc774: \uc6c0\uc9c1\uc784\uc774 \uadf8\ub300\ub85c \uc804\ud22c\uc640 \ucf54\ubbf8\ub514 \uc5f0\ucd9c\ub85c \uc774\uc5b4\uc9c0\ub294VR \uacbd\ud5d8!!\n{2171525650041354}\n * \ubaa9\uc695\ud0d5\uc5d0\uc11c \ud3bc\uccd0\uc9c0\ub294 \uac00\uc7a5 \ud2b9\ubcc4\ud55c \uc2f8\uc6c0, \uc6c3\uc74c\uacfc \uaca9\ud22c\uac00 \uc5b4\uc6b0\ub7ec\uc9c4 VR \uccb4\ud5d8!  \ub2f9\uc2e0\uc774 \ubc14\ub85c \uc9c4\uc815\ud55c \ubaa9\uc695\uc758 \uc2e0\uc785\ub2c8\ub2e4!!\n\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "\ud55c\uad6d\uc758 \uc778\uae30 \uc6f9\ud230 \u300c\ubaa9\uc695\uc758 \uc2e0\u300d\uc744 VR\ub85c \uc7ac\ud604!\n\ubaa9\uc695\ud0d5\uc744 \ubb34\ub300\ub85c \ud3bc\uccd0\uc9c0\ub294 \ucf54\ubbf9\ud558\uace0 \uac15\ub82c\ud55c \uc138\uc2e0\uaca9\ud22c(\ubaa9\uc695\ud0d5\uc5d0\uc11c \ub54c\ub97c \ubbf8\ub294 \ub3d9\uc791\uc744 \ud65c\uc6a9\ud55c \uc804\ud22c), \uadf8\ub9ac\uace0 \ud3ed\uc18c\ub97c \ubd80\ub974\ub294 \uc138\uc2e0\ud0c0\uc784\uc744 \uc9c1\uc811 \uccb4\ud5d8\ud558\uc138\uc694!"}]}, "developer_name": null, "developer_privacy_policy_url":
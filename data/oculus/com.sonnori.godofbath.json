.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI1XS1kHIxUQ7kNvwFr_lF_&_nc_oc=Adqpx-mTY21lEcVIAUtW4amgBi6N8-gxxpbdHGN50ceWhenxYwUEpd64Zuxj5x6Zwac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkag30RJeF67r1Awo-cPYgi_3W7hCMq17cY6Mm3SH-7A&oe=6A52472F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PID_k_ouIx4Q7kNvwEbNUoh&_nc_oc=Adqv7PMXL0lipeMii8NQ7F2bux6NhskM7kISah6IGUY56eTJ72X3AN5Ht4yb510ZnOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjPC52t1iPugmuKu6QLDMCCoJJfza41novr99HBJjFIQ&oe=6A525081"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b82HUwS1xkwQ7kNvwHXYFtj&_nc_oc=Adojq7Ypi_TlUCmSCqN48D6B9aWQXIUtmZUOazf-Tx7HvZaVP3RRgNGRKu2YqQQwiJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABQlB3skvjDij0mqRa90lqqP3XbaPPiqTWEmiho5i4Vw&oe=6A526528"}, {"file_name": "IMG_0620.png", "id": "1547078116625666", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1547078119958999_8403208151240748249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtD1HeOw4L8Q7kNvwFcNr1r&_nc_oc=AdpAKZzxYNaEZTk_bE2E8PqNfZ4DxEOxKud05uD-nICuBOMuAm2YGVAIQT3zdUPOz_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4PJWdMncYTo6xXhnraICs4JUqGQSE--dHzJdZ-o9WuA&oe=6A524D6E"}, {"file_name": "HeroCover_kr_A.png", "id": "1544914920259210", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_1544914923592543_20439413943043317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gST4Ok5d5DUQ7kNvwEuwkCQ&_nc_oc=AdqOxrGJvcE_j9JCEGTFVTVqYEF6elXgM0Z3I-NMZCX6CgYydFWH9DF3PiCx9CHlMNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIntBmSEYMWJE4ZWS9_B0L1XQhyKLX35QxFM5q_InhQQ&oe=6A52548D"}, {"file_name": "Cover_kr_A.png", "id": "1180716197305101", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t
5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfNjjumkNaMQ7kNvwFxnB-S&_nc_oc=Adp_PzBIbt2Z5GSc5CZ01vuxEyMFq5XAzOme-arkH-i13ttBoXLGJaLLyOxajFbyFL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wYPejuFSUUBu-BEVvbm8Ix0phIGEiY7gLO6o0ghdX-g&oe=6A1EFE33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V21coaez_OkQ7kNvwEodmwg&_nc_oc=Adq84i1gLrKD2U60Hvdr5SjHpKO2f9okvokCB9GIaNwyEhUTHxzecQB-n7JcIMPhHYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FV1cZDEc93eDsTCh7J_NOHLQ_-v2c1FqE1z9YcpVDgA&oe=6A1EE326"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxdWqDAo5HIQ7kNvwHcHbl0&_nc_oc=AdpJ_v6xqFoSNko-7O_RLfkm7dj5014Jjx3PyonRimWw_Vs8ASr7FOpavhm4oyXyImM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mlx35aHMR1FM9GiNF5472sBQg1GBwkRsfzHLJRv2eVw&oe=6A1EDAE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq6d_KQoAXkQ7kNvwHpvPc3&_nc_oc=AdqxxUFQ8S-HlYXHg5SrmdO8VQHvlu82j-i5f_4atn4g95oy7moYSLownrbXx7htGcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m5iXXouHU198OdCnbjvqrsprrj3wHYtut7M8vNuBZPA&oe=6A1EEDD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py8NQOgPPM8Q7kNvwFczVEi&_nc_oc=AdrQ1ZCNyQKMoVwoFf5lmKOCjTQL2rTdOOwRZEJLR265BU6CLtbgt6D5IP1XUSlSzxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fdy0qFYanpPeJVWfAphZ8TjFcSeIHf3khls8S0TusAg&oe=6A1EFAA8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
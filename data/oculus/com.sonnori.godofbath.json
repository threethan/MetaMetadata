5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoBy3HTHO1QQ7kNvwE854eF&_nc_oc=AdodXKoBVUX8Y2Qg_mPy-0jpSDw3-kD7-T8ZhRP-39P14mnZuYBUnlzSrRHJ31rQ2-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Gk9PVGBg_CTg4Z5ARRQdfJF8pazowuCBgY6zIFuFEw&oe=6A898F73"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16_XUiXd0EQQ7kNvwEMw7Zn&_nc_oc=Adp7uO96Yrp81f3fHYj1tjNt0v-IklaxuvGtNahwvDWfhs4MFVBEZ0Ej0yIcFCQk4CY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy8ivmi9iyGDgNHBdsbIjKpnVt2dq0H-6OWuXeJH2F5A&oe=6A897466"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2mPtVk_W8EQ7kNvwGjIboo&_nc_oc=AdqhbH-akJ2Ebiery6IxEeBfAYEro3-5AfT9clPpGIJDrcX1MEnIzmS0ATAhP7Uk1TE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEINQ_4H3uqhDNonPdgcNUfq_gTzUYv3Uly_T2Kyohn1w&oe=6A89A469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaXH2dOlnYQQ7kNvwHDKQBh&_nc_oc=AdobCh7Ka_qc6sETJ4RslpAXQjStjZY5DDpY9WEHhIlsKOfyHAnxTiyZbBrPpyRVcTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwEa0eLjqIzIeaV0kHSdIe9K9z8dvK-6EJeuG3s0fIKg&oe=6A897F14"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFfW1_Qgq1gQ7kNvwF5QtyI&_nc_oc=AdraxDaeZL5XZZ0Y7ofxswjMYS_UAEgNn4Fwi3YzOMJZPwejMB6ee_G1_vD53i3KIkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfrqqyQ59ppTWaAR82_2zTMo97juwO-L9CfiHf58fSFA&oe=6A898BE8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
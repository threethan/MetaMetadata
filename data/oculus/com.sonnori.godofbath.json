.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aPxAc6rZMgQ7kNvwE3TBPq&_nc_oc=Adq1fe6FURWVrV6hWwzjiUzB1j1GAoWvIioFxzj_RRQYI2DsWn1jAiHsSo88TEknBNI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wfG2om7zfb9SIhK-qpDhHcRyZGEux6Poo81ffOw1qnw&oe=6A395C33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zK5ASMf8I0Q7kNvwGpN-UG&_nc_oc=AdrfTGhJC9OAamgLugEU_miUhTjpqt0UEon81RzSQWKn6v1b5LbIeYdjOt0eODarJpY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iX3Ocwu5kKTWIBxG5e_JycukNz6xqLfKj3VIL5Bwnbw&oe=6A394126"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23Mb_7SCFnoQ7kNvwFcx2uW&_nc_oc=AdpQUrprxaguUohQZzR_UqONd8Fbs80IFALOw2qynTU2CiVv4stmsntyHtyDooe0cvQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vnw12iEFQ1bMaUgNpmtxgGZ2KdPbc5Rgm6z_GLqb8DQ&oe=6A3938E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xumx1vultAkQ7kNvwGn84t0&_nc_oc=AdoQhQI8QHa5RlbJysEd0n5LRTGPTRX2e15nALobab92mWS7tyZCnoMBvin0vfJPZ6s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t547V2BSbyXAmQNOeJXIL1LylQt9XAxkTfP6JWBahRg&oe=6A394BD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWH-JYIWMJ4Q7kNvwFirW6x&_nc_oc=Ado6iDe_XcIyEPvqP2qsoHUlzrp9R2UVXHSo7uQ-NxjJCpi-Nom_P1nA8cT__ez4m-0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ojWnrnkuiPbo2n2E6pfTDxg-s2PUE0uCTIdI3ZXKg0w&oe=6A3958A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618472_135431524
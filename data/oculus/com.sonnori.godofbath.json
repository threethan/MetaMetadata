5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J-HXzHecD0Q7kNvwEGwXs9&_nc_oc=AdqAd5h4p5ay6CrPFdl63M86hnL0k2tikRBhyvLdYTBAc-dSZ5jMnnU4x1oIqGSBpQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBqfFI4R9VYQehivYwpqdRgkENOjISMiP20AbcXp2cpA&oe=6A7B0EF3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiVrxwE7rQkQ7kNvwFuMl-J&_nc_oc=AdplXpyPd8APqTOUOdOvLRGIzg8wT19akPnrPPk-O3eENy2ovKEcCRTadEH7wSM_tuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZLNzZKxFDB_0Sk399u8L_p6VmhrxZMMtH7oVNJMAahQ&oe=6A7B2C26"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpZmwLDtmUMQ7kNvwGAAb9v&_nc_oc=AdrHNdow3TyqIgtT7TyYcnpaUCeHA_Mf6gYwEuntEg6-EXz9oWs3WGeNuKrck-hhz3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpnfZgJxo9zva2PXDPKM3Zv3zu0AAX1wW6XXI9qwR7SQ&oe=6A7B23E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H66fZru6vJsQ7kNvwEcLO5t&_nc_oc=AdqExCeSu_T-Xozqr3__pAJsYA_t7auTBWii58yL7di9YZI4FLSOr28EsevVs7P6b6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHONTg2n3tm0f6IiuDsZEzN019CFusVNqC_IuzkgzyvQQ&oe=6A7B36D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak9VJFjcBEEQ7kNvwGYfcU2&_nc_oc=Adoa2FBrdoLdm31Y5hcBLEq1EfybswHjPI884f-NuU6zt2JJ1fOg-l6a6LoCDqhClcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9YSpIPA0jdMeefwW9bg4fwju_ycqNcmZlnJnDZ7T_0g&oe=6A7B0B68"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
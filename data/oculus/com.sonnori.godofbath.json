.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7msRt-nGqA8Q7kNvwEwhxI7&_nc_oc=AdoMG4A2FILVTN50zb9tAYRoN1j4YQfrZ8ZB0sdMgy2nGRMcRvG3H3HeS1xHMENCwf0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwqYiCi710d-NYRRhxCEnudRu7hVPq00Jvj9CFIGSFqg&oe=6A94322F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkTF3G1PJ2oQ7kNvwFFzPZY&_nc_oc=Adqj28XdtU1u45eXbYSspKhnJD6jOz6Vh4GZL3SkpkNfdgDgc4_wYs08VapMRyGCRho&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW9FfBr3Nm341gWGrkbKahXHdB0RhI_L8khbmA2YMFWg&oe=6A940341"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb3Rc7rIrEQQ7kNvwHfYqex&_nc_oc=AdofNecX7UbekQSqOTYs4k7fmOi04XS2JQE472BrdVmR9vgNuEadM07hyehO1_XrK-o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRzHKA-V1w_fKUpnXdE9Su8cKs6xHThfDknWZFOnZeWg&oe=6A9417E8"}, {"file_name": "IMG_0620.png", "id": "1547078116625666", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619174_1547078119958999_8403208151240748249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Emg2XjzhVWQQ7kNvwHqR1kT&_nc_oc=AdpsKLszXDoxjkuVYiALwAglz-q8InV04XgeiCO_I5AI77D0JH1_LDforNp9WxGnQwA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwTPIGnx7pNNWXuXGReqj8V7okUcLxh0_ZZMZb4av7uw&oe=6A94002E"}, {"file_name": "HeroCover_kr_A.png", "id": "1544914920259210", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618472_1544914923592543_20439413943043317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCk88knUQ5wQ7kNvwEL4br8&_nc_oc=AdpTqqDPhdVN1jJJsr5955Qls3rzI5PIROZuQkrQbHTOB8q3KSvbrMiGkKRY_JNQXqQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzlgFIa77GUPBKB612t16DFYL6EN3d_SPFoGcKpWzNwQ&oe=6A94074D"}, {"file_name": "Cover_kr_A.png", "id": "1180716197305101", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t
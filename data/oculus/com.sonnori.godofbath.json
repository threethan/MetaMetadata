c_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTigEdk7K6GO7JnYELae0Q6Q99JpIvOeITckz9-8fGCLw&oe=6B05CBFB"}, {"file_name": "GOBVR_Screenshot_04.png", "id": "826037636688789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOi9jUsopiEQ7kNvwEQ6jm0&_nc_oc=AdqKWBJHBpJ3RVApGoM2yZ8QuvlSYwKKQs6_KNOtWtOGwbyVcZxcQSXqdiSPwI3ioyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqVamZHzam9chwG1pHIguC0okuMZSCWImxLqjzOoUv_w&oe=6B05B4B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mzoxcatuskQ7kNvwHIPh1L&_nc_oc=AdqG6egnwREEcrswpojNRYtKRImUJKVl9xXF3MfRkQiMwRY9m8DKfK4t_HY2kgvEGMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFyoRTZR1IEvhP76RWahBW-urmd4vMit3ui0HyNGdEDQ&oe=6B05D1E6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PQFx1TQinAQ7kNvwGKsOu5&_nc_oc=AdqzUmuhzbtJLorfPBVHgFUiS7IeTUwRUq7LKgsPZSfj70mIToa0ZemLhINPGe2t-e4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc1Ua3-CrVWY-_yOKflwd3YkV5MnPRYxm783kOUhkdtw&oe=6B05C9A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxCrtFuyWn0Q7kNvwGd0hsO&_nc_oc=AdowK4IklQDI6z-uHJOcV5gluOPtnPlV0y8rU-QkRXRQVEY47iCD774hoQq-lViDHgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyb8SC4yXvBKSqL78WRwGhINZpxeVP8TqtqlQdMXbh6g&oe=6B05A454"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq3XFJVMyvIQ7kNvwFa6u9b&_nc_oc=AdrpAe0JCcEIyhGSm20sr
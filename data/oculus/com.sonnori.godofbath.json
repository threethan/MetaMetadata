5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6JjzWtS0HkQ7kNvwEt9slY&_nc_oc=Adp5ucIU5DbLrV-7EM9KCrS89zc33mIrGdNcXqL5nQ6PzN5FMA4S6lticm62p8z62uE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zLKu4pZbEkqlsOCxJc4_Sa6HvfSvpYXvKJWCi4fDTJA&oe=6A1B09B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX4fhtMNhB4Q7kNvwHqHVJT&_nc_oc=AdoBARMMhPgdeBWBd5TUOOfV_vrUjSG0x0Ze4mOTuLVBdxRwk1Xwx2MuDcYrus3SMFA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56WbtJBrrQmYnj4r_SX9Fcq37Kn5yd3so8erFzMyaXVA&oe=6A1AEEA6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eilyWQVlCmAQ7kNvwH_iyl0&_nc_oc=Adpigc0_JBxcDGxCP0oUY88HuqlLI_adqB4fXsJPdCu7s9SSpbWaAKP_fAWFm6MgMRg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r9xN2na-bJTP1HzdU7JrHL2tj3p8a03qQFkL5JzEpsw&oe=6A1AE669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPDK_u1SOekQ7kNvwF9uBCW&_nc_oc=AdqP71bjuWU660YL775WalZBI_5DLkWz3jUvPuOrioKEgdEi-LvlZs_LjJaEQBdydW8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bBgmjtHZUrsJHII_8GXn0JvSXnWpJ0XqMMfkZL-67jg&oe=6A1AF954"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEiwDb6dA5sQ7kNvwHl7J_c&_nc_oc=Ado1OdvagpkCcYMu9XH-1IZ1HxhvGSaBnD6iqzFTiFA73-DEH3wi5vJ7E_j0-POqXMo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Sc6Hh1Y2L-HBaASNX3HT2DXfHOwNiw5JhWsE5IQ2xg&oe=6A1B0628"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
71-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOqFz3rB5jIQ7kNvwGLwFJY&_nc_oc=AdrDQMRtarnj_6F8yP4yzWrZeaZ0ftpb0Inm4FIDbBw2haOAPy-NLkWumpy2Gijkzao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-OSNaTc6U4JkQBAcRZseFbdilRahUs2v0vlyv9KcnyA&oe=6B09C666"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwf2S7H_xDkQ7kNvwEFH0CX&_nc_oc=Adrl4JEBxgKTj3QxgwbbOvK45Sn2XqfMp_MvVflb5MTNhaSQOjILTKAHce4_lS1n8Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbWAgpb64lBwTBNmx8v76q3JsAV7Rw_ybg_tfMDBDX7Q&oe=6B09BE29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_en_B.png", "id": "1393935742074773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugu34KdjY_MQ7kNvwGZp6Gy&_nc_oc=AdqcWJs1_FFvxt4nWQF2d3pGCm7Ue95SLIT_TvEIhiMKfVVWAMI318B-mpsqhkCxT4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREy_UfW9i26QgTnWlucbtEocEFAbKebyH97Efg_uT4UQ&oe=6B09BFEF"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Tz7KSNrMEQ7kNvwER2wux&_nc_oc=AdrDCfKLoIxuHdP6gmhjkrM-gt52r3QVzQnSctgsQ3nKua6kJkwtLeIHg6ctroOIq44&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0UMAKdmBSNo2HAKT1q1jT93HZNo_VU0ZeigoYTBXXGA&oe=6B09C941"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p85Jc1Rf4wgQ7kNvwE5qQpb&_nc_oc=Adrs7lizFab3x_f-QbYM1mQQybph1ISHNHcBUD6KllKYS0LDUUwZQBxLxAyjwBZhsGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRulV-GO-15z_tJBVIpPvtDONvBZqqokANFbirKbA5g_w&oe=6B09A5A8"}, {"file_name": "IMG_0620.png", 
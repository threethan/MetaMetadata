5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLynB5Ct6hcQ7kNvwGSKi7H&_nc_oc=AdpZqfMI_e3CnHqkiSKajnvCzO98sTHiYp493Cba2-eaBtj-q3cKNsq99vQB4Qv_0Vo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0BUAGagr-yVsXAHxX9Gj-TW4jPlOQprW_5ejqFRZKlg&oe=6A58C7F3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xQIk4q1yCUQ7kNvwEk9F0E&_nc_oc=Adofz8lfr1xXVCBc47GVyl-e5Eh7XPFnCuHw1UzhQt-IgCgDzYiRRU5iybOg5U-DaQ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLH5w8oXyT8L_bMFGtFAy-3M6wZiy3zrbd3U3tMy8KBA&oe=6A58E526"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWU_2Eqw760Q7kNvwH4MuyF&_nc_oc=AdqXwKjWW7GQiMf-70kFeKlmsrgawxq7G6Le4rQyfj1Rl17BbraijnBEFs2utp_k6KQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6mlH42dHRyYTtFNk8_O6IH6tqOoSOvNMgvShfyt1GhQ&oe=6A58DCE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yedplgkL22gQ7kNvwFRj7Dh&_nc_oc=AdpdhQUFNSYvD13F2eC2widYng46t2nryxIkRjUWcg7a7z7lE6MRfMs5ku3acpOrhDk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZfMMK-edfZ_u2jpSrSy6sCast2GTu0nLAnvdLHJxTeA&oe=6A58EFD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ldvzUPDNpkQ7kNvwEywPqi&_nc_oc=AdrryHrXOhOJ5tQgb2HNJoTvzAIgEaldxtkDFxqYplamJnAL92CRM6NEpQ7Cbr4Mw5w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIDkeYK_8Lz-400aTp8729L33dohkYPZKkQS8uTc1t7A&oe=6A58C468"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
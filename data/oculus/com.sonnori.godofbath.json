5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqNqcQXT4y8Q7kNvwG8JB2s&_nc_oc=Adpz3ex-9tvsS3vfzh5VOhnZC5Pgjn-Wll_o7whKuRtz8TidU6tv8YxeJv8VdBAMsB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QS6s_klOWJrJkfYfhNk6hMXN5ZhQgK6bNJYqnX6t0Og&oe=6A3021B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1rdTjz5q28Q7kNvwHkO7hl&_nc_oc=AdoI77z2jK_-UCOoHR9o-z3lH1EpnfSMYbtWy08EZTr-r5qmlijXkAxji_rPzt1dqyI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VYi4f9yQocsheBWDkm1zisBE870JpXYJxX0J6Kd5Ojg&oe=6A3006A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_K_YeGXbHgQ7kNvwHX_DPd&_nc_oc=AdqWRZHuYrBAtloruSKJ8IAd6FS_urr9CKrj-oGS3fsBTshdRbRNEdVLkAFmoDIc8j4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84KRcZGKHov2GfVExyopEHs_eDxiBwwICZIe9efMAYew&oe=6A2FFE69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PYMLHj8gC8Q7kNvwEDzhR6&_nc_oc=AdrG_2MUVx92J2nMqtPZqGEWbRvX_-nHO1j-qo8ZBi68aZJemBETHqmqw79lPvSijDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xZ76BVY9UjZJJUNTUn7FIEUS3IOGTr_QQQre7HySIng&oe=6A301154"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85UIJK54Wr8Q7kNvwG8cOrS&_nc_oc=AdpHO5HB5E0LbC-Mftq1N2Pi3QQpgJQrNjgGjcE4uy2t-ROnSVBqtdPw9CzrVJvwByg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pWdI1kRlzgvRDoarnrzNFnhVZa1UR1B24gXr7r_i_nA&oe=6A301E28"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
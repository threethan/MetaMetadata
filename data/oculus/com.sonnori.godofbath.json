5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wDxjDjtk1AQ7kNvwH7vrp6&_nc_oc=AdqFqHb9EP5Y51st-1fHqpwC1x_n6fWnqcGQDjdfReJujiPsW6dVoBUjKZBfp8C0SW4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIY5b9O90aIhmKie0meMrmGlAYGYv15Rwptko7cf7IdQ&oe=6A917873"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGk6TinXGaUQ7kNvwGABLJc&_nc_oc=AdoumdBRvXxNQhJKKpyjg63-U_MUgJGKFnw7CC_erHIdSEyihi1e4VdYpCXF9CJ0bvA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW8OGBOv_WNjQie1r96QN8J5HHY3xpgfwVip5aFRq7bw&oe=6A915D66"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J_vZL73Es0Q7kNvwE-h2YH&_nc_oc=AdpXAXFdwgRrpZatQmPWqN3ITHvz_xJq_WsHUWmwDHDIDv1-cylgzzr3aN-19xoFFdc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsCgivPqcCivgFJ5T9rgs4RpJSFvJ-N7p0b9TDb3Bl5A&oe=6A918D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBiZJihPLqcQ7kNvwH3e2sv&_nc_oc=AdpAvM0sAU7857LPUsopXCA-VT-b2K0tJ67JHQNxAGSHs5JX6POIZoQOoK4fEJAzNRg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhJ9ZW58v-N2o5-WCFI6YdohEqFd-wDus2hEayobYB9A&oe=6A916814"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0ZlnMgiKv0Q7kNvwFtpH-m&_nc_oc=AdrXIqEah1ClvHQevWJTOSl0RuO5hr9q_NT9wOmjK6roNEFyRSunRLXO-F2hFQhsYzY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE5Il2LVKwYbA6akF2S1RB3zZOPXCZA2jiTevPvcoibQ&oe=6A9174E8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
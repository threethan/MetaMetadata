5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4C6UzG_bgwQ7kNvwFNx6Yj&_nc_oc=AdqzMPbcLG31WrdJ9EstdRAEIslesKA54dTwNSHZA_ExZ8mYDmi9D9MOc_SE7FxQMJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR0OjC6k8RmIVE4VeG82eons5uWLTs8AtorrH01wtxfg&oe=6ABA8F33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBldrH8f_WwQ7kNvwGvi1GN&_nc_oc=AdpGRvdxTzz1t7nM0TYQKoqmr2oN7vviBY_QP3-mjP-B0NvS5L_fcuQeM7g7KAO3zjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAtN8dtakoAWiVAZCWXGLXWB30kycIf8uPRFo4n66w5Q&oe=6ABA7426"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bLDX5Y6SrwQ7kNvwHv-AEh&_nc_oc=AdrhTHySMZbmLAP8TegZULz7gNGOLnxaXqCO8Dfhkn-ZCXAEq5Fdnk8bH0-XL6MhaTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl4dE7PYTHIrXR_tr4mKhMV4Cd6IUF9lF2g-nY5R3EPQ&oe=6ABA6BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYlHxi9hDBEQ7kNvwEOXj_a&_nc_oc=AdowCCLm86AeNhs0JFUNKLYvIUeZ-ceZZh8tYqLFPjK27d-axTyY_kdWAUiSBs5AfDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJeCIgZ2v0ERFG9jCyIMT5YTay5wrOoNh3dUlycITfHg&oe=6ABA7ED4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiTWE_BK3g0Q7kNvwF31K7l&_nc_oc=Adoj4NqiPwigxtvJfh_fYRRdET5RkQxKhSWM2kC7_VPfFNf8L32i1myoatrW-4Kr5S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmZ8TU0sVV9Wa3kBPGnUJecsXv2ePi0kfD_lzgE7nwGA&oe=6ABA8BA8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
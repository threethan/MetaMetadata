5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9m8ywGoMLIQ7kNvwG09Dbb&_nc_oc=AdrKiJW5ctD2qk865QAfxaAFZLOxmq-g3yQiIKduUWQwm4OdHTGKM0M4St-duYt_veE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn5ZvtndM9D928qrsv8lUbCv_0Cx-QDfUZcTI4z3Z--g&oe=6A65F6F3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo8WzDxULZAQ7kNvwFg6n_V&_nc_oc=AdoP27xn9U5YxOgpaP1SoK2ottkKFyRVIt0_lC8q9SZkVJ7K_g0F7Ixk1XygSveI9FM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR4NT-JNkiajfmODPH2tUHseUDAvW3x_qrqBgv0DgQzQ&oe=6A661426"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jh1J7lWd14Q7kNvwHvEWkb&_nc_oc=Adoef8zhye3WiB95mbVFgP3b6WRzikOrc40421BJC33nl2Q5jVVPnVsaH-8LM4tzyTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDURoKzTZN8BZUgSo_nBNrlbJrQIXygH3v3V0Og0pZ6Kw&oe=6A660BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vqf1bhIbdMQ7kNvwEIezUC&_nc_oc=AdoYHlsgwV0M2nfu-Ebh5NPRwy-i3FiIpk8KfD-xPIETvEPZRxb8BqoJqy7wU3XSiog&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALFS1h3fgG0Chp3CzjLD-k2tcMjw697iLkvCJZxF3Eag&oe=6A661ED4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnH7DOBfbJoQ7kNvwF6QPn7&_nc_oc=AdpWkfGFeKvWn1oC-YNkNHbXdKX5FdhoyfrekQEIe9QgD51JsrZsuX8fGyP7Yo30V-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaq2P2PA9ZXbvgFWGR3Md5PBZvIKOqOy5y3ttqvIheBg&oe=6A65F368"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
71-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjot_Oq8kAMQ7kNvwG9--Ux&_nc_oc=AdplvO--pUYFSSTmgvDi2zRq2r0HcpjYKvz9o-JDSaVQaDJaysXGnqLGvzgW8R4DroQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0ImrrWcYd0J5RBfF6RvCwUNPU4WH6OG79UiS3SxLGOA&oe=6B0F0C66"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N36lCCFAtxYQ7kNvwFLksNe&_nc_oc=AdowbTCUD7PgD2GL8klva7nSqaGHS95sEUcMhnqzh8ZVmtagGp7wHgmZYz_bbxY4eis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxYm8PUO63PATbt26E-SpW8-6vWKf0tT12fiTBnkqlpA&oe=6B0F0429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_en_B.png", "id": "1393935742074773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-6gPjjPKWUQ7kNvwFUhYbU&_nc_oc=AdoI5PsMugbzehaK4ql7vF_lbgtLldERQfa54iShHkIqSc7cZIUI2ABuCR4b89VFpVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWjMSt4tAozm9s2BP5ySdPpodIGuLxvaPbdhGyc0VWqQ&oe=6B0F05EF"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5xxDAhI-egQ7kNvwF-8cGE&_nc_oc=AdqNt4FzH4MoAOqFsxcI7cYt68sDiAP1g-W-KZtILNtZxfwVa5BlWKou93BS82HXM_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-hcj4Rt4_IuzTYja4LJmbUu4il-8zkKvE0HnMxwUhKg&oe=6B0F0F41"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyLa_1WTNRIQ7kNvwF0SU9Y&_nc_oc=Adq-WVGibdQgzYma-nLNSc4JarmgE53jnVBo-TyznKERuFpO06AFU6Xr_DpfBdz3iHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlMynGBdvdjHkKZ_t3zCCakHRDpo4qbG6sIad4l-RXrg&oe=6B0EEBA8"}, {"file_name": "IMG_0620.png", 
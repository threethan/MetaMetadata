5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxYB6uJgO4gQ7kNvwG0wWbg&_nc_oc=AdocAigxzaUFMvWEzpG-I3V8HY8Xo1fP0Of6XSH6m1d8W3XZ7gLrW5cUdlchgSCLzwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYzSy0Iyzh8glNNB6hJLz6j6op8RpPho8AkE8KjUf2eA&oe=6AA81A33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kTgNEYx3SgQ7kNvwE9q8LS&_nc_oc=AdrPaeM4TWtsd28o-FFcaKhKMlgXoEKasqY0M8XfXJfqfDc-cMlClzN83UFM53qEuwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxkWp0HQWXmp_NB4OBY_JmqStu2VzjYxw7W270VHoojg&oe=6AA7FF26"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG_1BoHrkkkQ7kNvwEuVX6S&_nc_oc=Adpax_4K-9n8m8GxygtouumCVoZri-lZcgftWpEsuRYRBu6wadgMuMMos3t9cyZzjdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRdmkd4-5_jJ4zNycRw0VdogY1Xn9rkW30MtgvQCuXHw&oe=6AA7F6E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej7bzyrzN7gQ7kNvwE86AiW&_nc_oc=AdptqWRUJ4lw9c_TPwSfkI5K1VDv_ANjAoZWy7lMPNOBiGMw_Ye4C16dS6hGIUCjPAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSZsFFRp4wVJVsidxdcarRZtYc4-Xyw94oaujqBWB7lA&oe=6AA809D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZzcHymn54kQ7kNvwHUcBbD&_nc_oc=Adpk6P0xOeF107W2YCCeZHWrmPeNSqTTKvnqVqGGfxX1p5HB2bn3QPgC2_lyKifdmhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMYSwclrP8m04M6T5EbuKNsZfJjzy7ZaByY3S4s3t1DA&oe=6AA816A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
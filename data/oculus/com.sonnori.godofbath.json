5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZTfXCHXcNAQ7kNvwFrbhx7&_nc_oc=AdpDukwygztMp7xU3rw25EDJiNo4-pJEGt_OcoF2qrL_NhT6UkOUrXYF94Ad0Gs9Od8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrG88PfWXIjc3UXDKdDHRoChOO3k-fKT0rtYL0ekJYQw&oe=6AC90FB3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv0c03xNMWIQ7kNvwEqQ6pz&_nc_oc=AdpXh4Rmx0NBwLy-4LhhmaVAgYUzKL0sxn-t0SWSOJq-CPEsKs9bOnDW1JZ_xJMJN_0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN24oCtOn3HmbW9TWAvFFp7jYRj0GTFOdJ86OwISXQNhg&oe=6AC8F4A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDyEgbd5lu8Q7kNvwHPdkXR&_nc_oc=AdqFkbDFjgw0Q7qS5Kyo7_cvVmPqOhBirVLpn59kjtX8tEJY3MZXEJW7UutGjDOj_7E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBLR3krDj_KpaItVkxlUOGG20oL03SySmJxO3fo5dVgA&oe=6AC8EC69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTHUtWTbcWAQ7kNvwF9Kjxz&_nc_oc=AdpTdHqagVeBaA8uEp_NZWCRhywV8pGO0Tjq3pI1U2n08GetpYQUmfF01KN7MIB32dQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ7ets-wPajvUoV0UHJBYQPqXTfZVK0f1Ddq_i_nPmPw&oe=6AC8FF54"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGCE22jaqPwQ7kNvwGUNPX5&_nc_oc=AdoHCYtmSkdPueYmnMFN7BqoI8ivie1BH4HbxXsS3seOa5E2ZSdvXnUqe886xuoM2M0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC_wwNK415VjrHF5bDh7Boh5Y50DWy-8WZ0LTgBfwR3w&oe=6AC90C28"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
6_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyIlM9hTsIQQ7kNvwEQ8jpo&_nc_oc=AdprCDc-Eszbqv42uVpoyQKX0gyQ1QJO3aarGj2fHqBArSdsy6liDaizzZWzd5vJMDA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bZ3Nr2KDwjITB7yY4l2ECyIBNKhfzCHYQ6BljlYeshQ&oe=69F1F2F3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LlcGS64epkQ7kNvwFF_IVy&_nc_oc=Adqy8JUybZKMynDEWymKYsAQLCtlXaxHoRLoj5bx-6_9sNDVKfQPS1SGOvGY6r91HHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af02WcqAjfuRUAG38gM0jckNoO3bMH6BO8YX5Sh2ZntRkQ&oe=69F21026"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lxAg2s8Cv4Q7kNvwHbqiMI&_nc_oc=AdrqkyR3vHFwtJjzcGZl_jBTGWsuc6SDwTFgPbdnyixNZEDzRgaNXHviqKOWrqduWVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HIe5q-GTDJUNB9ew1v2EaMfB9kGEiXZ29iwtXrc_6pg&oe=69F207E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xb4FM-gjdsQQ7kNvwGV74eZ&_nc_oc=AdpQZ5Iry339tsSLzhXHWT5OY2RuwuF_mQ7AP5giMvMf2BACfz84A2rrMAJKH6xioQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GSTp8t9XCTvnTACN6NGeB6lIsWQaKtePBRe1rlfkIrg&oe=69F21AD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iOSFdL3r40Q7kNvwHTBrkk&_nc_oc=AdrP8PNsWZVNVNeylZtLADnM_CgTWZiMmVbdf6kgnB5vaNex0K6GhPYQdLLfD2CST3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RH41rv_LL0Q5OwG1dNkXzG55ynhyrf_1D7dhkvu8Z_w&oe=69F1EF68"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740398850688241547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03ie7ypwnmAQ7
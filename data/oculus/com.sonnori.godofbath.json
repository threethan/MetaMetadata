71-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mzoxcatuskQ7kNvwFMh87o&_nc_oc=Adru9UKwb8qc_RuEcQc8vxYOA3GQzdQNAL3o2LgUNCsjESPAcB-PWPE52k0J0RHpDdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCyhpMj_8XUUAiJ-4iSaQC1QVXx20txj38LrLdMFBAZw&oe=6B032EE6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PQFx1TQinAQ7kNvwE_bfzT&_nc_oc=AdpEYM6DkXG-QT-VRQnbQdU-ozRfdM5PYR3GCuWFY81VkFBgSW_5_5LKrDbRF_1Ln08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxemrpyc34v258NOJkBknBecX4DKTFbVxnPEdmAjOl2Q&oe=6B0326A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_en_B.png", "id": "1393935742074773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFpR5gvPqJAQ7kNvwFrKibl&_nc_oc=AdoiPl3D5_2qqB1FuRcAp4fO5G7PZQquydvzz9kyASuk51elKB2xYqRdI3I8cIKdxgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-a-IaPzlbfq2LLw1FGHQvF2bFOHJ4LWB-GKEAP61dag&oe=6B03286F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-urxyPAZK1oQ7kNvwGaU1xT&_nc_oc=AdpyKis8-kvUIfEDtM-kSpxJq4AQp86eTtZs49h1kwen1lHAYncsiCdE0lWRSShk-IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxEAOjlPOF0uRx2TtjpD15PlYZzGpxAkMVGC4LJLEiEQ&oe=6B0331C1"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BZ_rkM5JkEQ7kNvwFH556M&_nc_oc=AdrotKYpRL8ApPnKvtl1LAb4ngLv7lmMjggU8GdlCnB4eektKVzMwX-ZD28EHxVIYLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCGk4Kw2Hx_ux3uZr9C4AN2gDuwmi-RlJ32k314TGsQg&oe=6B030E28"}, {"file_name": "IMG_0620.png", 
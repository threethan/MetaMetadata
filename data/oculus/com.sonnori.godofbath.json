5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RepeK-paXgQ7kNvwFqUuRn&_nc_oc=AdqQg-yzHJCXlH_5C9aO730r2irViwpqXTA7ZjLv4hbX7LDWurEY4ViccH4Q4dBf5Wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEOqqUtBDH-XkopH1Pq9q3PX10OTNS0yQbxCjUsxXKvw&oe=6AC66CB3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwwbsoaPXoMQ7kNvwGqsWLR&_nc_oc=Adruaauo4iywpFZqnPnfunrLeT9ouaBPAdhabB2VqQ4O6B2wBtrn3Vldn2amwtcBV6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkSa7JNUECHURk0Xl8ewPMPTt_UKyGSkLwURU8GDufuQ&oe=6AC651A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujhMmjVIiZcQ7kNvwEWH1Hl&_nc_oc=AdqyOA4_KE1lIO7sWH7PhfMATLveoAxUYa68X6FAnh1rpB-I4DmjEauDzktIgmcNDRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFuWWSbVilJNv0h1-mz9f--gNERO4O_a5OqozNIIe5Lw&oe=6AC64969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NQqWe8rXC4Q7kNvwEZYKNH&_nc_oc=AdpXhSjW1areV6Dfz1qmfRPQRiaNydVR1IUiBx8F5ttzSJ6nugzY_DQmweVbyCB_90g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_BNn92QWW5kWPNjOXC8b18t9-26TxOmtOr5eeb1ifPQ&oe=6AC65C54"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGCE22jaqPwQ7kNvwH81YHZ&_nc_oc=AdpZaL0RJuLmfGBSs_RP1bzW537SiC27dzuQ14h5ok3k576IyCXKjc_n1QSu1C3fYFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCQ8srjcVAKTLeTI3KRcpG0scysWmNVz9XglnFSgmxlQ&oe=6AC66928"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
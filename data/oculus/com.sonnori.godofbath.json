5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6JjzWtS0HkQ7kNvwG75dE-&_nc_oc=Adq-rs3JiSG7YcaiYWwosa13Mn1keLXnkIKTsxvaeAEVslL4Lh65cg9FJSU48vTcSFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OOirXnQoCxIdUuhNvSSAOiqotlY7j4RRUp2iAPiHIBg&oe=6A19B833"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX4fhtMNhB4Q7kNvwErtl0v&_nc_oc=AdqCJLq4mGxDzeOQLf8ZjEKsvDrjfhoxt498Kk3uzhtY921ET3onJxNamHNuU07XDX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v4MV56FwNrJM0vvTyxM115XCxJ5NXnls-AKsRSiwa7g&oe=6A199D26"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eilyWQVlCmAQ7kNvwHajRDF&_nc_oc=Adp_TVX29k8-J3gfzhyjogd4yomZMm-j4jWFJKNpMsxHgjfDwWZWoj-NNWSPaPMsON0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FdoV8RPyXF4nekCVJHPCMsw31_GqGm2lfc3CkZB-CFw&oe=6A1994E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPDK_u1SOekQ7kNvwGPRGQy&_nc_oc=AdqYWcQSXM3kcigFsAh9wQ4rhrzU4OuvxA0fmaj2CL86UUACcYgFLPcJNyvpFsmXhA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qIRLwE-svJ5FuHO9WqRIz7-FsgOHmeYdPnT2YJNU7Qg&oe=6A19A7D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEiwDb6dA5sQ7kNvwEOitnk&_nc_oc=AdoCkwglocO-9XjR4_k-I2jpx836LxPmh3rMd9uCb2K6KHGKTN-PZFq9J9nZNVl1yGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ntdkniR7meS2E7Fab8liLT2lyc-pDspvE8u6jbW3Sgw&oe=6A19B4A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoBy3HTHO1QQ7kNvwGZJR7v&_nc_oc=AdprFDWWdzqZSxhCRlxMUxg0WzJgZ84xgiMgopmgVlslwfdXk1CuLaS7WE390pETbMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqaCmynHxgMjfL5ZozWCJUt2T2K4pI_O3TLaIGt11wEg&oe=6A8AE0F3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16_XUiXd0EQQ7kNvwG1FcZK&_nc_oc=AdoNDwwnZTvYCjPGoTPJu2MZpyPmFJ_0xYRIYEovfP-mXK-0lZe_m9w2CoBL7cWLMg4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAy3wBu9aBg8RxilI_gGLOHKZoecMCsN5pRosIg8QnDg&oe=6A8AC5E6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2mPtVk_W8EQ7kNvwHyaHj7&_nc_oc=AdrrJ9lx7WK6O92s21WnlA34ddXwMtxfVotcAeywx4B7QNkfuvdOzV9syE2WmQB1eq8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEciClJBwaER6JKH826gz4fmkEAsJVeDF06TNQzo3QKlQ&oe=6A8AF5E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaXH2dOlnYQQ7kNvwEburgJ&_nc_oc=AdpwKLt8Dz5JyIbsIIe-x2wdKE_zGbf_rTSC47FcaYlVD7dH2iUHTZrgMbySGs-N6Ic&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi3PqVlV_AFG_fBG-7AiFhOiI2Mh_cM7d5gs9pDVtHww&oe=6A8AD094"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6dIrmupoX4Q7kNvwEMc7pR&_nc_oc=AdphsKH25TCl644IXevz_N095RaFGiWAGHPjwP26QVwHgk7qQs1NzKunaJoptjVmI2A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEvFoTjcJBvUA7Qb55zQjkyGf9gnBwcTRNURCeqQULaw&oe=6A8ADD68"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
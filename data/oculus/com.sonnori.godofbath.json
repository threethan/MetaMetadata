.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YooyBEjLZ5sQ7kNvwH_Brry&_nc_oc=AdpdAwCnI7SR-D8Dc17iydwhA5tLo06jkX--KbyOxmGAL6lNd9N86XFLQ8cRqId_C_M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsYGblHV7Q5xnvehzmWcAu6wyfGnrtOPTsCPuunQ-v4w&oe=6A7DB1F3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nib6bfw72AsQ7kNvwEZizy3&_nc_oc=Ado3rNrRI7v-Ii94it5heGXloYPHf3WQ2jkMTCFTgjjy7du02OKYj-i65IRv1j-Yn5g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIrg0kVn2820lwcVE9zHuvqIvzkBSsKHwlqxyR9eH3mw&oe=6A7DCF26"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0wA37NNw3QQ7kNvwHsm2zn&_nc_oc=AdqNMgP9fEoeFtYpYvY9ipkzTiBl7Yrt20eWelu0icx30vASiNaBqvRkAqBMPSw8OIE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRtC7gSebWGofG6TnFdzNV5mCKSqnAb1l0fJLP-7e3OA&oe=6A7DC6E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q9I18avSbcQ7kNvwE7WToX&_nc_oc=Adr8VfbhbMJZJgHfbr7603Jp10a2Fs4zSeXwX5GFVrfhizc3VgBSoGX_VsdLdr7zdFM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB2YvsF5pA4ngkQ2uYlJ436tt7ykFVwCYb8O9JTECVDw&oe=6A7DA194"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak9VJFjcBEEQ7kNvwFnqxKc&_nc_oc=AdrZ2SKxWQG9EMTuwAnx47Yt7QcBjyvmmDez4ab7sZ7ajpccXrH9eHLA5j68oRvW3HE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGruSZouqdizxmFx2uHXUyhelZ6xO4gHqSJR2PArO3WA&oe=6A7DAE68"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618472_135431524
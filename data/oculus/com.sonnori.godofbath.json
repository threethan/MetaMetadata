5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q1ULPM8ZfcQ7kNvwFwiDW6&_nc_oc=AdpNcnvMNlZrzfgQz-prkI1AipYk8jayqZxKHsgCuIEF59L2A6W6dIjlj6G51y4KpV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-iA6XC4O_b1QtD1Yi9lLKPv0aJAekAZWu1GSyL79vQQ&oe=6A54D373"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTsXFp1obaQQ7kNvwHIZUK6&_nc_oc=AdpUjFhLzMFqIIBRYJ5UqjyDGunX_BNHoFaTzzIDnSF8tVtnT52F2YQTBegTdniqAi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiaS9JEFPNPBuPrya2dfiX45GptgkSby1ObGIMFEKSAQ&oe=6A54F0A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peUIMG2KkmgQ7kNvwEgOBO4&_nc_oc=Adr0ih8p3psjzQvyqK4B8ZKDmua1ALhU90tMekYkAzjjKBal1VHJZmFLjFFeeyJsm1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzhFOpLA98SG6ESRxQT_prXZYrvA57rjVRRWaOXcFHvQ&oe=6A54E869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6hMKxD0fn0Q7kNvwHx6bZX&_nc_oc=Adq4p6hBhYvcXenoYkQB8E885rrBvGK2nqONOcGxkIlGWnE43Z6RQ2TrrFqfeTTm2yQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvTCbidzollzosiohSSJtkO3nXWYWvsUmsXl-ZYfTQDQ&oe=6A54FB54"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azCD4N6wwWcQ7kNvwG6NR4U&_nc_oc=AdrbsywB1x7B1cstCb4odZbbkSbqQHDGKirlf19BJk8Rn_9Dc1CP5-_OQ9kpM-w_BwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2PzdkmpjXUDsOjKdFL-jd0bW1axf_RZWYZlqmjWUs_w&oe=6A550828"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
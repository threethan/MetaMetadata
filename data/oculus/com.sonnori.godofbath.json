c_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn7WtjUgIHL0nhbuCJghC3BR66pxf-iPpKOdkNuS3M1w&oe=6AFF347B"}, {"file_name": "GOBVR_Screenshot_04.png", "id": "826037636688789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqM8a0cmvVUQ7kNvwHfbv0q&_nc_oc=AdpBBhTDCYYWGB0SMgig1nKeluEFLiXHEEZ3KfP9B8zqQajuvzwSBEGWlCftu1KOxWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQomnabQ-5irmNfusyDfiCT6dNOB4_dhIM5YcMcbWKafA&oe=6AFF1D33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mig4FlSuw2cQ7kNvwHW9c8i&_nc_oc=AdruZdvJ2hKQnyhiq5XUlne1jw2-JIeEtZrGZN6E8FCu78wNclme2cXudFlm4AukkcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNUZGbIRd5Ni6ka9eedht20-zfJ5ulPNNZOiv_GT94lA&oe=6AFF0226"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdoI2uIPBckQ7kNvwH2TIX0&_nc_oc=AdoQ4S7V1WlGboNp4impoKVBpZZKmRTAZUdvEhQgqiZz9J9MeBVOSm5U8HzHpssBefE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDwezLZQu39ssuXYsiLC_JDtn4oli8jJITeb8mMc-3w&oe=6AFF3229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXe0Gzej-aIQ7kNvwGx8hOU&_nc_oc=AdqFqkkOcjeqvRmrHpHwz3hx6lOpSg5l8k2Gpdrd6ttEGpxj0f_OrC_ZU-6k64ZBTPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCuh4IlQkFUg89XukX7YmBAbCNArqJhvufehKvmmxO0Q&oe=6AFF0CD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1_n81gsQ8wQ7kNvwHQvQUt&_nc_oc=Adpw-Lf7Bgj30NREoVWPE
5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxNs7C5NKiAQ7kNvwHVPzqH&_nc_oc=AdpQxJl0EcVxmmHN3zSId8QGzMTBP9w6OGaDItD8waLVgJ6s-RQkQLTS5HdcFC4_ykU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHDdVrBibZU8K9alTSFoiu53YCJcQvTRxfLKQLDTrtog&oe=6ADCD633"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAlFiHG15n0Q7kNvwFrvX9j&_nc_oc=AdosMgVlj8b5ZfKpiri8B8bENsnogvKriJzSIJuVrNpwCRQXE8rB1utKLBfRN5SRRiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwD_BBASYhqSho-dMzwTzaZrU1j1V0w9-9vkhhFuJ2PA&oe=6ADCBB26"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRrXpS3x0I4Q7kNvwETQ0Hq&_nc_oc=Adqc8oE9a2xYVjfvCmqyoG8l38xfY_lNHFC6jrzYyonmPV7-AeoCf9D6IFN9MjhQGQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVA_iVpge1RXC9wkmHfYPd6uhrk8rIT5XKl_skNVluvA&oe=6ADCB2E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snx9vs8drUYQ7kNvwHYPqqV&_nc_oc=AdoBUCgpTlg6rNRs1H4chZyAziURk_kl7ynau9k0gUr70ViwdihgNUpfg_bTxFKwI-c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoog1u7l7bSgB459am8YxfmuJ1ZpRWqoFFVHXGZdM3ug&oe=6ADCC5D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8A2ZV5BhOkQ7kNvwEp3c-3&_nc_oc=Adpq9kdpXQsb4nPP_oa0Y0hYvX0L5S1DiCWldZYS4CjGs7oXoFQD1F8e924vTyFQyzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN__6zkrhTYTfQxmi0iFiujIEq6XsiP-RD4_4wgjpHKWw&oe=6ADCD2A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
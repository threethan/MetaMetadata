5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SncvsarseYAQ7kNvwGcCASt&_nc_oc=Adq6dY8L5gOEp6ZvhFQmzu3E7nZDU_fIfuUgbUS_BLq6d8snfW-EvXo6rKTbu1ev24A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfCLm0nus_ew2xo6Jhl_t1RfJOpepQnUv2RoLn5EnTKQ&oe=6AA29BF3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qga6_Q25YZMQ7kNvwFhgIuo&_nc_oc=AdpuoySvb-qq4MA0Yi95FkMGUIrHwMhbpV72tcBOweG7V8reb_zYYPCq-mcaOm-uhjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1-ZWwO25RqtRCaH1-xDlyNTokhdAk1CMnIaPtk8YWzw&oe=6AA2B926"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Gaz9PHBU_QQ7kNvwE8QlSW&_nc_oc=Adq7Ek-yXCLhWpFNWmj6JvXo8mPCk9IaAca7F1CukNi-udMk8Joza3vSFnEbxQoUXFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXY5Lx7bPTn9dtWqGuJPbSPJRabi2vkt1969IdOQtUtA&oe=6AA2B0E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuP-teGh5ocQ7kNvwHlbB9j&_nc_oc=Ado0kVkbSXB46NAOd9COZnuHtg-cZQ35qn4gPrs3sKFNuZfHl9zQq_dHwXbVBeTmi3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP5FYzZ97gHn1YCguLENGZCznTD4Y2mx414Zvt5cy-Eg&oe=6AA2C3D4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfrQ7UA9YckQ7kNvwGfZBSY&_nc_oc=AdoqRQaAQ38w5VViRrwXIb-hCo-3Dd9MKk6msBTg7bLeDOPfnZCqEXNDvEn6txnmH34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII-uyGdxnQz7TClLBvsMwjth4NHZjRbbiCZPdNtlwfyw&oe=6AA2D0A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
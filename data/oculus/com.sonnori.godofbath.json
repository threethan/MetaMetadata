5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_c49Px80aQQ7kNvwGtXLM4&_nc_oc=Adq0-ss4TOjIrN1ZDLR7_7K5_qcyk2QV5OXSzBUxIC7K8RFYF0m2CH7OygG2ap177Rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U5w_LNiP-KVfTzPnW5r5bS8YroEbmlDH_IadNzzZ9Kg&oe=69FB2D73"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TprQ3uxQpo4Q7kNvwHod9Nx&_nc_oc=Adr9oBoBol6TIAQ8fSInPCzXWjiR_LbI0qSmwW6uLI4eBTzRTVs6HFTGoSqTl-C-P9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rh9HK6vGI_NYN4fjpBkaStMbBb2z6hivMxBVGwVPC7A&oe=69FB4AA6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1vhcooMiVkQ7kNvwHq2ltO&_nc_oc=AdrBGnH5o4T2zvMG1aFT0Bq8PtnK5AqKBNmKnCqfi4UbWcYoxCGzEnIVeQpt0ObK6dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NFY0dT2zRDBJj9tuRYwMc9EjlzJ0ovMaTvSmvMt8wtQ&oe=69FB4269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWSVGUTtUsoQ7kNvwHUEkxk&_nc_oc=AdrxPzGjr1CSVXIpgqcKlw7mePYJZv8bAN9ITmAS9Z484hrDpMTJgvCXd6hr2AXl7Dw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nDu8qvkTnhLLzT4IRIExj5buupsZ85QKJoLmCKoj4Eg&oe=69FB5554"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WOiMAzqM50Q7kNvwHHlfoe&_nc_oc=Adq9HsXqFt_OHGLnM9ooNeULhuQEeyApxwWg9a2NfeWHxbq3DEATnS3FG7msLYpQkTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fY7yRVShqO2Uw5cnuDE7CU79o5FeAVIkU8c6t_h1T3g&oe=69FB29E8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
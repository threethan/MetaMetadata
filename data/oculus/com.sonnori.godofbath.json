.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW0mwVkLrGsQ7kNvwHV7dcU&_nc_oc=AdptQ5qQ_Ttb9spCymOiLNgpvsPMGQ14AFxL9yZUc7H67Tth6NQbeEPqGyCBDzjt7sc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ufK-JPNTJK-4BvW-y4fro9iQPgAvRyBeL8E75g9bcKg&oe=69FDE72F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i84Co_02BIoQ7kNvwEfka04&_nc_oc=AdpVbuPzJ7p7VyQ1-hrDwT2j5Fc46jlrfphzriq6PMnFDcBTzaIzqbCpDof1tik67DU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LjxdN73mo-v25AvQi_5GbfMdnY14Sp6wr-VmwWYUvLw&oe=69FDF081"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXMPuJds3SgQ7kNvwH0zHcF&_nc_oc=AdqVvg9qI-h0VjEM2v8BlmMm2tOYnUvYt6e5HO1zhf1qDZWGxdUP_PsciM_N4qAAlEo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZYbUff0q4JoTvY44-28izZdw6TL2gGb3uFqCQOvbCxg&oe=69FDCCE8"}, {"file_name": "IMG_0620.png", "id": "1547078116625666", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619174_1547078119958999_8403208151240748249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffc_snLaAwYQ7kNvwHnppVz&_nc_oc=AdpTqtuRU4pXxyzyaemVU1ExVXf-WfHY0_zx7eZS9dKBL-xqtfLzR5ggIZ-xyunDIsg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wDnKJ9l3Tl8Kh4QTmk58lHevwmpv3iQ8trvevlxJDUQ&oe=69FDED6E"}, {"file_name": "HeroCover_kr_A.png", "id": "1544914920259210", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618472_1544914923592543_20439413943043317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzwv_7lIarkQ7kNvwGF5726&_nc_oc=AdryZyN25LsYn01em6uK7jNPYhl82qf0s0IaIxSyF8Lg_dcIRu2TaO3jUUr8SWTVAEY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60VM94bYLjOWkeSA7c_Xg2hLVD4KQt8Lmq_HO6-LcqKw&oe=69FDF48D"}, {"file_name": "Cover_kr_A.png", "id": "1180716197305101", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t
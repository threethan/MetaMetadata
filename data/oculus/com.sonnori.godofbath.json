5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGV6uMFi2nkQ7kNvwFTL6oZ&_nc_oc=AdrrC6mZB8LuI3fkjRHoN_brxS4_YlgzN6AMrTH3S63SBohpx7lIOn0K4hsgkL0dzoE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M7YP8bfoTxzwUOrceUHUZa_uryjJ4s2Ilv_2fc1jurg&oe=6A2C2D33"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cwm5rF9u9LoQ7kNvwFa4Zc_&_nc_oc=AdpMOvxMVBkaMdtG2o1SacJPwRh3pGQNnB59L5h8chnSxQSIOT-Oev558AP7V2Euwh4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GnXVG1OUHlGsUDGihxuzjGLUdxKHf2JUn4P2sQ7tJyA&oe=6A2C1226"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPZS0dvj7EEQ7kNvwG9-TC3&_nc_oc=AdqLmNQE9Negzo4k1wDoKaBwxYVs9YIC5z6pp-3MeG6A0E2xXwPPCEHinOGqSUl_7Ws&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z_XsbrsyE1zIsfxvblM9zKQAcwCv5bMgn9NJriCxMrw&oe=6A2C09E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GDXKQesJq4Q7kNvwF5criN&_nc_oc=Ado7EslH6yFp5SphK-qiG3qlRkiPgjdMUpKrR2YY7iwzuoGoLs4D_ChIxv0bTzXMxx4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ohT6nQyCetd7XJNA2AFmQTfNZzi1MGq7Iuh8cNReReA&oe=6A2C1CD4"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFnsB4hmdd0Q7kNvwH9kmbK&_nc_oc=Adqlas4MsfDG5kVdZrdXjulo2wSXXO91xFw8qziDW1QwNzJvlc51w4MPJq9dfH9beoU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ij3xxqlyuwbm3YMZ_mY0-qxuWVRSuASOeiOUrkPHuVA&oe=6A2C29A8"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
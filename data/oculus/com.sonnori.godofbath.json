71-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xhtdSUnsH8Q7kNvwFxGMJt&_nc_oc=AdoHB-1agu9jWfK8FMiLRfFQ5Y8gu6wIRkpYEzRDIzhOd2YfZjC2xCfBO-pH_2XKYkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxSFKrxxtdhWVyxBRw9-cQexSAJj0hBHoxwVuI24lQrg&oe=6AFDB0A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74nGiYy6EB8Q7kNvwG-r-vO&_nc_oc=AdrnzzUDtAkD_HY6JmflVRfocFXXOyp-AYHsJsLgWGlSfk00_hA1MoDhtNFuO1H3Ukg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH1lNCm732w61DKASwsnWtSqZM4UOngtrQBsZurTG8XQ&oe=6AFDE0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_en_B.png", "id": "1393935742074773", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1393935745408106_5227587196332653476_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbtFBYbUVzgQ7kNvwF_MDJP&_nc_oc=Adqzc61RehI_T1rnkqchohJhybwhpYRS1n8nZV8sH5QRb6_UWrZG682-6V3YjY_tzHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKkVCzojMx_KjpF9zQhVXTlkPVpkxnbqWdMaAH5JuUYA&oe=6AFDE26F"}, "display_name": "God of Bath", "keywords": ["Fighting", "battle", "action", "korea", "Comics"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "IMG_0619.png", "id": "4313722828908122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_4313722832241455_8129084445092545218_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FMXEnMfbWMQ7kNvwFGx_Z8&_nc_oc=Ado-AyWhU1pZdVrtP5V_7plaJzh6C6bIf2ssCnqGT2RySbn7H6_2b0xlXKILE4UFDCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmqx_0c_6iKHLNnalFWfznDU7X3y9bbmISkMooDnFJ1A&oe=6AFDB381"}, {"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1_n81gsQ8wQ7kNvwHs7ytW&_nc_oc=Adpq7tYivy2E0JWLO0MKJ6pXdxMvrEzc9lgTdUA-Kpvi3Jgu4rsOgqTvev801CbbN9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG-2mxz2hYMQQNqcjfW4aCukBhmWJk_nglOybhhrjoAw&oe=6AFDC828"}, {"file_name": "IMG_0620.png", 
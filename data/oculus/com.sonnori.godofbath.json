c_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1Y0lf72nceNodPpBBPpWt9bFfSmXsZv7K38q4ksk7hg&oe=6B1057FB"}, {"file_name": "GOBVR_Screenshot_04.png", "id": "826037636688789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWzWvRGu1soQ7kNvwEA-vrJ&_nc_oc=Adp3eDIGNEd1oBJ9lRry9Aa4YMRpSeL20RkHVJQFSy-iE0co8iF-FZ5tqc_9IyqF0Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVe-VqrPQFnCH5QjT1tAiCz-Y1eH1CIW4tyWodeICdlfA&oe=6B1040B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjot_Oq8kAMQ7kNvwFPWkhC&_nc_oc=AdrTjaoQA5EYKOedKwnqrWInH1VjUyB6ptqzFeC14DbMlKRTtMB1uk8v0M_C6lubHHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2ks4mdJz5i-EOwkZUhE0qT2FbQw9a2RroIssYe0Iydw&oe=6B105DE6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N36lCCFAtxYQ7kNvwGf1pBr&_nc_oc=Adqoifl4fOLG2tzbxAgC4q39UDI4sKO4Upi2HpyoPIN64xpuCvjbochnc8LtsXMpIU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViJj00UZqI2NsTSiv9iPhfmzPFLSyidxAW82XN4Mn3pQ&oe=6B1055A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw362bnaKoIQ7kNvwG1rE0x&_nc_oc=Adq1zWuqCLqJnygMZxXq3wCxXNZyG_uIhD16tkh4Oavs3alLhKu8Vfu8iRQqkbaek0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8As1MQmhvLbJy-89YMqiFb7CXjyKQ2L7YNf1ydrJ99g&oe=6B106894"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyLa_1WTNRIQ7kNvwEB5562&_nc_oc=AdpOmyPYozwgQ_1rrgg1q
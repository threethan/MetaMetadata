5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4shLeAnjNUgQ7kNvwEstC_l&_nc_oc=AdpP_VsJM4F8ceSMMMzVlRZNCzBFMGqVdkMUPP3n10rb_fDoiMQKf5PlbtFnm-68F8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDsSiZp3ZR38ghY3UIuoUlFaGoCTm-p7n_jH6N0amepA&oe=6AE8B3B3"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F4-QV3gykYQ7kNvwEFCHlU&_nc_oc=AdobhlAUzTbWLAJOdYvxlFkdxnCbrfnnmuWFVbK7VeZJ0mmCT_Arktam2MJfDueMaP0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8PY0nFvRCP2tId0ezjoF7CQYnlFY5aB-Wnw79cgcfdw&oe=6AE898A6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SSKfcRm03sQ7kNvwGR9yPZ&_nc_oc=AdoI_yeeJXZ0H7iGIBGqG3IsURPjBXNnvlzYNLL0SbylvS9_W2HrapzuoUPUGaYk34I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrtEoMvbfrJSeF7ywDFoZLDz7WLBkwprANbwXtUpkzyA&oe=6AE89069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmBaOq--imQQ7kNvwG9zwAX&_nc_oc=AdqhuS27WpMuEuIrl1qEbhPDiLPItRFINV-Ct624tuPIqMhbjp22DKW72XAfxEsRGUg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQptrn__7TwpQJHR4OK0uVj3XaxjBbfTlHQ7Y4wA5YoQ&oe=6AE8A354"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9GihOlMsAsQ7kNvwFtcpcf&_nc_oc=AdoKdFZDQsXiJOT16LsF0LLoWIslnMLvSBWSbNEAquVA3fHED5yP5IzpJoZQE9bKHSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkjvKRsE4K2dIXp0c0iQRRIeR2zHxVINyCVD2zE56TTQ&oe=6AE8B028"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618472_1354315246067333_8740
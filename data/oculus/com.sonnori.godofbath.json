.com/v/t64.5771-25/499619174_826037640022122_6813080488966134526_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY0pE6lUqAMQ7kNvwFRlx90&_nc_oc=Adoz9ZXFTkG1QH04KTMf00hJoyk28GoaDwuqOgIsfr7Z51evA0nQEpR321YC-1J-6x0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT1qUszwL2skFqkgN-xXGC4yn2C3oE2aTOrdB59IVQBQ&oe=6AA3ED73"}, {"file_name": "GOBVR_Screenshot_06.png", "id": "793207366867818", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619450_793207370201151_5776514371250358265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOLB_ZO4ZqwQ7kNvwGwsHYc&_nc_oc=AdqRLFBHM8OVv1VIPosCa2n9vOYjavAy6gD8a_48OmWoVw0U-vchSmRdtCnfK1gnna8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuIlzOdNlhM3GEbW0Twi7NMMgPdjnR2YAyd8kMiOrXEg&oe=6AA40AA6"}, {"file_name": "GOBVR_Screenshot_03.png", "id": "1196618298997122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618512_1196618302330455_7857288920185019181_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3Hmd_IIOcUQ7kNvwEkcdt8&_nc_oc=Ado4HcPNOMgbaw5NVel4Oi6SRnjZEX3ssHD5gHN74SLwQBrxD4Ilq6QyBHQ1_jumNSg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITeN5tu-OcVUaqQKUPHeOs2pU_igFcFfA-GTMto3K1Qg&oe=6AA40269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Cover_L_B.png", "id": "1330446771678457", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1330446775011790_2085533124224584754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szEFnbWbqGEQ7kNvwGQxzFo&_nc_oc=Adqi-RBF3JegaRQpFiKrZZ4m1dkVAlqqJKLLPhMk-yx0er0rs5MGeGpH46eR3y37vlk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdtDoRK1YECUp26JSXEIMDvY7nKWRrX6jRMRvDYZLa_Q&oe=6AA41554"}, "display_name": "God of Bath", "keywords": ["god", "bath", "fighting", "boxing", "action"], "long_description": "\u201cGOD OF BATH\u201d is a VR adaptation of the popular Korean webtoon The God of Bath.\n\nPlayers use real hand movements to attack and defend in a unique \u201cScrub Fighting\u201d combat system.\n\nThe immersive VR \u201cScrub Time\u201d sequences recreate iconic scenes from the webtoon with a comedic twist, delivering both laughter and excitement.\n\nExperience a new world of VR action comedy filled with dynamic battles, realistic scrubbing action, and unforgettable characters.\n\n\u25a0 Key Features\n{1337823384203149}\n* Scrub Battle Action \u2013 A one-of-a-kind combat system powered by real scrubbing moves!\n{841894742141525}\n* Comedic Scrub Time \u2013 Relive iconic webtoon moments as interactive VR events!\n{1589004808932841}\n* Face Off Against Original Characters \u2013 Fight your way through familiar and unforgettable personalities!\n{1521575192738410}\n* Immersive VR Gameplay \u2013 Every movement you make turns seamlessly into combat and comedy!\n{1199671048730157}\n* Experience the most extraordinary battle ever to take place in a bathhouse!\n\n\nOriginal Comics from NAVER WEBTOON \u24d2Ilkwon Ha All Rights Reserved.", "short_description": "Experience the hit Korean webtoon God of Bath in VR!\nStep into a bathhouse where over-the-top comedy meets intense scrubbing battles.\nFeel the thrill of combat powered by scrubbing moves, and dive into hilarious \u201cscrub time\u201d moments you can experience firsthand!"}, {"images": {"nodes": [{"file_name": "Cubemap_20251106_095857_nologo.png", "id": "1858878011724015", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620817_1858878015057348_1911355417361916343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfrQ7UA9YckQ7kNvwHacE-A&_nc_oc=AdoyYRrI1R5FSc_sjTP2WdXZbDOrmXvAdsIlbg3TY_vnSvr3WNk10O4vvfiqiNcJTY8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhNsMudUfGC5cn71uVCCW1LuPBFBBeZU8_LSbsJaHgVA&oe=6AA42228"}, {"file_name": "New_Cover_S_A.png", "id": "1354315242734000", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618472_135431524
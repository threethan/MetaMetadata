ng?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv2Zk3MC9UoQ7kNvwGHucFw&_nc_oc=AdqtYOiHN-ov-zsFTSBXbl-CLw1yxsY1G78ZUucqzqWxLtx0u_eDzBcFTPeQVD7jCjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaeAPPzp7Ow9qC35t585LUvNFJKZrbjFt2MesCKpRaTQ&oe=6B05B872"}, {"file_name": "migrated_image.png", "id": "245238729841351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_744761505904997_7544207954908545024_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k5SNWKUatQQ7kNvwFBuw3l&_nc_oc=Adry9h2difUwKnerTagVoiV4rzRDA68gJ9qiVIid5-_x4dC30mRglJNxGVyVUw0WbXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSny-hNq4BjPMNg9hSP-70PKN4qlvXd4Z_-_S2wKivpEQ&oe=6B05C370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Y56TFz", "id": "961733557358514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974607_961733560691847_3809784408441880576_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3urJiR_-yBkQ7kNvwF1HQm7&_nc_oc=AdpktSJHzkrfZusriroaoJit2XWWuWRWmUcFhTVxHZOeOpP7W07exhrJ1JqLkv3YdpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6tGpQe6yJTrauUTBpTGYqEpKeBcOulcoFEBulIEGj4w&oe=6B05D95D"}, "display_name": "JesusVR - The Life Of Christ", "keywords": ["Jesus", "Christianity", "Movie"], "long_description": "Jesus VR is a 56-minute film comprised of 6 chapters from the Gospels and is now available for Android.\n\nDesigned to bring the viewer closer to Christ than ever before, this technology transports viewers back in time to witness the life of Christ first hand. With 360 videos, the viewer is at the center of the film and chooses which direction to look, making it a truly immersive experience and one that won\u2019t soon be forgotten. A new and important way to get closer to Christ.\n\nIncludes many stories from the Gospels including The Birth of Christ, The Baptism as well as The Crucifixion and Resurrection.\n\n\u201cJesus VR \u2013 The Story of Christ\u201c is executive produced by Enzo Sisti, the executive producer of Mel Gibson\u2019s \u201cThe Passion of the Christ.\u201d Enzo Sisti, \u201cI am beyond thrilled to be a part of this groundbreaking project. It\u2019s as exciting a take on the story of Christ as I\u2019ve ever seen and its production values will absolutely set a new benchmark for virtual reality.\u201d", "short_description": "VR experience of Jesus\u02bcs life from his Birth to his Crucifixion and Resurrection"}]}, "developer_name": "AutumnVR", "developer_privacy_policy_url": "https://jesusvr.net/privacy-policy/", "developer_terms_of_service_url": "https://jesusvr.net/license-agreement/", "publisher_name": "9383000 Canada INC.", "support_website_url": null, "website_url": "https://jesusvr.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427762075700473"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2139370429489711", "version": "1.1.12"}, "id": "272474550084460", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
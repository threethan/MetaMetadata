0NU0ArE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iGPPhTs88ZvJjKzrrk6oPm_snMKIiunzwKm-jMsoc3w&oe=6A4661B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Y56TFz", "id": "961733557358514", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974607_961733560691847_3809784408441880576_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOzuyOO8WN8Q7kNvwFWYOfe&_nc_oc=AdpF7PAzgIrB9p5Z_34kCQqb3YJF_qoZzP_XBiq2E422L53glitrFy61nTNkmUFNkF0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XQqtB0kZxSYcc2ypxOgSUrg86wgx8kVQ2008fLl7KAA&oe=6A46779D"}, "display_name": "JesusVR - The Life Of Christ", "keywords": ["Jesus", "Christianity", "Movie"], "long_description": "Jesus VR is a 56-minute film comprised of 6 chapters from the Gospels and is now available for Android.\n\nDesigned to bring the viewer closer to Christ than ever before, this technology transports viewers back in time to witness the life of Christ first hand. With 360 videos, the viewer is at the center of the film and chooses which direction to look, making it a truly immersive experience and one that won\u2019t soon be forgotten. A new and important way to get closer to Christ.\n\nIncludes many stories from the Gospels including The Birth of Christ, The Baptism as well as The Crucifixion and Resurrection.\n\n\u201cJesus VR \u2013 The Story of Christ\u201c is executive produced by Enzo Sisti, the executive producer of Mel Gibson\u2019s \u201cThe Passion of the Christ.\u201d Enzo Sisti, \u201cI am beyond thrilled to be a part of this groundbreaking project. It\u2019s as exciting a take on the story of Christ as I\u2019ve ever seen and its production values will absolutely set a new benchmark for virtual reality.\u201d", "short_description": "VR experience of Jesus\u02bcs life from his Birth to his Crucifixion and Resurrection"}]}, "developer_name": "AutumnVR", "developer_privacy_policy_url": "https://jesusvr.net/privacy-policy/", "developer
ng?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2xk2ZyJJ_MQ7kNvwHhTVuu&_nc_oc=Adp07HEY-syQAglL-Y9VQ11Q0d27UkzeMtuDGblUbnlh62-ze-QBbzyLhlaE9GB4C6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlELMJbZJU_IDfKjpX-z0ZQFsxY4xwP6_QTgLpBfDf0w&oe=6AFDCF72"}, {"file_name": "migrated_image.png", "id": "245238729841351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_744761505904997_7544207954908545024_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUcwdobGiS8Q7kNvwEBIJVf&_nc_oc=AdphPX6vTGaAlI5b1_oLONwtJPu4I8nz3sadeK6Okeb73GrNEkC1dd7XrMwRbzVK0lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReOWyn02unSVSIKlEqKYze9ajYlLvPYcqI_HiqYO-RbA&oe=6AFDDA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Y56TFz", "id": "961733557358514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974607_961733560691847_3809784408441880576_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4HrjWcbleUQ7kNvwFFlZdl&_nc_oc=Adq4MmQb_-q4eh6t7vnAkP2EHCakiPpGjHxfYgSFkIdI25HIdudSLSd47EjiGwhgDvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJCg4DY79-pdGyT1RTfHGjBiHrM1ZbxI-ixBQKTlJa-w&oe=6AFDB81D"}, "display_name": "JesusVR - The Life Of Christ", "keywords": ["Jesus", "Christianity", "Movie"], "long_description": "Jesus VR is a 56-minute film comprised of 6 chapters from the Gospels and is now available for Android.\n\nDesigned to bring the viewer closer to Christ than ever before, this technology transports viewers back in time to witness the life of Christ first hand. With 360 videos, the viewer is at the center of the film and chooses which direction to look, making it a truly immersive experience and one that won\u2019t soon be forgotten. A new and important way to get closer to Christ.\n\nIncludes many stories from the Gospels including The Birth of Christ, The Baptism as well as The Crucifixion and Resurrection.\n\n\u201cJesus VR \u2013 The Story of Christ\u201c is executive produced by Enzo Sisti, the executive producer of Mel Gibson\u2019s \u201cThe Passion of the Christ.\u201d Enzo Sisti, \u201cI am beyond thrilled to be a part of this groundbreaking project. It\u2019s as exciting a take on the story of Christ as I\u2019ve ever seen and its production values will absolutely set a new benchmark for virtual reality.\u201d", "short_description": "VR experience of Jesus\u02bcs life from his Birth to his Crucifixion and Resurrection"}]}, "developer_name": "AutumnVR", "developer_privacy_policy_url": "https://jesusvr.net/privacy-policy/", "developer_terms_of_service_url": "https://jesusvr.net/license-agreement/", "publisher_name": "9383000 Canada INC.", "support_website_url": null, "website_url": "https://jesusvr.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427762075700473"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2139370429489711", "version": "1.1.12"}, "id": "272474550084460", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
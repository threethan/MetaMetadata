_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5W4HZvs9e4Q7kNvwHeb8mQ&_nc_oc=AdpkziZb2LUmqnXeRSFMCPEyufrK1tFt-TexRbA1-Hq_81jksKHLNLo_BV3xsbgq_Wo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUtv11pcHhoW5tHKspE99B6FIN_Vj4-cEdvQ00GRItGw&oe=6A8AD9EA"}, {"file_name": "migrated_image.png", "id": "330491061242710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974581_291285761560120_3324331272951562240_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nam-dQIsTIQ7kNvwH84ULA&_nc_oc=AdoWrDE1JjP-nvooNbzMzNsv418wH1cYQSOCzhzN68j6evjPO-oJvVMlBDnwWGQ6IsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVC3rUbVwxMasCl8cAHQSKRgPECbFMZd9vGxhLPw6zRA&oe=6A8AE4B2"}, {"file_name": "migrated_image.png", "id": "249523232752794", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974829_316696232288776_82016764203892736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nryTH5BGIRkQ7kNvwHJfAqZ&_nc_oc=AdqvdLlbJ-pEErIEGQMoPHluBQdH1Iq34WERGV5pVbFgxdAeawc_1a0jbwediXHwtag&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMIKIVwyV0Rq5-gk4NPG_J4qGeO9YroYQn0EDRR1IFeA&oe=6A8AECCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JesusVR - The Life Of Christ", "keywords": ["Jesus", "Christianity", "Movie"], "long_description": "Jesus VR is a 56-minute film comprised of 6 chapters from the Gospels and is now available for Android.\n\nDesigned to bring the viewer closer to Christ than ever before, this technology transports viewers back in time to witness the life of Christ first hand. With 360 videos, the viewer is at the center of the film and chooses which direction to look, making it a truly immersive experience and one that won\u2019t soon be forgotten. A new and important way to get closer to Christ.\n\nIncludes many stories from the Gospels including The Birth of Christ, The Baptism as well as The Crucifixion and Resurrection.\n\n\u201cJesus VR \u2013 The Story of Christ\u201c is executive produced by Enzo Sisti, the executive producer of Mel Gibson\u2019s \u201cThe Passion of the Christ.\u201d Enzo Sisti, \u201cI am beyond thrilled to be a part of this groundbreaking project. It\u2019s as exciting a take on the story of Christ as I\u2019ve ever seen and its production values will absolutely set a new benchmark for virtual reality.\u201d", "short_description": "VR experience of Jesus\u02bcs life from his Birth to his Crucifixion and Resurrection"}]}, "developer_name": "AutumnVR", "developer_privacy_policy_url": "https://jesusvr.net/privacy-policy/", "developer_terms_of_service_url": "https://jesusvr.net/license-agreement/", "publisher_name": "9383000 Canada INC.", "support_website_url": null, "website_url": "https://jesusvr.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "678251033359818"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974519_224041168539075_2480543174800441344_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlDxWPg1qRYQ7kNvwEoppBZ&_nc_oc=AdpxhKayrPsuM0VxmxAXHJKzI7PpwzAlhEFevKdE-Es3xt5hlDREDWE1z_cuoXAmeQw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeFZ96qo2y4xJjzDARCt4Sd25StsE0HfHSbXWcg4bHmA&oe=6A8AC095"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JesusVR - The Life Of Christ", "platform": "ANDROID", "con
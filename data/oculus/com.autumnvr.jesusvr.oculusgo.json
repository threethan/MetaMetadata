_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Xe3-d-uYhwQ7kNvwETZ3Fq&_nc_oc=Ado0IanhfA77ZgJjiDOczEGg9RcfzTacvYHrAM9QIFY6r-5PY1m8JHr8RewlQ8rUY8M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu_01mT5cgqWdKbbaykUO63AXSrpbG5Wd2_9E2oon59A&oe=6A5504AA"}, {"file_name": "migrated_image.png", "id": "330491061242710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974581_291285761560120_3324331272951562240_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4is8ACWfdlcQ7kNvwFdhVxi&_nc_oc=AdqyitRsS25t5OumWkmazHjz6LivTF4HyE9u1EL18_G3GgCA9KGBQKTUw9b6_5xHEVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5-iek8nYCuoYQzVkATX4wq8Kczn1fQ3XAc3ry52n0jg&oe=6A54D732"}, {"file_name": "migrated_image.png", "id": "249523232752794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_316696232288776_82016764203892736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea2Fwn8LhKsQ7kNvwGlEVW3&_nc_oc=AdorFhqTjN1NklleeA3RSpRJhT8Y1aA8RtmBczI3Xmu3G30iqKhM3RFVl2j52tNKIO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZYkgI1NrDM79m7yHQAuIGqPD89MQqzpEFyMnLTvIyXA&oe=6A54DF4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JesusVR - The Life Of Christ", "keywords": ["Jesus", "Christianity", "Movie"], "long_description": "Jesus VR is a 56-minute film comprised of 6 chapters from the Gospels and is now available for Android.\n\nDesigned to bring the viewer closer to Christ than ever before, this technology transports viewers back in time to witness the life of Christ first hand. With 360 videos, the viewer is at the center of the film and chooses which direction to look, making it a truly immersive experience and one that won\u2019t soon be forgotten. A new and important way to get closer to Christ.\n\nIncludes many stories from the Gospels including The Birth of Christ, The Baptism as well as The Crucifixion and Resurrection.\n\n\u201cJesus VR \u2013 The Story of Christ\u201c is executive produced by Enzo Sisti, the executive producer of Mel Gibson\u2019s \u201cThe Passion of the Christ.\u201d Enzo Sisti, \u201cI am beyond thrilled to be a part of this groundbreaking project. It\u2019s as exciting a take on the story of Christ as I\u2019ve ever seen and its production values will absolutely set a new benchmark for virtual reality.\u201d", "short_description": "VR experience of Jesus\u02bcs life from his Birth to his Crucifixion and Resurrection"}]}, "developer_name": "AutumnVR", "developer_privacy_policy_url": "https://jesusvr.net/privacy-policy/", "developer_terms_of_service_url": "https://jesusvr.net/license-agreement/", "publisher_name": "9383000 Canada INC.", "support_website_url": null, "website_url": "https://jesusvr.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "678251033359818"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974519_224041168539075_2480543174800441344_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnYCrqcMh3wQ7kNvwELTI0H&_nc_oc=AdoBZbQH4j-gYrI4u2m3MegpZf6IGErIa0stW7y1O1KZSUMpQShbCLojP8LnAA0pAcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOmRITC8FK_zxbnhN10267eEMwlLLnpi5JcggwUbE1zg&oe=6A54EB55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JesusVR - The Life Of Christ", "platform": "ANDROID", "con
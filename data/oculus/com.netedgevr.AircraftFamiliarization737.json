.png", "id": "779667418247074", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822074_779667421580407_3842498408983897823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvcvwPwoITgQ7kNvwHlRBCD&_nc_oc=AdpMgcAepTpnsPWrzX-rtNAslIxykPLmh552HYFk1TQbI92hPvMeKaN0FDCYULu9bww&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNEuD0m4dUofMlofmrSkotCjH55hAHpK41HwPNxRFYCg&oe=6A858F45"}]}, "id": "1326436285614852", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1145618896950395", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_1145618900283728_3800331538025267934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC-YnHhKD0kQ7kNvwFhD1od&_nc_oc=AdqQDtXqfUB0qqDcOU4gDK-x-o6pWlwIm9qwIJ5XRgEnSjvWZCCm1cYydIopklwj98Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlkTGnzuVkQCA0IefhFWUg4WDV9KiNCcmJaKKk5oMxYA&oe=6A85A976"}, {"file_name": "2.png", "id": "1332764041851093", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619697_1332764045184426_4699915912389038124_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=602-yXx8G9kQ7kNvwEjED9b&_nc_oc=Adq8uPkiWsPyFBr76k43b1p2rtGo2lHwIQGLhhEjKum4tWItZ92QRVbBxFo2wUHRpEA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFptGN-uIXLxPcWP2-LLxvtLuF8MtLhSNrWNqSNWvurAw&oe=6A85A8AB"}, {"file_name": "3.png", "id": "808721211636038", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499302651_808721218302704_6539202310688661767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hj96MJsNLXkQ7kNvwF6lrIR&_nc_oc=AdrKCw3i5Zb-kbUImKV31uXCpTH3xix7SwwqFPe9wwfgBT4AmV3tV2o2Ld8daQ-e8zU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh2jv2PtyBJ1XwZKA6PSf-tmLvVS2I6_dIpvte4_UMgQ&oe=6A85887C"}, {"file_name": "4.png", "id": "3196862387133645", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623210_3196862393800311_2070831414169798993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74bQ2BvJZKcQ7kNvwHkr3ig&_nc_oc=Adpx9pc02W1n_BxXgxmsoNiPT9Lk8yLCOjAyCc0h8UzCmiRDlpMDvPasiNJfew8Icvs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFT3vFsQBcfeag7fcDTCYWzSzBB5PdgD2hHcy7TUUP6g&oe=6A85980F"}, {"file_name": "5.png", "id": "4098072160431829", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499302688_4098072163765162_8235641802601316797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsGiphFgHdcQ7kNvwHB9oWP&_nc_oc=AdqHwxgEH1xO8Z_C-6FgdAgFdLw8N8DAVnwCvUVJe8FKhQv4vGi7LLU0Ri1d0Hptvvw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEucxXrhn-B28iDZG2Rz9D7eonRPAT_NwXSFJWCIAUIw&oe=6A858221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image V2_1.8.1.png", "id": "1940517156803578", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308263_1940517163470244_4366018430096261161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d__eWCJRuBsQ7kNvwFUbcgp&_nc_oc=Adr-eoi-iv9qR2XViLtKk1VOyD3VhJIzEoKcqGkQjNuG6ZhHO4Li9x1Ap_jmXwcQclc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwcCzPk8uK2WEGVVh1npfSc7UdEweoG1Z4G5hMl0JPzw&oe=6A857EBA"}, "display_name": "Ramp Simulator: Aircraft Familiarization", "keywords": ["airport", "737", "airplane", "flight", "aviation"], "long_description": "Ramp Simulator: Aircraft Familiarization revolutionizes how ground crews learn and maintain operational excellence. This immersive VR training module allows trainees to explore detailed aircraft models, identify service points, and practice ramp procedures safely and consistently\u2014all without relying on aircraft availability or weather conditions.\n\nDeveloped to align with industry and regulatory standards, the simulator ensures every trainee receives the same high-quality instruction, reducing variability across teams and improving compliance outcomes. Trainees can interact with full-scale virtual aircraft and ground service equipment, learning essential workflows in a realistic, risk-free setting.\n\nOrganizations benefit from a scalable, cost-effective training solution that maximizes efficiency while minimizing downtime and safety risks. Training progress and performance metrics can be tracked for documentation and audit readiness, supporting continuous improvement.\n\nWith Ramp Simulator: Aircraft Familiarization, aviation operations teams can deliver world-class ramp training anytime, anywhere\u2014preparing personnel to perform safely, confidently, and to the highest professional standards.", "short_description": "Immerse your ground crew in realistic, standardized VR training. Ramp Simulator: Aircraft Familiarization delivers safe, consistent, and cost-effective instruction on aircraft exteriors, service points, and ramp procedures\u2014no live aircraft required. Improve compliance, reduce risk, and ensure every trainee learns to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24965770983034926"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
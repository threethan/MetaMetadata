NoCTTbpvYTAhAbaUMaLk56h8sR_xhwWHXTgDXF_4ef3brOzqPCdwyzTwpYcgAlw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZlx93vqVtJb_Au0NaJ5rwNySscoRbShI3YoovJvsbfA&oe=69AC108F"}, {"file_name": "5.png", "id": "4098072160431829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302688_4098072163765162_8235641802601316797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eG1ndiZ1PQQ7kNvwEyFBSc&_nc_oc=Adniy_MIXYfwxanQDXuCtzffT-pC_AwOQoO5nZwa4deQaA14hBkYoymgcl2Vxha-910&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzzs0zaZznfkRhhsQDLh9j9mnPV_iZJNRh13ZCgMcbEPA&oe=69AC32E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image V2_1.8.1.png", "id": "1940517156803578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308263_1940517163470244_4366018430096261161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzVLEKljpzYQ7kNvwH5J_CZ&_nc_oc=Adk7rJWIrwUCBipbalnGvB-at_iP7tPdikC26QLIj_D1UbgxXv3m4W1XDX_kF0qr8Fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzG50nsKeZD2mHy9FfDcIh3hrbdnCeyfgf6YgAgAwNzgA&oe=69AC2F7A"}, "display_name": "Ramp Simulator: Aircraft Familiarization", "keywords": ["airport", "737", "airplane", "flight", "aviation"], "long_description": "Ramp Simulator: Aircraft Familiarization revolutionizes how ground crews learn and maintain operational excellence. This immersive VR training module allows trainees to explore detailed aircraft models, identify service points, and practice ramp procedures safely and consistently\u2014all without relying on aircraft availability or weather conditions.\n\nDeveloped to align with industry and regulatory standards, the simulator ensures every trainee receives the same high-quality instruction, reducing variability across teams and improving compliance outcomes. Trainees can interact with full-scale virtual aircraft and ground service equipment, learning essential workflows in a realistic, risk-free setting.\n\nOrganizations benefit from a scalable, cost-effective training solution that maximizes efficiency while minimizing downtime and safety risks. Training progress and performance metrics can be tracked for documentation and audit readiness, supporting continuous improvement.\n\nWith Ramp Simulator: Aircraft Familiarization, aviation operations teams can deliver world-class ramp training anytime, anywhere\u2014preparing personnel to perform safely, confidently, and to the highest professional standards.", "short_description": "Immerse your ground crew in realistic, standardized VR training. Ramp Simulator: Aircraft Familiarization delivers safe, consistent, and cost-effective instruction on aircraft exteriors, service points, and ramp procedures\u2014no live aircraft required. Improve compliance, reduce risk, and ensure every trainee learns to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24965770983034926"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1317747402680199"}]}, "baseline_offer": {"id": "1317747402680199
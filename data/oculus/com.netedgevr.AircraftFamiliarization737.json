VrGOH3OxyTu2H-E3kPCrKIQ3CIDrR-2XDMS9dV7FnlXg&oe=6B0F14FC"}, {"file_name": "4.png", "id": "3196862387133645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623210_3196862393800311_2070831414169798993_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i1iFqnnJtwQ7kNvwHbW1yd&_nc_oc=AdrfmOOyz69rdK0DSzb4KRyg2r-xuiAAUf3VrwdFFjyhhkti8Ix26RtiH3fNEPCD8zY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsOyevX_YYQJklkwzqrhzSNRCgVbnS4AhP7DUnVuDcSw&oe=6B0EEC4F"}, {"file_name": "5.png", "id": "4098072160431829", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302688_4098072163765162_8235641802601316797_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-CrASF1FGwQ7kNvwFpvA-e&_nc_oc=Ado0dYI_Ywl3dUemdWHZ7DhxksRiSFQ78RWQEcAeu068tzf-o0mAFfbSFsmLTdy5h_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTaeQsruwxErHTRhWvV0YWBjDCNiHEWsGI665FLjVjfw&oe=6B0F0EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image V2_1.8.1.png", "id": "1940517156803578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308263_1940517163470244_4366018430096261161_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6gPQcjxEqwQ7kNvwFiOqo6&_nc_oc=Adqi6yZpPChMrPz9s3_oI2hCkkGCgkT9E8K_n3lQygoHYLdWZs2WJdo4RvUkLdvFcP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHTylQgz7Ck_iJSeCHB6wx4ASpQxxHXzYlZwfdtnJi6Q&oe=6B0F0B3A"}, "display_name": "Ramp Simulator: Aircraft Familiarization", "keywords": ["airport", "737", "airplane", "flight", "aviation"], "long_description": "Ramp Simulator: Aircraft Familiarization revolutionizes how ground crews learn and maintain operational excellence. This immersive VR training module allows trainees to explore detailed aircraft models, identify service points, and practice ramp procedures safely and consistently\u2014all without relying on aircraft availability or weather conditions.\n\nDeveloped to align with industry and regulatory standards, the simulator ensures every trainee receives the same high-quality instruction, reducing variability across teams and improving compliance outcomes. Trainees can interact with full-scale virtual aircraft and ground service equipment, learning essential workflows in a realistic, risk-free setting.\n\nOrganizations benefit from a scalable, cost-effective training solution that maximizes efficiency while minimizing downtime and safety risks. Training progress and performance metrics can be tracked for documentation and audit readiness, supporting continuous improvement.\n\nWith Ramp Simulator: Aircraft Familiarization, aviation operations teams can deliver world-class ramp training anytime, anywhere\u2014preparing personnel to perform safely, confidently, and to the highest professional standards.", "short_description": "Immerse your ground crew in realistic, standardized VR training. Ramp Simulator: Aircraft Familiarization delivers safe, consistent, and cost-effective instruction on aircraft exteriors, service points, and ramp procedures\u2014no live aircraft required. Improve compliance, reduce risk, and ensure every trainee learns to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
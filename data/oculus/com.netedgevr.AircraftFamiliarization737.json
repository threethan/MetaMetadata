ng", "id": "779667418247074", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822074_779667421580407_3842498408983897823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4b4WipfWycQ7kNvwG1IYha&_nc_oc=Adrxnfdb8MumC0IOKAuypdHibAaEo1VGPXh-Lq63o4LtitqmzSYMRsxDSh1dCvLyl_E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4-tzHdLwEIxFuszLTA4y2NL3CW6v7zzTxlUCLtqbYOw&oe=6A7DA645"}]}, "id": "1326436285614852", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1145618896950395", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619680_1145618900283728_3800331538025267934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NLw9ICF_KcQ7kNvwGLa_-z&_nc_oc=Ado6p-XEywcyeFbTtq7IfmNeMRCp9MEjBYwkWluoPc04oDGPFdtyRm8fJqy5pbg76mo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXr6ea_K5nGAt6AHhI8tqxMctnKddv0cTg17VU0lgdFQ&oe=6A7DC076"}, {"file_name": "2.png", "id": "1332764041851093", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619697_1332764045184426_4699915912389038124_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpy2iUHsEUkQ7kNvwHxFNBN&_nc_oc=AdqG-DWo-Hq1zzCBlmfrByV9zDuFvPwNkbpHw5Ae0ESu_IiyZPqkP2N5tnfK58JruHM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsAH1b3w2Uh6vpmzAblepRMm5bzxOT69eRSG09kHWyBA&oe=6A7DBFAB"}, {"file_name": "3.png", "id": "808721211636038", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499302651_808721218302704_6539202310688661767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyV5Qp3lhNEQ7kNvwGQhMqw&_nc_oc=AdpbP52jE2nAPJnwPVGy5VchD1iDpe_Si9j09PIL2RipNY7KYqmUuVrIenwmuEsGFDY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu7bZN6_WdmqVGPzQb8AfGFSUiBoqzVZ3EYlAuBEyHXA&oe=6A7D9F7C"}, {"file_name": "4.png", "id": "3196862387133645", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623210_3196862393800311_2070831414169798993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtCXtZK6yfcQ7kNvwETKnT9&_nc_oc=AdrQmvR3BdWe5QCVhlEGc4zJEzT8LBCbKfR7eA6AWSsOWyp56boNYY8shHvOtafRE3M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9UHLwbJ5H7Nr8elIF_MqXZ9dn2bQ78a-_MKixp64YKg&oe=6A7DAF0F"}, {"file_name": "5.png", "id": "4098072160431829", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499302688_4098072163765162_8235641802601316797_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaT0fi_06EsQ7kNvwH_cxgK&_nc_oc=AdqEJnAnE-JF5fV_t4ysr-FeL1yBcciyv5fLakL_8Oq9a-DAqiYS79gY3yxJTfUdMuQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBREgpSrv3MwDXy4XBqW1AP-jR7SVZLscF0-vUISM9fg&oe=6A7DD161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image V2_1.8.1.png", "id": "1940517156803578", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308263_1940517163470244_4366018430096261161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOTS56Z03OcQ7kNvwG0Jr9q&_nc_oc=Adrl6gWO7xjIh3rSkYRrWrabMNST7FtT7uBemyoxAxZuvz5txE2Wwp4AHGMwMZspFu8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNRfA2f8Wy3Kcy2AYOe0_B_KMnfciE65ZhuMV6AcdLZw&oe=6A7DCDFA"}, "display_name": "Ramp Simulator: Aircraft Familiarization", "keywords": ["airport", "737", "airplane", "flight", "aviation"], "long_description": "Ramp Simulator: Aircraft Familiarization revolutionizes how ground crews learn and maintain operational excellence. This immersive VR training module allows trainees to explore detailed aircraft models, identify service points, and practice ramp procedures safely and consistently\u2014all without relying on aircraft availability or weather conditions.\n\nDeveloped to align with industry and regulatory standards, the simulator ensures every trainee receives the same high-quality instruction, reducing variability across teams and improving compliance outcomes. Trainees can interact with full-scale virtual aircraft and ground service equipment, learning essential workflows in a realistic, risk-free setting.\n\nOrganizations benefit from a scalable, cost-effective training solution that maximizes efficiency while minimizing downtime and safety risks. Training progress and performance metrics can be tracked for documentation and audit readiness, supporting continuous improvement.\n\nWith Ramp Simulator: Aircraft Familiarization, aviation operations teams can deliver world-class ramp training anytime, anywhere\u2014preparing personnel to perform safely, confidently, and to the highest professional standards.", "short_description": "Immerse your ground crew in realistic, standardized VR training. Ramp Simulator: Aircraft Familiarization delivers safe, consistent, and cost-effective instruction on aircraft exteriors, service points, and ramp procedures\u2014no live aircraft required. Improve compliance, reduce risk, and ensure every trainee learns to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24965770983034926"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "
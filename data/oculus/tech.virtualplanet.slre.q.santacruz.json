9a9_7G0rHwZi0ZY1xNxPqTWx_Ax-IDKwQ&oe=6A92CE32"}, {"file_name": "Render3_000000_000000.png", "id": "432284811184300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003245_432284814517633_5132220345663751492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZgM2YGpsf0Q7kNvwEUpCat&_nc_oc=AdrzD5i9I6-PY3CMbSXlyQQPiSBDVXF0loONJ0V2vzmpqX9pJt9KQB0dRVT2GaY3ktg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAc84eaXtlWQmKB0ZkvEZWenObSSZz4Wgq_9vzrCqNCA&oe=6A92BBB5"}, {"file_name": "Render5_000000_000000.png", "id": "240785461090600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982478_240785464423933_514977364124496703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsC2CDpM2LcQ7kNvwFklvkA&_nc_oc=AdqKbBjdNUSEPkwwiXh_XJCNdmFDYQLxy3PB-WkwI22_BUGK5VLxQgaTPhbb53sMXYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_h7l9c51RNoGM-Fb9-dFOKaDZVQLvdhUtwlRsZYVO8A&oe=6A92B3C4"}, {"file_name": "Render4_000000_000000.png", "id": "165322211912880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982479_165322215246213_550137257360985092_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VGSG1_Li18Q7kNvwE-8010&_nc_oc=AdqtfG67RcAWM1DcWR2CErJVaeRR4C41h7Q7fOXVJQsBx5fXvgBuCrxpr94fLwy0d6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjkBfyof6JmCfbr_FJ08Jg7E82gSHrEIjmrWUeeFmSiQ&oe=6A92C97B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer Santa Cruz", "keywords": [], "long_description": "As coastal communities contend with sea-level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle. Virtual Planet Technologies produces insightful and immersive experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real-time. Adaptation scenarios can also be displayed.", "short_description": "As coastal communities contend with sea-level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle. Virtual Planet Technologies produces insightful and immersive experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": null, "website_url": "https://www.virtualplanet.tech/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "es", "es_PR", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635725861035636"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "925593764726357"}]}, "baseline_offer": {"id": "925593764726357"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1634841300, "sta
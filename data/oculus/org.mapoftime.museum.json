oXLiYM0l4o0PEK1HfUGCh5CMDzoUEVCyte7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCIUIzPSEbr-kbYwGhPU_0SVVZLeNke5PNyug_3kAiMw&oe=6AE4AE3A"}, {"file_name": "3-the-hall-of-life.png", "id": "949814610932500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604293968_949814614265833_8323452955575462269_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc-jwL7LxlQQ7kNvwEnmdPY&_nc_oc=AdryDN3ouGoXQxK_jJc8pOudU0iNafzz-E9QTRqJ5oEScAWiqM0O5w0H5LedJfGz7no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8aM3wWAzYIF0hL5nt7HdAKkyIPSGMySrTPRtaqwECnQ&oe=6AE4C0B2"}, {"file_name": "1000036997.png", "id": "28687274150914895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_28687274154248228_3758662622735436752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ioE3j_cf8Q7kNvwGxIgWa&_nc_oc=AdpX5QLhT_Ksx5eI2MhW8MKZ7q7VSDkCWyYH1ik-T2frKKaHUVAZhJCHeHVBzKeMnl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiCkPhglkn374I0wwSK2gk0-pri83P7soolUEQF9yXYw&oe=6AE4AD14"}, {"file_name": "29295079413426923.png", "id": "1598053178710831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604328314_1598053182044164_6309205189978160740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H3Ix3TixY0Q7kNvwGJE5ze&_nc_oc=AdqXcmyFpmzcc902ronblZ1MwJXeun7PNszfuosU_-n0Dmc_2vx0UzaJojmHddKrfnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqBiNI5WnbRKbjMXe4f85hycSRAA-E4kE0Pdf3u-Aw0A&oe=6AE49A1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hallways of Time", "keywords": [], "long_description": "Hallways of Time is a museum of the history of the universe, built to be walked through.\n\nBegin at the Big Bang and follow time forward through three halls:\n\n\u2022 The Cosmos: the first particles, the first light, the first stars and the forging of the elements.\n\u2022 Life: from the first cell to the first animals and forests, through five mass extinctions and what survived them.\n\u2022 Humanity: a great globe of the Earth you can turn in your hands, with more than 300 moments pinned where they happened. Play time forwards or backwards across 300,000 years and watch history spread across the planet.\n\nEvery exhibit can be read where it stands: what happened, and how we know it, with a photograph and its credit beside it. There are 495 entries in all.\n\nMove at your own pace. Walk with the stick or point to where you want to be, turn smoothly or in steps, rise for a view from above, and sit if you prefer. The halls are scored with public-domain recordings of Bach, Mozart, Beethoven, Chopin and Satie on piano or violin, or you can turn the music off.\n\nThe architecture, sculpture and lettering were all made for this museum. There are no accounts, no ads and no internet connection: everything is inside the app.", "short_description": "Walk through the history of everything, from the first instant after the Big Bang to the present day. Three grand halls hold 495 moments: the birth of stars and elements, the long story of life on Earth, and a globe of humanity you can turn in your hands and travel through 300,000 years of time. Read each exhibit where it stands, at your own pace, seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://balo-97.github.io/hallways-of-time/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Omer Rehman", "support_website_url": null, "website_url": "https://balo-97.github.io/hallways-of-time/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
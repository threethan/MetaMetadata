t=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ioE3j_cf8Q7kNvwGxIgWa&_nc_oc=AdpX5QLhT_Ksx5eI2MhW8MKZ7q7VSDkCWyYH1ik-T2frKKaHUVAZhJCHeHVBzKeMnl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiCkPhglkn374I0wwSK2gk0-pri83P7soolUEQF9yXYw&oe=6AE4AD14"}, {"file_name": "29295079413426923.png", "id": "1598053178710831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604328314_1598053182044164_6309205189978160740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H3Ix3TixY0Q7kNvwGJE5ze&_nc_oc=AdqXcmyFpmzcc902ronblZ1MwJXeun7PNszfuosU_-n0Dmc_2vx0UzaJojmHddKrfnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqBiNI5WnbRKbjMXe4f85hycSRAA-E4kE0Pdf3u-Aw0A&oe=6AE49A1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hallways of Time", "keywords": [], "long_description": "Hallways of Time is a museum of the history of the universe, built to be walked through.\n\nBegin at the Big Bang and follow time forward through three halls:\n\n\u2022 The Cosmos: the first particles, the first light, the first stars and the forging of the elements.\n\u2022 Life: from the first cell to the first animals and forests, through five mass extinctions and what survived them.\n\u2022 Humanity: a great globe of the Earth you can turn in your hands, with more than 300 moments pinned where they happened. Play time forwards or backwards across 300,000 years and watch history spread across the planet.\n\nEvery exhibit can be read where it stands: what happened, and how we know it, with a photograph and its credit beside it. There are 495 entries in all.\n\nMove at your own pace. Walk with the stick or point to where you want to be, turn smoothly or in steps, rise for a view from above, and sit if you prefer. The halls are scored with public-domain recordings of Bach, Mozart, Beethoven, Chopin and Satie on piano or violin, or you can turn the music off.\n\nThe architecture, sculpture and lettering were all made for this museum. There are no accounts, no ads and no internet connection: everything is inside the app.", "short_description": "Walk through the history of everything, from the first instant after the Big Bang to the present day. Three grand halls hold 495 moments: the birth of stars and elements, the long story of life on Earth, and a globe of humanity you can turn in your hands and travel through 300,000 years of time. Read each exhibit where it stands, at your own pace, seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://balo-97.github.io/hallways-of-time/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Omer Rehman", "support_website_url": null, "website_url": "https://balo-97.github.io/hallways-of-time/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1241158719090264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_1036007229267197_6888448577728295651_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezr_yg56EYQQ7kNvwHvXv24&_nc_oc=AdpsN1Zkj1tlcow6y0QgFhuHJeOzLhEWehuKJ_JdC5nbzweMTOme7FwjdhBaPXA-j0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfoY9hSfoo494tcubcktQnY4zDV36XVZNPj7PYHGpp_g&oe=6AE49FCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
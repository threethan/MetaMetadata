v7Su5yQSofhEhyP_3pnZQ&oe=6A104CAD"}, {"file_name": "SampleScene_Custom_._09.01.2026_18-14-39.png", "id": "1206046254851808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822883_1206046258185141_2722866994676018976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-aKGsXVml0Q7kNvwE5USVY&_nc_oc=AdpYE75hIbPIgYFOp_fcy3AuAiKXOe4oDO3p7euW9R7LBR-Rnv8UE3lJjiMIxBBJo38&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-GW1of-OMvr58cQehiFmiD8mPUVtafIHILHWSqzRAOQ&oe=6A106A1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Outbreak Dreadwood", "keywords": ["OutbreakDreadwood", "SurvivalHorror", "FacilityHorror", "MultiplayerHorror"], "long_description": "Step into the darkness of Dreadwood Forest, where an abandoned containment site hides more than just shadows. What began as a secret experiment has spiraled into a nightmare that no fence, no wall, and no soldier could ever stop. In Outbreak Dreadwood, you are trapped in a sprawling facility that leads into a forest shrouded in fog, hunted by horrors that thrive in the silence. Every creak of a branch, every whisper of the wind could be your last warning before they find you. \n\nImmersive VR Survival Horror \u2013 Experience fear like never before with full 360\u00b0 immersion. \n\nDynamic Exploration \u2013 Navigate abandoned outposts, blood-soaked trails, and hidden underground facilities. Unrelenting Tension \u2013 Limited resources force you to make every bullet, every step, every breath count. \n\nEarly Access Terror \u2013 Get in first, survive the outbreak, and shape the future of the game with your feedback. The outbreak was never contained. It was only delayed. \n\nAre you ready to step into the woods\u2026 and never walk out?", "short_description": "Step into the darkness of Dreadwood Forest, where an abandoned containment site hides more than just shadows. What began as a secret experiment has spiraled into a nightmare that no fence, no wall, and no soldier could ever stop. Every creak of a branch, every whisper of the wind could be your last warning before they find you. The outbreak was never contained. It was only delayed. \n\nAre you ready to step into the woods\u2026 and never walk out? \n\nEarly access terror; more monsters coming soon!!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/outbreakdreadwoodvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5StarStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/outbreakdreadwoodvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26091638230488423"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1419263559685463"}]}, "baseline_offer": {"id": "1419263559685463"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771351020, "status": "PUBLISHED", "id": "1419263559685463"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26403683412617235", "version": ".54"}, "id": "848802694855765", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
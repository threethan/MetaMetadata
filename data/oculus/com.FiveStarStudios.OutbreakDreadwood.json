uGbMa-bcigkhNaYaVLEAnaGGV6F3SrTiC5Gztlnl9JGi07Cyxs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lRbOKYDmCBsIjzyQ90OK1RJKt8p0wvcGn5hQl6kNh1A&oe=6A1059C5"}, {"file_name": "SampleScene_Custom_._09.01.2026_18-12-02.png", "id": "1460985115418149", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307451_1460985122084815_4045682850516833606_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYjVPJllyC8Q7kNvwFOB9gE&_nc_oc=AdpoISUDV-T1TnqtKq647vvfHcA_24MIKKJ6D3c8J0VRtL7razSGlvx5z9MnHVABqBs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vi2wunSs2HzoNHD9cCdkWUoo7N_s65lakfz3JaPF1QA&oe=6A105D9B"}, {"file_name": "SampleScene_Custom_._09.01.2026_18-14-39.png", "id": "1206046254851808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822883_1206046258185141_2722866994676018976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-aKGsXVml0Q7kNvwE5USVY&_nc_oc=AdpYE75hIbPIgYFOp_fcy3AuAiKXOe4oDO3p7euW9R7LBR-Rnv8UE3lJjiMIxBBJo38&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-GW1of-OMvr58cQehiFmiD8mPUVtafIHILHWSqzRAOQ&oe=6A106A1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SubLiminal Slop", "keywords": ["SurvivalHorror", "FacilityHorror", "MultiplayerHorror", "SubLiminalSlop", "ActionHorror"], "long_description": "SubLiminal Slop is a multiplayer VR horror game built for the Meta Quest where players explore a long-abandoned underground research facility,  and go through a variety of liminal spaces.\n\nUsing immersive VR movement and proximity voice chat, you and your team must navigate dark corridors, forgotten laboratories, and unstable cave systems while searching for a way out.\n\nBut you are not alone.\n\nSomething lives beneath the facility.\n\nAnd it\u2019s watching.\n\nPlayers must work together to:\n\nExplore multiple environments including facility halls, backrooms, and underground caves. Avoid deadly creatures that hunt players in different ways. Communicate and survive using proximity voice chat. Escape the depths before it\u2019s too late. Every run is unpredictable. Every sound matters. \n\nAnd every level takes you deeper into the nightmare. Just remember\u2026\n\nSome levels should stay sealed.", "short_description": "SubLiminal Slop is a multiplayer VR horror game built for the Meta Quest where players explore a long-abandoned underground research facility, and go through a variety of liminal spaces.\n\nUsing immersive VR movement and proximity voice chat, you and your team must navigate dark corridors, forgotten laboratories, and unstable cave systems while searching for a way out.\n\nAnd every level takes you deeper into the nightmare. Just remember\u2026\n\nSome levels should stay sealed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subliminalslopvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5StarStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/subliminalslopvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26381330304852546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821782_1872046833502434_4500932768354780201_n.png?stp=dst-png_s360x360&
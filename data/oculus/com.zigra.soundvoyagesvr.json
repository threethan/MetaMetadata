H-4jfYbGJmTedzj7yrDLRzGsKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwhnLu46bnxrgVJP-OydqkuSjHifXqnQSfHjpUBhoHJg&oe=6AB90AE2"}, {"file_name": "3_lista_serenity_vibes_sin_url.png", "id": "28212393121794383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/756589809_28212393131794382_9101462499650396771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqzMD0i4qA0Q7kNvwFJ48Sv&_nc_oc=Adqdl97sEtANhvDC-peufwXWzFogPR9-3yFUIMKO8_SA9euOlJ94sm3cBhTs0EtCCQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3zsgkLMrwWf0v6N6Lxa20KMEXz3jveZ8eoPYyspjJ4w&oe=6AB93253"}, {"file_name": "4_reproductor_lotus_mandala.png", "id": "1076094105344259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1076094108677592_2088000046788261585_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj4lkF0iY5cQ7kNvwFg597a&_nc_oc=AdpSC-GKbcVXcExzJAKMh_-6InAy2qKYiUTLS3ruDNzv84cZFjJIa19vwGFltcigJ7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFNGj2g9cThFj9jPKMK5yAd2dBUFBfIUbCu0GKTkkHgQ&oe=6AB92640"}, {"file_name": "5_desert_winds_barco_volador.png", "id": "2182320879362622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_2182320886029288_3055924156060172872_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3ZaJEtTP50Q7kNvwEYK7ca&_nc_oc=AdqWftNwcnCIk5LjRyPFGcq7JIMbGHMPukAOgcrtBmM1eKPchHJ9p9ywTk_cq9gCeFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICdb0j4yAugJ0UCDa_75m8lDmVcuPMovFtJZL6V45YGw&oe=6AB92154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada_trailer_nebulosa_FINAL.png", "id": "1060859123415115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1060859126748448_7361617755451568191_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-8kcRmtICQQ7kNvwFNCikd&_nc_oc=Adrx6mVHZEOiZ80MGTpkVZm_FXG9N0fc7GYySyYNcZYNS_YFU4MY_ed5BV_yCakYU1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6wQmUmE4uJt81Lk7AQBnRKuYiyaB3D4wt4r5BWggsUQ&oe=6AB919BD"}, "display_name": "Sound Voyages VR", "keywords": ["relax", "music", "sleep", "groove", "360"], "long_description": "### Step inside the music.\n\nSound Voyages VR turns each piece of music into a place you can stand in. Pick a voyage and the world wraps around you in 360\u00b0: neon night drives, deep space, ocean abysses, ancient shrines, dance floors and storms. Every voyage is original music by iKRX, made for 360\u00b0 video and streamed at full quality \u2014 up to 8K at 60 fps, without the compression of video sites.\n\n### A new voyage every week\nOver 120 immersive voyages already, and a new one every week. Collections: Serenity Vibes, Night Drive, Space Voyages, Cyberpunk Dreams, Cinematic VR Adventures and more.\n\n### Whatever mood you are in\nAmbient and downtempo to relax, meditate or fall asleep to. Techno and groove to move to. Dark and cinematic when you want an edge.\n\n### Made to sit back\n- Sleep timer that fades picture and sound out gently\n- Loop a voyage, or let the list play on\n- Keep watching: pick up where you left off\n- Favourites you can move to another headset with a code\n- Subtitles and interface in English and Spanish\n\n### Simple on purpose\nNo ads, no accounts, no purchases. One email to enter; news only if you ask.\n\nStreaming notice: voyages stream from our own servers, so a good internet connection is required. The streamed content is provided by Zigra Servicios Profesionales SL and may not be available in perpetuity.\n\nHealth notice: some voyages contain flashing lights and fast camera motion. Take breaks if you are sensitive to either.\n\nsoundvoyagesvr.com \u00b7 Support: info@zigra.net", "short_description": "Step inside the music. A free library of 120+ immersive 360\u00b0 video music voyages \u2014 with a brand new voyage every week. Drift through neon night drives, deep space, ocean abysses, ancient shrines and dance floors, streamed to your headset at up to 8K and 60 fps. Made to relax, meditate or fall asleep to, and just as good turned up loud. Over 1.2 million views on YouTube. No ads, no accounts, no purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soundvoyagesvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zigra Servicios Profesionales SL", "support_website_url": null, "website_url": "https://soundvoyagesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1289337424268687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1803486790787512"}]}, "baseline_offer": {"id": "1803486790787512"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789708860, "status": "PUBLISHED", "id": "1803486790787512"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1287899631079133", "version": "1.0.1"}, "id": "1038343485467765", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1232185963317167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1287899631079133"}, "release_status": "RELEASE
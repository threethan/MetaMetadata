2499650396771_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk5XjbAY5O4Q7kNvwH3rW8F&_nc_oc=AdoeesNPZAVp6cES_5D_uVUP53qpAQKrPRUJ4jbstpzSD7HYGXBB1F3bIRTe4Z0N420&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPumr2qqXI4Ph1OOxw9mTeAswLKP4ToeLvSmNSg04x_A&oe=6AEB4B53"}, {"file_name": "4_reproductor_lotus_mandala.png", "id": "1076094105344259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1076094108677592_2088000046788261585_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN19739G3Z0Q7kNvwHUQWUq&_nc_oc=AdoxO01EKT_5YJ8u7pQYH6HCnuhjVRBAF8Ce4GiFKu_QvM3tkH1M9osMXSIIva5q82s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXwCosZ6Z_2BCjPgfQNRosyQF664dP9qUepVqHgNIe9Q&oe=6AEB3F40"}, {"file_name": "5_desert_winds_barco_volador.png", "id": "2182320879362622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_2182320886029288_3055924156060172872_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHf_xX_LT1IQ7kNvwGIBmUS&_nc_oc=AdpNeKgWjMjCBUCjuVAwu09eXyB5lxAUM3idhxOu1TVoR2PmAV7KCCF9vJM7KTJ5lxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk4L67IAMwyzI0Hni7Y5XL8RLgiQwvpLvPLoHUVI3Nhw&oe=6AEB3A54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada_trailer_nebulosa_FINAL.png", "id": "1060859123415115", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1060859126748448_7361617755451568191_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeoFzCsbezsQ7kNvwEkwjYo&_nc_oc=AdrWRhZB-DQTE8AjCCSDb83lGjfXSbHqbVFtvAO7T6J-z1YGl5gQJ-7aeXvklKKZ46M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRSh4klrGjfzGlqAG0PshsoqX8-Mwq3yrFenOYipvzEw&oe=6AEB32BD"}, "display_name": "Sound Voyages VR", "keywords": ["relax", "music", "sleep", "groove", "360"], "long_description": "### Step inside the music.\n\nSound Voyages VR turns each piece of music into a place you can stand in. Pick a voyage and the world wraps around you in 360\u00b0: neon night drives, deep space, ocean abysses, ancient shrines, dance floors and storms. Every voyage is original music by iKRX, made for 360\u00b0 video and streamed at full quality \u2014 up to 8K at 60 fps, without the compression of video sites.\n\n### A new voyage every week\nOver 120 immersive voyages already, and a new one every week. Collections: Serenity Vibes, Night Drive, Space Voyages, Cyberpunk Dreams, Cinematic VR Adventures and more.\n\n### Whatever mood you are in\nAmbient and downtempo to relax, meditate or fall asleep to. Techno and groove to move to. Dark and cinematic when you want an edge.\n\n### Made to sit back\n- Sleep timer that fades picture and sound out gently\n- Loop a voyage, or let the list play on\n- Keep watching: pick up where you left off\n- Favourites you can move to another headset with a code\n- Subtitles and interface in English and Spanish\n\n### Simple on purpose\nNo ads, no accounts, no purchases. One email to enter; news only if you ask.\n\nStreaming notice: voyages stream from our own servers, so a good internet connection is required. The streamed content is provided by Zigra Servicios Profesionales SL and may not be available in perpetuity.\n\nHealth notice: some voyages contain flashing lights and fast camera motion. Take breaks if you are sensitive to either.\n\nsoundvoyagesvr.com \u00b7 Support: info@zigra.net", "short_description": "Step inside the music. A free library of 120+ immersive 360\u00b0 video music voyages \u2014 with a brand new voyage every week. Drift through neon night drives, deep space, ocean abysses, ancient shrines and dance floors, streamed to your headset at up to 8K and 60 fps. Made to relax, meditate or fall asleep to, and just as good turned up loud. Over 1.2 million views on YouTube. No ads, no accounts, no purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soundvoyagesvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zigra Servicios Profesionales SL", "support_website_url": null, "website_url": "https://soundvoyagesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1289337424268687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1803486790787512"}]}, "baseline_offer": {"id": "1803486790787512"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789708860, "status": "PUBLISHED", "id": "1803486790787512"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1366787916523637", "version": "2.0.2"}, "id": "1038343485467765", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1232185963317167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1366787916523637"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1038343485467765"}]}, "change_log": "What\u2019s new in 2.0\n\u2022 Tablet mode: hold the menu in your hands like a tablet. Grab it by its edges, move it anywhere, and toss it back when you\u2019re done.\n\u2022 Touch it directly: tap with your index f
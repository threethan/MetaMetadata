/scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162705_319966728419130_3243453366570844160_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXWtIJ4z7q8Q7kNvwG-yIBr&_nc_oc=Ado1GhAnwEupYVOJP1-jGE_umXf77k2VcQariDuVxn69j28lfBS0EjqxnnKb8a2GXK8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmKU8eJYqvY7QS47yFOnxcZq-E30jS94Ec1Yp7G8b_AA&oe=6AFB3553"}, "display_name": "Hello Mars", "keywords": ["Mars", "Hello", "NASA", "Simulator", "Martian"], "long_description": "Hello Mars Highlights:\nAll 3D data & landing procedures of Hello Mars were created strictly based on NASA\u2019s public data & research.\n- Experience the \u201c7 minutes of terror\u201d Mars landing sequence in VR with real-time rendered graphics and spatial sound effects\n- Prepare yourself as a space pilot in the actual landing simulation lab.\n- Voyage through the distinctive Martian terrain surface with the Curiosity Mars Rover.\n- Learn more about the spacecrafts and historic Mars missions via the interactive VR showroom. \n \nHello Mars is the best way to introduce & showcase VR to your family and friends, a \u201cMust have\u201d GearVR app for all space lovers. \n \nYou can follow us on social media, for Facebook | Twitter | Weibo:  hellomarsvr", "short_description": "For all space lovers, set your foot on Mars in GearVR today!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.uccvr.com/privacy.html", "developer_terms_of_service_url": "http://uccvr.com/eula.html", "publisher_name": "UCCVR Experience Lab", "support_website_url": null, "website_url": "http://mars.uccvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomme
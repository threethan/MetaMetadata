xqSpleZyzrjcdfg9HHIk71K6ajl0D9Izc0uQ&oe=6A3BD393"}, "display_name": "Hello Mars", "keywords": ["Mars", "Hello", "NASA", "Simulator", "Martian"], "long_description": "Hello Mars Highlights:\nAll 3D data & landing procedures of Hello Mars were created strictly based on NASA\u2019s public data & research.\n- Experience the \u201c7 minutes of terror\u201d Mars landing sequence in VR with real-time rendered graphics and spatial sound effects\n- Prepare yourself as a space pilot in the actual landing simulation lab.\n- Voyage through the distinctive Martian terrain surface with the Curiosity Mars Rover.\n- Learn more about the spacecrafts and historic Mars missions via the interactive VR showroom. \n \nHello Mars is the best way to introduce & showcase VR to your family and friends, a \u201cMust have\u201d GearVR app for all space lovers. \n \nYou can follow us on social media, for Facebook | Twitter | Weibo:  hellomarsvr", "short_description": "For all space lovers, set your foot on Mars in GearVR today!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.uccvr.com/privacy.html", "developer_terms_of_service_url": "http://uccvr.com/eula.html", "publisher_name": "UCCVR Experience Lab", "support_website_url": null, "website_url": "http://mars.uccvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1251912771998896"}, "review_messages": []}]}, "cover_square_image": {"
 today!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.uccvr.com/privacy.html", "developer_terms_of_service_url": "http://uccvr.com/eula.html", "publisher_name": "UCCVR Experience Lab", "support_website_url": null, "website_url": "http://mars.uccvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1251912771998896"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "CANCELLED", "id": "338147203318882"}, {"status": "PUBLISHED", "id": "148936939108324"}, {"status": "PUBLISHED", "id": "366068433819430"}, {"status": "PUBLISHED", "id": "1558450387559954"}, {"status": "PUBLISHED", "id": "1911808032166933"}, {"status": "PUBLISHED", "id": "1650416775031774"}, {"status": "CANCELLED", "id": "155354808554902"}, {"status": "PUBLISHED", "id": "1699402766754960"}, {"status": "PUBLISHED", "id": "563958570651599"}, {"status": "PUBLISHED", "id": "156024531731373"}, {"status": "PUBLISHED", "id": "177738989534901"}]}, "baseline_offer": {"id": "1699402766754960"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "CANCELLED", "id": "338147203318882"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1298927040221614", "version": "1.1.5.1"}, "id": "793507824141498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nod
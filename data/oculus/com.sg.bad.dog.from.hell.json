BeR_TB2T5URFzjYnMLY_1U1MH1whqmHReTBSqEPLQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaHuQrFNDnJ3K7HMRQcfyFeIvxFC5G6WklUa0mC625eg&oe=6A81B595"}, {"file_name": "5.png", "id": "2287826901660715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819356_2287826904994048_2940115318031769793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYEd4Rw8CzwQ7kNvwGO3OfQ&_nc_oc=AdqGmqCMNWC8mtXh4bFXJ63NWBdwdAtaUCRUwQDBCsuT7sZ9uZK_Fn5165_i0dsh1pk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3TViL-EfCmFVLaHBs4PrvewtA4S6C-KWzeTGgBiMO-Q&oe=6A81B090"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Bad Dog From Hell", "keywords": ["dog", "simulator", "granpda", "VR"], "long_description": "In I Am Bad Dog From Hell , you\u2019re not just any dog\u2014you\u2019re a chaos-fueled prankster straight from the depths of canine mischief! Experience the mayhem in full VR from your own dog\u2019s-eye view as you torment your cranky, relentless grandpa. Sneak into rooms to pop balloons, toss books from shelves, and flick the TV on just to watch him fume. Snatch a frying pan and hurl it his way, bound onto tables, or even cling to the ceiling to stay out of reach. Every prank is a new way to drive him mad while you make daring escapes from his grasp. But beware\u2014grandpa\u2019s fast, clever, and determined to catch you! Packed with slapstick humor, fast-paced action, and hilarious interactions, this is a heart-racing dog vs human showdown where the goal is simple: be the baddest dog and never get caught.\n\nFeatures:\n\nFull VR Dog\u2019s-Eye View \u2013 Immerse yourself in the chaos from a first-person canine perspective.\n\nMischief-Packed Gameplay \u2013 Pop balloons, throw books, mess with the TV, and more.\n\nDynamic Grandpa AI \u2013 Outsmart a relentless and reactive grandpa determined to catch you.\n\nInteractive Environment \u2013 Grab, toss, and jump onto objects, from frying pans to shelves.\n\nHigh Mobility \u2013 Run, leap, and even cling to ceilings to stay one step ahead.\n\nSlapstick Fun \u2013 Enjoy over-the-top pranks and hilarious reactions in every encounter.", "short_description": "Step into the paws of the ultimate mischief-maker in I Am Bad Dog From Hell! As a naughty dog, pull hilarious pranks\u2014pop balloons, toss books, turn on the TV, and even drop pans\u2014while your furious grandpa tries to catch you. Leap to the ceiling, dash around, and outsmart him at every turn in this chaotic VR comedy of dog vs human!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://signatureholdingsltd.com/privacy-policy", "developer_terms_of_service_url": "https://signatureholdingsltd.com/terms-and-conditions", "publisher_name": "Signature Games", "support_website_url": "https://signatureholdingsltd.com/contact-us", "website_url": "https://signatureholdingsltd.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31822463634007316"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1612648786578452"}, {"status": "PUBLISHED", "id": "1492666555392167"}, {"status": "PUBLISHED", "id": "1132368141817139"}, {"status": "PUBLISHED", "id": "24315264304797274"}, {"status": "PUBLISHED", "id": "1065039179164103"}]}, "baseline_offer": {"id": "1612648786578452"}
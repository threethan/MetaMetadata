183202_6804179322370908442_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njyNNaHCcvcQ7kNvwF8E-K-&_nc_oc=AdowRT8nTnuu1It3V3j4c-A-OwycyECJkYqVDnEReyR3JjBI7wbwFSPe8T9zq1Hx3hw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2__6hvygkjU346iBXHNr3cwUWg86ky4HQRvE5YTnroIw&oe=69F204AA"}, {"file_name": "Screenshots-4.png", "id": "2074559966703153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821952_2074559970036486_8387706909598038158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mVKWgjgZ6QQ7kNvwEHsMpJ&_nc_oc=AdpjFXSK7Jm0qrxs4ZkWGUENSUiy7GXB9mNETW_wR-JcbpSbWonweKQBDPhzllM1L6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af19lWdRqV1r696cyU5RvRn3C8hGD8FA7C35zPsS8DT75w&oe=69F1F3E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1480679329165385", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982674_1480679335832051_8277201057350291656_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IF51i8VwTZkQ7kNvwHM1k8t&_nc_oc=AdouD4Gf_zfpXMkD9Qzj6keg77jLqPsGavaHAhNXn6A-I3T0lFp0Vmj8PN7SsmzI6-Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1_o0uz1M1VeewhWeqcF1gvCMQrqpnQydXqe9kz0877NA&oe=69F1F454"}, "display_name": "Innkeeper VR", "keywords": ["innkeeper", "tavern", "medieval", "manage", "cooking"], "long_description": "# Innkeeper VR \u2013 Your Medieval Tavern Awaits!\n\nStep into the shoes of a medieval tavern keeper in a bustling fantasy world! In Innkeeper VR, you control every detail of your tavern, from cooking to cleaning, serving to managing unruly guests.\n\n# What Awaits You:\n\n- **Cook:** Purchase fresh ingredients, chop vegetables, grind grains, and turn them into a cauldron of flavorful stew or a barrel of the finest alcohol. Experiment boldly to discover new recipes and bring in even more shiny coins!\n- **Clean & Serve:** Keep your tavern spotless, pour drinks, serve meals, and ensure guests leave happy.\n- **Handle Chaos:** Break up brawls, stop theft, and physically throw out troublemakers to maintain peace and protect your earnings.\n- **Hire Staff:** Recruit a bard to charm patrons, a waitress to serve faster, a cleaner to tidy up, and eventually a cook to handle recipes in your expanding establishment.\n- **Customize:** Decorate your tavern to reflect your vision, whether it\u2019s a cozy retreat, a hunter\u2019s lodge, or a noble\u2019s haven.\n- **Expand:** Start small and grow into a grand, prestigious inn with guest rooms, a bigger kitchen, and space for more visitors.\n\nYour story begins now \u2014 grab your tankard and prove your worth as the ultimate innkeeper!", "short_description": "Run your own medieval tavern in a bustling fantasy world! Cook hearty meals, brew drinks, and discover new recipes. Keep your space spotless, serve guests, and manage chaos by handling brawls and throwing out troublemakers. Hire and manage staff like bards, waitresses, and cleaners to grow your business. Customize your tavern, attract diverse patrons, and expand into a grand inn with guest rooms and a larger kitchen. Your journey to tavern legend starts now!"}]}, "developer_name": "Moon Haven", "developer_privacy_policy_url": "https://moonhaven.games/privacy-policy-innkeeper-vr/", "developer_terms_of_service_url": null, "publisher_name": "Moon Haven", "support_website_url": "https://discord.com/invite/ZhUQwEearp", "website_url": "https://moonhaven.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25225459763738012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572927_1514760112667254_6108568675557641183_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjE5zdjPzKoQ7kNvwHbFZ_z&_nc_oc=AdoX5lmgzBVq1U4YfW8lismhr_C8uIdwBLMPxjP5ZYxSDQLH8378htUA2Aa3Y5i7nw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2O6vsTeW0q4JDQ5eOCDQHGswW6CyANIsAD_Jwtp-BPkw&oe=69F20032"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Innkeeper VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1668034800, "lastRevision": {"nodes": [{"id": "5563528913691056", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5563528830357731", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3467396073546967"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "mini-landscape.png", "id": "5377902932258935", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974706_5377902945592267_8178964417693708976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIp47KFrgo4Q7kNvwE2OtK4&_nc_oc=Adr-uKOkPHrLuD6HRM1s4mBhM2xzfoJUuAl8S0hxA90PWpWHAG4bgx6cHj6zxhNKzMk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2sdK5CFU4zR4HT7XVqS3vCvHMRhoKpYSJiX-TL9n-3CA&oe=69F21155"}, {"file_name": "Portrait.png", "id": "1562796947509486", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": 
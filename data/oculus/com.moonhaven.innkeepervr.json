ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1583175886183202_6804179322370908442_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5-67QY55NcQ7kNvwHLEaSy&_nc_oc=AdkGtdnbbwHuPti3uF_tbmYxuzJAgTiGOnfpRnSmJTRbGBE7IeFpk2AAfPwDro3g-YI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXd748vV6WqM3y9wkGNdQ9IGfZt87JNNwWU6JfQVNNyQ&oe=69AC252A"}, {"file_name": "Screenshots-4.png", "id": "2074559966703153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821952_2074559970036486_8387706909598038158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmZOxYKYQNEQ7kNvwEIjOeg&_nc_oc=Adkvv84LcIK_TE8iVV1INoXWMhltaCFNYy8Tlpt0z2DOJiyd6ytL1TxOJV2MmPOD7y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZ1Z4GQBGQ_ji4iEYDOKICpcn41qk5ToYJEdNN7jV10g&oe=69AC1467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1480679329165385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_1480679335832051_8277201057350291656_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_qGgo5EDOwQ7kNvwFjf9iz&_nc_oc=AdlzmYUyx4yOMYqRKBopG0obNSVUDO8qqZZeqomuuhAi1hxd15viTMt1MDogxey7rYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkV6SabCsHbDHTRSBNKD_cpgF6YKnM8PkVJij-Yv70XQ&oe=69AC14D4"}, "display_name": "Innkeeper VR", "keywords": ["innkeeper", "tavern", "medieval", "manage", "cooking"], "long_description": "# Innkeeper VR \u2013 Your Medieval Tavern Awaits!\n\nStep into the shoes of a medieval tavern keeper in a bustling fantasy world! In Innkeeper VR, you control every detail of your tavern, from cooking to cleaning, serving to managing unruly guests.\n\n# What Awaits You:\n\n- **Cook:** Purchase fresh ingredients, chop vegetables, grind grains, and turn them into a cauldron of flavorful stew or a barrel of the finest alcohol. Experiment boldly to discover new recipes and bring in even more shiny coins!\n- **Clean & Serve:** Keep your tavern spotless, pour drinks, serve meals, and ensure guests leave happy.\n- **Handle Chaos:** Break up brawls, stop theft, and physically throw out troublemakers to maintain peace and protect your earnings.\n- **Hire Staff:** Recruit a bard to charm patrons, a waitress to serve faster, a cleaner to tidy up, and eventually a cook to handle recipes in your expanding establishment.\n- **Customize:** Decorate your tavern to reflect your vision, whether it\u2019s a cozy retreat, a hunter\u2019s lodge, or a noble\u2019s haven.\n- **Expand:** Start small and grow into a grand, prestigious inn with guest rooms, a bigger kitchen, and space for more visitors.\n\nYour story begins now \u2014 grab your tankard and prove your worth as the ultimate innkeeper!", "short_description": "Run your own medieval tavern in a bustling fantasy world! Cook hearty meals, brew drinks, and discover new recipes. Keep your space spotless, serve guests, and manage chaos by handling brawls and throwing out troublemakers. Hire and manage staff like bards, waitresses, and cleaners to grow your business. Customize your tavern, attract diverse patrons, and expand into a grand inn with guest rooms and a larger kitchen. Your journey to tavern legend starts now!"}]}, "developer_name": "Moon Haven", "developer_privacy_policy_url": "https://moonhaven.games/privacy-policy-innkeeper-vr/", "developer_terms_of_service_url": null, "publisher_name": "Moon Haven", "support_website_url": "https://discord.com/invite/ZhUQwEearp", "website_url": "https://moonhaven.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
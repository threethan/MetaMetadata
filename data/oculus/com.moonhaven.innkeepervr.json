sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1583175886183202_6804179322370908442_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a4CjcUxxQYQ7kNvwFH7-6Z&_nc_oc=AdlDOnbT55C3IDGxoGoG1Ezq8gzLS1E4RpvOmZLAK-iFlEQ4n8E-KlgdVN6mIGqJo7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVKCSKOelYxYAsKQGkkHNFFUuyUc-PgMC1EV_H_kJsTw&oe=69B6B12A"}, {"file_name": "Screenshots-4.png", "id": "2074559966703153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821952_2074559970036486_8387706909598038158_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTazzL16FYoQ7kNvwFnonnO&_nc_oc=AdloC5RvUn3Werqoedjfd6KIKoooKOWkHFMEjc8tHWA_TYPPquen1RtZu9udSWmnojk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHvmYR6Vy7Erx5XLIvg70XNUvtyJyomoX2n11ggtyhUg&oe=69B6A067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1480679329165385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982674_1480679335832051_8277201057350291656_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMN8dTLmrAkQ7kNvwGLid4u&_nc_oc=AdmIII48MTLT--j9Q8oEsRFigR9exS8UDlpnVOKc9TjDNLCkgQ8VA6CGJy95VhjDhwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtmLjy9V3GO1F5U8RrVKhslVRL5NbWw_VLIUg2CSKZYg&oe=69B6A0D4"}, "display_name": "Innkeeper VR", "keywords": ["innkeeper", "tavern", "medieval", "manage", "cooking"], "long_description": "# Innkeeper VR \u2013 Your Medieval Tavern Awaits!\n\nStep into the shoes of a medieval tavern keeper in a bustling fantasy world! In Innkeeper VR, you control every detail of your tavern, from cooking to cleaning, serving to managing unruly guests.\n\n# What Awaits You:\n\n- **Cook:** Purchase fresh ingredients, chop vegetables, grind grains, and turn them into a cauldron of flavorful stew or a barrel of the finest alcohol. Experiment boldly to discover new recipes and bring in even more shiny coins!\n- **Clean & Serve:** Keep your tavern spotless, pour drinks, serve meals, and ensure guests leave happy.\n- **Handle Chaos:** Break up brawls, stop theft, and physically throw out troublemakers to maintain peace and protect your earnings.\n- **Hire Staff:** Recruit a bard to charm patrons, a waitress to serve faster, a cleaner to tidy up, and eventually a cook to handle recipes in your expanding establishment.\n- **Customize:** Decorate your tavern to reflect your vision, whether it\u2019s a cozy retreat, a hunter\u2019s lodge, or a noble\u2019s haven.\n- **Expand:** Start small and grow into a grand, prestigious inn with guest rooms, a bigger kitchen, and space for more visitors.\n\nYour story begins now \u2014 grab your tankard and prove your worth as the ultimate innkeeper!", "short_description": "Run your own medieval tavern in a bustling fantasy world! Cook hearty meals, brew drinks, and discover new recipes. Keep your space spotless, serve guests, and manage chaos by handling brawls and throwing out troublemakers. Hire and manage staff like bards, waitresses, and cleaners to grow your business. Customize your tavern, attract diverse patrons, and expand into a grand inn with guest rooms and a larger kitchen. Your journey to tavern legend starts now!"}]}, "developer_name": "Moon Haven", "developer_privacy_policy_url": "https://moonhaven.games/privacy-policy-innkeeper-vr/", "developer_terms_of_service_url": null, "publisher_name": "Moon Haven", "support_website_url": "https://discord.com/invite/ZhUQwEearp", "website_url": "https://moonhaven.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
16NOcflrXgtANerE3sd4dHuflUYkgdQAF9ww8kJIp6wG8G6JeDqybeBQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_5AwHEtfYDgLNUJKrm-M-sdWSGpjRCQc_OQbfCxIYcw&oe=6AFB1D36"}, {"file_name": "Screenshots-3.png", "id": "1583175882849869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617729_1583175886183202_6804179322370908442_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_OyKZB8ILUQ7kNvwFM3jn1&_nc_oc=AdqedF1X1_tckClsZzSZFZtt1XJzgKcXqlb3JPntEHTmbvWnbKRYhjlKjeXKHyBS2Bw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMIPxaLb0OxC1ezkLZydbEACMJmTIoDpvfAfN-FgpoSg&oe=6AFB3A6A"}, {"file_name": "Screenshots-4.png", "id": "2074559966703153", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821952_2074559970036486_8387706909598038158_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMlmhiDZQGgQ7kNvwFKxYjp&_nc_oc=Adr11sYzY5abcvDTjaK_fggieACWB-gsQp8s_eg0mjv-Bk5F-R_n1tgjhpjdZb9AdLI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2gLAiySE7iLzFTt5VwPjIbeHBH_JKPrIOZx9GJc7GKA&oe=6AFB29A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1480679329165385", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982674_1480679335832051_8277201057350291656_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QW-sHFx0pQQ7kNvwG9iyVe&_nc_oc=AdrrEIaVziITzyuUU685oewvLQwqJfna-FDnccI6lyfT21CWTi4n8pXvnjB_hJnRzs8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG9iyef1SurLMgccx7rB8GJ5JhSXFXQKL3zhagxzooiw&oe=6AFB2A14"}, "display_name": "Innkeeper VR", "keywords": ["innkeeper", "tavern", "medieval", "manage", "cooking"], "long_description": "# Innkeeper VR \u2013 Your Medieval Tavern Awaits!\n\nStep into the shoes of a medieval tavern keeper in a bustling fantasy world! In Innkeeper VR, you control every detail of your tavern, from cooking to cleaning, serving to managing unruly guests.\n\n# What Awaits You:\n\n- **Cook:** Purchase fresh ingredients, chop vegetables, grind grains, and turn them into a cauldron of flavorful stew or a barrel of the finest alcohol. Experiment boldly to discover new recipes and bring in even more shiny coins!\n- **Clean & Serve:** Keep your tavern spotless, pour drinks, serve meals, and ensure guests leave happy.\n- **Handle Chaos:** Break up brawls, stop theft, and physically throw out troublemakers to maintain peace and protect your earnings.\n- **Hire Staff:** Recruit a bard to charm patrons, a waitress to serve faster, a cleaner to tidy up, and eventually a cook to handle recipes in your expanding establishment.\n- **Customize:** Decorate your tavern to reflect your vision, whether it\u2019s a cozy retreat, a hunter\u2019s lodge, or a noble\u2019s haven.\n- **Expand:** Start small and grow into a grand, prestigious inn with guest rooms, a bigger kitchen, and space for more visitors.\n\nYour story begins now \u2014 grab your tankard and prove your worth as the ultimate innkeeper!", "short_description": "Run your own medieval tavern in a bustling fantasy world! Cook hearty meals, brew drinks, and discover new recipes. Keep your space spotless, serve guests, and manage chaos by handling brawls and throwing out troublemakers. Hire and manage staff like bards, waitresses, and cleaners to grow your business. Customize your tavern, attract diverse patrons, and expand into a grand inn with guest rooms and a larger kitchen. Your journey to tavern legend starts now!"}]}, "developer_name": "Moon Haven", "developer_privacy_policy_url": "https://moonhaven.games/privacy-policy-innkeeper-vr/", "developer_terms_of_service_url": null, "publisher_name": "Moon Haven", "support_website_url": "https://discord.com/invite/ZhUQwEearp", "website_url": "https://moonhaven.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
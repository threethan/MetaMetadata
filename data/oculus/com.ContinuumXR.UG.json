qaDlbCup2_FkLI37GQ_IOSMLkrqT1xcQYrGtrq0-JJZ-6wSDl6koVKjnEYI-RM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NVf1EcEZcHdeG_rHAA16PykjWV0EBsT5g0RW3UTJ2_g&oe=69EB64C2"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWcdwRea8FcQ7kNvwEVoOpP&_nc_oc=Adpk9wIgaXVrihTUpJKJ0JiN7OK_VzZnhlGn3_WWHSxshIpZKR9b0zh1sqGPRTQbxyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TcNv-aJrquDIul2Hj6sir-XuU8pyIXCZp3kemUs89WQ&oe=69EB88D6"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHvwyS2C_tsQ7kNvwFxbFfv&_nc_oc=AdpQYn8hnc0nwsVMd-fvFwBnLPaeE5Wo9FGGtiXLOrU8i57C2sPM_X1PwgHzeoUx8o8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r2lJLnmfWjkjXcmPo7o8VyJsg6F5QPCnMbsrQH6gzZg&oe=69EB6C61"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFuTz9POsTEQ7kNvwHOfiNI&_nc_oc=AdrxgZXSkj4BowPCocS0zowB9z2UK03gxe_nF3F1m7HqWFrxXKxYffd601JyRn0U-I0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P-DpoSoxcFibZLUkSETCI5k1kTkSFyepmimJs4_qJCw&oe=69EB7516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Ix-z4_Fb0Q7kNvwGrVs8W&_nc_oc=AdpgdCTZf2t-Kzrv2uLGW7wQyvke_LnKM1VHPGahCsOwGkXRjWHk8i-z5Qp_DnALKKI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bOfl0Luzeq62sq6JyYEMg5mBBWFP7vvy5SSAIm-Si9w&oe=69EB6823"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
c_ss=8&oh=00_Afwu1T-cIseZ1I2cFU1-oZ2E5x1Tw52BozpR1xzbuMyA5Q&oe=69C134C2"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiSEXSrL4hsQ7kNvwER9tJE&_nc_oc=Adp1xK42caj3BIKE_mUoIXqC8yvFC003g0HpSLSanzpwksxE2JEGFhPB5MgWZUEdDsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpSzPM4mE_739PQ_uBJAYccYZWVqoXRgGZ2OFGVrkJGA&oe=69C12096"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMSHgMUFKhEQ7kNvwGr1YnZ&_nc_oc=AdoevDZkGVlbMGFOzkx_iNaE9LOrQ9_-BSflu5HTLms2lNj90OWEURGWDFvi-UZmhPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgPPx9Ki8FhFg-gQQB3T2-zh1jB17dypDSrZBqtSiFyw&oe=69C13C61"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6ihptKFLhcQ7kNvwGCmEHB&_nc_oc=AdrhMR9VLm1oiOCIdD_Jj10Ns6WgkJ5du28Oy94HQs0f0FXLSd09QcUJjbjREarM6TU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy00qmsFcgRY9HhuO4VgCtfor3UsRk7ocjSByVUFFmuwg&oe=69C14516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBjC9fF1b_0Q7kNvwF3pAKi&_nc_oc=Ado_Lw6nSaJaTHSUnwY8nXOW5OmCg121F6dL5xjVW_pq1g0yKCeXP6gCECbiOnAyL-A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdK0Cyonjb0xqXvRyWidEWGzCr6YrKz7wu9oHiHiunsw&oe=69C13823"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
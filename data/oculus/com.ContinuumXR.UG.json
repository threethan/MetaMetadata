F4sy91QJ4g3dYCyxfenKmE0QSBGGPPG6m6PIgZqPWWsTBX_ojPJsDsfZMqA1w8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Y9VMafPf8rVeDTaHJn4YrlPssjoQ-9CCuaqG_BiHQA&oe=69E77042"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76FCp9UoTB8Q7kNvwHvmEzi&_nc_oc=AdoozgebILCRHPAzhUc9G2QoIWvkagghJ9rPGmCPFM0sVRjGtjdcX8OyP_h2UjKsJYI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zfKZAwHuzFBk9UCTds_LWSkMX2w1XzZxTrF0RTXFNqg&oe=69E75C16"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwKR3GDLE28Q7kNvwEGen6n&_nc_oc=AdpeoRHfL6MM3-Ct_S0KQ4TgPy3lveCkqqHMRjRA2OCsKvK9fzRuMPxFhUjAA3RTk5Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28zEBPhtPhiFXSiyhJcQJuRPkPtrl3uv3Rz4D-8xb6MA&oe=69E777E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qOENKj0KzQQ7kNvwFi2Lzy&_nc_oc=AdqjnADCVl1rrb5NyMRwypFRBp8S-kgBcpA9zlGx2xz6usSSzsESC80EWx1PABmHZpc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AWGwN3AV0F9qpiohyRQ8JMnnNEGWOZNUfeIqfespydw&oe=69E78096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZfO4uQNEK0Q7kNvwHOJ3Ad&_nc_oc=AdrSBkAGSHJPqulMpZT73Oeaa8RqvmU06ZQQKctdyWbC4OE29ct7p9TI1Z5PhPnbqqg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b-Vt9zUdbO7eh6s8DCuqgcl5obcXbzaiJaa-O4YJqVA&oe=69E773A3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
12", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824012_1387956526425545_9118400061305828374_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS70pk10-BwQ7kNvwEChnBa&_nc_oc=AdoPkknpCHODxHHWde1Y8nhFwyakEC4_3tZyMxBBcfBkOHdiJAY3MOoPecQLfliAvMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1DWND7Tyf6BIgrzo72qX6Qj3DrjJSMtjunjegsundRg&oe=6AB27B9C"}, {"file_name": "Watering Hole 1.png", "id": "27660978210159004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499309014_27660978213492337_1865525266710838074_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wGdDlLZ9HoQ7kNvwF07m1T&_nc_oc=AdqSmTBkiHHSzcfwt-Yr1oY6ZfOCDpBSsnOPabNK85W7OivK4Vk3yEI6b05BkDfTa4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoPlbDJddJslTYVcLKkyQ07YXy9TxOr3M0eqJaVZo7fw&oe=6AB297F3"}, {"file_name": "Cow Canyon 3.png", "id": "978579584660340", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307470_978579587993673_496570818273099848_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90ukfNrLkOkQ7kNvwFHvDRD&_nc_oc=AdoXSh8j5MB1q5xs9z4Qazi69IfC0ABy0lWSXbpps0meDXHNMUnCxUD1A11i5DW-v7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINkYf_hYgcDMA0tytzgbi64bUMlgDL3HSFVwxhJ5u3Yw&oe=6AB27F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_Meta_Banner_DINO_MASTER.png", "id": "1598151688431876", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623558_1598151695098542_844076325083149233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kANZqzVd3MQ7kNvwFeQ3RF&_nc_oc=Adq3T0h6MdbuoKfY7Sd29VcuPG5UoFcLuHBeREOSHKXBfH3zYPzhJEeeVyzw6O1BDgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9LTsLKYBQgXisCMy8rU751_toGUOAuJ8KT_Mfp5pSjg&oe=6AB29E4D"}, "display_name": "UG", "keywords": ["free", "social", "action", "multiplayer", "dinosaur"], "long_description": "                                                                                                                                                                                                             \n\n\n\n**RAISE DINO**\n\n{802769962423593}\n\nDINO SMALL. AWW. GIVE GOOD NAME. STRONG NAME. LIKE MUG. RHYME WITH UG. \n\n**RIDE DINO**\n\n{1683283132386209}\n\nFEED DINO. NOW BIG. RIDE DINO. GO ADVENTURE. NO GO IN CAVE. TOO SCARY. STAY BY WATER WITH FRIEND. SAFE. \n\n\n**COLLECT DINO**\n\n{1100334291498447}\n\nWANT OTHER DINO? TRADE WITH FRIEND. FRIEND HAPPY. \n\n**LOOK PRETTY**\n\nLOINCLOTH SO LAST SUMMER. GET NEW. ALL OTHER UG JEALOUS. \n\n**MORE DINO**\n\nUG UPDATE THURSDAY. NEW DINO. MAYBE NEW MAP. NEW BUG? UG FIX BUG. UG PROUD.\n\nJOIN TRIBE\u2026 DISCORD.GG/UGVR", "short_description": "HATCH, RAISE, RIDE DINOSAUR. HELP FRIEND TRADE, FIGHT BOSS. FRIEND DIE. NO LAUGH. NOT FUNNY... OKAY MAYBE SMALL LAUGH. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27904187899273710"}, "review_messages": []}]}, "cover_square_image": {"
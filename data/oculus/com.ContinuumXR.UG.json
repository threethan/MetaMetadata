DGUzs91izQEeXyCT9mOsLWenDZY7OQteHYvCSMMaMh-KfY6212xe1c4WLwGUbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20gjhH3KPpBSEn4T71d_y1ivQug95RVfpycAV3x1FKFw&oe=69EF5942"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMuGVnqesA0Q7kNvwHpHaOM&_nc_oc=Adqxg49O99VuZgGzDblvM-YV-2tvDX4XoEwAygMbDLuGMMV5itHzaV_EJGyfgk6Qnlg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fyJ7v3dYmudPSAMa62WqKEfQII7LqYjoonZ7NhzU7uQ&oe=69EF7D56"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhPl58XAFEIQ7kNvwG1iHwC&_nc_oc=AdobzdX4iX4Gj7Gd-9kcX5mjq4FXO0Wr0zAzQ3sanLjPRW30RWjrxZ23ddEV393aDaQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BgaEooTZZX4MJ6kOBTf_RNM6_16ySqgSFsLVvuNFBCQ&oe=69EF60E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmxLfeNRF3wQ7kNvwFe39Yi&_nc_oc=AdqCxMrfbbAuqeHqvn9lWJkJSlkb6E6cFqw8bpakiQJypyTlvA0PU404b1BNwChI-f0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ySJtcw0ehioj_uz_AkT4an2z8TwrCUpYaK5ayKJw4Hw&oe=69EF6996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xaG0mPfDVoQ7kNvwGd3u-I&_nc_oc=AdpjOR8igrvGQX7sCHXaPEIUcQNdEPoGP68zf7tSmIACKRVWTVqa0VdzcbM5KOsoJto&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sx7SwYK5Elg2XnOAbPypVve3VxttVA1I6jUvY-TsDCw&oe=69EF5CA3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
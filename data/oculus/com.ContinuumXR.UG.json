OkPypCystUkPkJYk7YbPWtgSQGzMU9alrN20FIOL88xaVvtfwf2Q65s_V06Uts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mzj4jWP879fipsFwWUhvX11srYD5GucjjDK31LUVp4g&oe=69DE35C2"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNvDn_8P0cgQ7kNvwGle3O9&_nc_oc=Adq6YY4-gK_tOq1N1ftbk4-DqRAeEH_NJ05DL66E_Mhcvl0SgErjdRh_g9f0CwcGl6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zG2hGVv5x6TpA104aoGiaYOn2E7VdkJIZCn-ltyoU-w&oe=69DE2196"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIqtoAjMJWUQ7kNvwGZlWG4&_nc_oc=AdpwkxdD7m5z27zsI02BqIxJlCtWpw_CQ-IwodpuroXWFIieGIV_1-df_9WbgfFdKnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zyvw00Aqw97W5do5H8D72ibf79ecml17FtXQ1v7eh1Q&oe=69DE3D61"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmwcVE6pzFwQ7kNvwH6cUyW&_nc_oc=AdqIruVgh6spAzjrH-oOfxi9SFykeixcIgHYL9qyZQcYYwu0cTcMrowOricwAQwb1tg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jlIcWkOEd8tAlVKSHZLGout3jD0eNQiaH-AdZ8XAtQA&oe=69DE4616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MbCLPoBSdIQ7kNvwF7Etf3&_nc_oc=AdrZ9ndNxFZERqMzG7nYhu7EuZEUuVWWoMg7Wg-vPro0N2r2t0BVfw0Wqzyyib0THNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jBk2L9Eb0YfON9FZopV-KtC-MjNEYFT7HILnuUMDiXg&oe=69DE3923"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
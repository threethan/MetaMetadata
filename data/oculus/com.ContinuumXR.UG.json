nc_sid=6e7a0a&_nc_ohc=Qnqm5T-KhI4Q7kNvwFrezCy&_nc_oc=AdolstrrN9jtOsRJ33e0khMuLsGoYDK4h_QDVarrtPeNAvy-o61ERaqojVqhT2We5M0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2K_ChroC81AsTcxAeTxfDAsxcL14na5LwmBvWXPVVlbA&oe=69F0CED6"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhPl58XAFEIQ7kNvwGWWdBc&_nc_oc=AdqhGJ6twogEuwJaZhJjWQvNZpTEKKTAUib8iwAxHPVbk6dDJ9ksOKlXlCgyucJhlX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2IsVJ69I-5-_N4wGj7oZiXQRT0t3JlRSQUEbheyCJZkA&oe=69F0B261"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmxLfeNRF3wQ7kNvwGpWxjL&_nc_oc=Adq8wm5EKBe0mexodk5MZVCxACnsMZjxK1R65s1ZtSFmI5wSZ60FyuCYafK3uFr8tFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11mJ4EJPdjMOlPb-MRCPQAjXewo-NDB_mgIq6NQVEbRg&oe=69F0BB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IfCKb-XhuMQ7kNvwHDWRsQ&_nc_oc=AdpFFjT-gZ6hdAc7tbwyQ7SdLZ8Hqbmj8EoW1szoUPDKCrkzTmBf-jRY0jVpX_tR9zA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2mDKDjYhL7rl4wrm3VrBTVWYicwTtTwk2NZJ7UQM6ibA&oe=69F0AE23"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "suppor
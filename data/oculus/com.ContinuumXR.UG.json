cdn.com/v/t64.5771-25/499292712_945272031189257_245705989701859346_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4pqXUYcxFcQ7kNvwEjEmZq&_nc_oc=AdrQR7G1Tj5jvheyYmayFudbtubQfYyWPJSlCRJRJsZCDTle1Edw57hNWS6nxF7Rf40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NdjW2GbVeFEFtGNimALdN6rTkXnYmqlEHQk2S7VsZug&oe=69D65E19"}, "display_name": "UG", "keywords": ["free", "social", "monke", "action", "multiplayer"], "long_description": "                                                                                                                                                                                                             \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "What UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25776185082074013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296037_1404859827470284_9068407491937449068_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz3R_PfqtHEQ7kNvwG5re2o&_nc_oc=AdpXhKhHtnB7VXHxiR45qMU9he-uNTSZCtBzNdcmaJ0jv-R9vzxImMPZBbDo17RWnxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LIbapv_ll7AOQdPl99JQSoFHeIO1fMe70xNuOA5QVzw&oe=69D65691"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "UG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1755280620, "lastRevision": {"nodes": [{"id": "8485526498233140", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "848552643489981
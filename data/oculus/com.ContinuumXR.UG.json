00_AfsEKvj0UydMqonJoW3cZU5GOCxMZOIs4d1ugWjKOjVXvQ&oe=69A2E242"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fT1u9GWrPsQ7kNvwEZvjnI&_nc_oc=AdmbNf7rNoXQeysWLYLygxHByWsSr3y0bWdzegh0odWnH8M92ndiUmYTMMuN1gYHyZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDBsx-nPfbu_VviCd2OuFlcP937y2o3Zzis8BJZnBBew&oe=69A2CE16"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKGa5EjJCK4Q7kNvwE2BMle&_nc_oc=Adm-BC9zoqivDGQfNaCxNVvIpqGujmLxJWMUlq-ZGcWybkd1zfTqwOa2FOcTDS8grao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPzKcpTM5EvwTMAgNBDsxDpSws_4ZLwDmcyij7KK2YZA&oe=69A2E9E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uasqjlaL12YQ7kNvwECke_G&_nc_oc=AdlZjYlxllziYAkp_xa1CtnyrUS0HxYfy7Z0XF7bGYGSOrltrNh19A7sRnxjh9JW40Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5d0Q6O8EA0rVD6GVILSJFz_PWXi28u4bLpQGlc0E8zQ&oe=69A2F296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_Meta_Banner_Crystal_MASTER.png", "id": "921641417038828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_921641420372161_4565932704307279249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr3_yrq3kEEQ7kNvwF4YS9m&_nc_oc=Admkkpqbsd5eVM1U886qY7qm2ITXei-NAwUdZ5DdS6GT9YptZ-9A8dx-dm_iIQDIDV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvn2FIV8d9mba7KoObXJ9wRH2Y2ZmD5n62HcqpE9ajvCA&oe=69A2F854"}, "display_name": "UG", "keywords": ["free", "social", "monke", "action", "multiplayer"], "long_description": "                                                                                                                                                                                                             \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "What UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_g
_Afujs3kL_A9eBdFP1CLMPJLiOfK27kSTDU3rbv6EUOZ1Zw&oe=69A03F42"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPkYKuIB4fwQ7kNvwEJeT00&_nc_oc=Adk0dCMJAzUhr7RfvWeUcxU1etCgW_LjWZKHp3BUwhoZ6IcjEhSGWx-T8tl7SlNEnF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8Rr0ij0-XyHz15WmNmCNgKLol5UkWLwZFjJj1ldyDzQ&oe=69A02B16"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns0C8vH8kp8Q7kNvwH1qPcC&_nc_oc=AdlUsykPC5Q2Ln9dj5jvnYv9Nt96rsSBXrdJYRwUOfv6CUSoI780soqamHzkfj33c0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftO456hoiEs7_WFGCOhp1ypjuc6za0qdwqkgHKIPqqugg&oe=69A046E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uasqjlaL12YQ7kNvwGtxGCs&_nc_oc=Adk2zawAS2p9kG_JtBkMxL8PgJCe8sNpmSjCwaYZ9GvDHUxw35Pf5LZ_CvHmfwWV7wU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJV0mkNzd9vQ4ume_n7S6H6nSV4oIVY7Df9lv4ur_t-Q&oe=69A04F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_Meta_Banner_Crystal_MASTER.png", "id": "921641417038828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307413_921641420372161_4565932704307279249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aS1dJYXDKoQ7kNvwHCSKog&_nc_oc=AdkrmE8bqVzPXNry4aOVl_rhGdWZA4leR83jL3CVhmD5YAinUCIV61qDs11QFLNuBMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxSDditFpna9eddWbD6NG2FqhoVewrKwVMdtYF8tnUjw&oe=69A05554"}, "display_name": "UG", "keywords": ["free", "social", "monke", "action", "multiplayer"], "long_description": "                                                                                                                                                                                                             \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "What UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gra
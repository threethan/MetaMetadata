4.5771-25/499619638_1087339933545674_5970238145573754642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ULoiDjZcu8Q7kNvwEyvbUt&_nc_oc=AdrJ6zeZgCBX7TPdtAWwPvH_nVurc8Y0l552meTByvfVcrOyPAi3YZRARARYx09opLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2iAVGjiXVCckldOrn4EPhOoysPBfraXQgh68G0o__3Ag&oe=69F0AAC2"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnqm5T-KhI4Q7kNvwFrezCy&_nc_oc=AdolstrrN9jtOsRJ33e0khMuLsGoYDK4h_QDVarrtPeNAvy-o61ERaqojVqhT2We5M0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2K_ChroC81AsTcxAeTxfDAsxcL14na5LwmBvWXPVVlbA&oe=69F0CED6"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhPl58XAFEIQ7kNvwGWWdBc&_nc_oc=AdqhGJ6twogEuwJaZhJjWQvNZpTEKKTAUib8iwAxHPVbk6dDJ9ksOKlXlCgyucJhlX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2IsVJ69I-5-_N4wGj7oZiXQRT0t3JlRSQUEbheyCJZkA&oe=69F0B261"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmxLfeNRF3wQ7kNvwGpWxjL&_nc_oc=Adq8wm5EKBe0mexodk5MZVCxACnsMZjxK1R65s1ZtSFmI5wSZ60FyuCYafK3uFr8tFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11mJ4EJPdjMOlPb-MRCPQAjXewo-NDB_mgIq6NQVEbRg&oe=69F0BB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_Meta_Banner_Skeledon_MASTER.png", "id": "1995607554400645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_1995607557733978_6944533597222087303_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDfKo7c7zwgQ7kNvwF5W2Ja&_nc_oc=Adrm3u1gYmAPMdMTEc_CHa3lfj_T2lX7I4r3pbZSfKRPzSv2y6-ExADz2n4aCBIBAX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2TeStNERrPc9Dc4xagWxbu3F8lc7Jcl_MCPSDuHWUU9g&oe=69F0BE45"}, "display_name": "UG", "keywords": ["free", "social", "monke", "action", "multiplayer"], "long_description": "                                                                                                                                                                                                             \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "What UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597
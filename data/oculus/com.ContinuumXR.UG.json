c_ss=8&oh=00_AfxjZD_Fdzje00k0ZNGk05pe0K2dol_RwIV6SFMxcn7b_Q&oe=69B7FA42"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr8XzFZiv7kQ7kNvwFUiGod&_nc_oc=AdldorxEQU0dqTQegYCLd-l1EczkO1AwRP0jCQ5n6efqwcXj72jcYk5w-EESGg9YP04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCTsLXNG2630oKEKalOX11z0ZkWQTSGDjeA6LTjSwAgA&oe=69B7E616"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jjuu-2XKZQQ7kNvwEvOUBA&_nc_oc=Adla_-s3k2v_0LSYTYEpYkvUidXyr_5Dm1vK6pHTotpU2uSkSf9cVp5ZYz98GENgINQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEn3jRxyEfqbd9xcaDTQ0dzoMx_U7ap4Q8uh2Q7_E1HQ&oe=69B801E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqgykt2acQUQ7kNvwH_TWe7&_nc_oc=Adke3XnCbTGRbp1CyUjYnh46vHYnx570LgGASxi22Zmiqqz4BQmd4ZsoElrwKS0LTxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMiTi9PNQuoJpxwJhTp3P4yJ-5guqG2G5uQa8PsmbhFg&oe=69B80A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr8smrBOYdMQ7kNvwEMrg2R&_nc_oc=AdmXirsrN-YzxUo53n2hdhYYvIPt_RAaHqTS4EiQe43Qh7v8laoKMqpXIqN1kzcfhxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgYWNsBNF652nhTDDStCLoOu-dudyf2qn_ZsTNfeQuIA&oe=69B7FDA3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
wEj3Aem&_nc_oc=Adq_FuAodwEpi4efzwe49us83hr0gCat4j0lKIc4O-jCLZJtvB7DYf-JPOLioLpeA2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lh1Z0jA2oDc_O5MHTygrdPRa0szooqbJfQaNSPjAnFQ&oe=6A43C0E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEluYoq2K6cQ7kNvwHglVVM&_nc_oc=Adr-UoPdZI5wAJuupqJdT6H3a2jah48rn-kZ-qWCZoEbxKoDJBlJ0zu54IHekzwhSns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96MIkDKt1X7D2KzVBN6BWV6SPYuiC9jJ0RNTj1tYa3Eg&oe=6A43C996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkmqnKpD9DwQ7kNvwHIJmGX&_nc_oc=AdqKlgHJaulxrdKbjVYBCWLDoPtu3y3_KMrApBBuHhCb6mkwRL7uBMEELlh0rNzB7MM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9phEfnX-SGksTXvWQpRLg-d5qtXZpTqSvnH5bl1rIcOA&oe=6A43BCA3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "24073572065668665"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "664100212615172"}]}, "baseline_offer": {"id": "664100212615172"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755280620, "status": "PUBLISHED", "id": "664100212615172"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
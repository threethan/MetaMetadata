QoG94pn9I3KfC8dg8eJwprpF7umU5mDY8u4NNh0HRXbcoIKt51CaFi4ca0pujk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CcQeHo41hdWXey4pO950rf7wvz2TavICGBa3abr9r9Q&oe=69EA1342"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWcdwRea8FcQ7kNvwGRlSLT&_nc_oc=AdrN3D7M7EHLdC8TD7yYwPNtBOEYQjDzqx-RrI7p17uMada3j6neLrWCkanrFIAf7sQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NV59iFCpYm3aUSeWY7-CPqWRFzIwAMCqNuXur2Msbog&oe=69EA3756"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHvwyS2C_tsQ7kNvwG2OEvx&_nc_oc=AdrVzAaeQ_P_dyOJJG3P2yAFtnR_8GqH4JIe73D9LiBoJfVHluybQCHBIkV7AIw7sQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-pSkBmM9WlS5xGvFVL8LoCfSRHoX3x-w3tXxQYZ3dyA&oe=69EA1AE1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qOENKj0KzQQ7kNvwFuBN8B&_nc_oc=Ador2cA5-D963k6Q3VvvSAxJjRPPT3dyTquKMi_Nb3JoZ_4OMWPj4S3LTW5vJn0Yvuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cTMjmlue1Yai1xf1Sv-m9vH6jtcb12Bw60tvyJ31Nxw&oe=69EA2396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Ix-z4_Fb0Q7kNvwG3iq_k&_nc_oc=AdpTT8BcG-p4lwxuCyzcoaiOtXB5-EFcJdDuH1NruagsrT59SzDKZfPguHFw8MZ6gUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N6yWB5KRTcfrVsfy7AdlaSim4EOQWUOwUqI5627N0ew&oe=69EA16A3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
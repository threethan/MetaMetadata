1029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkcUkxXAITQQ7kNvwEMqSyr&_nc_oc=AdrhX0mRu8FACr5YdPA8h29Sfn5s-ELnkv8Pm8CSx6FsmzxENgYvgLDqa1dozpgfiGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mR472F5wBj-IbcIFzGoduF2GBRA0OXjb61BCBWT9T6A&oe=6A049556"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj4ghNDXYU8Q7kNvwGxZzsr&_nc_oc=AdqBjtYhUR1c7SKyQynjxlB6nOIZANbV0GPCnBGGSvuaLDZCyAhpJOsVCMXEhFBj0l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fplBx1BOp_sqSpyeHQ_oQZ3-v31UTFLuKSC4yadaTXw&oe=6A0478E1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS7KrWmWlDQQ7kNvwGqFt5a&_nc_oc=Adp-hGPpHhT5lyqw0FgTAVGn3R5JyD3fKwnZd1MgoCBTU2SE4r9cMDxR4P0ML1x-tnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yQl0ERkLa_NgIVHMlEZmhpat53lygFiyHsEN_6dy6VQ&oe=6A048196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5buAlP23G40Q7kNvwHFYJon&_nc_oc=AdoD71q4IQl1EaNux8OJHrfssKbcip_OmXyTJCrUgA6DVE477WyJCzDQN53XtqtR9Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sbYtx9J0CE69etZm6Z-rtMUhf8iQU4mHbDF-oPl9TfQ&oe=6A0474A3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
c_ss=8&oh=00_AfzbfBaiWjcyFfHHoPS1wezhgb4-536DtO7CUfocIf73jg&oe=69BE91C2"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88BKLinL45cQ7kNvwHT8QQs&_nc_oc=Adnj9fs9x-rIrslen6niaZ9HDrV7oHnp08nABcUBlwt6ajytyBF5gXcDJ2f9nioFxhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-jfQUaPmBPmRU9C_TMROJaoveIQDax1Qznrb9KqChoQ&oe=69BE7D96"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMSHgMUFKhEQ7kNvwHjYSpq&_nc_oc=AdmXDmfP0kyy6ayen9nf-osOPvi2gcVn4cu77EMtyi5l_begrUShU2OrnYrjvsPTokE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNLWe0I3krTaytcKjQoOk0YTNqTZuI5rQxCl_62FsbTg&oe=69BE9961"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEp1A2_WNE0Q7kNvwGVYvn8&_nc_oc=Adlh6_P6J6zS-a53xuVBLCAzN6cOs07DBzUpyDfGnvxfe3PF2OO-hDehsUNvBcHXQ_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX-OJSKDaglLalgEDZXozLMjnR5otlyayYXQRzK6pbLQ&oe=69BEA216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r84A_6E4JxQQ7kNvwEcUlh_&_nc_oc=Adnlj4iQV34ciZOLoM15T2UYg0rH_EnUifimQTdDPftKqtAddw9ayVSuCAWcUnqrH7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE1HPeRaMnvNaPtqeIQeqbTHZv8pI_8BzR7cC-nJIcZw&oe=69BE9523"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
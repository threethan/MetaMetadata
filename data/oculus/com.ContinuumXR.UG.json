CgDgsa3r0f4NxgAyheoqrX1dUQuFbqsoInuwlULltZw2eqodKMOs7ZAo-V04Hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r1J13geb4JzVpB8fwBkpVFkf_tr25-_phcQLABigNaw&oe=69DF8742"}, {"file_name": "UG_screenshots_03.png", "id": "24087872754173737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_24087872767507069_805203801029632786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNvDn_8P0cgQ7kNvwFN9IrR&_nc_oc=AdoXe8A8EgQURMLMJz_5i6z9GRJkZljDr3lp_M7v3zlqAhxqz5qEL__9QEO7faDKLjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3praEO9gjxTdwIl5ZUAQUDZQDfCJpqHEtxq_PXoxXm2Q&oe=69DF7316"}, {"file_name": "UG_screenshots_01.png", "id": "1295710352099354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_1295710355432687_2720259447759890609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIqtoAjMJWUQ7kNvwHxfRN1&_nc_oc=AdoEd0muamHfHXnJJLWbbxWGtXhXeI8s68Dgsg548hmGJvDRqpdBfvNm8BVWMKTwJ9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XlG9hQq-z_UKRumBHrU1oon-S2B05EefbmltzH_LJtQ&oe=69DF8EE1"}, {"file_name": "UG_screenshots_05.png", "id": "704698199245823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_704698205912489_4901350441392553705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YFFyRqQSMEQ7kNvwH2nS6h&_nc_oc=AdoPypd9ZKZx0P62wBjcFPrpQ5GAWex2BHSqzdTnc8NHepV_yqsg_ruIOYoihBvTQm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iD_GWQ5TNVfcyLam2yIQqMa1Rgu7r_HMqWJHBb6K8BQ&oe=69DF9796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UG_screenshots_07b.png", "id": "1773532646571384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1773532649904717_34822168060613078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MbCLPoBSdIQ7kNvwHUy4_h&_nc_oc=AdrzbEYGA9k91ddXz1J2F8qOJgWcrINQN6VwzDBet_ua75R_re90XF-lZOKebgZlt-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19plNqjdOdwIMoeoa-ZFW0u0nv8JtzloxzJXGpR5Dx5A&oe=69DF8AA3"}, "display_name": "UG", "keywords": [], "long_description": "...                                                                                                                                                                                                                  \n{1683283132386209}\n\n\n**Raise Dino**\n\nHatch egg. Cute and small. Name dino, maybe GRUG, maybe dumb name. Dino spin, follow, roll over. Feed dino. Chicken? Pig? Friend? Dino big now. Ride dino. You control. \n\n{802769962423593}\n\n**Fight Big Boss**\n\nClimb volcano. Explore cave. Big treasure! Maybe danger? No scared. Brave! Fight with friend. Push friend off cliff. Laugh? \n\n\n**Play with Friend**\n\nNo dino? Ride on friend dino! Want fight friend? Bring weapon. Want fight all friends? Bring big weapon. \n\n{1100334291498447}\n\n**Wear New Loincloth**\n\nOld loincloth ugly. New loincloth pretty. UG sexy now? Find other new clothes, change how UG look. \n\n**More Content**\n\nNew update many time. New fun. New dino. New better. New bug? UG proud of bug. UG proud of UG. \nJoin tribe discord.gg/ugvr.", "short_description": "*EARLY ACCESS* You cannot play this game outside of scheduled playtests. \nWant play UG? Sign up in discord.gg/ugvr. Only if brave. \n\nWhat UG? Hatch dino. Feed, raise, love. Ride dino, with friend, with no friend. Fight big boss. Scream. Trick friend, friend die. Cry. \nRemember, game early stage. More update come. Fun. Make you laugh. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ug-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ug-vr.com/terms-of-service", "publisher_name": "Continuum VR Studios", "support_website_url": "http://discord.gg/ugvr", "website_url": "https://www.ug-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id"
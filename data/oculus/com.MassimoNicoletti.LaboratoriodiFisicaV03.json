hc=HlXnPXcd0qYQ7kNvwFvMZfT&_nc_oc=Adpq2dqdThFgwKaJ0hK0nxTY7rcGe_H7d2Q4FYvfpEU_LAi3WnOlUdSQ7j4gdBtM-WE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbp0ONsft7_TghNxXTbVOieCuTg2EO44-q2NzY_pqscA&oe=6AFB3DF7"}, {"file_name": "screen2Ripulita.png", "id": "2174423813383786", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_2174423816717119_3243753802393826354_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQj-XXA5Pl0Q7kNvwHoyHZT&_nc_oc=AdrBwigH5BNSdTpo7mdEbHJmI69JNVqc7kEAVIIzPJwPPYYzdf0vj-uAxOSlixmcTzs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS2kmnjWLCGZer64cFxuw-yoBZIcE6KDn8eMelQzTS-g&oe=6AFB2702"}, {"file_name": "screen3Ripulita.png", "id": "1151893696898119", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_1151893700231452_8733621428597343598_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZL19F0Yqp4Q7kNvwGUYBpF&_nc_oc=AdquV0DH1EdYNBbXzLmxI0zeT1OkrkpIrz5dyG1dc4zehVU0CAU5o8L66GPpoBRzQis&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIoCaLIiwaZsPn8aRw8w4N4bG0B-v_U5ereTDqVxlyDw&oe=6AFB2DA0"}, {"file_name": "screen5Rifatta.png", "id": "25671085852590189", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820855_25671085879256853_1807598339443831316_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROQUWCrH3YkQ7kNvwGpbdF1&_nc_oc=Adp9pHxL6G5a9TEsO_2mY_EC0_ccf_cf4CXD6nLM7eDYYq7kK00k6pH4RrgnxJlu_A0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn7qQQtawsZWR3fepGiaQZmsLNiWpeiO9502Uf8vH6cw&oe=6AFB2551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "798016029997346", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818849_798016036664012_3077633648981422855_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAw_hEejVfkQ7kNvwGEGhdN&_nc_oc=AdoHwG9VsrdZQH-hRH6_xa6s675rVVY2jrBR-2_2avadgzywPSAEuHAaQPzofg7LMfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1T3FC-EH6k3r3a_orh8YHyBBYereMh3YsZGjLS6h4dA&oe=6AFB3DE5"}, "display_name": "Physics Laboratory", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 and 3 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}, {"images": {"nodes": []}, "id": "892891660041536", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laboratorio di Fisica", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2 e 3.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
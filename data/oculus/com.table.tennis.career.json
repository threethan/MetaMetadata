n.com/v/t64.5771-25/499622188_1123281080567506_6097964415713960048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPf6YMjzvhkQ7kNvwEk6eiS&_nc_oc=AdqPY0ZAlvfkPfBrILDVDykm6lm7t87xUklYLVkKvgmV2wFydIwKy0hNv-_CCzecuRs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDh7URFDJlJrTjdIjtS2gfkhf2HDx5rAl8AXxwF9V7VQ&oe=6AF9C9A7"}, {"file_name": "01_MatchPointSmash.png", "id": "1093480353471659", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619369_1093480356804992_8907662635968293342_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpa2YNO8QPoQ7kNvwHWtjH0&_nc_oc=AdpGZr6Pu7yYzKHn_t-rNL5v4Yo8Q71zFZ3h2iHPfHV2NCvfO6hFxa-YuwMfBTkqb3Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvu5QZ1zPOIkJA3g__N6p-zlxQ_o0M9ZVod3vBxwYlug&oe=6AF9CA14"}, {"file_name": "02_IncomingLoop.png", "id": "1834931311043300", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619382_1834931314376633_2450380928669653784_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3r-5ncBLDcQ7kNvwEHvQmY&_nc_oc=Adr3py5AvjnibzJ9AWW2BvA5BOL6jieKcK4wgb4I1k0Ee-L0in3Y95hgbqBNOT6W43g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV4mwnAJ1PHWAyD047N_AQdXUy9-FVFNv3pG0xvKVMQA&oe=6AF9DF73"}, {"file_name": "03_BroadcastRally.png", "id": "4665945053652453", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624592_4665945056985786_4250118240276418927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oOTcPUR7VwQ7kNvwEjMoN1&_nc_oc=Adrzrj2Wy1fuE40L9VYTcJuyalbmV-aoP9mg8SCFPB9MCkUhCZUNYOcP6hxrdo6gfoU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTGh-c_D-ilLKRIyrGtS7I_pppuuYZcApzbFhncr_PDA&oe=6AF9DAFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Table Tennis Career", "keywords": ["tabletennis", "pingpong", "simulator", "physics", "practice"], "long_description": "Play table tennis in a realistic VR ping pong simulator. Every serve, loop, chop and smash responds to your swing and spin.\n\nREALISTIC PHYSICS\nThe ball runs at 1,000 simulation steps per second, modelling gravity, air drag and spin. Topspin kicks forward, backspin checks the bounce and side spin curves shots.\n\nCLIMB THE CAREER\nBeat AI opponents, earn rewards and climb 12 leagues to face the King. Choose Beginner, Intermediate or Pro across 13 arenas.\n\n5 GAME MODES\nPlay Quick Match, complete 11 training drills, test your aim in Lucky Shot, or practice in Free Practice with an adjustable ball machine, speed/RPM readouts and slow motion.\n\nCOLLECT AND UPGRADE\nCollect 9 blades, 9 rubbers and 17 balls. Upgrades change speed, sweet spot and spin; open prize pods to earn rewards.\n\nPLAY YOUR WAY\nPlay seated or standing, switch to left-handed mode, calibrate your grip and choose snap or smooth turning. Fully offline, with no ads, in-app purchases or paywalls. All rewards are earned in-game.", "short_description": "Play realistic VR table tennis and ping pong, master topspin, backspin and side spin, and climb 12 career leagues against AI rivals. Train with 11 drills or a custom ball machine, upgrade paddles and rubbers, and unlock 13 arenas. Fully offline, with no ads or in-app purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
20f&oh=00_AQGkrhqs184im2yAJ2UHf6PM8xS02pIYAUqpAElyCQ6fFQ&oe=6A79D77D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C29Iicjex9gQ7kNvwGtrc6H&_nc_oc=Adr9gA-1mEUTINtfQ0OtT4cRCedyuoyhSpK0OGwfy-gdQ2u5iMDgxq5GG5SV-eNKG8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtP6T_cfl4_pNA4GgkWKWPZFNLcZTrcJLL3O9i_x4zRw&oe=6A79E6D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6I_lyF0dnUQ7kNvwGhiUTj&_nc_oc=AdqsI3LRdglWiJ8SZ7cS8hoGoFeDcoD2CX1c0XxG20tgHpSm00tQAB_4YxV6JSX4xSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4BzWUlWDuT6DtIAUmrHrmbOkkF3OxBXHYresR-RfhKg&oe=6A79D1D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJboYMXBwkcQ7kNvwGyI1ce&_nc_oc=AdrXQTUkJ8c7zc99sKC5WrapEBxA1wRLyoDTUNroCkOOb5wx3Yaq7xpGZIOd7Lb5taU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG00jaVhtNs-anqdPGmPXx4wcSifA6AkilaZ09Q2ohvuQ&oe=6A79D875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mm6DeQGa6gQ7kNvwG9C9Cb&_nc_oc=AdphyztBR1arjBb2DiFsCprqxS394wcohcBCz1jvlwdJBoQ3vuG5KKnvWJHqgN1tKFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3IFAFcFiR9jkWfq2dGAwfPspX_LDrLYjz-s6-Tb0hLA&oe=6A79B92A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcWO_Y9TlsAQ7kNvwEBv3sK&_nc_oc=Adrpz2oh2dMNkbx-XgYqdBwe5TlQpV0R5_-Ulvp8l7BeM1muLFMyrGzoEATjmNpgr8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQXzJg2CMjWGnoY5RIg8sj8pP9CQ_c2sTr8cQaaFvMLA&oe=6A79D6C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PGYT90A0UEQ7kNvwE6yP1d&_nc_oc=AdpOrM7SfoKCVN0V_k5_0ymEqj8BmUfenTabaGJhzjl7eCSrB4hXiGwHkkmR
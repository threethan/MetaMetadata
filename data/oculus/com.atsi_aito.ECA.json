20f&oh=00_Af2Pd9NXlN_6Zp3ZiGav_vib9IhAKmHieqgWg4X-zrKsOw&oe=69F35E7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNwhTcrXxtwQ7kNvwHcgsws&_nc_oc=Adpc5LJpbRgeNzAw7rDTAifYDM_nZZGnxgWtNhleEJDdo4RxPVoHpQP0sdFge67x6r0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2x2EsNIk7vxwQ2jgams3gbbm8ALplf05ZBjoTmOCY2pw&oe=69F36DD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HVT-ElG6zMQ7kNvwFAesHK&_nc_oc=AdqvpL57Ygi0K-j6W1pJGtgBScJmGFQxgdZ653mQJu8A8mywXt43ucPi9IxiNboPfuk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Nkf-b8Io8YeIeXe0QZgnljOtdj1gDhF3LSSWVYENQ9g&oe=69F358D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myg1G1lZaFcQ7kNvwF_t3_r&_nc_oc=AdpGi4cziYbcwy6pYpWRKH7JQwDo2MrnXADgini3EykWcGv4mawdX8WZcxAxdob_6ZE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ua5mvoBeIgud4UcwyLTwB4d4xzzBZPc_xoPdcNuonuA&oe=69F35F75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YleIkQpJjDcQ7kNvwE63z-z&_nc_oc=AdqjMKMtL4QQhfpNBu7FYBD96-1ApSXsBr1zA42K0t4YrWFs-EsQed1kdAnfDmcQDSI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0phl8K4CxslQPzk7p8AxAKAEEBb-0eY0CKHue2No2FNA&oe=69F3402A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXQatVaG__wQ7kNvwEl4_2D&_nc_oc=AdqU2hbczAMP5_eY7qNTP9UXDZD_d7GnhezaNoWnTvaGELOCUj9ZTYEOI5tf2CDd5Ms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IwgrKmSVeY2ypQkkIurtepMj818e8OOlPP1lO2aSh7w&oe=69F35DC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYSen9J3L_0Q7kNvwE0dIBN&_nc_oc=AdoFfloTe4o_6HfHlo37MBmMmy0nVuWH62Ai_Xm0E0i7p-GydaRW6fqnvKdr
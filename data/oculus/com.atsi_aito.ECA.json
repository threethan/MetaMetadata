20f&oh=00_Af93RiDX4iJ-w-pERgApilGdCT9P0re8ALS0OiwtA-CEnw&oe=6A47BE7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z2FpUN4nrcQ7kNvwE4m5GA&_nc_oc=AdrpVxHu-EpDxYaW_Ksv-2E5x9gZSUD_E-v7K5dTj-NIU9UFm9QAjfqPVWETSkrVvM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZGndckBt64OWJhhduy5HJgncgcsfQe0Fr26JyAHqb6A&oe=6A47CDD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuGbFBX-k6kQ7kNvwHtqkN2&_nc_oc=AdpNYWt3JsZ8haU16f2k8kmw9cpht2E4GizaU9luIxFNFRe1bU2Y2xJGtJWnMqqBw-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Uw98fcUY7H0dLH8QN9iBf1-EDjsN8eCw03xHz50XD_w&oe=6A47B8D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6YdO7OOz0IQ7kNvwGZQFFP&_nc_oc=AdpJlKUI1xVbmi94LukwHSW7NReXRuksjwhC31vBBdGUU6RUbk6RvqytK20DK6lhfKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--BH1ggOxEsiPzgCYb6mfN9QLJ5OpRrO0MWH3SHRuhKQ&oe=6A47BF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgTCsz0mxcUQ7kNvwHcaNOW&_nc_oc=AdohgnpVENb5PhZe94aWANlES42OcF3_X_-y_0So7faxlhZ0296ke-LC650pU2ncMLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IpGxmW7xEpg9kf_rmCODkztoU1O0ZRIXzc263SHhR8A&oe=6A47D86A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpFaTG2fStwQ7kNvwE-gORT&_nc_oc=AdpmjHoaIvBufPEe-Tqchs5pJsTvtyga9ykB3q6EvFez3K28XMj5f3apGN5AFKNRg-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RmF61BoXcaZlAdz04jvT0wThvRGmm5pxRIVNHEhrz6g&oe=6A47BDC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwvUExwqaSQQ7kNvwFJ0x6b&_nc_oc=Adr3Y_RTckm9wF9AglVssjN8w0tdIktAf_kUNlCRm83mQiVf1Y0isWExAWLH
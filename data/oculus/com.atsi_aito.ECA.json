20f&oh=00_AQMgd3rNDsjM0dm5NhZ_YiY2s2ZwhLZfSoNdz52pyVID7w&oe=6ACF88FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMmNTIAZEQ8Q7kNvwHwr80W&_nc_oc=AdrqDVsIoogUs4YnSYR3nDjBbIpEYd2s6S6oYhFfmTgC-BGoGk9ea2fAhtrcBli-F3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_3R-nLTDnNLZxnYio_MscauDbUcHAwPmZo7t8HQApBA&oe=6ACF9856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99-GGuShOocQ7kNvwFNLbWN&_nc_oc=AdrW_DsiRYyfwsb24D1uJavZyoPCupMe447o1dY6r1yNJSxPxsGs2AfGlX2UOxDqcUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSdQ5Bd6Kyun23krS_lJSzm9DJ-dBQ5JZPJEMRRKUAgg&oe=6ACF8352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOz-I7F4y3QQ7kNvwEN6Psl&_nc_oc=Adqe4KrWr9hrsksHNwM3mKysM8aS6kXDVrxIe3rFY4-cGPd4Vxh9L17Sp1WRP0f5ugU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAO1D6s42Mr6hDDzaKRivDLAG4fQPSJxSLT7cDDaW-SA&oe=6ACF89F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNwPWv16wA0Q7kNvwGZKa55&_nc_oc=AdpYT00WcHlF1yvxuSlqah-C5h2PlUf8oV9fn0Pn6NLWFeCHGDd9WolDy6KYle5LeCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQCh92NGJNhLTfHz5LjjrJsz8zJlZOSbPk-AOHZ11GnQ&oe=6ACFA2EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIde0CZ3CN4Q7kNvwHYNy5v&_nc_oc=AdqD8voBV8hbzIfnpZHjiDQvATCrBwCQOqUw57kQUc2a7IH_yaaKYpzS3GBaHfPHaDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY-1gKM9Hcl9os_KYVE76aS7b7V7kwBJXptGnAO3uoZw&oe=6ACF8847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBJkpBoeawAQ7kNvwF2_50R&_nc_oc=Adr9nAB_HfXQKPS8KFynD5jaMHqlw_zZG5n2JjNzoc8Df_DkTG5lEAW7OEqU
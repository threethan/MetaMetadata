20f&oh=00_Af7xPT-3bZRqZH_L08bwoupVQI1ShcNZyi_y21Xe6Unaiw&oe=6A0481FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdTbhg_Pt6kQ7kNvwGB4Dst&_nc_oc=Adr4RrsQN4GiWTxOaFEYXVyt69PfHMxTw8BfV8g1stPZN8A2Xycj3O0ob4Q1j_r83sQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hSLtoddyacy5ywHkDsm2aadVmwNk_3USOEU6EgS8Zfw&oe=6A049156"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnoG-pqZxQQ7kNvwF91kHw&_nc_oc=AdpIUB617yFgklATpuZ-XM6KMllsA23f_doEo7IjRx8Pve9C1enIjYjB5C8wrvi5fEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PVWTldGg1QgyWEXULCqldlh4oPW_-Vx2qpyqXfXWXYw&oe=6A047C52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JmO8m-NdZEQ7kNvwHFlS5P&_nc_oc=AdrNSwA3m_6a2PzCrFW87yxHiDXUhDMRA814QyRthGD8E1pr4huVqi_Ok6hgP4IB0GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rGUD0R6i1uQnHS7RvQdhSaAjSUXzXkduA9BMUISFqZw&oe=6A0482F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxKBjvaSY0cQ7kNvwEq5nZQ&_nc_oc=AdpGkAgFgPY1kznxW0Z4T2QXNL35ccb1NgLMlouY6MFbd78ziytprvsaP9iMOkngGto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GUYW3A2GH7tJZnuXtMctzUI7yPBg1MtPUxIukuDswwQ&oe=6A0463AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UadtzjMuMSEQ7kNvwFAiPNi&_nc_oc=AdpKPdDIC1rBP0HIrb1EvxTA2_Y85i8X1QcM5_bmZxgnaFpol6QIc-QvEbcYhixkzKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zU9lE-_dgxYfsqTrNTvHMDVuN8-FgR0Y5DvdScHO3Tg&oe=6A048147"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYJnfQMRXuoQ7kNvwEkR_gm&_nc_oc=Adr9HJTK7m6UvvjpEd0X092RZcu7oyBv560yPzpgtZuAGREylSwHyK_S8Bt1
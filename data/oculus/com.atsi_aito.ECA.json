20f&oh=00_Af244mVVe6Q4_yX-GJzitRa-8_962CHklRrMUSuqaen3pA&oe=69EF69FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1ui8vfF3wYQ7kNvwHZT6lm&_nc_oc=AdrBC2orlHk7nH5FwCtNq2NdR0gFXFJonBxx6Al5rhGEOb4pN1e81haF-HIq5YM31-o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Bv2pOc9yLqLr7MViIrhKX8Hhxef-xOmCLa3Y1Jmon3g&oe=69EF7956"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O_tEe_zbGkQ7kNvwFljWIi&_nc_oc=AdotVETXbKgYfHmiGWrb7uxwpPYJJGm5FVCU4p6ggAYe9JYyJblCnv1SungYMkSEaOM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CPPlD3YQNBElUfLnz2A7aDymeVu76IklJ53yG-EWvJQ&oe=69EF6452"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmv2CaMSkNkQ7kNvwFGjX5h&_nc_oc=AdqEwdvlW9FRGhaXxG3HfVStKqa9teO6bIPzWSTeDkq0yXSgEs0iAlBbfss44VAyKso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yozyRP3jZ9ni9n7VkDC5huPn0Iu8jcbooqYvGqGyn8A&oe=69EF6AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYJgokbbDaUQ7kNvwEMRUGR&_nc_oc=Adr-epiOmC2vteGmwjyzeVtMm7XTkKcgp9G-mhBYLvJxsuiGiul3hULytxFblnUuqAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33BYmlqyRlL0X25kPC6RL1xqhiALsNbeZWfpn6xKcARw&oe=69EF4BAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPpyE6Q1ldkQ7kNvwGro-_N&_nc_oc=Adph7azJc_OIuiz3LFS0TgbganV4A5sY98mcnQDEQjv_Kim14tPEyUIo9Ijiq11OAGE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3s8S5THIh3HXP27jbwwZEXauKw9EjoBbJm9rUCk6Ww5w&oe=69EF6947"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TRel61oLc4Q7kNvwHyeNYg&_nc_oc=AdpPFSupzLuBCx9FpiPm2GejgvE-0azBLTQmkg5mWs120qzRag13U8LWFnXH
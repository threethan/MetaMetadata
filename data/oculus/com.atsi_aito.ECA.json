20f&oh=00_Af9t_Qn2lI4zWmzODA5zK4J8WjbLWPFCIZVDgfCwh2eaXA&oe=6A25777D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcZVOWIQ8z0Q7kNvwECWFB7&_nc_oc=AdqxRN5Q_k9By5raVBu_wXAIUVpngDCOLNvDS7pNxfWVMh2_1sNFDqPbDTozjBXjIKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--x5dzRE2HlHM4W_B9-5sWpZD3lVVzGBosX38uE8scuA&oe=6A2586D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzNzc9Di-4YQ7kNvwE1zS5o&_nc_oc=AdpRGJeluPvF5gSDU0C0XcFkCfzFuekYgZzgR6D6Ng1jTvc9iH_oc77l3r1aLftMAvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ju1Ug8auUpbkWr_DrYEWLKcUpd4DJMm0Yl3m0ytXC6g&oe=6A2571D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4RMdipCKoEQ7kNvwHXvIL2&_nc_oc=AdpK5j_T--VvDb8MMQYPNShTzbYHrculvpHizipKyquvxv-7IWMb1pRdwttzov6UdyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LkL4cX__zDnvykTZz0VvHlxmrFsAlKf-6HjGGXscKzA&oe=6A257875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3njBRElLHsQ7kNvwHN4cqC&_nc_oc=AdrXZqGIdsvIqRBf0EfDY9V002nuqDmVYs-rZn30uaSYr2G2G0mEMjV_aqxuUcFArjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oLx90slVs0yNO6S1UalJCa6GuXTmXP_WXieYcmULM6A&oe=6A25916A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhkQa5HmUNcQ7kNvwGdlyh5&_nc_oc=Adq3GZ0nFqEhOYMgO55sZxHTFqU07RVhWjLJFzbCWuybWUwbBAe9ZRfPwPbdOSPWQM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IbohRLSTelbipX46uN4o-oyHbGfcWo-6fkqSmesOy9g&oe=6A2576C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg03QoBbeq0Q7kNvwEeY8UB&_nc_oc=AdrDVtoB8Uot45G7fzxM88OCg8elWr_2AJu7B-wwO-xWk-HLyh9p63uJAKs6
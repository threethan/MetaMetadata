20f&oh=00_AQFmEpN0Dc8uGTdCVmjRU3Jykll5Q39k7T13WGQpf_MfHQ&oe=6A74917D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56C7t01sYvkQ7kNvwEF1LII&_nc_oc=AdqN1rgZ6SnvMFr3LTrLdAqjmlUo8whTG4_5TQp49mqbEGGH7XmoNnDry1AuAC0nZVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE1ViQmdwEk5hUSu6zc3mnL0BZBF3xc6eAbFNhovodzA&oe=6A74A0D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtNl4uihfjsQ7kNvwFlbuCh&_nc_oc=AdoIw0hJnwV1nMmL7Hl4IiDZuPY89DN-w_jfoUf0GssEYYP7HPlfuEJ1iK2Qv-dI88w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgtZg-9k5Csjhnh5CXMvROzH3x3MUhSGEDq669xGv5jQ&oe=6A748BD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C39lgebTeAQ7kNvwHhM97U&_nc_oc=Adqubc9d5F4aoHEpUryuHI48cPdyqX_bPNc9Rd8E8PtwubImuUunQhAtTvpUgksf_tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbPZ_m5zRh8tfxpEFS7y6NiMajAZEsZc04MyKpMU1SEQ&oe=6A749275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbL-ZxjVyaIQ7kNvwGycq6o&_nc_oc=AdqeZpCmQtoRhSmGojK1Jg21Nxgq1hjvuvsM20-6jms4907jEcMGTYhvhiydZSTQqIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0XpJ8pCRV7eJBxRT4k-fl4tF9VNpGG_r0y8OrYcHvWg&oe=6A74732A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkLiUPfCojMQ7kNvwFDGZqV&_nc_oc=AdoMTIOC6joUs79FqWqI16AOM3of-JAeIRSnKNbh00W6jduYthaLg2uL-X2MXPHuy8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcc7iAoe1XmActyD24iA4n544ijV58C0bz7GW3jzX2sQ&oe=6A7490C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnGBtuLRFRkQ7kNvwFpnYY0&_nc_oc=AdoIh7s96Bv74iSoUuIgZoXlcS_kpY0gge6r0UnMvXLCEqSe0pxht8db6gDW
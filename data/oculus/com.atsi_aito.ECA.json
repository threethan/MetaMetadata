20f&oh=00_AQJ1rCEwpfOKbQaL1ag4fd0F0Rst5iDt1EdFjFh1aexm8g&oe=6ABD13FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt92Q_lUSiMQ7kNvwGRCGWu&_nc_oc=AdrouBg22T-eoJQyDdrQdTRZxjXCKyqKbRsWUK7kYYtlDD4b51UOV6XfNb8oDHr40lE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq6H4zbnSoI_F3f1qEGuh5CVs3uGXDOBrBcyS3yBux8A&oe=6ABD2356"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHLYaNUXtcoQ7kNvwEyLuSU&_nc_oc=AdqWvvoudqaE0_fKgPmWi94qk11CwojbgdbQawah9HtE9udB3RB62Q0eehFuUcREGq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKevB38RvwUHZoOBf5e5PpBrH2Z6uIVIGFQjz3WcrH4xg&oe=6ABD0E52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmCrJEJiju0Q7kNvwEHevkK&_nc_oc=AdrMnKg6ss1O3wihJpuG6u3HnRq3wwMxJaxlTao6xBXRO5wskBnXQJWt3y7lwj6rrGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdq6ZX4a9JEEUM9bEHk8BC3wf-dKiBBOWCNoUxqx9weQ&oe=6ABD14F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zlao1fPU08Q7kNvwF2owGr&_nc_oc=AdqHD7RdsuKqK2n9GWdu7UwIe3AkPQ-Ym5Fwm6av-uFMTyemN_jg8rVa2Dq7udbMzc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL48nZH_RV85H4WbvkOOugfF70erRs_rV-Uvm3DBvoMA&oe=6ABD2DEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bXCkCCJxp4Q7kNvwGSmmx4&_nc_oc=AdrdyvD17gyiAXhw8IDDMvnh-NMFbHImpZ5vIsD58A0DFqa3aVI2VwhVKTlqAGO6rDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJETaBTGlAPW12oo8VnTXjiUD4drdgHi_fPKPF0oCbaog&oe=6ABD1347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnJ68Cz3lisQ7kNvwHTPJVQ&_nc_oc=Adp3UvTmPeOvea_nbWsA6IHmUzvWlef4_LIipFNuF0XuMqXOSnFz9kFVBro_
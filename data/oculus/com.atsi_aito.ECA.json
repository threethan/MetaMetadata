20f&oh=00_AQFp-9o-_92juCGbk_5ajqvuB-pzs73-FzTmjsK2qyoI7g&oe=6A86CE3D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIeYJLhCXFkQ7kNvwH-as-B&_nc_oc=Adrlsi8YZiOQFqG8XIIYb-ZVtoV8wYHJZePcbege1QZTx-N8u02dlNjjqYDIPS_mWxM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP7ry25MVTIkh7OQUabzykDAu-HGf-1q13VKC5WhKhBw&oe=6A86DD96"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRsYNX7tVcoQ7kNvwEZdNzp&_nc_oc=AdpGQZ0aoOfOQYus8ZqP_zN3JNbtGlKRb5v_fnWSHTNucf0I7g9pg0cVkvgS305tPBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpmirlCee6IxIq5HIbbfSglYhSyABzQtkZseQMCtNAcw&oe=6A8700D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHg1v8yqeFAQ7kNvwFTQllG&_nc_oc=Adpyviqmk-DqX3LXxdqhAIGdkDwNOBYqCmRZxDXVfHUuJHFv09gu4prBknYdB3Nlps4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP1BXhW1NUvXNkYvOhX1jUqhCV0gXIlIA6niSu6IRmTQ&oe=6A86CF35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHzVMLYQgJUQ7kNvwEy93Gw&_nc_oc=AdqBMWXgmkM2vf_1Hr521ExZSbWLCFTjvloHJ7T_ovprZeM3_-DyvdAY0dzNgKABqpM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYykY7Qq7yYPynCvc3kS_Sylj4Bra-ENAdPF5xZ3Z-BA&oe=6A86E82A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAFKD8Z12KUQ7kNvwHGORVw&_nc_oc=AdrOxZu1BnujWiEHUi0Cs5OZReFlgIalQA8GAm31ZVP3jcQMV63Ap7g6Sc2SvY7DgNc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFawE7D-hNUXWJWdX3MwdiNZYI4IqMlEgmGnRfCDrvndA&oe=6A86CD87"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wgrNYHCBBYQ7kNvwFsL3Of&_nc_oc=AdqjjRNO5_NZoH9idht4FnRjsOgd0vpFdtRUYq19taB3toGk9BKAJDYB6t74
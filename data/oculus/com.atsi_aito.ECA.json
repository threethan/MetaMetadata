CzzYtWatpK0wafHaso9rvqcQ&oe=69BBFF7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvfLROI77jgQ7kNvwHlVRny&_nc_oc=Adlxw8I6mKzMZ94myRMbR4BCdbd4BurS8S5KyNnt8ErK5vz8bEe3sVv-rIjUVHg5Nqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqO6CV10ZxqTFkPQRao0NCsOMQkiP0JGTkrKmSswiLPw&oe=69BC0ED6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNSlg_aIq8Q7kNvwGW9L7V&_nc_oc=AdkANgKBfqWgcEOn5tgjM-pmjmVLXHMqLCAMUrV951vpVY3J6y-QSmZl644uuwaneEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzypd52CNSGivNqgcZWSuA2Ca9bKhG6DCftP_Ps4qsyFg&oe=69BBF9D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IfGwyqwTx4Q7kNvwGgbkiw&_nc_oc=AdlLIB8L-tdjmfxGiX0tIF2ybLMewBpjrfJYrdY4OGapbJ0hoWta3U9D5FnUXfZMx28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE-7T68VMmJ4Q5-_ggwhYxdjY_E5kQJZ_krEWFUTYvkA&oe=69BC0075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ag8y-B5JkQ7kNvwGnhDAq&_nc_oc=Adn41LgfCwVGOmN8ry6PoBRJc2QsoNkUD4A7aXUnOzYu4Lc3kQCaPGAUfsRAnMI7DVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSBn9hbFeyuhtPtRfpZzP3bmctVabdzDoqipT0Vte-vA&oe=69BBE12A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG6yC_uJ2CYQ7kNvwFB9AVZ&_nc_oc=Adk93A3V64dgyn2HLmsG1VsPHZcpmbrf9e1Ra3sN5hM7fpqlTG9aq4jPf036Z1ZvBBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzq3a0BeZO1aZzgiJTPWKLvOQ1Bd2PpIrcoaiYEc4QkIw&oe=69BBFEC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6Na8THXDAYQ7kNvwHHnV3-&_nc_oc=AdmpzsiLeiqH41A0p9IQ0-nvhGqOPLFnSRClSh-mSCJZHsH4RaxfRocq8Top3VIDX-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.co
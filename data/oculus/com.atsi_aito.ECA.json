20f&oh=00_Af7M9B3D0-6Bjkful629dVkVBkmVBbTMv7tmuhvTMz4g2Q&oe=6A008D7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRgG8h7_a3wQ7kNvwEeqVjv&_nc_oc=Adrt1JyYcbjbbfK7JIr_Xbgz2Qe85j9MxVN3wptQ6Zp8vVJ30s3HQg6VMFEmwGiA3LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kPmzIdDZVHy1LXA2Mygvw6eb9teXgiHnENo7CqFaTUw&oe=6A009CD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odoxJjyOMAQ7kNvwFJ3W5p&_nc_oc=AdrIevkyy-BINhTpJKlHZ5-YBl0P1deOQYZY1HO-li152C3vSkJcz8m1CSJ8cxEMCIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nCdyXaoBZHCegGqGzWTcog-rUA__onAmPhIpaLV5f_w&oe=6A0087D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4TmODKO-gQ7kNvwEJGc6C&_nc_oc=AdrvOMWZFRcbyDLCB8F0Cc5Yiou9uvPEn6F8_QMzYWpTxLHz7pLQeWzOefLrDxCPN_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GTanbTmf2slvvx1o6yA3shxJ0L5nul4qVzopjX09-9w&oe=6A008E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LEe-GAcz6YQ7kNvwHghtxB&_nc_oc=AdqIH5eBcp8ketJT4U0aQl-3oYDTfLVhqa9yxxDaN60fvW2CdBd-8ewL8DWLGhAexzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rexStMj7jK9OdyR-TewGauLs_12dSiFOBb0ZMpmlcUw&oe=6A00A76A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwgD7cp9caMQ7kNvwEPxKn-&_nc_oc=AdqC-7ievogNEFoo5pJ0xfI5RUEcgQMoAvU83eMxTTev-qzUOugUzSY2NxAcnVv13Q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VHqZkK1dGAn_iK1D33y_OwxJ_hPEbJdNaV0K8LLF4Ng&oe=6A008CC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vynyasC9xDoQ7kNvwHt5w62&_nc_oc=AdqVss7OVMkm3rimJwXc_TbP8yv3GMWp_lCXECPTnOE1dIAQyp9RsB9PlPRB
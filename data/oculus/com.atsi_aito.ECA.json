20f&oh=00_AQK0RScdOMl7z5DtZ6kXMTFC_zU0pZTCKGCsgc0ESjmVtg&oe=6AB287FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TajwIe4OpsQ7kNvwH5nLtr&_nc_oc=AdomBRPNW_hnN1nmjEBv6AtWCyZdDNDIMC_cP4YFVsCgomFqXONthbLenpObYRsIl_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmePUiMbpFHYplTz0wyaybKFBccSPCpJNi8JbTTKwJQg&oe=6AB29756"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7WIwNKFfOUQ7kNvwHJ2CSJ&_nc_oc=AdqZMpDn2jpTzNqWBn-katiimw1-UXhnEl2Vobt13U4qzhfnQkB0pbftotTJ3YVbOZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbkmSb6VB7KdO_F7JkZiVMT4ERCBgKxi82QK7ObaiBRg&oe=6AB28252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ7VOpsLpkoQ7kNvwGYrWFH&_nc_oc=Adoq9wg2bBP0_h1GaNL4eoh9Mzx7Jje0dgsu42FRE6BpnwzMJ5x17CfqytsbXdyRqjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-hXGgYPrMrq8YSu_SQNyefl0akVhRm5Zx5xcSi9bVyQ&oe=6AB288F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRC7WT-KkLgQ7kNvwER4rFO&_nc_oc=AdptubfXKmNnHUlYW5026To25H48NuHRGzGwZyCBfh5h1Cq1aXgP-MHvbVBX5hNe0bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeuA1UB-C46EgY-gCCZJSE0IRmxOi3YLgeZ1KlM0on5g&oe=6AB2A1EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol4wc2osFdgQ7kNvwGbtYtv&_nc_oc=AdqQdu3K1a8vHPv4jz47F3pvfnjPdQSP2e-vMsqRqEu8dHkcPHzh0KGGNt52Q3YwS38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmuCER8YL9CNkJAiowbsrC83DbDGji8Um_ZvH014a_yg&oe=6AB28747"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rKUFYbRUCsQ7kNvwFST5rs&_nc_oc=AdrobCXGosxKEuhC6mVJyGMGML0UFZrFjflPYbrCS5IdaXkEDNUeMzdADNvq
\u30e0\u306e\u9032\u3081\u65b9\n1.\u30b9\u30bf\u30fc\u30c8\n   \u8d77\u52d5\u3059\u308b\u3068\u3001\u52a9\u624b\u306b\u3088\u308b\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u304c\u59cb\u307e\u308a\u307e\u3059\u3002\n   START\u30a2\u30a4\u30b3\u30f3\u304c\u73fe\u308c\u305f\u3089\u3001\u7d042\u79d2\u307b\u3069\u653b\u6483\u30e2\u30fc\u30c9\u3067\u30dd\u30a4\u30f3\u30bf\u30fc\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\n   START\u30a2\u30a4\u30b3\u30f3\u306e\u30b2\u30fc\u30b8\u304c\u305f\u307e\u3063\u305f\u3089\u30b9\u30bf\u30fc\u30c8\u3067\u3059\u3002\n2.\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\n   \u30b9\u30bf\u30fc\u30c8\u3057\u305f\u3089\u79fb\u52d5\u306f\u81ea\u52d5\u3067\u3059\u3002\n   2\u3064\u306e\u64cd\u4f5c\u3092\u4f7f\u3044\u5206\u3051\u3066\u3001\u8131\u51fa\u307e\u3067\u306b\u305f\u304f\u3055\u3093\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u96c6\u3081\u3066\u4e0b\u3055\u3044\u3002\n   \u6575\u306e\u5f3e\u306b\u5f53\u305f\u308b\u3068\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u6e1b\u308a\u307e\u3059\u3002(0\u4ee5\u4e0b\u306b\u306f\u306a\u308a\u307e\u305b\u3093\u3002)\n3.\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\n   \u5236\u9650\u6642\u9593\u307e\u3067\u306b\u8131\u51fa\u3067\u304d\u306a\u3051\u308c\u3070\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3067\u3059\u3002\n4.\u30af\u30ea\u30a2\n   \u5236\u9650\u6642\u9593\u307e\u3067\u306b\u6249\u3092\u629c\u3051\u305f\u3089\u30b2\u30fc\u30e0\u30af\u30ea\u30a2\u3067\u3059\u3002\n\n\u2022 \u30b9\u30c8\u30fc\u30ea\u30fc\n\u5c11\u3057\u5148\u306e\u672a\u6765\u3002\n\u30a8\u30cd\u30eb\u30ae\u30fc\u8cc7\u6e90\u306e\u67af\u6e07\u306f\u4eba\u985e\u3092\u82e6\u3057\u3081\u3066\u3044\u305f\u3002\n\u5404\u56fd\u306e\u7814\u7a76\u8005\u306f\u5354\u529b\u3057\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u5b9f\u4f53\u5316\u30fb\u53ce\u96c6\u3059\u308b\u30b7\u30b9\u30c6\u30e0\u306e\u958b\u767a\u306b\u7740\u624b\u3057\u305f\u3002\nN\u56fd\u306e\u4e3b\u4eba\u516c\u306f\u3001\u3068\u3046\u3068\u3046\u305d\u306e\u30b7\u30b9\u30c6\u30e0\u306e\
20f&oh=00_Af-0qDtxzY0qvP34ko3QbEv3Y4eJk-3ieiBKvPCJJgXKbA&oe=6A30037D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqe2PNCe4UQ7kNvwEiPqEF&_nc_oc=Ado1fVpfpi-Q0nB1Qzei0mY5wVujTOG0NmnZ8hswMK4cJAXhfCg-26zKDUwVydrdjBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81WQjPpbktlV44m60yz1XV_Gr3XU1UszDifMviXS5JAw&oe=6A3012D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3-HkWIQ-D0Q7kNvwH0ud3A&_nc_oc=Adox4xAxl1AGQJYGSdOlDHExVDnyReC2RVSeiil6GxO_Iq6aK-6fTq_oewfwxwSGrO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_afv5LdgUX8n3LWuSp67EdrIcqE_Bqi0TS5zBeDslLnA&oe=6A2FFDD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWR4n-fidGcQ7kNvwEze5ps&_nc_oc=AdrhY-yWOdNf-NoY5MXpJMni2hff6htwTBK2_UOY-fFlOZzTrHZ6v5Ve0G1GFQ2t0Fw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sMM_49yJpUwhKFG2bKUd7PFsJbm9o89LoaAcG70lNuQ&oe=6A300475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YE9euW0AacQ7kNvwGvsCIq&_nc_oc=AdroMmduPkS8OxAVWjQwMGMo-JgR3fR7NmUa96lZEGsDPFSKWte3O0GVucRSKyn6xKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UdUWlUHUPKpN2XhYXyMH7QynzQOT8YM2UTYdpUCvEIw&oe=6A301D6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIjON0q1-LEQ7kNvwEGdzSc&_nc_oc=Adr3KffiyUoV3vGM3l84GXpORxDM5C6JREyNKd3M6XkHnKPWbT04TTqzRvRlzuC65VY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uhePwQ0n_pHn-SJTIw6xKuMfUiIuMB4H9w2gs88ldpg&oe=6A3002C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vzLw-m5HFYQ7kNvwETSS3g&_nc_oc=AdqB7LPnMP1nAxgH8Zrt4Am12hpy8PZw97cXD3MXzLZDpjpx1FwqNtfm3LE5
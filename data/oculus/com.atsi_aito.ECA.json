20f&oh=00_AQCYc6fTpu5Q2Vupg1yl6jNM11YO4FnoCSkahpRn48yyQw&oe=6A6F4B7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMQSOn-i-N8Q7kNvwEBbujE&_nc_oc=Ado7UPC_AwHZH-MLhJijCuZ0pAO3tyqvsKpYwErcveAhSSKqGQ2vD3DwHybqizFMmSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs1sVlJap_ZmpdXdKW-wmwPedkxMKSTFI3OJo6fj7Oxw&oe=6A6F5AD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EfXbGBWjigQ7kNvwHnFaMZ&_nc_oc=AdpQgIPBJXVUN5Ib8AojXrC1f1dFlM6fwNJdLuvoM3sg1cfgovk5mOrRsovLeK8ap2I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhqEhHHLCQvGcPMsqx-HibHlzWFc6FM5X04G_SKg1Fyg&oe=6A6F45D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snYcXrP0td4Q7kNvwGHsrdX&_nc_oc=Adpx5-_pVfmlg_ck9Rc1Fm21pdZup9Kblbqi1EiDKwUzDgEqc6tG6rHOjIXQwssp1wA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgY9PLlXQsWyPqVoRx_j7PiquZb9_IfqOqjYAtk-V7MQ&oe=6A6F4C75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFhvoGIAbDAQ7kNvwEb5xKA&_nc_oc=AdoGplWDRHsivA8fT1wfUYUigv5mwIWItIgZOaBXgkruq2ICcYYwPlnCTLlPbac2sv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-HBK-A1ldU2RSS_8dhfr0dMpDm50pWsaNhYBjmpjG_A&oe=6A6F2D2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsUJBAUGNLEQ7kNvwGVDBfg&_nc_oc=Adod1wMGLQ8WSL9sjDeV5_Jjg0KmBF4Flj0YWnKEffN1L1piYWLB_16-VbC4lfT9ECQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDELxORP78HFriYivwD7yUsGl4xSyZw-f2hsa1qhOMX5Q&oe=6A6F4AC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPeypdeilxgQ7kNvwH4Exor&_nc_oc=Adp6TnB86caqJw7LvbthuOYN61mxrkRH2hYxHkwryma_RSmuq38ng2cRaNsZ
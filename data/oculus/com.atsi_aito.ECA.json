7e\u3059\u3002\n   \u653b\u6483\u3057\u3066\u6575\u304b\u3089\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u51fa\u3057\u307e\u3057\u3087\u3046\u3002\n2.\u5438\u53ce\u30e2\u30fc\u30c9 - \u4e21\u624b\u304c\u30d1\u30fc\n   \u30b7\u30fc\u30f3\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u51fa\u3066\u3044\u308b\u5834\u5408\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u5438\u53ce\u3057\u307e\u3059\u3002\n   \u305f\u304f\u3055\u3093\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002(\u4e00\u5b9a\u8ddd\u96e2\u96e2\u308c\u308b\u3068\u5438\u53ce\u3067\u304d\u307e\u305b\u3093\u3002)\n\n\u2022 \u30b2\u30fc\u30e0\u306e\u9032\u3081\u65b9\n1.\u30b9\u30bf\u30fc\u30c8\n   \u8d77\u52d5\u3059\u308b\u3068\u3001\u52a9\u624b\u306b\u3088\u308b\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u304c\u59cb\u307e\u308a\u307e\u3059\u3002\n   START\u30a2\u30a4\u30b3\u30f3\u304c\u73fe\u308c\u305f\u3089\u3001\u7d042\u79d2\u307b\u3069\u653b\u6483\u30e2\u30fc\u30c9\u3067\u30dd\u30a4\u30f3\u30bf\u30fc\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\n   START\u30a2\u30a4\u30b3\u30f3\u306e\u30b2\u30fc\u30b8\u304c\u305f\u307e\u3063\u305f\u3089\u30b9\u30bf\u30fc\u30c8\u3067\u3059\u3002\n2.\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\n   \u30b9\u30bf\u30fc\u30c8\u3057\u305f\u3089\u79fb\u52d5\u306f\u81ea\u52d5\u3067\u3059\u3002\n   2\u3064\u306e\u64cd\u4f5c\u3092\u4f7f\u3044\u5206\u3051\u3066\u3001\u8131\u51fa\u307e\u3067\u306b\u305f\u304f\u3055\u3093\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u96c6\u3081\u3066\u4e0b\u3055\u3044\u3002\n   \u6575\u306e\u5f3e\u306b\u5f53\u305f\u308b\u3068\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u6e1b\u308a\u307e\u3059\u3002(0\u4ee5\u4e0b\u306b\u306f\u306a\u308a\u307e\u305b\u3093\u3002)\n3.\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\n   \u5236\u9650\u6642\u9593\u307e\u3067\u306b\u8131\u51fa\u3067\u304d\u306a\u3051\u308c\u3070\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3067\u3059\u3002\n4.\u30af\u30ea\u30a2\n   \u5236\u9650\u6642\u9593\u307e\u3067\u306b\u6249\u3092\u629c\u3051\u305f\u
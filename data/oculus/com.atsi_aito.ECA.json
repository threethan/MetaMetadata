20f&oh=00_Af_2z8XveFwwSct3nS7bho-QUrM-SxULroXODB_AaP-BpA&oe=6A2EB1FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqe2PNCe4UQ7kNvwHM3DkN&_nc_oc=AdoVPdw86frp4bwlASz9F0q6BBeTbiyN2w_jv7glFaEA8aeiBFnBLU-C2EtGld4unik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m6cqwEgMAYF226gqt182VmB84dRkk2HUmAFfAsY7HVw&oe=6A2EC156"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3-HkWIQ-D0Q7kNvwGKnIB0&_nc_oc=AdoTqD_v9Zsm5Zq6XtVXmC1MtiAAMhWrCat-mm_DBmwtlfPJZccPFtn8By7kiTgahZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ulONu5B3SUOP3-SUekLs4-uaOXnHKu4rY3PkRcK52rw&oe=6A2EAC52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lGB1UHnyOgQ7kNvwHr3o3U&_nc_oc=Adq0mRV12faeBxdXLX2Oyq20j5CgR9MKR14-Tgm4EPP1ceNq8mZbZC4XZs531DGJk3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o6PI-NDdgPiDSDcgaG9wbzQHqwcwuUL7yzwLq8FFFSw&oe=6A2EB2F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YE9euW0AacQ7kNvwG77IeX&_nc_oc=Adro8XCd4DAPl9ej9us2GUzF5V9w3DJhxpVwyfmN-AJu7JBVmXM6QhAWvVC5ZjYflOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ohkv7seLJ-Zc8Pk87dr-CJ1ncwrYh2rkrztFI7yhFKw&oe=6A2ECBEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMVOPr2BfvgQ7kNvwFtAiri&_nc_oc=Adrwtr1_0z3NjQ7QvPkw7Yr53zWRvw6xE5LZgEEU6Iv0qknx2jcOWqu02WvtL07SlSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_QVAzDNol4vcqe5OvwXxUTFxsgcZONMoCVRaxQhZ-Mw&oe=6A2EB147"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vzLw-m5HFYQ7kNvwGMJgfB&_nc_oc=AdrgcENjWFUGUweO_jUBWY6ludFBx8tBAobEimv2-RTH7Ee4Uozu2Z-gUqJW
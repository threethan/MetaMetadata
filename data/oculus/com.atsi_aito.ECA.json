20f&oh=00_AQNLE-2arUJk2nRyZP28iZ3ex-8uhh9shCw5nWr82m85-Q&oe=6ACE377D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRgbhAOZclkQ7kNvwHs4A3z&_nc_oc=Adqcbb4Ht4354oGOuVDdY3pon6t42PnNugZTX7iQ0ffk2UzU-NRKpHKAf_ACYebpiu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOXZH7dzO6wHHYNDJHe7QazTK0FzEy-bcf5xexKhWU3w&oe=6ACE46D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99-GGuShOocQ7kNvwEUpmEh&_nc_oc=AdqhdPsIYReg5hht5hPfIe6PEioD-1IpAIr5GujM1rvXc5zhzrfFl37JtU6Ld4h1cm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzBQvrJa8IKQJBil-cR7N5JJKEQs5lFqK6V83D6SKpeA&oe=6ACE6A12"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOz-I7F4y3QQ7kNvwHAMWik&_nc_oc=Adr8HIMSzOedRKLXmbkMm0xChzEComHsmwEr2eOCmdHVgnR2k59dYReXIPTBPvI3jFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpADffW-0X5foOlLQfX-E-z9OqrN3gopItLAr3TqJTrA&oe=6ACE3875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNwPWv16wA0Q7kNvwGFvdf9&_nc_oc=AdpUq16oPmPAtstUGuzpMNEj2nfyM44-YRri-6ufHaSJd3pY-JbKZzlxwlwX7Y1S_Rw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4rg2aH74hwypfZ54fiReGx-C6mBfSDmvI0H-xKmo_nA&oe=6ACE516A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIde0CZ3CN4Q7kNvwFYKJ6F&_nc_oc=Adqwgu89LFBYvGNcKXWxeyatziEI53JxOtKovcuWFm5OYiYK-1cfYTEVreQ86jeP6wQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3ffNgkmZ0IrMern971R2dH7ubSwqmDJSz8yz9s3mV0g&oe=6ACE36C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBJkpBoeawAQ7kNvwEGC-m6&_nc_oc=Adoq4ZFCosS9XvmZjwyIiZvZ1w4yZFqf4m21oZ8LLunTaNJhWSBrUVKf4Ate
20f&oh=00_Af7EpvQ0bfW5MySDYPqH1QmYaHW2hulfYtP33fbxfWOw_A&oe=6A1453FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kab0J_ME9pwQ7kNvwF8gk-Y&_nc_oc=Adra7Pu6BBWD9Fpq0yGsqUVompyIKq4xWE1ACijvl9nJUAHHgtYBz2FYgt-jgRj81tM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M6vt9OWY8qGda7XegIZ331JgMXU552X1rJGim8P2Mpw&oe=6A146356"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztfaHbIl6AEQ7kNvwEbOfXb&_nc_oc=AdombpIverJC4YgZLyL-jDnibkcN6C7daMQc8S_mcSnRC9UN1eJO2JMEqhXU9PZK_o0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lr9o5dwzTJyDpzJtgG-61O0vU8GNrsdVYyhFVXntdLQ&oe=6A144E52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bIZ1fQTTAQQ7kNvwFLcsZL&_nc_oc=AdobiAuH6nGITQJGdDcTVp46-PibTMb9mIKls67jw94_0-cwU51p_z3IY6f2Hh1W1eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mfHBstXJNqiaZa7oPmO6slxNuSEEZB8RlwWUtsk6fhA&oe=6A1454F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAh5B02FHH0Q7kNvwHuCXOh&_nc_oc=AdoXuoaYGjxQSbYyD0XgZ7VRXxa93zhqSbmhf3nPzRoyuSH7djV0h3wFrZJZrFmBeBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76xsub7fc4eC6QdPpcdYgVw-62omXMdyRWZ5FBnfRbMg&oe=6A146DEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX6axkjvej0Q7kNvwHqWy4M&_nc_oc=AdqGs2L_IxjninqJQ7XHL12z-NZLZo3kjk2LVJvDakBuLklMb3tWtrulgAxa-IRdJHM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-09ViCwDRlIU9ByOpmRL0ezglz_a38zhspli3PPR9HA&oe=6A145347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=budneF1iXG0Q7kNvwHJrirT&_nc_oc=AdrfOIEEbvZ88eyeEYDqGRDG5JClOJGDT1xbmskykjpE_Igl0mfGUXZeC6V4
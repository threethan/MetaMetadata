20f&oh=00_AQB32eh26dzGFIBh_V1ZSmv_wTApO9CS-BqPzg_U4C1sRw&oe=6A57907D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcS_Vce46tIQ7kNvwGdwaS4&_nc_oc=AdpjuVSxauAqktbIThU2gMXcJGeltNopBGCMPlaP4JHKmNnYy6jwf45KQEfPDSSXul8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTpUx-kgUAPTecE2lcUps-1XlsoyYZVg8q-FL_d--Uqg&oe=6A579FD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjdVle8BnSIQ7kNvwFtc1vX&_nc_oc=Ado1DWAfwbNf2UapeRlFaAIJiTWLeYGNHFsFVTdqAyOFwQKOP7uQM5xjIJbYPpoInA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCyQHbRzT3RfmJaEj3C1yvXbYK4-Xe7_5R62bPXB08-w&oe=6A578AD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4PAFLmXvesQ7kNvwHUeW6d&_nc_oc=AdoQOQMw8fmRbo1dYvTB664J8vqioxE54Z5iyE4KaJjOZRB-0VDs_wAphg9oAqjhupw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdZBUWTYWndrID5MBYh3URNkq61LAMizopQ3ouLBLraQ&oe=6A579175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhAJRTHEOZYQ7kNvwHHhhRF&_nc_oc=AdoB0DtjKeu9vXrnU7E3zlTHH2JWipDzDBw5AA3rqXuq4HwXeatwL17qQGhInzIm8f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsja36j7UyF1Xnx-k-cBc2oojBBj1mkxVgpSOSpRjaDg&oe=6A57722A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgKK6v-oEloQ7kNvwGGiKt0&_nc_oc=Adqtkq_8xs85JXsj915Od77XlmXeZUymFLPQgTyjvh3sv5bByAn5V5s3JpK_AcrCNnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm_vpBh-UYNTpvx0k_ESakVIk5uoUgxV859M9aulhdgg&oe=6A578FC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gv9Uxm2BMQQ7kNvwGiVt_T&_nc_oc=AdqD7p9HFYZuaiaHkJEguMQ6m8CxVTJY3kcG0zYxcQJ-wIuX7ZFn2GZiDcx3
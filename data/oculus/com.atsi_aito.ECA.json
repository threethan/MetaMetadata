20f&oh=00_Af7sExaV6D7-z2cvAfr5nSekcwkjk4U6ZULuE3p94r-wmg&oe=6A1EDFFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZTaqXT6YmIQ7kNvwGt3c1e&_nc_oc=AdrrC6C1BuvEXYDINPj9p7lBvQXpLbD6jYkeGBI2NAw_U7oRN1ajBf0pQwGSotjYyBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x16eZhMv0Yd_lonjaz5A2f6JNhAo51PxjHXWLDxiqug&oe=6A1EEF56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1j3X9Q8pRcQ7kNvwHDyxh3&_nc_oc=Adpm0U3lCbxSl5LiIm61Bz4N_nd5aiiBjbfQTCeo3aCYU80wNCLM0aEGmhccGr1F4FE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x9Qg5wtE5wAtfX0aIF-INo3njaI_mp9WV6cVFN2yNfg&oe=6A1EDA52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvQ5ker3-YQ7kNvwE1n3Tv&_nc_oc=Ado-a6-a34hhUi_C3ra-zVeZh5uiCe6_Un1U7ly2fWv65sL2GXVrk0FFeOd1-IuIoWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wbAgsVAQH8ttwid4vX9dFbPrFTgijoUHP8NNQyu_G-Q&oe=6A1EE0F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgxl-O9DP8QQ7kNvwGij2td&_nc_oc=AdrtBfrOYurO5ar0UTzKS2fcXgiY3CFiwF9ZtPgQ9eFQGMnDOXTvpfcHFJYQ09UdQfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KvlCLB97SppFa4BA7gghkMfsb6A0qiCxiRfl9cZ72ng&oe=6A1EF9EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skD2Nb7GlTgQ7kNvwH6euXn&_nc_oc=Adogd9JJi1WmPXS96E84pkEWOfkc6WYQjyGAtUOSfk26iD-mUBVPDGsrWSeq6aGF2LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wTGhJvUUnkfgpI8d-P_BBZFJZ21rVT-YUVo5ZBnGSug&oe=6A1EDF47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9XHITxeBvYQ7kNvwFhBpUI&_nc_oc=AdoUhMK9fQaiR1HkCeDDNN5sKXbGaOoccbr43X7HL6bhG0GeZutCGrDGDgNt
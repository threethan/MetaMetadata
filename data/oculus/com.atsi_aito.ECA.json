20f&oh=00_AQAFtbK4HoWDs4JoSZKSJfn0Jh2TYHYw_5GNCQupwrs3XQ&oe=6A563EFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcS_Vce46tIQ7kNvwFEOW4d&_nc_oc=Adoso_tbaUYC_kgct7eRyBjTANfJSJe6CrcD5jFF_ol5huADLCnWZgFcw1bDxNRFm1Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpFrlE3EgblwWj1f8o0rhZL1KlW6ul_OyKFM60K7Kp8Q&oe=6A564E56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjdVle8BnSIQ7kNvwHMbjfG&_nc_oc=Adogpgy0PmUezO-5wcHztiJGRxb_7HRboWvyh32ANe8uGLHutsRv50w20BqYAYghemI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeyi-IS6os9WuGZCQNB-ZXEwlqSIegWbBi5bNfGXwhGQ&oe=6A563952"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abD7j5hs1ucQ7kNvwHcdhNw&_nc_oc=AdrcX9KnNSNyodnHsKjQkTA37E5lyISvJ135haSBgyh66krIU9dzcrGUeh1o646s3ls&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf9oIEYxinx-vqduJkIw1OGdGDO0wyKgl_73apQh-TRA&oe=6A563FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhAJRTHEOZYQ7kNvwGOSyBk&_nc_oc=AdqCYosk9u7IdAmJxf1baMg40JoSELnnCU0wCx5weLU6ba2Q3Mnh2lmowHYIausqhIA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOhA_u2inWAAbEOfBXFL6zmNBzdCW4V16OZlMuAEBS2A&oe=6A5658EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4-7dOkU6w8Q7kNvwEvPj9Z&_nc_oc=AdoZyK-jGkorJF9qGdUZUKR9KhLR5NYrAnUlOZSrBgfk8ozM4d_lgQlaVqLBTLwWhPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnC801S_iyaAIJpga-GdT62n1GJQGmpiGFALus3sslBw&oe=6A563E47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gv9Uxm2BMQQ7kNvwEHYkkB&_nc_oc=AdpVxVT-fpG7K2jvTdxM8XmnSi9GyPDe5j7lcFTLj8xLHtJRoLLkkJb4aCTB
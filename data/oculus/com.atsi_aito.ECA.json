20f&oh=00_AQEzK2i-2pufpAKsPq1CN_8AzaierI4XeQrDm2KOS7KSvQ&oe=6A84637D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIeYJLhCXFkQ7kNvwGKOiyl&_nc_oc=AdovOC4pzuOq8zue5F0tAGFGMCfDGRwrJPjgvTYY8GGi0qzjhc_i0QCZHNYO9ztkXPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERDspRuk8bXrv4J-c2C3y5jJxWHBY83oyl21ivtUWcJg&oe=6A843A96"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eehcoQRZ0SkQ7kNvwHD7xTW&_nc_oc=AdpS_qP2v4ZHYc08J0Q1Ip6Ub7oKDRZmxeNAMgz-uoKmV2PHFh-SDvuemx3oW5esJkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlkBIc9ZtZq8-Lwz2ZQkSLbEXv2TpolTMMKO-4zARxvA&oe=6A845DD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTEtBk4BYpMQ7kNvwHw9hVB&_nc_oc=Adp2SUkO_8BeN-78IGPO9vQPuvvQMTRMxRPPDETOtGf04r6XrIVoApvTK3KmXPr8wpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2MjHYJHFaoV79GOCa5GYTt7aM3S1S3ByEOKGZMiyFAA&oe=6A846475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umcJud7_0ZkQ7kNvwHLD7FF&_nc_oc=Adp1bBissvXSImtzavou7maSzm0K9Su0zNwkd0PFynALoJrmwSGGs6RPj5dCAjN6Fh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH26L_V7f7EibrQa45lE4NNi0nHG0QptbCX2YW64fcUg&oe=6A84452A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7uvcJM35_cQ7kNvwHcPkQN&_nc_oc=AdpKuNGjzuC7rW46mXaZL_hjRmNNcGnw-7m1oDpic-tePvrPLNXLcYCpltjiSrSgH5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF30OsbhdlzAPX_WjOJ7bBzC22Fbw9sXhtZNayzGJeYdg&oe=6A8462C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK-Y0hba6BEQ7kNvwEfbJZT&_nc_oc=AdqrTzdHnCLS5dt4k_vuSiJcoa1As6TWDgZHXEMP_kpUXSQxk1yiQvJtQvV2
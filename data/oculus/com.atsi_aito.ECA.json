20f&oh=00_AQQ35_iii10FJxUudPICm8QbN4TX-jnQNpJbOcIZkMR3IA&oe=6AEDDB7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTRBnTd07DcQ7kNvwEdiYZc&_nc_oc=AdrWMH8rx1anWyki8Buk8Rr49SNI5faUVohN1fzdKCst85vr_VaeBJ8aGY3KDDQj48M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqZuDWOLtiTuE-HwCKhcu3VK7IZTFAuj0BHRu176JlNg&oe=6AEDEAD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdSvGpiW_noQ7kNvwH5OGcK&_nc_oc=Ado33o0ZVTmzO-yf3FYys2BHrUyLsCRcackJn-ubN4AlOT-g-TyODajcYUUGjCsuv5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIX1vuTK3vR05AcdgeN3wdVUyAcQir5t2PR-bP8f1p6g&oe=6AEDD5D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWc4UuUGp2UQ7kNvwGuFTcn&_nc_oc=AdqXEBU6tsp3oqy0kC17eyhKzKzdHHJ4aHv852IiwxVIZKZ0vnQh-QgRHnyDQObL5cU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRehWpBrBBphvgRvrNLNTDGVakDuwNoBKwiq0iRncXBbw&oe=6AEDDC75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFYIrhxx8tYQ7kNvwH5k5vj&_nc_oc=AdpF1q8pkCzbqukyHqb327MzD52fotExQUqiG46o7EmvidyiFUb_M_Z1JvlCp9GQ6Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Jzu_1h8JyNe1tdBaDVL8vv2GwAfnHqK3SBnhH-piLA&oe=6AEDF56A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPMURv7hcbgQ7kNvwFOqzvK&_nc_oc=AdqGqogiG4TR0aO4gvCd_GLbvJ6gpIkCsUDv6rO3b_zC0xArNpseuvT2w0NSvvB-nUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2YkhPg-nHSc17JQT-srMXu1IZjlgFW8btUZGDb9AAjQ&oe=6AEDDAC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAYf0XJqtTIQ7kNvwFp6HwN&_nc_oc=AdrBvwtoY5loj4ZjuFdxds8GSLruqO-VHcMVq-3E9tg03PnkH84sSbS9K77-
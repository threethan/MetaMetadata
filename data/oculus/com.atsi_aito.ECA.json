20f&oh=00_AQCPl9O_LBH31mCV7McyNcEYN6ydZSE5dDiuo315rJWyEg&oe=6A5A337D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fby1TIQVg4Q7kNvwFiYDKp&_nc_oc=AdqB9mUPGPEavJj28KJmR8t7Ujcv_g6fNI7rlylZzms9fg6XyqGSk7_-iNJQvGD2tzA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiXqbwdHiF-w4PCL_6rgSv-mXtHW9I9Ifp62ApOsVUhg&oe=6A5A42D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_zH29pZuwIQ7kNvwGM7Ath&_nc_oc=AdopsdKob7gYHMYa9SlA9AX8qY6sZOGDg38vjw2p9DQ30u3JIRnEIOrm1Zzp0WTmcGw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fH82Jp3EmBp0H_TXR7jIqRCSQL5ucwwRxOP4pzvyOQ&oe=6A5A2DD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4PAFLmXvesQ7kNvwEviMlr&_nc_oc=AdoPovshmqKzqmCLVPxlxDfXMudFqR3oqgOr5HLkqhM0z2Q6lsJ-BySwIOqkkakM7wg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvHiX-8awYAop6Py4sjgnc0KA3TBtXOWS4W7QBkblOmA&oe=6A5A3475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mo8xuadKLHYQ7kNvwGOfo7U&_nc_oc=AdoLgVzZuI4BtSE9j5Nv5pIg60_GDKRvjXEgj6slwkbLFcSGItUhs0w8nX0lIBEZS_Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwdJbdVl-hbkNHJmPMSQx2t0V-cwqtgJO0A2P4Y2zWfw&oe=6A5A152A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgKK6v-oEloQ7kNvwEx_f5x&_nc_oc=AdoXv8cS0lZ3Go-ZGhrA4LWvBWcubwk5pCYC8UseRMDt__vkUK07FO0CjH79HRV0XZI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3CAhooT4JWfd_hjpUU4UNGkgYN_LKanfArWmt3MBPrA&oe=6A5A32C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrG2lJWuWFkQ7kNvwEKRL7T&_nc_oc=Adq3bfbtpII9QHjd-7spzlSwLc66zlPZqRcG1Y9ysnw0b0OObVpK4_amXXbO
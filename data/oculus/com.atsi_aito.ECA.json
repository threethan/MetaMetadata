20f&oh=00_AQLiZd0k5FMUBv81xwIAmI3HouAOMrNy7s5n6bitA8YGgQ&oe=6A9EC17D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijy1yosoFiwQ7kNvwErpXj5&_nc_oc=Adqz-LK5tECfQ36MSvWgr7AkoFbjxtoguVz-hGDR2UKRV9Re4HjJ91E0huIsqReM39w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFMTsyxzgjYQtPI_Z4Yrk47fnFL_JkchuEl-v6rd8Xqw&oe=6A9ED0D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHaKTkEwLKQQ7kNvwEAdIwf&_nc_oc=Adqc2lkaQCHkejDphSz0rRPfKRzloFVYYgTYtloOoaTwZv8tUURN8IFvmdYNHZRt0tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzxq-CQew8sLRUd3toOVGjghuFtNcbtFWsBNhKMJifHA&oe=6A9EBBD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU3dsJPZFlAQ7kNvwEHXiDb&_nc_oc=Ado09x5UIOCOJczAUk5h8zbXoypTe5ebxjnUCpNIju4AwJkzPWNmM5XshqtJsKFQHaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0CMRfG1WucAGYMY9hqCcMAgAjcZcsJJHnT4KNc96q-g&oe=6A9EC275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rYnXmHzQegQ7kNvwELnhkY&_nc_oc=AdopuG39lt6CRU4uk0jbLAr6U7T-8aI3ahZb50jGdLvdWAqgd2Sf852NuYLJC1UuvTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkIdI6hC050apC3huie_y3Rqz1xblcjF4Dm-jbBoY5_g&oe=6A9EDB6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpSnzzgcfIYQ7kNvwGJSSAZ&_nc_oc=AdqDZ0Rk1NuFFdD59SXaMQJ76Eaoklgk94VsJV4z7uSX_H2ynU_vyCBYL7EI1JzqCCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWvqA4zjVIqlubYmYxm1NMJQzlSFtb5ow_uAsHEnBGgw&oe=6A9EC0C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5E42VldigYQ7kNvwEgzV2J&_nc_oc=AdrWa--BNXX6WXzAGJzSD4yoNssH_U2sc21lmbM8_bL2_w-IlzenJbypkLje
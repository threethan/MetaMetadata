20f&oh=00_AQTJos1byDH4wvyTwW6NhDduZpc_XOLFubV7KMTghQhrQw&oe=6AEB387D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTRBnTd07DcQ7kNvwHKb87i&_nc_oc=AdoxVmXmI_KQ3iYqI1A7fv5d_9LGnbhfJL432ezJ57Pj0KbK48CAD_tRkJy_vpst3Bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjHocPDjLdsROHPFQXUP2D3qrWungvdFBvXrPtTE5GHw&oe=6AEB47D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmVVG05obDIQ7kNvwFe9-4U&_nc_oc=AdpxXS0zY4lIbxxT1shLT4nrN3eVL41mBDpbOfo--KLHKnzW8ChQlJetu_E2OhK5Luo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0TCrpaMI3nWw-HITfZhnVesbgBBFrOoHQs4jnCgLBaQ&oe=6AEB32D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAyIWj74xaQQ7kNvwEx37xU&_nc_oc=AdoPtTwNf8bN72QjVNYFrUB3zK6hDHniOC_aj6T2Hb88etOJR31gIg5oUYyimqJmun0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-wm-uvSBTzPsuFuc8JbHojsFf7ZOX0knf4va7Cn6kDg&oe=6AEB3975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fszjjsdOrvgQ7kNvwEIJcFu&_nc_oc=AdqG35alf2r7bcuKNEFysiPPePwEffhuiq7i-lB4z0OMay4yTtymi0tfG5UqC9Lyh8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF5YQFJRTL-Oe5syv3UVUw8jl56C9HmSDDf9GT6GrXSQ&oe=6AEB526A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU16WalHbl0Q7kNvwEJduyi&_nc_oc=AdpRltzx8PRQJtAz62x4mJxVZrbNBF7zHlXTLmoeACgWrobIiRED6ux4Ulkw6wnswd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO4qo_0gJ67mmIzS1VMjNHFRllLYkg68tccTFPnH-lAA&oe=6AEB37C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqY_3wjJXVwQ7kNvwGOyO1y&_nc_oc=Adp1bljDIxFd6o1XzXzmDNa8gei14jyBarr6a4ot0uef9WIqZF1DMaNw69qP
_ss=7f20f&oh=00_Af6OVMha0i8T_vVqoMPLAlSIUGyFiSnfW6bHJEcbRhcAiQ&oe=6A11B0FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kab0J_ME9pwQ7kNvwE2De-K&_nc_oc=AdoyBLmiWkCKhK9HZJdVitoGznAOcxJpoiH88g9D4xMfiPrfQrlN4OuQG2oaZLpiwbI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SGVNpQi2RmK5zpNhBae5pibGhvfN5xDJSZPRz51BYpQ&oe=6A11C056"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XqtX8mo2UEQ7kNvwH_TsPI&_nc_oc=AdoCqE8VQb1VKmQSw-OFDassyTGNQ6k1dEA1SBu6QnBSA_W2EXGcKdHR6aHkUt3YWBw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e3H6_km2EXg587W00AHm_xSVx8EAA6DLDJQ7DdcqcHw&oe=6A11AB52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypNSYazU9noQ7kNvwHm7cY8&_nc_oc=AdosDduwUZIlx8s82OyRh0_lEmuVKsBbnewgvSJ-YCGhbzzMq3wyKwerm99FRRQidyg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PcokgLdsQZ3jHSDhT6o_W9bvU4x3jAHe7WWr1r8gM3Q&oe=6A11B1F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5654yuK7IFkQ7kNvwEWNZib&_nc_oc=AdoYZBpMXLhZcVyP1dhN3SpIzdIWYHx0GfbFgts_1UmeB7UKoJqDAwX1knYi-RvlJAQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uMPhm_M1Hck2qeTVsIF6g9UvP8xL4H6-hJO1Iqpl9Xw&oe=6A11CAEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTcQUwUsfrEQ7kNvwHHMFXQ&_nc_oc=AdqAhzNTp5EDzAOb3t-j0-djKteHpFpBXMn3BBUCBjfsTTWYB_oq-BjoYoR-s79zz88&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46P8I3lbP2yHQeQzXd0brraGuyAWsxNzNMPL2-6hlfwA&oe=6A11B047"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HWvaIMVElsQ7kNvwFJ2VHh&_nc_oc=Ado7SbMN9sTjaIQcE02EtAYI4kEpVd1WcGMoAUjhEyEnd7YcU1qhJ
20f&oh=00_AQCABBejFyfGZfKE_sM5x-IpYUBnZRCOTQS_skd_JEDGMg&oe=6A58E1FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fby1TIQVg4Q7kNvwGcRzjJ&_nc_oc=AdrSDvJlpX3xGISNhjGoXhGSjVKIQWYSo0mVorx4xConkMrstYoiAE5Uqsb_pA_8GfQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqLNvPGD_osqvU0t6scW35pvA1bMzNLbs5T3SMYkViiQ&oe=6A58F156"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjdVle8BnSIQ7kNvwGVD4LR&_nc_oc=Adpyaqvp5zHoy8dD49sjd9moEh1Eg8ClQKbusXxeC6tcq3WTN0-ByCS71hzfLdRk1x8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsqPtqwwxH_JCGqumf2qJsRD1je6yDRAr9M9VLLomv9g&oe=6A58DC52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4PAFLmXvesQ7kNvwGHCtXt&_nc_oc=AdqlyV98-zXlikK95ULIAY6BiihDhEfdDiGngZXllsQSQC3NWALsgskSEK2AEVSMKDU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhqOpC0d_Hf_wjfocDMDkQM2DflTZNN6YpTrtTSEhKEw&oe=6A58E2F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhAJRTHEOZYQ7kNvwFdStF2&_nc_oc=Adrd6kwZG9VX0NLy-2k0BRGIwxROsYAcp_Boynu7XCUOD1ICJnGeLfnck3s6i5J9V2s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhEUKrrZh8lzj48G9WkGgwI9-yOXhoDnXY7nFXkFd_xg&oe=6A58C3AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgKK6v-oEloQ7kNvwGCoo1X&_nc_oc=AdpEWKsIQiTjavUgqa7M0xSh7pgcNRsCVIEhS7uXP_yqBBbsWlKEPzlnx3tWi5HOZ1A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDelaWWcBw0QTxdzJQo0798uu2Y8RWY7ZfY7f-XR5WvgA&oe=6A58E147"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gv9Uxm2BMQQ7kNvwHeWefD&_nc_oc=Adr5zLN3ISVK6UmdIioPZoKndeelj0YUjttJjwT8B6zjZbbDzB-BesX5ZYNm
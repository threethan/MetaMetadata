20f&oh=00_AQBTWNZK9ftz8ulIk-K-kDKybY2uZ24SwH_BwxzhDsgqkw&oe=6A5CD67D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU7k9Oa24SMQ7kNvwESDf3e&_nc_oc=Adpxg46jZvY5vZjfND1Rof_nuRMxTXwyLVoLUhsr8t7PehRk7BHQkcJQ7A7K04XZYUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzqBdCgnZVJIYNKndqVckpcHEguACxRyZkCHs7XOswgA&oe=6A5CE5D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_zH29pZuwIQ7kNvwE0dEjx&_nc_oc=AdqpugfhCeC8Q46qocTN0lX4loMXQQ21eQWAflLBTxcLq6UHmB-EsM6icllrR_lOPoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPDMj9s1AvBOJds6Wvd8IXRPstU0NRy1DBJVubJaQjpA&oe=6A5CD0D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYBSYLY_RTYQ7kNvwHD-69L&_nc_oc=AdrdRs3tI-uH-9PMc9fZDgKPfn_KKH7yguTMNTPiKX9F5-94i-NAlcpb1RWWjN1im1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTqDsjtkN9cB3SjC3qJOnohOEhnIwpYApMgBIrsp36tA&oe=6A5CD775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mo8xuadKLHYQ7kNvwHi8Vxe&_nc_oc=AdoKO0cA9cA9wJKZ_m9GkWKwsbTfgcDS42v7o9JaY5Q2dVK3umwb_Eo_jPLmSitx3qQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16rxFlOA3OGYBtPncEWNjCqO5uiEuegmo3gTyx90HRg&oe=6A5CB82A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssGfnV9jOhoQ7kNvwGXR8iu&_nc_oc=AdpSthld2ZgnvKgRhEHO8xyuYpxfxJBC8XZNXxGnEXfZEaMPKhARe87Oo7hrc3dsIxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4hp1ExKjnF_cEZopYt0GMF9uVxyTGCGVmxXJVWWHE_Q&oe=6A5CD5C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrG2lJWuWFkQ7kNvwEnKtdg&_nc_oc=AdoMy9U4soBYQxZWelKsoRs6KaulErrorpnpo_bENHF0oaCPIaUrJtVjk_te
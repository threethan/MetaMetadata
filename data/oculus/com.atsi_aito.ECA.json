eHQ5rR4nWMRwiAD9UaY3oVIA&oe=69B021FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDW1b3M6Q8oQ7kNvwHRzSo3&_nc_oc=AdkSE1ABRYRf4jhu_NokSzCl6n37_RJmfIymS8YjeUADMgv4ZnBhCh7gqJAwdXylfrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzaou8FHbT_tEFPDcE6PoErMzD0LN5aV-ipoa1Sqx1ryA&oe=69AFF916"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04FKQdNuRD0Q7kNvwE4xnDC&_nc_oc=AdluOy0mX83PyPvzvIJegQyAYf6h-qUBCX6Rpu17g4kOw1umWu0dxnOdk6BxjIn824Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ_oI1uzWoNrxQ8zf8vbsUFaPkm7fV_CnTSH2vZb8vAQ&oe=69B01C52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNCNXhez2BgQ7kNvwEbucLE&_nc_oc=Admqv3Sqg332M8P8obXsEjfxnVRvL95X5BYnbmHb2a4UclCBq4HlUq73COyNXZiTxmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYcEayFFmNgW5ogtJcsGbLE1obiLniRHAHVQpsxQT0DA&oe=69B022F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pwFlf7K0O8Q7kNvwEBfDda&_nc_oc=AdmoPrl99Q8mhWcF6pTs-QN63SwqTcHYFJZiRmE9YrEEa9cPR3zLcyEZlu5mAb0fHV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2y8az5zXO0jVGY0Iw2miUlHb62EjGd8BcYg-Fymzpjg&oe=69B003AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKmtVbjPzYcQ7kNvwG35u48&_nc_oc=Adn8VBvyWEIto7Ns51TLmkOe-0F7CcH8xdNQLIT98Q46LN64irNHXAutX-gRX_L2P10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNzHu8PYp36KDF3GHKngp_0XNtcSUHRNjg0X8CyYbw3A&oe=69B02147"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWoxFjfhULIQ7kNvwHCUwtN&_nc_oc=AdnWArfC5Ca-SbZgcYw81qmFrbM4coYEYT1Wibe_JLinbCg8gANxH2bpCkkOuekcJHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.co
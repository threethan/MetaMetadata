20f&oh=00_Af8B9d4BIPWZdnRQkSkPfzrGSGJTIBbLTwpTQsSqFktiGw&oe=6A3E83FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cghpuPH40UYQ7kNvwH476mZ&_nc_oc=Adp257bqaSY8HCxQnQebMcJH1XqfVNX46C6wJScvy3MoIIO_O54aE3tBTjmHFrh4cwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3kDZZ_BHqUXP55fBy1bb8diKozG1fYADnMH7mfqFMYQ&oe=6A3E9356"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHr7pf7OZLsQ7kNvwG053Xd&_nc_oc=AdrsJKWeVRn_dYsIS2R3GKR0g8qeXCVEZCiScPWfEYhGcaDLiFErke2FVkOlRu6yyBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T6MEnmQsOiLqGvfQxHGqiycRua4AFNN6ccJnUvGxzPw&oe=6A3E7E52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRoJnbs09lsQ7kNvwEA2iIj&_nc_oc=AdoMXD1IAmfDP4Hk4N8NxUjGk4PFrxaJQL5-0-WatTAvUjXvpr6Ezb0NNJHsAiSn5Ig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Cy1FNx5fh_oGxIuGMNSgHxoVPKaTpHdPbbYMuRBeCtg&oe=6A3E84F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlsMt5ouhUsQ7kNvwGw599M&_nc_oc=AdpMIbsthmBa13R-QphC82c42BdJrepuDtbE3hajiDr_tPekgVdaXQ5ifwKpUB1a7_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SHvyWSlhemL_6vGRSlDZ3dpqyk6zCYFMFViAb5gpFNw&oe=6A3E9DEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4wCCBwap5AQ7kNvwFjtAX5&_nc_oc=Adq0igDfPNGxf71g8b2RuQdz8SYnz7ybFU6bWPrMKSd3LYRaJOHZgRqBi54Izpe1-Ho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aeMHK4zAhv7s_Ka9pUPoPXzPTSOO-erzDkdx5v7HTsw&oe=6A3E8347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpXyEVuU9MMQ7kNvwFtS9is&_nc_oc=AdrMEywn6ZfWX0ofPIcKRHV0wSyNv25a66AaG-wLuEleDSoLHr7VAGVqKvwG
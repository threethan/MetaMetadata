20f&oh=00_Af4Q3w-sR95AtQUVuFmJEeBW5nr8Z4X7-tQha3jviZ11Qg&oe=6A0B197D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEG5iJV4LJYQ7kNvwG-sJu_&_nc_oc=AdoDBJDkmOSPy3ESuCnn71QFGTK2pd4KguxXrx710S90gxQQMFFsHRpRGqlXJjXjKA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u76rWCKQ_t4aZEne5-beDzrnQNzHurZPi18XwGbTm_A&oe=6A0B28D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-o_xeGeAgUQ7kNvwFdgOs9&_nc_oc=AdqJK1eTlyeRQC4Xn_gwg0aC0S_x5aWwLcNg4ln3JftKbp-2yVV4CNIrkXvjHXsUqMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s4K9oI432vw-HyZU6vnHxc9wZ4dWS4Wvf_7FYAlvOXg&oe=6A0B13D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXZPwUETQDgQ7kNvwEcHjNw&_nc_oc=AdqgeN8AivCuu_biZN6qu-UggEXU1X9I2FoLPSaBd0EDKtby09mNC9iwLe4FTj4GT8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MsOrLTRf2Vdi_r_FK9hzvNN12_H14UsamnZ6YCT7new&oe=6A0B1A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHFauo0tz7cQ7kNvwEEsYN3&_nc_oc=Adp3V63AV4sXwjHb4dg9dKsxl-zV5aQlSAlLhOidxe5v2P7XAYIwT1yJrfuY0y1g_J4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xDUG4Eb2qlIiMP2dUVgeoZBe2V_4FMFm2PW8YeYhPtw&oe=6A0B336A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7slEhGsDM4oQ7kNvwF2QVtw&_nc_oc=AdoJsH8_fmxHMAqzmLsUhc02cVlkVguglKhSw7IYxuEej-TKtX0utb-huKNqU8gsYe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sVToQh0wLKPpdTDW_BX5W0BSScs0IX3SYpN30cRLACw&oe=6A0B18C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNCSGUP_nKoQ7kNvwGWNIAd&_nc_oc=AdpukKJXkiHJyh-fsYJspHOucRHhBiplgtR8oYFapLnehpyR3OdDAdM8aKlQ
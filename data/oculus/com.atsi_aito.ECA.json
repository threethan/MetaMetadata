20f&oh=00_AQF_ckcDhhHhvRr-LwA_R8LxxLbZL6y-ZH0FUxzTutLv8A&oe=6A7F1D7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e35_lOlr520Q7kNvwHFxJbf&_nc_oc=AdrEeHnD06f7Zeo_wkGuqOTSwn43fBmbCuvQ2hRrrTi2M_mlE2j2QQbtXpoX_sLPbFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXZtMYG4mahLOQTnGF95WXCrzitW9n_nQ-1Vmye43M6Q&oe=6A7EF496"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWDoi8aAPUgQ7kNvwFzMYeK&_nc_oc=Adq0kDK0ZuWqQPYh-108p5oZS1SGLc0KER70KoT3YFOffzKWQxX9QQLKluK4wteks3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQGubBSW9VaMPyb1JsD2fH7PEz43uL0mKXgoywQ7BcvA&oe=6A7F17D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtQ-7gbeUE0Q7kNvwFJ71ZJ&_nc_oc=AdrIGZ2AsH8WDT1Qxc_x2g_QudPTSB8ohdLi9e-zhUjsQX0Zad4liQ7MLL0ITrHB7Rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Fpw7rJgHx5ix0AByk1o8SCqXLo9sOOZJCbxdO9TUJQ&oe=6A7F1E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16DwoG2ltAsQ7kNvwFeDdO1&_nc_oc=Adq28V7IdFgI-yWt9vP8jD1SzByEQCRXApMgBl7wMB4AZLdcNJFpXF30oFohJnwl8-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJAemvcGdBkizFULXanrwOAxLcxssGwRaDySAKw-KiOg&oe=6A7EFF2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr4ICCR9TLQQ7kNvwGqpg5f&_nc_oc=Adqp7GKICQTeQVLIlKhD2qHZMmME3zhDMojJm_0RawYe3ZTEX33HOXEhS651I-yqh3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEttS4HcXBPoZCWdWpZIo-6wZle2YBOTpCJRFzzWzWg-A&oe=6A7F1CC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApXbC-ZIpwUQ7kNvwF1eLAU&_nc_oc=AdrZthlejKdp3tIoEJ2iy1iJ7Grm0aHnlJKk3zjCir8OvKNeEmEGxk21pbOS
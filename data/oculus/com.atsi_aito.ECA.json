20f&oh=00_Af4ZzHuStSEB_FvlOJ3vgf_phttlvjrTdiq55DA18_SOKA&oe=69FB477D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loCTol3lPhIQ7kNvwGEniCS&_nc_oc=AdoGZsZuHMg4n1Ko-hFnqvH410QHC_ZTUgcn0dku2FprnlPmbh1iokLG9xig93N_QO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CLqxfIIHgZLKVpWp5nrFQUW53CgFn5PbEKL8wgZlP-w&oe=69FB56D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wboqte3-e8Q7kNvwErQDOR&_nc_oc=Ado2DEx2Jsrp-r5w2NY6VUdOeANXjy7i6DDl4vUs6x6p7f2vuuYL-Q37nmkkAkRmirM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zr--Ripix7l1YJkybTRHlUiFEePgkld8_KWxjzRwsIw&oe=69FB41D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA0QYlwOgb8Q7kNvwGQ7rI2&_nc_oc=AdqN4l_grIbWyhcFIsJjMgdqLH3-_zPR4sP-K0hb_Sh3IkFFLaUBCm1mnJPla0Wm1Yg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UDINGHUCVHiJDwH5AsFrHNCe8bnSIr0IXkyaevgQX-g&oe=69FB4875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuPGFSEj1UQQ7kNvwFypM6t&_nc_oc=AdqoieeSMjrCvJZFm4W1-KlXFILDKOcs95xdfZ0GFfy6DdRewetBTledwFW6du3PlaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-AiCKk4CP5VjQ2riuA3Z9-FD2VD8ACbNw55YHNvCBkQ&oe=69FB292A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNJeDAmr4m4Q7kNvwEtUHh_&_nc_oc=Adp6rtCu0MAB12JRQezinIsQXBauS6xVNpcSqsOL7kS49ityrg5DQheAms0O-b6fdZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DZ7mEORZDg1ulUhljQ3nlbWxZ0EIV1sb0b2y18sA9lA&oe=69FB46C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rzhsbUgApgQ7kNvwGQh8UA&_nc_oc=AdpKI4ZnzKnWhC8ocas5GzDK3PaIu8shHZ8cnO2XnRaLOU3hu7y4nhwcDGIT
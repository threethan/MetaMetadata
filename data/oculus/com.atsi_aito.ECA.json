20f&oh=00_AQKVwfLE7huoLhlZwG16zH2X0UIQvufvyWRd0KWJT3BX4Q&oe=6A9ACCFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTyXFYV2TWoQ7kNvwFxUEHm&_nc_oc=AdpuGaFYT1JFnR7xtBeg9OlnyzaKj6DG_dWyStA7x07yRMWfX6-XgWs9oz6n1LleNXY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGC4W3pLMdKPs5griqC4XcYfddqDZsk34GncyAr2E0_g&oe=6A9ADC56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XgPw8e7GZEQ7kNvwGsOwxK&_nc_oc=AdpymYnLu3EXCfaes_Ss-HG0b-oG-GjoGze3IXg13godQXdLZ3kDeK1ESkcZhdqiSjM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNWwmaB9Do5d2z8tFqylmnPtGYTS7cKXFIO5ml7v8W1A&oe=6A9AC752"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6G6N5wtpYUQ7kNvwHnisnK&_nc_oc=Ado3eE8rr0OjnTqoC2eN1aXd-VtRAJYOjV3V0Xkj9k2sHF9Ng_Mmvp5nOhS7svkkx3s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNWn1693J55zQQ69B6MI-mveLk5AIjuluz8hanDVsGlA&oe=6A9ACDF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnddd7aS87sQ7kNvwHmGTdU&_nc_oc=AdoDPEKxUztCnWjlkJ2wpcwsIIyQCPcS60ztnLWMsB0XyPD89l32VXZ-Dwm2J2aljuM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP8YE6J98MHFahGKYEr20xQCCK1VIl5Dpyf4UiZE4igQ&oe=6A9AE6EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcEV1OjMIcsQ7kNvwHb8Ob-&_nc_oc=Adrt2GbjBSnDFqyhisoo4s7WUck0KAbLxoxVtb8PYXTIyaGF7YNaTjJ3xx7eVKXEQps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJimqzRFdy57lL0dcIafqNnEcwrrTB4JmCyHH2ee5mRUw&oe=6A9ACC47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUWg5rYAhD0Q7kNvwFAvCXc&_nc_oc=AdqCmnnV9XpWTYyx7zPGylPl09AUfmcbOVymCH7w9fwU13TsWWUg8bDWKdBA
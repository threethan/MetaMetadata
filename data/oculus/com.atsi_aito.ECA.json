20f&oh=00_AQM5TyKKjMtDShR37F4FhAvzH9omqr7gfjXmHz4eqkyIUA&oe=6AE4A0FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28uWAhCf6GYQ7kNvwGmfwVA&_nc_oc=AdoWVT_uyivi5e_aE5H2wP1LPv8CTMHdH4du7eul-CUGM2rMfa_0t4NN4gR5SUs4Ql0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwO_hWGLktG2mq_wrs5x_Bn5nhJe8lZLLGK_pdOdzVyA&oe=6AE4B056"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoLInvxcq-EQ7kNvwFzl110&_nc_oc=AdpJn3jywuxombFCuHzcD8wYi9fa2t5dlZ6edNePKZ6lG_Jae1RQUdE9KqBzvPY8E74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOmUWHt6R4iDICFYEyz9GL8GH3kk3CI7jj-5L_gCn-bg&oe=6AE49B52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIcG4-B39fAQ7kNvwGpo7h3&_nc_oc=AdoF75Xv6C78bwUqCyz5KsJ3zHHr5797h1Dh1PJkBzrJFGLDhyR0CKMkN-G-yoC9Kjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO4fy8j7hFxnju3GV5gv8EQVst-6TJFDcRqMOKAZDQyw&oe=6AE4A1F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB0SnmdVIVQQ7kNvwGaGgMX&_nc_oc=AdplKcM8jksI9IBt9xxNj4E298iNGAvzRWGGtlg8Ao5EBZL7voZW5V-kAjch6Ler8hU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyn3I3k56j7r-ChYxLITFVhOSB1JQpdUbAnZ1MZHq8yw&oe=6AE4BAEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3BX2PKfVOQQ7kNvwHdjFvX&_nc_oc=Ado5UB3Bca5KMXYS3VVy1Jx2Y7-g1sdTfaUZ2hXA6AyjCFgIC7efxIx4b68728XHS9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZptjvuAWP5INYpRYq-bVaWX2bAzM8CqWMuooMbKnl1w&oe=6AE4A047"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRowAGSD08cQ7kNvwGneknY&_nc_oc=AdqydzrVx59Y5sklzRjQ_qbrwBe1_46PTXDajQqWkAqGOjZk0PUZSjIovMUn
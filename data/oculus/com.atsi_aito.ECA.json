20f&oh=00_AQHUVI2qcEMpBWn9HD_EB-T7sTixsY-0j8g3zTlZjD3opA&oe=6A92E3FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18BZoaw1NPYQ7kNvwHVSYYx&_nc_oc=AdoDD33RDvdZK_lhrC8O_eht10msQtoyp76yDpZffZ72KdatthB0FlL44x6hnuMDqUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqTq7q3eTpPC-prgbo8xa0O5Zaqiwy1UG6FMbwjduyPQ&oe=6A92BB16"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOL4ZZaM0V0Q7kNvwFCZeAv&_nc_oc=Adp61ka54cmF7L76vgV2NXwfdQIF-lN1bqSoZpG4pwp3dbEGVACfSGUTvE4_svxq74E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeEgWaR-rJRyGwz_wV_n5p6qwjfy40DI4GrD-08yCISQ&oe=6A92DE52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILmR_wf_GqUQ7kNvwGZ2nod&_nc_oc=AdpDwsmoq_5wxgknPzFu_5aH757orDDY8vJICbNwdp12VIqcEBUmAzRErE-p3bsWagU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-80waCruXdTuiIhP9l9rqsgtolHfjppKe8qypehXzEA&oe=6A92E4F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoCkmeP5BIgQ7kNvwFSif0P&_nc_oc=Adq-DbY4E_TuL4TDuzNcMZpKLCrdFvy4tAdONRIFqSFBQMDhXClJudenJT_iYveSxtU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHiNRZy3sZjCmUsKQzwkc_BshFh47XNGU_gcubzlvVtA&oe=6A92C5AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-NfpjCHkEIQ7kNvwGIRTth&_nc_oc=AdrUXNBCH_YRH-uiolkKGtT3qdEF7VPJDvEl-aAr_xMWMdIwYY3q5-88RuDQJW4n8R0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnhDq7sejPUZxH2I-lHYnlHrfIUrB6FMqpfhXsI0rRqA&oe=6A92E347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqQJvu_e1GgQ7kNvwHPu_TP&_nc_oc=AdprnmjtYD7Wqwi7MhXR-OWV8WttDhMkliBt7OG0zUjmBF0GANIcR9cO-geb
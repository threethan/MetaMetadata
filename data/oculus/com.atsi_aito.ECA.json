20f&oh=00_AQJkDP6mSuh-6ojIQMzybGy9M_gaUuePbSOX-ZX8cWtCQw&oe=6AB91F7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7UQH7i_bzIQ7kNvwGAlDX_&_nc_oc=AdoQSoJhhuOTqdSurNTVLFuMn8vW4dCYAZ3fKYN1RllaC1IzL7lcFIVzeMKJG6ANoSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy9htE_s5fhOIghsEZCvEwbJt3YhSQIoleMBCOZPuQ8A&oe=6AB92ED6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usOmFLDtKwwQ7kNvwGQhRt5&_nc_oc=AdqGl0ydA2zb5IEfiHcc9o-M4kKzOUu8oAtKkHNVXflN10jx72HgDLpRZU4cE8Wmryo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh8K4dI-v3gPRJ5Ig7fOyo8aypHBXqbc2rlmsjjSLdPw&oe=6AB919D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKfOnpImmmwQ7kNvwG_ZzS_&_nc_oc=Adr8Duxib_HqyOJEEI0-D0iQ8lBlKUjTFvFI9nQPmG-Ntx58w56D4gna0SddUs5wX1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfkIwtmIf-XTez2oRYk7ydz_d_cILA7BvgkVoDBhC0xw&oe=6AB92075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhPPSs0FHNcQ7kNvwFA8Ez_&_nc_oc=AdruhOEir_ymnEbDOtXVZIwbiKMYIiUeOHXlSdPsS1qrbT8H_MPm6xBfB6oXJRxN7ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbl4BXtU3Zg6Zl7r_AeWzG6ztnElQg8gHaieZBn_CWxw&oe=6AB9396A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoRMSw0R5VwQ7kNvwEGViWm&_nc_oc=AdpClUux_eE_pOlTlruIyxH6vhK6VyC7jZnzJ2KjRPsi3TnM0e3__FPmZCmUnEAl8Gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYKRjG-ogif6IvnClb7fRN4-TVKPsUEHnW3Gp0KNjXDQ&oe=6AB91EC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxpQPAK9qzUQ7kNvwGbhVq9&_nc_oc=AdqwI7QatgtMHUcjQJmvbOkPGC8UG1h84XufIdRjOGt4C9G2wEbHS0Oo37mX
20f&oh=00_AQDTqoVOO-K07R8ffuZf7Db7HxiTDdMdeuk0T87_IG3ZWg&oe=6A67627D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-F-gLEH8TsMQ7kNvwGUCNIp&_nc_oc=Adp_SPKpxGBB3pnSci0_GCcOMQO29M9B5bqdj6duzTdBsrtXgbA5SQgfgYNrqFbfARI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY9BmvjEgpPLpMkg__Tb9Zsbp6CXn1-2DQIizw23w76g&oe=6A6771D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjaHrSI6gqkQ7kNvwEnVnGL&_nc_oc=AdqgDxtNjZTwDYjvjGN6ZdGiYRozHTiq0G_QJG3zTZAwEjP6xw3JNA3xGTsKjB0bxq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtkhgPIufhgXu4jcgRcrtVwoetHL7_mp0Ber121WfQwQ&oe=6A675CD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLQA72onBQQ7kNvwHh8QMh&_nc_oc=Adq1IkcflCYQrQH1QWCRmC--_pYZsM_LoQwiFZftsxaKAEaM-aAtZGPba3714ZIbBUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGv7Rg8aiQJwDyC9djXXrfs1eD8H2DHAnCm7LPUpWQQA&oe=6A676375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53OMff96azsQ7kNvwEFsJXI&_nc_oc=Adr0o26INvTUz3AxyfuFIeO5SvqS3gusARU2OfKTvX35CRAlsGUVzrBUDZu_HY880TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0WUUGmHdBCSofEUUj8edQA0-yUCrVOiYlBHip3xbamQ&oe=6A677C6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dmuhgyckc6EQ7kNvwERJoBY&_nc_oc=AdocVSkNgO1dU9JIsnnYwrzdKqLWP4MplXenlvYr4pJm5garyv9n9rfCoo7CUuQbPp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfr17rNcktffNuxji7lPsU_qDRl3eSzeKUnS084FLPWQ&oe=6A6761C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3fLQSplFeIQ7kNvwGtWCGV&_nc_oc=AdotmsO6GCpuNq3AP-PFEZVKEMb0A2pMgwiQDwMc7y08caXZWcKd5lCvP-9y
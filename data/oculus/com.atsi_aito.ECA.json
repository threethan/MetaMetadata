20f&oh=00_AQHz7RQ3Rd16HODr2K1G_OH1Sn6SOGs7sXP_NlKAxVpa_Q&oe=6A75E2FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56C7t01sYvkQ7kNvwHhTrYj&_nc_oc=AdqN2xCnHFjJ74XQwv2Yev7iPjZX4yFDWJ8jVm1D3XOYpo_aGbbn0pjx1qCTg0ZoKio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3il_VJPlCOwDK8a545-viWcxqg38xC92tSYxuid4D9Q&oe=6A75F256"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0McsQe9uTfcQ7kNvwGw3Vr0&_nc_oc=Adqy3GWmtWMLiRzSsSJ2H5_be5oy__d2kO5XFtRg9-uJC6zPzb1bTp_fZeI6wZlEdNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1nSIwW7m7t6oAQmqHjr6qmom153K3ff0naTdbrB2L2Q&oe=6A75DD52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C39lgebTeAQ7kNvwEKhXl6&_nc_oc=AdpTHluyN7MKMmJ1zxzbiiySgA8Ih5lpFhBXfR-I9VDqG2YzHUnddWXy0Ij6fZI9MlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR1wiqq8FUYEsxlIXRuoN6w3vyFlNkL4oi2u7BFJ5-7g&oe=6A75E3F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taenD7rXOoAQ7kNvwG5sWJb&_nc_oc=AdrqqwBB7kXeZkB-BpugyGiQqXMfiwVVYM3DZ4w4NoCjSM7BEvzUZhFhtwBpP5f4PBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjJ-S9fApCGsRDDYWieZYGeQnXp480SRzwkbGOAj6Nw&oe=6A75C4AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkLiUPfCojMQ7kNvwGS4g8J&_nc_oc=Adrrb5wPyZkpd5r02oUK82SWn4pmmBZJD7PwNB2GKAqiPuXu_o757XJVW95b1CDP0og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUrkmU57AHq9b3uoIkdl6t1n3Cq8_9RB6iv-Ha2F-9kQ&oe=6A75E247"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY-wR-L-lQgQ7kNvwEmnYW9&_nc_oc=Ado8jABNQ6WdM4cAxxkAdau4Ic2zM8OSAJhFre1AustHgv_IxgGq_EzhhjTg
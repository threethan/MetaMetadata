20f&oh=00_AQBkvCsDBxDg9GXKC1p9qIQ09ZgbICvx7yGMRCJCs8vhuA&oe=6A524A7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1djrxd7Kt4sQ7kNvwHuirBA&_nc_oc=AdqJ0h3osdXBDZ_8xOtcj5PMvO6hBTOwBkklzGBlNlRPBO5IEFxZLaTesyhj2IGHBfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwg3iDlOwly_rqDo9Lgq0KFF_op-qrJJhVJyJn6o4mQg&oe=6A5259D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRnEHwAnsykQ7kNvwF8IXII&_nc_oc=AdqPOJME1lK9UCRWuVQ-chOyynKvE35KQZU_KGXygOoQ0imnzTCA1ql8GUGwa360v0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhm1ZLE_sSzB5w-uTcxhvX8AMxdyigxUa09pE1QdfmGQ&oe=6A5244D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z5J3UiMCXoQ7kNvwEUeb9C&_nc_oc=Ado3_SVWqa7sNHItjAGjyj7KzyQ10sZ5WeXh37GrR5swVEE4idjPoGmYKJ7ycXlvcoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA109Qd8LqDb6ciFn6nAafC1tA3M8ttU204opkyWuA6fA&oe=6A524B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZj7a5TnmRgQ7kNvwG3xnEf&_nc_oc=AdoM1hZobs7D0OSIfy6N4gtb--RlwLaj7jrTqmcuByfYKXT0F4axBSI1lUC32Ot0B10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCQ3vyKM9ESqdvPabfLTDToNuwHA-a6TygYrHgFI0GYA&oe=6A52646A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-bnJWtGs0MQ7kNvwFVS8yY&_nc_oc=Adq3ZAgvoKcfla934Cb8CPTd0YCvY7PTAbSsJQyOZ7YViMYnDOul8Ty8TE48-EXzryU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC02w5ck0k_peHNT1b4nw55KBZginNSeaFThjEC27md3w&oe=6A5249C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKwfHOmSZnsQ7kNvwFeh5n9&_nc_oc=AdpFCe92Tjscf3oxdQuMVYbxPKicU4zQ0JKXOX1qIZburki62-2yYEH2cpKj
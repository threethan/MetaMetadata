20f&oh=00_AQEqttrzrOYSBrFS8jYQcuPBhh_svgDgVAs33pFURShFUQ&oe=6A709CFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxwr8KJQzxsQ7kNvwHbd1hv&_nc_oc=Adrk4iHlvgRNWPhYPAa3wohtbDCOhwdaU-tYYxhgM85z2n8kNm9Ay1d3I_-nyI5zUIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiP9mTAIOPOHExg9FV7f5Te9bRwdtmemIaXu-6wry2bg&oe=6A707416"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EfXbGBWjigQ7kNvwHiI9RV&_nc_oc=Adp6vz0preCUnRzl80BggIgi9wfhu7TbLjWMZGsAFsW-IafXZV3ihba654hUxaDOgnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF08mbRilBgwDiZAqUgv9rd85ONpcCeaIIR-3TG53BxxA&oe=6A709752"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snYcXrP0td4Q7kNvwEAThli&_nc_oc=AdrMGyKSUTvWD0wnFWBrJlUCfT8XyFNLhKqh2VLsS1nUD5yhGGcey3XwGw2ZTkVeMXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQt8jnAdcKMMsfzMrlLDHxKNgI4vjUkKpe8wsYWyDnkA&oe=6A709DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFhvoGIAbDAQ7kNvwGIW17q&_nc_oc=Ado1MQYgCbmkg_L__W9dBjgSo3lUqngAZ0AmyjQapaglzHBeNk_XHk2oMG3GOl3r2b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFymjq7rNZEaj1FP4NwaZL42ivqC7c4UVa75uh_fW1bLQ&oe=6A707EAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsUJBAUGNLEQ7kNvwEJ75To&_nc_oc=AdrxYe6_b3PUpF7LaqtqfOy2J6c___C7122H4czSn_PRYuL2x2YsDZYFKrnEgGNpus4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHedJUSFkDtEkDvF7KLgUHligIJvoxtwdv8gZsrHSjHAw&oe=6A709C47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPeypdeilxgQ7kNvwFCQI2Y&_nc_oc=Adruq1ym3mKpWAXj7ssycWgGgKURhBjl55F_DX06_VA36s3ZCp1Nmko0I9uQ
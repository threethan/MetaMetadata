20f&oh=00_Af7hgdpTqmi4T_QcvmhIy74lC_gbTQO5zAnCPlcYnL1Pcw&oe=6A13027D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kab0J_ME9pwQ7kNvwH-1vuM&_nc_oc=Adr2UdfiBTHJvfxWYEv-q0IZ5xB3D6_nkOdggrFC6MqXMKQZphvbI0LtpxFJpkrfs8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cOFGFB5Ehw7s4hV7S_wj6JVwK3B9BP9r0w5m-fXFATA&oe=6A1311D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztfaHbIl6AEQ7kNvwGZo4xZ&_nc_oc=AdqwLKl6wJ__Fq5OrjgAAEOlpMuPC1ccI7d_mUA4qLpZGrR0rAXgIGvtmhJTx9l57-s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m1PgAD6M_Ha901MGaqEs44ndsxAEzZC-4PwI4sZ29tw&oe=6A12FCD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypNSYazU9noQ7kNvwHG3h1Q&_nc_oc=AdqJJON06TmGSEYWAT5cSwFY9SfFXrMkDAWYTyCIfKf8fgP3XKD0qmuet1dztS-IjFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eemWBQ5_Dy5NE2-WLADL0nhnWh4yMkPrC3brCqIUFCg&oe=6A130375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAh5B02FHH0Q7kNvwFPuAqQ&_nc_oc=Ado-zVewPuvBgS7y3gXcCsrsxfLaHHdIUtN93nDHYf49S0QOXk-iumNGSicDVHHz95s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EckoM-73ZgV9qcNeaQ7gb7v1VAjSbaUpU10ZVjj5O5A&oe=6A131C6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTcQUwUsfrEQ7kNvwH5jPFg&_nc_oc=AdoBLwYkHfNWAbevNgUCWBR87GA_p8hVPLerU3ncUwTzTYYxKJSO5OOlYxVN6NsBq5w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qpVg9-YRiJ8CP1PZEoc_T1GSPY-agNwe0l4ks6fNHDg&oe=6A1301C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=budneF1iXG0Q7kNvwHtWpf_&_nc_oc=AdqLXO1DezD2iaRyxyCtwKSvQXlncUHwyUjrTlXMgIiZoOSAPq4NY8QBIirJ
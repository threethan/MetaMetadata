20f&oh=00_Af31arLUNIQVMbXrgxnvKigLvZy0niJkY0c1r2pBOifV7Q&oe=69F8A47D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsoAZm8ld7gQ7kNvwE4LmQ2&_nc_oc=AdoS_h7Xypik6CSL-2gn__ggJgp1Oto-E9Tpqks4LooOJb6iL4mmU5-YFFmpFXatYok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hLNIZ_dzS8JP95UEIpTPlfJwVFVrt8Y1DOfaCmxCmtQ&oe=69F8B3D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQnLfS3w9MsQ7kNvwHFcSJZ&_nc_oc=AdrXBhAuwnEQR3oZzGG9a2t3lRRx6nhjCv9hqd3OuNaQFawEYiQ4dh2-Y9ag41ZpbV4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rTGTwNmvD8Jz4WTVlv8x7-FMs3CN6dbq4iqpaOYiM3A&oe=69F89ED2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA0QYlwOgb8Q7kNvwFBf4UT&_nc_oc=AdrwPlCpbXkKFOez5H_kkcmLqjbJQEVzeeNjdjj8aowOlJg3ZXAvpoWr0rljoXMfV4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ItTPn-RJ_9ehZ6K1t44ZzYMTadMMsl65W6HU5ZsHrqQ&oe=69F8A575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvB3Zbhf21MQ7kNvwGlok8U&_nc_oc=AdqHg76MdVfJOatOQU6UwaU_a4Hkar5LfO2PSdArDmqGfgbQ-TCytSTClw9y70ave7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZzFcSRtwXTYkGMi6B7XFlRPd63beJE3xMQxN3Myri6w&oe=69F8BE6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNJeDAmr4m4Q7kNvwFmHNAB&_nc_oc=AdpoKPiPEvJ6kUo8_-x-iojuN4LZ80PWgspASkWeqfCxHfvEnPp2PagUdMexEjHzKIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xnkDokA6ZsLqBRw89CZhArDe_GMBgcQ12sbqlrboweQ&oe=69F8A3C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE8m_AVKSEoQ7kNvwECvxWH&_nc_oc=Adr2YGZ249QqGGMo2rq4zB-bJ2qGj2E5l5l4DgYZTU8a8D2HjIe5VHpRzzuC
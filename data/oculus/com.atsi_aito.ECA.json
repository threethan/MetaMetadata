20f&oh=00_AQBx--sbgYFoSwgMf59qf_6Si3DYIC9HT1GCrUqkRAR6FA&oe=6A4E55FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2U9Cu8Eqv8Q7kNvwHQw6s_&_nc_oc=AdoS3NdVxkprd-CMsyS1ddOpPucKr1vF4-l5pNOjWfwtm5Etuf-My858cFemaVmR8HY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7yMaW9dptJxioQexZ76YHYiGDZvBUm0gcR6FtxZim_g&oe=6A4E6556"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwpCOfbsmmUQ7kNvwHp2VIA&_nc_oc=AdpgHzi8I5urYMdyJM4d3qwlQGSyDf6CY_yDlEsjnyq503C78Y_RD7_q8DU3tkK7L-M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxNz77dld78ImZuUR-YHNyi5wAo5Op3WoLF8HN5zAQMw&oe=6A4E5052"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ca_MvdWtnEQ7kNvwGWUvQs&_nc_oc=AdoVl45VmpWPaViGJuMCuo5QhoSesHwr1dyfPkpRmEu-JhAogz6yCbjcZzIhPeBvq9w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBARFnZsTjbgTjvLx3fKZn0xJ1ozlT48ql5a3gB2Sc1-g&oe=6A4E56F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLkLLPGlmCUQ7kNvwGctteu&_nc_oc=AdrWmeukn5OYPct6cpBCWJ3VSeDv5cm5083mLcgBflDhZUNRk4KLcGL8xSCrGTRCe0Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4nyGtc-HOgl6HGp1zPYWRkl76LR6b-_xcQrUReXUmCQ&oe=6A4E37AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y6lDjjZif8Q7kNvwFv8z9d&_nc_oc=Adp7FtaHyqDrn7IjDev4iks1dV-aeudhp-Kqq3pN7yXchAltZrM1T--elB6zNaUAX80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDskBMoNbrGkuw1UOIIQ-UeJ4tebuC7u2ljo6w5Jo7VAA&oe=6A4E5547"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPUhJFzDYKAQ7kNvwFWfVTV&_nc_oc=AdrTFIUxBJwSUttoyANZzl9P4cd6GnsEYPxTtf_A_EI-rq9EJBKuF_dR0j2t
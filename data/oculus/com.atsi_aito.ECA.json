20f&oh=00_AQH3t_VO-yplplohIGZwE-HQlwJJwB2-seUkIJF_h7CeZQ&oe=6A915A3D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18BZoaw1NPYQ7kNvwExjoZO&_nc_oc=AdpYFK6792TZgqgdRgYFq7ISngfTCpNcyAg-JGaVzYH3sWQ_deSqnc76XH0knnyq_7U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSLzhStvXPGB3oXMP3BxCrxIza7Jc5s-uQcw0yX4h2Cw&oe=6A916996"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOL4ZZaM0V0Q7kNvwFkRygN&_nc_oc=Adr_po8YaI7rlN0uLDJY8UyQwWgqunj4W8upFouZtgSQfDfaxnlZFPj7e-ooWZPZGbk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7S82RCIJt_pa3gVYQugoeybqhPMDPayamGksG5C7k3w&oe=6A918CD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMtuI5n7i7sQ7kNvwHYEvAn&_nc_oc=AdrAIJ1NqnH520cG_eyS1uh7exrrAFARsmdN0Bj1dQXdCmLkOAmSuIScHqEKw8hPk-Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0d6wzNtSIMqXry7fPbkcseP-BRSqTjZakQwVj5wxU7Q&oe=6A915B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoCkmeP5BIgQ7kNvwH7MdB-&_nc_oc=AdrCAKSkwESea6XB01-Df5JDIO2zMu4Y8rbJUNy2YtPIJO4W3-8WPpPL0RHxhJJSKMg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPSgnG5Au4Ha8yjk-38ZU_z-4zFdTvZuz_VJox4Xy70g&oe=6A91742A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO_Td2mfgwUQ7kNvwHd73vH&_nc_oc=AdrovSpDsymyK4XifcUpB4YF9dchXRd6HPFvCYJqjC0aNhpFm_vaBxTj4GMXdBDMO6M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwk64TvOUkAChtRCQ6CrUF3GcOZV59CfG7wdVTiyIz2A&oe=6A915987"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqQJvu_e1GgQ7kNvwEUU0_T&_nc_oc=Adp38vtwY_mAHvtSqcdajfxD-1gJBsy0DwO6-_upPk5jdi-LrTVnVe69nkiM
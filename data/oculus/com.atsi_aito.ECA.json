20f&oh=00_AQAIiWGoXWex25yMkCT8dn34vTcZ8sz5iqoIHxVIk8SqYw&oe=6A4D047D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2U9Cu8Eqv8Q7kNvwEYyI7J&_nc_oc=AdoGbqkhoXxkZNATsDYM7Rg6-uRC_cPf8v0iQGqLl20-pnWYtqCUw6P5MPqXjIiigco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABrk7Ox9NaSuJRW9-wcBSaqVvGa3JPtDz7lPlzThIUoA&oe=6A4D13D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_znk8AzxJusQ7kNvwERhf2i&_nc_oc=AdoDjwDU3gftWX20c6uRtGKuYUa8M2jVZkOp7tvV1LQxLVDhXKDT2aJTlyv0Yo-o3Jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjS_b8I_N6jbUFHqU2Cyc-GTqJmyb2lTP_MFLI26xk2w&oe=6A4CFED2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ca_MvdWtnEQ7kNvwHPDROP&_nc_oc=AdoatXhTkIaDoUBMK85HRatadYZghk3eCWFZQNMeqqIDr21-UNy_XZZZKMHlr-kZKM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA--UYXS3odnuo2-oIqnllxjGoh5HDBC4pMN-Kq4ErrFw&oe=6A4D0575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29DDJw2tcF0Q7kNvwHswHE5&_nc_oc=AdoLdH-7c2cU5ZxmuHV_2VjDLpJ7Z9d0V6vICFcksIURQYYH0-_u9gTSUaTBXpVDELo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-SomHapvj-0OjcxPDIwtpgmsxKe6CIL8IrJLn0_yDOw&oe=6A4D1E6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y6lDjjZif8Q7kNvwFwRmAH&_nc_oc=Adr_JjUYjEVM2_HTQ-v1CMuyzLNWB9uu_GrhZswSMcvTjX6QnJ1eXdslxlJd4iu1ShE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnx8z3RG_gDDi4l6t2n4t_HJftLZmLMlVIRINVVAFJSg&oe=6A4D03C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaeqKoxTwQkQ7kNvwHdrNhr&_nc_oc=Adpz05T3jO-b7Me126EWtQcCEBnp7Ly7F1RcVZvhAoj98hztIKAoBxo8yagx
20f&oh=00_AQOTazFfhkvbLGi-eaL7O4DatsgKYlF1uOXdrpWm1Dafdg&oe=6ADCB7FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuvICy5jl-0Q7kNvwFsm06_&_nc_oc=AdrE4asfKWsWHQAJUxJiUGzXjoEsEqKuKy4YqFB1BAnejHEi-Uytc9Otl-HdCjWt1lY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGvfUWhx5ohyL7rCHALwFuvi1u2D3f5ds0gDv10bm_Tg&oe=6ADCC756"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdNGP5_4AvAQ7kNvwEaQ-ch&_nc_oc=AdohnaM8StRWzuaQvUzfcERKHB_4AxeQ2GfexVFOyKKNGmOW66PtpO1KNRTjKkv527M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkad1DELADCWxsRwScs9Hp52DSQcp4rtzvmlA9Mihiwg&oe=6ADCB252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKF28NDWvAcQ7kNvwG_Ekd1&_nc_oc=AdrrNSc65YH3L0cMHsgfw4UBg9YQzN5t4RYQ0EV9ksb_sNlTU2r01N_JUVhSa_YyDBk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxiLzXxEVVGNO1Pg2qK-dVRS_AnSRqK5ggIH365oDCwQ&oe=6ADCB8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1LKRQnu0OkQ7kNvwF2yavS&_nc_oc=AdqoBbd5VqcNkbYZFmRuTXlo0CSFHasExxcw3gaSKPMtAj0iIAUCGphSlf9XBav2_EY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQMV7vkQSs_lvErWjVePo6ftzwvIHaB_Ion_HVuSy_og&oe=6ADCD1EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svP_S4GaqtYQ7kNvwHvY0vx&_nc_oc=Adq2gzYoi6EHKwIyMpSojNV8ntRWI2WT_c59p0JM0dUevy-_h97baIV2NkbWVcGNfMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhrDJRKyRNyZwKBxGJpjmBsD35nn7uinSW6iAwJs-KEw&oe=6ADCB747"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQZTE_dPZa0Q7kNvwGAa9Iq&_nc_oc=Adrp3akU3eEausCpfLL_SZ4-BWikfZra7p5jqoftFbazHNFfeOQK4JI7oJO_
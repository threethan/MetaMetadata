20f&oh=00_AQAW7rI8iDlJT0Zn4-FDzrJ4ADx-Euyzp_J57z0-pYlRJg&oe=6A490FFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_6XpOaUAC8Q7kNvwEAivG5&_nc_oc=AdoFjYmt7SHVpPNDKa4Y2KTRe68cwGZetSqWLAmr2CipRRveJkFzyeiIe1FKugK2hy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYgAAl5EqblvAmVmrR3ys43ehUfXN_n0aiu_x7InTE-g&oe=6A491F56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuGbFBX-k6kQ7kNvwGhp9Ww&_nc_oc=AdoB-0MMUkbf_e1dt3hdsGmhOw_gziJv1jSKMhMT2lR7tkzmb5FxeIM7H9VZsmIMdBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXCn0viwpaLWvzCV7BSlFyhsPwHvOqeMdhNqJIdaFxog&oe=6A490A52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6YdO7OOz0IQ7kNvwF_2tlF&_nc_oc=Adrq01ehuUNwvn9wi5DrTyLby2BzqC5cRwSOglsx3jSZb4Jm5qXPPc_BppmkZ6mxoVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2zbLvMDHYLUiY4xsnRTCEeF2Onhz7vckTgab9K-HYMA&oe=6A4910F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgTCsz0mxcUQ7kNvwHiT3oo&_nc_oc=AdrJSyvbfBnMnvDUjTshDEFl8JPybWkdVv68OTWsTyeueOHSu011VDlenCrIvAJteyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCQe2KNvBgjhHfAMhftSUL8ULLCHG9q-b3j8tM-JXJ9w&oe=6A4929EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpFaTG2fStwQ7kNvwHcrc3R&_nc_oc=Ado2sk8ZXVyaE_R_yMBeGTstiReRIUSZNNfU64oQed4sNFBXXZjreEX1w7gEJkLZt4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfWEMs17sGsu30T6YtEUbucJJ5H89MUT1XRHrgSPH_pA&oe=6A490F47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwvUExwqaSQQ7kNvwFtTG3P&_nc_oc=AdpRp_7tKRQuqYvC61y07oGuRM5B0JFPuWt_gRot5IWq710cRuQWQR45zLhf
20f&oh=00_AQN7Euf6RridSFQlIP5GjwBTA3bkwAezofYSx_3mElfDMA&oe=6AD3B5BD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flsXBKFboAYQ7kNvwGmOSWV&_nc_oc=AdqBTPvOKTLdn2vN1IavwAixU7rcAA6hXNUgj-R-7Btl25RooDd5T9T3ulXzHLDYuxE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH42LjsC89iE3ONF_gT7C0tKbNGyFkoCno6MSXJ61zoA&oe=6AD38CD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4sPwRuvY9IQ7kNvwEPRQpx&_nc_oc=AdpnC8ay0NKmnDzberD0Y-CuG1wtiyeDcdPeLi13z5x-GIlpVKjWl_N4J1gso0bCXHk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_FrzLHY28bUGAwCPsogAU84k4SWROPyhPOQJznzT5eQ&oe=6AD3B012"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWWZ1emV_FMQ7kNvwFl7KzF&_nc_oc=AdpmW9lEt_XhvsDVz5dX4pjC5yfjnW5ohD1P1ub2qzJBCgTPm7ERMSUJ9nLEGU6kH6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEUkZnOxrBMkAX47cl1pj177G_-lRgBspOko9DlrAruA&oe=6AD3B6B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ujw5glhD7HoQ7kNvwHhTdsj&_nc_oc=AdqttM_9M93rL9ezdLwTtcNPpTTC_2sTNNyPc1Qm2TSAD1osSQebUpfa0dXPlnVBdrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmTgHsxcC2Rb0_v2l-u4kY6y067xJxRaB1oBoxklYGYw&oe=6AD3976A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MzljJPGxWkQ7kNvwGGLnQK&_nc_oc=AdoGy0jOAv_bQVYICC2ryXqHAMI0Z4_4ILlzF4eWrVYNVAudFq9BWOwzX1KeZyuHiVE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAss8PwedEbrar18z-jT1jEWofGcjeniEfltjAtIdY4g&oe=6AD3B507"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAL7i17vj_sQ7kNvwFzAJll&_nc_oc=AdoxYcwZvDTcnnHpE3sBv7O-BvsIhoroN1fIOpHJwc-IoX1YDo9LwdAhhahl
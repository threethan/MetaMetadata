20f&oh=00_AQG1S9OKxmTEOVhkMQIJl3gp_wqR1iLfdzr0PL6pmkDFDw&oe=6A77347D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56C7t01sYvkQ7kNvwEzmKpd&_nc_oc=AdpAxLHFhnQbZ1LADTvwcB1JoEVR9wHviXZSpNq9BzjJ7UehZOWVDD7tvqc-OiORebI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJBdklkVvY5NSo8s6LgRcVN5MF8lh-I9kayyj0x2gpXA&oe=6A7743D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0McsQe9uTfcQ7kNvwEuI1qi&_nc_oc=AdpZiwlO7RO_M_F6YpBwqTRmjj2ebSrZ0XU_pxMnmZYP-aob_A7Y8y-jUFClxFxk0X8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxJQEJIvwQ0SdbdzJqLnWRe4fPRSCi_sEOgTNPCcb3VQ&oe=6A772ED2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJboYMXBwkcQ7kNvwGvhtgT&_nc_oc=Adqfs0kzhF_f2QFJJfWlbVEoY_LHXlV19KQYZIL85f7W_usWlhtpJXk5aVD-OWN2RE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy6U6_kazLhMIlLUiRRSMBJED-NwlKDWP_cgJKbOw5PA&oe=6A773575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taenD7rXOoAQ7kNvwEYRIHb&_nc_oc=AdpynH34BpxZeNN41ZkcKtYDQUQeurMAmT0SYRA3CmTwALMZBzuQIWJ8XtirsyXruto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECL9Y8dSLc0Y-h5VpTCyh7SJ8QaPT44D7u8yw_utD45A&oe=6A77162A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcWO_Y9TlsAQ7kNvwExYuSr&_nc_oc=AdrnsVdDn27n4qfyycymvOItXf6mUsGROZ_ELUVrd07mVBKcfYwcsoSMQHjtHfJtLI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFihzL3JXqMbxtKPwhu_B3y_qt9mWvQSyZlGp8rs7zVw&oe=6A7733C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY-wR-L-lQgQ7kNvwFL1PQ3&_nc_oc=Adq4__fAquEpumSYApFlU08RMcxMG96e3DnbYo1Fk03jT5scAoJGju_s1zBj
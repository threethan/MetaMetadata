20f&oh=00_Af-Xz8w9kqfbpBj1NNTCKL62WsQyPraT04D89Y79op90Vg&oe=6A281A7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcZVOWIQ8z0Q7kNvwHojiDo&_nc_oc=AdpWxJkQftuCj8tX6ol96iosFM96AEMNztZ_hA0ANBm2-3qguSP9Y8QFT1btIviqVOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HMUXjqalPuhPEAiu3j3q1V-edHNhWuzfkSxjgGTtdYw&oe=6A2829D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2lsHkwIkR8Q7kNvwHfGfrb&_nc_oc=AdqbmAmioTGWkRr0-FMWNQocStnAkD4qSfcL8q4sL-nwdHhNwrNAgXQXS1hfTEQrUWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--AUuiWU-sWfG7bbn54vNebodl4ak0Otcg9uROBoS9aQ&oe=6A2814D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0GsTv9h924Q7kNvwGqaruP&_nc_oc=AdrSLtUrc5LuKxjMrfTVhrAE5ZRROzupftYKL_5yQCeJ4NfMBdMu0PmnBaydU-9cB-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JMXKR_IPaK7Fyb8yb93OTek5P8kh-UVu2BXJH8M1ksw&oe=6A281B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPviZ3TiS-wQ7kNvwEsX0zs&_nc_oc=AdpiPIxoe8tsulpcmzSCXPcLw9vaSX4BZUcrDxuLe_bk9L8ocT7q3nwotMsJwuE8_Pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zUPfl1WEHcHtRbAypTVSACxRfGEhN_k6hu1BoOEfaDg&oe=6A28346A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAdqOi5Z3c4Q7kNvwHSS76W&_nc_oc=AdpmX5n3XrgGC4HOvkGmCfqwLmn68Swa9AGS7vuusFaizPWivPn4Z6TCeqyCpNia0NQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O2ewifiyMZPQ8-xtuu6Y5VGtTjAltuWxV71UYtNCOcg&oe=6A2819C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9_wsvMnYGAQ7kNvwGxIfFU&_nc_oc=Adq__L73uPe8WpQRB9lKuqJlaTUcuMlSKjaiwC5h53kgc3Pic_sQqMvbEBF1
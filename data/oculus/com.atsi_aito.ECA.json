20f&oh=00_AQFEH9ABc4gRn09nH4cynEO2yUDBsU0TeJodvem9YpsctQ&oe=6A806EFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98gmqnjDGQ4Q7kNvwGfGJIG&_nc_oc=AdqwSeEReEkcX2MOF4mk5i3zl_0QMPkuIqg9eEyeAcWBAddiZXAECDnq2QkT-F_olyA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEhndPP7ctGK5lcIzgiqsTDe3Xi4i8sB7Y6GeCztP-Ng&oe=6A804616"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWDoi8aAPUgQ7kNvwFWA_fM&_nc_oc=AdpAKgf19L5ip6Dt5vsi0hvsalLKytNwW1Osspn8oC7aU83c_k0iBZnGzNXUzMIyEXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3BS7RmycvfvLDV1HfDmmpXcxw3FfM-QV1e2-6_meW6g&oe=6A806952"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtQ-7gbeUE0Q7kNvwGCDko_&_nc_oc=AdryjGX5iVzLci9EI52eFtqAb8hEl849oYK4dr2MymcKVy38F5jo6PGN4QuI6iwKICU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrfky34M-6VXCOoV_MbYEULfNTudLx6NH0Ltcv-Vb53A&oe=6A806FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16DwoG2ltAsQ7kNvwH15u9h&_nc_oc=AdrTjw09htj6OL0A9oYuV54kij9CJVKPAWq5wJcxfr2FYPERw_3coy9USs7aMzV5ZPM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Z-dTZL-pMBr66H2Zx6zZGQhIfYCXVbAlAO6t_wAvig&oe=6A8050AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr4ICCR9TLQQ7kNvwHE3IgM&_nc_oc=AdppWfanOL2aTOd69WWvKW7KEBL4vfNrYUlzwrwKs3QbWcgqZ4obiVokcDn2v2n5FHk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAdxcx25jqf2gZy2MQaz7FupSN7lCpOAU7vAKbHIr-lg&oe=6A806E47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApXbC-ZIpwUQ7kNvwGDKxjl&_nc_oc=AdqdIjaaeO9iASgpRSLknRASzzA7oUw0Ngg951b8F6F1Oz18lc6q99AfwLYA
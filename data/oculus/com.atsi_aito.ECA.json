20f&oh=00_Af__93Ud16ZeCG-cxPdvb_ETHTqTAgkll83x3Cpe2zwqUw&oe=6A37EC7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtL7i4dZIAQ7kNvwH-Qr56&_nc_oc=Adr9_J0M0dLc-tPuDBKYb2ATAUq5vJQMS4G8ewZePIaGS6zhT79daXbisKc7dDBj11s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TXqV8EZ8IXjwAp-0zxF8xi_JkLeuGvTi2HeKJrZxJEA&oe=6A37FBD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr9BaIpj4FgQ7kNvwElDqUU&_nc_oc=AdqH9vH3USibQg5-iaosxRIuS1zIaAgNsr-12mphana9uKe6XFDgc5M0Nqx_3XKZzN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wIbeMPTIX0Mw9qN-ptNSYZIoN7g3uGsYgr2POXvQo1A&oe=6A37E6D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olcVOrru-S8Q7kNvwH4PScM&_nc_oc=AdorgStGXhiQgxptRd0gW_a9y1czX5hL0VVM4luUnDBlsIV2wO3NAorcLJZI5lFsSTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nMIx5zpKclhv8TO8QZUcNrJRiahhZQc9Hv31BIZZvIw&oe=6A37ED75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGI5ZFytaQIQ7kNvwEW81TW&_nc_oc=Adqj906pFw5oWHnNj4HK2OX_sRW47EdZlMyQNfUygnKnFnyIgNMwy04iEOtulwjWtY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wQiMeoucDw7OZ2uHPHKx2VWUo1fWVKjAUBbLtyNctuQ&oe=6A38066A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omypJWrkIDoQ7kNvwE7eNsV&_nc_oc=Adr6EOMIVNyChrtKN3aJMT6SCCQz9u1vSZ81Ls_SH1pspXpdIxEVBtrreP3vc6ghB8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ImO3y2e85WTtWcIaXsQWO3GYJExbp6eROorYFAMUFXg&oe=6A37EBC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdkkOqcps2UQ7kNvwFgqp11&_nc_oc=AdoGpxxStS149BSo4zJ0LAWozLIb9Mi0hptNXDztf5reTxSKIpNVDyMv_9z_
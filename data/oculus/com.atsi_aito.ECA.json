20f&oh=00_AQK7PhEuq46QHn_r6B_tpwqbnSfuGbQGsq-HoLg-ee3nyg&oe=6A98623D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTyXFYV2TWoQ7kNvwHeZD20&_nc_oc=Adrs-wcCSakeLdNvH_TxN8tSUi4pk_L7Vyf8O8IEoRHsYuZAxUmbNLCKPjp-2JMEBcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqdczgteVoiEcogsVM8UdpGSnOyvPPNvc36BwuCFgbJg&oe=6A983956"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89M9DYNimoQ7kNvwHFqTRs&_nc_oc=Ado2NAoIndWJ4Bp6EcMe3eyUleRPVCWfJ_0MMkjzhZg3HOr4KlNeQmsxOPKWH8OS2bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3tewXwGr1WwQOzMSrlHgq07h-z5VRliNbcbIy3xUwsg&oe=6A985C92"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEzwQE3s0OEQ7kNvwFKhVhX&_nc_oc=AdqSH5AWDTPpe1khzAbn42IaQ-eDG0nJFGERzLnJq7YjkfXRq4Vm4Aqh_PHzxWqQnCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBdZ8RGs8OQV6SQJmE9Rq2cKbpOPqQsNXWR0q1mOMX7w&oe=6A986335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWUekfg1hUEQ7kNvwGNu8Xe&_nc_oc=AdqwW-rZzv00bnEnKBv2bf--UBr6K0P6Xmv2gxiy-HAVX4jjaLkWrO1C4Ndmwfiye1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSGjmKOoip_dAjumFSYdG-T0fGcmqIg6nnIN2WfxAULw&oe=6A9843EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF0aaUpluMcQ7kNvwHsEBeb&_nc_oc=AdrRB5bgjn6WKsAKEn8ToHJHydzSKJQ98uVNNWN_63C8wmdDbu-qOM8YPyrvZcQBU7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIND9Vp9hThIhrIS-Ss6xptj5so4Qd_SSK8NENesm8e4g&oe=6A986187"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUWg5rYAhD0Q7kNvwG7nBdV&_nc_oc=Adr_rNfJsTbyLwUu5Ap7G9vwgugFcfJfVANbPUuFB343xG_XqYqGhO2ut1Ua
20f&oh=00_AQLZPcjBk55jYkMImqo84UMEhlR5drYdAlfVAa-731UtCQ&oe=6AA6AA7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K3IKl6tOs4Q7kNvwFouPsC&_nc_oc=AdqwO5_StT9cSKp7RyUTwwi5dTYhaB8ukrQJqyjEJL97hHSQzF2cNxETkV2dO0k-N8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo51CJpau4aysdc4yM0cXKPjP91_hFqvxUDu0gJ5L-Ng&oe=6AA6B9D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDOv-yesaxAQ7kNvwHPELdC&_nc_oc=AdpBXB4HtWMjTOMHOGQ4bbBYg5sylaBFwpFjyyuewIaxG6KIR2OahXAUDcyNRNbcMIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiFGN1ls43BaLl7s0EfuCG7iST145sQnoI_QokkzabQQ&oe=6AA6A4D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j7V_JgZF80Q7kNvwG31Wq2&_nc_oc=AdrqoyLkJ6bDX4HUxldURLS1jyRKeM5cu7o2Eg4lter-qyb9w3K2yDD472UMD44Q3Tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIShHm1T2A5qLOTHju4WMYI_qdnZdr0epKmQYXZs6GrwQ&oe=6AA6AB75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md19So_Jx2YQ7kNvwHbilRz&_nc_oc=Adpfqsk98wl90hMWldtLGqmzZZuHht8VEl9v3BrWN9hB4oCfksS94k1hW1vxkHY0WfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEAGos_DVWTf_QU749ewv5tOO8hOqXU0ym7cQJwtu3Pg&oe=6AA6C46A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEbeBMJb2PoQ7kNvwFW9vOC&_nc_oc=AdogYwuIsN3X7Hk_saqUnh7Wmb1YR6JbstSmru1zC7FBBwJqNcXBfpqV-rkfuEyZOFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKpMcBGegyNUjszA3cFzu42sG3BxTVJF0yphU8NwVf_w&oe=6AA6A9C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=can_2ZUW3TkQ7kNvwF3kpj_&_nc_oc=AdpBnJIf8CJ_pejmRABJxkPxrRaQk6M3jFTjmHYcGxk_7vSVX-JWcGeEsMLK
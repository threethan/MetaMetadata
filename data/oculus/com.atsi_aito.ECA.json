J0r54uwRt8vUxKOX-MiaJAFw&oe=69BEA27D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTgzn8De27IQ7kNvwENnN25&_nc_oc=AdlOTJgSMrBAJuy_zO_ZxDw34_4Ko1fG6b5hv-hGLpgz5QwXYeZLeP7asF8CylQ1nhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy83sXKEomZUdDtRofwtTYP5BseSOxLduYGanukPdPa2w&oe=69BE7996"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNSlg_aIq8Q7kNvwHDtM83&_nc_oc=AdnWsZn_fJad2SGRESQUt_b5X0t8WXca1CBLf-fi_UTDdrbFY1S8TqTIWadRdcoWbCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXHwUkww97IaX0ZlisbFqi0gsd99Lfn6aqlE7o7Idp8w&oe=69BE9CD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKPdJoGB1o8Q7kNvwH13ILd&_nc_oc=AdmeP3w0EKf9QuSNehdFXBV1LPpU1hdjAIldxk_4yZBHYkojNoMQc_Iq8x43CDrJfg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWvcFrh12sj79p9m6R6CuFYk_dIA-ih8mdZjw7NLV8cg&oe=69BEA375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ag8y-B5JkQ7kNvwGo3h8f&_nc_oc=AdnGziHr3yUd64tw3gBHkCPS-TkkaasA6GmXTnTe_owTCVgiaeDa0naVklqWhOvjDb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwI-5OG0Zxku9aLtfLa7QGZWYme-mp_iYW3aX4KIP63iA&oe=69BE842A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JZsUGx-Bp4Q7kNvwGnGprv&_nc_oc=AdmwLccfUXgLnQi673IbH3rZHW_UzUAkkpVxRkFSmw5Tql_HbXYXCYCNwEqvabpFrOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQ7HgyVuTp6ceDJahCs2odDActJGUsrtm1TFYnb89zAg&oe=69BEA1C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6Na8THXDAYQ7kNvwG4WjDp&_nc_oc=AdnkgQPq1JV3QQeT2kGkLTmIV-NoPXJHHwTa3PnsQOm1raezZmrt6LAbrF79Z9IOhPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.co
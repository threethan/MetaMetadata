20f&oh=00_Af6k58g0JZ2bx3OR4sklHXNr7WxXIqp7APEqGln6sfaBUQ&oe=69FC98FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loCTol3lPhIQ7kNvwFbjXmc&_nc_oc=AdrDrKcWHI7hJbMjMtXPVvuGM7XT36v5FNQF-6P_hHL2RZmWmoyV7MtPNVcQSNvC9zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TSX5aA-yfHrwmI8VWO3A9MZHSMBAx6hIDsAIPe-S1CQ&oe=69FCA856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wboqte3-e8Q7kNvwGEKtGd&_nc_oc=Adpx1WwWgS_OAkUcQqfzUnhSOqe2esHzqVrYJX4HNHlvocxppOsaxgDnzYMUHrdn7Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fyl_4wuCetwCWFFbfGcKXa-HylT5DdObYCCv8oo8jLA&oe=69FC9352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGio1LwZ61cQ7kNvwHT2D8l&_nc_oc=AdoFmFgOhRNe54s8KlAUablgj6tsChDdOO0uTUgnmQVZq_HEqdEJNI40RPcTW7bIe4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NlLpoedHmWOJFCadxxw1NvNZn7hTVDjV1Ne2sYKSWqg&oe=69FC99F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuPGFSEj1UQQ7kNvwFCFBxd&_nc_oc=AdobDRSpvfsztZQeILzr6YlSFiAaKftboxNsbNrp3-XeF1HCc7IS4A3bMJBvyqQshVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bXMVL9cg2BPxGbkun3_s-4m5QOjS6RhCf4w6LwXEXRg&oe=69FC7AAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqyG6ra-urIQ7kNvwFrhg9A&_nc_oc=AdpEGCbneqtBk8phSlLRoSw6w_EEp1rt2RoScmfVl4xR5pcv0txKlit9gE2s7R0oF-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mlbG0piAqOQUKSSUil4nTYAyGm4CNGl9EXSFoGj20jQ&oe=69FC9847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rzhsbUgApgQ7kNvwE0Pxhe&_nc_oc=Adrdv7auCfsndYJG0XVsXpk1kR8qFIIKHNspEljwiQcZNN133jGvk7XbPR--
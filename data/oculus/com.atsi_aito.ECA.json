20f&oh=00_AQJBe_fbXs85xvwfG1_lyCPsRfmPsirqu4CWuOEnDHbmjQ&oe=6AA558FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K3IKl6tOs4Q7kNvwFEFPlK&_nc_oc=AdoZPNKgDr2HnLpaXFaP0X7-QsgW-h9Icb2xz3xXEPZxbbB7iWsoDdUYpe7N7NaYT-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl9qyTVgAmCW8QPtdYj7V06SknggR3kxheXyn6Wk1v7g&oe=6AA56856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDOv-yesaxAQ7kNvwHFD8HU&_nc_oc=AdpdHG0Tll_AW86MjaL9Kz3PIA8Tc-XkCEYoWC8AQYGvUJefLYFcBOEvskdrOiWR4ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAG-p89fFg1-5FM5N9tvxfG-oLu9XOq69D7UNGGqcqew&oe=6AA55352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOH7XUeBOAMQ7kNvwFtPlGO&_nc_oc=Adq6-3RWupDK6l2tjAvwSUxCX3b19j31TnGM3O_7Z3py2USLoD9zlrQ9kRlMlYpOopk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgZHz1O0GFN6uwb118MMZMgickM1jFjTqvHQMt6nNTaQ&oe=6AA559F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md19So_Jx2YQ7kNvwFJ0RAM&_nc_oc=AdoQy1GkY2zjKWB67D4lR0K4pD44mUVdfDeHy1a9Y4NpAmiWssDBzJBTa94TDKbjCnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkZT2MbWxnBh5nKkgpuW9ptTAYFSN62UZDSBBSbca2dQ&oe=6AA572EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9i1xzTRdpAQ7kNvwGW2X2z&_nc_oc=AdpR_h1CmHC04UVc1LiEe5id8MutMkegaGjNIaP_HJ4HDafXdZSAWDAop5B9pGMuByA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQMhjwCjg7yXtFv3kjU5sIAwo0yfzkBBxOONLCIxlcag&oe=6AA55847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=can_2ZUW3TkQ7kNvwECRAjY&_nc_oc=AdoUiegsTwNDJUlrv2i_Rrms1RhT4qbzV8WAwi3bgBf2Ss5PLF-AP7j7IVsd
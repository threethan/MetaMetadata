x9b_5rh_0ajdXBKPQ&oe=69F20CFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNwhTcrXxtwQ7kNvwGvY_J9&_nc_oc=Adpc0JGH_NXagpHpjM7J3l43pcCv_vGJewdFL-sgOCXEhj35UEyW5uAF4k9Tq9gqjCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2pxu-6EiANkXgyxCqFXAsRRxia0b5Rg7vebLe_AiXooA&oe=69F21C56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O_tEe_zbGkQ7kNvwHk5IMg&_nc_oc=Adq3JjEHT6bdD3Nk3dvjEg4nm2Bh17eBNHhWJyu0SV7d113juGvt6cEbB4iDRiRIfxQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NLi3BjqgtwO9CyzK1z6JaZrLprud8POyYLnYbYI-g8Q&oe=69F20752"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myg1G1lZaFcQ7kNvwEVPDDv&_nc_oc=Adrhzlx9ej5tun2LJ2jSCMhgAzDTTUsfyiablbbX88r2W_B2k8vrJaoMiM3b_0PTU1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-twYjcKSe1roTcYcmn06RT_KTmpdFHVwj_UP2QpZ-IQ&oe=69F20DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYJgokbbDaUQ7kNvwEqCesQ&_nc_oc=AdrvXUiTlgcdJpquYRSIFmVEYsJWJ49B-lApx9f2yMvl_FyyVR4mA5UJ6Pk8B-OLMYE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06yfm2jyhc06dOORcXYJDLkSnf8QQJSggroovhNOCPQg&oe=69F1EEAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXQatVaG__wQ7kNvwGtiOyZ&_nc_oc=AdpGw1vyp5fSo06lz9x-TlmzRqW6y51A-aND13n8f3LAf1Syr5DTlFUfNDXI97qwafI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3uF210flDYfdcjtN1X5zwD1wQKw4aTVeIZBt8py9bTUQ&oe=69F20C47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TRel61oLc4Q7kNvwG6stFi&_nc_oc=Adpi-iJPjJtfiS8GlF-l-AIiF_7x5-rAmtDbdMiNH3EQLibYYNMnkbZPzrcXo20MrmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20
20f&oh=00_Af4sWsOLRbgOBWPCLJGoZ5c0D6XCYXAwjAk-CLwb4Kxceg&oe=6A1999FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II9TeT8hRE8Q7kNvwHwm9qN&_nc_oc=AdrzvNABCbIseJxKE2QMqyiedAYGQAZL84U0jsZLviFZ-opXWZaHTd4ZDVG6zMFiCVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pRIQrdPCNZGeHBIQ9Zm0A0VaO-TID0Z1R3Xk1lXJ7xw&oe=6A19A956"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NVhBZSslAoQ7kNvwEP0-Nl&_nc_oc=AdqFN_zCXQ1jS1zcaqIkYiAiaKu09WnXDT8XlfqAJ8beoWW9lKNxQYQRxlrJmJVj2YQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6esp4uIsXCy2bxFsEVoTczoBdY0-WPQHBm5xHVi7m--w&oe=6A199452"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3I_W_8PYusQ7kNvwH4Kob5&_nc_oc=AdpjQ_FV6DBxvIBc58uaVFELEcpb0UAdfKWtce8Sqx8dGZ49SM1uuy30R5U6z18hhNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fON7gC-PRGiP8CujpN9-2p6cxZTnCUqnhOmrY0hmuVQ&oe=6A199AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zMPyWQh2TMQ7kNvwEpQ8Oa&_nc_oc=Adr-u_nfdTSashEq3thPH_gR0Er-NFbH-dn6Vd6o9yfxVSePctlGvd4WijEAnAzX9nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50K8bqmGOegGhTdTGYjdgWTdFw0S7faQvFegwbcYaYRQ&oe=6A19B3EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb_JcojbY_0Q7kNvwEZecA_&_nc_oc=Adrrp3OStMKLyRIuM_J79WfpTl0a1Z9cQaJa11ly-JZ3s0iAsykqk6uAwnbQyYQZkPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af478QVvCzOsbf-tqV-dXRMQ0TOVeyXERiWQCtNIFLwj-w&oe=6A199947"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaFLGcBsfYYQ7kNvwHeEF2I&_nc_oc=AdqQgip3Q0RXp6W-2h7RmY8rX2RniQjxdbImr2VYKDJaURp4ulDEbqRL_wzT
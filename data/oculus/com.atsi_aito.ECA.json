opLR4FeNdxfUq8k6PeUlwYXw&oe=69A98A7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Xh6gRTbBMQ7kNvwFkZ-5U&_nc_oc=AdlD8qQLnnYRwUgUhis-q4ZqRTYLuor74R2HZeRlY2aQ_orE13ZFNoH95LTHT_DPuZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftchbwr5IxZb5YTPZH0FWGRe4eUepMc9NAnZmxyvikj9g&oe=69A96196"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpxHFyEtn1kQ7kNvwHwdl-y&_nc_oc=AdnHPlqps5OvjqCuV3-w5AI7dhKhnieuxfv0oo-Vo9_h4ATO_1OmpqV0Vc0-9CieNeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPbYYXsUqK3x5oDYtTAmf91ZsgqH578mseUFwGtRjyug&oe=69A984D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1eSvxMA9UoQ7kNvwEccRcz&_nc_oc=AdlrziH31JA2NeV1Lm6fm06rwuACQ5qlv1yRoCzKoLRQ-uz677VF7w4djAD3MXAM--k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqwDMbcxdinbqip6-vVfcDfjKJV92BrxAlTZ00vg3W7w&oe=69A98B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kOYQKCNH1YQ7kNvwEEy-cm&_nc_oc=Adkek5kQjS0UCYaDTd8P1ccaydUIPFlDXlI7l4dmCy7KI2V9A18m6fMAmCEJoWsmb9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTA5LlTsZYk0b3Gor4QogJWa00LhPMCc3WndVyozKIBw&oe=69A96C2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuABT_FWZrkQ7kNvwEMixL6&_nc_oc=AdmESAAbgAjE0CgenU1K1S9sBIf1tJilmSlnxaJo_p6UDdbu9QoWlWrdR1DxWbvW474&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs4lc71f1rzRcGOvMyEKeG3CjZd9mYJuPgADXjEhL99KQ&oe=69A989C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1GcWkTDLwQ7kNvwGDe__0&_nc_oc=AdkPEaD8VsJf6zrqxHc0RK3UjcV5c20dT-zZhi69zXySZqUKdvzthu7HaARtnv5jZPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.co
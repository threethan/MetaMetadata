20f&oh=00_AQG4iWf6PXYuPCvUWJQtgnleBs1zhpD04BhsmXOC6fYGyQ&oe=6A733FFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxwr8KJQzxsQ7kNvwGvRQAk&_nc_oc=AdoakSOA54hugGo5X3a_VDbURC06zUBfJKTi3nKrAr9I8eCLX47911nMJ637xCG13_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpDtoqhPD6DOby7zL6JxyPCtbqHVOQAVCZsI_hF2Asvw&oe=6A734F56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtNl4uihfjsQ7kNvwGn8OX2&_nc_oc=AdoOL_X3W1K5M305WvxkxNHLIDgVs3BTaWQO1laIcEMNny0v93IFaGTo0R8DVpR8DZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEarXm87OFfJHFvKcT9VE5D3fsOozBHYm0EoHvqhu62wg&oe=6A733A52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C39lgebTeAQ7kNvwEEWbg6&_nc_oc=AdpIw5MOBkHbiO52nW27pOWcRmNAIe-ax404r95i-NWCQHyNQ3QcmnAbajW840O_tN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhKXF0jBEhbDWCIsuKO4u_Eryttq_UdNjMfq_NkJ-dIw&oe=6A7340F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbL-ZxjVyaIQ7kNvwFsXTeb&_nc_oc=AdrNAYfVYFwSxAWTHDRJ1ugzh9GZvnuqSFdqnqYObBjO7z_trcXi9U-eZxf6XTzQl94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGehOMN9cU_UDk85ngRDPVNVlsAT9kB2YSdQz99q6CgJQ&oe=6A7321AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkLiUPfCojMQ7kNvwG-yCaE&_nc_oc=AdpplGpgrwEZhNLFMG_Otnty66jOpAIFbMknJjQekkdNnrewZvN5iPKisJSlPy3NMXM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKHkJrBye1zJVUzbnthEPK0JQFHDH1vmiqiLetLA120w&oe=6A733F47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnGBtuLRFRkQ7kNvwERs4kd&_nc_oc=Adq9H6ykQAyM_vABAjUMxAMNZYHBm7bz1UayXTXv8NTu4K_3_vAbT3Bho5ZE
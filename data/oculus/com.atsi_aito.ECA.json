20f&oh=00_Af73wk22b3TCQlOnuUtZzAjoDpHOO773KoGAjlmxOqvjyg&oe=6A1AEB7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II9TeT8hRE8Q7kNvwHhaJe3&_nc_oc=AdoUHYUDsYhJhmc-JlYnROzX2oklGFukHfx8Je55ViCm_f2MoFT5pRNJxV6NsHHTla4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qw5UECz7YsVAZVhhyCIU7DaG34mZTJT3jO1XoxmbzDg&oe=6A1AFAD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXycFB_ywDoQ7kNvwGQfXGU&_nc_oc=AdrSneWo8dYa-1-ycegpTxB7ain9qXSYFjGAZfcPWPJEtSlpcWwhlTyiGtJ8DT6YGcM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UYmYZTau88wpAjk0u5PH58T0XFFmf5FLwaM4DYr3QrQ&oe=6A1AE5D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3I_W_8PYusQ7kNvwE3Hnri&_nc_oc=AdrYjCKmbxuNkZQ7C4gkfzcMQgTzCXtIveKNZ_52PbXKQF7mfOuQhrZ2gD8r7bRCWZQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Y7BUuXIVwXFqE0WS7MVTLld_015MM_BsGayW3Za4aQ&oe=6A1AEC75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYeEYxrqQlwQ7kNvwG75Qc7&_nc_oc=AdpmO4sO77DcFVx1u4nyTfeHv0zJwZet0s4rsbIm3Fobi4tYzIxNINOn_dmIs613g0Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jaX7kgdnp0LqPd1oscIng_giQU77Q5_n0O_zJ-apFqw&oe=6A1B056A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb_JcojbY_0Q7kNvwFi8Z8k&_nc_oc=AdoHz-If9YKH0cZeMXvDXI17HKE0W1llU3afhn6Xy8MqGeepvLnFKzIWl9IeQB8zs6g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HRsSHVTtFJS7Rd3GnMzOT0ToiJ8-c4YuJdhKal_D-Bg&oe=6A1AEAC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX1TuonhHQQQ7kNvwH7c-5d&_nc_oc=Ado_mGkoO3_3UA9iMwTBXCQgjIKtiNVDWSsIJtQ-QLUUV49jm-aw8xPy0EKl
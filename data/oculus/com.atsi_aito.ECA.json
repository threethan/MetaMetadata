20f&oh=00_AQBy9pN1a6EoUre-CNXIoo7EKZn97oJ5Hzb1aqByOZrO4g&oe=6A5F797D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU7k9Oa24SMQ7kNvwEyPsBN&_nc_oc=AdpYtKc1nPrl3rWa_orWhk6i1eb1g_R0RYCzBcXbKG4UTqzZFX3VgAVyoGEsquhO1Fc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0CempwCYZLfBF5Hu0YHTRJ4ONSLWU3gNfItdvZ6k_ZQ&oe=6A5F88D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bQNrtpVoo4Q7kNvwF-mvLr&_nc_oc=AdpL0QjRVI4oQg5LdhSvSmhQkExWFUuwAnqA0_MWVjpLEJfAndaRBiQkAVMvDrc5IhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDJP5tAESjM_iSADtjhu4jQlw0ShDVYW-Ha8jyEfMGdQ&oe=6A5F73D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf0BR9YwZeMQ7kNvwFbzPs-&_nc_oc=Adoj-LdRhI0yWvKAapF_HFmXJ1Gdr2iiPW3RNJP2rxirW68_OXZxQeeXFgrnmtUYRIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMWzsqoPJrlkr2e7yyxrQKkPMgCiHJQ-uefFI0b09Kaw&oe=6A5F7A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8S2jMlf_vUQ7kNvwEABz04&_nc_oc=AdqhLPNqLqrbqP8201nBTjF2lENb0VDYBk3T8Si03tSHuw6LnLnV0k3YGiBfg0NsS28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhrPRXiZokPTCzv4x9NWJ5dZ6GmcOL6bMwNnTtu0Tf7A&oe=6A5F5B2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uQb9Rhqh4oQ7kNvwFkUlgt&_nc_oc=AdrLlakHtRiUO0L4ipe4Js5735rN87fljf_u86-Q00UHQPl-WpfUMkw3WlQaM6EKmQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsd8Vw0hL0ZWuZI03pQ80Gek1yUnNPiOebIsnGkfct0g&oe=6A5F78C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mom846MlJwEQ7kNvwEpsw_i&_nc_oc=Adr6zyVnn01IM_82ueyADmPZHzuHnQ_0jqlluYB7LeriYCIJqasfPN5NO6Dl
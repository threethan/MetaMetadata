20f&oh=00_AQNqozzBy5PHsVX_5qXP4fLnX8mEgfljnTxm-SNKG7Ia7g&oe=6AC259FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1863bCoHoBEQ7kNvwFm0eKw&_nc_oc=AdrqhY4aMpmiW6JX0DMrY5N_Pk-YpFUn81w348xU0HlaTTkq4JHdlyr2RFwhoHKyVqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbPU6V2AsCzheh28sCOZ99NpVrXBmxvw2qGRRC4qw9bg&oe=6AC26956"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwOiGtdQYD0Q7kNvwF8yhna&_nc_oc=AdrUsqeHpheqGH5YNacKkkyLYo1Zr3fosDdnG_NRlItiqCutN4VP9bdQB-FH28tCvVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF1tQ7U-jrV4F06PeH35HXCXwX5y1N1UtblSNF_gQH0Q&oe=6AC25452"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRcdLjAzx6kQ7kNvwGRoClB&_nc_oc=AdrCaG4MahS52fAGWCTU22ODDGHnAEkEuWQTGs6-ZZbVv0paWebiqn7ZmSZlSWYnjOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhGU_ngdWGoUq4NC5fXSvZLJ6i4O0EaaRMRQZnY0JPpQ&oe=6AC25AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCHD9XuJEYQ7kNvwFYKVJO&_nc_oc=AdqnziGfyKVa7bmQhKE4huHC0vt2oY6ox33yANge9LI9iBbzmUxhO9OSOUGBB1t718Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxBc0rIUVdyeHHEmq-YP8eFCmfkimO5-2QHjq7a67Yrw&oe=6AC273EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oySKNjrYatsQ7kNvwEvyDRy&_nc_oc=AdpMfqxRRqNr0G700k_jSsrsVdjRFEqDXQkkIbhS_Iy7smp5UAfQ-ceoaqkvaECuAjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ-EqKXM8Q0zo5DXlN8z0L8gObyg-Lki9hukPfKZGhcg&oe=6AC25947"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX3TM72rx3QQ7kNvwFQUXVT&_nc_oc=AdoHp7euna5cgCqrdQ5AuVJ212G6GlUTCBMXEkNJINcA4dtatEcsDXSn4NVS
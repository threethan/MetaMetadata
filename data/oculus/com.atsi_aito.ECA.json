20f&oh=00_AQGPbmYJ8pwqSW84ogO8ERAdEZ8wFYMm27Hlo8_6EVcsbg&oe=6A8AC2BD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpOIckVwKRwQ7kNvwHSdPZH&_nc_oc=AdqNalFl6uAMmJNq-BFjWn8pUFd_iTZ-egPAt8w8HfEUhR53_z-wCt_A-voISG6ibw4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNXSqCnpqBQirVf3ZLQq9r-gb3I-JgA1NMHtxN2KcroA&oe=6A8AD216"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY29dn_vPsUQ7kNvwH7kaC1&_nc_oc=AdrINk1KKFSYLds9torwQNynFbg-syICKu1hvEVAAq44f9AzQbMt_PXhhCav5tOeVKM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAO6DG61M0gH8Hye3Md4ZT2702przsybP1Au-3oF2i_g&oe=6A8AF552"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKoVlGLPX_UQ7kNvwHog773&_nc_oc=AdoFlUUxKcYynthp5i4LKUDs95qA2gCxTipptbrAQN6z4uDatxztzI-nzlZjROWiIK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELv-5vvVftil_yer-INS20HIbQO7t1RlJgf1kGEBERkw&oe=6A8AC3B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADhKXJ9Y6woQ7kNvwFgYnK1&_nc_oc=AdrOS2byddnAWwN6dBkcPLfB3rNmZji9QdWFYhlk6VNm6_s75vJwlTifx1dG1Mbvubc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw3GuLJ1RBxXxQW1zFC_KQe03Wt-wrxuIUiYXb__c0oQ&oe=6A8ADCAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFDgKAWnEGgQ7kNvwHsmrUY&_nc_oc=Adq33EL-ybJPFCypxvrsVnFgb4SR1GPZsbLl5uyKAh6AiHNK-X_nN_d5oHuJ0EwFH1g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLhGleJ2bQUSVkV_H9miGVmzPev860UJwhM48IWrClcg&oe=6A8AC207"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFLtM3fcfbUQ7kNvwHFxu_0&_nc_oc=AdoXsEGwfg2zLrKxJLflx1WEB5AYFWb5eymrQ5AXaNUI0pSb-yzfvVjRjj1b
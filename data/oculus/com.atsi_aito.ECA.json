20f&oh=00_AQBW_VFMamysLMGh2C5erItaVr0T--0H9bKMM0HQwvSbTw&oe=6A68B3FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9tYyum4L34Q7kNvwFs50ox&_nc_oc=AdrB48A5ZgF35T_Pv3ZdyW6RDH_MXpwnX_dpGTEza3s84AAfOl-1ApJ1H_z95pMyOfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ8U6uJ9xuEmbgYXUeprnmJTScfeVG3q9blN4OwCgQTg&oe=6A68C356"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjaHrSI6gqkQ7kNvwHyDtFK&_nc_oc=AdrKZQeym8SdHZ9J_T_5knvbWpSvsDdybsLxAJQv_ER_R0VfIFA-JGOUaFGKZxoP95I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_X6JuqVL6oamTs5I1aDu53Zam5UW3yYxBlW1-d38qYg&oe=6A68AE52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLQA72onBQQ7kNvwEiLVLE&_nc_oc=Adqf_8ERgEEhPXdNMcasGgQM6lbrutX6l2kGHlHOL4vr6OoHSbBYzgNM9UdYbhaSB4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcIOzmTbSxCvFEmFgaD81nTGHNtW66QJvtlF5kKfvAyw&oe=6A68B4F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53OMff96azsQ7kNvwEE4PCa&_nc_oc=AdqvKqqK0ZMYZ_xiZsxx7WgrCyMHFlUOmA2O-2Jd75TUwWdBBpDtakalcA9EByecp7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmbVRnsfAyqY7jmjGnHRsrGc4EcKKBxzGPceSPEp5D4Q&oe=6A6895AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dmuhgyckc6EQ7kNvwFIr3aO&_nc_oc=AdoCYEEXDclP5hZOMv2gRZCxonfPicddLnG1O8nGZfzHXLexMsRQWMa0jN2ZmaYHlss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzspYbpEv6KFnbRoU-kD455FP0iEWG7fAL3CJp_Q2_UA&oe=6A68B347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3fLQSplFeIQ7kNvwGwzrgo&_nc_oc=AdraWSL53PQhhvHFQ6gHAi9SRrL32lnR6LfeF86u6ILF-ZKO1aC74fGyyfPd
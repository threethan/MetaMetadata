_4pEtNKjdjLUULtqPB9_NXUg&oe=69AD7EFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPX5pg9V5FIQ7kNvwH-fy0I&_nc_oc=Adla0EU0c1regK53Eiik_mli1tajElMbfouGtKOUHBzPSiDXfDcTxfAneiPWHquX0BQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQPcxDRrHxaPabOeaZeEOeUFneIOrQCFyz2vPt3N15xQ&oe=69AD5616"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6gU-tHIGpUQ7kNvwFa0OIZ&_nc_oc=Adka7F-wLtFbYhYVCnP5NfPqmRrOpXyRcCBASGttOtO61Nr7__v6mcdzM_XxWzSWF4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHzU5pUr_HOcEI9Ks4iPxcJnxl9PYhF26hpEJn5nZeRQ&oe=69AD7952"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNCNXhez2BgQ7kNvwGbmUks&_nc_oc=AdlPxWwuXhD3_EtPwpPtupHXoKAHxB98AMmkLFwj9pkUbKYSTSPpmuqgeG7FFHblY1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxuu3XsdNm7L8d8MpTXR2rmko5_8bTqBcaPl6yoeqv1Qg&oe=69AD7FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ywB7k9ubssQ7kNvwEVEOnR&_nc_oc=AdlYR3_fysg2tfisd-1DVvma6wjYW8-fAE0tsQkudbBKCWIvVmsgeBAJsnQ-pKD-fBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaD3rPt_0Szk4cm9JotDc0q3ltObTEHKlXu-KWdW5jIA&oe=69AD60AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKmtVbjPzYcQ7kNvwEupmb3&_nc_oc=AdnsCGeFXSMTVOZhG7GPfBXMuNxdaVk7btzhFVD40e6IXrNDeXfZ4cAADLWQ1p2onSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDPWpE_0TzKqf09_X6jFPaAPN6ZPCjpd-bynfElTv1Sg&oe=69AD7E47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPfZEchChdMQ7kNvwHILiCg&_nc_oc=Adn4omX4pnoaRiIThPLgHIDHVopSOl5QVErYGXww2ERPy-H9QLfZ44vLxazqAJJ4_cU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.co
20f&oh=00_AQAEIm-gac7yW6ALv-nskeQiJQpdMW4E1mBZmrvvNFUmJQ&oe=6A539BFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1djrxd7Kt4sQ7kNvwGAKnDm&_nc_oc=Adq6zfig_A5_JMWQEzbLyrMTVFJpOW--cDYBQqtBy8M_85oGTL2GPkJomF17LWMyr5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv6gXX1ERZ-I1owasnFvDo3bUVXewbxxALdN6C72Ukhg&oe=6A53AB56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRnEHwAnsykQ7kNvwEI69k7&_nc_oc=AdoDT0z6nznfsAHIQBR65w8CySbVMWqYV2oB4fdIfX1nXdF0u9K5dol0Qt2W2vN4KkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKZhQYoVR54LURE-zu4Bimfh83BZBrkIeDW0KRCYDJXQ&oe=6A539652"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abD7j5hs1ucQ7kNvwH41Ayj&_nc_oc=AdqEZ5087dIpBsBBxkfyYaGXlXtbZbCvoqI4hitZOb4Rb_lBNRsHCWTGDesE7C0DE_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0h5Kc-cX4eKSQan1DYHLIhuYGX_VeN6-YzfHqVG8N4g&oe=6A539CF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZj7a5TnmRgQ7kNvwHc8GVZ&_nc_oc=AdryUwJNBCTSaJpZCWeWxBfxUtquV72tHcWGyZTJVUNTGqSDSjqtSgZ65tTA0b2m_zA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARbd7tUsL5r1TVcjC9Q8JqPnHl7VQVsLdSXTUqQAugmg&oe=6A537DAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4-7dOkU6w8Q7kNvwEbCBel&_nc_oc=AdrA964fu8s8zA79X6E80HviLAptZOR8r9OKDfvovyjLqbvNbIDietgme4dLPRVCMfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuiNwHN7dCSBRH--6l0B92ISvnFq3wwACQPHTQ0plo2A&oe=6A539B47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKwfHOmSZnsQ7kNvwGnh1zl&_nc_oc=AdoAaOvQzhGWFFNHwB6v9rnEfCBI_5SI8gjp7tv8kAHxgJPTZwFCigLDEYJZ
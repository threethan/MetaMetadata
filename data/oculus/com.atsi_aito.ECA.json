20f&oh=00_AQLQR8Q1A8IvhpaJOw6-A2r3txNwXRfXMcBgbiEeApTnkg&oe=6AA7FBFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClOArKTuOXYQ7kNvwFBPnkP&_nc_oc=AdouVcfVKfbhLvhmigbMRRb-65HDmP10YzGMwnDjFPWUn7YQonQSeVg63JEtw_Rcrr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwWkjJrkWZs6YOTHyngl1Ci1B55c3ecqYw35axJUkm0w&oe=6AA80B56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDOv-yesaxAQ7kNvwHwu6Yn&_nc_oc=AdoedzSZcL9jSygQ8OxogQx_Y7yXp1UbysB9WnxExH9Z-1wbm7W0MrYh6-lebejibg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe83WXEdWgDrzJ6_FEUr4V3Ru9KUUyfkNN8Z6K2-cYpw&oe=6AA7F652"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j7V_JgZF80Q7kNvwGJE5KF&_nc_oc=Adp-q_JsLuWw4J1ZdQsOUEWHG-cKQQ93vajPurAsU4H_MadvBaGec5UPbCBQExUuUNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS7rab7AWncZEkqze9yECF3MgZ5_o5E5t3jMc5lzpZ1Q&oe=6AA7FCF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md19So_Jx2YQ7kNvwHppyNh&_nc_oc=AdrN5FjQv0EILUzEjuhjhUqB0Bb5ISKej9OXOujjXZRoZSNpQiBPG2DM5haNh9wfxCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDKYxJHYQH_yhGMdTlm8c0EnfxhFd7jb05YKX-6MWcwA&oe=6AA815EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEbeBMJb2PoQ7kNvwGrGrcS&_nc_oc=AdpRSJyNZsD3vFtZ0-954OQM37c7FnrYfcuXkjto_g5Q8cSfmM83bAl5pnMaDCkWCLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLc_uRQJJPQIKtCgjSjNVb719e7AIwj26vD25KBWNkPQ&oe=6AA7FB47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=can_2ZUW3TkQ7kNvwEDIbXU&_nc_oc=Adq9f4dRmGEE_bFYN-IUzyuOGkBg9upZv0AKQQD27g7S0kMQCICcMi4psJ1n
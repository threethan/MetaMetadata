20f&oh=00_AQRC0pXzkzd8T6pEwtiKQH1AIX2Mth1h7pjPJbszyrX_0Q&oe=6AF89FBD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Ffb16sxzsQ7kNvwH6R9Cd&_nc_oc=AdpNEO_4q0DESlLJ4EaVqZAMthZR1a2zWWKHZjC5f5H-azhajuNRj4NU9myS3gW1CcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYeNDGRvc79ilPGb2Tz4-yLMmP8Dn_sLZxHVuaNpn68Q&oe=6AF876D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aIlBDkbfUQQ7kNvwG0agId&_nc_oc=AdpIFP8-49Ko4LIA_1BZPqAIQKcZTpKLbBotw03liUbhEk2OMk7jihaYFBg-lcySVJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjDBnvrfytqHO6QuHVkG54cs7NYNEMksG6pOzImvCJXA&oe=6AF89A12"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZIzeWc8Gm8Q7kNvwFDJs7v&_nc_oc=AdrH8sqhSGpq1XDve4LVadG24HY3lptDyDvyFT2X4VJgWivjFDj5UuYihGWOh5L7B0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN1bZeKEUFhLSnRSYB2jd6HtFjAjJv0UXuAFiGouQQAQ&oe=6AF8A0B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88NQyZSGAu8Q7kNvwFUDWAz&_nc_oc=AdoUMF7IIw8qupfqVWpYl8pMT-8FHnr5Wpv6qRlZ-BNobhiC5WEGIbYSVL4v5_jGdrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjG0FMJ5185jxpJq17xrG7wuR9ZT7f3EFjUBMncE5o2w&oe=6AF8816A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10gdazYI2W8Q7kNvwFaIn22&_nc_oc=AdrEHyqYrWWt3vnWXaqOVvMJQMW02gjFbbcXqS1B3o0CqDfyRhCfnVx0w3ltPqEgPXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsI7jb_xaeDL38og-HPygk-GgTOd0Q0RTsOYxOm_GkiA&oe=6AF89F07"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU8HowmgTnwQ7kNvwH6i0UR&_nc_oc=AdqAZEFl3lCJAg61yiuyhs5oPRighoK-JdxEthfADGZRFTLSxj8DqK8m7hG-
20f&oh=00_Af8FJzJgT2g_OnZAYwQGt_qLlrmJHkxgpSmwZI7053eKMA&oe=6A2ABD7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-DKfZO3L0YQ7kNvwFGlssl&_nc_oc=Adovv2Kr0IPSmVrcifQ31h3kFxzJGMu00X5g3JFqfK6JX_eR9swrX-AUt6c_kbYB8HA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_0I-IUN8399YLlwQ7HMgNWvne1z5U7oSwTOSdGxqTqQ&oe=6A2ACCD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jr4cuLuBLcQ7kNvwHEVU1U&_nc_oc=AdoiXjI3f2f4WOM4STLRhzXrAcoKel5I0DTg7se1RnZcf_JPIrmYBDILI7BSdFR6Rg4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MgJmPM2YqForduo5cyuTTeKSxSBZ-3D6ksOPX-lCKew&oe=6A2AB7D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0GsTv9h924Q7kNvwGpbH7Z&_nc_oc=AdpQNAqnsuRegytPL8NXvW37gcrtCNz1dxNxCYDGnrMvP2CL8cpvC9uKfspNkzo1ROQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gmwmh6rlaLqKOK4O4ZtQRQI-o1jH57cd8FscO8IUlWA&oe=6A2ABE75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTQHH1Os4F8Q7kNvwH0z7Ks&_nc_oc=AdrE9qrP4fsfHlVS7-G2rB5jxKEP9pSNYiosNYs61hEvqk5RUOUrofqvN_XEeRIIbfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NEpnodbKmcRldPVpxZeUrfwOePmWhHMZYGH1Pnw986w&oe=6A2AD76A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAdqOi5Z3c4Q7kNvwGf8MKf&_nc_oc=AdqVgFQ43x5qOuBGa-8kzD5hUOUrBAdDfRSov_V8JD4pU-CSrh4UZI2b97TLhpNFbsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Ua4n4rtNpjsAC9zSsxEYQuZ4pUaF-yBw66rIGDgLtw&oe=6A2ABCC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyOH9ACHi88Q7kNvwGjLSF5&_nc_oc=Adp9DbDa0sY13kSAtAVm7yx-1-BC2gaEx19itxXumnQrjekTcL8qQCR9hyg5
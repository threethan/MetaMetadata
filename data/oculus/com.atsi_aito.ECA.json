20f&oh=00_Af6QR5br8yfSLFVWTiyte5qNs2INdeGwM9sWsJIfWiAQdQ&oe=6A03307D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdTbhg_Pt6kQ7kNvwHdJPD_&_nc_oc=AdpgBgE7TjKHaeY8y_HoeJiN_8p3DJ1MSaX_H_g1QvotWBY9hUto9Gsmx9kCYyIFbsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RAuWGFenMiX38ypdR2CGwtm7vuYpOpyhj4xrxL_L0wg&oe=6A033FD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnoG-pqZxQQ7kNvwF6yCKY&_nc_oc=AdqvsMb1dyowbVBYgaXP2nMEltAdZR8Zn4NxNP0PH3FvxeoVfSNAYPMJBkZHHXMSIbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af783i9Qr_DrLqFnvViRw8-Q5U5Boix0KKAEV2bulv7XZQ&oe=6A032AD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4TmODKO-gQ7kNvwGmSRLg&_nc_oc=AdrKXbkHHtUCb5dlw8CEgymS5rCdf3KtuYEb_NWYK9Xc-UWPPf7sbOTtdb3vuvku2wI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MA1i4pA_YYA-1y_pcxJj11aR80uLdW-ApjeKtsVmFXQ&oe=6A033175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxKBjvaSY0cQ7kNvwHGeD3L&_nc_oc=AdrXDY4RxjJDuQpyIlz0MpkKGub5Z6bA5Y1ObGTcq8eu93-LgBASUdP_WEWAK9rno-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_i4J4nkqyj6GWXauokkuqxMUJphrMGgriZHOCOH7_IA&oe=6A03122A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwgD7cp9caMQ7kNvwEShlZs&_nc_oc=Adoes_qKVdDSOp_iPrmAY3D6qokRhwvk3PoHZlBxa9Uh8fxcd20hxFP8JaPEDdrC-Co&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ECeZisUlaDgN8_-FouUo5NKnSsJjnwHBz0x0p5czgEA&oe=6A032FC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYJnfQMRXuoQ7kNvwGq3xpO&_nc_oc=AdrxIQ052Xt4-f-T4tKwyzHXd23tsWzzKcuEJcH4mGqBDZ5kVi8MpOR73C93
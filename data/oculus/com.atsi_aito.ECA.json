_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXDGw4E6qVkQ7kNvwEX2mHY&_nc_oc=AdrSGzpescX8F1Ktw8y4rgnv_wmYC-toTbK4Bi6JM0WCeJaXaVwigHzWSZQEmW9JCec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1HvUjufX8hZ7ZA4yriRYu6s7NboZgtROiIwjDoVtExg&oe=6B0F093D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmovoIrPYb0Q7kNvwG2I377&_nc_oc=AdoH8U2Df20jw14mXxGPq6-Lg4FufghCeeBQAOcS00clMm_1aNAu1gD5UYH5wxSjnes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAQzzkECjqAeusspoO8bU9qpMOhZCDxzapATrSXsfJdQ&oe=6B0F1896"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyKbCR37Y9sQ7kNvwGgp2ny&_nc_oc=AdoS8VAV9_09g5eNNvdn3e_nyY0ED6bhzAbDD6u1BwxSSkYWy2lZvpJLu75Igva92jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5f9V4AJ_Lq9ipVqDHfhd0p8UmRBLkpn6ogv89p9RItg&oe=6B0F0392"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN6AMXbekTsQ7kNvwGW9JVs&_nc_oc=Adpq0EZr5mCx9jgvgtj6mcqHb8PpseSHy_RcdaqymzJNDg0PkrcY17KMMWwbexa2awM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbje8pQPysbXW68NZOA_yQM1InZDeu5t8VoR42YYRlBQ&oe=6B0F0A35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwrK_BlPJXkQ7kNvwGrGDPl&_nc_oc=Adqnsjsgqw741ixFa3F08LRgo58Tzp5Y080pbU9OIVAWDj_6q1GJz5zvqhFMSq_kPhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMO8YSdzqERoBOy3Yr1PywUQI9yNoWeCgpd44mRjI9wg&oe=6B0F232A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTKw3_WrRtwQ7kNvwF1ODYM&_nc_oc=AdoOoNrvBjosOrbT3tMPtTXetYG-bcN9T28BRHVaNEZsdXOk8eHcRCwTpLU0nHKorwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUA3ryI3p5ypwZv_kkSeDML2_h4KKYRlzMjJ0Bk9yZaKw&oe=6B0F0887"}, {"f
20f&oh=00_AQKiOYnW-K4rE2umRaaNNhmERf8vuC6Y5D36AU2u4HbKgQ&oe=6AB3D97D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuCVkOYL4rQQ7kNvwGeUHCE&_nc_oc=AdoyKLoCjqZw8l9TtcgHDsGTgPLeVRBYwuDo0L2jWZUUOYrPoRGsYCy2mHHJnWQiTvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6ngwRh5o-FfTXrGX-S7N3xBHHUndZ48OBS_iYiQ3RDQ&oe=6AB3E8D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7WIwNKFfOUQ7kNvwHlKq4D&_nc_oc=AdqqKvIPtm3SrhpZFewd3emjLpE3TSJ_1r90gQM7HEiBKGl0gAkrAfexBqTLUdBMJ94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdkO5jW_79Eea3E4LTmXn9DgwYZ2vk-iYVWYtbP2Ktyg&oe=6AB3D3D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ7VOpsLpkoQ7kNvwEqJCZl&_nc_oc=AdosFzTTW1_ZWg4r_3UXmY7dlTKuzkoNhUhdAmJV6UO2Rmo88T0C-763pXIoJdBSnSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgoyL1wbIdu44I7W9ck8h8LUJv9jh_jFqkjGWkyK33rA&oe=6AB3DA75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRC7WT-KkLgQ7kNvwFVvYna&_nc_oc=Adqlu8NRhX8NYEVXv7pvTWJbBDPTuuCULqWmQWORudN_wMYjcApdi_caRulouFTgG9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKABdqm-GdKJRWKw1c_IWhqYFrILInDLQ18jnan3tsPMA&oe=6AB3F36A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol4wc2osFdgQ7kNvwFzgAWO&_nc_oc=Adqb3-5nQsSv7dyit6UyC5uinJTb9BHF9JdP8sgfXjwWQ-bq4Q-Y7AX0YTmzEBIzp1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfmUNia79wD2xLQXddDu2ljwAZ0lcGkpIiENjlxRhFvQ&oe=6AB3D8C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rKUFYbRUCsQ7kNvwH7TO78&_nc_oc=AdpfbjExegCtNrqaXtrf0Pz_AAU8Z2PRARQgPuiBEFAWTkSyaPoTWZFapEQ9
0IjX9DA1OqeVtjmzZzDDh6FQ&oe=69A838FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Xh6gRTbBMQ7kNvwH1di0s&_nc_oc=AdkcePsPvpTowfrE-8iCY2xDEjFDTJaTSXKNU54fjjodHG31bn8MN5kScTwuG6y70tE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5rq_Az8omyGW5NFAMH-DkJScu8CaU6yPhKmcq-lBYBw&oe=69A81016"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpxHFyEtn1kQ7kNvwFiYrxZ&_nc_oc=AdmUt5FDKgkY_AJ_HGsHpmNJtygr1I_Yn69D5f2QjH9FcN6NB5_-4yImOAfmWlrkE2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvc495tH2yAHaNbLaxrKbf4jUkXSNnnHuid3RfkU2Cgbw&oe=69A83352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1UwbQPDRmsQ7kNvwHLIOeT&_nc_oc=AdkdxauI-OsIhaqYjygoMTQ0PcBEnl27-_rBs93uR7e7ThV8WQtBTh12-rL7iDD_rhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft6rQJjTN7b78Pe4VlM1edPVIP_NwXKwsuHb8xBgla-lw&oe=69A839F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kOYQKCNH1YQ7kNvwFlkr3L&_nc_oc=Adk3v8QX-KuaKF5S-QRwqLvjmR-a-NGQSHC7gB8Dlei0_IhGPQMq61Aq_EB2QK86xdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7KD6AjYzzf6hqwdwPwnkjfurUH396BJ6-kYjW0rn3Mw&oe=69A81AAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUpMIIXDfTsQ7kNvwHxVq-s&_nc_oc=AdkgzfgbhUEjtBQYbStUUCiaXVb06AtLMZl9jbCPH2n4qD48s-49XTSBJccX1MHsxLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-mBD2nB9e5bLESqC6QnF0h8qqFdIE4BHads2DCrcqCA&oe=69A83847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1GcWkTDLwQ7kNvwE5ZE2q&_nc_oc=AdnnqenDQ8Q0WbQfo-W8H2Uc5z7SFebwTb1sKYsFNUoZdG1qqNiryRsbBLLGCMq5DwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.co
C0EB0cvFK0zrnxz_rOoFXHhg&oe=69BFF3FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTgzn8De27IQ7kNvwGZ4bl5&_nc_oc=AdnJI2n_wm5IKtLwYAnY6wShyCDrUHsCnXp5jyN42RfEdjweRLnAYGpRpPj0qFFZ6nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywztQm2DE__jZTuf0SWE6qDS3JuOyq4ftso5KAcX1Y-A&oe=69BFCB16"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ds-Im9lmsQ7kNvwE7e9iH&_nc_oc=AdkaBgHf3XiTpkbTBCBY1xL9OdZij63TM1VGfbIPq1-hZPux2lW38XLelLzs7klzdwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFXLAcVcIsv2eIgNgZiaxMBt_qYLiLISSPDC3qK41LdA&oe=69BFEE52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKPdJoGB1o8Q7kNvwEKAbu_&_nc_oc=AdmHRdyWe6JBhCZFsIMVC2-3DnWFG_9SdVgOQbgiQZq7gP9T_l3fNt1rizVpeYexv34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDXUSDjR7z6-Mmef2tuAMWeAaOOE8NcuuftIwdfarZFg&oe=69BFF4F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQdb7vL8nqcQ7kNvwHoxrbX&_nc_oc=AdlDUq4F7fymhPr6U5Q4_HtvZTZ3InGz0AzijmrpO01LmLf7_WuyUjr5vR8fTRHlW_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQXmXsCTSX_sHrl8a_vCyRvnXkpecTFgWK0hRkgBS3OA&oe=69BFD5AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JZsUGx-Bp4Q7kNvwEvn01Q&_nc_oc=AdkQBf-Hwm3Ih7dkJBpknnmrdQPMxVgGWGwKEjH5N6rBn40Hgd-00QBY52RVLDwh2Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUmFxVrb1-Nmq-Dt57eCO1RcQSRG02QKZiVR3NWhzU6w&oe=69BFF347"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7rXDBFcv_oQ7kNvwGSJ_NL&_nc_oc=AdmOtnGWA2NZQIM-6JPWevX2iK6vGQHsd3GP1HgkM5m5XxMQdMG7zEKO_VEeEdfKMMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.co
20f&oh=00_AQEAuhnukE7jZyMj2g-WjQ0SuDykPVTQ8WUQbHL7p7nHsw&oe=6A89713D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpOIckVwKRwQ7kNvwHxbOHw&_nc_oc=Adp5SXkPVqo-20DFZbzD8L_1LRGtrC6r48DL3RMhCbibGasHBWAgJ-jQ-2qGJWvGy2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw45etegcsBJn0A36qO3TNm1km8Dv47AmPKPLCcUlzRA&oe=6A898096"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY29dn_vPsUQ7kNvwH2QOn2&_nc_oc=AdppcfZyB0QGok0NkTSYjt-865BvXIyPNVhTTO9HmUmdFvv0qnUA21IIQUqiZ1twTvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkDeBLX9ePn_7tyUJo4bojKBLoWbUBx3l6_aC03ccafw&oe=6A89A3D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHg1v8yqeFAQ7kNvwEaaie5&_nc_oc=AdrCWZMVHjIzTkQZq6SrkfBHnzza8W9lj-FKdOwJm89QE7oBQhEMs98YkuEfhOyoUn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDlP81WUnZiGTgWNp6nqZHe7viD-Ys65two9TTnE1HOg&oe=6A897235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADhKXJ9Y6woQ7kNvwHwcKq0&_nc_oc=AdrW0bNwsrKYWvwX5vlLo2-uKjkXrMAbfoX_wRrP34TUajqzW0g2qtd_nrBm0ONCR-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPF4RtzPvlMJ6ET1_weeiqxeoj-EMwVqEYppAQDbkWBA&oe=6A898B2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAFKD8Z12KUQ7kNvwEcBEv9&_nc_oc=Adq6Jtn9z5Ox_Q1L1rxV_hKE8JSACZ-t4muNz-6yWMoyy66sLEexmSRgv-6H_DKq6NQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5IUoxHJ3yRb4k4MQNWNyeCdP8gL79qkj6y_VfnJS1OA&oe=6A897087"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFLtM3fcfbUQ7kNvwFRxOKk&_nc_oc=AdrdDyIriwOWcxUXlrCvOgMBMoHbp7RJKLGeZsBxEu11WYW_pl3dl4ebBFHc
20f&oh=00_Af5C7wSUw81W_SLiDcNQau_p1JTAPfvG0EMliyEBRiF8nQ&oe=69FDEA7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRgG8h7_a3wQ7kNvwGXfB_N&_nc_oc=AdoeQwRbdnh7ikBMzHTZXiYpeTkUJjB6RB61qI30A-H71w0PD4yAuBW4Li9QittgBbs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jd7kOFR5gLYfQNrzPtAbbYF6BByr9feAaOOH_QqTH6A&oe=69FDF9D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wboqte3-e8Q7kNvwGUhozy&_nc_oc=AdrUKrse-0wWiNGPzDGSqqDAB9Os8ODePfehMemqQhTo9gbcIA_cC7mhtTAUhECExCU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tb7Cgs0G9ym5aEPJJoeSgg1WrQldOSHPRtfOI-YYuIA&oe=69FDE4D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGio1LwZ61cQ7kNvwFWBSIK&_nc_oc=AdrkM6gMYcl3zbKOfjTLBZqpVpSumUgjVTGPs4mRZagJ2tHJOEKU5Ir-7Zc3fXu1w7I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41j0n1nPDUUry728Lb12mMPUS52jhHhtdOnrrEVxKMdQ&oe=69FDEB75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuPGFSEj1UQQ7kNvwHTap0_&_nc_oc=AdoBlumLeMKglTYn_-LTjvNJGoC1esFtJaPffcmQcf_IqM8s1SyF-0yrr-YJFEk_CkQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CiCMxO1ql0Bgu1PnJKdKIv5nUy89csOcr7skd6YZrFw&oe=69FE046A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqyG6ra-urIQ7kNvwHNazgb&_nc_oc=Adq2ZHKPm1loavvIg9GOSMXmGcDE3qgnlFBWkvTe0vrTfXvI1psp3AY8WkLxInNJq2A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tckxVpj7VqBcgPwR7O3zsLb8Knmw7qarl9v_K7XkD_g&oe=69FDE9C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rzhsbUgApgQ7kNvwG9KI6X&_nc_oc=Ado0NzE42b-LWU5_bDlYqpmdLYq0zbXBWldBAWC7uDN_D6_UFVeQO0JIIRZR
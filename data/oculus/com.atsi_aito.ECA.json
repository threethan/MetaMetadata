20f&oh=00_AQHmkaStKiAy1BonkL1_kwAinVicBn94JlOhuKdlf2_wRA&oe=6A9040FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18BZoaw1NPYQ7kNvwG7xSZj&_nc_oc=AdoYzq86vHS7G7Gj91Ek7m0rVYbMW59Na7EGbiKJ0HmK4ZEKMZgEcD_X12TGAAhq_eg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI3Yu0Pqo3C1tvD2uP5k3R49TcfCSkCCPFuN0eKp-deA&oe=6A901816"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS07tG--pmEQ7kNvwGvo2uw&_nc_oc=AdpINevh9oCYhpWUsuXW7CgSkj4Apdt7kgzmkWtD5gbJc5piNsuike2ysUp1THnyP5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGJguaTUOn6WaNx2iFnZn1bAd4b0mOHDd3Rcu3W0Up7w&oe=6A903B52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMtuI5n7i7sQ7kNvwH5_j5W&_nc_oc=AdrAOPDewntdhtWpKXR1i3PbBR0eY9oLzBXaETnJXVx-JIoGg27hEXTumT_m0c6hDjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-SoPXusICq3OvHHhzr-6WBAxLGMc8TT9YU46MaIcvxQ&oe=6A9041F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u-A2bmN9T4Q7kNvwFcoAW0&_nc_oc=Ado-LsnxD8uIvGkvy-KWNTU8hpeZMsPOuoYatDhXVX42a16JjEb5bbdjJXWEo-loRTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3LCJKrbDfahbB4GJs33TWTUDifRjagpaiuRyGOD-QqQ&oe=6A9022AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO_Td2mfgwUQ7kNvwEJBlee&_nc_oc=AdoYizM86iFR6THC2mXJMBfeBtXhYRKb4hUqNZVzixAr2DN7BeRoZHLZ8iCq0cKgGvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS8YKDwiLzyTJP9qhnlf5cG7VCNBGgZ6433HpUtZB_qA&oe=6A904047"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAfPMSss7YUQ7kNvwEtqbi2&_nc_oc=AdrFEfTLLD-BACxiNPzyDpgZuS5BFW3oUVA7i7dFmlku2NycCPses2CtcqHj
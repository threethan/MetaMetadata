20f&oh=00_Af5hyORItrqxcbs8mkF0YHD9oHOuVLnumD58iz0tUfBzfw&oe=6A09C7FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEG5iJV4LJYQ7kNvwF889yp&_nc_oc=AdokBl_k8gDn2e3mtGL2bQLrbW9WRbbwBvDZEXgAFUsNAelrwhr0BM5vZU3ufZHq4EI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zCBnOeqaM75AMLWo5ATIrKlaS_hi7HSFM6noe0CZ6kA&oe=6A09D756"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOomDgrRHlAQ7kNvwG1QUOz&_nc_oc=AdoamrwdXRP7uIvwyOyVr9NLKtklxYfKcFIlRhPYyOIeEFlTAxDtQI7n1qMCACkeLTY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Tepr5k4JtEhsxBMOKjD5B9uXLDAfa7gp_dZqW0guGQ&oe=6A09C252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXZPwUETQDgQ7kNvwH5Wm-Y&_nc_oc=AdovjKQF8CV_IiLvW4H2ayskqL-PKMlYf7TBJ_CO7Q5UqBaJTEWGyYd_eGE3wpp3yZQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70uCXN2XK8lpYgqXzi7sZQUvXMpvWGhiwK0kJdE-4ojg&oe=6A09C8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VbrYEHICDQQ7kNvwHeQJ1x&_nc_oc=Adrvq8HQjt0XUJMTYL0tDcm_sVtD7GdKhaZBRE2F5tQY2DF2MtmzRFhFT5ttnXy3a6Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WrT6Hsql-_NsZcD_YVY7mNpSP_cpHIOUmLQA_6jXcYQ&oe=6A09E1EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7slEhGsDM4oQ7kNvwEvSIiB&_nc_oc=AdrfCl0zRzLLYF7PfJkHPDLZNctJ1EL8A_cuyBRfG0SRY3pvYNFjFeNwJbFtJdmY99c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iRwCaxKsKh7sK4zPDQf5nZMSxF9ZzHLQ8u-FsVzf7Vg&oe=6A09C747"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3fTYzaLyvYQ7kNvwHPESRP&_nc_oc=Adq8njXpV6MJNq1nHReGIkMl-wflOUGVq7drmzQjs2z1LgXxRXvnpWMKG254
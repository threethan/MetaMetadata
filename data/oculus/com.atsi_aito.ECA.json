20f&oh=00_AQKuYu6msVOezWOB6rgHrTke0p-Lz2Il7mk_Ccdv3aHYQg&oe=6AB1367D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TajwIe4OpsQ7kNvwEqjaTs&_nc_oc=AdpK75YR7zLWOoolA2Vu_HmkoXQ_2q1ZIijajeS8sI_4ESVfwqA5yC1mTDQVYrGQtUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJREmPfl0UcREs6Fmm0bMMbtkFqm0IR0He9v0KvRBEmeg&oe=6AB145D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7WIwNKFfOUQ7kNvwFsGZKW&_nc_oc=AdpkYiBSWjhLjWJiFmG60yR91kvVbFCSzbfK2WIp91ddJNebfxnGxywvS8Lc-nIWFBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU2YghITYZ5a6XhOidQ0_ETdKlXxUkKUDPocgdU4QoCg&oe=6AB130D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RnVLI2mViMQ7kNvwE9eOO3&_nc_oc=AdpzJv09enpy-vOJ6lyGvVXPp8ZlUufDNp0XhoKOX58eaY5Dj4CGoOHOOQMxFY-Lz9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFvqCtqCmZ3H4bRcDkcCz6rkix8625Db7TmcfZp4_KwA&oe=6AB13775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRC7WT-KkLgQ7kNvwF5K2c1&_nc_oc=AdoaF_sXTxN_jM1YsWi5RsKPp5mzR8LdLsPFtFE0vj6Cmug1rVVsP6z8vEqYgBemdsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHXrXj6F7Cdf8AzHGvzTUZk21LoSQH6ib-uCZ_1pSNcA&oe=6AB1506A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5ZqgbxV1BkQ7kNvwHVIG44&_nc_oc=AdppRVSB_yJLixjAQ6RB5QWe0RyEDpATizmG6x7Ydk1JdwTc7cPpyWvjCVa3xiff6zE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRTTVziiBN06Fehl6RAYtnY3LQU8jMtwq9ICPdTXcm7w&oe=6AB135C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rKUFYbRUCsQ7kNvwG04sB0&_nc_oc=AdoxnA1pp5jpAx8BL2PcqAisAloUYmwzl9_bDv6eeJoyAX2At4vxyyjnA3og
20f&oh=00_AQCpFyUP2OVtqLo5S35lJ4pQNehOP79M9Pkn7rfaSDzlUg&oe=6A5E27FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU7k9Oa24SMQ7kNvwEGOk0Y&_nc_oc=Adqb7wS47HoDBRuGb3h4xDlm7lNsFv7y4xsDuYsqpZilLRfKUZsdDVi1fnrt6D0YcLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADdcajQdhN8ScMsoRvuwURasKkpQgF7so5aTQg2cua8Q&oe=6A5E3756"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bQNrtpVoo4Q7kNvwEujInt&_nc_oc=AdoUMzGpbMPB7EVb_SaPFnjCFXASoxHlw1I672C9JT5l3B9UoLPefFKoFGrZVGuEDEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL24Hd9SGQ1-yT3rprBOaThPwA5AEz3c74nD9O_Jo3nQ&oe=6A5E2252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYBSYLY_RTYQ7kNvwGmENks&_nc_oc=AdpgmBBCA8N5A-IDmNhH9aEFvIOg57ikwQ0x-SWGIbs9v7yocWoF80IwbcFjNJaf-WQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiFP0Gqv-L8SFMgp-1vUmTXzKevkCkKe8koUjxLEsdnA&oe=6A5E28F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8S2jMlf_vUQ7kNvwF56cJE&_nc_oc=AdpmkPFDUVDAXR-2nOxN_hDP59wA7th1BodaBocXPWZqWXvyqLEN1MdBbcysnAxudVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArJptHIqsaEXdmvWI93FXE5RyfTAHwHNwzL7r9owBkgw&oe=6A5E09AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssGfnV9jOhoQ7kNvwE-QKwA&_nc_oc=AdoDZbV3bAKzlZzhOGbUFl3Cho5cE4WGb5xKiqz5qkGmSrSt03o30IQ_ZZTI7WeKE8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3r1GbtdVOyizjJ4J-Uggh8d0I0DmAI5UU8Vyq7DJ5NA&oe=6A5E2747"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mom846MlJwEQ7kNvwG9Xle5&_nc_oc=AdqsLV_f4mHpKMZl66cBWRtDOm9yB8D4AsZRqgrflXqU2I-Mq5hEpRWu8PHs
20f&oh=00_AQHkMFhnXBwOybAFTY2cqj3gqJTcTQk1CXj7hyQi08IxnQ&oe=6A7885FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C29Iicjex9gQ7kNvwEBc8T-&_nc_oc=AdqsAaJlLu2dkmcfdPEnNwoXr5Y49NUJyEQhtr0qt2yFVHv84Y52SJ3zb2xWxxNT-6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOiLvYm9D-8gMCu2CusKf0QOddlnx3MoJFqiLUJBg5cg&oe=6A789556"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0McsQe9uTfcQ7kNvwExbVP9&_nc_oc=Adq3PlwM0MSi1FpSoLfc2saFgFDQQ87GFh88mwZ-9AT_D4aHOoLURDekxNWW7zKpwa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWA7omhca5UUjhHye3OEG84SSxSu_63kJXyeVDzP6qEw&oe=6A788052"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJboYMXBwkcQ7kNvwEHtPUr&_nc_oc=AdrELy01q4BdHqlKvEDcQ-a8XjfwV2OMuFc65jF1DtXpb7ZftJZT78rmNfXWMLjG3yU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOFa1sr4Ek-k1m2JuMecl21RIAiFipv6gYen4_OtElJg&oe=6A7886F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taenD7rXOoAQ7kNvwEhxDHb&_nc_oc=AdpZuEl_WOCsqe4YF4LhikefChVgY4kis059ja450dEY8y_DGKJqp4Aki_WA6LQ-9G0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqciKhw2uj7Ui1jXiHFusy_prk6ZpKIYlfhqYoogZX8g&oe=6A789FEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcWO_Y9TlsAQ7kNvwEKl9AO&_nc_oc=AdpqK5risLFCqG5OY6qnLQFYNvOn_lYzIpFUebiMeHrHhsLlv9C4yJNkZ6gZxdXnIFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz3ZypdL_4mSfbRJX-Tx-BQiNrWs7VVXTjfsSxM505wQ&oe=6A788547"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY-wR-L-lQgQ7kNvwESlQnG&_nc_oc=Adq5nMzeLEmnyKc6OFpcOevsKvaKLlDM5EJP4IxUxTN45xuK4w-H-YfOS7rC
20f&oh=00_Af94XQ-7WuXBGr0W7S4jYtP6R7IHyPRJ-LiZvQBnzE5rRw&oe=6A26C8FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcZVOWIQ8z0Q7kNvwFnwKIo&_nc_oc=AdqTQ7EhI-YdD_uicy8BCeSTudU1asfoYHy3YYYFOnBbgYV61MHKnSQzaVr6TKZksDI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9suJJjECAjSuht4r6LrFG0iSju7mhLuYZnOzTfJ_99Ow&oe=6A26D856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2lsHkwIkR8Q7kNvwFA81x8&_nc_oc=Ado7tBjZfDxnV88DTGUc8ozyVAFmG6-oQoQZAquYYPj_UvnzKfdI02zMZUYuGXsS6bc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zI_AEsDiCbZDsuPCHAKv-4DzCjU8GmXgZ8gKGgHyFhg&oe=6A26C352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4RMdipCKoEQ7kNvwG7TtkZ&_nc_oc=Adq8aqsAsMCiMrBGq07FGuicMFFtiTUlgIy06a_UXplam3C2SOxQgBt0Zm6iy5iBfjQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zBGCPnONEXbFx2N-_iuxuwVArPrkS7tjG8Obc2_8yjA&oe=6A26C9F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPviZ3TiS-wQ7kNvwHwn2v3&_nc_oc=AdpXKFjH36XZoZn9P0jeoix3QKJWSNN2VEjwOV-tS2A3x-xsosb6NaOwudi9NusCQvU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92kBHap43iw8Ubm3mOscdd2dwi_vPn5PCfNJNq7tVgpw&oe=6A26E2EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhkQa5HmUNcQ7kNvwEiqVXH&_nc_oc=AdoUf7XRHbCc_Tfi3V1-4IOtlQieEQSWo0j7yJv9QIfGqUbJCtrWvY8TaGqYFmbpmEU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l_eT_EbiJ_bagpX54uzVXpvxkmk119JBDNJD-v8KzkA&oe=6A26C847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9_wsvMnYGAQ7kNvwGobUiU&_nc_oc=AdoQsL82cqJ4q9Fv98CMXVJOh51XiD_WFGdYiEz5fE9QGP8ilTVaAZl05ShJ
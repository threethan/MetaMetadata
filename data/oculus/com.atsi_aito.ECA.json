20f&oh=00_AQFbFg6YRFigif3edk3sy-bkx9CShwTZwrRT9lFRFo7DLg&oe=6A71EE7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxwr8KJQzxsQ7kNvwH4uoOZ&_nc_oc=AdptgZWLYRKC6KxXWGqs13fBf4SAAICflYZXlhqzpf-RQsRAGh28yTnhimfi-4rZwpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBLKpEaZilyLJ05VjhKJVoJ5_Pg6lPEUc_DIC_oDa9vQ&oe=6A71FDD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtNl4uihfjsQ7kNvwHAWdcw&_nc_oc=Adoaq-A1Hhb_59ubgTQj5OCqEfkmtCWlDNZm3Xr4f3Yo2z7NfTg30gtRA6rQegC3ZBo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERIe4gXvMdyvMb94dVlHEPac4dgKe-4-B-EhRWhGEijw&oe=6A71E8D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snYcXrP0td4Q7kNvwEq5NR-&_nc_oc=AdqGfHX4fu1pRW4tqqSY4MOOoZ1qN-FzMsB90KxbRUVLhCdcxjRKYZOYjZU5e3-YXeE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMGNiht8I99lgeu6zNH7EPtgtx_wchLP2h3nFuhwBn1w&oe=6A71EF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbL-ZxjVyaIQ7kNvwHxzcCD&_nc_oc=AdqY3V-P1LDxwEO_ggNxNPxYgleQFAeW8ZOFFTbSCAIB8pI9cxLCObbL1s257VvHE8o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIopNq6Fku69ZOJ_Md6uzP4xFFeIZkVI22TBpZGStqKg&oe=6A71D02A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsUJBAUGNLEQ7kNvwESdFF-&_nc_oc=AdoiHfl_ZHJtSZykk0fIPiRxu20lHFuh3HTPdbMV1AyATwoW9SZzL3Dwb-98ElkZYJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSSJub6iJJrXRcakbvDZyXj7sDG47v23rEvPbckoWxSA&oe=6A71EDC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnGBtuLRFRkQ7kNvwHLHzKe&_nc_oc=AdoghKry-j-yqmZWyHyvGFa9OEMTUlI5zhREv0Y_iO4DMr8W0DclNCIw7Yqg
_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-8swb7CDXsQ7kNvwGTdSwu&_nc_oc=Adq9xRIHsGOmB4J7TFkHh55BLOPhkg61pmvDZHCFUrbmpgwC2WdA3zr27FOIoNHR_PE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFbekxoeudDbRmp8m4K3Gn3r2YrIu-k2Y6gcMscMAteQ&oe=6AFC943D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LP7lwWYNgEQ7kNvwGit9f-&_nc_oc=AdpcxHnCLzWhw1fuURBUdh2NXTjUc1mf5j20zqiRs3w5F9wmBkVQWn6V_ZpJzqchn6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTIXlhvjDM7ApkPJ7QMZPgVWYI77o6VEZgWur5psVW2w&oe=6AFC6B56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMv9Bec6xMAQ7kNvwE3tiWK&_nc_oc=Adqt6Xmx6HFNBPDmqPPz5sIZStS_qJ4eMgs2qeeYiATI955ygvPrWe0unG8JMVGtEBc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDwTI4NiZtccL_WDCjbqUYEKkI0UqillYVzsgsSGQvGQ&oe=6AFC8E92"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyIX7uL8cdMQ7kNvwHE5kSQ&_nc_oc=AdoWEfRcWZKH5-LE5w-9V14Ur7Icsm7SlQjRTXPmf3kI7LvZBgn-znoD7_insJYriBw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNiv_FMYNThxsKGXQBTU7yI2QGj00ZshzkrJ1xTCnFhw&oe=6AFC9535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F61zViNdPQQ7kNvwFBDFSW&_nc_oc=AdrCjYX9WLvJb3BqpCtVBO4HHxgylNjMXa9gol_HiNsGS22r5UrZ1zGY7MtBrW0CfcY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoBGWU9b42VtyFVgnnjdOdy1f-VOHuZ3qBl25htRZaHg&oe=6AFC75EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc99-CCD8BgQ7kNvwEpnLas&_nc_oc=Ado2ZTWb2NlFTg-TbvV1yy2D65ju-5NkQUOmo30x5jJXQkViuMCU_boc-EQhcpIK6yA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXAH0JqrSYp9ruLeD3fqLts84tj5vHlHquaAyi2_Gxzw&oe=6AFC9387"}, {"f
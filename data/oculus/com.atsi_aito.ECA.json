LhGoINrQFJVErMJusuUOCDhA&oe=69B80AFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7319Z248wgQ7kNvwHNvc2E&_nc_oc=AdlgiVTejbKoeuA5XD4SzX-SV4X-E29NBYgMIUzdSmoP1iUBSfLFCiLZ-lAiyDg6gOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydzI8GUpUZoPms80z6OzswlhYvcuc4zM_P9AonR9TMEQ&oe=69B7E216"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyunvTuq9YUQ7kNvwFIPvG8&_nc_oc=Adm9Roi2083F4aUahtWXaou6go0e0Mda-r1tEHrpZatxwwTYakZpW3-TdTZkLfvOGxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxjrq26M5lq2fxPTPLqcONLFb_BQW_xPxDC9lw9rjaNaQ&oe=69B80552"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so9M8mz8apwQ7kNvwEiif7S&_nc_oc=Adm3EUCHOUts9yoAjPCOvPPNloQuvwtOEE6gl_UlKdWEQCzM1XjHcVsGsRclXu5ldHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZ10T5O8b8rn2hK3hYF_SwPeIoMbusw0Yv8fv--Y3s4w&oe=69B80BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkxJZJTgdj0Q7kNvwENV3HI&_nc_oc=AdkFl7O4idmyKC9w3BgWk43Sf3LCG9NQSmnsHS16e8WHf8RK6X-YTL6f4zf1ySIx0LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7id10zcWlesmk9kWSJ0PLV9Q7CcwYR_8dib5j1Qo31Q&oe=69B7ECAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5z6cmIp_10Q7kNvwH0MCwV&_nc_oc=Adkzlq8Y9LpQ6niFOkzlgS6ypqhwEqZS8UBvsTeKHfeyBz8SZF3PHaTdv50Gm8fzvFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycNqG2mp775rLjGw60A-vzFUmWGnyAUKkCXBx357X7Vw&oe=69B80A47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir-P99mtD6MQ7kNvwHw0mDe&_nc_oc=Adlw_AXRFQys_3YqVKT-5gxZpPn51ls6rOlJCxTym92tEkRvdmjHfRukxwBNAtjcsX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.co
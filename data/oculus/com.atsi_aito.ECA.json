20f&oh=00_AQOykmJKyMOlN04PAUEDxmewVcpP2cJFZ3ZfWV_VKx6aBA&oe=6ACB947D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRgbhAOZclkQ7kNvwF-2qzW&_nc_oc=Ado_fG84gNLpyb5d-TeejXKB-Uv4yhhFHdg7FYl2RxzU5gjlPNo3tDBIt3h7atm4IAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYzpFmhhTZPIW9UYM0VH-UPJ15_Kii8moJLPd7OywZew&oe=6ACBA3D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQQZAa-pLi8Q7kNvwGc0ZqP&_nc_oc=AdqElXQhu1I-NpUZ85yco4DMOIAjM6mk0AM6sb2henn6r2horWqAsZDAu4JprGtShno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyQRePbgciUB0YCZ8IvHiHzpe6-D1R6qwjN281b2CS-A&oe=6ACB8ED2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9a1VLBs4OsQ7kNvwGLdtv0&_nc_oc=Adpb8F_zWyhtvTksU_UaPA8syjjAAYZh__5tGhyGmFJAXgW9_mRIrRO1RcaI3CDy9II&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsneplXtQFTN2ysk3QzpQXTdhAYjDjgHzR6u2XE4rpRA&oe=6ACB9575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYnheac89TQQ7kNvwGTQM25&_nc_oc=AdoIvu3sbG9pXbGu-Y-eKg12beACqPecGgavSMIo9-P8tKPLYgrLER5myzL0Y9JG7dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKpgCez9T03vBSXo1x42zI5B2EtpXxHtRAq2Ls5hHzLQ&oe=6ACBAE6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f_aCHQPkOQQ7kNvwFRXREy&_nc_oc=AdrHj2zdqjyjnfOogDKqYGPat1BY-uMxHyC7RlxzyrjjEe3KzGvdBgLCMuKoCjC66Vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLgixCx98KFF99FPixKGRrMMkSQZI_3HzeXW4-oBaqMQ&oe=6ACB93C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aL8sotpMr0Q7kNvwHA2TGn&_nc_oc=Adq4btZ-Hs8UO_oVlhZpbsqOvPA1BnttrzxKdaHI5DrY8XCEG85oZOdykJHd
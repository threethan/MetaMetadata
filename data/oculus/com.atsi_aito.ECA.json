20f&oh=00_AQEd999YFYU9JLEWSrU5ctUAloiI_pYp2v_Zqdd6UiCRFQ&oe=6A81C07D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98gmqnjDGQ4Q7kNvwEcb2Ks&_nc_oc=AdoRc1GFtvTxes-Yv0i6Rn_PT3xmneQEHodVvNpgTvvKRo7sv8jrBFVx6WeqJhXRhsA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoUT-71PUudwrhZNHOL7lSRqzhSB96IWwwAXzcI4ElVA&oe=6A819796"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eehcoQRZ0SkQ7kNvwHflNSE&_nc_oc=AdqyOCtcqxmA-y9zmB8akEcmDXAR2gSckdQ80kiW9vIiScn7pZpx5AUM3DSeR9vO9M0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkgapuSh4aeOKYQnz4xBMylqhw4pR03eSnsVGGI0wNJg&oe=6A81BAD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtQ-7gbeUE0Q7kNvwEG0ucO&_nc_oc=Adp8L31QbHcf1QZUOXv21Gx6nbjHoId4dAYezuUsTiPsv2ivdtffDPupeOnNzsP93vw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWEaVqNw4lvzMAflaiYU6IVdmLkhas4QP7UnJqGjkPAA&oe=6A81C175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umcJud7_0ZkQ7kNvwF7KDLe&_nc_oc=Adot2AxElKNUtP3DozCSxL5s6rT7dq_tWHTuYpb5LEOly-dllaHQ532iCTRg8YvZmBw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiV7pPhndwFYCFWQtJmX0Uv740SuvUG5WztSioR7IZLA&oe=6A81A22A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr4ICCR9TLQQ7kNvwHzm0xc&_nc_oc=Adr5QrC3HNeLdqzNIyUJTjGtYLKQgtUAAnUwDgs6MR3K6nDeKzSYs6RBpxegJftn4j4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRHTH65Vfbwdr-pbgQ8SlhvD8_mSYVww14FrfUuqwbtg&oe=6A81BFC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK-Y0hba6BEQ7kNvwEuKbeE&_nc_oc=AdokHlroZyDWkBojwL-592cQCEQ11jEDCCR-roisDalVVyX3GcMdGBEdqLW0
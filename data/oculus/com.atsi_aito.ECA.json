20f&oh=00_AQKy03FvMxG7rfqpnEQYmVYvuIhGsfhC1xztwM3cvBMo1A&oe=6AAA9EFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClOArKTuOXYQ7kNvwEwPEf0&_nc_oc=Adp6-u-q0Ly0SyM5g6dbjdESsBVBaTuCtDjk5K5lK-rKZJdmXfSaXQCy3lQbWs7_8Z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKxQrjr_Ueaec73f_x726Edek7N_Qsx34utdzXWFN3LQ&oe=6AAAAE56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmHBcKO9yzgQ7kNvwFNDH5O&_nc_oc=Adr4_uRPqvxnxKZdEl46h9RSmip32gRLGW9Gi-N7RrxS1Nh12UTdguuExQ9ZXEEldCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5pjQ-s9n9d53gu1ev5MHHO0hVcjd6LRr2SFVK_R0LyA&oe=6AAA9952"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_TLPiikk1IQ7kNvwHI_UuT&_nc_oc=AdoeDIk_fSrQYH0g7eKDw1x9aKB5o5sZXRXh2wzAEvTqQtTcL4XANs3giYIbYvUprNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_dX726xkpgW-PkornV2ZvwbRH8QZpM3vdjYnHwF3bfA&oe=6AAA9FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhB3i8f6rCUQ7kNvwEqBLtD&_nc_oc=AdrSzNotEslMxyLlv3ilJQVmsLU4k9dxNL8AqkKrYb1uFc5FW2ue6B5bNkV-XlAmAg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIliVOMW9irUYp1KqUx_mmXmkA9ZnARZCx8bh7XqrWaJQ&oe=6AAAB8EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqD6OrZfYswQ7kNvwFSwAT_&_nc_oc=AdqE_8IrFKLqaohE4ty4DQDjBXVfswAyUJR0oAoP4PVbV_1n67bX3xWdGE3uorcB2L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNE4f1QPgH8KgOl8x4zFRyof_l8JKDqx2FVSiXc4nNMQ&oe=6AAA9E47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjEbPeJkCYMQ7kNvwGY2GaL&_nc_oc=AdqeYbgF4JWfPfo5uwKjopfiuOXsjOVrYMSyaoejqD1k12BBtk8cfnPDuO5y
30f&oh=00_AfwFZgHgV_6jxEJheNMewjXz_D7rgq5fAWVp0j2WxdqC_A&oe=69CA7FFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITabVoy6eb0Q7kNvwFV_w0L&_nc_oc=AdomUdyyF2dIZ9cnkY5EYFq8QixzY98UPxm_YTEL4t5x3xbv37by7B2OM5ozLfm0dcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziOYDTRivKR7VQ4LLwvQCf9-NUIuU6R7gh8I3W_wlJJA&oe=69CA5716"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt2qkBkW5DQQ7kNvwGlkRs8&_nc_oc=Adp2PWu0TI_koTM_7P6kRMrysD4agN98Q-3Bxosk1CLcBz7-xVHczwMwAmBcOL2JIVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZpVCpvsTs_asMgBu8eorvV2AKZKW66Teoy1U6dS3vHQ&oe=69CA7A52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-3IjXUuo0QQ7kNvwEvcE64&_nc_oc=AdoQkPPAWknSK0IXqUBGyWxays8-AzOzR24DQN8LfcjMAaCIerA73ujaSya0UOQ_1I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya7Ck0uiZYX6zm28zfLL5o3RsHZNOf0hmAFqhgedE0iQ&oe=69CA80F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYQiP3bDMnUQ7kNvwFO2uaL&_nc_oc=Adpt1GILdof3tZ241lUOuLR_wiMNJqH53VPkK8lKZFARYyQJX-ZFa-347hHtcTx23Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4nzpX3vqLM-7D97KFkWvvFDq0lG1Tn8ADvF0IhjBmjQ&oe=69CA61AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aExYQjE8CoQ7kNvwFLPWf5&_nc_oc=AdqOzfBHqHDVmzclgyoVZAS8B38to3WI3hU5S3__xjCiH6zh9sDA-7jLKgS7vlfXQLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3URgOFqHn8Bc6I2zbgTTmJg1APh0HMfa-3Fqhn0QMxA&oe=69CA7F47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTNvcloSaNYQ7kNvwELooih&_nc_oc=AdpunrSVzAqma2rtLYx5ioJEYuSpSSUr5KqV2VnLqu4cjAatvhFF_tLpKIOk
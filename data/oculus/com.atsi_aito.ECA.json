20f&oh=00_AQS-K0vMaDeDSR7T3sW0zfO28bsbQD-YC344SpIns1PPtA&oe=6AF472FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpQArTfF6PIQ7kNvwF5LpPP&_nc_oc=AdrzAyJ0hW6XBVhIBtR0C22BS96HWzERSRtaiLsPitQPHGcS_PaoCwWW54nTjgBhhZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9A2Qc4hcTfG5P08jpA1tNKkVyBmpjM3Bw7CHMYxhvIQ&oe=6AF48256"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc7LImeuLggQ7kNvwFIW63l&_nc_oc=AdrGWo5wq9r6I10IOL2LgmnC_pSo8qPNU-8DlWzror349cFfj3osFLBUXZ0w5jlvFrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdRynhzvYthI0PejiZ9ZVO4avbJKGlU-qKHx49ZIVsOw&oe=6AF46D52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leaDhlL0T_IQ7kNvwHqkzZQ&_nc_oc=AdrDvAqvycLLpmwZ3aS_bomSSG5RH2fLXHNvZPB6NWczROI4J204OrWpZZNiBcArCuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD7XKcuac8uuA0C0qw6SjtdaSxuQZ6WQun6vCMXoxLNQ&oe=6AF473F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpbYNK395ZAQ7kNvwEvw7RS&_nc_oc=AdqQJhwIzBsWIm0qv5S6LdqmOVNbwXm2P0vTMC3zdBXEbplEq32qPDavsuUtN6obnHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0vgron-kS8Pswgm1TZfqaBUYum5mTxuk5kh_FddugLQ&oe=6AF48CEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUD3BpiohZUQ7kNvwEabAVl&_nc_oc=Adoit4QCADTXyS3E6CwP19SqMruqi8Ksmrej39BBjBtMukYWKgoNZqfC1Xx8d7qrJGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK46fXihNrK7XkaE_wMrlceRplGb1umzV1P9CWspfGHg&oe=6AF47247"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh5amHzKPfgQ7kNvwEQ-KkH&_nc_oc=Adq8_QVTpgZ-GPc1aeOGMbAPWYKqREj6THtFrNsRSfROO3XVr89_t1eHKd27
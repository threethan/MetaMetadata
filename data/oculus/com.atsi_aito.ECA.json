20f&oh=00_AQA0IPO61L47vChmdt0Bn-YgQuqtJjtyWHJoYwBjDAyUMw&oe=6A6A057D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9tYyum4L34Q7kNvwEy6IXB&_nc_oc=AdoWeLq9P8TF3RmdBSTKvE9F0QZD_vkiZPD8_Lgb4kNRGDCj-wvIYUZRSFmfl-i91VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3E8vqTwUPanZOectGUBkpR2NY_TBilLNDMAbcuH4E-w&oe=6A6A14D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vJZWjAgZ3cQ7kNvwF-scfg&_nc_oc=Adoar9WJaEr9DJM59gJlImhEsBv9ZSrRdAfmR2eSuZaVJlyDJmL_dgwYzxM7OHO3AAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw43B5Fg_nCQsPP2s2rokL3fYSFraLc1huxf4r6D3EXA&oe=6A69FFD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLQA72onBQQ7kNvwGgh0Ao&_nc_oc=AdpsOCh0fUTUVTwTF5q7TMY1Kr2uanhdKlcbHYLUaAv-GZX3hi7mricudqnJ6EZIlEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmDBH41VrWmu7CqLxi__rVIi7ZVLfVoFef3xKmtJ7tIw&oe=6A6A0675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM5NHwZS1J4Q7kNvwGBWS4Y&_nc_oc=AdouJOpKxZJ3TUa1NwqQwbRHGgXHI99zxkkEXJYXcKxGOVaGUl6lbvlo4ANlF-ZB33U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkz5lAXVmZMduhVTfaUC9_pEaJkEhPfNBB3nlfrseQbw&oe=6A69E72A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dmuhgyckc6EQ7kNvwEj65K-&_nc_oc=Adq4iXENlAvNYeceyb-km8-7lYXGqki6Nbta6bXEOPSMjlsGO96ayhpUoRlgROvzOcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMJW9HZxogM3JGEMBHPNgBcPfnwn5ER35m29SI1vzbfg&oe=6A6A04C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEIqfvkluJEQ7kNvwF_LgUV&_nc_oc=AdrFcw3kbuYJZi8wHIRrLpiyPXifbhXQPWQR1iDK848chlXV1G_zeZNAhhb1
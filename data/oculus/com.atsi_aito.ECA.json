20f&oh=00_Af64jqeScq5kcOCUAvhLR09VMYwtENmMkUDJIAVJZ6u0og&oe=6A1D8E7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZTaqXT6YmIQ7kNvwHg_SQo&_nc_oc=Adoyoy7vtPaN7IyChg054Nkl6rTMgXy9oUY0WD328Ek6cgtoy3OR1xHNJW-31bKGa5c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CQmpTAOM63G7A-eV0IRHpuN18fIvQhVDukfqvKwK89A&oe=6A1D9DD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXycFB_ywDoQ7kNvwHCMdUn&_nc_oc=AdrQzdDHS6bZrTwOnTfsrW7Ud4wr1do9Jp7jMu9Fjn_tc-R5Br2jq6lDM7-D8SmzcKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IvM0DenqsRXeTYH82cCOSZQyLC1MNMU_CawY6j-Fu-A&oe=6A1D88D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvQ5ker3-YQ7kNvwGCopsp&_nc_oc=AdpEv9A22O0Ik9KAlQ7jbwvMLeRCGWXk5DFN44BwnRLnB41cxXCOMI7oZZadwCPVN54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sy6C5zguWqoeoBA5JACrCeYIE737lUXn1s6VFvuqiRA&oe=6A1D8F75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYeEYxrqQlwQ7kNvwGpIXzr&_nc_oc=Adq7hWLl_LZAk2bSO4xaYtz4N9GYsE97AsIgcF5UC4sGOoIW-Y96yuQ1fvJwzfYESU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sx50QpXkLQWpelKCCBGLrdE8qA_XSzVnoyFyawlPKng&oe=6A1DA86A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skD2Nb7GlTgQ7kNvwHD2jlK&_nc_oc=Adpzlt6-Juqs0WBU3nEnH7C9XogBjP3dEEiGpO4laxd8WWpNc2wcUyRMFZ5P_ggvv-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kSzhMM-TXDaD7IJIbMX7ipAK3z08VoNspwk5JlyWucw&oe=6A1D8DC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX1TuonhHQQQ7kNvwEf0SF5&_nc_oc=AdrhtCJWwVP6wsHlDRGvy8mhE86Lz-913sPUcwr5biD1LzUpinjRBodGKbkO
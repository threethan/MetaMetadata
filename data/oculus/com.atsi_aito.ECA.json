20f&oh=00_AQIDFnd-eXQZIeebJ_pE5CdQPW43pYqjW9drj2dKXRdbEQ&oe=6AA012FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcbVWwaa_q0Q7kNvwGb5JO1&_nc_oc=AdrHnV4ZeVEN7A9XFJMyMKmkeklPXCaUSfWQDH9RQInSBkBRiVdgHsHrsQSSo5NDTKg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILyPaFSOwnNuHilpdMoJ5ONfwjqmAB-Q0GyDzJosnwaQ&oe=6AA02256"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHaKTkEwLKQQ7kNvwFyFJ1s&_nc_oc=AdrOvTCzr0dkaBV_wFpJcOV8x8Og06-P8PCThrxk8Fnnm4mBB0gDT1BmpWqKs4z4qn4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg8cGsYP9Kg-YU4TWQPMnliusiAhTsmB8XYnhQK17ceA&oe=6AA00D52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU3dsJPZFlAQ7kNvwH0B1xc&_nc_oc=AdrjevPwHxEWhaAoA7_cbWVh_ROBrTYlgmWVMkwzYRsF9o_8mbM2By3P2H-t4U2_RIw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9H1bX2UjxTah4AR4uhP3mwgAuFELyCBAjAccKLPiliQ&oe=6AA013F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rYnXmHzQegQ7kNvwGXo7e5&_nc_oc=Adp7NEGnTiexJ39QVaB_Ab1j1tREXIAFyQiASfxnkobTMNfdgryuYZS6aIFbOBat65E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXMYfe19RjjkTbUb3G5Io0UTp5FytrzrXkNi6FGKqhlA&oe=6AA02CEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpSnzzgcfIYQ7kNvwFL_Cl_&_nc_oc=AdqnPoVZY9wtxyw8wZ9KxIWc_jDwz7YkOAjFuYvOyNdM9wx_gXJtxFPs6jfrIHhDsnk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVS222oMiqGtry1Au77BWui6SCgCXaadEoPhpSCIUP4Q&oe=6AA01247"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5E42VldigYQ7kNvwHW9SUz&_nc_oc=Adq5SA-ualsjkHfde5c3UKpt6p8Sy6Wap_Ji6PdBOL13R_0vf4G73ofLYdSE
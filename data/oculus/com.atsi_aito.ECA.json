20f&oh=00_Af8233Sm4S2ZhI-HdfKj3ApD2Hd7ngJZ14qppsi11AihXg&oe=6A32A67D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2ne9E-PZl0Q7kNvwGVWySR&_nc_oc=AdoX7AMLBUppj6J5FD36rvQfgEM_E8r9o7Kt5Iym6MjJzXOv_jjc3MqY4nlpQ-vHKHk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DPQ1NwQCo71tVpnYncI--R56C4baqdT-lsEg05Khv9A&oe=6A32B5D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMQg307O0gUQ7kNvwG-MtvT&_nc_oc=AdooGK0ANoaFl4LGCXOjMaoTISaJSYtoYbQgLqzAMlJ97ZpWATBXMRaCt_uC8oNMm-8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TyKflNGGVdS8AZEZXkzQfxsXN95irlDcSf7qoLCD6nw&oe=6A32A0D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWR4n-fidGcQ7kNvwEAXnum&_nc_oc=AdqITiJ0M7bptLIIvCQfzz2quh8hP3RyQ27i0pmJSz7ffBWMyRO_K_Y4loQEA7DqYfc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XZoelHcPY72-8t5ykqk403G9U9LogWjc4R5b_DpD1-A&oe=6A32A775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhWktYlydL0Q7kNvwHFoPft&_nc_oc=AdqIWguL0VnxKW9fxSnyPYDST4S6Rdq_Zt1qia_i-HQIZISdra6HJUeaYxVg_pZveao&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TQcBHJh-eSTqndNePuVurk7XBxvfpY_KsHEUzs4_rvw&oe=6A32C06A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIjON0q1-LEQ7kNvwGJPKlD&_nc_oc=Ado_N9L2Flip0CwADUFfdNb5uHAp9xn7Vk-S-Tt-_xTO0TQVzegOmsWxJDxwgMAocdI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E_JidkaO11_zn1t6yHY2JA6_bQJ48u1qbp6UNPHbayQ&oe=6A32A5C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd03VphAVwsQ7kNvwFhPcRg&_nc_oc=Adr98k3gErtypix_fWTQAaOFUQKIiQt7ogC-9Q80986PmmmMarid9-Q8rRaR
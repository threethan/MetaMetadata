20f&oh=00_Af-MOm85MKao8puGMmRVOuHCihl6KJ7RtDhlRAgu0SEmXg&oe=6A3D327D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cghpuPH40UYQ7kNvwGhxDAp&_nc_oc=AdoJ2z9-jacZSyGUtt4sP_v1RbIBs_u2cSyDS1ZGFa7oXXeP5EteN2va8cV6G9YAMLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v_MGaAsnd7l4UCFaZZPaw0-GDwtSJxVJBUqXMpWrlvw&oe=6A3D41D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol-ourAZHekQ7kNvwGq0Er-&_nc_oc=AdoBVFqyjXWG-UjoZ3j3vuPB7vnYEphvxcQZrWPrPVc21uNc6nWDnZNTbrOnb02w--E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CUyRm0GAT7vIw7-7iGSKa2w_dsgDjHWYo4FfpmXtE-A&oe=6A3D2CD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRoJnbs09lsQ7kNvwE50BC5&_nc_oc=AdoNeMQm188G4BHNa4_BxnP5_Ec-hF5wudYtbaXyVYq-rpRA_54Ctp0cW40O8eG5Dek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-thV9-vlQv9Qd_nM9tZGQw7EHFFSlTh_P0XcJ8xQA4Gw&oe=6A3D3375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffdIdomOKGYQ7kNvwHWBHay&_nc_oc=AdrsjbolomPiSdM5SqhinRZcgV5fecbiQcPEY0qvrHggFw-cuQJqrz1XrZamTLlaqso&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87dkYZMOHtBmBtYPcZPjcLqB3ks1ftZcb5R70r67nuGA&oe=6A3D4C6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4wCCBwap5AQ7kNvwHJddXS&_nc_oc=AdrEoDLxcUsIVhXCqlZIurYoBi9EeOZ1vTKUhbR6XSFLRGQ1j1l-1Q1-nhK98WrsAmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z2uDIypbVYl_uOtMqcpWtO7m1qCERE3qVxtDVqVfw2g&oe=6A3D31C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWC2HfTw16AQ7kNvwHzaKmo&_nc_oc=AdqQ6GX-KA6zFFmgNBpcjsIQfIKxf0ryaNyPRfcedCBderLGDRdOgv67MgwF
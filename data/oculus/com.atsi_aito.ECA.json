20f&oh=00_AQAEP-uS52bbc1lgS9XVPLVMHiAQPmsuYTkgIAsCGjXQew&oe=6A54ED7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcS_Vce46tIQ7kNvwHPPAdh&_nc_oc=Ado9s57__JlHpmt52ghcc_Rrm_i_g6oDyH6AhEDoNQX_KF_L_QuSA0Q25Oe-YholYcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ89LFdKAY_z-OByGzHIRUYyWU6Mv7BwjcGT7ZgFNRrw&oe=6A54FCD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRnEHwAnsykQ7kNvwHmviGo&_nc_oc=Adq28xRdVhlM6EViasRCQbb_0rOq9jkmtXNhOVqdlGsYjdLwzhFbGop8V8UID3kKhRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbyEJtsSciFRAuoqkN-9K_IGaP_PB5eaptPIQeb1oMAA&oe=6A54E7D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abD7j5hs1ucQ7kNvwFsFAkX&_nc_oc=AdoTt8GMqlLRrGr_N8V54MM6jrvEqI8766L0AciNgWjRizUnYS6LaoRyw2ochx3PQ0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKnFKXVT8Ht9BmlOmZkchwMqGky4li8ukI5KIBB7bTgw&oe=6A54EE75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZj7a5TnmRgQ7kNvwF5VeDC&_nc_oc=Ado-9uf1sbLZRXPc7T4ra7TcJPaR4Npsl_TQjSdz2MFMdaS4gTRKWJuHQ8pbYYrqa94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgIo2KXqCEGeje2CHQRlekxtL0Kx7TeSMAjAGDjv8OuA&oe=6A55076A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4-7dOkU6w8Q7kNvwGMCCVX&_nc_oc=Adp2MGIWEbQO0JpEM-45cs1EDUdpBsbP-wCZSAydp-XAOCW0tBky9snyMUeSLXh4P2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7JP0N4QEjvnMvWjkD-gmPo-qAafI1u9LkBUFI2FhrUg&oe=6A54ECC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKwfHOmSZnsQ7kNvwEyqZkb&_nc_oc=Adp934v0EJ-xPxzvzBrRug-0E6zdD4LkNygNafWI7SNgIaLi2XoADB7Rngkg
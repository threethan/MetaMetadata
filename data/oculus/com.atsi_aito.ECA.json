20f&oh=00_Af_fHAatOrYvMqbq4Pz-q9SYElLWsCh50c1-DLaKqcFJ9g&oe=6A35497D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtL7i4dZIAQ7kNvwFphJtQ&_nc_oc=Ado6fOHWQ8aPelKexYN6_LxsZADXOO9Tv4aGD9YymQq-X8Vp7oIlc91aM70I6aOIghU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SjiGh80JnQ6qhEdF3Vd78v0u8mSwNQGu5wGHBsSP-Hw&oe=6A3558D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMQg307O0gUQ7kNvwGO8l_j&_nc_oc=Adr0nXjMwvtgUvCe83-PEJqKTItmIe2rElN1OnoJOel1mw-Pkc9fNvdyfB0nuFIMC2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OqxkER3S24WrB82lXAN_L14-f6ZvwQ4Y6Dk-ztuF97w&oe=6A3543D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_BrRZmjFrkQ7kNvwFjV_o3&_nc_oc=AdqUgQwqLIn2CJCFjtI_ZiVurhBXsp32DfcS0TGpCNmSrOhuX1juaJA9U_2LjtD2lY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CPsspXlEuphC1Vxc79cssdAfrDSOsMFA9YjuHHrO3nA&oe=6A354A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhWktYlydL0Q7kNvwFUEe6b&_nc_oc=Adql__sHvsae_lOW99u_eErxxrjCazYSx_SxR-ECEmYPRBlLRvdx3H8qlHKZvqQjKD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NfAkt7UbgHx_zGgAjwXR0NSwRao2Jvtvnmz4yz011Kg&oe=6A35636A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXe1GakPygkQ7kNvwHmGANN&_nc_oc=AdpHLa8ghJ4d2IzHPWPJra_NYHST21LKav05mF-Lcaj8o_0BaJRsIRQSvw7ueRLSXlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oqRMJ1GwzTxP1JIYoSsmNK1SZAAKMwa6DhCN1qALI_A&oe=6A3548C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd03VphAVwsQ7kNvwEl5IAd&_nc_oc=AdqajlYxSXnWl9h7tb08FPh-FBJBqFEK5CkGo5ztiUAu44_ZX8hsPnydO8Z4
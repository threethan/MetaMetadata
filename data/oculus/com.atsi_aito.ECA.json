rY5fE6j89B6p7_h415aBouQGR9Yy3Q&oe=69AADBFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPX5pg9V5FIQ7kNvwEtB1kl&_nc_oc=Adm5CfAVtfqhoF4N6SobvzeSNZZo66chGypBuVF9bQXswGrcOIBJmGUTqnvJoGgpuss&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjGKM3eBUaTlbsyzLDJg-X5p-1CfDKE5E8hqw-lBnKXA&oe=69AAB316"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpxHFyEtn1kQ7kNvwGnU4nX&_nc_oc=AdkE5TNx2zHnGdiZ7KuXaV3nOJgW8i6F0R7HwaVHvMhMD7n0wNl--1UgZ82BLIojix4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyO9Gj4h9USsqXAcrMaD7DRq6hjfskHn-D_U8RfOqe10w&oe=69AAD652"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1eSvxMA9UoQ7kNvwGb5jdN&_nc_oc=AdkmPd54apsmr9VcMte0UDJxGPTJ9qQZPF78-Ph-fKV2qI2juqvVvOVUzl22X4b3RoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu8JiFaJkYz0PsWsSz2SWP4xvFywRP-Y6-AXEjnkhj0w&oe=69AADCF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kOYQKCNH1YQ7kNvwGHyYFc&_nc_oc=AdnV1YG1_dZZBjQzf3ev86S5vGBnjhFKgaHxnQBs5UoPZPg7x283JN8-6clvIKYlMxc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9s3ZymXi3DqxEg5mUhGhTgyD1nPO1v4mPs-02OjLrNA&oe=69AABDAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuABT_FWZrkQ7kNvwGsQjCW&_nc_oc=AdmygZdQzhelXtvy4AsW9zzykgifsxrOc9N2USXrFoUjDewXN5SCgl6DNGYqcpKU4uw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSWdGC-GPxEuLuaKVxHlVUf4f8gYEwfmtZ-GaWhi-Zlw&oe=69AADB47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1GcWkTDLwQ7kNvwG9-43l&_nc_oc=AdlHT5JvkbcIxGo9Whr56ApJaSKhTgcRv4okm6h3vdoqDbSKTiXFh5mxn54NrLUL3kQ&_nc_zt=3&_nc_ht=scontent-sin11-1.ocul
20f&oh=00_AQPXzsKwRo5r11ifOfRqTrwyD7sCvADvOVhQdRv0yf_tPQ&oe=6ADF5AFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwdCrCoR6VcQ7kNvwH_EER_&_nc_oc=AdrdqSoap7Jr2X9DAiSNEgM8S2pi_6pohOtdeu_Ke_gvw5nnXXeZgSOFOcVobWcI0W4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSyNk4f47vQHmIJ0CppCH6R_wveyVaEEzrtm4tM8ciMQ&oe=6ADF6A56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdNGP5_4AvAQ7kNvwGKWI6b&_nc_oc=AdoZUQdwQFieYAw-X2MhRHQIdGPhjdDa9emU8CdDXoJTgzmQZdvSaR83E5-bzzJSKOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCPEXQXqDVZh5GHR_EEO74mnhlgP_7rBGlTykXPjjISA&oe=6ADF5552"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyJF7VXDS4MQ7kNvwEzQX7p&_nc_oc=AdqXvmhJ1lKL3Gc97T2ydAcCyrnrUDNqj-QdXamHa9inWGWONHku_OuWg9rRzibQl3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrESbZ1Xvn6rBbrGOpY7Rt8hO5OY61l5tDDdM-4GIqKw&oe=6ADF5BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1LKRQnu0OkQ7kNvwGe26yN&_nc_oc=AdoK1eXc_YSTOA3PcAgVRn4EqhJrVz_C3VzbEsrXxas1whJHiklyCRLDKTjsaNfL8ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5UL6so_gASsrcre5eIU2_9EDHdlPq4SHikacWskg-6w&oe=6ADF74EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P405xLwBjAQ7kNvwGM80Qk&_nc_oc=AdrHJFSPhuBpyRErLCx_tEEKvxMYxdU3TzxvzSWy5VENZjMBHLJFZ51f90DphHXy3AE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ2eNA7h-KEHkTp56EJ06kNS0LZqWXFa6T6vteQsmvLg&oe=6ADF5A47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQZTE_dPZa0Q7kNvwH5NUNu&_nc_oc=Adru7DY7qUKefZfUCCkhaTVcz-1AHbx7BCcW7js8GYZzjCh26a9FZVqEm-qr
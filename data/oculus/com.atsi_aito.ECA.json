30f&oh=00_Af1_gwBbKeNYjrX5fCq6fDWaDbotSdG0Pyf1I5IIA54iFA&oe=69D65D7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgyIhnTq2PQQ7kNvwH_ivA7&_nc_oc=Adq2ZIB1PcAJpbmT-2EcK1CMZpXGoHpennWzVrQlcKuAHhZGuXA6MLiXuyOz040MWR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j5XaawH2O0Sph_L3a7uK2hh4jUc1j6G1SH-a5-0nVYw&oe=69D63496"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT1VhXEOc1YQ7kNvwF7ctPC&_nc_oc=AdrOU2U0KcrVmEHPqU2jR6uecC8JsJ2ozdscDojEEK_qTYtpT0NKC_nkyTD-KzddE5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Ly5WHK_NrypZVuqYmSHpV9rul4Nh3eTJ4P-1Zo0Lzg&oe=69D657D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7Uj8oq2R8IQ7kNvwFJYnbu&_nc_oc=AdpUduRZwIS4D2ub3tM0fA0XmY2tPGw-r8lHOCbOEcTgSDwMUUFw8747tkguUnshP8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n_QbJMFeIZstu7r4tN2QwJI2y_QaCtcj14S5Xfy5QfA&oe=69D65E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiaCE6PAZ8sQ7kNvwGyTDkS&_nc_oc=AdqQHa6bR0lPBzuto_8ljjxqyblf9Hn86GiK8BKt6arJoyg1urALYRZwv73yAJI48mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z-1zCbTiwwE2I4VGpNh-D7RMQSheucmlEOnO3BYs5fw&oe=69D63F2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAbo-bQQyk8Q7kNvwEafHc2&_nc_oc=AdpXRH5PhSW2ygKbZlehB9R2px7RywtDEBKAoGnddthah6K2cga5MQ8ZoUzVM4JdKRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af063ZcLsv6tbMVW2zNZFJH_alZUXPBBKPeTnS50sxy3Uw&oe=69D65CC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjlZKSd2ArMQ7kNvwHqSBe5&_nc_oc=Adq0tANTyGJwh5gF8_kbLPKpKkhebfvVv74f2T5OVjLhvtOreCkcIdhl3AmZ
20f&oh=00_AQEuWcSehe11Na60aVOKf0NLwObvb1-miE9WUYliVLMANQ&oe=6A95BF3D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkoX7ZQ2w-UQ7kNvwF2qM3h&_nc_oc=AdqFAgCMJLBWTRx6mXmesqlYcvXChM4P4srQM-ABkadWIIbjDr4iAfusYuTxLHVcAZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC2JGbim34dyXBaX3OmqHwq5I76Yw1U7ftwckC3v1HdA&oe=6A95CE96"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89M9DYNimoQ7kNvwHIYntu&_nc_oc=AdoUVIgmGXKELClmkTEldDrLkMcZXs5i3J8pjdlcIQOTLhKtcsjeYTAbkV5dTPOtCMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrJajHFOZykEpiK3bQCEiKHVnb43cTRPL6OI4StN6ytQ&oe=6A95B992"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILmR_wf_GqUQ7kNvwGp2h6H&_nc_oc=Adp1ZCZTteIBLqbHjYW7PewzIUlJyzrWEaQcgT_pqkT4jWSUc7IR2CVAnQHiNtqGta4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIBYqSFMdgc_CKD2U_aTp9b_vJ6KN4hsluxENBRLJ5Wg&oe=6A95C035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWUekfg1hUEQ7kNvwHh5MN1&_nc_oc=AdodgMhy5GfFDvsPbaDwYqrV8SMj4UxeX--sSigF9U9g8Hk8plL7xJzqO2w019HL7K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlxCb2zwBrwECPBmA44Ur-WPkBeuG-nCycYtSJJCZESw&oe=6A95D92A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-NfpjCHkEIQ7kNvwEoJJCD&_nc_oc=Adrpr6okdzCL5Db3g75NIArW7Fm0jVwfvauWx9qHRDbL2poysqEZXl0heQ7bozw-Q78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCjeMm3ZwL2HW12GYX07uuPYtbI0cyBZttWhjHJ0O9Kg&oe=6A95BE87"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A6-0gnQFtMQ7kNvwH3zxft&_nc_oc=AdreIIXp20UW0DrQyEgKOuUXfSsLWRkrs3O1j-UpVN6gWal5cA2srKrFx2Ik
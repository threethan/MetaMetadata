20f&oh=00_Af5qoyaawCLs1_buhw0UMnjfvmgeYTqAU1pPxFftWTPzNg&oe=6A01DEFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdTbhg_Pt6kQ7kNvwHT0eOw&_nc_oc=AdqgM-qsRdx-RXi8u4h5sW-QP04a0aIsVAPx1DGg7C1t20xGCXyqOdgHasHyviVy4PU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TYnca1fa7XssSIDV4Ja_mvJ-etbLBxYJMXtK47tHHGw&oe=6A01EE56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odoxJjyOMAQ7kNvwFKVzpr&_nc_oc=AdqqTh4Tlk5fWxQUhrMXP-QKlJQ4fNNrx32goo9F5zhhGEaWENJc85xIZc4QCe4srDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LDAtUVuhERKlacIOql8XRbGdned70cZ2TuhkktxdcyA&oe=6A01D952"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4TmODKO-gQ7kNvwE8AsJd&_nc_oc=AdoWibeJJxm5G_c1JaQu_A5z545UaV7KpNIA2vQZNQHmGYnQlCJfcGuEkdmYTEnlBnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L2MEUsyufl7EhqWMCK17amzoht5lHkLSzmhermjcFRw&oe=6A01DFF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LEe-GAcz6YQ7kNvwGCO2vB&_nc_oc=AdqrIJn5SckeC1JYse4_d69mbB3MfImQHahqoFlWPIhHkRM9xo2JVW7FHXAyNGSF4u0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X4ClGWjQT02FjZxoBRuYfVcyw9ZSK6SXQ9ykLzkd-7w&oe=6A01C0AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwgD7cp9caMQ7kNvwFCoHek&_nc_oc=AdrFKOb9fdcUQ5aOA-W7haXqwGNlcAgZKS6k8KX9PPGAbLFgCFurVhl3HaJAs45PTcU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NDtAL9Hj-bKEXDm3iwTNij7hdg_7A6iYPR0HqQf1a_Q&oe=6A01DE47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vynyasC9xDoQ7kNvwHUFS2R&_nc_oc=AdrC0RjtoW0irGfV0Sr91oyDNW4dNoQnOX0hV_2YP0SmO6_oje3UwoRY5ub2
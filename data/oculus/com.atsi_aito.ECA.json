20f&oh=00_AQD-Prne44mT6Q5G81XjBdVhNLqd9GLdxHiaEUDGm-dBQg&oe=6A6DF9FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMQSOn-i-N8Q7kNvwHlpqQv&_nc_oc=AdqvxgUuCkc2vO15x7ZRkorXBEuQCSUglyxfJ_e5OxF7zU9j_hm704EzUCJl3gP3nbc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu-t7jD8ZT0kw_PbHF-L7dfNJaQif2IW_wo6yLuNlQ5w&oe=6A6DD116"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EfXbGBWjigQ7kNvwGWqtL4&_nc_oc=AdoXJhxwAwm9PceTMlDPVyUeBAlxKKD5GWz8aOoaPkjRaOMot54Q9n-fJ8quOmS3y6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN6muXYasOmjEmpVCl-JUxZnpwuv9aYecmIY3t0UGxvA&oe=6A6DF452"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQqQZvJd7SUQ7kNvwGDvSqB&_nc_oc=Adqt8nZ3cJnvvrU8FJ42KZhji_TgYC5vykYiakJE52t3bhzsWO1QHkwXh_C-kviHN9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUnKPSEOoxgQAAQlo8riof0HSrQy58LzBdYy7t_LuFzQ&oe=6A6DFAF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFhvoGIAbDAQ7kNvwG2Ff5V&_nc_oc=AdoNPeenkPZVGgESBBoI9LtSkpITJnEOG0qSHgfoXbXjOhEoBs3K3KTrR3Z7xRru_LE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALQo1SBRQofAJiuDj536jyp74fFOAYJVo6q9Yhr57c8w&oe=6A6DDBAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsqEjdN3JbgQ7kNvwH_hoF2&_nc_oc=AdrhDqDWuprIekgnza5uoax3SD32TKBK1ZnlywwdZ9NTu16x2Mz0L-BBsVrndAzmCaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvDIbCXsNVl-vkwapcvIBwuwNm55nnrUR6VGmnZPU0lQ&oe=6A6DF947"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPeypdeilxgQ7kNvwHUnZhq&_nc_oc=Adr6zK4wrpXL-dXfFAlI5xnXexTtWgsuBCtQz78WVhz39f1HMg-p0IbeWh2S
30f&oh=00_Afyx9POCS0t2Q3_qH9CAbRAHkEAq1a_iYh0jZAQh_T--KA&oe=69C296FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWhqYkXXLkQQ7kNvwE2d7Xy&_nc_oc=Adr77KJ58lDbm8rJvJIDMAENrpMOLKC6ACE-J0WDYe8LwDcL_i8_YlrVVUG7F-H1LqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTILAgMZ1vsT-kK-11kWOnM4Tvg0m1f-I58-YnBi34Yw&oe=69C26E16"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ds-Im9lmsQ7kNvwECt4Ux&_nc_oc=AdrF0ckhzIGv-FT50O_nawVlt3c-ArwKuSlERWhat_SZWYYuluiP6rmVtpu9eY1zAYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6A5tbR8PFIS8oyH_2yZ228KafJW10vcR6EyemqB-aFw&oe=69C29152"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMpCWanL3KIQ7kNvwHJMCq1&_nc_oc=Adr82laSuIGc5umKMghDtGol6_uZpG-410FQVOshuup1rDjc86uh07G80t64Cvkf7Vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrUkf_5rqYtQRKPVhII4ZcKk-G9jZDH9HJ3GMpNzoMfA&oe=69C297F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQdb7vL8nqcQ7kNvwHPGkks&_nc_oc=Adqx7BqNRuTLZBwZLKvoVYB7atqrlmGEzA1KCdscm0qiGk3bo7hrso-dfORiRm8LQrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRzQWlGi0heWULySFCS_o3yikwK0jeVcdoAKaAbrbCWQ&oe=69C278AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RDBP6lK48gQ7kNvwGnF4Ty&_nc_oc=Adrrw3LnN4eyogeqbPFAsfWeVMXcquK3ihWEWAnnFXUGd--HhJoJkZawxqjevsRw_lA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOeVXQqaoOVKh7zsWdP_35FsJ-6GWmVN-dMnoydx70DQ&oe=69C29647"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7rXDBFcv_oQ7kNvwF3knJs&_nc_oc=AdqKuIuzWsiUnAhoIEqL_E1Cb6JXwtlwDVgHwn8-94vNNVCbuNH-1pjU6Q9H
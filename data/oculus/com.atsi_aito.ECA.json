20f&oh=00_AQLGiSvQSS1Nu_aHUOQMtxfX1zYpuoJgNelcqbHP_NS6IA&oe=6AAFE4FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TajwIe4OpsQ7kNvwFp7Yd4&_nc_oc=AdrjybquNc7kmpCj8BvorNUd6Bn8gdDCy8RArMSRZCvxsCOwXHPWnacCJoZ6subAr_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFsqVbJTxUuKMGQu8mSHVCcDDABBxeg13wVihe7P7wvw&oe=6AAFF456"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJqemo7zPz8Q7kNvwHt3z6L&_nc_oc=AdpA2z93M2NrRcqkSN3ak3sENNOS2KX-AI6v7XtEW-yjW06iPITXze4F1yK3z177PU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2AbzTjWAna3RINGAucNn-mD-zmr7MutlMig9QzOZwmQ&oe=6AAFDF52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RnVLI2mViMQ7kNvwG6YjMG&_nc_oc=AdqjXhp7gX5UsuZDU-JOP-WbhH4_qf8HTD7K5QqxEhO1RgAxm-QWVnQO2gxzSibrzqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKoPVKAtnt2obbDDumQhInAi-UkO5yTaEgOzxnb6K8ug&oe=6AAFE5F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp07WB2B-zwQ7kNvwH40kwk&_nc_oc=AdqKJDzttaQCWyEnamyJbfwznAQGBhKSSMPmrj2O1KW6Yo5mPIUy2uC0XZ8f4yink-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXc7ca6HCVrHKnvWFXpA2EAVnXsW4b78rJ0hxHF4qEw&oe=6AAFFEEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5ZqgbxV1BkQ7kNvwEJYTiw&_nc_oc=AdoJO8XtUL8ZsH7-T7MRW0Xj-tEnY8ElSooVnF_EZl77XbV9LFhRfeh_nnSm9AD1Mmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG5Rng8-PLLsHvWYOFM4NkCh9y7XAVZ80qcDJDoFguow&oe=6AAFE447"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kAejM_AfAgQ7kNvwHZ-zKS&_nc_oc=AdroBteXcZWGeOGo6tA5l9Mk2003Z3dXD4vZO1qX6ryf9Z6o3IAB-2fimJ2k
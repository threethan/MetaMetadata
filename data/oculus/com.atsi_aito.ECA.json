20f&oh=00_AQN0jCF4xzThyYtSfQ-CjAmNfRG0JrQJlStnZkhx9dow_Q&oe=6AC79FFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oDEVRhz2JoQ7kNvwHz7Tai&_nc_oc=AdrCKhhVz8cUtmtbtwV-gbfcvTCwsTen3t9obUJ33Z5Jf1WHVfp1BdAR7ul8yPXhaE0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBEXjuVcw9SVl8QXvsSs5g-A8kHWNUsGqP3vIqLaFutQ&oe=6AC7AF56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNYyDKDGXDwQ7kNvwFKsmSw&_nc_oc=AdqHMGTDwkaoOWmNcCN_dbJymvgKD_i7Q4TvBk7KphhwWvywx7hIWTFebaWBpTCBRWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCo-fLlVDNwkqvxvOXk5muy67AoZd_uBtU1CwrEE_A_g&oe=6AC79A52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pw13wua9QQ7kNvwHs7wp-&_nc_oc=Adr7D_0n6IenLCnByDjvMRDTlOQjVUzqtRNxgZFTES2EezgggjRbdFH7z2Cj123nfU8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlvP9jLRLB8H68ckGF4FB1WysA4QdYwmicmtSMNfqwDw&oe=6AC7A0F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA40fZoY3uAQ7kNvwGJLmKb&_nc_oc=AdqBZQgz_E-e16k2EGeHYxcJF4NQXkQCaz0B_fkZskcNLYx-6tUL7dMlibeePPNv78k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMITdfIJM4rmLrQAbGfnUjZbqEB1VadyLcmxVwCoSc1QQ&oe=6AC7B9EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVo8a3yrXPAQ7kNvwGlos5C&_nc_oc=Adqo0lcY_NPrfOVWwbUodxX9Fb1dG8TUaQxOelfL4VgiQGg7dkfdOGmLUjiLUN4elU8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWfkIqoklyfszv8BYLkJfMDA3RFNURauXG8CSuEPfv4g&oe=6AC79F47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-APBmyUDAg8Q7kNvwG9sSpo&_nc_oc=AdpEHIrFvDr8ap5vqsNWXT8T9axeRPst8gfQSM35vkFrjIh7DCvqSfODbloh
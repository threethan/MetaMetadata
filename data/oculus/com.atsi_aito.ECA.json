El7oT_tIz6jbXVvHZe461FOg&oe=69BD50FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvfLROI77jgQ7kNvwEWmA-E&_nc_oc=AdlpVgRUaZzKZ9Eznr4gr_qj__66d8cvcW5dxw5WjcYLa_GjHk9toqmp_schLccJt8g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJJ1krLm41umwN0LlHU28_3QpzntkzdgMuMrmSvwJucg&oe=69BD6056"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCNSlg_aIq8Q7kNvwFsJyzR&_nc_oc=AdlhpoZNhHYBOsSdzeXoZg4UoQ2ZWHnvqXdlN_NylixJyrBKnpOPhJ5TLY3H6RBT5jk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx28USYRQJI0C8Yg1KhtDttFFrmWtxWYp5pv5mkPfNJcw&oe=69BD4B52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKPdJoGB1o8Q7kNvwFESxMX&_nc_oc=Adm8ufzuWxfIt9H-0oAKfp4pt8iHOmkHaQIpJ3346yR8KiilOUdTAXx8ZvGBm_HF9TI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN2UA-gxk3XT6SwBnDY3sRGKhTJy74F-wn9v2bu36DqA&oe=69BD51F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ag8y-B5JkQ7kNvwEGhTCW&_nc_oc=Adn1aDfMm0TfYDEwWMf5F3sm2eezHLWI77yLeKgWxacMhSUK3dKvsdED_LDSyvef4gQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyM-0ZHdtDugsysnXjYTBqaRTROFMwOuu1oGNWejbzoMQ&oe=69BD32AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JZsUGx-Bp4Q7kNvwHcpAfQ&_nc_oc=AdltCwaV4tC_l25K4AXQUu_ZqUEQflz6-6tcXXmA8EGA6urdjIRRnMNSlLsBhpky0EA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZKG7ZlkzSTJo1W1rOha91DibxpSplSDEAw5DdBNayTA&oe=69BD5047"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6Na8THXDAYQ7kNvwFVr1N-&_nc_oc=AdmZUI8fxNTIGPgRfmL6dkUjCvOkO_FMtLDGdWeabr1jM68njXxEDgeyunMbHZcuh0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.co
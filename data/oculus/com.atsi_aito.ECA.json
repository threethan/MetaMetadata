_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALXKFimNKH0Q7kNvwFvqWk7&_nc_oc=AdoKXlpRjHo09CmIfDE15WARoH35-kw38OtAw02Ax2lhrYmEsmVfzq8ASN30QVpTWkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYM0DkBpy50h55MY8AP7xps0epedJE9CL6QxL7gmGBWA&oe=6B0088BD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyqa2bzWne4Q7kNvwGkRLyT&_nc_oc=Ador_AoNf0DN2_YP1UoY7zS_0uVxBSMoTJQ1a7HzUuGyrYQGiMU56DpNZpOwagn-u7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT034-JklyAV8X0YPAkKY2RDz4QNM4aWg7bLMGJMjle4w&oe=6B005FD6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj1bMo6Qv40Q7kNvwHIHltz&_nc_oc=AdoiDbqB5ICIVqczQJnLzvsnRpKPhuUpisNF_r-xNOkUU75otJjt3cI2L9BX_8N1wlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSM2oZDvbs0Ut7HOGKXwXnVqMcQuoC78GpEwBRfxLdXQ&oe=6B008312"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaOVHr50KbMQ7kNvwHdkDDp&_nc_oc=AdqqeS7u6n_DrrGhg-6OTCxPKqM1d3Wybr770CF3LT9TimiQOpzlom2hUWjMR8JMIt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2-d59CfxRFBIU9g4BbbYD0jwFpKhk2LcgWOKvdpMGrQ&oe=6B005175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-_K6ffyGx4Q7kNvwHXEYmQ&_nc_oc=AdorVROsDZvIRkjj_gU-3geHbPUAmDeS8coBoCOkxRjKAsEKQ6Ww0m5jx7o0ak-k1DQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV2ZptRmXsMb4eMG3meSXAvTJZ2ejpGp71M2YG2UbRuA&oe=6B006A6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujKl77v1zjwQ7kNvwH2smFf&_nc_oc=AdqFHyfKt7CPjDghJwDjQAiLGPTGFAJjsPmDTlSClDey25Uv5ND7rb2WVdHpDdDIRdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPSb-1xfg7aDTKul3Ioiz74fb2ZAy5i6u7hC2LFNvy7g&oe=6B008807"}, {"f
20f&oh=00_AQNQ9_n7KUT7-6szuZhXO0s42hcZ0beUzNMS8jki-AFF2A&oe=6AC1087D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1863bCoHoBEQ7kNvwH3btv-&_nc_oc=Adrki7LhWZbEOja0v1UyiNhz7nREBnBkkjO7EmLErUakibNpPx0-FssVoJu680Wq_0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx5HTTF_fqk4Y1h8YuDJxxTzBvSKuSMhcov3FUQCWGgQ&oe=6AC117D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwOiGtdQYD0Q7kNvwE98onL&_nc_oc=Adr8jPbNgizuNiKqQKKUckBT1cl1GuKWPxpEpFKbbQtr5qb1NYZX3BjwrI4V_tOj6ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO_ubnH9FNk05QIUv-vuTjo9eg5pE4EPatZbC7GBom2g&oe=6AC102D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_7n2yxcxHYQ7kNvwG9hoHt&_nc_oc=AdqWneKSknh3ymbMz51y0HZbapVkgNXzghO8INHA9kVh6BaeHD9Gid_9jbiz2pSb-iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpVFylabWSjv5A0QL9qm1sTNybHB1EW57Vc4BLZmtjEg&oe=6AC10975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCHD9XuJEYQ7kNvwHEzheG&_nc_oc=AdrFdu5FCufNYfXqJ_4DHUX0RhkiYFLmI9SqKOVqQIOD7p_YafOpUcbyIkcAbddqRKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRIHiZJpAh266bVpzWN95gPug0xZkJP5A-mn2pbok56g&oe=6AC1226A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu5_HA9fALYQ7kNvwGXR4wP&_nc_oc=Ado30DsoVJOqV4ue8qqalL85v7FYCIVoPTNLNFeEgJfwCjSFJnilkG9GX4fnfQRZW4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTX0pOcemxn8M5-_ydD25U0PLCNbepxhYb3E10CFtk2Q&oe=6AC107C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX3TM72rx3QQ7kNvwGAfeim&_nc_oc=Adp9JZyk4UvyGhfuT-Q9M-NGHUVPTcQaitVg-jWsvlvL1J9gFc9z8wfxd0fr
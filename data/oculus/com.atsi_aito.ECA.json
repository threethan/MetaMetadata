20f&oh=00_Af-ZSNV_zTDtlEkbRvqya9Z6fUScrXQ0EK11NqT-K1xz1A&oe=6A296BFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-DKfZO3L0YQ7kNvwH9KUns&_nc_oc=Adqjh9AITLWXASK-lR3ZMxYj-ZELtlrQVazWRus1V4cJv406GVnNEyu_tnS5L3Iszt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MN8H9NiMAGjJDnCDL2sIAhapahQ9IDBceAEr924QwVg&oe=6A297B56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2lsHkwIkR8Q7kNvwH37-ZE&_nc_oc=AdqEaeMf_oHv6f8RjgRC5us9HE44gFjn_ROM6kiIg3ckn_5MtmYwv9YsrG-SNSjaoOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_inEsiZHrn_UAn6TVMu44GZRXwDyHvaZhrymTye1v3TQ&oe=6A296652"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0GsTv9h924Q7kNvwHvzDQD&_nc_oc=Adp1Nz5Lv8Znf97xpZMuJdavU8V3ifyWdbMiNoVXNFxrvWxF0ID7jknYVEjf1HD3x1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zX9u_mU98Sb9BKVCO3HopZJJAGRbc-jQVTpWz4R0c8Q&oe=6A296CF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPviZ3TiS-wQ7kNvwF-kWcF&_nc_oc=AdoZEnCWSYTKlbwXfIinrA8jB9Woh95_XS2Ck2WJUbMZnnnBnCakoBmfn3C_GHsXbR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tdLIzw0-CrVadOrbXxZS2oZaJpt6is8RDZbsTBdNUIA&oe=6A2985EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAdqOi5Z3c4Q7kNvwF5fTJ4&_nc_oc=AdonjDhPsUJH4Be-O5vMBRo4JfZqfct1No9SZ4qq_DO5aGBMTdUShg9pTs_DA7KKeo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RsikHY4rR6Pb_zhb_K7CZiePpxKqvb830-uWMOY1MVw&oe=6A296B47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9_wsvMnYGAQ7kNvwE948nS&_nc_oc=AdoOf1AuomLb7XNkTnFr7wUTLGju8NgQzJ9gxvBUuwkacyLAStz0LI2os8QI
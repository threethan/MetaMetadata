20f&oh=00_Af4Uja0UVAmwM_xjIEbY5fXIXe2bclYs_6neiruy82i-yw&oe=6A0F0DFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVm23ydaFz0Q7kNvwE6WdRV&_nc_oc=Adr2m5GDI2CqFEnDvuLL3TD6HpJGcVCQ4mWkw_GbBbAsKUJZkKICFf0xP7Ed-iC3hRA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gbboYl92JOY7MoZW-X88GK5IqTRUMd3iXZq22zUGYzg&oe=6A0F1D56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XqtX8mo2UEQ7kNvwGIaIoi&_nc_oc=AdrF8iKumi1wOwt7UGz432c11qLdG1r1h9b4PhEVEYLbDO491_jHa-MIMgyXuSiMI68&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m0OLlc62m4YjauL-ETwTS821_1UnoWwhHq2rCuTUCzg&oe=6A0F0852"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-6YMcnQ7qgQ7kNvwHYTGoc&_nc_oc=AdrCPAHhQ_HL_EOsYOO1H8yOwPGzpOLrxn0EsLWxc9G58YAG7cNv6L87obbXsDJm4mg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P9Bnx_VdKzK9ABHHVqGD65B4qOzHvcPnHGBjOUnWJ1w&oe=6A0F0EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5654yuK7IFkQ7kNvwF_zXUo&_nc_oc=AdpQx0Nm4jc29U8MZkBhM72j5C9NI0DnNIWqNJIamso0_kZkGGztdcveR5ic9IDnk30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FrBoeEik6EOg45GpByixt9B1lGUrAnhF_tykmsEWRYA&oe=6A0F27EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tIvNZ-InAkQ7kNvwHmEzZy&_nc_oc=AdoV69yqYRDo01rpqyQCcfP19F_I04Il4hTuHoq7rBAHt8ZHJxDWDlTzq37ESezUVfk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RfelCwppVnv6gAK3rB-KblB2jJXB6UDjV6yM3O59GPg&oe=6A0F0D47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HWvaIMVElsQ7kNvwE8hI8Q&_nc_oc=AdpiUGYgdsgoe_uahtBRvk9woVhyYQb2tym-UI95tzcw-8xszqYP_tTuJgsJ
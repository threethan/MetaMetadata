20f&oh=00_AQS3mKUIObPfBHVNaC8sDfLfNI9iShUl_ZG-cFkhhminlA&oe=6AF9B8FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Ffb16sxzsQ7kNvwFcVEVp&_nc_oc=Adq_aGZXj1PTXtcfLHueb6kB8VB_Y0wvHfSdV-dKUQysnXrIogTySGkSwLyzEf3ZDl0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSupyhnlF9xC3BNxdfLqlvvGdyaKBiVXx8IRCEc7OocOg&oe=6AF9C856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aIlBDkbfUQQ7kNvwEnT-ir&_nc_oc=Adr6x48XaMdMBU5VT3CwYdAsCfF_8qBrV1_gETApIS9Uw6bIlqUihiukJeq1CaJp4gk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNlsqDEufnL8GHkrwFPm2kym6yoTjsRRZ0Cr5e4PTidA&oe=6AF9EB92"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyIX7uL8cdMQ7kNvwEJgzbU&_nc_oc=AdqsGe14GHZYY9WiHoepRfMtQAPbfAd-FiOlrYqWU78peWEl4msVfMdKpNFyA-ddhug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0oThQxlU56AM8oXciq6F9Puroq9lrJtmfiFpYSUYjsA&oe=6AF9B9F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88NQyZSGAu8Q7kNvwFLw2P9&_nc_oc=AdrgSrdTwlbC0fgPsraA393iiMQjz6EdnJto8DRF-_jINd7Sr-ZFml_f921A3vQXm9A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWg7TKOWPvUBX8cwnJZuEf-727Ja-LqocJAKAqhF0qzg&oe=6AF9D2EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc99-CCD8BgQ7kNvwHJJ14Z&_nc_oc=Adp4N4zcV7HYvv0ZcIx61Hneaj55bAsd-az2TWWQyH3yFsQU8fMRv1fzHRss1Nwzy5U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk-pc-Y1ShL_PxYEYi70NbFFCnL6h1m0t7NlaWWu4frA&oe=6AF9B847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU8HowmgTnwQ7kNvwG7ol7C&_nc_oc=AdpgkTHWZyrCkBAQ-vLV9hthUEXLvZkCrAPZdf6h31ZlszuI3rR93tp7Mb01
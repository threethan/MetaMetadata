20f&oh=00_AQJubybcmlIiP2CiEoNQ2t_yYFXqJ1RYftsnA2kRPbwHEw&oe=6AB52AFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuCVkOYL4rQQ7kNvwG7TesE&_nc_oc=AdqMwmq_QIxAFgpZQ6fcxle6VkmOanXe_JD4bESvL1ro-WP9Y1hmOFy9BWCFcvpdlfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAaAyrs0t9fRwPbdMdB_RFpArUqUE-uu3WXTXMGmx6eg&oe=6AB53A56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNouw2MCOmQQ7kNvwGOzpsN&_nc_oc=AdpIG3y4DJJEJV3Tck-dWZCNPkl5SynfYGUHGXgNWl_pa9sFu7NkD9k05qot6H5LaCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiN0nUiYM1-lBndde5JY4TAu4ecfZwVOrBrAyad5UolQ&oe=6AB52552"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ7VOpsLpkoQ7kNvwHlxZMC&_nc_oc=AdoM3a3s03lw7SB1W-BMqHQXNngHRhZhrX-ujW48rtBPlRW9n0Cx_PFVf4StD5rbUTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7RG1gWTPZH5qnIMbaYYDZII3qJi6CyhTTwrLRvaXCeA&oe=6AB52BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkwzWatt1RMQ7kNvwE_B01T&_nc_oc=AdraHiHgKIep30XfHat7pwWJr04Atbzr9-s6_Ekqq79dJWtJUuni8xtiwTFEKj3v3HM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImsB_EMoLvzDkfA8-Y5dh91zF33gEvpymzy2FuXVdiaw&oe=6AB544EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol4wc2osFdgQ7kNvwGf4nA4&_nc_oc=Adojv_xMYdBcYKqi8CQxOXgON8L2zJIchcr4zAadCtPqMrt0W9GRb01U-SCW39o2Q1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbCifchH_ItDDqxCqb2bpjCMcKp0MkX9pmBsNu79HTCw&oe=6AB52A47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L52mR9q6R-AQ7kNvwFBih7k&_nc_oc=Adp0whvi791ZfE3iBu1MzBIa4d04ii1BUA3jB1PrQoPTY7qx0xHPzYpquBgS
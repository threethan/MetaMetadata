20f&oh=00_AQFFM7OnvtUePiRwfxC9mOqzn-LBIJ-E7w0VXBUDQksTxw&oe=6A9748FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkoX7ZQ2w-UQ7kNvwFTeYRP&_nc_oc=Adpi2_qSiOqvvaf7TuE8V36wq-rUAPb2TfwMZ9Rebrpbikzwjr9r5k0we-KPkSIqXY4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCpY1KlT9Siyc20YFBEPzwgYSX3htOUFDbZlNJ6_Ge5w&oe=6A972016"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z89M9DYNimoQ7kNvwEKnoGD&_nc_oc=AdpZ69nVWVy2q1DqrgF2zpbByqg_Cw7yB6ReHenhFP_QbvkdoazUIy2zlydNXbvmol0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFKXRGJkFKC2VeNo0fO9PqkrNWw5H_Rskx3ROYIMNWVg&oe=6A974352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEzwQE3s0OEQ7kNvwHI9i5T&_nc_oc=Ado3jpj1jLF04S-GF-7kYcHjw9lX29IDv0iNkcOnQcHVW8jbXHCoCiN1lLaiN7TX3Mo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN07kkczb1TaboBwBidsTzvTxIOS1b6OpvsGNLLCHSuw&oe=6A9749F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWUekfg1hUEQ7kNvwGkKnBQ&_nc_oc=AdrGOTj_5C_ZT90Up8frj_hG1J2FBVN1lx-vDME-XL922J5eQCw-qM4qvuJTHENqx4c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP0r9Uf_nhrRJFC9kXC81m25bXNkzlmduZeA5KoYiE7g&oe=6A972AAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF0aaUpluMcQ7kNvwEPPK4-&_nc_oc=AdpcXe1dGZ9aOJKbj8guX0bD3QSDUI0aYBg5aoWr2K62oqnzWLyAMd-tPpT94ykue7A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3KmOAhF-ApJRYoiR3eT3KUtGSeCcGkaYkybdSFOz0tw&oe=6A974847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A6-0gnQFtMQ7kNvwE8JBHJ&_nc_oc=AdqrX1kicRbJZDixb-CMqq2Flk4KYyJugwBTX5kaFCaBrhjAzZGWgveovPri
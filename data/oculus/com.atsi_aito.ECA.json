20f&oh=00_AQR2jrK7jaS4LSiGPcKzBxlJDxuebX3Mi3ooOKtTgoji1g&oe=6AF2083D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVcJRnD33woQ7kNvwGPScWe&_nc_oc=AdouX-pogK_RsBgE-wdbFogLwl5RP3AzvgLRDQiDxfAqxBSa5yUAQ0_oGgBO12dhvY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR28wpgdILs3gGr1B7NMbNkWDWa3xOXzLWpzKPMJ0WeVQ&oe=6AF1DF56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-SPFxJrX_kQ7kNvwEw7JG_&_nc_oc=AdrUMmeyEdtVCpGkFQIaYlawgFHzhLLun88bZnNbZbrpii0KCN96YuLQFRdr2k8M1Xg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2wRMzhC_D9vjyUPgK-BJloz4P0e0ABMyAGu9xTWxiRw&oe=6AF20292"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leaDhlL0T_IQ7kNvwEVeSm4&_nc_oc=AdpKOkJJfclJuTESHdflzGIgfdqf6iiSEloYNCuwJq9I6EPB3lhvF0_6T-lJR6S2hkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYqH0JVBKbq2uMO5ztMA_2QFCUOrBrPr2pp9KpDm1X7Q&oe=6AF20935"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SbMyUAu41oQ7kNvwFvooty&_nc_oc=AdrGNfaP-4OpOS2a_m_gJxVmylpgye3IqsToGn-MLZ6VWLLyIwB0Qe8F5Gk0g4OKUb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp7_53mx9JLevICz3j9nKaCPcfmKV2Vp6u2OENAf09Mw&oe=6AF1E9EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUD3BpiohZUQ7kNvwETF4AC&_nc_oc=Adr2jBzLoPePnBQKorsBBGPb5tS2UX8iO5ATVh3eau38BWF5V2HOPMuUbgTx9lAREVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8qmrWC7UyngXACi2RG-n5r8K4cGYnz1Y7Ydbjlf12PQ&oe=6AF20787"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov5frAc9V4kQ7kNvwEVxapq&_nc_oc=Adr3Xc9fG61vdXKhpvzm66spCTHW5lx76COiF5XpdoKwvKhY43L355UzNzWP
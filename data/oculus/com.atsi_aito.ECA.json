20f&oh=00_Af8jNZbPUk1SSU2dRFXmXzGKStl0UNhoR4fvfChSClONlQ&oe=6A33F7FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2ne9E-PZl0Q7kNvwGhVwSE&_nc_oc=AdrL2rXCTxfEizDv3904CLADX_knT0qO5x2RBrGV5V9Hf1mYPs1BIcNPRHHkqsbhjT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X7GlSoeV0Ox4FdCbR82H7cVW13JE4W-UoghkIlsJ0ww&oe=6A340756"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMQg307O0gUQ7kNvwHIc0bg&_nc_oc=AdoVB_iKnuf4SMxETHZBcMhIYD7rCVq-aAlUEeYg4LHqAp70F-cfVobNYJZT2JBXYE8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nx8phSyIfKPRwxGlCLu2T78VqIEMF9-k1jamjFHBqow&oe=6A33F252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_BrRZmjFrkQ7kNvwE_DzE7&_nc_oc=AdrJt-32hagmAHdiMG3JJs8N5ZUc3Gpo2WLiK-rXV9M0F4hKgNLmR3m9fC5f75o_ZjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90I-RhBYzLqT-pFIz4laNwUEBV8gXqtKdViY8Km5385A&oe=6A33F8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhWktYlydL0Q7kNvwGybDRn&_nc_oc=AdrVGmMDrx_ZHQbXhtz7XdzgRBzZCn8YsIJCZiR8U6efoPa-1KsreKy2PL-JBD_HPsY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qTkcnTu9Hq3L5lymQutfM2HrRw-SsQ7TsYIQHe6sSyA&oe=6A3411EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXe1GakPygkQ7kNvwHt3RwA&_nc_oc=AdrOKcct80E0CjLXNxGpVrF4RBqPUtAnl5VC8jp8flvYvlWhhsbucGvCXUNY-HwTiPM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af984vL-F7DkMOYmxLy0aCny5dLtbvKAfTbu2HPJYzaxkA&oe=6A33F747"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd03VphAVwsQ7kNvwEWj1M8&_nc_oc=AdqSO2Rs_0akWaQNbdpYn2VtbVUkm0A5MKdT4Whnnv3r0UuZofL_nWY1iF3t
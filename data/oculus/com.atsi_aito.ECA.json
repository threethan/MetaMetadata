20f&oh=00_AQH0JtlD8P9tyZihIMqI9xdRnKJdf3ORi1jdOop0VlUd6Q&oe=6A7C7A7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e35_lOlr520Q7kNvwGVuV-1&_nc_oc=Ado2QmTR7NaP63g4pBtmNUFwEGxoVfZlsuhhty-awdKUZvfC1IVcuZ_yM3wrSOm-LiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDfoaW0FZXYBvO2uak1SXoQRdzRWuOIWjddQas_BMoJg&oe=6A7C5196"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6I_lyF0dnUQ7kNvwGNAray&_nc_oc=AdoPWa2novz-3HiUqZhPnArAmlsNelq8B7i3PCKQuY6W4hxBktUiXzH1VeVA6rpqct0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNuQ6cZmp-oHJYMsgkbZRnXURluq7jR6f7IFtiSfMOKA&oe=6A7C74D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_WVj78NHs8Q7kNvwHCsch4&_nc_oc=AdoDPV-eXS7MSAmCPaAnJGVPAuVv2CpHANXfZ3a8oIe_mA9vmlwc0D8SKy5SK-IppnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh2lkOBQGb9MfzK56xb6ywhNDmHy3ECPoDyt14RbkPkA&oe=6A7C7B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mm6DeQGa6gQ7kNvwEREzj0&_nc_oc=AdpINy9nabkzXCPlTDjR42CdF-n1NJFIwN7qQ7gRzV1xdCRIpGWS8pdbJ7sqdLLxCqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBwkNd6xLNe-6Jzna4-LW0fl5wref28pJ_xJpLKrq-Ow&oe=6A7C5C2A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRlLYVwQNHoQ7kNvwGsW_22&_nc_oc=AdoflR3OZ-NK35V5Y5nW_8uISck0S_Lodeey7X70PJA1NnpNXHs99UVER6TAIlx5ZWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmvGGf6V4hwhvzRQCwvIhcOwDZsCVlshBrFVTvcwnleA&oe=6A7C79C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PGYT90A0UEQ7kNvwG7TknV&_nc_oc=Adod8S062zefYdYFah5oDZTqXQx75i9URYs0oBDMFcS-ufcnRrApgeZ81rzM
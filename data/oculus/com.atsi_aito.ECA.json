20f&oh=00_AQGhXQB2evvFP7I5q6PyeGPOVx3F-4yqwVP3tagTxdQACg&oe=6A7B28FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C29Iicjex9gQ7kNvwGUGwfx&_nc_oc=Adq9Yjkh91gA2xIJfhXw7f5v7bAU80xKg2WmQ2bRxftOtD4ApKnTrHhAt6aTie2l59k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjhkapX-hMJk3Lm-gFVPtjz91T8-cTgUiq1ZbV1692uQ&oe=6A7B3856"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6I_lyF0dnUQ7kNvwEDmBem&_nc_oc=AdpLQR_-jOMVV63hwqXA8dwku6_iNg2NRK13bq_Fm2wECKQHk-iNe0cnAJGDMo8qeUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp9iGJ5P8YhSiLAO6vL90M0yfrBiqLvHBtVNj7PF7L1g&oe=6A7B2352"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_WVj78NHs8Q7kNvwGed4-I&_nc_oc=AdpCKTCg2Z2HkW3dyYLNZWgQblrE6762uuRgtQcPJeqdlddsGpCZQo61DNFfbvcj1yA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv2CDQ-Lh-Zt8IIFIbTAVwTCtmlzkK5RPHFU0PE30Z8g&oe=6A7B29F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mm6DeQGa6gQ7kNvwHE2tho&_nc_oc=Adpy-xdA15qwkxMfMoAoXDEd92Mj75fF4G3AaBWzsMTjOaenAq65As2JauzeXxZVWas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU7c14qvl4N_hPgzaqivHRWlEyUTnQH4FbK2a6opn9_A&oe=6A7B0AAA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRlLYVwQNHoQ7kNvwHHTS5F&_nc_oc=AdoaId5JAuV3U57VfOxUWg1RXK6Lv_KFq01A8CWNKxsPO7_X8SMfUqrzB8LaxsXGeqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Si_gM09AiMIdCUkYsB-2An_0b602IiSTpHo3Xq3P_A&oe=6A7B2847"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PGYT90A0UEQ7kNvwG-7Y3t&_nc_oc=AdosXfGFgdznGqwkbdYa38jAlcVklCrF_OzRS-bJf0pDTN2OEA_LUt-eKsrl
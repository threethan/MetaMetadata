20f&oh=00_AQRabRvwwdvIhgFKwbLiZubyTN-rWz4-b6uaUN-ZlcjvYA&oe=6AF359BD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpQArTfF6PIQ7kNvwFH8HTR&_nc_oc=Adrg6eyt4I4yYt6cJGyrGDI6eumN9e-BkA0MJvn6xJrgPkHVlBDrryuekwNH1jY5cVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXVDuasw0tTiKepUnCo6Bf3RIgCrZtpNcNxKwlPtOlVg&oe=6AF330D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-SPFxJrX_kQ7kNvwE6uiCv&_nc_oc=AdqQ904EjNKnqxTiKAxO02KbldK8fTlkBQBUiA7wxpp3EhUoJ6V353guY3tfwihFhoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEsf_B0h6wxJqxpxbv6HZZ2vHKPdReivjZtzd85H81gw&oe=6AF35412"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leaDhlL0T_IQ7kNvwE3Z584&_nc_oc=AdpgWPL-rY7VO7LIqi7lobLLS7wC6nkcW2nd3qkPct6AG5s7FccEqiNG6qw1EuV4JHM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnn1EDnaoGyfAwAjA3OkDjd4C9oAlxtFIN_-9G0hmKLQ&oe=6AF35AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SbMyUAu41oQ7kNvwELGU7u&_nc_oc=AdoLRPXnlh6uBl4Ncu1srLY_YUX8xd3K0x71v3I_WS7ia9KVxs5YWS0Nxu9As5EB-bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwUG_DA_5ceN-yEw2dQJGmDGIaK45y6pqOxXmIVS7JAw&oe=6AF33B6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUD3BpiohZUQ7kNvwHWLBro&_nc_oc=AdqFFrSsu4fZ4D-YqHPNnrKjDSA_HbMKdqhazQFKkaq4z90P-610rvVNrqMw1ar3_ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8y3c2YRaENPdnoTuYZ06cmh56wHsHHp_5-W_XeOttFQ&oe=6AF35907"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh5amHzKPfgQ7kNvwHPf_pa&_nc_oc=Adp3wEOYgprgWEK8Ghpf6VXTrSbeWPVaQLsPCru_289nBYlt5BR0y_jWuM3f
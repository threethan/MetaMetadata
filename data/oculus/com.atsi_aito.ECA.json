20f&oh=00_AQOKU9WcxRUcfBAW7m17E_ZAM_GXgfn-iAjCwzQFmM2PPA&oe=6AC8F17D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oDEVRhz2JoQ7kNvwH4pzdh&_nc_oc=AdqPBan49klqvnBGQzg194qAQUSvBbVDnmHkykvAwyX8Ekb18lK6ME6VYUh94QUNRA4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYTggeFlfxuTYdraYrT3iAMxFwTh5oluL-VpGV22hGfg&oe=6AC900D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQQZAa-pLi8Q7kNvwElfx04&_nc_oc=AdoFVn6C2488k7pAYjbNyXwe0Mfh1Etj9npVUp-vaU6DvBRo_UjKjUZwm2GgGq8-f38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDqrlS_lVOnxOSOHeIJa0FCFTaeYQs-d5H1pnFJcyOMA&oe=6AC8EBD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pw13wua9QQ7kNvwFP4GFx&_nc_oc=Ado7isFV81Xo65dx448maaKsWl3APPRLo9qoDzX0XVL6TDxyqv56JZ_Qwtx7qyOHCEQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHObKH8NVMJ_W759bTM6BA_6DSOcG2zpYYmSWZqRVgAg&oe=6AC8F275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYnheac89TQQ7kNvwGED-eu&_nc_oc=Ado3-5SWg9RzaePYUIQABShKIJhgjc-fnXu_6m107PjSpj4YxcWavNWWHe6ZHXUy1Rc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORhvpRnZMRt3aUKzHCnsQBmwCHvaG-6qjpNzfMe7Jspg&oe=6AC90B6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVo8a3yrXPAQ7kNvwEaTky1&_nc_oc=AdoljR794Vh5UYosOfX30HzMsb3gckZ6ONAahz7UFhSXuRTC1Bwd6HnN3DUDQ8GZc6Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfSseUaoHgosTgZPXNsfZmJBmE02rgriW8cdsJkh4wMQ&oe=6AC8F0C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aL8sotpMr0Q7kNvwHUfQ1w&_nc_oc=Adr1_fhBSpotee38i-kiU5nO94lYmJsoj0vePV6MVsrjCaEujigG7c9zpEAq
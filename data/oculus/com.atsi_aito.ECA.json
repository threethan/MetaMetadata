20f&oh=00_AQJchM9nPElll15sD5PQAYtN-GuKdTsktJHMRRxfORG-aQ&oe=6A9D6FFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijy1yosoFiwQ7kNvwE7KYwK&_nc_oc=AdrQfBsiDkt_st3yDao4TOs-LOt_57_Ll1TSSFOF1h3U6QWJ0wkNTFBMm5ooVEdl6qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVxP9ysr8eKYn1neKfZOLSXiuB0pCuhUk7Rq-HQYNviA&oe=6A9D7F56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHaKTkEwLKQQ7kNvwGJvMtH&_nc_oc=AdpN57oTNFuto9H1C6qWGeI6NhYNfzGIptr36n-2RAcRmsmXi4MWjs7267ZPHDTybjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgoohFwrPF5TQvUnWO6ZI1o2EuKyUJGWK5IHHgMhh0SA&oe=6A9D6A52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6G6N5wtpYUQ7kNvwFd87q3&_nc_oc=AdoGyusBs7N5zZ1okHb4mWnY2CK0lFGT-Rjh1fmSIIc_kuul8HvTULmz_5Jm_XBxibo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYSWHWTl3saizXB6D3UcnOM20jX2IlmGp2updmYWGKdg&oe=6A9D70F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rYnXmHzQegQ7kNvwFp6XD_&_nc_oc=AdpWYuQ7TqOiWCKV05hu28g-DM5sL7L-d_Ugtdc0rxPJlW6QH2S5zQg_7wDUqIyiWgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmqG5oZaxqE8inAfQsbRuGxK1RfErZX9AdnjXvPx3XNg&oe=6A9D89EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcEV1OjMIcsQ7kNvwHYSCii&_nc_oc=Adqtg8iO54SNxVOPuupZVVpigWel-lWvycKDXMSdVaeZIldkRDt756NPAqFgMhkvezk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzKaVgKdMGGfrG6roQ3I-EfZmHkqlagTxZU_LCK9Cb8g&oe=6A9D6F47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5E42VldigYQ7kNvwFz3LAy&_nc_oc=AdodTGYOa9kUfVT3Ys9zHB2qELa4Y-oAtAkufPLdjxXpaI1Kos7g6tChKHuP
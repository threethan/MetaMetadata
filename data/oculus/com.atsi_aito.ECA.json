20f&oh=00_Af6Qu-nyK6w2GpnQ4gbASXL75beG57eGymMCq7XxfFV2nw&oe=6A0724FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD9wzcwu6rcQ7kNvwEngR7Z&_nc_oc=AdrVq0SD8bo41WAtnAf8Bii_XGQutAtPVNpQjpzk8YGiYWhPxEG972TB9Pwv79hEUS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DfXCVs0fwoxZ2IGOmkQei3kE3mlN6aUa5YLEGX3hMCw&oe=6A073456"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOomDgrRHlAQ7kNvwHIsTgz&_nc_oc=AdrUZmmox-zi2iwxVoT7qt2qnsrx8EiL5nVTxUn4VH0YzxstkwE8TYxHFekwcazePZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XINanvGiC0gjZyfB4Xt98MIzLd3r9gxhNzX0kI3Sn8A&oe=6A071F52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JmO8m-NdZEQ7kNvwFHn46P&_nc_oc=AdomRmlsnSLL-0X2KvPkBSw8eKUQfmS7d71pJUjJ8TKZo7y1p13Q0wsMnM5VGZq2GoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OLBypX3_LEJuITOtUq1lFrAfz9bZZ0k_h9jmQEExZNg&oe=6A0725F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VbrYEHICDQQ7kNvwE0mSXU&_nc_oc=AdrjICx3lC-abDFvTydV5uCdIb4F_6rCEupMhFRlI37GblZ_ySceHeBCU7jgXPx8-JI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dB0CwWryJNxl3q2hu9QxDqbLfoalRD_aIoVESVpM2Ig&oe=6A073EEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UadtzjMuMSEQ7kNvwEqBkj_&_nc_oc=AdrC_gcrZ9Gy-RfUpf1ROvG_rcNm381TkjvVmtWFf43Q5FE2v7b9pApvE5FwqnREs-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6si034iuRgCm7BiEJb95xEbRB_qYiOJ_I3VqZP1Ht9sg&oe=6A072447"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3fTYzaLyvYQ7kNvwFaeKil&_nc_oc=AdqAmIFevFhbWB2aDuElgLAiMxHj8wmEm-pKpm7QbnI6FLP7Si2Cuqo3EmfD
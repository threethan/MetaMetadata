20f&oh=00_AQCRLiDE9ePXAm0f91KMNArj-X-jSHAr7WtebalvMgPBDw&oe=6A4A617D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_6XpOaUAC8Q7kNvwHxYUBE&_nc_oc=AdoppEdIatY6ohhdB6NERPsw95CQi7Glv5h-77u4nveRu9cKeTHna7mVvHnUJ3PbtUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjoBRrFQWsEKrtyA9wwPZuV9J78-ipdjgq-c6cH5Wu2Q&oe=6A4A70D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_znk8AzxJusQ7kNvwHc_YJz&_nc_oc=AdrgaAYb7L6F2YwckQU9qerpueD5fLHRwQ0ZNAMYFVhavbC4jpuEco5T-uyA-FgJFRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvL2tvi2rwy1ePUqO4ZWl2aHS6Rw7h2x7nCRVMJ_81gA&oe=6A4A5BD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6YdO7OOz0IQ7kNvwGjgojm&_nc_oc=AdpKyXRG2T8vmWpjmwhHoZjCmPUZHbqfY_81-VAnXs17zyLbYDJ_f_JKo1nzR9AWuvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXnRuROR9kSEPBir75kJVJxMGdSiqD_V1l-6_0I3CsRQ&oe=6A4A6275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29DDJw2tcF0Q7kNvwFHrstE&_nc_oc=AdqQWkvFu0W2J5XRIc0w67jZxb6EubTGWNXyIWCtrEzIu-8A627YmozvOA6D7mjR5fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbFlwHd6U3uZaiaYi1NZXLlsgYsOuIU8KF0fjccRPajQ&oe=6A4A7B6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpFaTG2fStwQ7kNvwGSmZkW&_nc_oc=AdpHtnh2oBMDB6XB-yUEzER6OCc48txB5d_4wCjXvaFH3NE39Oz1nSFDjHlqN6yfMws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiJqLcnuKTgB-C8YP2KnD4LMfSUhWywp22B35RPNtrow&oe=6A4A60C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaeqKoxTwQkQ7kNvwGX2bqM&_nc_oc=AdroZg1Cs72PqH1iaEbSxzNsLRsmNffP2bxuooj2juDcL7BWTzhXD5H7i6ZE
20f&oh=00_Af4yF1kDoMoDUFMOnPs-AqZEEsCdaU0nJB4FkByRGEa7sg&oe=6A05D37D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD9wzcwu6rcQ7kNvwFWA-Zb&_nc_oc=AdpaHCtNv6YDlKJXMvCN63y_iwG5ASk73PaVLOnIDObyjoZKgUZPhFJOcgoCLV7KgCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N1X35xN506HNs8TKUMvGWZHNMPmQa_Jzbm8sBKw5w-Q&oe=6A05E2D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnoG-pqZxQQ7kNvwHMRd9z&_nc_oc=AdoZBJSLBKy5i-O-i1_vZt9qBcCvk3aYNT6zode4Cif0qRlJU1iaBDeVEX7ZsYkp80E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ocrf4TA0U7lEePU2Nmd4IY_cShM4JRAeD82PGPy8lhg&oe=6A05CDD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JmO8m-NdZEQ7kNvwH3V7yG&_nc_oc=AdozUY-gJBZVngqq5hpkAQFQXYXoB1QC0Jo-8cVPQuIYE1hvCM2yPgudKxQviwsJ8L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j7OR8apC8sBZtLT6DhvLJNiLHET6yS6yzEEqjMlCVLg&oe=6A05D475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxKBjvaSY0cQ7kNvwFQHWZ_&_nc_oc=AdoIh09HFrAUNVc1QxOKXOHqgy2zVNvzKGI7TC8Sd17bFQfpSiELtUYcp34IYDGkKSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uz6BZ5snR2cePr1xPFpqQrvc_A4ZRze2jIQ_WWfIVZg&oe=6A05ED6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UadtzjMuMSEQ7kNvwGcHW-_&_nc_oc=AdpebHOcEJsNatNFcZab1l1vWxtqeEoOCkBI8XlUWA_a4kSIfTsFMfIX1KUW38jpNLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WsnK_6_9XsTqnKanlfwBc_Ssi4VeoO0Y1EPITKoNNQA&oe=6A05D2C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYJnfQMRXuoQ7kNvwHAWtHY&_nc_oc=Ado-D6wptot7j0zrQ5FuD4qhdHSQcSI3DNMvjNdTP9piU-bS9y71I2PFPW9D
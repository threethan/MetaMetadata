20f&oh=00_Af-46p4UPh1C79cotPYYpUQTNPjE3gVuTs62YgKHTw459Q&oe=6A3FD57D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cghpuPH40UYQ7kNvwHy2MZX&_nc_oc=AdqDIDfo4Zg5z72Z-ZTVMNw9RDmdPvz_ALmGRkd5h2uWrwu8ZSfijpCyZVBjmew4W_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RMMxHUYXIsmt1b9CVhPWDAdkIMOxXbUIfHHl5uCRREA&oe=6A3FE4D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHr7pf7OZLsQ7kNvwFUQxKK&_nc_oc=AdqjEIWgCvbwKsEbPDIuWHHNZOY5F-KGW5vX3prfL6p-t9TXkcULfd_cX0R9Htgcu7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a0nEj1p5p_n3DEZMwDPv756Rijt4Mo4zsUGIIBMlTVA&oe=6A3FCFD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t_0zezUgJ0Q7kNvwE20HDt&_nc_oc=AdqwexusdUcosT5rNy9tl7wrFzfC0SbuvQKRGrH7SXkx03DBO-nqbNBkUUjL4WS8Nr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IVHx04lBfSOYn8CXeeYF9axidqkqOUxJmRxWvGaqzfA&oe=6A3FD675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlsMt5ouhUsQ7kNvwERJDLP&_nc_oc=AdptRWK0oVnJrL5vo7XPjdbaQbEP0jveKWJQCRtjGP4ohiYEoojVfEQ5gZ47aqwTgF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TVgSp7FIAN6hN3VmocI8ttqb9QFrGGXkQLwrV2lM9MA&oe=6A3FEF6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUvVwnbvg4YQ7kNvwHY4v1i&_nc_oc=AdpcHFgsmiH_KmYXEg3svD3mwBq2mz4dSZ4HmotKXPcfNuwg2bOdQTdGH-ic-wlRR4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vWf0vS31oEwxKsb-Onqd1tiPfk96-UmhYU9e4FRoEQA&oe=6A3FD4C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpXyEVuU9MMQ7kNvwHuRrky&_nc_oc=AdpGCcJcMW_4zgczEie3XPkEn_zaHs_6Ddiqicy5oDLr87nfhXBD3iC6tHMB
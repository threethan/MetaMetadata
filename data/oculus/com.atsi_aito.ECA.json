20f&oh=00_AQGNlDHzrDY88FQBP8wS6r3BF8BI7sSdBXbl0lbWMFtFJQ&oe=6A93FD3D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkoX7ZQ2w-UQ7kNvwFFnR28&_nc_oc=AdrpibrmWxdD3jVq-0dnEXSmny1vh27KNQNn7F_8tQFKC-UbxEOk27SsvnnYGibE2Os&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC9nB7UPgjnhjwh2ELVG80lOH2o_QcxRqvy4jXe7qAgA&oe=6A940C96"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOL4ZZaM0V0Q7kNvwFY6nyv&_nc_oc=AdrJ_xAB18UYnP7FguGuvV7jvG3ZkLIhdvXVyPp4SH3zPDU7-ZBcTDUFv0XEppgLXNA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcTv4wl7V6me7c-xePTXIDVN0NJp6TgHXxEKbf33uoMg&oe=6A942FD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILmR_wf_GqUQ7kNvwGblA7K&_nc_oc=Adpk04ELklwTbnnWZI9x1gqNZj2Xs5TSVZqt5RUt2FB84tsXBVWG1lph5vKLtgRHSKk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxw4BufkRtJUB7llwWQ0Cf-YU7aR9Df3Q0oD3ZScRRRw&oe=6A93FE35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoCkmeP5BIgQ7kNvwFa9a9T&_nc_oc=AdpdKrVwMVsJ22yxzM2huSEq1PLqF2JqY1-SMij_-pZ5MRscBSViJQ2QI6UGjrh-Yow&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWFVPv0ph3Qtsa6Lbe_VOHWO8VsdLqstVeCGV_7QqWsg&oe=6A94172A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-NfpjCHkEIQ7kNvwGCOJZU&_nc_oc=AdoU5Azem6Re0rdW-aCVCNCmTnr3bdas3Dw-NbcvTDIoYRhAe4lZ6DMzvxti4deBDQU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-tyR_CHWm7SHqieC4rKJQro1Y5fr4CEpsXereA-VXQ&oe=6A93FC87"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqQJvu_e1GgQ7kNvwHgxITE&_nc_oc=AdpddM0iWF5N6WYTDRvSNUPsR8JET9i8Kjwt4HNOL9Wa6Ajrv1csvX1SL1Qy
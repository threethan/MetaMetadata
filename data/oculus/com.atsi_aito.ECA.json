20f&oh=00_AQQ_IG9RhsMHyjX5Icxpm3iHm1_v0Yp54fxj9-0hqfdu2g&oe=6AE8957D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTvW7yGC3LMQ7kNvwEVZITt&_nc_oc=AdrgITa2GgvjNDsQzl9eY5qLBAfpiW0mrA9Ge04sHUihwRtkg024qpxfrS_ZqX5JetA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyRdhdRQYsj7Qgbr40RcWTLzd_0bBOxrpl4CWckoqwOQ&oe=6AE8A4D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmVVG05obDIQ7kNvwEoDBY-&_nc_oc=Adry7CGsG0lr5xlphY7B3PErkxzFx-HY2rvG4hCGCL7e-wqOcUukGUeo6G0H5sU4AtM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuuYi2bor3pZTaWNsEc7s-7Jk-LE3j7KbQ43HUD5X3tw&oe=6AE88FD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IB6aHHtIA0Q7kNvwFpTaYB&_nc_oc=AdqQca2eh9-Z5yETIumxk2AuuQN6sG1zet0BjnMD924tnHMZ-EhB9JZBShqFnXwioJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ2MnF683DXVeua8OPKJABBUun2X5uoRxpSuCiykBQWA&oe=6AE89675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fszjjsdOrvgQ7kNvwE_JkF8&_nc_oc=AdptzkfsKHsZoIqZdFRy1n5CgEJEoGIg7JeofDzrQJmEayfYreCm4JjvOWWhIk30LxE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSHdS_mptb1nC2k86JJ-ySA2zVPV5dYgthj_1DVa1FSg&oe=6AE8AF6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQOf_Hey1voQ7kNvwF8jGED&_nc_oc=Adp7sqLpEiOQSHFi-zjgCsd52TD9VSIrB2fvn0ote12nI6knF24qRbfLoEgdNeWdz44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCSVBHZYAbvgAhD44nPlFfW4FzWWFNeEpojqeBx9q7Gw&oe=6AE894C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqY_3wjJXVwQ7kNvwHlq6As&_nc_oc=AdqdsCZCNPj0fmD6PFibnk2TN75zKAPafl8RthB6gVRosJ-urV86zwxxDLIO
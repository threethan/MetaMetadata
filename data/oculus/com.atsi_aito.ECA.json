20f&oh=00_AQFsudqT7na3U2fg_l5dxG627XEbivtJ27TnCB0BPlcUKA&oe=6A881FBD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpOIckVwKRwQ7kNvwFHq2C1&_nc_oc=AdpkMuZ9ZelShixq2cFsggJftC3kptMV5-CugXLiSa1HT-QOlenVySqEeTpi4NYW_gU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9UGIYR583f-VOa9bDklLIUCZPGAA0Rta9H00Fh5eG4w&oe=6A882F16"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRsYNX7tVcoQ7kNvwF-zVLb&_nc_oc=AdoiVUJ_Bg2zTIz6usn8QlDDwKJfqV-YUsZbx10QyRH-pYDXLldZb4DAgcvgUHpqF7s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ-07_vlYLbY9iy0fFbZqvBeXhAGC0V5iDZs6rd41tzw&oe=6A885252"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHg1v8yqeFAQ7kNvwH68aeT&_nc_oc=AdrsK9nPGjUl6FHbzz3B8nirqZPReVky-_MElJ780yI1gzJV6GZgPiOvsIJhnzottVI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6F9uekmTynP-LA2cRHgG7K4qTn_b2kch_UpvRpg5EZQ&oe=6A8820B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHzVMLYQgJUQ7kNvwHArW1C&_nc_oc=AdqKSB9bLDaF9ZdFeUZi-wPV1mxNoXcljmURDfXbwodPz9lBQYTvFTGctBfpYAmJPqI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGhgoL8pI_xPlue3Xw2vijRG4h0DAnHIsNs2WfgcKMfw&oe=6A8839AA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAFKD8Z12KUQ7kNvwGUPxTh&_nc_oc=AdpXE8eGL4uJJT5dxvfYAYFq-v1Av5zL3zUQEpKZdvxiQngHNCIYt5_N4FIPHb-tfeo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7yeA7W4WKraN3uqkNIOjhAyECRWkuiYM6E7YwS878gA&oe=6A881F07"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wgrNYHCBBYQ7kNvwHoFSDZ&_nc_oc=AdrW4pMlYwrrIfK5mfTAv0LgeDfpbY5D4s9B7mGiwuQGwmsOoUn5mxRA8lP0
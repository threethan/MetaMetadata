20f&oh=00_AQNilRDsT9cEOX4nq5GUADYmqrf3QoXMczo4MIA_iyApZg&oe=6ACA42FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oDEVRhz2JoQ7kNvwEMun94&_nc_oc=Ado23QJsfGQnw0DNj5RjdI8AbmO9F86nh1TW0sfDqKbg357_7y5s-6YPaUyahQW3M1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5pxgLIzYiglSptzszAB7mWsO0ikxgJ6_op6cwrVpJqA&oe=6ACA5256"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQQZAa-pLi8Q7kNvwEPmm1d&_nc_oc=Adr-XYefRsK6N96Vi_cltydRb0-_5gTb0h3rbD8CsyCteyQ0GHn_KEFAvzc30iZ8FgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNQLuoRCt2QsKBz2CSL2L1MgrFpsuVKqDbvT-gTFVFLg&oe=6ACA7592"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9a1VLBs4OsQ7kNvwGNNRle&_nc_oc=AdqWYRThc-amWsCsluGNvM3P00f4cp2x0Hj5lbnI5BupllnYUS224l2jIbDs7dsuIHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUCguDqianIxBRF5-8eee9P94iqCXztQ7hRkBdXMC8sA&oe=6ACA43F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYnheac89TQQ7kNvwEgczXd&_nc_oc=AdrLsWAKuXRaUkc0TdFVtrpE8mfrGdxhz_CJQlDyrqmN27lk9VVHKoGYiyLdIn_X6v0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXwICRpeMKMyPcBdgflHajufFquKZ6upPCurJI-HMf-w&oe=6ACA5CEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f_aCHQPkOQQ7kNvwHjp_d-&_nc_oc=Adoj4A_exAET8cMjYOxCoDrZjEZA0KKtnq-CqC1xJDLFErHuQgq9-e5M8LsURivrU6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRRG_65lEQh5JyRGfV5zsgxtjzHECgX6RdJh0plkWV_w&oe=6ACA4247"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aL8sotpMr0Q7kNvwGe5BJN&_nc_oc=Adou4stoV-vm3iyLUsxbctxOneBdavzR7fAeNrAou2co8RSt8WQjiBDwU3WQ
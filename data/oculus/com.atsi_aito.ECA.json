20f&oh=00_Af5C1JbpQ5IwbGAEDvZFs-vrFzDq-iWLbBeyUUYQGrHRfQ&oe=6A0C6AFD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEG5iJV4LJYQ7kNvwEjnZtG&_nc_oc=AdpF4-uJCFQbo8dz4zbxnVxH2B6wpcsu1Vg3fHR9CDN2P5eyTlnkCD8ST3lX-wT6CK0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BTSiVHxk85yx-q88OpXQ5v0rF1I1-q2XmISnroWlRlA&oe=6A0C7A56"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-o_xeGeAgUQ7kNvwHQBY_R&_nc_oc=AdrLG1JKbDobaE5WRHqWEqlBTRewEa1rnLd-2_scmwe_w2XBVlA1b3n7qQxXg6AhBWI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pbZWf_BJAaCVedBcV-AzF_PzOYh3c3oqCxiiQWVW4lA&oe=6A0C6552"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-6YMcnQ7qgQ7kNvwH1w-T3&_nc_oc=AdoHhrn_QlncXq31yNzKsVVCVb2eU01XJb2In04hv7NWNs2E0KEIlW0A2SVGUikTLOQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VziuqVB660S2cRj6x9H4h2jkVvy5G1yuUGHzo9jo_sg&oe=6A0C6BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHFauo0tz7cQ7kNvwFWKfy4&_nc_oc=AdpdeywDerFUeXy3km01Z2PkEnkW-DYGtbbe5VcAyF3WWu-EvXdW1pwCIFNaHBxpQf8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XTHU6yiiIwd_pJQoxniZvRkHskqCf6kG6CIIs436slA&oe=6A0C84EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tIvNZ-InAkQ7kNvwE5xCDq&_nc_oc=Adrt_MNVizG_cfMfkwKnXt8YAgoZnWbr2PcNraTs7phWv1CvhZsBfELdDWi2StP4U8U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MqHVvUhMJi1XGAb50D3yEDwPNo18DkVb_8oV93hvM6A&oe=6A0C6A47"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNCSGUP_nKoQ7kNvwEYBsub&_nc_oc=AdqLC2u6b08ynKQusnvvIpmO9dL7kbD4w6ZQbcALs-Hih-nW0EjOT9pXD1Ry
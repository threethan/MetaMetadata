_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALXKFimNKH0Q7kNvwFINBDR&_nc_oc=AdrSKOimIQG_Dbnxx6lZAzItKl3TT7RnnJWaaW6m9tnjLTuY6M8mKRVEJ_LKFxkO_Io&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREJOna08vkIme0DGlfV9uEtncRHCDSt6FU3QLey2vaqg&oe=6B032BBD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70BHhM9xgg4Q7kNvwF5gxTA&_nc_oc=AdrgGEYRywv3OwbLhT9s8wiLSGfFc8UI0nFpo-ydw8-Hj01bwP_6f44QnMnNFqn8y8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd6dgThAnnn3jJPGYL_9qJBiMnro9qKnnQp7-yfXP2Fw&oe=6B0302D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj1bMo6Qv40Q7kNvwHSguFt&_nc_oc=AdrkNUXCvkl2zG_DdJ1VGk6OabwBW7EhEmBvNMPKipqApqJYzW9MER8-YALcEDivKTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKgdY_IjuYV_EZZmBg03QlgWAkJf3k1rWgBQHeRDlsCw&oe=6B032612"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrsyJlseUa0Q7kNvwEw70HO&_nc_oc=AdoxUrKb0gEEnc5rCEUNQZlMw4g27nb7DCv4Ne3Jckx_zU97yoOXlwACjGWb5Sa-7SU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc40hbbXoRDkz-uJiGktTGImetftryfn2_dQIJT2cCVw&oe=6B032CB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-_K6ffyGx4Q7kNvwFi7sRX&_nc_oc=Adr1ID34GjzC8aqHlPm5RCKyd--IF9e_qCiBK8u8AJERTHHOP7wSgcg9MNwXu6pGSPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1uN8v7MP4AiUjjBZdjOwVMDKty5kOlqYjn6fzj5Or6Q&oe=6B030D6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn335yKgJ0EQ7kNvwEC2mBm&_nc_oc=AdrCfzvRXkuRIbrO3NX2oZLZdAP4pgRYKfc3nG3G-bE7YmUNVEs3Ce1T97m0csU4c8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScQlE-o7CGR0D4DTrzubSSfZRZvWxMDA_chj9IG2SSdw&oe=6B032B07"}, {"f
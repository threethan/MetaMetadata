20f&oh=00_AQNqoZKjhrwE4i-3dydlH5-ApFfomuxR6K7vdT8iPP4T6Q&oe=6ACCE5FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRgbhAOZclkQ7kNvwFvpiIa&_nc_oc=Adrs4vTLerEWmEmwtryNjUE1NNOK1Omred6iAPkgyj4--oCXP6FhI6-m7GjdqAeEDck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwKYSdHqPZSE0zhtQxwDZoh3XAn7qeBn4APa2696ifTA&oe=6ACCF556"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99-GGuShOocQ7kNvwHnfq2m&_nc_oc=AdqD7-fkYqZemgnvKz_T0_VhvxM3bQ20MidL5MTxsRTBZVh4mronT1t3m_0ZoEFqgh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdn15hOysbAV0JAPa7hMPjYGo8sBmOqIV6b_LjTtxa8A&oe=6ACD1892"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9a1VLBs4OsQ7kNvwEeikLz&_nc_oc=AdrZsqClG1B3jO8jAnrPWnX285KC4jn7kI1YCMytgBRqEeZ2nvka4KuuEovv1ZmbscU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBg0Q_ZuEzHk3ZoPug_tdbtaq9m0IzCCg7ElhLVMZcbg&oe=6ACCE6F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNwPWv16wA0Q7kNvwE7_7FG&_nc_oc=AdqzWsA54A8BCSxWELhnhZpRK5GHViaVNS4XLbGBcFmcv080wGsEEfH1g6X6d2ZWAig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXaEUrPAzCgeJJmAY5rdKVX1qy7UmduB-Rn5MXAA3NEg&oe=6ACCFFEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f_aCHQPkOQQ7kNvwGx7feq&_nc_oc=AdqpHqVxn7FfVzap97jXEFzQRfuvRdXX1FA2NyqZYXXL8Xm01i46dH-WQua1ORf8-dA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsMB5L_gzkdRi-xUxe4tBYznuaTldsqXTBSPke6jyUcw&oe=6ACCE547"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBJkpBoeawAQ7kNvwEyImbS&_nc_oc=AdpO0Ne7obNDZaxUXg-_w38mQDtRlPXn-IrVrzDsgqNqzDyKwGV4iaPxmz5e
20f&oh=00_AQQJ8CSP1fbsucW5EdUJRAu3e5qXVAgQ3HhyhJ2QS4cHlA&oe=6AF715FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Ffb16sxzsQ7kNvwEjwAvx&_nc_oc=AdqFHbehIxwRXsvXDhKGKMvdSyfKTij0FlQNTVByXtDxVKzEpS-v2C7V-WKPgFrzwjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKZmVu-OX4lhxDC9yIstPGShaf0-57iFtmDyG9WJ8TkA&oe=6AF72556"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc7LImeuLggQ7kNvwEiG_WP&_nc_oc=Adpv4z5-reqRINom0J0mkj1PTeDRIha2UsojlkButs12rFr_BQB6LEIgw7dt4Zl_Qmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6fOsU236vyp3_LfE4NjxrHmga0c_GVyS9HMsWrtYxVA&oe=6AF74892"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZIzeWc8Gm8Q7kNvwEof_iN&_nc_oc=AdoOo1IqcuYQ7WECLZp-0b-5uQ5543H-7wyUqPoqvxlc9SGIHjPahVB4p0DuZAUFRc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVyyxXKWIVbg7C6ut6LQ11Cq_V2AiXGowMgGN9wCAOag&oe=6AF716F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpbYNK395ZAQ7kNvwH8WjnG&_nc_oc=Adq-jhZRFuWO5WKeK9th2HvzDqdNHi0SeXSk-UkgBmp2iy92KeJS024qlvxhThPtI3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFMzYMtjBgCq_ZoLuqkoIoJkv3w-a9m__f2k9BN00Pcw&oe=6AF72FEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10gdazYI2W8Q7kNvwHowdzl&_nc_oc=AdqtS788f3HFJMj6ttBGKT0qzrAvUPW-wvMmGzTitbO-yJX5VCqVLvzQlYb0UgUop9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE0pQF8qUbBkbxqRSHIjXXTkLsMExc0TCa1zWOsJBGPQ&oe=6AF71547"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh5amHzKPfgQ7kNvwFRO59Q&_nc_oc=Adp5ZUFcw6sEkZq0LpLgEQAWg3Zn0FfuuQjPXSjmcHCpU5uvPp1aqRs4mbRC
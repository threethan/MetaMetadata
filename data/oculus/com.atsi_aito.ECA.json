30f&oh=00_AfwrcQ5_8xrSH7PF7gYCHz7qzFVexWlbhyeY_E4R41BeCw&oe=69C92E7D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lacAz99wjEQ7kNvwFOGvWY&_nc_oc=AdpLgAhfahBwb0GMiCV-S1JCXyaStwPARXOy_peuDW2gcj1NMiGRniucxC8Or9wVzgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKPKq0LYJQUvLPBH39ttnVsMvsWkQUu9WaqVUbnzuS1w&oe=69C90596"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt2qkBkW5DQQ7kNvwGCrIIk&_nc_oc=AdqX2E2d6SEVTB00hiWLR3ZpWZ4AmkQVj62iApdOb_pwVCH2HVDlei6XXIqPFbQtA3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBd1edKlGwMHtYSbNnUGcMTRfV7AkcaD92nRMR5i-X3Q&oe=69C928D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-3IjXUuo0QQ7kNvwG4ekRC&_nc_oc=AdphwTgbwRZ4NTmmOAXW2j07kl3SO87v04hYR_lD5_ZCL4O2nBv1fkc5kwAozpqf24k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz77XtW0wp0dL75zKVdpTNr_6ZDQUlS0zKitM2rcY2avA&oe=69C92F75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYQiP3bDMnUQ7kNvwFBDerq&_nc_oc=AdqWQwy9Nuv9W-xRZRF79FEb0YOgaEDo88Y6z7x4jxi9-qrdpisrDepXZmVRfLeRUrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiGEwmW9pW1ulk7IHn3JO06IruYSy0aKLmxCvEWEf1ZQ&oe=69C9102A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aExYQjE8CoQ7kNvwGW8iiy&_nc_oc=AdoktVDyNaQGegblb2zv6IAtghifqyEmHYUSrbOvjZhwPimVEOjFHxFsd5JIuukcVcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybnxbKlN61l9o6j_PtSX5sCXXKm9tbjPLEB22BBMIYIQ&oe=69C92DC7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTNvcloSaNYQ7kNvwGcw9-2&_nc_oc=Adq3bjMCQkYNn5niO6dFH75JRz8TN3MlUlNX7HnC0S4oVKwO9XcKweovpmEU
20f&oh=00_Af1ncRdE-uYxxAzFiRtP1CwNMo0Xzgy5AZZufxFQVgkQrA&oe=69F6017D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsoAZm8ld7gQ7kNvwFS-DK_&_nc_oc=Adr7-nNfiRkVps1feCRY8fY7vDRuH7LJI5xyV10xhs1CtX19J6vYigEyKLEKZ-h1i8E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11jKSIYNxSGowYFUjIkG8tGxGHxAl3NOUeiJflec_ebQ&oe=69F610D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HVT-ElG6zMQ7kNvwG11tGF&_nc_oc=AdrPTCFDJNDGqwPZYglV_m9K_9KRLnugtXWrcAWeek6bIx3oAX_RUzCM8m9nu10q0DM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c7_N56aKz1n77sOsU0ERrK6Jk4_08PWoIRg1AusJdXA&oe=69F5FBD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsWqBIV7VtMQ7kNvwETm8Pf&_nc_oc=Adql-QVb3XRmD727qPvVfANa6-630AcRXielqE4HvqAWnTrQ5KM7E6O_XEs11u_kLyE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28BsHiPmL3W79ikBJYn8d8XfqrDEomlSbCJZzNjYYIzw&oe=69F60275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YleIkQpJjDcQ7kNvwGnG6u4&_nc_oc=AdqZnLHqQ7Mba2ECKpHa0iF-p2QfQyHdiMxFWhVTuVOMAEDQvB9LTlTYz_SVqgfS5oU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tpPFlsWahLjuUm940QwEWSyLjgmrrIBgU9wFPqX65qg&oe=69F61B6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuxn968mAjAQ7kNvwGQQ1aK&_nc_oc=AdpfrnL9UhR86DzDMc3dsO7ecWPnczoaojI9iT3kuXrtZo5I979_MBZMX2dgjt-6d2o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s1z6f8lYAOx8o-jw0aCXHrlvLKt8T84jzSEJAqiLRew&oe=69F600C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYSen9J3L_0Q7kNvwE380la&_nc_oc=Adqtj_0NJT37XkBBeTypb15fVVB3-3WNb2ZaYotaEqOJ7pBPm_NS7wPBG-9q
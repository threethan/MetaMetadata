20f&oh=00_Af5_CK0EDT9umRkIeludQrfwv7zFI3-PgxQZF1V2frD0Tg&oe=6A08767D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD9wzcwu6rcQ7kNvwG2Dkgj&_nc_oc=AdqN7wBQMLouaayVO3AIW4TL10hqUCdqKYYv8wTGIERFvst2bYDNakTDHIxD-g8Klhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eBCMKr9cKuiy_DOmzjEiCxmpWT3AjA0T2aO2q71E8Zg&oe=6A0885D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOomDgrRHlAQ7kNvwH4gTaM&_nc_oc=AdpOvngP4enAM9ryJ1OAZMG16M7-s7GqRhldpW86PXwQW3slC26qNnG6bpTKD3mFeMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oLVtMvs0W3_vgtbXt_ncrFSXoaaAC4s_FaYE8keuzFg&oe=6A0870D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXZPwUETQDgQ7kNvwGruHeI&_nc_oc=AdoSkw9Lphu5Hta-x9xO15iWpaj46fdcJiskZ3eIk4pZMD4hAlZj7eXUeCaZeeY5PEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JhBKwm9nBl9NQQkVxPvOyQ-oASPYttq-kjJK9qFRk_w&oe=6A087775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VbrYEHICDQQ7kNvwEozYPG&_nc_oc=Adq3zGf8xk84s3IlMm8FmYBS5IDHjCOX5moYML1l-P3ILInA4DAFS_ayjlzwaR7cnhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VnsRNuaXvBMKTy13dYbxVfN_sji4gejfMbIXRQqc0fA&oe=6A08906A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7slEhGsDM4oQ7kNvwHnm3EC&_nc_oc=AdqeHZNR0HxyVOUOQfa3CPw68wuYH9m8cs2GAzT1fLF6thT3qxfm_iO1_G1Whtg6zws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yXaOq8gztRzC6JG_LL4i6yGH5sqiSTKVaQRfKU-XPaA&oe=6A0875C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3fTYzaLyvYQ7kNvwHNvRWw&_nc_oc=Adp1cp1PSMpNVqd-RtR817D0iwIGDPlzAUqr-FBA3ptCCmHP3kpEIyGPCT0a
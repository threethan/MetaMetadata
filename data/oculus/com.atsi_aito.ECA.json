20f&oh=00_AQChUXXMGNs2GER8dvPrI9Ak3h-JdKFh4zK4HaJ3knSQWA&oe=6A4FA77D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2U9Cu8Eqv8Q7kNvwFQAQKa&_nc_oc=AdoQ-VO6eDvhnjNZf0ea32uikokOmpAWA2Avzg0bORn5MlGq35V95d_QvMARYHJPwTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHyuuopW_jdO8FeruR9VwDDQQdQlFTvauPOy0kS2gdlw&oe=6A4FB6D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwpCOfbsmmUQ7kNvwFkZ-8p&_nc_oc=AdrdTVfi4MYdefzywEitCjmrVnptOQeA5IFAN98SKNEddIbNHqrktI6TPUK4xujl7lU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlZZjDOmHppkJEqXo9ujAyZ1XIxc5ui_j55NatkEu09g&oe=6A4FA1D2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z5J3UiMCXoQ7kNvwEjkdqB&_nc_oc=AdrDr-FEgBuyk0VVRdqf_9mDONrbvkl8cEpVi7eaLVMHexmi_3ovakJd_ooTp45ldWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDNrPHeLGMmZhVEuLwVTJW-oi1L8Mz5FoOrQSNxNofvg&oe=6A4FA875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLkLLPGlmCUQ7kNvwEKoVih&_nc_oc=Adq16XTpiLg2XvE3xcn2K0eMrx8ePXCMcMkOFsaXN-lMiALFtTftyM0YGpI5S0GlzRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBisrdiOEgKLQN9-_FZBM_OY7v_YQQVGthVlHGiz82SVA&oe=6A4FC16A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-bnJWtGs0MQ7kNvwFym1oq&_nc_oc=Adp9orYVsL0V1wiogG4-yxmQWn9n5aB6wGo0mxHp4e3GzGhIGlsezJFF2NoLiv5ZMtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaXU-BChbWLxC9ZkSoAmOjSW9KT9jodjhKIvspz_lPgQ&oe=6A4FA6C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPUhJFzDYKAQ7kNvwGeCszD&_nc_oc=AdocWiYRDSsCqptDtsGGpQPwXHQL52UHuBdUtikFh9n3HRB7YeGdAh4gqWek
20f&oh=00_Af0SI1sZNwdptLMCxabupEtMCs-FPbOajTIrVCEBUfDYbA&oe=69F752FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsoAZm8ld7gQ7kNvwH5CIBY&_nc_oc=Adp-hEMVUQkcQWpKwB5BKDJF9nJ1drVuRSi1d7VF9Nm108HxuNe9N7N7xOuosbFDpzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PT7GHNlAQ2MIpsuLEee7UL_iuPmfvflV4LQNHLWs0mg&oe=69F76256"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQnLfS3w9MsQ7kNvwE5h-jp&_nc_oc=AdqtV6uX7MHB0jOoTvxnp9M3nkK_FeHcFe5AUAN8XoeasAQ7UXthfEjuG4POImZcew8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jM1h56azpia9KxLu5ElYm3GMahCSloNtMhuw7rO1qHg&oe=69F74D52"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsWqBIV7VtMQ7kNvwFRR9gM&_nc_oc=Adr5qCtOw9aSyYiShcVOHG8Hw6RzdwsVLU4CF-u6HUaqm56Iels0jsB_j1T0wr17IZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15uCMGTjeu2G-EtecCPz5zp0ZS5UsWY6yagm6EAOXYdQ&oe=69F753F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvB3Zbhf21MQ7kNvwGEGTgf&_nc_oc=Adruc4_Kj64z8jQIZNmXvHsPDfCUXDpS6xKzLmOBd8gpscLJBzRYCvan5mouJn7OH-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NV-AUVOO3u8wwvZXNP_3G1sQC7nGIMp-FzEs5zQjbcQ&oe=69F76CEA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuxn968mAjAQ7kNvwFHMy3a&_nc_oc=AdpVOy_4AYd63kwiG7zeQOzi4bT7g-Ho6OvIL5Vup4Wey2VObo8s9vEqy_O6kSSzFUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bQLTKkC4ko5lNqN2THwsVFyubUJ5UNnwL2wqeBnU5YQ&oe=69F75247"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE8m_AVKSEoQ7kNvwFHu4DV&_nc_oc=Adqtoha2FuSEIJT2eya4FWce8C3KH6FUahmz4LyEkmj_3FeCwKClJh81Ka3H
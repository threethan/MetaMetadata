20f&oh=00_Af755XZou0XUUFndt9OoEwFVPrKoOaTiE87pCzDYKsdMng&oe=6A16F6FD"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xOFPzOP0mIQ7kNvwHnslYk&_nc_oc=AdqxKWchyUxSW8IHzQGNn1RsBx5XyPtdREBgMhdOzX1skrAr3ayJYFGstYZXDtg1rxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_fQUvNkmWaD_pThpudKdip1HH6ZPEMJNLyYznEkYE9g&oe=6A170656"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NVhBZSslAoQ7kNvwFK-TYw&_nc_oc=AdrdGRnAfBsQkMfEbm_JwTagAtKjJBB_lfux_veeB5ppMoeNx6A_oQ52PPjKvaSuBzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HGvgxHhHgO-NEojXYyWwKj5slp4ysiMS45HjaxVBXOw&oe=6A16F152"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bIZ1fQTTAQQ7kNvwFEcv7J&_nc_oc=AdpHSEh07VOsdRh8q6coxthE6056jQ_3h8ZbFxOOIc8sSQf-DTEK2qpH9A3lVKCzdMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54vCFFY5liTdlp17Y9qAX5v2RuPsXqNhAb6FK-jPndzA&oe=6A16F7F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zMPyWQh2TMQ7kNvwHXKjna&_nc_oc=Adq4O8A9UpOCFkHOfrBSrwIZ1PwHYFQUsRQJ0syHVFhFmQcOsdMciuNL0DzQv9zBRE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Me03UMqvkpaPCSTOnb-sLGZ3GJxn-g30IMo9KPAy-3Q&oe=6A1710EA"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX6axkjvej0Q7kNvwExKvSJ&_nc_oc=AdpxL6mT3f2VO1-BxLc0p5bme4CTuZtT4jMwnpBaNfI6OIj0cqN3FnX7Adp9apD9bZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PiA1tdiOGLD80q403kX0H9PXyn1WLw06NSot2iOPgyA&oe=6A16F647"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaFLGcBsfYYQ7kNvwH2T1sU&_nc_oc=Ado-YTtxOnkwXrtcklH0MLh-Uact4qYe8NncrPUAntpp4UlZnkI7bwz8k_8H
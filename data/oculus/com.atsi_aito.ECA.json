_ss=7f20f&oh=00_AQI0h36FzzH0R1AF7UDf110stVOjp7kWMyEh9nld_VNvPg&oe=6AAE937D"}, {"file_name": "SS3.png", "id": "2975583329435126", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974523_2975583332768459_4876848584461000911_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4OGjtH9p4sQ7kNvwGI1hPm&_nc_oc=Adrfbkg4Sq9wQ4S5-Dnzpn_RgV6Jug-q-CORcL2VDpNbZCGQSct2esR9tp2b6ydYa3o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSyv7gvhSX7EFryNkaWZzdd3HYpFSCg4ISE4yGvmTTgA&oe=6AAEA2D6"}, {"file_name": "SS4.png", "id": "184634680428060", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75641339_184634683761393_2675350997552393899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJqemo7zPz8Q7kNvwF4ubkL&_nc_oc=AdoqVpDbVUvuX5DynPbJK4mUiI0wGhYDOQQm-i5Thrk_Qb5DZUZd34EoNGr09LfVIe4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoYv20e0TdABxHP7Cc3vlk143Ej9BDLimbkpbLtQ2nDQ&oe=6AAE8DD2"}, {"file_name": "SS5.png", "id": "411302063697425", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003249_411302067030758_3628480977844434449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RnVLI2mViMQ7kNvwFSbXUM&_nc_oc=AdqjV7SBo4e2vTtORXnzrqEJzl-gBQjqf0bt09BELda-7p4lcAL-dankjSbS0xXeAp0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkgdSEwk3cFvRZVLK22BD7S_S-tsIPgMxTdBU0lhyRDg&oe=6AAE9475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "903752467203527", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982530_903752470536860_7264819481473567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp07WB2B-zwQ7kNvwGXs8vR&_nc_oc=AdpOLafN--aW8E6UmLeK1eVreQQR8PAtzQNLBM6xMmfdU0pCYlWN_hA0bDwWzUuh05k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHp480ftyq0hiuvXzhjn3b2TjHyhBqFmXe408k3pWQsw&oe=6AAEAD6A"}, "display_name": "EC ARMS", "keywords": [], "long_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAim to escape from the base with two operations:\n1.Attack mode - Either hand is a Paper\nThe pointer will come out. You can start or attack the enemy by hitting the pointer. Attack and get energy from your enemies.\n2.Absorption mode - Both hands are Paper\nIf there is energy in the scene, it will absorb the energy. Collect a lot of energy.\n(It cannot be absorbed after a certain distance.)\n\n\u2022 How to proceed with the game:\n1.Start\nStart when the gauge of the START icon is full.\n2.GamePlay\nOnce started, the move is automatic. When hit by an enemy bullet, the energy is reduced.\n3.GameOver\nIf you cannot escape by the time limit, the game is over.\n4.GameClear\nThe game is cleared if you pass through the door by the time limit.", "short_description": "An energy-collecting shooting game.\nYou collect energy from enemies that block your path.\nWe aimed for a feeling of exhilaration when absorbing energy.\nPlease experience the comfort of absorbing energy!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3708337449267211", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57574720_3708337452600544_5022510225171740223_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5ZqgbxV1BkQ7kNvwFRJh3v&_nc_oc=AdovkjkmC11BzFtCJlKo5-JzCPgeD_9LhTynVUx1K4X0pGTeI17tnK_G9yE7rFyZc3I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJahnXWyQtuWg8d4OvKlfALziBi1-R92kWSMGQ4XB40pQ&oe=6AAE92C7"}, {"file_name": "ECA_CA_S2.png", "id": "1553145808652115", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75392232_1553145811985448_7681725033970670856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kAejM_AfAgQ7kNvwFKCsFK&_nc_oc=Adp5ehQbjqiN_FcXajF6BWPkONRHzYrqTwrfAEzr9RHa0cgFikZWh
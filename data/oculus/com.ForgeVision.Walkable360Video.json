dn.com&_nc_ss=8&oh=00_AfxpIYZT8a2jXP3oGfhfet_0cZBEAZf9UsMdTsSdBmol-g&oe=69AEB7A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khkvM7vIeDEQ7kNvwHGLD1f&_nc_oc=AdnuoEFVnBq40-zeWjlx1XVxZGBddh52anEYl2ve_jA4p9IN81ZC1jFpsmMx9ESPmHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD4YY1WILBEkN_65aSkL9T-MR_LA-lCvI17JSy-Cms_w&oe=69AED6E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXPLlLgmSG0Q7kNvwG2A9SV&_nc_oc=Adla9Q-qDkzsvSNS38n5JXjYbUGctUoN5WG7glLA1vQpLyl3MxPU7Fo-AfUxqsRXJ4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_AaqZj3xVzjFteVmMB6gAaXQk1D0GlZCVLoIwyBzUTg&oe=69AED204"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
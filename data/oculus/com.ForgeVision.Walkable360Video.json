e7a0a&_nc_ohc=YAWyBnO_344Q7kNvwHRtW6v&_nc_oc=Adolpo2u-mJ_Wpe3RCLsJlI5Tfz-uFstQdv0sXjqNq-I3Y4YyIExssmDdR6RHjYSLTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QCbTfk5_jX1Sqt2OJLTJp4XU2yWK4DYLCNY3s0vi7XA&oe=69E4C525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuGj6hmk5-8Q7kNvwH0lMTf&_nc_oc=AdpebgOE8MALh-b_eEGmSJC19t_cCIg9VxdFwkAHdpd4ccwyCM1uspvS1ejm9L6Mor4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IZnBQeNLAvksgysAzATqfIHElH9r_3JVP0oiqR-uvrg&oe=69E4E463"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GTBhQffxasQ7kNvwFdcEqB&_nc_oc=Adr7d5RxZtqfkW9_JpkP20lu0AbPg6CietNlB4FYp3wXeG7wW4Sl1ybVuKSe_xC1_Tk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&
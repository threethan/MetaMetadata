dn.com&_nc_ss=8&oh=00_AfzE_8Y3QuGYlsdCCR660I-N8cs65-k1nP5zTkBF42a8kA&oe=69B2AC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITT1Uu7T_tEQ7kNvwGExqT2&_nc_oc=AdlRQgCWf7WYiZRMCUlxKfvMlrg90qV7WZNWu9wqH3nQvRq1hdQLnFfVcR8P5IPfGI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSuPejvrfmHF8zTE-fn_q5eIhvdGAuv6Xt-Mv1lAN_DQ&oe=69B2CB63"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9KE0IMeiP4Q7kNvwHM2HLQ&_nc_oc=AdkWkwFA2uGtrIe_79IuAGcxEEX2GgMC3_5DPHZ5nGsPL5SNeMGu39nZiOw_L0UberI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4ZTO8eMk4_5EqbSRPZMayFhYFeji8eQQCS1dk_UwTZg&oe=69B2C684"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
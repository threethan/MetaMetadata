dn.com&_nc_ss=8&oh=00_AfxEYZyY15RnUzzpB7ESEpGemiXaChEivUjpBU1C_-DX7Q&oe=69AD6625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sevvMbewzysQ7kNvwEubmgy&_nc_oc=AdlZnOHaYArAHebkKvdtiNlK-uW3c14JBWuDmZpnCWCw-NBEkp-wLjnbsf07dtOSlTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC2HMewKj_VVadRMJpZBuHao6UlieYiSH3IfNqIdLhQg&oe=69AD8563"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXPLlLgmSG0Q7kNvwG5Ronw&_nc_oc=AdnplwDFoV9TTtl5FhqkHCknADMgtlKOTeFCMKldGdATJ2GhNN-QsgqXrf7dDWteBp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxCg0UwGmZMbP3aeLHSDqsy7hH7863O-4WoKmqwn5VMA&oe=69AD8084"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
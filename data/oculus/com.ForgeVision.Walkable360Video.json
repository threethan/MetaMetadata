e7a0a&_nc_ohc=d3Cx-dBhXf0Q7kNvwHdt41y&_nc_oc=AdqzhDna9hg9XwGYGzH4k_zeJQkpKoKsK3DKOuiEQtbyCjsWo-Rx8iuVGOoIz0HfFe0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtW2MElwfwQOn1Kfw_MO-LFC_zgKK5Iu9HPCaqucI1vA&oe=69C52125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9gLaGHOQc0Q7kNvwHGvbA1&_nc_oc=AdpK48wEiG75ktnWtYgRYzpSQnjdYj8sFr_TcXs9rdkmOrpr6Y2Wh5IO6hftSLi-rRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx66DTLT6sO2SdDNCKcRhyLan7WkNk-pCvg1OdWar-FZw&oe=69C54063"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PTHYndC4usQ7kNvwF4N2xV&_nc_oc=AdpzJZivkYVdoZUNPtNbGYNpjthd4hTnkxBPFIj1FcPp_BOMbURgPYLVMYYjQx7T8PY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&
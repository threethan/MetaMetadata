22074416_3388905810994569704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh2sYIzyoxgQ7kNvwFHp2fN&_nc_oc=Adkmr2ttmXNhEBMQf8vf8aU16FFMJIl7ctNWKrCrscUbLqWFiVT8k48F-jAs9T4v_HM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7t8lLQjmixmZXWe6zD59fcbJLBxrpb4qlEQb22Hcirw&oe=699EED99"}, {"file_name": "select2.png", "id": "360852952275944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974673_360852955609277_289561917377990546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tw3QTy7qiAQ7kNvwECftrR&_nc_oc=AdnNPafXrKszJ5F7WCz_8Z_iL8caTmG3Ec3IHUcEf8jkCbWZiGLmvQmyiGn6zGDDyBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvkRbkCw9dcfKbvGXpG0PEOkvtzDYctOWPbRggKC-6ntA&oe=699EE870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc_PRQnJd1MQ7kNvwFlJgfy&_nc_oc=Admli5rmc5Gc7NS7ndbsXbYTEtCaHueiHJf3r1O0_RaWjAsP0ZC4k76Nw590lUlPXnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-wcwNKCA7pTDHvbrM0Myb3spaOd6MSuA4P9_01nXlXQ&oe=699F04E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  Menu button...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Look at your raised palm and pinch...Display menu\n  Pinch with your right hand...Select", "short_description": "You can enjoy ex
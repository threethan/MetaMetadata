dn.com&_nc_ss=8&oh=00_AfwNS2ehVaV46_4DJewdOJulzLOfXxEfFcgvd3Ev5YqN6A&oe=69AC14A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sevvMbewzysQ7kNvwGtI8KD&_nc_oc=AdkAh091trhvPpAIH1X8KWTANIvfaarvnULn7AlvUjmbA75FUwfvccFwT-W6A0RVR9M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxABMnqImr9BVOrBjRPnPa0pFD6FpOORHcJ5Q08VjWUWQ&oe=69AC33E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39qD5K8BQNgQ7kNvwFOA3k1&_nc_oc=AdnEU0jHQhiR1MdCzVuP8KR16cuzbLt8yA0CPOd8-dcGTwhZOWvQ2qwWUOk-SUcVWeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPf1-DTVhC0txuN_u1DYG-JEhkFLB0_RA_-js2RDIZmA&oe=69AC2F04"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
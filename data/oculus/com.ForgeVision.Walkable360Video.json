e7a0a&_nc_ohc=feiCzwRvVMoQ7kNvwGDHDbS&_nc_oc=AdpX0nrrxP4xZ50qYB5YCudjimWYPMHWwvvki1h4I-FV3tvzGKUZaCvZ9Yg59cmeVUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_-MX9MRW8RpHE5UQ_8rifU1gOn29gFzpo7VyhSHBCwg&oe=6AAC0FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr-YgO_0MeIQ7kNvwHIC9Rd&_nc_oc=AdpdVfu44vTg8OHUuvKWUg_eeFY3BzArHKomsOQyOxgaCaLVak8lkfu-RsvyoX9xnV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLph8x24EYfNcdge8lIFa9pIZWxhp5gRDtd1uI3nKSelg&oe=6AABF6E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3Ndo19dE2cQ7kNvwGIKncH&_nc_oc=AdqF8CwcqLdcDztHuo2-YbUUjExjJChQWbe7bJ9Cx7E_s2M-V4YhN9g71QEpsAh1k3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
e7a0a&_nc_ohc=0G3E5gCnqd8Q7kNvwEc4Q07&_nc_oc=AdoEULMuEPmpXTGxQeOgfSZ6gexT1NxGxfzszZV_HPUos8FYQvz8d_PPCaBvOuB8b1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D_tW_jXMclyp4xUqJwv-Gd6rxcyt5CSAQSt7H89Jnyw&oe=6A1321E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_fcIvjZLdcQ7kNvwGGHtaS&_nc_oc=AdrMDxp7-aSWGzVMqXeIyNV7xhMRHPLGeN6vvWQzgJKb5MtLZTMzKgFMBtHPDTNO03g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zW0h2ZX7_kUX5xeaT02Ma5gVUhznCEa-QNxDb1kRYMQ&oe=6A1308E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaHuHcnA1HIQ7kNvwFL5VQU&_nc_oc=AdqvXd36DpoBj0AClRlm3xY630-gdY-jPUH535NMPrRwgId4H2ykfSQfBKx24dKCvPk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&
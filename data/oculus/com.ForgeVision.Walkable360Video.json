dn.com&_nc_ss=8&oh=00_AfxVbwgFueF-pcdkQiHB8VTIUvVLA68ljgcIRczSbNIJxA&oe=69BE89A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWRfEmqKJ3kQ7kNvwFqJRsc&_nc_oc=AdksDechV8mgttjuGu5Fy9fBQlb-g0pCyQBORC9ZvyxgcpFvDsM6xernHH7w0oefVqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7zlHVJtWrcF-9-F0qlKDDWNOFwZwb3ZA20MNjyM93Aw&oe=69BEA8E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97jNxcMGwTsQ7kNvwHsRuZM&_nc_oc=AdkscGXHH_VcSN8nxbJlYim9ihv1HnBpFVacvo_Q7cLlMQqMuP6D_EMbcD798EY20RM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi4-EldlQMwU9I0FrBN4JYMZXyWPlCdGUDeliOv30C1A&oe=69BEA404"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
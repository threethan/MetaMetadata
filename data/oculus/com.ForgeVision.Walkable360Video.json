e7a0a&_nc_ohc=UigYpODqByQQ7kNvwFKSNMu&_nc_oc=AdqpGYT2xyX4JQ-60AMZr20BokjJD6l71U-mJV_qNW2f_lXFfzSq4HBCJCcm1LSLHvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBcsH__Ez3Lu020d2GCCB89vrqPZMGCNSHE10dHhy9Cw&oe=6A75CA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fVJYh9pdekQ7kNvwHm97kt&_nc_oc=AdqUTmHlZ_9e_Kb8zx97orf4hN_avZ3U03hSXq5MDJUb_WL5HzRqvETxg1s4owdMw5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsk1JHMcFeN_b0R8t6_LUSmS6sGbzxdhEUFpINyAdRKg&oe=6A75E963"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvB53J71RXMQ7kNvwE-6Gyh&_nc_oc=AdpqlkoecTNMTKxqn5wMDhICgHpeMRQaH6c0zyGQB3oTmoSiJReGftDJVAdhJCYcbZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
e7a0a&_nc_ohc=5yLuULoJpR0Q7kNvwEeYImH&_nc_oc=Adp2a8U7UjjCzSffmnaXvVt29Sb0Qy_TfzhRBLtGavfDRPLXugr8aVjiNqgN4wZAKFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Cz3IZWE7awBIvjc3YRLUA01lBZyq-6kzDLaGmWQzfA&oe=6A4CEBA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqWRTCI1E8UQ7kNvwHnMhp1&_nc_oc=AdptCWnpvPv1k-O8waqrkg9Lt_D48A6dlHekEzEkXEfOLV47EOvaMU6zz7T3j9p6bB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6-YKlRlEzlIaeH3nBn8gyD2D2lyeUn4yXgEW1yMBv2w&oe=6A4D0AE3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQVx8QX-LXYQ7kNvwH6J4VJ&_nc_oc=AdpRoOoFsxfHhmBRAPyndtEe8Bfv3xojAexjstObCShoKTRmPs4xtT9qaXyJDrH7ljA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
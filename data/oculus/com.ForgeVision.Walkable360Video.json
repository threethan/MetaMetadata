e7a0a&_nc_ohc=lU9qMh_4aI8Q7kNvwGFzs8S&_nc_oc=AdpG5_Zcw2AYPxSuqv0z5Oyk7Qt00LyYDzpz1QxEsqFVsRNvVjd0WBNTNeJUN7EL9jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjrHGr9SdxPbdIyUH_-u7nxw9_sXddKeOqjgLccvsxNQ&oe=6A8C33A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LoR1vE1nGMQ7kNvwHVNPiH&_nc_oc=AdrJJUiDgWMLyV2wFCQZPRtegEAV25ZPp_NMLAxkQq-_4pq9qiYviY_VuyEM4DAF9I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaDOpPlxmdGSzMaQH2fb8A02uF8Sy5a_ZtAaQV93DBzA&oe=6A8C1AA3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kumTdwoN76AQ7kNvwE5tKCy&_nc_oc=AdqKeZ4XvgIGarBYZG7Al2H7fZMoN5oVzTGIfmNYKa11A6nV1L_YI6M2Q5XhjhU9sJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
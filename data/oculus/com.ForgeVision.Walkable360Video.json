dn.com&_nc_ss=8&oh=00_AfsBGeRnVpENjfQ4mz80YYkzkBHH3WyaqKmXrGg2E_OF_Q&oe=69A82025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfTLbkB35uoQ7kNvwE7MyCX&_nc_oc=AdnhMYbnr6SDizrXH0l2LHkjuAJXYhFFfME5qyaRzXralYDyzGfai-MDEExborZRWIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsLrApAoEqOC6UqyevSBWHTqN7OuTrPUOjJFWMTxQolOA&oe=69A83F63"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XELqPcYdWg8Q7kNvwGNEhMR&_nc_oc=Adms2vs0MofRVw-anvZdbr6ZAjke3EYyr9iUTEBpfTVlHP1tt3c-yQUBNm3Q2kWOYUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs9gg4YX4ri42vHnbuJfiHIBrWufdzICaq0JZFmS4sHhQ&oe=69A83A84"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
e7a0a&_nc_ohc=q_jP3edHgu8Q7kNvwEobJVC&_nc_oc=AdrenvWrZ5fGGb0bMzfc6VJt48qG5Ov0pUMohsre-QASXHpsw4Ku7mD2ow0C-PunvIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfrdnS1IOJqmV2bVUFKMxEzbZiZYl7NnGgluV-Z_YgAw&oe=6A6B3E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMEUTDUsMNcQ7kNvwH7OGvz&_nc_oc=AdoqtoonGM7C66byh7_oWa1vftofkCPDyy8CVyku6bxQgQv22rRAESOwEwAX57YYkw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIcLseq0nD3Oe94UcOZT6KsdF_WnS5ZyoIXcUQO_JlCA&oe=6A6B5D63"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp1twwNbt0oQ7kNvwE-g5-x&_nc_oc=AdrKzlC0scvSeBFAQxGoP1Z6GG7ePpdJuRDS1LDlDGl9cLOAa6_37VJXnbQcaXBc_5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
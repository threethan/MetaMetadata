dn.com&_nc_ss=8&oh=00_Afzll1HQxCgzVUaQGwSB5NhkqlH7eKuxlG9ii3ML5vDFrg&oe=69B7F225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyaFZEZL2jYQ7kNvwH5QX9P&_nc_oc=AdllW2SOMvuERRlm2HUT4gLDCg6c-uBz-WoDxJPAV65rSf-ATgJH4rL3eK37QXXf86Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuVjz2YpgPZ_UxVftwX14ooAovJhNs1OzQn9pcWCxw4A&oe=69B81163"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFCM9LbGyyQQ7kNvwEkGIlc&_nc_oc=AdkCHWXtFSP3X30TXqYX_ShlyMuK4DIzpOG0TXau4gkP0G4Qbu7DU9cZuxKXrKJHE5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1s_quIhCRX5SwWYwREcDvZbm1s5wS-3sElBcRuyGa9w&oe=69B80C84"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
e7a0a&_nc_ohc=GDQpyYB4EBAQ7kNvwGX8Gop&_nc_oc=Adq9nNmply3N5XCMXKrkdCgSvJFFmikCX62ZHPIK5j4UPHuiLW9kbanN0arFVxpibAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVtpTdt9DS1rL6cbjJkFOQ35IDtAFji67S69-JIlJPtA&oe=6A7F04A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2YpFp6XutkQ7kNvwHhK6oj&_nc_oc=AdpTU1z_I3l0jrTD8HfTamVsHmbBCOweCSJWQM97yalugmI98yr5Plattkfl8yJQ7Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvd5ZXKSwR4w0p4yVHDj-qTfcam5x_GmG3IJs0PJyY1w&oe=6A7F23E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMQIf2FggMIQ7kNvwGB51n5&_nc_oc=Adp6_mQ_zOprkepLzxVkc1dnBafGdZRLIVQ9f3riaHAEMVbcdxod3r1mszs0dspo7wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
e7a0a&_nc_ohc=6nUo-gomsXEQ7kNvwFLssor&_nc_oc=AdqM3WkuxmKuUF4f1yZ3mGAzTQhmVIkSqkkg3vIXtczeU4-RlfrG5G4RStTo0t8RFpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkzBV_ZUPnrKCVmvKHtwpWyLxnmLyxIg029Nc1ducQfA&oe=6A82F925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edow4Gcca2wQ7kNvwGWgm9a&_nc_oc=AdpaulgvT_tqQYpB93vq5duGYGywZZTN5zEL-YL91NjfDfx91H_0om16Ji4uEtuomaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAVYI_o6A-XLYCDkhoCeZ6VguipHD7OAFTaNsTL8xafA&oe=6A831863"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGFg77IWPcUQ7kNvwE27Vlc&_nc_oc=AdrqUj3IsTtnqE5d_oaunRhivVSUE6FLrabYQSXrZa5ta-s7RquFNrxOKGWv050o3yA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&
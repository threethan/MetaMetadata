e7a0a&_nc_ohc=b43Ziy-iVi4Q7kNvwFafUZr&_nc_oc=AdohN9cyem4_GHRLKklCvFzw_atR866m8Jbnpg-2SjSQvXCd84UfWpG1T_HrZ1ay8zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EmjW16v9a0RWl1HY6Vls7OkdLEU0XrrtoLptC_5BKIg&oe=6A3C0065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zt5QfaGD74Q7kNvwF9tdXN&_nc_oc=Adrre0CeGdj_MK8_EEB2uffjDTfIaE9i70BO4MJAU9eclAQPSbMzSPh5QsLng6_VdEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g9C2lZJumbAFS1H8QcddCtSL5X6TqOetC5vRTNxQi7A&oe=6A3BE763"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehvsapBbMzoQ7kNvwEJmbVB&_nc_oc=Adr0yOqL8qJRgNWs-gsCuqp-030RPTf5HfOXgR0K9upCfflqzXc_t0mL813tsYTDK98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
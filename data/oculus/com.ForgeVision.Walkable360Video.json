e7a0a&_nc_ohc=5yLuULoJpR0Q7kNvwHWiW8u&_nc_oc=AdrodtL6Ky_8n7xtp5g6HbZO8tos4Skw8GuhzY_NdlMx6YWCkj0piq8sCMzCABwlrGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmycEWyVkeLFv5DkxqrltdKs6qacqHCz-tJURSCSy6mQ&oe=6A4BD265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWCQZNAyjo0Q7kNvwGYWYOf&_nc_oc=AdqSbap5cqme3iG1PK1_yz4GMuLdaFqf47jS5PZTcYqeR06lrfVJfTUPjxT4IAWg3GE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfjVWUvT0o5-KHx0j6TJpUvgkKwpvuaf2hx37xgWfvBw&oe=6A4BB963"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQVx8QX-LXYQ7kNvwH0kxNc&_nc_oc=AdoAhJG1E0P6AKhKM-ynpE2vJRVaTkNxunC4SomWN7EtYkfeQnikQDXxz6aXb_YlcEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
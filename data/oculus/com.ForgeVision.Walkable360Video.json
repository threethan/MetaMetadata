h=00_Afzc3U2YuWd4oJgK2yol_u69Q0Dg9b3D-puHPmBfJEJqdA&oe=69B7F619"}, {"file_name": "20190117_025255.png", "id": "2815766318741083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375083_2815766322074416_3388905810994569704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8WQh8_AfHAQ7kNvwEPa6ym&_nc_oc=Adm5yGPRKJ5Wv9cxY6J3Dr118SyRo-aoA3E7-9HkFrQPrLiJjtOChGBIQwK1H8bEe-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy9EtWrUiRVoprnVxGtSPWKYwb22cOlkJyXx2DT2Qrjcw&oe=69B7FA19"}, {"file_name": "select2.png", "id": "360852952275944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974673_360852955609277_289561917377990546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqTWXKgj_PAQ7kNvwEJ4CiD&_nc_oc=AdlB-bS3pDbS4_m0oY5oyENpHrUdxAYkdwAZ5jAG-cOApWqbu9JTo7q-_pl4SBN4vFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhCQk9gxiyaLU5BF9xTpFmff-OVrShNUPzlySb8HO5SQ&oe=69B7F4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyaFZEZL2jYQ7kNvwH5QX9P&_nc_oc=AdllW2SOMvuERRlm2HUT4gLDCg6c-uBz-WoDxJPAV65rSf-ATgJH4rL3eK37QXXf86Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuVjz2YpgPZ_UxVftwX14ooAovJhNs1OzQn9pcWCxw4A&oe=69B81163"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  Menu button...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Look at your raised palm and pinch...Display menu\n  Pinch with your right hand...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://w360v.forgevision.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "ForgeVision", "support_website_url": null, "website_url": "https://w360v.forgevision.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1712407615928294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195904_1405343146469944_8168917841517985146_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm23vI6U4mQQ7kNvwG8Pi2J&_nc_oc=Adnio5q1oWiXfWvkH4_ImhO9CYYRFzkmua56hpnUZlYD42aNDBk8X-1wPIEVzg3C6Ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywvVy-EtpUgjAN43j4v0tMb7iO4bqiRTCHwCtqDuA2AQ&oe=69B80209"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Walkable 360 Video", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "relea
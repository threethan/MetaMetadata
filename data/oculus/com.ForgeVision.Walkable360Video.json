e7a0a&_nc_ohc=8xyLOlujvjUQ7kNvwHwCI0D&_nc_oc=AdpAI0BJh1xop_WHuAlCmh0dCtyrHPn-4S4kkpp82sAL4OHnskQ75F5mY8FNTGwezK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkMcMCw0qO_UuKG1i_Rs4zevbydmauq07cyuQ1YVC21w&oe=6AA7E325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMeruA5qrPUQ7kNvwE1eNpH&_nc_oc=AdpHnSxcIhAMWMzspijF6gdRtD20F0yUvvZToucsaifwMH3Tfd1LW6nAwaSG6XiQqsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNcE-i70Rzd0prMnmug7YPdNDDjsKEOqod51faQZ5fJQ&oe=6AA80263"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr6G7nrcCLYQ7kNvwHWjJqB&_nc_oc=AdqlOlJRa72wtYJ1I8z8fFef8mglD-fIFDdRuvk5vi02o6MykI72DnBPdxVompnwR48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&
gtJuKYZ_5esAt9Zj8u4kKz2eW12s6loKm1AXLTHwpT1AFDUA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZsVfrtglH2H4lHYGnDsgq54zkzu8K7gDKIqGPYaXfXw&oe=6A396159"}, {"file_name": "20190117_025255.png", "id": "2815766318741083", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75375083_2815766322074416_3388905810994569704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv6G0aQzDdEQ7kNvwFwTcCQ&_nc_oc=AdoDWDVvT-gPYhrGWQLQ74khQ51Jb2ynoaOZ8lKt0MChMzw2PQg0t1LL369wV94SEFM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RPUTMv5GrgvnhkLvpfOmXqML10i5NWXgs5fj8jPZc1Q&oe=6A392D19"}, {"file_name": "select2.png", "id": "360852952275944", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974673_360852955609277_289561917377990546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtgE9LXXyiMQ7kNvwFW7Kiy&_nc_oc=AdrbsRfXNlSAI3sPAh-fxefHLU36lixCGhTwj902KZf576IW2JpYlLfbVMfd718MoPE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bjJbaP0T2iDTFSMFni6d9chkbdz6IfcyLi10p5aTg_Q&oe=6A396030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zt5QfaGD74Q7kNvwFH00kg&_nc_oc=Adpq682SF2kTwyXYj8bscO2tqRQcR8IdN168Pv4dzI_fFDcTEhmI5O6UZGBPz3nFwr4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h9encD69TWQSvNpETVScmFnQvfJyqXXbmxpF46tS9Dw&oe=6A394463"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  Menu button...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Look at your raised palm and pinch...Display menu\n  Pinch with your right hand...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://w360v.forgevision.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "ForgeVision", "support_website_url": null, "website_url": "https://w360v.forgevision.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1712407615928294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75195904_1405343146469944_8168917841517985146_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK6iWrogrlIQ7kNvwHxPNo2&_nc_oc=AdpHfTEvA0uIsfDaCNtPobTC3tRg4ZYloeQfSf_SQiX5WOGN1qYDvU9o0MpkA_4WF8s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2veNSfLLwFT-Yr0HDV2TesJU4fDXlu9K0CKmhvVOcoQ&oe=6A393509"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Walkable 360 Video", "platform": "ANDROID_6DOF", "context_category": {"context_category":
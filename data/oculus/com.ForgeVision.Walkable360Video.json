e7a0a&_nc_ohc=w8j2VM_yKcMQ7kNvwHmcT4I&_nc_oc=Adoq76pKD7P53TzrNIWslJPnsNO0-SoNCz4sUWa9G9STHFHcbeG9tJs15msM4AdlTZY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtNt2UBa0Laq1n6gsL5YU9vH7XSeCSdZPznuWiHtSKyQ&oe=6A5A1AA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFLRq6sFPwYQ7kNvwHDxDD4&_nc_oc=AdqnQcuTTbg7AmE1T5vct4S2X5bJDGuxuM5kGCQQIKOIg6bxQOq4OmrdG9C5ecgusjc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1RbRpskypXU-skz1PxXLHwJ44lpWVu2l2nFy_QksIcg&oe=6A5A39E3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BojlBu0Q4_4Q7kNvwFGTJPj&_nc_oc=AdoA3tOQFSZsNGRKbrb3enLJHk14M_Un6pHbolCRRpKxYbocquCc8UuHNHdhzqEXv98&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&
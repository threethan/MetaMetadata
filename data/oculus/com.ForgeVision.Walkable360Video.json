dn.com&_nc_ss=8&oh=00_AfyDfG7BbmTgboaRKmN1eOGwN018gRv93KQWuR6vduznRQ&oe=69C12CA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWRfEmqKJ3kQ7kNvwH2he_e&_nc_oc=Adp7UeghgPEz2mnzet_bXkp0BXiEAV4EJ89m7nxTLjcf8VIFdsPHj_pjWuxO0AXZNtw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZB2H77H-oqVP9xFlm-4RDlwd7vJTg7BEQ9elyO44BfA&oe=69C14BE3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHQ3tDfBsRUQ7kNvwF0DG1h&_nc_oc=AdrLter_9exKJdsdtsloWp5oLT7fZdw2w0RpkNg1Z0NkRA9jINPY8rwvlsYQl7hIBBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzqbjV90YsUIY5bzqvF5UzE6R06SijJLEvR_AUbnr92wg&oe=69C14704"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
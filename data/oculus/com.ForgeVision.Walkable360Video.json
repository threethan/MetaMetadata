e7a0a&_nc_ohc=V1DIRwzp0_YQ7kNvwEWSHST&_nc_oc=Adr4-DzTtb3y7Jw_FRgyVpiMZQ8U-H_Rf484sACpv3BgQl3WoBVsdCJd3oN8FUajBuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpsQzTa9VUgrekJpV6Sdcp0WOoBSPYyUr38XsQ6Hr8BA&oe=6ABE84E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnexejeZEywQ7kNvwFyUeCv&_nc_oc=AdrrvIaBU0tWmhAddKL_-95u8jym_Be4FdXfoIKqW3Jm_lUPHbGqhQ6Q64WQMYOPUIo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL334h2n4EqYBGFNKw7gM60nuO7kaoyLqKWG-MX5DNVXw&oe=6ABE6BE3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjYB-uIc-2UQ7kNvwERobeb&_nc_oc=AdrF7RCUX7ghfGUGjezBqcogrYXVEWo9ozy9xMhK5FyGom60GSnfeeabGk3SyNQjaPk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&
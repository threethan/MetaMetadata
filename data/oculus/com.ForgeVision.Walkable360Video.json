e7a0a&_nc_ohc=lU9qMh_4aI8Q7kNvwEIjWa2&_nc_oc=AdoJYQC-Qc5LBxbOIYm_lWXIsyVOqpb4Ef3ogbDn1wZnoA26F1ycIB_OR33E36Lg2Ys&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMwwhdkgqZPoOEQJcvMNdX4rwjwOn7kRtZwK9kP56RXw&oe=6A8AE225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxKp0iOq4tYQ7kNvwEd4fi_&_nc_oc=AdrrxqfaDqSbI5QXsxptayEXYhpofh1Q7_ZPoMXvc7AvdayID1a9wjhtDKFkGGzv8WY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmnwh_u2hFVAiSgS0CJz8gaZztkogmPRyXvDcv5vi85g&oe=6A8AC923"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kumTdwoN76AQ7kNvwFu_6p5&_nc_oc=Adp2PBBsa7XM1-6fagTPY9IDHhBq-qMXG7oEQREpTUtoW3GF5mlk5egTjw3W_kvlbSs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&
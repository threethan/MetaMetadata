dn.com&_nc_ss=8&oh=00_Afy5-s-E9za1vsGIV5t6zQB0qdc6QW-xkIiVvCVVxbn6Ww&oe=69BA9525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC50N06AkDYQ7kNvwEqvrcs&_nc_oc=AdlGA2Dev-EBkqA5iksxnnJKrP-mEp-XjnIkz3SUrZL83nrz8r-kdVXLO3XKJa5yVRs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJdiFMoGAfrS4agj02UkT4ZZiEM-Dlhcq2RENYgS5SpA&oe=69BAB463"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4i7UCuV-y0Q7kNvwH2LTKH&_nc_oc=AdkjhtQXx9aSlLvMDJQHca5BppqSAzWSOfay4hRzZ6096Q5L1PaRUE4qI8vIDodRCIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxf6dbzci6SUs-f0hjZ4rgKIN-n7vQrxOlrUkGkR1Xjzg&oe=69BAAF84"}, {"file_name": "walkable360applab_logo2.png", "id": "2827393120859875", "image_type": "APP_IMG_LO
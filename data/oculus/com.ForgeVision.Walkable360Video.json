e7a0a&_nc_ohc=lU9qMh_4aI8Q7kNvwEPFbhU&_nc_oc=Adpr0MHqhxlz2vkpVFRuKqG6ckEwh-bwBNeUTXmBjryzoON1vVf_sqOUZlHfzEYLkco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoXfFTBo50TJn_3RK7SGdjeVjVJy2qrNp-z5UpdTNgkQ&oe=6A8990A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxKp0iOq4tYQ7kNvwGGkWuI&_nc_oc=Adr9LSFds7EbQ9EfhueDku5e93yNasjncmvwoQUuT_RgMy7hY76Ke3KOWAHn3q2BYVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF863lVGFfQQlSy0w07_cxWkdM9oDWDEDrbpjQNc8EpmQ&oe=6A8977A3"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGG78ykju10Q7kNvwHgS5-H&_nc_oc=Adqcve0QJXaDoIQxvm5kvujK8H_FkMytDXppMsTW0IIRxk5xBuT35Qg9tiym5Nl6g6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&
_j6-zhFRtptTiHqTcjiOp7-IWlxPiIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gw752L6XDPIN0OHfVx-ABaf-HKVil3XC0qrF3pC4B3w&oe=69E4C919"}, {"file_name": "20190117_025255.png", "id": "2815766318741083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375083_2815766322074416_3388905810994569704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWfwdPM3V3wQ7kNvwEUnIcw&_nc_oc=Adrz6VnD0Uf-0cXAGym_D9kmqCcWXU9HbIDGKR3Hqj7gNBpZ_bSxNvtStHlx55OuKEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MVkkggVa44wtssCpl9CB-aN_ncERCPzN7f3L2qEnBhQ&oe=69E4CD19"}, {"file_name": "select2.png", "id": "360852952275944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974673_360852955609277_289561917377990546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY30ZkR2PREQ7kNvwE_fQNL&_nc_oc=Adp3I1O5S-_pPp51XGiP7wSf4-Jm2sT9As2GwpCeGpxlqE12ly5XKcnBe25bPzoT9Vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZB4mzrDtpOhO0Vy1TZ1K8uA8JWJQgeh9JiaZOYtpn0w&oe=69E4C7F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuGj6hmk5-8Q7kNvwH0lMTf&_nc_oc=AdpebgOE8MALh-b_eEGmSJC19t_cCIg9VxdFwkAHdpd4ccwyCM1uspvS1ejm9L6Mor4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IZnBQeNLAvksgysAzATqfIHElH9r_3JVP0oiqR-uvrg&oe=69E4E463"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  Menu button...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Look at your raised palm and pinch...Display menu\n  Pinch with your right hand...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://w360v.forgevision.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "ForgeVision", "support_website_url": null, "website_url": "https://w360v.forgevision.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1712407615928294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195904_1405343146469944_8168917841517985146_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrfIDE70mqIQ7kNvwE3uMqT&_nc_oc=AdrZuRofr-a3KJl5xrGvYH3rBY11ejZh8lHHBqXqzksj4h9J4uHeTGrljGEixkNtKE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yBoig2rJKCbbmcE7KbXUAhUfMBtz8CwEUAZ9IrIjjMg&oe=69E4D509"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Walkable 360 Video", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "36
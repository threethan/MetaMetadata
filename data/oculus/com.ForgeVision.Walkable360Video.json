e7a0a&_nc_ohc=eZQbeFyc0wAQ7kNvwHANE7a&_nc_oc=AdoXsoTlCNfZLfb_xJN-cxN2_ohnGaAfvpWqMxCK-zXCitX9xy_VLUCY-ndkYGxO4ZA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af754ClBsG66KGO2KfNaPn-zjf2gU7S98_EbcFVMw_puUQ&oe=6A0EF525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMw7XvqY8msQ7kNvwEkrkIb&_nc_oc=AdrI2qw0QO2G4vTSFZlwPpdvx0Y25XEXlpasmISTkk_qH0wNGxjFpw5NTHpbtnn6plY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57jAsQF2_NQmsK04U4jKm9YdrkiKi6LFn4XLIDM7TqgQ&oe=6A0F1463"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps9FLqG5ZtIQ7kNvwEojiW0&_nc_oc=AdrrVk4Vtu-bZeDE_VsgcOF6K6G0nuVLqyCILmQZIEHRI4jCKN4M2DicGxUMXpUq3uE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&
e7a0a&_nc_ohc=rhsUwM8UsyQQ7kNvwEjh33g&_nc_oc=AdoD--jyg8sTOdryznDxnUHEY8kRCdYpIrF2xXGcbceiOnOfX8uaML97ke-9lN5N1EI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6afA6zRqnAIWNihciXmax4pih4tw9ApgOaIZW_ywV_5Q&oe=6A09AF25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE2_cQpkIf4Q7kNvwFP-RnQ&_nc_oc=AdpnQWpa6209NZNFkQIne4cUVetwjt1h0Xrs0w3XdMpkeX_MbNcyfdWwht_KXQYQb3I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60gwGNdUkGosrl5cMi03X0hv0YovmRFiZIQ7G_RbFSLw&oe=6A09CE63"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  A/B/X/Y buttons...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Pinch...Display menu\n  Touch with index finger...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}, {"images": {"nodes": [{"file_name": "walkable360applab_icon.png", "id": "480730176505648", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031603_480730179838981_8784053951676686878_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNxDFgS9CckQ7kNvwFLcbGc&_nc_oc=AdoAVV5u4LTyY0uZaohIk8XEICGSxWiDjVcrxhIJM1aVefmIx7__9VsgnNCOIfgtq5M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&
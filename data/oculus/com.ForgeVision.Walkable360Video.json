cdn.com&_nc_ss=8&oh=00_AfyGZNudaVL4GNYghbSCts8nHBE9janJE7PdtQbp8gKAIQ&oe=69AAC719"}, {"file_name": "20190117_025255.png", "id": "2815766318741083", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75375083_2815766322074416_3388905810994569704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8IPa2m-lN0Q7kNvwGC3U1H&_nc_oc=AdkgpacQY6QWp8LMzhiYqzy7xJtggUBaRQXrawiQBaOaXB3O1A9FhZTPvd13mH32Tvk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyj_3XsWhfIAuvdTHkGFpUfYrvLbrc8U_izeOvLAlShRA&oe=69AACB19"}, {"file_name": "select2.png", "id": "360852952275944", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974673_360852955609277_289561917377990546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKvKOmoLMZQQ7kNvwGG7oGu&_nc_oc=AdnwnzULwUZ2dFYfbh6wAGtCVOSy0paAp1ukWDW73vsGxKuPTm2_ThqG0_-oFam1_e8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzejNmpJ9ckvseW1KUUKiWY6hkceGoQaApvi-zDXJsqTg&oe=69AAC5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "walkable360applab_16x9.png", "id": "2928143990796935", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75222945_2928143994130268_4675042322529854180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sevvMbewzysQ7kNvwGooOmu&_nc_oc=AdlizPE4daU_kUAfryiU9iPFCDRSDr4n44dVNHnI-HcfmT8yu375w3rl4lTGDB8G8F4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRctLuJE8hi1DD6_LhvgI3RPZ8lrdejXk6aFOsuRAYBg&oe=69AAE263"}, "display_name": "Walkable 360 Video", "keywords": [], "long_description": "You can experience VR video as real as ever!\nVR usually cannot close up or walk around because there is some gaps between a point where a player stands and a ground which 360 degree footage shows.  However, this new VR called \"Walkable 360 Video\", you can walk around as if you were there because it creates three dimension not using Stereo Panorama which takes photo with two lenses like our eyes so that it depicts as if you are seeing 3D picture or photogrammetry.\n\n\u25a0Operation Method\nTouch Controller\n  Menu button...Display menu\n  Right hand trigger...Select\n\nHand Tracking\n  Look at your raised palm and pinch...Display menu\n  Pinch with your right hand...Select", "short_description": "You can enjoy experience walking around through 360 degrees view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://w360v.forgevision.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "ForgeVision", "support_website_url": null, "website_url": "https://w360v.forgevision.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1712407615928294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75195904_1405343146469944_8168917841517985146_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=653HsU_uo-gQ7kNvwHY_nbA&_nc_oc=AdlvXO1jTE1YRQKUxHKt7V7g2XRXo73OiVjVh6Z22QmEwjQiAV9pHN-poLVfOJCQFHs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpUma6TPJs76JxF1oQPZfaU8Ee8qo3LP0OPtrbCSLSTg&oe=69AAD309"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Walkable 360 Video", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "72636858
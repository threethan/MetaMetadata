_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIOAhZaO0i8Q7kNvwF76Uet&_nc_oc=AdqDog99gnl__9cfT4G_6V8CuJ9bQ3KBny6siaeu9O1sJVQGrA14Qak20ZV-Y_BlMJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSui5fcXOcjVMH-V1iWM2mvO9NhEIKSrnuQsm86_8YPQw&oe=6AFB205E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "614279034633640", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391909_614279037966973_7217059226938573029_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HtDLSrw7qUQ7kNvwE6BfxE&_nc_oc=AdpDCfx-DpW4VY0CY4Tx3kg_y8M3mcUIIAg4WXuULI8T7EEBYL4kNN6gJMnyoEPDC_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmnUjTjG1TDDMKy0UFXaOnRlRO4jBgSKx4c7eayJZlJg&oe=6AFB15BE"}, "display_name": "Castle of Secrets", "keywords": ["CastleMysteries", "ExploreAndSurvive", "SwordAndSecrets", "TreasureExplorer", "ImmersiveAdventure"], "long_description": "Castle of Secrets invites players into a captivating world of exploration and danger. Step into the shoes of a fearless adventurer equipped with a powerful blue laser sword as you navigate the dark corridors of a forgotten castle.\n\nFeatures:\n\ud83c\udff0 Explore an ancient, mysterious castle filled with hidden secrets.\n\ud83e\udeb4 Face deadly carnivorous plants and volatile explosive mushrooms.\n\u2694\ufe0f Wield a glowing blue laser sword to defend yourself against lurking threats.\n\ud83e\udde9 Solve challenging puzzles and uncover valuable treasures.\n\ud83c\udf0c Immerse yourself in stunning visuals and a hauntingly beautiful atmosphere.\nEach corner of the castle holds secrets, treasures, and challenges that will test your courage and wit. Will you uncover the truths hidden within its ancient walls or fall victim to its perils?\n\nAre you ready to uncover the secrets of the castle?", "short_description": "\"Castle of Secrets\": Embark on a thrilling journey as an adventurer armed with a glowing blue laser sword. Explore an ancient castle filled with carnivorous plants, explosive mushrooms, and hidden mysteries. Will you uncover the castle\u2019s secrets and survive its dangers?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8939349666191849"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1586528589935329"}, {"status": "PUBLISHED", "id": "1642079346905354"}, {"status": "PUBLISHED", "id": "2060790581514031"}, {"status": "PUBLISHED", "id": "869927735411806"}, {"status": "PUBLISHED", "id": "1456163105864999"}, {"status": "PUBLISHED", "id": "818793727400307"}, {"status": "PUBLISHED", "id": "2013294032818545"}, {"status": "PUBLISHED", "id": "558416583962208"}, {"status": "PUBLISHED", "id": "1185411552958340"}]}, "baseline_offer": {"id": "2013294032818545"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1586528589935329"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id":
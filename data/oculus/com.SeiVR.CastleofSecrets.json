, "display_name": "Castle of Secrets", "keywords": ["CastleMysteries", "ExploreAndSurvive", "SwordAndSecrets", "TreasureExplorer", "ImmersiveAdventure"], "long_description": "Castle of Secrets invites players into a captivating world of exploration and danger. Step into the shoes of a fearless adventurer equipped with a powerful blue laser sword as you navigate the dark corridors of a forgotten castle.\n\nFeatures:\n\ud83c\udff0 Explore an ancient, mysterious castle filled with hidden secrets.\n\ud83e\udeb4 Face deadly carnivorous plants and volatile explosive mushrooms.\n\u2694\ufe0f Wield a glowing blue laser sword to defend yourself against lurking threats.\n\ud83e\udde9 Solve challenging puzzles and uncover valuable treasures.\n\ud83c\udf0c Immerse yourself in stunning visuals and a hauntingly beautiful atmosphere.\nEach corner of the castle holds secrets, treasures, and challenges that will test your courage and wit. Will you uncover the truths hidden within its ancient walls or fall victim to its perils?\n\nAre you ready to uncover the secrets of the castle?", "short_description": "\"Castle of Secrets\": Embark on a thrilling journey as an adventurer armed with a glowing blue laser sword. Explore an ancient castle filled with carnivorous plants, explosive mushrooms, and hidden mysteries. Will you uncover the castle\u2019s secrets and survive its dangers?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
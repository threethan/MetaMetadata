vzRtG7iqU3fYVwXQu3dRLevxRobixgvJORDx0rDLbL9LU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft1afinmRs40lgtzABxHZByvEkXqKnnN-LU1Xoh_A1j5g&oe=69984073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "996198778041278", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031321_996198784707944_1867821654081104755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1hk8RfWHe0Q7kNvwGwtBT7&_nc_oc=AdnTDGoUyG-VMz_gxt4xz-U5KDCdmsmKEN6gmpLpCrFdVRFk8c2XtGGCJe-YvEF85LA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvN7toCPEr6sMNHmEpb6yYkSaiYc2jpzXjGKWLnGw7kVw&oe=69984241"}, "display_name": "Mierzwa [MB]\u00b3 Systems", "keywords": ["brain", "learning", "leadership", "executive", "attune"], "long_description": "Mierzwa [MB]\u00b3 Systems is the immersive VR platform used in the Executive Attunement\u2122 program. It targets the four domains that power distorts: Mind, Brain, Belief, and Behavior.\n\nThrough interactive perspective-switching, leaders retrain their perceptual systems to decode emotional, behavioral, and social signals with system-level precision\u2014before misalignment takes hold.\n\nBuilt for technically trained leaders navigating high-stakes environments.", "short_description": "Immersive recalibration for executive signal loss.\nAs power increases, the brain\u2019s ability to register social and behavioral input decreases. This experience retrains the system to detect what\u2019s been lost\u2014before misalignment spreads.\n\nPart of the Executive Attunement\u2122 program by Mierzwa Behavior Systems."}]}, "developer_name": "Mierzwa Executive Systems", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRqEgyRn9-1LWLoM5roFqwj0o1J0p7BmoO6k9J0cJ7nP1vDSCzKGhMvrY8PggsjDn27QzkMpZfRfM5Z/pub", "developer_terms_of_service_url": null, "publisher_name": "Mierzwa Executive Systems", "support_website_url": null, "website_url": "http://vrperspectives.com/", "category": null, "com
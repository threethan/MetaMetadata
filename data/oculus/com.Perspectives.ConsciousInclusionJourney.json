975544612564697_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DunggyGNe3UQ7kNvwEMU7Vk&_nc_oc=AdqHR2SUxBJCFpkbGBI23gEpppIoHmv6h7u7x5pKprMmIX52JCOjhV_1yATv-zU848g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdXFSSEOpQnNfM0IRl9-kosUgd8373rEl5GC4DA6t8yw&oe=6A707673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "996198778041278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031321_996198784707944_1867821654081104755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5kY1rSbuSMQ7kNvwFlo_XI&_nc_oc=AdooKTaNQTxXGlcfzJV8lTKL8OUQD42C10FBheEdj789Zarc1-GBObaRKWjeZdaY7Ro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa2eOf_HPqh-VEew69FLkr5XPNbxNNr-kZfY8RimETSQ&oe=6A707841"}, "display_name": "Mierzwa [MB]\u00b3 Systems", "keywords": ["brain", "learning", "leadership", "executive", "attune"], "long_description": "Mierzwa [MB]\u00b3 Systems is the immersive VR platform used in the Executive Attunement\u2122 program. It targets the four domains that power distorts: Mind, Brain, Belief, and Behavior.\n\nThrough interactive perspective-switching, leaders retrain their perceptual systems to decode emotional, behavioral, and social signals with system-level precision\u2014before misalignment takes hold.\n\nBuilt for technically trained leaders navigating high-stakes environments.", "short_description": "Immersive recalibration for executive signal loss.\nAs power increases, the brain\u2019s ability to register social and behavioral input decreases. This experience retrains the system to detect what\u2019s been lost\u2014before misalignment spreads.\n\nPart of the Executive Attunement\u2122 program by Mierzwa Behavior Systems."}]}, "developer_name": "Mierzwa Executive Systems", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRqEgyRn9-1LWLoM5roFqwj0o1J0p7BmoO6k9J0cJ7nP1vDSCzKGhMvrY8PggsjDn27QzkMpZfRfM5Z/pub", "developer_terms_of_service_url": null, 
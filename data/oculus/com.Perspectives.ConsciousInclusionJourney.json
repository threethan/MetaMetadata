m by Mierzwa Behavior Systems."}]}, "developer_name": "Mierzwa Executive Systems", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRqEgyRn9-1LWLoM5roFqwj0o1J0p7BmoO6k9J0cJ7nP1vDSCzKGhMvrY8PggsjDn27QzkMpZfRfM5Z/pub", "developer_terms_of_service_url": null, "publisher_name": "Mierzwa Executive Systems", "support_website_url": null, "website_url": "http://vrperspectives.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23944456865213212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_1464355271232994_5211797055292235493_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk1UGnHbKzwQ7kNvwEf90EM&_nc_oc=AdqBEvJ0OLvjRpx3aYnfNomfJKsI3uxKkw-oTHYf-kXYFYoBhMPChDfdgfgKPRivmSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYaPS5cPm__J3pWH8HV3FnQaXL4si5DMbvZf15sphDCg&oe=6AFC864A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mierzwa [MB]\u00b3 Systems", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1682635995, "lastRevision": {"nodes": [{"id": "6140018696083636", "release_type": "SCHEDULED", "administration_stat
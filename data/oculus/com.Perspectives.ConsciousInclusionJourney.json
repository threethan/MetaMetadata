b=1-7&_nc_sid=6e7a0a&_nc_ohc=FiesO6PC3f4Q7kNvwG8Zd4c&_nc_oc=AdlnaBLX_olPiJP4o6EMyfuHyE5nY9_XCkXV8WDmVlZzduA-xq0tShC0c1sntB7YHco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwboIDgWNxLd-dsOGEkpeJSdzjlCHiO8gu8cB7tt5u5QA&oe=69BFCD73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "996198778041278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031321_996198784707944_1867821654081104755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QES6HObcULcQ7kNvwGqjdTl&_nc_oc=AdknGFP1oHEutYkbd9vCEVAF1vxDHDhbJ84f26m56jp6BkoUc5RaJB_PAOjXLWTgq3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfaL6yWLG2yndyvuLlU-4MPXC6tWlAgOnWk-Qy5oegwg&oe=69BFCF41"}, "display_name": "Mierzwa [MB]\u00b3 Systems", "keywords": ["brain", "learning", "leadership", "executive", "attune"], "long_description": "Mierzwa [MB]\u00b3 Systems is the immersive VR platform used in the Executive Attunement\u2122 program. It targets the four domains that power distorts: Mind, Brain, Belief, and Behavior.\n\nThrough interactive perspective-switching, leaders retrain their perceptual systems to decode emotional, behavioral, and social signals with system-level precision\u2014before misalignment takes hold.\n\nBuilt for technically trained leaders navigating high-stakes environments.", "short_description": "Immersive recalibration for executive signal loss.\nAs power increases, the brain\u2019s ability to register social and behavioral input decreases. This experience retrains the system to detect what\u2019s been lost\u2014before misalignment spreads.\n\nPart of the Executive Attunement\u2122 program by Mierzwa Behavior Systems."}]}, "developer_name": "Mierzwa Executive Systems", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRqEgyRn9-1LWLoM5roFqwj0o1J0p7BmoO6k9J0cJ7nP1vDSCzKGhMvrY8PggsjDn27QzkMpZfRfM5Z/pub", "developer_terms_of_service_url": null, "publisher_name": "Mierzwa Executive Systems", "support_website_url": null, "website_url": "http://vrperspectives.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23944456865213212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618064_1464355271232994_5211797055292235493_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTWhfvEYAwwQ7kNvwF5jIjE&_nc_oc=AdkIwdnOifhweUd4grZd6oOknz5JVi0tZCp7c8XYkBf3pAwl4vsgyR0_2oww9D-ynV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymS8WSE61jNjgIOtZUez97Hc668j8Lshg-UJudrNXmhw&oe=69BFE60A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mierzwa [MB]\u00b3 Systems", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1682635995, "lastRevision": {"nodes": [{"id": "6140018696083636", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6140018689416970", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "232939819281960"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon.png", "id"
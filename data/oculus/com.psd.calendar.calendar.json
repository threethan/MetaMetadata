wFK4wjq&_nc_oc=AdpkecrkZFtcU6Lm5I0VFSPpqUn4dX28zpVi9bTc7CF1fVL_WRm6O8xk7rcJa6ZR9Uk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I7Fw3qpMLRxiOoURqTyuE8gYgE1AQTFZ896GiRU_SKg&oe=6A0F247C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4-M1Ziw2yIQ7kNvwF3PXme&_nc_oc=AdqsmCShBc8pMdQwihgCtR25lpm8YevR1lEmG3S_3OG6AzKmO82HQpoLUgC1U628B1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XbzYGB32GcWYGCRFJS20y3sjwbbRpu9TvGlqs9R_mZA&oe=6A0F056C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZGF_2bl0LkQ7kNvwGdTg-j&_nc_oc=Adq69FqKZjtwiTF0l6w20e1EdD2qbI7MmeN1dXPs1D84QHGXLLA58klCYftS0xOtF5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nphscmBKroX8uGjKKC177DNP7x3KhWnxaCBRFpK8JrQ&oe=6A0F2170"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhmN9obs6w0Q7kNvwGTEFkh&_nc_oc=AdoEY12C8HYpv2dH3R5sChn3yWBbarZH0lu-i8YS3cqe9WTMVUUscdbOOHNbfX7KGwQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uxmjO9tkuM5Ri_SlB1Lr6u-C9EPFykrXTqxDodMBiWA&oe=6A0EF9CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw5QCpLNXYEQ7kNvwFY4Mjl&_nc_oc=AdoIXW3GgS0aj2IYmttwoI1CfVF5FG-Leby9RRQLQ_jRWGe1cKoz9D8Tl75-pSMi9Co&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F4kWGDVB-G0ifrU2LFByMHacFLh7pNy5g0ydw_wrtUA&oe=6A0F03B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
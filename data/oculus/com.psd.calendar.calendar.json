wGgU9g_&_nc_oc=AdpJxm5MeXhs2cOCnGHwOAp-E45nF_bsQZWkF8kSPYBMU3G2sMCB-UoBos7zC6zBzbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01PHMpPeLJs2XeSYx-n8J9V0ws4FmOQZF9ZBQqSvWzDg&oe=69F8BAFC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgeYy2ErDIoQ7kNvwENSmbE&_nc_oc=AdoF9gwfvltISs3uC_8FqYdRYlGaKb9DK5UKL05V1j74URPabvmpCYzi0OwwdG3be1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vZGFi9l-YYnEI7Mwu63wNdEYZ6sUdP2adCynjZY_yjg&oe=69F89BEC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk6ytuKYA_8Q7kNvwF8y9cs&_nc_oc=AdpqRFhc3O0B_xnip08Ldl6zbC9TDC5rx25vF8XnRpXO-vtrQjWlFzJokmN4qgP80s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ViySkJuAgpWfkuQE2--RHTftfeyBKSemA9upErFIQ7Q&oe=69F8B7F0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2qnuz7CuLYQ7kNvwFuDb9W&_nc_oc=AdqRu2k-dWCKVOCfIN-KmqLUM6zC7VDMPN08tiMhyG_VvqFLpSnz8HRChI1KSdCo7-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cxF9tcy6l25E1cHopNvKXYSU3RbFEG6XUpBvPL2SeHA&oe=69F8904D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAvycpzNjhAQ7kNvwFYBTN5&_nc_oc=AdqN2EHfTq7wzuQJKsrbGcPMsm6eBpOgdAAoa1xtrxWRjwuXzCt1XIiA3KqSsLFVSLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p67Sa7uyYk7s1JOXCt41_Ef2AjYSk5nLOIhkrLu7wnA&oe=69F89A38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
t64.5771-25/491820648_1257169872590376_3704678405841889113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp5iWpF6siEQ7kNvwFHAH-1&_nc_oc=AdoQfcYJ8IVWfE3akEFZs-m-pES1va1n9yzZnKY5ALKLS6y1pmm3xYQMB57UUrI9TfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWc5xQ2qnKhx9iBVAloKK1Vte2QBLSAWVI1-ENl06kqw&oe=6A79B5BC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyeswr8D36QQ7kNvwEBVNZe&_nc_oc=AdpXDk2_OZliPthcmSI939KCfuRw37rsyDZem4S1w_H34-Vtz6hx9-FQ-Bvup73v-Qc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1fNFAQoKyCl3G-6w-HAwgmljtTiZEZ1g3Gphctt3zxA&oe=6A79CEEC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxdS9Qnb8goQ7kNvwHaWRKZ&_nc_oc=Adqti_6Tr9SWglOB0riXA2OwkJ3eX01eJX99f9UdkWwRhp54TSI0Ut1wz35_uh_cdeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL7UyLRvf5YTyLLJZvnu0zT1duW7kea383egtkFE1C6A&oe=6A79B2B0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaFh79a7VNoQ7kNvwF5XnXC&_nc_oc=AdpzEQWsGKagI1oPmvtUgn82eZADb5FrHLuZOkxb5rkpBjf9dDgtH7JFVAh8XdF62KI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTK4oidY7TPCHBVTltY9voNSM_LQFaf_9kjlXHqbAsJw&oe=6A79C34D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA0qFaGftNIQ7kNvwGwgUhv&_nc_oc=AdqOK-SNAwITnaRrupty7HXDl1bajWSCyVCtharqTRjNV3fpmo_oNqVFiM1fCMEkmZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPsTHrnXhXuPMCYGhiwYTfDPKahngsZqQs3kwXJsdQlg&oe=6A79CD38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTA
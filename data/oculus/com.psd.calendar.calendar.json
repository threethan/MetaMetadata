wHJJned&_nc_oc=AdpNfJsUxjBjB12uo8n38Hsb1Ts26UwtLyJqtkCQTMieda60lpgBkUBgey7lU5wtndU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xuIuhlIVSDyiRsuPOiwTBZE02lbZ_0uZlyi3_1Qpi7w&oe=69EF807C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ykp64eF6UQ7kNvwFXO_gs&_nc_oc=Adrq7vanVHTGbjU5VsM4vipPMLVXlANZeofmCYa30qwXMt287nHgeyjvisr2D77WEBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3s919ihXZE19UF7UkSbXOQpukpaMyuso9WNWe1cHtI9Q&oe=69EF616C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9zoGWDtcI8Q7kNvwGcspez&_nc_oc=AdraDtcbxJ_xzhJiinUyHtazsKDfoGWLx9SKELEeUD3PkhVx8ypn3Ucaus_U6eeGW3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2njCOLHOXaKjKpYTvH0KovMF-VFVV5xlCukOWSlpiW3A&oe=69EF7D70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4MD4sI4RS4Q7kNvwG4kdAO&_nc_oc=Ado-q3jewhs-SpnbuTvfHXc2HT46SYILVDDS9uExLa6Lzyst2RywsIRD93ZIjUgddWA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s9eh2Hmi5pI-OgldwtmL6Cxoj7Ng9EVMISEvSIj-ydA&oe=69EF55CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dF0ZBx7xZkQ7kNvwHEEZ8V&_nc_oc=AdpIcZBEEYdmOysmL6jbi6d1PQv3nSfq7qBAMuiyCwzL_JUT6hU1G-yq_cWLB0UYfIY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0o3uL6DmPpJiQyxQjhSBAmzRJJ6QEJdNSpeb42e7bC2g&oe=69EF5FB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
t64.5771-25/491820648_1257169872590376_3704678405841889113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmrJHJXGV_EQ7kNvwGX7RBu&_nc_oc=AdqA-71GOshUys14sYwvLF9Pze7u-3aNFXTyDkQrG-cvn0FTeQowenEEDuGA-H1o3uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl-YW9FFBAYeu6HEZsMgORwF7d85RAMucRKbrwsdY4sQ&oe=6A7B073C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG1kYhswLhkQ7kNvwFElyzL&_nc_oc=Ado1UlW0bBGF3Dj1rdWAe4TJpv_ydYMRHYmJqpwU8gpPBkpApGXnQGeM2DD_QbdUNlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELjUJYdL1PGAsUVyC1zWHBbLHhqI7FsU8da7dl9yGL4g&oe=6A7B206C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFQRzx5oquYQ7kNvwE63c8H&_nc_oc=AdpQs_UGogYV62kV2CuvH4Pnfle3BhqveRQWa1Gsh_Ef6u7ii1M4oLehnscuakPVn4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTwxIh3-NRfzWhXcT--qND3B73kbdf2VTVMJI60YnWsg&oe=6A7B3C70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaFh79a7VNoQ7kNvwGt6-hT&_nc_oc=AdqffJxhjUh9N1uPLUoHaVr6MiWf7zcRgFtaLkS7sTwagF2SaQHeoEIC9b2UNNM3L24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4NsR-pYc4n7wELgVLCNNAopj3WGWBiLLgSEREvhcqZw&oe=6A7B14CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3gGcF4SwsUQ7kNvwHii_QG&_nc_oc=AdoxVvwaLAWB7nfSngq2NWc-13AH7vhk6Cl-CBVDdXHYCz5nNDLpJWUBvySJSCBGdeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEieznZJcV3CFuVqUdINOhgjpVRIrq_NOGCJq3t_72ytQ&oe=6A7B1EB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTA
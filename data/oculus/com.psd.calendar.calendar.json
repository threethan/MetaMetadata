wEN594p&_nc_oc=AdqmgfAMI2AfXqkXbaPl2O2uHZ1Ewywwjj30tWm5-J5svX_JPDUiCU5pnLNRz_GxGk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMCCHA_WQdZLtXWnNLB_D6BcP9bWXWafTw8WHFzRDP7Q&oe=6A510F7C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhpEVyPLQM0Q7kNvwH_KBbC&_nc_oc=AdoXAHVfusaVGRr_ff_LPQFuSfpE7d20ce2_6ABv_XqCLQ1DC-jnSzqJyS5CtYvVCwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0h7DJ1spLcvzbVrYIVS4lFwdXxwI7GBEdxiI7jfY4lQ&oe=6A50F06C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdSks0OziOkQ7kNvwEXMrR-&_nc_oc=AdpAsoFgeowI_zSLVZ9G-BJeOyxPFR0zjUynZ9i9Ib75wxTzorOfgWnmibAInpQisl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAkdob56WQcSoCjZEy46z6DOM1Gmsp1RaJJb465W5DIQ&oe=6A510C70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3UEahei5rcQ7kNvwGvOC3m&_nc_oc=AdpAQv1HQ2FvHqID1ceigdNzm8PbQ7J2VodSAAKrQwEBSriUC0_CjyyerrUe9zyeRQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe1duwZpxCroQ4hjuucv4IDDn94jfIRRpL_iFxLl_8Og&oe=6A50E4CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgONSgkLwRMQ7kNvwGDuEbO&_nc_oc=AdpppCiOtWc_QW6ZTk8jpDvXEWYb5RzQXMw-uGlrMH6UvVozeYmHsx9czqa6cXj4irA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXt1my128w71px2w0XRudprM1z3cKtatVK7KOzgmll3Q&oe=6A50EEB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
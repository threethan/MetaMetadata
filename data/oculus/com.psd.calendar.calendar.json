ent-ord5-2.oculuscdn.com&oh=00_Afv2RzLtog2yngeTtzrGVjUHb15hqkNgrvo4ekRNZKIaKw&oe=699AE83C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShGAy9XEKVoQ7kNvwH3xPUZ&_nc_oc=Adlf4428Fk-B3Kvn8sO7TiRiib_2_tmHxrkZnT3MhLliZm63aV5i2mYcn-r-Mj-qBjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsLrdxp0GqOBF1inTqIqwVg_Qpuvy65xR3EyJP9eMm2jQ&oe=699B016C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nVfGn_x2DkQ7kNvwGve2dT&_nc_oc=Adkn9GWrhIRL-b9JsLEozUqKi6rhdYni0yWAqRdFiboGr1gVk4RmpYN_nAl0DxsEjBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftQQ0yz5iuNcanuURowyht6ZvWwiUSmmrFS8XGdE1WMgw&oe=699AE530"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHDJ04FWNyQQ7kNvwHs3NUQ&_nc_oc=Adnw-O-PAdM4ZIIS0XAu1doFEVLbBbDYyjVemjtLYo8Lx9KfGH_QEKjsDprlTCNgfLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvOtGp1Hcpvji4mH7TuZxFqFL0AM0Wpb5YfkK1-sMwoHA&oe=699AF5CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuj2ZZaCjzQQ7kNvwE5vhWO&_nc_oc=AdlqN-HTo5prn_Q1cvOMlsP9kj9TV74pmoOP9_mxOfBzWYDrN9v3YpVDPPvDrZkOapU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunWogB05lKCYs0aoRuIA_i0G24-Oxvv2j9Y5Iy-BwVFw&oe=699AFFB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
wF-i43P&_nc_oc=Adq1om3osgZ1kdqZVQKsx53BHttYF7T5oSg1IDGZzPmty1FRRTcDUSKOzxYPPlbY5IQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X0T7No2EjO9SU-U6KT_ArolOXtNEzIsv4pBus2kOdAw&oe=6A1075FC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJsfKIMAhecQ7kNvwFeEEWs&_nc_oc=AdoEuKVQvtxD4w3Aemfroy34d-6mKPKs_aVjXv4G9iLwPsMB6mDGxmoYHtgOSCbh2ow&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NxVbRarD-95FkCdupBHa7ImxhxhIa27jNQrU1t0zm0g&oe=6A1056EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75XaQE6vQPMQ7kNvwEPbzIT&_nc_oc=AdoetEwOD5FtpiJ-h3ctObbfo7Ii9Da7Y8rBT-tfLBTOxxQbSkvKyo1YBQvILQrzu4M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NOO5r8SetRSm0TzlpKjLhnIE8OSGUoEf5LDnfxVsrTQ&oe=6A1072F0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhmN9obs6w0Q7kNvwEYxS4S&_nc_oc=AdoLKEY72vvbpsMZA5xodMwC1kyhYbvUezShlowxnN7fTR0BmyRxWnduaEJABrzGGv8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46HLfK1Tsf7-yeoy9hIBjpnFyqkMGCv_y5Nn9CBvpnjg&oe=6A104B4D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH3I6McoCUAQ7kNvwE8fFIT&_nc_oc=AdooqS1aUVExTX9MqhidqPUyfHNPNvOqqiCopUvgFd33uPizbODz3HMF6p63NaEqfE8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OGRr6vcGf6zw46LbswNvkUg7whGVm6DB35olefBtemQ&oe=6A105538"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
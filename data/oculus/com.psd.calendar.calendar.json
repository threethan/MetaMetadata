wEHnXMN&_nc_oc=Ado42rQ4gyV6JyXr0eyNpqCRKL_p7hA9qoempT3ybSaGjzQ1-XuIT3cOXTy05dzrbNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V5xQb9sezzHqK5EZ9A2D2pYBqTcKVu3IATEW4EhOIQg&oe=69E4BC3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXed4TzaJdkQ7kNvwHG6Rlv&_nc_oc=Adp97i1X9d0EPKhTqu2ImO_SsuNpXWu6mHEf8zlt8kZT_oBWqnTWJyEcuy5Vsz7kyGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TcH8N2aDg3VenazN5O5fTdT0wGq6nfEkgHggCuB-JDQ&oe=69E4D56C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl2UCHZdwAAQ7kNvwFIoaiL&_nc_oc=AdpAtTFqPfVZAlB02Ecr_DBuMicFiSWEgKH-_TYQV8z4rulM3L8sB914GmQVBLxaFkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IsWepO12RuB4rTfgyrsxIrCRIE28_BmaYFAjxHpmeGg&oe=69E4B930"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKgcRwEvTgYQ7kNvwF1pFG7&_nc_oc=AdpHVOWBhqtOOEE4aHRWnlYQun20LKbbXLLKldemYtPm5pMaRGDtfOoTh--fHzddkN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fefrlBm9dPKqqWhbW5Nhe1fsEhoin5ZjNBkHSjwSVfw&oe=69E4C9CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOkX5lAfpCIQ7kNvwE5FNdB&_nc_oc=Adpkz-RSAsPRZJkqh9ZBGFKezisOWxeLp5rzTB0XWB1Nlv9wGP6vOBNioMSCZYrkx8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hqX5a1D_TsSHclZ2qZ-fD8ZZ5zxlnXuKZoQZ6wT48yg&oe=69E4D3B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
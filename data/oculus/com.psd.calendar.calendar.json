wG09G7U&_nc_oc=Adrgo3Sp3qqJ65Ucz37aoE8o7x2GgmbpNY8zuvXQ-Q9rjaWfQ9q1eM8Wm4Fq6fcaWxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iVd94vihj2b5lJy87yichvRq4DRkJJ_i7PSAsgrKLPA&oe=6A21997C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXME1d4UWgEQ7kNvwGHacoV&_nc_oc=AdrAYC2aW61JLWSHGEtjanVtyk5IxqMS9kSuT__4kisPYSyzUv4NE--NvDhnnDAvm80&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UuumCB-e_bDtUwL6gHJWmVSY58re_036YIKoWTehPng&oe=6A217A6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GUmOCtdjZIQ7kNvwH3NrLX&_nc_oc=AdozEODrMQhodNoqifv-bAT36lO2cltwXbQZbTXb5T0BZ1u3OcjoLAaxBDokDnOKVVE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GsPW8fvxL8Xkvdt70WdRPjSgibK1A2CTd2-YPP-5yIw&oe=6A219670"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNHBkX6yxGMQ7kNvwEh12Sh&_nc_oc=Adq4cKvVa2ist7EwKxJTdCFiQAmby5d1gxJ91z7QbQpYRnM-qRbU1Qc-Qy8q2xQy8b4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WrrkEaa2G576BiUAfsRUM18_oXzBEFINJSm1wWJrT7A&oe=6A216ECD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsDyPYKJ9wwQ7kNvwHfo4hl&_nc_oc=AdpCPzqYMhVzHiZIZSWLUa0aJujcoaCu7si5relN6q0WfDRBMXTL3JiNaXQ8iE7e1Bg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-41L-bhGYG9UkWcCBFMDSTad-HxNtGvD_Ogyr9jpjV9A&oe=6A2178B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
wFEAtOA&_nc_oc=AdoNENMSc22jgLSoVw9WCbe7Kki2-gtAw8emP6LcYw9cXJuQpAI7NzMkFQ5r_TLZkJw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAF3tl9Yphs2wa6Ogpex7nTG2hiHrqLJzuQnbm68mKOA&oe=6A65EF3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJIQHzsI0J4Q7kNvwHBxumw&_nc_oc=AdreRTdQhSmwiWYmFT_P3Eapv3U02vGfio1Ep33tC1-RW4IBqOTNRU9oBDKEB3gxMQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm1n1cfSjsmAR81KTJyIVJ4hhwLkK7rht5R6Hn4pldYQ&oe=6A66086C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTZ-TK6-XwsQ7kNvwEB_Px_&_nc_oc=AdrlCtHDJwfWtYh4Bf-sxjE-jTPL2PzqWxyEesS_MXwJXKSgXfEMGqaU5Z1wLXlvGhc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArG25rtzqHo22Kygnalxb541HrZw84pDgXEbY9tQ95qw&oe=6A65EC30"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtmxLWGpS58Q7kNvwEAkof3&_nc_oc=AdrngPoCN_3WZGmqkv46OfId2jiBQJvo96wg2rcWd5rmu6kKTDxZgR_16bqawxOwAmY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0KCc7QTC0Tw1ofxEYqeGZLN6ZGB-7n26mehS3KTvVkA&oe=6A65FCCD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JxWLN_2vF4Q7kNvwHStD1D&_nc_oc=Adpy6lLCb5m635FRLZOz-tRGu8LRvY5h7jzbqB0wefp_t6w457Dwv3OA_D4m3SEJThM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE9AiuPxKAfzI67DGEQecW2SyYNcvBfFZOjkrwkYnd3A&oe=6A6606B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
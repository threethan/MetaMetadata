wGQHXRV&_nc_oc=AdpQXJ3w12YPodT3o7kNVsbAkctvrz3BFdK36j6ehojZpdjNYFfIBrwORbVynu-5MIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt48MT0IxBdRZYrDFGD4f8CC8SEDAMAe0zqsLArgfKaw&oe=6A60A93C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtEdYRNOt6YQ7kNvwFlwNW5&_nc_oc=AdpROMM70DJOjsmKsmFNNfKrQ6orIt33OHiO6BUNw6VqDiYah5xkxSRbgDpjN_JutYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA01e-afMteGITIsjGF7TQzkgyrE9bf4-66hNPVKx90Vg&oe=6A60C26C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlQAHTn2LeoQ7kNvwFhEhpJ&_nc_oc=AdqPBOc57oH9YM5qD-rZwqxGv9YBbBweWJ7bE3qXck9yJtozY0wl-wWIWOo2Mv4sutI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHsNQvsTdGWHr9XhQbk_54HlpU37Kt7gSO8e1w3S2vNg&oe=6A60A630"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da9K8nbK1koQ7kNvwHiRDrW&_nc_oc=Adoz7ns5mhUm9846NAblTAu8YvMXT4YHJqBPaY4Jq9nWbdC67exVFcBsP2H0umyu0W0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATq6D-5BaDqZNdZgCa2xe9A7kyZo5HSW4G0yNUDvUo_w&oe=6A60B6CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYEDC_CbTQcQ7kNvwGccoKe&_nc_oc=AdoLnf6FVzvjToSQyKK_QHugskpuXH3JJzaF-KK7xAv8DN8ivC2fjsjoJKnC39C7PFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYi20VaPOWtLPgRGleG5xbx_PeIqBh-diTlQGV1NVJkw&oe=6A60C0B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
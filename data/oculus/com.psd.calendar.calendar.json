wEHw_O7&_nc_oc=AdpR31eFJKOSJ8gmHidA_O95cXvOS9_0VkRQH4H0ubDK1rqOP37u0oGodJSYsodESGw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnRxm8NDdeDfphk_7MzvNsQLAQQfA8iiUdZx5Ej5IEdQ&oe=69C7BB3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayd5xgaB30UQ7kNvwGJP6mh&_nc_oc=AdoMvQpuel27VyDWpLtgMfhupMrLMekNqT6h55AzEmiQMnVe4gMR74c0SWHb_3kL17s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMEc-W3m_0k7B6crtcvrwPTAFmL4_bW-tqWb8incxLGw&oe=69C7D46C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0duZPemzAA0Q7kNvwEXQI09&_nc_oc=AdpZGVM3dS_2qmfu2j3kc8ijNNtVt6DJNLtx2yhg03jEKdfS8yLPhaEiT2qAjgEdpsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypjIBEJnUV5TGNa3UiAY6BazIMQF9MpycF4RA9Rvx-3A&oe=69C7B830"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gxPzAqfHRQQ7kNvwGNfU8L&_nc_oc=AdoftzymHWkDq38kr0zV81GnNDrfPCTmu9cggNZdGe0oac9t4vUAGdsAjhh7zaJcBgc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5pY1Wep53wHMCxCQVpr29iRq9sK5INykzE2cuj5fcPQ&oe=69C7C8CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acEO6jN0fTcQ7kNvwEufJ_G&_nc_oc=Ado4d4u9WRjXKj4TVqRbYqRMQwhip862XcKZoqYFOgDiIscy0fmR19TvTIoZoJl5Ng4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHchj4BqMHhSrn061FiXuFVVUwhNlHsGHuZgQY-4mOkQ&oe=69C7D2B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
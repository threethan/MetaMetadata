wGqP7O6&_nc_oc=AdoEUFEcbiRlI4zU25u1SnukBXHliNyOybxFec-9cOlF7JEZ71ZdSdgz8BCq6DWK8W0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mwH4T5Bb5uj2s0dp2Xog6QxRPnZPYt5EDWziqQxF8iQ&oe=6A316B7C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM09TNEZ9tAQ7kNvwF7ewCo&_nc_oc=Adp8kkfK3KOfjv84Up-7fcX7uzWCjdMx_qtHORXbgIaNz5cy2YVNMfMnhIbM2Sg_VR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x84c4w8VjBVoZSibO0UFnFk1HMQOJYBawCO-u39IMSQ&oe=6A314C6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XPnLsivIsoQ7kNvwFyN3wM&_nc_oc=Adq9BsIIl47JGotopNYxtwCxYMo-SGm3KqYwBXoKpRnaw5LyMB_y5VZuOAI0VUO8-Lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__51E5VXtJ_ywIOuwKFxcQ8j6a9sO71E4g4SKxaq-tnQ&oe=6A316870"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnd_Umc7o44Q7kNvwGv-on0&_nc_oc=AdoUMtA8ZIHmGOeB7tadDk8cvNmlaX-aZpmn9AyHV0Yizb2RO6osTLoygwxPGJh36zA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RKLG8c_dicPJ4byirLm7As-GcpYZZNsH9uDQVS_-xTg&oe=6A3140CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAalfx3UdvkQ7kNvwH7Fuwj&_nc_oc=AdqM_SzX8YeMVEkbxeGbulMuUySdBPKPpzIwm-r_8GXfZgwticFbfylI6lyAO-lvOrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0WXrrauDtP_eG0dpFrq11OurEFa0Fn3Zxjws0zeJSBw&oe=6A314AB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
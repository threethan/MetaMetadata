wGrkzaY&_nc_oc=AdoFV7KHxJ5EY1YInOVvScRPgD_oABh22mYwCsoYq2MWFHN12la96qi1rSxvSF67MYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZhwuFrmpnr6BVbT2Q6pHKhDAbacj3ry6JiVcPDKmetA&oe=69D2473C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=051xJ1rL1eoQ7kNvwFaJt5r&_nc_oc=AdqwKyKO2IBa5j0Nz9fyM4raZadiSgojf0nHwI5WdJvgousKDE3lW8PFnccNkMOgMWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DUo1sbOYXUUgokBpc_JBhIgUEQjVdrJZNR3ls9F8WuQ&oe=69D2606C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tujQg9f9GEQ7kNvwG8MWix&_nc_oc=Adrd9zDY09JhZs2Q0nooGbbgWHa3eQvuzynEsAlgkv4AXqSLvAUrk8FcedYxUSqb57o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WhCxncRKC8jSY-Y0tznvcxGMsoWhdxD7o3aMCd4ezTQ&oe=69D27C70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYBNCrUjHd4Q7kNvwHggnQO&_nc_oc=AdqsTAEgT8EGQUmhUy5w3f8p9AtOwrJTZgNBNXMb0O-QW43mleLO-NPAQEqJCwcmw8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vh8YLqnHm5HmvOJkk-vz2HUm6ei3BBqW3ELsQfuDkuA&oe=69D254CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC3khdqp3esQ7kNvwGtBXyo&_nc_oc=AdpbRYUr7ofVhoC7-8pN7O0gDoCUL_N7qjnQBmMWIVs51CLj6MVc_wTbaTsI7EV3Cog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pbiqiKWvyFlc-yeinCcVgrcO76fGI351iP_Ph3tT8dw&oe=69D25EB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
wF35_7D&_nc_oc=AdrIiDubyIsTOJ4vd3oOYOeiI-2WZTqiaAwbF5o3gR4ADEL-r-py7R0WGm2xbbB7Qhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p--dpa_XAwPZSbdNYdxr0ZAY0cfAzR-bIja4JkDGHMw&oe=69D398BC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=051xJ1rL1eoQ7kNvwGaO3wE&_nc_oc=Adr5f-EyqvzoPGAo_1rUuFAitpuUpBBKp3J2QD-ta9eg7qIe-7LTGKMzaX9QhPUY3UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EFNNl1RU3iyn3v1k9BCh27chFZCqfnGQS9Be-RIPEzg&oe=69D3B1EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tujQg9f9GEQ7kNvwEttduC&_nc_oc=Adr9bTEyVvTxCStiKdEU9FerC0MvYUAt1GppG7ilIVKH8DsquBPjf-zos2x0cKhKdbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qPzM5-Ch3oTj7OWEs3-vc-K0sHpvMzCOtvnr2JmWHkg&oe=69D395B0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf0pSyLKZ_IQ7kNvwFk3gU2&_nc_oc=Adq0wp3cc49kC973UNvFKYK5VpidJnSaT4pfZFVrCOw2mR8obpRIpI_xvDYh2R-hVV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zZSxJJtByfF9-dR0GiywLGapvK9JfJrveeep-Exsy7Q&oe=69D3A64D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC3khdqp3esQ7kNvwGGr8Os&_nc_oc=AdrPBru54IByn4GchmyvRECRGH8HEesKdIk2kqkzhEMx46rpWqu45lfyLG5NgtT05-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uTzfZm9F_4nz1bwbNnLZX0387BdBynZS63I5BRVCBgQ&oe=69D3B038"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
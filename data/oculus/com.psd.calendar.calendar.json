wF7Ns2x&_nc_oc=Adrs8e3UPtQ74CRcMmY4JnuvLAlbSKs5jicb8Nwl8xanGaTZCgMPQK8iLnIa1DAsxKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5WnoLe1EVb0usLPqUxx0ykD0gZ9p565NWrL0SwSLtiA&oe=6A340E7C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-MjVl4G8y4Q7kNvwF8Kqmf&_nc_oc=AdqwujA8LBevPvYoMCgtD4otHa1f9ZREoZJXNIgrhpkGIJYRuvSaVvtf-dengn36UGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UyFkzIA9iWrkIYUgOHrgY7FRcWhedvecy5DwGo17p8w&oe=6A33EF6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3lML8eqfKwQ7kNvwE4yH0-&_nc_oc=AdpA5zjMfbFDUtuQgT5l0YstuNiBArOyVkNgfN1qfov5JwyPZGxtzXZFNhUfN8wl-uY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mOARn8NzbKz2HrCo8IGp0qqclYf1Ugcmm3AdxYzCUlA&oe=6A340B70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JVIMi7eOzsQ7kNvwErFPwY&_nc_oc=Adr5M-7DCxqLTEQM9ebUd3_olNWzpM7BfE3MrXAJG3n2764hqWwQnd4OCpBflUW4AgA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mS2ifhAtEmqjGopilsK0Ymq34gc1cQ0AADumFMbMBKQ&oe=6A341C0D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FYHvwIKjDUQ7kNvwFMiQJ0&_nc_oc=AdrcIyRLgv5agN6rkeoGDVDwY1ZNCIKjbXub9lmVRAdWrWg8pegGwXge13r-_WN5v-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ECfHT1cmrW-Eci_yISN5BHXKgDCvaJzj_J69Fncrqaw&oe=6A33EDB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
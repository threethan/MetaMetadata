4WW4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af35xr40oTB0z3V2uDo85OTk3jx_oQacEaf_EQuDykSrww&oe=69F1EB3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fITvYQpzOggQ7kNvwFRHTzG&_nc_oc=Ado3-TUP1m95rbMAJYkwDbobWGGookJ63u9BERNd_0H_S2N7UCHQVJBeQrw7b30Rzik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fSvIkGWzRpndIK-GN0-nDGKIr9LH0djr9qqNejYzsaw&oe=69F2046C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO_eGF7gfK8Q7kNvwFmVzhD&_nc_oc=AdorMvQutL1cjQ_s6XI5oJNdgO5BO3IhOoXMH2wEVaw5IoASGJqjmbzD9BAcEjlFNBM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2pafzx4wZhkkamOha7VQYG1nw5JJq_VJ0-zXTJi-ftZg&oe=69F1E830"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4MD4sI4RS4Q7kNvwFK5r2U&_nc_oc=Adq_q8trIUjU4y_hyz6IbTnh3wcpO8v-nORWbQ1F1OJY3OknbQKOLbiAukjAdZI4LCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12KrYihlfNlX2sxSYOXeQYgy7vAaW1C1wDuGr5jVVGcA&oe=69F1F8CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlJFF6bz2TIQ7kNvwFklubE&_nc_oc=AdpUb4Sj-wvHlVkci7dIkUOHrPbJohut1KAqRFbFhQKH6XuE1oBPJCuc9EZ8IpqKBXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kurSASO8h5wM-ZwYe7bRJ7jc15Nz_sNjQfvV-tNcOJw&oe=69F202B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED
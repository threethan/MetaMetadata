wF0TDLP&_nc_oc=AdqqREpzBROD6SZIfyPA0ipXfUyzbSBDv1fXL1qpLSj0irYA_kd2eaG8S9Ga6r7cN9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIfdvygj20Opn5C8haJsBCPe5i5_JEL5uwDaHsdPYuAg&oe=6A537A3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF_-AAk7zQMQ7kNvwEsWnuK&_nc_oc=AdqiOwafQpHU42vi4hWFExk3VuDyFSJ-NPI5f96web0OJeJPQMaTO0OLBzTzo9Y6__M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDptfV50wBuhmcAA-ufgKh5wqBhjqrplLd4EI4okHlzug&oe=6A53936C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0hcEUNNDpgQ7kNvwEzdtYl&_nc_oc=Adpa4nOTkFPd7IpZfGj6JpV7Btv9Di1bi_i7QrBloFHZSOVuQ0xDu3osiCKhON9oyg8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgUgw35up744pfUi4FI_GvzxcqfrxXIOSdXypzke3CAw&oe=6A53AF70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYe4N1EYAiYQ7kNvwHUMmpn&_nc_oc=AdrlFFZtOT1PpiCNtCA_IeVQe44fvrLlG8TQZUmQ8hb-3bFYg2J-ydHyGiTf1lqq6xo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFeZ6XVUop0ilbW-B-04S9plCgrAdSiDD9q3OvmlFUpA&oe=6A5387CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG9z4yOL9IEQ7kNvwFk2QfC&_nc_oc=AdpiX9wGh4yfwgzPUKY3_e5JesgKHu77ODemyzdFkOUxMnEzkqVIQv-Of9c1Xj6doYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq6g4pAR1zPY5UVtwR3dHO4eLH9gGuKEVV8wHsfELXHQ&oe=6A5391B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
ent-atl3-2.oculuscdn.com&oh=00_AftUZBm2TGyBxhhnS0o6pdi04QxPSVaXIHHYgvWU0IpX6g&oe=69A5743C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVIfJizXaJUQ7kNvwHelJw-&_nc_oc=Adl-WM2MxfOlJg5uQOSo0nxwo_2E-OQutPmnRIpCZ82gPRZtVXJnqHrN12NGW29knj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvhonpL2npscjCtPfV1POal6uMcmaZdpTehz2XkdsDwIA&oe=69A58D6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iktq6QQTIUYQ7kNvwFvLO57&_nc_oc=Adnzm6dBWcC10gbsvvXqB8LRmw3Egv8diRxv6rgaEkvCPbNVRC2HjnKp-d76X4aSdkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsI6dlRaCioPz-e6tceSk1aPc0XT0x7JFztcnLsJ00abA&oe=69A57130"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um04aYX0xtgQ7kNvwHos0p6&_nc_oc=AdmemIksFjs43-XOauz8M4O3BP1MMsOBbPdpkT32W7zrpS8sjhMyZmWUAg2xGny8BuA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft1IE0XWXqDJXsEulrKv8tYFGbkq39jiGC8gikqyM0xNQ&oe=69A581CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR2WC1iX8aYQ7kNvwFhoC7V&_nc_oc=Adm8QCLYu6pOzH3bq1vSEmzzLMY8fv_haFXKFJEqMQ5u09IkduUi2bZfMNp2VBFfIf8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftCQpnbKh5FjuqfEFsgXaQcQAMMUTtQ9YYIRT-GAl2_xw&oe=69A58BB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
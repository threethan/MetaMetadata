wHd9698&_nc_oc=AdoQ9PWkI0LIdE3a--mKodNCh88IoQV0s2SH0kRaFsuNJ-tcGKl-1IrZqqY_iL1NqhI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97q8mFsVlMeHKXyMTjwThYKNTDnebqGReRHFUBLxExQQ&oe=6A2C257C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ouj-LNJNpjAQ7kNvwF1a87B&_nc_oc=Adrg9hkucQOqFQRFW-JI6X0xO3mQYQFNPZWoafMqmG9ZfV1GYpcoydMjBgY3drnlhzM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RFu4BKvkOcpdl28xODyKAVzcFdEsEJYMK9-xudjmmNg&oe=6A2C066C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdDb3GXUwPsQ7kNvwH6noyw&_nc_oc=AdrZSO7_dnrITGuQegxYAQCWyBN3VOVZCDSoYG2hVkVgOBwHHk49xL5b36GxFQvb8LI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B3qsYSa78Pj_zSb4gkttDCm2_VygBbvVuqcPy5hgd9A&oe=6A2C2270"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa8O_Axiop0Q7kNvwGEJWAE&_nc_oc=AdrVT6jwiclUVRvWLmx93BjOItGWsk57AGc1n6x8vJylms1VEQYq5sIrExpxPA90c0E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2UMBql6FVMWQcKIwW1woXmZJZY4g1vGt8-0wqV8pVdQ&oe=6A2C330D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVyzMs0WRjAQ7kNvwFMvYzX&_nc_oc=AdoU-KyjOaMewcLxr4ywXMvSKpBIkvj6Yvud_R_c3efgbrIhGiifz_YiKvY3o9X-xYo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rkPJBBSCddOz--F30GZSuMDZ1LhIDMdfQi2fZCkoxMg&oe=6A2C04B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
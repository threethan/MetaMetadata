wE6mSh-&_nc_oc=AdrC_IoXt0EjkOUqik1ePMMuEuJk1IhyTXZU6cSo6xEZ_4bDADxhVS97prcWWASW_nc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk19_y4hEHXjQqd3ReLHFC60czNtp9gSu_mgCfcYy2eg&oe=69C2753C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmcx47-81j8Q7kNvwGkm-vH&_nc_oc=AdrIHXdjfcHrULehvHKsz0YKejztidWs29Qig-U9Aiyfw9x3upuZIi13HnWaiqp8jwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySXrOkHMpc2fxiR8q5hSOfQ0_rsndeH4XdKG0_dCcOeA&oe=69C28E6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwb1UNY0isIQ7kNvwEDw9My&_nc_oc=AdrfaMhRdVrp7xF_MaevEloV-k_YEuRvSAJtzCeI-77sZjbXlL9NbwBKXlzIeZjHK0Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0q08n-BfMnbBn_owH4QwwveqsJCB9nNicvRpQ56xg9Q&oe=69C27230"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCJp3ERyr7sQ7kNvwHeGZe9&_nc_oc=AdpVo3_qS4c-J8a0bFOpocsRx499e0HagBGd0qgJnVD4DPjFJ212qVdbmT0Qqab61RE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjgLQs3U5ePKhSGvoMxZc1Ub52QivJGs6c8lr2cdDHEw&oe=69C282CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmMb_qpKM_wQ7kNvwETtCi4&_nc_oc=Adrl6ZO7AP6L1wkudweulsdhMhIIjtlABjEcllM943P3LHyiZQFLbKB4iYd1_AVgNAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3x0xpq011HViixzTRM58IQkASi6zHiPxk5RbQ-GpurQ&oe=69C28CB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
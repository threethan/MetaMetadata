wHMjT49&_nc_oc=Ado25TvlM8DOPkIG9lZvrAlCOZR1EdaF9wMnSCqduccjXxi4ci6e1Hw9-xM7-c9eK3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60JtUmUdZbHTkv8iVrWeS-4cfXEqzuu-90XNEZpLtLZQ&oe=69FCAF7C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUwuRyPKsU0Q7kNvwHCP2xj&_nc_oc=AdoNi6xM3gXSzS-99vOOR7H1o_YCEJ0xlPHedGhVfNIYjyEh6FgrcwKHToIAsb6l71A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LG5WZtgqG2Q438-W_BrHelTnqeQbYGTrDFi5hSC8wbg&oe=69FC906C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0pGRQU4yt8Q7kNvwEyiT5v&_nc_oc=AdrY3CzCdLzRyOOlN62LyrKwJz9-wd34aWFMQej-59ROR3KkZT7g3BEc28kOnMWzsE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68ZG-LAEAYgego2183RJBXpdqiR9WIwZ-1NtUeVW8aYw&oe=69FCAC70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2qJlAfSZa0Q7kNvwHpHCds&_nc_oc=AdoJ8IUGDYAQmYpIsjOpgA-BGAVEL6yBzWPi89Sh8f5cAXjRXXWmeGIbqrO3unLKQCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70O7jeGAPVtj7PnoRmFCxJDKtfNzysSYPw2_aDs9ao5A&oe=69FC84CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhZlgjmZFMYQ7kNvwGLxVBM&_nc_oc=Adp4E644WeVf03eCigr86mrLc0n2QoFlgoiqxp12dsmioUSqfDrXomuMY8BooZEEpcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TnaIRfTzuo8yL0eizVKjbVx2JNSTANnkW-ucE4WH1Ew&oe=69FC8EB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
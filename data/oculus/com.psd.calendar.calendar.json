wHe_8d8&_nc_oc=Adq-RijzwYSxyKAqsGIR5NJ71BSKXgCFGQjTVMGcNfdHMt82mmvffqXQMp79TwKKAXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rT0BCjiewd0rA-q1e285YJ-zAUGIgGQ9YibvUKbD21w&oe=69DCD33C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npUYvSdLx_QQ7kNvwGCq9Rs&_nc_oc=Adp1R6qbtZ38189ykQa97nAXN9_7cOlZbYn9lmiO31uqoOzJnM7iJDJeDuYH9mW3smg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OTZ2cVKi9q2AM9Th3zOrxbrVj6_8YcV_ND0BkDWnfIw&oe=69DCEC6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4u_cpwixwwQ7kNvwEz5sbq&_nc_oc=AdpLNqLg9CZbRxm3xXcD91GPbxVJvWSQ2MCcfBMBs_ddGJqb__MbtZ6FM5ZYMfGJ8uA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fnPOSRU_jjQpzMAlOaitaOHS77Fego1nkhajmnWZxlg&oe=69DCD030"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PPCtsm6SSIQ7kNvwHE6b64&_nc_oc=AdoZdKmmypEy46xHQNimkxExzv5k4iTtzdMiOGEeHqD9l2w6U0if_qxpIR_zykcHCPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27biXXePi7fW7TwLQ5TX88LnJmWFNfzgqYCK6-TbjelQ&oe=69DCE0CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr76OogExVEQ7kNvwGcAAVJ&_nc_oc=AdrCM5988W4Js6_o3z8S7S2pfXZeTYGcjiSGJn05sRy2Om8s1YdkFvuHjDYBK7J1ZSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KtIRm5coGqfCxp-6JbFvIFOyl74BsJag3jgHN7R4HNg&oe=69DCEAB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
t64.5771-25/491820648_1257169872590376_3704678405841889113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmrJHJXGV_EQ7kNvwFENxe1&_nc_oc=AdohBHTdndPMUY4HZJ-QQvtzfy7jLIsd8RgkoE40u5oCNlG0mraWkoGApFvd5b3k9Wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwo-HVDukauU0_RFDM1iFUIFtYQPOpZhIdQWSXRDgzbQ&oe=6A7C58BC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG1kYhswLhkQ7kNvwHYZfXU&_nc_oc=Adr65pto401xfKYFfYw6UMF5prYQNj-T7tlRrInxSRA6V_P1wBtkm6XSDpYpytfHI8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeY-ewu-E9dn0F5kBndbzG_5EcrKXORcJHu0NBONfdHg&oe=6A7C71EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFQRzx5oquYQ7kNvwFR0e4W&_nc_oc=AdokzUiBPU1kcXWdPelFhJTNsjDqvDZ7q4lVdgEYOntwYUdhR5VmaZNA_GRhztM-KVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlqE5KWP_KMThok8vRPv6WMh7yZHONWqtVm6SPLCvIhw&oe=6A7C55B0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaFh79a7VNoQ7kNvwFrKvLP&_nc_oc=AdodvoXpwM-6vILinaOBkARa32R7DzbN4_Q87B0-FMZf4sBF3xpuVsA_Z2fMJbjjc7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4z7EM9CSlaCdrrgeQF8T8D_vlGD1sMpm4zIfAj_tRJA&oe=6A7C664D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3gGcF4SwsUQ7kNvwGWyoA-&_nc_oc=AdosHqmfyIVFj9VUeJo6Y0u5BntCnqQpd6Eyqgy0AuLObCY5lmiuV1-gaL6EoyApxQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErlTivwZ82LHjlIzlrUY9rNx-E24Sq40ywtGtfBdwmPQ&oe=6A7C7038"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTA
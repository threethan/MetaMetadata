wG3hVnR&_nc_oc=Adp-P6SgmhdOWJpW7mWsbxJe_PsOsA3VArD9eawwFpV11cjR4jOLf_gofT9yrzLdtbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KrGObkEP_aYXcukpKbGr-QZYh5lt5Vd9tjYebMKG5Dg&oe=6A0346FC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECYvEfXiGW8Q7kNvwHH1RRc&_nc_oc=AdpmqLPZNNXA0oSmhC0CZ7DzqdX9ymfshuE8UAqZZLgUbMR007afX6b5glD9H9HoBwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pQRDw1xnHs4B9LkTssGxfrxh7cF6pwenkFURHfYhHQw&oe=6A0327EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-7qI_FWHo0Q7kNvwH3W3HQ&_nc_oc=AdpVerE-q5c3zoy8tKLHZ-uXzGEsO4-AUmjFA1dNe7VU96FA0xpFboejcjnZxp5gS_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6guUBTVBuzFHzGIhiTkYWTNh9xlk17Zpnj7bYAvhXRvg&oe=6A0343F0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1hG3IVoB-QQ7kNvwEu2iJj&_nc_oc=AdqZ79s3rA-kJfL6M6KV2S9M109Q6Gk4-Th_kM8Ay4BYhUY1FsnPzHrxfQLVnalZjus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7khTxs1MhbNwRWNojftFZtwvdI9NA-NUJOnVnYGu-YVg&oe=6A031C4D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH5iVj2Bmd4Q7kNvwE7cFbP&_nc_oc=AdpJean5HRE9CUb2ebPyAEskZrjFfmlG0MgnOjBbeJhYkHnayVU-LHgXwsBMuShIjzA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wpp1PuWbFaZhQrNsyv1m4ZuRvT2xM5SaWRx4SaqdSSg&oe=6A032638"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
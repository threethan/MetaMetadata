W7KGQAAbuvYfBrMv9mgoHkpf4GNsP-0siytHvZD8ageAZ9cvQA7G4jLTu1o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOn5fIbIQ77dK_umnk--7HJFlB06rHeXYS21zfiqtjrA&oe=69AABA3C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB5xUDetThsQ7kNvwE_6qZV&_nc_oc=AdmMn0GtfyeJtblNlOYwgAfF1y8H1CGYVDCB7zavV9f4EZWIhNLkC_1Jss2HIxMdW7c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1Bv9Y00eKPEnDEc17wtw4P7UG2r9cXE9IjGnFzuK3Yg&oe=69AAD36C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz2DqFxttnkQ7kNvwEmoUUU&_nc_oc=AdmiGHvsNZuFpjAYp5AMxHMNH8w4O7jWkQ2f9kgqpHcFGTgtkKJu7j_tx7JlUfd0sEI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfymTwug8lTgtG8rDIJovbDKWvbNpkLaI8YdhXoPXk4XYw&oe=69AAB730"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqBKPfTxC1YQ7kNvwEXkZ9O&_nc_oc=Adnts2s--eTZCVCbM3Fia8yuJVLWWxNk3zGdattuXi_rm6j9x2-XmoPre7SA0-dazRA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBLwJot8RfgWSCGakmq2jOlqbxT6Rf7mfaOreIL1Ag4w&oe=69AAC7CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFU09DL5ddoQ7kNvwFul1tx&_nc_oc=AdnKji_s9Fy5da40X02nwXph-iyJvK4Y2aZZCELghV7H8jEu2llLLRuVobGqOfUZRN0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfweahplIH23Gl34spg-5QJ8GwkfHyxCx5sTYqYTxkJqGA&oe=69AAD1B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": 
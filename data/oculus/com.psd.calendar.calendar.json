wFmBgFQ&_nc_oc=AdrCivZMLbYbjg-j_Rr94SE4AjyU7OZJw79KswS7IJgw2dsbsqZh47GXRSK4DdrHzdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yiJYoc8iHe4MaJaKKN-yqcSzrW7kurlVo3CQ5m7RUMA&oe=69D8DEBC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j5vGiNsfPsQ7kNvwHxklEn&_nc_oc=AdrJ_UMYddGx8k5MmdDRIUGhRpnO1bev_y1cj_4du9iEzKtOoPnnrdSyj00ouiDFIfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JKQg2_lD1CP8xTRgYmUM7d3Fbu2Zb_IbISYsQtp1nDQ&oe=69D8F7EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4u_cpwixwwQ7kNvwHdd9ft&_nc_oc=AdpvdQCmaUDSv6n-LjVZ8gP7UZq5FeakZ1GfDSPeirkBACRbrCHcawBiqO-J_wGyYNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gIEoQeau-TDZAxVXZzg0SuGxgF8CJ9eO1VZ2yQ7_LWg&oe=69D8DBB0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fqTs24thAAQ7kNvwEwYeuk&_nc_oc=Adq-1E_VR9YRhhfh6cBwUCSDWmyNruzcHZJ1V2gMW9O8YeMYgnXlPDZyoEoFR83kNP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e5PoUQjaekP4Kj8Pw5p097ei_Vq6yDBI3BoAamOvWOg&oe=69D8EC4D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gnWjGOpfGsQ7kNvwFRAqk1&_nc_oc=AdprJ6_tc6nwCVPsWrxCWFD6Zyclln9PlhSN2CWFAz1-01STfjelwwLN-pvU8UwJEtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z7gA12_z9AnazJWdVg9W5Myr-3uOFM1i1xuH1rMUbsg&oe=69D8F638"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
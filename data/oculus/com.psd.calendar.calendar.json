wH9Y3rD&_nc_oc=AdoacEwsGMYFiTD6F66JGJWUeeErhS1awIbkXDKgwy1lpCwOoxkYhxJhCbEjrhR3oC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vv53WsXCKcltv_K1TZHp1-xp58B3spSFCwNIDCF7_GQ&oe=69EB8BFC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIEFWLTNkCsQ7kNvwFijY4_&_nc_oc=AdrYSD_DwR24PoZWXTkPnKLOt3JoxJAKXnwFd8vJ_-G50KEysCnzhEl5f93UshY-JhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j41b6pjx1Q1or-PG2Pkvo1SAEH8PhZ-lM7VbCIHUvJQ&oe=69EB6CEC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUk7p8EUE4EQ7kNvwFMCohX&_nc_oc=AdonQ9Fk2suDON6g_X56JyaNH3xLrbIc8nAp_c22BCP-3CHOGE7lFw8K8wfBc1AIr10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yw9mykApUxILD8QEWJVLNxarWp00v6GanHp7B_H_jSA&oe=69EB88F0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDa-Vxs1t2kQ7kNvwGGH_Gz&_nc_oc=Adq8re5777f2bEFdBRt5Fo_o5l67aaY_mDPkBwpSS1FH0YCB4xzvLQsDtPazL0iyrXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CRfb9VONffmq0lVKaR3TPF6wKfyPRy3ms5JxIKnduXw&oe=69EB614D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkUlkMTrqc0Q7kNvwEOjxLW&_nc_oc=AdpH_LC-kAmqxKotJ2_KTti6kO8R64vVRJzBWh-zsJKEYXbVXqMy1JjOskFGSWW8kdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OvFHw904OLnK-Stwj4IOYy1yei7eDSgmVR0MUjfqjKQ&oe=69EB6B38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
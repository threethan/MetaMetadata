t64.5771-25/491820648_1257169872590376_3704678405841889113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtxKphA_RGcQ7kNvwGaGMdx&_nc_oc=AdpzAdN3JYLJLqxRoKag_GTA2O5-mKOcJ0EQbnvlcKcc6hUyZJf7LcP86ORSUG5vrw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8B4Wl-vI8UcCf7k49VOxKfSkYJKiBB5Kg8AOpZXAC5Q&oe=6A6F29BC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbU1U0U4XE8Q7kNvwHRC2eZ&_nc_oc=Adq9voCzFhgFXCjyFUTS0XsdC41CokrwxdPy5kkGWh0lvzQzxTBxLGDUxtSOnU0CNb4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDszbJftiSrin9hR0aykQoQQCCJdyxZql3ncZ2BVm3WTg&oe=6A6F42EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDDYBby3bLYQ7kNvwEeNgQ-&_nc_oc=AdqQDFwvagKZp2fjztV7jAHrdKsam80Tp8DvyO7XyCV066_yFBSbW0etCkmKJf8djUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbTWbeWUJZs4oVmWXvTOJ9jJaqb3meE8p4S6hCHEMd7Q&oe=6A6F5EF0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IZiYzQ_zjAQ7kNvwFT0N6x&_nc_oc=Adp_O-VbVqvF2KkGfAmOPU9BU24fxf-DsnDUaP0iL3oQdqb-L61V9M1g3whNQzZtTl8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq0KvbPszk087qfOhgslNoJ1s-coTDEtMGw17f-Ytwdw&oe=6A6F374D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3enQYfz9S0Q7kNvwE2A8vK&_nc_oc=AdpytGnYY6bMYJJ4lBNigvl3kmC7i4HScMaQPvDVFqAxkmugRZpBLarWgNfhxus9O2Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8RBhLUWz3yfZ7bUNV8GEm9hU5aVDFatph-_MveSTC3A&oe=6A6F4138"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTA
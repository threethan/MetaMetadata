h3BcmuwvF02jkJYxS0YEW0J52rysugV0u-JZ1w7YZivFiTW1kE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIVSpr98pcX0Z89YfJKf6Ts6Ys34v6quM5bs3VX9da_Q&oe=69B7E93C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKCgwL-hH98Q7kNvwGV2K72&_nc_oc=AdnPbgY44xO8rkQy324IlRWwuE2WChILFvPAvHX5rQ24gBJw-yDoI7y9y5eJeWt9rNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz136_F-AH6U2LuNX8W0dOhBJJ-cUPPhBoMg0NM4YOTkw&oe=69B8026C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUoKxesUPHkQ7kNvwFLXWS0&_nc_oc=AdnRf2lj2pUbV16BnRkWoDU4u4farlpHZ00232oiH9uyjtOOdMI4TIDkh0BHq-07R9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3iY3q13TsvZXtYlNVrgMkbJ8OWGmweCjIFV8JCvoRDw&oe=69B7E630"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcKGavJZJPsQ7kNvwF1QWtf&_nc_oc=Adlt_-9B93pQYurkVq8Rkte_TrEW3v8vaVuEZYgix4gTVuvb6OpARUIS88qusxj15dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxj3ElY4TpnSy-xXrANfrrTHyyai6DrU6YpP9f0E5WZug&oe=69B7F6CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8zlKJ_UR4IQ7kNvwH_cOMq&_nc_oc=AdlUpknjhvI4F12PnRJAgUbclndwODqnc9cyBoeSBvIViJGPgMlOHNwe2jbLfaAzOa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwAhuto9Cfmp9gSWNHxvvDe4A3fl8_WV52xO_lv7V5Hg&oe=69B800B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "39322247850
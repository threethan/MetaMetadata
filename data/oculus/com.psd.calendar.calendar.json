t64.5771-25/491820648_1257169872590376_3704678405841889113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nrg87GRgZsQ7kNvwEFd-2N&_nc_oc=Adpsyscx8R31p24nSuDipVG6YdDrezI2V_o65jzLwePd5eVy-FMISh1rNd0AjEp0zoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHttFRrLWMac8aVFYNtztG16oW7MUPX_ibORqZYqT-U0w&oe=6A73567C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qLqzz2T00gQ7kNvwGj-VHh&_nc_oc=AdrOK_ovUlydEq6CHR61UwMIE0GUmqcjeZh5VrJ3gTdBTEIpQ02brPOTsHLPjmGQ--4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEbiQkaPTKGHIcrW45-3Uu0kiHedhCN_AaiV4Q6mZiPg&oe=6A73376C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPYat1iMstgQ7kNvwF5rjsQ&_nc_oc=AdpWEFKIt0gL7829v2tbyn334g8PIPgrhAptAjJR_6vMQ82EEE_DYsWlSi5vJLqsdxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtEWCqIEB4H5d2Q_vc_C3xriorKLwh4Ah58_U1iKbedw&oe=6A735370"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC8OoQRIKTsQ7kNvwEJ1jo3&_nc_oc=AdohtQhHv06W9DejxBGXdrpbaMcqn3YsjDEIgXRbQvlYcH-1sVOfMxAwEgmwd9fZhyY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd3R_K4WlkbLZAzC8qdI-dB6saSat_vdesrMafYyotig&oe=6A732BCD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4WrH6yqhqoQ7kNvwH0MSdY&_nc_oc=AdqpsVLjGpbxgS2jaK85ChiFN8ok6jsTsgEv2JksJvAu-QmdLE2ZBf_CVi6HxBOsN_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpTzr3gBCHgsMV9AuWinKrbI-qrQRAq40Iu19eNUeUbA&oe=6A7335B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTA
tent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8EMYELN8NIhMP5c6EFktfJeg6w9WwDF29LYJ9Rdq0w&oe=6B05A9F0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8uA9i2dy3wQ7kNvwEkkn6Q&_nc_oc=AdovSdBOhGIzomv3uTdFgA3TZxuDZSpwmtc2_z9IilmhgQuFx7vFkFp_6UJKJhujcao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQtYFgqBU4MWDSwiXRX4oBk5RgPziCt32vNYg4NVPAA&oe=6B05BA8D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzfXFf0l7gsQ7kNvwH4vFcl&_nc_oc=AdoFG1nwczJGQ0HYz93nyqv9jqBgc03Xu0LQalXuqh2OJknDyVL-_B8aoX9ocW465PA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxOYcVwciVEly9pLHyyjo_tesEdd0la0NqSO4K9h4lqQ&oe=6B05C478"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9962065627241967"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "743708118061500"}, {"status": "PUBLISHED", "id": "1027772522759465"}, {"status": "PUBLISHED", "id": "3993560440973333"}]}, "baseline_offer": {"id": "743708118061500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752077040, "status": "PUBLISHED", "id": "74370811
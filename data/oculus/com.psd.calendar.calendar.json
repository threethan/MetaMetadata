wGR7sVm&_nc_oc=AdrJv09TEYcR8uDB71oxWj_DrAlfW9_i_Ezi-Au8RBR91-DqgYN8fVt78Cb5KBwc8Qc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykrIH0LDYjLCqp9skDNy00ofAdgWZ3ENVjhelnETcr1Q&oe=69CBAFBC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ80Sf_oFp4Q7kNvwHs41oz&_nc_oc=AdoTuGjyvRvf05uqE911dkn_q-CdBl63qi6Ryldqv00CvxGpZnqbohjnsBe6lVXLMDk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjbk91AFBF8WfjE2eI6gl-LaWnbVXvX42ZHaJyAk9wMQ&oe=69CBC8EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irEoCZuGu4QQ7kNvwEeMyZV&_nc_oc=AdoiAEeKvfYUFcjK13lAILaRv7nFp4LtuQf1sBajLVW6vLs4W5ldsQ-ihYNor_072JY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJ-AWLQQJWo-Pw8S9QGxoEDp-zlZjri6kV0H6SvwE47A&oe=69CBACB0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb3yUwW8wlcQ7kNvwE6C5uO&_nc_oc=Adq3qjBC-XT1-dXS1GxvsfT7sv84IIwOXqr-6t_MdaJVD_HVU5zoSuQaBhi86DPz_Lc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyACRKKfkbTDaBVnI-RpiiNq6uBBAI4j_ybAdB4-vfujw&oe=69CBBD4D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HJy_xzCydIQ7kNvwEOo7k6&_nc_oc=Adrwy_Vmm_ztBMz4GrJKJzXzZFrnBk5XEqUuA1WZu6yxIKj2n3e5ZLhGzVWaSfcqDIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbFeqQlbb2UE31A0gzYpSWF5Jdg52dnqFfXE6E__iTmg&oe=69CBC738"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
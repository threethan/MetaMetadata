wHM_q57&_nc_oc=AdrI17jgiXBks4hIwa3KGJLhyPa0pckFHzdwfu3yuwfB9Rl4mWXKcJRWeVo9vyNgpfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wjw2Ucs_edO6saWhEE8gzYZ8iX9i_GjIDeNOToC9bvA&oe=69D63BBC"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJ9pg5PJNAQ7kNvwGAu6bJ&_nc_oc=Adox7XC_b0FTqE4dWLdDR1tjsRV0MoyZCAq-me9oR5cKyZMsASrfFMoPAOjfQ9FjgwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OayMBlIqHylPeM45ShJ8TgAdeMwQNGEsdckGlDZZWCA&oe=69D654EC"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyl-FkQhC0YQ7kNvwHVD8-2&_nc_oc=Adq8fOV8Ilh1Qx920l5BgRHUM5qZvmLrnfA-Cw5Brmy0HFrid1_4iTphrTK-wU3yy-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WSV_b0PB2PkC0uOOd-BNvg3fAB-7zqVr4N3kwoTjYBQ&oe=69D638B0"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf0pSyLKZ_IQ7kNvwFJELZu&_nc_oc=AdqtCWExKl-ExYcHT2etF_ZNV9yDmP4-3ZGSqkkiSGYz5CE7-zdQQTUc-AsXCqCRg5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CzqX61AqlpGVeqlRjsoJlhXLId713hvESFRF7TP3vFw&oe=69D6494D"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D23msXVJSYYQ7kNvwE-v8Ob&_nc_oc=AdrC1YWcDqhklICC7T4xFIqmopX6_4oh1UrpLwY4Lp-hkOOaum-eZFLbMTc7wgkldAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2usGcgLbw6nmSS-onH9lGuH8pdZ2xFHp0eteaz_TGcRg&oe=69D65338"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
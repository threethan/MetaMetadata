wHBFbX2&_nc_oc=Adp_E5ABCZkfk6oL-318NSJWe6DjebFD8jU7ZU-DGf2rwfGEOHERX3rQHeMnY_3k2yg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMuA_GMBhtXnajPZroowudz6deREv1q7lsx1H0SA6stg&oe=6A4BC97C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vMZaThSZH4Q7kNvwFLVd1E&_nc_oc=AdqH2WZGhupzY50RvuzpVOQKuYhC14hKFsURlRrOD65M4NQ8YSlpmlLFFpH4FDHgqmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgkGVp6oviclzDRowO99NM0dlbfPGUdlKK1jZ3iJgNjQ&oe=6A4BAA6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVKk6LjVo9MQ7kNvwH4xMDb&_nc_oc=Adq7cudYrOfDSmuAtVpovMITMe3B0-wGG9-RTtgTTF9MyxI69IwPpb_lO9C5kRIPjK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrEia8NuCmCMt9jeRCQrdwDMYRULCTwzMXPKZlzHQ_aA&oe=6A4BC670"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4HT00aRNcoQ7kNvwEPXIT3&_nc_oc=AdpdlhUtvFMk4Y76oOrxGvKz70WnlzYLTTeYzNWkrU354s2UkaUYSjy7Ffn7rpbFlbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMBNMqggm7N0n91JIm-gv4t1nRD_4KIhpJcJ2i0tw6og&oe=6A4B9ECD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtWhNCpyyXIQ7kNvwGrF4dH&_nc_oc=AdrXw_-h9_g7v9TP9Ya_W2qSxB6B7Bb8XthHMDV0g1nyrFM4srd-AN962Uvzq_rrF5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsB62tF_du9gHb7RMeJhiM34bTrgcpch6Vq8UAF3c1Hw&oe=6A4BA8B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
wFCcugH&_nc_oc=Adr3YI_e2U8IBlsPDOFKkPlYq3xmqtOkvQf77OxS2ow_PJSQN42foepcgeNI4fSKcgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAKc8tD5y50fx4GN4_ikM9b2FmfACMdmRTd5VFZEq_gg&oe=6A6B6D7C"}, {"file_name": "2.png", "id": "1593559845364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_1593559848698137_5006246285640620137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWWCQGFvLggQ7kNvwGaIMx-&_nc_oc=AdpXDmNYNJtlRTJoZ-qxk8kUq7zDEANtpawLpkq0xrQ5PSOGZMgQJG9TSPWFsFYzFPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-tGn3t-N0U6hX8RjpUzDwyCpu-9kZAzPrNlc2tzcAhw&oe=6A6B4E6C"}, {"file_name": "3.png", "id": "2157379071374193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828842_2157379074707526_1945640424716555186_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS3P-R3wgEIQ7kNvwEKvEFh&_nc_oc=AdqyZyBVbk_G6gYrtIqQdh9JyK02OpAQ1Etcy6mUQXpTT9GUwaFXIFAt3_98j3pRQuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD05A0LfaGXaPhz6KpZZmEcLXa_tFNayHHK7rfVVz0LIA&oe=6A6B6A70"}, {"file_name": "4.png", "id": "1009406078036722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1009406081370055_390968474089104374_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA2G7Y8UfJ0Q7kNvwEy0-BO&_nc_oc=AdpJooMWzABu5P_VSM7BOJsBxrm55Qv_g0pdN2VxHVjMvs9Nwvux5nQkV9S1nWL9yHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa04ekYCt8Cp2rGQanYYUl9muZ--OvkV_W_si0_A40Tw&oe=6A6B42CD"}, {"file_name": "5.png", "id": "1482291982937646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_1482291986270979_3477486190926684877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s11-VAnu6FEQ7kNvwELhfhf&_nc_oc=Adr5mzgasZ-6UTgrpidT7a9lkV2EKFU-xKeUilOlTCWCHcV3SANmXf7HSp5yZS7RqYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbdnLN2pHJ7cNX0X4teqznKF9GDUyW0wRgMBHYFxWO6A&oe=6A6B4CB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calendar", "keywords": ["calendar", "daily", "date"], "long_description": "This calendar is designed to be easy to use from Meta Quest and has many features for easy use.\n\n## Main Calendar Features\n\n### 1. Calendar View\n- Tap any day to add an event\n- Long press any day to quickly add an event\n- Days with events show visual indicators\n- Monthly navigation with smooth transitions\n- \"Go to today\" quick navigation button\n- Interactive event details popup when clicking dates with events\n\n### 2. Add Events\n- Main floating action button (+) to add events\n- Comprehensive form with required field validation\n- Event title (mandatory field)\n- Auto-selected date based on calendar selection\n- Optional event description\n- Optional time picker with 12/24-hour format support\n- Automatic database saving\n\n### 3. View All Events\n- Secondary floating action button (list icon) to view all events\n- Chronologically ordered event list\n- Complete event information display with icons\n- Total events counter\n- Empty state message when no events exist\n- Rich formatting with time and date information\n\n### 4. Event Management\n- Delete events with confirmation dialog\n- Automatic view updates after changes\n- Date-specific event viewing (AlertDialog showing all events for selected date)\n- Confirmation messages for all actions\n- Real-time calendar indicator updates\n- Persistent storage across app sessions\n", "short_description": "Calendar with daily log"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZCXNCsBn5eclu-NVLLD8u10iDNwaaBsQ7XmLx0OAy2Y/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/2d-calendar/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
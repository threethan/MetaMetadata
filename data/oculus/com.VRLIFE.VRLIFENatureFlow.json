6ijz1btP9M0of5w2k9lu-dhvP-QYrRTzQ&oe=6A95CCAC"}, {"file_name": "Experience Bild-meta-quest-app.png", "id": "1361428622850408", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1361428626183741_8421371744220998247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9orh5Pm9CdgQ7kNvwFmDG7H&_nc_oc=Ados1sQKkKrKLLalM2S0ZW9_bvUZGf2_XhHABw03lepopWJ1CFfkiXAZK1Of2mraMeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEho2DhDk3Yr3SPGSHekv4bAphk1Aj3MlnlGVmcxXKjw&oe=6A95D68B"}, {"file_name": "mountain-experience-meta-quest-nature.png", "id": "1064404752815161", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_1064404756148494_5383805336858141788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH97Z5R4ECoQ7kNvwF4Wuvb&_nc_oc=AdpBRgawfwQWCWUYhKBZ2G8y24-eHBf9lalHTIqzOvDemn_MteNXrAlM6vjfWbtbCTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfMaxN_V8WmfAoxdIxWHm-dKcAAMrj5qDfoURL3HYyGA&oe=6A95BD6E"}, {"file_name": "cabledrive-nature-experience-immersive.png", "id": "1760990698379191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1760990701712524_363921830727423092_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7uw1cdHeUIQ7kNvwFoQBQm&_nc_oc=AdoHEH4NslTHYJeuZ6S3gtX89afPg3Q-8QTR9-mJ1_55A8wsJICfmvm7D0fhTTwa1S4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwI5G_33d_GNigSfXffUB8nCtcDq3hf1nI8DtN_t2BLw&oe=6A95C169"}, {"file_name": "forest-bath-with-birds-nature.png", "id": "1705681510698013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1705681514031346_121127452629710680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5s_8aTyDyUQ7kNvwERtZM8&_nc_oc=AdrZwiJxDm0m88B2aWOM4IQ5SylZaHhv7odrq9hT5aY7FeFMIUt4-TkDMBXstHxKi_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAOs2nYbNm74IqXxA2ZeHb9WxRb9NUiArbjGzhmCGbwQ&oe=6A95E066"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLIFE Nature Flow", "keywords": ["Meditation", "Nature", "Relax", "Immersive", "therapy"], "long_description": "Escape everyday life and immerse yourself in the calming power of real nature with VRLIFE Nature Flow.\n\nDiscover immersive 360\u00b0 experiences filmed in real locations and enhanced with authentic nature sounds and spatial audio. Find yourself surrounded by peaceful forests, flowing rivers, waterfalls, breathtaking landscapes and calming encounters with animals \u2013 as if you were really there.\n\n\ud83c\udf32 FOREST BATHING\nSlow down and reconnect with nature. Listen to birds, rustling leaves, flowing streams and the peaceful atmosphere of real forests.\n\n\ud83c\udfa7 NATURE SOUNDS & SPATIAL AUDIO\nExperience immersive soundscapes with water, wind, rain, birds and other authentic sounds of nature surrounding you.\n\n\ud83e\uddd8 RELAXATION & MEDITATION\nTake a mindful break, meditate in beautiful natural surroundings or simply escape the noise and distractions of everyday life.\n\n\ud83d\udc34 ANIMAL ENCOUNTERS\nExperience peaceful moments with animals up close and enjoy their natural surroundings from an immersive new perspective.\n\n\ud83d\udca7 REAL NATURE EXPERIENCES\nExplore forests, mountains, lakes, rivers, waterfalls, wildlife and unique natural environments from around the world.\n\nNo artificial worlds. No complicated gameplay. Just real places, real animals and real sounds.\n\nNew nature experiences are added regularly.\n\nReal Nature. Real Sound. Real Calm.", "short_description": "Escape into real nature with VRLIFE Nature Flow.\n\nListen to authentic nature sounds and spatial audio all around you. Discover experiences designed for relaxation, mindfulness, meditation and forest bathing, or simply take a moment to slow down and escape from everyday life.\n\nNo artificial worlds. Just real places, real nature and real sounds.\n\n\ud83c\udf3f Real Nature Experiences\n\ud83c\udfa7 Immersive Spatial Sound\n\ud83c\udf32 Forest Bathing\n\ud83e\uddd8 Relaxation & Meditation\n\ud83d\udc34 Calming Animal Encounters\n\ud83d\udca7 Natural Soundscapes"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrlife.ch/datenschutz-bestimmungen", "developer_terms_of_service_url": null, "publisher_name": "VRLIFE Global", "support_website_url": "https://www.vrlifeglobal.com/contact-vrlife-virtual-reality-consultation", "website_url": "http://www.vrlifeglobal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28978598721727984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_2438938913295887_8382892104494714957_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqSqf5DXkkYQ7kNvwFIvuM-&_nc_oc=AdooJbe2mWRigoZhC-K7UgUWg4CS1lZF_buClL7wSzVhfLTR-W-1KRlFYLhBwU-ptMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuplESgL_uMHojdp1ZHE-5gSGswbklUrsB5Uf4QlSxZA&oe=6A95CC10"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRLIFE Nature Flow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1751658000, "lastRevision": {"nodes": [{"id": "24
.net/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fuzzy Bear Studios LLC", "support_website_url": "https://remainalive.azureedge.net/", "website_url": "https://remainalive.azureedge.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "587787802943153"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1620451045969653"}, {"status": "PUBLISHED", "id": "26934910412765517"}, {"status": "PUBLISHED", "id": "3805505809582466"}, {"status": "PUBLISHED", "id": "1927661281427951"}, {"status": "PUBLISHED", "id": "1568501014132826"}, {"status": "PUBLISHED", "id": "1220982549777277"}, {"status": "PUBLISHED", "id": "1022503089382102"}, {"status": "PUBLISHED", "id": "3290235117948402"}, {"status": "PUBLISHED", "id": "553326809670646"}]}, "baseline_offer": {"id": "3290235117948402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1620451045969653"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5234818359898709", "version": "1.1"}, "id": "392352856152251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
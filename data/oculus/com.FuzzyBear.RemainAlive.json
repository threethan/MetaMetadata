o99Af90R2Mu4y7do36Lk-8UIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftIY6o1iD1lLSMRnIZeclfHxFo97YyAHYJbVvPq8VfOXg&oe=69A96EBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "569564538088911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_569564541422244_2229318701064110982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD2cBQVWH3MQ7kNvwH7yYTE&_nc_oc=AdmUZjNRNV8sKx9MBLHfbawKSMWdgrqtevoRrGq_eyK-5VrTERpDKMzWJ2roOduPXVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftZUvKjeeqNrNoF5fs2uLsSd1Fe8L5X7iHG-I_V4W4SLw&oe=69A99739"}, "display_name": "Remain Alive", "keywords": [], "long_description": "A zombie survival game set in a post apocalyptic world. Fight the undead and living in order to collect vital resources. Rescue survivors and watch your base become alive with each mission you complete. Choose weapons for your particular play-style, upgrade them for the ultimate experience. Will you remain alive?\n\n- 6 weapons with unique upgrades for different play styles\n- 5 well detailed maps featuring zombies and scavengers with unique objectives\n- Scavenge for resources to replenish health or upgrade your weapons\n- Different mission objectives make each map a unique experience\n- Future content will be made free of charge upon the game's success. This includes new weapons, upgrades and wave based survival mode with an even bigger focus on interactive gameplay elements", "short_description": "A zombie survival game set in a post apocalyptic world. Fight the undead and living in order to collect vital resources. Rescue survivors and watch your base become alive with each mission you complete. Choose weapons for your particular play-style, upgrade them for the ultimate experience. Will you remain alive?"}]}, "developer_name": "Fuzzy Bear Studios LLC", "developer_privacy_policy_url": "https://remainalive.azureedge.net/policy.html", "developer_terms_of_service_url": nul
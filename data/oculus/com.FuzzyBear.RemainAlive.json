nc_oc=Adp3vdC9_JGMhxqnn4vieTYPb4iGCWupN4_5Lqi48tk7Ksb1TE7QjfGTd0N2FbeSYYA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xc2B919WM8h8dt5AzTLtMJHlvAKxAI1geaUUiJHJoUg&oe=6A15C1FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "569564538088911", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974584_569564541422244_2229318701064110982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIZpZgC3RbsQ7kNvwGzAkUr&_nc_oc=Adr-V8qGJ62lLyVUoMJ2gNbcjDxLx8iYM76BOO2dponYY0DNwLJNtF6aznPRmlyn3QQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q5Sr_oQncYWbEtR2kWTACKvS4-g0zZgkL92ckwMV1rg&oe=6A15B239"}, "display_name": "Remain Alive", "keywords": [], "long_description": "A zombie survival game set in a post apocalyptic world. Fight the undead and living in order to collect vital resources. Rescue survivors and watch your base become alive with each mission you complete. Choose weapons for your particular play-style, upgrade them for the ultimate experience. Will you remain alive?\n\n- 6 weapons with unique upgrades for different play styles\n- 5 well detailed maps featuring zombies and scavengers with unique objectives\n- Scavenge for resources to replenish health or upgrade your weapons\n- Different mission objectives make each map a unique experience\n- Future content will be made free of charge upon the game's success. This includes new weapons, upgrades and wave based survival mode with an even bigger focus on interactive gameplay elements", "short_description": "A zombie survival game set in a post apocalyptic world. Fight the undead and living in order to collect vital resources. Rescue survivors and watch your base become alive with each mission you complete. Choose weapons for your particular play-style, upgrade them for the ultimate experience. Will you remain alive?"}]}, "developer_name": "Fuzzy Bear Studios LLC", "developer_privacy_policy_url": "https://remainalive.azureedge.net/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fuzzy Bear Studios LLC", "support_website_url": "https://remainalive.azureedge.net/", "website_url": "https://remainalive.azureedge.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "587787802943153"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5234818359898709", "version": "1.1"}, "id": "392352856152251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5036822016365012", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5234818359898709"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "392352856152251"}]}, "change_log": "Welcome to the first free update for the game! This update includes a new wave based survival mode! Here are some highlights:\n\n- New survival mode\n- Achievements\n- New crossbow weapon\n- New flare gun weapon\n\nBug fixes:\n-
=scontent-ord5-3.oculuscdn.com&oh=00_Afvm6IUI9tKCkvqHctL89hKSmlHeFLSQrop1WxevHO8LfQ&oe=699B12F9"}, {"file_name": "4.png", "id": "1434855357644470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295701_1434855360977803_6680966563204590808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsBGmWAqqEIQ7kNvwHduN6S&_nc_oc=AdljDdMaIZzF0OmAjIy9TzZdq5Scq8mwkzuYtixbPYUdEgE4-vxLLh1wuam0FRDyJ0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsyApBKPiFb5OcGogsmcmSwtdX2TBK1QfXT-oghjD3qjw&oe=699B0457"}, {"file_name": "5.png", "id": "772098898577869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499626699_772098901911202_2286375546642685127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYyfsNFoQ-AQ7kNvwHv3HQC&_nc_oc=AdlmCdOdmLBo7DS1CMXAaVaWQlTiQdvAz2D61lN4XOclXzXwcdmnLCAZhey6HHDvy9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuvaX5YOETcW4tzxEEULP8ffq7SHvDqCDBrWvbsV9ARuA&oe=699AF8BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1433874047960007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294003_1433874051293340_62546198785689973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cha5JZg-FjIQ7kNvwGtSTcU&_nc_oc=Adnk-SXgtrbRMp1Eb68z6-nXbBs3oxWmAorLE7LD8-pI7XnxI1Ktf6emt5igSJ2StnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQb8X_pvB4_noM7aOPwN1UEkcIDWUAMKPYx8OAvYIB4A&oe=699AE5F5"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "cultura", "juego", "tradicional"], "long_description": "Sapo VR lleva el tradicional juego latinoamericano de Sapo/Rana a la realidad virtual. Apunta y lanza monedas hacia la boca del sapo para obtener el mayor puntaje posible dentro del tablero, tal como en el juego original.\n\nEl juego recrea diferentes variaciones locales de Sapo/Rana de varios pa\u00edses (Colombia, Ecuador, Per\u00fa, Chile, Bolivia, Argentina y Espa\u00f1a), utilizando controles inmersivos de realidad virtual y f\u00edsicas realistas.\n\nEs un juego casual, mu
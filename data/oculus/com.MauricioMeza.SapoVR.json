WXLJ2kl1kzIY14YqO0Vv2Gg&oe=69A4255F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1437483187287857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618061_1437483190621190_7374579288631393352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-mIajcdw98Q7kNvwHHcix0&_nc_oc=AdnL9pYZNFgVs1kmG_9HfWpNPbH_Ri27F2fJIvPJ7qxS2dJk4aISwriXQCbGYzLiD9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsBjwaRtnuhC2K3pjkUTLvH7n__KBrX2IX2WJAVazRGYQ&oe=69A42F0A"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "latam", "culture", "traditional"], "long_description": "Sapo VR brings the traditional Latin American coin-toss game to virtual reality. Aim and throw coins into the frog\u2019s mouth or other scoring holes on the board, just like the original Sapo/Rana game.\n\nThis VR experience recreates the different local variations of the game from multiple countries (Colombia, Ecuador, Peru, Chile, Bolivia, Argentina, Spain) using immersive VR controls and realistic physics.\n\nThis is a casual skill-based game which is easy to pick up, but challenging to master. Perfect for short, fun sessions.", "short_description": "Traditional Latin-American coin-toss game of Sapo/Rana brought to virtual reality"}]}, "developer_name": "MachineMeza", "developer_privacy_policy_url": "https://mauriciomeza.github.io/SapoWeb/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MachineMeza", "support_website_url": "https://mauriciomeza.github.io/SapoWeb/index.html#contact", "website_url": "https://mauriciomeza.github.io/SapoWeb/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
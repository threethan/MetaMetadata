1", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499300908_1874010443217094_1060082434608903300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=305mI7QfZEsQ7kNvwHtN_PA&_nc_oc=Ado8ZQXxCXbJxIki_nSKwYi_o0WnD1_xplirtdb8h5LTt5A0rLPCNpfhpA1NSnco89w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfIQHRMXsKb_NbwltDqVac5GNpbp5hnH_6xE1qaWCgfg&oe=6AA9669F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1437483187287857", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618061_1437483190621190_7374579288631393352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlYtpjuyKagQ7kNvwGHauIG&_nc_oc=AdoPI42Ch6gjqtEMJMbCHgQ8M9rVSF7u9rhSxgC0aHyHSj5p4rKpCDmxC4JlOtQCDjs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0H7inz7r-962ReOdBOxTaubh4aXDZ3tt9nflqj0dgBw&oe=6AA9380A"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "latam", "culture", "traditional"], "long_description": "Sapo VR brings the traditional Latin American coin-toss game to virtual reality. Aim and throw coins into the frog\u2019s mouth or other scoring holes on the board, just like the original Sapo/Rana game.\n\nThis VR experience recreates the different local variations of the game from multiple countries (Colombia, Ecuador, Peru, Chile, Bolivia, Argentina, Spain) using immersive VR controls and realistic physics.\n\nThis is a casual skill-based game which is easy to pick up, but challenging to master. Perfect for short, fun sessions.", "short_description": "Traditional Latin-American coin-toss game of Sapo/Rana brought to virtual reality"}]}, "developer_name": "MachineMeza", "developer_privacy_policy_url": "https://mauriciomeza.github.io/SapoWeb/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MachineMeza", "support_website_url": "https://mauriciomeza.github.io/SapoWeb/index.html#contact", "website_url": "https://mauriciomeza.github.io/SapoWeb/", "category": null, "comfort_ratin
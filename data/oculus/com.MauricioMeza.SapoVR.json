=scontent-ord5-3.oculuscdn.com&oh=00_AfvqBDjCeKBnKz4NFzxdqpbgrT3mI28Wo6c4jmhOIsCk-Q&oe=699C6479"}, {"file_name": "4.png", "id": "1434855357644470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295701_1434855360977803_6680966563204590808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsBGmWAqqEIQ7kNvwFrKVzA&_nc_oc=AdmNHRWLff2rkenMqQPEXK5Q32WHz6biBsbcujLs4Mv-VFVn9JywXzXBFfrS4pjk67s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftsJhHJPyTJvVeogpOBFYhjLQ1bMWLrsgwfU0FjlU_tCg&oe=699C55D7"}, {"file_name": "5.png", "id": "772098898577869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499626699_772098901911202_2286375546642685127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYyfsNFoQ-AQ7kNvwFDvDq1&_nc_oc=AdmU-MJRiYKoHGbcOuEmr2DBZCFVxzWTveCUyLwsAeizkw7LtMiVM2hRLK2Xb-uK0XY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvLqnjTBNQ1Vx2EC7vePViFOpMn2g26hU6CK54ye48Baw&oe=699C4A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1433874047960007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294003_1433874051293340_62546198785689973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOQ2iuJWr28Q7kNvwHpCdLR&_nc_oc=AdkAhSQdmOHL5d4PEgUQM3n3XQTOcpfPppHaWsl48xaEn4y1e0ViGRUgPH4GZrBlTvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbPXf4pb2_6snZZelttux7hUMG9CFoonEb7tCCFbcw3w&oe=699C3775"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "cultura", "juego", "tradicional"], "long_description": "Sapo VR lleva el tradicional juego latinoamericano de Sapo/Rana a la realidad virtual. Apunta y lanza monedas hacia la boca del sapo para obtener el mayor puntaje posible dentro del tablero, tal como en el juego original.\n\nEl juego recrea diferentes variaciones locales de Sapo/Rana de varios pa\u00edses (Colombia, Ecuador, Per\u00fa, Chile, Bolivia, Argentina y Espa\u00f1a), utilizando controles inmersivos de realidad virtual y f\u00edsicas realistas.\n\nEs un juego casual, mu
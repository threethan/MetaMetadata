=scontent-iad3-1.oculuscdn.com&oh=00_Afuws5PQ0y7aHtZXOsZPPQXUqPd2aMpnd4OkvMeLTulGaA&oe=69A058F9"}, {"file_name": "4.png", "id": "1434855357644470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295701_1434855360977803_6680966563204590808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d56PkRhmHB8Q7kNvwEWWg-E&_nc_oc=Admk1VHPbq_Em0B2hBSkWBpWGzPWRwYnJi9dotCoRljCMGgYfVsdIBkgZdkJC5_W8w4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftakx_lppwCDxuDxXFzBf46ytsuL28JGH5EQr7arK4Ywg&oe=69A04A57"}, {"file_name": "5.png", "id": "772098898577869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626699_772098901911202_2286375546642685127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nF-tSa6GosQ7kNvwGH4mqH&_nc_oc=AdlTG4u8QOcO-ruAFOiIgoZPETtHZZGFKW85iddVdzk_VdJXkoW8zqNuxK9kUC0CFnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIqxsGMckrXkN-fgm4kB06W9wCYI9t7wMCIi28NuAs9Q&oe=69A03EBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1433874047960007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294003_1433874051293340_62546198785689973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dym4zcDMZSMQ7kNvwF5whXL&_nc_oc=AdlfsgMajEkHzaSfpBXrp3z3K_j5FyHh4ntKFUe4XDJFkZ-iPt-ICKEVp4juCwtbWtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvbg6Nji0lU6ltB4Sji1IQLaq6PPoOqsjp5us7il0F8Nw&oe=69A02BF5"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "cultura", "juego", "tradicional"], "long_description": "Sapo VR lleva el tradicional juego latinoamericano de Sapo/Rana a la realidad virtual. Apunta y lanza monedas hacia la boca del sapo para obtener el mayor puntaje posible dentro del tablero, tal como en el juego original.\n\nEl juego recrea diferentes variaciones locales de Sapo/Rana de varios pa\u00edses (Colombia, Ecuador, Per\u00fa, Chile, Bolivia, Argentina y Espa\u00f1a), utilizando controles inmersivos de realidad virtual y f\u00edsicas realistas.\n\nEs un juego casual, mu
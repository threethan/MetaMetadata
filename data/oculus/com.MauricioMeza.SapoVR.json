=scontent-hkg1-2.oculuscdn.com&oh=00_AftqKOO_mX9gmvj_uw0jTyjNffWZRokkjNXdueGTB8KKyQ&oe=69A1AA79"}, {"file_name": "4.png", "id": "1434855357644470", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499295701_1434855360977803_6680966563204590808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HaqWDwyo3oQ7kNvwH4Uwzj&_nc_oc=AdnwAhmdQXuOQZIHAVAR6sKxiqLIsmhSXbNE5VL1V7Rh7SkyjwD9abHBFxvdUIkUH0k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftJy_19YPOdP2YS7NpLNEPD3kALKvacdMJnm9wVIt4JGQ&oe=69A19BD7"}, {"file_name": "5.png", "id": "772098898577869", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499626699_772098901911202_2286375546642685127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcVCG9HvkSkQ7kNvwGRmP1F&_nc_oc=AdlPIBjnXoVZPvKwMm2aApyygG_olFDm0PRXUhATp7AX7eqCOyB1xcffmUXaao93YVk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsMkN9Km7pA_pi4VXfaIUVUdrjqnzqC7LbF85YMu_Y2Zw&oe=69A1903D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1433874047960007", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499294003_1433874051293340_62546198785689973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dym4zcDMZSMQ7kNvwEVMcXl&_nc_oc=AdnBsOJXMViBTldyFTJOhoYLFj8iQXc4ltvcU7m_2ZRvKuNFDK7ySjirB6z7MhSbwlo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs5p26YV_JxWFf25Ya126IRuFLzuU7mj7rskaTXVRMS-g&oe=69A17D75"}, "display_name": "SAPO VR", "keywords": ["sapo", "rana", "cultura", "juego", "tradicional"], "long_description": "Sapo VR lleva el tradicional juego latinoamericano de Sapo/Rana a la realidad virtual. Apunta y lanza monedas hacia la boca del sapo para obtener el mayor puntaje posible dentro del tablero, tal como en el juego original.\n\nEl juego recrea diferentes variaciones locales de Sapo/Rana de varios pa\u00edses (Colombia, Ecuador, Per\u00fa, Chile, Bolivia, Argentina y Espa\u00f1a), utilizando controles inmersivos de realidad virtual y f\u00edsicas realistas.\n\nEs un juego casual, mu
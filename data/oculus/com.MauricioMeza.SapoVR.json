) using immersive VR controls and realistic physics.\n\nThis is a casual skill-based game which is easy to pick up, but challenging to master. Perfect for short, fun sessions.", "short_description": "Traditional Latin-American coin-toss game of Sapo/Rana brought to virtual reality"}]}, "developer_name": "MachineMeza", "developer_privacy_policy_url": "https://mauriciomeza.github.io/SapoWeb/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MachineMeza", "support_website_url": "https://mauriciomeza.github.io/SapoWeb/index.html#contact", "website_url": "https://mauriciomeza.github.io/SapoWeb/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_CO", "es_CL", "es_AR", "es_PE", "es", "es_MX", "es_PR", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24084615877893749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830615_1189930549842088_2247653778896810662_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS8Jf03-EisQ7kNvwHuFm8R&_nc_oc=AdopK16S59hh2eur0aLU5x-g3zI1FujaYpSt7G1FH-Gz4odbiJytdnBCFDBTgC8I-FM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1JJ7K1Bl9eUXMbEryi1vqxbd_g-CHPuNqP1Ep-qUDzw&oe=6B084431"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SAPO VR", "platform": "ANDROID_6DOF", "context_category": {"con
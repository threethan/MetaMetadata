c=Ado0lI34IrKCKdhsskof_F71Ue8bvoAJztnby3eRv4tAc1_tyQzNqQVg6AAH_cMLE3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOk6yT3jQW0-LvEDmtoIOpNkj1uftgfeA0aUHs-N8E9Q&oe=6A5B7E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR9jcE8wQUIQ7kNvwGRRe7q&_nc_oc=AdoDJZ0GOo7fHifZX6ucPS9l3RwXIGQVG0QO6XisNs7EWFz1rK7AB66jemzWKL36y3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCpZDgPQU-TY-Deme_TZBCipJFF8oA4FSL7_C8wmLgIg&oe=6A5B8FD6"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jE_IFr9fjcQ7kNvwEfmkAZ&_nc_oc=AdqFeWfdjUXLH-_fjGbbUNhfXGTyA370KP52QrDZRpKT23NI7_FTdi45CN7weEFXxcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIH8TbXWkXUM0q-PZxS_ks7lx8ZPK_Q7kzHXfO_qHrwQ&oe=6A5B8827"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ-XgZMc2NEQ7kNvwF7knAX&_nc_oc=AdqNnitWaJrXrHEqwNJVpwacrFxGNfQfHK3Gtu3DhMjDEcjWmJ5NYNZnEWYh2DaYmcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGDDVffAxs_XtIIMLtEGB6mzvxbi3J9l6t1vbE6JMcRw&oe=6A5B79CA"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLarRvs9vEsQ7kNvwFZ2mXh&_nc_oc=AdrN5x_uH_mpKU6IifqfgpgFQ69nch5IhaJ29WYNkZip04Mn--lYx37WdBecVmJ88OM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR1FWOn9SBtmpnmn8nUjXC1B0hhun2xPxiD3L7s0Vx0g&oe=6A5B8C4D"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "611334856994072", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_611334860327405_8252438548182403553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWEhKJZv_sQQ7kNvwG_aaZ9&_nc_oc
c=AdpPuQjof21f0Ch5TB19XwLU-GzhdqcPQNDugJoiXC3Szozf13yl-W8rVcNNL9OTHMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQFxCsrUnk6rMoIv0J-ifDmEJ2G8K7OlEBWrVrB0h4IA&oe=6AA55265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYcgK_oCAdYQ7kNvwGdy192&_nc_oc=Ado7beJyGk1fslDy5xNN96R8emHBuxrArOAbCZXsXXtKODN0wX1I8Ie7aMfeyTHn_pM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPkazCKI_TuODoD0VRW3nUccX01F-_569qN48591b4_A&oe=6AA563D6"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ase57glCl1wQ7kNvwFGf5VQ&_nc_oc=Adp4qdpj1VO0DoEhi0OfkA-mPCmpEQgK_gW5EsC3BW-PBFj8Z8NiLosgcBP15rvIFV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3RkyYdg63b7YDGTwuJ9mZL1oDI8MA-y7iLnP9UfcLow&oe=6AA55C27"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md_KpnkzxpkQ7kNvwFWB2Fd&_nc_oc=Adqph6X1gcWabwRxi4oVdHLPrABlnVFKGK01YpmLPFKPNUNf_766RjpXnUG75-N6CKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGe1D05d7dUW8j8MrCqJMDJd-WgOdn2vxlL3zoGKcV-A&oe=6AA54DCA"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhxmegKrw88Q7kNvwHWO7Kf&_nc_oc=AdqtmYmZq_kHVMjpF9EWflglF7IOZnWd2R_7vZgpGoMeG4kaFRUYOttyStu7U81vHD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfoLg9BspCiIMuTF6_lz-cLc73WO2W9WScy6GZvD8BZA&oe=6AA5604D"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "611334856994072", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_611334860327405_8252438548182403553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuzKOmfKZycQ7kNvwHL091q&_nc_oc
_nc_ss=7f30f&oh=00_AQQrOh9uzuTlKkJsOtGK_BdtJHEUhGpDozpR1z0c_tPaSQ&oe=6B0C6AFA"}, {"file_name": "5.png", "id": "460885435594504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75643375_460885438927837_5034800992196904794_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGQHBY9FlIQ7kNvwFJl6xJ&_nc_oc=Adou9uv9TgAcwVVJer0cV0DXUzxwmyZR0nLRtLnKc2bsmDxAWqRCjIo8YoGrc_uMnO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS28023PGEFVMUHNGjHVEeH6e_zsSRLWUvXLXlsbG5uIQ&oe=6B0C5FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8hrPNsdcngQ7kNvwHSzWIz&_nc_oc=AdrdL6E04I9UWFystAFfJXcht2UNvt0zmoThpUMxlY5Q-YkJD1DhmqxFGp8PPMfFHZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTLMUIycCoJC5dTFr4DhBQPCdqvkTGEPVokT9ADEJu5Q&oe=6B0C7116"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RusGLS4mhZ0Q7kNvwHvIEY8&_nc_oc=AdqbUkz-JwphQLA62kv9d1fclqdQxKGJUGu3wPr4dNROI1KjHSQ_RG1XjV7dpTXO-68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVLna9BIDSzZWXHceQ8hrSOEdvxvuDwRAoqBRxVGMXmw&oe=6B0C6967"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ8X-qkloAEQ7kNvwExyPsP&_nc_oc=AdobHpOVJC0MaIEEEp3hvnAE4BSa2OkVdxrOkbdrHfFPo7r8SE3I5wCixtztyLzuky8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkwiq02r5UjqGwtJguKSufMG-HVx5voiTdFq6kprP4wg&oe=6B0C5B0A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItCreI6embcQ7kNvwFkoxK9&_nc_oc=AdrAVnUStOdDOexcXoGBv1EE4K1znf-VW5Oa6v9nogLkgY8KrzJ3Bt4
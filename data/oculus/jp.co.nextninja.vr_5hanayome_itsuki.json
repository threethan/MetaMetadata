_nc_ss=7f30f&oh=00_AQW_LwKrRdHSUE8i2cPffPftLBuLyzA_CvBkSoTGT7fNNg&oe=6B0F0DFA"}, {"file_name": "5.png", "id": "460885435594504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75643375_460885438927837_5034800992196904794_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZhBxa-LMZwQ7kNvwF1rXaZ&_nc_oc=Adoba7UwYFRXVuWkDrrVFjO2ENLdqXHtrjcA--TIpGeUMKkB0YyPpsNNpruJCncKRtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNIE6eT6u7P_1_Zy46cUHczmmAmLyCax5sYpoCGWJhag&oe=6B0F02A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy8tol2riOgQ7kNvwEyGSon&_nc_oc=AdpArUrZvNtw9NLY8N-ut0CyrYc7Z-Q2E5MnqC4CkWRTaq8TnnfWKrsh5kXPdGqFvyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTu-wPEsDH89w4AP-Un0MY3v5Eh90nlPvGXkr-cf0qVA&oe=6B0F1416"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7N4LT8PHY4Q7kNvwHz0gHQ&_nc_oc=Adpwb3ejYN4pUg2-lKRqjZmwOSZ2TrcHvBdbA8G7H8yaCHyFg5M4cwzcnuc7TRu43Vg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViHAnn6lODZ24GoUofn4UIvFyqL3ZywrmmdKnB_8R61A&oe=6B0F0C67"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kbWcG25jIYQ7kNvwHSUR4I&_nc_oc=AdpbkfCZslX-XwzdOvfTHiOqevuKX3l3wFtUB_ygY-Qlwj3i1X0sELZZPuf7DHNvW50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuSvz632BLNmGYYcDncdeTG-0hdZTH_TzQbaBFk3q8tA&oe=6B0EFE0A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06tcThbYerQQ7kNvwHai3Ax&_nc_oc=AdqwBRdFAwPxjkYHRpUeG4K3kO02fRrfLKqlddJRuihyWnZPyWtj62x
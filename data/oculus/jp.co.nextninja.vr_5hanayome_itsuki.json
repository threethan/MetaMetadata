_nc_ss=7f30f&oh=00_AQTOoBDzG4T7l68AHDdJNpynhZ_Km4O02PHf9jZiQP1AJg&oe=6B0B197A"}, {"file_name": "5.png", "id": "460885435594504", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75643375_460885438927837_5034800992196904794_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGQHBY9FlIQ7kNvwEsTp2T&_nc_oc=Adq4KAQYCe6a2rB083owzglmXu59bGRZgM8iNJhb6G4PK1q4sRPmlLZZpsoIpnMk45Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSufWdo-KLPNLStI5F5-Xa6LqyYI_NJCZKgMlwtMaS75Q&oe=6B0B0E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8hrPNsdcngQ7kNvwFYuelR&_nc_oc=AdoMGgrb8TB16qXwWkBzaGWRU3VfuSVMDlYPw1CSJxJ6bllPcx38xacmYU3dkzjJ5Ok&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOjCHwPGG3HvKuwX_cY2rfCDOU1R0mvMQNeQa1QE5imQ&oe=6B0B1F96"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RusGLS4mhZ0Q7kNvwFrLiEl&_nc_oc=Adr730i6dioGpVf5u6NIA4t5mUP0Jrv8dfNbighwN_Yaq-kqyNvwr7-HqOnK9zwidlY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQa5TkMxfw49BciQD8ab3156BJvxnZ_HeYAa0KLF_bXyg&oe=6B0B17E7"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ8X-qkloAEQ7kNvwH6w68S&_nc_oc=AdpVRoMrmPuBbiQc9Otx_Uk_OnTGhjgkbxYAVKUiK5nEbclxkXBlzAmEQ3n7eu05hPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVNWeSMXgAqoKb7upW8j7EzalPbUtmqnDYoDdh-FciHg&oe=6B0B41CA"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItCreI6embcQ7kNvwFmxZLV&_nc_oc=AdpWVlXY5KPX5H4441LLWYxDZjP4IIxH0pSVIEde3kcmCbsL-jKdlFe
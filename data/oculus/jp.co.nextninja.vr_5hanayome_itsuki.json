_nc_ss=7f20f&oh=00_AQSg62SffwinUpfcWPt8Skta0XHx4g4Om_ODad_1GXAolg&oe=6B083E3A"}, {"file_name": "5.png", "id": "460885435594504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75643375_460885438927837_5034800992196904794_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W89UFXO-8QQ7kNvwFLTMC2&_nc_oc=AdrgVxlJRxQ1KyhU9eK9kSdPj5cCSsgtfSK_-KKQO5PTRjiKhSSNPsxvkVgyONBEcoY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJhqNdTYobJv99OQITTHSLToYGW7_KQA-Qq2le8bDzPg&oe=6B086B25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9RX6k6VocIQ7kNvwGloIal&_nc_oc=AdoLeNic3HnuE1qKxtl0fHGux_5IIi0Tjx1dfDVPOhxkc72FIkezPX-tOI_JlnRsUIA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWZGJkoaSDOIsEN4lNcKX-eSVP_XQrzsxDTN7icBr9DA&oe=6B084456"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kk3uZE_xs0Q7kNvwFJp6Sl&_nc_oc=AdrorsZ0n_1U2IZgtNthXwS0cgJ2Zi-7YOQe5SsRnW9YVFMGbiufp4c8_SGDm0sKSCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5UDXlFvF0prKOTV6oXL8Ntq9RZ5HRvNg02YnDfMN4w&oe=6B083CA7"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bag9h7kEY5gQ7kNvwGpBanM&_nc_oc=AdotI5UGBjA8hs72v6kuDr77xgVCjBr-KeC_UrzfYXoezBsq5QDGlOpS5KVsKi1A9pQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7YkBtzMsyw4RHDOLrC-S3j75kqqNlVayp6ktUBYmLHw&oe=6B08668A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6ASAHq8iWEQ7kNvwFN0N8a&_nc_oc=AdoOnF16bI8gXwAjrtzIQOq6L0LNQfoSjtqhmS6Y1LSw1LvBRLHRvRa
c=AdrCOAz_31KmOk9O6FwrNw31vsYPCSZpdkLSQjq9SWkmpqqitrGI3L1-TpqFVGpPorc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dpm7V-K3RlnNFA4Nrochqiq6YuJ13HaXueMaC1DaJJA&oe=69D3B3E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOoJM-KuNEEQ7kNvwF-tiaG&_nc_oc=AdouqlrF64TYqmHgPjhDJ-5qKSTVeJg5-V8CTE2wzf_h93H74aVNe2qH1zRcHRUMMiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3djJbt3Iq8PZ6NVqPqwObYtom2qM2Be_9_I8kALfp96A&oe=69D3C556"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpWk5VktWRMQ7kNvwFSve5t&_nc_oc=Adpgxpk-ocpsazg87k9Hd8n84uN-tFN6kln08Is3TApr5azOT8CIFySxMEmnbm6F-Fg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bsQkhK_i6EfOg89bgrVVGFsFPKJu0NgS8nDj3pll6ZQ&oe=69D3BDA7"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDk4S4q1448Q7kNvwF-9Bm4&_nc_oc=AdqWEe7zlDWACam4NQ_qjYiOF1NGEiLObAQpeqW_uffzc-DSwzD0oAyR0MjgETLFVpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o89Mz4fcxwZevR6Frxuv1_w5NPTDWmrPBpe1lamtGeA&oe=69D3AF4A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAANeOM5yI0Q7kNvwEYJSD8&_nc_oc=AdpBV9Vsr3OAmqQbDMgtXDRTAGR3ZVt1PPmNTSeGPUSE0Gl9oAY_TET_eyqJWfVrfuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0520VtFqxjeohwyEPlCNG0Vh5zY5UqSIUxsvrFHud1dQ&oe=69D3C1CD"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "611334856994072", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_611334860327405_8252438548182403553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hf6mnvuIycQ7kNvwF65iyI&_nc_oc
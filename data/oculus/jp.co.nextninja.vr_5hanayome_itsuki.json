c=AdrT1TkMBKrDsnBXrWVSI1-0nQzqB_18az49C3XTqoZS9lb-MbuJekUZVh8zGUwfdpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyq1Jt7yYa1Yw3ADXRXpanJtFfgT0b3JvFQxhwA-HSwA&oe=6ACA74A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5redUklwv-gQ7kNvwG4fRan&_nc_oc=AdpzwuAcmyJR1Pg4baNVkhYnQTkLT1kwP5bAKhF5SnoxuurCNxqZY8VXIrJCyjD82kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP23LELa1avffQ0RdcLQtFp3k4TyiG6--MVSKNv2thvg&oe=6ACA4DD6"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvfyAYeD0EsQ7kNvwE2117k&_nc_oc=AdqmtuO1FRJ3BYFAMYCqRKzka8f940Spfwk4TRD9DiAJ66j3wIm0-vqBxCCLnCEFDC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvjrrB3390VMriO7x6VPzu7QJPLVJ8dEk5-e8cxzEf3g&oe=6ACA4627"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbSSCSfYtrsQ7kNvwHo6WUg&_nc_oc=AdqXJmGMf70bAxNogJ5eKUvlpHo8L-qK_hpFHgWZOlPzoDVD-vjtD88DYOEh6x0lfGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS4jOVniUcqapLzVWcsjQZvVt6jxChyYLIkuubtLTeRw&oe=6ACA700A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljZCVKQAWCgQ7kNvwGe3SlK&_nc_oc=Adr_vBu2hQM98QA012HFvPY_-gzlwpn__ItyM5iP9jqdavLzFDtCFitw0kgR8Jx6wqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPebi98nagmObVsGcuWSST9FwlTPzjL34eiAJk26G59Ag&oe=6ACA4A4D"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "611334856994072", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_611334860327405_8252438548182403553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_ZV4fJLOrYQ7kNvwHyOUIA&_nc_oc
c=Adr_3hzG1pQc37QGvNfbxyDZT-3-yZdZifxJLTUt_XVtCE4N24hVbISKu4vsGDeYz08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Pa8GLQhArT6ewWMgBm5K46iIhV0I4U01BkhsDuYLbA&oe=6A9C17E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-qw5qknOXAQ7kNvwEX4hfD&_nc_oc=Adph1SpPRulWdJNQVoLNpu5LuEE4ylGJhpyHrP7m73lrcMf2tlNnQV9_cx8xkrjl2HY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInYZ8Ib7mt4zSLYDH9GXWZ07HUNguU-079Fwh5Xep6WA&oe=6A9C2956"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlJpjud0jYkQ7kNvwETtJzt&_nc_oc=AdrvZvLzhrcytXuYBT194rcmNeK1T-vm4g1mL7bmVgc6HL6A-TQ0BfcApFKpQ_5Lcd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQqd2LfYjh7FG8Fkw4fdfqMW0GWgm17K00P5OlgtC80g&oe=6A9C21A7"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=884DUmP4RfUQ7kNvwHtFkEw&_nc_oc=AdrSCh33hYypE3Rrte6uqthRrAY3Lt6m1lc98drFiy_TkjbfHkzVSkEWHP7HOcdfOkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFymc9ZNDa7n8dJFjOVX9GgKBzLX-nch3kK7U_XYO7yA&oe=6A9C134A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQHF_AFAy8YQ7kNvwFuxSqj&_nc_oc=Adp6UFcocGdhPbvU_wTK-X7f1vgz27WrjUzEwQsyULdkOfk8iuX57w3CcE6lHKHkSF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn5tPR68hkt0ntLAWR9478bXm5iu49VPWGZ8DLUKOj-Q&oe=6A9C25CD"}, {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc.png", "id": "611334856994072", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_611334860327405_8252438548182403553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thv_wpRrXCEQ7kNvwF7tY3X&_nc_oc
_nc_ss=7f20f&oh=00_AQSetlkCMK2u7FyfNkEy_qGz0ALylF1YApLrbBrwi4LoPQ&oe=6B05D37A"}, {"file_name": "5.png", "id": "460885435594504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75643375_460885438927837_5034800992196904794_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W89UFXO-8QQ7kNvwHq7Yd7&_nc_oc=AdoVbzaCuWsauP_JR7lnarDWBjFB0BsR-LwSXArIGddPExPcjKsx-Aw0X0yNPW8Uzuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjhbyEBd_ZS7cqeEqD_GZzjM8bxf6vzgpVQWEXf8NN-g&oe=6B05C825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u5916\u7248_\u30c6\u30a3\u30b5\u3099\u30fc\u52d5\u753b\u30a8\u30f3\u30c8\u3099.png", "id": "455639726171290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_455639729504623_5908233865260845479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9RX6k6VocIQ7kNvwEjAU-u&_nc_oc=Adr4uqn1lDhGwsCAThezFZQeMd_1n3ZncIsJQGZzZ9z3HQfoMMPmTccu1jEJQkMr7Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSgk3cx3R2o2v_xOVq5KpFsd5rPAUtALxQ0rGUXt32gA&oe=6B05D996"}, "display_name": "5hanayome_vr_itsuki", "keywords": [], "long_description": "\u25a0About the Game\n\nOur time together...\n\nThe Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game.\nGet closer to Itsuki by experiencing Futaro's daily life.\n\n\u3010All Your Favorite Scenes From the Manga Recreated in VR\u3011\nEnjoy a selection of scenes from the manga in fully-voiced VR.\nListen out for all your favorite lines as you interact with Itsuki.\n\n\u3010Experience Daily Life With Itsuki\u3011\nGet closer than ever using VR.\nMake memories with Itsuki and watch as her expressions change right before your eyes!\n\n\u3010Multiple Dialogue Options & Endings\u3011\nSelect from a variety of dialogue options as you play through the game.\nKeep Itsuki in mind and choose carefully!\n\n\n\u25a0Featured Characters\nItsuki Nakano (Voiced by Inori Minase)\nFutaro Uesugi (Played by you!)\n\n\u00a9Negi Haruba / KODANSHA Ltd.\n\u00a9NextNinja.Inc\n\u00a9Blackc Inc.", "short_description": "The Quintessential Quintuplets OMOIDE VR ~ITSUKI~ is the first official VR adventure game based on the popular manga series. \n\nPlay as Futaro Uesugi and enjoy spending time with the youngest Quint, Itsuki, in this VR adventure game."}, {"images": {"nodes": [{"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30ba.png", "id": "3207087926213543", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001732_3207087929546876_7830877897326875727_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXPfNsxd_VIQ7kNvwHp_4aM&_nc_oc=AdqBLjupxU2rSjU72wIb0hMPuHcaXvqDmcTjZjF6FZbxYhntfWWyfWZsrvIieZ_IhDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLLq1Jmz1z2gmHdEMhzTa7P8tBzkMw0aNti6A22KGHUA&oe=6B05D1E7"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "734565387850223", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031618_734565391183556_211605470323462312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bag9h7kEY5gQ7kNvwGbeKP6&_nc_oc=Adr4RwJOftYUcKVh7dIEi8zvvxhVIYrs5Jpxm7F3_e_Z6B0F7Pcxrw8fCCrjroyxVPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe-kgcrvN0COjafhKZbETojVTTMBOF-Pd_zOyjKQZXCg&oe=6B05C38A"}, {"file_name": "\u7e26\u9577\u306e\u30ab\u30d0\u30fc.png", "id": "640096450406720", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031591_640096463740052_4767462473956722232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6ASAHq8iWEQ7kNvwH0PdNF&_nc_oc=AdpO39-_e1TPqP9UDiHzuAMr5CFz010wOL4__3mCbV1gkJaFj1VV0g1
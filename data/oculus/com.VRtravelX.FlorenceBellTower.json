4704_472661475336941_8746652073780188542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEJz01VM0kIQ7kNvwF1YtWP&_nc_oc=AdqTavUWirNbzynK_CCRcq-whPFmgf07bnh9W4k-2G1WvsaT1PKQFJ45eKKj7RwehPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7M5RYxu8Eh29ysjiW3yFbIz3qg8W2jFVI8jn2gFR8gw&oe=6A7867FA"}, {"file_name": "Screen3.png", "id": "536184842810431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334059_536184849477097_8775900482231609859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHvS4MH9BJ4Q7kNvwGLwEdA&_nc_oc=Adr-kdqt1XXErIdnbXEAG9JvgCyTIbRrMwVjDAqvbDH7l-0hAPucRyPp-ovzxpv8hH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQmt6EYTLB3KhLkSLhfsKwnDXprgvT88MvP720_32WA&oe=6A787391"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Florence Cathedral Bell Tower Climb", "keywords": ["travel", "tourist", "sightseeing", "florence", "italy"], "long_description": "Take a VR journey up Florence\u2019s renowned bell tower, where each step brings history to life. Start your ascent up the narrow, stone stairways, taking in glimpses of Florence through small windows that open up to red rooftops and the Tuscan hills. Each level offers its own moment to pause, catch your breath, and appreciate the iconic structure from within.\n\nAs you climb higher, feel the air and sunlight changing, creating a unique atmosphere that shifts with every step. At the summit, gaze out over Florence\u2019s red-tiled roofs, the grand dome of the Florence Cathedral, and the rolling countryside in the distance. Yet it\u2019s not just the view that makes this experience unforgettable\u2014it\u2019s the tower itself, an architectural marvel that feels alive as you make your way up and back down.\n\nThe VR experience captures every detail of the climb, blending realistic sounds of distant bells, footsteps, and Florence\u2019s ambient sounds, all adding to a feeling of true immersion. Whether for a relaxing escape or a unique way to see Florence, this journey invites you to explore the tower, one stone step at a time.\n\n#travel #tourist #sightseeing #florence #italy", "short_description": "Immerse yourself in the experience of climbing Florence\u2019s iconic bell tower. Ascend the ancient stone steps, pause on each level to take in glimpses of Florence through narrow windows, and feel the journey to the top as if you\u2019re there. This VR journey captures the charm and challenge of the climb, with panoramic views and the majestic structure itself as the star. Rediscover Florence from a whole new perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Florence-Cathedral-Bell-Tower-Climb", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8659721914145447"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1761249281570072"}, {"status": "PUBLISHED", "id": "3319784094870731"}, {"status": "PUBLISHED", "id": "962720499601402"}, {"status": "PUBLISHED", "id": "904234075495110"}, {"status": "PUBLISHED", "id": "898464179276643"}, {"status": "PUBLISHED", "id": "4306073659626892"}, {"status": "PUBLISHED", "id": "1350120646551867"}, {"status": "PUBLISHED", "id": "25141
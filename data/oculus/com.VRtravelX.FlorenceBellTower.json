d": "813355527492000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_813355530825333_2003026767392222219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaynwQRl_XYQ7kNvwHMs3Ki&_nc_oc=AdmgfpSiE0-GDGlpmLrE4BmMuQRqthWE9wD2MH6-4-7z0ebYFj9R6_WVqn-ftYTQe14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-hXwZ_gxEyUCKEBlm7JALBatgShrY8bSg0i6dJ7XsMQ&oe=699EE12E"}, {"file_name": "Screen2.png", "id": "1707239070067932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_1707239076734598_3916897846171963701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXSKnSP-waoQ7kNvwHsX7m5&_nc_oc=AdkXgl6EdRxVnt8PKgjN21KzdbV-4s7PQ_jGAwipZT6mPZtzmI0DyBjLlLeo-9CxSbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvyrbqXljkCMwfeFsHOM-1OgYzR43hWgz03e6QqozsjMQ&oe=699EF669"}, {"file_name": "Screen4.png", "id": "1070790754835618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031612_1070790758168951_5782537147077799343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qzFta9BpocQ7kNvwGgxQFU&_nc_oc=Adli0FMrd0Yq58SlCkMjKqyB4ComBGv1cAEYIZ9RtR1SG4vqu_9YKtyNew3Ptg8J_nU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu1P-PsZwR1te2r6S0M-9WyruZcoWioK5d8Wv1_SI7upw&oe=699ED4EA"}, {"file_name": "Screen6.png", "id": "472661468670275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974704_472661475336941_8746652073780188542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDiIsyPKJr0Q7kNvwGpeI2x&_nc_oc=AdkS4FmAf5AJkk7STDkC0NBC-_SUMLoI91o4eZKfU4nBzT5zf94f6BZ8zMv_NBTBdrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs2-p9rPRibPRHX_QF3Zh1HwF4UYd86nHG5RG_4_IOFsA&oe=699EE07A"}, {"file_name": "Screen3.png", "id": "536184842810431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334059_536184849477097_8775900482231609859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPkEcFZt9_IQ7kNvwHBASQD&_nc_oc=AdlNrIOEi-wX5dTZ5K_bbJkHAhM2MjcmTIQWnfsQLha63LQOoQgqLqQNBkqL9cQOUbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBkFzHx0ecc7tU8kJ4x6mdbTFZvCa52q9xQc3pKl0cPQ&oe=699EEC11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Florence Cathedral Bell Tower Climb", "keywords": ["travel", "tourist", "sightseeing", "florence", "italy"], "long_description": "Take a VR journey up Florence\u2019s renowned bell tower, where each step brings history to life. Start your ascent up the narrow, stone stairways, taking in glimpses of Florence through small windows that open up to red rooftops and the Tuscan hills. Each level offers its own moment to pause, catch your breath, and appreciate the iconic structure from within.\n\nAs you climb higher, feel the air and sunlight changing, creating a unique atmosphere that shifts with every step. At the summit, gaze out over Florence\u2019s red-tiled roofs, the grand dome of the Florence Cathedral, and the rolling countryside in the distance. Yet it\u2019s not just the view that makes this experience unforgettable\u2014it\u2019s the tower itself, an architectural marvel that feels alive as you make your way up and back down.\n\nThe VR experience captures every detail of the climb, blending realistic sounds of distant bells, footsteps, and Florence\u2019s ambient sounds, all adding to a feeling of true immersion. Whether for a relaxing escape or a unique way to see Florence, this journey invites you to explore the tower, one stone step at a time.\n\n#travel #tourist #sightseeing #florence #italy", "short_description": "Immerse yourself in the experience of climbing Florence\u2019s iconic bell tower. Ascend the ancient stone steps, pause on each level to take in glimpses of Florence through narrow windows, and feel the journey to the top as if you\u2019re there. This VR journey captures the charm and challenge of the climb, with panoramic views and the majestic structure itself as the star. Rediscover Florence from a whole new perspective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Florence-Cathedral-Bell-Tower-Climb", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8659721914145447"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "904234075495110"}, {"status": "PUBLISHED", "id": "898464179276643"}, {"status": "PUBLISHED", "id": "4306073659626892"}, {"status": "PUBLISHED", "id": "1350120646551867"}, {"status": "PUBLISHED", "id": "2514105498952812"}, {"status": "PUBLISHED", "id": "723608566777674"}, {"status": "PUBLISHED", "id": "1192601502378059"}, {"status": "PUBLISHED", "id": "1117275346515876"}, {"status": "PUBLISHED", "id": "1148559166605434"}, {"status": "PUBLISHED", "id": "1694461038068851"}]}, "baseline_offer": {"id": "1694461038068851"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "904234075495110"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9110930412357926", "version": "1.2"}, "id": "935734741741619", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typen
VXK1Wq4w2qkmdNESmRBw9oBTeY3EbTLQsL_VEsLNYbj4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af39dPBYvXH-WFH3PlMxBWdLh1SbfReGlYARASnaEydwoA&oe=69F0AB16"}, {"file_name": "Foto_OpenGate_1.png", "id": "3623577734604615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819396_3623577737937948_2503550691350532302_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9FTggGT2EMQ7kNvwEdqaQt&_nc_oc=AdprM3YbQh86-tHDY3L1DH6rgrY5ob8bl_WPi1l3OR8swCDy2MDWILluC9x6cj3pLL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1DaNuiBEU1-Y34bobDItRUrLzsHa0dYGeIg6sV6tfwvA&oe=69F0C3A0"}, {"file_name": "Foto_OpenGate_5.png", "id": "1287008662981372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300574_1287008666314705_1331466032948951952_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ovwcrnbx3UQ7kNvwHIYggB&_nc_oc=Adr9FkJINcUKJuOAAL0i7ydlLi3gw4bEDVDP5Wnwg2-nn7Jsw6VN3o-8Z7O67ez9Sk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2mKPe9wbt6Ild-uoaRAQwAzBPhxAvxr_BEJ5sd_AVnfA&oe=69F0C0BC"}, {"file_name": "Foto_OpenGate_3.png", "id": "1657037504959275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821955_1657037508292608_5609345335318592564_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roRKojU3I6MQ7kNvwGLniId&_nc_oc=AdpPo3BmQhsKTCLyfvUxCNLajnBWC0APktMTKb46FmHD9GDpAFuAiKyyq6VFtAUPymc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3GhkuzA81NxkPzxegUwhUD_DzsdZEuQ0kDWgameoihmQ&oe=69F0A8AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OpenGateCover.png", "id": "1083210333713788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1083210337047121_9212582815442388818_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRCRubs6KT4Q7kNvwEhp18H&_nc_oc=Adp6CfOxZyzRB9S43AHWX6Z23wQy89Pgrf92HdmAlPuOfw41FM1sk3vFXeQtZSexifU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2D-hyiTKAn7SNkWlOW0Up1HYkM-3vt8jAr6fOZc7SfJw&oe=69F0BD1B"}, "display_name": "OpenGate XR", "keywords": ["builder", "mixed", "opengate", "creator", "editor"], "long_description": "Metagate's OpenGate XR is a webapp that lets you create your own Mixed Reality environment from your smartphone or PC completely independently!\n \n- Register on the webapp (app.themetagate.it) via email or Google.\n- Subscribe to log in with the same credentials on the OpenGate app on the viewer.\n- Upload images, videos or 3D models that you can interact with in MR (move, scale and save position).\n- Create a 3D travelling companion with customisable artificial intelligence (GPT based) that you can talk to in MR.\n\nSupported formats:\n- Images: png, jpg;\n- Video: mp4;\n- 3D models: glb, fbx.", "short_description": "Create your own experience with the first Mixed Reality builder.\nUpload your assets: images, videos and 3D models. Even add your own AI Avatar. All without code!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-opengate-xr", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24305885949005963"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499332686_1369920530925848_6771610
YFBIMmOLjTXYcM7FgpGbZ_-n563dP2zknPi67C_jZNsTBL0y-GDfOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsnkzu5ICQrB8aDneSx9Gz5B5wudzSb9hbBfEDB4J-r2w&oe=69A6D716"}, {"file_name": "Foto_OpenGate_1.png", "id": "3623577734604615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819396_3623577737937948_2503550691350532302_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEnlE_dq-iIQ7kNvwF80xrD&_nc_oc=AdkcRb0xaFchXwtfqJ3VpfDHQ41_6G7iwLD_XADGSUCDHOSQxyo30JAppgGnAXAY6Ds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdXl4pZVHLuPl_GyTWp0-nQtRJvnGyHlr2EIpRXfM8kg&oe=69A6EFA0"}, {"file_name": "Foto_OpenGate_5.png", "id": "1287008662981372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300574_1287008666314705_1331466032948951952_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OpU5HvULU0Q7kNvwFDVW2g&_nc_oc=AdnKXuZW0TRc30HEURNvIM9t9YzAX_SwP1X4X-KY5MYNQgL5USGM4-AWlTP9D8qlGk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftB2Rn0GD7iT00UDXt5hLck8ei6864jq8VfqoO_RDtFKg&oe=69A6ECBC"}, {"file_name": "Foto_OpenGate_3.png", "id": "1657037504959275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821955_1657037508292608_5609345335318592564_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGuaCYBh0qIQ7kNvwGdQzb4&_nc_oc=Adm8jEviw4O6WvybytQumFGfeiWHd-Pgo8ybUpCOw89DLZ8upWZAfA3FyW98IS8JIik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaacEqFNyULijPokFSxCW5UPIlo2ooe73M6cGwEGeITw&oe=69A6D4AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OpenGateCover.png", "id": "1083210333713788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1083210337047121_9212582815442388818_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbpoVWHr0bIQ7kNvwFyKqOF&_nc_oc=AdltCjvk5Nh5Ne29q0-_8Mgeg89dyD5w84dZnxNj3YoGlQ_sfZocra0v83EpWTKiNEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoEdWlkonTu32ysMatrrFPO-8v2MizBGzLediFkQac8g&oe=69A6E91B"}, "display_name": "OpenGate XR", "keywords": ["builder", "mixed", "opengate", "creator", "editor"], "long_description": "Metagate's OpenGate XR is a webapp that lets you create your own Mixed Reality environment from your smartphone or PC completely independently!\n \n- Register on the webapp (app.themetagate.it) via email or Google.\n- Subscribe to log in with the same credentials on the OpenGate app on the viewer.\n- Upload images, videos or 3D models that you can interact with in MR (move, scale and save position).\n- Create a 3D travelling companion with customisable artificial intelligence (GPT based) that you can talk to in MR.\n\nSupported formats:\n- Images: png, jpg;\n- Video: mp4;\n- 3D models: glb, fbx.", "short_description": "Create your own experience with the first Mixed Reality builder.\nUpload your assets: images, videos and 3D models. Even add your own AI Avatar. All without code!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-opengate-xr", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24305885949005963"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499332686_136992053092584
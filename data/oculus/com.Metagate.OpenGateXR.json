64.5771-25/491823291_598683549364804_6239408941634692089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSczbdpIuYMQ7kNvwHCd2hw&_nc_oc=Adla-12tHMFT3raVMFFj45meF-LwEBoTwTEr0SnyKuhfZHN6OcbUqMB7C3LNsEKlWeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzln-JFHU8OkORlFUBVZWBjEVbJUbK4tM0CQnF4dWA9JQ&oe=69BFC986"}, {"file_name": "Screen4.png", "id": "686700530818077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_686700534151410_8957197507642442114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3fumEinfFIQ7kNvwGil0S7&_nc_oc=AdmgLZcaqJ6QNR1gpkB7qS-d7OoKNhJlAog_KIk7IpgRltGmnQ0bgudntneJHP4pLZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZUgGOWhA1wYCjTYSUikr1nkk3PqqjpSK3ooBanoPn-g&oe=69BFF8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OpenGateCover.png", "id": "1083210333713788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1083210337047121_9212582815442388818_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81lTkM0BVRQQ7kNvwFSzZFA&_nc_oc=Adkp-5c-QaunOkAUSl4r42pGp9pq1ascUW6Pu_Q46aAJo-So6alXAejRCcbArizXnJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyR8yEzPgo2WFURBXJSEuqBnjZCxQRVyEzhT_LGYsG-kQ&oe=69BFF59B"}, "display_name": "OpenGate XR", "keywords": ["builder", "mixed", "opengate", "creator", "editor"], "long_description": "Metagate's OpenGate XR is a webapp that lets you create your own Mixed Reality environment from your smartphone or PC completely independently!\n \n- Register on the webapp (app.themetagate.it) via email or Google.\n- Log in with the same credentials on the OpenGate app on the viewer.\n- Upload images, videos or 3D models that you can interact with in MR (move, scale and save position).\n- Create a 3D travelling companion with customisable artificial intelligence (GPT based) that you can talk to in MR.\n\nSupported formats:\n- Images: png, jpg;\n- Video: mp4;\n- 3D models: glb, fbx.", "short_description": "Create your own experience with the first Mixed Reality builder.\nUpload your assets: images, videos and 3D models. Even add your own AI Avatar. All without code!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-opengate-xr", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10097859503568512"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1873968400063213"}]}, "baseline_offer": {"id": "1873968400063213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751450400, "status": "PUBLISHED", "id": "1873968400063213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25378317288429485", "version": "8.9"}, "id": "1613969959219729", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9279651075389363", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25378317288429485"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channe
__oX04Q7kNvwHox5Re&_nc_oc=AdqP0Hfs-eCjFvacC9De-tPXT0tlUJ333kiEjM1wCD9dhna1MS24cwZcGliK9zK31Pk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyITuqhgyLV43Hqc1eXxORT9eKuLG3SRCRDuFol8EakbQ&oe=69C68CEA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df9DlxfN2qUQ7kNvwG_WL78&_nc_oc=Adpza6Y5NvQHNZYjDD7zzXanOaKUJslhrQ71hwDQfV-0hPOJBGCLFXTwBgRjGK3jjc0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZbULaiORPQyH3oCaI8Zn0yu5gG2FPNQhNua3i_yuHZQ&oe=69C68D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf3ce6Vn2TEQ7kNvwHgNMnV&_nc_oc=AdpCrLUMiNVUp_tNEV7boEUZruK7x6CuBcOlHEVMDpWBshENuP1zipXwfIwUsHIyZE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpwF1R9G-fcaXWzuw6LtzY2m0aHQDyPljBpP_EhY30uw&oe=69C68CFA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_priva
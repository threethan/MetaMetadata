CTKHqanzoCkX1txJoM_dRm36dOLosWKVvWs6y7_C2eNN6sk2G30cvu1aI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxwf5dQTyrQaGUuSCE3ZeaAeHLpxvuTbzUTsPsNUn5FAg&oe=69B417EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnMKYqmA76wQ7kNvwFaDwJq&_nc_oc=AdlyJSR72TmW5lsvhImMY5XsQ-Qm_0EW8ExcgxIsIhMNtKacapNy8MaGJSR7ss5gZco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq24HLtv5NwNeT8nuP5G3fYOqlatcpr673bVTgOs1JPA&oe=69B4186B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyIKwh3ooDQQ7kNvwFmOe15&_nc_oc=Adng8h2_0H9SuZgMM4Xpry5xu10rHwP7cMzpUSOqcMyVA-kWKZ2UZ8TfOCJI-Gpsmqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzR6DDR6uYhKX8GwIlQgSgG9LSPNkhrTtfX8Cx3Pcewgw&oe=69B417FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
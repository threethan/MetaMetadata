9txGBkL82baeFR3Khs4MYvz5BARZ-8uIL8spYnobtypmvq2S2dNMcBgm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL_F8k8hfMPJMtVWBzmtqXZ6g5wpF4IS0RXVlDOTQEUg&oe=69B5696A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnMKYqmA76wQ7kNvwG-Nrnr&_nc_oc=Admuwy4B0OXbHc7Ed30O_87pYViy8WG0i_nnI6E2knAWvAUtbH2p7VUMWNZg3V780wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmWjGBrA6OqLLm8wShhTqbGeTB3B8MDHv2ok6EQbYtAg&oe=69B569EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9zQbSi6a9QQ7kNvwGuYW4U&_nc_oc=AdmeL4nkkiFgqRz_FB-cXUDO5GxletSiQCzKybgtd6ZDcuWEIthXZTw-Ot29dgv8PIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFdl-RQNIvYSDMdovvB7fOwfY35XGXlwIefEXS-hm4Fg&oe=69B5697A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
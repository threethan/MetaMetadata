6VcBVmLe2BBIc-raCytLzbX2JBl3tMoUs53GjNlLpcPhFKCj9iLGGsUyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd2zVJFK78YhJnimITAA09CH4e5Oc9ZJek5sbywLhNgA&oe=69AC2EEA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdrXfLRlP9IQ7kNvwEjYq0B&_nc_oc=Adm5vO8eou1w3uSATx0bi7hfUjh45Pa1A675mRegU3s-Sh7bsDWpvlfvJ3rUGHt8agQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxY5ha79xvDkFKMvAVZ-EP94ybnGvX-EI47vLhzZUVyEg&oe=69AC2F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxboQ2LonoYQ7kNvwFZYCrk&_nc_oc=Adl2e9eEAugAVmZACWqLI9TD4HOZyeJx3MRvaBTbAjNGsV0U0gpq1FwkBezTC2jZT5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweNBRNZVqHWerzXEy1XgGSIVubRV1vSy_QjXVfYXDtDg&oe=69AC2EFA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
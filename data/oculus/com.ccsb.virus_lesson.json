t-iad3-1.oculuscdn.com&oh=00_AftGOkKkTh1-dunlCk7MOf2mcm-g21YCJ8JhwZAnbfnlrw&oe=699DAE6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7eQiX1e1GMQ7kNvwFZ6xGS&_nc_oc=AdlvOQVOSPtvU0_MGAA6gzldI7Jj0rT6xkSQwCqa5l8bkpFiM4vGwRpEsaTw--hdrus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEvG2j_zFMavdCIkcftQE1aof1De17QRmnNJCZIF2Yzw&oe=699DAEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6lBCzcj8yUQ7kNvwFQF922&_nc_oc=AdnyKb05Mxio3WYalgkeE3OPDsM4-vBHcC2idEvFK-6pntKNmJ0ftDmpWj5vsEjnFjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunnOqeNKz4eReoQinb1-J5fW6ZvW3f-RuNcNnb-WXrng&oe=699DAE7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
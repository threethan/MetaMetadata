7l_9bDSIkekXluIDRSJ2TIv9oeaPiSW38u0n6K3PU-WkTHUXb7UTgdy8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxUTyTEcE4h5uMHRXfkLq9DE4VQsGR4X-BXLLMN0Fy-A&oe=69BEA3EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJnBI3lBdQYQ7kNvwF6o0F5&_nc_oc=AdkK0CaUEdRb7MxLit53gXKY70P7LKQzh4ut14yRGyyL4v5uPAT8vlVexp4-CUaf42w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD7R0y_QI5iVmXvZ_ArIbDYDdv-Y8-sHLKRb04qJ2wGA&oe=69BEA46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7isXiXdhGfQQ7kNvwFpA5ZH&_nc_oc=Adnq503sDk2J85A67HKRv6pKIy-fGlyQ5UpC1dh5B6T8MGQykCSn__4_ATYXKQVrvzE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyfKtDLcqEDg_l6abVqtFWtoHQB3K9gu7NZqsgZvOp3Q&oe=69BEA3FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
0dW0j06qQF4CD8Aresp-HHLTQPjAwUbktcLbD8dVruDNByWppsAheEIbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpisvx1q8QQhtWojvtoLA4SolNpVFKabW4XKAqmhHZqw&oe=69BFF56A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJnBI3lBdQYQ7kNvwF6ethK&_nc_oc=AdlcHGvQnABFPGF_hGfnAiSw39wViJOhvOPyBBVo3p9h8Sw7cCPGfATH0jpC059CmIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2wTAY2Cv_mmFH86Xhyrhu8ic1uQhNW01xFinoDd6G-w&oe=69BFF5EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7isXiXdhGfQQ7kNvwE_B0HS&_nc_oc=AdmA1FE7qu7lHUnU-2MOHhoWc3w14auuOirVo37JRhwoamWxWiR1Tbs_OshjlR3SakY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVcEa8xkH7qVt3_1nvrVeHIEpY0YHtXpdmH7e_xG9xKw&oe=69BFF57A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
3edYDUQ7kNvwHot72r&_nc_oc=AdqWJh6Yh0-RP8RvxXGZLCg8HvSG2RI7Lcc6do-xFyAqDeqVqWnFvc80LV1qH0qATPs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3XB74I5XK2RbbwdnJD43BAoM2FGcv2ln3G1qbuSzebw&oe=69C53B6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df9DlxfN2qUQ7kNvwHEP9nN&_nc_oc=AdrV1aOWGp-GP-pewzGy9R0kLPw5b0mBBknju8rQ3IBij4DHxHnthXZ7hwJJkvelDBg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRG-TT-UFcwo63aJbd5KpdYklyj9zgvJln_-XqFJl0jA&oe=69C53BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf3ce6Vn2TEQ7kNvwH4MDTy&_nc_oc=AdqrBRrHYV5flHaxZflqHCLoV6SBQN-66AE0WyIaANIvaSroBHw3o6OHj0aun4XyRRU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuMAbE4Km5wXoBm3TsxZ_MPS-7n8J0qYYROmcKn2SWGg&oe=69C53B7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_priva
ontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974754_1430187927756080_83259455439309888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73YwjphnxA0Q7kNvwFog51r&_nc_oc=Adpw34Txog00QeW4cqWlq4u7t1uumd4fQ6H1mzL0B9DbPRGXhIG-RQC-ZOoLXHxtgxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLAWavXXNshbinVoUAYtHR37emT4M2ygsuJtv1lMXzBg&oe=6B099CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QNJOIidfO8Q7kNvwGj_i6p&_nc_oc=Adp497vmmuyg3Bt_0r7zz8W2Wc_17xS3DqaDAiaCWLlYSGvj8zKA8_UOB1GI3rIMIIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxb-1PGDLy30egoPySOdBuBYzdNx0xeHIgctUWne2ENQ&oe=6B09C4BA"}, "display_name": "CellPaintVR", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name CellPaintVR that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_website_url": null, "website_url": "https://ccsb.scripps.edu/cellpaint/", "category": null, "comf
KCA4d7f9qn_QNzfg9EWNDBP2Mx0aQciXmUwoSMYCh3AJLRopIte70TAkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzvxa0P_zcB1xUkldgj6gV1G7IbzPx7crPg36qs4thciA&oe=69AED1EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cYeGoKOhWUQ7kNvwFng7Cu&_nc_oc=AdkrUm9VrP2GlMW5rgFQ0qHuTLOYc-33WBv8GNTJDg1Cc9lhkHpfca98NJFzJgRaLGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6BIxSb_1a64zBFquoffh1QtKKnkyJ63hYRQ3dGUtwFg&oe=69AED26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4u4knMM1fkQ7kNvwFF-mjM&_nc_oc=Adl1pOwTLpfDnkwF4fc6GPh5j0W72Y5IMqzfeHGlGH4pQy5qHAA2y0brNPP6JYXeQeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2Vi71URyxzvYx0UAMQlB-ZS1uabJA5doWzDAzE8l_fw&oe=69AED1FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
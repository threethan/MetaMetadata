3edYDUQ7kNvwFQRYFW&_nc_oc=AdrO8kIGjzr_O-sjVtDe5RVXyAuFRcX8D2Zbi-Yk9nyjLaOJGo6run6MWnXNvvpYiGU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIofG0ROcqvC5YGvdqciwB6Th1NA9whRzUn7EFAgpG8A&oe=69C3E9EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzpYIvZBn8sQ7kNvwHJRlEp&_nc_oc=AdqBQqxAumWnV2zKqY408WgiOQADjygA6Dw_KYNO0leWvgv5Cx70JtVfswrhWFH_l-o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4X7nqPMcKi6UBumDbJCbWu2LqdVF9MDpwjcNDgbzxMw&oe=69C3EA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8QryITDB64Q7kNvwFtca5o&_nc_oc=Adp-HRmSRMjiPmwfI_ue4naprJz4RvZZGRkevZ_WaAJxtHcbejfsrnXubN90f15REZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw76Ff5d03wk4ipkCLv9vfksjoTjeTFE0hEeOVTS5IQ0Q&oe=69C3E9FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_priva
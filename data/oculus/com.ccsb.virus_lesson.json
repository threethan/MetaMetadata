t-iad3-1.oculuscdn.com&oh=00_AfungtMaqaALryV4ysSkN5XSwyzc1fW40vjTKeQuyJ_YWQ&oe=69A0516A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqnJozU0l5cQ7kNvwEob-ic&_nc_oc=Adn4vdw2KsJp12nSfk0k1QNGd5gjvLpG0pu146QlrHQ-ylksbye62hhqqq02FjBNbNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjAQkTFqWnl1dKCFvPFzJRhU1G5X5XLYtrswrXvvLX_A&oe=69A051EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6lBCzcj8yUQ7kNvwH6canm&_nc_oc=AdlPoHi4h9FM6dBvB3t5kg3t7NqL0mif7jEXSul7U9QT-WajN9YmXQNCcpyChpbhZ_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQ6TneF4FaCzrXRkRpdmUh1S-a2G8M0lY_xE9Wtejqfw&oe=69A0517A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
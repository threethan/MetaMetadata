p9b8_F7LW-V3Bufes98j4voq28Dn9eEaw&oe=6A843D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp35VStt4kAQ7kNvwHDFZ2d&_nc_oc=Adpi7AsEtFxBOn7h33LappcQmYr_wA9-kZ389WjeuN5QKp6PUD6SGlu_BHATGXqLmn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjng8lbhbLZKG1JSm9ekC1RrPJknAT5sM8EpNwArdneg&oe=6A8464FA"}, "display_name": "CellPaintVR", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name CellPaintVR that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_website_url": null, "website_url": "https://ccsb.scripps.edu/cellpaint/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
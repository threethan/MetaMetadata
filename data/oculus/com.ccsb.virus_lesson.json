TsGNEsnKyl4IJufReH9I3LtL8cco6aelw_24AfQ3YvS7OA33kXaPgejRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCoP9ZM_HgpBcExHk0KbgLTpxHaGVuEKQqeFUW_xYq5w&oe=69B2C66A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnMKYqmA76wQ7kNvwGh76OM&_nc_oc=AdmX4NuHU_RQc0GU9VEs3PPkNtipsCB36WfdM81GaEJu9gi33yb53eELQ6q4EK0JGRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfybJXZqEmMs4pqON0yC4cJzw5j28O0WtXn6NnQ4wpDgOw&oe=69B2C6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyIKwh3ooDQQ7kNvwHgtsI6&_nc_oc=AdmdY-YuVguIas6ozK6rsZqnfO-egj7aKjWPpFn5chZ0BA-Rdg608TcDpI3If6zvMpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzytwm0r7aUxBEBrHXOtrjqLhffvjxVWaA6zdUCTCiHVg&oe=69B2C67A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
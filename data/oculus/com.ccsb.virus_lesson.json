ksUuepXyrCIrQSN3CcK-80PWCdtltnd9HbNgmt323phfJjbMnI-IT22XA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4UD3yU7NgeF5RTylpA4froAq-fDWyEvSiSj_RHTGErA&oe=69BC00EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDIV8Z-TjHkQ7kNvwFq2sS_&_nc_oc=AdnKAb565e7vDFPzjc_25nv4kBXYeEdl76Qeh_kU96eMakEcV0yNbHZVmRHI2OY4ULo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDmveSagaEEJOWkmfJjoLIZ5VXeamHi4_jBP2-pvtM9g&oe=69BC016B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-fdJowNjz4Q7kNvwHqK2z_&_nc_oc=AdlwMxAknUTqZF_xqDyB_Fv12TsZzscrTjXPI8OAhXzeEt0CUD9irxDxIo42jIJ9BjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4dOFjkiHMMJHy8saxQ6cOO1kisRYhNBauXN1j_P7a5g&oe=69BC00FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
PBxbsQbGcSZV3RmaXXSXVORjGhGCgiDqyT6KAqLBleCAIGGgMpVfAw3-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugCjV-zMtY-oFAin6VPP41QcjqpofLJ8RHD13flD1lWA&oe=69A83A6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrO_gW0y1HwQ7kNvwFwI1hQ&_nc_oc=AdlDC3LZJBJ_14KShH8T7uICDsSdnSff6RRRKQHnEv6t1AO0QUDxAnP-zYCsZ-oBgm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsD9FcTDUMA5BgfakREV-bPxH2jt9XZBB47MlUwSiHf3w&oe=69A83AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTPbodnQkfMQ7kNvwF591dK&_nc_oc=AdnPu6-YtbiSaJrKmUh7e6ft3r5GvfKggQyXjlagE4Ku5eei2zo9UEWhKHDHdTfHYjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsrFA5Zh8q4AxKtarOgwyrmvKHIIMfT-hp-IDktC86wjQ&oe=69A83A7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
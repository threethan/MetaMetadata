t-iad3-1.oculuscdn.com&oh=00_Aft392Ts1b1-8FGLLiNpt1yM-KCrwdyffqa6JOJr_S9K1w&oe=6999B9EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7eQiX1e1GMQ7kNvwGl-Y5x&_nc_oc=AdmG2TG9YQDUN69tR4-NjDXF7fYa7cxeQMVR3C4LQ5MXYVLK2bXPLNZEbNUewlk8sQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcFssiBZ4sXwpGm1D0E4hShrS3mVf4UaaWsA-Hk_rYJQ&oe=6999BA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLw9flnXL4QQ7kNvwEpwN2t&_nc_oc=AdmogxCxj3rd_gRQT4-FJqU4NqqlLhKnT0PDjADhm1ZjEodPNwR9XyiYGNPTzdFQwlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv30L_UWT7nq3m9_-16Gx653bjiaHgx65aiXJfMZPf9OA&oe=6999B9FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
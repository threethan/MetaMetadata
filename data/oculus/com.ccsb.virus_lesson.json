rDY8FnyHFg1vT8KQ4CT7eMf3R1-JvzjxPIls2X51crKLRGPM9qj3j3ORQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfycVQ62hQdbOtEzV2lxrJEni74bIqoD_FnxDcq8Ioo-UQ&oe=69BAAF6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDIV8Z-TjHkQ7kNvwHGDla7&_nc_oc=AdnJeXz1VvXYbiE2iZnlYoGGd8uw19fsjTtFRat5NzjJ3SbG82aVyxwn_racgeUfMlU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEtDm7RmcNjuqswotxaiwuKEwFUBh1XqVsCy1BI7aQdQ&oe=69BAAFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-fdJowNjz4Q7kNvwEN-0MM&_nc_oc=AdlzEYJwjR2X2_o22fYh25ca664oGzLhYhQze-Dk5hzGsRBMKZWxYrvmXgj5F9YTkpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsSqQJ3R1uVMbAlMRAz6PMtqH1Hd5nYX3qygF3jsVRsw&oe=69BAAF7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
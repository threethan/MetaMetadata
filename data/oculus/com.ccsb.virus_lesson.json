nHcqkr3TcSkfdsBGOKu27VIqx5wvHLhQQ&oe=6AC7B1FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqqp0iZEZUIQ7kNvwFg9XYr&_nc_oc=Adps-hj2baOoMwrOLkZUS1E063ZTPvWQ_jw_zw_PK6FnOr4ATwmF7xWmV5tFZ9oG0ww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVzE4rb_NAUpZsHUodAiLAud0E9Y4jp89DKPdjFkw-dA&oe=6AC7A17A"}, "display_name": "CellPaintVR", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name CellPaintVR that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_website_url": null, "website_url": "https://ccsb.scripps.edu/cellpaint/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
t-ord5-1.oculuscdn.com&oh=00_Afv8OK9BhiEANesZnwROygzqhaIspKT15li5LztVsrvFPA&oe=699B0B6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7eQiX1e1GMQ7kNvwFfCpys&_nc_oc=AdkA7vxK4nKPl_jcTApQwLRvnRYLQ6yZepyy2i7KiqHIB6PuhsWiiDa8twfxKWqH-z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfumFrnA-P4eutppGx2OKSXdkWhDJCuGRr2DjulNhIIRtw&oe=699B0BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLw9flnXL4QQ7kNvwGuLrEK&_nc_oc=AdnAcFbNWphBJXrFt6amUp0HNP9hpA4QszrdExoizMAHxDJe4Zauy-LIKcSlXA3PjQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0kAn9OL1LqVvYHtyJ35fxooV2EJYAv04tmjhaB_PUqA&oe=699B0B7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
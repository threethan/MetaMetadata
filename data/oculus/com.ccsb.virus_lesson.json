t-atl3-3.oculuscdn.com&oh=00_Afs7zo5me4Tp01c0Sz8uI7AymQnPxR0lwFZQzOnd2ehclw&oe=69A5976A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcxOZXpNR1gQ7kNvwHwomhj&_nc_oc=AdmSV4UWzoSBK9mmyVYGn5G1NXywTKmyHeaCN_XfjLx17SF-4qcXpiJNZkjbo_llyZc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuiaABQJX9j3plgKJ8t3WIqHrqXtRxCTRxV_P2B-en8uA&oe=69A597EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTPbodnQkfMQ7kNvwHbQ3lg&_nc_oc=Adl11-TEz8vK1hg9VvaB71xP-Nnz9Ho9kdPlPdWKTUxQFWmWrQqTkncFwmhrdwGrJ5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs-nYZzHcxB2KmlkCHoLYIzBFQ1TXJz_qHo3EcWNR4SXg&oe=69A5977A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
iE13_qhCkzg5Cfyj4hjtXaYnF4zPhhYMUsVxb9uenZ5k7S9Rvqn2r2p1U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afww__FoizrFfCFxDaLa24lozjnK5tq7ls45J9v88cJ29g&oe=69BD526A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJnBI3lBdQYQ7kNvwGiHmM8&_nc_oc=AdkNP678cP0ZYJeEzidqWHVyeyAnFl8WE0SRc2j6l7iIF8agIZJBkq5RKb_4ZGFRG1M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxl5XeLHiBHaF-tv6kuX4fjP58i5rj-x0TxK71OZ4Lo8A&oe=69BD52EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7isXiXdhGfQQ7kNvwGPex0Q&_nc_oc=Adl-lDQFKnDjbjVi2gQq5vxaULTCi1_thKf2m0GwMBJYgOFLCav3xUGbFh1UYufbmXM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydH2h6RQu7rKrk_-KbCqyCyltzHW9p5lC4pxw8fXFF1g&oe=69BD527A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
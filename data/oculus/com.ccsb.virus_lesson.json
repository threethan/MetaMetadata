ontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974754_1430187927756080_83259455439309888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HXHF8GNHAsQ7kNvwHeWyoy&_nc_oc=AdrCuv69jNIdxwpe0O3u_95hL_DwELELVrstLi5qUC82O7O4uNsU8_yu6rDKGlcEie8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAVyGaf6l8BhSjk0HnqdTwh9WkZltQUaoKTyOtpqeMVg&oe=6B0F1B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVIHtWNWiS4Q7kNvwF7QCcO&_nc_oc=Ado9Y1s6brCOJRYvDOslSjkBz1HuX-k4c_4vj0Ory9u69Cvy4x3oRZcvUVNZPf0pDGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWetiReth9iMmQXpUn4neRGk6IeX7trv6tcXtpclbwmw&oe=6B0F0ABA"}, "display_name": "CellPaintVR", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name CellPaintVR that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_website_url": null, "website_url": "https://ccsb.scripps.edu/cellpaint/", "category": null, "comf
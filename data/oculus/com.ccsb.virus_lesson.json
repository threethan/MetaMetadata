t-sjc6-1.oculuscdn.com&oh=00_Afv5lsXfHkr86A59QikJMFZiZy3WB0hYZCPPcqsMSE_inw&oe=6998686A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jgn4pTNyS58Q7kNvwGwQvA9&_nc_oc=Adl11BJ2Cf1jE2Gn0wK_qO5d4W1rdnkRqEUKtrn3bh3_ttcq6H5MIL94bC0IQ4w4MDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfunXyX8bw-ipIWgFVYSAq0_kraXOTTNnQMWJQ6BMrZSzg&oe=699868EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OfI4XQgNKsQ7kNvwEiz6Ci&_nc_oc=AdnllTEtLyejsyaVIZca7rVhSyGEANeVgLnfOix0H8UKNay01NQqq_M_6hRK2Rvx3UU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftYsojMWWye5OrQ3BfADmXX4_RSfQvUq1Gm5HoRamH-WQ&oe=6998687A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
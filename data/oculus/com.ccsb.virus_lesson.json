jXuvnKXn9Up_5E2Bq76l17q25P16l24ftndz3iKm8EQRRc0aI4LTKIKf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvmqAutPWYrWIHm_x3tP2GwAIvilU_s9z0XKCJO7rWFg&oe=69B80C6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UGT-ivdaBEQ7kNvwEsyhjx&_nc_oc=AdnO4NttPLGhRfGT09fYwfPMf_ek6udQRL4sdDQgE2U_xVGZjEvg7EckhQdUi3KHESo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyqy9zshP5c-4I1Es6fQLd6-_K6BChhkhK4-1R8qQfPNw&oe=69B80CEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9zQbSi6a9QQ7kNvwGeRm5A&_nc_oc=AdmxdIPWhnXc-ETMApZAojJsFVjQnwT1EH0KH7r5CWyhlUdHSqA7dGGVYPPYhbWarT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy37LetSQJPKM7vfNI7p_qtxXS1LrgbBV4_Pt82_6GyVg&oe=69B80C7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
t-ord5-1.oculuscdn.com&oh=00_AftECHoSUySfA2KGLwf_DHYKU-VB2xZbPNl-wOoAPCkITg&oe=69A445EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcxOZXpNR1gQ7kNvwEFGttX&_nc_oc=AdmLqy5zBD0lxuvacbzAM7GzfMarij4bRqeV0fXOG4bS7Wqp9fXoIwLxYnX019I-v3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftl_ShYPmlAxuiBGAPWJX1rISzjj3vTX1_2aobNqe3D9Q&oe=69A4466B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi1snsEWqckQ7kNvwFoFp_d&_nc_oc=AdlKJTLNwlAaBR6z6sEQZJOO504D5-UAtNQNe6lYTKf2A12iuLerBYtVQEHdqOH0jq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsIXbRa_3XNn0kM2hbj_tze6iZvDk_rP_WpllIzDTM81w&oe=69A445FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
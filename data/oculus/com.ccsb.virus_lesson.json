t-ams2-1.oculuscdn.com&oh=00_AfsgO57cbGNRmmH_yRVsg4z-HHayhrv34tDf4WQb55dcow&oe=699EFFEA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqnJozU0l5cQ7kNvwGMe7gK&_nc_oc=AdmpmRlEEnU8Ssr7D5s-So_PrFpnJb4gBxp_Agc6P66rHJVO78U5K2fOw-b90Zxkm9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfviRnfZFFzYSCmoc2Dn5C7rHCpHAlkkm7vi_WkEbDq0eA&oe=699F006B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6lBCzcj8yUQ7kNvwHoVa-o&_nc_oc=AdnDR_aaKmhEX42jyOywYtqXc3sN1xQfwq7sloRApc-HKAjYhQssHrO0AltNVQzpdOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvnYD_KenL4Rie8-8hzz_FZ6hPLkwYNqnb6VK4PPjXsRA&oe=699EFFFA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
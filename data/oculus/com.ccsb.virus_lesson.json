wG7WYM2zHhNWbLrq1T0g5TxJN8p_JcwsjDQDVVhsXlDkH1256a7uh8eDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNSvZLVG80olNXEQ6LfExNgESHvgOigU9fnicGnjnWJA&oe=69B0236A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cYeGoKOhWUQ7kNvwG4a6-J&_nc_oc=AdmhWLfddRP7TzSNx-0Pu4iP2KtZjP184fhqtVETHHAZgRiM1n8DRk8BkUKOKu3qIRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzktyXPo7nls-DYXsJnTOv5cvtjafo9DqVywPOkIoz4fA&oe=69B023EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4u4knMM1fkQ7kNvwFO2kct&_nc_oc=AdlrWbsY-AZKhYh6GSI0NH5H52yEls8Lp2KH_j0lLLmfMOeQJWVxEacyxASJ8mlx1DI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRqsKPTna_QrtuBYPjwSi5CbEXlw4UptiXahJn3nvbhA&oe=69B0237A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
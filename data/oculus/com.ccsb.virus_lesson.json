3edYDUQ7kNvwEEnOTW&_nc_oc=AdrrOAooK1K0le0xSh_i8KLQzV3basrvDsNuQOLf9zhJNBktwRgjo1ONXPf_fsP-3BY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcHjyv068Cp1Ybg2q7nQNlP56oEyGgraFOb4mA8nwKvA&oe=69C2986A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzpYIvZBn8sQ7kNvwHxW8sU&_nc_oc=Adq4QHNBgWFn2XTH3w9gZWuU7LRGdlDmoO4hl4MCDCmtPusg_EYA_qK_ubZQv9f_jtk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBwRdYR3O-tq2_baJzRLBtdkSI2z2HBXnwUA5DEge2pw&oe=69C298EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8QryITDB64Q7kNvwF0SBDA&_nc_oc=AdoDWlaSjADpGX_dLyhdjfpold4kcU2Tv0NHcFlMLll1CLKwhQWZC-cwUOp69ZAJw58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUvwZyEd8__6kiGYiYVOygacxTuxxamwyoEtBGQPGebw&oe=69C2987A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_priva
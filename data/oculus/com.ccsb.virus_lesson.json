cSLOwkAD98a2SkDP8eXZTGjaZKIX-G8auNxyq4kuZ4_-YgFIZgKwenaHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzBQGz3A1UaA2xInJ24B-ZwuhgvBz0zHDJ_yw0RiBx7Q&oe=69B95DEA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UGT-ivdaBEQ7kNvwERuywk&_nc_oc=AdkJ7dP5ll_muInZVkDQZDdG0mB5M0KcvUUcYSy8cKgQoRp4DCjAb69sCvzV4YWBj3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaEuplF3JKUh8U4oExL9FFSdAkQjY8KwFBZlJ7HeekHA&oe=69B95E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-fdJowNjz4Q7kNvwEeCVnp&_nc_oc=Adn456T6WC17rcVDptBuquVo_IrTvfBwPTihjOo7GDN_qwb7kWiJLjf4ijrxAEavvUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGA0ej1zkj_awoSvQNBSmDxpqiuMuQ0mEg9CEAxncElg&oe=69B95DFA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
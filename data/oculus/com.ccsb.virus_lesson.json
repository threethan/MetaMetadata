COFtxGM7KFEDUqQ0h31oZWapO81_6XEQduQMJwaEeNOnSkCUYMSxuM_yE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybugyPbrBHTe_PjTQ67Lp0mnRW0q3V0bTajta6wAygUw&oe=69AD806A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdrXfLRlP9IQ7kNvwE6kPR8&_nc_oc=AdnmqKmAnFEjIu4b1sO5oC2eC-TsjqU9fJt1Qg_X5Azr8xYj8o_TnF39kJM_60cIUxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwngUSbvyoRmimCi-Cn7y0NFLiWT1ViILScPHyiVi6fiA&oe=69AD80EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4u4knMM1fkQ7kNvwGd7R2P&_nc_oc=AdkJ8KV2pgRJKoNBIYaHtLp1jjsD92bNRqjwi3EaEZ6wC-JycWUsTCgVzH4KBxi5940&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6k3USSW56orHaQqzbRHkHEqizLNqyOIyAFtM-Jkd9JQ&oe=69AD807A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
ontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974754_1430187927756080_83259455439309888_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HXHF8GNHAsQ7kNvwEd_B8A&_nc_oc=Adqi186YtNDPxnD6SDp6WfUVZk7c0bRCVS6ZCZgicYYgU_tAjpIDS4kgmI6KIuh6RDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa6aDE722yMC232JkokJWOIddvgbNMMGAiAU6WqL9EWg&oe=6B0DC9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVIHtWNWiS4Q7kNvwHNMkg2&_nc_oc=Ado-0OBnNqFd_K2YcKbsNmSmRtXAeGrw_rekchGRCXFUOyiyVccHoZZt_8Dnq8XD3rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvM33YZIaRmej2gwaznu0ml5MHc6fh_i-_7kk05fOaxg&oe=6B0DB93A"}, "display_name": "CellPaintVR", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name CellPaintVR that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_website_url": null, "website_url": "https://ccsb.scripps.edu/cellpaint/", "category": null, "comf
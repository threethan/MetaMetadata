QE8LEvoSE5DYZmPbVPILotrvAz1CM0vhVKns_oAR-R751P65TR6ZySr2Uw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwEdWFeLmXgt1bNVardjY3fv5jXQBBfQpuG9XFkGGhYQ&oe=69AADD6A"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdrXfLRlP9IQ7kNvwH4cOPd&_nc_oc=AdkQF1695mXotzyyTPRq7VoXBZ2nnz_sgvGFGAQg5GbHdfpreNlwsevjZfHuFEqT4pg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxdNYjgmnGpbTDkoiyDmmYrg6daJpOLDPrVFyNTW73uQ&oe=69AADDEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxboQ2LonoYQ7kNvwGwax8Z&_nc_oc=AdkRCBFmHMdr4YwOsvapIPD5Tm_R-oPoX3LnWhEy3W1yIVk0kIe8LYEC3lcIrfEDDjs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzquHq3U3ghg4VnNQ5RRNHNeGEo_PHrpcD1gDYJ8n_-Cw&oe=69AADD7A"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.e
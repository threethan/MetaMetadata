Jv6KtDm921GcBZGFF-jMQ7p-nCXW3MfGfVaPbd15ha0FZn6Lou8o1qClc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX5eeKrZHSAStvwHhhV1X0moUprRH-a3r1Y1Mu41EOjg&oe=69B174EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cYeGoKOhWUQ7kNvwERnVgU&_nc_oc=AdkRVPzdyD4Z4md6lofDS5VEFi-i0d8KYbL6h7oaXTQ4MrsNSG-CCHCO3jLjucmPouk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzrb_ce00AcyGO1SkD7dkkUAqY4tunH5zilFalcICWceA&oe=69B1756B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyIKwh3ooDQQ7kNvwEFksUv&_nc_oc=AdlaBuPjF1wX2c-YC2GescBKCp0kvh6OjseoWwunOyYMfbW8jptqvoZjNaVmm9rcuHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAnvbSjxASv6yszQVyng9fzbysZ0LAlL18171LNAeOlA&oe=69B174FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/i
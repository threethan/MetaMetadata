t-hkg4-1.oculuscdn.com&oh=00_Afvb9BLz2DMoAqsENKRQaQa-MDyAt-RLNhMJG-K3DFYp6Q&oe=69A1A2EA"}, {"file_name": "screen5.png", "id": "4210942055847647", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499623185_4210942059180980_1194395137070400906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqnJozU0l5cQ7kNvwH894nx&_nc_oc=AdlWoTGrvLp9AQymVQhGfIL5hWhcNcg7tX7gqwH09RAQMjRUz0F86sQkM8czn9cD3H4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftljD_6OKJusRJbMcOefUMrtta4_K6DYH9PV7oE1UoDsQ&oe=69A1A36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1100_crop.png", "id": "276845508261952", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031561_276845511595285_6591910760851817440_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi1snsEWqckQ7kNvwGY4gSX&_nc_oc=AdnTdD7_S5OIuXpbKAhrGilu92vB7k34oCHrJcV07z_obL4rkEQ_6585Zt4QcqdHfLQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuAbGjTo5DCEtVmkY83gSggSkDlIIN62WrxXjNMClb90g&oe=69A1A2FA"}, "display_name": "The Virus Lesson", "keywords": [], "long_description": "We propose here  an informal science education (ISE) project with the goal of developing and deploying virtual (VR), mixed (MR) and augmented (AR) reality tools (referred to subsequently XR) under the umbrella name Virus Lesson that can make the world of molecules and their biological interactions more accessible, engaging and comprehensible to a broad audience.", "short_description": "The goal of this prototype project is to introduce and examine the concepts surrounding virus structure and function.  It focuses on the construction and geometry of icosahedral virus capsids that enables viruses to encapsulate and protect its genetic material, accommodating its needed space while it travels from host to host."}]}, "developer_name": "Scripps Research", "developer_privacy_policy_url": "https://mesoscope.scripps.edu/index_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Scripps Research", "support_we
ord5-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwY8gZ7sjKQQ7kNvwFZLX1_&_nc_oc=AdmYhAR235H5_YXH75p9wMoISg9YAvVG9fh05aP16Y8tQD31nWYdXkgjv-WBeMdqqjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6Du5Ag4kfAkTNHxGrLmVjTGarWTQWk_XgWZemledDlg&oe=699AFD6A"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHHJDpO41EAQ7kNvwGhEpMd&_nc_oc=AdmzB7nUOhgQQIvlKPe6MXf1xzhKVZdRH7vL6XKUo88wFkRKtN_knpBbpfM8UMaik6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftUd50iLDR8WOB1mTBGmQO67K-A_DcrOwFWvB2KMxo0nA&oe=699B10D8"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9ShqJLHTCwQ7kNvwGuZdVr&_nc_oc=AdnUQ5A30re0-Qb4x9gpJCUAd1PtvDsMIBmkqzKYiGmtZ1oIFGR9xedcdtNYlsgxoSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsCgcOyBV3CsqZdgMFc8YEhhP01KBrfTN78oYTEA_axKg&oe=699AF7F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja5k7s2CB6wQ7kNvwHNcmJB&_nc_oc=AdlFGo5k4QnGDe95srTfUf83IiTvqCGuoriwfLhWjJb6SDINsQ-nO6hQin9FmcVs6ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvxa9D7RSWG16XIqDp-UXuB1IpVKGOol6EnkEiWdCIkfg&oe=699B0784"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", 
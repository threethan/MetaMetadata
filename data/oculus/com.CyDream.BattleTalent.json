h=00_AfwNRyJQLnS874aPHpp74bQasmgflKbab2EZyDo4isM9LA&oe=69CE5AE0"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrG2oo-wq5EQ7kNvwEmNmNv&_nc_oc=AdovGCVyOT2BNLpgXMgEMoccR-5W7S3Drb6Vu9GgH3tonhC10EhtEuTR4raSkr3X9Gs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-N1uWIxDwXH97ONq35SQSZ-yTsDrODzJDeTTiIj6SEw&oe=69CE67EA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfQcEvQKUeQQ7kNvwFQOcyI&_nc_oc=Ado9TeD_ZvlJoOdUeZe3Wa4sSrP0JmKOmafsspkQF-Hzzvc1mXbOfADXZp45_vCVWm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwhuw0ktEtfVzL__xhumHupcl0QgmuBU6hixNOUE-PuxQ&oe=69CE7B58"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ckTgdV5SIQ7kNvwHTagIx&_nc_oc=AdpDNxyjVNYjS0DZbJXrgBY4k70r0nY83taAMcv65I1skdXud8hqNsoqkW42eddNGPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZu_Sr403Kx9M_0P9EG6D6wA6PvF-VLMJbecExaLrEuw&oe=69CE6274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asIggrwSG74Q7kNvwHgl7ON&_nc_oc=AdopLzbu600VpvdBr6o3HxlPM0fSGbJEQl1SBg4qtJmh2hR2oNO4NEny3EZJpMlgL0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDoI29rm4QSqe2U6j3cGFBNiqV1Ccqnc1B61poYb9IAg&oe=69CE7204"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "
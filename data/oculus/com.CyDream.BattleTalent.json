eYX33HfRm2njPyyDvCoAgxCH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TP8xCIVkaoETwFPkWs4tTlbGRE6TUnqbKZtfNodU-mw&oe=6A2ADC20"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEYCJZld2AIQ7kNvwHkWdRW&_nc_oc=AdoDC-YbizWyj6rzSnd3GCD2OcO7A0UwDXyE8awayy4_vO8g30j-jJyzqD9iGIjIPJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cG7zw_R8FK9Hkd2ltBMPuTWDrLJWipRmk-fg5_Rb0qw&oe=6A2AB0EA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN8U8hxdbQ8Q7kNvwGArhdU&_nc_oc=AdrlRicM4dKtZrfQGpTiPc35x6mDVmENgnxtDhmxgWlLhGrt8LRt1kbphZ34g4HSAvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NvCPPEz96PkZTpuXhjMP4qfS_lGMRj8o_yUkfWE6DsA&oe=6A2AC458"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE-1tMH4x9oQ7kNvwHOrQgv&_nc_oc=Ado3uQlGq4aAlmVRiOX7niC33hDiXuedJKV4Uc_nzEoKyFMrkIsZht3IGyJy5n7DAi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ebkig4aNDIYCkdVObE6eneAsQDWMwOT5tjrgfEwQuqw&oe=6A2AE3B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1870842463624277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619594_1870842466957610_5218009932879125959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNPPspkakXQQ7kNvwGsCF-Y&_nc_oc=AdroMfPfXmIKDzKC889XYk9XA9vjCtT9EDL0CgncRNW6_7FRa5c2gwr__LHqbXktr0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nGZDjqU34ERroP6EZ36cBCfVFBCNmJk6F6xdf1LJN3g&oe=6A2AB1AF"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "sv", "fr", "ru", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34483256017985281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303672_1347063184125109_1755279695409896724_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVz1VmXcMVoQ7kNvwExGwYi&_nc_oc=Adp3f3i54lxL85LMWjeolP3abK6Tu3VbRwO4ya2SkaT7_2hZzFaZkU_VMdnD0Kbf0wU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tayjaO-y5GGHzW1Ljxgipm57ZLTKzI8XuxvTwRDzCxw&oe=6A2AD56D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Talent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_
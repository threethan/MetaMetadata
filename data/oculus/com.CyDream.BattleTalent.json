HzLdaoSmSy6I2h7dSYdIM-BEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcVcrSFkIXqz0Kivxq7KI_GJCm8HypTbUJkZ8-XV5NKQ&oe=6A4FAC4D"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9YgCMN3JWQQ7kNvwHx5-NB&_nc_oc=AdrpVnkpFob6kRULDW0GKwmr6Cr2zKMPOhxR5v0Bp_yB9mjj_dAOO5WVr53_cipp3G4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6K97PbtKBrD9RdiByVgth1LqVRy8e2R3NH2wPEstANA&oe=6A4F9AEA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1UHXSzJvuMQ7kNvwECKuXx&_nc_oc=Adp9pFsmyFT9q3WJnCh_8ElgpNETK5kJpzjfp3klHcmd27Ah5ED8FtIRMgmaNcBrtMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJgdlUug0Eq2C8xWMrua0aC2cumy-9zyGyZy5OHNftKQ&oe=6A4FAE58"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnuec6GJVacQ7kNvwHRhmbs&_nc_oc=AdoWMUxUB2OiiABOUfYhUfJHpmgmcY7ulg6ApnpdIyzceKDO3M7s4WFzlMmZH2uiVZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsKF9a6tvBtgZxvzFdVTL1WBTTwp_WwExhTh5Aqo9vpw&oe=6A4F9574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1382313613767330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620504_1382313620433996_8057670797762845351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWGKt5G_Rf8Q7kNvwFQZy3y&_nc_oc=AdoWbnW0g9KwWjlcNV39mPN4DpV-SdKL_AJLimcfdT0PAWT1EKHUSamJPg6hhsUyxeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3XVagFI1VMlzAvIC9ZmL9VR87SRz315S4-sDP0lQw6A&oe=6A4FC2CD"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "sv", "fr", "ru", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35877657265211809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624983_4306681526264893_1819366258790088338_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMVokWi3J6MQ7kNvwFrEac3&_nc_oc=AdqmUjR2UmxDYKxUWbUKndDQK0b97iKVPhuz5JlLTxObZSxR7iyKTcvMTfcOTq9yanE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGS095qtrR_M3kt_gvM89aKITZrZh-Jo1vFvlm7o2k3A&oe=6A4FBDA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Talent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_
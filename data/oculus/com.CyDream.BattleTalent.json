hkg1-1.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL4a2yM2d9sQ7kNvwFsu1XZ&_nc_oc=Adm39pN_YzTt5j6kYCMyLaFqvXNfqTT0iKNQFXMxAtYRoh_WiKd9c9afFobo-tbUgc4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvVPD9ELmP8w3eyFNwNX6hVK8eXxeGHHNSPKFtZyZmljQ&oe=69A194EA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrDGuJTrYe8Q7kNvwFN2uBx&_nc_oc=AdlPwhIXVo5Uah1KLzcdxen97tPUoAn0sEt2fWcYHwuQ0pyNObX187Ii4HN6etlfrrE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftgkEcClXbHq4XzJSY0RwGKg7qs-r4-A6G3J0NnwhZcQg&oe=69A1A858"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0HklH_dq0sQ7kNvwHJVUJ6&_nc_oc=AdnD1NlXNjwhPjf5x1osqEy2CgSIFlV8kmC0nlpcVaeNLNPWSrnYeTvFRxO0Guj7nIk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsswS7I7VH7gutZETnW8cglZnT6PuvIaVqfxLuUibmlHQ&oe=69A18F74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EMZp1o2T-cQ7kNvwFbAHmp&_nc_oc=Adke2zbe4KCa8c1YiFwtkXbbDrywTUMK-AiFhgz-YcbiMJtXbxktvfgGqj5wnPdZCno&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft3hHP6Yx5pjExTa-B1Lqm9i27S2ozW8WA1fQsqXdowmQ&oe=69A19F04"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", 
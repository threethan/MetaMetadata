A6YPh-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3mjuGXjK_9AyA0c2M8u2MSpcI3tsk-ZGk6RmPzsQMdA&oe=6A9C234D"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZY8_c2_BREQ7kNvwFYV8Vb&_nc_oc=AdrwqqlOMysYDKBQKYmjdcU4AdJqX2VjYPAAs7g2xFOMWl8SlugQAqDqMgItLaxTvxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTr-hizOMV053HapQ0D2JjFLIadXbzMxlvbwsozHHhyA&oe=6A9C11EA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTutIepwVU4Q7kNvwHFlgBM&_nc_oc=AdrZUlhYIqjQemvC7ROZ3hNVJPL4tdogx6TjwyhlS2iX_Hb6xe-vz2hXlPiq_o-Qfwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUuVf9upr0EKjtCWlt1XTKX6qzaOUYt3hX5dqwdEltgg&oe=6A9C2558"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqzOlkkFjzEQ7kNvwGjMZfB&_nc_oc=Adr4jCKkdfTEhYRwd3Cb3GpO9M8baWH0kbkp8e6Cxw1sKplv-xs7kmvLys3fuwPc8C0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyD71zj_TThnA1ozmC_KtGZjppEmVpAu8Wax0plgFWXw&oe=6A9C0C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1280511594053414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312338_1280511597386747_8355525194427344147_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdEm1HG_GUQ7kNvwHryPwd&_nc_oc=AdqfxUPN4MazO6oS3S7ZjXF6fto7V3jKDO0TrVvDXA9MHstFXdBZB-9M76VULGbPfN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeBqQYFP2UQqdHV7kQsW0ADqWhRMVeWtll7gttsrgvJw&oe=6A9C1A24"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "sv", "fr", "ru", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37395839430060244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298281_3990423687930951_3759598710705788061_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ojJfTwcgEUQ7kNvwE9wWic&_nc_oc=AdqE4-CTfncMqzkVLZ8N12QDdqnk3N2u0QEZB7pOzEDxvc84PIpne8N4EaxIR59lQ_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcPNHBnhCJQiHR_ixc3IiFFA2fMRt7Mi6TGU1Iy4rMow&oe=6A9C1738"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Talent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1685638800, "lastRevision": {"no
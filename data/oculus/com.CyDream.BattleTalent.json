t-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL4a2yM2d9sQ7kNvwF5TqSz&_nc_oc=AdnbHUb8HkDW2TpzHEx57BWcF3UEG5PoOyw9T2baYmaiuXkH07ae2jlPxyMONcMtimM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAGmzQafQKqe4mrMD24OPVXna8Y-bsFoRLmWI6wCgwxg&oe=69A0436A"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ay8OIgX0dNIQ7kNvwHN-oKu&_nc_oc=AdlHw56Wr6zM6FebRbojeBTnj6ownoFGDOEiW3Hw93PZxD5sS7TiA5HI3te2RP3KUos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulCTOxvmf19dLb92GDi-ZHVpSzxDy39bhmRehZI811Eg&oe=69A056D8"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PSw0sNs3bMQ7kNvwF0LhVu&_nc_oc=Adle35i_sb6LJtP77j54N5U-QvUJQSY8TZyNNUce3nnKa3Rf-rTcK3QGSR0Zp7QPGQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9dtrSUsqd2-FhFpMO18aRKZWSAxp00HxMrHN0qLst6Q&oe=69A03DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EMZp1o2T-cQ7kNvwGognWw&_nc_oc=AdkLRK9fATFB_hIFdTx9KoWceFGUclYtrwq7y9kjJFFEngGAkfuFLd-5yBXy2sOjnUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutBHo519874j4M3q2yjaOhEqJsIoVgzgjpaKvZ_LOg9g&oe=69A04D84"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html"
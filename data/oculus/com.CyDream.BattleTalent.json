atl3-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00N6smbNyNwQ7kNvwGAQ_C3&_nc_oc=AdkA9eiL2jKX4iAUIArjzhGXO584yZxycN1qdIYHjrJQ1ZOR4iJsfnMq3YXOKCjz1Ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvXRAdRZ8VtPA2sy_5H0fWR2Hhzt-4bdLoEK5oDIbydzg&oe=69A5896A"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBWU0WBoKpUQ7kNvwEJEcPk&_nc_oc=AdnvlX6bf7mj-MMm9J83Di0q42mh8pk4odzKKDbcVxvXwrjmedYWgaw6bEBa15YgZy8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5WscRL5bI-_fFByOtvXApf7MmqhWvUEsjw8sDbFrmDQ&oe=69A59CD8"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfqz9tez36wQ7kNvwHUmysC&_nc_oc=Adlbbrq8rE0LfgqYhtmLor-ssL4T525bgEK2DXHsF3D_hJp_p09WSRSa_eTCm1VytpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvM7oaDvXbanSav7MWpr-L2cEO7CAX5qUlORo2vLwlWpw&oe=69A583F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaNMTk1LeLMQ7kNvwHvDxGI&_nc_oc=AdlPCcQbBrTbiCwB6zu4jYjuVaxZU54aBqzgsR3G5xwsl_Ol7T5lG_2s_dVdQJ3lBuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afttyc51UrclPVmc77jene3dRXCa-uYhGRFK6IFzktgZfA&oe=69A59384"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", 
ams2-1.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL4a2yM2d9sQ7kNvwGsLAGX&_nc_oc=AdlPYPt-7mIzLwU4QFRMW5DbiT6ZHdWcoZ2aAqdD995EqgOuJxYNb1fY-Y_XUzD4mKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftRjhWIrwmyj4Ir0rmciyqp4xWrA89oghJQ8r7WCEhEGQ&oe=699EF1EA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ay8OIgX0dNIQ7kNvwE_7Lse&_nc_oc=AdkAuVAbEFBwiShx1Eq-e5S5EraqAMXMrnxEZ58aBMG7YzlTS8bZpMfc8cXBXjVcreU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvu33QPCGEFMQZCwVoXGgJuHbpVKqAVNoBzPdtrTjCIdA&oe=699F0558"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PSw0sNs3bMQ7kNvwE909Mz&_nc_oc=Admw-spzwFiJmU_K7Hb3z-0VLDH2vVV4yx2xJ11OuOuErho3wlEWc5Q8SKC4wbbdXIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu6g94cHMtCqZb3RCZ-jSjrUZD8RNWgszI-G-J6a8Zo2w&oe=699EEC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1257252019717768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_1257252023051101_4556208130971759166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK88RdHPMdYQ7kNvwGQ2cLB&_nc_oc=Adkju6kkhnwlS32I-f3cw0Z-cO7IjwmttMGCYzKCb0BcpNVvusXMjuxAqHSs9AxjSiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfufvVRB6vreK_k9jIw5mQHGaDflNdL01Kz51KvQ7iRg5Q&oe=699EFC04"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, magic or modern combat, melee or ranged attacks, this game has them all. "}]}, "developer_name": "Cydream", "developer_privacy_policy_url": "https://cydream.tech/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": null, "website_url": "https://cydream.tech/battletalent.html", 
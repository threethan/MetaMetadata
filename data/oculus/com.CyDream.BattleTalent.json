TWc3tZUsQ08E5ajFIj6Nh0PT7Jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15aPjPqyIwzYEqvv2VZGpmgNH7ZZdqtd2zpuU-SP8h_Q&oe=69E372E0"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwTSXlUTanYQ7kNvwHi7YCA&_nc_oc=AdouEdnvv9mQn1ktrNCMcIVCEfRmJs-KDsgYlY-7m3siMqqvAK9maspGp0Z1NeiEheY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RP3_wR5NspI74Z4wSSHNEmYQoCkAmnzaIE_DUDTm_dQ&oe=69E37FEA"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdAktPv4TtAQ7kNvwGTQcM4&_nc_oc=AdqXXmVDBe1h3QI1z5smjxQdJbgDIbtxKBCB3vDLiRl8t-T_6gByopYYBvJvefV8jhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dv8JFjmSlQORFdUDrH32ZrEI2MN_EdJORz9vxIKvaXA&oe=69E39358"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjnuDJQFYvUQ7kNvwEW_y_d&_nc_oc=AdoCU5EhtLVfvrQOK2cuH4ljClh2I0zXKll6_GMo1Pai3s0nP68fPlnNCajBf1UrvbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33L8gqFLUhb5MQrqwAWGaxQL8XOlc9iIBtqNLiW_wDww&oe=69E37A74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1870842463624277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_1870842466957610_5218009932879125959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nLq-hXul4UQ7kNvwH6I_p6&_nc_oc=Adorimi8CrQhQeF9ezegRHak-RewTWVS6rIkaeuHWxSuaegUabp9kWhhvFegODyR1pg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GJLx3dSwY_xjIsdN70ZjTxNIOkM7IkJUi_T_sFsS9bA&oe=69E380AF"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, 
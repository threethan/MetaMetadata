7ZheULpMD6MXdv3LXTTWImjiWRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeEY5kfoG5D1Zs7OxO7IHDByK2F2aNXLdN0LWxRbfwiw&oe=6A8316CD"}, {"file_name": "vlcsnap-2023-05-12-17h25m50s471.png", "id": "1296273721283473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982665_1296273727950139_9036441277484988244_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhSdnrORY4EQ7kNvwHJWkn5&_nc_oc=AdrHFjcWyevN4hXV9ikWPktyHHgmx3tvHUks4SE3_gHEpPagWQddy-AdjrRnFYO7tvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMx1lWmU06ijyNz-EBuxsMjAkVEzh51G9upKzoe_QFUQ&oe=6A83056A"}, {"file_name": "vlcsnap-2024-12-19-10h42m30s837.png", "id": "862208289839723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_862208293173056_8926643515256314746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyOioMytFnQQ7kNvwFyvOo9&_nc_oc=AdrhIiJvxc7xc4RD42Hf2F1i2sjdKL6FWou2rfBdlleO_lqjLvJZaGV0lh85CtNJOrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPTFlaN93WS8ueHOp9YbDNuz51tHUeX9VgQOF0Ygu13Q&oe=6A8318D8"}, {"file_name": "vlcsnap-2024-08-20-14h38m41s551.png", "id": "2371128206657808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_2371128209991141_1182381678042568983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLL9GElMBZAQ7kNvwEFMUrW&_nc_oc=AdofBtie-CgcHkAvTlBdPAnSK9BUSgH8M9fellWUrWYBveUz2nIgPdOR5nwxcNX-bG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXlFsArARVzzofE2odwfKYLXHz9bUYbW7CBvNZ06atvg&oe=6A82FFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1382313613767330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_1382313620433996_8057670797762845351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LKyVR5vUCgQ7kNvwEih8SF&_nc_oc=Adq-iwhiZA5Qq-RG23IQOtsmF_b4wXcMRffUU-bSYg7IPWIWQtsdiyGXh1MhQpfoOlA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDf__ta4xVR1CgSfBpvR5I_08HZ0oDLmtI0OcvPY_IlQ&oe=6A82F50D"}, "display_name": "Battle Talent", "keywords": ["physics", "melee", "mod", "combat", "multiplayer"], "long_description": "Fight like a Warrior: Dive into a challenging physics-based roguelite action game set in a medieval fantasy world. Create your unique fighting style and embark on epic adventures!\n\n- Join forces with your friends to take down enemies! Experience rich **multiplayer** interactions and create powerful combos! (supports cross-play)\n\n{993508985736691}\n\n- Engage in realistic combat in **Mixed Reality Mode** (supports multiplayer) \n\n{862080482494054}\n\n- Experience thrilling physical combat with **spell, melee, and ranged attacks**. Beware, target the boss!\n\n{1153464909301423}\n\n- Customize your talent points in **Roguelike levels** and unlock unexpected treasure.\n\n{2455464587991559}\n\n- Explore **Sandbox Mode** to experiment with **2000+ mods** and Scene Editor feature.\n\n{1662858931145151}\n\n\n\n# Features:\n\n- 5 game modes: Adventure, Challenge, Sandbox, Mixed Reality mode (Quest 3), Multiplayer Mode\n- Supports multiplayer mode for 2-4 players and includes a built-in voice chat\n- Built-in scripted mod menu with 2000+ mods, enhance your gaming experience\n- Thrill of hack-and-slash with realistic physics interactions.\n- Variety of enemies and bosses, over 80 enemy variants with different moveset\n- Plenty of weapons and perks, over 100 weapons and over 60 perks\n- Seamless huge dungeons with multiple landscapes that regenerate each time\n", "short_description": "Battle Talent is a challenging physics-based rogue-lite sword-fighting game, and now includes mixed reality and multiplayer mode, team up with friends to defeat enemies!\n\nIn this game, you can create your own fighting style and experience unparalleled gameplay in a mega seamless procedural dungeon. With over 80 enemy variants, 100 weapons, and 60 perks, the possibilities are endless. \n\nWhether you prefer medieval duels, 
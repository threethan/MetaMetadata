uscdn.com/v/t64.5771-25/473393328_331787713363139_5479799395310953245_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A49GcCFawegQ7kNvwGAnkSh&_nc_oc=Adq6qZ6icpigBhnHCT0UYgkZLhEoMB1ZsMKX6pAadgTYcvRwNFh1YgFXfqnzjiBvWwo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS9Xfyk0quDhPry8GgqHCmF5nC2BOP839_Z_vApj9rRg&oe=6AAE84E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2961219004028951", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391862_2961219007362284_5968431701223332584_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaIjpqsWoJcQ7kNvwHEBOux&_nc_oc=Adon4mRZ9NkV34slY05MrO88oxcE_M2DdYAj4BQ50HjAutU7R_-xQDjrfpdgVrcpXGQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLUIrXsgo2s-pCttIsa7OvxwzROxxE5ILkVr5O8UjnDA&oe=6AAE8566"}, "display_name": "Dance Partner", "keywords": ["girl", "dance", "nightclub", "interactive", "partner"], "long_description": "Meet your stunning Dance Partner, the VR experience that brings rhythm and interaction to life! Your virtual companion is a beautiful, dynamic girl with realistic facial expressions and smooth, fluid movements. As you interact with her using your controllers, you can shake hands, hold her close, and guide her on the dance floor. Every motion is synchronized with the music, creating an immersive connection as you groove to the beat together.\n\nStep into a pulsating nightclub filled with energy and excitement. The atmosphere is electric, with vibrant lights flashing across a shining dance floor. Smoke swirls around, and the sounds of an enthusiastic crowd add to the rhythm of the night. Whether you're performing a smooth waltz or simply moving in sync with your partner, Dance Partner lets you create your own unforgettable dance experience.\n\nFeel the music, connect with your partner, and immerse yourself in this unique VR dance journey!", "short_description": "In Dance Partner, immerse yourself in a vibrant VR nightclub where you dance with a stunning virtual girl. Interact with her using your controllers\u2014shake hands, hold her close, and guide her across the floor as she reacts with lifelike expressions and movements.\n\nFeel the beat, connect with your partner, and lose yourself in this immersive dance adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9220676491385618"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1503540321460592"}, {"status": "PUBLISHED", "id": "1141266197581332"}]}, "baseline_offer": {"id": "1503540321460592"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784189880, "status": "PUBLISHED", "id": "1503540321460592"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23949657368060954", "version": "1.1"}, "id": "621482537009352", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
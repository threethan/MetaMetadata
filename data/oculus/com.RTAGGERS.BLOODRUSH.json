 TAGGERS\n\nSwing, run, and scale your way to victory in Ripple Taggers, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-ga"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Ampi1e4RWBspLQpNWRDfovy8LYqRtAJQJOf_M2AqfDk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Direct", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1mbMUYDQ089JWQzaA29tswchxqqZTv8wfZB2N0LyTasU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1152710877933875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507833663_898312999988524_8689406888850015903_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FUcMdaJmxgQ7kNvwGAI8mH&_nc_oc=Adprrl1Yt4WSqmpDvwlmv9zUP-YVwxow_pH99GwSUH7kUyLYNfZj6fLEuQs_wIs1EjE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLolQh_45lCFXymrpW1xT7b0acjgu
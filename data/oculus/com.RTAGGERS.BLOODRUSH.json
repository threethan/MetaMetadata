yWsFUicypjg&oe=6ABBB906"}, {"file_name": "Gorilla_CHasing.png", "id": "1343170760592134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1343170763925467_2625165734147829836_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXmFhAAQAXYQ7kNvwElHI_K&_nc_oc=AdolOZBt8le_x-nDDiy39LlquGBLMN99G2HqpgQxXTppW2sQjW1F_JlE7w3ggQ0vICQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfp5LoLMQrdsbWyiuIjL3GikWRqJmW1avPBsIAO2XFrA&oe=6ABBC7AD"}, {"file_name": "Gorilla_Chaserssssss.png", "id": "4034041696729937", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507840145_4034041700063270_105011202233764348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FagPvcyf4kQ7kNvwFr84du&_nc_oc=AdqXcO_DLn5rNXoNqhVYHgS-dfQ_1Zex2flaZ0HDYwum2O-mRReb5oGrN0mx3X3L5DA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQUwRzNwyZF2DzKlct4qVN6iH2xSKVMNMzQYKrbD_LJA&oe=6ABBD8E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Taggers", "keywords": [], "long_description": "RIPPLE TAGGERS\n\nSwing, run, and scale your way to victory in Ripple Taggers, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAGGE
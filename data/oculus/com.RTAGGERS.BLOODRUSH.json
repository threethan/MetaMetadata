mjckvQWBhPg&oe=6AE5E906"}, {"file_name": "Gorilla_CHasing.png", "id": "1343170760592134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310667_1343170763925467_2625165734147829836_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVQ4tG40PeQQ7kNvwHsZFaz&_nc_oc=AdrsHSzRNkrCieamqSiStGU8U42rt5KKjzIdRCgvQfsC8yD_sYR6bUhKGXnq0wnUtXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOudlC0LU0Z8pN3_SStNgvN2dyCA1nLNDQai6Xnjf_cUw&oe=6AE5F7AD"}, {"file_name": "Gorilla_Chaserssssss.png", "id": "4034041696729937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507840145_4034041700063270_105011202233764348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8afhOb267BkQ7kNvwGfSITC&_nc_oc=AdriI0k4RXfS1ID_OFhBooGSelv--VnnvVLy34yXtBm1RjWiBI0VlJuetw62juCQgBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCeJ-ky0BzTo1xg8y7YBLqDldiaK6dZTV8hxcteWq8aw&oe=6AE608E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Taggers", "keywords": [], "long_description": "RIPPLE TAGGERS\n\nSwing, run, and scale your way to victory in Ripple Taggers, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAGGE
F"}, {"file_name": "SC_40.png", "id": "654637948950870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031387_654637952284203_2208042870690662588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eezk_7aLvYMQ7kNvwGHn1-O&_nc_oc=AdnITTDfuugFg0OCktD1ps5gz0GwOYmhOzB3Pic1mxcqL5lST60DMDspGHUkRWKWDfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsORkF-n4OUomB5rxq79gTyF00o_bg4i0Vtx6l-gplPmQ&oe=69A038D8"}, {"file_name": "10.png", "id": "532010624981550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_532010628314883_1581933983801511423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9lMhPw_qB0Q7kNvwFGZujz&_nc_oc=Adnw7vhj9eJvVmTcevOD12BSRYKP98uJVHzwE9VV9Zx_uhVj3jyODajlzNqSDv7yyMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoKfc3nKK9CzVFix2QGRzOJGuZ_pW5s-jjLjkUgIjkWQ&oe=69A036F8"}, {"file_name": "7.png", "id": "371941711519418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_371941714852751_1494028129213572271_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQim4JgEcJwQ7kNvwGAlykB&_nc_oc=AdnPXG1Efk9SJpXTcivFEi9BOnu0W26QvOApqyuCQA4uLTH1kWmqK9xonzMrXmKj7hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCFJDU0PRK9UCYIYlN5tWht3vAskBmB5xFOCIVGPxDvg&oe=69A039B3"}, {"file_name": "5.png", "id": "363277835686128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031486_363277839019461_3354516259083345336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up48stAT884Q7kNvwHYAl-n&_nc_oc=AdliKfYHXNVY5-EQAFO4IMZTlMbNXj4dcHDBCEZvz2zNGdVAnnMpHjEgdbmPMQm1rrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqJf2SUF_LRtiGzpf5JRTwYZv14MrNKKhEbw3gs0ICig&oe=69A02E0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Banner DEMO VERSION 2560x1440.png", "id": "714731722940437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_714731726273770_7390464621846344973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ5A0mITlrMQ7kNvwFSRbbC&_nc_oc=Adk06_wMWhbhPtcq3_ZDUMDrWN7Yf43Hvv4YE7gpAL5DlbmtnKxlgcXkl1oc_EALpec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsA5V9_aTSMv4pvqzZudyZVudA7pQapUNSQhC3APr8UMA&oe=69A0365A"}, "display_name": "Labyrinth deLux - A Crusoe Quest (Free Demo)", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest (Free Demo Version) you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest (Demo Version) is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT",
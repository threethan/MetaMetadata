4W6s0iXP2NURCByattC05nq_KEl73ER6Lg&oe=6AA179CD"}, {"file_name": "3.png", "id": "196112052664570", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031625_196112055997903_7876639671305377338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xOUJOSLDasQ7kNvwFRaMsy&_nc_oc=AdpiLFDDk381rKCxcilUKyTo-L_JrzbGE8BFM4IVTcQa2rb41IkNGCdD2vOS_ZOBHPk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFTjoM3DQj14OM3iks0mo5CVgIgx7kfdx6G-C0c_UjEA&oe=6AA159B0"}, {"file_name": "4.png", "id": "2056126091205099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001713_2056126094538432_2215718104281062381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4buI9TAV-IQ7kNvwGRRRpc&_nc_oc=AdrvqWeToipz4nDTMMifYZ2Kc8fMhw6XGBCF0CEinsWomAeRUMz9lR9t8WJJpBJ9sO4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7LQxcSpziGgvedpPnYmJDmW3kuUTNY8d6RG8WEUbwpA&oe=6AA16B7C"}, {"file_name": "5.png", "id": "392209392597860", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031634_392209395931193_2356641713421028551_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onpmHonwoyAQ7kNvwEY7tKW&_nc_oc=Adoisig-hgUTuwlYuuHlF5JUmEBi73qBjZoqbnPulnqlbUvc4qR6lbzxUm45-xXDibE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQe9zgAqFCXHflJmLlETRDJDioVXSzPZ58wXi56ZUxuw&oe=6AA14E94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - Demo", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836400421092380"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "453073723098526"}]}, "baseline_offer": {"id": "453073723098526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658959200, "status": "PUBLISHED", "id": "453073723098526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5785191554870209", "version": "3.8.2"}, "id": "218839503644990", "channel_name": "LIVE"}]}, "is
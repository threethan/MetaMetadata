VR1y5v8HV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPaMzZUHArPE8798JCyCgvn34LB3UsyjRzandLkAsyXA&oe=6AFDC3CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Banner DEMO VERSION 2560x1440.png", "id": "714731722940437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_714731726273770_7390464621846344973_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs-GHzu3zcMQ7kNvwEWTXPI&_nc_oc=Adrx9m-C6j5MF2Q9ZBtltXsqyiW2-oSji8TSVZNj1ClhwU4MzQyU9xTrFItpG1THIQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVroa6986aGUlGiQSlxf8JEqFV-Gh7GsJjSrGvgYVuzw&oe=6AFDCC1A"}, "display_name": "Labyrinth deLux - A Crusoe Quest (Free Demo)", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest (Free Demo Version) you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest (Demo Version) is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1392449391263493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_400252165337673_4623922018838430358_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaYxDBmu8F0Q7kNvwG6v1TF&_nc_oc=Adrq7ZCMbg9kSwV1nnTClEv95bWQR0CTcw82JZIxtP3e8dCR2lIlFWxNHLm6Q-5Oan0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXBImYt-D1m1ACwX7HIrSEo6194THYnVlCXrqaVdDNNw&oe=6AFDDE31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Labyrinth deLux - A Crusoe Quest (Free Demo)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1658959200, "lastRevision": {"nodes": [{"id": "4416468925055549", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4603501616372548", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, 
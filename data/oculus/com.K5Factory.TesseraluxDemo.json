wYRpmywlbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRjcJXyKHjQuwAFwXqKgfWsvH5pbq2G5f-lZnusS_5Lw&oe=6AFB20CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Banner DEMO VERSION 2560x1440.png", "id": "714731722940437", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_714731726273770_7390464621846344973_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-FbTIjNjCcQ7kNvwGj2Z_r&_nc_oc=AdoF-EauT8f64rsd7AO24GRcAI5NkXnZIEcbFz4Jz3Y9hlU_Gku29TkpEY91JIhnAag&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDbGaOz0nbuk0ScEGL33f8x-5mipT6HydbV6i-pwqRqw&oe=6AFB291A"}, "display_name": "Labyrinth deLux - A Crusoe Quest (Free Demo)", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest (Free Demo Version) you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest (Demo Version) is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH
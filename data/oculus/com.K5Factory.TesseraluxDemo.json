F"}, {"file_name": "SC_40.png", "id": "654637948950870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_654637952284203_2208042870690662588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keWYHZ_0q2cQ7kNvwEZMBlM&_nc_oc=AdlIooU1Kjx9Irl2C9xDi8rPWusS-UnsNRcfjeoC7BYMIMGQ-2UcNrghLgP-YH0OHaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvm76K8RPnUcIo75t-vVZG015pha2EFygFlW8DDxZOfQA&oe=699AF2D8"}, {"file_name": "10.png", "id": "532010624981550", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982552_532010628314883_1581933983801511423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEdherSxoOwQ7kNvwHShVK9&_nc_oc=Admdm-tA9arNGfIg0_DTfaRh7QJ5adImlyTWSA-JuthTFrLEkK4J_yfm1Smah7XFWmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuB0BrL-RHXlz0PYND8jClq8nq10j8txuWPYg97XggRfA&oe=699AF0F8"}, {"file_name": "7.png", "id": "371941711519418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_371941714852751_1494028129213572271_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpPD4cwEnTQQ7kNvwGEq2HN&_nc_oc=AdkdUw-qTozeKSusD0E7LJF9iwy9rDEo8QcddSaSPptM24K3xa_i2ugW-CHoy44LIE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuHvs_qxU6GtA1087EkFNOtvFSVQ8jnfzNfJ3k6LwrsfA&oe=699AF3B3"}, {"file_name": "5.png", "id": "363277835686128", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031486_363277839019461_3354516259083345336_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4xs4vHqk6QQ7kNvwFJ7GgC&_nc_oc=AdmrhKed0UjTLDzaekuGcH3Rwv3J_mPgJZCnCqQMWqiLFV3rm7YCDao-5kn7bbB0TJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuPfDpqqtUlbtx-mxdPfTYxSm53KrFfIttWyaY5hDRn9g&oe=699AE80D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Banner DEMO VERSION 2560x1440.png", "id": "714731722940437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_714731726273770_7390464621846344973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq4kNnOOujYQ7kNvwEwEhwn&_nc_oc=AdkZPFS8sZrh5rT0Fg15Ukm0imLrIa2bg_2NY_YeuLYoJZW1D7tQZR5MABzwz-uulJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4ZuJvIqxbOyK6An8xxLeK76XYGvDNFuUN_3LsxlRfQg&oe=699AF05A"}, "display_name": "Labyrinth deLux - A Crusoe Quest (Free Demo)", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest (Free Demo Version) you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest (Demo Version) is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT",
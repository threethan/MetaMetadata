{"file_name": "Screenshot_06.png", "id": "1820917035544526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825575_1820917038877859_3427058352426245828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Lc3nhVFzYQ7kNvwHIx3Cl&_nc_oc=Ado5zBT32dNAoyx2v9JIwaijVxF_OaTDvky1wTp0IvTWOX-FYzogVbJ0u5wkKVS4rVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQvyxgwNY9vtbRPhO3-s8BeZOeHux--HdNrf-vw3lgMw&oe=6AA004A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "2895244437526734", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_2895244444193400_55662069923444701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGDnHrJ7xJsQ7kNvwH1ORlU&_nc_oc=AdophMhb7rkBUn05ooaj-9ahTHzF33zqYi4ZKUpVdMQYON9oRtxx1sJMSqg2szElxeM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5RrooVPjjwKnRrLy96rz22m_7C6r7gd65bLsPIPcF3g&oe=6AA0148A"}, "display_name": "Mini Mechs", "keywords": [], "long_description": "Move your mech around a battlefield and battle other mechs, tanks, spiders and turrets, each with unique armory and behaviour.\n\nYou play from a third-person perspective, while your mech's arms mimic the movements of your controllers.\n\nSelect a camera view that best suits your comfort level:\n- aligned on mech's forward direction\n- aligned relative to mech's xy-position\n- aligned relative to mech's x-position", "short_description": "Move your mech around a battlefield and battle other mechs, tanks, spiders and turrets, each with unique armory and behaviour.\n\nYou play from a third-person perspective, while your mech's arms mimic the movements of your controllers."}, {"images": {"nodes": []}, "id": "1686153142489129", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini Mechs", "keywords": [], "long_description": "Du steuerst einen Mech \u00fcber ein Spielfeld mit dem Ziel die Gegner zu zerst\u00f6ren. Jeder der Gegner verf\u00fcgt \u00fcber andere F\u00e4higkeiten und Bewaffnung.\n\nDu spielst in einer Third-Person-Ansicht und steuerst deinen Mech mit den VR-Controllern.  Die Bewegungen  deiner Arme und H\u00e4nde werden von deinem Mech nachgeahmt.\n\nWeiterhin kanns du eine f\u00fcr dich angenehme Kameraf\u00fchrung w\u00e4hlen:\n- Am Rand des Spielfelds in x-Richtung folgend\n- Dem Mech in xy-Richtung folgend\n- Immer hinter dem Mech in die gleiche Richtung schauend", "short_description": "Du steuerst einen Mech \u00fcber ein Spielfeld mit dem Ziel die Gegner zu zerst\u00f6ren. Jeder der Gegner verf\u00fcgt \u00fcber andere F\u00e4higkeiten und Bewaffnung. \n\nDu spielst in einer Third-Person-Ansicht und steuerst deinen Mech mit den VR-Controllern.  Die Bewegungen  deiner Arme und H\u00e4nde werden von deinem Mech nachgeahmt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/minimechs/#policy", "developer_terms_of_service_url": null, "publisher_name": "Jatrix", "support_website_url": null, "website_url": "https://www.jatrix.de/minimechs", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3527416010756396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491829120_1649396696599812_5244082814975245156_n.png?stp=dst-p
=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN3yqKvFsd4Q7kNvwF4c9U6&_nc_oc=Adr_kV5eqgsITPdD7JQSNc1yhRs2ghBl-vjvnQDk-EUENjmhekRJ_VP0_PNpojs2iXE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_UJtiooH8cb5hTgKlM2ZN7KN0jc3NyqlXdYN9aHO-vA&oe=6AFF04C7"}, {"file_name": "1000025452.png", "id": "2027829567960154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620519_2027829571293487_463153492679184700_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nazHoliWu6AQ7kNvwFo1vz_&_nc_oc=AdpzL5jMmyQ6-BtBHw1zuDXwMsRfDiYcmkaERKpidb-N2Q6D90kGFFD_TmFiTabEBEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIwUFd3LSNV48l6Tv4uLSu_ABxcUJKVKPm-TjhEUSW5w&oe=6AFF300D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Onnocular", "keywords": [], "long_description": "Whether you\u2019re working out solo or alongside friends in a synchronized multiplayer session, Onnocular blends virtual energy with real-world movement to make fitness fun and immersive.\n\nEngage in dynamic Zumba routines with real-time avatar embodiment, seamless multiplayer synchronization, and interactive environments that respond to your movements. With intuitive tracking and responsive feedback, every session feels personalized and high-energy.\n\nStep into the future of group workouts and level up your fitness journey\u2014Onnocular keeps you motivated, connected, and ready to dance your way to wellness!", "short_description": "Get ready to move, dance, and sweat with Onnocular\u2014the ultimate mixed reality fitness experience that brings Zumba to life like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d94459f2-e40e-41f4-964f-1059050a96f5", "developer_terms_of_service_url": null, "publisher_name": "Onnocular", "support_website_url": null, "website_url": "https://sidequestvr.com/app/28993/onnocular", "category": null, "comfort_rating": "C
6&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERi6e7FQko4Q7kNvwFhAoz-&_nc_oc=Adk-ajyOOQ8Fi8183I5NCE2PoBOxDsCkoaDVOL9_cdyQrDe1lGyNcnk9WIJsTgfR98A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-dN4WjhEgdqlpHeQpTZNsVzpN-UdMLp8MhpQ4ASAv_Q&oe=69A43D4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Onnocular", "keywords": [], "long_description": "Whether you\u2019re working out solo or alongside friends in a synchronized multiplayer session, Onnocular blends virtual energy with real-world movement to make fitness fun and immersive.\n\nEngage in dynamic Zumba routines with real-time avatar embodiment, seamless multiplayer synchronization, and interactive environments that respond to your movements. With intuitive tracking and responsive feedback, every session feels personalized and high-energy.\n\nStep into the future of group workouts and level up your fitness journey\u2014Onnocular keeps you motivated, connected, and ready to dance your way to wellness!", "short_description": "Get ready to move, dance, and sweat with Onnocular\u2014the ultimate mixed reality fitness experience that brings Zumba to life like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/d94459f2-e40e-41f4-964f-1059050a96f5", "developer_terms_of_service_url": null, "publisher_name": "Onnocular", "support_website_url": null, "website_url": "https://sidequestvr.com/app/28993/onnocular", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRAC
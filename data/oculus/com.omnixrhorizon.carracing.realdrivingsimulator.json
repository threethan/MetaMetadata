words": ["CarRacing", "DrivingSimulator", "CarDriving3D", "RealCarGame", "RacingSimulator"], "long_description": "Experience the thrill of real driving and high-speed racing in Car Racing 3D : Real Driving Simulator. Get behind the wheel of powerful cars and enjoy realistic physics, smooth controls, and stunning 3D environments designed for the ultimate driving experience.\nWhether you love fast racing, free driving, or mastering your parking and control skills, this game offers exciting challenges and endless fun for car lovers.\nGame Features\nRealistic Driving Physics\nFeel the real car handling with smooth acceleration, braking, and steering designed for an authentic driving experience.\nStunning 3D Graphics\nEnjoy high-quality visuals, detailed cars, and immersive environments that bring the world of racing to life.\nMultiple Game Modes\nFree Drive Mode \u2013 Explore the city and highways freely\nRacing Mode \u2013 Compete and test your speed skills\nChallenge Mode \u2013 Complete missions and improve your driving\nWide Selection of Cars\nChoose from different vehicles and experience unique driving styles and performance.\nSmooth & Easy Controls\nSimple and responsive controls make the game fun for both beginners and experienced players.\nRealistic Sound Effects\nEngine sounds and driving effects that enhance the real racing feel.\n", "short_description": "Real car racing with 3D graphics and realistic driving experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/omnixrhorizon/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "OmniXR Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/omnixrhorizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183
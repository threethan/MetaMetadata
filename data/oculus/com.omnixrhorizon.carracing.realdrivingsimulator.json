2159228_348899075885841289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ1h69_3xDAQ7kNvwFInN91&_nc_oc=AdoyyLhBeQ8SH93JsK75sQcHBchmIlv1dwU1xo5GLppBaX4UYwSQyYaPGHulrGYf_kM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl-kd_mqzDRmGAobdU2RiXhfUjR0VS8cHJiHZY0bOcGA&oe=6AB13C7A"}, {"file_name": "4.png", "id": "894130173451376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_894130176784709_6726690834324617196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfi8NCufd4UQ7kNvwGuwmRg&_nc_oc=Adp5pFVW2EwNaxMpoZCZ97FSuyqE4EooQZNQJo1_riYHsPDhBHU3cqADOfxMSSfxkGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg87BqnPmkU3BiYBct6K9r6EHIxn5fPcJGMDuwoHE_aQ&oe=6AB15369"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing 3D : Real Driving Simulator", "keywords": ["CarRacing", "DrivingSimulator", "CarDriving3D", "RealCarGame", "RacingSimulator"], "long_description": "Experience the thrill of real driving and high-speed racing in Car Racing 3D : Real Driving Simulator. Get behind the wheel of powerful cars and enjoy realistic physics, smooth controls, and stunning 3D environments designed for the ultimate driving experience.\nWhether you love fast racing, free driving, or mastering your parking and control skills, this game offers exciting challenges and endless fun for car lovers.\nGame Features\nRealistic Driving Physics\nFeel the real car handling with smooth acceleration, braking, and steering designed for an authentic driving experience.\nStunning 3D Graphics\nEnjoy high-quality visuals, detailed cars, and immersive environments that bring the world of racing to life.\nMultiple Game Modes\nFree Drive Mode \u2013 Explore the city and highways freely\nRacing Mode \u2013 Compete and test your speed skills\nChallenge Mode \u2013 Complete missions and improve your driving\nWide Selection of Cars\nChoose from different vehicles and experience unique driving styles and performance.\nSmooth & Easy Controls\nSimple and responsive controls make the game fun for both beginners and experienced players.\nRealistic Sound Effects\nEngine sounds and driving effects that enhance the real racing feel.\n", "short_description": "Real car racing with 3D graphics and realistic driving experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/omnixrhorizon/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "OmniXR Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/omnixrhorizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34597563773190862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619145_791899390620782_1405486147515034279_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iw06YGgZR2sQ7kNvwHVCshC&_nc_oc=AdpNZJ7xded-ACPobG0t9fU4FCLvThOiSogIXasbtkIBTcfldgDVtyZdYfAhVOJABkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs9dbHUZQuznlt7TIKV0LzHy-CR4DdZu5nVgwAwOwUyw&oe=6AB137C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Car Racing 3D : Real Driving Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category
&_nc_sid=6e7a0a&_nc_ohc=0BcTJRAIMIYQ7kNvwEdbRn1&_nc_oc=AdrrJuWSheyMvroDZJtlf2FyRL9D4LevZpwywObkhZWtGvkYPYYuNR9ki9SF5yuB4Dw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVQawRmXhCVCazMZYS3QVbm3F6vgYbQ-Q_9BCCcFdfxw&oe=6AA93C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "inDeathUnchained_keyArt_2560x1440.png", "id": "317640752731499", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75240098_317640756064832_2748467767532483275_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2h1y_Wr5CYQ7kNvwEjJ3x2&_nc_oc=Adpe_H4S36y1v9zc5FtZNDyW_orsLxij2OXfEpkioRyTba3_PPUGhBM0h8RdNQ72jv0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBESknNu5M6-VTxgE03JoZJnbKqzmiymZknTqXUqPxTA&oe=6AA94278"}, "display_name": "In Death: Unchained", "keywords": ["roguelite", "roguelike", "bow", "fantasy", "medieval"], "long_description": "In Death: Unchained brings the rogue-lite experience screaming onto the Oculus Quest. Grab your longbow and rain down arrows against the forsaken souls, angelic creatures, and demons that have taken over the afterlife as you battle through the procedurally generated levels of Heaven, Purgatory, and Hell. \n\nFeatures:\n \n- Rogue-lite action in VR without the hassle of cables or confined play spaces\n\n- Accuracy and tactical positioning focused gameplay. Outsmart and outplay the enemy through clever positioning and being precise with your shots and defenses\n\n- Procedurally generated levels that adapt to the player\u2019s skill level and progress as they play\n\n- Full use of VR capabilities. Moving in real life, aiming, shooting, dodging incoming fire, using the environment for cover, etc\n\n- Multiple enemy types and distinct worlds\n\n- Progression through death as each run earns you special abilities or modifiers that carry over to the start of your next game", "short_description": "In Death: Unchained brings the rogue-lite experience screaming onto the Oculus Quest. Grab your longbow and rain down arrows against the forsaken souls, angelic creatures and demons that have taken over the afterlife as you battle through the procedurally generated levels of Heaven, Purgatory and Hell."}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "http://superbright.org/tos.html", "developer_terms_of_service_url": "http://superbright.org/tos.html", "publisher_name": "Superbright", "support_website_url": "http://superbright.org/", "website_url": "http://superbright.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "365608512059331"}}]}, "scheduled_offers": {"count": 47, "nodes": [{"status": "PUBLISHED", "id": "1117815417432187"}, {"status": "PUBLISHED", "id": "1037698659266475"}, {"status": "PUBLISHED", "id": "854263590291225"}, {"status": "PUBLISHED", "id": "1265326448488264"}, {"status": "PUBLISHED", "id": "1479276863696090"}, {"status": "PUBLISHED", "id": "1105370748194743"}, {"status": "PUBLISHED", "id": "1709069939789879"}, {"status": "PUBLISHED", "id": "1907848033111294"}, {"status": "PUBLISHED", "id": "1427549295081798"}, {"status": "PUBLISHED", "id": "626730443600261"}, {"status": "PUBLISHED", "id": "577220311522624"}, {"status": "PUBLISHED", "id": "589070088987309"}, {"status": "PUBLISHED", "id": "598403444546535"}, {"status": "PENDING", "id": "12474309625
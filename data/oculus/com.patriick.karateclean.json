r54skOmZMptl89QoHlPxks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKlhNWLTL47rXuO6UHAK4VseGOrnWCM1G1CeQDY6XKjw&oe=6AB52A9F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV05zFhttlYQ7kNvwHFI-8v&_nc_oc=AdpJ-pY5NIft_rpCmeF3fcA11EOpXKhJ3SoqLA3cO8qk4W4b8z1RApdyeQPppMz4MMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJclq6biZGy0v-FJdTktlSTj-Yx4nPG3p5uyGjnyQH5xg&oe=6AB536B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhOv-Yn63bsQ7kNvwEAyZa-&_nc_oc=AdrQHYL5XWe5gPEFwjiKYAp7SwICbHdcWl5-ju8amJxR863l_v3Z7fVQreHH07bW3nI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOfRsErs-9sAcmT3O9fNeqPbq_1nhwokHCpNtTRZT9Ig&oe=6AB549C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
K3etHB020wqm5TQmVrfG6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlGRMYINbZxN9Es3JA1LPAC45rAgpw3XShCc8spmhXeQ&oe=6AAFE49F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx8VJUDvyIgQ7kNvwGU5kmx&_nc_oc=AdpcQrbu_A7KKRl9KNcFUprr6B1WoUpB_oXuVU-QU_84acrYw1T8oGvQG19lnF0yaog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISkvHA5rULwyIfl2gbMpgq4rBveutEUVWwcxUzObkuEg&oe=6AAFF0B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz2Jj6MK4N4Q7kNvwFLrJMb&_nc_oc=AdrCdWMxwWISXtDH3QNmC4xqibiz3Vntox5ewUSMK1-T4ak6XGYfE5tAp1cIAguuxys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfLQfW9q5fMr8y7GcA4YaPxZ6KorLYi3gtqllFqhxOig&oe=6AB003C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
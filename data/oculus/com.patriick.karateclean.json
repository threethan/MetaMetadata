9Yxmf8WbDOMaP4rWqmEoaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tqnj_VJQzMxp3BJoYIHvV_GHFV81wriCR5Gc8US3k8g&oe=69D65D1F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H_wjOyL1bkQ7kNvwGCy7tY&_nc_oc=AdoUWIvb1bHiVgmKCxnf-IGw8dAlsbYexzO98iHAatnCma46mc17ABO1gN9cAxqTXsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZlJiX3TiWT6Wec_Mta8xFmJ2bmwSNPfCUVOBle1UVXA&oe=69D630F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsNqheE2h6EQ7kNvwG76EXl&_nc_oc=AdqGXJsIAXPV9R2WqiA95-L-VkdrLz6r4HsKmCRUU5gawJVFU3puvhaUlrZ9L0KOXyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tWAuwe_dAkeC0qQmoCT0zdIj7iKz3AV3zoUelhlAs2A&oe=69D64406"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
p-Qr9ajHPRzZF1IwPV4Mrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgnUxridNYi3BJ10NHW4_Aw1BETi3TABtQB-f8j_li-g&oe=6A95BEDF"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy9TIEFd86EQ7kNvwGuTCeY&_nc_oc=AdqlJRo8CxRPwWFGefJcuP0P2_p-JfRgC88pPmITEMVQSIKTPlXdzx1eJG00mNBepmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmECRJFDjxG_E2b_OyOMrfe3l8uo4LKMG6H9zwVyqh0g&oe=6A95CAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=er4JDSgnQ0gQ7kNvwG8DkHU&_nc_oc=AdqGmqXIIqIq8fHl2esxIEkbX5DHOw-qyRvHD3nV7O8pZWQWSBN2uxHfPPxWibLjI48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMQi4EIWfO952wIcGvetx2lBH4h8I-c0Kn_adWvvriyg&oe=6A95DE06"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
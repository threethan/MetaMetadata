qmgF-c8DwnvDF0PT0Mdd6M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXFK5EXrzJxSw1xqqQdDVQjjD5MR0kkcRyrTBllioniA&oe=6AC4FC9F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLmunXTzCZoQ7kNvwFo6Z90&_nc_oc=Adr37WdK_ntdWyW8ydECyjFBQMECNS1Z0a2g0VI2GDK5QIHcPnQerlJqLTYnM9CmyIM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv_tpHUylTZ8WRAlNkLYZbpw3MTB5D518-bzhZGwdoKQ&oe=6AC508B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxiRwLSFuksQ7kNvwHYsoLs&_nc_oc=AdowP7DEjPd8M0LRPqq8-QSDM2O-YDs6dWbS2VVTv_c5W3K-L2k08wUEqsNmG3ouSz8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNthrqGP8K1RNmYRW7Axam5yY81XxoDWOAFq2ZmnW4_zg&oe=6AC51BC6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
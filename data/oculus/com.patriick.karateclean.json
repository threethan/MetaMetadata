bg48gJuNgnGBDHq77HM7MQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ICkLJnTymgmDUm2LjNyIBOvCvw8emkO0nmCCdkkhlw&oe=6A8970DF"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7pCE6cAqWcQ7kNvwHOVC6P&_nc_oc=AdqO_Agw8dafnD78QObfNplT6MTO5AQRcbbm-rH6A2i8rPstRtmr9l8Bd1aKY1WmsxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5co4reb8jA-xHdBXDOvfvcR_Vs6eNsFr7Uxxy53JiQw&oe=6A897CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP9evqtXyX0Q7kNvwEhADKC&_nc_oc=Adpx_ohmRpUPFvw2D3_bl4bPnwY_uknICoQPleihG9gZSn_1APLqI9nSdTrTyip1YM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVXCkQmRaxN5_UyvDSUA-u_m04W13Jr-mza6FUVc6FBQ&oe=6A899006"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
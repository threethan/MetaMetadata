9618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6frChKxAyugQ7kNvwEKCCZt&_nc_oc=AdrlBc5STwerFx3ICx2Rl7u_3Feuj058SNbU0hSPJXmnQApx0DuSXSRQethmnpQlklU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRbSKVHtDk1Q-Vthr4guxeequhqfp71BywLM9rM_z87Q&oe=6A881F5F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06NlaA7dhO0Q7kNvwGYwP75&_nc_oc=AdrAv1pvIxlazQ7Uo3qaQW89r3MKk1xVFJc4vv9pMZsBQPxlF0v9D0hI1ck_20pJ3Bg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzlLU9bEiPuUSRDxybdlIxC1VQOVtUkeZfiMEwASSpfw&oe=6A882B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP9evqtXyX0Q7kNvwGbyLTH&_nc_oc=Adox2vC7_7k-6biW4WzhnRFJFK6OGVvbpCY57P2QYaT_TBJJU3Yttxg4DMmq1S6x0Yk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKR4-L_CgGLSRagZGkwml7eu7cbHTPBorNxGFcszpt6A&oe=6A883E86"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCle
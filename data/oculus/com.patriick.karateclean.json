xXbV5DQPwa7wHJOtkveUFw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y7j4s8zgifDRK2Lq8NounrGtYk-bMpK6foVHuOa8Z_w&oe=6A24259F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTvRH2rgx10Q7kNvwEGH6FV&_nc_oc=AdpflMiBrhJRmB3Rz8oyALX3WL1RnbWNgdv5gSzc5uJnc_nma44by3cgZp_0AQ9D8MI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86ZOIq64kpPLLP63KSQ0oL3STsNo4J5YdmJsCKNQsSfQ&oe=6A2431B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KvggKcwHloQ7kNvwGlcDkU&_nc_oc=AdqFmYrqX2pIEXi9LdMOwE_PgIcsMNNIXux6MVBSVDycJnWwmerD4zdnIQh_q-f5sYM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gwabJZb9kLW0tiswZmG48We0-3Tp-S1ibmovURvtPGA&oe=6A2444C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
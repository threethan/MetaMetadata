9618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THYWkWR3wsoQ7kNvwGCSc0U&_nc_oc=AdoBs_vHF3OtqUrbMOc0vsSPvofD7nr_YqdibJcPz3n8WiGjF_aI8s8RBMbX73GxzCs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kBtNccQVC8xYtEv7b_zCrOBrsYGpyRqv-wW2HiIPC8g&oe=69D7AE9F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CsInov1SxAQ7kNvwF0Fc4x&_nc_oc=Adp_XBNbrEGpRcZaXE-gsGulsObsGUNb6hVA5ViRAexxuM6ZT_K2LsrCxUL_aj3HdDg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3clPud7p6V5OKDuy374ePGliwd00cfqYiiiSNIFGM8xw&oe=69D7BAB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsNqheE2h6EQ7kNvwEbeXAZ&_nc_oc=AdrM9frKxTcaNl08iH2tqHlXQj7q3aAPdVBEFczMANq5XsHJDC-HC0zapJDpUDkX-oE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ut2XmUAdidRg08mDSOXeGIunCQ8vTwobfkMPJXcw4_w&oe=69D79586"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCle
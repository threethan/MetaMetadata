CNowibmgmjWXf_K6f3JIjc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeer8rF0zy6ON10SurEjgz_xmtvPgZ2Gm2bGwItkrctQ&oe=6AA1641F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsPZ-OPBD6sQ7kNvwGezpAZ&_nc_oc=AdolJxfmcXT0e5_E4aAqr8hMtRZPEIRblMKufw5JTPXtkuIQB1H4eazCmpHu1yczoD8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ34llVoB_JZhNd-5GfsdBySU-RkxwcFQL_4SLPGpz-w&oe=6AA17039"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_PxKpgFbm8Q7kNvwGKW0xJ&_nc_oc=AdoNZTv_ZkYp-yqZ1yxxuU2BDzSA2Ma0WLOIpcxJS4kz-FJbAZXpvbTuyypVlsFKkRA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxWg_8RUjJrqqnpYHIB4nPht2qZIKxm6ZWp5yfMtij7A&oe=6AA14B06"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
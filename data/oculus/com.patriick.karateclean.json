xnoGFtmWOKPauoFDPUxUfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kjeBV9ei5xvQYGPwk5hyrT3FaHdi3PRqaPm3cPezfVw&oe=69D50B9F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H_wjOyL1bkQ7kNvwGbrNbn&_nc_oc=AdpAm2xoJEVPH11fuHeTIUCmnfpxcdlHrONaEguz82hUYfuNOcVs7PnwN6pIT24wB74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YYaDqkty5CJxHN-Ru05ReYi3mmK6aaDMB9mM6TGEkTw&oe=69D517B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsNqheE2h6EQ7kNvwG_o6wz&_nc_oc=AdqNVNQHOK7g4PvmY1iraq_P66OkyHTNfe0AVMHwFXABbZ8MnUQABsSWxiivWiDyYhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ygIRgZMhh6zt61g8eXQTpxXW4g_tel1ZXqiroJTt0rg&oe=69D4F286"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
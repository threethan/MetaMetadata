uSeeR7fbFaPwZ4GTvddlng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-if_nN5IR92Phz2K7OQ-vtpwat7ZgC0YNBaLPfeKD8Q&oe=6A5E279F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p6dln_Dei4Q7kNvwG6B2xn&_nc_oc=Adrz50Zwvpy5nxtk4FkuhQoOdHC5IwPsHIBmkfPRebvQdkvIMp3-q7ENh6KOvijFVBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqxO54g5z71_ZK6ilXzZNc_OywaF3Zkf7WASNMViZC8w&oe=6A5E33B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B0CqyjeolcQ7kNvwH_delR&_nc_oc=AdpOALGA6GR1K6z5lKwxkMVU5WsZHRFIIP-f9_cqclbuWNhE6lWxsROXvXmY-h4jmmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQQpenqra3-EERr3WZ8PF0COwemOALfbHV_Xvg-Q0lKA&oe=6A5E0E86"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
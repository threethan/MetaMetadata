qtTHfKlG5wk35nmoc1t9VE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm7srivvYmIyy4WeWgObN-u4aZJ4PVd2BV1BiDLfK_WA&oe=6A81C01F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCwAAgev6WIQ7kNvwGcOvRp&_nc_oc=AdrfnLGz9oTRkK03V0DjE74xz3N8_7hEkx75S9vjZcH4Bb_pRR8U6wxG3eAEGhR6xH0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr_DaP71J5QdPZ7d5wR_UScIObqBOjGTg29I6c84O_Cg&oe=6A8193F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdziMOSk6eEQ7kNvwFru-rB&_nc_oc=AdrKrswBRoMss8uVbNdnE8ry5xrTdI9t8vS9_Eou324l0lgkwS4kpAiNKaMNpliq6Ik&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_AYinAP72TIZ6DyeyGvLcVgnpEemFk_rPXI8SOegKFA&oe=6A81A706"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
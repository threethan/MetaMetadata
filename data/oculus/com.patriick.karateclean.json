t-dfw6-2.oculuscdn.com/v/t64.5771-25/499618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATTnTY8peC4Q7kNvwG7nwA5&_nc_oc=AdphxXshWtHhfudN668QAvkrasdJr6WA-92N09TPHr8JWy1lzeQIbPcyqrezlAit0-g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqlyrHKcPDiwTddSJy1UTsaG9rPf0GRlhN-EDaEHDCuA&oe=6B08715F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj8vxOwryeEQ7kNvwGr7Ogl&_nc_oc=AdrXxIFi60D1tPAm6fOldfsjodqg3g1zPv_TMHBXvhCOkhgc1o6GbQ0jeP5_BkLZh7A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCPFN9E-D3zAKku4_oXxWPPODAKLsodyGE6KMbFovJ5w&oe=6B084539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OWC_O4_8fkQ7kNvwHzVJdb&_nc_oc=AdoU5QJyQdtrh7PKyWtoEK2uGPlOc-Gzh0odJLkEqwd9iLAGFHnaOLGLlZq86TD1Cko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaia_0H7_WtxWSZ574oDmEM6bQj8z8xdWgvLOSHi2Y4w&oe=6B085846"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "developer_name": "Ricky Robot", "developer_privacy_policy_url": "https://kc.rkybt.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ricky Robot", "support_website_url": null, "website_url": "https://kc.rkybt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26409824631943372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619680_1520105492656312_6656175596443083182_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzbTNS7Plp4Q7kNvwENM8Xv&_nc_oc=AdrUl8KxoipSTp1ZzDrEnM41KI2iUpxhi0qEykpVkSb2z6Pt6Az88zan-UXMGKcvXaY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtrszxT2FCL6APrXaRgSs2DUyf6apP3PhojRUk4HNjeg&oe=6B086DA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Karate Clean", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770837780, "last
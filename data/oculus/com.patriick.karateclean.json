NshzYEX-H4QTx3kxD7G3GQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsctVwE9lsSUp3I4SRX339pnDQWv48LE02OH1797qPXw&oe=6A9ACC9F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExfN8Rx2gmcQ7kNvwF_2IJ1&_nc_oc=AdpInD0yDVqYsiyiTpPbol-7aPmg3KuH2aljfJU3JZAR7-e8_jYfj70ZukBU37aFeqQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrSwzbfKTf2Zd9OajEf8Qfm7S2okTV5TtlnGMVMR3P2Q&oe=6A9AD8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5jq39Mk4RIQ7kNvwFc3b3p&_nc_oc=AdqafyG6A_HwhR4EEWmFUU0SOprTShO-Rn_rDbzZvEfr6pKK-WYZcLqT2uBtWGgDod4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC3WUSGY1MxmC9B3LqhOumq6eaasWF6_8gcy0-3Xp-TA&oe=6A9AEBC6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
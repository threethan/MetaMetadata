t-sea5-2.oculuscdn.com/v/t64.5771-25/499618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATTnTY8peC4Q7kNvwGcZYy6&_nc_oc=AdoxzBctldH6DVG8sKnTWe_orhPeCN56ZFbRLjyZ1B7nrd7j1SI5FnOSMrUjs1LIXBs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgB1q8T8GAYi2LWUCiEaXqPS0qgy4-IOpjAktQFZCJOA&oe=6B09C2DF"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj8vxOwryeEQ7kNvwFVdeb3&_nc_oc=Adrq-klV-b5O28UIbYfvE-WP13wEs-k8OQavMtu0CQi6Sa3uZ3o8kL7v1-QaEKRtbsg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWfxJ1hj8hWlrNyiTqe5i1spjndKK3CJ5OzX1Awn7AcA&oe=6B09CEF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJUPuvmoz5cQ7kNvwEJfl3T&_nc_oc=AdqQaEA52XWHoDZJZzcY9ZUHziqtG7RmwTSjUaz35BbQ9k6N9KECzfZrKAK4m2tCAeE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgn1mETbUw_6uay5AxLGY8AUUunSnjOGdBqAqa60WlDw&oe=6B09A9C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "developer_name": "Ricky Robot", "developer_privacy_policy_url": "https://kc.rkybt.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ricky Robot", "support_website_url": null, "website_url": "https://kc.rkybt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26409824631943372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_1520105492656312_6656175596443083182_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzbTNS7Plp4Q7kNvwGgg72g&_nc_oc=AdrC27YdL9xM-dTaTeUaq-ZIT5i6woS2UR8dKIP9iv5S5ezBw29J6MKc-KHwFSraTVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRgT3tg_7YG63FZMTDxQuDnGF04XsSiz1gWdmyR-Pgdw&oe=6B09BF29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Karate Clean", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770837780, "last
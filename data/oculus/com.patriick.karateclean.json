y_8ggH0wP9TuGA3ZN19fOM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBigqG6JUZhKfz_cbYnukciaj3wYLLOElDNxrlRN-NERA&oe=6A66109F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA-1dWnpmgMQ7kNvwEiGOYe&_nc_oc=AdocEt1W7BGdHl8zs-hwtkFX4zJBGnxXvfcxlgRUT0E8-plUkLUF1uw9wdTOGepAAxQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWoV4nyZf3XsZJyNj6S0gUmDtAv_6fN9WFfBf2MBOSzg&oe=6A661CB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgowP0nRbZgQ7kNvwFKlJWy&_nc_oc=AdrSMN5Gw60puAyqud7UHv742RqPRTZjG-2mS6mpbSZykxJNV5W8Ch5D75GGSaGOxDg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk9iorSEk_x3t-6FEHSuGRClG7cMhEhGhhlj564x1jBg&oe=6A65F786"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
9Av3ZBeWGxSSFvTWaSnh1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpknEJXatPhP_-z-i5Bx8ys-JzUBcw2wdjlFiFd1JmoA&oe=69D1171F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9W2sffQZ1IQ7kNvwGqj-Ug&_nc_oc=AdrFbonGOVtHqOSMVSu3EI_bm3ziIxDmIJdi8Y2gNGme77k_7reon6dgc_Dg2JY03h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDaT8T3RVL4uSPm0VTwF_BCWbOTcmzPjvKdnHZgYJsxA&oe=69D12339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr2EZ6yGsgkQ7kNvwH6Mk0g&_nc_oc=AdqG5vtzxa4IZsXXI_uhU5TzsBUtLA5NAGzNumMbbMI8FnJJGZADG2656Px1iV1rZi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyqyCnH_69MPzu-M8DV2_gAShwHbUifqiKvGUYfDJG2g&oe=69D0FE06"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
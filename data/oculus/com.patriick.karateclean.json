VvD52YBUFr3-QpQDoKzyis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04h8INh9_JwWdF-l_8TyfFruGm_8F1XfRMqiZVUWfdww&oe=69D9001F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CsInov1SxAQ7kNvwGu-lvC&_nc_oc=Adokk9DwgHSDmHeYMZEVmu4WnmqfaKrJE-n5T5K--eLd0kYR3bdMUrFld85Nw-Md8yw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WUwq-sw_wA6B7LgGZ4WZpxgX8oNdxvSAmKHSwrfinlw&oe=69D90C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p8Ea_luszIQ7kNvwF5Sz2s&_nc_oc=Ado_7WEr8JUE53Hzh_7-jdRYV6LgRPeb2nXcsbGT44BOj3I7VVx4HETKjvr69I-u8cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-ZbeIpInMBu-SWSop1Vl3stDss27V18XEd0lxqeu0Ug&oe=69D8E706"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
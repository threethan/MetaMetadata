9618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbVTajUIQ4wQ7kNvwHjQ1Pt&_nc_oc=Adoz9bM-1uSwb3t-vFAV0wL1rzycBA3nC-Hh6J-gzfefg18850OzYKwTBJEmg5NWByw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbGOMC5_YvhExI0xnfBLMhpRU3qHjZXFemdIHsipwKrg&oe=6A92E39F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D031BSQTFS4Q7kNvwHAmH0M&_nc_oc=AdoLeE20q418y8lvjUROVdYvy1K9slf83OYYVezyt9O942zbFII3kpY3_N3hAtEiIQ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENjmYAa1KAsUlSC1fNwZVLS--WRo3jaIKSAmX5SvJBdQ&oe=6A92B779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=er4JDSgnQ0gQ7kNvwEklIwo&_nc_oc=Adq4EECA6-utXo6SlgXxKnp0IblNynsJN8EpkXu6NqXe4mYhgTBZS8eUCmdEu4Gbnyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFpDcQs7CEzUgCP0U11uE9-axJZY0lUBGFyVjqh_Kz2g&oe=6A92CA86"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCle
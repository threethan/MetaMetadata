9618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkHD4puOhhQQ7kNvwF9yesk&_nc_oc=Adpie5UUJv-9zE5wkpTYCYRwtcbUy7DexVF6hMX8vEZQEUm0hh-x7HJB0n0-U1seNAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIKxNJr4pqdWquZeMPQX00uAu8Lv0OPKnmFZPUU8YB6w&oe=69CD229F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXOgFCxN8b8Q7kNvwHuY244&_nc_oc=AdoIKevWBB6lFGJJHEV4ayzWYhNU9pGAgWRO48aNqPJRMDCHQ6EUx663kEvEqx5HwVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM3xCu-iE6hf-cMoEMD-hu-nV8DUqcwHc_FsOHKAFL-A&oe=69CD2EB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXssk99jip4Q7kNvwEIdk-J&_nc_oc=AdqsYJ0dPVYY5ByufhGHzz0h4mkpHbYgtkisnsvHChrnkx58Pi5dYABK2vSssZ1QwBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3KxbzK0nY4lbBYoSNbXse_lUr5R_X5ay-3P6rTrHRng&oe=69CD0986"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCle
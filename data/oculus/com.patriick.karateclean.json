w8BmVUw0bn8cThxSIY0HpalfBVBbjENNw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1l-0lZtOBTPIvTc-5eGsBvN57sWpEXPl5V04PrwqOHw&oe=6A8D655F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi8DAl7DV6sQ7kNvwFbJfuB&_nc_oc=Adp1dqKz66UToK8JvHHKS-xFJROl4fj0iuhnnN5KMdEelmVX7gb8d4Rzgy5inwVVL6A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8gYUIcpvWlrZ0-KMtVqIOt8U2jdV3iDeqZPfpp8nzGw&oe=6A8D7179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HuYpLoH9NAQ7kNvwHiTO13&_nc_oc=AdoGqiCWL4OeBeeELEP9mtgbQ3yR1N6VZowcnMMe-SNqakjv05ssha-P0qFeCWO56XA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYv1qABxYByPQduRNUZNYb4cxNNkvJunw9-KWLMCq3nA&oe=6A8D8486"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "developer_name": "Ricky Robot", "developer_privacy_policy_url": "https://kc.rkybt.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ricky Robot", "support_website_url": null, "website_url": "https://kc.rkybt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26409824631943372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619680_1520105492656312_6656175596443083182_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__hCJSTMkTcQ7kNvwFZ_XiC&_nc_oc=Adqi_tFOW2GMCEosh7ewY40BuOy35thBN0NZU_9Rxbnp-wot5yToxqDPDrPlcF8T9R4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfmj7Y9GPoZsklJ8oy3RiDUmbUFdcTYHKHUaomB88n2g&oe=6A8D99E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Karate Clean", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770837780, "lastRevision": {"nodes": [{"id": "25922367910689049", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25922367817355725", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDRO
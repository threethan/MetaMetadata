sXDT52MS1HR_NBn7IheRKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jyWbXFtkziEONOkK9UNHsDEEH9hicZkn51y2hYt58uA&oe=6A47BE1F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot7nOZc1mFIQ7kNvwGOJ3Lm&_nc_oc=AdoogNqjpxASzCgxd_VQmRZSADEHQpO6Qqj6ZP2MzBNMTqirnad0Hu3JEJkzUZhrAF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pX-UwGY0DNRH3Wzg2jzcnGDOm0J_W2ebgKYP85tDVJw&oe=6A47CA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfI3Mi47-HoQ7kNvwFU5GJx&_nc_oc=AdqmgW0Hzf8yCQIKB4PlOjLHi6ObDQ6SB_5wvvWUnuDoWjn9kIXjB-lUB1ArXC1g3wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b3afy7V3aW_ClHtw9xiHIjHOENVnQa1-ED-4tCcWleg&oe=6A47DD46"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
n6yXFS5syze3WZN6I_FdoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdUvcC-Ohfbyi-WVnWCKeQ5oftQJ4H2s0vP0gG5L_JEQ&oe=6A8C13DF"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7pCE6cAqWcQ7kNvwF6x8mt&_nc_oc=AdrDWVWd66sX6exCOndp90l1ebNL2vP_CAsvNDHySZIOZpfzqroAYfh_qNqYrJsLtjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMQJhZLmfam12gu0K26RclEFis3p2Vo88bC_07qlvGVA&oe=6A8C1FF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HuYpLoH9NAQ7kNvwGdl0JY&_nc_oc=AdpBwYnSLw7Twpfk0L2Lzi9bvXFuFz-893FqTeARAIeS-DtbCVW0XDcqKBY4DKeRLtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlpHmDyXE_FJA4xXgmnzMYsIWYsV4aav4-ioUGBssV1A&oe=6A8C3306"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
rRuRHYvRbAM7wgwNF5SNTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O6g4LiMObtESIli7cWU8ZYj_5eBK2L-jgt0F5t5nIDg&oe=6A43C99F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YU25WFY3DrkQ7kNvwH3B5cG&_nc_oc=AdqoCfsHS4MMdsTluEHSQ1CC9kjl_bZqa3JNHZik3OmvpVKhkqJwvnkB_rxB4dnzTDE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QhCsdQxa6T53ohHt7_LlLFiWyGP9Un5lh4-HddVEJaQ&oe=6A43D5B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqMeHL6QTGEQ7kNvwHqAuSI&_nc_oc=AdofHeY4XnjlkH8YDCD7rlWIXkUSwpYwruwJFZnFVVjo9S27Vkd1KNnjbu3jQjvf6NY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kS-SfBOZhbYYcecpW8FR25YO5lugKooC7P1vYkWagwQ&oe=6A43E8C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
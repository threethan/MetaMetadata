m6FID0woKOaEdtFkoTe3Wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9e9WyiPapB57skr20-IaUHPlZYwAH_tBw_YdmgJ88ZQ&oe=6ACF889F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXJkZ8cGWvIQ7kNvwHo8v5G&_nc_oc=AdqQWI0eTR9bSdts21e4NbUoBvdyYZqc2m40_jnK4A9e9qSdlaJ3ArqUs5fhsRTlH4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJEzv-Bf7StCE8J8AP6njaWAtzcLfG16r6qrwXPGedhw&oe=6ACF94B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKyevOJl7oQQ7kNvwFNmPGA&_nc_oc=AdrdtKQsXNCi9bLFtEgXN1GswXwoGEsDT2oTyg8v2UuARJRMd0oCVw3JFw862TjuXi4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8myzmhpD6C00R-gueGGpJvNATB7dfyXQ1SenfSIDMcQ&oe=6ACFA7C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
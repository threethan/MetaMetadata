t-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_951677170761360_5506684720352019659_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQmAC4fWVwkQ7kNvwHFQnt-&_nc_oc=AdoGziQqVsJbHHJC6-3_5BRdk_90uPoY21UJw_D0Bgeix5CSlaCd9_g_iROVCr75u9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP0vpeV_IFcTLUT5Gm7duGFQ4hGneHsL1_JKOa5jKvjQ&oe=6B071FDF"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAmir8aBA04Q7kNvwEAukVf&_nc_oc=AdrMRgfZtHC2gi_o5YLWMGvEXJXOqLTCE7IsSw_XLZVpk19Z3iuQYiKAd89pQbCBJAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2jTbKjAtqzd4g2yvxohm-GPLb8MHvI0uwNHU9SnoPnw&oe=6B06F3B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OWC_O4_8fkQ7kNvwGLaxWD&_nc_oc=AdppW_zlhHzMBC9DCRCR4jxoy6z5da9VnX51MaSpQNWio9R_h54-ZRmNVgIE7rCAQsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtvjGYz1F-HF7e9WVU2Hm8aTzFOYB17bdQftjvdj_jkA&oe=6B0706C6"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "developer_name": "Ricky Robot", "developer_privacy_policy_url": "https://kc.rkybt.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ricky Robot", "support_website_url": null, "website_url": "https://kc.rkybt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26409824631943372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1520105492656312_6656175596443083182_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuYhVJa9X30Q7kNvwH8n8KC&_nc_oc=AdpScwH7wuFmiGc8oJEiKoKrq-wCyUUJy0E0UMD8R0Hc1INUPI0TceelaXwzTtY9Cj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVzMnw-VUPLOZSSRn2i1b09_q5rm5Qcz802OrjIQkSWg&oe=6B071C29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Karate Clean", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770837780, "last
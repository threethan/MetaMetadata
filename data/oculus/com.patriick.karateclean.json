FJADpX05fupUMwTHxV13po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH70I2sRomMCtRs7kf2KsXLCBC0GRORJxoGpI9lggv3jQ&oe=6A84631F"}, {"file_name": "saniwait.png", "id": "851370534611184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_851370537944517_7731506010071464934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCwAAgev6WIQ7kNvwEMkUU3&_nc_oc=Adql0FMx0AkwuGC5xzZiMIh2ySiCqNVS3tU1_61BpOG9cfUpIwYZ_lK91DXKmZHvrgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOwe2cOb-gzEED8fiNHuuzF7vBuPXqyMQdtp56ysCNcA&oe=6A8436F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "725036987336012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_725036990669345_2178777661868222990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGX3GYHVgVMQ7kNvwH1xFmR&_nc_oc=AdpkfdcaQaoTnwI4jWmgg6grJs7HGxN9zrGpYcFt9N6YRAhsDDIIyEhDVhGU57GxuLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUYLy0dbewWUmFeabsW1ssyHtyNl1s1p4s71vOKhpjoQ&oe=6A844A06"}, "display_name": "Karate Clean", "keywords": ["Cleaning", "Clean", "Chores", "Tools", "Productivity"], "long_description": "Have fun while cleaning your home. Collect virtual coins while you wipe down dust, wash off dirt, or sanitize your surfaces. This app will help you stay focused so you can confidently clean every spot and make your home healthy and beautiful!\n\nThis is a great way to give yourself a boost to keep things tidy. Make Karate Clean part of your weekly routine while you're cooling down or warming up from an intense gaming session\n\nOh and a bonus? If you have a 3d printer, you can track your vacuum with a removable open-source attachment. Paint mode and Arcade mode can turn a boring chore into a fun game with real life benefits\n\nCleaning has never been more satisfying... with mixed reality! Transform your home into a Dojo with Karate Clean!", "short_description": "the best way to clean"}]}, "develo
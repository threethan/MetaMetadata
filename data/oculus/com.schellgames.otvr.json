nd. Come face the terrible and weird Synapsion Brain Beast. Cower before the pedantic might of Baxxtar the Instructor. Submit to the overwhelming cuteness of the three eyed Warp Weasel. Become incredibly famous incredible or incredibly dead!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.schellgames.com/games/orion-trail-vr", "developer_terms_of_service_url": "https://www.schellgames.com/games/orion-trail-vr", "publisher_name": "Schell Games", "support_website_url": null, "website_url": "https://www.schellgames.com/games/orion-trail-vr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "461748238948029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139059_818749501562808_1460253439_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5yHqlDzNbwQ7kNvwHXf8Yo&_nc_oc=AdqYdAjPUFDsqzo4tofeIbShvOQpRLiNOrLEJTsGoBxeKO2KPPjC8VfFw-xWzQR6LAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmXSzAGTA4fyC2wKRdnzUfUX7xhlUx3_osaRt9VbUARQ&oe=6B09B451"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Orion Trail VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450944000, "lastRevision": {"nodes": [{"id": "154626758227896", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application":
1.oculuscdn.com/v/t64.5771-25/39031517_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBhpDan7hlcQ7kNvwFImZbO&_nc_oc=Ado5nd_uEmof-iz7Ad7nRQ8r5N29EAF8E5FvtDQ6QQHvP4vbR0PyfDv2RJypahkHW1I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66dBHVnVUFPbWdWaBEX9LQEdqF7Qaf7GeOIUcV2nHE7g&oe=69FDE028"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJOJO5qmGf0Q7kNvwGwAda8&_nc_oc=AdpMvY1wOc1dM-Hc15HiUmC6S7VJ7M5vv5jSq2dgJuqPhsIVSYYHEOP9euQSfOk0UXI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SbpnT48QhXgAsQdBcjwr78wqejQtmZqI8wwxU0Q4aEg&oe=69FDF55A"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqj1cCGAbiYQ7kNvwGEz6ll&_nc_oc=AdpOzeec5nWewh8m_51-VKmVWo1klkchf-f8arT9OGOllZHFTNba5GllYQyZVIYVxpo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I8vf975ZZ9nvqM9Gh0JIv9ksg2_CwWReuYOxFIvwVQQ&oe=69FE0198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYx1zu2CXpkQ7kNvwGuqUvN&_nc_oc=AdpeFYcdvLcXm30Yxrc3bkDHoDvQdHFEcVn6Cl9iv4mjc9y6HoHzrbVfmzv6tqKmP7c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u0j1lFSig-uj5I1dcyvFWZT-Z0vOBEmOpqrjeXkX8mg&oe=69FDDB7B"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_37w2baEGWcQ7kNvwEWRw1h&_nc_oc=Adqz
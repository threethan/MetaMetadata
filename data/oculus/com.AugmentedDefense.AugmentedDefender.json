1.oculuscdn.com/v/t64.5771-25/39031517_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ppz5Q5CM8V0Q7kNvwE57BzM&_nc_oc=AdrGFhEnNZ8IieOu5bIE3sVo8-BNzjEy_o4JGGBbbyv-e5Mf0QFMhiDg1gFzyraAMpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vGEo0ctzxn2glAbiiVdxX77oC84wyX3PnRHdHKw8RpA&oe=6A314AA8"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYSfs_JLJQMQ7kNvwHGDA9L&_nc_oc=AdqqeyQqA9VQogICQNa1FPGSwiCxMhw2r7CSzpNzJ3Vdpn4yUKRpt2QbBIECrZprG1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q8UXuB4AkFv61ltZd91L4Byof8Z2gS4df3TyxRHWE0w&oe=6A315FDA"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kafuXnBf7K8Q7kNvwF3d1r0&_nc_oc=AdqOUSjllCrHNkqehsUHghwYqjHwsLa4qdYEEIwgyph9B0ndLvTuOM2dSGUlZ-d-IaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RHeT0MUXp5VagWx8_96uS78DjC3NGb0L1OGNIfCKMRA&oe=6A316C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pnxgcr_5XAQ7kNvwGQhQX4&_nc_oc=AdqSNZ3nvTNDdtmk_anydCasWfUs0bxG4LkjCwdEx2IksEFZSeRwZihE5XMY3kOnR6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SQge7MZxLoNTVBFseh5Bhq4VfQ8OTY-mSWheX_h6bsA&oe=6A3145FB"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kowKaLDLRrEQ7kNvwGDKas5&_nc_oc=AdrR
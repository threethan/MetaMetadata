17_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_HYa1KCALEQ7kNvwGJ-rK2&_nc_oc=AdkoNP_v-m5VsK2vkE1vWK4-cUwvZ_DpNEfHuX8OWfLAmGDHaVFxhhsoaLKqiTAUC8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGfo0v5W0Z-1BZQnQBGL2G17WbNxMdgnmL2Jkj9dmxXg&oe=69B6AF28"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up8EYZRsmtoQ7kNvwGOtag-&_nc_oc=AdnQ1s77fJJNuFl5KvKQJCbudvhUSSwQ-8my7Zh9_oGt1XWtKvhd3qs7IOl-PZY_Db8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6uvRAl9rzb8O2y7KQ8MsrKK94pdRdQufXwfl9mAVYvg&oe=69B68C1A"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vji4yfESsQQ7kNvwFdpQhd&_nc_oc=Adki2sXRygxQbC6uDujxZc3Fj0MEMZunPuMwFTZcDT_qnw_sDiTmQk-MWDIMaFFNWhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUNd_ngGSb2rgHqLvp745033-m4gVLbjFpzOuSCluHAA&oe=69B69858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Lhe5JkRB0Q7kNvwGq5Jug&_nc_oc=AdktKtKveHdifSGRoTzplLqQxPm1J1_Mw10cE77UdCIovLuvRd0FRg3xqKvc0SvScgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu-8Ws1NSMFUEHgwqa--T62JX3medH4239BVx35lEF9A&oe=69B6AA7B"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui_VnOtGHqEQ7kNvwFE5aDy&_nc_oc=AdmKKmow3LB0i5NPf9b8p1hLQfr3N0nJNszoPQIPmRt7Rcv4ofCTYsFn
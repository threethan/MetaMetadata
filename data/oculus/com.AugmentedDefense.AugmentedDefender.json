1.oculuscdn.com/v/t64.5771-25/39031517_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTeCq85_TUsQ7kNvwEpLUOt&_nc_oc=AdrEuKl7CphP0AENexxTl_Ch13O-ksZ-gaMsPm5pWOrs5sDGy-zXwDYDe9HWaipQDqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MmrbfsRG0-VKa_B7RLQRRTZ402mzkrbBczZ7UMfg_Dg&oe=69F89A28"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3-QOviND3EQ7kNvwGQy5DX&_nc_oc=AdqQADfTgcEzaECqn4b9aDnG3g5DktA5QiEUVICwvjebliaA_zV4jFFU6qIMnEqbrO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3r4uqQnl4vImkTSR-kx7jxHt4e4sSTnQ7V6VCoUckbGQ&oe=69F8AF5A"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvhvdQyxxiQQ7kNvwF19xat&_nc_oc=AdqDlM6eJDbYyzkY0I9Ub11fmgonaxQQpNGcRdYuC3NTLKsiaKcuTn60Z1UEZzlLHHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aEB7FIXqpAql6Vsdj1_q8OjlWVHyu9nYRXqP2l178cw&oe=69F8BB98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCOBKoyuJ4sQ7kNvwER3r5z&_nc_oc=AdolBzhVAQ8gTHQ7Mm8w0tOJZumLcWYaTA1AIE0VLrKVlPNU1GWdjzAclOp-OpYvaZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tofjHbawyYw04DmurJ4hXcyr1AcT7pGNDaUwyy64rWQ&oe=69F8957B"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLpitmAZbGgQ7kNvwFzz9uk&_nc_oc=AdqV
1.oculuscdn.com/v/t64.5771-25/39031517_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5FS_14AguMQ7kNvwHmSkoi&_nc_oc=AdoSKG7vIXiogLznJtOCtO6_TFHy_79l8jN3Ao7Ai2ZoMMe0KkU7U2maIdewTwt-Rbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAByCyrtBzDfVu_gj5lIcRH_o5HnhJ_5uQzQllPOnOh6A&oe=6A4E4BA8"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd-K_kbWG2sQ7kNvwHsKkAf&_nc_oc=AdqK05Ls6r2MtHrDur0gIAuXjeafoD9rT-9BBgWDdwtRKP5Marql0QxDdlkxgPSaiXI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAdp6C7DS-Lf1ERj-eqQ7QALo52lx94WL-kRvf7s2FAg&oe=6A4E60DA"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6YscfoITmAQ7kNvwF3Mnxw&_nc_oc=Ado0FBbsluM23gDdNt7VIOptB3RdTJK4f1kZDHiBbPQm6FG4VZV06mb8MFykt-5HZ2o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHvhTVdF82v6ML6TLupuADeJvoEBSK-lmSl7yk4HYOmQ&oe=6A4E6D18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE2KLfEjKxwQ7kNvwFXU1wr&_nc_oc=Adpdy2AN6LD13S4Ak63z5iensZZ1K1s6nxQ3TQouYeKvYRm83GyQdISwFJfw1dwzKf8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgMp3nlpznjZ194na9TGaXDdAB-V0Pd4fh1Lk2sS1OWQ&oe=6A4E46FB"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_8YVDO0XgoQ7kNvwHmN9Oj&_nc_oc=AdpT
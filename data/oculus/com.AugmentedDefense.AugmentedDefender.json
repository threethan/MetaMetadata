2.oculuscdn.com/v/t64.5771-25/39031517_1345274202815977_5325859926193534740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grmEJnTIGk8Q7kNvwEKtIpS&_nc_oc=AdowLTQrEpDbgcz89uTc2JKEwkt2Yx8oQb8gassPdxBgc8TrhdUSrfAN-6aO9ymb9Fw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKCVP3qdPuFBXbsmk53hWXQsGkNlWtN8ys7VNIfDtnGQ&oe=69C7D2A8"}, {"file_name": "screenshot-4.png", "id": "946559893549912", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982614_946559896883245_3044152554930032544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKNEZBVIWm4Q7kNvwGWvL9r&_nc_oc=AdrdG2w3qtnRrivMU5517_NNfXd39siM_fDBWXW4BB5ifuD76so_HpdQNz1v6RGkljE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi7rSLRp7IbcUw2shXE0UrvWAiQoUSfO4cZK56wZX-pg&oe=69C7E7DA"}, {"file_name": "screenshot-5.png", "id": "1500603414002810", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031602_1500603417336143_7900130055392580307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqAEkWkoucwQ7kNvwHxPR32&_nc_oc=AdoFYd9Eic7xJsr6HBstSuuKOaQUygwW6U7FyYthZ5K9YzfN9pTa-h9Mr7S296Yiimk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNwYCoXHpYaiplBjWLgm75A-OXLNyRiFSXZzOqtNx5lA&oe=69C7BBD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage.PNG", "id": "1660353114371441", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982695_1660353117704774_5041858368859999884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYSP16FdiTgQ7kNvwEbRkbA&_nc_oc=Adr2LMYkuJSV5Jm7TQupbP5-GBJ2OE2hZrSJBUgFHo04bTLqKHJ43YY44tkWlnLNyNg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhV_xiegnmRQrQFM8cxnPrbOAe8mWUF_lR0WhZyfxVCA&oe=69C7CDFB"}, "display_name": "Augmented Defender", "keywords": ["Action", "Shooting", "Simulation", "zombie", "survival"], "long_description": "Looking for reality based trigger time, that incorporates your home in the experience? We create hardware and software to ground the experience even more in the real world, for the most immersive XR weapon handling experience out there. Once you have the basics down, add stress to the experience by trying to hold off a zombie hoard, trying to invade your home.\n\nCustom Stocks (All) - Full customization\nRecommended: XR Pistol, XR-15, Ace Pistol Handset \n\nHaptic Integration supported:\nProtube, Bhaptics\n\nMultiplayer is currently in closed Alpha Testing, Drop by the Discord if interested in joining: https://discord.com/invite/GgQy6qugZU", "short_description": "Ready for the end of the world? Lets find out. Target practice and guided drills provide trigger time to help you prepare for waves of hostiles coming to invade your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmenteddefense.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Augmented Defense", "support_website_url": "https://www.reddit.com/r/AugmentedDefense/", "website_url": "https://augmenteddefense.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7688003697967557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75322602_2151973455167553_3505496280884842972_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIUZgZ53bOsQ7kNvwHzZiIH&_nc_oc=Ado0
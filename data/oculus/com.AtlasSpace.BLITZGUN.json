5/491821674_2033060437303504_3384610096838983817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--M7V0VSMPMQ7kNvwGqmqK-&_nc_oc=Adp8GPwKrTNsT5OXirRy7YmFsqhxGFrc7_SSzp-qa7ROFhE_Gjy8p5Q8B116uGCuTPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBXIajmkgqkjTdsEavnkjGRuQ764BvV2mUoUgnfG81Fw&oe=6AFC8E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_22_2560x1440.png", "id": "1722742758761048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1722742762094381_620013322805513597_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYdCO7I6PnYQ7kNvwH18rVh&_nc_oc=AdqJ5b3lxQcdVJQAenLMG6aJB9driOWoiilwbkWnEzsAXwZ94qsbgihFyrngOS_vrcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlsDk2Qt-rQW3aY-N18MpNW4h-Eez1X70IagMWGlIzHQ&oe=6AFC8A69"}, "display_name": "BlitzGun", "keywords": ["Passthrough", "Leaderboard", "MixedReality", "Shooter", "Arcade"], "long_description": "Your walls aren't as solid as you think. \n\nA dimensional invasion has begun \u2014 and the entry point is your own walls. BlitzGun uses Meta Quest 3 Mixed Reality technology to tear through your walls and flood your living room with enemies from chaotic parallel universes. In this room-scale arcade wave shooter, you have one mission: survive. \n\n{1627884154994955}\n\n\ud83d\udd2b 9 Weapons. One Race. Every kill brings you one step closer to the next weapon. Enemies get faster and more relentless with every level. Unlock all 9 weapons, push your score to the limit \u2014 in this weapon upgrade race, the highest score wins. \n\n{1611415866608649}\n\n\ud83c\udfaf Every Shot Counts Each weapon has a limited magazine. Hit an enemy and it drains. Kill an enemy and it reloads. Fail to finish them off and your ammo runs dry \u2014 game over. Be fast. Be precise. \n\n\ud83c\udf0c Two Worlds. Two Strategies. Two different universes are waiting behind your walls: \n\nArtlantis \u2014 A stylized, chaotic underwater world. Short corridors, instant action, relentless pressure. \n\nPinkverse \u2014 A pastel plastic universe. Long corridors give you a clear line of sight \u2014 but no time to think. \n\n{797860203183115}\n\n\ud83d\udee0\ufe0f Technical Features\n\nReal wall destruction \u2014 damage that adapts to your room's geometry \n\nHaptic feedback \u2014 every bullet, every broken wall, every kill in the palm of your hands \n\n72Hz+ Passthrough performance with a high-energy soundtrack \n\n{1553438543192603}\n\n\ud83c\udfc6 Global Leaderboard Unlock all 9 weapons. Push your score to the top. Make your mark. \n\nOptimized for the full Mixed Reality experience.", "short_description": "Destroy the walls. Hunt the enemies. Evolve your weapon. Every kill brings you one step closer to the next \u2014 9 Guns, enemies that never stop accelerating, chaos bleeding through your own walls. Unlock them all. Claim the top of the leaderboard. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vReBWQVEyj9RtpUkkjyGNZ0FU-5LYysihlB-QPcR2XtFpfcjlc08PbqJbQcGtFdjTEGrzbImZS_Mun5/pub", "developer_terms_of_service_url": null, "publisher_name": "Garage Atlas", "support_website_url": null, "website_url": "https://www.garageatlas.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
oXUQ7cO1VLzD5jXvkPzjDZQgn2gQOQ8Z-IGEfMLFZ4K5ilLDMeZ08Xt0338&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SqfZsRtbYwYItHE6MWze5zATjenxS3wsAJYSHnDQRKw&oe=69F20A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Cover.png", "id": "757799479237248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974779_757799482570581_671029364813839155_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aouG46aDM4Q7kNvwGPFJWE&_nc_oc=AdoyaVEJrOksGiJZPrmz_foIe8J4dxp9JmVWZjk6MQ9bA8HdFYdTJ_HGtL5H9lSC0EA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0TPRR2Ey2JbUMIy3ykKRyysWsfjQlf6gPaa94HviFtLg&oe=69F200CD"}, "display_name": "Higher Prana", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing.\n"}]}, "developer_name": "Visual UniVRs ", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/98308919.pdf", "developer_terms_of_service_url": null, "publisher_name": "Higher Prana LLC", "support_website_url": null, "website_url": "http://www.higherprana.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM701YvwJwMQ7kNvwFLPQID&_nc_oc=AdnmD9-F9Q_Hjz2wBqdESEdjjYATS_MmMejzn1iu_TgOY52Bya5txhV9cbzylt93HBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzmqZ0ThauGkglenm3mr7i1Pnwsk-xnaVVd8HiCWGeNQ&oe=69B6B683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Cover.png", "id": "757799479237248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974779_757799482570581_671029364813839155_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oitEx_tTp0YQ7kNvwEgEA-b&_nc_oc=AdkxyusvihjH2WXwBEgeFpBfxWs3M1ALw1bby0VfQA_NTlMKZo5a3xN0TphU3XuLDUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_1MhlV8zdDZ_fpwas_7hLcAcoq9t-_mAhheilhm7dCw&oe=69B6AD4D"}, "display_name": "Higher Prana", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing.\n"}]}, "developer_name": "Visual UniVRs ", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/98308919.pdf", "developer_terms_of_service_url": null, "publisher_name": "Higher Prana LLC", "support_website_url": null, "website_url": "http://www.higherprana.com/", "category":
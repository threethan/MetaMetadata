70423566_7720916531455171664_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxOn7FJ02HcQ7kNvwFW0w31&_nc_oc=Adoqx89cV3BriD_3q8udhpgbIlwHL130Ozuvc6CTo8Jn7-WXlTELNjk-mGn0pP-gexE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1BizUY1S9Xt8_63hyAZpHl6bpDRt8GAITbt4c1Ka4Mg&oe=6A8ABFC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Cover.png", "id": "757799479237248", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974779_757799482570581_671029364813839155_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCJotY5KD4cQ7kNvwH0mtT8&_nc_oc=AdrrL28q9t9K9UFZ_lnCYEMZ5SberdiDLebGfS8kYrwt-mqMSQ3nkGMecN6SnaVC5FI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_u0c7qfDhKR3i4-UsmQp8YaAD5rsfxQGmUCOuQidJvA&oe=6A8AEECD"}, "display_name": "Higher Prana", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing.\n"}]}, "developer_name": "Visual UniVRs ", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/98308919.pdf", "developer_terms_of_service_url": null, "publisher_name": "Higher Prana LLC", "support_website_url": null, "
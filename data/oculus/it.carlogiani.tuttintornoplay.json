EXgQHT8O4kq-NEyaLesEEZ_kDjUrpT6lI27O9kLn4il5hO7eygnl_h8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnA_lN_QWPc6QlEo9-NLV5vNvodK2t609qfVQkHk42YA&oe=6ADF6E92"}]}, "id": "2545912839248029", "locale": "en_US", "screenshots": [{"file_name": "5_languages.png", "id": "1160305693013840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654862493_1160305696347173_7656148191411384936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvca4fXkhLgQ7kNvwFkF3eS&_nc_oc=AdpkXiFQms53HZ-Q4Z6KsZXyONEiO75ThidPrQiva1QLXJEvlWzrEmNVWJ1XG4o0kTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKSrQfnyTENIQh7ju2Jnw2vdVSyDv7_RwTxgJEZx4EhQ&oe=6ADF5818"}, {"file_name": "3_previews.png", "id": "2291462678364981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_2291462681698314_6185295995556223408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMDouj2T3A8Q7kNvwGmBhNh&_nc_oc=AdrDVIFD3QZ7BJ9UCxuhNafAvWdcy6pbhcINtvcisi41oOHKnaCbaWq903JYO1E0JYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLiyC1VCiAphbLhlmp8GX_wNUVaQCOSxV6MbgOk1ZnyQ&oe=6ADF5325"}, {"file_name": "4_camera_wifi.png", "id": "4397085753756905", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307444_4397085760423571_2835219916609647912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM8oLr7fed8Q7kNvwHIzgcU&_nc_oc=AdoXDHrcyFjfqKv7kidq1_MJ6XwgL98a1KwZIRaa-QVQ8_4mePzJQgxi2sdKVxCKf3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0744E65A8m2eV2RTg5RD2z_UG6ynUnfWqYmHMalzpbA&oe=6ADF5A79"}, {"file_name": "1_home.png", "id": "3439098736274137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_3439098739607470_8675960843809168349_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gic0d0PPyV8Q7kNvwE3Xf5a&_nc_oc=AdrsQ4aBgch29uFQq2UqmwjDQ6QcwbNp47wSWdr1UHAKerewiquQabB7ebaV_7lDOb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO40jy5aQ_tcswlvxusuzphl7sJULrb0kFWl-m1nUbx-g&oe=6ADF5DAC"}, {"file_name": "2_player_panel.png", "id": "4237146329915721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303790_4237146333249054_125410969968381222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uJH0DnEvScQ7kNvwHA4Rr5&_nc_oc=AdrR6MvqKLuJTwriv7jzejr3M7eGCmD3qv5N7E8uuJ1lvYvxRLnBpKqvP4zlV8iUtG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc5E-skwpyf6GUi5Jg9oBqok9okfylWZk3xYo0iZGRTg&oe=6ADF6C49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "keywords": ["Insta360", "360", "videoplayer", "insv", "panorama"], "long_description": "Tuttintorno Play plays the original files of your Insta360 camera on Meta Quest, with no need to export them first.\n\n\u2022 360\u00b0 videos (.insv) up to 8K: the two lenses are stitched in real time and the camera's gyroscope keeps the horizon level, or locks the whole view.\n\u2022 360\u00b0 photos (.insp), 360\u00b0 and flat .mp4 and .jpg.\n\u2022 Open files from the headset, a USB drive or microSD card, the camera connected by cable (U-Disk mode), shared folders on your network (SMB, with automatic discovery) or directly from the camera over Wi-Fi.\n\u2022 Adjust the stitching when you shoot with a diving case or lens guards.\n\u2022 Smooth playback at 90/120 Hz, previews, sorting, and the next file starts without interruptions.\n\u2022 Control panel in the headset: seek bar, pause, skips, previous and next file, stabilization, recenter.\n\u2022 English, Italian, French, German, Chinese, Japanese and Korean.\n\nTested with Insta360 X4. X5, X6 and X4 Lite should work too: feedback is welcome at carlo.giani@gmail.com.\n\nInsta360 is a trademark of Arashi Vision Inc. Tuttintorno Play is an independent app, not affiliated with or endorsed by Insta360.", "short_description": "Watch the 360\u00b0 videos and photos of your Insta360 camera on Meta Quest, straight from the original files: real-time stitching, gyroscope stabilization, and playback from the headset, a USB drive, your network or the camera's Wi-Fi."}]}, "developer_name": "Carlo Giani", "developer_privacy_policy_url": "https://karlfi.github.io/TuttintornoPlay-web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Real Tuscany Studios", "support_website_url": "https://karlfi.github.io/TuttintornoPlay-web/#en", "website_url": "https://karlfi.github.io/TuttintornoPlay-web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450733930351104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1117294937548352_3778545753641688368_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpJy4H4sm-IQ7kNvwHKh9ew&_nc_oc=AdpPw9o_AJvpvIaz7lgqUV6f1ca0pHYNksV28hvKpg64IyekSYYxzA1OgeDN5mN3EII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8xBTIcXRd6TwJwn8CoByuJn7wQXg5Vv2DOmHKvkHBIg&oe=6ADF6512"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792444680, "lastRevision": {"nodes": [{"id": "1450733943684436", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1450733927017771", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4414339708829183"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4492032777733295", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: lettore video 360\u00b0", "keywords": ["Insta360", "360", "lettore", "insv", "panorama"], "long_description": "Tuttintorno Play riproduce sul Meta Quest i file originali della tua camera Insta360, senza doverli esportare.\n\n\u2022 Video a 360\u00b0 (.insv) fino all'8K: le due lenti vengono cucite in tempo reale e il giroscopio della camera tiene dritto l'orizzonte, oppure blocca tutta la vista.\n\u2022 Foto a 360\u00b0 (.insp), .mp4 e .jpg a 360\u00b0 e normali.\n\u2022 File dal visore, da chiavetta USB o scheda microSD, dalla camera collegata col cavo (modalit\u00e0 U-Disk), dalle cartelle condivise della rete (SMB, con ricerca automatica) o direttamente dalla camera via Wi-Fi.\n\u2022 Regolazione della cucitura per la custodia subacquea e le protezioni delle lenti.\n\u2022 Riproduzione fluida a 90/120 Hz, anteprime, ordinamento e passaggio al file successivo senza interruzioni.\n\u2022 Pannello dei comandi nel visore: barra, pausa, salti, file precedente e successivo, stabilizzazione, ricentra.\n\u2022 Italiano, inglese, francese, tedesco, cinese, giapponese e coreano.\n\nProvata con Insta360 X4. X5, X6 e X4 Lite dovrebbero funzionare: i riscontri sono benvenuti a carlo.giani@gmail.com.\n\nInsta360 \u00e8 un marchio di Arashi Vision Inc. Tuttintorno Play \u00e8 un'app indipendente, non affiliata n\u00e9 approvata da Insta360.", "short_description": "Guarda sul Meta Quest i video e le foto a 360\u00b0 della tua camera Insta360, direttamente dai file originali: cucitura in tempo reale, stabilizzazione con il giroscopio e riproduzione dal visore, da una chiavetta USB, dalla rete di casa o dal Wi-Fi della camera."}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "28882902294678400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303707_28882902301345066_737247729215203180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THquBGKbpKIQ7kNvwFYbTVH&_nc_oc=AdpKUnPSk151cMTnc5FBDu3OviNl0ZvBZJJfCjVI_HLJ1hsrFW2qxJObmCq-Vxe6wWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONr7TWqw3TYQI0leZBqxuwrnXNlW_g9ahrQcuzLugjug&oe=6ADF522E"}, {"file_name": "hero_3000x900.png", "id": "1244785334519378", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753328995_1244785341186044_7521195147226850601_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj8fzLiZWaEQ7kNvwHnmrWV&_nc_oc=Adr8E8IcTvQo7yVX6LHjObzN3os3CkvWdY3BI2X7HpvG_GyZWBDHs8oY_DTpAVI6Ffc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONymFNk3-MMU3D66dMkQHKNNYOr5Jge6Ali-XbRdPAGA&oe=6ADF48E5"}, {"file_name": "icon_512.png", "id": "1126875513596729", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1126875516930062_7652338666183615868_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufjqYuXNLw8Q7kNvwG9GQBg&_nc_oc=AdpMZ28U5LfNpg_EnWd8JIHlXLTW9H7pUUkVSO3WWq-6YJP9I5Rdtu-Fr53sImp79bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTbAfNjTr79UUlrQdOwsY4Xy66ccsW_jwsHeBXt8OQdQ&oe=6ADF778C"}, {"file_name": "cover_square_1440x1440.png", "id": "1117294934215019", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1117294937548352_3778545753641688368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpJy4H4sm-IQ7kNvwHKh9ew&_nc_oc=AdpPw9o_AJvpvIaz7lgqUV6f1ca0pHYNksV28hvKpg64IyekSYYxzA1OgeDN5mN3EII
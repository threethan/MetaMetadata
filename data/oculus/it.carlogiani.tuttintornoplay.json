{"data": {"node": {"__typename": "Application", "id": "1450733927017771", "organization": {"id": "117058067052037", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1450733927017771"}]}, "id": "1573073561505387"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1450733927017771", "release_date": 1792444680, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1450737373684093"}, "id": "1489077699778378"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1450733927017771", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450737373684093"}, "release_status": "RELEASED"}, "id": "1450737373684093", "version": "0.9.1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1792162679, "id": "1450733943684436", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1450733930351104"}, "release_status": "RELEASED", "id": "1450733927017771"}, "id": "1450733930351104", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1450733927017771", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4414339708829183"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4492032777733295", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: lettore video 360\u00b0", "keywords": ["Insta360", "360", "lettore", "insv", "panorama"], "long_description": "Tuttintorno Play riproduce sul Meta Quest i file originali della tua camera Insta360, senza doverli esportare.\n\n\u2022 Video a 360\u00b0 (.insv) fino all'8K: le due lenti vengono cucite in tempo reale e il giroscopio della camera tiene dritto l'orizzonte, oppure blocca tutta la vista.\n\u2022 Foto a 360\u00b0 (.insp), .mp4 e .jpg a 360\u00b0 e normali.\n\u2022 File dal visore, da chiavetta USB o scheda microSD, dalla camera collegata col cavo (modalit\u00e0 U-Disk), dalle cartelle condivise della rete (SMB, con ricerca automatica) o direttamente dalla camera via Wi-Fi.\n\u2022 Regolazione della cucitura per la custodia subacquea e le protezioni delle lenti.\n\u2022 Riproduzione fluida a 90/120 Hz, anteprime, ordinamento e passaggio al file successivo senza interruzioni.\n\u2022 Pannello dei comandi nel visore: barra, pausa, salti, file precedente e successivo, stabilizzazione, ricentra.\n\u2022 Italiano, inglese, francese, tedesco, cinese, giapponese e coreano.\n\nProvata con Insta360 X4. X5, X6 e X4 Lite dovrebbero funzionare: i riscontri sono benvenuti a carlo.giani@gmail.com.\n\nInsta360 \u00e8 un marchio di Arashi Vision Inc. Tuttintorno Play \u00e8 un'app indipendente, non affiliata n\u00e9 approvata da Insta360.", "short_description": "Guarda sul Meta Quest i video e le foto a 360\u00b0 della tua camera Insta360, direttamente dai file originali: cucitura in tempo reale, stabilizzazione con il giroscopio e riproduzione dal visore, da una chiavetta USB, dalla rete di casa o dal Wi-Fi della camera."}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "28882902294678400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303707_28882902301345066_737247729215203180_n.png?_nc_cat=100&
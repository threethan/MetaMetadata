e_2560x1440.png", "id": "1096713252996113", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312306_1096713256329446_7662460925530361684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKsR6AVrVlYQ7kNvwEYzag8&_nc_oc=AdrjOyGdr6OFFd6sfSHvDmkK9P2HN-KElijoYnvz8tYTZ-rH3N7B_ARA4BQFxeJeQL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPuWFuveqT2RjVuMEKOFKa2M9qJVnSO0a_a6s5sdCugQ&oe=6B0DCB52"}]}, "id": "2116143479097603", "locale": "en_US", "screenshots": [{"file_name": "5_languages.png", "id": "1160305693013840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654862493_1160305696347173_7656148191411384936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTo9pDdML_cQ7kNvwEoSok4&_nc_oc=AdpyuAogIB9QjSoNHRzg4YXMbKJQDrK6ffuYLReC7pFI-G3laiWNAknllsItg_OKZJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5KHxyb6B0mJxxyxz-uPxZhTG1P3l7WCcaY6FZJ3OTwA&oe=6B0DB4D8"}, {"file_name": "3_previews.png", "id": "2291462678364981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_2291462681698314_6185295995556223408_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtkYNcf6u1IQ7kNvwFm5wGW&_nc_oc=AdpxDv3CUXfUbE5I-mpx9EjUk4YNGsJ9cEILV_S_s_6xrSnHRWGzQytho8rT3tgXx7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqXN8dl3F-rAP5o4S1L4z4a2Za80NwYaxs3NsGCacvpw&oe=6B0DAFE5"}, {"file_name": "4_camera_wifi.png", "id": "4397085753756905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307444_4397085760423571_2835219916609647912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0hvoLMbwacQ7kNvwEeW246&_nc_oc=AdrIfl-2H5AFTYiHD37en6syinJcYqHd_Yk8tRVwE1wRjUH_PupN4WckGxVcKarwGa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6mUX2cgP8foV_DMUTlSVsT6uxcHz5Foz2FnkSutx7zg&oe=6B0DB739"}, {"file_name": "1_home.png", "id": "3439098736274137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_3439098739607470_8675960843809168349_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfmTVFIobVoQ7kNvwE36MqK&_nc_oc=AdoVo-LCq-xVGfsAin7vUHcR6siOEEto4sZFP-UehgIU-FoiBUCi5Xh0NGXI6el1U9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCXwWVgEXUX10jFgvWyrwPLGVZWaLUvFajnT2tpX2LQQ&oe=6B0DBA6C"}, {"file_name": "2_player_panel.png", "id": "4237146329915721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_4237146333249054_125410969968381222_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1hZY71ab-sQ7kNvwE7otgK&_nc_oc=AdpZKx-GMQJadAorcrPdgraaNYJGV_v7P2YiYm8AmiHWijyQ6TVawvAeWEDYk2gdNpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5g3DuY621hPox5sJ4c2gxk4MjgyILd9C-mW_LyK4daQ&oe=6B0DC909"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "keywords": ["Insta360", "360", "videoplayer", "insv", "panorama"], "long_description": "Tuttintorno Play plays the original files of your Insta360 camera on Meta Quest, with no need to export them first.\n\n\u2022 360\u00b0 videos (.insv) up to 8K: the two lenses are stitched in real time and the camera's gyroscope keeps the horizon level, or locks the whole view.\n\u2022 360\u00b0 photos (.insp), 360\u00b0 and flat .mp4 and .jpg.\n\u2022 Open files from the headset, a USB drive or microSD card, the camera connected by cable (U-Disk mode), shared folders on your network (SMB, with automatic discovery) or directly from the camera over Wi-Fi.\n\u2022 Copy files between devices, no computer needed: from the camera's Wi-Fi to the headset, from the headset to a USB drive or your NAS, and back. Select several files at once and keep watching while they copy.\n\u2022 Photos are leveled with the camera's gyroscope, and you can turn any 360\u00b0 photo or video by hand.\n\u2022 Adjust the stitching when you shoot with a diving case or lens guards.\n\u2022 Smooth playback at 90/120 Hz, previews, sorting, and the next file starts without interruptions.\n\u2022 Control panel in the headset: seek bar, pause, skips, previous and next file, stabilization, recenter.\n\u2022 English, Italian, French, German, Chinese, Japanese and Korean.\n\nTested with Insta360 X4, and by users with the X5. X6 and X4 Lite should work too: feedback is welcome at carlo.giani@gmail.com.\n\nInsta360 is a trademark of Arashi Vision Inc. Tuttintorno Play is an independent app, not affiliated with or endorsed by Insta360.", "short_description": "Watch the 360\u00b0 videos and photos of your Insta360 camera on Meta Quest, straight from the original files: real-time stitching, gyroscope stabilization, and playback from the headset, a USB drive, your network or the camera's Wi-Fi. Copy your files between camera, headset, USB drives and your NAS, no computer needed."}, {"images": {"nodes": []}, "id": "1118177490981142", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: lettore video 360\u00b0", "keywords": ["Insta360", "360", "lettore", "insv", "panorama"], "long_description": "Tuttintorno Play riproduce sul Meta Quest i file originali della tua camera Insta360, senza doverli esportare.\n\n\u2022 Video a 360\u00b0 (.insv) fino all'8K: le due lenti vengono cucite in tempo reale e il giroscopio della camera tiene dritto l'orizzonte, oppure blocca tutta la vista.\n\u2022 Foto a 360\u00b0 (.insp), .mp4 e .jpg a 360\u00b0 e normali.\n\u2022 File dal visore, da chiavetta USB o scheda microSD, dalla camera collegata col cavo (modalit\u00e0 U-Disk), dalle cartelle condivise della rete (SMB, con ricerca automatica) o direttamente dalla camera via Wi-Fi.\n\u2022 Copia dei file tra dispositivi, senza computer: dal Wi-Fi della camera al visore, dal visore a una chiavetta USB o al NAS, e viceversa. Puoi scegliere pi\u00f9 file insieme e guardare video mentre copia.\n\u2022 Foto raddrizzate con il giroscopio della camera; ogni foto o video a 360\u00b0 si pu\u00f2 anche girare a mano.\n\u2022 Regolazione della cucitura per la custodia subacquea e le protezioni delle lenti.\n\u2022 Riproduzione fluida a 90/120 Hz, anteprime, ordinamento e passaggio al file successivo senza interruzioni.\n\u2022 Pannello dei comandi nel visore: barra, pausa, salti, file precedente e successivo, stabilizzazione, ricentra.\n\u2022 Italiano, inglese, francese, tedesco, cinese, giapponese e coreano.\n\nProvata con Insta360 X4, e dagli utenti con la X5. X6 e X4 Lite dovrebbero funzionare: i riscontri sono benvenuti a carlo.giani@gmail.com.\n\nInsta360 \u00e8 un marchio di Arashi Vision Inc. Tuttintorno Play \u00e8 un'app indipendente, non affiliata n\u00e9 approvata da Insta360.", "short_description": "Guarda sul Meta Quest i video e le foto a 360\u00b0 della tua camera Insta360, direttamente dai file originali: cucitura in tempo reale, stabilizzazione con il giroscopio e riproduzione dal visore, da una chiavetta USB, dalla rete di casa o dal Wi-Fi della camera. Copia i file tra camera, visore, chiavette USB e NAS, senza computer."}]}, "developer_name": "Carlo Giani", "developer_privacy_policy_url": "https://karlfi.github.io/TuttintornoPlay-web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Real Tuscany Studios", "support_website_url": "https://karlfi.github.io/TuttintornoPlay-web/#en", "website_url": "https://karlfi.github.io/TuttintornoPlay-web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486850853406078"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1117294937548352_3778545753641688368_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m3fD7fzFd0Q7kNvwGELok0&_nc_oc=Adp4Qq2etK7T5ifFB1QfAd7HrfY_AT7dU4FFgGsPBPFdX-xqqLxh38_AA-avcKEPeSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVVWNDEPocb4CZm2VxramfZL_VWl8HH9vuNcEZTdSB3g&oe=6B0DC1D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1792444680, "lastRevision": {"nodes": [{"id": "1450733943684436", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1450733927017771", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4414339708829183"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4492032777733295", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: lettore video 360\u00b0", "keywords": ["Insta360", "360", "lettore", "insv", "panorama"], "long_description": "Tuttintorno Play riproduce sul Meta Quest i file originali della tua camera Insta360, senza doverli esportare.\n\n\u2022 Video a 360\u00b0 (.insv) fino all'8K: le due lenti vengono cucite in tempo reale e il giroscopio della camera tiene dritto l'orizzonte, oppure blocca tutta la vista.\n\u2022 Foto a 360\u00b0 (.insp), .mp4 e .jpg a 360\u00b0 e normali.\n\u2022 File dal visore, da chiavetta USB o scheda microSD, dalla camera collegata col cavo (modalit\u00e0 U-Disk), dalle cartelle condivise della rete (SMB, con ricerca automatica) o direttamente dalla camera via Wi-Fi.\n\u2022 Regolazione della cucitura per la custodia subacquea e le protezioni delle lenti.\n\u2022 Riproduzione fluida a 90/120 Hz, anteprime, ordinamento e passaggio al file successivo senza interruzioni.\n\u2022 Pannello dei comandi nel visore: barra, pausa, salti, file precedente e successivo, stabilizzazione, ricentra.\n\u2022 Italiano, inglese, francese, tedesco, cinese, giapponese e coreano.\n\nProvata con Insta360 X4. X5, X6 e X4 Lite dovrebbero funzionare: i riscontri sono benvenuti a carlo.giani@gmail.com.\n\nInsta360 \u00e8 un marchio di Arashi Vision Inc. Tuttintorno Play \u00e8 un'app indipendente, non affiliata n\u00e9 approvata da Insta360.", "short_description": "Guarda sul Meta Quest i video e le foto a 360\u00b0 della tua camera Insta360, direttamente dai file originali: cucitura in tempo reale, stabilizzazione con il giroscopio e riproduzione dal visore, da una chiavetta USB, dalla rete di casa o dal Wi-Fi della camera."}, {"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "28882902294678400", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303707_28882902301345066_737247729215203180_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxHPkw0HU3wQ7kNvwGrD0Ww&_nc_oc=Adr5Y1NP3wOef3GueXr5T5b_GFUgFoC8vcqSoNO11F9sQ2sPPcT-IUm0eyR7kYnhifg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSc0qL1dBoMOUY1bBHknJgkDUSw4hqKTpUWXu8o6Y7blA&oe=6B0DAEEE"}, {"file_name": "hero_3000x900.png", "id": "1244785334519378", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/753328995_1244785341186044_7521195147226850601_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2ETzUQrQTUQ7kNvwFNQDoa&_nc_oc=AdrniUwXBhizKSJ2iqthz6GHSm1P45l5q5acJNWmZ4-YT8ToqJzu6mJ9HHbzxIcboCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6FGr8gXQGLRPlY1hq-Di54-ppoLzhRe0_1i7jIN2uQg&oe=6B0DA5A5"}, {"file_name": "icon_512.png", "id": "1126875513596729", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303471_1126875516930062_7652338666183615868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgbQIZABZfQQ7kNvwGPaZR1&_nc_oc=AdolLPavVM353Nk8E1vUl2Dtu5MT8gEyynkIs2aC7K3Q-sOIlb9nxNi3S-lI0aLuPwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZdPY6am_sclR8Ydg3HEy6QwyMlHRbF4ocpOT5r46mBQ&oe=6B0D9C0C"}, {"file_name": "cover_square_1440x1440.png", "id": "1117294934215019", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1117294937548352_3778545753641688368_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m3fD7fzFd0Q7kNvwGELok0&_nc_oc=Adp4Qq2etK7T5ifFB1QfAd7HrfY_AT7dU4FFgGsPBPFdX-xqqLxh38_AA-avcKEPeSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXeo724-Gh6vwupkGfQaPCInGHY7QYQEPuz5TVp3d41Q&oe=6B0DC1D2"}, {"file_name": "cover_landscape_2560x1440.png", "id": "1096713252996113", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312306_1096713256329446_7662460925530361684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKsR6AVrVlYQ7kNvwEYzag8&_nc_oc=AdrjOyGdr6OFFd6sfSHvDmkK9P2HN-KElijoYnvz8tYTZ-rH3N7B_ARA4BQFxeJeQL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPuWFuveqT2RjVuMEKOFKa2M9qJVnSO0a_a6s5sdCugQ&oe=6B0DCB52"}]}, "id": "2545912839248029", "locale": "en_US", "screenshots": [{"file_name": "5_languages.png", "id": "1160305693013840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654862493_1160305696347173_7656148191411384936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTo9pDdML_cQ7kNvwEoSok4&_nc_oc=AdpyuAogIB9QjSoNHRzg4YXMbKJQDrK6ffuYLReC7pFI-G3laiWNAknllsItg_OKZJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5KHxyb6B0mJxxyxz-uPxZhTG1P3l7WCcaY6FZJ3OTwA&oe=6B0DB4D8"}, {"file_name": "3_previews.png", "id": "2291462678364981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_2291462681698314_6185295995556223408_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtkYNcf6u1IQ7kNvwFm5wGW&_nc_oc=AdpxDv3CUXfUbE5I-mpx9EjUk4YNGsJ9cEILV_S_s_6xrSnHRWGzQytho8rT3tgXx7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqXN8dl3F-rAP5o4S1L4z4a2Za80NwYaxs3NsGCacvpw&oe=6B0DAFE5"}, {"file_name": "4_camera_wifi.png", "id": "4397085753756905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307444_4397085760423571_2835219916609647912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0hvoLMbwacQ7kNvwEeW246&_nc_oc=AdrIfl-2H5AFTYiHD37en6syinJcYqHd_Yk8tRVwE1wRjUH_PupN4WckGxVcKarwGa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6mUX2cgP8foV_DMUTlSVsT6uxcHz5Foz2FnkSutx7zg&oe=6B0DB739"}, {"file_name": "1_home.png", "id": "3439098736274137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_3439098739607470_8675960843809168349_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfmTVFIobVoQ7kNvwE36MqK&_nc_oc=AdoVo-LCq-xVGfsAin7vUHcR6siOEEto4sZFP-UehgIU-FoiBUCi5Xh0NGXI6el1U9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCXwWVgEXUX10jFgvWyrwPLGVZWaLUvFajnT2tpX2LQQ&oe=6B0DBA6C"}, {"file_name": "2_player_panel.png", "id": "4237146329915721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_4237146333249054_125410969968381222_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1hZY71ab-sQ7kNvwE7otgK&_nc_oc=AdpZKx-GMQJadAorcrPdgraaNYJGV_v7P2YiYm8AmiHWijyQ6TVawvAeWEDYk2gdNpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5g3DuY621hPox5sJ4c2gxk4MjgyILd9C-mW_LyK4daQ&oe=6B0DC909"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "keywords": ["Insta360", "360", "videoplayer", "insv", "panorama"], "long_description": "Tuttintorno Play plays the original files of your Insta360 camera on Meta Quest, with no need to export them first.\n\n\u2022 360\u00b0 videos (.insv) up to 8K: the two lenses are stitched in real time and the camera's gyroscope keeps the horizon level, or locks the whole view.\n\u2022 360\u00b0 photos (.insp), 360\u00b0 and flat .mp4 and .jpg.\n\u2022 Open files from the headset, a USB drive or microSD card, the camera connected by cable (U-Disk mode), shared folders on your network (SMB, with automatic discovery) or directly from the camera over Wi-Fi.\n\u2022 Adjust the stitching when you shoot with a diving case or lens guards.\n\u2022 Smooth playback at 90/120 Hz, previews, sorting, and the next file starts without interruptions.\n\u2022 Control panel in the headset: seek bar, pause, skips, previous and next file, stabilization, recenter.\n\u2022 English, Italian, French, German, Chinese, Japanese and Korean.\n\nTested with Insta360 X4. X5, X6 and X4 Lite should work too: feedback is welcome at carlo.giani@gmail.com.\n\nInsta360 is a trademark of Arashi Vision Inc. Tuttintorno Play is an independent app, not affiliated with or endorsed by Insta360.", "short_description": "Watch the 360\u00b0 videos and photos of your Insta360 camera on Meta Quest, straight from the original files: real-time stitching, gyroscope stabilization, and playback from the headset, a USB drive, your network or the camera's Wi-Fi."}]}, "developer_name": "Carlo Giani", "developer_privacy_policy_url": "https://karlfi.github.io/TuttintornoPlay-web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Real Tuscany Studios", "support_website_url": "https://karlfi.github.io/TuttintornoPlay-web/#en", "website_url": "https://karlfi.github.io/TuttintornoPlay-web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450733930351104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "911086578604968"}]}, "baseline_offer": {"id": "911086578604968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792444680, "status": "PUBLISHED", "id": "911086578604968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1486841223407041", "version": "0.10.0"}, "id": "1489077699778378", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1450733927017771", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1486841223407041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1489077699778378"}]}, "change_log": "Copy your files between devices, no computer needed: from the camera's Wi-Fi to the headset, from the headset to a USB drive or your NAS, and back. Use the \u22ee button on any file, or Select to copy several files at once: progress is shown at the top and in the notifications, and you can keep watching videos while it copies. Deleting now asks you to type a random code, so nothing is deleted by mistake. Texts now refer to all Insta360 cameras, not only the X4.", "created_date": 1795384982, "id": "1486841223407041", "version": "0.10.0", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1450733927017771", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1486841223407041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1489077699778378"}]}, "change_log": "360\u00b0 photos (.insp) are now leveled with the camera's gyroscope, so the horizon stays straight even if the camera was tilted (the stabilization button turns it on and off). You can now turn 360\u00b0 photos and videos by hand: with the panel closed, hold the trigger and move the controller; on photos the thumbstick turns the view too, and Recenter in the panel restores the original orientation. Stability fixes: no more errors when the camera connection fails after leaving the screen, and faster closing while a file is still loading.", "created_date": 1794963215, "id": "1481894927235004", "version": "0.9.2", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1450733927017771", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1486841223407041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1489077699778378"}]}, "change_log": "\"First release. Play the original files of your Insta360 camera on Meta Quest: 360 videos (.insv) with real-time stitching and gyroscope stabilization, 360 photos, mp4 and jpg. Sources: headset storage, USB drive or camera in U-Disk mode, network shares (SMB) and the camera over Wi-Fi.\"", "created_date": 1792162940, "id": "1450737373684093", "version": "0.9.1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
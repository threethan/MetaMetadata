ADF5A79"}, {"file_name": "1_home.png", "id": "3439098736274137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_3439098739607470_8675960843809168349_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gic0d0PPyV8Q7kNvwE3Xf5a&_nc_oc=AdrsQ4aBgch29uFQq2UqmwjDQ6QcwbNp47wSWdr1UHAKerewiquQabB7ebaV_7lDOb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO40jy5aQ_tcswlvxusuzphl7sJULrb0kFWl-m1nUbx-g&oe=6ADF5DAC"}, {"file_name": "2_player_panel.png", "id": "4237146329915721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303790_4237146333249054_125410969968381222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uJH0DnEvScQ7kNvwHA4Rr5&_nc_oc=AdrR6MvqKLuJTwriv7jzejr3M7eGCmD3qv5N7E8uuJ1lvYvxRLnBpKqvP4zlV8iUtG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc5E-skwpyf6GUi5Jg9oBqok9okfylWZk3xYo0iZGRTg&oe=6ADF6C49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuttintorno Play: 360\u00b0 Video Player", "keywords": ["Insta360", "360", "videoplayer", "insv", "panorama"], "long_description": "Tuttintorno Play plays the original files of your Insta360 camera on Meta Quest, with no need to export them first.\n\n\u2022 360\u00b0 videos (.insv) up to 8K: the two lenses are stitched in real time and the camera's gyroscope keeps the horizon level, or locks the whole view.\n\u2022 360\u00b0 photos (.insp), 360\u00b0 and flat .mp4 and .jpg.\n\u2022 Open files from the headset, a USB drive or microSD card, the camera connected by cable (U-Disk mode), shared folders on your network (SMB, with automatic discovery) or directly from the camera over Wi-Fi.\n\u2022 Adjust the stitching when you shoot with a diving case or lens guards.\n\u2022 Smooth playback at 90/120 Hz, previews, sorting, and the next file starts without interruptions.\n\u2022 Control panel in the headset: seek bar, pause, skips, previous and next file, stabilization, recenter.\n\u2022 English, Italian, French, German, Chinese, Japanese and Korean.\n\nTested with Insta360 X4. X5, X6 and X4 Lite should work too: feedback is welcome at carlo.giani@gmail.com.\n\nInsta360 is a trademark of Arashi Vision Inc. Tuttintorno Play is an independent app, not affiliated with or endorsed by Insta360.", "short_description": "Watch the 360\u00b0 videos and photos of your Insta360 camera on Meta Quest, straight from the original files: real-time stitching, gyroscope stabilization, and playback from the headset, a USB drive, your network or the camera's Wi-Fi."}]}, "developer_name": "Carlo Giani", "developer_privacy_policy_url": "https://karlfi.github.io/TuttintornoPlay-web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Real Tuscany Studios", "support_website_url": "https://karlfi.github.io/TuttintornoPlay-web/#en", "website_url": "https://karlfi.github.io/TuttintornoPlay-web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450733930351104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "911086578604968"}]}, "baseline_offer": {"id": "911086578604968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792444680, "status": "PUBLISHED", "id": "911086578604968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1450737373684093", "version": "0.9.1"}, "id": "1489077699778378", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1450733927017771", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450737373684093"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1489077699778378"}]}, "change_log": "\"First release. Play the original files of your Insta360 camera on Meta Quest: 360 videos (.insv) with real-time stitching and gyroscope stabilization, 360 photos, mp4 and jpg. Sources: headset storage, USB drive or camera in U-Disk mode, network shares (SMB) and the camera over Wi-Fi.\"", "created_date": 1792162940, "id": "1450737373684093", "version": "0.9.1", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
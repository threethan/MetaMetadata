c=Adr2IGnWUMg666F67w4P5T24vE9WQHYxRhlr6rFLqq_QFYKDr3Ndh-mgR8yEr6AUImk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu6Ej5dvFzvp543Tjx8xLA_DyGFzacs1WumMmS2JX4UA&oe=6A660E5F"}, {"file_name": "006.png", "id": "2344256995974732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57574726_2344256999308065_5372037537357461991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TGBo8j83osQ7kNvwGKn2Zf&_nc_oc=Adp-l6eM1KXzyW8vSZKwxHeHqZswZfRJi34HgxTWBxjsxGWV1GIO4yLyWvoBHL2X-6w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6_UK6eA0lkeb-T3PlB3EgO37GBI5I1Cb13vEUW1usqw&oe=6A661BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaa.png", "id": "1161317304892909", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_1161317308226242_7286292951381202248_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ea2w30UiF8Q7kNvwFfM747&_nc_oc=AdruTsjTjnAsvV6XKvfCmGUfBMto4MByEPAUu1Xo1rFAA74wjbQtq8crW3KBkEnawoA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0EPxnsIW7mIaDBA_6FUGdb6GnMYE9DyjxCUbpRkC7SA&oe=6A660DBC"}, "display_name": "MEDICALHOLODECK. ANATOMY, IMAGING, AI", "keywords": ["Anatomy", "Education", "AI", "Medicine", "Surgery"], "long_description": "**The human body is not flat. Yet medical imaging and anatomy are still primarily interpreted in two dimensions, creating a gap between data and understanding.**\n\nWork with medical imaging, anatomy atlases, AI segmentation, and digital twins across VR, 3D displays, and 2D systems.\n\nFree access for students. Send your proof of enrollment to info@medicalholodeck.com\n\n# Highlights\n- Interactive 3D medical imaging from CT, MRI, and DICOM\n- 3D anatomy atlases and virtual dissection\n- Real-time collaboration across devices and locations\n- Spatial recording for teaching and review\n- AI segmentation and patient-specific digital twins (PC-VR)\n- One system for VR, 3D displays, 2D screens, and iOS\n\n# Apps\n- Medical Imaging \u2013 interactive 3D imaging and case review\n- Dissection Master \u2013 virtual cadaver dissection\n- Anatomy Master \u2013 3D anatomy atlas with 2,000+ structures\n- RecordXR \u2013 record and replay spatial sessions\n- Spatial OS \u2013 shared spatial environment across devices (PC-VR tethered)\n- Medicalholodeck AI \u2013 automatic segmentation in seconds (PC-VR tethered for best performance)\n\n# Use cases\nUsed for anatomy education, simulation, interdisciplinary case discussions, tumor boards, patient communication, and immersive training with real medical data in interactive 3D.\n\n# Important notice\nMedicalholodeck is not a certified medical device and is intended for education, communication, training, and research purposes only.", "short_description": "Explore anatomy, convert CT, MRI, and DICOM data into interactive 3D, create AI segmentations and digital twins, and collaborate across VR, 3D displays, and 2D systems. Free access for students. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicalholodeck.com/en/support-contact/privacy-policy/", "developer_terms_of_service_url": "https://www.medicalholodeck.com/en/eula/", "publisher_name": "MEDICALHOLODECK\u00ae AG.", "support_website_url": "https://www.medicalholodeck.com/en/support-contact/", "website_url": "https://www.medicalholodeck.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt", "pt_BR"], "supported_i
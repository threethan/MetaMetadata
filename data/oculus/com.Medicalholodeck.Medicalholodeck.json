c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbQPRb-87SYQ7kNvwF-wpE5&_nc_oc=Adqbe3V28nGDUODfaByAy_AxK09HhAt0YO8dGLHEDsMklCRGq1p0-0Rd3UR-kFrYFbs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41fxnm4BXwEVug39ta4rK8Zr85MdyNE6b9bLmkYIdEOQ&oe=6A11A7C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-app-lab-01-04.png", "id": "1726320934218866", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375762_1726320944218865_8479957325917845115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv_fL0tjqYgQ7kNvwHy1vcQ&_nc_oc=AdoJmdMNCmxaxI3Tf7rwIaKicwqcNXF42JZvW2uekb4VT2W7vwIjcJPtg8NpY0fdTXA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gqijoLodN2oQW-B9EQoRuHY62Xza7egg97cchWNg4LQ&oe=6A119D25"}, "display_name": "Medicalholodeck Dissection Master XR", "keywords": [], "long_description": "Dissection Master XR is suitable for teaching in classes in VR and for independent preparation of courses and exams. The interactive anatomical 3D data enable a steep learning curve and optimal learning success. \n\nDissection Master XR brings human dissections of the highest quality to VR and makes them interactively accessible for medical teaching and education. The entire human body can be studied in multiple layers and discussed in groups in VR. The app is the perfect complement to traditional face-to-face lessons in the anatomy and dissection lab.\n", "short_description": "Dissection Master XR is the dissection and anatomy lab in virtual reality. It presents high-resolution human dissections created especially for anatomy teaching. The entire human body has been carefully dissected and digitized in up to 10 high-resolution layers. All structures relevant for anatomical education on a university level are precisely marked and annotated.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicalholodeck.com/privacy-data-protection/privacy.html", "developer_terms_of_service_url": "https://www
1-25/75439593_640043654006551_7051351553269026222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgC2TxRtNl0Q7kNvwE8kC0M&_nc_oc=AdqBkJcKOBSmOxFmmB3nLEmqwQJeF7OVoeBCM-uRk6rc7QN2Uq9eCnXdp6EiBDyHr0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlkloJz_U2FvhftsYDnLZDdHVRxg0-YVZYdawn4AHMkg&oe=6A6B5521"}, {"file_name": "MHD_20220131_142935667.png", "id": "951099422186728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75532179_951099428853394_2950810225293688420_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv8adIS43DoQ7kNvwG4_toM&_nc_oc=AdpqVs3nbttPZqdFcj3lqYcjq4L7pgmQb6NzTDHr59XostBrsGgTSKORA7LJtlPY4Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4bhUxdqRoDaQNmEGAVPtVQlkv5-uSDA12kOUF_appWA&oe=6A6B57F5"}, {"file_name": "MHD_20220131_143028542.png", "id": "473945630951304", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75557061_473945634284637_1179387240987874291_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ7qkRKD8ecQ7kNvwFj7-IB&_nc_oc=AdoxzebgDgCrW5b7AODcBi_x0SAodtNL1jUo4TI5PujhoLkdnAkUGI6Tj1WOtYypXis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvPCsqxRawJSHzzqHW3QL2Ew9Rtp9GlJx0LqXo4KSGRw&oe=6A6B4DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-app-lab-01-04.png", "id": "1726320934218866", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375762_1726320944218865_8479957325917845115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwE7GDtDfDUQ7kNvwGajShw&_nc_oc=Adof02AlVorvrlTWKwlD-N3NBghgopjy96J5i2Vc64N01O2Qv9B9DQoM6R3vV-a2xtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnI87LIz0hLEsv8dIFdFyj5YBubsXzAyQLtbzlhye8JA&oe=6A6B4325"}, "display_name": "Medicalholodeck Dissection Master XR", "keywords": [], "long_description": "Dissection Master XR is suitable for teaching in classes in VR and for independent preparation of courses and exams. The interactive anatomical 3D data enable a steep learning curve and optimal learning success. \n\nDissection Master XR brings human dissections of the highest quality to VR and makes them interactively accessible for medical teaching and education. The entire human body can be studied in multiple layers and discussed in groups in VR. The app is the perfect complement to traditional face-to-face lessons in the anatomy and dissection lab.\n", "short_description": "Dissection Master XR is the dissection and anatomy lab in virtual reality. It presents high-resolution human dissections created especially for anatomy teaching. The entire human body has been carefully dissected and digitized in up to 10 high-resolution layers. All structures relevant for anatomical education on a university level are precisely marked and annotated.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicalholodeck.com/privacy-data-protection/privacy.html", "developer_terms_of_service_url": "https://www.medicalholodeck.com/privacy-data-protection/terms.html", "publisher_name": "Medicalholodeck", "support_website_url": null, "website_url": "https://www.medicalholodeck.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MEDICINE", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "678408766843213"}}]}, "scheduled_offers": {"count": 2, "nodes":
a&_nc_ohc=fD7Qfq9Yqa4Q7kNvwE5p5YJ&_nc_oc=AdmrxuTlh5uAPXgBikUbSkwU-zW1t9JM2a1aQSA47r2H3SCU2_GLukZj0HQrc1yMvCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afukf_4cAZkpnfkmU7H9ffbZGEkO3oQ8jXQ8yMSRLUnkwQ&oe=69A421AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpsPrime", "keywords": ["chimp", "vr", "free", "Multiplayer", "Platformer"], "long_description": "Welcome to ChimpsPrime, the next evolution of primal VR movement. Inspired by the viral hit Gorilla Tag, this fangame cranks up the chaos with futuristic arenas, enhanced mobility, and wild multiplayer modes.\n\nPlay as a hyper-evolved chimp and launch yourself through neon-lit jungles, cyber temples, and gravity-defying arenas using only your arms\u2014no buttons, no sticks, just pure skill and instinct. Whether you're escaping infected players, racing through obstacle courses, or battling it out in arena-style combat, ChimpsPrime delivers heart-pounding action and endless fun.\n\nWith responsive locomotion, customizable chimps, and a dedicated community, ChimpsPrime is more than a fangame\u2014it's a movement.", "short_description": "ChimpsPrime is a fast-paced VR fangame inspired by Gorilla Tag, where primal parkour meets high-tech jungle chaos. Swing, climb, and chase your way through intense arenas in the ultimate chimp showdown."}]}, "developer_name": "Monkeyguy1dc", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/chimpsprime-privacy-policy/4eefe4b5-5cf8-4f76-9dc9-7f1deabcc241/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/chimps-prime-terms-conditions/08f093ae-5975-451c-9f0d-4cce99a3b62e/terms", "publisher_name": "Monkeyguy1dc", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-6AyWwgmGx76yEYJZia-3cd3M-vl-uhIu-Xg4udhdlk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9710502395693322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619625_2212051669212467_3044835930421599845_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I55logu6rYIQ7kNvwFq4tsq&_nc_oc=AdkyhiMVquf8F9sBoYMPNaxDQ-gLNobKC0y8X-tRYMwb1jqBf0Zk6N4Cyk0sDu1jZWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft9U6otsCdpjsanS1ricPa6QupCXNzgng1Bb9B0ssAgnQ&oe=69A43BA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChimpsPrime", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1749206460, "lastRevision": {"nodes": [{"id": "9710502419026653", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9710502385693323", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "593909747074538"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "com.oculus.vrshell-2gdfdfg02asd50524-14342 (1) (1).png", "id": "2212051665879134", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619625_2212051669212467_3044835930421599845_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
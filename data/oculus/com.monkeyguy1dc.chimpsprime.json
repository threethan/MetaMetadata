F6kl8TKUsDzQDQFtBcGlGY6-0RCtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2Zt_CAFfofoDsxez7eFAFZgzyrDEseMvCxzy9d8E2clw&oe=69F0BF46"}, {"file_name": "com.oculus.vrshell-20250524-143344.png", "id": "1727778797811659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618932_1727778801144992_4588746688370004633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPmvGSK8UkkQ7kNvwEnzhn5&_nc_oc=AdqMZ0aR6KMqiNhbXUzM8Qftctiq5AwQnKhtMTuvTad3Fj5sCEMegq6NEH7hEYkhJJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2jxB5rHFJ3zPtmXCsQYqVKJAbBcZHBMKBwXdFNEeViwA&oe=69F0A77A"}, {"file_name": "com.oculus.vrshell-20250524-143305.png", "id": "1896166294488060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499352529_1896166297821393_4039127564225976258_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0pmWoH6sEQQ7kNvwHpnmW_&_nc_oc=Adq9Tim5OC0D56EucX90wwldSkGZPFir-iNL6k5JNt5brnhsvP92mRR6wKqkg8AGVPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3xGhKjOmwDy1M0HpDzsPJOyuY_1RV3DtD1n7ZSXibhzQ&oe=69F0A313"}, {"file_name": "com.oculus.vrshell-20250524-14342.png", "id": "1599570470665290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307574_1599570477331956_6550683482986128368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRSiakOwNskQ7kNvwHEFBGm&_nc_oc=AdpFBm0ahKtgje-CC3YcjTr84rsLkzhfHfZnsSsmHWN2AGi0PivEEZAgZ70Iw4Tj_O4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1QN_q5wKFTtEMpeM1vYI-sO8VfU1AUxCWkPFS0QEfn0A&oe=69F0D0EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpsPrime", "keywords": ["chimp", "vr", "free", "Multiplayer", "Platformer"], "long_description": "Welcome to ChimpsPrime, the next evolution of primal VR movement. Inspired by the viral hit Gorilla Tag, this fangame cranks up the chaos with futuristic arenas, enhanced mobility, and wild multiplayer modes.\n\nPlay as a hyper-evolved chimp and launch yourself through neon-lit jungles, cyber temples, and gravity-defying arenas using only your arms\u2014no buttons, no sticks, just pure skill and instinct. Whether you're escaping infected players, racing through obstacle courses, or battling it out in arena-style combat, ChimpsPrime delivers heart-pounding action and endless fun.\n\nWith responsive locomotion, customizable chimps, and a dedicated community, ChimpsPrime is more than a fangame\u2014it's a movement.", "short_description": "ChimpsPrime is a fast-paced VR fangame inspired by Gorilla Tag, where primal parkour meets high-tech jungle chaos. Swing, climb, and chase your way through intense arenas in the ultimate chimp showdown."}]}, "developer_name": "Monkeyguy1dc", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/chimpsprime-privacy-policy/4eefe4b5-5cf8-4f76-9dc9-7f1deabcc241/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/chimps-prime-terms-conditions/08f093ae-5975-451c-9f0d-4cce99a3b62e/terms", "publisher_name": "Monkeyguy1dc", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-6AyWwgmGx76yEYJZia-3cd3M-vl-uhIu-Xg4udhdlk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9710502395693322"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1104232174841426"}]}, "baseline_offer": {"id": "1104232174841426"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
833", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_684225454395166_4669500940882966481_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEBgjlcZKGMQ7kNvwG7JPMg&_nc_oc=AdkOOq6zVZ8C1KVY_YFERiiOs07P5-egveGFXpxf6dgMsqzUgqFaGbhvvewFL5Zngts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP6Rbf8HWnbnv47CtUBH2yoFyGhEvzurleg9t9U-BR9g&oe=699DA49E"}, {"file_name": "Screenshot 3.png", "id": "712797527816902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300549_712797531150235_7255838885968633153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34ct99cCrTQQ7kNvwHQ-Qks&_nc_oc=Adm-9ZvdwDkZtMHe-wQo-P7yUBk_aexC4BTm1DG9j9Q9bkq9EGxlkhrx1aFCX8-104w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMfGlHfWW22GFcjqdoYX-0pPLMhAVLY53VIamHRX49Ow&oe=699DAE11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Valve Tagg", "keywords": ["tag", "project", "taggers", "tagg", "tags"], "long_description": "\"Valve Tagg\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of \"Valve Tagg\" is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "\"Valve Tagg\", an interesting gorilla tag fangame."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1gTxMV6lnqtn8qWj4hWBGpKMNtJlnK_zM6_XgFZhmp28/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Signal", "support_website_url": null, "website_url": "https://html.cafe/x0ad04eab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
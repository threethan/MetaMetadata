e": "3.png", "id": "624000227310704", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499300897_624000230644037_2803082333846325672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cUUS1qK3RIQ7kNvwHfDQTb&_nc_oc=AdrkJjhanUEUlpCMuE9YCTQ4D5qi42CJfAeszpUCw50Nm3WT9akk3Oqxg9q8TWHOi6c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0yim4F8Cysftz3EEaWOJbXZ30LIPjxuGJGkTAHvGy_w&oe=6A7DA6A5"}, {"file_name": "4.png", "id": "831080656270843", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308349_831080659604176_2106439751798831701_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roAQqkxrgtIQ7kNvwHuVTu9&_nc_oc=AdofIeG6yFiA0ZeGaTl9f0Q8ubf3DWe5sZjfRbx0wTN5SieHK-TGN_kdTznTnfgZ5xg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY1VQp2USpbWrQQlviWT0pHTsh6HbdIY_rjZ1U0i2p7A&oe=6A7DBD3D"}, {"file_name": "1.png", "id": "802331519241452", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312468_802331522574785_8880843642444831968_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DurrKvjzt2MQ7kNvwHwvbMu&_nc_oc=Adp5zFw4fljIewjSEFM9BgzLCREvobWPZsxSYujPG81J9CFCsyJEp9QOeKpPhATT8_E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOsDXKMrI9BPkBW0CGu0qzuAcdWAOcjPwBljBzSCIydQ&oe=6A7DA6EE"}, {"file_name": "5.png", "id": "1308530937391475", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307326_1308530940724808_3061350910341798016_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG_cpwXK_hQQ7kNvwHxjiYW&_nc_oc=AdoyKUrB9MgUa5PnDo6OV1lmtICULFG7JU37UgcJUSRdJboPpVF3iCxLs6VoGLzZIKI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpA2vOci3T_VGD38DbyV6tFJamAbHCFrU_aRMmakSpyg&oe=6A7DCE69"}, {"file_name": "2.png", "id": "1373474487495150", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825034_1373474490828483_3189952892363354563_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNe1-G1miRIQ7kNvwEvPIQl&_nc_oc=AdqRIjjUO8JmgEbHPo2Xf-MtdrTisW0lVXDYIkh46E6m4mEehnkNuiFs3tIE9ogaVEE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUWYiqnRx9nqOGFLdELYdkG1ajPAYdIAFprnnBrKpJnw&oe=6A7DC411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerimage.png", "id": "671138185570890", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822489_671138192237556_1616973346297713532_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy4ETRS_iUkQ7kNvwG0mLAq&_nc_oc=AdqtkXtA14Vp1jlYW0AoZ2LFh9VKYKVIaNbQaumRvDtYesUW8oAqzPYpE5wJZcIw0wc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQDQz00GvSZwN-ePBRjzPjKUGftWdvkX0Ty2wOktucew&oe=6A7D9B6C"}, "display_name": "DONT MOVE", "keywords": ["Flinch", "Horror", "Simulation", "Realistic", "Action"], "long_description": "\nDON'T MOVE is an immersive VR game where your ability to HOLD YOUR NERVE and stay PERFECTLY STILL, no matter what comes at you is key to succeeding.\n\n Perfect for Friends and Families - Using the 'GALLERY' mode - and unlocked sequences can be replayed at any time.\n\nChallenge each other to 'hold your nerve' for as long as possible. \n\nA statement from the FLINCH-INC Dummy Testing Facility - \n\nHere in the test facility we use every testing apparatus available, no matter how ludicrous. To test the strength and resolve of all our dummies. We pride ourselves on creating dummies with near zero 'flinch' mechanics. As our founder famously stated time and time again. 'You won't find a more willing dummy - than a 'Flinch-Inc' dummy\n\n FEATURES \n\nIMMERSIVE VR EXPERIENCE - Experience the horrors of the test facility as the testing team throws test after horrifying test at you.\n\nBIANURAL AUDIO - A fully Ambisonic/Binaural sound mix puts you right in the middle of this immersive experience.\n\nSEATED or STANDING MODE - Seated mode is recommended but if you want a real challenge - try the experience in standing mode.\n\n \nSTORY \n\nFlinch Inc.: The Unshakable Standard in Crash Testing\n\nFounded in 1908 at the dawn of the automobile age, Flinch Inc. proudly stepped up, declaring themselves the sole purveyors of the finest, most unflinching crash test dummies in existence.\n\nFrom day one, their guiding principle was simple: a dummy that flinches is a dummy that fails.", "short_description": "DONT MOVE is an immersive VR game where your ability to HOLD YOUR NERVE and stay PERFECTLY STILL, no matter what comes at you - is the key to succeeding.Can you make it through the rigorous (and often ludicrous) testing schedule?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spectacular-ocular.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Spectacular-Ocular", "support_website_url": null, "website_url": "https://www.spectacular-ocular.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB", "en_US", "ko", "ru", "fr", "de", "hu", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24727781743543432"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "4398437023705610"}, {"status": "PUBLISHED", "id": "26848157994804186"}, {"status": "PUBLISHED", "id": "1250708077242035"}, {"status": "PUBLISHED", "id": "1976599513238700"}, {"status": "PUBLISHED", "id": "2245388762635703"}]}, "baseline_offer": {"id": "2245388762635703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493
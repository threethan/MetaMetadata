e": "2.png", "id": "1373474487495150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825034_1373474490828483_3189952892363354563_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOzzT_IiN1YQ7kNvwHCDwJk&_nc_oc=Adoghe4JrJTVidydv7sNDJl4bijkULMM__GFiR6Z3VmQAdTBRaF1Gk7rdNSDcaoKhHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTD0PhX8eRahRALTsCWMQZeOi6YOnXAaTs2pFC4p12LtQ&oe=6B0DAFD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerimage.png", "id": "671138185570890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822489_671138192237556_1616973346297713532_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga3OUyN4_M4Q7kNvwEc67Su&_nc_oc=AdqD78XABr7NYqk6ahx0G9X-ixgI3EtVKVaIhgr8SICJr7ERiEFS1pAwxYnalLZjeAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfdpN1TSH_GXiMvrAYVCxiyNacToEIYZG29jnQMtdeYA&oe=6B0DBF6C"}, "display_name": "DONT MOVE", "keywords": ["Flinch", "Horror", "Simulation", "Realistic", "Action"], "long_description": "\nDON'T MOVE is an immersive VR game where your ability to HOLD YOUR NERVE and stay PERFECTLY STILL, no matter what comes at you is key to succeeding.\n\n Perfect for Friends and Families - Using the 'GALLERY' mode - and unlocked sequences can be replayed at any time.\n\nChallenge each other to 'hold your nerve' for as long as possible. \n\nA statement from the FLINCH-INC Dummy Testing Facility - \n\nHere in the test facility we use every testing apparatus available, no matter how ludicrous. To test the strength and resolve of all our dummies. We pride ourselves on creating dummies with near zero 'flinch' mechanics. As our founder famously stated time and time again. 'You won't find a more willing dummy - than a 'Flinch-Inc' dummy\n\n FEATURES \n\nIMMERSIVE VR EXPERIENCE - Experience the horrors of the test facility as the testing team throws test after horrifying test at you.\n\nBIANURAL AUDIO - A fully Ambisonic/Binaural sound mix puts you right in the middle of this immersive experience.\n\nSEATED or STANDING MODE - Seated mode is recommended but if you want a real challenge - try the experience in standing mode.\n\n \nSTORY \n\nFlinch Inc.: The Unshakable Standard in Crash Testing\n\nFounded in 1908 at the dawn of the automobile age, Flinch Inc. proudly stepped up, declaring themselves the sole purveyors of the finest, most unflinching crash test dummies in existence.\n\nFrom day one, their guiding principle was simple: a dummy that flinches is a dummy that fails.", "short_description": "DONT MOVE is an immersive VR game where your ability to HOLD YOUR NERVE and stay PERFECTLY STILL, no matter what comes at you - is the key to succeeding.Can you make it through the rigorous (and often ludicrous) testing schedule?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spectacular-ocular.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Spectacular-Ocular", "support_website_url": null, "website_url": "https://www.spectacular-ocular.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB", "en_US", "ko", "ru", "fr", "de", "hu", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24727781743543432"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2684815799480
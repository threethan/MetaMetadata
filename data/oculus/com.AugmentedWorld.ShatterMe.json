=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QzpgaD7m4Q7kNvwHZKnCQ&_nc_oc=AdqXHMPqVJ_xM5v7vkbeFawx7X738fGZObuXw-kVeja58yJ9ayzspUMFVaSRCzXucwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxXxK4RO0kxy8U3fCagL4KuOrltLchQo45WQ0hnMLUPQ&oe=6A6770E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzenIlXWy0YQ7kNvwFT3ect&_nc_oc=Adq8T8UoiE9s8sz_gZk-7VKl6aefu8fDcHZ499bpyOAoNUvilkh3b4tJC3zo329edUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDadxLeDxzKgGDe5sQ8TsixrCJlLULO4n0AqV-JATcOzg&oe=6A676810"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpNwfHDCHAgQ7kNvwGmxFqW&_nc_oc=Ado1hAUHXSdY8fMXseLM51G31gU3FRgMg6Abw-BjV85N0c1Ev9Vh_8TiVBGcmv3Eibs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUWgF5d0Q0TK8SVMs_WVkSa4qSkynBiEAN_-yPf9RlNg&oe=6A677777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unHbuCp4HgoQ7kNvwHHqlas&_nc_oc=AdqP4mRWOOL_MkicUhC-nsY-Sj7O6LdaRMoJ8qy1dknY-kgvEmKMR-Jkbx6h4iH078E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJiFvM4hRUY8T62WFgL9dwHn0LSprSKpwHjKgUClnCYA&oe=6A674A92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpTz0AMLSVMQ7kNvwHw8JiX&_nc_oc=Adpd2zO1gra4JNAuCagPr5sKVjNYSksthZN5GhoE60H440I4gtVtFfxMq98Xs7IWPRU&_nc_zt=3&_nc_ht=scontent-iad3-
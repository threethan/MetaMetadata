=1-7&_nc_sid=6e7a0a&_nc_ohc=mOJOQTFbakEQ7kNvwF4cM7_&_nc_oc=AdpVovYa2h1NBb1DKKoDN0ppV1l0F3zcIC5rT9e2ZPkbsH3LUupAxT6y2uwWXyBp6GU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx93UdRoqhg2fUBDU0nktKbrW7Lz1NHTDoPbKzDNkXlQ&oe=6AEB46E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCCiLP5jC9YQ7kNvwFS-gQf&_nc_oc=Adp3t8qLrs8Llun5eZV-1qTLKvf703Q5SM-X-mjMA3UOCitw1V6tyuWojkWPJFNtESI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu8PWlITfKJfAGvL9OZjUKEL7GgI6bdtFJ4byouIUeHw&oe=6AEB3E10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZMAVL8aEcoQ7kNvwHpZq_F&_nc_oc=AdoxjaaN_08P7-KA6qXucKlDb3NMG8oBvaC1xcnWYyzDHoF3R6lhEV4cou6bTTH1rmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgf1N8uWd37-z2zPwxoY_0IRdBvmUTx1WQcygTNYq-XQ&oe=6AEB4D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSzTVPIgIDgQ7kNvwEMgSst&_nc_oc=AdqMQfJxSdPZkrFxoE2-YPRAANGDNefGPdRhXjd3NxUGkvB5w5z8gf7wnGles1RGcDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaU6lRBSX-fUdgGXAPhBZ6nvKep3u0TouBsQUQf-HBtQ&oe=6AEB58D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMAYiDZ_6gUQ7kNvwEL9wvx&_nc_oc=AdqjfVJqJ18fcLg8QrjqHIpVoRnNmANkTE04vWK4tOrOS0CciGlrL100ewwi0kwn8FU&_nc_zt=3&_nc_ht=scontent-iad3-
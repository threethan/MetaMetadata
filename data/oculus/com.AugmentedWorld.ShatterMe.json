=1-7&_nc_sid=6e7a0a&_nc_ohc=7ePVhnQI4IcQ7kNvwHXNYvu&_nc_oc=Adr-1FIa2bKARUZ_YoxNEELfLzOdIbiPn0b-vq7r3CRRklqNmLKHNWB_uUFU0TgVeMY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIeBJotE0slnt9c8dSzTJI8VM-NSOZS0qeHWtAmVN1Xw&oe=69C7B321"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49NRtFBACvkQ7kNvwE09WyN&_nc_oc=AdrlFmYmPmppkxd7YlQ3koO6u0uqPiY1tubyKv7eqek70yTkmWRXiJaUJ55NGAOS_yk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy89sNBAS6mrRRq97FRo7tFvHjGC3-3RYlDHb-yy-RrKg&oe=69C7E290"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySh0ES2TimYQ7kNvwHy3kYB&_nc_oc=AdqoC0-gf0SKKixf9p3W5XYfLd8YjJsnluAuGEmJZJtrvdcgeHDv34to4M3IptI-JjY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmWPY87hRxskYPnK7WL3_XA-OOdDqmWSklYRU5Z9mE5Q&oe=69C7B9B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ILTRZSby_4Q7kNvwEmOxe5&_nc_oc=AdpcPe_vw7uouRe6SBOqVfr4NWvHztxmFOg_3mgdib_YA-_lWY3a64sksdhVFadIgp4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhYOJc6wafogjp8qdKE9jIxep99FxDtJH6QB2LTUxOvw&oe=69C7C512"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z0mnRUyDiYQ7kNvwGYcsLi&_nc_oc=Adpjtqvvk8Yxi5yfJpsK-abOldn6iWLxavZsiESPo9XIlyaJ_xm3L1BV7PC69k7CkGw&_nc_zt=3&_nc_ht=scontent-fra3-
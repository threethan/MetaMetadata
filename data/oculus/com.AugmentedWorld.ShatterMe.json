=1-7&_nc_sid=6e7a0a&_nc_ohc=lC8MeLzO-xoQ7kNvwHin-Je&_nc_oc=AdoUaLgLgysKCmckjhPAu0dvyI1sFfTfjl9qeNlYeM8wvbrzq1h4FuU4aSKaBlRvmE4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiNPURke1fGnXr7u59kde9t7tzWyu2Y64N4cNInlcVCA&oe=6AC8FFE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eaz3ROGt7FAQ7kNvwFJK1JW&_nc_oc=AdpLxHg1zsxrN-a_usH70BPdolK84hyn0FGpgMGTxSiXnIES-ZjEzze08yUOfsASCP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO7UvKL_2RzYfHWp1HwrOuBOST1CezWhfU6_tTpKXHCg&oe=6AC8F710"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84TWiDc078UQ7kNvwGeRYaj&_nc_oc=AdrqkV3hf5eUtz8EBWLkqSz3M7i5lDI-ovi52niNcp6YBzpk-fYuAXpwJN-AN4a27Ko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi_2MtQllHjvd1NLtFnBZEJoZmvcT3-ulbSNVLs1GN2w&oe=6AC90677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nomr4Pp-86UQ7kNvwFDYXg2&_nc_oc=AdqDQZxgaqVVrVE3M6asFhtpKkE6fn6Wsd9r4pbmcpCN4KzEj-QI4m3SLOeZ0eZPDMM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1koXaxZqM4Ibf_BJAnxyh7z1XzCpCdVkWJ5GAq4CBKA&oe=6AC911D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liBOL1xg-loQ7kNvwFotgtP&_nc_oc=AdoLME-qvcmUMFQcCYsCzf20uAjzL_t3AcR06ro5YNs2GITerlxkI15YAXSrclRaexY&_nc_zt=3&_nc_ht=scontent-lga3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=nRR3RgNi-gwQ7kNvwEVhAOn&_nc_oc=AdqJN7Qpi4e9M1zusyhe_I7bLfA-rZdlVnAFtpwyLas7xTH_dELPFgNuE4rWCu61ffM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoPNK7QN5Si9fEaCyOmSP1-JrEd8PRYDrFWf96hWWBFw&oe=69C26D21"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEPMNIm2R_UQ7kNvwFcVH7D&_nc_oc=AdoogKLK8eXrmCOnYRRbX7aSLGWR1WPxN_X-BCB03L47OGbOINQ-COhA3yCrq70GKrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEBs_VKwOZuRrtf1LfNZpsnJb3amTnauKovd7dhWjN4Q&oe=69C29C90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OysbZNRqBAUQ7kNvwGoTb0A&_nc_oc=Adqkxo44yBo6vq3ZwQ3G3KSRvA3wppSy0ZVcj0nVyH3G6xJzhAJtuAUFQ1L23c3P42k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBI_dODtrItSR16VAWfOk460PSPEDez8oAxzwmbJKZxQ&oe=69C273B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A26pKAltvsQ7kNvwEaBxE9&_nc_oc=AdpyMe5er5gkCNEP5Ki6xy7znxZBxkToZ6CAoqAoTxCheSzLrxzAqnyEPX5er2jIvRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUmJuLag9soQO3X-BI0hAlEB7U9J1ckZsTcvEUBYfb-w&oe=69C27F12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrp_l45LpyMQ7kNvwEtdNSP&_nc_oc=AdrRk5pWy-G5ABtZptkRGH40FnzXvf03psjJPiUBf0hIxqh-sWvnSH6M0yHUDILy8IU&_nc_zt=3&_nc_ht=scontent-sea5-
=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbk1OAOHLGgQ7kNvwFLqw7Q&_nc_oc=AdrXLqBy3XJvmuxP4Gm70wM05DgGK3AKqrHMT7hFT2BljFjrTS9Fe9RRrUVNhJaa8wI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP98_yKzbThodYtq2i6DpAoYXKJH5xboyV-yx_Bqsj1wA&oe=6AD38BE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoZgnNdzhcIQ7kNvwEi5z-0&_nc_oc=Adql5Ceo8mmbJBdQ2R2WcfrGs9nTM9BPeqd4UjqHrS7oNieTVTzZhBzSn_OEQWMqk3s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvJfWZToDJj7awkGohzdA0YTftrOSu_AGFmhGfIp2sVg&oe=6AD3BB50"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlefnYfO4vIQ7kNvwF5iFX8&_nc_oc=Adri6NhY-2fDTdPO8YXe8sXZCcPBD9gxwuJJFCgHjY_R3Ehi3yhCgaced9Q1UlLRinA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIs4n7ITYDpbBFNqMZmav9x11vx7HO3oTm9TJBpPslUw&oe=6AD39277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuTiPeU_qC0Q7kNvwHx8h0K&_nc_oc=AdqsDX-eOS799VMJbDigE1rrKNx1GmN-xPaabyZpkIb_v6HS3W_tOgLDTwtGHRwOTCI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxmZ4XI5jVMRJT2fNJ8S5R5aBWBA2HrNn0zL7N9LGf0g&oe=6AD39DD2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9x3I66JCnsQ7kNvwEYW9_f&_nc_oc=AdrhCN24COt2js0Art5Ny_4BGqImMwYJ3AGQewGaug07oBP0w8B1D-wDjIbg7igehGQ&_nc_zt=3&_nc_ht=scontent-dfw5-
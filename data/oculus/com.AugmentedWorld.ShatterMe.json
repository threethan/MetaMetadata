=1-7&_nc_sid=6e7a0a&_nc_ohc=nVmoAN563KMQ7kNvwHly1P-&_nc_oc=AdqKRuMmxBtwMHrkVU4C7ip8HBGccnQJOZ_YWWFTZ6kVRKfdsoW_xdn9EMT-xKSW6aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDd2NtnUwzJKFYjt0kvwgc5WXXsMaeGd71PCRlTIXSLA&oe=6AABFEE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiNBb_xtKV8Q7kNvwHL7H9X&_nc_oc=Adobf07jCphaSIG9f-0PsxnYXQoESZ9nkdY2hIrn3C4KTTwjb5ol5EYbP__RQCNwPs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzS90wjVeI9ABzmSs19fo9RdcOp9ueNZg2woygJNimxA&oe=6AABF610"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfHrQs1PImQQ7kNvwHA3XLX&_nc_oc=AdpG2jMvwsLT_UYB-Y0xpC_6AUw7gKcoqFh9JlR6YeYanzLbukO4PGHit-VhSLqGRto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdK-LlikjUCWhgA8mkj_kviIFu4cs0mJqA0qMRndslHw&oe=6AAC0577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ovWIOaPCosQ7kNvwE6Io1i&_nc_oc=Adp1NohigmQo5IeE8vID-YYW7myjHtFlYvtK9EaBnTIovNWKyVrg152nFOWUUC2HqEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAWZ2aEpniE0vwcdEHe1KC8QMx2QbE8KKOFqqA85LnsA&oe=6AAC10D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYUduMSMfgIQ7kNvwHZS6WX&_nc_oc=AdpyUfgSfpFoXx9vgUhX6gSOLGlem1halUMj23s8f8RhlYBOXtr3dWls7c-U4IqieN8&_nc_zt=3&_nc_ht=scontent-iad3-
L3KtraHfg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftj3j-_Wb35KvdZ0oejtvGQJEAN59gNn9k5xMPP77aW8A&oe=69A56C21"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnhQbD0084Q7kNvwEKWDJk&_nc_oc=Adli_KazuQxW-r_joR3KWilESNWkB4m64igjTn_gJOR_YmLxMoHmlyP5cZo53xeQPzE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft3QUMdYlY6BALEVDdIvfQ-KxuGRxOs0JsUhnS1Iykaow&oe=69A59B90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E66OfF3G_H0Q7kNvwFzYIrp&_nc_oc=AdmlspKUHZsbJhO6Tmg3NJhjPHSI-yU_M_AfeH2sDizac4V-clq4dadnPtqX68iv1Gk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftldrVLTHIA5w7EgY4MLA3hiyKyqm4aRn08J7ZQBTQk2g&oe=69A572B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHl6-tHKN58Q7kNvwHQon8I&_nc_oc=AdlnEHHIncd6V1eEKz3TTO4l6a4DfKFwhTGFCazrHd_cy0FHnOLoE1x4vNSoXO__b1Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsA36o3_j_-Jjd8_KWLI2ZHdDp-HrrOGprJNOzjByoQWQ&oe=69A57E12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdfMznzZJlwQ7kNvwGTYCOq&_nc_oc=AdmhVJgLZ_cE_d0_ro0IxBDzA_dspT3Tbd7lbE2PmB8KeZMUDepc8rscbO308bdyArI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afui63u2dKdQcaUjnaXEtBOc9wbq6M5DeHxKN8Sjpd9kBQ&oe=69A58F19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVmoAN563KMQ7kNvwE-u9C5&_nc_oc=AdoMCPKdJIywxr9iAB1DcAvTR3fxMNOmb6ESp6DWhTx44xdP4FpKzcC__ryS73zNQJ8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2eLiu_ACI1bnTPH-6b7LRbHiANdLwnUi-JAXQ_3W-Zw&oe=6AA95BE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvuqPssKChIQ7kNvwGzyGPH&_nc_oc=AdrWkm5joRLBLHqoGMI5oPdkUGqzs3eCD2oMVCr1aaD-etaKlWJryFlDX05d9czqBFs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb-229CT2i_2EfqBmB3OGPC1AvNKxQJSPZK6xdH8RBPQ&oe=6AA95310"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfHrQs1PImQQ7kNvwFLVxJD&_nc_oc=AdoWulNuadMhxri4c-CLLt5ZQoZ0Xs1dYKw_FwQUp6fXHydEWkEs1x6IpzqkPB4E2as&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNBrc-RdNtH7nmasa9Vg1QGmySEaiaWxrvok9_z1VRHg&oe=6AA96277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ovWIOaPCosQ7kNvwFuh4l8&_nc_oc=Adq7yyDgpQY9M9CjP3NSIFcU4-la-7VzuH6mIquHXZ1-QLH1_nGEbrNRk7FclRcGFX0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP5LLku8PYm7BsCftFiGu3KE5vTo9kihmE_KIEpQfitQ&oe=6AA93592"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qwHxbHkVpsQ7kNvwH08tR6&_nc_oc=AdrZXNEX2DdJGoDS9fxyfGqPVLrnmOzBMxnpVTYI-cex23BsjRVcxoJ1vE4DCcRKrJU&_nc_zt=3&_nc_ht=sconte
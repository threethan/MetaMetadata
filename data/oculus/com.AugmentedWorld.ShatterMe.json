=1-7&_nc_sid=6e7a0a&_nc_ohc=iguJG3n68sMQ7kNvwG19C8G&_nc_oc=Adr-fRzJwJLdDRKhHhomJlTvYgbBHkUi3bXXg5K4XziAU8VFKAmRS4ce2KLfHgFbovo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zEGwGVt6Pbkv_YQ03EIetglAYDaoBqNz5nd3WRVtNsA&oe=69FCA761"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEdHIA_Bzn8Q7kNvwEFrEgg&_nc_oc=AdppdUniolNfduNfjqxRRbagFVjH7k4W31v1dUJLDPk-_BopVJ-eVPIJTD_YZ9NF_HM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mxv5CA7cZiygP8yWXAqb4XrI3ZwV9L-GsQ6uqVq0qbg&oe=69FC9E90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKmpekEgbXEQ7kNvwEVZfVZ&_nc_oc=Adp4O8FZ_fBS9deaLyOMuP_qxK6z-6AoZSbjgP8QvAdAcVrqjHJx9VRw6BXQZ6M-KPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Eq63FgnFlP_zVpxg3GYoy3ebqTZE0tOh_yWUKDh7x_Q&oe=69FCADF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UouR3RqJRyEQ7kNvwFe-iTk&_nc_oc=Adqedseu6Dg6iRJJKwYjAlsLJic5P49SmrP6F7QPlq-4F_zblx2dFgoVv_fMLCe81j8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r3yhVUEDzZY_OYpcGsjyUJo1oQ1Qv1UQhRs52L_IHmA&oe=69FC8112"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlxScrxL2nMQ7kNvwEL9wNP&_nc_oc=AdouM0bGFge55txCECD-f92etMlZ6a2fBuhr6x8BI5hmXKgpZId9N2yQzrjOniLxbt4&_nc_zt=3&_nc_ht=scontent-iad3-
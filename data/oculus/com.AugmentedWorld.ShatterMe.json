=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgc-IxljnDQQ7kNvwFaRBId&_nc_oc=Adq8gPiSqISX0VSL_Hdd2MHQaN-5dBMrPqBivalkDLUr27XRyt0xqP6GtmqI_LlOZkM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyzDPcAOqIT8Vw7o7HFIA8QYjsBsGzEo9sy-UA_9z4Kw&oe=6AA56761"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juQqnCuODbwQ7kNvwFVymy7&_nc_oc=AdrpHC_0r5LABthkaoqy8ffqxicWQSIi11S23I8LgxvyajHyFBe_0GjmGzMYvi0Gr_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU32TE0SKVi88utkIPRL5Ggdlf5os5JAUba0GB9pf6LQ&oe=6AA55E90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdkwYp6VxmsQ7kNvwFlP7Zs&_nc_oc=AdrxY9H6hovARQcTZ1DAQBm2eVyLG5-FusHqgD-QUr7L3mLpO9JyxJwOyMu1v0h2JLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7FQg6nkss2EplJ__fGdy_WK-45TF73Gn7m4t0X7_eFw&oe=6AA56DF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EZt9Guk2boQ7kNvwHo_0xQ&_nc_oc=AdpB5Xp9QutFIe2Sz1u2qT6l_RUp8-AO_ZSo7GoJ-SmLzqJUWXpACJsg5U7Y5v-69Og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPMQA97xXZR31n9XGTHdPKVtHoL9nirZpRvjzS1nN6dg&oe=6AA54112"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGedCOZ8o0YQ7kNvwGOyGAP&_nc_oc=Adrk5DqnFOx-pIzVktIH2-AAB3aZ6ef7JZsiiwUWzqUlABfslsyHokpQiDddTkbU3Fg&_nc_zt=3&_nc_ht=scontent-sjc3-
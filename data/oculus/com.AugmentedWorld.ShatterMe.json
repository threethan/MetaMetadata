=1-7&_nc_sid=6e7a0a&_nc_ohc=iguJG3n68sMQ7kNvwEa96rn&_nc_oc=Adp7a7lvZVV-MNb-YEhZzdEMpoD7UgbwVaOd5Q_d1MOIcmfJj541lDu4gprEDjaRqBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mjMSj5qIZNwBQylSKqe8Lmz6xXfGjUplgtN7R2Vd0YQ&oe=69FDF8E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAbUXoI6YdsQ7kNvwEPFgvt&_nc_oc=AdrK2-atKiLcudhVkT2D7GN3MsyoBbBLWiyu9mtEb2c2cC6fGMEjkm5z_9OIR3Blzfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sa5zGZpTAsjbinR7OFkc58sU9kwGXcztmfJsyE_Ox7w&oe=69FDF010"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKmpekEgbXEQ7kNvwH7pyDS&_nc_oc=Adoo5FTq5-ZWR4AgP1hNfyIgtNoc5D2VXIHBddwhrVUiRWuphOhpFJkZuWV7h_3exW0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t3e5WKAW_a9FhYaKeY3tRQH4kJpzMgRDcig4gSC7rLg&oe=69FDFF77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UouR3RqJRyEQ7kNvwE-s-b_&_nc_oc=AdrkmUopID-wbBdQSajieqtbTkkv1M2g-y1xoEhVRD8fHXWEQEtr8uw8PVqwyPlF6Ks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aMcU_NcBGHSgzmquSUvsOME6FCtVB0jT20ZoGdl-SfA&oe=69FDD292"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lWXonRE29YQ7kNvwF7JSp_&_nc_oc=Adr72B69tzKl_puK113td3gB6GJ_Zs-IH12FzWWutb2Q8hzaw58PSUB9OBgBO1IC5Ek&_nc_zt=3&_nc_ht=scontent-dfw5-
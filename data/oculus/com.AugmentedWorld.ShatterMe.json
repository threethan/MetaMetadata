=1-7&_nc_sid=6e7a0a&_nc_ohc=KcXy8zP-1KoQ7kNvwHWKpbH&_nc_oc=AdrrP5FYoUBfnTZgHr44_LtQaSaM2gY1mz_PJ2UnXZ9BuEskm21-X2QUrnwF94cVU08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vrYHapk2FTY3UWFKiACbeHLDLbxLAbZ7I7ez5UyBieQ&oe=69EE26E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_eLFxQmg_kQ7kNvwEvz6KR&_nc_oc=Adrq1fvf37hK6FZyNdT6cjY2X9vcVehQ-djtukJl6hzzwVUCHheOaSXPLALwg6eq0U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qYHCLGpVwCKpcDCmnYsQmlZSoZ5NPVszFF_dno31jHQ&oe=69EE1E10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5viNOot6FwQ7kNvwFoks6a&_nc_oc=Adoz2_aWtR-MAsBEPX3W3mVWAGJzyxdzA3Z5D_mp2KVpRKwW_6tG7eF2f3t_Gol4WaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xk58AcTB0OliAWOHUNovRwk2DYRuLLCfLH4kLUEUtLA&oe=69EDF537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vweX6dKaaUIQ7kNvwFUUiu4&_nc_oc=Adp9ASBOQhaHd0nCIoGxtZS6BnGvQ1jefduJv32_885FB1p1x8d-MTwpSJo8K5Fu0I0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gfcNGEA39518_C7Au7xEonleoOysQdQphSxQ0H7nXIA&oe=69EE0092"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thkku3J6agYQ7kNvwHAYO2V&_nc_oc=AdpHLbvcUs9Z1jkGnMdbLQAPkIsmJ6_CldC0X-uR-JCvVDUAafq2czkb1JFAXsg1FHY&_nc_zt=3&_nc_ht=scontent-iad3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjkh7jPSugMQ7kNvwFCCZfW&_nc_oc=AdpYkGV2TSog2-K9YvibSuysM8SsxrfCrqlVk7pUyF6IMwYWTMQioXR0yGAd42F6Ivc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHgCfc6arxecamCEm8D3q2-FpIvJ0NEx7I7ev3WvieEw&oe=69D0EDA1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHawhQ-TqrsQ7kNvwFZRUpi&_nc_oc=AdpzjqzE_FZUm6fRRPh3ib3TxJKlW_Y6H025bD2ev5w4My0bg1WPhXETp36GdYXsbzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBcIJEqVcPDV3Cp_EAAQmsjdpR5WzkBFy_lz48Rk08sg&oe=69D11D10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hD_YA2OwmEQ7kNvwGbspiV&_nc_oc=AdpCYkRW8H2lIM1B4EeOVB5ZnYz6T_5VvJ5aDH_Hl31Kb4tc5f5vaZLDUaabCuoJbWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwSYYMKfH58Lfwu3dvnB72HzE-TGPD6l3qMCwkyLBWQA&oe=69D0F437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-mYWUdyblQQ7kNvwHoM5Nt&_nc_oc=Adri-vx3PxYn4Ey48XQ3PLsGzPXi6cPBO10_bK59HEcGGi0YEFTdQMEZhhuQPYkgPkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ-xvMFnjfoZ8jLInm7zhswthJfIOL7sIOsgufI24t2g&oe=69D0FF92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVzFvtxNss0Q7kNvwFsw2fW&_nc_oc=AdoUUxGA5ftk8dCI6NbpSRVBabxhYry_AWl4v4xLs8Zg7p0sOwF6C0OEHrezyMUuSmM&_nc_zt=3&_nc_ht=scontent-ams2-
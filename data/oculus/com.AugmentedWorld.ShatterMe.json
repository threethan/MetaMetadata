PygQ7kNvwHoAylj&_nc_oc=AdkjJRlXYZXPMUJNCzCofT6nJQD9YBR6XC-tFlxbSm2oK7E5NECKs8L2WgdXGUpzyQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYne6C5ljqKDEmojyYKg3EFbGTdMX_PI5q2lMtVNF0pw&oe=69B149A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wounFgHr-UAQ7kNvwGQ16Nu&_nc_oc=AdlGr3PvHKyWjlCd6FzxET_YVKUE8fr_WQZpio0SEiqu1lJMsR3cnNTnJR6NG56BTWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjREpKnnAEYV1mA3YhkgWNQPSEZjEAux1cM3g2XWbxRQ&oe=69B17910"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqD1m6rWZNwQ7kNvwFHUt7E&_nc_oc=AdntOVe7FBTeWe_3SkuEkKKOjkW2zl8LGk0E0YvY5T2Pvo49U7OPH1RnYRuMY41r73w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfAZ5hJYo8RZJ5WXVA_8ttDJyepRnJBcCZxoOqr7FQzg&oe=69B15037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stg4IR4phT4Q7kNvwFuZJgq&_nc_oc=AdnCq3w5SFFkglf4vttFjh-Rliti0p84TbiXVS4-ukSYLarhtBgFIhQ5Qaw02edz18o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfdJskpfn6Z3Pxffz6JaoEU5uxS_1nLEYR9iFYrxnoHA&oe=69B15B92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUhPMBp8lhkQ7kNvwFd5dZS&_nc_oc=AdnvJ_rd0KkfogaMXCy46eGwWeoBsFAJY8UUc3sCDkp-C_OS3p3VgFUkK_5-DnEqmDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyclRo_53i16Otc1IcnH
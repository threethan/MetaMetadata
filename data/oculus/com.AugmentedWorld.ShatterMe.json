4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkKC9jE_YFEQ7kNvwHjXcGX&_nc_oc=AdoL8CgwNIV9W4cXy9mR3mKMsLIn0S1vzGFM6plp4-MVAo28vJne4D1FqvNm8-2LcTo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhEEP_yp9EBI-RdkLZsk8KCbr2YP2C8HMSyCbGgnSwGA&oe=6A7DA221"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLIKgv3OPUMQ7kNvwEvicQr&_nc_oc=AdqyGPsceJbdsKmNqSsDEIWmdCoya4AjbJEYkx9ds7wxxycrjZI_70EpqfN6OJ1YZ5U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYE801AYTTKaPoB4WSGCb2HoH24FJ8o02nhOpBWRX_BQ&oe=6A7D9950"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl_PFx5ltD8Q7kNvwFwVpwK&_nc_oc=AdoyH-AaS04fBCvYgt5loRBJ_5BP1bxbcaQ4Zs1QZggCZmnPGtfgfKFTeHhz5hFQ-YY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVyxkBfknzb8KSqFxvh0LJdlQddhRbIZD4mvsm62EKLQ&oe=6A7DA8B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztoydydEAVoQ7kNvwFya2Db&_nc_oc=AdoEm-ph5PXlbqTuyLqtVgmViXz28de13-R-hLBU50h6Opja397dcSYoEvCmSYetXRw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYhDOSTtJnCyNYf26kAPYQ216g8yZom8nc5JSc4xY-fg&oe=6A7DB412"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elEbpNai4mIQ7kNvwEmXSPO&_nc_oc=Adq_UfcDmHEyA8XSgOm1BdxeXz_uPBySxlOJBrZyCOJFcA0m3NXNA82M8w658NiGTkA&_nc_zt=3&_nc_ht=sconte
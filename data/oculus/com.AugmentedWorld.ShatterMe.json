=1-7&_nc_sid=6e7a0a&_nc_ohc=ty8NJNRCAz4Q7kNvwHPna4P&_nc_oc=AdqR7HMfKWX5vl82O0GI3vgZ2ZakIelC7KYtAEEXVjrghNoPWIVU_EjAFMe6jKJmEjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_VrSa8DONuaHggcv_8ayATQ5kuQQibnjJfmbw6vx6PQ&oe=69D390A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JpvioRlF8wQ7kNvwHg0-Ov&_nc_oc=Adp7vDpkLiyTdDN3eLYA1eBylG9AXeWDhZI43kpYtANkQWyb7jC1A43_WWsTzAc9isU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RnB8_PWx4fqKS8g-vUR0xqkn3dO7pNWh8tZ_yZDpVzg&oe=69D3C010"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hD_YA2OwmEQ7kNvwFLzATO&_nc_oc=Adog5cp3kszA4i3EhBhS8K-zPFzwsrHTiPmiZX6IVFU1U5lN5LgKXj4m_Z-hkiuYt2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K599hnC6L_vIR-zQuJkczS7CQzBAIKyxdWlrNGne-oA&oe=69D39737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsOHlghvZaQQ7kNvwGgLno3&_nc_oc=AdpiYwHTE2GsSReIKzX8LLo9OZvveaesTAS67NhIDg3Dgd9qYV-qsb4Ez1WnSv_3LD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m5ziKb6Hv0BPK4aa5n1Btrsy6COp3v4vxs0_f39XEQw&oe=69D3A292"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAXltczrxjYQ7kNvwFNLpjf&_nc_oc=Adp_uukvs1O3mDw_m-8ttyZVkUQgZtZUvSZBX45n8--M0HXJPItiIFLOLDiQ668vwOI&_nc_zt=3&_nc_ht=scontent-ord5-
=1-7&_nc_sid=6e7a0a&_nc_ohc=nssOxL_o9esQ7kNvwFWnNVR&_nc_oc=AdqcWyFx8PCAYG9O4irvE_AG66MvJtIkqxznKXFWJqJZZp5bKVlw6czCkfcyr_FFz4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KaFDdpsPYWEPfKLL0Ycxkk_yjfXW3yoPBRa_fGLXwoA&oe=69E78F61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqzr8LksKXEQ7kNvwErwCPE&_nc_oc=AdqvVZOWj1GhSd18Ch7ms8gsR_1sauqwmt3oPRUzBDi8hUELON8XniL0BJVIkcBzg-c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZXlZzEwSUBj9GcGdm100D3WPLAh27CnO2kD4jnvf1JA&oe=69E78690"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3Xwjgbm3ssQ7kNvwHSc-1R&_nc_oc=Adqij0bChnSCByG_vx3JEnAnpBcUgnGS5Uy_voLPDOpnELRX9qjLAIVbOmBIRUC3nsQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yxPSjOJfOR0pNkqzbfkoiae6rj55pU03rCTlsaLaCew&oe=69E75DB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA9ihGRuPG4Q7kNvwGyFeMo&_nc_oc=AdpZnSbc7-5P1u12IM1fybnn-s93SkM0IQZEugsY6SJatKagedekoY_Ktqty9SxvpxM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27mS0FTeJHoOigASiL5DU4m_AMd-IEHoKeJBJKj9tUyw&oe=69E76912"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5faMhJb7NNMQ7kNvwGn2CYd&_nc_oc=AdrJ2P2KWyAFm2fU8xSn1O4rZinuL259t6Pnjx4Yz0JRYsGdMFU2mVeYzsiFOXaZWMY&_nc_zt=3&_nc_ht=scontent-lga3-
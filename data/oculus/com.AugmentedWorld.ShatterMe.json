=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgc-IxljnDQQ7kNvwH_K78v&_nc_oc=AdpKxp1uIQtnKRkPKcGVTFVI_T9QXE1d67LKMnkBwJx6GBUdQ-eWcaTjKWrNThnNknA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0HM2tTV87x0lyV0hBZ5dJpIHTIS8ogbVBo97EbG1xvw&oe=6AA80A61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvuqPssKChIQ7kNvwFNoM-_&_nc_oc=AdokJ_MQJLdkOL4JkUCzZPFn1dCAiR3JObN4Qmw-5dLID7nx-w9kGuCg1pWAXKxsf7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2gJVBLOqSiygO-tkOXvnQXyilpbx0foUujGJ_K3xWxw&oe=6AA80190"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdkwYp6VxmsQ7kNvwFpFBWT&_nc_oc=AdoRfaOrarM50SaViu9IuNFy-t3B6-ms-Uih6WK8cJw2fZdPtU5m3ofLU92pfZyDSNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9G4uIOSg5ke1kZ1j6ZTdaoig6jx3kcJC1ylO7dk574g&oe=6AA810F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EZt9Guk2boQ7kNvwHH0wSU&_nc_oc=AdrYNDyCk3Unz6kU70-CMBRUVFhRhIPQ3oTO8ZBXAxQY50x5D_9TulcXKKSzGLa1v20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHDQkbSpbfzVlheJ7qxgvQKziywJRjM-fopxmxZwlyiQ&oe=6AA7E412"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qwHxbHkVpsQ7kNvwGy4aFK&_nc_oc=AdqdC1y_adIqLMuPPJfSJKNcIqTMImuhdc-z49DFAV9KXllhhXEyR_dw9ln4c-Qhg74&_nc_zt=3&_nc_ht=scontent-iad3-
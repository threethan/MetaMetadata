=1-7&_nc_sid=6e7a0a&_nc_ohc=ty8NJNRCAz4Q7kNvwF881jT&_nc_oc=Adoo3ZhoJkpbyPaJJCYUPYLq4xe3NBIsNzdeVClCeMVyEUvFhnH8WXUgWTkgibyPaX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I6l4Qkkk6H0Fp3XJcwQmLubakeT9LUaLKv3SYwO_JZg&oe=69D633A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n04hloHoDcQ7kNvwGrC7Pe&_nc_oc=AdpzpSYsCbDw_Oo_vlZbJEw1g_kh-9KtJUEU-mfKnuIKSN8RG1Kg41sDm4B0_HXlfVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1COCHR2l_aMYrc1GIIPetje379JGlRHO6TCSHmkdaVgw&oe=69D66310"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fguJ7MM3t90Q7kNvwG9NGue&_nc_oc=Adq2qvVK0RiTveFiLc0FzLaHYS24Sb3dW7yGOReJmQnSjqqMD7Cuptx_etRLaZ2mI6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ivFGZrVQJHj5SCMjXqQ2WqNVVu4yOKrIngSYoM8qkBg&oe=69D63A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsOHlghvZaQQ7kNvwFWOMQX&_nc_oc=Adrh1Lp5Fnlx1iTJVvtRgmmCthRGG7DLhhR4hOvavQy3vczeMm1WLWg--vkOSIn3r9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fXRWNooIl_l35UMyu7hhL5rWIhBXsXPI9uYR2HgwVZw&oe=69D64592"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m7RajN28hUQ7kNvwE8Fxtp&_nc_oc=Ado9qgL0TWY3tKbvC-g_DJCRjWaz4pL28paQWC80zc3e9mzoS0Fv3speII13f9iZ-gY&_nc_zt=3&_nc_ht=scontent-iad3-
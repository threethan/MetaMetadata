=1-7&_nc_sid=6e7a0a&_nc_ohc=hQg-_ZI2i9MQ7kNvwHIUPXA&_nc_oc=AdpX4Gs3iT6e4u0RY1LmyuIznm5_BIJVLmMHXWwTYkAUppkFVLppJ8TQSmVTMKEXVFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS5Wg6esf3ud0E2RWE4zYPqrgTp7anzsHplQ2gIgSZfw&oe=6AE4AF61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0reMWdPzQ6oQ7kNvwG0FY9q&_nc_oc=Adqv3Ls1FGriFNqlK2h3_Yo_aGZBZnqh_Qz4VgXuQhunAR30lt0Buz-O6AFu94y8z4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP31NDKXE2RTetY2BuvGuGZRV9W820B34ZNp2OgwCMvTg&oe=6AE4A690"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-6-l_WY9GAQ7kNvwF2csUK&_nc_oc=Ado0OjAXVtKTvKoP0po90PMAxMjmc2VaZ1Vq2zS26A1PYFoRMcUOmbbQhy5IcF9C4EU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzv3sO-REdEeWxLfAkJzt7Ki3lOp8188qQbnipivFCLQ&oe=6AE4B5F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRksSISEFqAQ7kNvwFx37OU&_nc_oc=AdrN1mPaS-ZfEw8H9DuNOoui967ot80B6TU9A6XICeXflN37U7_Y7_sRl8ZvY7mebys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbLN5LDeuvdsMWIG-D9JdJcHRn38j9JG7GVyYB3Or6gQ&oe=6AE4C152"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWZ_3dEkOBUQ7kNvwHSufTK&_nc_oc=AdpWBajtjiOUV0ZdAVB6cvt2E9Dm3aQt0Hc5Xv8KyvUBKujHGA5xu6G8QLJtJZUkahg&_nc_zt=3&_nc_ht=scontent-iad3-
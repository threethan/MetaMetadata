S2wQ7kNvwHnRLCQ&_nc_oc=AdkMFnXn_dLCL3-U_3KNzTJaCfi6Iieu6F2X8Hg8X7Y1kECzZAE-LhyKtsEEHYjsO1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIaWmJXPk5cS18uH9bwxsJ-nf0PBjdcoAKi6Ehgtvk2Q&oe=69B53E21"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc-9xCCduwEQ7kNvwGK8Ivf&_nc_oc=AdmiHHRlYeme1zCAkl5zRNrUNEoY1TuV2JyU857xcpJEuz5A8DOPiFY4yj7l5-_l54g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwG4lwVUv4PW0LCZakQoSWWVAXNX7QDTykg17NhNrYV8Q&oe=69B56D90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoKAAbx1ZcUQ7kNvwFpMoAJ&_nc_oc=Adm57vbS7rBbEWi9cbV82fh4kC-W0H37D9YoX8Sdtp6wyb1LCY8GEnB6CSTRaLyt4P4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2G_a94gUiKtb2V7CIP25JYUS7kN-mlw_wqjLLxjxNgA&oe=69B544B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWq-iIJt-xMQ7kNvwGxXOsA&_nc_oc=AdkDaZ80xmR0HW84XJW2TZYviTztM4RXBGqXY7jU46iJNFQxinR6ukaVsxuxkedJ6NU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCBhbMqe-GyGFol7HjZJl4HZn_syaKusqcQoZY8rm9aA&oe=69B55012"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOPhsgyeuZkQ7kNvwHyrr_Z&_nc_oc=AdkLc1es9wojo1fRMwhIZt2T3aNJTNE_3R5iy4Fih9iJrUqzmTGnXZXMMma7yLL5l0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpxiqTtTyiAHK5ovB6Q
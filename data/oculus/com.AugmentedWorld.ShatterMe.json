-w&oe=6A8D6B50"}, {"file_name": "Screen5.png", "id": "920899901960435", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031458_920899908627101_3284581321115754687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgAEaHM5IPYQ7kNvwF5kO-S&_nc_oc=AdrBtYuFFB4kIVEas3-OX-T6px263XAAZeKA51OjWIl2E2Oveq8KSMiX42Az3buSbnw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFPJFWy3gPoNYXRrq6qJ3QojTT6fqjbEIYyXdVbySFvg&oe=6A8D79C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1414812452370639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974593_1414812459037305_4441829631623283258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCMxsNzgopgQ7kNvwH5TYUt&_nc_oc=AdrWD1z8qKcp_M2gmiXrfRt_LIpPV7pnF9sabyPq9yHyswv7_PikInrlvHfI2MU98eM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcPvUMQWIwYdXtVOuAVaLOeK0McSH7HVUxJHSuh9KTZA&oe=6A8D6E80"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy
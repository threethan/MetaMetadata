=1-7&_nc_sid=6e7a0a&_nc_ohc=k3b52xVrNQIQ7kNvwEshB5x&_nc_oc=AdqoQa2As8swD3KDnXOeOfj686Tm4blYeefv8OQhHrtiTrjIqIZ-HhQXAxGSzaps4nQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tvJrM0XSoamYsVKUsWmuUBBxkJihQtkBvrvM5kpgzmQ&oe=6A106DE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4lq6H8MyWoQ7kNvwFsV410&_nc_oc=AdrhmYxpbpxqQuwsS5hd1gv_qWIFHHGYy8lG9e73WyrcWQr1vH2Ok5Da4wmjycUR-xk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QhbDq8e8Q5qtnTfNJvA12qcdILsYW459NZ-j9aU681Q&oe=6A106510"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmheI3THOnkQ7kNvwGBV_MG&_nc_oc=AdqnkA1AlhtLLJJXeo7Iwf0ZWOEtsFBZNB2mCwnWFRw8lSy1kxnWBGyyK57s_m1OrkM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OV36arZzc3cJ8v0sVgH6VOE-vGtqORaXUTFE0jJUFRw&oe=6A107477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMu3yI_a6EcQ7kNvwE9LEI8&_nc_oc=AdqdyuOid5l3A8TUMZQWesZROb2xAngOrrij5RajJ8_cYhzxZN1e6s8KkriC23wPwAs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bVGl92Oee5jdl2YSPYGJnzrnQ9qZZSJIFJPQ3kTpSPQ&oe=6A107FD2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=732MP4CS3-oQ7kNvwH_PbD7&_nc_oc=AdpWqQo5_jRMZTmIl_withVkyOwxetHA1APev7kM_ahcYw6VZj2rWD5OkOVd462SUlk&_nc_zt=3&_nc_ht=scontent-lhr8-
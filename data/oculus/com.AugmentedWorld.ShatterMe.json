WIbN9ed7oI6YKyixEoXMnkmCJsE9o768QIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2nUHFF3-7dC9e04h0hHOcku175trYryh0JN-rhpd2kng&oe=69F21B61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKDu6Sbh6QkQ7kNvwGLSPyQ&_nc_oc=AdqbSwit7Ak8IQqrqWDuTFENbh4ZQp4nju0Z1B7uWGFBTSRcZYsfLJaJTF_E7Sw4Fhc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RF5qcltrJ7b1-7a-Drv3YBJE0Zd9nfg4JRrHNAZ-OsA&oe=69F21290"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmtboO9PCz4Q7kNvwHzMJYx&_nc_oc=Adp2YOgBFpWC_xVKu7oFbA2oyl8m1H6lB2UyPVoY-N6w22nGE3gInab1BpNLGz-wKqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01SjTzgccJVUAj7iPshykDPejlzySxqyKoaOw4it4JMw&oe=69F1E9B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAACB_4ixzkQ7kNvwHipTn9&_nc_oc=AdoJcdi1liMEUy8wajRuvmSyJmxF_9HpvyztcWumHAi7NqKmi2w-kSpLrY0g-7aejaE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KZu0AsIU5aKeHzbJCSNKKPYlwxSXdyER38UwBo4QEiA&oe=69F1F512"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMcoV3sKKowQ7kNvwFAjLMH&_nc_oc=AdqwvGwQbQngLBaugaHFBpEuAw0JT7Vqxn5XDIS7ErzfMKaqjiTYGBr8Wo7kPNjv8W0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zijI04LlX8Tt6K9bORVeBqVNckmVCSswnf_z8-QNtag&oe=69F20619"}, "is_con
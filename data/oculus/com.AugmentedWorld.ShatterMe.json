=1-7&_nc_sid=6e7a0a&_nc_ohc=KcXy8zP-1KoQ7kNvwHj_jG6&_nc_oc=AdotnmVqbOn9RZnoaeMreTlcC71wq9jbkoeJXixEHjteh-nd8HUFcLGfjzlxMal50DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UJ1WLVUnkwCc7tTFxOAl1Ipo-uMMAsZ709dGBI6QUZw&oe=69ECD561"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxbshS_bujEQ7kNvwE9XbR7&_nc_oc=AdomV98y7uwjUWmMKs5TtwQnYevxinMnCuCiOhgCKFwWIOOtNE9Vn0B-o8CawQi9J7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10bmpD9R6PuCT21lL4-F85BumhC2nIP7O0-o_L5XVnsA&oe=69ECCC90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5viNOot6FwQ7kNvwFdGTN3&_nc_oc=Adr5A1Yi9-CZECQL2RYZc1JPw7x5aNj6dpt-b2vF9biCs_1awmdXOgEynRQ5s6t7L8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BBrQ3yOW_E7m7ZcDJ_sZNP2_m6rsaSx4LqcVyyJpdfw&oe=69ECA3B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vweX6dKaaUIQ7kNvwGvhzX-&_nc_oc=Adr3Y73bvNEvgQrTOKQn0q91jDT2RibAIc_yQEjpTZmsa3r63ma3GD3SWMxf0bUVrJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FqULoaFJ62PsfidVA7jf_CLf5VLcuUBjp32JMOEoj9w&oe=69ECAF12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grCnoXNe90gQ7kNvwFNT3PV&_nc_oc=AdplTpir3ZzMNcEidnakUMCngXkFiLJwRtjSAIK9bLWAYymcDFcsjTabUrSN7KpQz9Y&_nc_zt=3&_nc_ht=scontent-iad3-
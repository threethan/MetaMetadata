4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3b52xVrNQIQ7kNvwFKmUUu&_nc_oc=AdoyoOwjfkZQ8gFCmZJZQ2FBYyprsxe_5HEcnKGXqzjo54tSSNOCmlxa0hpnpYUPoEM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_wFI0yWOe7L1uQsYT7lQ2pjC20Pibn6qLqAmjLgbTjQ&oe=6A11BF61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOkKlQV2fgAQ7kNvwGzOFOU&_nc_oc=AdrKWkTKpIqP9b9bO702ZIV57k1nG_S8cmqAkgBW4Esxkwvm3cTdCFvTUCMXwsTAXdw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oP16uvdkaZ_Kt8sF_aXqhZH1DN0Q2n-L3WMbFW3kqtg&oe=6A11B690"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmheI3THOnkQ7kNvwGgKM2W&_nc_oc=Ado0QHyL6gl5C_enr_FUOt7F9Sa9x4LcWHPnQGc1lvtyJ5_QX3sFTDjy5hTl5m5mIhA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WjtuMkzUQ6CAvl5Y2tk0O5cPTk1_-czxa6-UITlKJKA&oe=6A11C5F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMu3yI_a6EcQ7kNvwFwMC6-&_nc_oc=AdrXWIdEJ3ilH06mCOJyuLQbYkJzp83G_ziIpUI5mIb0vBXsJLlUX3dbBpAHb0VXLp0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CiS-10et2oGMJRS6yMax7gQEzLVs2-a4rEU9Kr8gD5g&oe=6A119912"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBZxV74St4wQ7kNvwGNM2BG&_nc_oc=AdqOPZ3-f1apmRRvMo1HwPWddlHKuIIwRMqSjzJ7Oe0HNiAAMAfJ4p1WyIg7x6kcSkE&_nc_zt=3&_nc_ht=sconte
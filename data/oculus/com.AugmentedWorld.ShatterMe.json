=1-7&_nc_sid=6e7a0a&_nc_ohc=KopA28WLfnoQ7kNvwGgWy27&_nc_oc=AdrgfxZpjaTgyizQfbiNSIsuIcfERE1BzG2P3O3CfAxWPf0VLhu7hF52jzjxrRWgbPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNUnlIhxE8IzSfaU4uXbuK0Zwhq4kFdy7R84B7G458cQ&oe=69CBA7A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSsc0ivgXIkQ7kNvwHopL98&_nc_oc=Adr1jlMOyz-MwNo2I2cIlLfrSrqRL1K-NGmjy8fZ2_f_7-bzHlY5kZqI32Y1slWbKVs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyZnP0gWLEyNlegcy_C_zz3tBG_c9CTEuLxXzhgOBzgw&oe=69CBD710"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcu2PMG9-PsQ7kNvwGO_28o&_nc_oc=AdpVSaZ8Ub9HAbMAWzWSaXlMBZxBSB3GQwxf5pIRhBoBkSoBpbsjoRIyz88MGi-0p0s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM_z2Cg7xpQxLMSfTs3jnORp9ozWuaNpYMV31TCj3zyQ&oe=69CBAE37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R__2aJIQ_ykQ7kNvwGglJFv&_nc_oc=AdosU2bQ8NUE_dzdjf9kZPC2bd85eg8SJm1x9EtPJ9F-3iXLotxOSpobqfLUuTL4o1I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzziRqFsE-7AgyHmMmvanLj58fViPX1QtwP9kLdmiUZGg&oe=69CBB992"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGuibsOB1BYQ7kNvwGt0M7N&_nc_oc=AdrmwF8HoX9736ZkNJlno4hvjK0Bk4YE16cWnifNIvbYJpRR7d7x1TlfswR15xNk110&_nc_zt=3&_nc_ht=scontent-atl3-
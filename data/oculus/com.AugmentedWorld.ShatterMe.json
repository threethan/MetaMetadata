=1-7&_nc_sid=6e7a0a&_nc_ohc=qZZVV9bmUccQ7kNvwFEPija&_nc_oc=Adr6IzkugRAmoVk85zbhfr1zbdRgp1vvinOV609qEliIu6qucVS9BGm2E2aNBBK1MjU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEaIYFpvOJC6FgdTlVX53cgFgb9QIbsNnO6MgZ2sD4IA&oe=6A5A41E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qanO7arTIg8Q7kNvwEhYN-e&_nc_oc=AdoEokc-yHvnkNKtPDmtc1P2QwPAeDWbChisqhakXk43sI-5keCOnQBcjotviOQkoIc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5uw3tO8-J8zI2wiXs4-NTY3ytrIjaTjaKYQejn8Df8w&oe=6A5A3910"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idza2rjwWhsQ7kNvwEtd4Jf&_nc_oc=Ado_HWC7ER0aKCUxjqtm1TmmvPLgoUl0iLk4j9g962xH9seWAmjbT3rdSGV9t9XVUEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0QEGkaLdhoFIOISwYj_z7Epox2ku8yxPoLXQ4wIs7Yg&oe=6A5A4877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18wGpkjSLTkQ7kNvwFd42Nc&_nc_oc=AdodwQ_z5V5F9r7jvoedx8Nx3Hknoqwrtbj_b8mHWGVJ0hYLdPsKmW7T8ewBbzS2t2g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCVfZHaH1X99-Zu-v7qrEtKZbW64EAeWQLINF5oWPVgQ&oe=6A5A1B92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR3ktWpUh60Q7kNvwHQTYf0&_nc_oc=Adqadmjr9FdN5MjJcxO4qmtR_xuyv4N9fpTJEthGZYPhY0t0h0cL3a3ujQdukrjvIJ0&_nc_zt=3&_nc_ht=scontent-dfw5-
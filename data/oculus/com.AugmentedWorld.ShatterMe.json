=1-7&_nc_sid=6e7a0a&_nc_ohc=mOJOQTFbakEQ7kNvwGYUYLL&_nc_oc=Adq7qTZbdwlAJxknK0dt7QukplRyyyRbluYwjtzAeEqS9rQmVejmlAuYPW-vpGF8xnA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOg1weFQEZ_wKQTac6_vhn8AIplcN3NqnbX9nRIzrnCQ&oe=6AE8A3E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVZMa5L5MGEQ7kNvwHlVjvM&_nc_oc=Adq6jLfJBYwK5kJt7TSPcNGagn1Q1Ul2mjM3VVMSd6O9syrsaX8uY_M0O-kxq_s263o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZACcVobU_2Md6Tt-YHkYFjzIXQpOU_Dm290ABLppnNQ&oe=6AE89B10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZMAVL8aEcoQ7kNvwEWhXM5&_nc_oc=AdoqLbRX6TjfH-oZlPVpTbFl3XfoVIoHCTyZXHlxZ9_CxD-PMkeEn0PPqsOy_sAu0xU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZSMXj3bDC2-HRPA1c8o-XrsFrjNfXjIM31g9STs4oQw&oe=6AE8AA77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSzTVPIgIDgQ7kNvwH2dm64&_nc_oc=AdqMYfGE8NWzH0JVk-zE5yV1YfUQf7I36teV8keWHXsbDSWHo59p4WRpGO5r_nLHkCY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5UVQoNGgskXftMops2PRT41HoQlPlyLDyc3mPGeNYBg&oe=6AE8B5D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhObJWdPW1kQ7kNvwE-NGOu&_nc_oc=Adp-osEs6OskLD4xOXTkep5Tse69RqrhiZ1h9iDcnVGnlt0Ki0C4gXzZXmoP9XJ2yVM&_nc_zt=3&_nc_ht=scontent-lga3-
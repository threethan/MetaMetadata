=1-7&_nc_sid=6e7a0a&_nc_ohc=1T_7UMSJINYQ7kNvwEum2kv&_nc_oc=Adq8r2uaz0FaLAIHtrfGj0TE2uIHcGMRbXxj82scorgr5NIwaDoXVg6g9dTOvJq7Gdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUKHacuV41AjG4SMFOrJLGgGP0R_839ruwPbE49Z3U_Q&oe=6A4A6FE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HalClu2lLjUQ7kNvwG2kI_O&_nc_oc=AdryiAftiZsCNseX_lE-7eSYnIGwBlSFfn8uaB23ha9AEB8_vgitKNinRhxn9ExWJMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhH50WTyxgQJvuS-loDdJ_OaQTOgqLKwIAendBwA3x9Q&oe=6A4A6710"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy7JAgj5RgMQ7kNvwG_dIDa&_nc_oc=AdqxPBDJJFSgpLDeIDu9Dd1p5r16JVRqdLUgXcbn3Px5UhmTmV497q6f2GmIv0EJNfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv-TB5FnjkNhzmhwwIID76E4Q-MjRoYCxe-w6usfEVAg&oe=6A4A7677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVlcECHP8PsQ7kNvwFr0xcz&_nc_oc=AdrJ0hVxY9OSFIfu_l6qm0FI1bOCN4rexFA3bXo18JyLRjHvv6T8GJLjRE8rn0j6kIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChmXQkoDLxcZRxHaJg4-FgMY3MsPGg7Pg6frOfxIfuzA&oe=6A4A81D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KFnTP4wEaIQ7kNvwH0jtb3&_nc_oc=Adozt4o7epfgP3sY1kvLHSyV8dtd8vdn5IsYhtYNjrLJD4r1yxdb-mS8yegb7P_EFCU&_nc_zt=3&_nc_ht=scontent-ord5-
=1-7&_nc_sid=6e7a0a&_nc_ohc=lC8MeLzO-xoQ7kNvwFtwNUc&_nc_oc=Adq_5iV5t1fz52bwSLc4msMbVlVrt4ZGT1d0opaxpIiEKyJK92X0h-QMu7gGpAbpAUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa3u3jLdm7kt5U_8yQrL2YWgUFpnmECZL0Jabop8zWTA&oe=6ACA5161"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eaz3ROGt7FAQ7kNvwH2aLRu&_nc_oc=Adr61SUFMAR5ptBv35jWNf1SYIc3S1gxKCbDcoTEj_gzTBUoWXzO0TefW1ixLgL_FYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRlD6HJm9pOoC-lmNvehSxeBX_87NAH8tLbpdAF45W_g&oe=6ACA4890"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84TWiDc078UQ7kNvwFx45Ar&_nc_oc=AdocVDb9sVSq7r5p6esraA6eBnNPmcZG0X23XyJbVOZLpuxN9M3I_q5uGisbEA2zMOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQLEtsdTzEYPB5sfavV3odYjQQzaOLg7xhNpIqRoi1jw&oe=6ACA57F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nomr4Pp-86UQ7kNvwEx98Jh&_nc_oc=Adq5oKI64dS7-e_2t2B8mlLuW0_8qIXqbbk8R4zEPY_v80y3mCvSKttF2nOGHeM6g3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgypgpJ1vpdeL_mADPfrGIknD2a0cIX_Y-u6gI4s2UlA&oe=6ACA6352"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liBOL1xg-loQ7kNvwFFlm4k&_nc_oc=AdolFsbGosCaD-ixu-E5HLeNcAJVt-ndvlwYvXzcXe7Wk__eVCySQzXISy9L5LN-YZ8&_nc_zt=3&_nc_ht=scontent-ord5-
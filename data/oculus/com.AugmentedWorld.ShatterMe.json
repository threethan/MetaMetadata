=1-7&_nc_sid=6e7a0a&_nc_ohc=V1o_cMl4dFMQ7kNvwGfOv8n&_nc_oc=AdqLOU6DTkh-jKwJjaGHXLNisGHK8CTJ0yWB4PHH0Jn8QyiFv2wBbqT4z6kDpVJhDXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vryP60wfy2Gbo9sxC_7Oz9sKbesvdYs-gNCTP__FnNQ&oe=69DA6061"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuOkc_kPQ-sQ7kNvwGXgZvj&_nc_oc=AdprCv9DIOjcW6JvHJzSYOe9YBergsf7XgTqOBOkxU3Q2e3Yv4Vt0cYze1vbpc_wseE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2shTcVYVK7iyhLoug6YF8ZdNXOROx4TwWTgIf8uAF8rA&oe=69DA5790"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Fl_E5OkG0Q7kNvwH1YYha&_nc_oc=Ado5mBj9ist1of2KRjy5SlB2O_-e3TaRWJIlnaQhxYXxvGG8yDgSsQB5elLMVxv1a3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YFZ53KzGQOuMpI6iQ7GxxD1yT2yIjGYOHtNICEx5Dww&oe=69DA2EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLREdRg0gaMQ7kNvwFAknOx&_nc_oc=AdqkLPMlXIMpDgCJ1LOhyUMyoNDNKrd4W_QaSyJ8ERehGHFc8R8BAzkKYbw1kEnkuOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jHyGxJQ286QcgSkbj6WdF6rYY1-JGCzkIK1zLNIItWg&oe=69DA3A12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTG5pZ7k_w8Q7kNvwEuZzqj&_nc_oc=AdpdLfrKh9WzMqRiL3DSWq08tw2SV0Xi_zr9b6vwSLuQjW_ky5dQrpki9UKrXRQ9tgo&_nc_zt=3&_nc_ht=scontent-ams2-
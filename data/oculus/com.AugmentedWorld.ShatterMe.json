=1-7&_nc_sid=6e7a0a&_nc_ohc=evivzB5Xh98Q7kNvwFfwonp&_nc_oc=Ado0ytG1vzuwA4LvwBrK-8ZKYx9ETGRHYxica6PenWAPwx6-LgD1PZCCWGH-T7_v314&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T9OwI-uTLzuvKYEWSm_OPFoJOJ2LF1fBdEE8miQDkKw&oe=69E4EC61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zETysd-i8EcQ7kNvwEvA834&_nc_oc=Adrz6hVcSuTN4aoMVyQ8NnRpQSPlA-NdLPce-rBwSIlk8WIs0P4COqNd5rpLlt0iaF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02Aq9vjmBjEPVo8O7IDmcVaA93dny0S--8Ms1es4bxkw&oe=69E4E390"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3Xwjgbm3ssQ7kNvwEeTPtP&_nc_oc=Adp3Sxeqa6cpnyk5KI5mZntJ-nUncKxSs50J7JUwG_df1kY60YJkMyGTmIrIGrOyqrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ivZKMZoGYR1CkxkFg5f028A-XR6EQhPPD2MTfA0w98A&oe=69E4BAB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ5NOS_EBuAQ7kNvwHJFr4v&_nc_oc=AdpEZkhOrLSquyv19o4TCSI2FkS9Uww1Hp9OVPGUQgDgpj0ubvV1meCnfqt3QIPKn4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LkKdq57IVsMNgJv4bm_wUaV6DPUbozlFoQPpjA0N8SQ&oe=69E4C612"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msQrDgL7H0oQ7kNvwG5sox6&_nc_oc=AdpR7CQmZ-0u67Woazvmt8vr8gCczwsssLV74bP2uGne5_ej_uiF9Oe5qVE00hmiScw&_nc_zt=3&_nc_ht=scontent-iad3-
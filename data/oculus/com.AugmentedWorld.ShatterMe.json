=1-7&_nc_sid=6e7a0a&_nc_ohc=MUek0_2vm2QQ7kNvwHY96iE&_nc_oc=AdpSIU1g9NJAR9RwFoECn61lSFhiG7vBbkzNcK_ZPhfMYYKw0qpHaNFAWusLee7HfJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LTnuzBBE6ACY4cjF7EUyrKsrZr5959f-tOj_fhv83HA&oe=6A3FE3E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCRP-vaQgxgQ7kNvwGZuk4R&_nc_oc=AdpkAyn9FyXZCCat6NMpX5REqWr3KZ7WRqUCfiYm3OJ1uRpYyT40qvk0rbFYlH0t-mk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fY0TD4ndaRQHtKLGHOr1_tGOFJ-2IVs9pm2QsKh44xw&oe=6A3FDB10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgEsKNBQ4TwQ7kNvwEYNozh&_nc_oc=AdpH6Alh3TZKoaSfJe2XTFKsm04c_NLqDgBDUaFstzakF5vOyivliWa5yPqTnB3myeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Gh3kJWGsY3eI2lqj0dD2dkeEcxuM3xaWhfKHsqxCRw&oe=6A3FEA77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQDHHIncEsoQ7kNvwFtG-w9&_nc_oc=Adqw8lvCCGPCH3z6n8WL8mTbKCcjCn06qggRBvK8ohA8Ab9W3SExoouTmUkyuIT2WyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lunphUfT_XzySasZpYVaFH-z-Wxdh0E1dh6Kl7nJV7Q&oe=6A3FBD92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfYnECi4wokQ7kNvwGaut3c&_nc_oc=AdrCi6iq0pkeFjk9nuCcEDdDQrZ0L4bGHc63IX_ft9QmJPPVr0lQfLrOUKtFXihPNgs&_nc_zt=3&_nc_ht=scontent-ord5-
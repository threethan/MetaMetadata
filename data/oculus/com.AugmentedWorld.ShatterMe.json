=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi-ac4u4MsYQ7kNvwEyTpnM&_nc_oc=Adqrb1vUck6Td-Yqsu5h1969VjxRqgrTHBeZ2BMIJncXjnExDz4Qtb8-_o_EKaCHffY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BbgCqACf3hYiPDCDfszUpJ95iE67ZZZHsxHo41ecMig&oe=69DE54E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZFRIVByRDoQ7kNvwHId4vE&_nc_oc=AdpXq6kVzTOSH7cbKuvBPDYVXwdQbv_Xsk3W11OxxiqS5RCOEwA2W2seL3qbFV8NdjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vhxb3GLFQIw2POfHsHWJwVorcRiF2AjLWprJtZOICDw&oe=69DE4C10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqqhTIXzpX0Q7kNvwE7ljfv&_nc_oc=AdpI7nS1-5XzYw5Zs51SBY7fkSJWku1ekDZHXlfT5vur4TrOkm2tIu0wHBuKRHMHsOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39b5tAdduYF4E0rjEaH4ZKQOyxlD6ZWq-TPNb-hDWZ5g&oe=69DE2337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2K36KsArb4Q7kNvwHUqKro&_nc_oc=AdoL_7tTCeiHmslrLpA0Zw9GxhS8kH-qg5eR6_QDST5LXcCHRXHSHys0xPJJ7RbxNYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QyKqA8tugNjsS3TGIijHqJYxSbjcswWsAeI4xxs2GpA&oe=69DE2E92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dt8obE9IZcQ7kNvwFAaBHh&_nc_oc=AdqxuCBiU6jwrhAf-lY8UiQjkwEBjQ4CKQIqEQ7SaorJ_h9XKPEXms6ILgTCcsj87ic&_nc_zt=3&_nc_ht=scontent-ams2-
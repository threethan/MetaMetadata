=1-7&_nc_sid=6e7a0a&_nc_ohc=QPYDLN_0rlEQ7kNvwGMXwOF&_nc_oc=AdpJA7rYI_GlISZkwg5MU7Ktxpix558zVFTFDq5DV2HpbAECqal8Mh6gjDQyJhu1TIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO-SwFpFvT0L3bZ2Mq6iDlBgnR_-RMz4r_x5NmI0Y-Sg&oe=6ADE17E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPs5D00N7hAQ7kNvwGW711L&_nc_oc=AdoUUkxFvR04mYiRCEA8jD2zYk6vDgo5mtw5G0tQNvBYi_TY2xoNt_iYr3_4S90oo1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPREcR4xcawI-qn8GY4ivrV1mPtOiOFgjmBtLB_lGAh4A&oe=6ADE0F10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41n6L0k4rssQ7kNvwGS_-Ze&_nc_oc=AdocS3LTGtI1AYnSg8em8OKdLd4jSn2NqgrCZ2Satq9wno9ISkeRC9w_tdZ2XHOXqBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqAW1Tvu5sIl1GQ-nSp6rm2OB6-YatrhnMNc_rNETKXQ&oe=6ADE1E77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wId_BusCSLsQ7kNvwG1c7Zj&_nc_oc=Adrr8K5S9L0qh3OhWmTfETheWxhx8mEFFzylwslReBzCKCizH9uuG4RKVdk2074_ZBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1SglvsYt6p7jsZDhPYPz4dhrcSl7bvI_mV_7vubtN0A&oe=6ADDF192"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKIQdAbSkKsQ7kNvwF7t0ek&_nc_oc=AdroLMecqRSD8sSnwv2hV19gJGXO3mzqoQRkSQQVuOlv3bE8CByVFSNUz0WRsZwcko8&_nc_zt=3&_nc_ht=scontent-sjc3-
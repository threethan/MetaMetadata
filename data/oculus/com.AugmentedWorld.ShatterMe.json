=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaGFnwsZSeYQ7kNvwFZHOWF&_nc_oc=AdqzZy5Ct86hbVcAQRmcPQHYQoN1SvoPmDDn6HqBeaAy5zJRMX7YPf7bG4BjIGkk3bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g1oAj6nWSXiWYC2S5kjfV3HDpx3AzUBFoZtDWqch7Lw&oe=6A47CCE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKLXGsm_zuUQ7kNvwE3nl-S&_nc_oc=Adrf0vmvLq8UgdzlelVNMSVeMb_8xRy790bft49xYruu91_X4JYv3y5d1MzOwqaPedU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yCgY7WDvd0HZcGbDowEa3t_3mbsJ4JhcVw0IA21FXeQ&oe=6A47C410"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpNA7EWZqPoQ7kNvwG_1PI4&_nc_oc=AdrypO61Aljn8EcGbD4mPXABWDPRgeNpblrQAq1LVYKzkDREanHbX9nIau3suUUsEZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83gZBIxNMy0W37b0qdZ0nYzMmK3vDWOrGXcHBqt3TN4g&oe=6A47D377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP07K-Yj4HoQ7kNvwGhmD9W&_nc_oc=AdoWUobfzzw9qJvsDkprJTtpe2ZrV7TMfmpU-2ZBqd67hZuFzWCMfdI0sjIZiAvtRl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Hdtd2MoG4LNspqJa_ho0kgJgpV42XOMZ2gA-F9jclQ&oe=6A47DED2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzyTdyDNkdoQ7kNvwFGxwws&_nc_oc=AdoEXz9ubWCw2ARK5FHV-944iTQW5h0R3pQDoAilhBNVP0SrSnC3eKYV31wdH7mf650&_nc_zt=3&_nc_ht=scontent-ord5-
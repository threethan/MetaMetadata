=1-7&_nc_sid=6e7a0a&_nc_ohc=erT9xXZR2tUQ7kNvwFestw7&_nc_oc=Adrof0uhyFSFEEMdh2GT2qmpTt_1B1Luh2YQbxsomZzG9rDS0_GDYuRgAlSW5XmQEH8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd76oG4pPHX0haypZ9scNH0K0infasSLTmlTywRILzYw&oe=6A86DCA1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04LIkdAPwYIQ7kNvwGlR_yj&_nc_oc=AdpAUkAX0V08cE41gqOl3XE8XScMipvhEc4scoLT_chRLZNbX3-jvkE-viMVUt_Vpak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJsCngM9VSsp7YGPGLX0s9RE712imwG7g4FnSJWeU6A&oe=6A86D3D0"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzZdmsbEATAQ7kNvwFOdSIc&_nc_oc=AdrTj8mbUuf97V2JD21-hnPatrCt-B-6Squ_yZShH4c4iVqZ_8pGhofGpuKQGQn2QVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu598wwTczedp9px5-m7a4C22e-Xx9hR77ew1meIoQHg&oe=6A86E337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Przl5BlVzPMQ7kNvwH-inB7&_nc_oc=AdobpxpNiftzy36WUl4BWBbbBi3bDKHkcN-mXKYHWE-2MTuVaGzm43o1ennoFNUf1Ks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0BQHEdHgowC4LkB0ehNiKk_we_5K8xxAhZLdkeACe5A&oe=6A86EE92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1EECAqvzU0Q7kNvwGZTFku&_nc_oc=AdplWyJbdyL6b3oJWki_Tx06ZZq3t965aL0yegfZdXsQ5HuPicXIGyYd9TAgis7pt0Q&_nc_zt=3&_nc_ht=scontent-atl3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=9RlkKZVBO90Q7kNvwGGcwIe&_nc_oc=Ado0_yifYUOVrKHuczW58AKJTeS_HzEVIOH5sRkLta5d6cxEoSoy34V5GwS88QenvOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZJ_6xKYED1nm2huEhdK_mGqhQSCCztvGEwxaq_iHQ8A&oe=6A297A61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6xa0ixg8BYQ7kNvwHHf1Jg&_nc_oc=Ado6h8wc4rcJXUVWnN3DQvMKzt7FLcLMthBjVJZxmemJyxOiiVom94UgavBPnVJcqCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ti9gKTUT3_xjc5CbDbZ51zwmkP7owXUq8cMX1hvyhuw&oe=6A297190"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZoFsbXgNiUQ7kNvwG-R02j&_nc_oc=AdoqK6SsHpwfZ9B8VeJgwNqaOGi6ZLEQ3Ocs_LfbuzZYk112NN88gzq0YmZxUh82Dc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M_s0p7XdrEgtWogwyHrx806ijb79O67Mfndihhw24rQ&oe=6A2980F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuIbA1oMaBsQ7kNvwH5Ip_I&_nc_oc=AdrvgYu4JZK9VJKpS6RAKjQWocvKo5gXZzcAwpFwFioD54XCvQlBsiJyuaZXr7S9LV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zjquG24Rg1q9E-7pA9We4bUT4tuntyr6IihXk2qYZpQ&oe=6A295412"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZRW7K3WDZ4Q7kNvwE1HBik&_nc_oc=AdpziCO2GBE5tTsYloQN0PjcOvOe4wHKL8JAaIpUs7t6QzCKVUaRUbm9IPbxPpgtCRs&_nc_zt=3&_nc_ht=scontent-ams2-
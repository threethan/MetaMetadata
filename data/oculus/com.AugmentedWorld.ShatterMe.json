=1-7&_nc_sid=6e7a0a&_nc_ohc=iguJG3n68sMQ7kNvwF7Sbwl&_nc_oc=Ado0z9RoQCGIbxrx31tEP1uUqD-mTckSgHTQj9_g9XSB9SE6eZxNudgI7FPWjcbXeKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D9P3c5RIzrHBXN773m9AY97E4kpyxLqYN9oPiJ4WhyA&oe=69FB55E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEdHIA_Bzn8Q7kNvwHlfVgm&_nc_oc=AdplzIoU9Y1K5hnHEdxJEQPbQOadGWW5XOHfQoyQhYfFQ3xSz7dnYfK2rEtM5yfrdxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mEiBXJZM_fs2H4zt3A8rXR1Vg5VzRO1kDBCB_R-V_jg&oe=69FB4D10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKmpekEgbXEQ7kNvwFfKQUw&_nc_oc=Adre-YKCKRzWyed32JaHSR_bf_1iZJNqatCrebMxT06eY5pNK6wQviFs4A3uL-PsOMw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ScsGIgqSNocJEwr8HB_H1HEQeI_7S8T3Y_pfeBfa-sQ&oe=69FB5C77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UouR3RqJRyEQ7kNvwEl2pKU&_nc_oc=AdpFI7d6gheFsKp-esy-X4q7vDqqEQeKdx3qbo4cQCfiRs-5vHUh1wZJqf1u6UDF8p0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q4ooCoQJYrA_5p8i2h5NXAujn5Yi23b5xooaGq_rx7Q&oe=69FB2F92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlxScrxL2nMQ7kNvwHD9Heq&_nc_oc=AdruiMy26jtu4OMbDG9IdKAnODLU7LaAEfTr2ZxmXVstf_wnb6bSXEs-N_oG7rRAuNk&_nc_zt=3&_nc_ht=scontent-ams2-
=1-7&_nc_sid=6e7a0a&_nc_ohc=YnAJy0cE_ugQ7kNvwFJOy3_&_nc_oc=AdrD6XqG64Gb4ceJUaH8FBJCoy3vnu31BKTLLiTkebr2P_n-aliii7RpOni0oiNSZZs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vir0v8W6RyEswzN7cogzIJK5mCXHUzjyklr80y54qIQ&oe=6A32B4E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiy7QpCxH2EQ7kNvwGacs4g&_nc_oc=Adq9e6p61QjuZlk5dKWOauhHToJgoOjGSTqaBYgsZa5FR1SNbdPAcR41t4V6eXQCTEA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__q0H0OK8BBRQFcAgDmnUf8hhZP4cTdecaMGRVxOWPnQ&oe=6A32AC10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u024a77gX8Q7kNvwGdQcM-&_nc_oc=AdpcTNF1H3DU7vEGMrFja7CZTYENYzNxOU3rL6RpwPGubma6V3MX7w5x-Ii9P8X2xRg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UCvM-CfL5eVvUgjJea3Xcbm3yPGuxtHjvInAdR_XdWQ&oe=6A32BB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf7_LjLLzcoQ7kNvwFPhd_t&_nc_oc=AdpudezNrAUG8BTkGa3PmLVpC9mRwVRP782Ou8rRIhg3o94gK1EMsC6EpkPum2F4xXc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iSSpaV36SzVPEO10Wass4NWOFE66MuHXhmRU6-PSdug&oe=6A32C6D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yzRij-p5FkQ7kNvwEbV9g3&_nc_oc=Adq0KlbSB_zFyPD3iOhyDJIv5QVI5ZHnRLqS8Mtajz9Dv8qhdcaSUbMIa6FZfVIimro&_nc_zt=3&_nc_ht=scontent-fra3-
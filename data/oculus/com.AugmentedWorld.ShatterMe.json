=1-7&_nc_sid=6e7a0a&_nc_ohc=_zvecVPcch4Q7kNvwGUMgBe&_nc_oc=Adp2jizA_QsUDG3KMh0q7aQbXRW4dds3Zid6O_8YWCagkmzVbTdJbgyFmjmHUqOnWO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fjusSiLMweSp-Tqtt_d6xEuu8RlkoXwYoJgQ9y_4oTA&oe=69F76161"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM-HV1zh5vcQ7kNvwGf6XgU&_nc_oc=AdqY2SdHqrbGMz3DYPhoLgCOq4Rmcm-hgzCsh-xRWnVoe6k5xr0WOT_kzhjeTSHsvVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hSPCNFbaBP3z4weZqh4JgRnZV20SPpYlVaokJvCD-vQ&oe=69F75890"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5zJYryTY10Q7kNvwGM4wAo&_nc_oc=AdoV-1_G7cjSmgluaIg-sAQn6iwaRdo7lKG5hFSpq1CyXIy3YiwRYyzVEWGv7djiyJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oPJWtnNPQMJiWU5Fv8sdQAjvJJnh1PFyklKzfOoi6Yw&oe=69F767F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KY4Z8S3sBxcQ7kNvwGLAM3G&_nc_oc=AdrNQ6fhSi_miRojQwGO95zyl_def4htDInT5dLkdjADRJv_JdBbaatcuqmrwAiCUS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cULxWpWCRCQ_Y9lakn1KyLneoLUP0WivVFJab-FIc7g&oe=69F73B12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_gjUZ9scjIQ7kNvwFT0y7a&_nc_oc=Adr1F_nSRQHueyEoqdpcYpptNMioWgaiFCOHWhCOkJdFrQAdcwT_-gukUdPeozrL3tw&_nc_zt=3&_nc_ht=scontent-iad3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjkh7jPSugMQ7kNvwG5wMA8&_nc_oc=AdpX3VIPYnj-G0sYmkhIMN2b3ud70v2doV0_9Pohg7IZg1DGsvvNF7nXqNwv3jDd_e0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxf_J66CMWqryLrUTOQs4AE8BsdVN85o_3ZTVpu0tmesg&oe=69CFD461"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHawhQ-TqrsQ7kNvwFMRnv6&_nc_oc=AdpK5pfCpwGzTZLHpzSv1vU4IWSxj4lEGZdJ6iGxCgymsndVv_iSa7fOFTpxauPfZ3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzn_72ZsVFKaaDc2wF9wUpArqPjRVJT8e_kELBwMFMsWg&oe=69CFCB90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d34xvk2gZv0Q7kNvwEAzE0R&_nc_oc=Adrbz6HF8JOEtN91D0LYMCI8W8g6wTwVO5cLRiNdsqr3s7RPaoeGY9IheSSDYyffVv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz69OwX_pkW2etSOZTb4dmXBI_3E7SW-pyqjhDojfzUFA&oe=69CFA2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-mYWUdyblQQ7kNvwHP-OYy&_nc_oc=AdrNWxyFL6Uj0XnQFY1pdOxW1wrzpLy92jLZMPWJYWVnqIozVGFa-4i3WbS_9lktvPM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymKkD862goCSa0X3R--_eykSq62hy71mn99RarIYKCFQ&oe=69CFAE12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVzFvtxNss0Q7kNvwGbsSke&_nc_oc=AdrP8WuwA8qFn36hnc3-V5w8tCqrBhnzW_HYcLrHZxRTdswMxfLYU_KlHI98O7Uxu7M&_nc_zt=3&_nc_ht=scontent-atl3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=hPCau4dLqZwQ7kNvwGmDWvY&_nc_oc=Adr43jiDTLe9Mp_IpQV0roN0E49Wg4tEZqyi5Z8ulptlH6l-4LJ2P_eicCYvDv36qlE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CV80hxAFCWsJfdL51i65P2tJoRJgTkYD20DVKptCnYw&oe=6A1C4B61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLZJZsh_mfQQ7kNvwFNNFgw&_nc_oc=AdqYW3i3-nQ8h-gJMuC1cDAeq2J1RQDFMDtpN3WAn5Xo3eEN4nP2jyztt1vu_Uf2jwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jooDCGcjR2s_RQVkBlKtcciJautzmY5JXGQZ028-pjQ&oe=6A1C4290"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mewS8T4lYFYQ7kNvwFEM4Ba&_nc_oc=AdoKRTS4ptyRVcLCG4WeUJ-m4jsW02lyXXIo2_n7oMf1k6lyBSQh-odiO9Gf6RvkjFQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af677ddQ1QfoWUlkHND7GMCnZHWyeABVLQqMbo5_DRhH4A&oe=6A1C51F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZf0N_ck0kQ7kNvwF__ubT&_nc_oc=AdrqHR5wA8gCyzZ-7p6MLQ62fH5bAE2UtYkWWJekrZFD7OKsLFSgXEBIZ9loynRTBHQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y0ZGqcifsxv5_CXDVn7ZNRxU6mOG12aH9rkuafdboSQ&oe=6A1C5D52"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj5_JKTxPYkQ7kNvwFiM082&_nc_oc=AdrPHlxFvAVO4DFHLXG8uwONvwlvuwoGTU7QXL6b4DTaBx7MshrwuT2L6xicFVFhaQc&_nc_zt=3&_nc_ht=scontent-fra3-
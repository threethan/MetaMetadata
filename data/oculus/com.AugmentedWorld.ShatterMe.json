=1-7&_nc_sid=6e7a0a&_nc_ohc=PcB0E8at0RMQ7kNvwFA_3au&_nc_oc=Adp5J_a2bsHj6Rc4QT1ZCSl-5_9gahtRAdwGy_AzMz-TgDgyRo_xOMhgTRDbHfJK5J8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEwnL7r9fVZw_F-RGb4y-uwtVytU9OHzBPgIXBSnqHOw&oe=6A64CDE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzenIlXWy0YQ7kNvwGkGEcG&_nc_oc=AdpbY9FZpkJz8OZM7sJG0WImk4dxvWqlAKFW3yCrlLaKq9UCeozcd8fFJIoutq0PZfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOsZQakZ8CW1cEcPP1bgxwxUPtcRP8V-HkPDb5t3VdXA&oe=6A64C510"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d7rjYLM2M8Q7kNvwEehuwE&_nc_oc=Adr2mkOAXOmS2Fyh8yNpH1Reapqc4Dli7R_VrTSy4sqP9A8EJGiR2YhQ6z7KilT-A0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf5N12ZGmcXzKLeCSsw5dsguEdAF0RphRmLET5oZuxog&oe=6A649C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ9_q2azRJEQ7kNvwF66dO5&_nc_oc=Adp2uC8vug8-dso3HwSyr6bajjfMIY_Wk_BoWj203LyxSMsJRoLanKA-FjRACkxVWdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrUAQqseLAji515F_SrwDWWWLBpj5-pmpx2Wn-DAniXg&oe=6A64A792"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpTz0AMLSVMQ7kNvwFXrtKy&_nc_oc=Adqj5_xHhAsnvWJFSd0-l2-YiFtLHOiCdv7GxHM73GHMxKkgfFmHRok06-rkowmkIY8&_nc_zt=3&_nc_ht=scontent-iad3-
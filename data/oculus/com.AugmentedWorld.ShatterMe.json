=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjkh7jPSugMQ7kNvwGN6x_1&_nc_oc=Adrd2VY0Y1_ozub632H_tuteXpzn0XkCa6pHWrFBhOwe3ao5Wzyiyk1mJFQl8wlJcTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30HDwe2XWqXlYwu310r-EmOSMY1_7lCs3GI3VoaEu-tQ&oe=69D27761"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JpvioRlF8wQ7kNvwFRDaTS&_nc_oc=AdopfL2L-JuW8EXo225IEL9QH4PqPnKJDL_J5-IAvPK-Cwe0qaFVEK1JCYVtI2WhZKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pEOovsPoNeHo9WPP0yeA1ZlrqtPIJB6l8QJC0QFrpOQ&oe=69D26E90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hD_YA2OwmEQ7kNvwGG_Hd-&_nc_oc=AdpwuZhV-LtXPQRUpUJyfx26YjSH6Gnl6OBh73AdcK0zrieB7dPXWFC99a9sfaXiNPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EeShtcW2oXY09JyFrm0Ez966_hMx6qGHHo_XbsbNdZg&oe=69D27DF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-mYWUdyblQQ7kNvwGfr6nd&_nc_oc=Adqh0c29E4Bo7GkXD2DPxlu0G5oyC-VcnsXETUkUQGSxD1iN2P6b3TXuV7WmBtRnizE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IxrJ-Xe-EL29Xgs4xqoZ-L6EosL2Lk_ee1tfx3UORqQ&oe=69D25112"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAXltczrxjYQ7kNvwGmnoX_&_nc_oc=Adp3zBeWgk11mmNZSrW-Mi9UhQHcVnvNWT-Ho5VS0eMCkftFNlR66Gk_UjoXxJ_CDas&_nc_zt=3&_nc_ht=scontent-ams2-
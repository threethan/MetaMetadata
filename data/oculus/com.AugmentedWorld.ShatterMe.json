mqAhQ9Ol8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqNYRVkt-LfDXlL3VIHPHxBLRYIdmazW69_c_jA4jPMg&oe=69A41AA1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnhQbD0084Q7kNvwEXmRUE&_nc_oc=AdnGKT5Q6X76DvSxToDrXIt8M1dmo71_uUdg5vsFkTVQCW_KvZLhrgphx1GiYZFZATE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvpOsNzjduRifnNwVoo5HjZebRHYlb7INxxv_mdt7fW4g&oe=69A44A10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB7L6CSSuD8Q7kNvwEHdauW&_nc_oc=AdkhSg6f0N8gh8olFmKpn9vZIjPzXrvr4XkVvaDW3MDYw9VKcM69Us5lAU1zzyxBbCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvNkaA9LhPZ5AZR1PwyeSlPmBTepABdxWdJdaYUjK0tWA&oe=69A42137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHl6-tHKN58Q7kNvwFsyiqj&_nc_oc=AdnzxXPWIuDShggshQ8P7rQ8CrEmrasxMmKB4WpjSGAWOvVI4n9fkxh4lA6Ybt2rSX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsT_pfOTmKN5bfSVYiKjwyXMi5f4w_Ct2ieYeDtbPHe8w&oe=69A42C92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdfMznzZJlwQ7kNvwETaVkX&_nc_oc=AdnEOFwhZO1HFiRt7XHZF0r2vSntfJEYc-uSHq0B06xTB288v1mwsYjaw25l4Z6EE1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuesIBdloHsn7FDVah7j9bAK18byBmBuFbwBbeZmhBI6w&oe=69A43D99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
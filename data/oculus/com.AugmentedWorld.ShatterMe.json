creen5.png", "id": "920899901960435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_920899908627101_3284581321115754687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfNBnm2kEF4Q7kNvwFRwTjl&_nc_oc=Adrl_wi-pL045-7_oWiqYJUCHyNzOvfKqkngHOQaF2cULM9r7OzCita9v7b86NXytMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeA-7Mh1Y3yNG71eo40IRURHTnAANZCdo9vC1moSrJ0A&oe=6AC66282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1414812452370639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1414812459037305_4441829631623283258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPSqQvJN0xAQ7kNvwFmkjnh&_nc_oc=AdrfSmxy5p6_9EQ7bM3um19mqQRO7LFJM0ohFEIrAUUpr1SBKToPL5w2DTO05kfmr70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnJcc1stgpm5RkQTmk0tVP-GDBVUtr0ljecjs2m1WEcg&oe=6AC65740"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url":
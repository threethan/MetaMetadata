=1-7&_nc_sid=6e7a0a&_nc_ohc=spxkvSnFpjEQ7kNvwFaASzd&_nc_oc=AdrlxQnjLzUqUAR4-84goY_H8EX1JdwjDnVWYG4ydZesEjbSi9-5sOvFDAWMLDviZa0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I3l8Lz5et9aBlPcy5W_nelp48m2vRq7ZIXH2L05sjcw&oe=6A0C7961"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dxn1DtaEDQQ7kNvwGVzyLv&_nc_oc=Adqwngg6vZwtGKhwLIB9qt6cJrO1Nkd4DOFIPD-iEkuLpk9zCIkJMSDDrAnSvjPMEjo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FvRbIKQpKDdSn52FnZ8nIcIpGOM-Svl_Ncxe2sVhxTw&oe=6A0C7090"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMXJJuqE-lsQ7kNvwECFYrT&_nc_oc=Ado78bByhPxhXBIN1-AF_gJzScqaiHyoGOdq_0hA9KVGaYHLdTqWq4DG6D4KXIDxD94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t5niPzDrEGuRNZ2Eh7gkX5gn0mRs7nHuHionulQHhbA&oe=6A0C7FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sLwj6L8--QQ7kNvwGt2ocF&_nc_oc=AdoGss8jyTT2RS2CO1Uhjn2zXfGaDEXiKrR5bBFOw6PG9WpNGQobwCZEpSOFGQny1yo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I8GUk9ZRkU6s1YXUM5ynEJ0hIQMAJxtyl2_aI0AUZ0g&oe=6A0C5312"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yfAbRDjWbEQ7kNvwEUj7BU&_nc_oc=AdrpVyB-co3OxIsrm2ukf1q5nOJCbfRq6QEswW9y-2C2eaEiobWJ56xtUEkNApPfgUc&_nc_zt=3&_nc_ht=scontent-lga3-
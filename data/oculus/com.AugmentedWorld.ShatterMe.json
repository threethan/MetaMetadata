=1-7&_nc_sid=6e7a0a&_nc_ohc=xjmQjdI9iwEQ7kNvwHWuh9M&_nc_oc=Adqe86S9NLkIzVlvVaf1NA3ZrT4ouUzYLzPT5O93LVZT7W0CLfKXYBUGc41473jdG1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1reOOWKI73sgLX4k43EnUcY_7SiQVOWDSD7pmfLQlaw&oe=69C3BEA1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEPMNIm2R_UQ7kNvwGRkyY1&_nc_oc=Ado_q3_UMmTrR211NZ04jmjohpr-JeTnhFmKPekLnUsVw7JAcMVkhLrLPaPRi-teOeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMsYu76I996nhSzq-gIqxdHsg0lOPH5TRyExg0xHn9xQ&oe=69C3EE10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OysbZNRqBAUQ7kNvwFUHJRu&_nc_oc=Adom9d-ViStdWzKIZhz42YRS_JOhA1GdC9kSDkxF0iIjuU6gPgYs7YhaGFTub_woqbI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx5HHV0cHrBegkZPDWaOi5RimBk1ObMSl31TuSRwtTcw&oe=69C3C537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R4Uqav9TuEQ7kNvwElU_6R&_nc_oc=AdqtmyADSwN2DWc9ce2hLcdAMPodQoH3uq3DILfD9v2Tt0LpdMXB_Hf1vyIVRchV_3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS3uSF5Ufo_bFclBlSyYR6D4tagjzf-JarbNb-MkO3bg&oe=69C3D092"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrp_l45LpyMQ7kNvwHdeL_E&_nc_oc=AdqD_dpVgs4assO440yqrYyFQPQOUEdq9psu79rUAc40lz_p6mxNKA82WEf8EItGl9A&_nc_zt=3&_nc_ht=scontent-atl3-
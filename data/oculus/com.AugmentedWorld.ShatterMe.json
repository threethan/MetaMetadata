=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z0qyu6mDg8Q7kNvwHvxqRn&_nc_oc=Adplab1Osu2DCZXhiOcHssC5BeQdtsopJShsWZBnBmBurOaGNWLxpzuECTfAXQ8xbqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLTYCZoDoT8n4WZ8K2ZASj_pKOggqNh9BMrQZ0PlNn9g&oe=6AF8AE21"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjTeksSgMMsQ7kNvwEI4VyM&_nc_oc=AdqWoeXz6E-2by4Y0bD8xxx6cHkVrHVIC6peoNzJxWh39wDhD2-KAPmB79e-OBShPno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvERxN8BaQllew4HsVfAHDap2QBGgYm7mukL-vaTAeTA&oe=6AF8A550"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67ogMGtDNpgQ7kNvwF8xWi5&_nc_oc=AdrAV0Q0PvTm6GUv_IF59M4Zg22zVu1D3olFONdXJY6z2Xt30Vh0PhEfsV4nKc3nZcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSFYoCjLg_U9dnC4AQK2po9bW_s6gUaHEoevHSGUuk5w&oe=6AF87C77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfJxuGSiNiwQ7kNvwFAprON&_nc_oc=Adpg_bOnoffCfpEre4ogEeXPZ9XQDXsQvUwD2qsx4URNIRNcW1N7_tpenrGKbRv7FNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz5JQjbmMWsy88D1qUCONkbgRKYRcOlscHekIsl7khxw&oe=6AF887D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l1aGTfZ16MQ7kNvwEwIU8C&_nc_oc=AdqPE_8ydLidhGxnPJ-Dg6JAYmZ8wU0mxul_uc_DuUckiE_MFanIdrkH5OovODXdi4k&_nc_zt=3&_nc_ht=scontent-ord5-
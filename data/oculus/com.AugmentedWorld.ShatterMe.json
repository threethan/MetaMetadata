=1-7&_nc_sid=6e7a0a&_nc_ohc=QPYDLN_0rlEQ7kNvwEc8CQ7&_nc_oc=Adr1NQ1XgoUPrHKjaDgN4QTEKmqQcGQ4Laysu7Q7t7pLwDrn-vd6RWuBCZROK2vuh_k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7kjFWYPXF7naUUozxMwvkK2R799TFSFbIwACaLj-Q2Q&oe=6ADCC661"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPs5D00N7hAQ7kNvwEQuAw3&_nc_oc=AdpUxGwUpKNMgYe-biwDgfggz1GRcTc7-evziJvP5lRVg1P59SyAV__Zsk3Bf7QL-IQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIE7XJ-88N4JkUhDkPZxDz3M3ul8EBv60YBT90vcwfaw&oe=6ADCBD90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41n6L0k4rssQ7kNvwF8i3iy&_nc_oc=AdqfGMiUH6PYu9mktO5GNpaiItVerYmbVo64xaFyXLNwt2zMImLvz2S9rtGfVVqkTcA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7U8Gd2Tr70SCgRe2iy4JiQ-XJi8mNZZWGQUJzkJpnGA&oe=6ADCCCF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wId_BusCSLsQ7kNvwF3uVwH&_nc_oc=AdrXPjuNm9FFiLiME5hXJGCiB-22eWd53cA4vbrgxWJK8J-3UNhdjsiN_y-PkV2fTVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMANbszqrPweeyjKxMe37bWwN0IfE7sVTtS-VG995D9bg&oe=6ADCD852"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKIQdAbSkKsQ7kNvwE5-vZw&_nc_oc=AdqoKQXuDlbkKxL70GUppVYvrXYg_M4yi3vl3qC5SvRd2BS7hj0kC213pI3GRi12w9I&_nc_zt=3&_nc_ht=scontent-atl3-
xigQWqjGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAHhrz7ND6b6NspkF_0BHjaVjHNQP60bmCT8PRYhOCRw&oe=69A02621"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLz9kbeU0goQ7kNvwFR_8Lf&_nc_oc=AdlyDMXMKqC-v5ej4FiBz9DD_2dZTYriWF42ObfM6Z_GXeirsWwN4tqR5SUJdxm15-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBJF_r0LuXc6wBhmIbMm6dvVTZSVdbTnWm2TRLXPW5kQ&oe=69A05590"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl1oQYOP3kIQ7kNvwFFm7Sm&_nc_oc=Adn-6CUe-b7BMeJ9oPmT8w7hPcYgqsGv86XZT8UUm9Gj9NFCNtsXTKMDaRDnQdyAIag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfgQILlvXVADND0eEiHumIWJ_5rS8SPQGq8jYZVlcHTA&oe=69A02CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khwDaHdTqXUQ7kNvwGlSLJx&_nc_oc=AdkhqbGklj1Axu47OQElNbLzUTzLyEYOU2UgLxr8uXfqU7qv6z2ORcn70U2LIGB0SKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxzT1Xv70LKUSF6rF4RCHo6h3bRL4F7WznLFJA3ymCpg&oe=69A03812"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsPfTz0g1qIQ7kNvwEGSADK&_nc_oc=AdnfP7ppVBvbPhx7MyTeZ_2xmNrc4w6kz1orU2euxa_kOrA3Y5IGlngyHyRKAIXdF4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFS4VIm136itq_kNi_7_BsqEyR9KM2QdcvUkx9MsGrXw&oe=69A04919"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
=1-7&_nc_sid=6e7a0a&_nc_ohc=V1o_cMl4dFMQ7kNvwF0gIeb&_nc_oc=AdqZt4EewggmNnuHLnO5M6gTm3J-jZtKAgx9ms7mjg-SFrPdQEt6A3f2qqq_NG43iuY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CCEgJhoIuo7SDYsXB4NTFlZGNzuoRcwabR-vfLCUFZg&oe=69D7BD61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n04hloHoDcQ7kNvwG3p-Wg&_nc_oc=AdoCyi3FP3VyBubC-rueymNJ78BaI2VCa8LGJvfNFQO9CtItzpjN1DkFWrKIw86aIBA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F7cBhKmUBJmScA4oTK3zxvelGTchP7VSJRy-ckGwVaw&oe=69D7B490"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fguJ7MM3t90Q7kNvwGstvmB&_nc_oc=AdrRe2xEcB__33Wv1QVSHJPuzJVoMI7etDQ_bRHc9YbOBhur0VNrfI4dyKb-m_ArOH4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ohJkYh3p4d3X-YMpeVV2Tc8uX-l6estHNZgM36Mq7SA&oe=69D78BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLREdRg0gaMQ7kNvwEKKmbw&_nc_oc=Adpps-0nn6cNk_SlEG68bg18mZJo-I8DZJ5t_Nc1043rqq02U0zQNGeHqZqc69THmkQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sBAi1e_o1kU47KbAjEcXJ_ZS99QVOsmXc7SKQrGAYlQ&oe=69D79712"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m7RajN28hUQ7kNvwGSDFVp&_nc_oc=Adpeid9WbUyc6x4da5Iwh5TD24eWS1rzpeSBeaG8xV-X8QOXz-XCyz7AIMVrrqLYdFI&_nc_zt=3&_nc_ht=scontent-fra3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=DtbO_eG79u8Q7kNvwEO4t30&_nc_oc=Adqrd829X6Yt4kjzdWpWoV7JDsDne5EuTij3p5Xe3LbhzdwyOastDeANU1I7n_8aNH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR50QKHFJWkBKVhLLWTU9mu1BZc6ximE08ga5XQd_cZTQ&oe=6AF5D2E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li2hV-L2W6QQ7kNvwE8CGf_&_nc_oc=AdqeRfF2fmfRFdyyb4_UsmY3glamiqjQ16dsBcnO85jmtnMrFq6ZNL-vw8OOUdWFnXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkD4z1mKUk4BTug418d6Z0oOmqSb7WoXO2lCVl5Chi-Q&oe=6AF5CA10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MBw-nB7hJsQ7kNvwF5epnp&_nc_oc=AdrEfsa2-OUVGFSfQu7i_wIql-ZDJ0Uzq0qkEegaQlcK-6T-Ytb3qwDRaX080JqMg-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHOH8vv4Cy6ewp5BEj1Ugc4TkopXAEdxhJ0oM6Vg7Mng&oe=6AF5D977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m119ObCVyhYQ7kNvwGj9Cld&_nc_oc=Ado9ODud_13zHhB17yboPYBC49LlPr2SEL68oRG48E26Y0rwHxhCfxnwjs7BZ-pjeuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjL-LPjJ7iFunrXU2f9UxLQbVgULjyCjbNsv7jLUOgYg&oe=6AF5E4D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxj5h6MkymEQ7kNvwEGJnvO&_nc_oc=Adoko1iTiLAHj5TOgg33BdiubRczJHUp_UlUN9ibJ4v5DUqrHOfoP1R9eFGp99lAg_8&_nc_zt=3&_nc_ht=scontent-iad3-
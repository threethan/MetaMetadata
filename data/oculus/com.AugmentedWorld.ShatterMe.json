=1-7&_nc_sid=6e7a0a&_nc_ohc=3K6ZcmHwFHAQ7kNvwEIWsQl&_nc_oc=AdrSK3DR7EN-5lc5KF6IW-7orOcV4-aSjal3RZ-fXhtJ6lefE0nuRIzOD0aqqSQXX4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrkYXFUh1zq6y2z8_EeLoIYAohzT1Huk0RovFCQA2M-g&oe=6AE35DE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0reMWdPzQ6oQ7kNvwHSDKf7&_nc_oc=AdqKhbvMgHJS97iekj5Y11s_hq4UZ5Q7PNt4lfkFxWJA2Ch_1aprTrlz-R4q4KocaOY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgPLwPdmEXROs-HF3BLg88_86L6YBGHDR_gP1vuJ1blA&oe=6AE35510"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ9tK9nIGF8Q7kNvwFxgj8F&_nc_oc=Adqz8S3IBeuMe1guvyAhWllBlU4OeMwyGhqOiOOTdtjJHsdM4jzJFBBx6wW0-tYnIp8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH29WkxWtya7xlm4FRfCqKqzjNQoPmiZX1uVQsYia9Ww&oe=6AE36477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikzK9gjcY0YQ7kNvwFQPNoH&_nc_oc=Adq4TloPtsUJtY2A3WRi3_FxT-vVSIxb2VH4549BRajUliAWX9IOe357WvV7KYUqOyo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_O6wnbO2BdaLYnl7Vk_-GaaZvhY92zMS_fMnRVgfEwQ&oe=6AE33792"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWZ_3dEkOBUQ7kNvwGW5tqo&_nc_oc=AdpJ_Al6yizL2xKrXfbM6AFtAQLxkc0lCHr05tP9mbMnicfGdlaSe0XGL8PfKrN7cOs&_nc_zt=3&_nc_ht=scontent-dfw5-
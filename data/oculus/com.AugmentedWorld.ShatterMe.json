2WkmKHq5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afso_CdZa6pdvLDqXeEYXJTpEirPqd1hRriOVfT6bQ-uQw&oe=69983D21"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eiag1i2thoEQ7kNvwHqLJy6&_nc_oc=Adn3go6dYSKY3a5F7BWRSCg5J5KmHzBhM5gCntEQNPN2WRy8mmWorD8VZ9UnlkOB6fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfszA0zVlr3qboUekzfLO8Ru8t7BYZz44t7cVAUo-kFsiA&oe=69986C90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGdi8btTmQwQ7kNvwG9LJNE&_nc_oc=Adnt8l2XtEbpxNs8f7yZfRyHhQQIM97vZzrH85TtnBjZvPfUy240OM8izSpEkbSa56M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv7K58ivKV_BLCZlnDMdNXwkeTfqsbh3zkW-LUz70Oa7A&oe=699843B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6sQD246YjEQ7kNvwF75XdL&_nc_oc=AdkaQpf9VuwZEGih-SYUmSrm7hofoZar_B6BhiMS34S7R8kXArcuj2vOQSZ5XIDjsoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuAmG1K3OUxrCIgbHwOM758ZT0_H1VJ7VZxzrWwEU43Yg&oe=69984F12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4JU5VuefEkQ7kNvwEUntmX&_nc_oc=AdkRd1HJkZTqB0FeXpUTyJ1z8gqagKxAbFkEVKoohI7tex5fn50aE3taLlPn9eqeWDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsU2mtaTyHNJSx4ijfhEpQLDhebX7i2gWvsuCHx2nq4mA&oe=69986019"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
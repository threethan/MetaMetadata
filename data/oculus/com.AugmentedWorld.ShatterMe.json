=1-7&_nc_sid=6e7a0a&_nc_ohc=3GvYh7bNnQwQ7kNvwFDZkQj&_nc_oc=AdoczTd3UKSoPUT3bApe7ovYHiI4NesCkDGQJWS68n2UAQZWkY8Vst712dl3gzktvl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl4rckQI1Q0T7k5RiAUYmwgAaFjww882QzGA-9A8TRkw&oe=6A75F161"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0UEJ3K2fgcQ7kNvwGd2Tn0&_nc_oc=AdqpdWQDk5JfWMs8QAIxMl6pmkKyXV4_EnLMD7v_SjP_5lXvhqx-1nf6TTizAb7AxsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_2mSAlp_owflvHrwGOrKVJvrfJHh4WQtypgmeMYMHmQ&oe=6A75E890"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOL35PaekeIQ7kNvwE-s4YP&_nc_oc=Adp9L8KGC07mfREjbAFYUBtwhAm-6QqwsFJ9pPBuol62-LlYXL0SZIeeRybmmbKbfYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFulsdMEFCXuj4eSBmaapU6kolI_bI0oL2cbKj4lkbZCA&oe=6A75F7F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V6nlplNoK0Q7kNvwHGN51C&_nc_oc=AdqAplAwNFhXTLVKyOpENpjOtfulGpy_STRXba1QgSOnmoT_sDJ6Nw9q5RYpfN18kl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmQ7H_Wmv4vGpCat-swgiPF2UP-gLPJHV9VDGtix7ATA&oe=6A75CB12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKsykXMW6g0Q7kNvwGuJC2f&_nc_oc=AdpCKwMdZN1Jv4bzHqJFjcA2k_421SZAwHFZDz-EcmkUnknV0bV0s02CQFCiPeFincU&_nc_zt=3&_nc_ht=scontent-iad3-
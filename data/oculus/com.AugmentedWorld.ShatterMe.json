=1-7&_nc_sid=6e7a0a&_nc_ohc=4wpSHfYdmtEQ7kNvwHQ6Im9&_nc_oc=AdoKEIXZH9CCUUI4qIaHGdSr-W8173e6CzmKM9WdPUwyj0o-Lcy_3Y0NOR7Z_nIRTrw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtzXrif2-hBBAUUg21wMqXSMzcgRh2UWHSPh0aLDa1CA&oe=6AB68AE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-zdqrn7EhIQ7kNvwHdZXqi&_nc_oc=AdoeCURoE6CnWc-lx01pHBPnWdqiFdSB9csQw3C9hg2hc9F3yqAJTzwxx3Yio1kxeOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4joPVdF5MaP-Mf1IcZDygBLXQfo4qjGdBQErI8Tapg&oe=6AB68210"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4FV-kJebSsQ7kNvwG7Obo9&_nc_oc=AdpsJ5zJ3SPpn9fYeBszbSyGtlfqrjpXz88pnEScunr7X9MWazP-H1kvnua8nCo7z1o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUBcrUDLam_Bc54rWTz3QvGuuYa9U_6eeBSO95J-W9iA&oe=6AB69177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4LNOxNMq48Q7kNvwFlBMz8&_nc_oc=AdotEYikiYECxQ_ZrlPpDseAeNlHhjpCueOd7RYqe3qX6ld_DW2N7wntm8CGW6v39DE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFbEwq8IiqssQU-JNHcri0NmAwZyxlbK6sH2ZXn-ABig&oe=6AB69CD2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyXpO8S2kzAQ7kNvwESdU-G&_nc_oc=Adrmtw13wfyWo7COQKdbayaC3adbPdJXWW7xJ2ZrmYeNAONC2_khp7cxZGgl81Z7AYo&_nc_zt=3&_nc_ht=scontent-sea5-
=1-7&_nc_sid=6e7a0a&_nc_ohc=7ePVhnQI4IcQ7kNvwE_FvXW&_nc_oc=AdrwnmTTqOnbDAsIAL4GIr9IiEHFSLN49pNPuHwL5hT1-8NIz_E7LkgejxL3uB9xfc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzn0_ysoxDDDSxe7BabaU4de3bt6KxB7c-lkE5blsKTIg&oe=69C904A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49NRtFBACvkQ7kNvwEI5RyP&_nc_oc=AdqaMby5w7F5QQ3DDW24GX3yKyCCCIp3LogU51AI1bsr7Q_piIWtxUi52JydXv9t9Jg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwakklhbaHOcshf9hWtVQ49c7sj7YzjUtHVkPyE3Ja4HA&oe=69C93410"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcu2PMG9-PsQ7kNvwFIbC_j&_nc_oc=AdqMGDDGGsas9jM_chW4a-qmDyQscn_g3QKwGmIeo7GIGlczH665M6Ocsz9YuvIC528&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5_WG3VKIMoW_YBAObkjEydcg-xInHNvkmFL9RLJyMuw&oe=69C90B37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ILTRZSby_4Q7kNvwH-kbZZ&_nc_oc=AdqyhWm2wv0uApmCP2GV9AbGWDyhLEtVN3ihG9MMZuM2w8mRTJF1A30fGMBQJcEoJUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ih5vjNFUv7_-2cSNOMl7JVR6S1I-mlrb2eaBp0zrGg&oe=69C91692"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z0mnRUyDiYQ7kNvwECoTGr&_nc_oc=Adq8D7VvrsRdMez5WOXRuJV5F4nCYEZH95slxiyKAeWc6_cgeRKZlMOWrXYCoCsVy2c&_nc_zt=3&_nc_ht=scontent-iad3-
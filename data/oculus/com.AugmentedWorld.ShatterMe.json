=1-7&_nc_sid=6e7a0a&_nc_ohc=6WtjoZBU6HIQ7kNvwFzVUbR&_nc_oc=AdpOPfWvCkxs3vwW7a1QjUcbALAPnHOK8r03HsiBdkMbMggs5MRGwb4gBkoxT_hpzz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F1qJZujADo5ES4380_j0U0bWyT9FANOoEP-O5acKv_g&oe=6A073361"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZiTnPBBdeQQ7kNvwFXDQGU&_nc_oc=Adrg_JFNKHmcEchR3BaFv1lL6xt6LFthHwV1BAk9d_ZI4v-Th9Q1J_vf_ZP9qUEU7V4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YMgKQGcApJnXW0On8ovu2VzngnISAeI4IR8g1PMYfrw&oe=6A072A90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfPMZkK91pIQ7kNvwEr32p1&_nc_oc=AdoVj3UGpnDlGaDgJSUe8WCPn-_Ko_65e32PXeG_h4pH4r0A4V5fTWanjqEq1oiOCuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RyGc6PcTXRHt8m__fjF5G8gUEpoGULzcWBU7uMrZIyA&oe=6A0739F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts5vk7zDJZYQ7kNvwGwWION&_nc_oc=AdpgFT3IgyGpjisgwAGcO1Ci1LMrIsOd0vcEylmmeTGtvLGygYfd6lGK0Zm79J6zp2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-0OQrYM7CsRMrbWbri6uYeq02WrCk2QenidbxmPdHyg&oe=6A070D12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-On9Id1zaIsQ7kNvwFRHIe_&_nc_oc=AdrQTy5HFb6znh1_XA6-gWul2HJ8bx48VOPqDiEGJCJEzK7ySYmKa2x_AkZAkBKWCxo&_nc_zt=3&_nc_ht=scontent-ord5-
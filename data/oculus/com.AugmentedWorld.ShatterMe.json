creen5.png", "id": "920899901960435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_920899908627101_3284581321115754687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhEgpymBGgYQ7kNvwF8DCJc&_nc_oc=Adq01l0i8zZHAef807QLvXtalRHj_EAc1GwZ9Hdtrp8tfy-IiApKVmez9Dne3c0l84k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqz7Vj3bQX-fW-mxyS5_D08UwPRoVAZmvqaca5SbTNFw&oe=6A5F5542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1414812452370639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974593_1414812459037305_4441829631623283258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw-ecNS0EgkQ7kNvwFQGvn0&_nc_oc=AdpF0TAyGFpZQtIXOtpKo41pYewI9-t0PQ40tzVHugKSeZbhdLCaA55cQi88teYZy84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxpKkM19Mxt5ZoSRUskky9h-eGu4Vv77pMzJcBzpJLIA&oe=6A5F8240"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url":
=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp5ui-nZQKkQ7kNvwFQrBRG&_nc_oc=Adq471RG8xArkCKQV4rgOxSP0YMz8idoxFd_sAuMPbj2h6L7m7DHTl_KZt-2Gzwx7Ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZGDlnjDAqpmp6DnYhJmAILEB8lFJSdE1MmLfoIluonQ&oe=6A4FB5E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOwj6KwbB0Q7kNvwHjbLIN&_nc_oc=AdpYl4PRUDRiMmKDwJzLFr_WvSnvElqoFg8Sn2ocePhDuULLXQLmAVadwPWhxF-dpEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCouy2WTm2fggdEOjSZMgnpguvT97Rycpgae4f__evOzg&oe=6A4FAD10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Vx8hMLPjDwQ7kNvwEV3H8R&_nc_oc=AdpDvtqgo7gQ0q3X3kyfuES5SIuZh5-cHEBqGSwx1FCUfOynWViL-9JfIC4bccHQvoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClCsVxDSXZTcfMPXXKA6Jezn2ZjmXF7vNQ00K__wRK7Q&oe=6A4FBC77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64406jKR5DgQ7kNvwEmMeg-&_nc_oc=AdrOHmpTk0SlZX6Kf6Lnz-gGCSRi5_2-n_rl-d1BxSeDcdYK8an1S2oAqhMLZtoqVsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe9VXukuKoyLL5wSP3VmPTMn0g60DL50mBEyjhvQNNbA&oe=6A4F8F92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YTWdWYbieEQ7kNvwEtR6kl&_nc_oc=AdrJCyVPbRL5aqOZb3cULkw3WoZ9BTXSLx-69lB3Mb3wXYfrCa-16AaadCIxRETA9Bs&_nc_zt=3&_nc_ht=scontent-iad3-
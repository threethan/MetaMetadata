=1-7&_nc_sid=6e7a0a&_nc_ohc=k3b52xVrNQIQ7kNvwFAuSVM&_nc_oc=AdoJDlfAsnPMMY12tHpYsV9h-f01Wn3ltpVyC_SOOhoFQ-INi2Ryt9KqTi1SxSigB-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JNce2865LS-IUpQBO7-bvCS95nz5o2MEX0xNNCJP2Cg&oe=6A0F1C61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4lq6H8MyWoQ7kNvwH8eCgb&_nc_oc=AdqkmhCEDA-OhEO0uG1v8nbuYeYaOBf6S6AV4G1sKnkv_AEw9WHwyJnxZ23p-igBH6c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lC9rLys0NzI_r5n70lTcFs3Ms7D_gNQZyxfCkaKr97w&oe=6A0F1390"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmheI3THOnkQ7kNvwHHVzAB&_nc_oc=AdqTFcOlmIQwNYP7qYKUc5epVYA7LnngJ9Ld7issWeFqhOSF8Yks1nuhyth7C6Rh-88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eq16cyAvwbjaw0Z-hmsu81orfqmG2Y1Kfc6fO3gb_vA&oe=6A0F22F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMu3yI_a6EcQ7kNvwEfS1u3&_nc_oc=AdqshWw6Jq9r5DTp8qCCKnFoK6fH0AFqfjKZZX0IrlSXuzuRjTVrg0uP18YbZCNe7UE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Jl0QUp6a66beAae6miqFzF1ro6G1BScSmUq4Q_pgbg&oe=6A0EF612"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=732MP4CS3-oQ7kNvwFLe30M&_nc_oc=Adqst5QuoKAun1PBR6-CN0kp-acQKjlQcwO5wgAoY9W2_PFAExH6UISG_NX7JKflVNE&_nc_zt=3&_nc_ht=scontent-dfw5-
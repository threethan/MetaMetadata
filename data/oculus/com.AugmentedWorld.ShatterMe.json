QW3IS8bOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkZCr2iijs9TW4nGXFl5r7_DxlOM9YRormg4Rdh7rJhw&oe=69A6BDA1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LM5yXGKT0kQ7kNvwE8Iz5a&_nc_oc=AdlGAbEJ3VegvuVdUde9JpBnecpFFgjf9_U5H7-lMsBssVs4RAaT6PgkIvLQFpaSQLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9Zf5xR2kuv6TLjB0lrIKFwy_33YiWnXsPmnGLDJcyAQ&oe=69A6ED10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E66OfF3G_H0Q7kNvwGlOc0R&_nc_oc=AdmH3oxMmHCoPrENRo7l5vvWLsPhRyubEyvoYkjM4xx49rqlHae5ZSG4hOnzE3E0xrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8iiYUlYrLd8WbGSWnjVUslyCLD7YnAgKpfN5iaiVrqw&oe=69A6C437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHl6-tHKN58Q7kNvwHHxo_1&_nc_oc=AdkisFKqgQielXAW-TmqIZVVCRaua-JEoITELSyyawUsKNHOwIWPRsgt-ljQawhnge0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupGyV7Db_n205WBvDSNzlI5EZDIiDEduWK7uWnZpGzOA&oe=69A6CF92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzqCA19MRq8Q7kNvwEKJBR6&_nc_oc=AdleTgfFRXN5W2KMsLL0ELnYC6fTydt6fpQupmlJFISjYVxZd_phv-su8OeHwLM4ipw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgyRZN43lRHWyvs2IVlNOlp9bWRF2X94kYoTnTzPJdvg&oe=69A6E099"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
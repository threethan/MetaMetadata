=1-7&_nc_sid=6e7a0a&_nc_ohc=19XZArPU8D4Q7kNvwF-pzVW&_nc_oc=AdqQlquMmqLO0tNDlXo0oN6LT2ThoGRLN6koDd3h6IhLPy2Sl8IoQHcvIiKIM0Ua5BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGGNSNsJK3PdHFqJDeyUSQKUPgH71kSQ8sBIuDSITDGA&oe=6A6CB6E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56u_mIW11jUQ7kNvwFcEYP5&_nc_oc=AdoaOFSWc87hq-mcoCgDfMN82aNgkD-Ka6oY8wARKNDEPmM_4W1rVBO2Ro2cOp2cJ64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDYtnTqFQ2T8r1qPOnvASfZYiROx24Q4p48lwuxQiK5w&oe=6A6CAE10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhD5Oct7SwcQ7kNvwGH-F8a&_nc_oc=AdpH7C61Qd5h0RMZXiWd-OaMI2Ve_8WRrFTW4L4mE6d5LOxOg6YdO_unUnrlKp5zNQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY5NB3j90LAxKFBNHgDd1HoEieHwRZrLEhrBHm0knV2Q&oe=6A6CBD77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4Vqqv3Z-KoQ7kNvwEidBWm&_nc_oc=AdqY7gcSss9A2q16XaVFgXG1fa8tW0gGNr0KW-16bis81jXpBKolgL2u1OA0F_RtHn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9gt1y_UMROot3opDhfbUcuea7ZKaO1oT-40qN3hacqA&oe=6A6C9092"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZK3HuBhk9sQ7kNvwGEitkw&_nc_oc=AdpLi1yOSXQXYSxhGJw6QDQ1NZPdBeXrWgW2HskN_PBEgW_rvArFFpJogjriQdAIQTo&_nc_zt=3&_nc_ht=scontent-sjc6-
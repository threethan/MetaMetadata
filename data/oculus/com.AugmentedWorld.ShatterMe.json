=1-7&_nc_sid=6e7a0a&_nc_ohc=of7FDCO9wf4Q7kNvwFoAD9l&_nc_oc=AdorLpGb773YuaattY6uOI6YuNTQNqdNbPZgzfZXriXeslogqbdx0zR-Ot0Cki2SZT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dK2SorclkXc_aO2lwodf2sJqI5v0xN_MOYLzdBWFpVg&oe=6A009BE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAbUXoI6YdsQ7kNvwG3tF1R&_nc_oc=AdrbqWFHIZ8NjaMw8r0CwyBbHU7-ewqqEWLqrPAaXz7oa5-Ac01ThWtVQHNY0T6nOio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cnYWENgp4Nl8J63E7fyFwwmtznnGazez-7ztgiRE5HA&oe=6A009310"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmh9Us3p-0cQ7kNvwEttv_7&_nc_oc=AdqDpC7kTZuxeZZyOiIY2fkRvSP2hlEpu5G-88FWeV0EV8YefzZC3q-Sh88OiHWswHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lz352pDa0W5wAyOhgezF0BqqeZjUAsm9bmEseSlbndg&oe=6A00A277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1Ux79R0L2EQ7kNvwGwoKm7&_nc_oc=AdpCXopukh9o6yEXpCJTu9lTwMPox1KAKK4nKRPRICIHceUJ92emF90VIHO1GiA_nMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rNe0PFQiOwIp57etfVxjLkwJVMUIP8wY3iTLIiyuekQ&oe=6A007592"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lWXonRE29YQ7kNvwFb28ti&_nc_oc=AdrJkKE7Mc6BpRrgYHIyrFxb40iW7klJuq626rPGUZTM2smaWB0bvtpmqBoy9OVGYyw&_nc_zt=3&_nc_ht=scontent-iad3-
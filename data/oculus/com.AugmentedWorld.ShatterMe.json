fN4OBQg54&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsTWHVYDJ67WGKoIkzY0PNIpphV9Ax7EPXz3EU8hl3DzA&oe=69A177A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLz9kbeU0goQ7kNvwFZJDpf&_nc_oc=Adk3rK9Jzl2MvmTC9iiG-DoqLJmxIL1anny9HNerbI7i4sFtUyCb9v_dvJiXRl4LWjg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs22E3qZ4qHFI4etKI_OjaZjzkHwScsf-umrMPdZyp9iQ&oe=69A1A710"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB7L6CSSuD8Q7kNvwEZkSk3&_nc_oc=AdnP-f8fIz7OF1uHUsPCPkK-6FUbgPxFeYhIDvlv0tiyEzNJqYefzhrMubf-x_y__94&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsCdewNkwFfN2l6OIhlNyLhOd2GUMH7aGmIcFA-LIuLkg&oe=69A17E37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khwDaHdTqXUQ7kNvwGfXVCL&_nc_oc=Adk32PeVI_EkKZ0EsR61FzWZG0yzUKo48OwIRucC2WZXyUA4EfFr2QjTGF8ibAiEso0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftjTmNikO3Qzc4iDg0F6Q77fkZCmO-6ZJ6MEk__BpTzRA&oe=69A18992"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsPfTz0g1qIQ7kNvwGR0ror&_nc_oc=AdnO9QqV9HjUe11xfEtdE5Q4ya-p_Dv3MP_6S1wA6zjk1DjBsdhRbErj2c6V4RofuNo&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftsN7u4DkUz3_KnUqfzKpIBfBm9e12vO9l5LAfOtH5rQw&oe=69A19A99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
=1-7&_nc_sid=6e7a0a&_nc_ohc=utKdTteBstMQ7kNvwFSbz_m&_nc_oc=AdoR9Nv1uM4PSSG_4xGqcYlVoHmvhOK8kMh6bKi3mHnZdNpuRs6yFbakXvYMc38vxu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_zJlXMadzlQtxx09lppItZdU5Xn7cuDRuXLLBuEXocw&oe=6A033EE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K9sO44ctvsQ7kNvwF0pFG3&_nc_oc=AdoPB2uAWj_GsmILwSzPk_TNGV8Dv0Xj8fgd_jNQX9jHQWqMVpQGK7_F3G4if9Fnhi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WRXEhjqX9L9jhqv5shBXIjZBx_8-6XIWV6vWJ1wk7TA&oe=6A033610"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq22Q8jfbBUQ7kNvwFj4LEC&_nc_oc=AdoGXkNTtpD5ms2mmtbtCn_SqJru25Wx31ryuMK9pzApgxXh1jR8bkhM33yCyaTUiE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sDtfqagbS5Qe466ARsz28El0tK5IHRRM-QLODFcglag&oe=6A034577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etvb_OabEegQ7kNvwGWx_8l&_nc_oc=AdqXu1-c_nn86Ec2djIvROGa8GGp6vEewBJgV1l0BQJNYxYtQGnznk-K0r5GOYf8uio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vb_jGL7vBhPqJRE2ToHlDKBGq5ZkgxCtTTDV2Wi_oog&oe=6A031892"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxAClIVTxHkQ7kNvwGLEHpa&_nc_oc=Adp1YQ0P7cCnL88ARMctBNZ8UaqzX-Z5LreMDDvjPReVg8IgberVp3GqQ9WlN1e6InE&_nc_zt=3&_nc_ht=scontent-ord5-
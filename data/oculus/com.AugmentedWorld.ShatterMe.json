EB0Q7kNvwE1Awk5&_nc_oc=Admh8fq0O2EAqoWNfW_86w_C9ipZSpPwvWGPcaETFXQgNaubYavBGHCBOgIaGmPcqS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2uiMqdoPudxeeIAZDsDfCeJIqr7D6_5UAbYvWw7fEsw&oe=69A960A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LM5yXGKT0kQ7kNvwHx_opE&_nc_oc=AdlSwVdOOzbCEiSP3P-P1lW5PqF54_lVKenlDE1MK7kfSDp84GG0nVMi8Niv85025hw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvVMYtPeHtuW6k6JdyAaRw7Vp9UK8P_auBhroC6-JkWMA&oe=69A99010"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFkXtH3LpwoQ7kNvwF8mMKg&_nc_oc=AdlHeNocZ5Od7uhdcFhgLVyZ9jtobQQWVg59t-pjiOXEbBe29O9JCx238LNrsu5W9zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_AzR67Bvnz3EAihxc6SCqs1SPzxfxtK6cvoUmU9rHDQ&oe=69A96737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIdPr7cO3IAQ7kNvwF-5obw&_nc_oc=Adli_o-UR0yA1m-GXABrGGPE_VkVIzEiT6HorIlM8DE6Tl7wNQHDxvS5cZP5zU-J_z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsBezcFjMiGhBi_IjPU4JS3XG6OR3dDEKqrFVXtbq-zyw&oe=69A97292"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzqCA19MRq8Q7kNvwH-mNrI&_nc_oc=Adm1kbyzCFFUTUNQALc9h_FCV9hqYLn68JlyTxVChZ9Y2htLaI59pJcJhA3HpQUZvD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsNqFO9Bv6cDB68LyW-z
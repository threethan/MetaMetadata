=1-7&_nc_sid=6e7a0a&_nc_ohc=qZZVV9bmUccQ7kNvwGpVjkm&_nc_oc=Adr07m8of3-HXQ_54L3Jq1kvIwK7mMBTT28uV6Ma3PBKSJF5lmk5fN2wF4QrIA0MjCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqL1g5ZScJnTu2favKOZx6XFs3Acy2HGB7LKAwniSsBg&oe=6A5CE4E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVuwFDCdqZgQ7kNvwFN6BW1&_nc_oc=AdoHZH_M039YFejAQdAOo23jsgKqdDjczF3K9HroepXY4-qyMq8f4ggE3SvZJvo354c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv3QmCdDL2BTEH7aCWlC6nh3JRE5BMgtAP4a4q2K09ig&oe=6A5CDC10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idza2rjwWhsQ7kNvwFhxiHt&_nc_oc=AdqQXS0gJtKGoJ3fDzd2paY5WJHNe3K2fnHm-E_xjXBJKIT6kcTMXXa82wa2b5BlsJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1kdZoSFcF8v_7HzfxDQ4DUl3crCJmt-T7tU3d-L_eng&oe=6A5CB337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18wGpkjSLTkQ7kNvwEy4Vu5&_nc_oc=AdqaeCC2cJ0hBZgcK37JSTFDNZTnCUeDD0TvEZ3QwfKt360FQA3VMNeo2kTUENGra8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKcVRpxFu5ZSt0iGTOChWN_0VwVcSZ_A9l81dJuPl4DA&oe=6A5CBE92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7OGNrysqFUQ7kNvwGNwX3z&_nc_oc=Adpa3QB6xtRS7Mj5N36kHWOsloItd7WZhm_1efh5ntDhLTgRXtx3YEAyofWVj4quGKY&_nc_zt=3&_nc_ht=scontent-sjc6-
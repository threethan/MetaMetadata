aUgCjmRcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoRpiF6gbueTOsWxHPI3FgrVKZ1WTnky-UOwAvpNLPMw&oe=699D8321"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha60GFwijsUQ7kNvwEVdvJc&_nc_oc=Adlar2S0N0Bu5oIBt-QESsJYCONC4J2hTEwsVI2btsfv1iFctwCKrBRIV46gHdY-_Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNSilURk2z23v7xedUPRaVSf5-x8UZXM0kZBJL_KdFZw&oe=699DB290"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl1oQYOP3kIQ7kNvwHmij9y&_nc_oc=AdkYEV9O_HJDDY7_Ak7NBtBkc-wVgU5GKOAvy_Fh6juW5flX8YdMdX4tYFHnR6snJf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxvylC3zndZYuUPjbXdjZQ957XTAehQlrmf5y3HaAaFQ&oe=699D89B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnDck0FXtU8Q7kNvwFGWmpI&_nc_oc=Adn0FOLWrizibua0HOvOFA8EJ_bJ4SPaLpNPtpfAGq-aGklFAxFfbNa-wGeCpxeUeXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSttqXvin0F1in2JsVG_h-FxtlVzSa3x97gM7dDVcl2g&oe=699D9512"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuH06msNDugQ7kNvwGOz3Ex&_nc_oc=AdmBJ9XUPlnoFcomwTnoQlqg8srwynUyatSmHfHfCslRehrG_KtkTwFaQYWfjefF7vA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstvAstWghNdbqCvUkoLxn0V5HpcFKSaRtVi34lYNai7A&oe=699DA619"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
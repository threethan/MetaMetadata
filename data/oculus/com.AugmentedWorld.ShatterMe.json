=1-7&_nc_sid=6e7a0a&_nc_ohc=qZZVV9bmUccQ7kNvwE8OSOp&_nc_oc=Ado-NJM8xg5vZv2Vi_FLugDeooAVCJXCEYZ0FmMRHi_nyQmnAuE8PUDlW8BQChdXfzk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANCiBDUy6V1itdI3kxDq4EQRLRdtruwrS1zZOlNbOeVg&oe=6A5B9361"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qanO7arTIg8Q7kNvwE3uJvK&_nc_oc=AdojUssc51DknLApoA42bXKuUTlSSsFn-mwnA9DIygbncbtmi_GJjdNzGTWJB_8VdZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPRvT8VwBf0uNFA2A6XJEB7aCa5Y4JkzWkq8bpG97GvA&oe=6A5B8A90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idza2rjwWhsQ7kNvwGJLDhq&_nc_oc=AdovZTD49RIwAUjInzuSMI0_Sku3az_D_J_u4Uc_Dex7FmZdBkgWqo35F3c5nektrN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbyhc-enU7cO2hWa8NZ9Io63fahj_PqvYWzyRHgvigDA&oe=6A5B61B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18wGpkjSLTkQ7kNvwHjtkpL&_nc_oc=AdqEgl-pz02OTLqB87osv4xYo_uEIqXNZYhGr3WxFK_m49ToWT6-xtGRUZpz--dicX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgwQxFYFaqxtOpIu78jB-VJs5Do93JHcDyOwUXtSVJNA&oe=6A5B6D12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR3ktWpUh60Q7kNvwHbypKx&_nc_oc=AdpyTHJi5TwKDl41UJj107skeOPTqWp-soJjrZYJ1hUqrFB3OnQ61mO3DH-uYKt5-RI&_nc_zt=3&_nc_ht=scontent-sjc6-
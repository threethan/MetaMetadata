=1-7&_nc_sid=6e7a0a&_nc_ohc=wzd3wC0fBMgQ7kNvwHqF0qH&_nc_oc=AdpyIdg8eqmG2fW2b-A9uulJczqnmeqPIzHGsJIvB8bS7_3CeNo1nHsia0beXfWf-yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6IP8QspNgenudwv4xjsTQgxS0ELy6lHv_K2O7y6yRFA&oe=6A9D7E61"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI942Q3XFFEQ7kNvwEzFWdt&_nc_oc=AdrHmZtCDTfnRXz1sa8HGK3AFNYQRBIwZGUXJ-zuZ0g77yUl_HT6KkErc-MEuK_SrBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-JHvqnoIZLx4YqmXEWOZr5R47FV-jXL0dA1kghsvHMw&oe=6A9D7590"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCjcKFsNJcMQ7kNvwECATDk&_nc_oc=Ado8h1iNP4rKWUndxSUoaCaCIqDV_vHdDTQpiAF-EomKlRqDUJ2yWqh0naBc--GR_dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLDXAIRdMXDev1Cf_TZMSfC37LP-c-Jb1QDnnJN0_tAg&oe=6A9D84F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdnKzw2kkgoQ7kNvwH76MAA&_nc_oc=AdqE1DeoSQietqGPYtK7KjdIO_YHqhBk8ghfAxD5prWcJnmwJi9JrcfXzAjUOpP9iZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4EBHujVuCOkMrVd8djBNENwrPYboK1rDNoG00i9TtEg&oe=6A9D5812"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXk1bQ0IIsIQ7kNvwHUtgid&_nc_oc=Ado82bcoh_4WVy0GzweKZhKpJ0t7Uh5mG15el3g6fYBQo-UDIjiKgg1e8pEE6nGDv9o&_nc_zt=3&_nc_ht=scontent-sjc3-
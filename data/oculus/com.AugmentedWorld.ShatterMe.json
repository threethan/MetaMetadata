=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv2Bnkg8XnkQ7kNvwEgVYps&_nc_oc=AdoVNRYlHaZihVrF1gBNZXUC8Lz5rh9Pg6fUUH0XX4SYifn85clBt3htJWDrqcCmuo0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M0GQHS5vpvxQtMZdtk9tGZytwOMPO91edjiB6LNCHPw&oe=6A170561"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC_QYk_QYnkQ7kNvwHAC0Vw&_nc_oc=AdqBVb3vaJp66AsM4QoHyirfIAuTpJXAWypHp7O3FKHg1fVkjQ_K6BnpGpC4o2vhUjM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67lf_U-hL_Qb4rAPfoKYVvH_OTZ-ibY6R-bTEYIajeLg&oe=6A16FC90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnpPSxYahVgQ7kNvwFbQHkc&_nc_oc=AdrhAHOA6oImaAIOgyC72sIJfep520g4R9CRuV9Fg4fw7Qfy2nn2BmRmRLb_0amYbJ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kTJo3YQWYlD-Xg7LakBH2ElHyw1zqd-7wtGSDAFjl9w&oe=6A170BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayd8DJU0BAsQ7kNvwHRw2sI&_nc_oc=AdomeUHdqXuE5jZnPbFJEZ_idhmtZ6VfGzu5UBcQ87oOFwcBfcaEenLXEWWObDb_gZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wdifjP1j63yFEA-xUQw8VG27QdbI4h1L_RfdBmZkc9g&oe=6A16DF12"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyjzf5esSPoQ7kNvwGgw-G4&_nc_oc=AdqHrtpNGqt3SwLGFv_s6tfvw1M9bvkP3I5MPvrodbSpmgtvwcjVg_1ao-4akQ9oaXw&_nc_zt=3&_nc_ht=scontent-atl3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=KopA28WLfnoQ7kNvwFAjX5n&_nc_oc=Adr9leYeOzjMPwSuZjPyjT8khx5OBXUsySBZxrY3wkGrcgB9KWj5y2Z3lW0xEtTTOrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1bOHGUr4YOgEDlhoUp8JrVww9-GSBVAsExQzENevfMg&oe=69CE82E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHawhQ-TqrsQ7kNvwFoL1mT&_nc_oc=Ado0YNP185fJhOQJQ5tMXijf6zsKW0SKqSJLRBNMHZpwEna25vDyjKwsJLbLvpe3aoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYLqvJJtW-QXVYdoUWH9lTJfY8P3-a3ahzoC-xvbXhfA&oe=69CE7A10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d34xvk2gZv0Q7kNvwF5G3Sf&_nc_oc=AdrmbSQOUC3KK4elSbka09hbwcznRIoT-cVO1GCHQF6OrKgrtvHKF3dhFTRNvG3lZ0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGGzuq1Mp5ikG4tCydicl4AsqrykU6OdlsIYSAz_1TxA&oe=69CE5137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R__2aJIQ_ykQ7kNvwEmxW0B&_nc_oc=Adr9XxOL_tmdMiWQ5L_p_ZCM1TCtJSPUgYeIR6HmdwxL81tn9m5No8iZewuz6FXwOaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRXDt2WPvQE8Cy4VArkpymiLnlVjrZoR2b7dk6TSl9Nw&oe=69CE5C92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVzFvtxNss0Q7kNvwFrJrE6&_nc_oc=AdrvOWsNQgcSXLk_pVcPuW1mN-UNobSTTpzO4rDRSFmdcVnRwg8absHUKgk4_OYBXO0&_nc_zt=3&_nc_ht=scontent-ord5-
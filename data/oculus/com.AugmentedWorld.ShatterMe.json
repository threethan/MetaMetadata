=1-7&_nc_sid=6e7a0a&_nc_ohc=tfzwFagNiI4Q7kNvwHktG8_&_nc_oc=AdqhakGRG1xJBaldG2ZfLZLK_CvC5sKW6gYj2r6Ff6-TWFS6z81XJPsMfo9yz_D70uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsKl6mvgNsZiUn2TO90XGJbKI4NDQr1O0UcuM53WW_og&oe=6AAFF361"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTnx7seEQu8Q7kNvwGXiqbV&_nc_oc=AdpsNxrFC_mHbDnHLWk5s5vB_97W-N5sJJpLiebnUgkPzG6b5ni8VPj0uPNv-Bw4ek8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTzF3858SpbYR4Jx7wkOE-XHK2a31P4JQPKN6pjw9-Rg&oe=6AAFEA90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6W2uSjB87oQ7kNvwHFeOEd&_nc_oc=Adp_RXjP8FlEVmHjlNn0AJot3suu3es3BERemB8yGzHOI5oQPTuiCSotjX4g0aiYVVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKId_Amz2C6Yt7kd2buDNQAai0h3vkgr3znayfJpjyviw&oe=6AAFF9F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnzGxtYUqroQ7kNvwH-nVoi&_nc_oc=AdowwvbfuaZVhUFq9ATU_IX_XlSMAsqLtqw7niWwICBRdRCEG7y58FAj7tDoZK8kc1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm91BzcaXBP8M5JxuCTlWltrhji96AEr7grArAm8_A5A&oe=6AB00552"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_icG3TvSoFkQ7kNvwHG64UH&_nc_oc=Adr4ZsAtJoeEv4ciYx2KXd7vIr0dXPiEFRVkFgaKmyi5loLyJfqBcitlPgU7Ul_d6GA&_nc_zt=3&_nc_ht=scontent-ord5-
=1-7&_nc_sid=6e7a0a&_nc_ohc=lPDpc3YW0IUQ7kNvwENUKoS&_nc_oc=Adr_wYT5REj_Dv_69laauatFKGyEziGOB4s4b64bbXGEPkA3pSx6Lp2KtgoZF-w118Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvgj1jFcYiy4MLhXtsZGyBurt1sGoaR-dxKnKbC2dT0Q&oe=6A579EE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyP0v0Er8-4Q7kNvwGSwYr6&_nc_oc=AdrRMob-LZAZIgdm-1-dym3nxc4B4hRn0lcHZCD9XKLCuhMgQgsVQDKbnqFRVmn7Gs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiGyRnacjVjTY-36rulOVK1bFoBK93xrwryhbHAdPFHQ&oe=6A579610"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVDVXPMA6vUQ7kNvwECNJ_Z&_nc_oc=Adp9MsKleL8XkP6PNFKMK2D_XuK3fWYnyEb2y0gPqjibZ3vkiaJQvdbLglGIYuzDM08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADmO-9akdwisoknLcy6H4pkqbxCXayhRN8OaHMyajEwA&oe=6A576D37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMvjHuiqpDQQ7kNvwHj8ESM&_nc_oc=AdqJvoOc_UxJbt7bQcA9ULA3ByJF24uzAX351I1-1X-vmKtOxX4Z8pGxWZHbVJNbwcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVggQvB6zjtIJ8qzfQog4Ab23aCWmgs9kDWG7zFBdNcw&oe=6A577892"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gXgNjshcHkQ7kNvwH_hXWh&_nc_oc=AdrUU3dNAE7A9jWO0BvvJDeQw1ADZ4WTU-_9tiBMei5et4y_AqjhkgxTBFALLpa2rpo&_nc_zt=3&_nc_ht=scontent-iad3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=32nrkUP3x5UQ7kNvwHrWlCa&_nc_oc=AdrEm86QHSniIIGVTYvM5jLEwebDeol7JhrJG3bDHsLelU6BoSvX26lTaOOhK00z4Io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZnzYU5G_OpeF1ju6I3Ah243-nSSQQMe76tnQ5pRdWQg&oe=6A8AD121"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VW01iwmSJgQ7kNvwFz2Ul8&_nc_oc=AdqRb-bM91zcVn62ijwUAQviehNzoXeD_EFj6qiV3BwwxnzVJ1NLpl9PxbAQwFAxSZA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjPDNu7fgn24VFjZQv_ssUn8o7KtvXiqkmJ0z8iXiztA&oe=6A8AC850"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENUkrWd5dyEQ7kNvwHoIKLU&_nc_oc=AdoNa5IUu1biMh_kezQYcoIsVwX00Q_UOYOHGICEItYCL4k2Ux31n_WPyuWLFhzzGkM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPWEe2zJnYPe4sIV-ccCAVQm3yP2u-SfQe1zZ67mTLKQ&oe=6A8AD7B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPOUzOIKw28Q7kNvwHFKygc&_nc_oc=Adozf4ade6_c4oMNIwzLQMhy3NtxOIQksJhOms59U4CZvYpT-dq3VjiF7GrV83azfaM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExk-MSe9BePxhNDdQBYjNI-TIVQNdkjrBn03ZbFn9u1w&oe=6A8AE312"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZd8ynUjxVgQ7kNvwFHPm4k&_nc_oc=AdozSiRXkTxTLKo1WuyjwShu_ACuWMIY4ThfSIKmczQfDrPmDxI00CzSEzUv-1gA9R0&_nc_zt=3&_nc_ht=scontent-dfw5-
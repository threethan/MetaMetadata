CTEQ7kNvwHhDYln&_nc_oc=Adl4cPmg5HPqF2A4h1SvhDB3KsXo3edhM1RHYeShRrCesETxr0Ih3wXM46KSgXcQoRc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUNlTEyhJaKkDTQRoqQ84YRlHzEk4sCsSATgl8ProF1g&oe=69BA8421"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQtEHyBtPikQ7kNvwF2AGwm&_nc_oc=Adny4HUP9y6UokyJy9SynvLk7BzbFiaALQpR8Wj3wd-S1IYVZ8I7BvqilmFadXzxA_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwflz7Zx2l05u7q-y7kCFQfprte4O-repg1kt3x8hOBHA&oe=69BAB390"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20m9V4ebDVAQ7kNvwG4MZ-w&_nc_oc=AdltFaLt89HhBdazlBP7-Vqe1NnASg22uokvhPaVt4TsZPcwFHJmPbZhx7rl0geQQcQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwkl13huVy2oLr-xkGl9UwYS7vkdcSuHla8Ye-KOLZPFQ&oe=69BA8AB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I34lRYRRbgQ7kNvwEq-Nck&_nc_oc=AdmbMUHdtAqH8bxp_ftAkQD3Q3doRgeMM7Pai0NIgZ8BMRoMzgzerXy2zCg1XvSlOTE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLxrBbVKwQx7q6qgfjRFtZmocj2j4EQH8A1i0X-kXcqw&oe=69BA9612"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sW7qhUusoEQ7kNvwHXQSfp&_nc_oc=AdmnHsqnxmcFTgY8Sfttrg3nVOjNQ7AXN9eOv7CxSI58o7JhONk_DbgbSHZ1TWGv3BU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1ZJRZ_cxopC2KeZMjz
=1-7&_nc_sid=6e7a0a&_nc_ohc=7ePVhnQI4IcQ7kNvwHrWM-h&_nc_oc=AdpstcGPuYlH-RQLAVY2lESrbT4bDekMcC27hFbSBsM6XWFGD62Fs47JKCE-IRU6oNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2npUeKS31M80HY2L-YEwn4gjgeAIkQT_rkgZc1BSyww&oe=69CA5621"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSsc0ivgXIkQ7kNvwFWPLVW&_nc_oc=AdommtBm_Ql_f19zqhSN7b0l_FWmPhW7X_8ZjcuLOvRXrwqEufL0iQyxRONPBcvaVlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiX1oxSJLp34IN8IhCU7eLhEwlS_9gcwwqBMwn2Kc28w&oe=69CA8590"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcu2PMG9-PsQ7kNvwHT0jQs&_nc_oc=Adp-O4j3cfBwHfp1dw-Jt_dC3JJv7UNyagiiGwtyzF4bjWhapVEq3EVL4Kus0sD3oKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyVbxNDSsT2EAvObSflqKZN45Ro2YIT_Xfa4ASqAlqxw&oe=69CA5CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ILTRZSby_4Q7kNvwE7CTKh&_nc_oc=AdphNKXjZpiPLSHYnmTAC0GV2vXLmzN_h2839GsMoE2l7fSQVs8m3x6j6T1I-36Kgio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbGjbw7n1RY51RGirMHJFZWeXcSR7DISKou9QDUCwlJw&oe=69CA6812"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGuibsOB1BYQ7kNvwFjG3Ts&_nc_oc=Adq58FobjfS6BZSbHNYW9n25lQjaCxV4c7-W6uwXhkmbJsTtQUx52j3fT-n_WYKyssM&_nc_zt=3&_nc_ht=scontent-iad3-
creen5.png", "id": "920899901960435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_920899908627101_3284581321115754687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fQKIPut-0wQ7kNvwFVVHVA&_nc_oc=AdoDngh6y1NaghVTEsyuWJ99BViMjGyL4s2n1Kp0LBs019p0E-XfnCoOp16XalgqTuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OS37fKHoNIE-OVdOLp5Sm4uR66wtATC4zlB4sGxZO0Q&oe=69EA3802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1414812452370639", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974593_1414812459037305_4441829631623283258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0TVrCJXjzIQ7kNvwHdeDMF&_nc_oc=AdohCOEaoJYhc5-R1BHNgi3VSGlsr7KARJ91gYY_FDUPN6T27f5N7_WDWwnvDJrLK9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LjgJalNbF0jFGCXzMeSTB5EgdLzfWDaolqJkLYI43XQ&oe=69EA2CC0"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url":
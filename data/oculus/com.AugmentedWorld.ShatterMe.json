=1-7&_nc_sid=6e7a0a&_nc_ohc=V1o_cMl4dFMQ7kNvwGfXtD4&_nc_oc=AdoATWOr-2WKSw72jZoCaTUnQ6iVGl_PUk99kEX9nZbOB9T6j4c4_uFNJ-bkmtKt3xw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w9YkcoYDunzMbc8iVXNxdGzht4YijNUV7kUv2MkbwiA&oe=69D90EE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n04hloHoDcQ7kNvwFjfO-u&_nc_oc=Adpm29gK3GQwDzLrnrqeMv0jlDqkLz_lwlXYyGbdGY9eAkvX7lcR-er6emu8XoK443k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0URiFMxb3YTFrClr86Ys-b3dMSAhJVtKLYou050PRi4g&oe=69D90610"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Fl_E5OkG0Q7kNvwGjd79m&_nc_oc=Adpr075ZaWkH_GWy7blrt2pivVdBG5GfTLm-rBx6Bq8rm6hbu6ToAISdYnTkOeSr5VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VoPn-UnRRByKbEJqOvBUFvajOkr835fTim6roJF3pRw&oe=69D8DD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLREdRg0gaMQ7kNvwHi3pKc&_nc_oc=Ador0vn0P_eIqTQ5Hfq9ZT-ze1KDzqq3kJaqVpHSw8IDZtZUG9DO9-ZqHU64ioAehiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GT0uyRy8Up4zXXqEhdSD9AiKfc1CV24uZeEPpF15tcQ&oe=69D8E892"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m7RajN28hUQ7kNvwEKKXxU&_nc_oc=Adpp8af4wJwrUurNLCIqHm5jvZGOKgecUUAkpPYj_vBUpD5g11PeOiKV0CfvRa2kLv4&_nc_zt=3&_nc_ht=scontent-ord5-
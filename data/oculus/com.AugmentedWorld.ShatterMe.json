=1-7&_nc_sid=6e7a0a&_nc_ohc=gGGGPxCbPMYQ7kNvwEyW_YS&_nc_oc=AdpRfNMjoA4Zwpj11yNCEwlOQOvk27vP0_mTr1ZPcZsbpcKOAXEiGcRjP48DcNcWz10&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vxjMUd7ivkvsJ16Tg_DPJ6AOaqVR29mrfsPXKKg3GGA&oe=69E24961"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zETysd-i8EcQ7kNvwFztydn&_nc_oc=Ado9naoTZgxkGh75laDOZDDsdwqy9nak9wgRnBJbnLBOoZYBhuBX_Uz-vsZC8KKzEpc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1smIbBvBEoG8ZT5jl_3CQrJrTuDgwYdTgutf5KZDonIA&oe=69E24090"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDJKmbwgidkQ7kNvwFllR1p&_nc_oc=AdqmJGIvvOoQ8uIp0YdD_gYSohVznsaot0w1I6zzkOFe9ophYYLfPq3YAfesljWV4EI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mwSCjEpX808WQkTr4Nlb6kzeyJPaYbfXbS-FQO8-9iQ&oe=69E24FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHWv2ik1E4cQ7kNvwEWG3bm&_nc_oc=Adp1ld3SQENa4d1VnhrhjyzZHf8MTwgNV-_5pVzvjG6aSsZhVsGrMFC1FW1hISjfuQA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ig33F9oOkC8eRdM80-2T4_kRocGnavOQ2tl-pdKcFZg&oe=69E22312"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msQrDgL7H0oQ7kNvwE5EpTM&_nc_oc=AdqJ05VhAUYkgylgptaBIOT3KxnOD5llIEfRy3ikBmMTI7qyhDSK4Tj3x_xS0tQ0j-M&_nc_zt=3&_nc_ht=scontent-lhr8-
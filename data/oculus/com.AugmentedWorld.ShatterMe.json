=1-7&_nc_sid=6e7a0a&_nc_ohc=gcsqsu5F2i0Q7kNvwHsmTlO&_nc_oc=AdqX6kSewfNWymdPXgLW2_SsyJb1rp6S_yvI73JE1EVP6UeVMAfu6nEedQJ6AH5RaaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KbKURY89A9H2WX_UoNdZqCE_OXChdeosQWtcazD-mSw&oe=6A3A9DE1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNc39c5zrXkQ7kNvwE0t5ok&_nc_oc=AdqlKm_eWdaQLnv2robZ__aRq2ipmRUNMvOq3JvC20Y6_SqR04V5hv_-oLQE2PWQscg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N3kMMeHgJ2rciu-V682PLtrxsAncI7IrVhZibzWe--Q&oe=6A3A9510"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYrPdPL4S54Q7kNvwECmWQN&_nc_oc=AdqQYm6w78oP9C_53M-Uq7yoZ4vn2AjrTSxD0fxWcmYfnAr2g4vikWWYR9VquSt1Gbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pHWt8CeEnV-XV4kowocDotnKvmT6cRr7iyCGHRUCkrw&oe=6A3AA477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo-KRqpYj8YQ7kNvwGusgFV&_nc_oc=Adqje2oNH86NgC7_wfU3__kp9gsa-Nfi7kzvVCyUjqddxkIaa29qHXd_nS8w5vNUVzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sPR9ptZ5ftXa8YNdySAvht_IVfJ4AEadEuX2-UPQvGQ&oe=6A3AAFD2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLTH72HkGGYQ7kNvwFWloFU&_nc_oc=Adq9L6nWNxVk4RrG6_vmylFkAA2Vl9fqLqvLQdw8D5lXodO62k1-i2OIJtBXHRv4xSs&_nc_zt=3&_nc_ht=scontent-sjc6-
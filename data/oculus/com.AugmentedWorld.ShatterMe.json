=1-7&_nc_sid=6e7a0a&_nc_ohc=lrpMWS7T4asQ7kNvwExwhiG&_nc_oc=AdoWSmrVIBteD3ILe0FBJbq-0eITdPVW388F53zJBxw76qaeZS0QokzmVFpAG5q7e9w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhhOjWdOrMUnfBzsQ4D67xNfkE5E7AplgCKyvNK-r06w&oe=6A901721"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60f9UcyfiN0Q7kNvwEYzxRi&_nc_oc=AdqV7eUMVU52wI1dvpQM02nMy49UT1-NsualRlcjuudZ-qirPjWxxQd-nh69m8NZN0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9sNoiP9MJG7A739p_HcmnFZoF_3FGNZMECNLXQcQm3g&oe=6A900E50"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik6iv0Ua0-4Q7kNvwEfYJ7g&_nc_oc=AdpYighi9pviI9TqDX1Vyoz15ll7cE63Q8BmU__79saoqZfShMOb1Pak7qiyRmSaVFk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_4brOfofgpitTChZtUdNS3RQiFzGjqb6lB6noPL5pg&oe=6A901DB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EB_pEOD3JkQ7kNvwFV2LbK&_nc_oc=AdpZw5DfYjSPqPN00mDp9HZ5rl-YrG1Z1IkoVQRkitbghSgpSk11y-Nse69SuRJAUmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4PUuKcw5QVta0catkapoitR3rsnzF7Pg88KD5SmM0zA&oe=6A902912"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBZnaRQhHE8Q7kNvwH_pqAi&_nc_oc=AdpcA9TDe6IDhdr7nHBZZGdk_82uNGmoGZ7qrQHk9eOf8Hb7Ifzh5kflV7Y_m57xilI&_nc_zt=3&_nc_ht=scontent-sea5-
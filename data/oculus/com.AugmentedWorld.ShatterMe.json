=1-7&_nc_sid=6e7a0a&_nc_ohc=JHy_aTcpp2oQ7kNvwFqnUn4&_nc_oc=Adrl8CbgzTdCdgcXYBIx3_CCVHafODhNWCHOrWnvfl56YFvmZUlMAXcBPJCunBf-LVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl-c0DKVZD_ZBT2pymNVvTl1nyRuchFa_ZpU8L2tythw&oe=6ABD2261"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ-bnxsK_pYQ7kNvwF-92af&_nc_oc=AdqXCIwmF1k-C9Bv-BDnPaVyVK0oiHZmH_NF2yFst5OCG0mRAoU7I2m2PizzD_0IS-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4B5QmEh5zCch4FGme_zc2IkFWJcy_5k2I4UPXBnkimQ&oe=6ABD1990"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEPI7uhIfScQ7kNvwEstsd4&_nc_oc=AdprpUcY7AXzZIxCUPU6_TnJwEsHJ6PcbBU2-pqvrjXIZ1MVm88XwlBgmwatFeEST_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpyOPpOGnC-3rPUqQtiRBnYeT0WU4Qw3jbAuoJIe_XwA&oe=6ABD28F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAHPZqsaLh0Q7kNvwG33qtT&_nc_oc=AdoKtk2z1n48HJdq0kRKv1fm65nLdrCWhvQs6dXdsxbi31xwdkorzmnlDUVT0QmBJk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjJD3McxKVUDjZg7N8PBGn1Y-4rkQmVjB_fMJ4RhPSPA&oe=6ABD3452"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFfd51GY1ZQQ7kNvwENukkq&_nc_oc=AdqBfLWZa6_5Cf57aJOJnl3rytnA-maMttdSU8v4Jq0dSEGW2Uw_mTFWH_dse5prKws&_nc_zt=3&_nc_ht=scontent-sjc3-
=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi-ac4u4MsYQ7kNvwFBKvd3&_nc_oc=AdpBJJGtwUfwwG95CVbruO0-0Cw50Rp2QGO-K10vFgw1oHrN3DvJ0l6_ssUi5h9kYiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UnaEOuHiRv7d4QT1qM2qbRgvrWXN87qP3BhEGfwmmpg&oe=69DBB1E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuOkc_kPQ-sQ7kNvwG9EO2O&_nc_oc=AdoJJ1aq-hQ54LBJ2akQv3d1nxEV8vLvH07zn34h_QLjJiUSpf9Db3KXBSzGpG0Pnvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j_6QgyqgtnP3uljOw-ug4up-usN52pB0tORCTEJeRhQ&oe=69DBA910"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Fl_E5OkG0Q7kNvwGer3WE&_nc_oc=Ado3eZhE9a9H1wdKFDXFO6xepnOOSZrfM9tqEsZWebMH1w6QGeYrm4I7P6PNZoM16YY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OK6TbEU6pMxS-sucqmZPwWd8i0xNo6viRHGrVJ1hN1A&oe=69DB8037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2K36KsArb4Q7kNvwEw1g-D&_nc_oc=AdqPaMj2VCNpncUbE3slrttuEuy-FT0Pq1R1qx-WyOLnxcx8yyeZIMjgdNwDYEN_moA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02rlj-JPks5ZfTLRQ5cwj2Uwl6qsWD_JQPjJBkYaGIWg&oe=69DB8B92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTG5pZ7k_w8Q7kNvwGHMFiA&_nc_oc=Ado1mTQr8ZXow9BEf3p7cUyAhYgMeSDBHL8bZe29uXnEFHjXZXEUB7PRH4yoHqvDSkY&_nc_zt=3&_nc_ht=scontent-iad3-
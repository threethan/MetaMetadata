=1-7&_nc_sid=6e7a0a&_nc_ohc=gIezikmp-FwQ7kNvwEFcX-e&_nc_oc=Adr7W58RnqU8qR2IXM5C1Eqg2BHHjSs7UgcqfFrIqlJtgUNcBrhECXSA5dPliEF4Exk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9AMywfCAXCN93Wf9Na6swJBwMFZzEftKISsjM6hYITA&oe=6A8439A1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04LIkdAPwYIQ7kNvwEzRDoB&_nc_oc=AdpxOpeoeiV_V3SVNSkGiIleNgTeEqcmHZ_GOBj0YwnL-3K5DRKlk7wtp3-JM8Q-rHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7WqgtPKeMtJ24csxy-31BiJPEGviIqyXPYbF-wQu3xw&oe=6A846910"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZLo4e_0FBAQ7kNvwGNlVVa&_nc_oc=AdqOiKidIQc-3HQFUIXXMu2xrKXa8xnjn09XWNn1gENkqk-QrzsZuHI9NvPa7itroTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoGs1tOFum_X-b-u0SGmJDiX_iOYo2YdlbPEHsPKEw9w&oe=6A844037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkxg5ONx5TEQ7kNvwF0zuKy&_nc_oc=AdoGYMGl7AN5tcAIGRhMRXpiePtzTrlJQQf66PxCG_MsBjm8yPqwfRhrq2U3p3N0kFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_HgyzIUZ_EgrF59r-5XtWnoVf0UumyMUSYok-gxuJBQ&oe=6A844B92"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1EECAqvzU0Q7kNvwFQCt4k&_nc_oc=Adoe1sVf4IbWh_VbpT3aOTm9pfRkHnEvrLkriGRsXbTBDH5_te9I0A8VXByb1--n4oY&_nc_zt=3&_nc_ht=scontent-sjc6-
=1-7&_nc_sid=6e7a0a&_nc_ohc=BZEza-EHlXIQ7kNvwGlR64Y&_nc_oc=AdonIMJ1Ik89XY-cm5tMtpFwzPuyRyZufijgBoOJaYvXMz8me2GHjsmq6yrod_UFtxs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfDxcrUhuyiIz2rzlu3pdDIAt9U8O1LqP7cVgPX7M7Lg&oe=6AEC9861"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCCiLP5jC9YQ7kNvwHi9TJG&_nc_oc=AdrfUkFPXpizO5550hPeU6B1ScN00JPyMpzVkQn4r05rVTn0m1EI1nIWpEfhguaaIsk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi2BXXmV7yCOTu7KwjRJmhGoLZUPFKyVKeIg8inSN2CA&oe=6AEC8F90"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEivCe7EIYEQ7kNvwF0vHLo&_nc_oc=Adof-q-nwZIUhv_MzLnyYW1CIr4lm8GTSHaxm16HkX2_8nUuldsLaizvCb9F6Nm6wp8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdUuVBNDl9EnWe93Q3sntA1BIqe-phQEcgTJz3Y_BFeA&oe=6AEC9EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJjOQLKFJO4Q7kNvwG14P4F&_nc_oc=AdqKb0y1Y3Wiobi3rACcdkAzGXZbkq8CFKBeVaqfVJFQqY6SuQEsIlcdl3vH_6zz90A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROEqrfx42omvPz4XPslxgjkj1Xm8Rkrp9Ou-DkjufjnQ&oe=6AECAA52"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMAYiDZ_6gUQ7kNvwFxV8Is&_nc_oc=AdoHyozwjhXkPT5475m4kuw59v8fkxc6-Plv8avKPjkILG6kCSzVqQ66Ys9oP7Q4xP4&_nc_zt=3&_nc_ht=scontent-lga3-
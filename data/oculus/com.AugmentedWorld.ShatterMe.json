=1-7&_nc_sid=6e7a0a&_nc_ohc=uA6OTrro8kUQ7kNvwHY8bpH&_nc_oc=AdoYRyHmDnjgK5WIlDIsnRpWL218-0xDgfjFj7fWNbc8CQ4hvhzDLM_qC08rQn50CXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FyrLa1GInXDDu5UvJEYAkl5qt82TOK9jLmQZ8aNZ45Q&oe=6A4286E1"}, {"file_name": "Screen4.png", "id": "763903878354330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_763903885020996_7514514540935187093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXKPepJJ8H8Q7kNvwFvFBOV&_nc_oc=AdoiGtv1rANglLiTZCwCpu6CBIyByizrVosWF6Xta_6dykt_3259zJRCBTDa9IffpQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W2RzbNTKdbzupYB3wl7_AxsLsIFL_XygnEOajOtuqfg&oe=6A427E10"}, {"file_name": "Screen7.png", "id": "897228174954460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_897228178287793_2347293338162094256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqlfwZ30RKAQ7kNvwHd7Sgo&_nc_oc=AdpATRofxLM3IHdaXUtXjcVkN5SyTjrnZ43xW2w4VzCgIDohblUfJHLJ_u2ODQAa2ds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CguQ_uzzfQmsCPsne23jHHOICSBTq12yOlwd6cSdLNQ&oe=6A428D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "468847405441911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_468847408775244_1456870109061634964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4QKuUMLCDEQ7kNvwEm0Lf3&_nc_oc=AdoHcBjFE8IWfUaTAJiNFSNTAQl3zTDUD98xQmtI3nLgRgLdekTfD_PwVMQEYGSDxRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L0SQX6getB6Pq9-0NVgpAWS-SuNPeaSOoTANjAeSyXA&oe=6A4298D2"}, "display_name": "Smashy Smashy VR", "keywords": [], "long_description": "Life is hard, it can be annoying and there can be a lot of STRESS.\n\nSMASHY SMASHY VR is a stress release app that allows users to SMASH and DESTROY VR environments. \nChoose from familiar environments such as the Office work place and the Local Supermarket or choose alternative environments like a giant game of chess or Egypt!  \n\nNEW CONTENT: \n* New Maps \"Halloween Village\" and \"Christmas Town\"\n* Time Attack mode\n* Unlockable mods for Free Mode\n\nNo need to Smash your expensive TV, Smash TV's in VR and don't worry about the mess! \n\nSmashy Smashy VR is still in its early development and has future game modes and environments in production. So if there are items or places you want to see in future feel free to leave feedback!\n\nEnjoy SMASHING in Smashy Smashy VR!", "short_description": "SMASH EVERYTHING! \nLet out your stress in different VR environments and SMASH all the objects you encounter!\n\nSmash the Office, the supermarket, a game of chess or even a holiday! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://jakex20059.wixsite.com/augmentedworld/privacy", "developer_terms_of_service_url": null, "publisher_name": "Augmented World", "support_website_url": null, "website_url": "http://www.augmentedworld.co.uk/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066883400057230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_913630702974353_3770362900091154630_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2CPxzVUJn0Q7kNvwGnzS-6&_nc_oc=AdoWhVXW16R2G4aJPYZMcgA3as_frDapk05fXU0P4VYYF_-HGyj6oQy5Xn2_T2Sq8BY&_nc_zt=3&_nc_ht=scontent-sjc6-
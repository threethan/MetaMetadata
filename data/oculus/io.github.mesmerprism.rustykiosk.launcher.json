_nc_sid=6e7a0a&_nc_ohc=XlnnzOCIQI8Q7kNvwHMOSJ-&_nc_oc=AdoYmJ-eKcxlOXkhQqQkRXIyCz9w87mdOPeiyO14Dx0iq8gbsMRw6ZR0RbqbkYT0R70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfufUw7JBMzKSPa4wkT_iq-hAhvfkvPcErJzQZ-Wzrrw&oe=6ACBAD46"}, {"file_name": "screenshot-05-favorites.png", "id": "1072684218616467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828087_1072684221949800_3031424401382592266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a01kBq5-hAwQ7kNvwHI8eOz&_nc_oc=AdpK5fbVfb2L1XKWwj4wcOXwkx_-_jBxVefMSi3wX90jYEfeUEx0mTQZdX5U1Aq9jsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQDwG44zojqQXMBJWAu_OrOUR-oYgeoWRuhuaxX9WwPw&oe=6ACBBE48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rusty Launcher Lite", "keywords": [], "long_description": "Rusty Launcher Lite is a lightweight 2D app library for Meta Quest. Browse launchable apps already installed on your headset, search by name or tag, mark favorites, and open an app\u2019s details before launching it.\n\nYou can optionally set a local Wi-Fi preference for an app. If the current Wi-Fi state does not match, Rusty Launcher Lite explains the mismatch and offers to open the headset\u2019s Wi-Fi settings; it never changes Wi-Fi itself.\n\nRusty Launcher Lite works immediately after Store installation. It does not require another app, an account, Developer Mode, ADB, a PC, or a subscription. Favorites, tags, and Wi-Fi preferences stay on your headset. The app contains no ads and does not upload analytics or personal data.", "short_description": "Browse, search, tag, favorite, and launch installed Quest apps from one lightweight offline panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mesmerprism.com/privacy/rusty-launcher-lite/", "developer_terms_of_service_url": null, "publisher_name": "Viscereality", "support_website_url": "https://github.com/MesmerPrism/Rusty-Kiosk/issues", "website_url": "https://mesmerpris
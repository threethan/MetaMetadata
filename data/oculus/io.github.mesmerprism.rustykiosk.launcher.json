b=1-7&_nc_sid=6e7a0a&_nc_ohc=QY7oScEeTSUQ7kNvwETasny&_nc_oc=Adr3MNEM0JBFdbjyGpvutooeDK9FZjRqp8y5dCyRQwLpUAzFaTJXJ6DNWm5mdtlobhg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhux8dss-pcup2A7K6oJO4S9sbQComsREebIrD4lwTKg&oe=6AA96646"}, {"file_name": "screenshot-05-favorites.png", "id": "1072684218616467", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828087_1072684221949800_3031424401382592266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd8g7kYToCgQ7kNvwHaHHzW&_nc_oc=Adp-joclWylk-hTsBzESUXGwDOi0nrSjzjWYq9gsa5X1C9BMsZmf26-_zM65TtUQq1M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkVx8QDEPCwDvyoDUPvrVXrK8uEoryUMY3Lt-kS25Fog&oe=6AA93F08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rusty Launcher Lite", "keywords": [], "long_description": "Rusty Launcher Lite is a lightweight 2D app library for Meta Quest. Browse launchable apps already installed on your headset, search by name or tag, mark favorites, and open an app\u2019s details before launching it.\n\nYou can optionally set a local Wi-Fi preference for an app. If the current Wi-Fi state does not match, Rusty Launcher Lite explains the mismatch and offers to open the headset\u2019s Wi-Fi settings; it never changes Wi-Fi itself.\n\nRusty Launcher Lite works immediately after Store installation. It does not require another app, an account, Developer Mode, ADB, a PC, or a subscription. Favorites, tags, and Wi-Fi preferences stay on your headset. The app contains no ads and does not upload analytics or personal data.", "short_description": "Browse, search, tag, favorite, and launch installed Quest apps from one lightweight offline panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mesmerprism.com/privacy/rusty-launcher-lite/", "developer_terms_of_service_url": null, "publisher_name": "Viscereality", "support_website_url": "https://github.com/MesmerPrism/Rusty-Kiosk/issues", "website_url": "https://me
_nc_sid=6e7a0a&_nc_ohc=_PuKVDCy_90Q7kNvwGocF9m&_nc_oc=Ado6Y7WAIgMn0xQ8w1F0__5JqVUNkJhhSjSpor-cmiEVv71STB6HhyNpYc6VJHSCAzY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF57WlVajEuyM-8NCaRlElzFRjse81j-T5ZOvhAhNwu0g&oe=6A81A106"}, {"file_name": "screenshot-05-favorites.png", "id": "1072684218616467", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828087_1072684221949800_3031424401382592266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaBqtPy2Ay8Q7kNvwFzuQ1y&_nc_oc=AdrWqn8PDqjTP-STeGUoMkS44Y79tE2BBFX81voVZfR-zg7Kf4aQ3OlWJQH10vmFE4s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP8dG2X90zkctbnW1NaWIy8qey3P9kgaJNCFm9vC6IEQ&oe=6A81B208"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rusty Launcher Lite", "keywords": [], "long_description": "Rusty Launcher Lite is a lightweight 2D app library for Meta Quest. Browse launchable apps already installed on your headset, search by name or tag, mark favorites, and open an app\u2019s details before launching it.\n\nYou can optionally set a local Wi-Fi preference for an app. If the current Wi-Fi state does not match, Rusty Launcher Lite explains the mismatch and offers to open the headset\u2019s Wi-Fi settings; it never changes Wi-Fi itself.\n\nRusty Launcher Lite works immediately after Store installation. It does not require another app, an account, Developer Mode, ADB, a PC, or a subscription. Favorites, tags, and Wi-Fi preferences stay on your headset. The app contains no ads and does not upload analytics or personal data.", "short_description": "Browse, search, tag, favorite, and launch installed Quest apps from one lightweight offline panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mesmerprism.com/privacy/rusty-launcher-lite/", "developer_terms_of_service_url": null, "publisher_name": "Viscereality", "support_website_url": "https://github.com/MesmerPrism/Rusty-Kiosk/issues", "website_url": "https://mesmerpris
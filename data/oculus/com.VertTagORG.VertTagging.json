hWHAR2h_FE3Mk-V_E5Pw&oe=6B006CA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Racers", "keywords": [], "long_description": "Gorilla Racers is a fast-paced multiplayer Virtual Reality (VR) experience that drops players into a vibrant, high-energy world where agility and spatial awareness are everything.\n\nStepping into the game, you take on the avatar of a simple, legless primate\u2014stripped of traditional controls and forced to rely entirely on momentum, arm strength, and physics. Launch yourself across maps, compete in high-stakes races, challenge friends to games like tag, or just hang out and socialize in active VR environments.", "short_description": "Gorilla Racers is a fast-paced multiplayer Virtual Reality (VR) game where players become simple, legless primates. Experience unique physics-based movement as you race through maps, play classic games like tag, and hang out with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1OaOCnbP9WMd2tG7Y_BLm85NF_giyjU90k2IerwKPGsA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vert", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1sFOIsjIj2vsphfilN_Voa8QIFXFJ7l8dYuqIXlKzTIc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGL
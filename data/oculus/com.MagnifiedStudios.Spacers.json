K8maPdnEaIUKpLUYqgR75vS3iGvl0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSja7huwMg_cMHb7n3pnsyYGqszQq8fYjX_f1utP1fJNQ&oe=6AFF3078"}, {"file_name": "screenshot3final.png", "id": "908388298102807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_908388301436140_1025673239126702808_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dKY8SacRp8Q7kNvwHadwha&_nc_oc=AdqlhGoyK3E9MUuuKGHX0UK4Y20WVXmVi3GESaAl0_J1pmYtIqJREEwxOaOCJYKN8Ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa2vD2-SrX7oEkQ1CK6zdmSwNSwTqpHideECP3MvRoPg&oe=6AFF0A36"}, {"file_name": "screenshot4final.png", "id": "9233695499982144", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001714_9233695503315477_6160575696438784085_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upRBTYlAT3IQ7kNvwEzG47n&_nc_oc=Adpe119J8pJtRCHnJf5Snmi5BdZY5X-d35hl_SlyrnS7fFZClRdE-oQiGr9Lm-UY9Gg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQG7HzzICmyK9-wBvrWuIgkoJfQX07_qiaeG914UAdnQ&oe=6AFF006E"}, {"file_name": "screenshot5final.png", "id": "1781862055912979", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001676_1781862059246312_599295616912043130_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9BoUz7pA0EQ7kNvwGV_rb6&_nc_oc=AdoHOXm8oAtdz9KU9yUzBEOB5eWhthvO9pnzL6NzURNpaoqreWXr3JbB01MHXyS_PsU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9PaMP19qCw2wnHyeJr7WvqWTFLaWNr9sRmzYYw_K4Bw&oe=6AFF2287"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spacers", "keywords": [], "long_description": "**NOTE: The game is still under development, and the full release is only avaliable to selected testers for the game.**\n\nSpacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Click the PLAY button and enter the arcade machine to play an activity by yourself, or with friends!\n\nCollect Space Debris by doing challenges in the game (play an activity, fight off 10 aliens, etc) or participate in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, customize your weapons, or just customize your living space.\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable shapes, colors, and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets."}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spacersvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/spacersvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8468699213179627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979721
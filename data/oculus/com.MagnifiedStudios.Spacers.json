9832373814415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvmQGvOfxNgQ7kNvwGrThDv&_nc_oc=Adq1m88_wmmJaWXStr_6Rs6tVFU0S3BlusJhFGnpEvctRfo5Q0htMGTYlDVie2IZ4CE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dkKqj4D5_wfRfOFHtN1K2PJ6x9nNFT15_KkhLiRprBw&oe=6A451919"}, {"file_name": "SampleScene_1440p_01.08.2025_14-18-57.png", "id": "9830538067051757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300897_9830538070385090_8138103576657128316_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhEEyPj1UTkQ7kNvwFRr2N6&_nc_oc=Adql5zBQQBQMM9QmSDxM3eTCChxE2INznqKN9sB1vUaJOgsYfy1-QZCCUuTH1T7djRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nj_qgXzsrM28QUuLh_qpQAamAXfIteJMBReHtyM0cyw&oe=6A4502F4"}, {"file_name": "SampleScene_1440p_01.08.2025_14-50-26.png", "id": "1494661731693499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296288_1494661735026832_7079800069696480343_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=580MY5mqnNsQ7kNvwGfpFOX&_nc_oc=AdrHeaEckq-CTfQ14qOHKcde0fyPe0DFn8ZlZA00NLR3Jjc34tkwVf1WhNUtNQqkwKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gFcWnYWRCjO8glxtVorGaP44wdQZ6kVKJVrg5xt1j5A&oe=6A451C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spacerstrailer.png", "id": "1291668745915958", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308204_1291668749249291_8689298561442697697_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoAFnm4zzG0Q7kNvwFq7bPN&_nc_oc=AdoQNoYvB-16omHKNAAhr3YzLirXu_9317N6UZr7UZwhPVSQ1V5mLv94FZxzC_upHvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wTW-juLO-TDSy2so86V1QavnGC_YG9kCDunINllj1Dw&oe=6A452F57"}, "display_name": "Spacers", "keywords": ["space", "shooter", "building", "gamemodes"], "long_description": "Welcome to Spacers, a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Either you can play some solo arcade games at the Arcade, or have fun in the multiple Activities!\n\nCollect Space Debris by logging in everyday, killing aliens in certain planets, or participating in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, or purchase new blocks for the Creation Warehouse (mentioned below).\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable blocks and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets."}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://spacers.magnifiedstudios.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://spacers.magnifiedstudios.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25091469890475964"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
9832373814415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4um12E1bR8Q7kNvwEnmrEf&_nc_oc=Adrsp04ZwffYJzhiEp8q9KJYgiUVpdkuneaUh8za6IR0xBr5c563n92sZfNUwl0rk20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FM-DHzrATvus95U9Bzks6K0Yr7Xf-RhlP6IKofkqxrA&oe=6A315299"}, {"file_name": "SampleScene_1440p_01.08.2025_14-18-57.png", "id": "9830538067051757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300897_9830538070385090_8138103576657128316_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRGPxXxnHYgQ7kNvwHnGN-g&_nc_oc=AdrNqQuqkr1UWhfrqro7dP7YZHPL1yL8nJwt4rDvWc-lBRuNzeEz59YAOGor1MpTAPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c5b-d62gUw1Zvz7Dl386-FoP3KKisMfCKaJzDOAPxlA&oe=6A3174B4"}, {"file_name": "SampleScene_1440p_01.08.2025_14-50-26.png", "id": "1494661731693499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296288_1494661735026832_7079800069696480343_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6_IhflbrLAQ7kNvwFy_Uyh&_nc_oc=Adrk9fY-T3DENZlxI8TV0tgcEjyNuz51hv_pQdarsNIAWMm1B3VY4RNPrOXFmP6FrkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a3ONcHLkV2HXLpgqBPQRUvmUj5McP7NZynBwXbzAKcQ&oe=6A315606"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spacerstrailer.png", "id": "1291668745915958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308204_1291668749249291_8689298561442697697_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x93UfElnCx0Q7kNvwH4-CKC&_nc_oc=Ado4gydD9pXzKfiVLU5rAkx-09rUyVCBFA1y2FUgw0xpanuIOg6BEHOfcHyBjd6rpO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vgwauZFvnVufKw1urlKX7I6-tA2b7My1gCvgVzJrxMA&oe=6A3168D7"}, "display_name": "Spacers", "keywords": ["space", "shooter", "building", "gamemodes"], "long_description": "Welcome to Spacers, a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Either you can play some solo arcade games at the Arcade, or have fun in the multiple Activities!\n\nCollect Space Debris by logging in everyday, killing aliens in certain planets, or participating in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, or purchase new blocks for the Creation Warehouse (mentioned below).\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable blocks and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets."}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://spacers.magnifiedstudios.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://spacers.magnifiedstudios.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25091469890475964"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
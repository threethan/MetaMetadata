PObdbf_zcLqfE3_3qiep6rUjpVZGgpJIMOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lWln50YQnmedbPOlX19PgnqXM4fM7hxBJ093tUB9Vdw&oe=6A01DC99"}, {"file_name": "SampleScene_1440p_01.08.2025_14-18-57.png", "id": "9830538067051757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_9830538070385090_8138103576657128316_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4K9RO9XWjQQ7kNvwHLIt0A&_nc_oc=Adof4ZLK70rsarRtsfUgebSe3aZL48DQLIxtPtUJCu_AYUcwoH2cK9MaeUfAL7LxOzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hYC8-93tF-9Rx17eXLNXZAqDs8ExBSXVaXcpUTRKBtg&oe=6A01C674"}, {"file_name": "SampleScene_1440p_01.08.2025_14-50-26.png", "id": "1494661731693499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296288_1494661735026832_7079800069696480343_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAVrq4Va7PMQ7kNvwEk3-kC&_nc_oc=Adq2ltsDVTKSUw0GSz2My5QCGUR10KLU-ALySeuHUXsnt-y_2PPMhVysMZatsOTQ4lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vZpIaAle6YQT4IXdDHKwCX7gJOVje6Hd1yg2SD949wQ&oe=6A01E006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spacerstrailer.png", "id": "1291668745915958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308204_1291668749249291_8689298561442697697_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jR_oAU52DsQ7kNvwEGrOvF&_nc_oc=AdpMqz50ASaPXSq4BzIcmqCLs2bWyMqfvZrBhLilKllQLtQiN7OB1RHoP3Q8ceNcL2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73_zvqKgAn3HIkIKQ9Q0wvep8JffeOKbyVaTuvol6ung&oe=6A01F2D7"}, "display_name": "Spacers", "keywords": ["space", "shooter", "building", "gamemodes"], "long_description": "Welcome to Spacers, a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Either you can play some solo arcade games at the Arcade, or have fun in the multiple Activities!\n\nCollect Space Debris by logging in everyday, killing aliens in certain planets, or participating in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, or purchase new blocks for the Creation Warehouse (mentioned below).\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable blocks and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets."}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://spacers.magnifiedstudios.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://spacers.magnifiedstudios.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25091469890475964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831792_1942701539609331_9052230902911991990_n.png?stp=dst-png_s360x360&_
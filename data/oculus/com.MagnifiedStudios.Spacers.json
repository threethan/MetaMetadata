_kCYDpKPiufPXHd0v92Q&oe=6A394936"}, {"file_name": "screenshot4final.png", "id": "9233695499982144", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001714_9233695503315477_6160575696438784085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrnEZQlMXYIQ7kNvwFIfuia&_nc_oc=Adow_w8f0qRhgRs5cLcXBlUIiu4Z_DA4MdspqGZBu4cHz6QRu4Zxtfo8AlxRjH5XcTM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P2bvV_sT1SuN7PXgprJhM4Dy6hkYzGfzvpAa16NZ4qw&oe=6A393F6E"}, {"file_name": "screenshot5final.png", "id": "1781862055912979", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001676_1781862059246312_599295616912043130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuiNWbDFpQUQ7kNvwF-a003&_nc_oc=AdpjPG6tSmHoMItcH1FkSUMzKWYQX4QziRkePQpGCK2cfF0QNwDAIkWlAGJI5aObAW0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-juh3JQxNvoBZNczM9fb--ru1elFr5jIpBRNVRo5DfuA&oe=6A396187"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spacers", "keywords": [], "long_description": "**NOTE: The game is still under development, and the full release is only avaliable to selected testers for the game.**\n\nSpacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Click the PLAY button and enter the arcade machine to play an activity by yourself, or with friends!\n\nCollect Space Debris by doing challenges in the game (play an activity, fight off 10 aliens, etc) or participate in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, customize your weapons, or just customize your living space.\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable shapes, colors, and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets."}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spacersvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/spacersvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8468699213179627"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25099871459635807", "version": "1.5.1"}, "id": "764774402457309", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8468699203179628", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25099871459635807"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
b=1-7&_nc_sid=6e7a0a&_nc_ohc=YjKNo6AdrNgQ7kNvwEl6aON&_nc_oc=Adlhmiq4gByvvC6xh-zn_VTXkJxeMe3_LpJjw0qpSZ4yNGHRfbw9N3dTSrjTUT7KKRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQenNuKTB-IdwXu5n8Go31LC3KMsXON6uHMvyngMEDQA&oe=69AC2EEE"}, {"file_name": "screenshot5final.png", "id": "1781862055912979", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001676_1781862059246312_599295616912043130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fObJQKnUNAcQ7kNvwFj-Gyk&_nc_oc=Adnw8VEhNIS1bsUF-9zR1ocYmts4gSIc1Wx2YbXpttGyY2tsftX4MKYRuWMIBTR7GYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoUi_PI4xWv-UJ1zv3YAzVRRYkjiPtepwtPnO6ycmR6A&oe=69AC18C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spacers", "keywords": [], "long_description": "**NOTE: The game is still under development, and the full release is only avaliable to selected testers for the game.**\n\nSpacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many aliens invading those planets. If you get bored, you can also play activities in the Activity Center. Click the PLAY button and enter the arcade machine to play an activity by yourself, or with friends!\n\nCollect Space Debris by doing challenges in the game (play an activity, fight off 10 aliens, etc) or participate in events to earn Space Debris. You can then use the Space Debris to customize your outfit, purchase new weapons to fight off aliens, customize your weapons, or just customize your living space.\n\nIf you have a creative mind, try your hands at the Creation Warehouse! Use your imagination to create planets or activities with avaliable shapes, colors, and props! The limit is your imagination!\n\nIf reading all this makes you want to try out our game, go purchase it for free on the store. Have fun!", "short_description": "Spacers is a Gorilla Tag Fan Game that is themed around space. Explore many unique planets and fight off many 
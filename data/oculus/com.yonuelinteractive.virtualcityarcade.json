kbQAQ7kNvwGyAix1&_nc_oc=AdocXh5o_tNsJOqG9rs2vihz2O9lgeBScMeRvG__WGFtSKH9lwK3GpdndTjOTbRWgLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1-bf6YaRW54-WLadyc-1xRBSQrVIqCfXWI8v3A7KkIog&oe=69F0C3E9"}, {"file_name": "VCA_Screenshot_4.png", "id": "2111813139550610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_2111813142883943_182929049086474223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGT5rn-hUO4Q7kNvwGHRy68&_nc_oc=Adqazib8khLYqVZaTsqnz3vCpjj5dbMHtkJ9Lf9LA2aLp_BHj65mpVNsZteybci1bhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3U-MvOK3JS02iIT5iLGSrivzea0DgHE6z9YyBGusyvgQ&oe=69F09D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VCA Cover Art Landscape.png", "id": "2197718734372428", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_2197718737705761_4069023878709377842_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTmoIRwh_a0Q7kNvwGS2xwD&_nc_oc=AdrlJFiivwnyyV-jCaO5pJpP9rquYLYCJhyo0hgLPYkwyjmJQ6-2QMMj48dC_rizars&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3EA9nT4xCnZgKhy_-NgT7qMYTgAlchfV7vi9FTucYe1A&oe=69F0A241"}, "display_name": "Virtual City Arcade", "keywords": ["arcade", "sports", "basketball", "hockey", "physics"], "long_description": "### **WELCOME TO THE 100TH FLOOR**\nStep into your private arcade penthouse located 100 stories above the city; a dedicated space to play your favorite physics-based classic arcade games designed to be played exactly like their real-world counterparts.\n### **THE GAMES**\nYou aren't just pressing buttons; you're using your hands to throw basketballs, roll balls, and move your paddle. Experience tactile, 1:1 interactions that make every movement in the game matter.\n\n- **City Hoops:** Aim and throw for the hoop with realistic basketball physics.\n{1169871302866477}\n- **Puck Strike:** Grab the paddle and test your reaction time in Air Hockey against the AI.\n{1768711684090617}\n- **Ring Sink:** Master the precision and strength needed to sink balls into high-value ring targets.\n{1659352088738386}\n### **THE ARCADE PENTHOUSE**\nYour private arcade is open 24/7, designed with a minimalistic, upscale aesthetic to make you elevated and thrilled while you play. Floor-to-ceiling windows offer panoramic views of the city skyline, providing a stunning backdrop to your gaming sessions.\n{1299921815397370}\n### **COMFORT & PLAYSTYLE**\n- **Accessibility:** Built for comfort. The Virtual City Arcade uses simple teleportation to move between machines.\n- **Play Position:** Can be played comfortably while standing or in a stationary position.\n- **Competition:** Challenge your friends or family to see who can claim the top score.\n", "short_description": "Welcome to your 100th-floor arcade penthouse. Enjoy stunning city views while playing your favorite physics-based classics. Will you claim the top score?"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/virtual-city-arcade/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/virtual-city-arcade/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25963960019965703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-i
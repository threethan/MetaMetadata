scdn.com&_nc_ss=7f30f&oh=00_AQRW3vXqikkNe1Svvcli2Bas32YT4d0G3T5WhKGOf66bew&oe=6B0C724E"}, {"file_name": "VCA_Screenshot_5.png", "id": "817177354803279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_817177358136612_3964906631822625_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As07Z5rLq9MQ7kNvwGbvaDj&_nc_oc=AdowefZBIRW_Hq78UWHIjH5sAAewMT_f19CejamzajOEoXF0LHIIeB80aa0gKpxgsL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHxENkUu2VV_IZVhePm6mjrdqDbcT4ujJvwYk6qzNDEg&oe=6B0C6EA9"}, {"file_name": "VCA_Screenshot_4.png", "id": "2111813139550610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_2111813142883943_182929049086474223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGhGrUEl-KMQ7kNvwHSOi7p&_nc_oc=AdrhFWhxs_S-Ajv5fvNoxGTA57isGf_XnlOZUARz1hGVXt6Gl90g2KTSx84rE2eFz5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKfrDgE8HUcodAJe4FThfcSP1QfGEcbXavrUaf6kafBQ&oe=6B0C806A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VCA Cover Art Landscape.png", "id": "2197718734372428", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_2197718737705761_4069023878709377842_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEhukjb7RdAQ7kNvwHxHbBE&_nc_oc=Adov9aWgkW_w6qj-8djae388qUsFKlM3dDHXP61-8flW-3zpt5vwSxxRtu0u-gSou-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTG_Eb7N4UPLfs64ZMBVrW5JmKqbUf9DYeCxfwUFgaEsg&oe=6B0C4D01"}, "display_name": "Virtual City Arcade", "keywords": ["arcade", "sports", "basketball", "hockey", "physics"], "long_description": "### **WELCOME TO THE 100TH FLOOR**\nStep into your private arcade penthouse located 100 stories above the city; a dedicated space to play your favorite physics-based classic arcade games designed to be played exactly like their real-world counterparts.\n### **THE GAMES**\nYou aren't just pressing buttons; you're using your hands to throw basketballs, roll balls, and move your paddle. Experience tactile, 1:1 interactions that make every movement in the game matter.\n\n- **City Hoops:** Aim and throw for the hoop with realistic basketball physics.\n{1169871302866477}\n- **Puck Strike:** Grab the paddle and test your reaction time in Air Hockey against the AI.\n{1768711684090617}\n- **Ring Sink:** Master the precision and strength needed to sink balls into high-value ring targets.\n{1659352088738386}\n### **THE ARCADE PENTHOUSE**\nYour private arcade is open 24/7, designed with a minimalistic, upscale aesthetic to make you elevated and thrilled while you play. Floor-to-ceiling windows offer panoramic views of the city skyline, providing a stunning backdrop to your gaming sessions.\n{1299921815397370}\n### **COMFORT & PLAYSTYLE**\n- **Accessibility:** Built for comfort. The Virtual City Arcade uses simple teleportation to move between machines.\n- **Play Position:** Can be played comfortably while standing or in a stationary position.\n- **Competition:** Challenge your friends or family to see who can claim the top score.\n", "short_description": "Welcome to your 100th-floor arcade penthouse. Enjoy stunning city views while playing your favorite physics-based classics. Will you claim the top score?"}]}, "developer_name": "Yonuel Interactive", "developer_privacy_policy_url": "https://yonuelinteractive.com/games/virtual-city-arcade/privacy/", "developer_terms_of_service_url": "https://yonuelinteractive.com/games/virtual-city-arcade/terms/", "publisher_name": "Yonuel Interactive", "support_website_url": null, "website_url": "https://yonuelinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", 
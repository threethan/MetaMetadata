1.oculuscdn.com/v/t64.5771-25/499304305_1862058671025259_9028058675544612688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw8r3LywR8cQ7kNvwGg_hB2&_nc_oc=AdoGcqyRyqGymmcT5JOPSd9uSAXQ2GgY_NmGUrZ-KpVYSMyMJX-5CB738VCiUmGT1oo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11s3opZq-xOUFbzhLBHlKxRNGlFbqWZ5s0bZ3UpdoCuw&oe=69F8C008"}, {"file_name": "cover_2560x1440_0.png", "id": "841051325671597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307433_841051329004930_6558221086193494577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFi4S7-rPn0Q7kNvwH8iSBC&_nc_oc=AdrJLmeuu6Pr3oLXzSSZ6AsOEOtrcaOOEFCWb2IHuWEGGNJOGVJuO5jYfcbkXHo_vDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af382f1mJBhVGIoSrlxDj9rD60F6zLpqQl9swUQGfmbU8A&oe=69F8BDF2"}, {"file_name": "IMG_0570.png", "id": "1627718628562277", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618288_1627718631895610_3853042830749402254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE4XDYyJu7EQ7kNvwGl60Vh&_nc_oc=AdrhmUzdy91eHYi9m6neccxZ2WCtdK6mXvnuZna3rLdWDQn1lbYsrCOe73v_Rn9pN-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Uh_v9AB5-bjIII3nFN_ogspDQzTfdN47segs5k52LPQ&oe=69F8BFA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoobVr", "keywords": [], "long_description": "Goobvr is a fast-paced, multiplayer VR experience where chaos, creativity, and movement collide. Step into the world as a quirky, agile \u201cGoob\u201d and compete in energetic rounds of tag that test your reflexes, strategy, and stamina. Whether you\u2019re climbing, dodging, or sprinting your way through vibrant environments, every match delivers unpredictable fun and laughter.\n\nDesigned for both casual players and competitive thrill-seekers, Goobvr features intuitive movement mechanics that are easy to learn but rewarding to master. Explore colorful maps filled with obstacles, shortcuts, and hidden routes that keep every round fresh and exciting. Play with friends or jump into matches with others from around the world\u2014no two games ever feel the same.\n\nCustomize your Goob, experiment with different playstyles, and discover new ways to outmaneuver your opponents. With a focus on social interaction, replayability, and high-energy gameplay, Goobvr creates unforgettable VR moments you\u2019ll want to experience again and again.\n\nGet ready to run, laugh, and tag\u2014because in Goobvr, you\u2019re always one move away from victory.", "short_description": "Goobvr is a locomotion Multiplayer  Vr game that has horror  Pvp  parkour Shop only up Horror   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1S9iM5CNkXyhz6HRCpcLiH_YM9Q7uzG73ioOaOfZCOcA/edit?tab=t.0#heading=h.m5g0yqeaxo3v", "developer_terms_of_service_url": null, "publisher_name": "Velz", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1S9iM5CNkXyhz6HRCpcLiH_YM9Q7uzG73ioOaOfZCOcA/edit?tab=t.0#heading=h.m5g0yqeaxo3v", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35016038254709319"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1892781958061844"}]}, "baseline_offer": {"id": "1892781958061844"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776974160, "status": "PUBLISHED", "id": "1
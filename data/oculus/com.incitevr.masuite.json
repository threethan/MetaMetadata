FGif3Aen1IFOecxrTr4WA2nofNRczyhjiBtr_H9sFyh_lNSJWt5autzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgcvzUCpz3SMx2ofZzSFG3EXX_VrAL3s8NjOqKLGzXtQ&oe=6A79D747"}, {"file_name": "screenshot5.png", "id": "1086846368515723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003241_1086846375182389_3532808754830807107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZPNGH1pyoAQ7kNvwG0UVUz&_nc_oc=Ado-oLQgOzzdgnCECRvmxLGSFAq0_KfJG8pQaJshtGQsVGo5NV-R4BBRkjgh01aAdoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd0QZKWDooV6gDa9tADCPYLLUVnsBLrQkR_7dzU5uyCw&oe=6A79DEA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "221546809957040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240106_221546819957039_7723109708925411952_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoGLj-hT004Q7kNvwFPbBv7&_nc_oc=AdpzHq0qVqvZTspCTrk1waNTdrovuk0lKANCFXRBNyWIhqU9oI-i0_QJjqSoo48leog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3irqt0aF_I0bPlzUNpwxG-j0VzYDGwZ0OQMRzsTtISQ&oe=6A79DE93"}, "display_name": "Medical Assisting Clinical Suite (Professional)", "keywords": [], "long_description": "Intended for medical assisting students and working professionals seeking a skills refresher, the Medical Assisting Clinical Suite (Professional) is clinical training in an immersive health care setting that teaches you how to prepare for, setup, document, and perform 33 clinical skills procedures common to the CMA/RMA/NCMA/CCMA/CMAC Certification Exams.  This is a permanent education license, providing unlimited practice \u2018anytime-anywhere\u2019, immediate feedback, analytics, and guided, expert, and exam modes to check progress and build confidence.\nA certificate of completion is available upon successful completion of all exam modes.\nImmersive learning is a paradigm shift that is already underway in healthcare education, where leading research shows that learners acquire clinical skills more rapidly, with fewer errors, and retain learned skills longer through immersive learning experiences.", "short_description": "Intended for students and working professionals, the Medical Assisting Clinical Suite (Professional) is immersive clinical training that teaches you how to prepare for, setup, and perform 33 clinical skills procedures common to the CMA/RMA/NCMA/CCMA/CMAC Certification Exams.  This is a permanent education license, providing unlimited practice, immediate feedback, analytics, and guided, expert, and exam modes to check progress and build confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clinicimmersives.com/privacyPolicy", "developer_terms_of_service_url": "https://clinicimmersives.com/termsConditions", "publisher_name": "inciteVR", "support_website_url": "https://clinicimmersives.com/support", "website_url": "https://incitevr.com/solutions/healthcare/ma-skills", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478304580399985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_1754677018254709_1795213526312633191_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wIS_8gyPb0Q7kNvwHWtAVv&_nc_oc=Ado00aT8J-QHkdTNFnK7JybSDMaCr6BpeNUDRGy0
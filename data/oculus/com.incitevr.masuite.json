WA&oe=69B021C7"}, {"file_name": "screenshot5.png", "id": "1086846368515723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003241_1086846375182389_3532808754830807107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqxsGAWtenEQ7kNvwG746OH&_nc_oc=AdlPLALXdKBTH9XY6yOrTSxOMQvz-ofZE3T1aQ_9v38JPI8imb-0UwUkKW1AAImyMDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNrS5E90_u6-p-pTlHE0yvkVglDteWQgc4T2d1_QKlFg&oe=69B02920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "221546809957040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_221546819957039_7723109708925411952_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTs4FHJmEY4Q7kNvwEP1RbK&_nc_oc=Adm70Q538_ERkGUD5bzKQ16yxm7y08wb4IP6AOE0E-pkFck45yhsZRK6HHT0uNEX6Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyok2WqRlxWEekf91CC1MYon9ZqTqwgTgWeIf82bh6scA&oe=69B02913"}, "display_name": "Medical Assisting Clinical Suite (Professional)", "keywords": [], "long_description": "Intended for medical assisting students and working professionals seeking a skills refresher, the Medical Assisting Clinical Suite (Professional) is clinical training in an immersive health care setting that teaches you how to prepare for, setup, document, and perform 33 clinical skills procedures common to the CMA/RMA/NCMA/CCMA/CMAC Certification Exams.  This is a permanent education license, providing unlimited practice \u2018anytime-anywhere\u2019, immediate feedback, analytics, and guided, expert, and exam modes to check progress and build confidence.\nA certificate of completion is available upon successful completion of all exam modes.\nImmersive learning is a paradigm shift that is already underway in healthcare education, where leading research shows that learners acquire clinical skills more rapidly, with fewer errors, and retain learned skills longer through immersive learning experiences.", "short_description": "Intended for students 
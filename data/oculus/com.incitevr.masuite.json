uY6RSlcQt8TDJail2LKb29vXyA&oe=69AADBC7"}, {"file_name": "screenshot5.png", "id": "1086846368515723", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003241_1086846375182389_3532808754830807107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDpn40ZedNIQ7kNvwGY0g0H&_nc_oc=Adlu6GFSq2b88PFgPBxg3CmekA_aB_WDRGcruJ00VbUwrMLrzjoR05vFQvS6ApFbtdA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_nWf8a6D8CoOWw_kBXmuO7eVRZTSqTrgACFY3PkFkNw&oe=69AAE320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "221546809957040", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75240106_221546819957039_7723109708925411952_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMJyPkE7KaEQ7kNvwEA5gLo&_nc_oc=AdloJWWQ_9WXUSvfa1wrjBy5x817b1O-1scL3w33uY2ZGNR1cDUl0w-jcQi6g7L306M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyD-psG-8D5pASRd4qecfJ3UWYXLIGIX5MNJmgKTKttpQ&oe=69AAE313"}, "display_name": "Medical Assisting Clinical Suite (Professional)", "keywords": [], "long_description": "Intended for medical assisting students and working professionals seeking a skills refresher, the Medical Assisting Clinical Suite (Professional) is clinical training in an immersive health care setting that teaches you how to prepare for, setup, document, and perform 33 clinical skills procedures common to the CMA/RMA/NCMA/CCMA/CMAC Certification Exams.  This is a permanent education license, providing unlimited practice \u2018anytime-anywhere\u2019, immediate feedback, analytics, and guided, expert, and exam modes to check progress and build confidence.\nA certificate of completion is available upon successful completion of all exam modes.\nImmersive learning is a paradigm shift that is already underway in healthcare education, where leading research shows that learners acquire clinical skills more rapidly, with fewer errors, and retain learned skills longer through immersive learning experiences.", "short_description":
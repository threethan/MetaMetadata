d=6e7a0a&_nc_ohc=oNibv5SjsDsQ7kNvwGbAjq3&_nc_oc=Adry6QQHKwuQ1DWCMNEOdHz0Tq2u-DeYnZ7NN5JLi2N9AevkTulpKxo7e6R3TDii8vE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWTT6joZ2JsxSJc9nwjs_IyjqV2atoy-Ju890273jYoQ&oe=6A5E11F1"}, {"file_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLvSHkoBoSIQ7kNvwGxFUUn&_nc_oc=AdqAG5AXDvC3RLURPBYbGkOoID5s6AKn8LFy--VxFk8LroUdoXUYlRJgVy4M1HgRmD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc1EadOcF-RVMCflC3KZ7rC1MxKGBdYL6cnmTiC-iU1w&oe=6A5E2F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qiMUZaytScQ7kNvwFmDIHa&_nc_oc=AdpYL0N0llWCEXRxAoI3jkR7Egnd9R4c5kbx0I_58FWNBXmCLUm0J_V57LK_yPVq6gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo6qJ6ru2yJanP9Ac-1GIkqUge4mceSw7ijCui_qotVA&oe=6A5E3158"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26970999212485724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_1643722873545660_1394352116950540110_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qfcW-cAHkgQ7kNvwEsL4nn&_nc_oc=Adr6AcVSHjVnnSzsjDD22Yruc0jQ1TfA1zEd3j1gsap_6pJ53mmszBVDZxd8COEZUeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-sxua9Jcwb_Fh4TLGYZArfoUKXdsb1seacpG-NQWkjg&oe=6A5E2ACF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Im A Rascal", "platform": "ANDROID_6DOF", "context_categor
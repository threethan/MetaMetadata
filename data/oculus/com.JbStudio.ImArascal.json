b=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ5A_KF7FlYQ7kNvwE1_5c5&_nc_oc=AdpJ0vCAS2r516jVUFTYipWKtA0yQiokk2yUvvRm_siidR1G31lM9RICKKg6Zw6LCDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiMMf2sdlQMuZjNLc5qQ67qH5RAohNz2hEa9uenT9GCw&oe=6A4BBE81"}, {"file_name": "2.png", "id": "25769819596023289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_25769819599356622_3036351450570875080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LAfHKCkbeUQ7kNvwHmP3uH&_nc_oc=AdpijiGi2GB3Ij_N0mGNwA9TGMebldfq3mD9WoE5OYkVIBYeBj36qeu7fGymU5y6-oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4pfrPBA8EX8f3iaoYXWYvGRvxZO6mKQ3N9C5Ay-4eKA&oe=6A4B9CF1"}, {"file_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5nn6R5hMKAQ7kNvwEE_pVy&_nc_oc=Adqzmeu_5g3ZjwvH6avWeV_kEDqyIcMXFOlc1vU8T0OdgbQtq_V0mL_07b0vZhS5JSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUT6DFG9IWCu5OMasga3atGkCcfIEqHpGrApSUhvwxgQ&oe=6A4BBA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svxHQc-Of_AQ7kNvwF8Fjwu&_nc_oc=AdqqKMVJoxHoX4poRcdxWylIPtX6jhdQd8ZfVtjtQFmhOF4jEfUAuPSBvBAq50WVqKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyZ99xB9C3SXkZ4rXl2ffCFOHfWhUSSAiygiT72uRvjw&oe=6A4BBC58"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26629498699969112"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2812489759108940"}]}, "baseline_offer": {"id": "2812489759108940"}, "is_app
=AdrdrhOPLVj7uYmStknVcDZkYdYhnKzRw3PRG5l3-k2tSH1TtrFos4_b9ovYWifR0hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-eun6Sm4I3Nh3uHFFyCi4LiH9FWUf5Uz07JWyhx3ccQ&oe=6AAAB52E"}, {"file_name": "1.png", "id": "26690214610630642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_26690214630630640_6699560580199619593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNF-YC27fOYQ7kNvwHAcyGT&_nc_oc=AdoqUrq1JfMlh6QQUiHj-j5ane_cOjlFkmK1Cve8HSVhcsY2QLu_lTSNmt92WsiXLJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYwOsfVGuKoCi7mPOi07p_I3yFwsIfXHw_E5zuSErhRg&oe=6AAAAA81"}, {"file_name": "2.png", "id": "25769819596023289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823854_25769819599356622_3036351450570875080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZM4RM5ZYAQQ7kNvwFD2XO7&_nc_oc=Adq5cad8DWrnmLZVjij3PzWAVI8Wx1JYnxv_Eun9LO1iyH8aL064Zt-xA_q-eIqBtig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVHlcm0nrP3lRozLLnITu5Gj1yJM69dJp7dAUhDXhc3A&oe=6AAA88F1"}, {"file_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn1aKI56Me0Q7kNvwGFYEVJ&_nc_oc=AdpXEtOHRyM1WghtpbCpcfYZOXxdO_SpYFQtNftzkA0stZUecDBR-G9N9shSedAGu2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJH81C9dsPFMHTiwOUz3kjzNQxzxAtgroORTxftZXJyg&oe=6AAAA687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ju3T0bEZEcQ7kNvwG-qwAw&_nc_oc=AdofJ_Go9fWv9v-6hwl7TQfdIIxmZbvg1-COLdGM3u1krNefekcg9qQ3SVb1SbzXMKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBjSjkv7hMt5LShYXn369HMxVgiewArIvvdQAic6RWlw&oe=6AAAA858"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
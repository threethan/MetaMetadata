_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kWZjxSYOIQ7kNvwEp6Fyl&_nc_oc=Adrr341RmlqALqvN8yQ0d3z3smtvvs8Oidao1YTQbu4bp7KrNdIoJvTSNgUWQIrH3K0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7945rtclTij8bHe6Vv122C5ew-qX26qhRWzcHSNkbDnw&oe=6A185007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKu8Bcdd2hIQ7kNvwGewvsj&_nc_oc=AdoF5-dW2xrrGC1UTrYlkQN-UJ6nR4gkBfoGQhhHU504qDzi9Tq6Z-oQBACd1tfklkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52PPI5ebesHG4M-zymahR6Ka5T4o5dIIt1JLCajJMXlw&oe=6A1851D8"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26970999212485724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_1643722873545660_1394352116950540110_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcHsIicELpUQ7kNvwGj8_Lx&_nc_oc=Adr26cnWjZ_qHZXQLyMVXUHG1gh-U9wSpXZzpaa3eMk6Vfo8BoVCHbAjld_D9V9g26k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56vdqEwBmQFV_Zr6vbx6D-PLgBxXD5pzaiU2VNz4HenA&oe=6A184B4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Im A Rascal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1774627440, "lastRevision": {"nodes": [{"id": "26629498743302441", "release_type": "SCHEDULED", "ad
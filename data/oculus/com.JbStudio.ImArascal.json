1"}, {"file_name": "2.png", "id": "25769819596023289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_25769819599356622_3036351450570875080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TIAlTBBgaQQ7kNvwHue8Y4&_nc_oc=Adp-7tem87DYOiAOt6Xxc-so64WV7j3twvtxX49lOwu0TgzS35zgI7nGZ0gCpvyb-bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xcv5y2xCzu9dNurOfp6D4YwHLGVfO876I3Qfil9BzPw&oe=6A2ED431"}, {"file_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-dc4q2FhNsQ7kNvwGO3WxG&_nc_oc=AdpYJEU57RIZ5GtQJKCV8G6f1bOfcvoafuaVMwD6p07sAEZHlJo4lFU4ixGBcXJJbNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y1a1GbacZlx5dH7_th7kCxzl4eB_phE83MCjq17C6gA&oe=6A2EB987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmDzxNz5u3cQ7kNvwGrfjGU&_nc_oc=AdqGowRk311SFsYJH5vXBwG9VpHD58hxwKzpm77W9r500x433WYmU_r5iVrQ41yb84c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yW-E-2974yhHJegVNpmTNWH0y3q7rtAdHt_09vvO45g&oe=6A2EBB58"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26629498699969112"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2812489759108940"}]}, "baseline_offer": {"id": "2812489759108940"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774627440, "status": "PUBLISHED", "id": "2812489759108940"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2
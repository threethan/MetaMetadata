14630630640_6699560580199619593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVDdvYEqR3IQ7kNvwFEz2hF&_nc_oc=AdrpyKkh8JZh_ChsdjffTCUtKVx15Z7pdttdt1IiJFNRNP55UvXYd69fKRAlHZ07sQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o1_jWxN5Ns8YmqjezsgR0Bsmox6J7QroqYvS1Rmeg4w&oe=69FA0181"}, {"file_name": "2.png", "id": "25769819596023289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823854_25769819599356622_3036351450570875080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0FC_sDBdGwQ7kNvwFBcZOi&_nc_oc=Adp2LamWB09hwndjLyLo48zsVJ2CkrSvOsD31MGP_nNTikCFVacMc34J2J45rKYL9AA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LDDmT9olKSzRhU7LOcKQXcQzriWGwoEdF0c9AZl0q5g&oe=69F9DFF1"}, {"file_name": "Image Sequence_004_0000.png", "id": "25726589977040575", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_25726589987040574_4650408330277911466_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKQEjCNgATAQ7kNvwEo-ZMl&_nc_oc=AdrtOMw_rlmLxzn9pKJtMmYY5B2Y-yhi_0VNxPfXoOfuoMaRVtok2-1YU43mGcLqEh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TC-DZRoFuO1RYv0Ac5rWKDhuP-3kP3-FTgBSSsNi8cA&oe=69F9FD87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_q4lsvwq4lsvwq4ls.png", "id": "2120110958738604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_2120110962071937_8265361888699801887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy_fdtpVkqgQ7kNvwH6Ai3g&_nc_oc=AdqISf-hYOyB0wKQ2ju5SzifdcLNJy6u4032RFTQU-KSfsUK66Ng0LbmeRnsQv2lWMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nMyFhRsgDqATkE-0Z8GEwHfdZhPzMrE3L9Vb3KHnSyQ&oe=69F9FF58"}, "display_name": "Im A Rascal", "keywords": ["prank", "Funny", "slap", "fighting", "school"], "long_description": "CAUSE CHAOS IN CLASS\nStep into the role of a mischievous student and turn your classroom upside down! Your main task is simple: disrupt everything and everyone. Throw apples at classmates, prank teachers with funny tricks, and make the classroom a chaotic playground.\n\nFLIP THE CLASSROOM\n\nKnock over desks, throw students and teachers around, and watch the hilarious reactions. From slapping pranks to over-the-top mayhem, nothing is off-limits in your mission to create total disorder.\n{931255579317179}\n\n\nDRINK THE GIANT POTION\n\nGrab the magical potion and watch yourself grow into a towering giant! Smash through desks, lift classmates and teachers.\n\n{1667556514258190}\n\nPURE FUN AND LAUGHTER\nI\u2019m a Rascal! is all about hilarious moments, chaos, and over-the-top mischief. Are you ready to cause mayhem in the classroom? \n\n\n\n{648534651686094}", "short_description": "Step into the chaos as a mischievous student! Throw apples, prank teachers, blast noises, grow huge with magic potions, and toss classmates around. Pure classroom mayhem awaits in I\u2019m a Rascal!"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26970999212485724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64
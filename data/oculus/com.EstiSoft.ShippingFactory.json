0f&oh=00_Af8nUb9OTEdetJA0pIyiapnHlx2ehhSr0Vyp-T7r3fI1zw&oe=6A3D3B0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-24 030729.png", "id": "1117463629746447", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974634_1117463633079780_7343539147849814148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TjknmtqPTMQ7kNvwG7NvOF&_nc_oc=Ado6phauAy3dLRhETqAPcFmc_HNlncrUKuzXFSoMA6_ZHv4Vf_vJ-KAqu1KdJvXJVoI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IclT30649yyzswSErNO40Wg8z1PaOixkP9Eb33C-Npg&oe=6A3D501B"}, "display_name": "Shipping Factory", "keywords": ["comfort", "casual", "hypercasual", "shipping", "arcadeidle"], "long_description": "Shipping Factory invites you to an immersive VR journey where logistics and strategy meet excitement. Available on Meta Quest, this game puts you in charge of a vibrant industrial hub. Your mission is to manage shipping containers, operate heavy machinery, and streamline workflows to keep the factory running efficiently.\n\nExperience the thrill of tackling complex challenges, such as meeting deadlines, solving resource bottlenecks, and adapting to unexpected scenarios. The factory is alive with activity\u2014conveyor belts hum, forklifts whir, and containers pile up as you work to optimize every aspect of your operation.\n\nWith intuitive VR controls, every action feels precise and satisfying. Carefully plan your moves, make quick decisions, and rise through the ranks of this high-stakes industrial world. Shipping Factory combines strategy, problem-solving, and hands-on interaction to deliver a truly engaging experience.\n\nWill you master the art of logistics and become the ultimate factory manager? Step into the world of Shipping Factory and find out!", "short_description": "Step into the dynamic world of logistics with Shipping Factory, a thrilling VR experience on Meta Quest! Manage shipping containers, operate machinery, and optimize workflows in a bustling factory. Navigate challenges like tight deadlines and resource management in a fully immersive industrial environment. Intuitive VR controls make every task engaging and precise. Whether you're strategizing logistics or perfecting the assembly line, Shipping Factory offers endless fun. Are you ready to master "}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/shipping-factory", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9088695567831430"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "3071509353049347"}, {"status": "PUBLISHED", "id": "26039722612290456"}, {"status": "PUBLISHED", "id": "4214140442247116"}, {"status": "PUBLISHED", "id": "1232827325041128"}, {"status": "PUBLISHED", "id": "646644854799405"}, {"status": "PUBLISHED", "id": "1384663329646169"}, {"status": "PUBLISHED", "id": "443083542174516"}, {"status": "PUBLISHED", "id": "545704628329642"}]}, "baseline_offer": {"id": "1384663329646169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "stat
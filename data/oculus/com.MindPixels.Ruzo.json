=69D25892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_02.png", "id": "755258066122271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_755258069455604_3152224420084855536_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU2sDqkExK0Q7kNvwGnr6Xu&_nc_oc=AdrT2W35ZjEMeCndIgyHP3q1eTDkwgr1d4iuUXVwVXffm1rt4KOyCTHdg_oB5wH3KAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SxLo6NUVXcJz1vtCLlVgzaV2SuOyLePpdqR3xKE8_gg&oe=69D24C4E"}, "display_name": "Ruzo", "keywords": [], "long_description": "VR Game for adventure seekers.\nRuzo, a young boy passionate about hunting, dreams of becoming a skilled hunter like the elders in his village. Village relies on the sacred forest for their livelihood, but Ruzo is restricted from venturing deep until he completes his training.\n\nUnexpectedly, a mysterious force plagues the nearby forest, causing suffering to the villagers. Desperate for a solution, Ruzo steps up, he decides to explore the depths of the forest.\n\nWill he be able to save his dying village????\n\nThe game unfolds as Ruzo evolves from a curious boy into an unexpected hero, facing suspenseful encounters and unravelling mysteries in the haunting forest.", "short_description": "VR shooting Game."}]}, "developer_name": "Mindpixels", "developer_privacy_policy_url": "https://www.mindpixels.io/privacy-policy/#developer", "developer_terms_of_service_url": null, "publisher_name": "Mindpixels", "support_website_url": null, "website_url": "https://www.mindpixels.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6-wzeNubTcQ7kNvwHOWWgA&_nc_oc=AdrIISygxy4EU6FZdttcTgpevaxkcEWZFiDccXePW2EEMRgfAPofXI_FHyAJHRXwxoo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMKEoSNr8Ef3eba2XWJVyf_ETznD-glIv8w3OKUu_zKg&oe=6A918276"}, {"file_name": "Main_Custom..._12.05.2025_19-51-40.png", "id": "1233201251703875", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822821_1233201255037208_2302763727501136695_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro90D_omKK4Q7kNvwGuQ0Bd&_nc_oc=AdqEnwffhq-O4Dx9Us4wuDK7Wz7Q-MBDplouhHPO7b0VVh6ZLyOX6hZ_zYYfm_WQqlY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDJFJrOyVE5eGGiuClpvB3ge7YjaOZmV03kZ_aQBoUZg&oe=6A916B47"}, {"file_name": "Main_Custom..._12.05.2025_19-50-37.png", "id": "762247262895327", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491822581_762247269561993_927212370882782938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD2HDVqzeQcQ7kNvwG7oz9g&_nc_oc=AdoU6-4vUHlc6XgDfyMHC14dOEJV8jry_QRIO8sqtXS-vBUISMnuGkydMyfPbdp8jxA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMsJSSe-9G04UqvozXFZDwtW1KuL5ES5drnk_SwZR-9w&oe=6A917715"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Game!", "keywords": [], "long_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\nWelcome to Banana Game, a chaotic, high-energy VR experience where you run, jump, and climb just like a monkey\u2014no joysticks, just pure movement! Inspired by Gorilla Tag, this fan-made game takes everything you love and throws in a big pile of bananas, new maps, game modes, and a wild community.\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock silly cosmetics, and explore jungles, cities, and banana-themed madness.\n\n\ud83e\udd8d Movement-based locomotion\n\ud83c\udf4c Banana traps and power-ups\n\ud83c\udf10 Multiplayer chaos\n\ud83c\udfad Cosmetic customization\n\ud83d\uddfa\ufe0f Unique, community-inspired maps\n\nNo rules. No limits. Just monkey business.\nCan you become the top banana?", "short_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock sill"}]}, "developer_name": "MayhemLLC", "developer_privacy_policy_url": "https://docs.google.com/document/d/10LZnuwhqBHZHpjVe02BDMyLzWdFnv7wOBcf5jeHVVxw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nightmare", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-chubz/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23999787552962510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491828816_1871601907026849_2608056570880895559_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX4hl4vJxdIQ7kNvwEdr478&_nc_oc=Adp-EyALeVSIy3vCkfWKosLG7zVQvaD-u-G6LR_Q_9H5_bWSKbGt2NQCWevQWv3NN50&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKv0yUYKGbMVB_sj3CaWD84uJj_i_07S63f4wKvWTe5g&oe=6A9175BC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Game!", "plat
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbtCKfh5RSwQ7kNvwFOeVuK&_nc_oc=AdpXnkEYAN3SeZ5wLt-ewK-yPpHylBbz7X3pXlJviUw5yvh3NvzQRJ26L-8GAXf905w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER8U13773hXUbplUmZFGzhtiQ9ly2nwp2jspgwCpz9uA&oe=6A7875F6"}, {"file_name": "Main_Custom..._12.05.2025_19-51-40.png", "id": "1233201251703875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822821_1233201255037208_2302763727501136695_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXilcodZWWcQ7kNvwFHddLf&_nc_oc=AdpFipo7cd3C5r_2igrODGKF0fAWVbhxI5WW6QoJeyVIhiGVvUxSyyx1alINPquiE3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFibBlB3sWgOvZJPVfOCUQLz16ttgRsSwZd8s81QYTEMg&oe=6A789707"}, {"file_name": "Main_Custom..._12.05.2025_19-50-37.png", "id": "762247262895327", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_762247269561993_927212370882782938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5sM4hbRuBgQ7kNvwFrI8ii&_nc_oc=AdoXvk93AQZEVYe3JTV_oSmebq0TfSos0gtbezp1xWcKwjO-TfSB6ci5Zn70phmGObY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB_mJDUUrfGI4LQ9NEWsH9FmBAR0zL-ALnUzJ9xr-l_Q&oe=6A786A95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Game!", "keywords": [], "long_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\nWelcome to Banana Game, a chaotic, high-energy VR experience where you run, jump, and climb just like a monkey\u2014no joysticks, just pure movement! Inspired by Gorilla Tag, this fan-made game takes everything you love and throws in a big pile of bananas, new maps, game modes, and a wild community.\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock silly cosmetics, and explore jungles, cities, and banana-themed madness.\n\n\ud83e\udd8d Movement-based locomotion\n\ud83c\udf4c Banana traps and power-ups\n\ud83c\udf10 Multiplayer chaos\n\ud83c\udfad Cosmetic customization\n\ud83d\uddfa\ufe0f Unique, community-inspired maps\n\nNo rules. No limits. Just monkey business.\nCan you become the top banana?", "short_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock sill"}]}, "developer_name": "MayhemLLC", "developer_privacy_policy_url": "https://docs.google.com/document/d/10LZnuwhqBHZHpjVe02BDMyLzWdFnv7wOBcf5jeHVVxw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nightmare", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-chubz/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23999787552962510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828816_1871601907026849_2608056570880895559_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei9l53wk0YgQ7kNvwE58ORq&_nc_oc=Adp5yHRK1DQyn5MSMpp2NUGn1uzjuAC6MArmhr0-9-8H7pIyd6sPS2APPyjwtUNbS9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLLX2Ev81C4oYVEjSO1qIEmLDeAVxuX8xMe45pvbVB-g&oe=6A78693C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Game!", "plat
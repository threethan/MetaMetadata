4Q7kNvwHghHER&_nc_oc=Adk39ZACdH58gtLofrKtGA2C0SXHSxR2XCND7s2Pnem45EZV3_7VuDlLxStWMyZb7xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsxj-vVnE4tNez1FKZ_MhUbZ_vO6lqmwuqTPfx3KKLzbg&oe=699C3447"}, {"file_name": "Main_Custom..._12.05.2025_19-50-37.png", "id": "762247262895327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_762247269561993_927212370882782938_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TOa0BKL0AQQ7kNvwFCcYR-&_nc_oc=AdnjSZO49LmTXEiO_g68g4S7F4kPurTva5I2BrSnYFdpiVrJbRySKtwbXJvwAcc9HxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdMzwjcE78EMY2iDgczvvSyREJYDTmTlvABQsa6Nx5Sw&oe=699C4015"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Game!", "keywords": [], "long_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\nWelcome to Banana Game, a chaotic, high-energy VR experience where you run, jump, and climb just like a monkey\u2014no joysticks, just pure movement! Inspired by Gorilla Tag, this fan-made game takes everything you love and throws in a big pile of bananas, new maps, game modes, and a wild community.\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock silly cosmetics, and explore jungles, cities, and banana-themed madness.\n\n\ud83e\udd8d Movement-based locomotion\n\ud83c\udf4c Banana traps and power-ups\n\ud83c\udf10 Multiplayer chaos\n\ud83c\udfad Cosmetic customization\n\ud83d\uddfa\ufe0f Unique, community-inspired maps\n\nNo rules. No limits. Just monkey business.\nCan you become the top banana?", "short_description": "\ud83c\udf4c Banana Game \u2013 A Gorilla Tag Fan Game\n\nClimb walls, swing through trees, and dodge slippery banana traps as you chase or escape your friends in fast-paced tag matches. Customize your monkey, unlock sill"}]}, "developer_name": "MayhemLLC", "developer_privacy_policy_url": "https://docs.google.com/document/d/10LZnuwhqBHZHpjVe02BDMyLzWdFnv7wOBcf5jeHVVxw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nightmare", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-chubz/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23999787552962510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828816_1871601907026849_2608056570880895559_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVDFduH2mQ0Q7kNvwGA24ao&_nc_oc=Adk8-sIybTgBD8RLeWs0JC9M7vzSLGkNHwH224JbCd4Z1lYEiVVb9uK0hTW5lF5eiE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftC3aURtsGw_CHlPFf29B10sEGc0xkrFInAwQwU8GMCjA&oe=699C3EBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Game!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1747166940, "lastRevision": {"nodes": [{"id": "23982951734646092", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23982951677979431", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1037093474534
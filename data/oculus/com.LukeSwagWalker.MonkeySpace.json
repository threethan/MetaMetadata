287667698376", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGrskfxpyxgQ7kNvwGy-CH8&_nc_oc=AdkAYz4R0KUsk5Kgt6YMXAjJgeBLIym4QOco8w5T8vpbAvaspzN2O2HIWI0ZEKWWra0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRS7zAxHOl8ycnH2oexKTsLAIKkhwSgDOie7lhKi4SRA&oe=69BBF71B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUJD-552LuUQ7kNvwFsWTE7&_nc_oc=AdmOaaogUOdQRbRkzwWkNUHQoEh7zatfRCYv4GWHHFrrQFPWSfzzY36NV8-Ct34waUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfweSfxBQLyTttqzNGbKaglb1OMVO_8Ydxcr1F1NohdwoA&oe=69BBF82A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url"
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDpX6lt-bVwa55RcDn54IESnGWrhMm6yJs9RixwLbLHA&oe=6AFF2273"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKFMVLLb2iQQ7kNvwHIsg37&_nc_oc=Adrixj6Oe-KxWRArrePbxUerwdzd0pafRXy17-0qqCxa-X_glIqS1rxghHGTmviBAyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQClMKOkwX6b_qRBAckzHhSh3MXpVo59QaO2yVAUOo-Sg&oe=6AFF2852"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ-CBEOnMtYQ7kNvwHxfEHF&_nc_oc=AdqrnCsj14zdYVy0NJnMNXTsatkA8GfVZ0YGvZ1f8_nVlUo0QbMt6n5t7CEAli4Of3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi8R1xYLV4dFNV3ERtwGmEs2EhQ3k2VRDjwtaWXBZwbg&oe=6AFF2BB3"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7VL1qj7SjIQ7kNvwG-hJNy&_nc_oc=Adotg2XKSuny-oTv8qmruoqzTaZAv6Ufn7KZcg7WFUECGwzceQnkyBIGvUNRCIfXtLc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM7NxdlJ_453WMRsbKaM7OM0u97vqK5_3nh8mmKI_Odw&oe=6AFF2EDB"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7dsSApPHkIQ7kNvwFFO6aX&_nc_oc=AdrnggKPE81AEB7kj58sqbZeruV_KfmPKwzbOdmB0d_fZ5DsaomOr-DGGPp9C1Glm_c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS4yD2i_RjA41X9Bfl2-WodzmHedSHqZq8WriIb12Qaw&oe=6AFF2FEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
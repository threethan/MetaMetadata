vVvacgFPwbPbDW4J31cwz1PQBbyn0FhAwp7Bg&oe=69DF7C71"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihnN3VhDIAIQ7kNvwG0v4g3&_nc_oc=AdrBq1CEq23SHpkT1yAwGm-pNbMoqhmdYY2-mV4KvlpDw2cHCBABG_TXOwXIk-lAvLI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i9cJq_CayN-y8OnzJMBRGHAUmWxp1KM7qUF-8RAlFtA&oe=69DF8F9B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fg9MvkBS2QQ7kNvwFOgbGa&_nc_oc=AdrobYMzvnOQsZ6P1qr7s9xGLUJDwyvkJwa4Is8uC8s5c2xI4O5Gu3_2jj9MxcLlTtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JY6YDJJhoF89QKkr_9RtEW6S0pYXaBnKSn-qWqTUphQ&oe=69DF90AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-e
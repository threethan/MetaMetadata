-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJT-gvUC9Fpp_K6TJ-DhXDDNc-wMw1MUfMRzoA3MGRmQ&oe=6B01C573"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKFMVLLb2iQQ7kNvwGaHszq&_nc_oc=AdppIY34XbiIwni3-jx613hskaAVf5SO3FiVyeZJKfvRHcNfw7dfWXqmoxZe2dQgbHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEWWzO8Sd3R4ThSlebRoSox0pVso2jOb71KNqt6UZPSw&oe=6B01CB52"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JElTk8ZFSSUQ7kNvwHU0vHu&_nc_oc=AdpsXpBM6ZacazG5QXA8MKnLLmuyftLfwyJGkAZcLaXQo9vjdkRG64Ne98VMiyJ5oB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVt5jK98KbuL4Krvx2p_k1849Xfm4J41HWIvqDDNqtKg&oe=6B01CEB3"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGOzfkkryfgQ7kNvwFfwtbv&_nc_oc=AdoNDtHv1J5TLYjuyUxKkw3b4rd_dYmc5XmToDMfZ5ro5X-C9bdyJceJPyNB1g_Sa54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjUEzc_hOa00TgCg4H-X8kVTB5-4ke5npmcYxa5IIgJw&oe=6B01D1DB"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgwgzfFFbcQQ7kNvwEcCdyO&_nc_oc=AdoM7Ye8X5W1pjG867vpx6ToSsS9pJuP6FVSOd2idiEZ7D-_0V09hkGDzRvg16ZQrw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFH2TTin7xIzyh199226JCz2v4KoJ_x2ZlPVIEvbQ06Q&oe=6B01D2EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
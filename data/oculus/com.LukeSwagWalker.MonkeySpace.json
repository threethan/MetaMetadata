cdn.com&_nc_ss=7f20f&oh=00_Af6-wqVoPZgYmEPJCSd4fpZLt75M7kI98tG5URoUyMFLuA&oe=6A11CDB1"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lILv3Mq5uo8Q7kNvwEaW70l&_nc_oc=AdrEVAhGpf3tg-d41wjhJjVtP7UkoSMCi4vZE9fN7pVPqSqhRSj2x2K-12YoVBEXybQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KCb8FRacbXe-J8vwupUxewLO1Hzv9-prXIwpWpmZSwg&oe=6A11A89B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBnQyGlS29UQ7kNvwGNZfk0&_nc_oc=AdoMliCnVk6OnHb0QZGzBshLqq695QVcDnJ3kqrCZSECj5hyePb0vJX0YEIPyLT92ms&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i2EvBtEYVP8H2CUSIzpi1e9iarv6K7F68exGb8pzWdg&oe=6A11A9AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsf
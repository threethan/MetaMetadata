-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHVXQVyUyuK-FYv4qNLZF3WkFwpK8SRjgY82DJ98JRRA&oe=6B085CF3"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnbBu0dWfbQQ7kNvwEjkfzY&_nc_oc=AdpUB2suP3_0Q01lWzkEMGzx885sXTUN5_-taF_5WUPlzQjYPbaajt9WlsH1CsXsZPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0uggmohJ1I7sMOR5z8Ej9CkmOVwIpSIJO5O5iqmW5dQ&oe=6B0862D2"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMH14ILSL8gQ7kNvwHOhcjD&_nc_oc=AdqS-6bDIwahh3d3BAF-WOz9SQXS3ttCVjy1uxZru_CY6PrrhsY23QBOptNkFFKxNxM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStF_Zy-Z8tfAcNx6pjHPENh09L8Qrjf5eJVGrx_B7ATw&oe=6B086633"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6B9Ufju2I8Q7kNvwGzw4U0&_nc_oc=Ado5Z29H7Z4Iz7MZ2LBi7uHSR84HAwk-8LUjXaF2EC2xQR_RjxTOrqkQ5eSE2LgI1tQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlRabNcR5XOeiUO8CPhKNQ6XIg92_ENxE6HzVVav93aw&oe=6B08695B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTp_Sqi79wQQ7kNvwHAJfSz&_nc_oc=AdpJZLDrnmvW5LV-SD7PJY8yiuWFLWYOHhR7L7Dh9A5NMnSjKqX6B1DxS58MFuZkqdo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeAr1Zy2fyC-oMxZ6Xq082qoXbG_bTX-uMeEU3frsDhQ&oe=6B086A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
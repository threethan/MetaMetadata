-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRagJ03M-O-f82sioDj3dDdp_P6fs_cPFQAY-TNRlJtZA&oe=6B0316F3"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP9CwtA-TMoQ7kNvwFAC3aN&_nc_oc=AdoErVFn0IY8l5XTUKpkDXalhw3NjG75KPbhLSEzh6GicDOhDQ7MhhE2atGsnW7qHRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLXSTrtjBFkxNcFx2TwEBkSSaOVgO93GTHzB7G6dWLrg&oe=6B031CD2"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JElTk8ZFSSUQ7kNvwGy509W&_nc_oc=AdoP3_4TK1I9blvtbCUin2ZNvtWGR3doXLLJtKUlFPdARy6qhofdnE0y2guc4dthqz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbzQIL_hwKK7uHhdczD7yPExpQk24dTQy1XAiXa9cdFA&oe=6B032033"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGOzfkkryfgQ7kNvwGrElRx&_nc_oc=AdqkPyoHXrMGxvwM2wynG9PVfhi3NlBcT7X1AjCVSUjH_aZE8b8rovpsGxdgPHFQY_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnZ3gR01B7dJ4eEEZfZeUNBiX__uQ0wBjpAkusVpWlGg&oe=6B03235B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgwgzfFFbcQQ7kNvwF9cfRo&_nc_oc=AdqhxBqu1KyDBluCWF0BUir1cBRYvzV8n9dsqQCR1UG-lr7icMU2i2nXz9GQweguUas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgNtZi1lR9WAZRreGlhchEfxpz6cXt30xz570z-aBakQ&oe=6B03246A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
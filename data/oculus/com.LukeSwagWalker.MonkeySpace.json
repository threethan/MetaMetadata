cdn.com&_nc_ss=7f20f&oh=00_Af-MXy_575GA6szYQ3c8weh5ppnR0lj9kZs1dqC_CFmIxg&oe=6A22F131"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De7QjNR5OM0Q7kNvwHQ2Q_X&_nc_oc=Ado8LmHdCgnFB3vA69-avQvU2AkBYBBEvoN3RfCYN5Da11kcyN-QSN3xT1Y1DVpOg4w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oy4i2XB10Tjd4mo6iZ5a8cRv5cA3celzd_8Z-ixv5vw&oe=6A22CC1B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDbZWUMfoCUQ7kNvwEdh8F4&_nc_oc=Ado7-4Bmi5N-5vFFUC0ScmSrhI-PRvEwc_bQQ9hxV6IkB_ZOkq3bvKKh6Upqr3LZeRA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GxiUMTj95HfvBQKyTCUWx7h_yuryrkoYHANBxnzyC0A&oe=6A22CD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsf
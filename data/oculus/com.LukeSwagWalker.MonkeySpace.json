-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4QyaITbrVJb5JHgtwWiqP4wDlDH1BCWEWFVlPlZiaDw&oe=6B1045F3"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTpSVBdiER4Q7kNvwEjVWta&_nc_oc=Adp5kejeZ3vWT2LNpm191O74bxDb_v-bxbQ1jnpUQdJqI46Bd0M0oCgvtHg3fQJKnQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6eHVZZJbtPCWbqoywZTavCFZyEzHDihYIESDOnfb_lA&oe=6B104BD2"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzL2sJhwABUQ7kNvwEwV2Au&_nc_oc=Adotf6-XGHv6UYWUVKfPpfUFSC_4db12W3vQNJVr1Jcn146lOUJMrJIr-EMXLbuB6DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPZoEE1O0YtgemM9wl5LPtjjnEOwpukFtTyNts6KFSjw&oe=6B104F33"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIZWE6M_u1wQ7kNvwHyoIlH&_nc_oc=Adpc6IHbhuiX4Xg3m-ZNa1tqZ0Znjd4YRdpw9pyc7BG3gDx8VzePta1e4NWLuNCGxMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9zsly3DRdYcovh9s3jo7Zvz75J8GxLsHfNHT1LC5rjw&oe=6B10525B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkEBL2FvseMQ7kNvwHJA0cT&_nc_oc=Ado7IZhZrNqVtWzCWRTJX2AqIx2D_A7oayZI03Suj4vv4KQeUoro0BVQhqEkZzPhPSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXceKmy1qlqyED7s_0AifahJFkdKvi480jQCewP6ZhEhw&oe=6B10536A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
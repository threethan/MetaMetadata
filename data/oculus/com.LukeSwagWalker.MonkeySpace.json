_TLoHQO70imqOaQg9xyxHgsMT1y8YqqeHE4Ug&oe=69FC7D71"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tozwtNFOgwQ7kNvwH3DVZt&_nc_oc=AdrcNiyi8YnGalDPol-kH4m_kH5ASQpo1yttcxHJqa-pJ1gFZvTarUlOSRVt6XcxT1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YszO264XKOuL8SpmCgX86cNvxsVFOEqhYO_wl-zBlSg&oe=69FC909B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of69BIPKqpEQ7kNvwFFwD_H&_nc_oc=AdpBU-ERw-o8iDIvmpKqGCVLiykC0ArQz7Hg-utojZCgm0S6ybvpkz9cwUQYBreM2c8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Uko54HDu6T4iU8vC1CzCNqD68veNrrB2Z7EbT9dLy5A&oe=69FC91AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-e
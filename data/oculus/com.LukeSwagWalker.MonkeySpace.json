-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUn_Ih_0GaM592JR9xTajkP4wL2uqCCzfof0KAinkmMg&oe=6AFC7F73"}, {"file_name": "Untitled design (17).png", "id": "1126649825739782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1126649829073115_3683479454548475503_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYEkg4te3EMQ7kNvwHLuc4i&_nc_oc=AdqCvSjMLri9A9DR3ZQFL84kjwWLkqs4xStsT7ybVBXTDfq5LksU2I9fTw-6Wf2RcmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwkE0M5nvqp8DaQaqoEXnrpLWQ-3kXkQek16pY1YrJHg&oe=6AFC8552"}, {"file_name": "99% of people cant build this (1).png", "id": "433767992647406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036706_433767995980739_6012737578053521790_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ-CBEOnMtYQ7kNvwHKI8V_&_nc_oc=AdoeT7D4acA1gOdjn2kwGBQ3DcGuGYMyWZR-6BPzesWRgGJsqEeUK5iGUvb2R0wteNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHAI5Wl8nCcKX5-Rgn0elc_3Np1akwJd3QJSE7ODLWcg&oe=6AFC88B3"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BZ34oyKQoMQ7kNvwHGWtqc&_nc_oc=AdoeGyfOmbcnikbAKL5jyG3IHB_6qQIQNRZV8-BSsObYJtVuyNd_gIftwFXho_JTBx4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlkihyRbo3o8030rCSGqWHMCECGJc-reyZYPyDpgx7Ag&oe=6AFC8BDB"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7dsSApPHkIQ7kNvwHEqpUr&_nc_oc=AdpRjLVtafly2MBzusyVkIoun7ILIi3V16DjDqwVUcPvAhnVjGac5kga78c1Kd0L-K8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuLv2PPglbgI1U70yuizxjyEYJBH5mn0A6QZKi14EiHw&oe=6AFC8CEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system.\n\nWhat To Do?!\nThere is no goal in this game just build stuff like in Minecraft creative mode. You can build monkey launchers with the fan block, or anti gravity globes with the space block and glass. And trust me it is so much more fun with other people so invite your friends to play as well.\n\nPlease if you have ANY feed back, put it in the discord or email it to me."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-ec8a1c993eab", "developer_terms_of_service_url": null, "publisher_name": "LukeSwagWalker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TSX42uHNHcKdPgUfM4k1Ar6vLe9Gzu8hGVhFzK_IoC8/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
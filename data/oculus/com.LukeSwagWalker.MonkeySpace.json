wTZ4ocGUQ-ja--fexX7vBY1lL5gf5lpCvUMKw&oe=69C912F1"}, {"file_name": "MainGame_Custom..._19.09.2024_16-47-25.png", "id": "1041287667698376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_1041287671031709_1368812967187463227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC7SY__VpbsQ7kNvwEl4Jo6&_nc_oc=Adrk2mk2rqQhoBIqpd30tcFCzLWKq5FXbJljPXTXcKFl2sqec-D5GpKb56SouP4h8do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt92-xJnhgQtjmOqomrNPB6KqDQ30CFEb3RcIafnWV_Q&oe=69C9261B"}, {"file_name": "MainGame_Custom..._19.09.2024_16-43-17.png", "id": "823277980005322", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035428_823277986671988_6030168098621021744_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHl93pBL2t4Q7kNvwFC5a2z&_nc_oc=Adow5tz41PfI8Y0CA7otFQ4Dj9D3yQDf5_EEdNphw1tXR-yKYW7WvBFDqCHoaW_c5JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHj045KnX8HzETd3Afq9DLGvKC9cL6AThjh8ev1LXTTA&oe=69C9272A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Space", "keywords": ["Build", "Social", "Creative", "Fun", "FanGame"], "long_description": "Monkey Space is a fan game that combines the creative freedom of placing blocks with a physical, hand based locomotion system. In this multiplayer VR game, players can build by placing blocks while moving through the environment using a unique hand based movement mechanic. The game focuses on providing a fun, interactive space where players can join together online and create structures while moving energetically with this immersive locomotion system. With simple block placing mechanics, the game emphasizes creativity and physical activity in an open online environment.", "short_description": "Monkey Space is a fan game that combines the creative building mechanics of Minecraft with a hand based locomotion system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/9717cec5-fd86-432a-ab3a-e
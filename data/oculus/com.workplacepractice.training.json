ile_name": "04-preparation-card.png", "id": "1135896585563903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1135896588897236_8300327844598135613_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1kngnepDfsQ7kNvwFz522C&_nc_oc=AdpgEI8GMn-T59oMibxITgwZlX1ucvSc1cWNrmeeUcrH8jAVkYY5P3IwL3sbu2gJR6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIVZzyS5agS2USxFGNMRJkNrDCMaEjz0eT9lMWIkZZCg&oe=6AFDD98A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Conversations at Work", "keywords": [], "long_description": "Prepare for a difficult workplace conversation before you have it.\n\nLearn with Rowan through short recorded lessons and readable panels. Practise describing facts and impact, asking and listening, acknowledging concerns while clarifying expectations, and agreeing a specific next step.\n\nRehearse one seated scenario with Alex, an AI employee whose two late reports delayed a client review. Speak naturally, explore what happened and work toward a plan. Review a concise coaching summary, retry a focused moment and adapt a workplace preparation card.\n\nIncludes one free practice per account, up to 10 minutes, with feedback and one retry of up to 3 minutes within 24 hours. Recorded lessons and preparation cards do not consume a session. Optional one-time packs of 3 additional Quest sessions are available in Meta checkout at the displayed price. No subscription.\n\nSeated Touch-controller controls, captions, larger text and voice-volume settings. A Meta account entitled to the app and internet are required for account access and AI practice. Speaking requires microphone permission. Recorded Quest lessons work offline.\n\nAn optional web companion offers typed or spoken practice using the shared free allowance. Paid Quest sessions cannot currently be used on web. Preparation cards do not sync.\n\nUse fictional details. AI responses and feedback may contain mistakes. Coaching follows an authored rubric; it is not a validated assessment or an employment decision tool.", "short_description": "Learn a practical approach to difficult workplace conversations, rehearse with an AI colleague, and try again with focused coaching."}]}, "developer_name": "Samphy Y", "developer_privacy_policy_url": "https://workplace-practice.ysamphy.workers.dev/Web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "YSAMPHY LLC", "support_website_url": null, "website_url": "https://workplace-practice.ysamphy.workers.dev/Web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346278521911893"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624656_1136404332071798_1459215473047680525_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1LA6J2smx0Q7kNvwF6G16g&_nc_oc=AdqVbW8gcd0-lcF-qQMzO6xNGZ5aFeIeWT_cg8a6cguXLc0ajAjCxIUbqWAKDP6Kna0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKh6C56dAVjlU7A8AcyeBeI5WYQXDEGlKTe5TGzLxChw&oe=6AFDB9D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Difficult Conversations at Work", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Han
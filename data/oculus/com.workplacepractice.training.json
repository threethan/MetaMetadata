0f&oh=00_AQTBq45jXJBTFw6iBTfmhoxAZRmz0EI1JO8qWoDJCqahhQ&oe=6AFDE572"}, {"file_name": "03-the-scenario.png", "id": "1630818818531243", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622188_1630818821864576_3302242437134061640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zxBkrN45noQ7kNvwEp-ikm&_nc_oc=AdrHc3fDLMK2FGAJCWnNFZMkRA0zqjAaDbk8IaViGH1hST_ep7Po6NS8b5IgVDtfSNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh_Z09z9zFJe8A05ugJQmzP7QICxgfTK5h4G_uM7yVlQ&oe=6AFDC408"}, {"file_name": "05-office-alex.png", "id": "1302552348664412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_1302552351997745_7525931569341959972_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWIH1Fm8dWEQ7kNvwEd-wbL&_nc_oc=AdpGlfk2sICvAbdB6fAfxfz-TEmNiQ0wpw9P5ZFOD7yv8-E6HBT9NXbkdtGs9_TvYZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRFWU433ICeZSniL4CO028e4fPbUESPMY_cV35UkOPxw&oe=6AFDAE16"}, {"file_name": "04-preparation-card.png", "id": "1135896585563903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1135896588897236_8300327844598135613_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1kngnepDfsQ7kNvwFz522C&_nc_oc=AdpgEI8GMn-T59oMibxITgwZlX1ucvSc1cWNrmeeUcrH8jAVkYY5P3IwL3sbu2gJR6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIVZzyS5agS2USxFGNMRJkNrDCMaEjz0eT9lMWIkZZCg&oe=6AFDD98A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Difficult Conversations at Work", "keywords": [], "long_description": "Prepare for a difficult workplace conversation before you have it.\n\nLearn with Rowan through short recorded lessons and readable panels. Practise describing facts and impact, asking and listening, acknowledging concerns while clarifying expectations, and agreeing a specific next step.\n\nRehearse one seated scenario with Alex, an AI employee whose two late reports delayed a client review. Speak naturally, explore what happened and work toward a plan. Review a concise coaching summary, retry a focused moment and adapt a workplace preparation card.\n\nIncludes one free practice per account, up to 10 minutes, with feedback and one retry of up to 3 minutes within 24 hours. Recorded lessons and preparation cards do not consume a session. Public checkout is currently unavailable.\n\nSeated Touch-controller controls, captions, larger text and voice-volume settings. A Meta account entitled to the app and internet are required for account access and AI practice. Speaking requires microphone permission. Recorded Quest lessons work offline.\n\nAn optional web companion offers typed or spoken practice using the shared free allowance. Paid Quest sessions cannot currently be used on web. Preparation cards do not sync.\n\nUse fictional details. AI responses and feedback may contain mistakes. Coaching follows an authored rubric; it is not a validated assessment or an employment decision tool.", "short_description": "Learn a practical approach to difficult workplace conversations, rehearse with an AI colleague, and try again with focused coaching."}]}, "developer_name": "Samphy Y", "developer_privacy_policy_url": "https://workplace-practice.ysamphy.workers.dev/Web/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "YSAMPHY LLC", "support_website_url": null, "website_url": "https://workplace-practice.ysamphy.workers.dev/Web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
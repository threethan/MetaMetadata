wfH_QkfN5ybX4-E0hhYZrAG7M-vb6YhH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDP6QjY4w2nT3Wox9WnRtUWMyQL8xHtYF9dYoTa-UiHg&oe=69AFFD3D"}, {"file_name": "sc3.png", "id": "1137471304069427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984445_1137471307402760_7212815590231567740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlfxhWgwJ9wQ7kNvwHh2IS0&_nc_oc=AdngDYTug9CQwMwaoY2v5mNXy_xTSfJ0OFgk3Rclvw1u--n-WAGZgXSOXMatSrJeYjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3XOTdHw4pmkIbcIg4y54HQD-lzSjdeJcxb729cVcbHQ&oe=69B01C6A"}, {"file_name": "sc5.png", "id": "969196391551875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520131_969196394885208_7115778398273723767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq-EFfB-ecoQ7kNvwGLdVwB&_nc_oc=Adk1tHiA8tbM65XQsJ2OXQgTcnyou0Txo75hSKeZAur7Tb5Loy-IwSjYfOX_k2Jy8uc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-fuHO3QRdzrd2u5q1VMDGs9eb0R_mRM_RZFDknZ25-Q&oe=69B0151E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1009902807136482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031425_1009902810469815_1845567791388563259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjW8KKK_xFsQ7kNvwFjT6UL&_nc_oc=Adn-2ZDj2LzAbzOb5TvuUqWeyRc2ZlRGulOMsFKZiF-FZdjxzqiMbynYQhyWN5iLJZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxztqC1ulzhIYudhVm9IYHyPu5zo48eDwY4nqA7CQ40sw&oe=69AFF864"}, "display_name": "Green Zone", "keywords": ["defense", "Zombie", "Shooter", "Survival", "Action"], "long_description": "Immerse yourself in a post-apocalyptic world filled with toxic zombies in this thrilling Meta Quest game. Players must navigate through a variety of environments, each presenting unique challenges and threats. Equip yourself with a diverse array of weapons, from firearms to explosives, and strategically place mines and barriers to fortify defenses. As you progress, you'll need to defend cities from waves of relentless zombies, using every tool and tactic at your disposal. Master the art of survival, adapt to changing scenarios, and unlock new levels and equipment to enhance your fighting capabilities. This intense VR experience not only tests your combat skills but also your ability to strategize under pressure. Prepare for an adrenaline-pumping adventure that keeps you on the edge of your seat!", "short_description": "Survive amidst toxic zombies in diverse locations in this new Meta Quest game! Defend cities using an arsenal of weapons, mines, and barriers. Discover unique tactics and strategies to fight for your life!"}]}, "developer_name": "Bexzod Abdubekov", "developer_privacy_policy_url": "https://www.facebook.com/permalink.php?story_fbid=122108972456316995&id=61559509877826", "developer_terms_of_service_url": null, "publisher_name": "Bexzod Abdubekov", "support_website_url": null, "website_url": "https://www.facebook.com/61559509877826/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9807585509351482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348041_1640617176520941_2891858986587112468_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJgHm8t702gQ7kNvwEV4gLU&_nc_oc=AdkZawJYFbgyQrbUhkWb5MdfIJXeLT5SRgm24Z40ImNN2UBUYcJ
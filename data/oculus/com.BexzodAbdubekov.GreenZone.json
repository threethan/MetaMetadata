2pkyHz47aMR-hBih_Mdzdug2rf1vMVRFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft7dOPAFirj5Nf_Z2HredVfUIjrYbdXZQnmbO1YlYa1zQ&oe=69A965BD"}, {"file_name": "sc3.png", "id": "1137471304069427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984445_1137471307402760_7212815590231567740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxDFpc1PIvgQ7kNvwGv10NZ&_nc_oc=AdllaOmUTHJUyE6Lvqya-b82RUlyn_el5Kiw0RTS-xvsJxoG4fkrrdlBrSDj2fNiORY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmtMuTyU2cra__eSVhfrU99lADuRQTi0srHUBsdfrRnw&oe=69A984EA"}, {"file_name": "sc5.png", "id": "969196391551875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520131_969196394885208_7115778398273723767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fCPJ8VZy0YQ7kNvwEcZ5fO&_nc_oc=AdkYjVWfW9eLEWs89GVcnWN3TZDud3v3Smohd8OC5MgHKXPY_mQcKv8b98E27EwHSuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuWVrxCtSVjbVfQAK504s0Z5NoI5J8n01rIvkDPNkeOww&oe=69A97D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1009902807136482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031425_1009902810469815_1845567791388563259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhaAfDiiLuEQ7kNvwEvipX3&_nc_oc=AdlNrcrCco2B2Hn2YUo_65gxdby5u2gnNebZjC2pQYTVGfka24epCjGvkEeT2ctHuu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftJ-QwQvVoKjYMq8rDuOoAM7e-9jB78eDfU3extnhLI4g&oe=69A960E4"}, "display_name": "Green Zone", "keywords": ["defense", "Zombie", "Shooter", "Survival", "Action"], "long_description": "Immerse yourself in a post-apocalyptic world filled with toxic zombies in this thrilling Meta Quest game. Players must navigate through a variety of environments, each presenting unique challenges and threats. Equip yourself with a diverse array of weapons, from firearms to explosives, and strategically place mines and barriers to fortify defenses. As you progress, you'll need to defend cities from waves of relentless zombies, using every tool and tactic at your disposal. Master the art of survival, adapt to changing scenarios, and unlock new levels and equipment to enhance your fighting capabilities. This intense VR experience not only tests your combat skills but also your ability to strategize under pressure. Prepare for an adrenaline-pumping adventure that keeps you on the edge of your seat!", "short_description": "Survive amidst toxic zombies in diverse locations in this new Meta Quest game! Defend cities using an arsenal of weapons, mines, and barriers. Discover unique tactics and strategies to fight for your life!"}]}, "developer_name": "Bexzod Abdubekov", "developer_privacy_policy_url": "https://www.facebook.com/permalink.php?story_fbid=122108972456316995&id=61559509877826", "developer_terms_of_service_url": null, "publisher_name": "Bexzod Abdubekov", "support_website_url": null, "website_url": "https://www.facebook.com/61559509877826/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9807585509351482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348041_1640617176520941_2891858986587112468_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PaOmFLkRDQQ7kNvwF4kMDW&_nc_oc=AdlYA6i69r2hdGo-WEVH8lQpiFcoMP3nL5rJesQQuUEVuTHlvx9
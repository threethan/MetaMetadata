QUn3N_QV2EqEFNo4P5y5OYJOzvkyaIVAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6i1gBq9IKa9MK62YmH8MroaFoy35DMZgIWND5Zg1RkA&oe=69B3F1BD"}, {"file_name": "sc3.png", "id": "1137471304069427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984445_1137471307402760_7212815590231567740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzmxaHAACasQ7kNvwE_LyGy&_nc_oc=Adk62t5XMqQW2cwzNs-KDKxOWW2uIGdCtLhkOcG71Qf8EED9pTYxl4X4KZOdMtuG9fc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyszLmuJXVkhY76izu4usvDNBsmN2h3fiQ208BEU1Ro_g&oe=69B410EA"}, {"file_name": "sc5.png", "id": "969196391551875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75520131_969196394885208_7115778398273723767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDDnz9ac4PMQ7kNvwHfJUxS&_nc_oc=AdlaT05T7Mt5i0Mm1jF_UqRTltp3AGYUOot7XwvICn88fl0sAoo44bdB5XWTW1ZpaWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwr2s3aFEUUY-m8Asm1sNrihBA1urvrEFvp8fGiZfrpVw&oe=69B4099E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1009902807136482", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031425_1009902810469815_1845567791388563259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX91y3Y8vAsQ7kNvwG9Lbcf&_nc_oc=Adm2HpOsi9DBwoBkc6jggL5zwpBvXHSS9rRI0qf7pr7Ahl7gsQSDE8Bnvx1cdeTt-es&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywtoOJHNEpFivdn2vol_q_89ihqGMVBWg4wdYTaIlyXw&oe=69B3ECE4"}, "display_name": "Green Zone", "keywords": ["defense", "Zombie", "Shooter", "Survival", "Action"], "long_description": "Immerse yourself in a post-apocalyptic world filled with toxic zombies in this thrilling Meta Quest game. Players must navigate through a variety of environments, each presenting unique challenges and threats. Equip yourself with a diverse array of weapons, from firearms to explosives, and strategically place mines and barriers to fortify defenses. As you progress, you'll need to defend cities from waves of relentless zombies, using every tool and tactic at your disposal. Master the art of survival, adapt to changing scenarios, and unlock new levels and equipment to enhance your fighting capabilities. This intense VR experience not only tests your combat skills but also your ability to strategize under pressure. Prepare for an adrenaline-pumping adventure that keeps you on the edge of your seat!", "short_description": "Survive amidst toxic zombies in diverse locations in this new Meta Quest game! Defend cities using an arsenal of weapons, mines, and barriers. Discover unique tactics and strategies to fight for your life!"}]}, "developer_name": "Bexzod Abdubekov", "developer_privacy_policy_url": "https://www.facebook.com/permalink.php?story_fbid=122108972456316995&id=61559509877826", "developer_terms_of_service_url": null, "publisher_name": "Bexzod Abdubekov", "support_website_url": null, "website_url": "https://www.facebook.com/61559509877826/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9807585509351482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1640617176520941_2891858986587112468_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glEFLU4bhDcQ7kNvwHRIC-X&_nc_oc=AdnXFnZR6EHrRTBVX3-yIQn0BFvNiuFeMFgghZrze-15KFf0iu9
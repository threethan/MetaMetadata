dKXi8FNw&oe=69A5903E"}, {"file_name": "original.png", "id": "1517401266424936", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820887_1517401269758269_6659666410252407508_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AfnZlyUtY8Q7kNvwGfbOFG&_nc_oc=Adl9cl4dot3IviL1m9acTYG3huPVtCcijOO7ohROulrh_bUp0vvsmELV6c2Sz3j57B0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuU3XmGFDuGz7foVT9SHmRGgDTSKRiNxa8KRggt8rH9zg&oe=69A58A40"}, {"file_name": "original (5).png", "id": "1989644131988053", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825257_1989644135321386_4088586968039819422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1m_IH1IQSUQ7kNvwGhUhXZ&_nc_oc=AdnvDN_AacrCem0vX5oYLeP3FknqZzr-26x_Y5I1EtEnAspvz2sAz1rcvm4dVWfr5Z0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvd__lQ2gr0uKz3N2-njuzjurtYd1-duwQdJlVg33XB7w&oe=69A58165"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anaglyf", "keywords": [], "long_description": "Watch, create, and share **spatial photos and videos**. Capture the world using Quest cameras, apply AI effects to your photos, and explore immersive content from creators around the world.\n\n## Watch & Experience\nView spatial media in true 3D. Some videos include **interactive elements** like butterflies, cats, finger ring and more on your hands that bring scenes to life.\n\n## Capture in 3D\n- Record **spatial videos**\n- Take **spatial photos**\n- Instantly view them with real depth\n\n## AI Effects\nAdd **snow, floor is lava**, and other visual effects to your spatial photos while preserving true 3D depth.\n\n## Hands-Only Control\nUse **full hand tracking** with micro-gestures and natural poses, including \ud83d\udc4d to like content.\n\n## Horizon Store\nSpatial gameplay experiences can link directly to the Horizon Store so you can jump in and try them.\n\n**Media isn\u2019t flat anymore. Step inside Anaglyf.**\n", "short_description": "Anaglyf lets you watch, capture, and share spatial photos and videos in true 3D. Record with Quest cameras, enhance photos with AI effects like snow or lava, and explore immersive content with interactive elements such as butterflies and web shooters. Use full hand tracking to navigate and like content."}]}, "developer_name": "Meteoric", "developer_privacy_policy_url": "https://anaglyf.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric", "support_website_url": null, "website_url": "https://anaglyf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25463812259980330"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031612_941003424177898_5294895046064330407_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRhKfRO5e4kQ7kNvwHzds02&_nc_oc=Adlf48p1PRuLvil1ZU9Y8ozzygjlr3AhlQJHGT-GytaDhfazIDi9NFpaTiKiMPqHQW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu8nknIgZGu6bHpJrWI_nHm5shg-eqQXAwF_i2mvA61Bg&oe=69A57F5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anaglyf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1716458118, "lastRevision": {"nodes": [{"id": "7450414158413416", "rele
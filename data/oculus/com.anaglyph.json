jrTSC-8H9iLL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2-jXE5lmgYslIrrdnUyS3vGMSep5mVHkGGMkvJ9fQqw&oe=6AF0B0FE"}, {"file_name": "original.png", "id": "1517401266424936", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820887_1517401269758269_6659666410252407508_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLMrX8oItUwQ7kNvwEzvFag&_nc_oc=AdrV_4kuQtw8-VwRgqAFn6TRGK1SxtjDtl_qiUyxPI5J5-Q5PnbljvsTSeYV7IHJZxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2NdzANC8h6XVFFJRxfLqB2bTdJhUuTcnB8VkoFYQbJA&oe=6AF0AB00"}, {"file_name": "original (5).png", "id": "1989644131988053", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1989644135321386_4088586968039819422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSNRxWup56kQ7kNvwEVAmZ5&_nc_oc=AdrLn_lm5nwoF64sBWJ55Drdgcq0jeGQApfx298p137gc7yo7GgHLwSMhK_42v0nrYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDs7CKeQxJ9Cw2wokXpunpilCCyP7QYIvJUJYuFfSAuQ&oe=6AF0A225"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anaglyf", "keywords": [], "long_description": "Watch, create, and share **spatial photos and videos**. Capture the world using Quest cameras, apply AI effects to your photos, and explore immersive content from creators around the world.\n\n## Watch & Experience\nView spatial media in true 3D. Some videos include **interactive elements** like butterflies, cats, finger ring and more on your hands that bring scenes to life.\n\n## Capture in 3D\n- Record **spatial videos**\n- Take **spatial photos**\n- Instantly view them with real depth\n\n## AI Effects\nAdd **snow, floor is lava**, and other visual effects to your spatial photos while preserving true 3D depth.\n\n## Hands-Only Control\nUse **full hand tracking** with micro-gestures and natural poses, including \ud83d\udc4d to like content.\n\n## Horizon Store\nSpatial gameplay experiences can link directly to the Horizon Store so you can jump in and try them.\n\n**Media isn\u2019t flat anymore. Step inside Anaglyf.**\n", "short_description": "Anaglyf lets you watch, capture, and share spatial photos and videos in true 3D. Record with Quest cameras, enhance photos with AI effects like snow or lava, and explore immersive content with interactive elements such as butterflies and web shooters. Use full hand tracking to navigate and like content."}]}, "developer_name": "Meteoric", "developer_privacy_policy_url": "https://anaglyf.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric", "support_website_url": null, "website_url": "https://anaglyf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25463812259980330"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031612_941003424177898_5294895046064330407_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BLMLfF9HjwQ7kNvwHtAl9M&_nc_oc=AdrzA54PLG6VnfgxikceD27Wwrx8c7BBlGr5RVelRAkTq7nr2e5OMoy7C9dIsCgdtig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo6V5gj6nufIGWjkvMiVr8MuD2J5-NYph1Ong2aCXtSA&oe=6AF0A01B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anaglyf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "
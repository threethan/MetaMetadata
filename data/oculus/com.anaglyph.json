culuscdn.com/v/t64.5771-25/491827646_3103704083135040_2619595680216165995_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND-hRCJ_fGAQ7kNvwFK_s_Y&_nc_oc=AdrKlzAmG_umQM7NV7t_jEHgja3amlpFZY2xJMZHWPJ-R6OWB96wV7uz5M0J5C2IR34&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_Kmfv2h8LywXBniGufwdsGI8f3BTEIC_8R4fMrQ68lA&oe=6B0B0EFE"}, {"file_name": "original.png", "id": "1517401266424936", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820887_1517401269758269_6659666410252407508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exXwZWekzDIQ7kNvwFdE-KF&_nc_oc=AdrHSVw2IUWJ8XcN-X_5lsTXkqgj8I_u_U-o-NI9lLWazHB3-bFsRolo5i3U6m97iec&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9G4Qlu3gQ4Mq_7nAqWdRjoQ6Sb4EPESsd5E-1ARjQEg&oe=6B0B4140"}, {"file_name": "original (5).png", "id": "1989644131988053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825257_1989644135321386_4088586968039819422_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY-_5EBOzEEQ7kNvwF-aTzl&_nc_oc=Adqo3dpV38zhs5Fdjdtr10FS4IitV0Rv6X5o3CQgvVMW0N2bNsl1Wt1HRbjKUz7IHIU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0nNMHX31iQIOjZQ5n30vr9vBxxeyYt8-F50_kec8vDA&oe=6B0B3865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anaglyf", "keywords": [], "long_description": "Watch, create, and share **spatial photos and videos**. Capture the world using Quest cameras, apply AI effects to your photos, and explore immersive content from creators around the world.\n\n## Watch & Experience\nView spatial media in true 3D. Some videos include **interactive elements** like butterflies, cats, finger ring and more on your hands that bring scenes to life.\n\n## Capture in 3D\n- Record **spatial videos**\n- Take **spatial photos**\n- Instantly view them with real depth\n\n## AI Effects\nAdd **snow, floor is lava**, and other visual effects to your spatial photos while preserving true 3D depth.\n\n## Hands-Only Control\nUse **full hand tracking** with micro-gestures and natural poses, including \ud83d\udc4d to like content.\n\n## Horizon Store\nSpatial gameplay experiences can link directly to the Horizon Store so you can jump in and try them.\n\n**Media isn\u2019t flat anymore. Step inside Anaglyf.**\n", "short_description": "Anaglyf lets you watch, capture, and share spatial photos and videos in true 3D. Record with Quest cameras, enhance photos with AI effects like snow or lava, and explore immersive content with interactive elements such as butterflies and web shooters. Use full hand tracking to navigate and like content."}]}, "developer_name": "Meteoric", "developer_privacy_policy_url": "https://anaglyf.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteoric", "support_website_url": null, "website_url": "https://anaglyf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25463812259980330"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031612_941003424177898_5294895046064330407_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQuublfBMcYQ7kNvwGBZwSG&_nc_oc=Adqx_XBe6SRfUSwyikA0IDvfgBOsaCjn78mmBKSGtuevB8zlaGj_eAITFZRrMkYfCEs&_nc_zt=3&_nc_ht=
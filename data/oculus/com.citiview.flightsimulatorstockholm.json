content-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3lJLudQOKDdsaeVZmCjYIIpaJcEnISOpZ8LjETu83LQ&oe=6AFC64AD"}, {"file_name": "screenshot_3.png", "id": "4814000495488832", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_4814000502155498_7490442064714475409_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9xQ9sGAqhUQ7kNvwHhbwIs&_nc_oc=AdpIxRE9kQVxYC7l9VPk0oNgN2zMtBMJ3WL8kldUqkv58yIA-_I1iqoWVaSkp9F54ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxvGvZ4hi6EkjEQVv41mLLQpoDUyrhc6l1O2rKT7bacg&oe=6AFC86FE"}, {"file_name": "screenshot_4.png", "id": "1053433604396910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1053433607730243_7541746074981695678_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmoAtMGFKXUQ7kNvwGzdKZX&_nc_oc=AdqsVtj-eF1RmtO_aN7jzmV9V0WB8SP299MVwBJKryIyt9hAz_uR4lhfHyBae77pPo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeUqht2Riz7fTPcAziZBlyELTaoWGxitpwdxVpvAqp_g&oe=6AFC91FC"}, {"file_name": "screenshot_5.png", "id": "1013175891783033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1013175895116366_1830304667567584961_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et8lJeVp0jQQ7kNvwEChuXM&_nc_oc=AdoUnpgCBHJSGPnEpZ8UAoXKlOwAIhLNdNB_sjMXvf36A02Ww22sB-jfc4Ue87OrkAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4DLIghQfBsDuSCCMMsOQH5iNwtwtBKBTMHDa0dD9qWg&oe=6AFC83CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4868657113420585", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823296_4868657116753918_2242665747314422664_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaNkM7Zq2sAQ7kNvwF5lv0e&_nc_oc=AdpMcLb-QufmcMjZm--qeI2Rp52QhsyZZ1T7b4IfDaYvqps4efE6eXmFELkTeBzIxi8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSADAexmZQpA7tuSEfCKAgFipE91Sq_YdIzVN9Vjezeyw&oe=6AFC71A7"}, "display_name": "Flight Simulator Stockholm", "keywords": ["flight", "simulator", "stockholm", "jet", "pilot"], "long_description": "Flight Simulator Stockholm puts you in the captain's seat over the real Stockholm.\n\nTHE REAL STOCKHOLM\nReal satellite, elevation and map data: Gamla stan, the Royal Palace, Stadshuset's three crowns, Katarinahissen, the Hotorget towers, Globen, Kaknastornet, Grona Lund, the Vasa Museum, Drottningholm, Vaxholm Fortress, Sigtuna, Skokloster and Uppsala. Arlanda with all three runways, Bromma and Uppsala Arna.\n\nTHE ARCHIPELAGO\nThousands of real islands from Vaxholm to Grinda and Ljustero, the Finland ferries in the ship lane, Waxholmsbolaget's boats, yachts on Lake Malaren and the fjards.\n\nA LIVING CITY\nCommuter trains and the green tunnelbana on their real tracks, the Djurgarden ferries on Saltsjon, cars on the real roads. At night the city lights up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND SWEDISH\nSwitch every menu between English and Swedish in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on Saltsjon, the Royal Palace and Gamla stan out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nELEVEN MISSIONS\nThe Bromma city approach, the Malaren and Saltsjon run, through the archipelago, Uppsala and the castles, a fighter scramble from Arna, Stockholm by night and a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Stockholm, built from real satellite and map data: Gamla stan and the Royal Palace, Stadshuset, Globen, Kaknastornet, Drottningholm, Vaxholm and the islands of the archipelago, Uppsala's cathedral. Start in your own glass hangar on Saltsjon, talk to air traffic control and land at Arlanda, Bromma and Uppsala Arna. English and Swedish menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorstockholm/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorstockholm/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288788017660504"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1582860963078519"}]}, "baseline_offer": {"id": "1582860963078519"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791915300, "status": "PUBLISHED", "id": "1582860963078519"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1288839894321983", "version": "1.0.0"}, "id": "1857442421916734", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1288788007660505", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1288839894321983"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
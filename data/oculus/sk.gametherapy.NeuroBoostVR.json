0a&_nc_ohc=cFlhGNRy0SAQ7kNvwH125y3&_nc_oc=Adqsy0rfBSprc_0VQzAZtF9aW4kdeulk9QuGnoFqiGZ0dPZiU87KH0L8EaHsp3ZYq2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS_XtfnYx6JbamSFNJraNE0_IlaFUzAKg1FKGPETcMRg&oe=6ABFB5A4"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-KIf1R1w9kQ7kNvwGyY2eF&_nc_oc=AdqX0Jqy9y5wuOuiVpKKwtHL06ftmMPz2gEbz6inocDaju92UCNj8o78TTiVswCiScA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqu95EUvk9pCztaLnGfLqol6Idy_Khrfp7knKne7Dk0Q&oe=6ABFA88B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjIw5JasSloQ7kNvwHMsVrB&_nc_oc=AdqH7Yo7XfRoFHNFP9xR4P49kSTLflT0ZkuJ3q-X0VOdV2YazCHl8EwvKBCSVmNgroo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuNfjjbCG6DJe7yFXAFzBA9X8rnNakZMA8pJUM5Ko5oQ&oe=6ABFAE68"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXdSWVLMDBEQ7kNvwFMyatw&_nc_oc=Adqc_VUGEZCPgo8rbyBeVEp5XP8TnGgs7oEHzPO8TCQjGlZUSbHc9cv4sJwWorCsKDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNd0ePcOSy5NhqPaZa6WEBWyjFJ63RBjsN83w2q53iow&oe=6ABFD482"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/assets/docu/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "GAMETHERAPY", "support_website_url": null, "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
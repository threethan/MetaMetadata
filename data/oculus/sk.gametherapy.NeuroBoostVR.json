ohc=YapVwedsDiAQ7kNvwGHEAWK&_nc_oc=AdrWpI7p11uCmZb4_codGM8iMnVmzX8GBiziy_zSwmYBc1H3MqF90dzWfOYeF2vJFm0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6SKGak1f3DLxBzBVINiZZdLR6swNZFF3q4cEb1gruCw&oe=6A8EEE24"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjuAA0jS2yUQ7kNvwGXJPNT&_nc_oc=AdohvCIoSxjyKyq-QWP8NB02BRJbfGVttnIN5ZPFoUtw340TfJ-REJBRuMolUf4n3Bw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2Y_NbfQ68khPpX06o_YqNbI0uAV8sfqQop7o2p5lsZg&oe=6A8EE10B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bxgd7_h3osQ7kNvwHKRV2K&_nc_oc=AdrvSghlza03WrLovuj-aPHCvRlvUayI66Qy_bEPX9BTWWF27xJrGJoYtTo3NmnveAU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEovr3YgYMpkTgkZKqW1Dp0QipcxMhpDTcN9CGJn_Wiog&oe=6A8EE6E8"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTjeUFcMnxIQ7kNvwEHdJcR&_nc_oc=Adql_H7TuwnAsHiEBPWs6fxQdlBy2kMneon3dYc5mgRr-zCcYKJiXsOZQm9T9LMkeN0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzhBnRiiIEqj7_mfxRe15mLl5TDnZsKlix_HuFMYPycQ&oe=6A8ED4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3904383223142599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031599_3904383226475932_4757459093719000904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8caPebo3OIQ7kNvwHrmN7a&_nc_oc=AdpBFJoofCVSKFr9c4-zZbSTNv0LR8l9Ftfw_D7Yerh9rEVLd4KOFR5XXbWeUsY3gjE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKBqkxOMBnsARlJ4RbyLyxyQMg682gI9grexrZkrEumA&oe=6A8EECBB"}, "display_name": "NeuroBoostVR", "keywords": ["Wellness", "Exercise", "Training", "Rehabilitation", "BalanceEnhancement"], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}, {"images": {"nodes": []}, "id": "630866979708520", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83c\udf08 Pre\u010do NeuroBoostVR? \n\u2705 Denn\u00e1 rutina v novom svete: Cvi\u010dte mozog a nervov\u00fd syst\u00e9m v z\u00e1bavn\u00fdch \u00faloh\u00e1ch a cvi\u010deniach. \n\u2705 Personalizovan\u00e9 tr\u00e9ningy: Vyberte cvi\u010denia pre motoriku, rovnov\u00e1hu a orient\u00e1ciu. \n\u2705 Z\u00e1bava v ka\u017edej \u00falohe: Chy\u0165te mot\u00fdle, otvorte trezor, cho\u010fte po moste a in\u00e9 \u00falohy pre rados\u0165 z ka\u017edodenn\u00fdch aktiv\u00edt.\n\n\ud83c\udf0d Presu\u0148te svet do virtu\u00e1lnej reality: S NeuroBoostVR cvi\u010d\u00edte doma s fyzickou a ment\u00e1lnou stimul\u00e1ciou. \n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n\n\ud83d\udca1 Vst\u00fapte do sveta inov\u00e1ci\u00ed s NeuroBoostVR! Stiahnite si na Oculus Quest pre nov\u00fd rozmer cvi\u010denia! \ud83d\udd25", "short_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAME
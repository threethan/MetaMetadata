scdn.com/v/t64.5771-25/39035434_1707421723070862_1881570540579653944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3VOveEAVeAQ7kNvwGqXot3&_nc_oc=AdrGlSMtFcwInCtnrvvNlqXpv-2K4rla_Oc3pN9boN2AoXYskZOF-IlYDTjFnPa0XF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyw6M7l1rY6nKKns69RXN0DFxZy9s_zl1IU0KpOOdSRQ&oe=6AE0AB24"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5hpgkvjvEYQ7kNvwF2oOpW&_nc_oc=AdrldWVFAPfwvzL1cZ883h5vGoXZAGMA8lqylUDcCQMaSpBj1XhkSgYh5VsIQHpSCSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9xsF8shRjRYYHaZD_6lNCR54_Ad-qeNx1EtpqOTlX_Q&oe=6AE09E0B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHRtwdUgO-4Q7kNvwGSErv3&_nc_oc=AdrJjN_6qQ9glOLAikL4HiLG6hXWLALgLvZ_obI_YvkvNBNGhcJjggKuWQW63XxTj3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw4X7PB7DjXLSmHrRKYhYU3i28-C8Vs1kL7xt2Rqg7cg&oe=6AE0A3E8"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwGbhM7lMtUQ7kNvwF_VIDp&_nc_oc=Adp27WtfjyurJsMInSCnmww7iklcvaPjXqTtch5Fh5lx2ATvvVgKma1YXf8HLqzMHQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeynATzdTX85ty4Li3Je-LMsgE9NCLRf60-oBlS-nkqQ&oe=6AE0CA02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3904383223142599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031599_3904383226475932_4757459093719000904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9hFAipLh4MQ7kNvwEQo7fs&_nc_oc=AdrRhF63WOFEOTDkeaknDuXOl9pzcrvJnFAHpjmWuJ3b0XD8QX6IUuyZ20XDmwr2TP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeuphypEgRtVg_KHwwEmA8PYRGD5UNLU7z6a-hbl8jMA&oe=6AE0A9BB"}, "display_name": "NeuroBoostVR", "keywords": ["Wellness", "Exercise", "Training", "Rehabilitation", "BalanceEnhancement"], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}, {"images": {"nodes": []}, "id": "630866979708520", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83c\udf08 Pre\u010do NeuroBoostVR? \n\u2705 Denn\u00e1 rutina v novom svete: Cvi\u010dte mozog a nervov\u00fd syst\u00e9m v z\u00e1bavn\u00fdch \u00faloh\u00e1ch a cvi\u010deniach. \n\u2705 Personalizovan\u00e9 tr\u00e9ningy: Vyberte cvi\u010denia pre motoriku, rovnov\u00e1hu a orient\u00e1ciu. \n\u2705 Z\u00e1bava v ka\u017edej \u00falohe: Chy\u0165te mot\u00fdle, otvorte trezor, cho\u010fte po moste a in\u00e9 \u00falohy pre rados\u0165 z ka\u017edodenn\u00fdch aktiv\u00edt.\n\n\ud83c\udf0d Presu\u0148te svet do virtu\u00e1lnej reality: S NeuroBoostVR cvi\u010d\u00edte doma s fyzickou a ment\u00e1lnou stimul\u00e1ciou. \n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n\n\ud83d\udca1 Vst\u00fapte do sveta inov\u00e1ci\u00ed s NeuroBoostVR! Stiahnite si na Oculus Quest pre nov\u00fd rozmer cvi\u010denia! \ud83d\udd25", "short_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/p
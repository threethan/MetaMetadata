dMNJrmKgfc9mTAY0WLbfl1xz3kMMtQn2RAAB7AMm8Q&oe=69BFF2A4"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIZUjk6vOQoQ7kNvwFDVQsi&_nc_oc=AdmJfvlm96OOhQOXlTA0xU9ogxzAMA5Bhk1xJZquUC8kckFPNjOCembTCZ7a7q2T_ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyE_n8ZSm6I4yzXtiSbgj4lNp9bY_7zDUDWtKxA3dniUQ&oe=69BFE58B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcpN49IESLUQ7kNvwHDUZ4y&_nc_oc=AdnWUJE709qjMToZUc8LDpCYKhJtpIcC5GU88WFCFH5KNuuXBOFDhtXS0mNUh3G0V_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWzqANmcjp7GNm3eJQeI0GyWQT_6arjdVvb1eLdujlHA&oe=69BFEB68"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IZ1nkY82TUQ7kNvwF2sJUe&_nc_oc=Adnf2O_p3jtz_iPBvSB7BX93SQrbggjlpzJ7Qe_nGKfWTpTyHG2S_bo5Ej1YpzPMlvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyI4F5vj1PXomVLxQKrG8XhrbwdyAGIg04Rtr5KkRgSbQ&oe=69BFD942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3904383223142599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031599_3904383226475932_4757459093719000904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX1ygF_IOPAQ7kNvwF_gUo7&_nc_oc=AdkQ1nxmxxD1dbwBGHhoTUmN90yn6NyWXtxR8klXj9R5VeTKZnAISh-ZqDGA-AExuuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMb9f_wjWcUTefcPqOzg2xcOlr9DqML1aN-w6AKO8Phg&oe=69BFF13B"}, "display_name": "NeuroBoostVR", "keywords": ["Wellness", "Exercise", "Training", "Rehabilitation", "BalanceEnhancement"], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}, {"images": {"nodes": []}, "id": "630866979708520", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83c\udf08 Pre\u010do NeuroBoostVR? \n\u2705 Denn\u00e1 rutina v novom svete: Cvi\u010dte mozog a nervov\u00fd syst\u00e9m v z\u00e1bavn\u00fdch \u00faloh\u00e1ch a cvi\u010deniach. \n\u2705 Personalizovan\u00e9 tr\u00e9ningy: Vyberte cvi\u010denia pre motoriku, rovnov\u00e1hu a orient\u00e1ciu. \n\u2705 Z\u00e1bava v ka\u017edej \u00falohe: Chy\u0165te mot\u00fdle, otvorte trezor, cho\u010fte po moste a in\u00e9 \u00falohy pre rados\u0165 z ka\u017edodenn\u00fdch aktiv\u00edt.\n\n\ud83c\udf0d Presu\u0148te svet do virtu\u00e1lnej reality: S NeuroBoostVR cvi\u010d\u00edte doma s fyzickou a ment\u00e1lnou stimul\u00e1ciou. \n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n\n\ud83d\udca1 Vst\u00fapte do sveta inov\u00e1ci\u00ed s NeuroBoostVR! Stiahnite si na Oculus Quest pre nov\u00fd rozmer cvi\u010denia! \ud83d\udd25", "short_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY", "support_website_url": "https://gametherapy.eu/contact-us", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8841151742655383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982453_914639510089109_4964949883562545877_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA4orSzjP9MQ7kNvwGiaHXb&_nc_oc=AdnGDBK9WCRjMsIczL9t6WwWcAGpySejW0bbUm2rJRoFN-Vdiy5Jhc9z0SY1sW2BWVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0Ie60Jy1e-8DSW6a42VvAu4_CKvaSpElWz1zwhszTtQ&oe=69BFE4EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NeuroBoostVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1703107418, "lastRevision": {"nodes": [{"id": "6244256012344982", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6244255969011653", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "738161194347912"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1074030017069025", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83c\udf08 Pre\u010do NeuroBoostVR? \n\u2705 Denn\u00e1 rutina v novom svete: Cvi\u010dte mozog a nervov\u00fd syst\u00e9m v z\u00e1bavn\u00fdch \u00faloh\u00e1ch a cvi\u010deniach. \n\u2705 Personalizovan\u00e9 tr\u00e9ningy: Vyberte cvi\u010denia pre motoriku, rovnov\u00e1hu a orient\u00e1ciu. \n\u2705 Z\u00e1bava v ka\u017edej \u00falohe: Chy\u0165te mot\u00fdle, otvorte trezor, cho\u010fte po moste a in\u00e9 \u00falohy pre rados\u0165 z ka\u017edodenn\u00fdch aktiv\u00edt.\n\n\ud83c\udf0d Presu\u0148te svet do virtu\u00e1lnej reality: S NeuroBoostVR cvi\u010d\u00edte doma s fyzickou a ment\u00e1lnou stimul\u00e1ciou. \n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n\n\ud83d\udca1 Vst\u00fapte do sveta inov\u00e1ci\u00ed s NeuroBoostVR! Stiahnite si na Oculus Quest pre nov\u00fd rozmer cvi\u010denia! \ud83d\udd25", "short_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n"}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3715489735443944", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223475_3715489738777277_6725514994967281094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSGTJy
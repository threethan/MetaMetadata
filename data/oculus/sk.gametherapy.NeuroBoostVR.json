scdn.com/v/t64.5771-25/39035434_1707421723070862_1881570540579653944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6a0VejIJj8Q7kNvwE9bHAa&_nc_oc=AdreG3BmM5oqwtJod7XJ0Wb625JJlkzefC133o5Bfb4O-3rr6UNimEd0UIGpO5dn5BA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX1IyO3vDX5P_5Gg37iH0XngFHSuhNnuFH2eR4J4pYdA&oe=6AF206E4"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILib1Ye1K-IQ7kNvwH8DmEM&_nc_oc=AdrAqXuJsNXxXToF0v5GjnxhIofqgqI5Q_FIt2l8whpcnNRkOJgGyuJD24FFLmJp4mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDHHB1gemfhhDLUFhuo-iyPddPTy7OIvZloWq72fHfSw&oe=6AF1F9CB"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRdZia3BNPQQ7kNvwHg9UE4&_nc_oc=Adq-noRr-DtB9xYnAVXzhh9FPaVX037CBSNzjgz5t8_lqZcqWT2Ngus2gQEoAR592x8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWKUPHt9O0yhZXtBz-r3mT36s1vsx9X22LlfpSXLbScQ&oe=6AF1FFA8"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4NOdsGM95sQ7kNvwHJJ3LB&_nc_oc=AdohC7oW7yncZAMvHu3xZonDppHN-woCDwGrZGiW4MF7MquElLuWfVtZP_BsV3oRaak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjy5hQzxNsdaaOGAgt7DTL41c5fkMgbSh04Z1dgDsttA&oe=6AF1ED82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "3904383223142599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031599_3904383226475932_4757459093719000904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s4iYEJiLRYQ7kNvwGfro3z&_nc_oc=AdoGgd9ylCc0_5AlxUYhTE1s0oqIckkGFaxe2C86XkrdH1ZsDkQkl3bNDb_7r-c6e5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz8Mx2vU23D5Yd0YjtlGvstGnA9AoJLnOkMzu1uSiNhQ&oe=6AF2057B"}, "display_name": "NeuroBoostVR", "keywords": ["Wellness", "Exercise", "Training", "Rehabilitation", "BalanceEnhancement"], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}, {"images": {"nodes": []}, "id": "630866979708520", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83c\udf08 Pre\u010do NeuroBoostVR? \n\u2705 Denn\u00e1 rutina v novom svete: Cvi\u010dte mozog a nervov\u00fd syst\u00e9m v z\u00e1bavn\u00fdch \u00faloh\u00e1ch a cvi\u010deniach. \n\u2705 Personalizovan\u00e9 tr\u00e9ningy: Vyberte cvi\u010denia pre motoriku, rovnov\u00e1hu a orient\u00e1ciu. \n\u2705 Z\u00e1bava v ka\u017edej \u00falohe: Chy\u0165te mot\u00fdle, otvorte trezor, cho\u010fte po moste a in\u00e9 \u00falohy pre rados\u0165 z ka\u017edodenn\u00fdch aktiv\u00edt.\n\n\ud83c\udf0d Presu\u0148te svet do virtu\u00e1lnej reality: S NeuroBoostVR cvi\u010d\u00edte doma s fyzickou a ment\u00e1lnou stimul\u00e1ciou. \n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n\n\ud83d\udca1 Vst\u00fapte do sveta inov\u00e1ci\u00ed s NeuroBoostVR! Stiahnite si na Oculus Quest pre nov\u00fd rozmer cvi\u010denia! \ud83d\udd25", "short_description": "\ud83d\ude80 Zv\u00fd\u0161te \u017eivotn\u00fd \u0161t\u00fdl s NeuroBoostVR! \n\n\ud83e\udde0 Pre akt\u00edvny mozog a inovat\u00edvne cvi\u010denie je tu NeuroBoostVR! Virtu\u00e1lna realita pre Oculus Quest vylep\u0161uje jemn\u00fa motoriku, rovnov\u00e1hu a orient\u00e1ciu.\n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd Pre seniorov s neurologick\u00fdmi probl\u00e9my: NeuroBoostVR zlep\u0161uje denn\u00e9 zru\u010dnosti v virtu\u00e1lnej realite.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/p
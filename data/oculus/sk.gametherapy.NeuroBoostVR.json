&_nc_sid=6e7a0a&_nc_ohc=4Ba4xxWwidMQ7kNvwHF1aWK&_nc_oc=Adq_JCIe5NwdLjLkanu5RtWllVsdncJLlTFZXwNxfjyOO41-iLVND6mMoO4oNJ4A0oU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK11_qJqcWW6sqbexJoQJ1btgaj3Qbxa-oVLptlKUpJPw&oe=6AA94C24"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uww9STKLHRsQ7kNvwE53XoZ&_nc_oc=Adq2CQhFLgusFEazBcZBrMDLpou1dXdjlguDGqAuIVnKyU-YO-WIQjQ3CsFcBkjPPGw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9u04aYZhEO_Fpo2kgV7MnfZea131-SrSlZaFcLoLJ6w&oe=6AA93F0B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okOuBg57z3MQ7kNvwH3qFwD&_nc_oc=AdpKKlh6MZjoCgB3OhQEvZj0_oWfegqLysOeuy9x3issMw51CZTgYjK7U7leNMUdVDo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0g-hfv3BbiQYuPwo5T8yPYnmEnYBIQXNSMwCyqCGTAw&oe=6AA944E8"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1q9BHnZiT8Q7kNvwHj3Nlj&_nc_oc=Adp-E4gC6vIDMsgxwOb-R_Cf92looxVgT8n69fzYRrZEvKYGayMeJIUd8YBwWnkrEZo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm3C4wcezzhfSt0Pxr2P64FJYrvPPI7YxM5gHklzXM0w&oe=6AA96B02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/assets/docu/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "GAMETHERAPY", "support_website_url": null, "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "r
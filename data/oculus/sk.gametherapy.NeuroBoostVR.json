0a&_nc_ohc=0isCb67Gh4wQ7kNvwGWp9TD&_nc_oc=Adp6pvCBE575Ja9FqlgCgenoaEuFrJOdqupYeisfPEIHrgmuwsx1V30aHg7409_nXhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L28ipvfNf779vnLPFAHe5irDIdkD7mwpsgApuNOoirw&oe=6A2D5F24"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzpmPFNBPd8Q7kNvwESCRPX&_nc_oc=AdqOVO_47YUjJc1wTH1uXor3bClPGEjxizQYwxfEYNpPDn0ZSCgojJrLPACVXta8ZzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98EYL3YRbOfL6FXP9W9txzC7YeIFb2wUwEO6gZOoJQKA&oe=6A2D520B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJHbmZGbQFcQ7kNvwFKXnrc&_nc_oc=Ado5Re4I0HJy9k-2lbqerLL_V94f4xYnJNFuFDQu18iBNYvEvWp11po0DgndIkm6ml0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XmU1gt3OIUW1N51NWHo-aXmCcBy1n2mFigZWmFKFgQA&oe=6A2D57E8"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_JJB29BXFAQ7kNvwEO3nK2&_nc_oc=AdoheQBXYVaGgFUfNt48_vJe8vrbutoUOtdvsR60l3AxFfd6DOHeMk4ZNR1NaZQdk8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MkWXC3U7oYz9A2CJfo8MP9Lh6fhpwQGviYpM9j_ujxw&oe=6A2D7E02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/assets/docu/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "GAMETHERAPY", "support_website_url": null, "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
0a&_nc_ohc=DeXsgXUQvv4Q7kNvwHF4TN4&_nc_oc=AdoKMpxERx4sWuRbeLAcmpxHOEh_V_v-aS-oPhlwkDZeU3Mokg4D7EidMYqJ2BasFmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIANKuLUE1TdZD3W6xoiOorZcia38yJ08MMKZjsUp0xEA&oe=6AA2B4A4"}, {"file_name": "HighresScreenshot00002_cr.png", "id": "656378790033982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_656378793367315_5326444234208413663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_D3zqtLk4EQ7kNvwGOZSG6&_nc_oc=AdrH4qJIKBH30j3rmWQPf7a9DeKSstNrfMM740rjFWS2b5X03nbtKeu5Jtq88x1QMuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBUR-Sr-49uRSc1b_Npb70UtBkkYrrcj-bpZLm2MS9fQ&oe=6AA2A78B"}, {"file_name": "HighresScreenshot00003_cr.png", "id": "373511228509371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575362_373511231842704_987523795937543327_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rftEkgY6WEcQ7kNvwFXenPL&_nc_oc=AdrAHN4PA435D2TofEWb2pNcegm7cY5TtcoXzvsf6pJcru96N_ZNQIr9xhbk7aDmI4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxCtU_u2ilyV_b23NmntzdP8LACPJrA8N0i19ndVuSmA&oe=6AA2AD68"}, {"file_name": "HighresScreenshot00005_cr.png", "id": "907397567493320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_907397570826653_5134560045346274448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD7EdpuB0iEQ7kNvwH3o1af&_nc_oc=AdrP7zb0wW3bU1BjjcLk0guJJLkMvP4fC9j6PuVu06ZN-Z9xTXUaBs0hneQsd-staRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXCLLu1xXckxKWUav3FOHM8IfqQylhE3Tc_IHIp43G-w&oe=6AA2D382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NeuroBoostVR", "keywords": [], "long_description": "\ud83d\ude80 Elevate Your Lifestyle with NeuroBoostVR! \n\n\ud83e\udde0 Whether you're a senior keeping your brain active or craving innovative exercise, NeuroBoostVR is here! Our Oculus Quest app improves motor skills, balance, and spatial orientation.\n\n\ud83c\udf08 Why NeuroBoostVR? \n\n\u2705 Daily routine in a new world: Fun tasks and exercises in a virtual environment. \n\u2705 Personalized workouts: Choose exercises for motor skills, balance, and orientation. \n\u2705 Fun in every task: Catch butterflies, open a safe, walk on a bridge, and more!\n\n\ud83c\udf0d Move your world into VR: Exercise at home with physical and mental stimulation. \n\n\ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR enhances life, helping exercise brains and daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Create your wellness program in our virtual world supporting a healthy lifestyle. \n\ud83d\udd25 Download NeuroBoostVR on Oculus Quest for a new dimension of exercise!", "short_description": "\ud83d\ude80 Elevate Life with NeuroBoostVR! \ud83e\udde0 For seniors or anyone seeking fun, innovative exercise, our Oculus Quest app enhances motor skills and balance.\n\n\ud83c\udf0d VR at Home: Enjoy physical and mental stimulation without leaving home. \ud83d\udc75\ud83c\udffd\ud83d\udc74\ud83c\udffd For seniors and those with neurological issues: NeuroBoostVR improves daily skills in virtual reality.\n\n\ud83d\udca1 Step into innovation with NeuroBoostVR! Download on Oculus Quest for a new dimension of exercise! \ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/assets/docu/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "GAMETHERAPY", "support_website_url": null, "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
k3_PL5W1YPS8borYxhSFG8IaNwdsxzoYJiA&oe=69DB9012"}, {"file_name": "2.png", "id": "916129660810450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_916129664143783_2747247883530245602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xuYzX3OE6wQ7kNvwFGq3DP&_nc_oc=AdptO31zGJrOizVeG9CT5Lh5z2l6ZmLhvZV0Qc9BuUiAFtGuGXe68YID5q6dwbN2Gh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02BeNCK1JpQ4QLA02bT1Z9sWXEF68Kps2qp5hr9Ue9Vw&oe=69DB7F2C"}, {"file_name": "3.png", "id": "1197996755831273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1197996759164606_6079597044734477158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksVxpSP3cfYQ7kNvwGmBcUv&_nc_oc=AdrEgCNl3NQQ7vw0clIYrNWHQLLJNYJ37e0Rd4toS1B9BMFhb6tC4qw0pYpXgmOryYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27eqlNL2ggy6czICLJr-3wSkVq-6iNyyovglo-2o7VAA&oe=69DB9E76"}, {"file_name": "1.png", "id": "1673012287196956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1673012293863622_4700489548991012953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iGqJxz597wQ7kNvwF-HV7K&_nc_oc=Adqxfaa458FGiyf1Cv5f7E0nMx8pG9EpY-Rh-z1fykE5Kd2iEs3C9burN1TuYWw2juM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v4vIve43Bn1Ux3Ad2CEV2wqA5UEgkfjvM_wEREFkC9g&oe=69DBA3C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forklifter Simulator \u2013 Warehouse Driving", "keywords": ["forklifter", "driving", "simulation", "cargo", "warehouse"], "long_description": "Forklifter Simulator \u2013 Warehouse Driving VR puts you in control of powerful forklifts inside detailed warehouse environments. Built for Meta Quest, this VR simulator focuses on realism, precision, and skill-based driving.\n\nOperate forklifts to lift, transport, and stack cargo with realistic physics and smooth VR controls. Each task challenges your accuracy, timing, and spatial awareness as you navigate tight warehouse spaces and handle heavy loads.\n\nFrom basic pallet movement to advanced warehouse logistics, Forklifter Simulator offers an engaging and immersive industrial driving experience. The intuitive control system makes it easy to learn, while increasing difficulty keeps gameplay rewarding and challenging.\n\nPerfect for fans of simulator games, industrial vehicles, and VR driving experiences, this game delivers a satisfying and realistic forklift operation experience in virtual reality.\n\nPut on your headset, take control of the forks, and master the warehouse.\n\n\ud83d\udd11 Key Features\n\ud83d\ude9c Realistic Forklift Driving & Controls\n\ud83d\udce6 Cargo Handling, Loading & Stacking Tasks\n\ud83c\udfed Detailed Warehouse Environments\n\ud83d\udd79\ufe0f Smooth & Comfortable VR Gameplay (Meta Quest Optimized)\n\u2699\ufe0f Realistic Physics & Weight Simulation\n\ud83c\udfaf Precision-based Missions & Challenges\n\ud83e\udde0 Easy Controls with Skill-based Progression", "short_description": "Experience realistic warehouse operations in Forklifter Simulator \u2013 Warehouse Driving VR. Drive and control forklifts in immersive VR, load and unload cargo, stack pallets, and complete precision-based tasks. Designed for Meta Quest, this simulator delivers smooth controls, realistic physics, and hands-on industrial driving gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT",
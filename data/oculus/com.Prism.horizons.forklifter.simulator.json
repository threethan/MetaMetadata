l, "video_trailer_thumbnail": null, "display_name": "Forklifter Simulator \u2013 Warehouse Driving", "keywords": ["forklifter", "driving", "simulation", "cargo", "warehouse"], "long_description": "Forklifter Simulator \u2013 Warehouse Driving VR puts you in control of powerful forklifts inside detailed warehouse environments. Built for Meta Quest, this VR simulator focuses on realism, precision, and skill-based driving.\n\nOperate forklifts to lift, transport, and stack cargo with realistic physics and smooth VR controls. Each task challenges your accuracy, timing, and spatial awareness as you navigate tight warehouse spaces and handle heavy loads.\n\nFrom basic pallet movement to advanced warehouse logistics, Forklifter Simulator offers an engaging and immersive industrial driving experience. The intuitive control system makes it easy to learn, while increasing difficulty keeps gameplay rewarding and challenging.\n\nPerfect for fans of simulator games, industrial vehicles, and VR driving experiences, this game delivers a satisfying and realistic forklift operation experience in virtual reality.\n\nPut on your headset, take control of the forks, and master the warehouse.\n\n\ud83d\udd11 Key Features\n\ud83d\ude9c Realistic Forklift Driving & Controls\n\ud83d\udce6 Cargo Handling, Loading & Stacking Tasks\n\ud83c\udfed Detailed Warehouse Environments\n\ud83d\udd79\ufe0f Smooth & Comfortable VR Gameplay (Meta Quest Optimized)\n\u2699\ufe0f Realistic Physics & Weight Simulation\n\ud83c\udfaf Precision-based Missions & Challenges\n\ud83e\udde0 Easy Controls with Skill-based Progression", "short_description": "Experience realistic warehouse operations in Forklifter Simulator \u2013 Warehouse Driving VR. Drive and control forklifts in immersive VR, load and unload cargo, stack pallets, and complete precision-based tasks. Designed for Meta Quest, this simulator delivers smooth controls, realistic physics, and hands-on industrial driving gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25759976090318919"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_2115111515987221_1636371523897701435_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sh-VPjGudtAQ7kNvwHFVu3y&_nc_oc=Ado8w8LVM3-74cELOwx4BHyXEh94gGiidulWdRwei4H_Cmu2kUrUw9gk8RcU1-tMQBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZMiIC7klKioq4wcPwB-T_hJUeKz2PFKMrpQSab0lqRQ&oe=69DB89C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Forklifter Simulator \u2013 Warehouse Driving", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1771877940, "lastRevision": {"nodes": [{"id": "25432309546418910", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25432309469752251", "is_first_party": false, "enables_in_app_a
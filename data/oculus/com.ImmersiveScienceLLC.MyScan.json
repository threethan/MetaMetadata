BinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31159701543643258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39778706938409299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1128713175774575"}]}, "change_log": "Build 600 improves scan-loading performance, including Brain, and limits close-up rendering cost with a distance-scaled inspection box. Includes Center Image, saved orientation, and improved two-hand scaling, rotation and wrist tilt. For Quest 3 and Quest 3S.", "created_date": 1792464175, "id": "39680903298189664", "version": "2.0.0", "version_code": 600, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31159701543643258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39778706938409299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1128713175774575"}]}, "change_log": "Improved scan loading responsiveness and scan switching, clearer saved-scan names, and more reliable USB imports.", "created_date": 1792015564, "id": "39540806218866040", "version": "2.0.0", "version_code": 589, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31159701543643258", "is_concept":
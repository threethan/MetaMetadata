1-7&_nc_sid=6e7a0a&_nc_ohc=aF-b8MX2cI4Q7kNvwGZo3_8&_nc_oc=Ado_1WTd6jhf_uVGAHzX1SNnNVroAAyISlUTVhiPqxptzraeY4VTyUQPhR2XpCpmM38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0DIoe2tOAxtLLpM9S_4NserwR7i4e_HT9iozkw-Kb-Q&oe=6AF07E8B"}, {"file_name": "04-abdomen.png", "id": "1396020509398410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593749142_1396020512731743_1239618857863704295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr1mjTuKZxYQ7kNvwGBTJtn&_nc_oc=Adqq2rRiZSkVBKVUZqcZl-hpEiH3LZ_FUZ2P00Q5c_SrQS7kacnCW5s2Ih33AHQrD2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjKkoaa2LybrjqsKNldOKWKJsSbdXUotf61x9hMHuXgg&oe=6AF0828B"}, {"file_name": "05-slices-to-volume.png", "id": "4475088022746148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593882405_4475088026079481_2842074521337017783_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egyaeFtQ7WoQ7kNvwG9mr7G&_nc_oc=AdqpHN6gIoZ90YvG85mLTEhIiMuAA7kcIX9nuaFsOqvoQU0PYoEt6Q9gGMi2tS5IgEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvizU8p_ImivhrMVnJr61syzp-2zCIPOX8NYHmF_2C1g&oe=6AF09133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "myscanvr-trailer-cover-drew-v3.png", "id": "1067018652882879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1067018656216212_7350077368477157499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57-iIjURk3QQ7kNvwFMp9qm&_nc_oc=AdrCpuBXr2DdZwU6UWCwFYVUNOrAX5dhY2wZx-OwQktsiBOyGBBb8xuyDSUpmZ4fb4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrUAzmMEWoatc8sJDrtj5LS6onjp6eVqaF7MON3z99jg&oe=6AF07C81"}, "display_name": "MyScanVR", "keywords": ["DICOM", "CT", "MRI", "Anatomy", "MedicalImaging"], "long_description": "See beyond the flat image. Explore CT and MRI scans in immersive 3D on Meta Quest 3 and Quest 3S.\n\nAsk your radiology department for your CT or MRI scans in DICOM format, copy them to a USB-C drive using your computer, and plug the drive into your headset.\n\nEXPLORE AT YOUR OWN PACE\n- Rotate, enlarge, and reposition scans with Quest controllers\n- Cut away the front or move closer to look inside\n- Adjust opacity, viewing range, image quality, and optional color\n- Save viewing settings and reopen imported scans without the USB drive\n\nSTART EXPLORING NOW\nIncluded demo scans let you explore a brain, jaw, chest, torso, and abdomen without obtaining your own images.\n\nBRING YOUR OWN SCAN\nPlace DICOM folders or ZIP files inside a folder named MyScans on the drive, then connect it to your headset and choose Open USB Scans.\n\nOn first use, approve access to the MyScans folder in the Quest folder screen. MyScanVR copies supported scans into its local library and leaves your USB originals unchanged. Multiple scans are supported. Reports, PDFs, screenshots, and ultrasound movies cannot be imported as 3D scans. Your imported scans stay on your headset and are not shared.\n\nFOR EDUCATIONAL PURPOSES ONLY\nNot intended for diagnosis, treatment decisions, or medical advice. MyScanVR does not replace your radiologist or physician. Discuss medical questions with a qualified clinician.", "short_description": "Explore CT and MRI scans in immersive 3D. Rotate, enlarge, and cut away parts of the scan. Start with the included demo library, or load your own DICOM folders or ZIPs from a USB-C drive. For education and personal understanding, not diagnosis or treatment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/myscanvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_R
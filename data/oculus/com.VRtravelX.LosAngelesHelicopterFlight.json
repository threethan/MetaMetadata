t-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TfumUaeFaYErdrRENp5ClSuGvQl_qhxE7lqg27M6HXw&oe=6A106022"}, {"file_name": "screen5.png", "id": "335699336070573", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57570305_335699339403906_2651527571149419145_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImAy4Z-kpnkQ7kNvwH6QJ4L&_nc_oc=AdpKpqCiq9RLyBXLAtCTJnHFPnQsIBMmFnuOvo57cJBEnxmX-54dM_lZel-sZJgE-k8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ioOPizRTuUMBFk5Z_t6Htralqp3X3Te7-m_AoBw7kBQ&oe=6A107306"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Los Angeles Helicopter Flight", "keywords": [], "long_description": "Experience Los Angeles like never before with our VR app. Get up close and personal with the city's legendary skyscrapers, including the iconic U.S. Bank Tower, the majestic Aon Center, and the imposing Two California Plaza. \n\nThe highlight? A breathtaking vertical ascent over the U.S. Bank Tower that will leave you breathless! Feel the thrill and excitement as if you're really there. This unique experience brings the magic of LA right into your home. \n\nFor only $1.99, you can dive into a world that will captivate both VR beginners and seasoned users alike. \nAvailable now in the Meta App Lab Store \u2013 don't miss your chance to experience the City of Angels from a whole new, spectacular perspective!", "short_description": "Get the impression to really be over Los Angeles.\nTake that crazy 360 degree real helicopter flight over L.A. without leaving your home, even without leaving your couch! \nYou can see all perspectives from helicopter view over L.A. like in the blockbuster movies. Fly over all skyscrapers and take an awesome flight around the US Bank Tower, one big landmark of L.A. downtown. \n\nFlight time: 21 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/LosAngelesHelicopterFlight", "developer_terms_of_service_url": null, "publisher
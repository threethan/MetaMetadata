ga3-1.oculuscdn.com/v/t64.5771-25/39031574_1675492552856338_7960362787917372007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ptrVXrNQHIQ7kNvwE6my2O&_nc_oc=AdqgA3H-It13WZOl18aoC_WR1hSCqhPSJfXpFiHBf5uFvRj-U5WvP_A-LefM6RKtyLs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJneTLBHBqcXJ6xxNNIDjEpY3WTmsd9kfdzMzc9ofe_bQ&oe=6AA013A2"}, {"file_name": "screen5.png", "id": "335699336070573", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570305_335699339403906_2651527571149419145_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oIRU5J3lVoQ7kNvwFrkGJX&_nc_oc=Adob6BrX6FW9Un4Phq4ls7JTkfKXFn0Hzv7rUi0r1rdKiStVZZ4KPT69Sm42uqcc7L0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtwTJeVE2Zb_oG7wEx4ylvETGESljZZ12ceXibE4Kc0A&oe=6AA02686"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Los Angeles Helicopter Flight", "keywords": [], "long_description": "Experience Los Angeles like never before with our VR app. Get up close and personal with the city's legendary skyscrapers, including the iconic U.S. Bank Tower, the majestic Aon Center, and the imposing Two California Plaza. \n\nThe highlight? A breathtaking vertical ascent over the U.S. Bank Tower that will leave you breathless! Feel the thrill and excitement as if you're really there. This unique experience brings the magic of LA right into your home. \n\nFor only $1.99, you can dive into a world that will captivate both VR beginners and seasoned users alike. \nAvailable now in the Meta App Lab Store \u2013 don't miss your chance to experience the City of Angels from a whole new, spectacular perspective!", "short_description": "Get the impression to really be over Los Angeles.\nTake that crazy 360 degree real helicopter flight over L.A. without leaving your home, even without leaving your couch! \nYou can see all perspectives from helicopter view over L.A. like in the blockbuster movies. Fly over all skyscrapers and take an awesome flight around the US Bank Tower, one big landmark of L.A. downtown. \n\nFlight time: 21 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/LosAngelesHelicopterFlight", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://VRtravelX.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6585816171518741"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2177138649871166"}, {"status": "PUBLISHED", "id": "1790806378764009"}, {"status": "PUBLISHED", "id": "4298644730446155"}, {"status": "PUBLISHED", "id": "1324331922954764"}, {"status": "PUBLISHED", "id": "921592330828885"}, {"status": "PUBLISHED", "id": "920038630552081"}, {"status": "PUBLISHED", "id": "2320962301738968"}, {"status": "PUBLISHED", "id": "2363905444082213"}, {"status": "PUBLISHED", "id": "1370799427941994"}, {"status": "PUBLISHED", "id": "24691066020506196"}, {"status": "PUBLISHED", "id": "1390366455345929"}, {"status": "PUBLISHED", "id": "8824875334280763"}, {"status": "PUBLISHED", "id": "945361073902141"}, {"status": "PUBLISHED", "id": "1762853284463184"}, {"status": "PUBLISHED", "id": "870236381268608"}]}, "baseline_offer": {"id": "870236381268608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2177138649871166"}]}, "liveChannel": {"nodes"
IQ&oe=69B80C33"}]}, "id": "299053433126250", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "213480288399772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974696_213480291733105_5082868781443147042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzI968nsmLwQ7kNvwG_9ydX&_nc_oc=AdndpxX6mMuYkwxBfr76uULcidS_Jtyr9sdLCKfgozKpSFBH2kr7pl-Ueeln9DrRRrA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZqpgSncIX-spZgGVepyHHuayfrdJRyxgZf-SN36RlTQ&oe=69B7F38B"}, {"file_name": "screen2.png", "id": "1290633628467593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569423_1290633631800926_3408178984616363622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofYFzWHe3rwQ7kNvwEOA3Y0&_nc_oc=AdkDZ8c9e88Kn_Uj1Z9s8YfWD-WgzjY06dxPFNqFnCoveT82POZFjnqZbakoEzr-vD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfygHWrP71eCaEhBX0HpoFJA1KZgvArEdR5FK0KH7w0OSg&oe=69B805AD"}, {"file_name": "screen3.png", "id": "742061921162773", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395592_742061924496106_7029404137050011907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxGAFL2S78wQ7kNvwH-Etlb&_nc_oc=Adkt9o4Y3qjPv5JG5bMiYe9oD5qhPDixKS2SCujVPZk_tYKPazVhNR1evVfRZR3rc_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvZyUF3oaI6oDjro35SmUoWucQ59lGb8Znblk9205GLA&oe=69B7F4AA"}, {"file_name": "screen4.png", "id": "1675492549523005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031574_1675492552856338_7960362787917372007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-0rp6LaOgkQ7kNvwFHu52H&_nc_oc=AdmZvEwL6zvZ3jXsOii9HzikFxnde3MNXgGffYLyFsXSnZTyJFvjIsrRA1fwuwI8ux8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYYEbQl5W1m9xTcK2ZuONLLbTEtOwvyulxWBhHMr4JmA&oe=69B80BA2"}, {"file_name": "screen5.png", "id": "335699336070573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570305_335699339403906_2651527571149419145_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIpF4dGxjcsQ7kNvwFSomvh&_nc_oc=AdmY2Bjz2-mrsMVizRwr3cmEq80w8096JhsxBxqfIIvkgPj5yp1m47oZHkz41z9Xee8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9wTAis5amb5G0pUYSdIMPCOO7kNr13slEPyA7PDSUoA&oe=69B7E646"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Los Angeles Helicopter Flight", "keywords": [], "long_description": "Experience Los Angeles like never before with our VR app. Get up close and personal with the city's legendary skyscrapers, including the iconic U.S. Bank Tower, the majestic Aon Center, and the imposing Two California Plaza. \n\nThe highlight? A breathtaking vertical ascent over the U.S. Bank Tower that will leave you breathless! Feel the thrill and excitement as if you're really there. This unique experience brings the magic of LA right into your home. \n\nFor only $1.99, you can dive into a world that will captivate both VR beginners and seasoned users alike. \nAvailable now in the Meta App Lab Store \u2013 don't miss your chance to experience the City of Angels from a whole new, spectacular perspective!", "short_description": "Get the impression to really be over Los Angeles.\nTake that crazy 360 degree real helicopter flight over L.A. without leaving your home, even without leaving your couch! \nYou can see all perspectives from helicopter view over L.A. like in the blockbuster movies. Fly over all skyscrapers and take an awesome flight around the US Bank Tower, one big landmark of L.A. downtown. \n\nFlight time: 21 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/LosAngelesHelicopterFlight", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://VRtravelX.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription
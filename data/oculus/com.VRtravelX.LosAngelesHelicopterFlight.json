hots": [{"file_name": "screen1.png", "id": "213480288399772", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974696_213480291733105_5082868781443147042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF27vP2MdnQQ7kNvwFbWrHl&_nc_oc=Adl2WkQ17fJxnh5bbzMs_2036e3YC0UDDI1d8LQ6g0755NJBzdomyhu53fKHnx_DRKs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsuxatv9hp1iGiLX_Io87C1enQAzkHKStzA7oDU4pfS5w&oe=69A18A0B"}, {"file_name": "screen2.png", "id": "1290633628467593", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57569423_1290633631800926_3408178984616363622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxkWEcHdFEAQ7kNvwE1sKfr&_nc_oc=Adn_IiZp_WaWbX82JVGjWNNp9pyylWWADshRFpdfdNwMi3XCt891KCek-w_LRMWNfC4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv3_ZMkOWbE4w1lTM1kOPqRZkoCRib_MjjKkfTMoaoj4w&oe=69A19C2D"}, {"file_name": "screen3.png", "id": "742061921162773", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75395592_742061924496106_7029404137050011907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh0y89PgcBAQ7kNvwE3N-oY&_nc_oc=Admcswj6Uy3GQQmotDMOKEkTT0r6khsi9WKYicYTPtEW5l0RKVdpvBQDnSn8Jmpp0yA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu3SkEFXc45Fsks7TPPzrSMl7qWzB66QZtVl7CYNj2ysQ&oe=69A18B2A"}, {"file_name": "screen4.png", "id": "1675492549523005", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031574_1675492552856338_7960362787917372007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izyex3CKyl4Q7kNvwGRGglK&_nc_oc=AdlHP2iMst_mpMN0YnmbcP9vSWOaN3GdlZn8CAFpoDxNDJ0f77oVYNgG_z_U7LtvLpc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftELT0Ob8vPINAWg5Kdg6MX-8vPhRLslNbGmu_dmD_DAQ&oe=69A1A222"}, {"file_name": "screen5.png", "id": "335699336070573", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57570305_335699339403906_2651527571149419145_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9qNWiKBJAAQ7kNvwHSPcmr&_nc_oc=AdlOopZJMVn8JTROoU8MpZf-G04bXkUWDJKy15_QxXMIOU1EiRapCVpNMBZWPShcKmU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs0bYR7rB-FcvUf7sO8PIhGBBiBY0shps6GQJi9-e1ruA&oe=69A17CC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Los Angeles Helicopter Flight", "keywords": [], "long_description": "Experience Los Angeles like never before with our VR app. Get up close and personal with the city's legendary skyscrapers, including the iconic U.S. Bank Tower, the majestic Aon Center, and the imposing Two California Plaza. \n\nThe highlight? A breathtaking vertical ascent over the U.S. Bank Tower that will leave you breathless! Feel the thrill and excitement as if you're really there. This unique experience brings the magic of LA right into your home. \n\nFor only $1.99, you can dive into a world that will captivate both VR beginners and seasoned users alike. \nAvailable now in the Meta App Lab Store \u2013 don't miss your chance to experience the City of Angels from a whole new, spectacular perspective!", "short_description": "Get the impression to really be over Los Angeles.\nTake that crazy 360 degree real helicopter flight over L.A. without leaving your home, even without leaving your couch! \nYou can see all perspectives from helicopter view over L.A. like in the blockbuster movies. Fly over all skyscrapers and take an awesome flight around the US Bank Tower, one big landmark of L.A. downtown. \n\nFlight time: 21 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/LosAngelesHelicopterFlight", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://VRtravelX.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOV
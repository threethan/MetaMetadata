US Bank Tower, one big landmark of L.A. downtown. \n\nFlight time: 21 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/LosAngelesHelicopterFlight", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://VRtravelX.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6585816171518741"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2177138649871166"}, {"status": "PUBLISHED", "id": "1790806378764009"}, {"status": "PUBLISHED", "id": "4298644730446155"}, {"status": "PUBLISHED", "id": "1324331922954764"}, {"status": "PUBLISHED", "id": "921592330828885"}, {"status": "PUBLISHED", "id": "920038630552081"}, {"status": "PUBLISHED", "id": "2320962301738968"}, {"status": "PUBLISHED", "id": "2363905444082213"}, {"status": "PUBLISHED", "id": "1370799427941994"}, {"status": "PUBLISHED", "id": "24691066020506196"}, {"status": "PUBLISHED", "id": "1390366455345929"}, {"status": "PUBLISHED", "id": "8824875334280763"}, {"status": "PUBLISHED", "id": "945361073902141"}, {"status": "PUBLISHED", "id": "1762853284463184"}, {"status": "PUBLISHED", "id": "870236381268608"}]}, "baseline_offer": {"id": "870236381268608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2177138649871166"}]}, "liveChannel": {"nodes"
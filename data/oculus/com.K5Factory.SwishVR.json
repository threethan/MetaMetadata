_977308423105029_2927181685912809646_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYCCrAArmg0Q7kNvwEZBu8d&_nc_oc=AdrHCm5JyDMhpGfJBWdwmBEW0S7RblPoIPPQrhb7rW1rUmHhYrZdkbw0eupTHBTFE8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUf-bNvI9Bt7yZRpmkL95tHgEBAFkhpuxAN1zKfX75OTQ&oe=6B103913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MomentumVR_OJ_Rendering_v002.png", "id": "413283917050883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_413283920384216_915793445868340577_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Avjf-KaVNYQ7kNvwFv_wl_&_nc_oc=Adr-9c2bFnjP9y8FyL3uAYtVNEYNC50pPf3-4dkoO68-Ge_tciVIEms8I7YNiZhHD7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZeGb-pf0XhoFawmF7Pl-TQwy1DguAY30Dox854K0cyg&oe=6B106A68"}, "display_name": "TrailBouncer", "keywords": [], "long_description": "TrailBouncer is a fast-paced VR racing game where breathtaking locomotion meets ultra-fast ball handling in a stunning and surreal environment.\n\nRace at lightning speed through five different zones in a mythical environment. Race and spin up and down the mountains while collecting items to be even faster.\n\nStrive to unlock all levels and stay at the top of the game by using each ball's special powers to your advantage and achieve the highest rank among your fellow players.\n", "short_description": "TrailBouncer is a fast-paced VR flying racing game where breathtaking locomotion meets ultra-fast ball handling in a stunning and surreal environment.\n\nRace at lightning speed through five different zones in a mythical environment. Race and spin up and down the mountains while collecting items to be even faster.\n\nStrive to unlock all levels and stay at the top of the game by using each ball's special powers to your advantage and achieve the highest rank among your fellow players.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "h
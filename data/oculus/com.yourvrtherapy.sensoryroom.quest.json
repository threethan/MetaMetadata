idFTKB8ep8V_ONJLNAcaA&oe=6AF4A290"}, {"file_name": "VRTherapy_Cam_Sensory2_3840x2160 (Custom).png", "id": "901028398300270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_901028401633603_627257832616781480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if2bTDAlP68Q7kNvwGYi-3C&_nc_oc=AdqjULmH08uOtW7f7IiBg1nZmwVuKAoND2RlAKsAGA6LvUr89oLWrk7XRugKFhwpTEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQturBBCLoByXmNJjJVVGxDu9-aiizLhup_Z_z7EFBWkg&oe=6AF4791F"}, {"file_name": "VRTherapy_Cam_Sensory1_3840x2160 (Custom).png", "id": "985952625960516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254875_985952629293849_7550419092568334009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm1zDszDRHAQ7kNvwFX0GFd&_nc_oc=AdreERclkR98NamRTVRy0-DhlkA6MTk9YgkJOmVvtKV3Cm8CiqY9TKCh73nOy7XrNfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT52Rmy1nMeyHSUfSkZI0AwR-wEYi_vJjuvOCNgCgdMzA&oe=6AF4A560"}, {"file_name": "VRTherapy_Cam_Sensory_Wide_3840x2160 (Custom).png", "id": "3552569408344767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031495_3552569411678100_5955106357745012263_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qdSZNRfPhUQ7kNvwGBIeKV&_nc_oc=AdoJZcKtImAmNk40fpj0tNLKOgPiPT5FCJBORFGjlaHcqNQXGGZRom6qesOZqqoBKZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSca_TxjL2RCkG_RMnG_fEU2uqdvWyKEdWW_Xnjwu20gA&oe=6AF496B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art_landscape.png", "id": "862962371915225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982538_862962375248558_5129333378553841424_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Baf8qmcfbwgQ7kNvwGp-LJm&_nc_oc=AdpdgDgqnU0ZyaYaiI1Q6be7KcMC83uAbm6uCHd5fNZUUnmzJWpRzpa_IYDu1cWwrNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrBI4ehD5r8qZuh4IXvT4xdIkItOdGUKURKuoPitimHw&oe=6AF4880A"}, "display_name": "Sensory Room", "keywords": [], "long_description": "Imagine if you could be instantly transported to a magical, calming world. \n\n\ud83c\udfb6 \ud83c\udfdd\ufe0f A place where you could let go of everyday stresses and be soothed by relaxing visuals, tactile sensations and gentle sounds.\n\nNOW YOU CAN!\n\n\ud83d\udca1 Inspired by the many hundreds of real-life Sensory Rooms in the world, Your VR Therapy now makes it possible to experience these important relaxation facilities virtually.\n\nAnd for a tiny fraction of the cost.\n\n**WHAT ARE SENSORY ROOMS?**\nThese are widely used to help people with stress issues and learning difficulties. They offer a safe space to unwind and engage in gently stimulating activities.\n\n**OUR VIRTUAL SENSORY ROOM **\nFrom the comfort of your home, you can now enter a realm of relaxation and sensory exploration \u2013 instantly. \n\nCreated in collaboration with trained Sensory Room experts, our space offers:\n\n\u2013 CALMING VISUALS -- \n\n\u2013 SOOTHING SOUNDS \u2013\n\n\u2013 INTERACTIVE OBJECTS \u2013\n\nWhich all help to promote comfort and self-discovery.\n\nThis virtual oasis has been developed for both adults and their family members in need of some safe, relaxing 'me' time.\n\nIt offers a rare opportunity to step away from the stresses of everyday life.\n\nOur highly interactive app:\n- Enables you to let off steam in a secure, controlled environment.\n- Promotes individual play and discovery.\n- Is designed by experts to enhance emotional development.\n- Requires no travel to a physical location.\n\nSTART YOUR RELAXATION TODAY!", "short_description": "Your VR Therapy's virtual Sensory Room is a highly interactive and engaging alternative to expensive real-world Sensory Rooms, which are widely used in both clinical and educational settings.\n\nOur expertly-designed VR space allows you to enter a calming virtual room and embark on a journey of relaxation in your own home.\n\nDownload today and discover this revolutionary new way of enjoying the Sensory Room experience with zero fuss, travel or ongoing expense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yourvrtherapy.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.yourvrtherapy.com/terms-of-service", "publisher_name": "Your VR Therapy Ltd", "support_website_url": "https://www.yourvrtherapy.com/contact-us-support", "website_url": "https://yourvrtherapy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8273669856034039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1009334420270672_8324374540253477555_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ6L_RDlnYoQ7kNvwGBdG1y&_nc_oc=AdoToTyNrxrOz3BiyuNgZwDQ6b7kiQx4v6aYwh1d6E2I8zy1UCcHlbOKPgd9Nl2MuaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRTBQd75d405fnpj-SAAoLPctHKruuZKJlxbqLMYvH3g&oe=6AF485A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sensory Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1694640080, "lastRevision": {"nodes": [{"id": "6749083358492704", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
RDRXUrisaQOjG9KsqcB6g&oe=69CD1A50"}, {"file_name": "VRTherapy_Cam_Sensory2_3840x2160 (Custom).png", "id": "901028398300270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_901028401633603_627257832616781480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbQ4TgVEiCQQ7kNvwHh1X-N&_nc_oc=AdpR9IULxrDpTBRiVwwYDIu8OFymSX56yKsAy7zt2O5ncOUNxJL05G9Xw4PdGzFcins&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylFVAZFslhh0-rcuoiDwF7u8_5-cbTwkw7_g61W88iIQ&oe=69CD291F"}, {"file_name": "VRTherapy_Cam_Sensory1_3840x2160 (Custom).png", "id": "985952625960516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254875_985952629293849_7550419092568334009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYqfm4butSUQ7kNvwG6DyLC&_nc_oc=Adr04YC91hZvDzhHYBMZUrVwP4Cv_4rsDnrt-h2Ufez26twYHD4I9Mr6Nah8utvYBqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOuJfTR3iuywrNSYAII4T7HqgTfjwbo6yhhUn_sDx4uw&oe=69CD1D20"}, {"file_name": "VRTherapy_Cam_Sensory_Wide_3840x2160 (Custom).png", "id": "3552569408344767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_3552569411678100_5955106357745012263_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJx6tjoc1qsQ7kNvwGOq0fC&_nc_oc=AdoVX47bznzU6mIbWZLAPoD9Dxw9sMRVwgz3wdPUe6PeBR-lly5TgJcuP4hCpSr-41M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY4SX2RVXLEMk9qpgPYL30bMwuxYsBmc8itZy97s_nSA&oe=69CD0E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art_landscape.png", "id": "862962371915225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982538_862962375248558_5129333378553841424_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mz-D4H-iX0Q7kNvwGqbIid&_nc_oc=AdoH0eiHx4QT9Q5l5xgzVJwc-xxwXz0VRz7fhmzjj1ltyGmCo5fCVdJwsc2AQ3vojO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt92lUPbMxIRG0WZWDwhvqsXME2KRC43O6ujnoZbAQTA&oe=69CCFFCA"}, "display_name": "Sensory Room", "keywords": [], "long_description": "Imagine if you could be instantly transported to a magical, calming world. \n\n\ud83c\udfb6 \ud83c\udfdd\ufe0f A place where you could let go of everyday stresses and be soothed by relaxing visuals, tactile sensations and gentle sounds.\n\nNOW YOU CAN!\n\n\ud83d\udca1 Inspired by the many hundreds of real-life Sensory Rooms in the world, Your VR Therapy now makes it possible to experience these important relaxation facilities virtually.\n\nAnd for a tiny fraction of the cost.\n\n**WHAT ARE SENSORY ROOMS?**\nThese are widely used to help people with stress issues and learning difficulties. They offer a safe space to unwind and engage in gently stimulating activities.\n\n**OUR VIRTUAL SENSORY ROOM **\nFrom the comfort of your home, you can now enter a realm of relaxation and sensory exploration \u2013 instantly. \n\nCreated in collaboration with trained Sensory Room experts, our space offers:\n\n\u2013 CALMING VISUALS -- \n\n\u2013 SOOTHING SOUNDS \u2013\n\n\u2013 INTERACTIVE OBJECTS \u2013\n\nWhich all help to promote comfort and self-discovery.\n\nThis virtual oasis has been developed for both adults and their family members in need of some safe, relaxing 'me' time.\n\nIt offers a rare opportunity to step away from the stresses of everyday life.\n\nOur highly interactive app:\n- Enables you to let off steam in a secure, controlled environment.\n- Promotes individual play and discovery.\n- Is designed by experts to enhance emotional development.\n- Requires no travel to a physical location.\n\nSTART YOUR RELAXATION TODAY!", "short_description": "Your VR Therapy's virtual Sensory Room is a highly interactive and engaging alternative to expensive real-world Sensory Rooms, which are widely used in both clinical and educational settings.\n\nOur expertly-designed VR space allows you to enter a calming virtual room and embark on a journey of relaxation in your own home.\n\nDownload today and discover this revolutionary new way of enjoying the Sensory Room experience with zero fuss, travel or ongoing expense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yourvrtherapy.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.yourvrtherapy.com/terms-of-service", "publisher_name": "Your VR Therapy Ltd", "support_website_url": "https://www.yourvrtherapy.com/contact-us-support", "website_url": "https://yourvrtherapy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8273669856034039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334053_1009334420270672_8324374540253477555_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIoaHyHSIicQ7kNvwGf8-o4&_nc_oc=AdpDVkDu2gdpRaBt044UzyFE8LXN3n4n3WL4zIIeVbhUINvbXoZbR1q-iWcfEI9l298&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlFZsuM9_Fh0380jpNenRjKuhhGN7aUF-TGEp5b8GBUQ&oe=69CCFD66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sensory Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1694640080, "lastRevision": {"nodes": [{"id": "6749083358492704", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
zm3DMqkf45BsFf93rwNrg&oe=6ACD1590"}, {"file_name": "VRTherapy_Cam_Sensory2_3840x2160 (Custom).png", "id": "901028398300270", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_901028401633603_627257832616781480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ7pwwWlzqEQ7kNvwG1RtGp&_nc_oc=AdqfadkWrnu0JvacDpg0qqvJIlYJUy-5DLV8Y_UzD5DhkzUQeJv01cpqJJz9IUefHUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN30c91fK8q9CRPkJ59J0V3DnxEU_CnqJGj8DjdzI_4Ow&oe=6ACCEC1F"}, {"file_name": "VRTherapy_Cam_Sensory1_3840x2160 (Custom).png", "id": "985952625960516", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254875_985952629293849_7550419092568334009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31UXN5TJ1lEQ7kNvwGY0-6J&_nc_oc=Adp5fm-2m2UR5VuljYijpIp5fAdA8ab0qE0sBzy7CpuYNrRN1laxmYq4MWbAc3Iv3t8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR2orNy30p8bcPu2ZAFS6oZeF4kuC3_asPBMBfMZRFQw&oe=6ACD1860"}, {"file_name": "VRTherapy_Cam_Sensory_Wide_3840x2160 (Custom).png", "id": "3552569408344767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031495_3552569411678100_5955106357745012263_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAFzp3G3l7AQ7kNvwErVPgR&_nc_oc=AdrNSEaI0aun9HLzNdolB2RQjd6o_NX9DpUT5A9VuLfipzFDsTwiSERGrF5wvANDFeg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi4gnqlbhJbBmZR_rtNCsNfCndAgruo4-GpL3eI2_3Xw&oe=6ACD09B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art_landscape.png", "id": "862962371915225", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982538_862962375248558_5129333378553841424_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYSr3cN8xYMQ7kNvwHPyMlb&_nc_oc=AdoEuM5YiFR2tdMRCP3EbUEkQvx7a-x812CsHdLI4yrr0xGrImMdz3ztfhf2vQQttA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNb3fIfo1BD7ANvKL_xr2b-MLotVuvgmSlM3CMF7sGLA&oe=6ACCFB0A"}, "display_name": "Sensory Room", "keywords": [], "long_description": "Imagine if you could be instantly transported to a magical, calming world. \n\n\ud83c\udfb6 \ud83c\udfdd\ufe0f A place where you could let go of everyday stresses and be soothed by relaxing visuals, tactile sensations and gentle sounds.\n\nNOW YOU CAN!\n\n\ud83d\udca1 Inspired by the many hundreds of real-life Sensory Rooms in the world, Your VR Therapy now makes it possible to experience these important relaxation facilities virtually.\n\nAnd for a tiny fraction of the cost.\n\n**WHAT ARE SENSORY ROOMS?**\nThese are widely used to help people with stress issues and learning difficulties. They offer a safe space to unwind and engage in gently stimulating activities.\n\n**OUR VIRTUAL SENSORY ROOM **\nFrom the comfort of your home, you can now enter a realm of relaxation and sensory exploration \u2013 instantly. \n\nCreated in collaboration with trained Sensory Room experts, our space offers:\n\n\u2013 CALMING VISUALS -- \n\n\u2013 SOOTHING SOUNDS \u2013\n\n\u2013 INTERACTIVE OBJECTS \u2013\n\nWhich all help to promote comfort and self-discovery.\n\nThis virtual oasis has been developed for both adults and their family members in need of some safe, relaxing 'me' time.\n\nIt offers a rare opportunity to step away from the stresses of everyday life.\n\nOur highly interactive app:\n- Enables you to let off steam in a secure, controlled environment.\n- Promotes individual play and discovery.\n- Is designed by experts to enhance emotional development.\n- Requires no travel to a physical location.\n\nSTART YOUR RELAXATION TODAY!", "short_description": "Your VR Therapy's virtual Sensory Room is a highly interactive and engaging alternative to expensive real-world Sensory Rooms, which are widely used in both clinical and educational settings.\n\nOur expertly-designed VR space allows you to enter a calming virtual room and embark on a journey of relaxation in your own home.\n\nDownload today and discover this revolutionary new way of enjoying the Sensory Room experience with zero fuss, travel or ongoing expense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yourvrtherapy.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.yourvrtherapy.com/terms-of-service", "publisher_name": "Your VR Therapy Ltd", "support_website_url": "https://www.yourvrtherapy.com/contact-us-support", "website_url": "https://yourvrtherapy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8273669856034039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334053_1009334420270672_8324374540253477555_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg4FuyPQlTIQ7kNvwGEee6X&_nc_oc=AdphsysjiCaMmty3ypuVQUXdZpfCLsJufnfm8ZdwNL-plzYn_-26KEVeUqmLTGvS8j8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHJ13EBOaa3k3NDfo5EMeCDRn37alzHbffBhav6eFjIA&oe=6ACCF8A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sensory Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1694640080, "lastRevision": {"nodes": [{"id": "6749083358492704", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
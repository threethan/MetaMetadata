yU1fbvOPYYaEvjEF6Xjcg&oe=69E383D0"}, {"file_name": "VRTherapy_Cam_Sensory2_3840x2160 (Custom).png", "id": "901028398300270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_901028401633603_627257832616781480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzfEQIUyJSIQ7kNvwGHg7ig&_nc_oc=AdrQd-LibLVrJi8AbLilMgRobx_06dF5hVSQ4NazzGLvt4xR9gL52jCJEFMIZJZL2rM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a5KUqEiqkJjxwT1OM6OoyVa6DnfBfvSXFqhzdLTLlhQ&oe=69E3929F"}, {"file_name": "VRTherapy_Cam_Sensory1_3840x2160 (Custom).png", "id": "985952625960516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254875_985952629293849_7550419092568334009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgFeLskcRPUQ7kNvwEh4A-n&_nc_oc=Adp-Jbe4AgMvhJwwmQqbR5LWtiHeD-b1ez_Be7UffHJkJIliZRLfW6C7GTecQym16wA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JARhxIIcX93Q68ecJjeZGrt5VX0s_rdKNnzoPGYoPaQ&oe=69E386A0"}, {"file_name": "VRTherapy_Cam_Sensory_Wide_3840x2160 (Custom).png", "id": "3552569408344767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_3552569411678100_5955106357745012263_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wOloUJrnRAQ7kNvwGKRL5M&_nc_oc=AdoRPAeA1HpctHPF4mXenj9TP1LWN04DR7z0LneT5qqjABPXw3eltkt05Zuo7uIBv9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IMZwDJUpCQ5N-_g_-w4bg3b0NhfQWOUNY_3gvAkglRw&oe=69E377F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art_landscape.png", "id": "862962371915225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982538_862962375248558_5129333378553841424_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W53hAMd_psQ7kNvwGPPPxx&_nc_oc=AdoqOlTNi_lzAJHDcKeDGAhW_xvIOhEEhyP7CpZLvXXldM6yHsRrcWAld4evlKGflbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08-0UhC5loH_owv8ht9JfI4R7ZiBjnOmma4ihN2KQiMA&oe=69E3694A"}, "display_name": "Sensory Room", "keywords": [], "long_description": "Imagine if you could be instantly transported to a magical, calming world. \n\n\ud83c\udfb6 \ud83c\udfdd\ufe0f A place where you could let go of everyday stresses and be soothed by relaxing visuals, tactile sensations and gentle sounds.\n\nNOW YOU CAN!\n\n\ud83d\udca1 Inspired by the many hundreds of real-life Sensory Rooms in the world, Your VR Therapy now makes it possible to experience these important relaxation facilities virtually.\n\nAnd for a tiny fraction of the cost.\n\n**WHAT ARE SENSORY ROOMS?**\nThese are widely used to help people with stress issues and learning difficulties. They offer a safe space to unwind and engage in gently stimulating activities.\n\n**OUR VIRTUAL SENSORY ROOM **\nFrom the comfort of your home, you can now enter a realm of relaxation and sensory exploration \u2013 instantly. \n\nCreated in collaboration with trained Sensory Room experts, our space offers:\n\n\u2013 CALMING VISUALS -- \n\n\u2013 SOOTHING SOUNDS \u2013\n\n\u2013 INTERACTIVE OBJECTS \u2013\n\nWhich all help to promote comfort and self-discovery.\n\nThis virtual oasis has been developed for both adults and their family members in need of some safe, relaxing 'me' time.\n\nIt offers a rare opportunity to step away from the stresses of everyday life.\n\nOur highly interactive app:\n- Enables you to let off steam in a secure, controlled environment.\n- Promotes individual play and discovery.\n- Is designed by experts to enhance emotional development.\n- Requires no travel to a physical location.\n\nSTART YOUR RELAXATION TODAY!", "short_description": "Your VR Therapy's virtual Sensory Room is a highly interactive and engaging alternative to expensive real-world Sensory Rooms, which are widely used in both clinical and educational settings.\n\nOur expertly-designed VR space allows you to enter a calming virtual room and embark on a journey of relaxation in your own home.\n\nDownload today and discover this revolutionary new way of enjoying the Sensory Room experience with zero fuss, travel or ongoing expense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yourvrtherapy.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.yourvrtherapy.com/terms-of-service", "publisher_name": "Your VR Therapy Ltd", "support_website_url": "https://www.yourvrtherapy.com/contact-us-support", "website_url": "https://yourvrtherapy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8273669856034039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334053_1009334420270672_8324374540253477555_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR1S3wexEzsQ7kNvwGuE9J1&_nc_oc=Adq0ZyLKGnVren2Qe06r1C3siOJ_dgCf4CcY1G09lW5JUc8U2lpH8TL9Su85N2UHeRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eJ0T-aSDgPLmWlnxkJ6P_sbycgeeWxhucQMy5shqESA&oe=69E366E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sensory Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1694640080, "lastRevision": {"nodes": [{"id": "6749083358492704", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
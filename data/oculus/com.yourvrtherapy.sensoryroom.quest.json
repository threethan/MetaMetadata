s://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982552_266954689500781_8464647702084630651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEBVa10hlgEQ7kNvwEd8xUI&_nc_oc=AdmChm6_Etnh37mBESSo7V4BBrSd9QIh95zn2y5Xq1QsBb-6szZ-ObYv6JfCF5zkq08&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afus5d6lwRulP_11u22K5GrXTCVM42uPvW-X2Cat8VO_5A&oe=699B0150"}, {"file_name": "VRTherapy_Cam_Sensory2_3840x2160 (Custom).png", "id": "901028398300270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_901028401633603_627257832616781480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNZnN0JhyfcQ7kNvwFYBA8N&_nc_oc=AdkTtDxn9zLXXB4HuQcPxhpvJ3JnuPPlA1UcU9rMGDSxedHgukjHY2mNkbXWZfFqjKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftOMKgH15yC6qkdOpdRRVYH4KU56kcSOKUHVUayFUh35Q&oe=699B101F"}, {"file_name": "VRTherapy_Cam_Sensory1_3840x2160 (Custom).png", "id": "985952625960516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254875_985952629293849_7550419092568334009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA6PmW8_qGoQ7kNvwFO1SUX&_nc_oc=AdloPicrnJS0AIcFMyGIq6hj5jI0DxilKEnFO0oGiKgskcW0N21w-XjdmC6MGBy-3OI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7t3CEcrWl4a6Fh3IXTlfLWpZ7qiVjkFCqiByU-TnLzw&oe=699B0420"}, {"file_name": "VRTherapy_Cam_Sensory_Wide_3840x2160 (Custom).png", "id": "3552569408344767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031495_3552569411678100_5955106357745012263_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdnRT6vbiloQ7kNvwFgTfFf&_nc_oc=AdlRzhNYNMAEBRWYYTrTstfP8r4gJr-D0mhrFK0MUAc_SYf4j3qvC1OqJfsqQbQ7K8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsvO8As9onZy-PWarqUp6_RZ0dPqtqaRG7u3jI5_zoJzQ&oe=699AF575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-art_landscape.png", "id": "862962371915225", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982538_862962375248558_5129333378553841424_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN4znTEeZK8Q7kNvwF7n2mH&_nc_oc=AdnU6yzya7ffk49aSyxYJByx9O-uWCwxh1XJpqz-Ck-ZrNkgt6KjRBexFLteTOpELig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuEYhRrpURayXQwpVTH25raoT_DRXYzb2qRfozr-_eLxw&oe=699AE6CA"}, "display_name": "Your VR Therapy - Sensory Room", "keywords": [], "long_description": "Imagine if you could be instantly transported to a magical, calming world. \n\n\ud83c\udfb6 \ud83c\udfdd\ufe0f A place where you could let go of everyday stresses and be soothed by relaxing visuals, tactile sensations and gentle sounds.\n\nNOW YOU CAN!\n\n\ud83d\udca1 Inspired by the many hundreds of real-life Sensory Rooms in the world, Your VR Therapy now makes it possible to experience these important relaxation facilities virtually.\n\nAnd for a tiny fraction of the cost.\n\nWHAT ARE SENSORY ROOMS?\nThese are widely used to help people with stress issues and learning difficulties. They offer a safe space to unwind and engage in gently stimulating activities.\n\nOUR VIRTUAL SENSORY ROOM \nFrom the comfort of your home, you can now enter a realm of relaxation and sensory exploration \u2013 instantly. \n\nCreated in collaboration with trained Sensory Room experts, our space offers:\n\n\u2013 CALMING VISUALS \u2013\n\n\u2013 SOOTHING SOUNDS \u2013\n\n\u2013 INTERACTIVE OBJECTS \u2013\n\nWhich all help to promote comfort and self-discovery.\n\nThis virtual oasis has been developed for both adults and their family members in need of some safe, relaxing 'me' time.\n\nIt offers a rare opportunity to step away from the stresses of everyday life.\n\nOur highly interactive app:\n- Enables you to let off steam in a secure, controlled environment.\n- Promotes individual play and discovery.\n- Is designed by experts to enhance emotional development.\n- Requires no travel to a physical location.\n\nSTART YOUR RELAXATION TODAY!", "short_description": "Your VR Therapy's virtual Sensory Room is a highly interactive and engaging alternative to expensive real-world Sensory Rooms, which are widely used in both clinical and educational settings.\n\nOur expertly-designed VR space allows you to enter a calming virtual room and embark on a journey of relaxation in your own home.\n\nDownload today and discover this revolutionary new way of enjoying the Sensory Room experience with zero fuss, travel or ongoing expense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yourvrtherapy.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.yourvrtherapy.com/terms-of-service", "publisher_name": "Your VR Therapy Ltd", "support_website_url": "https://www.yourvrtherapy.com/contact-us-support", "website_url": "https://yourvrtherapy.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "247542711086245"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "642405988079029"}]}, "baseline_offer": {"id": "642405988079029"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1694640080, "status": "PUBLISHED", "id": "642405988079029"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6796069163794123", "version": "2023.09.4115"}, "id": "267611679378042", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7R0hVnfEpcQ7kNvwFxmBNf&_nc_oc=AdqOlAGe1qERa-Sq1OijnzJU3oUIY4S7zpB_XBFeQlshmD2aCvHDF3OSH7QJs9XkdHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98TGp91qnyOy22AeV0nDSJMx2haV7eeR-TG5YjSfOT4A&oe=6A3AB030"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_kfSLFIkjwQ7kNvwHwR70q&_nc_oc=AdpQgyUL7ySpWTHxTwQRov6TniNLRuIbqxDMuVKKl_5yQtztNG10ZeIHxyAfUTLseoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O47hdQhauvJRvYLcefzjx5TfqmV0ZD2HEE8UTGwJ0TQ&oe=6A3A9340"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHy-UCz5GxkQ7kNvwHFB-YA&_nc_oc=Adq7jSr6iP2-8dWLfOa2-eVS3Ukiu8mBfXMRIR0ChjlH15uUhiOCJCi9yuLAPIU3-6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SMgXbuO2GyujMJIVmcRXxB1ilu1rXOyHlGJ0PRyz5nw&oe=6A3AAA51"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wySn2X1dJIQ7kNvwGtSLdo&_nc_oc=AdoEqqW1KUTv0cXdgsNgJNtrN2cCZofdlgH6mCpPgZtKgc6MY28YRD_pQATxEyTKu4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jVGw3DWn8oHyArOuXEBQnCjbYhEDvwUJzj0ypiOXu1w&oe=6A3A9C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIiErf-A_ogQ7kNvwErRChy&_nc_oc=AdrbHv_6leTIP2-pxG1iBG1h--1jc8rUrWwGKARsmGtF9yPqAjeuwRjVLUJcp7GiIWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZFQ8sClnUQIYslpk686g6LEczo5hEToYb7azO7t9puA&oe=6A3A8534"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
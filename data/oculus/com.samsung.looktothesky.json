.png", "id": "137746421009609", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162688_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaFXmrRr5bgQ7kNvwFXjSvm&_nc_oc=Adpc_BHYoa_AhdWIi-5r0XoxvFBec04XWghZwcXX0ZFQQOf9E0JaAuglIiIy2hIR6a0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVsaC5ahimKHMN59tO_SUwJXUl-bY47M118lwPPb9arg&oe=6A7DC742"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ab3tXUgIvkQ7kNvwFPLpsV&_nc_oc=AdoXESkHsq64OINnHsMn2VJWmTt_MT8vihDisicJa5sS67Sb5mdMTxr8OnYoWg2zKjM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3qdAgfZUDrgL--a975G4ByFrSGLTkbBmFmpOaAFGLfQ&oe=6A7DB470"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUAfYbdqR9gQ7kNvwFOT2wK&_nc_oc=Adrx9ePT3C0_e3F3jgfeupmleRs7TOrlrxN3lC_3CwxOwOpT6677F1_p0d2-1oTpe3c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl_nWckAeiJRer0uZ8sNkJQApzvxIDah1HQYykSt0rdQ&oe=6A7DCFC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPg3RjU840QQ7kNvwEHz0Rk&_nc_oc=AdpruJ8B07d7jZnWh3GaF0ywRG9_FwpMZjx7ITQG6I3jzcVU3j8FkwXtB1ixextUKHo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_FD7stHRBpsu_Fw44ZnJoHoUltSpXFBNGKc7yz6wxAw&oe=6A7DAE91"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOf-W1Uosi4Q7kNvwFgwpim&_nc_oc=AdphppQ21LXiU31sLUn8HX2zysY6UKcPQuR2yUrkIf8NBHWjkgsMkPm0yrLIneD9BIk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2WLOFSPFWBcNHWasCfDP1m1DfYz305A47EOTezLiYTA&oe=6A7DA070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjfkBNqumcUQ7kNvwHBIUYb&_nc_oc=AdrIrSx2PX3JWZwQpCRIpw1RNGG4YdriA18ZIMbc9eHWpx-Ie3CMoV0d1O9HB-_Wvro&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcFkP7XhQMskcj9ToHTUxpymA1eGjqPNWGxJl9SKYxAw&oe=6A7DC1B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]
.png", "id": "137746421009609", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162688_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4TpSy8YRh4Q7kNvwG-CoJb&_nc_oc=AdrRzn8R85UNOei_98Eq_rO8Mv0KR0DZAty02SWY30WLGjKYWUsWHT69LyL0KEW-12k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ypkYJ55eYElgNz2SD322WrRVcC4DOeYdax_XZqD-ZCA&oe=6A393942"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdlF9bFhC4IQ7kNvwFzcF1G&_nc_oc=Adraz4MJONZenmfWn8Rlol5qJhIq8tunvvvztwlTVeDoL2MrMpMe7lTnDF8TRjXDv7U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YxvNU15q77pxjGdK8PLY5haiOh5DM45VL6zuJrKR-JQ&oe=6A395EB0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9GIID42yNwQ7kNvwFjJ9UP&_nc_oc=Ado1giDq1r6b5yW9_9RT0imsF4HI0COnsA3icTEQrZcH3otyZo5TIZgbIHvBwapLkQE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98eYKcZMc1E221FCCj4G0Zw8lEV32u9YG9m4vq9W63ng&oe=6A3941C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4viX1Lub4MQ7kNvwGkHP1a&_nc_oc=AdrKOcudZ8r1qkokSabv2eevPFEKmaKmAVWK6QFNxk1hlKONRgziUqB3F7cq_31no48&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af833Ic_xo7cWK5zYrp52k0uaD9-M_92SrYyI8UzxMZ7lg&oe=6A3958D1"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wySn2X1dJIQ7kNvwE0PVHT&_nc_oc=AdpO13l0kl1PIDR03hg7DuUAbl1DNE_vh4zuXi-ENZtPANOy48E59b402QQpR2RBl8I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R5E1X7gaOZnO9o94aaZwo1aT8bXKCtYx9fV5tz6YoIA&oe=6A394AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIiErf-A_ogQ7kNvwFfGckm&_nc_oc=AdqI-SHkedHD27KcHU3zVjfnhnWet9eIu9S-1UcHAw3KGHKBXMXtWBY-YD6m_rh4alo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-5JlXCkskruGBKVNlrZKtq1BhkRZ44pKhWKNgsYTWIQ&oe=6A3933B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]
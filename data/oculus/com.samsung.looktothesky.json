9Fl_2acflBrXTn0q1Yv_8c7vdNRnr9C9pRSiNHgXuso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi_GZscike4ycfucPk9jrtT8mRz9rRbPPzQTAZReLcLA&oe=69B6A1F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zq6hGBGTmIQ7kNvwHqJkc-&_nc_oc=AdmvrCLWgxX_uwKi0BrobK36g_HwAXfnIhojHr36SepDTZeXvpeBL75oYaXDxyza0f8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx86tnCKDE-asuccxDVL_dbbEPVVSOlbYxf3ZLVldFh3w&oe=69B6BD40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaIV1KjJ6UEQ7kNvwH2BOpF&_nc_oc=AdmEqJPjgJRsYb4hRxP0iXg2I2dLXbPYXlo3-6qWD8JKWM-0-NGuALu2c3P4zdSzuDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9I1sCna2j4LjkckbZ-OaRIOLCQoXmU6BsCeGP6uI0uA&oe=69B69C11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG3OMiL7fVsQ7kNvwHgqnDM&_nc_oc=Adn5VCGU_0p6UhhacTDbSARKq2vBwaE0SEa7W6DTwYviibePqkIGJ_kpEhaBUnZC9VI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxjh52Nz-05OOVueM2JVqLeNV2a7vGge5iIh2YxuIdYZw&oe=69B68DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5tBdURkqW0Q7kNvwEUQkEQ&_nc_oc=Adl9ykM9AICt133msHUuYzdFPbNrF1K3w7NjzVECOOvG02uPah_M_vieOn_6iAvmpfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFL37DyAEqBZuwZrOWnP8lIAKMgRVOCZ3WbHhlatbU9w&oe=69B6AF34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
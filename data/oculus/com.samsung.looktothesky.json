8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hmze_aMN9IQ7kNvwFHHv_F&_nc_oc=AdrnT-8eek7qgvGs0RA9rzW61X6YzYUb2HFI9HuGAr24PNJtFUqqxgCIyKaGrU3KXHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0cVX_k4fX3eaAHqE8n1_RC6mVp3StDa-qKK11OGYLF2Q&oe=69F0B6C2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSz3UX7IHo4Q7kNvwFP1xOd&_nc_oc=AdrsFNy-wcWZRUhuWJ-XtWkj03kcvE19skwxcGoLy5y3B2J3AWtXmBOIdSy_WR_GsZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0fjIzr6vruNXxCRBvgqOvaz6S0XZ3ypC5RM6fmNRk-Aw&oe=69F0A3F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2uv7sJ-vmEQ7kNvwEAqzp3&_nc_oc=AdoKzpX0PG99fKO2nJgbtq7KpZsBqe49E-4okrIcj0W0BLr6-N5K9ftMZpQ-acETGEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3xuVGyP6uTj1IvzLEz37siWxTo7daR-96-1-vDNHCR-g&oe=69F0BF40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNPoukSQ-aIQ7kNvwHaI8TV&_nc_oc=AdpeSxsQk_5_ETgl1O4DWTzHaP3RzHpLgEZKVMtVjtT0hsVmpqF55OuFzHEbphJix5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0CrsN3s4bfEd9kAnRZNs0fBvoDlN7j0snbh1n4hZy3bQ&oe=69F09E11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr6-j9w4TXsQ7kNvwEbf7uQ&_nc_oc=AdoBVeRLs7SYiDdZ9827hVy5pzdCaTjU-4VV_Vvr4oVKMrhwNTJPKDeCXM69agmF4PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af25bo1fC3NOeCsYSSLJIe-XsOcSpCXpO4MFI5a6qG39Nw&oe=69F0C830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yub0X2GyQX8Q7kNvwGHUcu4&_nc_oc=Adrhh4L9B_xUZWBWbrckH4t9kv73j9gvYsRbx88qrvXIesAfd5nmeK0nunhWxV7zWmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2YtSwrHIkGf8GcBdnEt-OCikQkH2wsCBccCVwfkJH6Og&oe=69F0B134"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
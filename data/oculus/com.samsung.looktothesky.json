.png", "id": "137746421009609", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162688_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23s3PkxvjusQ7kNvwGr5mLt&_nc_oc=AdpHV2s9MAXwLoJAydPH81aBDUUAxjKvleNdLAXT1ym_zFu4hVb_0YqN6BxB7m_Hvrs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5FpIMJhGgRHHkUmHopPob0khLTfbmSWQikWoat9L1Lg&oe=6AAE8EC2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfoaYgrgR7gQ7kNvwHSTp0R&_nc_oc=Adop0Udy-R8P1L9DHXDjZAn445QR3VFpR9Kb-TERrIwLcWsKn3lf3yljTvoTK4YojJQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcTWCOmdgqa_TVCB5PNwF0O-RYBU3dLj1cqQ8OLA2oUA&oe=6AAEB430"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j6IkL7Ju84Q7kNvwGxgG3H&_nc_oc=AdrQFxetwzXr5b6kLwZuA4h2nZUgLTAo8x_hagYIPy9sBozxPE6YuFZpk8izQoFM51Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjCdQiNa9cmwMs1HRAhu8SISrcktWwF7eG8UYQNUbFBQ&oe=6AAE9740"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLHCCrJLnnoQ7kNvwFl600I&_nc_oc=AdpifEi3f6c1tp83atqNH94NWA8EyPYgGdBqazDOscZ7-MHizUw-53poLoor8OTG4a4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIY4CSjJAJODurWr4Up4ums16ZhRIv9ajFa_RHRVb05A&oe=6AAEAE51"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wvbvjopHTwQ7kNvwGnTYWI&_nc_oc=AdpcOwXNPC7_w15pjFYoIMGTehEuBX_3IVAtuhm-GAs_fzlT6OqZb4DXzCSwdrhgLQo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx8awg98484tfJtZLn1bUMsH4kbd8W4MkTRO7tSh3gAQ&oe=6AAEA030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AmZ_9e4S3QQ7kNvwFjusQM&_nc_oc=AdqbRGRdqqk2aqDyN_Z80H_ZDtU2OTXYYm3vntAY15LcgC1tj-gxYhPSLAwj9ZAGe8Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmqR3OC_Zxh2fjGxun74qI_iBzwn6pWlPoRXhR1oMfPw&oe=6AAE8934"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]
: "877697382654885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLXPdx0HreYQ7kNvwF4byQZ&_nc_oc=AdkrruCNZ2yanNiPBFX2dqhOU7iBKNfBUK9-AYqV_OWUYN7mTLLIxkdw2xwEzMCSKTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnR2Qsyv3WVJSshFu5B9Tu14Q3tWBqGuROiGWrlCSJ0g&oe=69A2F6C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K5NPLeBAsQ7kNvwHkQRVc&_nc_oc=AdnZtuGIj1F0odMP48Fe1NFprK5eMwJSfwS5C4V7N2dUod7fHk5XgeEsOFs4MjEzZ6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPy6FLQH9HPRMEhL6bAZBGOornjqnZ2dJt7T_HXOC3Kg&oe=69A2D591"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYM2915hxEgQ7kNvwFdKeYu&_nc_oc=Adn3dIMFnQH-ig3K09U-vm4Z41NZcn34nfnjaWM9C7Yzzr4CuZwqZ8EbZwBgNpjcr8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvHyEdzkw-PsQ3mEz2K6Pa35DkfgaYKfk7p-O7BoydRQQ&oe=69A2C770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaxpbm5yf4UQ7kNvwEBf5XI&_nc_oc=Adlb_v9CMMYEz4TccFtLjTiB9FwmnjI7WiJkeEWGmkxF8GEgzb5gv6j2AY6v1PZVHbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afunbu1VQOsgqZ9TElPL2H8_vaPxTqEk1QecRe6swq1oNw&oe=69A2E8B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "216208543984506"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baselin
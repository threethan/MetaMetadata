7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ2Hn5Ug370Q7kNvwEBrSmX&_nc_oc=AdpoYTyhF4r0r9jF3FdUJmGtU6vXPr-cCA1O_tNC3DlRv3-Dcq_W3XyJaTlMrsoSBhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CWxIzSVctc5X46cYdipAFNTHknhRLv--MlQn1fXfSUg&oe=6A0DA4F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu7MK92jw7AQ7kNvwHzeWAa&_nc_oc=AdoqyCGih_xZF_sFCabnUjzEFyOz5A1852uHMG6mEf_BWRpnU5JHLC9ItcRyVS7g4LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c4AtotQOi2Ag_pQ1XSOvevx9y3gDaiOROXx7H7o_cAQ&oe=6A0DC040"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9ShP3R9iA8Q7kNvwGjUn43&_nc_oc=Adpja04w98u-891dgvUy_RJToWJFsAUdPGtVmMrVoD2EPbqOrM-hW4Anb8in4aip2KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FcUzg3YYGE7BRmJVC7acGG0buKBAUAo-88K20VyrDOQ&oe=6A0D9F11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl7KqFpgp28Q7kNvwFBA1Nt&_nc_oc=AdqVo4CLMVDqQ-oAh8qT21RmGBcmKar-gzwTrJm-hT3ITGFeEAaD9qiT9zF8lB13LGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59l6QtaN2wpVefBVtDEqKShVhogSg8IMrdaz2f09PFKQ&oe=6A0DC930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myittZe4JHsQ7kNvwHScHFK&_nc_oc=AdoWN0Fyxq_Z7h74mpPBuZOCk0_cAbiVcTHuTH1QrAn0gdIiJZ1yLwJAul7uNZB5sxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OsE83pJ0qreiI_Yh8H0xBf2lay1DzXokpgYlbpc199w&oe=6A0DB234"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
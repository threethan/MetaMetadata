7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ84z4WYBKUQ7kNvwEEQqNO&_nc_oc=Adrb3XN2yZylBsyI6pEramR-m25Vo_VnBcw03upv7tpulLvWVYxJmW4Eq3H3VFEzKiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7N486kGV1OP6riu0EEadmVfziMduYIoS3f7M4vUC1_w&oe=6A64A7F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V379rWvHRToQ7kNvwHR9ttq&_nc_oc=AdokvQuRhXg0LQ3ra0ON8ZR5gkWpS7VAI1e_TZeg7G0HzQdXI6x3bMagVuJEeIIsc9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0YDykGBJTrt-1ykxOiu63V2MdKVUC7gFdw2JAkCZ-jw&oe=6A64C340"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2Ts1C0W9CUQ7kNvwHbkOdA&_nc_oc=Ado-o_uP18R8GDKgOxi7TrmjSd97o3UmhFdWqKhwnSyX5atfDio63TM5AxI3JAHONY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3E3l83YLwxVx1sCzXbGb3yaU5rlGiHdDVWWM--ZOV-Q&oe=6A64A211"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyBo0Se1qk4Q7kNvwF5NPUD&_nc_oc=Ado9C2X3bYcgeRRMZqlN9Yl6q7QpjbfrC1XLo4hkZc7kynFBAgjgz821r7mzVccWh78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsKTawXyzAGkPLLp_vJvnBqDKNDqMIgKNPf-2tbUY3QQ&oe=6A64CC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYzOVFEOPycQ7kNvwFeoTmA&_nc_oc=AdpXoSSzn2K2lzmnlgVHP_cVm_PGlR39bF2AcFO0I8RRoK9ke2CkVlB2LS6PSXM83Vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk1_ZkWHvDDkQr1igEaz60QRgtDU2udHfLgR_4Lcm9zw&oe=6A64B534"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
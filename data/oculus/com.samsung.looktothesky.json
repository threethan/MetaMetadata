au5t0a9xC3jjlclGP1Amds17DmfrTJK6e6Fo-nSTqhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfFt6LYVPLelrnGE2MyDZTRK8O9w6bsGJtLoZUybNjKA&oe=69AEB8F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4AG-nn48psQ7kNvwG2lPrE&_nc_oc=AdnypvEN1owQdhqHm7ovz_gAPxVpB2OgQSncUUpas28bD28DMqQJtaPdKGsDQqWqlKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywYYUXn1dNHm2mdp7PRN9_eXl03MuQ964dH89ocMfdzg&oe=69AED440"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBuYRJBiAOAQ7kNvwHiopjo&_nc_oc=Adlrn9q34OVSbO3hDllSF2QRL01mdUUT2vxmKs7Mup4i0Dehta26Ua6eZ2w2Ph368Qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt7bjCaxMHRbTjoZXEflB9CVr8bOPhix81y4kCLu-h8w&oe=69AEB311"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bpSgGNb7_oQ7kNvwGpjI1D&_nc_oc=AdlmDBAKLSjHrhfCcw99c9-qjpzPjB0tOoEdoF1yTvi42M224tNaz7P0arn-LSdDjm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzcBauI31fDv0uBexzq_aWO_5LLghZxOSQ8buwXZvheQ&oe=69AEA4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZziOoaPhysQ7kNvwGT8nIF&_nc_oc=AdkdTxJvLep-12P8VlCL_sz6Jf46PGIkW_6KmNOiyEofYIfx1__Pj4Gjp8PFFpdv9xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxtkg5MWaxbYrobqpAEqZcrk207hUcfKJrSpC5e1gj-Dw&oe=69AEC634"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
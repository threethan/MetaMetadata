8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ2IzFSxXFsQ7kNvwGEfsPU&_nc_oc=AdnO9LMvBWp9SI92IbSOs8xESKxy1ji-Ppdlhzy6PSpFrq0k-YuxUqlQCgojmb8wzyY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8nYG-LLCXRBZjHfjv71g60lwqJy0uyfjMMgviBizjFg&oe=69A43FC2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4sSm9DqEgoQ7kNvwEreP5D&_nc_oc=AdlAwpS16Nd14EmvVIz4Eq0QwayPFbLuKVUABiZVG2CgfBWy5tFE2BEsDN-F6mATb5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRObuauBD2aKnKp4ZUVm8NNHIaz5haso75Qv6dSwbwhQ&oe=69A42CF0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoLGgHNhLRAQ7kNvwGOmNDM&_nc_oc=Adl--q2hgXPNQk5o2PHMqVWPmZYVJVJNTd02dFbAnaoJwYc0gZuQtWAD1709EqA1yjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-8BwTTL8luOpIEYdgWmOsrizJkwXKzPnqCp4Req0W0w&oe=69A44840"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmYPxAcpwRAQ7kNvwHSjKwm&_nc_oc=AdmHaj_ZJGlIPsXsFwhsbtXB5ZZUHR72d0krBsHoj_VYP8jFoP1A8fle08c7kjCVSPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsN_eOvE2K4zzRbKGY5j7hEmCJOzHPeyu0MAis_0AXHKg&oe=69A42711"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYM2915hxEgQ7kNvwFEEF3W&_nc_oc=AdkKDdl6RV1tm6tTRlbqWkZeM5eB9HBXR8I9ZDibph-YcDzjr2xQNoTivHRxOCo1ogY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsWi25OemjOnh2-sMaYMWkEzFbLKsNv9dUWvuBIun9dsQ&oe=69A45130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaxpbm5yf4UQ7kNvwHqppyD&_nc_oc=AdlLivWlanS261MikAxvHTQaf4lwtZ9MzyT8DcqT6gkPPx3SjSxmrzLtAM-YvZTGXj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuOL2TBVKrvyhe3_OiSNORky7PIQO84TU7HHKcE4EZ1qA&oe=69A43A34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
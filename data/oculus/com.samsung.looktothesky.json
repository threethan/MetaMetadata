7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRHpGsD0kWwQ7kNvwErXcs8&_nc_oc=AdqWqUQrjBdh9gopGpZfOnFXpc01saDITFo9OWGhDmhJucm_Ej5rDUGPufhiIKwHCVs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oqU6ikhxMVPtDf3iIJb-_0FXEZ0vJr6LTuWdw7-VTRg&oe=6A32C730"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1-eaOx-C4sQ7kNvwG3GMbV&_nc_oc=AdoEFAb-MyAyVAvE9Uhj85EfyI2xJIMCxajolgLEvsAcqdOHbQutsxk7ixOxxA6kUDM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a2AVPWnNKANU7atpmW75_p4FkgM9mQQsCs2l-D8vozQ&oe=6A32AA40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKnJv7BtCLAQ7kNvwH171Tz&_nc_oc=Adp8yDJa_UMZo-MbA5LudIWEQ7htk9lwJVrKJXQnga8kjD4qDKIKCVV7yArZ6NAbvJc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1kvLpLc5qRNe1PSvDpLgFar_u-BWTjeS2dy1_WZLuyQ&oe=6A32C151"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQSBc6wfWoYQ7kNvwGC8Ka-&_nc_oc=AdoGP52MDzc_1nPQqCPaHGpknoDCpnbT4diCKHs_ajFEWNxedbY6foHgVsfMCH5pZ3A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lvuN-6oc0W-2TtUjsavZhN5cujheJf0vwHKUpfbjhag&oe=6A32B330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6fJZmKmg6gQ7kNvwFXPYEC&_nc_oc=AdpSZIuzTJht5CdoAx4SJ6_szUfBHJStoS9I00gEIytKldYsK-BZeEdu9222ofHl54M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i0Qna96qoot4BDHAmOsjGrFffHTZRkR6xtNqu0hHPDQ&oe=6A329C34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
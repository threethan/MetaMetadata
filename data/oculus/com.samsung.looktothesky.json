bNOy5F3lfHDdV4EgIOjLSyWzDuMBLl_y1KwBQNobu_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzon8cEnMujmfhpIorvpYq1qsj9yNxXTglOkKh_6Nc2_Q&oe=69B55070"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zq6hGBGTmIQ7kNvwEfC7V1&_nc_oc=Adn8rk9mxNKwnAZENaeDvtlH3ro1NSZMiDwA5ks_zoyDyJjbmWO-AEpUdhxZoyFFSog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgNLboqJgQAG2aPXDaLpbi0m77F6FmYHSgQ2lei5Etsg&oe=69B56BC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaIV1KjJ6UEQ7kNvwHtIe7M&_nc_oc=AdlSA4fjhLfH0JjIZLonBvki7tBkIXATG7Sh0ZYOixZphKgWCgemWJap2WPEFXE7rdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI2uGyj3KlnKx0yqKb29lGlIAoM2nKbLNWuZjw9ej7JQ&oe=69B54A91"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG3OMiL7fVsQ7kNvwHpcRBA&_nc_oc=AdkeScz3rb9zpW0tZ2dcnJFJqd7iiDeMPrbU-eT6qKwsrWRlO6YS6Tg4-2EchELB8DM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCuWuc0P2s7UpjCrMrvz3fEf9vtl7CBNtZ55z_mTE7vA&oe=69B53C70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5tBdURkqW0Q7kNvwFSmbLJ&_nc_oc=AdlOjV3Ac67F7b7270UtqZ96nqd3ZcaKhhVXNPemaO7H-TTtoy_PXWggTnTb9ELAVb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyljv97NBbZQntM806a3MBmpeKD_N7f41D5VXLhnd2Zrw&oe=69B55DB4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
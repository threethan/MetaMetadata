7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YGF0NK7BM8Q7kNvwFCfZ6n&_nc_oc=AdoWi7mySEgKQaEGfdz5wbOs-aDhtd_vv6Hr3hJn5TnoswjiL3sZI8m_FXFI7vt3Vnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FaxKdMcMEGVU44wzC3Z9qY7kE_E_ovHifh028_nsWqg&oe=69EE00F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Eo-96YK7K8Q7kNvwHXHxjF&_nc_oc=Adq82-w7ycACNMM8ZXwj-iriEqpeBbDe44nAg9NCAbmCbgQ4V6cVKUjJJgLmCoUgh5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z3Lnzdv_ioWsOHukwVHs-i5If6vounRlMfPoAf9zzBA&oe=69EE1C40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwQMfJCFmBUQ7kNvwGiXOrj&_nc_oc=AdrefPBl7tscCa6QOb44y-tDN7Kri6dkbWXc3T8PUaPmEpJst1d8DDfk9aZYtdAT6hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QDd6zoTBFUQheUscxhBYn8iXdJRzC47KdIGOcizSFCg&oe=69EDFB11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjaEstOQ3z4Q7kNvwG6gQm8&_nc_oc=Adqsv1cRZE4oCXC-vG-Zs3-zqJr5GPojYktdJhpd5c7In-wWvnq_1jHemfoR0JszY_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dzlFJNf9unTvK200obAC7IJqTuzG2QP_EGZz1LCRqyw&oe=69EE2530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AobWHHccdgQ7kNvwGPkYza&_nc_oc=AdqG4-meocGg-IXa9orhAXsFZLVVmF8_x8h3x9lQBbYAXyP8rcifP-URVGMhQw0r7CA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FrQngNSvRmiVAHtll_RyONTpHpvBz5ucxntqgOO72kQ&oe=69EE0E34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
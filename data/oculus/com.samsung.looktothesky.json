7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuRv58zz80AQ7kNvwEFolOe&_nc_oc=Adp3PQgrm5QbRjcN3MQYKH-XUfmWBpOpvqEDT_I81wMoWwuefNAYPuCQ30uwl9-EDDo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3buOAI_9R0Cc4fpPRMQ_hWavjeeg8aqZgN7ab34jUPQ&oe=6A9FFB70"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWphpsXzMNIQ7kNvwHBYjgh&_nc_oc=AdrJIlyCsEPtVyb0aSjjZmKWvsXnmi_GCH0mKvnCmtvFyvL9ZmuDVAbxyywLTIwA52A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcott5HQG_R9Cg1lNNP4sgjNXEHbf44_6PKOrQbE7ZOg&oe=6AA016C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YczxfA9P5GAQ7kNvwHRAilF&_nc_oc=AdrxAMRjDE3bw_a6GkoMAAfb0eZelSFm40mUbh1U_-AYTtlsTMihw3JaLnpNYNXTCTk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHxzSILikpk-4LaaqQ25wZrOUBzS_m22hkpOApMm_nFg&oe=6AA02DD1"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbYIQ83Hp5oQ7kNvwGyOZrb&_nc_oc=AdqKrgRyfmmmdV3q5vtJAJwIkCiu1_mmh0T234l7IIpTnr6rf4voKcqckyQls0QJdyA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIhRZvT5s5Lmt3YpI7RJkwwOGBkmSIqToLJzY4dM_S5A&oe=6AA01FB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6y6ipjl5PgQ7kNvwGksgaI&_nc_oc=Adqs-_pOLGLBf2gq66yUc9HX_loMnrk0bWYf_HXiHUaTKS-HSkukwAAfakHB8mKed3w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIApZAlRxuYaP0JNmQrRh2kIrgDeUGCVOtiDilOiAGzaQ&oe=6AA008B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
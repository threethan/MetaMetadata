CMxXGM89YRTUDOkf4GmhJf0TdQZ7_DkGN0sdzm3_uH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPZQn_U1HceUs7yroHw0XvBtGaiUkRcYBSnEmE1UpPUA&oe=69B00A70"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi3dBc-9irAQ7kNvwFUf28M&_nc_oc=Adm02GElFy4-8RmFCD_oIND5XUhILTPTieOB6Z06ltSwincay8RRCCVXCSmRRlyFZqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc0lDR0iQn_R0osfnBFTAXh629bgX4ojYwrcvhS3KPmw&oe=69B025C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ0oCrvRIGMQ7kNvwFYpnQt&_nc_oc=AdkxfPK3FaKzXoAZuv-1uOxEDYrB9zFsdOiwv7CBZ1cTFMAoBx-rLm3H7MycrG1huNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD0QEj92OJy01XkrHJjN0aW2iOqLtzvZuwQD1fqnYeJQ&oe=69B00491"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bpSgGNb7_oQ7kNvwE26PTP&_nc_oc=AdlcEPIokGiHKwuhrg6bPT7ZRvlxNTD4GyUkoXWka9OTxbhUAyQKWkg5oExanUMcI8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9WMmtBLRsg9889ScKGTUdUHqEkZ7xnMjuRAJ2MnSOEQ&oe=69AFF670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZziOoaPhysQ7kNvwGGE3pV&_nc_oc=AdktVbthEqKbVH9ywrA4PzHpnAFK3eNDvD1Pk7_HLzq1r72ka5ZtzCHY5OMg7OJD9XE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5Mb9n34Q_rFEqkIBCCQQPdF7JQv7pHcB18K7LYygRWQ&oe=69B017B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ2Hn5Ug370Q7kNvwGMilnG&_nc_oc=Adr-3WS8yjOZVBdJ8E2jwAkTtC1iCrJeCgK9-B79XjP8XWZNJf38vQ1nAcirjDkRelw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vkmig4iJMfEKf9wXzcH2u8aA1H8QwugmYC0nIw5clAw&oe=6A0B01F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu7MK92jw7AQ7kNvwGzgs3O&_nc_oc=AdrgtLNFQk7hDyb8ynElJCYR6SsVNrkLcMsbXRbsT06h0GFXJJDka2Po_OVFxP5v_kY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xFNX_j5ur8hgVHjup0fBUBZvOQrH9KMNEcN8JfG5-MQ&oe=6A0B1D40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9ShP3R9iA8Q7kNvwFv4x83&_nc_oc=Adpc4opQ4PxcMn5-eZk1HmCr9qLuN9f6kLPCVjwNyKZY4YYTDA2eHcmDdaD9__NAcMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BuGt8oUW0josasyx-dYkgcN-OSKLQF6MF5ewZXn40Iw&oe=6A0B3451"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNaaAX1elnkQ7kNvwGWu_N6&_nc_oc=AdqjHfx3UZhCM5B0U79wVT7Eehnkc6EIO0i7WoCH6bKu8-k_uC1F0j3hZH6UdZk5FfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sQHFa9q0wthbpaloD8LQxf28BabKhi22-lf6zOvKFqQ&oe=6A0B2630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Pwaus0LQH4Q7kNvwFlu6fR&_nc_oc=AdrUPgAqJocezBRZleHGHrfz4f7G1xhIPhmQUieVfHRUvqR3t60phb6xZy6UdGZ4eqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59k28K8jl4zm2RCuj2OAMtk4-kDhvISQlROaAIXuHVvw&oe=6A0B0F34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
bqJ6-3e0yFn5GodnQ_yqyur6_tiu2ijI0AHF0x1BcFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_gCED7oOePvSKvfG3rv6L-wlKei4utnIX8nQI5edJOg&oe=69B7F370"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2icohq36wBoQ7kNvwFzohva&_nc_oc=Adlwu8cH2jLITUNAEJUgh_0lY3Q549nwa4w9u__HRe_HmJz7fSTp2ZSnKvw3M509ePc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzp4INSGZceAJzLtm4ffQ8Cqk3ik-B7L8Z7QFXkHbHIMw&oe=69B80EC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkm7Jb-nWakQ7kNvwExkhuQ&_nc_oc=AdmV-dxAiLjSD3qTG1gCrZxVqsFgzrquhiW8XPyBxNZgfHu22jNiO0ECx2-E_vKtE9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUiEXyGTZJQigR_fCb2Gg1WDxGhnxvtgW-idHpbuXOQA&oe=69B7ED91"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG3OMiL7fVsQ7kNvwHzBGUG&_nc_oc=AdmFK20phyzBgcSrXO0Mua_gJZEKw0FQ4Cx94KgopAEkhOTc-rUyqx2buQ7dGN2kRIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCBGS2UC8NqaGRxjuoEblYXj8t57gjeamaqqqYHOLOqQ&oe=69B7DF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5tBdURkqW0Q7kNvwHZX38n&_nc_oc=Adk_HNOPwT09yN9-kejwyWnFmQdrVLUjWQ4dRNnDPRmMmGnk5OltrizjziwDl8u3sXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afym6PTK_uqMy1Ji6h9POSAkCcB2mWhwwdzFZ3Y1DIaHuw&oe=69B800B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
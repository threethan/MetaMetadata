8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2EOGnHYLfgQ7kNvwF_lHAf&_nc_oc=AdlPcYzzpdQHGSFmbaaEMivB_6ESSh61KWYxdabKrEGP-gqICtVcy2NEOzffC_tlaws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs7EPT11wW4LquhFQsnAeLUmiLdBY_Mbu36YypM5v6TkQ&oe=69986242"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaqP03Rrb7YQ7kNvwGT9S6P&_nc_oc=AdkIX-mv5IY9D3p4p35Z_HiV5omVo2ZXkfaGxCPVMyFhnhmz6l8GN_HUouMkp35bHHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu3avWxE4WFNDSILpSP--Hvezj7gGMR56WhHopdi3c7bg&oe=69984F70"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyz4TY7eKZwQ7kNvwGDCjv0&_nc_oc=AdmFmggbJwqWgwMfjdzj0mjmc_ZjqfqPJ1-bxU32UNAYZh565Px-jywcMeElDVjcYg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvRcQaTEMfeOO0gREZCy-_T06ygPFWO60sb96autcSK3A&oe=69986AC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0HfXU_JZ1oQ7kNvwHcr-WZ&_nc_oc=AdniJJS2H7kEHjAUA7wuMjPEaeP0HDWFl-Ty6YgkjepdBn_EAuR8J3eeN79o6KiMDtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuPDrokO7zSSPpsTWeqQ_2L1SjFLLEYYSPDBXXPVHRqpQ&oe=69984991"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAPX-Pxt6OcQ7kNvwHaCoPS&_nc_oc=AdlJAU_VkZVvny4_VFICTfUgVdHb_L-dLY4C4mANkSwqqn9rIa9gwt4p53rus72zoa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsCG80h4eBfBrEbCnNVXje-VvpI36bCpAlwcWZpkgXapg&oe=69983B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAEI_gNNrpsQ7kNvwFryuV-&_nc_oc=Adn52do40pIvzHUo1Ix4X4uKzE1myklCKW778hDK-ki8hkHlPyF2Zn1ULSZG12enpPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuU0sCIqmho_A8PkBDEtpT3QrL-T5N7u0k6qIdcjK6Nzg&oe=69985CB4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
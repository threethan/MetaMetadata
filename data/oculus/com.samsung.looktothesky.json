8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QksGjXlrUBoQ7kNvwFJIZ7v&_nc_oc=AdmzXH_Equc2t4Ptr8mlk7DgZEeAhlKGMb_n2VJom2cIDTFnSpMrcfDrLjva7tW4ujc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudRp7fLU5g8ne9uBXNgyKRZXe0T-DgDXjE-nDNtJwmew&oe=6999B3C2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaqP03Rrb7YQ7kNvwE639dO&_nc_oc=AdkpOwDpOEeOT-MakbHIGT1Owm0aEur6ftNYjHfiF--cE2FsnuYhpL9-LgnESFGCyag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPu5cObCVrR0d5MNvsAAnOaV3aMzd3_8n2MBSJyz2Mcw&oe=6999A0F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyz4TY7eKZwQ7kNvwGyyz9T&_nc_oc=AdmS3yVzOkY6stbZAWSJQ8CHvk4Ri7ZP-avcKAEFGyexO8ikgeo3kgLTUum2U3y_GRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNZKeQV0k5J1wiAQdrSoPqZoYpfA8V3YqKQ_NvFzwQKQ&oe=6999BC40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0HfXU_JZ1oQ7kNvwE1akBG&_nc_oc=AdliLG70Mfk3976PJfI7VP4S-ZWlyrmaQ2we4_gokbIE8-Ox9Oj6DjbUrcPPwl1dTKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIDoKgVnYWu59TR3WY3H1nFOI10N4KifVQUHifHDWUOw&oe=69999B11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63ilzxapnl0Q7kNvwGd6t7x&_nc_oc=AdnLKm6ffsQ__MruZM8FYFz2pmcsBsM0e-f8poBmHJxtojLmuf3bXZZgqbjSYSjjdjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqpqL_paoaE70cAuieE5WQaLRDEtT7Fc-uGK1CcPcfxg&oe=69998CF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDVyOpamLdcQ7kNvwFdNSkZ&_nc_oc=AdmfyUO5dJOU65jH6CEpcXqRqbgE5_uOrn-fQ1eXlxcTLr6el8ZatWUTdYB3xfMq9iU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsISqukQwGArO6kPV5mluZ27MVBMjIu7UUADdB-r2L3mA&oe=6999AE34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
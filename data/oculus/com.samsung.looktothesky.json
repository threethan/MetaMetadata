8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MzmfWwkZv4Q7kNvwHWP6AX&_nc_oc=AdnUcinJvrcDYoT5m4RTKKFe7Zrvp-0wjlDYsJs_EoGo6PuheP2cL1nSms3mCYIJjmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsz3fu3GsdNRjuKNpgk7sipry3W035BnmKMXE1L0i4iqQ&oe=69A6E2C2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4sSm9DqEgoQ7kNvwEGMJbz&_nc_oc=Adl4qchGu-sgYTt_9VofXUS3rWTnbKMO2SiYHcg4gvwLBHfKF-mhtaa12I97KxWKl6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvmk8pYO66W8Yy2Iamm-5l-RWJeNT41P4ivmRIV3ISmBw&oe=69A6CFF0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoLGgHNhLRAQ7kNvwFIfiSj&_nc_oc=Adl4PI6QdFUkQCxNvWSPyhhfAvZLncyd1MtjTovBjR8O88zEZfVNqnq2OmXLtMAxKag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNbdlJNJgyWWcJzn-Eea8wGHZhU-paQtGYT2kkCTNkHQ&oe=69A6EB40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmYPxAcpwRAQ7kNvwE21tAS&_nc_oc=AdnYFiBFTaAkZ7fb6A9chaLz6zuQKQ6bcDjxvjtvYAHKrrj-q9tIoEO6yLIeGzXmPco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4TjMbcaUQp13A8xVYK69qgZmKCsGrO2WWno5A5p0bYg&oe=69A6CA11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMXoFwMPkMQ7kNvwH6IGOa&_nc_oc=Adn5WxcaHv5s-SN4S0WaWcMfXJPSVC6PUd2CR1dlZhvfvkt_qU5LKvOenrIXUJQbhsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuucAToDFyGBpdrjdk1t4-fse6yP2ke_8tiUpR1Lzfd7Q&oe=69A6F430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZovHQUZPLkQ7kNvwGNwQTA&_nc_oc=AdnIt1gjCUfjVlSJ_j0TmROfol3e5EpnoJha_hJlkdCBr6KHDeqywQHmc99viqorZM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsheOXiU2E6z-pApAnHtasoUNylnbqgWncX9fm5OpL7iw&oe=69A6DD34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
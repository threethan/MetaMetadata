: "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2uv7sJ-vmEQ7kNvwEAqzp3&_nc_oc=AdoKzpX0PG99fKO2nJgbtq7KpZsBqe49E-4okrIcj0W0BLr6-N5K9ftMZpQ-acETGEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3xuVGyP6uTj1IvzLEz37siWxTo7daR-96-1-vDNHCR-g&oe=69F0BF40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNPoukSQ-aIQ7kNvwHaI8TV&_nc_oc=AdpeSxsQk_5_ETgl1O4DWTzHaP3RzHpLgEZKVMtVjtT0hsVmpqF55OuFzHEbphJix5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0CrsN3s4bfEd9kAnRZNs0fBvoDlN7j0snbh1n4hZy3bQ&oe=69F09E11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr6-j9w4TXsQ7kNvwEbf7uQ&_nc_oc=AdoBVeRLs7SYiDdZ9827hVy5pzdCaTjU-4VV_Vvr4oVKMrhwNTJPKDeCXM69agmF4PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af25bo1fC3NOeCsYSSLJIe-XsOcSpCXpO4MFI5a6qG39Nw&oe=69F0C830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yub0X2GyQX8Q7kNvwGHUcu4&_nc_oc=Adrhh4L9B_xUZWBWbrckH4t9kv73j9gvYsRbx88qrvXIesAfd5nmeK0nunhWxV7zWmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2YtSwrHIkGf8GcBdnEt-OCikQkH2wsCBccCVwfkJH6Og&oe=69F0B134"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "216208543984506"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baselin
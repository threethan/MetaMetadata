7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu9xkW3K77EQ7kNvwHtBRji&_nc_oc=AdqIE6K8rPpNGlIjZ-ci5oO-OK_OGFwbmfoAo4_Ak703_QziE6k-3AWJUIbnwusvjFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcBz_E5LUjXX_wuiOFrIaW6PD5k5SewaqxIgTX3M6JIg&oe=6AEDFC30"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eETxeg7xf4UQ7kNvwFFFxtA&_nc_oc=AdrHRetFoaZZfCoCg8JlH6D_QqMFyya6eXcMeEhM5cEIT3evUhEeitgVH4tBcLqikqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfnuxtZGbg3epRHXPSaXMUuF4qlXzWUje_lwF7zKu_tQ&oe=6AEDDF40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQKDa8kQglwQ7kNvwGFhwj_&_nc_oc=AdqcuGuIxjERzW9WH8Wxlg2bL_ggXgW6JKkxofiiQbMiMb9PH8dvA9gWkjt5rK4kXFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbZ_CMi7RTsHEiBvkDFnbSNRurK7cOH1z7KsjtuLMoxQ&oe=6AEDF651"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6YLL5OUnq8Q7kNvwFHqSU4&_nc_oc=AdrooS3TVzurAlENXMI80QbkVySyJn47g9clekUD1TORa6p1gagtW06lnjJ0imvFr44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7UuqF41ktktJ64vfKcTdTzX39oezK0TTlJQEczz4-5A&oe=6AEDE830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IobGkDbURLkQ7kNvwF2PGNa&_nc_oc=AdpLuFYYEoosKusg_pNKJI9shpPgHxk5ECfMfVlA4bHY__9Ql1QkNoV6bfPmQDSBiwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToixe91W_XCksAplstdsncHZER5zaykjSv0QtzFGe0Qw&oe=6AEE0974"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
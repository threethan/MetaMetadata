8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QksGjXlrUBoQ7kNvwHBPZK5&_nc_oc=AdkZA1T08yYqqK65pXvfVPyyEAQTmYfzm5aGE_E8i8KZCSGbcBBlEhJ1U0pYfviMfbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAA6THKheUjmZHC2-nV-o7x_yaMmyloNBO-QSzb2VnJg&oe=699C56C2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAcgpNyug4sQ7kNvwEnuOtj&_nc_oc=Admy60vEkwTILg6zqPhKD6uCM4J3eFYdmkY_k3rADo9ZetAg4ZCX04fHLCg2Aj8x4H4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftjTohF0z8hcsPMTHbL4ptO5g6TNale2GuiiaXB-n99zQ&oe=699C43F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlbWJjII35wQ7kNvwFAbNnc&_nc_oc=AdkgoD5SbsU0p0PL3gXbyvOx_iZBG78SrfjxYuCbnl-fwxB9ZihRk801UDmPeSoTADI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIajagohwQjm2mNfAOED-elshmWkHuMlDIAkK6fRsnPg&oe=699C5F40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJSGTHipxfIQ7kNvwG37gtW&_nc_oc=AdnsoBmCYOs7LHrpfAlSEQFyiphBilNHmKXbBYckzlo0DvMAaUdQCKysXObbfBdeFeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuRTjXdzF1K8lnn8na7QoPZxaoPix5XVuNnVZP0WzkLIw&oe=699C3E11"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63ilzxapnl0Q7kNvwEDMpTb&_nc_oc=Adm-dMJZaTSWbVlasK2RXWmNiL63ccjBq_abBp7eUA2frqUo4riJBV_2jgzz0ZvplfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftS6c-pU0wmQWGtjd_tkFk6jI8LmtnxolPjFPuNNs5p8w&oe=699C6830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDVyOpamLdcQ7kNvwF6rFlb&_nc_oc=Admr92rYYmJwXLwzqRsmo7ZEe62FoHbnSkJydBdXf97tD5CMTXd5ap8HIvZdnRbRU3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aful1G1Sfmng5q-tBK08j5uiYDFw6L7qzZenjeGn_NZFIg&oe=699C5134"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
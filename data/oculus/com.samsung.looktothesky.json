bNd7jasw3YvX4i1ZU7ebwjv2C8MxMOAqUQBodzM1n-4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwx-a-I6vbuBnfjhBRoLM6qY5DVlqL4KyPeCpoNyhv55g&oe=69BA9670"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2icohq36wBoQ7kNvwEwGCB9&_nc_oc=Adk3QPi33SImiQdf3JyPtSOTimjRyWF2ORV-AEo9h7pkZkGANf87n_xtC_lfCuAaLYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWsTP8ZD4HI7-1roggSwsxYlwBAfm0YqSQh71dEj8W8w&oe=69BAB1C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkm7Jb-nWakQ7kNvwENehFF&_nc_oc=AdkDkoJWscf00UJ_5yE1n-MaCt8claISZQeo3KuANf_iWxt1sEEXGaT-J29Bc2mj4f0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4Jh0ya5nfnJhWowHr8s0XM3PGY5Gecj7Nuq96z_ZrWA&oe=69BA9091"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kGShqJ4r3oQ7kNvwEw8q0h&_nc_oc=AdkI5QNZwoZDdUgFcrjakdUnqINr08hozfQXSdFV5DL_Y6ktze1anqD02UF5nAc_6jI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5I_QTt4nh0LUPPLCc3NXQrDDhBZ61A1yd0edfVhb6Tw&oe=69BA8270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8oLJPdmV7IQ7kNvwEZJPVS&_nc_oc=Admwu2GG0zDL9ci5m-TL0zOhSRL62lKib3yaJqsW0Ehjg2EKzu-Oo7IYveHPugkp0mw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzkq0jZ_41r5PqhFKlXB1kdwPb3Rx4YLytRuFzPpM7T3g&oe=69BAA3B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
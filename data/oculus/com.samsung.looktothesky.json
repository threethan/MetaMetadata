yW1onlX2Bu98OVXeMVHDwoFgFb2cMD3HtqlvaS9OuXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvFuIV76Z3urb4SapDBj_3DgLOFbezY0PebBR2LwuyV1A&oe=69A82170"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIhsZnMiCAEQ7kNvwEUlHIl&_nc_oc=Adk-b2EPaU4ajMFrvku8SZfnHbFU5p_3RWc88MYnIl47zArUpFZnE67Iko9mO_PhJaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsv3PlaHMFqLVsdR3kCHgtRYepDVAwRpQhOV3vL7Tk_vw&oe=69A83CC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejNcuFLQ0tcQ7kNvwEXWqye&_nc_oc=AdnVvsQ0NhfC9hiUxOhqtQV881SlnzHnMoMVLQtwj1G3mq1d1xZg5J1LC8jK6p9RHSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft0hv6oEH0oOfG3CbdN2gNDrzzQT-MWDRFV5MsNA3KzaA&oe=69A81B91"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMXoFwMPkMQ7kNvwH9N83O&_nc_oc=AdlppnnKCRJTGGp_s1mFbjpMnpP4MYLO0t_Lbec4x1_KJA8-fxpkJgMb9iO36h8ltms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHdIeiDN8Bol2BSieGb7eRZYCZUWL3RLWAxXivRijB-A&oe=69A80D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZovHQUZPLkQ7kNvwF25YfS&_nc_oc=Adlmsyqj3e1Mc1fcfbjCLEUagMXdM8EVvebtWVwiAyeBjcnezGNLMAweu0tdvKhvkHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftr1Cg8gNDvK3tsUScg3lHgtVLNL6siWJVWNMAvodsdhw&oe=69A82EB4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
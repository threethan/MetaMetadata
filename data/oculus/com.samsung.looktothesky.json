8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MzmfWwkZv4Q7kNvwFhvnTm&_nc_oc=AdmUfg3cpgovb22NhoLmR_VsSbbJoETsiB8tvv_fjqCHfNNrg8NQmCbNG3jZiVcoW8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfseQbvysLlypogphAr2DSl2JYmLqbXWzIOywsA1-f69eQ&oe=69A59142"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4sSm9DqEgoQ7kNvwE5hYFu&_nc_oc=Adnp6ujtEo-cjL0AIYFoogdH762HsiPPhGWjkZMwhNTtbpzIGRGtUmD47FJh9fVd5Sk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftQdqnIVdBhc4RD_SkYzgGr4ce7UxeetuU9rUK6oZtnJg&oe=69A57E70"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoLGgHNhLRAQ7kNvwECYipg&_nc_oc=AdlAb7SUqrcpK5QOvro8RPjE_ohztyTk8WuZgscY147dkRhqOSfy40qWcOeOQBwDfl4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfueES-XVMpxq_uCtUr8f_R5MEuVSvpUzJ-9_DM6banamw&oe=69A599C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmYPxAcpwRAQ7kNvwHQdmge&_nc_oc=Adl0kwYs3FPLHXRSWtbpJmBpm4HWrXzaDC18yzV90rrR-7aIdyQGjTxOmtud6ZY9HEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs11xhJo9ic0U5dHUhdDTgAlZDOVEA3Xg37UAsK18q_6w&oe=69A57891"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMXoFwMPkMQ7kNvwHEi9Oy&_nc_oc=Adl7GKMTP5rSVJiK03YcgN1uW84CnsiuWSgpM5RZW8fCpOYyByl-cxliv54LyHs78Tk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs-mQcHtPgWHG4MVZVgLLTbYpYd4BXEQQF29mMfQ_xS6Q&oe=69A56A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZovHQUZPLkQ7kNvwH0PGhK&_nc_oc=Adm-njiJIghSvUa5wDco74DoV3pFxnhN-kTCb7AaWOho9QVMuOzefA1P2ekGgQYc79k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfugL3iapTv85M1lagDuu6wuuWDA0Q3ZP-vkIJKqM85a-g&oe=69A58BB4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
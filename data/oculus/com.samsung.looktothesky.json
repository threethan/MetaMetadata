P7qmqk3UUleK8uZVwQXU9K5KX_UG0Eb5-hbKspEuhAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfmMVvV42C601QT4vymH9b5j2IfGssvTZZ1Wb9RxgNXw&oe=69B3FEF0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zq6hGBGTmIQ7kNvwGhaUbP&_nc_oc=AdlQM0-CTEKmQrbLIKw30oinISFUo_RFSgqHQe4PFsx4Vd7C6q3QbiZBaI-eZdQPHYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyI-2vySMY5NTMoIHdgqU6KRyIfmcg7z-YmP4WlWcMISA&oe=69B41A40"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaIV1KjJ6UEQ7kNvwEyptLc&_nc_oc=AdlEVgPo1yGcfaAIdai1cZ6hF4gWvdIU8PLGoN7NkTYQn1FL2hPlq1ufxGqE-Lgm1R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfziCF7qxpT65L01Wa8lpozXUBSanpU9tFCvkLLAvcvY9A&oe=69B3F911"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxU54BI7b7IQ7kNvwH4Gao9&_nc_oc=AdlqPxpYK_zVQpe83t8v06kT-5aYrn98qwAQRnbk3J18SdzzTuYHIWD4UO4-1V1Xl08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy3SZDE5hvqrL0jHhTKU7KWuOwSjRBbMj8owFYl2rJKQ&oe=69B3EAF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONugU2nJbBkQ7kNvwEbQ6Qq&_nc_oc=AdmxAvAVe0KQUGPH00ilzZ6IZAzDmLldEQpT-o2cdDAI94z9wsc4j6377zJ7cd2r9Q4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUphqvN0jHh-zZaKkSE3e1CHprFU6iPJVAOIMDplYx4Q&oe=69B40C34"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
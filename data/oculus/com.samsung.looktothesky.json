7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rQZu8lmFjkQ7kNvwHUxB2l&_nc_oc=Adp7c00ihR4aXVppFZZN_zrXbfFnVSmxpKZI2hpr0mnHBOjRaUZgHFqWhNJeeqyy0G0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kobgo9cvRuvEidT983XLnMbyYQOy4bsWBn8Vz2YZ55g&oe=6A046A70"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0By6R_glX4Q7kNvwGqtdai&_nc_oc=AdqtjF97FJ7uLD7AVWFFIWJIQAj_ES6SZEL8aRakwoyYClIFuPA1Ry2ZjZOmfyHwkwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eq46tRCLFi3Zyi7cA0pG-3VVUkJ4aBs0COFp4O_EH3g&oe=6A0485C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5XVDLAvqmQQ7kNvwHtm8bK&_nc_oc=AdrOf4jBbzHuY4fF_iKpAwAa_sHyGCmIVxksiJcdhDk2Yd8eiLgVP55rk9fIPI3K8ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62iiMUo502A8UP3Q6Z3RjRMMp13X9ytBtBfvD8QPTDUA&oe=6A046491"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-lTwkef8VUQ7kNvwHxml1V&_nc_oc=AdrlBYJLgQXNqBdrJ_Q_rIboc2E1bIRxtGKMwxOJ90_A_Ihso46V8BfqQNcR-bcz8zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B_Q3-OZJGOZyUlMQ3sTbtyB1KwH7h1qrXDNW2XNSVgQ&oe=6A048EB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHWLtgoZGIMQ7kNvwGpUqoF&_nc_oc=AdpGoWZSRJ3U199fjwymY6_GNAZ6LTCUvuGX_woWKyHoZ5nvwZDeJ51pQJXMXgIviGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hy69hb4ArVDc63h7yneCT21z22xiUg3l9uQuF9U70LA&oe=6A0477B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
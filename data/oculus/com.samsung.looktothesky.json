8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ2IzFSxXFsQ7kNvwF2p5Vq&_nc_oc=AdkTG9sy48vSmo2TpPVnzZWcOAkrkNj6DZ_CSekqQJ0nU8mMj8APcbTIQOj9QoxZySU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvnsUyFhohIJfL3qYUhG--PguWfOieNTHmkAYooq3ROlA&oe=69A19CC2"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzoz7y1QfZUQ7kNvwFySKXT&_nc_oc=Adl2K85ushn42sMY3QTVGyxpKzMNyzkGcKIQhZ1_UKjeMkYQcNM65Zh3Wm0iUqww7LI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsiOB6nthuTvDmdTS_QRZ3ZkTII7R1q3Bhn7T7vrE_eMg&oe=69A189F0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLXPdx0HreYQ7kNvwF6nus3&_nc_oc=AdmFfrYTEIpNoKfv4MmrUE3xPDXzaEbysGpiYuIoZ9pFi8s39PzyhyRkyOqpFyy3CLg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuk_HYV2Q525NaAppRaHHlJcJMbJrB1cUsw_ItwbDuMew&oe=69A1A540"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K5NPLeBAsQ7kNvwHegjC7&_nc_oc=AdmL6oCe5wF65d-74Rpt4z5vgEC4qR0tFzOnPHywtx0NOGaj7PT6sK_PPnk-OFd8Hyk&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfswTNxre1htjKbpLxLj6f6gFo2YaCoUFZmnd2yG0kIrHA&oe=69A18411"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYM2915hxEgQ7kNvwEq_fa9&_nc_oc=AdmsUyPVNcreMngdlcXeIu0tv0xRM6ATCdDiC60Q9CkaqmOdZyzVijs7IS7X88htppo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsBfb9u9GknS7bZCn1zG6UkjJFeXpJEQzulsQLauJIudg&oe=69A175F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaxpbm5yf4UQ7kNvwFJO9Gz&_nc_oc=AdnC9QC0ELqamb4MqQCyzZgZITtp5GG5Icoaxc0nqKl_1UIUgnwDZKRzjsu-fRfNcI8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv6iM6tYmYsxZYQcC2uZBTudgKzEFvkwPD-cpSpJjQF8g&oe=69A19734"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
6AFF19D1"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX_khKh4froQ7kNvwGnLm_i&_nc_oc=AdoZM39b4eVTAyLdG2QQayZdktWHT67hr2ywK_5_zeR8s5bGIbiN9hB-9SX_MbzqUDY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsWGLoggQ15ENKUWUgeRlPipL21eomK9vFOBb3lAgc7w&oe=6AFF0BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw7BsDrwOPwQ7kNvwGAEDPw&_nc_oc=Adp2XyoFrCvp1yG_3BA-l0HyBUq7Pir4kmv89G6fdmk1OuEr9mTBrGSB1r1rwX0v6NA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVxh6K1bJ7bCeMjgB034lCqIFYISXTXJW9jZGbO8D3FA&oe=6AFF2CF4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "216208543984506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_1278237395608328_3825083266633826304_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA3nU-5qi5AQ7kNvwGacA51&_nc_oc=AdpP9_PyeH-IvM1D6NN3AIFIAMKFulKA8muaNvm1D2Xx2nPXjNuH5PVQDG-378SwkTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp0PWmDXgtqX4kI98pT69eSSgbigh3u8dzSN6Ku8pxEQ&oe=6AFF293B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Look To The Sky", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504109911, "lastRevision": {"nodes": [{"id": "1902002840039549", "release_type": "SCHEDULED", "administration_sta
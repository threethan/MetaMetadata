8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBvkD9mxL8wQ7kNvwFKpjQ7&_nc_oc=AdnACkUUovjSLIjZ3V_t_bp7BaNzPQ9uYfYaOUF5Q0gyHL2l35USmo8OkmFjP1DwwLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmVbrkRRAti2Z-8nChpim8_ll-JnJFulJ5WYiskzGJ7Q&oe=69A04B42"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzoz7y1QfZUQ7kNvwEQ2KbH&_nc_oc=AdmuLGBPjoTokfRiTtH00uXxcQG-DiZvWQqOjs45dDTKxxdKBgzNheoIABy5O18K1YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvY9fUoDwjx0-kLKqJTYo7bstnJNUOt5SrQ5gCwZ-gsgA&oe=69A03870"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLXPdx0HreYQ7kNvwGy-NRT&_nc_oc=Adlnq66AYq-4-SsMcLtUh_pN5tJgOs5DquFEHtFNq5RF8aF6zADySMKUtv0qJnsvH_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYPRrUmQJbLdAyDSo2_eyg_25rNmNTscCaSBRN4SsIHQ&oe=69A053C0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4K5NPLeBAsQ7kNvwEiYp49&_nc_oc=AdlKNEXk8kRkiXfA52ZsT2yjANUFw68gq1TGR4s0WarKd9tYuvE4hjc_HPOIzlWB98k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshGXfU4DydKxyS7JpnQt6uD-93c9PheVOeZiWdpNkSLg&oe=69A03291"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5b_UagOcY4Q7kNvwGCXcC6&_nc_oc=AdnsnrrEhALZ9B7k5x8wVr4k1P3Mf5V1NTRU13-_NBQIHpze7Rnd54zaafV-wBlBkLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUv2fM2p-pcQyWVDNKTDLdxU7YdfI4_GrsLUYjxNKr0w&oe=69A02470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlOc_hCN1RIQ7kNvwHvSPGA&_nc_oc=Adkq4Attsd5Zf_izDOGyhZz1zxy3GH6EqI1jZE1RwNZAdkrqAb3CQ5aCYxNDnm9ns-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQN4cDazbrTxVxtSYDbdhnRFaQEeu5M2jgld6jS3fB5g&oe=69A045B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
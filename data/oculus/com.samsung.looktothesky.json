ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqDQQO-BR_UQ7kNvwHNze34&_nc_oc=AdpnLU1qu7eh_np1I7Um1VjlkRW_j_rtK_DeVNR-MoxtOtUKZnyxxj9SURN-6X6BJto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR72RyV6iNo6m2Hee_p6kyXrrbZAPpUuehmdW-Nijnd3g&oe=6B0B2170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdXSVYSEgpUQ7kNvwE7rJaJ&_nc_oc=AdqQzUEc5bUev8R9UkdF5DWvMK764V9EECm_ifzmOX6ubpQ2ANv7poEOByfhDrbrtQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPdhJ0h0xgmqEb-0gbibBe4YR16RnRva75EkFMB4Lb4w&oe=6B0B42B4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "216208543984506"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1694239884035855", "version": "1.2.8"}, "id": "1726972127317689", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236186189841229", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1694239884035855"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1726972127317689"}]}, "change_log": "API Level Maximum", "created_date": 1536073525, "id": "1694239884035855", "version": "1.2.8", "version_code": 1208, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}
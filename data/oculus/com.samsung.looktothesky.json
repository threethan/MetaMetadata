7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uYXr4DhUncQ7kNvwHgZJrX&_nc_oc=AdqUSZDuLOxQnoakDmyheYwjnL9jrXh4gytK4mKX7I5qWt5jnRGfXC5UEaEvFj5IqSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCmJo4K95V6PUcqtqDbCUPlaPiUcWgNwMPbPHKndKJTA&oe=6A5A1BF0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bskrHw2bllMQ7kNvwEvQeZN&_nc_oc=AdoG6Jo8JmZSNzLnS7U2wWERjQnU6IAhplTqU7yjV6SUTRFo8xAMRPHonic-zVMIyBA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTtYsv7mP2EwGknJqGluZs_Z0wjDBNqy9vCiutOOF87Q&oe=6A5A3740"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTar5BKTQl0Q7kNvwGZJgTI&_nc_oc=AdoI8nmFh1ccI5E_c997QXDXv1yDBlREM9asZoGWdWpnSx9-74t6wt66teFmiU7yqLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFdshXi-xpJG0dcFr00G2RmEitkE4kO9nEdkrTBIthHA&oe=6A5A1611"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63T1UfNncEcQ7kNvwF9P-_0&_nc_oc=AdrG4tWLbNKpAEyUL1Ty9TF7cxSkwPWw82RIVN0oItvJ5smBtJunWvHEUWenwjLQosE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwwtmJQDdNQddZ-1t0QvVdicbYQRz3p_n40uspsCFJQQ&oe=6A5A4030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ru3ULU2qYoQ7kNvwHoIjsQ&_nc_oc=AdqKmiUd09ptgc9OOdBrtQ6NIu7cfeQn-OeX0GheFnzdLzyeblTy6XQLkMjOiX11-qM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXjO4ZnHGxlrWwlUrZjKHw6g_XzyUfiAcMgxkaUYhP5Q&oe=6A5A2934"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
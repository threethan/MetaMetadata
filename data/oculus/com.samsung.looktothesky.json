7&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCHJzYDQ-ngQ7kNvwFtFz8Q&_nc_oc=AdqHqfKAbTjfq9Zzhr5taHazjMAv3Il1eC691R4MiXpTAr4xdQpFuEG-hCoWHcSVdxo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuKERcFSJQg22XpyEj9f_O0Ro06JvCmRAQ99RHguRIbQ&oe=6A917AF0"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lO0gTgv2Q4Q7kNvwF9kans&_nc_oc=AdpP1O1tWdk6NQgqMTSRz-c9P9WigLmAYoYZgQm0RuXMyndvvRmRYoTxY-FtrdNuxKg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHID2U6R0KweB9ejtaRghtw91JfMXHz40wMwdSwQvmGJA&oe=6A915E00"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-spw8LDDjsQ7kNvwHa6Kt9&_nc_oc=AdpCg61CeRG8_C5SBHg4cCcCGbVp35wswSabLsMgginOqQEaYg4-4h6tt70xhBZqXos&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDjOp-rhNPSAM0-G5e_P7BzYRugti1O9lJ4a_YagCFMw&oe=6A917511"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDM3EuzA6v4Q7kNvwFkVBv1&_nc_oc=AdrqfefU_qMt8LS-mAJ3sL2c-af5g1J56VI_7aCQWj0NGJ1BEeqeELwZ8ulkLEXN6YU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5XsQCP-NBWLO8JnugtxmXf9GtvX0VWp32O2VP4gAZkw&oe=6A9166F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPfhc5VdcjQQ7kNvwFf4P8c&_nc_oc=Adrnq-wGvRSRiqiQBPU_c7vxAkqaYrBuGPVIpAFjoPoMid_WcOkV4gfE9z3J4-0lsj0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOmFrQrfOtc7H4oJ9p7LHisumyLrbkSoZHal4mjdyDnw&oe=6A918834"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.html", "publisher_name": "SIDIA", "support_website_url": null, "website_url": "http://looktothesky.sidialab.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended
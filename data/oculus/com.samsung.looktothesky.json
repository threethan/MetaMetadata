8_835842563223187_8306678750049730560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QksGjXlrUBoQ7kNvwG1Z71a&_nc_oc=AdlWnr-siih0w3aWGA2X03hLrHj6kz3H_93PoJIV_s-XiVJh_SUgIvc2ybgwhP4IhxA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsO5YurITvC4pPv30Ee9wqF07ikBFmRL3XE7DGn6JJ1rA&oe=699B0542"}, {"file_name": "migrated_image.png", "id": "632499514269715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162675_278039229329045_4986470808911085568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaqP03Rrb7YQ7kNvwHGdOAQ&_nc_oc=Adl7Oaka07hjdK-jftFnwV_6h-taXkhu0m7mhWSx-ZXxOGBLjkaVStXQHy7E8zWDsDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqBAwNhwxGTK55ZIIY_i_QgC0AeLo65Jb-4C0csr_r9Q&oe=699AF270"}, {"file_name": "migrated_image.png", "id": "877697382654885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162698_313514219093013_5946213321723084800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyz4TY7eKZwQ7kNvwHi-1rD&_nc_oc=AdkFcETjqEP0kiE_uSZNYuVyo-BENvPUkZRrV9mNsdjPIoWXbVNQAVxQkAo0gDo6cwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfswUOdS-sv5v5cLM5wDfeNDhyomkYCnfngNK9uJEVBgvw&oe=699B0DC0"}, {"file_name": "migrated_image.png", "id": "254096412274082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_321489884939974_229381696334594048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0HfXU_JZ1oQ7kNvwGUOyjo&_nc_oc=AdndC4OgQTV8IsYLgE21RERHPteMjkeVB5w09hn1GWHdx4LpNJL3YyJMDR0A_DBFQ4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft3kJOInZY6Rr_dblcSw4hjzxYNZB2GrdUrREQx6Kj_Tg&oe=699AEC91"}, {"file_name": "migrated_image.png", "id": "457980911585675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162721_327996114289948_3054077533956866048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63ilzxapnl0Q7kNvwFfbllK&_nc_oc=AdlP6d10Y9fgD1yc5sA2DW0DrwwDdWhSY3E-zlS72nLOwSzuBUlUmONttX3VBfhz2l0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvNmwfYtSPt7LBcGbabiPmHEJfW7lvgwMaz4_vyrQ5wFg&oe=699ADE70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "108445756507435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_108445759840768_1742313471430623232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDVyOpamLdcQ7kNvwHYiVPY&_nc_oc=AdmPV-FZ4uSTRCNFt4aI6AcpZ9ZAMaAk2rzwxqj7gtK6-X6ZBpDJFp6-EEkKSOg4WcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvLlbebCsdKoesPXV6Quv8o_3Un7ynMOQb7uQyPoRUf-g&oe=699AFFB4"}, "display_name": "Look To The Sky", "keywords": ["Sky", "Relax", "NIght", "Stars"], "long_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location.\n\nThe app start with a fade in and after that the user can see an avatar  looking to a green field.\nAt this moment the user can look around to get used to the scene.\nA HUD appears with some options.\n\nSelecting START the user \u201cembodies\u201d the avatar and walk slowly until reaches the tree.\nThen a HUD appears asking them to\nlay down (in the real world).\nUser can look up instead of lay down or configure to seated in the settings menu.\n\nAfter laying down the camera moves showing the night sky full of stars.\nSome HUD with latitude and longitude coordinates is displayed also, so the user can locate themself.\nP.S. if the user look to their side it\u2019ll be possible to see the grass and fireflies.\nAn ambient music is also playing to provide a very enjoyable experience.", "short_description": "Look to the Sky is an app concept to be developed with GVRF to consume a content provider (sky map) giving to users a view of the night sky.\nSo the user can look at the stars according to their location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://looktothesky.sidialab.com/eula.html", "developer_terms_of_service_url": "http://looktothesky.sidialab.com/eula.htm
 VR", "keywords": [], "long_description": "Learn about some of the University of Birmingham's Nobel Prize winning discoveries in VR. Step inside an animal cell and uncover the genes that regulate the cell cycle, find out what a doughnut and a coffee mug have in common, or see how molecular computer chip is formed.\n\nThis application also contains two mini-games designed to help you learn how to use your controllers. These games involve interactivity such as grabbing, throwing, and controlling a vehicle with your joysticks.", "short_description": "Introduction to virtual reality at the University of Birmingham Dubai."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elmdonstudios.com/uobvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Elmdon Studios Ltd", "support_website_url": null, "website_url": "https://www.elmdonstudios.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "545068677277751"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340706_573549190851429_8366617655864295247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuSVtgEtJkEQ7kNvwFpSH-l&_nc_oc=AdoXcels6qPdXoBZF-3Qth8odAmHDhv78pCUvOP122SWuKt1mqTgzfecwI9GSwnBEug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=0
 evil Easter Baron Bozo. The Chocolate Egg Factory has been taken over by Bozo and is being used to create chocolate mutants which are sent out into the villages to steal all of the Easter eggs and ruin Easter for everyone. Using your Oculus Go or Gear VR Headset and controller, you must put a stop to Bozo and his mutant minions and save Easter!\n\nThis is an On-Rails Virtual Reality Multiplayer Game, where you use the Oculus Go or Gear VR Headset and controller to play.", "short_description": "A Multiplayer Adventure where you must save Easter!"}]}, "developer_name": "DevCleverLimited", "developer_privacy_policy_url": "https://www.devclever.co.uk/privacy-policy/", "developer_terms_of_service_url": "https://www.devclever.co.uk/", "publisher_name": "DevCleverLimited", "support_website_url": "https://www.devclever.co.uk/", "website_url": "https://www.devclever.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "334143465289083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003236_367740557161651_4500228039388430336_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNmvx_Uk-EIQ7kNvwFRV6hp&_nc_oc=AdlLk3F4pPTL5AMbphpOsnRSd98gWZWTe1Yfs8TyiRy7lEOGvTDBxjdtYjNH7Ggf_gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-uRTPBHv8rnWRvOQ_QzqmuM7GaGJKNsivPbtHbVX3wg&oe=69A43665"}, "is_concept": false, "is_test": false, "is_trial
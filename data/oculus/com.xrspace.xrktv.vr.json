4.5771-25/39036670_3972111626210012_8202621689105994921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04EPP-5UWHsQ7kNvwHAkMA-&_nc_oc=AdqNjHqziS834sNsx6RZ2pUDpTd5RNGvXHzu5XY62XYwajfDHJUAmfMvSkx428RrfVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB1raY2onY9kUO9kdxNKwr2yzUGvH9Ed9Qmc1JnyjX9Q&oe=6B05B6F3"}, {"file_name": "space_01 (1).png", "id": "695160908341259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974505_695160911674592_1890238264363433229_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQlr9kRSdRMQ7kNvwGfZPfu&_nc_oc=AdpPlGjpX9jQefk4tVxAXX2rjtt6ZIdTz7ZAS-ccIJCmuS2AVRIi22kgjQAEZ3VYEvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh8G4N0PV_tv7NyjKe_ttsqFtk82N0pnuy8A_QrCWGhg&oe=6B05A1A7"}, {"file_name": "roof_01 (1).png", "id": "354291156613496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_354291159946829_2782231998869954631_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr4ZQ6Og3qsQ7kNvwExJ0Ml&_nc_oc=Adrf7f4hG40ILDlGu6K8uZ39oifvg0yWFYErnggQUslZ_s0NT38mwKEANGk-8T84jB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZN7Y8-wLaJHBKxPp6Qla4Wwwy4ZdX-3V28ThPEZeWkA&oe=6B05BF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PartyOn_720.png", "id": "928293497880027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_928293501213360_2054420028608923983_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FinWCuJTBmIQ7kNvwGh8GXc&_nc_oc=AdqvRycGxQHe66_TLVfsHscmK8Uhw3JgRh1CW4J_dc_XSIGR3M0Jkh7ZQAQAz7Tx9KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMKQQZuV_DBxtNUIlkwG_8oiXjjkbkqZ30PJiXq_u6qQ&oe=6B05C4BB"}, "display_name": "PartyOn", "keywords": [], "long_description": "Join the best virtual music party ever. Sing like a star in the most interactive online karaoke.\n\nPartyOn is a virtual music event app. In PartyOn, users from all over the world can hold various music events, from sing-along parties to concerts with thousands of people.\n\nUnique Features: \n\nAwesome Lively Avatars \nCustomize your own full-body 3D avatar like a true rock star! Comes with a range of facial expressions and gestures.\n\nImmersive and Gorgeous Virtual Rooms \nSing your heart out from nightclubs to outer space. Ignite that party mood in places unimaginable. \n\nSelection of Music and MV Content \nTop popular karaoke songs by the hundreds, infused with virtual super-effects and avatar animations to blast your senses to the stars. \n\nReal-Time Social Interactions \nSophisticated audio systems for truly one-of-a-kind party spaces, chat and interact with fun and wonky objects/emojis as you enjoy live singing from around the globe. \n\nMore awesomeness coming up!\n", "short_description": "Join the best virtual music party ever. Sing like a star in the most interactive online karaoke.\n\nPartyOn is a virtual music event app. Experience virtual parties like never before with live karaoke sessions and real-time chats. All packed inside the PartyOn. Create virtual rooms, invite friends, or jump into random spaces hosted by party and music aficionados around the world. Never go out when there's PartyOn! "}, {"images": {"nodes": []}, "id": "308736748673147", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PartyOn", "keywords": [], "long_description": "\u53c3\u52a0\u524d\u6240\u672a\u6709\u7684\u865b\u64ec\u97f3\u6a02\u6d3e\u5c0d\uff0c\u5531\u804a\u6700\u597d\u73a9\u7684\u7dda\u4e0aKTV\uff01\n\nPartyOn \u662f\u4e00\u6b3e\u865b\u64ec\u7dda\u4e0a\u97f3\u6a02\u6d3b\u52d5\u5e73\u53f0\u3002\u5728 PartyOn\uff0c\u4efb\u4f55\u4eba\u90fd\u53ef\u4ee5\u8207\u4e16\u754c\u5404\u5730\u7684\u670b\u53cb\u5011\u4e00\u8d77\u8209\u8fa8\u97f3\u6a02\u6d3b\u52d5\uff0c\u4e0d\u7ba1\u662f\u670b\u53cb\u9593\u7684\u6b61\u5531\u6d3e\u5c0d\u6216\u662f\u842c\u4eba\u540c\u6b61\u7684\u6f14\u5531\u6703\u3002\u5982\u540c\u9762\u5c0d\u9762\u822c\u7684\u4e92\u52d5\uff0c\u8fd1\u4e4e\u771f\u5be6\u7684\u611f\u53d7\uff0c\u662f\u8d85\u8d8a\u73fe\u6709\u793e\u7fa4\u548c\u76f4\u64ad\u5e73\u53f0\u7684\u5168\u65b0\u9ad4\u9a57\u3002\n\n\u7279\u8272\u529f\u80fd\uff1a\n\n\u3010\u751f\u52d5\u865b\u64ec\u5316\u8eab\u5f62\u8c61\u3011\n\u5ba2\u88fd\u7cbe\u7f8e\u7684\u865b\u64ec\u5316\u8eab\uff0c\u5f9e\u982d\u5230\u8173\u81ea\u7531\u88dd\u626e\u4f60\u7684\u660e\u661f\u98a8\u683c\uff0c\u4ee5\u751f\u52d5\u7684\u80a2\u9ad4\u548c\u8868\u60c5\uff0c\u5728\u97f3\u6a02\u4e2d\u5c55\u73fe\u81ea\u6211\u3002\n\n\u3010\u6c89\u6d78\u83ef\u9e97\u865b\u64ec\u7a7a\u9593\u3011\n\u60f3\u5728 Disco \u821e\u5ef3\u4f86\u9996\u6292\u60c5\u6b4c\uff0c\u9084\u662f\u98db\u4e0a\u592a\u7a7a\u76e1\u60c5\u5636\u543c\uff1f\u63a2\u7d22\u8d85\u73fe\u5be6\u7684\u865b\u64ec\u6d3e\u5c0d\u5834\u666f\uff0c\u5728\u60f3\u50cf\u4e0d\u5230\u7684\u5730\u65b9\u9ad8\u6b4c\u4e00\u66f2\u3002\n\n\u3010\u5b8c\u7f8e\u6b4c\u55ae\u7531\u4f60\u6253\u9020\u3011\n\u628a\u4f60\u6700\u62ff\u624b\u7684\u6b4c\u66f2\u900f\u904e\u624b\u6a5f App \u81ea\u52d5\u540c\u6b65\u9032 VR \u7684 KTV \u6b4c\u55ae\uff0c\u4e0a\u5104\u9996\u570b\u5167\u5916\u97f3\u6a02\uff0c\u53ea\u6709\u60f3\u4e0d\u5230\uff0c\u6c92\u6709\u627e\u4e0d\u5230\uff01\n\n\u3010\u7d30\u81a9\u97f3\u8cea\u548c\u81ea\u9078 MV\u3011\n\u6f14\u5531\u8005\u7684\u6b4c\u8072\u7686\u7d93\u904e\u7d30\u81a9\u7684\u7f8e\u8072\u8655\u7406\uff0c\u81ea\u7136\u52d5\u807d\u3002\u87a2\u5e55\u756b\u9762\u9664\u4e86\u6388\u6b0a MV\uff0c\u9084\u53ef\u81ea\u9078\u52d5\u614b\u96fb\u5b50\u7279\u6548\u6216\u5c07\u865b\u64ec\u5316\u8eab\u8868\u6f14\u6295\u4e0a\u5927\u87a2\u5e55\u3002\n\n\u3010\u55ae\u4eba\u591a\u4eba\u90fd\u597d\u73a9\u3011\n\u9664\u4e86\u6d3e\u5c0d\u5305\u5ec2\uff0cPartyOn \u4e5f\u63d0\u4f9b\u55ae\u4eba\u7df4\u6b4c\u623f\u7d66\u96a8\u6642\u96a8\u5730\u60f3\u4e00\u5c55\u6b4c\u5589\u7684\u73a9\u5bb6\u3002\u60f3\u5531\u6b4c\uff0c\u6709\u4f34\u6c92\u4f34\u90fd\u904e\u766e\uff01\n\n\u3010\u5373\u6642\u793e\u4ea4\u4e92\u52d5\u3011\n\u96d9\u8072\u9053\u7cfb\u7d71\u5c07\u6f14\u5531\u8005\u548c\u5176\u4ed6\u53c3\u8207\u8005\u7684\u8072\u97f3\u5206\u958b\u8655\u7406\uff0c\u8b93\u4f60\u6b23\u8cde\u7f8e\u5999\u97f3\u6a02\u4e4b\u9918\uff0c\u4e5f\u80fd\u8ddf\u9694\u58c1\u7684\u804a\u4e0a\u5e7e\u53e5\u3002\u7528\u87a2\u5149\u68d2\u7b49\u591a\u5143\u4e92\u52d5\u7269\u4ef6\u548c\u670b\u53cb\u4e00\u8d77\u7092\u71b1\u6c23\u6c1b\uff0c\u5373\u6642\u8868\u9054\u5fc3\u60c5\uff01", "short_description": "\u53c3\u52a0\u524d\u6240\u672a\u6709\u7684\u865b\u64ec\u97f3\u6a02\u6d3e\u5c0d\uff0c\u5531\u804a\u6700\u597d\u73a9\u7684\u7dda\u4e0aKTV\uff01\n\nPartyOn \u662f\u4e00\u6b3e\u865b\u64ec\u7dda\u4e0a\u97f3\u6a02\u6d3b\u52d5\u5e73\u53f0\u3002\u5728 PartyOn\uff0c\u4efb\u4f55\u4eba\u90fd\u53ef\u4ee5\u8207\u4e16\u754c\u5404\u5730\u7684\u670b\u53cb\u5011\u4e00\u8d77\u8209\u8fa8\u97f3\u6a02\u6d3b\u52d5\uff0c\u4e0d\u7ba1\u662f\u670b\u53cb\u9593\u7684\u6b61\u5531\u6d3e\u5c0d\u6216\u662f\u842c\u4eba\u540c\u6b61\u7684\u6f14\u5531\u6703\u3002\u5982\u540c\u9762\u5c0d\u9762\u822c\u7684\u4e92\u52d5\uff0c\u8fd1\u4e4e\u771f\u5be6\u7684\u611f\u53d7\uff0c\u662f\u8d85\u8d8a\u73fe\u6709\u793e\u7fa4\u548c\u76f4\u64ad\u5e73\u53f0\u7684\u5168\u65b0\u9ad4\u9a57\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrspace.io/us/legal/partyon/privacy_policy", "developer_terms_of_service_url": "https://www.xrspace.io/us/legal/partyon/terms_of_use", "publisher_name": "XRSPACE", "support_website_url": null, "website_url": "https://www.xrspace.io/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommend
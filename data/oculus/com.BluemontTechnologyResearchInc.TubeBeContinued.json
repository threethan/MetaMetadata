_name": "TBC_BB_Screenshot1.png", "id": "1416454555595557", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031620_1416454558928890_6571955765539591451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG3eRa8_w-cQ7kNvwGPZll6&_nc_oc=AdowMQLa-6e_V2SoewUaGaQ1NBtxo41hCFUV_zyPm7Ic4uucmwVYZ8JK4gva1tM85-c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_mnfhP4lgKNM2SKcIrju67SYdIh5QhwyXKHaAh-BF3Q&oe=6AA934BA"}, {"file_name": "TBC_Screenshot_4.png", "id": "1512593585926048", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86659795_1512593592592714_3017758545978518425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUwwILQDIzsQ7kNvwHNdxB_&_nc_oc=Adq8t01WvL89I5sm4Sqys_7aK-xznJXjofiYVc1A-EGAUOAUtDhbEGuurlawy6psI6s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhHOvwze97kzOFF1YEm0HwXHlyqhPjDMNQq-mqLXHLdw&oe=6AA95AF8"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "610644550871736", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57568679_610644554205069_6546097349031153076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6JAfWT4_kMQ7kNvwHrwIOk&_nc_oc=Adq0fcigQUU5acW9oiud_UnaVoVGrCb3AT4LgwGWm6GzXNcTcRCpSpA6YOZhbF965rg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRs6wg3MVM8XFvBaGCexReYatTH_wulRgxmoUUcW0xMA&oe=6AA93957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_LandscapeDemo.png", "id": "799202501382844", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982567_799202504716177_5159505871863248409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y8xEwBqfSEQ7kNvwH-6F-u&_nc_oc=AdqMgpK8uifHTEwwJD6crqALoBhtWIG1ml1G7-00snJ0QuHJJ3S_uKWR8PwG1MKTIv0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvedy9hYE0QvY4hgfax2uh4WmYuNKGwDWc_hovVWbkgg&oe=6AA94CD9"}, "display_name": "Tube Be Continued Demo", "keywords": [], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nThis is only a demo, but the full game contains the following TUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for Tube-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_ap
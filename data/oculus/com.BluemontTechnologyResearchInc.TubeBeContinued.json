620_1416454558928890_6571955765539591451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W88upVj1nKwQ7kNvwEa42Fd&_nc_oc=AdkdDAYBDrDgipyzY6XGZElzIvRtgjEPB2HnzIyP5Jj2yQE9-ufErKEK3ENHnXcF45o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOJiyf5wx6P2YSvquQzQJ6PUaJF3CZh4Cn5A9EFWvkqg&oe=69999FBA"}, {"file_name": "TBC_Screenshot_4.png", "id": "1512593585926048", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86659795_1512593592592714_3017758545978518425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWcNIeTyJ18Q7kNvwHD0jdO&_nc_oc=AdnRnthl-QAcqFj7pRrs_TPhgEc8zCbmIYaXA9cgF_D09ieMmFgg67GW41Tin-tilXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuh23--09IIO7ksIcxzlpM_KA7M9XaOl4u6o-alNBmerQ&oe=69998DB8"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "610644550871736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568679_610644554205069_6546097349031153076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWLfsgPYV5MQ7kNvwF-LVkv&_nc_oc=AdmleOCyLusyV5R0bG-CMDgpg2cH8eWokgqeR5G-kOs3F9Vup1xz1xAxI625phEMbwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6QNXfLxyet1GcrhTTdssPObSCnF_X18eo8gtEay4UDA&oe=6999A457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_LandscapeDemo.png", "id": "799202501382844", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982567_799202504716177_5159505871863248409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJ8PqXXis8Q7kNvwG9goiN&_nc_oc=Adm684HqQAN4XOw-0kHi4Zei8TQ6yx8xbp-Uz1D0zXVpm0bH5xrTAPfu4wedQ1prg8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWaUgNhVS6WVxEUaopNY3NxEpkHZxb5xp3HK4mJ9jj2g&oe=6999B7D9"}, "display_name": "Tube Be Continued Demo", "keywords": [], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nThis is only a demo, but the full game contains the following TUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for Tube-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
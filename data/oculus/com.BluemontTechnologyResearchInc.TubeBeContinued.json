6454555595557", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031620_1416454558928890_6571955765539591451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BgB5vrv9AYQ7kNvwFFYB9V&_nc_oc=Adnhws2NgDlo3wW8XtdbCiskuI-nvs9cevj4VAc5Sc7IN4PJ8EuSmAxh5QSosRJO05o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz77rNNfqlB3kl5DrA9XLWXZatXYCtZE69xE_D7btx-vA&oe=69AC14BA"}, {"file_name": "TBC_Screenshot_4.png", "id": "1512593585926048", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86659795_1512593592592714_3017758545978518425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T56HaQ9jFMQQ7kNvwFCjVje&_nc_oc=AdkX1uXM1dsMYJrI_hLepKMLPSkXKWnFhuKKFkp-B0f705PWVgnqeoQ3rDd-jm-wIsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzsckwX34x8Ypv0d82M6S7A0Hzof9gJKOhSxHknFxvjkw&oe=69AC02B8"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "610644550871736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568679_610644554205069_6546097349031153076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhvY9HrcfScQ7kNvwH2MeYf&_nc_oc=AdnWqQECINLjhNJeKzUjKeLvsrIA8aPMH0nnMzN2s-xppfupX5E9MuvhNTXnW7NY310&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyld3b6IBS9UjGSFcLq7at9AjRgjDYweBvBhP763OIKWw&oe=69AC1957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_LandscapeDemo.png", "id": "799202501382844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_799202504716177_5159505871863248409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV2I3z78j5YQ7kNvwFA35wP&_nc_oc=AdlDJLkHvYivFM0x2OFMNXfiWP2GwVupjLGERvU41vMNvVWsipw_ao81NM8dE1Ukgps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjRZzzdA0eqmicgPDDzS_ady9zV2MJWLK5iFNMH0AeYw&oe=69AC2CD9"}, "display_name": "Tube Be Continued Demo", "keywords": [], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nThis is only a demo, but the full game contains the following TUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for Tube-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
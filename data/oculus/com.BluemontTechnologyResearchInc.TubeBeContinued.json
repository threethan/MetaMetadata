_name": "TBC_BB_Screenshot1.png", "id": "1416454555595557", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031620_1416454558928890_6571955765539591451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaE70UpvWRsQ7kNvwG-BAnG&_nc_oc=AdohUznAtXDg22rKunFf7K6h5X5qmUVhlQ18BYWs64WdaX_xBsXB69JRmO6wyN-phBw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBKL7WDnyxKbsZIFGkQQ6ZvUyPfDaA_x0lfXy4wx1_Ug&oe=6A8ED6BA"}, {"file_name": "TBC_Screenshot_4.png", "id": "1512593585926048", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86659795_1512593592592714_3017758545978518425_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDQwAcUnzxMQ7kNvwGKf4uz&_nc_oc=Ado57-S51Hjy9rWe3kWHsXFtYpgvVY-SgF76gMNdd8W7lIC26w_-dSq3IA3b1k-CSBM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4ZxdRymGEeJyFBhz7CHA3Se_9jEvd31kmg8sL-5TOuw&oe=6A8EC4B8"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "610644550871736", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568679_610644554205069_6546097349031153076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0nVzv--tk0Q7kNvwHLoE_C&_nc_oc=AdoUYF0_uXYqNJo_1wQ5NnVIkFxXMPdj4Eu4auzw5XKkIm-UU-LlsombGUdAvR9h4ic&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyNaAu0-fswdMhYVOEQO6gEcGRcdwnsF6xTtTbsEeqjg&oe=6A8EDB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_LandscapeDemo.png", "id": "799202501382844", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982567_799202504716177_5159505871863248409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqKybe1U278Q7kNvwH5ehJV&_nc_oc=AdoTIEY93BavjF9O6AwIhFSpn7msGZFfecSZXM9Yr9bu61blEVIwy8JzdeFDa-l0wZs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK_9Uk4RHe_-4dDwkoyl9EVsZdvvHz7e4rNfhsfJJFgA&oe=6A8EEED9"}, "display_name": "Tube Be Continued Demo", "keywords": [], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nThis is only a demo, but the full game contains the following TUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for Tube-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels in the full game! \u2b50\n\nGet the full game: https://www.oculus.com/experiences/quest/5556605911096889/\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_i
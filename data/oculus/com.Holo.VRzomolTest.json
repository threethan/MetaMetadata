7370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031373_357413323680703_5951214038743679130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZHVJ8VxHJ0Q7kNvwF-9-C1&_nc_oc=AdrqGMmfKFfn99ZmkPpUz-neMWLVcYcQUxubFpggDlyKBRI-yMouSsyZN6lC9vqAUPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfruAPAeXeotTLrPnejzuOoNZs7eK6hqlKCIF4g8MqLw&oe=6A6DDE1E"}, {"file_name": "3.png", "id": "1656549745092658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227837668_1656549748425991_1143631201984089429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nrLPSpKTJ8Q7kNvwEOXOFq&_nc_oc=AdpeKNOiFiklhMknyTuZGsA-PyqBuA1G-pSRkPR4Dg7KxgNUCplmQdr8Qcu0KGfmYWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3hJLE6GTye2H963Hrw4b_PtSm3JRru31L0SGU5v64Hg&oe=6A6DE788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1838571613315973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003272_1838571616649306_6242989053745109081_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHiHE_fuDTAQ7kNvwFKIFE1&_nc_oc=Ado90ZDdG9lqGZd31LmZMoyrSvuNX_T6D2JZz-3JUsdbh6JsHL57qK2V3Crzrep_cvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP6FN-j347-ZWySISG3hwE86JrqgcWrISN7lqDlg56dA&oe=6A6DFC1C"}, "display_name": "VRzomolTest", "keywords": [], "long_description": "The VRzomOl is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "7727081744001544"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8674727512570291", "version": "0.3.0"}, "id": "447072594930565", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7727081730668212", "is_concept": false, "late
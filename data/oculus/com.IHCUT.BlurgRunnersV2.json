": null, "video_trailer_thumbnail": null, "display_name": "Blurg Runners", "keywords": [], "long_description": "Blurg Runners uses a special locomotion where you use your hands/controllers to move. The player you play as is inspired by the character \"Blurg\" from the game that is named \"Fun Monkey Horror 2\" by Zeophyte. Zeophyte gave me permissions to make Blurg Runners. This is a multiplayer game where you can play different gamemodes, hang out, and run for your life. This game is just starting and has a long way to go.", "short_description": "Blurg Runners is a game which the player you play as is inspired by a character is the game similar named \"Fun Monkey Horror 2\" by Zeophyte."}]}, "developer_name": "IHCUT", "developer_privacy_policy_url": "https://sites.google.com/view/blurgrunners/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "IHCUT", "support_website_url": null, "website_url": "https://sites.google.com/view/blurgrunners/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27235316466112210"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1901646543664417"}]}, "baseline_offer": {"id": "1901646543664417"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729548000, "status": "PUBLISHED", "id": "1901646543664417"}]}, "liveChannel": {"nodes": [{"latest_supported_
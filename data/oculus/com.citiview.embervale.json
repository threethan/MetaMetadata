982959240158861228_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1aEIXyCUxoQ7kNvwE6lYLi&_nc_oc=AdpAPyJq0Qi504VLTSOjxMMGWnbPVSyvv7p6OfPYhUDt12w7WD_viilFSRyKlt78KWw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAN2BFUfchTu82AIjem0Zs70gzu1_nBHAtOzynQehs9Q&oe=6AFC6B1B"}, {"file_name": "screenshot_1.png", "id": "4428925754103141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_4428925757436474_4496303798797148585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGsOOaMkWU8Q7kNvwENdMWn&_nc_oc=AdruNpFilsCGGlRJWU2X0sQP_nwvpa1bRxYNLiyqQ4hx7Jn58VDhlBaDO_yhvU3WwVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_bT7ERduXQnXdclnvj2GU6vG3yu86Xn6YdaKO1hk8Pg&oe=6AFC7F73"}, {"file_name": "screenshot_5.png", "id": "1772005350777478", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596061819_1772005357444144_1027882785641356565_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OYXY9wHCN0Q7kNvwHruH78&_nc_oc=Adpma1YuyTpQ_zTjCMarvwgaxE9xmhyIwOk5fj_AvqqrMl5bZkS1SwVULGF_s2QM5JY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEopEyWI7kg3lQuRwkaPehg9H6wwJUvg3aQfiBnUlvcQ&oe=6AFC894B"}, {"file_name": "screenshot_4.png", "id": "4425537071045531", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604375581_4425537074378864_4330104995230199876_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmL23hRYjyAQ7kNvwGtcPg_&_nc_oc=AdoQKjnvadBu2VHJV12o2OQ2SV4uqNxyyULev_UG2MgDa5OLBXa_PmdAnbLw6F7_g40&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnvTdaPq9bLVx5u8SSI1HouehlzyRc-y34MBTvcA5T0g&oe=6AFC85D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28438133922511044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_28438133925844377_3000758296576009586_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srkT8S-tKnwQ7kNvwFJgvj7&_nc_oc=Adoqqi3WVkkbJQYvJplfMCCyoEk84FSLf5hkXwNHvhvVeMepbR4bcxECrhS_1Y0JO7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl2saZ3iKffroMX6T5sJtZMpmz2Mn_0o0sPIRLpu5DGA&oe=6AFC7FE0"}, "display_name": "Embervale", "keywords": ["adventure", "rpg", "fantasy", "exploration", "sword"], "long_description": "Embervale is a single-player open-world adventure you play on your feet.\n\nYOUR HOME\nThe tale starts in your cottage by the village: a fire, a bed that rests you, a weapon rack and a trophy wall that fills as you find the Ember Crystals and the twelve hidden shards. Walk out the door and the valley is waiting.\n\nTHE VALLEY\nOne connected world with no loading screens: the village square with its shrine, archery range and pond, the autumn woods, the desert, the swamp, the snow pass and the fort at the far end. Trails link every land and campfires mark your way back.\n\nSWORD AND BOW\nSwing a real blade: raiders parry and swing back, witches throw bolts you can dodge. Press B and the bow is in your hands. Five camps guard the crystals and the fort's Golden Knight holds the key.\n\nTHE VILLAGE\nNine villagers with things to say, a sage, a potion stall, an archery range that pays in gold, and the Emporium: swords in five colours, two bows, bigger hearts and more, bought with the gold you win.\n\nMADE FOR COMFORT\nSmooth stick walking with a run on stick click, snap turning, a jump on A, a wrist board on Y that shows hearts and gold only when you want it, and a left or right sword hand. A fall is never a loss: you wake at the last campfire with everything you carried.\n\nControls: left stick to walk (click to run), right stick to snap turn, A jumps, B swaps sword and bow, X drinks a potion, Y shows the wrist board, left MENU opens the menu.", "short_description": "Wake in your own cottage and step out into a 600-metre hand-built valley. Sword in one hand, bow on your back, walk the trails through autumn woods, desert, swamp and snow, clear the raider camps, bring five Ember Crystals home to the shrine, and spend your gold at the Emporium on new blades and bows. A bright, cosy, Zelda-style adventure made for Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/embervale/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/embervale/", "website_url": "https://citiview-games.pages.dev/embervale/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1340042055855324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/814574569_1526050965946475_8272292133085154796_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F26pcJjZuSoQ7kNvwF_uiQS&_nc_oc=AdoG62V8S0jDwLrRhfUjLt-0vKpGOpm50VLCcdFFT6nfVNCs9P6jhrqjhkFAoOGWcyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLpGMS1bzKlLGyTpb9MMscufKJOI6zdy4FQusNQB7cYQ&oe=6AFC6D4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Embervale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465
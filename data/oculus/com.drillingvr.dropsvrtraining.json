0887_858077761418441_7135124756977179891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrK6Cbvnfw4Q7kNvwGwrHZ5&_nc_oc=AdoRcnaA3IQ2V243Ytgis3FDDtwC2KMOwQTO-5nH6K37IX9O7pe238mMV7O0Kl_3gdY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdHciHqvoeJ9Tg1IxEZa5Q1p6vRBCE-dJ900fIAy_jjg&oe=6A8D9C42"}, {"file_name": "Exhibition01.png", "id": "2835305633400484", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258663_2835305636733817_2220042868864776207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgnaSKGzEOoQ7kNvwE6BzD-&_nc_oc=Adr_xV5yFzoujvFgmsn42V4XWueFp4tfcOhsUoOgaVvXzJ6VSLYPr_q34cXCtYI0GoU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA5nTx9zBGjJA_R-ZAPQM3FidNiXvoKaQ1f6nYgDD-kA&oe=6A8D71F9"}, {"file_name": "OilRig01 as Smart Object-1.png", "id": "343524720752250", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031471_343524727418916_2673813157432736279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQIfL-Kfz0cQ7kNvwFbWiGw&_nc_oc=AdqdCbQ0CzRlafYgnhfYDxbPhT9_K_xo6SV2AgIuMwm7DprBpVy7Ds95kenjeLUoxtw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTXxeenxixV9OKqLCN9YlAjhrcpkBAoiTl7ozqzPsqyA&oe=6A8D6E6F"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ovgPfhE0S0Q7kNvwF2Z6K-&_nc_oc=AdrufhwgfdryismAnrsFXgm4KzcGUh5R2aZfozr-Cv3pt-2CXS1vsJmGx-w0pNDffR8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHandWKaDZO4y-mMpXThqDFGVZmbJfN-lr4rnmT2G-1jA&oe=6A8D98E6"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jzuLHrWbUcQ7kNvwHng5Z6&_nc_oc=Adq67v_j2vMemwzZdpkftPpsI9GBphbGRvNoBIB_JW-TZ9mwn6GJcRzChiad4UKwqTA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd6UTMKPgsE4IWVcZnMdf8R4emj-LsckPKTrVDmtGlow&oe=6A8D9244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborate for the prevention of dropped objects", "short_description": "Virtual Reality environment to learn about dropped object prevention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropsvr.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Drilling VR", "support_website_url": null, "website_url": "https://dropsvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
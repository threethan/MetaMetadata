6ypdmZiKhqpgsXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3sNYqbdkFBjAXAIsDguKXxdKEyb-cq61jq-8BIaUHdg&oe=69B6C22F"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FcsqpkJ2AQQ7kNvwH-dQZa&_nc_oc=AdmefyM7f4ozIzs0mmS1XQda_aBXM17M6cXrEmJXlxNJl-hGyMwljCPxzgMx1WELvnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9KkGDWH270dLHgjTqMS5p06MZaYuxbqITmUkKzhAsYQ&oe=69B6B466"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9Pix-f945AQ7kNvwGcas0A&_nc_oc=AdnTbfjDskRTYG-D0L-sOHMVe-3dB-2dbw1t-gBJH9Rk0XrvBPWhr6Abvk_cMMcqSaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxslHeZFJaztFeBZ7Rb3q2eySaTp_U5OG0KA2mLbKr8tw&oe=69B6ADC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborat
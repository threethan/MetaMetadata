_858077761418441_7135124756977179891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfcdoMwVv6UQ7kNvwEAF6Lf&_nc_oc=Adq4CZD2CHzPf6CzD1-UDPsKEjaP37_BAsjkpVmi000fCvrX-3upz1J3KF6vodKC6Tw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuch8IzEm6O1nz3vdrpe3z9sXkziv0kVukFMpJyv3l5A&oe=6A7DCA42"}, {"file_name": "Exhibition01.png", "id": "2835305633400484", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_2835305636733817_2220042868864776207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzOzlj8jeLwQ7kNvwFftECX&_nc_oc=Ado7psowHfLfk_-AoUwjFPjWkfcOW7w_kPyEQTkX-QbZ7I_RJzJQnHULkgpoxZ4VpyY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb6Kiqr-3QVjFhyegyhQ73QJRZDIzadU8cYNi6c7GrwQ&oe=6A7D9FF9"}, {"file_name": "OilRig01 as Smart Object-1.png", "id": "343524720752250", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031471_343524727418916_2673813157432736279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Moq9B7lN5PQQ7kNvwFMpu3B&_nc_oc=AdpC6xCkUHOh8dokUS7Uh9tiUNfS5LyOiUbG5Jnuu8Jqs27OymoPU9WTvuEN3lREdtw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdVGHg11Qvbwft4WL88rcFKN4RL4Tt_8B3sUwAtZa7AA&oe=6A7D9C6F"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRy-Y6TnCFAQ7kNvwEYBMf5&_nc_oc=Adq2ePempQR7mo8lZQlpUh8NhDuXH18Fb7I-PlxA7icJ7LIDVilsnU7Y-OLyUN3ZB6Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSArlwHg8QVt4oYy9DUYjzpatlAKLfmeP7ECJRE2OkdA&oe=6A7DC6E6"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZMrCSzgM68Q7kNvwFmg5CL&_nc_oc=Adom0SNGzz3TBrDv8fmOgLKhtRvFCB_0ojfgg0H6xJrJaK9entkamISi3GGOInAoDvg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9YOAEz1YoApRG0S50kQMnJM9yAIidmbQ4ISQfPtjbVQ&oe=6A7DC044"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborate for the prevention of dropped objects", "short_description": "Virtual Reality environment to learn about dropped object prevention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropsvr.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Drilling VR", "support_website_url": null, "website_url": "https://dropsvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
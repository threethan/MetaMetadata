0887_858077761418441_7135124756977179891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrK6Cbvnfw4Q7kNvwHrZ5OC&_nc_oc=AdqEuZHpOk5yTDd2BI68vf4Xxk0ETP_4n2XjEZYbzVHmwdhg4GFXPkrPPQIzz0c4PJA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_8jcDdgbFfkwN-3-D3UWwoVULVEoOd1I0DOCPUW-8TQ&oe=6A8EEDC2"}, {"file_name": "Exhibition01.png", "id": "2835305633400484", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258663_2835305636733817_2220042868864776207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgnaSKGzEOoQ7kNvwGop7Zr&_nc_oc=AdoXdkGf6X7lulE0ypHNnFoYzJgkjK6xuGhIZQcwsqfxDuMPXJvBrctdr-WGgkyhCYQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8DSHUBaol49fzPwIWeCDaF5-TGsHs0Mzk3FkXnH29vA&oe=6A8EC379"}, {"file_name": "OilRig01 as Smart Object-1.png", "id": "343524720752250", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031471_343524727418916_2673813157432736279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQIfL-Kfz0cQ7kNvwEinzwu&_nc_oc=Ado3R7dpS2oE2wK36AGDxDjlljuRBtMbhukXGEBh7o7-IoWZ_h-FjDDV4xqdGn5_uAo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEsr6G_gL0ezAkwhQPeeFbrjh-KuIXTHZZWJrSP5kS0g&oe=6A8EBFEF"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ovgPfhE0S0Q7kNvwH2iEui&_nc_oc=AdqTSoOwCEfF2ayKY78JsRsYxW5SwjXZIAdufUPxLIGK3z1PzoMUV_O6HuwoEOZTI-o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCay6c6A7Es3y7itviOYSyptM0SGb12LRKY53LX1qukg&oe=6A8EEA66"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVBllZtOrccQ7kNvwGQNCNb&_nc_oc=Adr1G0-U8HAtIgHlS2l846xjbIuuJd9QYnyhcV43RdBKES9kqUzXAN4LmTNk-dE09eU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLIR7hFDBXBRj1uv4PbN4-sd7Co3Z8GzNxnEbDb8htiw&oe=6A8EE3C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborate for the prevention of dropped objects", "short_description": "Virtual Reality environment to learn about dropped object prevention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropsvr.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Drilling VR", "support_website_url": null, "website_url": "https://dropsvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
_858077761418441_7135124756977179891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KeCpZgXXqcQ7kNvwG0TOPv&_nc_oc=Adp-vVt4ji-dkjHmhoZnbETqbD8baS_NHt2oIniN36JBS23jfvf6iThi9Yafp2Lmmcs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jQB7t3IcvyqMXkbaJ6UHJKMKJugTw0NimcLj2Uy-1Dg&oe=6A466B42"}, {"file_name": "Exhibition01.png", "id": "2835305633400484", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_2835305636733817_2220042868864776207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bbOAcL3zrAQ7kNvwH7CwAX&_nc_oc=Adp94fq-u1vDbXJRFNtRmzbh6RJogkOM2tI9JcuW4EOSChbFIPIAGGx_LEJppBzprLc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zqPp02qP-oBbfkuUWfCWCUabkCpEWtzDXCCcXB90kYQ&oe=6A467939"}, {"file_name": "OilRig01 as Smart Object-1.png", "id": "343524720752250", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031471_343524727418916_2673813157432736279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57tFpojS5HYQ7kNvwEJ9sR4&_nc_oc=AdqQj2HDeMAwBD9VM2LGYSkYt5LBCEX0EZz65exGgMgoHooAOy48zAYZTSK__sGoZyA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C3MdIGiY97r1uJm9fPT0T9EuGGRDt4y_z5YmI7SsQ4g&oe=6A4675AF"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zawvywXWRtAQ7kNvwHxUZSg&_nc_oc=AdpomYMkuDgRU0go5I3ojRJ49D-975Kncdl7E4TBqak7YQHna6isfZr33Ve0PH9Q-3s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FtvW1ommdC7D1zA-ChosEsX1MeqscBpO0aqWNHB4WCw&oe=6A4667E6"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hR37_Rqj7cQ7kNvwG4a14D&_nc_oc=AdpVjkNZ87n0AC4nc4DL51xy4lfx_dJ0giu6Awla93IM3OetY6vO1cTB3ddX41eMuHo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aHetZuE7Q-ktewwGJreHCGFjfN8cOeq6en0tcmYh1dw&oe=6A466144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborate for the prevention of dropped objects", "short_description": "Virtual Reality environment to learn about dropped object prevention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropsvr.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Drilling VR", "support_website_url": null, "website_url": "https://dropsvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
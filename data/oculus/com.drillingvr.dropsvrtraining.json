58077761418441_7135124756977179891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tgju_cOBg9QQ7kNvwGtE1Pu&_nc_oc=AdqMaGq7pJZasP3zlXcha_GaLwRsboVVRr-OApPuSf17YxeOcTCbuuP-p7WnNAtxhx0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cCw80QAlx_BPrmeMaG_bc3ZCiRAzGiqKOdHsGB3nYww&oe=6A1C3B42"}, {"file_name": "Exhibition01.png", "id": "2835305633400484", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75258663_2835305636733817_2220042868864776207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeavQqkyB5wQ7kNvwHw5P2V&_nc_oc=Adp-MLDo5kYp7zdpHjjXCLKhgGcRXapP64vTvOZrlqwCqTOl-c3EuOv6Fzl-QVIcGO0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AYN2oXNACqFy9kOvo_TvigrTGWOxcp9-EPCEnezYzaA&oe=6A1C4939"}, {"file_name": "OilRig01 as Smart Object-1.png", "id": "343524720752250", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031471_343524727418916_2673813157432736279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4zCiYLWnM0Q7kNvwH1gZrB&_nc_oc=AdqCVF3i3V9o4p3DT91vjqA7AAVjYG9vzNbN8E1raXoqqFzsasePGGkiNs_MfKjYz3U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53ktYpAw7Hj4L2Oku1n83-boGH3u50yQjO8J-G-SoZow&oe=6A1C45AF"}, {"file_name": "OilRigTraining02 as Smart Object-1.png", "id": "2177448779057397", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75435284_2177448782390730_428727588116910256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cS1uPgXjHIQ7kNvwGit2cj&_nc_oc=Adpjswh1AtOcP3vHTZYp7v6XqqK0FH5LE2wVXb8Qr5R513DXU9_JzeV3WOY9eG6MQiM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WaY7fbP37V6C92JBIpX4HbLp1Sb5-itkew5XIABRRfQ&oe=6A1C37E6"}, {"file_name": "SDTool01.png", "id": "1281429298906003", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340705_1281429302239336_4781847839353527208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOrOayCbSqYQ7kNvwEQs49d&_nc_oc=AdoezamAJhyuK0q388pZLeENPQNqz48U7BoEZOc6Go0VlFhQrhHVOJe1dDVsCzlpxFo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iGRFqPLFgPPLSzzmML2-BfGN1ZcGtAVyprgx9o_EnEQ&oe=6A1C3144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drops Training", "keywords": [], "long_description": "DROPS VR is an initiative by the DROPS Asia Chapter administered by Drilling VR to create a free Virtual Reality based awareness training and collaboration tool.\n\nStudents will learn through a series of real world simulated assignments to\n\n - Understand the potential of dropped objects\n - Recognize common causes of dropped objects\n - Methods for preventing dropped objects and preventing harm\n - Become familiar with reference tools and publications of the DROPS Forum\n\nDROPS is all about collaboration and the DROPS VR will be a tool where members can\n\n - Virtually remotely meet in a range of Industrial simulated environments\n - Interact with the Virtual Environment by pointing at and moving objects\n - Speak with each other through a multiplayer avatar system\n - Designed for subject matter experts to meet and collaborate for the prevention of dropped objects", "short_description": "Virtual Reality environment to learn about dropped object prevention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dropsvr.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Drilling VR", "support_website_url": null, "website_url": "https://dropsvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
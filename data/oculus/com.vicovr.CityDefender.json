om&_nc_ss=7f20f&oh=00_AQJodVwjqkGgdVn-xOEQu1ZWZzJPrsyD07baP8dLNh2AHQ&oe=6ABE8076"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZGmZCjEYW0Q7kNvwFRi4eo&_nc_oc=AdqdjnMRvZeD0PB_7G_cJsDMra487SHRAfRdsiuhvR4cZVLKjaC0Yn_MHjMyP7Ee6yc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJymmcbCFiT6C7hqfcKgNL8M9iRFLHUlI2d4xg0h-k8CQ&oe=6ABE5F16"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gpda9pWfKREQ7kNvwHxbfJ9&_nc_oc=AdqBYNC_DMqgcpBtvZYoGuanQ2gGD9pDmvO0n8GIGevmB5e0xUBN8wGvrrjN9e0K9FQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHSkESzDRf7PCca11i8ZRn3S5_PZ71twftq0TduI7B3A&oe=6ABE6B43"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAaD_DuokisQ7kNvwFJvJ__&_nc_oc=AdoPJBzJaJsJcjozu1TeZlAU3diWLeKFh0kz7558pBFftM-f_I4YtTh9XyXV9TErfC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEsPVlWV2LLMOXGp-gZoGnukxtkdl9d74djc4rA_7BWQ&oe=6ABE6F75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3V1EOyGHAMQ7kNvwEYSbdE&_nc_oc=AdrCDXJA1i0WeveQs4YbFqDD25No0-GVW8TMtDhzcZ0gNsaKzdBbkDAQglIDUH-79qc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7CUlwSwOO4UQyF3Grv8WjcVUkIokbART5ojX3po8kWg&oe=6ABE8793"}, "is_concept": f
om&_nc_ss=7f20f&oh=00_AQBF4gz_deH0k6ToLUbCAASgstcCDhvU489I1W6ypYoQMw&oe=6A60ADB6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxO9RaHJWrwQ7kNvwFTRmBR&_nc_oc=AdrfIrPCt6w106RHf93_60V5K669hAJQ-_LpWubLm6kt5kjpcqWO3i_00vObtU2KPPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOioFEWkW4R_j-CBNMsTOP3JYCdWhTqly-ay6-Zq5I1w&oe=6A60C496"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zx4g6LUvY0Q7kNvwF3sx6k&_nc_oc=Adruu33DqOIkfGZe7-GuwOczzVd0xgxj2N0_9cuGQ1Mlhtp7taqkc84ndeMdLDw2zNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxJqWM2oJeJhDIL1J0UZd33ueWaT7ZJfTwCmUTxloUNg&oe=6A60D0C3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfqEaQV85PcQ7kNvwFcEWCL&_nc_oc=AdqNzoazp7jtwV2fsMCBtSyKsezVzCuMnO_GiTR9rqugvA63kpiOSr1wAKvapVftA_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU5hIK1-e2CKdOQxsjfhUZU2MJjx-KEzj6n3eawy21Yg&oe=6A60D4F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3OYCTk_dpUQ7kNvwGzDVzd&_nc_oc=AdrzrX7lg2PEKi8dTDHaCMTDY1Ce_jzQWTQdz59kdFLyRb2UnCW7iQhQLqsPLzwU11k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa5n7T4h5vWDb7cfm40UPzAf5QhJykipCMDrbZVlZJqg&oe=6A60B4D3"}, "is_concept": f
om&_nc_ss=7a30f&oh=00_Af1O7efC_jMEGtkDQnvB1NpszSawOnhyI-vugs-dTqpazA&oe=69ECA9B6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unrxC_9RSkcQ7kNvwEV5XgB&_nc_oc=AdpHqCDO6cPYUyRN4uH51YLFDZ4WaNg_MBzh5xxfSSUG6c_JG6EzY9SPBvZ68QxZ_4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i4svhAf5eAFk4sP-ONj_57WkNdLFlkCEoso0A80Tvnw&oe=69ECC096"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfC8bLXMYuMQ7kNvwGdYMGT&_nc_oc=AdoivS4j_eqQdqqQ59DxxJq0hYqRWoo-Y02Ro4HfSXx5kE21XA4-O-tJFbwZJRCx07Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3brFO8hGw2hRFJol5GWeKHuK6kgw6EM1BrlKOWMRm-Bg&oe=69ECCCC3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do8id9PuyGkQ7kNvwEMCJYt&_nc_oc=AdpTvtFMz6hT4JxE2joiYUaTXwZRo2wY6m8XFEkdzUAW5JOfEBLjr6Jj0otva9ZWRS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3plHIAQimwfgXnFPdI8lK6fhk2_pk3iD6qIRt2GEYFmg&oe=69ECD0F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M81ERE11t2kQ7kNvwHWf46t&_nc_oc=AdomGOZ6kFPSBlCpcRf3UqGLhcasUxtwLVN9hxpNCKXpApU7pdZgbucFlxFjfbwsXQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iK9OATfE-1GJhkdPqGczzp16tDpmQGdL0JvKJEJA4Sw&oe=69ECB0D3"}, "is_concept": f
om&_nc_ss=7f20f&oh=00_AQLzI9LbgVb-M_AsRIgwCVNVdvZRB90jEyiN5OwG9Vfoaw&oe=6A9844F6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LblBWQ4oL8Q7kNvwG1I4wy&_nc_oc=AdrKUWO1kkwHNicOV9iXOeDru7_y2YnHHDaubzc8Kmdr5_F-5DQNU3ynhTEjfy83qpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJykw2M8HzjUG-83IPg78HDXfxgb93o_Krv22i_gRQoAg&oe=6A985BD6"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slPBICpAt80Q7kNvwHM9il1&_nc_oc=AdoG8gMrLweW4xsEchyUtBN021xVAl3IssLDj9eciypHNvfWS2804r9glylu1-iiZAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWBA35P2cZEISVjLc5zebmMvvP6VaK0EfVSyQ8-adjew&oe=6A986803"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgSGJytPpbIQ7kNvwEaQXAi&_nc_oc=Adr8YbT0CRGDlFA6sByrnFVcoStdZy8VDej3T7Me6iLWN1eh-OVjie_IpsHbHlShu74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt7M5KVRwvskl72BCuFakHfqTd8JYnQPM2Y7QCjJhERg&oe=6A986C35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNQ-Nw6eyHMQ7kNvwGF4fOi&_nc_oc=Adoz-gi6qoQv4QDxfBhBq8frOlF6ADBzxa1wzJDfCRFDrH2wIqBK7Qhpr_9Tfa-LmwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGhJDHJ43lKjmbfyBJG5jPI1W5myfOL0oHDQk1ibUUuw&oe=6A984C13"}, "is_concept": f
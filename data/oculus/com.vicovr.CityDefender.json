uEkVeJinyVfIsJc3Obbov0NjRevsUybQ&oe=69B3F936"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lryt37W_HaAQ7kNvwHNpeM2&_nc_oc=AdmwFr5AIXc35GC8Q-6Hd7Utk6RKV6iUIkS2YAj7_ezUHFHLvhDRr4rXYvCgEwGrFZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_G1tvfY8DndmHt2tALsdqFlkTJZ6_o2JU7E7lXsCOlQ&oe=69B41016"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xIBS1LAo30Q7kNvwGO0Vm1&_nc_oc=AdlVbgAqGwmrMV4HS1X_P4wS3hX_IqC2x5WXwHa4uwp_0hnShvSscSRnSoPXul7NS0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvmqsbBH1RP1ktfLACAeYSOsAJDzwMQP2PsbK9T4hscw&oe=69B41C43"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5FZS7EEt18Q7kNvwEwTIZf&_nc_oc=AdlYXZGfM3f6HcPDxMWgbj4-zyLH6FkDlB2Nb43nUvQa2rNkRvnmG8vSGhYASsB9F24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9ykOQOXD_yFVIlxcN6E2MiZp8hDBQAiA0QVJrFLzvNA&oe=69B42075"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyAvmejvae8Q7kNvwFqy_Xv&_nc_oc=AdnFtTqED3S8weA9MgJsV20eBPQYj3pTZ5Qqmiju72H_2JY6dicb_RPpUjdBCD5sgb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfznhqE1Oivu374zNo0eHVAcu6YtZe5tljAIiwkpHoJ-Xw&oe=69B40053"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
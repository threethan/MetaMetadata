om&_nc_ss=7a30f&oh=00_Afx_IbCupl8SpuBV2iP3Lq7JeFhewnHIWGx0DCUUPTKLvg&oe=69C7BFB6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIUv08kJKaUQ7kNvwH32v4B&_nc_oc=AdpM1S5zDO3niGr1v9QiDrs5ih2zFEFyTtT0-r0KIm4YM56ZwkJsd0qdK7J15wA9RWY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7FXUdzo1XswBlo1mKph-X-5RpbuTxB2YRtk3fjA1a5Q&oe=69C7D696"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoPPAzTnUhQQ7kNvwH0_-EZ&_nc_oc=AdqUSDLpT6yXJtNdaANz3KFox6uaNaaMy3VOWZBXlammi2wLOurPSFlm8AlSrQytQCE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR3aKpJX_Aqp1tI4beAJ-w0LdN_JdgRz5jbcKC55Sd-g&oe=69C7E2C3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptbvgzhAgQQ7kNvwHOwEEX&_nc_oc=Adp5iZQfMoy7LlBCTTNcjV3gdzFDJiZTiH1UZcnsL06S8TrXsZ2tbhq3SRG_9Lz57KY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxxsqwekd3c1poyukQJKuKJYwbxqRfT-ORvNd6No2lBVw&oe=69C7E6F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuw11UGOozoQ7kNvwFpS2pI&_nc_oc=AdpGB61D9_FiRAascI75LOt0jNJN-cvFmPFyYp3gKtcyZQdvCj75MT_pRp5l9joz0mI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6dxhrwey1gR9CQv2DR4uYzwgYBWlQH1Ib5ce78jLWig&oe=69C7C6D3"}, "is_concept": f
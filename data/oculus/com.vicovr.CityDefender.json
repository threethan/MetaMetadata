om&_nc_ss=7f20f&oh=00_AQTtZF2jOpn6sEj5lt8qjsUDbAGnFqz_vV2gWfZNOyNDOQ&oe=6AF730F6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mJNtT_WBcYQ7kNvwEzDc0x&_nc_oc=Adqf-jYv0KKtEjR4esXAB5QGf3j4sNCGs-7D7qxCjyU2Nam95ZVXH8XqhHrIHkC0xjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3-W9fcQMA74gAs9PJ1PWhZr-qODXv7-djGLf12vh-Iw&oe=6AF747D6"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa4HROJ8AYoQ7kNvwExu0nS&_nc_oc=AdqPwsdqPgY-JchZs_qHD1ixFxpqaEZoTzsRXNLl_1NI-bEvBNxofA3tnl2v5Vp3EU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrjyPuS_XiNWy2cBStERhbUS8IcmwDu05b1t1kFG96Eg&oe=6AF71BC3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH5lmMC3EjcQ7kNvwG7aWUX&_nc_oc=Ado6Rgf9WKePoVKhdlJsm98YXUpOuZItOkYgbVwX0xcUH4y2_9wFaR_WbbSFQAeB1fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd2SaIhO4k_GRBQn1tOgx_tQj-QF8fY5_DD2JbmWJgaQ&oe=6AF71FF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h10VcFMAV1IQ7kNvwEW_T3r&_nc_oc=AdqL0_kom7ynlCn40KB1ClcHZobnSJnuj98N_-oh2UwJ4XfglTOj70jOeKw-vn-U5ag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs_MZSyi98FENnwlXTN4fb-qBr7dYg99jjgiOxVshDiA&oe=6AF73813"}, "is_concept": f
om&_nc_ss=7f20f&oh=00_AQFDtJmgWOctkgWoIKdZWq8MlygSJVlk-fHYF-rkYVDA5w&oe=6A9023B6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMCZvl3iJ0gQ7kNvwFnojS5&_nc_oc=Adpfj49O-0S8t9ndPqwjBZRZ6ojMLPwWL6bRNy1gnbSYD1LtieX8d7I01VrLVKiNe9U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFrufi4F05v2DeMfmptiuO7NdqtcD5hDjJ8zQCDwptUg&oe=6A903A96"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm2XLT2DEkwQ7kNvwFIsWVv&_nc_oc=AdpwChGwF0Bhvxe7KqdE6wTcAuMrulCkDauDu1otAZdkadg6RD9MMD0JoSUlpgGVXQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5VueQCh7KMskDGdYgjpVHsd4XSpwYYrOrY78tNoGghA&oe=6A900E83"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyYdadJGjBAQ7kNvwFM9e1n&_nc_oc=AdpYbgTXyy7KOMEhm4uymgf7iYjD3-tTJrK03_NCX2-JzKDEI8mrIbTaBUjK7Gu2T3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNczta-_0-tSx-7MN8Q5vbCE4Kr5zYECbKZCPPAe1mQQ&oe=6A9012B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y-Bwn-2j0wQ7kNvwG1CP6u&_nc_oc=Adrsx9iq6foYZyn3HcMZIJ5szGeLQRxY2fXBSLXVMz60buKCJX7mmOtM1-ErO5YpvRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn6SLJsNyYD8BmwbGCnPAF8poS4MtKTG-8uZE_LwMh_Q&oe=6A902AD3"}, "is_concept": f
om&_nc_ss=7a30f&oh=00_Af0y3ETiUrLzhPUoWt-bz-jJJMAP8XcgTE49aAQEAwPvVQ&oe=69DA34B6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2WAI4U_3dgQ7kNvwGM_AUU&_nc_oc=AdrBtcZT4BNJoXglXhbA9r8V4-z2wq7gYg8U0zDUFu9zS4J2f7gkhHhUZnJOykLH6J8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09YwfBDGmzlYqUviSZ1v_NPWNhg-Yn7O31fiVG02LQAw&oe=69DA4B96"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4FOtvYVor0Q7kNvwF8Ki5W&_nc_oc=Adq0uBGIngmeKWysn17ES6qUkcLTBkAizjFkvQvMGrHR4qD6Njy7oDunQV1GtgH4Idg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sLu6RsXfttiELLZH8Te5tt6QgIlR6dckVwQh3nIG9ZQ&oe=69DA57C3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1fJDuAdfZUQ7kNvwFtRhWn&_nc_oc=AdqnP9gjJIRQSRKzCjg1zmSGwDZMaWhoEcD5iN5I7xBHE6yBbKa1BrVjkl9NQhdU3fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AjR1dnTHDnGY4NDh2QWku8L7PPZariaWj3vRShjB0eA&oe=69DA5BF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kx-5WDh2h4Q7kNvwG_i3L4&_nc_oc=AdoRip77Mcyjd2OU_Saj67INfW077jVMVl09pEzDhpzmYEEf35AtiJdaWFVkse8puyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SwFzzl4HIcm0Z_6rQi2CU4LCzr8Cfx2bDfrd8dDITPQ&oe=69DA3BD3"}, "is_concept": f
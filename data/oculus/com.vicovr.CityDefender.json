luscdn.com&_nc_ss=7f20f&oh=00_AQGlLK-LH504Z885X0uN1VAMpYzVe-JWiJ-yqT1XiJXItw&oe=6A8ED236"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMCZvl3iJ0gQ7kNvwHwhm_-&_nc_oc=AdoX9295SSaDEtDkFDqFz-m09QUUr-GPB3vbcBjUjra7hs-kj-BemRsBS84ZoriCAuM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA2ugts8NQwVkGWoCiMzkhlpvJPZGHrEzZAUIFOaZRNg&oe=6A8EE916"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm2XLT2DEkwQ7kNvwFGbpRN&_nc_oc=Adqyk55Ycc1C8fBc8NDIqpDXjWcBqwQyU2YZNVCl3jjWSOxOzx3HEe8Rh9KUCMlSlQk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK4-BdnKuZHqhdcmmY9Y3k0UizhN-paX8YHRgLAunnyw&oe=6A8EF543"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyYdadJGjBAQ7kNvwG7_mCN&_nc_oc=AdqCK_JPE7H2SUqCDhHkRbYCv1Y1XP1HNBdD3_SZv2cAQHTTgsW5HonPD2rcHrCZo7w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZFwdhy3aqc1vgVBGplYwuctQHV9ofDgTGPXi_CYvThw&oe=6A8EC135"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOMpdi9KcnwQ7kNvwF2MoFf&_nc_oc=AdpASyvdDyxIDDGuiZmxwovCs8C0a5kl8Iv4UoYZMnHbjyVvOPA1poIs1X2VLruAeF0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs62aKRYmDZ9S1FX1C9Rhl2EecBq4oM8bIEFWXc5ZPxQ&oe=6A8ED953"}, "is
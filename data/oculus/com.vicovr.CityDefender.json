om&_nc_ss=7f20f&oh=00_Af2QkDY1lkfZHP8SwMeR76PRMStmuf3umb-hzuXZ5cF1yg&oe=69EF84F6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQqtdjpvEkkQ7kNvwE8Arok&_nc_oc=AdpUh6uqQDF6_aqrh3YSAUPtP0-ORnaqWkoUThoYY7A1pi6WMkQytd0WKxy-EeYnvrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35lzopHOJaEq_9FNWafDtuHRcpss0QFQcBL-aInsv2Yw&oe=69EF6396"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq022hMiIk8Q7kNvwGWmPJC&_nc_oc=Adq1aMU38sNZVpWdBJ3Io7Fv15jOPHSaZYBVXHvIiZo7zavNc8-6HyDPDgYPdKC1DgQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1drON0mRS5IiuWHn-W0jY_WadzXpSKpkJuSgRY3GzM2w&oe=69EF6FC3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwowDE7XDF0Q7kNvwHo2inC&_nc_oc=AdrE8_doQAYi5eKe-kH2_qXW2dc7_jBPm5uHh6AmRBfDIMrBLolgy5BBBaKDNZfTgJc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1R9mrmPCGmfCFyUJ1WpgufvKanfVEF32May8AJQmJqew&oe=69EF73F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQl4qeG9uTQQ7kNvwHnI1RW&_nc_oc=AdqYexvYsmWP5vYZVRJj1lsfaWpqu1gqBcmUxyN6w6589Tq8zZP9nTxF7UaoIYQT5fE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19Lb4ct27-RstT_LVQQVzE0ajwsJXI5MK61-cYqVhR8w&oe=69EF53D3"}, "is_concept": f
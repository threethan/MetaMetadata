w3aSsDrXPEjoG7F6ZqGGFhhAvqjA2P_A&oe=69B93F36"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SisHzpDwMs0Q7kNvwHoL8_Z&_nc_oc=Adlu5EuJeKzPiXjd_VFHIq0-3VJaDzhqtEOSpweO4myclPl1SW-7K_nXQ5WE5KRMpjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6wSPao1rQJhXufSpk_VUZkHPIKlZHhFyGvyuER0FN6Q&oe=69B95616"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FQX0pLe4DsQ7kNvwEYQGeN&_nc_oc=AdkvQyWz98F1WCEyWiMMAQKtOG5zAtPmVTafRG71nELOeeFM735RJblJId9h0NSekB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEK13EOzV7dNQLHNMWchyBVRbOP2crhn9gbc0C-Ko-pA&oe=69B96243"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4OY-fEvsMQQ7kNvwFp4-5f&_nc_oc=AdmN74-ySdDRrNByRD9F50XAq2YNje9Hjf6sYSPJhSOVJS2ebeVwB0ky_Hz4Pvyg4As&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyX_hG74POK0SHyNufCE6-eB6LZsGIO0jnBa9WZBvRrfw&oe=69B96675"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f6T4B9QYAoQ7kNvwFeog_H&_nc_oc=AdnuX8BeYeggJ0usvXCOyq2YBk8xvvxDe6rb5E2Oa0AaOoCrvAGwvPq1vElvM3LTv9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaNvGbda28DQIxBechnIUeItTGTNnwMB9eD-Tf9Pm51Q&oe=69B94653"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
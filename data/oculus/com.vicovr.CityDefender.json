om&_nc_ss=7f20f&oh=00_Af4TqVErr6d0Rpc2yYZqxTupUBpB6_tryZ_MxOHWZZ54Ow&oe=6A186376"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnL3oyAaVZUQ7kNvwEdKEIn&_nc_oc=AdptezaO85LMl708dFtKYiNtk4x62dnA8GW6nT0urbvRaSh8DLgzZdrxGjV4sJRhsDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pdAijJvN8WXh4Q4r_bUYkCIP2HZBvLtZaE-pyxRteSg&oe=6A184216"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Plmbd6SPfikQ7kNvwHKXRYC&_nc_oc=Adpql6-wkTA0Juze5Qtd6U5EHhdOvi5z2t3xEN_UAEuVq01Fg2eoMNbKmTPhCWf7VKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bIHloS6CwJMWXSL3V9vEvpDU_KZu4A5AzaF4aREHxwA&oe=6A184E43"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpGGveVrWpEQ7kNvwHe27Jp&_nc_oc=Adqf4S2jOYqJxK2TEC0hrRMTDa7bQolEM4iQKg46ECGvPXfd7jvFl4AVIH9XHMJ6-xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hFS8H2KNigf6Uu6YUM5Gb2GRDEWv1YKA--lteJPVEiw&oe=6A185275"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTNPVmwYePcQ7kNvwGP4HXE&_nc_oc=AdoCaY6gAUj5pjXa3likIUqHDgQKUBGFQ7i5V5hU3sLw-TItypszlv7U4Y_MGxFq7V0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YTpJnUUfa_8LF5-pmCOGjdcVXPWtUk-XNMOpQJFVOEQ&oe=6A183253"}, "is_concept": f
8592579101720576_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaelKkBkv2MQ7kNvwFbZW9K&_nc_oc=AdorXe2tLBQGCj2yAlgmWnsjjkqF7UU1ijJBIUVRgOqe8rvPnQzU0Zcq_Zk-kQnwZUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSEiXFkKQWu75jq3XB_CSV2c9wor9vyguHJpTXvuqY6w&oe=6AFF19F6"}, {"file_name": "migrated_image.png", "id": "868325363659257", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12448979_191176071374072_3464451617456128000_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RZgQTBaNnkQ7kNvwGSKbra&_nc_oc=AdrFzZbbyTJ7gRfC1-DO8O-9ESQZglMPkhDVHpecJ-OdqQNnDRe5ZUNRRriQ3FJGquo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJN8DIOE-wag6OQ64PsT5gkJ5XPRw2GV9P6gKeHRKyrA&oe=6AFF30D6"}, {"file_name": "migrated_image.png", "id": "812529575917082", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12602069_389797398069861_3249637844599177216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlNajiuUX88Q7kNvwHAg-az&_nc_oc=Adq-vpJqkSLMVGQsglM7pOQErSckAWyNB9NB9OZm4rGnRlWjp3wNPxXMRHCammmYKQ0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOVah0OGBiO0KYSbcXg7bmBeQU6iY0ANQwZP1bpYv-0Q&oe=6AFF04C3"}, {"file_name": "migrated_image.png", "id": "250033989495869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139451_1019920874774175_3985945279521095680_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIr_SePY-fIQ7kNvwG8LMaR&_nc_oc=Adpfb7NZAi8W7B0WtsazMxV-ZjUP34pTMSJoQGabxNqjC2VX-1AeRbjioqt5icAJOWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVwh6a2N1z65OpfEIUN2XaL0T6_ru4iparMApFC0MaLA&oe=6AFF08F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Defender", "keywords": ["Robot", "Music", "Defender", "City", "Action"], "long_description": "Have you ever wanted to be a real superhero? In VR game City Defender everything is possible! Protect the city from enemies. Immerse yourself in virtual reality without leaving your room.\nIn City Defender virtual reality game you float in the air wearing a robot costume. A great city with millions of people is behind you. Protect it with your life blocking attacks from enemy forces, stay strong, stay focused, try not to miss any shots. A real robot fight!\nVirtual Reality have never been so real. City Defender is one of those VR games that will bring new emotions and experience in your life. \n\nYou can play this VR game using VicoVR Full Body Motion Controller if you want to move your hands to block enemy\u2019s attacks. Or you can play it as any other cardboard game in any virtual reality headset you like. \nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Become a superhero in VR game City Defender, fight robots to protect your city!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1G131NIptFZ-QFv1AnQm5inmeZDrDY1iJ/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "221645733502640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12504730_201588923939071_2724743410249367552
55380473270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830602_1837355383806603_5370622812321390352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwld0hFqv3EQ7kNvwF277Rp&_nc_oc=AdrXHLR9scs-Wa6at1YzPN_k4af9yEYuITBSmnK_q-5fmp8KewjYXfEC6StBLSv5Rpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD__xznS-f_TIoKZs9l9ZxoegPCsOZA6q5o3dKL_71PDg&oe=6A4BBF46"}, {"file_name": "\u536b\u661f\u56fe.png", "id": "1565905471273464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1565905474606797_4396972295100556183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqWu6Jcb5k8Q7kNvwGBj7H8&_nc_oc=AdotTyM1pYcJRIzdQW0oiZLObdq4k-N0A3JgOKqBcXQEalU4I373uetw5VA89Vwgfw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo7cBJMsS04PnFWjpCdrHFJSRpQYlMidWGievI9yh9bw&oe=6A4B9E9A"}, {"file_name": "2.png", "id": "1339198104320286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1339198107653619_3859261687597429062_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ3VmKWYDroQ7kNvwF0sRbm&_nc_oc=Adpr9x3HgfixtGNCR-0or33cIRwdczqzipRb0eOFoe75MMZDjxZR0lu4eqNQKAAqJfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7WpASxSlcPLZLRFWDZO2jLbDOO-JYidOxsmjK883wsQ&oe=6A4BCFCE"}, {"file_name": "4.png", "id": "859526966511113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298790_859526969844446_7044839631494332452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4-VKCniJSgQ7kNvwEpf6hZ&_nc_oc=Adoz_M2ZD_TB0VqlIXnGey711udtr4T0XVAzWkDfVIxlqAdJmjI9kJNUPgVbZfZSesM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNK6ioyXTHetz7q8kS0j9kETDARAFNCp26MZJapU4UgQ&oe=6A4BB2C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "745045945226028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_745045948559361_2808277586930046056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z7-dcIid4IQ7kNvwES8abJ&_nc_oc=AdowHTL0gMjWcRBm4fEiuQNfoEzUJbpPVGKkSTtreDM17sneVRp6NtUWo1Ncz3jL9XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_wW-7kVzaJK9AiYSztTS-Y8qh3qWz2tHPbhDTokFBZw&oe=6A4BB343"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": " \ud83c\udfc6  **2026 World Cup Stadium Theme** : Enjoy! \u26bd\n\nFly 3D in Beta!\n\n\n-----\n\n**Miss New York\u2019s classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View. (2007-now) {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n{1496770768298592}\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  now with an optional **HD 8K** mode and **satellite map** views.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n\n\ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n\ud83c\udf10 **Real-world locations**, not fiction or CGI  \n\ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n\ud83c\udf10 **More Ways to Explore**  \n\ud83c\udfacTake one-click video tours  \n\ud83d\udcfb Tune into local radios  \n\ud83d\uddde\ufe0f Discover real-world headlines directly in Street View  \n{1305243991537071}\nAll seamlessly inside REVISIT.\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28327133946888547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_981811278172856_161701296571276532_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFmUVoLjgsMQ7kNvwHi2Hb5&_nc_oc=AdpLotfR-fWHDWDDUxjJ0N4GzI7Yl2uYNwWWuDAbtU5c94K9dV_Pead3Gim6rsJMOxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0onu5U1WNqf-eWiSXQ5I_9K8owURFZlRz7Fwseq5RaQ&oe=6A4BB232"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with Google Earth", "platform": "ANDROI
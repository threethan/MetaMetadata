2984542633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlVdXo06QYEQ7kNvwEZvX3P&_nc_oc=AdqkLAt6-m--03U1g5D-gApye1vQW4gquYDNRCLcIeRtPNl61jjcFwGjeMXbk4G1k1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cHRdTBQuo9pfr8bAAFnK-nHKfL0VxT9P8N2wszcWc6w&oe=69EE160C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ4x1g_aTQgQ7kNvwHiuM8S&_nc_oc=AdoErLlE9wntJseyUhlT-Z6vLRv4u0NKCIOFWkqFzNWUcEMGvuM0smhQgdTim_O61Qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nf41SNw3y7HNPak391TJlY5EqacG6WJHXCF99UOkqzQ&oe=69EE253F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mrD9-WApb0Q7kNvwFE7xxm&_nc_oc=Adqny619LFD1uSODfOPTDl4SS4Ap5jQ5CaVX4x8Z7Odyl1WaLJRJjNDrKDNwPfT2OHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yNwf3jYAFTkL_x2mP7hx5ZxUl7LEfpMHa7CzwbRWWmQ&oe=69EE136C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0W4kz4DkOMQ7kNvwHQxxon&_nc_oc=Adpcx7446A98r2FzupSZP28aOK-F21pyBeqIaCyOAuRwCfvR4zcBQtCdtGopeQtHSug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bKypbLrIMz5V7niPlAsVRIO-r9V1pdD0_vw8xcdxVvA&oe=69EDFFD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH3fjYQ2-xoQ7kNvwEXxS08&_nc_oc=AdoOErEVu2fAL5j1VRDQeVG7MtYNAvEOxP5AYuxD3WKL6UbToV0oN55MNYxMj12qJfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q_dZrO5ps5zUe1muxj0_9W6BShnihRei5Vs-HM_MJmA&oe=69EE182A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
cdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdaZB0ml60UQ7kNvwFyCXmg&_nc_oc=AdrE6HoAwoyVy2daI6imlXMNKU1gNBaxqrQ09KwcGNRpPGIOEscTbbKZ3EZNxylIjsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjoBFGr0utcHPzqnjZGmLQOWqnbJOHyIjIa0mF7ve3Ig&oe=6AAD3F8C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOmHpIkdE84Q7kNvwEhEcT6&_nc_oc=Adpl-dqs02UnYHWdo7hahhsJvDnauuzcFcKkTWmEJZ8sJQjPu8krjWv2WRGAwVR1vCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSKz_t4zG8TzBB9QwcCmyhtW1NBI4q0-AWS5ZYCkrxdw&oe=6AAD4EBF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r1uN0gXGF4Q7kNvwHV9Qb6&_nc_oc=AdphppOnRGRzIV6KURPvW7oPCXt3OJatb_4zaL0W8upRrtTx9C5M88_F2QDlWQNI-8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc9EJ4oIAoiohODaGA9WdHCuVtmHnNyVNfbG2leQsquQ&oe=6AAD3CEC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kISquITpTeMQ7kNvwGvw0wY&_nc_oc=Ado-Opw8fKLpMNFCsp_M7mqpZ2Q7FaZhpSXhFj0NwZCrLZlPeSghrIEsOt4-OChQ1hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn9oSVHXs4l0FwArV8xc2HBAv_5z-hP8PMgdTpr2NwlA&oe=6AAD6191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTN6ZuZS17AQ7kNvwGQ07EF&_nc_oc=Ado2BejERAOJiKFfIXmKHa4H3bw7uE8gAOFfqufrDeLrvE4PxyhR1ohwF9pUF9_kN2c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzq9rm8_Z3poU-W_Ro2apfvm3c_fiEFiyJiC-uTX4zdw&oe=6AAD41AA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/
4542633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0TI4y0dnacQ7kNvwGAyDhd&_nc_oc=AdpHtQmLInDsotTCnCO4g9_wjUj1_rVGllTXbNaDVACqgfGS8wj1AuSQ8NhyBjclOMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnn1xOboCkViodSp8HD0Hrhrd0bhqrLIBVsvHGjdPdyQ&oe=6A79D50C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH7-PC6MvosQ7kNvwELpMdK&_nc_oc=AdqlMPMx4stle9OumThgpjE3eVRgtQfRZqSPaoIvXllWQYwJtHFP7RgQiJl88aKhk9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf3kCEQZQ7FEIcZIbJ1h17ZObktQdE0o_mCN9UPzpgfg&oe=6A79E43F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HspZOljwe-IQ7kNvwHQtnw7&_nc_oc=AdqFmj6_kqGAEcQcTjeSzlmumQxAu-_bj0fRh9XBu_yWX5ugohrtW5sUwiLoYDpJsoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0weEWsfAnI6TlL0ZVH8c8aq5-HZEL7UJp3_74LASuzQ&oe=6A79D26C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-tBswSrH2cQ7kNvwGT8V32&_nc_oc=Adq7oPGX0RBAzoaFW7wS9EpRU0AJHXt8Yg4R403emcXeiSbvgDSiFw9YLguHuj7IywM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5_iNxcitUaBnaaUi4egodw3I4llYexKwTDx5y5S6F5w&oe=6A79BED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJr379eh_OgQ7kNvwF-8V3Y&_nc_oc=AdpP1mi-RWypnRwwz9tA-QXyLj3uvvI42oqmXCuti8BlcTj8bSDE2jcvVZjONFZ-OYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGacUTkMgihg5m3BqVPYSRg-OT4SMvUaGcB7z7ulD0jCQ&oe=6A79D72A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "https://moonvrhome.com/Time-Travel/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25576740931927876"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "970784252649313"}, {"status": "PUBLISHED", "id": "1328672575889306"}, {"status": "PUBLISHED", "id": "1403538915015047"}, {"status": "PUBLISHED", "id": "969521322249429"}, {"status": "PUBLISHED", "id": "1578996806670950"}, {"status": "PUBLISHED", "id": "2078635149643719"}, {"status": "PUBLISHED", "id": "1134728932120810"}, {"status": "PUBLISHED", "id": "614830931679877"}]}, "baseline_offer": {"id": "614830931679877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "970784252649313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28709932758608662", "version": "0.1.3-uiVibrationRiftDate"}, "id": "1031868982074876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28709932758608662"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \u2728 Refined UI and animations for a smoother experience\n* \ud83d\udcf3 Added haptic feedback\n* \ud83d\uddd3\ufe0f Now vs. Then mode now labels each side of the Time Rift with its capture year.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1785573118, "id": "28709932758608662", "version": "0.1.3-uiVibrationRiftDate", "version_code": 284, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28709932758608662"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \ud83d\udd0a Local Radio volume is now adjustable. Enjoy the sounds of the city at just the right volume.\n* \ud83d\udce0 Featured Locations now have richer info cards. Learn more about the places you visit.\n* \u26a1 Better Navigation Mode performance. Unused premium Rift Effects are now automatically disabled.\n* \u2728 Improved UI states and added smooth open/close animations for the Location List.\n* \u23eb Performance Optimized.\n\nFixes\n* \ud83d\udccd  Recalibrated map indicator(Revi) direction for better accuracy. More fine-tuning to come.\n* \ud83e\udded  Fixed inconsistent viewing angles when switching between Now vs. Then and HD Navigation Mode.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1784789160, "id": "28600954246173181", "version": "0.1.2", "version_code": 282, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28709932758608662"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \ud83d\udd0a Local Radio volume is now adjustable. Enjoy the sounds of the city at just the right volume.\n* \ud83d\udce0 Featured Locations now have richer info cards. Learn more about the places you visit.\n* \u26a1 Better Navigation Mode performance. Unused premium Rift Effects are now automatically disabled.\n* \u2728 Improved UI states and added smooth open/close animations for the Location List.\n* \u23eb Performance Optimized.\n\nFixes\n* \ud83d\udccd  Recalibrated map indicator(Revi) direction for better accuracy. More fine-tuning to come.\n* \ud83e\udded  Fixed inconsistent viewing angles when switching between Now vs. Then and HD Navigation Mode.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1784689445, "id": "28586466870955252", "version": "0.1.2-log-volume-ui-panoMarkerAngle-hovercard", "version_code": 279, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28709932758608662"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "*  \u2728 Optimized visuals in 3D Fly Mode with reduced flickering, less distant clipping, and improved frame rate\n* \ud83c\udfb5 Added sound effects for dragging the Time Rift (volume adjustable in the Time Rift window)\n* \ud83c\udfaf Improved separation between UI and Street View interactions to reduce accidental clicks\n* \u26a1 Overall performance improvements", "created_date": 1783679787, "id": "28454472267488047", "version": "0.1.1", "version_code": 276, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28709932758608662"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Long time no see, time travelers!\nWe've done a pretty thorough rebuild to improve the overall experience. It's not the final version and definitely not perfect yet, but I couldn't wait to let you guys try it first!\n\nNew Feature:\n   \u2022    \ud83d\udd0d8K Street View Everywhere\n   \u2022    Both Now v.s. Then and Navigation Mode are 8K now!\n   \u2022    \u2699  Image Quality Settings\nChoose the best balance for your device:\nBasic \u00b7 Medium \u00b7 High \u00b7 Ultra\n   \u2022    \u2728 Rift Effect Options\nSwitch between Premium and Basic Rift Effects anytime.\n   \u2022    \ud83c\udfc6  2026 World Cup Stadium theme \nThis Tour is sticking around for a while!. Enjoy! \u26bd\ufe0f\n   \u2022    \ud83c\udf0e  Fly the World in 3D (Add-on) \nExplore like you're really there\nEntire world powered by Google data \ud83c\udfd9\nClean, intuitive, beautifully crafted experience\nMore features on the way! \ud83d\udd1c\nGoogle data isn't cheap. We've done our best to keep this affordable and optional, so everyone can still enjoy the core experience. Take your time and enjoy each place before hopping around.\n\n\nFixes:\n    \u2022    \ud83d\udee0\ufe0f Fixed occasional Street View loading errors of black screens and crash\n    \u2022    \ud83d\udee0\ufe0f  Fixed a variety of UI, network, and image-related bugs\n\nImprovements:\n    \u2022   \u2728  Major UI overhaul for a smoother and more polished experience\n    \u2022   \u263a\ufe0f  Reduced jitter, glitches, and visual hiccups\n    \u2022   \ud83c\udfb5  Local FM now supports more stations with improved performance\n    \u2022   \u23eb  Better overall performance\n    \u2022   \u26a1\ufe0f  Smaller download size for faster updates\n\nAs always, thank you for all the feedback, bug reports, and support \u2764\ufe0f\n\nGive it a try and let us know what you think!", "created_date": 1782992212, "id": "28364758106459464", "version": "0.1.0-f19-r17", "version_code": 261, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
2984542633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz83aLKOm2kQ7kNvwFJ_fNO&_nc_oc=AdpBiH0crXrqmqRIsWKREBecW4iL5ft6detMsAOkTNob7tSbgmHuejJxETS1OpXsi5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bINwQJTYRAn6NZzhfGujCHE2-m1CdWd7d1-QlXZE1sA&oe=69D5098C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfEF8QyQcXsQ7kNvwFhkUjl&_nc_oc=Adq9KEIaKSLNj7fFIaGIEqQbYKCn0BaT8JOGSARZV023F_WpZSbYlcH1LrKxTlBAGmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JobO1EO5tBVB7oPe1uFh1ac2ghqBOT44shD5CrVDHaQ&oe=69D518BF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMdnB6_C2CcQ7kNvwFahRYs&_nc_oc=AdpENLrcuUSDAHDBV0TUZ56l7kWl6GqMQRu6iI39e_tpPyCym0yKOAmvVsx7ghPmOM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SPviFtdb3J39UPLQt2vLeLfcuGdHqlMq1CQnonTLxQA&oe=69D506EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oY2U4EQqxcQ7kNvwF72lKp&_nc_oc=Adr0IFxwmmzkjDPeUgwfuuO4VQ0nQfIUXnmhNZv48zS3nuEdsFeu089HLz603FATVgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bz4eCaGXfWKQQyXRdE_L6UZut1sWA2Bl8Oz_muvJZBg&oe=69D4F351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Qsx4L3hglUQ7kNvwGnB0t2&_nc_oc=AdpbyJ8Y3Hx91rMv42ABS2F_3bCuGqpbwtLbLcn2vhwCInT861YdXNo8hr5fiBdncBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xhzp8yPlEunLBMH0qX6hbcfWRYW4VhVQLO6FkhtJjpQ&oe=69D50BAA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
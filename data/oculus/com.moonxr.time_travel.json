1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PML1f_8Z3NgQ7kNvwFd8yRl&_nc_oc=AdrjOrDRSrfKPzc1C5tUkcTYBtQRrgdyAeueCuLC-N1sSS6p5aSc7oNyQlf0_eQJoDQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk14opYJLZq15X9Y5huSj5uih4zRpMMnL8apWn_zf_8g&oe=6AE33863"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRLdkFRv0pQQ7kNvwFM9v75&_nc_oc=AdqFEBuWAFIj9ZbUHDh1FzaSXCzPOJ0NuP4GWDzr13T7YFeh4L7ec23sygTscGqkSak&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZtPPNvaZ6ri9hmAil99TQG4UPIUNTsK97thcvmoMJFQ&oe=6AE364A6"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjNi1pJQ0T4Q7kNvwEIX7u9&_nc_oc=AdrhoyJa_B_SiLgzCKpB6cWwf8poSCJMeZnT0bg4NqaLH4dMNqJkqt0VvP9kybB6G7g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7zJeWrLyB9jXP1WmerBxDQV_43krRMIRzHGfzzyY4HQ&oe=6AE35E9E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op2ZPvsGdhcQ7kNvwFey35P&_nc_oc=AdpuLu0HNxuNyE-1Yc5jepPvv1Z88mGfsUinmKbiWed8HMuF_bSOzz4VT09HHc8S4u8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6aFJbF2hYq4qpYB6Ewp5t3vikBrwIA_7Z3UWnOysVOw&oe=6AE336AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKKkJ8HFsQ7kNvwFcXmH1&_nc_oc=AdrH8BzOwh2KZzMLFe51JNYN15tZ3pwNfSLjRkZHfQxRh9fSc022ab7wTKdmWYeLFyM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9BF9O91VK0Zu2mPpBPTzCWBS4JE-0ejyMOywUYiTpQA&oe=6AE35173"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
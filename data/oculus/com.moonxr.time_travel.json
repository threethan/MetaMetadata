2984542633", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxuwg2e-iP0Q7kNvwEdICQB&_nc_oc=AdrQLIh-ZzskaMGQH5VqwWYUwJH0tiFG6jtR9sa0C2dogNyDsFDoFAIf5jjOTi9dQWY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06gNkMHxggBColwlfb1zWucWwun-cuaZnXLo7hjJxBJA&oe=69E62D0C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXPFcKuxTmYQ7kNvwFybBID&_nc_oc=AdqOOF7r-SQbNU2WBfWJFC1_wviBg77PrVNEnjvW9tuI-pywVa-AGxpufClT4mevK6w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c0Bi4HmoZlOjjOOel3Cel5BohDNuIM-sbsvkHTDu_Hw&oe=69E63C3F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi0D6fgQ0RIQ7kNvwHliuJr&_nc_oc=AdrfJDdMxGEfT3b6fLcP7lHFU_NRNerLfiPbG7HfL9TrjGAuRbY9-CHgdDMBAEY1mNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ftMUyRREgA81upL-X6Fb0dW9sof5iO4Wew7I0tNt11A&oe=69E62A6C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W1dVw2nPH0Q7kNvwHTqqMf&_nc_oc=AdpiBxqB36G8rNkIzzIDCoT49JL78rqnKgKZrHKkSDNPvtq1lAe4x-mYdKGt05wDGxQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20GP1MNG0V57AsXirQFPXDcwrxA-P0EJqIUFDdfsOdaA&oe=69E616D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zcm-X144GAQ7kNvwFepYVV&_nc_oc=AdoryjH_QH9x7DDQkbbvmgmNLnzUYsjEG2_DczLDp2t_exZ-pc9W_J__mBfoM-90wTY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28AXk-zY0ltq1kOH-pFTk0HPxfXdJCBBGEmVocSWw4gg&oe=69E62F2A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
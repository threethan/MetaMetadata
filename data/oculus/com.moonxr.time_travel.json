2984542633", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPb4ojR2w14Q7kNvwHBfTaD&_nc_oc=AdoB4bia-RFVSxDyI1bCvDgj9-T0zJyflGPy3SZvCgJowQ3k-tx3R9TEdFr-594agFk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHBQdu417RMGigIgVP3iHXcU3BZnxG7dvDQU_-3e_0Cw&oe=69C5378C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iS002BXg-AQ7kNvwEkmNUp&_nc_oc=AdpH43CsBWXuTOLLFlIWCZCSFKFphPI-eNYH97k4f6CVeVEhfD8RMC8q3ooI7lgci4Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw65hDs3TiEsx2Qe4M1DBSF32S9kjvtQEYeuGTANZHq-g&oe=69C50E7F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeFp6PHM9LcQ7kNvwEZ0ckv&_nc_oc=AdoDG796bpMoFs7ZWEACxjUVwwnQuaR7_u5zo8IWaudOBvoGBMmvZ4zeheW9ftLx_Fk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA9JqlNepS74SHC5NuGYC2fBP48WLy_eD1XYNbS8fz2g&oe=69C534EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALd0FpZeoD4Q7kNvwHAXpb6&_nc_oc=Adpa9vqhIQR_fR75UOwLUGEzEIH6XFjQPyxR_trSvlnif4DT94_x53J058JR8jZrVR4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRmJkH1GAKuLyuLC20BKOJeWu5aZWamjSCDdNQQCgATw&oe=69C52151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2gz6BnTV6EQ7kNvwGOkVoy&_nc_oc=AdrvZ12aOUNPQnxfFhvZ70uU5_Aikl2RtAL3HXAlNpPSVyTfFeq7ds_342upHR8Ocq0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvljC6YoG85OSpR7wr5ZifvUyhu03Uyx6LrCA2Ln57PA&oe=69C539AA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SR3UY0PTlsQ7kNvwHuTODt&_nc_oc=AdpJiUPKcA11efmPWy8E8bFv9AtMGX0YCgcWS7-FLOBEA8mF-tQvBoCY0UGIcur58Ug&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoJQPpwD4GolCwad4a_roCJm1EfZOT5uztMh9SNClYPA&oe=6AF9DA23"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItkTJ6G_teEQ7kNvwGOP6uD&_nc_oc=Adp4wXwX5oZrcuKsR5EcRod_Mblb9tyFuxT-uLKJantOHjPkPUdBaj-TCf0NKS89Qho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrkMi1yzJbLKSqjsdCFZIfmC738dRAwlR_L6OIOA8YQQ&oe=6AF9CE26"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6Q7OAUelUsQ7kNvwHwXTZ4&_nc_oc=AdqA3WpoT5oCW4sjyNF0Rl6aTwa1nP6tCP0W3-_Xa1giEA_r08QsUN6z5TRLdW6oYDs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAEuY5V8u0k6NYYx65BewhtJk8EUce1t9oQ6HjnWrTHg&oe=6AF9C81E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkXnPp8k2fgQ7kNvwHLZQrp&_nc_oc=AdqEgH7EJUh-UdGzGZckdKS3898R4_gED7vIZQclLKDm71PUXVbt7JQOqyas5PIELFQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8JlNyFJGIEcy_iQ5-YeDyqDju-sP3QjdZmQbsGCEN_w&oe=6AF9D86B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6FNKU7XbvcQ7kNvwELx0Ev&_nc_oc=Adpp8iy9mR_clj_66P9F5n7GRCp1kJaVUjVQKIZCdEBcD9Ff5puuVIktQ6D5gOguXGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtdbL69hoD2pQndF7E7oYZ36sF56X4aPs0ovxuBi8C5g&oe=6AF9BAF3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
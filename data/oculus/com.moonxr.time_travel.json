t=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvRK4IiE7OszaUTR1wgaATCSYrg8ciWRyA9faDQlecEeA&oe=69A19F0C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWJ-mQjmjUkQ7kNvwHCP0nG&_nc_oc=AdlG13VjsFw5UNJYC9f4EVl7ge0REvid96rhK1ow34a0VRywoMwAALYfyIkApuud5hA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft0uF-XwZdLbrT5S16PgVY1gVvKKdyE26A7pqzxZgx4Dw&oe=69A175FF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hByXtCr4kfsQ7kNvwGE-rcw&_nc_oc=AdlBhJIjipxQTD4hfAjYDec4CT-_OUPxS9-o__ngvMamDLWwDJgnlb1LSBEA7AUTsIs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsBF5rlmvbLSmOv-9ohcejph0PWByX6dMtMyRvF8uUFCQ&oe=69A19C6C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M9RZ9LfY5IQ7kNvwGZ7bAE&_nc_oc=AdnsrBcyi3GJv71zfXZzI8Wc0yCznE5v6YtyxdTMSxl-5o7xHHUGDUU5yL48sY53TB0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftnjcAPohqc_RTj5zNst4OGk18qWfGBIZdsJx1f7dfCIQ&oe=69A188D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTSeO7aGKMcQ7kNvwHCpmx3&_nc_oc=Adno5wA2efCbzBP1tdkzHqsjnBrsE95Z1cl17zZ4SZ3NAsiNQmUEq865wQPG_56kGLI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv-EkU7ITyUMuLoVyitfSjMa8VAMix7mpgpqSV_emF-Mw&oe=69A1A12A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "https://moonvrhome.com/Time-Travel/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
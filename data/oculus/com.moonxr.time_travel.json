1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMgQBp5KTzsQ7kNvwGft1oD&_nc_oc=AdqmM6OuCmF1yxpSo5OMYaQOCPHG-B8BBeUIsVr0g9woV2-34LNpdpLHst1S1UX-F3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4AUOgsQBgAv1zUO3hd7OxEnYvS2g7qhEbpXXp8Vxy8A&oe=6AE489E3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZVvpu7ZCywQ7kNvwEd6tAe&_nc_oc=AdqKO5qPRXiCnpgu_OZAIj1JauRmEk-vK804lJ4Vnbmh9wVHPQi5lV1YM1YUYcm_3F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhTuxq7VSM0QdgLrxVnbUbhJTC0pkhhHV0my4tqjSfdA&oe=6AE4B626"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjNi1pJQ0T4Q7kNvwGnWc9W&_nc_oc=AdoAjakTcGonSHmRSormgYo3wQ1xSjAdl8aNotccZVeEvPSQilFckIRs_A-EDk9vjQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODF0a2PXKB4vdf2zlkdh1FLKTUOv7Q70cvIBuuFTMocQ&oe=6AE4B01E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op2ZPvsGdhcQ7kNvwFDPvwr&_nc_oc=Adrcx7v5P9Ol2NCst04p8G-bk9AXnTRlGuTdMZEX5AegPn2BxHtEzADNGwILc5-6l_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvhi0AvmiLWJiNfh4T9TGegRc0T5Tw2WAoZwK9FnhjsQ&oe=6AE4C06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKKkJ8HFsQ7kNvwFuQKoE&_nc_oc=AdoNb6IMTncmW1JwVSsyRGY0Elv_o15nKbxOxekaBwLEI7lCYAHurmSAjbxEqgUutdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBYBnMQoZBGERuCJtTfs3a4S3ywxdz-YGOfFyRZka_ig&oe=6AE4A2F3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
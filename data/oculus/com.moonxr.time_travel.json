n.com/v/t64.5771-25/491830602_1837355383806603_5370622812321390352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH5VjS9tvxEQ7kNvwGiAEDB&_nc_oc=Adp1ihH8YdJ9nLcTCC0-h8KtQvAKBCTwfg8GmCNW4Vkm57-mBc62uHFhICvOYUqJMpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytwHTsFobTJTBS5Ne1MJEFEOE0xCmVBet-C_JKBVt7nQ&oe=69C90286"}, {"file_name": "\u536b\u661f\u56fe.png", "id": "1565905471273464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1565905474606797_4396972295100556183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u848JtjGr3MQ7kNvwE_OaQ2&_nc_oc=AdoxdiWCu4FZD1OlrsBYpnN0jvdHCg67ciQnZmd_MERIpHuY8LscsKx6Q-wassJf5FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGEV4OOH7ud0whPVcrBRS79NCcmenYrBLIhOvEDYW4Yg&oe=69C91A1A"}, {"file_name": "2.png", "id": "1339198104320286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1339198107653619_3859261687597429062_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR-uIRCuTGsQ7kNvwHJxtgo&_nc_oc=AdqDPuizBw9VvtcYNryk6dMAp2rOC002SgCgRYP0ZrP7zNOOdewcrk4sbcb4hKK5pvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuXj7lKJyTbmn5GjGG_9mBBZfP180oRuHvlW5YQlT6OA&oe=69C9130E"}, {"file_name": "4.png", "id": "859526966511113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298790_859526969844446_7044839631494332452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUxUiogoNE0Q7kNvwFX4TiK&_nc_oc=AdpR7ILPeUUVO1GRV-knl5Yn42KxE0ReMGEPHCuR4toIjT7qEczxl_qE6pMIR-YL4t0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2uS06Iei-zrkrx_XhNJ2MbheNIIpfnYOoQ5o7A9RSRw&oe=69C92E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "745045945226028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_745045948559361_2808277586930046056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mb4jkvgm04Q7kNvwFJwq6I&_nc_oc=AdptcpKcqz48KGhAohYqiORxdTpIhgSneuADyN1A9z_cQ7_yz_EUWNUgWpL8S36vtbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_df4IXueUz1neHhGKERUR1E1494gexjGHTZUeQ7EiFQ&oe=69C92EC3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n{1496770768298592}\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  now with an optional **HD 8K** mode and **satellite map** views.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26495570346711592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_905874858787809_7316013011302063010_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOtoJhnT4_QQ7kNvwFN18S3&_nc_oc=AdqoJW1bmmGNHUmTuzQvOymJWUy3pVrzEa4guoLNHGw3xcH0md7smpnZvjyiFNXAxi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy57XwAvDMX6U0gEN5K6QDagFD1vuMvmhaVc3HPQsjbAA&oe=69C90363"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with Google Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id":
84542633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES_25K5Cf5gQ7kNvwFmTpfg&_nc_oc=Adq7EUzYjh0Nr7ovO0RzU0TavojLNRrOxDuoU0EUJbATSBnEn3wGrfYbDSjL6pboV-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Pjertglb2USWvPuA_ljx3zp-1xFQAnSMiENM5XT6nw&oe=6AA6A80C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkilb7YDSeEQ7kNvwEML-VC&_nc_oc=AdpGGzRv2x4h_b3wII1fYwKRct7cePK4jIK0lut2Bv3sCzqVZ3m8F7Nfp9KXtVSoel0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSW-JmGqaj0XHYEr8jx_Frg0DDOn6Km0zj4Emx5_Bi0g&oe=6AA6B73F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FryqcMVZv6AQ7kNvwEvyawQ&_nc_oc=Ado_2928MSfrs32EjcE5Tge0hza0UyVfyvhC4e2kevGxW7HwgRDbjqfLG_IJxZv2DJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLlpf6xfKC9dEPPAwE-TEIFcpXFXZEqtFPbohy_z8zLg&oe=6AA6A56C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVghd7A9388Q7kNvwHJHTz5&_nc_oc=Ado9Q4X92A7JNxKopyMJdtn8Vl46zbIuoKWxuVOfpq-o9kUHj8zNs--zoNIwtamXhAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj9fFJkfHmr2DrswcVZYOCQFspaHF6KFd6p8JuCSBKLA&oe=6AA691D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVsNBMwqUQcQ7kNvwEF71oW&_nc_oc=Adp_b95XKwBTKvZtLvxr4Eljnt2NIx4dXD7qLVWB5TkzG27WDug-oze4eeIeigfUKZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEiWs6YnOVf_vVMogzflSRSsOO6lPVXdi3y3Q77TKk6w&oe=6AA6AA2A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "develo
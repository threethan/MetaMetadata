2984542633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlVdXo06QYEQ7kNvwERbgZ3&_nc_oc=AdoYOQToZMgaP9TBK_ps3hUklHWwY3-qyzZ4gJKhfLsYFeNH4EuucarXwpISnzFJUp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mlfcu7NubOukQuHfVutQpvHZTeGU9chNEyAhWO68cxw&oe=69EB730C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wotfBV770-sQ7kNvwFEktz6&_nc_oc=AdpsUhe2vbfJf4rzljWwVRv7-5XsZV2LmjJDRZwI60hEZCw12-UEsv9Ai6bykfQ0zLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MONzeQATNNnsE50jTLUuwStISO5PkxRBgEfHkVGPbig&oe=69EB823F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mrD9-WApb0Q7kNvwFVdFGY&_nc_oc=Adrr5IO_ltpFRMIERR5_YHFtUTb-iP8R7yKWrTP0F8Z3z67i52u-eHPWfjisnGirJXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fw2cntANz3dwOoLJUljB1LQnmfNr5FUI2NAgOYOb66w&oe=69EB706C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHU2acMjk5wQ7kNvwFkeqqs&_nc_oc=AdroLg5rW3eJpp3VmaApzu4AoROeIJJToG8PI-CTfvhRdEZuiIsbwIYIV9DP3DwDyEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TDJ-LAVhmSaNPLwKnhdOX_aWY6_biEgCJ4Lgb0gdTBQ&oe=69EB5CD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF8pj0_REckQ7kNvwFUxd5E&_nc_oc=AdqAGkF0CAop-fiwVnwSSCJ05Y1NVBTQIj8hM9qPkC1a8e59P6zzVl80Y6es9kMAUzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JeVrQ_7-Rkf7CKM3jmL4-WC6hG0sYqlnJ9tmUrnVfFQ&oe=69EB752A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
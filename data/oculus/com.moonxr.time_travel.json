2984542633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bILcArpVviAQ7kNvwF9jpOd&_nc_oc=AdqIAF2JGm1k7LZih5PriyiC7jdzzzRPKvLdDxcfVsoCRLtbb0bwtUREdnoPDCj8tOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHFi-E_QCextM3UZI-oalyr2bESXJeP4UwmZH380fCyw&oe=69C2948C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iS002BXg-AQ7kNvwHTHoav&_nc_oc=AdrpEtKFXDyMnj0VQrr3qtIgiHxMm1ldZB8i3HaaOuEsrb9tfLEBAXlNX1rS1PpYBvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgZWZMVfShkt0feB9hglqDILNM3kmqRkWaIPPobPJsCQ&oe=69C26B7F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlWJWhRbeVAQ7kNvwFt-v0f&_nc_oc=AdoZC_SyxrMkPadwPyMJmPhzlwpe-kN4dapz5Mnzs6evJQYEolcWIbCtec9nQkg5L2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVdSyt-fja_2U6z6584QdrMl7OeNn3qvheR5ZPe44whA&oe=69C291EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALd0FpZeoD4Q7kNvwH1-Omj&_nc_oc=Adp4s89UJRCNLylW5Usfo9268dcRp_sbmLAWSaTMGicqB_2wnzmhqww_ECvYoHq9ea0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuHu4pDxM8QlL6qRmBypWwVmlnJYR8mTsYff3fcfBcfg&oe=69C27E51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2gz6BnTV6EQ7kNvwFjMc49&_nc_oc=Adqrj5v33At4yltPSC3wAIJweAfb8mm7JwG4bBxvMKFBbXRhPtLf4o-9ZwoCkLpi4Fg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw57jp8WOJkN-BiGucUHF6nYQOXRqQC7IrvGcjlcxSh6A&oe=69C296AA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYR9Rx0rdkYQ7kNvwE2o3CX&_nc_oc=AdoZWFn4h2dKqWRkeXQoAdDL4dgYlnt-jfVSzapliK5HMHQUQLckFvFlL8vHfH4yx7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Z-cc0oc-g8rUkfAbM8czmuuV6ZlPfrHbkJQvjNkbhQ&oe=6AECAB23"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4b7bAwanoEQ7kNvwGwfyOF&_nc_oc=AdqOPeameoPfvcYvxUSmf018EhMJ86w1V6NWYLXsqyR-L5OycCY1Mr22drCPqQe8VAU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAuLRdpVc_zZD1JYPeH_KOd_OvCdkDglGK-QBJt6VHww&oe=6AEC9F26"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDPwzFGzNUUQ7kNvwEgrgni&_nc_oc=AdrR59HmPQaC-g09YPGN7USmNQrF7caHOwEnG3FB2lh51UgOVXCy2IBawvD0bw1ms9o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvciD9VJ4w79dobu44tiXSyh2QT2JifRJ6xxmK9Q8Jvw&oe=6AEC991E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwDwfKnKeRIQ7kNvwEgvnLe&_nc_oc=AdpEv0HP_63pr55GZtkb31f1pKvetv_6SCwcXXFxn18nkLL8UNymlup-jZhLMj8kC9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_X5T9Px6NavvkORvLCJg9efOGrw-FGh44Ok1jAh2_Hg&oe=6AECA96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFIQYfWSGTAQ7kNvwGzDE11&_nc_oc=AdrEKTwy7eUpsArUdE532qojwVmNCkUAb86Vih0SN_ZbtENvLyGWOEmFSsBG-N1v4js&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-dN_FXs-rojsYE5OeW_oe2blwBzDuGFclHtedCr2uBQ&oe=6AEC8BF3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
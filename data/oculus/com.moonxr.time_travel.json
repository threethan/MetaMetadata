1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa1TQAORrVcQ7kNvwF3Uzvf&_nc_oc=Adp2g1EFP6eyY_9sBrMPcOXgTZBX7vkkxYchNXhemNkPPa_KycoKzLJYklat5oyxZbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPwQ_rSbrcvRhQ8noUDX2rUuttkhWxqjVoql3p3MZalg&oe=6ADF43E3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcMSt2dsQ6IQ7kNvwHwN2ns&_nc_oc=AdoOKKojInlmCouRl7QexXOk0unEs9oNeKauU5JBL7nRu3SvbAJ7Q-QLqSl6lH7aVuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSK9PF0dK8467KXBqYb_0dzf9hGrj6Z-uFCkBkA5g9Ew&oe=6ADF7026"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9yLE1uDMp0Q7kNvwF8vm6N&_nc_oc=Ado_Bu5GwC1jy4DgjfBb1IUYfxEyX8Re70Ny0zm5dGDDJ2NrR9mN5tzQ6CFHJ5wqWOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQC9ewBuQ5hBmW48n-ENLVbjPEuGTTrVpKEeBB6Y5DCA&oe=6ADF6A1E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqiH-Wi9bBgQ7kNvwESEU_7&_nc_oc=AdqEZcis0Xb85rkrU1cDDjpI-EC3DS7haLzBF76rCiyBwoa-1T_z_hZVGspuGiv0nzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLTzdlTYoH6z1g3IYSjOi7FXBXV3ivE0nQA2iF4S_71g&oe=6ADF422B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAQ6vLnGd10Q7kNvwEJXJc7&_nc_oc=Adr5JcKi8X0E3IGbuz2pA1_fj720D1vzl7lxWNfRanPZiB4fPijlN1xRN4aUePnPx0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ5g4Et_1Aobytyr2Om6_o2XewXgFFJTkSu_jv-_3l0w&oe=6ADF5CF3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
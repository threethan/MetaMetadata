cdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES_25K5Cf5gQ7kNvwEb6XQ6&_nc_oc=AdpwQ_QTdl-OAXtqj3b32qgP8dDM771sEmgNcAtt9U7-B8JkxLxfGCz_6mTprfGWBBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOBlnPVtTpbv4eJA7g8qPOHrPHgC_JaFkc2aBk8v-Dkg&oe=6AA7F98C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9G-hC0CVtUQ7kNvwGhaw68&_nc_oc=AdqdIlwwVdnClD4noRCQgCsvkw9-pY9CQVLecPQ96F1rxeiTDg9_BG6mOdlJmc1SMAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKliDjVy0DOmzmqbDbilphL4cMcKZMK4Osp0qr_NRrS4w&oe=6AA808BF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FryqcMVZv6AQ7kNvwGoA6qO&_nc_oc=AdpeZ9Jd9rvhfUdgwlARhuRV5Xe9HWBTfL0U64C7AK80Rx8ULdkLM3dp8NcsSsg9Kxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrCOcJ2laRIy7pzeS3Tzaoks_UYvlP2W1jSWxZwzzLMw&oe=6AA7F6EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ied3nRSdlKIQ7kNvwHy_nfz&_nc_oc=Adq3x1Sk_LawsKSa8AjbjxK95Fa8UPUMsDVsaEr_Eb6KuFlPOumTpx-m-kUaSOCCfYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInb8epX6IyNkwOv9V55T6Sf44gIcgwP6cjnEGIOTloJw&oe=6AA7E351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLfFF_ukiEIQ7kNvwGEuWxD&_nc_oc=AdrguE85eBj9ajC_is14JZxKRRQmHs_B3jA3VHs4XAFwaG0VcMKtjCgI4f4NB9K7Zaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVkNCjwQbmYFjNQM-wWoD4TKreetZdaysxTt0jsmjSIw&oe=6AA7FBAA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/
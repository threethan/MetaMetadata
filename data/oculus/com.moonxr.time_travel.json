4542633", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI9XZlvprlIQ7kNvwEIAMLb&_nc_oc=AdqzzImJ4sOE4v3Q_hQ6lTOUyHhmYoxDdSViiggkkwB917hX5ztYFunIjzTmsoRc-sU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcBDPO33q9wAZ_EdGGCclXOcKB0oXLJeA8X9k-A4u3eQ&oe=6A9ACA8C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa_BcVSNPPkQ7kNvwFYm-Hn&_nc_oc=Ado7Jyy3eDddQXiLUgccLUZDa87xC-Hdyiy7LAvHIeeCcC_G0CJdMcyNNvC9Wix7saU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0JwqssbFw1h4MRYqk8W-2L0-1agwuvtaD-S7y8o6Clw&oe=6A9AD9BF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCak3LMUmtIQ7kNvwFAPK54&_nc_oc=Ado_8ZcVCidFiPtVQX5hg4U-z-dkSPqwujBI4DXoBgYfiCrPiXewjea1r8GZYKUCdbQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe4t89lkkvKtilstj12ubijIou1goAHWPueoTXoz5Rbg&oe=6A9AC7EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hnitJX-KYsQ7kNvwFoyjVz&_nc_oc=Adp0HDWpjypraDNJYJ9TfZM-si1XxEQWwahhPw72g1AYvnkh0BaKTdu4saWEV7Tzs1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmN-pwZ0xHCUt8-xHiexSzPnsTMOBaXOW5HMxHKrqZXA&oe=6A9AEC91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac_ZI5w6k8UQ7kNvwEU1NRm&_nc_oc=AdprHT97zpZu7bZ29slPEXnDjoQu1QshrT6Oc5RDSI2h9IHXnry3G3iC9QeeDZ7yBFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItt8uzJSYeDYnMHoNlbQg054AK2gYgK-xV5YiUuPy8HQ&oe=6A9ACCAA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "https://moonvrhome.com/Time-Travel/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25576740931927876"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1374757464626421"}, {"status": "PUBLISHED", "id": "970784252649313"}, {"status": "PUBLISHED", "id": "1328672575889306"}, {"status": "PUBLISHED", "id": "1403538915015047"}, {"status": "PUBLISHED", "id": "969521322249429"}, {"status": "PUBLISHED", "id": "1578996806670950"}, {"status": "PUBLISHED", "id": "2078635149643719"}, {"status": "PUBLISHED", "id": "1134728932120810"}, {"status": "PUBLISHED", "id": "614830931679877"}]}, "baseline_offer": {"id": "614830931679877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1374757464626421"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28925542510381018", "version": "0.1.4"}, "id": "1031868982074876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28925542510381018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": null, "created_date": 1787039358, "id": "28925542510381018", "version": "0.1.4", "version_code": 292, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28925542510381018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \u2728 Refined UI and animations for a smoother experience\n* \ud83d\udcf3 Added haptic feedback\n* \ud83d\uddd3\ufe0f Now vs. Then mode now labels each side of the Time Rift with its capture year.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1785573118, "id": "28709932758608662", "version": "0.1.3-uiVibrationRiftDate", "version_code": 284, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28925542510381018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \ud83d\udd0a Local Radio volume is now adjustable. Enjoy the sounds of the city at just the right volume.\n* \ud83d\udce0 Featured Locations now have richer info cards. Learn more about the places you visit.\n* \u26a1 Better Navigation Mode performance. Unused premium Rift Effects are now automatically disabled.\n* \u2728 Improved UI states and added smooth open/close animations for the Location List.\n* \u23eb Performance Optimized.\n\nFixes\n* \ud83d\udccd  Recalibrated map indicator(Revi) direction for better accuracy. More fine-tuning to come.\n* \ud83e\udded  Fixed inconsistent viewing angles when switching between Now vs. Then and HD Navigation Mode.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1784789160, "id": "28600954246173181", "version": "0.1.2", "version_code": 282, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28925542510381018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Improvements\n\n* \ud83d\udd0a Local Radio volume is now adjustable. Enjoy the sounds of the city at just the right volume.\n* \ud83d\udce0 Featured Locations now have richer info cards. Learn more about the places you visit.\n* \u26a1 Better Navigation Mode performance. Unused premium Rift Effects are now automatically disabled.\n* \u2728 Improved UI states and added smooth open/close animations for the Location List.\n* \u23eb Performance Optimized.\n\nFixes\n* \ud83d\udccd  Recalibrated map indicator(Revi) direction for better accuracy. More fine-tuning to come.\n* \ud83e\udded  Fixed inconsistent viewing angles when switching between Now vs. Then and HD Navigation Mode.\n\nMore WIP. Stay tuned! \u2764\ufe0f", "created_date": 1784689445, "id": "28586466870955252", "version": "0.1.2-log-volume-ui-panoMarkerAngle-hovercard", "version_code": 279, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28925542510381018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "*  \u2728 Optimized visuals in 3D Fly Mode with reduced flickering, less distant clipping, and improved frame rate\n* \ud83c\udfb5 Added sound effects for dragging the Time Rift (volume adjustable in the Time Rift window)\n* \ud83c\udfaf Improved separation between UI and Street View interactions to reduce accidental clicks\n* \u26a1 Overall performance improvements", "created_date": 1783679787, "id": "28454472267488047", "version": "0.1.1", "version_code": 276, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3WH3t-1a2QQ7kNvwETh4rT&_nc_oc=AdqHPBIclKMrQ4vczpLjunIVTEP4cspBaRkoNxBYjy5_J0Q8mXe28pk6PkrGbPF8t2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlF0arMv-bQKbMbZ7t1ciqyVVYu-RO-I76O1VUNS2Hkw&oe=6AC3CCA3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srQdDKangmQQ7kNvwEAyiiV&_nc_oc=AdqFfr-h03CBwI7FNTxLnTS8fMJQgq0idGgPIMBVnMWIz9j3OZBqUGHA4YET72Shi9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeGyM2Zu_Jlj0rw6Qxrkd6NbT3GGx-C-n1Ea5dowAntQ&oe=6AC3C0A6"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rJgkIXcBX0Q7kNvwGUeMDU&_nc_oc=AdqJK6Yvp5mxEvOdgB97CVZ5CQOlf7u4PpnGsIFiW2RFLRa5K9HL96Q4J-UAyhpuo4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaUHIJiPvUbC5JkfRzBek47z7jb4st63tDk0guRKG5iA&oe=6AC3BA9E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtUDZy17ECYQ7kNvwF3ohRv&_nc_oc=Adp-JhAo4SvHgkWVIf5vunkkneCxYPUnoYSi-HuPucJZweiq7AOKAYLusFpGXl12rc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzibvoDhqKDrInkwQ1eCpUnABFMKqleOFTOJOCVGCESA&oe=6AC3CAEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doHBRQAAcRIQ7kNvwFSzePN&_nc_oc=AdpH4c5vM5fpI3TfWeUbYw7kCsoQv4faQtqdmbamhigAScguJ_19sLSryVaxB6z_VhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfBdpWwwm4TkKKjEqs9BM3bAZvFgKgS7QX4n8otT4lVA&oe=6AC3AD73"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Remember the old shop on the corner? The street before it changed? Go back and see it again.**\n\nRevisit lets you explore real places at different points in time using Google Street View. Search for a location, choose from available imagery dating back to 2007, and look around in 8K 360\u00b0.\n\n{4125580237715811}\n\n# Compare Then and Now in 8K\n\nGrab the **Time Rift** and drag it across the scene. One side shows the place today. The other shows an earlier date.\n\nChoose the dates you want to compare, then change the Rift with glow, glitch, vintage, and other effects.\n\n{1364211852074382}\n\n# Point and Walk in 8K\n\nPoint to where you want to go and walk there. Keep choosing your next spot to move through the streets step by step.\n\nUse the satellite map to see where you are, change direction, or jump to another location.\n\nStreet View coverage, image quality, and available dates vary by location.\n\n{1499057167861481}\n\n# Fly the World in 3D\n\nWant to see more? Take off and fly over cities, mountains, and coastlines with **Fly in 3D**, available as an optional add-on.\n\n{2590542894725256}\n\n# Start Anywhere\n\nPick one of our hand-selected locations and themed journeys, including changing landmarks, World Cup stadiums, and places behind major news stories.\n\n{1496770768298592}\n\n# Hear What\u2019s Happening There\n\nTurn on **Local Radio** to listen to stations from the place you are visiting.\n\nOpen local headlines, then visit the streets and landmarks behind the story.\n\n{1305243991537071}\n\n**Go back and take a look. You might be surprised by what you remember.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "nl", "fr", "de", "ja", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29331729316429000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_1060929186583896_1382245919522582905_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIqTlXkYeuUQ7kNvwHa-aYX&_nc_oc=AdoJgs1yg_aB37S4t-BoQXGhKKsJ2taCGpSB8BGrG5Joa6QLvCo4ronO16zuVt37V0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVxQ1G0Ngt-IsXRyJYIezuMRfw54SAY0IT8hE8n1U1lw&oe=6AC3C41D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with Google Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1760616360, "lastRevision": {"nodes": [{"id": "24837566789178631", "release_type": 
t-lga3-1.oculuscdn.com/v/t64.5771-25/499300807_1018885044456489_3536680659244981863_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=606KaQpynJAQ7kNvwFjI3fb&_nc_oc=Ado5C8ReWs-DykGJGRJLJXSrhGFjGbf84o1pb9ZuylhgKPLt3MkjJQICCIyJ3PHccN4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBHjGkKgpHp-Qz7-HZ9uSMwyLRVoKLhyUhtD_st8wxHg&oe=6AA16605"}, {"file_name": "2.png", "id": "1077890621570817", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654949474_1077890624904150_5197924759388749339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSRW5fbol-4Q7kNvwEqs1v2&_nc_oc=AdrD8fVfZFwID6L6YDbJ7xy6CeVXCVrgkiUi5T7oPtx4BHVw-whcVxyQm-RJX1zpkFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRM7HAQYbp3ZYKsn585d8xVe35wvG8krURq_i1KIVmtg&oe=6AA16DD5"}, {"file_name": "3.png", "id": "1994632248079844", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499292329_1994632251413177_3285356691602770175_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0WPsTZPQ3cQ7kNvwHXTNru&_nc_oc=AdreP6weqalpdlC0mZwFoX7_Vtd81Yf2CCYBrwxn0-h13G4jOTpt0PsxWD9ysUaB3x0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4O7m_zdiRS6UFbKCK2iB5HXTANhEzyMYivnzCkf9b0w&oe=6AA1617B"}, {"file_name": "4.png", "id": "1679800729741956", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303174_1679800733075289_7676543120549634220_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmuTp5UyZy4Q7kNvwFPIrSc&_nc_oc=AdpJ3WujKtGMTwGiXV4EqmjtBCNotKaxvK9bPUPpvXYQG96jDBzf4wQ9bxWrGH9qTu4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_l6tGrr9HhcUFNpWs3J-xHGNcRD7RAyOpUZXQJVcBnQ&oe=6AA16F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rvCoverColorTestLandscape copy.png", "id": "961842936901879", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314641_961842940235212_3495296691119787594_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB76imkVOMgQ7kNvwEOmE4H&_nc_oc=AdqTrpJGNvL7kz6qPKC7RLWiqL7t8_5v4K6Bmx3vZC2dWvB7HKDN6MitL_wQIzvgeiw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8-iHjusHBukDdcd3JnJIyF9jdiOkwUYUMhnEFOa0dw&oe=6AA15941"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "What's New:\n\n-  \ud83c\udfc6  **2026 World Cup Stadium Theme** : Enjoy! \u26bd\n\n- \ud83c\udf0e **Fly in 3D DLC!**  \n-  \ud83d\udd0d **8K Street View Everywhere**\n\nBoth Now v.s. Then and Navigation Mode are 8K now!\n\n-----\n\n\n**Miss New York's classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**(powered by Google Street View, 2007-now.) {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** - a split between two timelines-to compare \"Then\" and \"Now.\"\n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n{1496770768298592}\n\nYou're not limited to presets: **time travel anywhere** Street View goes.  \n- Your own street. \n- A dream trip. \n- A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  with **satellite map**.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n\n\ud83c\udf00 **Time Rift**: Swipe to reveal the past, and style it your way  \n\ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n\ud83c\udfac**Take one-click video tours**\n\n\ud83d\udcfb **Tune into local radios**\n\n\ud83d\uddde\ufe0f **Discover real-world headlines directly in Street View**\n{1305243991537071}\nAll seamlessly inside REVISIT.\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28490663723868901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312468_1296507309275965_6944397185154298131_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03Djur0E_M0Q7kNvwE5M95N&_nc_oc=AdovmF8727OyfEXa-Uos6nIYBVDx67Hi00h7W3h26AimLbauuZ9Iy4RdoKWMJRn9154&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvE0v3U0RodO3eJ4cWaLLSwo9fFFhKTzR-bcDXaRNOUw&oe=6AA162D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with Google Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3
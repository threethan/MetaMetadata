-sin2-2.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbbGJYWjXYYQ7kNvwEZRFsH&_nc_oc=AdombkfIsCd_Lvu4Zgx54FdBzG2g1QUvSTjipJNDu4c4NMyQEXcMq5KagffWYswHxas&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz064YcmNihhYVp6Du5PBCUIQdClS3cAoBliKZzp55Ow&oe=6AA94B0C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9G-hC0CVtUQ7kNvwHL3ngc&_nc_oc=AdrcQIJ_dxjdMLOq8w0KDHJsi42VvKGDiTwTNvWshTt8rdxnXkEs7ZuwfT8J4EOWtII&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjMrUy48kEubWnki_tfSRJXbnXmWTSLTiQbbAjagrSOw&oe=6AA95A3F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSWcNIhK1YEQ7kNvwF0UL0U&_nc_oc=AdqDhLTgp8CjlFmrsdsKyZ4BEgt_bUpm5ooibOlbbO6l0fv3sg9SHlIdBTtw9caeWXg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh4Vstj2Acajdx7bbElgxBtQ5C2JEYOI4rq89TuggDmQ&oe=6AA9486C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ied3nRSdlKIQ7kNvwFq2gpg&_nc_oc=AdpK2e8KJ1qdkS59nR3pHNBk7OanjL19_ub_cauAmALTHpKC8ja9XdVYqZqTTirl6vg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ581VfXOaD2nxEkHXjM5mP47z-H-oZnk2yAeBzpZ2sA&oe=6AA934D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLfFF_ukiEIQ7kNvwEOEg5n&_nc_oc=AdogbP7FXaxdZiYe30vumkbFRlFuc-nkfmNbXamxPeEFg1pQ9K6axFov3_IcFdS-Zp8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-Ab8BA6rXssGpP40IzBIO8xfDwCt_evxnUgog3yP1YA&oe=6AA94D2A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https:/
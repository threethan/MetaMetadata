1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMgQBp5KTzsQ7kNvwEuRksc&_nc_oc=Adp-J24ur5tcrOIhpHGGd1dgRJX_o4G-IC_hBkBBcc2FOs4QImipl_5dxWjgBi0atDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqZEvYH2P0XxUx0_qTAa6OSAYo7e8fWZPSj_kHtlotQQ&oe=6AE613A3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZVvpu7ZCywQ7kNvwFJW60w&_nc_oc=AdpngFEucpuPCqfRoPz3iV8JwfQ4T8itVGWrrulrMTfgPoQNGCvHgTD-UHewPQjSjyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAyFFi5xI9O83POC-KnoYnChw-DlwQDw-MJE-vMzFHTw&oe=6AE607A6"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD_il3UmoVQQ7kNvwGgTWjr&_nc_oc=AdrgFaoW-EG9ITPKpfUw0CJo1xWOPrYFzvjnU09x3C45zRd1bX0_1N3JdHBrkJ413jY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAt3TuFvfWPVCm3F3b5XVW9qzxXHCDwircCKkQzVebsA&oe=6AE6019E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op2ZPvsGdhcQ7kNvwELdyzY&_nc_oc=Adp3wCAryFRnNnZ1y2If0esjSNXF019IRNvtExaKpodVg0tWSH7n7DFzB7l4y1YLnSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCWHTVieUi-FWAMit8IYTMnj-sBJ3zydFbszmkGRm96Q&oe=6AE611EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxx8_IhAOkgQ7kNvwFDwINJ&_nc_oc=AdqOYgossI0_RsGH5pKm8Bs3guaAm_8wUwzwVHoqW9N-pdeGca55O9YAAuv6hn2Z7pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXtK-rIDUI8ARWKBwHf6hBF5AueiiCn8nE0oDKVGuuBg&oe=6AE5F473"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
2984542633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_UsZzHBlnkQ7kNvwF0lDFd&_nc_oc=AdrkD_WIc-H5Z4lDnotjhapY5ogyLQ889fRYyIqakexo4Nmf-J8yR2pfCAqcUqW7MqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Oxl7TiyWemSByKiiHn-NzfuBI_sjtX5XorNd30_Yqqg&oe=69DA4F8C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCc23Jco1uoQ7kNvwHN30Ag&_nc_oc=Adrr4j5Qa_GJuaPeAAp2-rzcByPfPRGxjN28iUL7_phFlj1asLd8FCX_0TslTn2-B2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QMKQhiEOn89imc8Ur9heP1wkFOX1Z4BcQEb6PHJRAjg&oe=69DA5EBF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC-GgG8N7t8Q7kNvwGytAc-&_nc_oc=Adotfrf9PjDKSkXKBlJrUlXuELev8B9MjpJIobQPV2QuwN2pzG5sznJNYb2Gyvh5b4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af032WKMGDkhXCDQvnDsWolhirPgTPlgaxsMJodTLq-FxA&oe=69DA4CEC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbUKYVgFFdAQ7kNvwEPWQct&_nc_oc=AdpQeLbTs9GK2KM7ERje8Dsih1sQdO0hZM5Ju02_MUv4bhevhV5z5ihmwlQskfrjY8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dkp_La-oknEdR-izJkDlmeWFvQaQeJ2Rn3y8Q6sKRkQ&oe=69DA3951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuYNGchXQdEQ7kNvwHg7OI7&_nc_oc=AdrYbB3-HTPWSnWoGijvhfb1lgVH5wdNA5_Fc53Ok8QhnlWSZsvuhOTHKkc8ttTsnRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h6rKkNTzEkY1gFtqjo4qSoBCUznIGaRHZTMSoOFwQeA&oe=69DA51AA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
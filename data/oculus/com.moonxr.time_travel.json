1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa1TQAORrVcQ7kNvwE05BtZ&_nc_oc=AdrwI10eBXSvqu5rpp-mq7_287kRfi0ntXfd1iWVcyxyIMnpoZLIcA1j5lAnBVg0HNs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs3LbmkQDJZfrhfokUGOQtgbtHnJkmfKx2DcpzkOHnMQ&oe=6ADCD923"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcMSt2dsQ6IQ7kNvwFY0uPZ&_nc_oc=AdrEGr3nty4vVXYJIbNg1EBU1PoGkuyl-zAk5BsdR9feueD4g4BXWMppbZxCOVic_8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXjy8qTc0BZYAQarZzMRg8ETSbGapelo_mXDhNfdBXrw&oe=6ADCCD26"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T--YasAoryQQ7kNvwGHCZlz&_nc_oc=AdqF9K1WmqZYLhx0I_hnZlBJEiH7ghGbxHQHBTSwAz5qAw4bGSf6Sa1IgQn95nGbH-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORap2XbOLZNjBgxDxw8-RFhcs6tU_11QoFFNcrxLTuuw&oe=6ADCC71E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN_Urfp1vTcQ7kNvwH7FVS_&_nc_oc=AdqOybSFkV_yV1s-u7mxMz2KgnaNOEvy6vzcA_G14X4ILgGInVjd5BkHJZYuWQvBbwc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7QtlnfvAf0GEpKBP-x_ZSPmdA7gVjPgGgMJAbBiVjHA&oe=6ADCD76B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PYIQJgAvhwQ7kNvwFXU0jw&_nc_oc=AdpAJmEjfgxgzx929Dj-W-holEQTWABXiD9mcDYI2WO_w0aCGZIi7L5s6HJm1SRY7gM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUQM7rvxr4AHplRAuzg650k8F8KfOURvXauky87ZvSiQ&oe=6ADCB9F3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PML1f_8Z3NgQ7kNvwFmwosG&_nc_oc=AdpOe0WZ5F9kuSDh50KA1OMmHox-A-Gi6zbSmMCD9xGrLPS3Wd9E2X4o8zl71qldAW4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN26qk2XtLu6lAI8ZKWXPreVtNBqOwz55f1xAHuXJKjAg&oe=6AE1E6E3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRLdkFRv0pQQ7kNvwF71KdE&_nc_oc=AdqST5CIluLwAUZ6-XA3pETJAgLubVNgSLkrsFAwtcMGebqA36LPMAJCiFtsTLHscEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjmlfsLA8URDMa_8NxXbqrb3rZ3qCrEaoYkFdUbia5HA&oe=6AE21326"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjNi1pJQ0T4Q7kNvwEN0Y36&_nc_oc=Ado2ikyJmex0e6q5RWqgCLXrXOityeyQhSUrpfs4WZd4RXKGhjGhWLPGKpwdx7bHikw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNErcGcGrtrBs7crYyVXukGPtC5v25FCbLseUCjfrmAiw&oe=6AE20D1E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqiH-Wi9bBgQ7kNvwFEtjay&_nc_oc=Adogg9DqWSma-rTwaWl6ZMr5IQzNLtIoUJLzhIVrDcSTaWFV6Ds5BzDmW9Exv_rLZPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7KZoRZlRzuNCXqiKdYvKIQmL3q8_odULG4IybAowV8w&oe=6AE21D6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKKkJ8HFsQ7kNvwGIjUqr&_nc_oc=Adrg-MsqfyIPqZUmG5mDQfsh4OZxCsIAC7LGvUCzMlU3ab1in2kbbQwY0rkp8o1gUaw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYLuyVNjKvoDUjeZXHzleBR6_vWHp-LcR7P5bWZjGj6g&oe=6AE1FFF3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
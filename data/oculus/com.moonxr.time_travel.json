1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wISyw21eD2oQ7kNvwEPri4d&_nc_oc=AdoKl5aqaziM-KnPJfrifhbvvrgBdPZ3Q76VV_dy-qzvRgsu1ofgxkSUOQjPcbQMj9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxkPIHVzGXTPIx1U4iPYauv7jj5i5ujD_JYPQZtPF6RA&oe=6AF49423"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqxUiZcigxoQ7kNvwFJtfci&_nc_oc=AdoG0ZLda7CM1s4fPhCy0TkLobDqHLSHUdJZZBTQfqjxd5IF_qdgfQwnJu40UByOkNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm1NW_1RmdnFu75yY1h15WhsNdD-AwHoEMwlWp3TqGew&oe=6AF48826"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYWiH-p8s_0Q7kNvwHu64jD&_nc_oc=AdrFLqbiK15_Gnc3Kw2sO1fV2Ql9WlB-KOVvsv8JR3GjrfRi3PTn5Mo1Un2dbctbals&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFPX_ORvkYjBpa0nT06c3IqJHeNi9wGQlV-nI6p61Law&oe=6AF4821E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvia7IgvF8wQ7kNvwGr8QJr&_nc_oc=AdpJu8WZNpe2P0dJbLDMmIY41Y8n8jW4wPlI2szA2GVypEG-zDzdnW4LwvjShjAa02g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXm0kSWYSOYd9p3WLY2SIEMyaC7DlkLZeMv5Df0tvNZg&oe=6AF4926B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_55yrK28d3gQ7kNvwH-PlT3&_nc_oc=AdqX1R5R0WJxYvLSSTWBYM4f5xcJyyyE_mQNl2Vzjjm_fc-xa8D8N1W0pHW4aogvjN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEj59_CpaMS-ep7TWir50K_dbDs-oEF-dPKu73EgQegQ&oe=6AF474F3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
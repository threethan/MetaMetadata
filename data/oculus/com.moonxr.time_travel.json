2984542633", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wST8SnhG7rQQ7kNvwEVypan&_nc_oc=Adoy16YQzCG8MnEonB72Q_TaIw1a5REKmxQg8bDoIjnza0Udh9IQn5HdKdxueYnV_ps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ78-3IDkJlVDCFfrUDN_GIhK8x4f9K85slFKnDNmjEA&oe=69CBCF0C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L50ldjwl5S8Q7kNvwGV_Uh1&_nc_oc=AdoeBRTfQgBNEE5CZuSqYqHN51wn2kcD8jU2bEzDmFzc0DNa2wEc0Jon8Zdk6sPw858&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiLdJOA-ynX6bQQmfBWZZXQBLOUpNONr_afrlYieNujQ&oe=69CBDE3F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=777Cfw9J-X8Q7kNvwHEei4p&_nc_oc=Adrkdq1DBK6MUgXmJGxmjUyhvuv7VkdKVsOBrQh5cZpCfPBcwLQ665HxfT6y0Mj31Sk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3cnsDdHowFqYm8RPVG6iYBok-R43fUOE-WXONsN_5eA&oe=69CBCC6C"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlR-wrlyYMwQ7kNvwEYTARj&_nc_oc=AdpbJV93UkuBf-SEYfYUT_dozUXPkC-MvTvFkEzLKkaDjoqAIBSFVHju2qql4gh4NBs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzY4FELopj3mhDhi7qXVA1be_PTzIkfNsRO-mU-GkMGxA&oe=69CBB8D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU4LJJSPgjUQ7kNvwESVRkx&_nc_oc=AdrdXEJoaa42KSvEITgjOXg5Lvud1Rq6Ba50jdXEz1E_ODDgj4reysNjfne9usNup7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7jq1jKVyut8YieO5Y_P2sawibzI3hCzEmvLP8o0ipRQ&oe=69CBD12A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "deve
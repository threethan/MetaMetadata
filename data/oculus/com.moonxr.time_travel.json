176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSgbHmZ1mr0Q7kNvwF9tP_5&_nc_oc=AdksfAFSS_YQcZdOgpOB-fXlWevGVzRUDhFHoZX7ZWMsiavhe9YtLoHZLeQ70oE5rFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs87ENEqwaKwLtHw6R92Vt7im2Rcgr3lQJGOsLlCKlyrg&oe=69A8368C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ_3DrTD9JYQ7kNvwGR_tgV&_nc_oc=Adl3cvcVrR2roujNz---l2JcjFDx31F68HgEeSzH7qZD3v-iT4GpNwSN5Rq_Q6g6c2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvZgJvpjpBn2BJiPu6cy_hwBwI9l4iLazgt-zqF6SUloA&oe=69A80D7F"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPRM7Q4kdCMQ7kNvwHceS4j&_nc_oc=Adlq7ZW0P597w4ub7R5GgOg6hfxbw2Ooust6XL9KJpXru2m5k1xpylcHe057eicqq_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjDN0hZexN1vxuGTPRWARKlKlsvSZKRwxRFtMXYfGBGQ&oe=69A833EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPaTWcO9-JUQ7kNvwF_4Ipk&_nc_oc=Adngt3Jjknzl5IYyJIupw5-3K22ixi1Ln5Qu3NG-ArctH4j-nlwY01QvHtjhkE4IZxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZ6ONwdcrXjfFCEv3XitPvaHMWQ9ck8DwmF-w0Y52I3A&oe=69A82051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1c7jAcnpsAQ7kNvwG71qu0&_nc_oc=AdmNJpiv7oiDW4F0Ksxm_upzMryKQKis9n_f_XKF7etXOR_8UwbN86JKsygYk4nf-2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftsUGMFOUjt3eXwQD5EL7o9AlWFR97llQ8QjqxZa7WBfQ&oe=69A838AA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url
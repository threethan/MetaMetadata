7355380473270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830602_1837355383806603_5370622812321390352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pERoQGmacgQ7kNvwHUF7Mx&_nc_oc=AdpzdkNM1wRzBJdzAhdb28y-um9oAstSj9kzUr-7GJINnqYPPoyGm9fOQoxX2puzqAs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RXvqgw8d9P6BpOL8uS0iLwErDyGBW8Vf1Rk8UvjDuAQ&oe=6A467946"}, {"file_name": "\u536b\u661f\u56fe.png", "id": "1565905471273464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619174_1565905474606797_4396972295100556183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr8bKnZL92EQ7kNvwGg1F9V&_nc_oc=AdrXfLAV_a-sXJa6yWzK2KXFYNx2sO1nCewj1dsTyJVvywaoQHWXE8xkWntFFp3MDFw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dNVbEXv8ZTDsKSVErC1zbBEyrmfn6aWFlNmTMldQqiQ&oe=6A46589A"}, {"file_name": "2.png", "id": "1339198104320286", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312231_1339198107653619_3859261687597429062_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SezEIpjyihYQ7kNvwGO-sh-&_nc_oc=AdoNX5nbHR5418J8MZHYYMW9d-NBFwbzHw9knNkHB60FjowaGZbZt6SpVhzTnfbgesw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XJG_ajgoKQFhTYLNSBITSXeHh8Wq1vqWbJkwMBhUf0g&oe=6A4689CE"}, {"file_name": "4.png", "id": "859526966511113", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298790_859526969844446_7044839631494332452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=letgnFBx288Q7kNvwHeMqHL&_nc_oc=AdrFAFu8WTBjDTuEgNr5KjGf2D5Qd6Lkxui7r3yvM_15bWqtRRW_fEL-f4yAkmU0BUo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VEHW8j2V1HbQRiK9nBJHHshZbPt18Tpxc5jQz34Puvw&oe=6A466CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "745045945226028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499304162_745045948559361_2808277586930046056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4AZ_dhf9FMQ7kNvwFqnF3b&_nc_oc=AdoqypxE5TTXQH4VgelKML5KlNOznVy06EdGk-75J5HRB3-WpP-DQ6l20_E7BqSIHJ0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jzAsOXxoOkgjLS_eASt53be7scs4qNfSvd0yQ6rnIWw&oe=6A466D43"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": " \ud83c\udfc6  **2026 World Cup Stadium Theme**:\n\nThis Tour is sticking around for a while!. Enjoy! \u26bd\n\nFly 3D in Beta!\n\n\n-----\n\n**Miss New York\u2019s classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n{1496770768298592}\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  now with an optional **HD 8K** mode and **satellite map** views.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n\n\ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n\ud83c\udf10 **Real-world locations**, not fiction or CGI  \n\ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n\ud83c\udf10 **More Ways to Explore**  \n\ud83c\udfacTake one-click video tours  \n\ud83d\udcfb Tune into local radios  \n\ud83d\uddde\ufe0f Discover real-world headlines directly in Street View  \n{1305243991537071}\nAll seamlessly inside REVISIT.\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28280709694864306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312468_1296507309275965_6944397185154298131_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q1FvIGGHz4Q7kNvwHBlXui&_nc_oc=AdrUj1TPKmbxcqC9dHfcNip2mNByeIZmoLed-03OUBIV4PLYqsyVyXUKZkynUf5414I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vBgEI_fkmNmZeBsf3xvkGY2AwYrJ48TK6DOLo9FLvbw&oe=6A466B58"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Tra
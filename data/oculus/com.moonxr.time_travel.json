culuscdn.com/v/t64.5771-25/491822581_1176302987875966_9164725694824432033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OYlITUl98wQ7kNvwHr9bJQ&_nc_oc=AdqjAyB5avLDa0VdpVxhw-07t7btrmlLI-jpB4xje8rTGru2tWvzDBR0P7zjW9G7kfY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4qPb49ho_DkajGf2yzhcVFf0CBfaXAflZCZgvnc2RkA&oe=6A2C0C8C"}, {"file_name": "3.png", "id": "4121623981451906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825052_4121623984785239_240546526297102524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltY-IYiUkBYQ7kNvwFYZodS&_nc_oc=AdoqzvL7lyPj9wbkk_a5oqel3RSy62nfObIYny9FmhbKKqzlN_89UwQ70GVtKDVatwM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nBjs7se41Cdkx9HscZ6TnbpoT7qR9XaYw3CBb60hycw&oe=6A2C1BBF"}, {"file_name": "4.png", "id": "1657230814964766", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491831276_1657230818298099_6790316724559446786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBZ3nhnSIekQ7kNvwGVp3v_&_nc_oc=AdofeZ-1-pWHQFi9HW9E7M7QUU1SIHuFP-0YOdBZ0QFBUST9Gs5Vyuu2kFlkPd1N7AY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f11B-uVgJoffroXlOjVuOsKeg1Smo7b8BPWcLxsw8uA&oe=6A2C09EC"}, {"file_name": "5.png", "id": "1396965764708962", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825050_1396965768042295_60285664847001603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmFgFdwsMWwQ7kNvwExcwDy&_nc_oc=AdrbjNXR7CRBoickCBFR2QG5jBx2VwM7e3DkTd7-eUmFQCPcxTqppUQv0-VxUl1gDCw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84rUVjO-19DB11j1wkEgq9-Q_Lo9FiytmwgK4cHlbqhQ&oe=6A2C2E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1138414718159936", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307311_1138414721493269_3022796374307437688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PUy5AzdT1YQ7kNvwEWlAuL&_nc_oc=AdrgAxRoCbrld_v4osf473EH3Ng_cXW6uIxwRDH2uR4zJED4xRXPSiJlUN_Z4J3kl_k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eXYpIcU3-oJrsSta8ZiHxkStzpf89GxwUgeFOuh-T0w&oe=6A2C0EAA"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "https://moonvrhome.com/Time-Travel/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25576740931927876"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1403538915015047"}, {"status": "PUBLISHED", "id": "969521322249429"}, {"status": "PUBLISHED", "id": "1578996806670950"}, {"status": "PUBLISHED", "id": "2078635149643719"}, {"status": "PUBLISHED", "id": "1134728932120810"}, {"status": "PUBLISHED", "id": "614830931679877"}]}, "baseline_offer": {"id": "614830931679877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1403538915015047"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27488553670746583", "version": "0.0.8"}, "id": "1031868982074876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27488553670746583"}, "release_status": "RELEASED"},
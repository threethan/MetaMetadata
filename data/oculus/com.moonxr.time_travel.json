55380473270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830602_1837355383806603_5370622812321390352_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pERoQGmacgQ7kNvwGOr_g5&_nc_oc=Adq1nF_WO302oX7mE1E3ZASkMNGdvlNEoAMGNqIkzuNpmiBaUZPQICSZmyi4CWLbuWU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MrlBokvFocDyFGrYyuYfKu-OS0ogcsUeTsCfnnyXmjA&oe=6A4527C6"}, {"file_name": "\u536b\u661f\u56fe.png", "id": "1565905471273464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1565905474606797_4396972295100556183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr8bKnZL92EQ7kNvwEj5Xqi&_nc_oc=AdquAP6aWtRS26miF4wKagUxuhoJORajyT-jLDZDrtNETDQbYJcTeowcL9cI3loTmJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bti6ALM4jjToNP1MOzDLzE6joDCTWcfhfpxeJk13ggA&oe=6A45071A"}, {"file_name": "2.png", "id": "1339198104320286", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312231_1339198107653619_3859261687597429062_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SezEIpjyihYQ7kNvwFdDwhu&_nc_oc=AdovhK97X9-1NplaGoUPIyqfx7vDSL76AjCg5BhJ5YYIF4DSu8EO_DfzLoKYieWAp2w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M_Us8kdsclb_U1Mxf20Znhij7cNIfIFK9760ufVODUg&oe=6A45384E"}, {"file_name": "4.png", "id": "859526966511113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298790_859526969844446_7044839631494332452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=letgnFBx288Q7kNvwEpFWtZ&_nc_oc=AdpldNnrUHklBIUs0Kux-em-vKiTbQr_AQt_tj9p_gKftCx6mMWa2vblG0pltTAna_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iImt3x1bNH73XSoFsxpQmfSod2phW1juQwlt3-kQtWA&oe=6A451B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "745045945226028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304162_745045948559361_2808277586930046056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4AZ_dhf9FMQ7kNvwHcZ_Ra&_nc_oc=AdozIfYtbA0dfK2HO7ozW_x_tpIApQPBCNXwwIzwpYP3MPLSwJxBwgJNWBJ6klbQgsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pe8k9kPvbqbV4nk0x0FlxA5aT0LiFYpgEI67ENAK8Ow&oe=6A451BC3"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": " \ud83c\udfc6  **2026 World Cup Stadium Theme**:\n\nThis Tour is sticking around for a while!. Enjoy! \u26bd\n\nFly 3D in Beta!\n\n\n-----\n\n**Miss New York\u2019s classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n{1496770768298592}\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  now with an optional **HD 8K** mode and **satellite map** views.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n\n\ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n\ud83c\udf10 **Real-world locations**, not fiction or CGI  \n\ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n\ud83c\udf10 **More Ways to Explore**  \n\ud83c\udfacTake one-click video tours  \n\ud83d\udcfb Tune into local radios  \n\ud83d\uddde\ufe0f Discover real-world headlines directly in Street View  \n{1305243991537071}\nAll seamlessly inside REVISIT.\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28280709694864306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312468_1296507309275965_6944397185154298131_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q1FvIGGHz4Q7kNvwHGZ7ut&_nc_oc=AdqFj3YYItoI_2OKPJcig_ucXGGqGYsx0juxhbaJ0y2MLVxhAxrlUMR3w9vXDhMdSBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XuOXhByUD8VO3kcUm2JYpDWeDOUnz5J_90QT6HBQxMA&oe=6A4519D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with G
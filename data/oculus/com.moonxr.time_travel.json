1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnAbio3125UQ7kNvwEe_GLl&_nc_oc=AdpghnTZjWQGGv4piiR4vwtp4TW8H7KCpH9AzfsPJvEnf4E_7EK0jqQR6jK8HNU7z6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2vE5HKl6z7HQ9vXWkbXpni1dvv4ZBnH2WEzXnwBdgpw&oe=6AAA87E3"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCPs9KzKLvIQ7kNvwEEbo9y&_nc_oc=AdpsbMGQI8Ut3pWnfzdigi_03983ZqdQK_0nJOcL8n84h-eytSvsXMnVSiJR3_86h1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQdkU6OBegU_buXN-7equGtM_iy4sPsEVlS3saxQPcKA&oe=6AAAB426"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp17fLddBIUQ7kNvwGpA3AS&_nc_oc=AdrUWweIf4ud93dv2Rwiec4tvBP2_5DvsytyRz3ImejkCA-lCwSFS85Po4Bl2mKGaRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi_KxCImfp5DoiajjerBCeQJyd5RpGuyhl9KA0d8MGpw&oe=6AAAAE1E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfs7HbypRdsQ7kNvwEgYvO3&_nc_oc=AdpXFJOTjZErV0yuCvv7o3DUM-6r4Dr3FFYu8v0cZTX7D7FMJ7pjXQZY9U-j4EvDmLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZcI0a9a7LSACNksNyVaNKGIti10yPECd0oeHQ5s731w&oe=6AAABE6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rvCoverColorTestLandscape copy.png", "id": "961842936901879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_961842940235212_3495296691119787594_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw9Ke8dRVe8Q7kNvwHvCldU&_nc_oc=AdqoqxA5iRClykH7PRq_kHqTNOvsQTNjjbTLQ6yK_n2aQehPkCLi7PN27ypOn3b5E5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnJpA1gGFQ4lBX01DKKDIIHa7vqN8eseB_hp8SxXrVWg&oe=6AAA93C1"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "What's New:\n\n-  \ud83c\udfc6  **2026 World Cup Stadium Theme** : Enjoy! \u26bd\n\n- \ud83c\udf0e **Fly in 3D DLC!**  \n-  \ud83d\udd0d **8K Street View Everywhere**\n\nBoth Now v.s. Then and Navigation Mode are 8K now!\n\n-----\n\n\n**Miss New York's classic yellow cabs in Times Square?**  \n\n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**(powered by Google Street View, 2007-now.) {4125580237715811}\nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** - a split between two timelines-to compare \"Then\" and \"Now.\"\n\n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n{1364211852074382}\n\n\ud83e\udded **Curated Scenes**  \nHand picked locations that highlight the most dramatic **before and after** transformations.  \n\n{1496770768298592}\n\nYou're not limited to presets: **time travel anywhere** Street View goes.  \n- Your own street. \n- A dream trip. \n- A place that no longer exists.\n\n\ud83c\udf0d **Open Exploration**  \nJump to **any real place** Street View covers and **walk through it step by step** using immersive **node to node movement**,  with **satellite map**.\n{1499057167861481}\n\n\ud83d\udca1 **What Makes It Unique**\n\n\ud83c\udf00 **Time Rift**: Swipe to reveal the past, and style it your way  \n\ud83e\udded **Curated scenes + open exploration**\n{1360640898988536}\n\n\ud83c\udfac**Take one-click video tours**\n\n\ud83d\udcfb **Tune into local radios**\n\n\ud83d\uddde\ufe0f **Discover real-world headlines directly in Street View**\n{1305243991537071}\nAll seamlessly inside REVISIT.\n\n**Try Revisit VR \u2014 and tell us where you want to go next.**\n\n**Discord**: https://discord.gg/X5pZxBdcgn  \n\n**Email**: support@revisitvr.com\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28861708900097713"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1060929186583896_1382245919522582905_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NibWt5i-7QQQ7kNvwF62wRw&_nc_oc=Adpf-b3djXd8Lmf2NHXpcnPiYyqdogl0pBYGnP5YorFb_x-5yP5yRYJq43IscUZtIbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX32z2fuZ3z3a83ucACO9146X1cQdvzMTGPVlZH77O3A&oe=6AAAB79D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Revisit: Time Travel with Google Earth", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_nam
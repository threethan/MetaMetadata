a0a&_nc_ohc=tLmTIYH9ZcsQ7kNvwFTCHVz&_nc_oc=Adplt6pVOfyWhbyj0juzGDdeZHCkZYLr12ZgX6rFWUoUfflE4WKXcFVj-LUdjvVeaQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLU97Y3xfWMnAmZph52y7ElYn1A_JzjgnV53Td85baUg&oe=6A57902A"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "magic", "history"], "long_description": "**Miss New York\u2019s classic yellow cabs in Times Square?**  \n**Curious how the Eiffel Tower or Notre-Dame evolved through the decades?**\n\n**Revisit** lets you explore the past and present of **any real place**\u2014powered by Google Street View.  \nFrom famous landmarks to your old neighborhood, watch how places change over time in immersive 360\u00b0.\n\n\ud83c\udf00 **Drag the Time Rift** \u2014 a split between two timelines \u2014 to compare \u201cThen\u201d and \u201cNow.\u201d  \n\u2728 **Customize the Time Rift\u2019s visual style**: glow lines, glitch edges, vintage fades, and more.\n\n\ud83c\udf0d **Featured Destinations**\n- \ud83d\ude95 **Times Square** \u2013 From grit to glitz  \n- \ud83d\udfe3 **Las Vegas Sphere** \u2013 What came before  \n- \ud83d\udd32 **Shibuya Crossing** \u2013 Before the digital flood  \n- \ud83d\uddfc **Eiffel Tower** \u2013 Decades of change  \n- \u26ea **Notre-Dame** \u2013 From tragedy to rebirth\n\nYou're not limited to presets \u2014 **time travel anywhere** Street View goes.  \nYour own street. A dream trip. A place that no longer exists.\n\n\ud83d\udca1 **What Makes It Unique**\n- \ud83c\udf00 **Time Rift**: Swipe to reveal the past \u2014 and style it your way  \n- \ud83c\udf10 **Real-world locations**, not fiction or CGI  \n- \ud83e\udded **Curated scenes + open exploration**\n\nMore features coming soon.  \n**Try Time Travel VR \u2014 and tell us where you want to go next.**\n\nContact us via Discord: https://discord.gg/X5pZxBdcgn\n\n", "short_description": "Go anywhere, anywhen. Explore the past and present of any real place with Google Street View.\n\n"}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://moonvrhome.com/Time-Travel/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "https://moonvrhome.com/Time-Travel/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25576740931927876"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1328672575889306"}, {"status": "PUBLISHED", "id": "1403538915015047"}, {"status": "PUBLISHED", "id": "969521322249429"}, {"status": "PUBLISHED", "id": "1578996806670950"}, {"status": "PUBLISHED", "id": "2078635149643719"}, {"status": "PUBLISHED", "id": "1134728932120810"}, {"status": "PUBLISHED", "id": "614830931679877"}]}, "baseline_offer": {"id": "614830931679877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1328672575889306"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28454472267488047", "version": "0.1.1"}, "id": "1031868982074876", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28454472267488047"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "*  \u2728 Optimized visuals in 3D Fly Mode with reduced flickering, less distant clipping, and improved frame rate\n* \ud83c\udfb5 Added sound effects for dragging the Time Rift (volume adjustable in the Time Rift window)\n* \ud83c\udfaf Improved separation between UI and Street View interactions to reduce accidental clicks\n* \u26a1 Overall performance improvements", "created_date": 1783679787, "id": "28454472267488047", "version": "0.1.1", "version_code": 276, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28454472267488047"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1031868982074876"}]}, "change_log": "Long time no see, time travelers!\nWe've done a pretty thorough rebuild to improve the overall experience. It's not the final version and definitely not perfect yet, but I couldn't wait to let you guys try it first!\n\nNew Feature:\n   \u2022    \ud83d\udd0d8K Street View Everywhere\n   \u2022    Both Now v.s. Then and Navigation Mode are 8K now!\n   \u2022    \u2699  Image Quality Settings\nChoose the best balance for your device:\nBasic \u00b7 Medium \u00b7 High \u00b7 Ultra\n   \u2022    \u2728 Rift Effect Options\nSwitch between Premium and Basic Rift Effects anytime.\n   \u2022    \ud83c\udfc6  2026 World Cup Stadium theme \nThis Tour is sticking around for a while!. Enjoy! \u26bd\ufe0f\n   \u2022    \ud83c\udf0e  Fly the World in 3D (Add-on) \nExplore like you're really there\nEntire world powered by Google data \ud83c\udfd9\nClean, intuitive, beautifully crafted experience\nMore features on the way! \ud83d\udd1c\nGoogle data isn't cheap. We've done our best to keep this affordable and optional, so everyone can still enjoy the core experience. Take your time and enjoy each place before hopping around.\n\n\nFixes:\n    \u2022    \ud83d\udee0\ufe0f Fixed occasional Street View loading errors of black screens and crash\n    \u2022    \ud83d\udee0\ufe0f  Fixed a variety of UI, network, and image-related bugs\n\nImprovements:\n    \u2022   \u2728  Major UI overhaul for a smoother and more polished experience\n    \u2022   \u263a\ufe0f  Reduced jitter, glitches, and visual hiccups\n    \u2022   \ud83c\udfb5  Local FM now supports more stations with improved performance\n    \u2022   \u23eb  Better overall performance\n    \u2022   \u26a1\ufe0f  Smaller download size for faster updates\n\nAs always, thank you for all the feedback, bug reports, and support \u2764\ufe0f\n\nGive it a try and let us know what you think!", "created_date": 1782992212, "id": "28364758106459464", "version": "0.1.0-f19-r17", "version_code": 261, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28454472267488047"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782990878, "id": "28364565609812047", "version": "0.1.0-f19-beta16", "version_code": 260, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28454472267488047"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782458347, "id": "28290097230592219", "version": "0.1.0-f10-beta7-3dAddOn", "version_code": 248, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24837566725845304", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28454472267488047"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782380320, "id": "28279113995023876", "version": "0.1.0-f9-beta6", "version_code": 245, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
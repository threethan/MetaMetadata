1064442069446164_3434816009789863832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYR9Rx0rdkYQ7kNvwG2WDDw&_nc_oc=Adp0PsysUc__8yBkk3t0HsR_z8iHck8sQTIV7de7GIAs-9FG_vAEJMDVCaYNPAc0a6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ150M-S6FH009pCgPZF3kQdsZgAZwEQ3Yx34DWmCgNQ&oe=6AEF4E23"}, {"file_name": "3.png", "id": "1032558206286288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310720_1032558209619621_5556440488269448082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4b7bAwanoEQ7kNvwGMyCWl&_nc_oc=Adra5492_ZY-FXth02N75eCbmlwMZfCx1_PEzOitoS2wiYRgVbUBymam0AekPO-wTsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUN0CkUa7nlsI6Np4f0x-_oPfUPaaFrYJdvO6xO__L_g&oe=6AEF4226"}, {"file_name": "4.png", "id": "1078288771315440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1078288777982106_1949950600889181677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i5JaMp5mZ4Q7kNvwEDG3E0&_nc_oc=AdoLY3NdGo_w7thYX3Qzq_vozkNZ7kVo6SpobxtfEXXnx02RDp9f3Ovqyatx7TVucfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwt0b1t97xSmVruj28ygW1oTFIVlSEStagtdtn1NwP5g&oe=6AEF3C1E"}, {"file_name": "5.png", "id": "1370203801267562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1370203804600895_658251117304836128_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9vcQOUnszQQ7kNvwFaktTi&_nc_oc=AdoEzWq-rwvWtOWm3OdMHB5VRgf6eXlZf3mlzRkcdqC75is_6k0nWqBsXaSHfRIhwPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlletT1swkEQOUymsOB1Hn5cPhX1vyHlL_QtasdVITwg&oe=6AEF4C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "revisit cover image.png", "id": "1419758470134789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_1419758473468122_5463809189124617856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfpk0sShAHAQ7kNvwGxL2k4&_nc_oc=AdorPH_S6I9-S919Itd7Nhs042ZrSLmbJYdnnwv81hAedT4sBlx3Hi8AtCPhykv4vWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-GzVCRE45j2yIhCqzdeeVkV2zcwSoq5w4DIEDy87Zmg&oe=6AEF6733"}, "display_name": "Revisit: Time Travel with Google Earth", "keywords": ["GoogleEarth", "travel", "timetravel", "wander", "StreetView"], "long_description": "**Every place has a past. Revisit lets you step back into it.**\n\nExplore real places in 8K 360\u00b0. Jump between years, compare past and present, and revisit places you remember.\n\n# \u23f3 Travel Through Time\n\nVisit real places across different years.\n\nUse the **Time Rift** to reveal the past right beside the present.\n\n{4125580237715811}\n\n# \u2708\ufe0f See the World in 3D\n\nTake off and fly over cities, mountains, coastlines, and famous landmarks in 3D.\n\n**Fly in 3D** is available as an optional add-on.\n\n{2590542894725256}\n\n# \ud83d\udeb6 Go Anywhere\n\nSearch for a place, step into the street, and start exploring.\n\nMove through neighborhoods, revisit familiar places, or discover somewhere new.\n\n{1818894922581575}\n\n# \ud83c\udf0d Always Something to Explore\n\nJump into featured destinations, changing landmarks, World Cup stadiums, and places behind major stories.\n\n{1496770768298592}\n\n# \ud83d\udcfb Feel More Connected\n\nListen to **Local Radio** and check local headlines while you explore.\n\n{1305243991537071}\n\n**The world changes. Revisit lets you go back and see it for yourself.**\n\nDiscord: https://discord.gg/X5pZxBdcgn\n\nEmail: support@revisitvr.com\n", "short_description": "Revisit the places you remember. Compare then and now, and walk the streets with Google Street View."}]}, "developer_name": "Revisit", "developer_privacy_policy_url": "https://revisitvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Revisit", "support_website_url": null, "website_url": "http://revisitvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_t
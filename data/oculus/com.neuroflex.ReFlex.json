t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFqjf4mAtT1z0CUNIUSpNQGjgeyNB283t9FQc0nSDH-g&oe=6B05BCA3"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dGYUuH5dVQQ7kNvwENZLk2&_nc_oc=AdqdzXJGgyOLRRkdn-PGVvbW7QW1l3onYC68dj9YKpFAmXxvW9R7B-lRZ-vSUbiGKYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM3CDO87ygcgq4E6yy6mxeyyyX22bQkMCdfpq-rY2V0g&oe=6B05B61C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePt3M2ZZ8F8Q7kNvwH2OTMo&_nc_oc=Adoa7mDF1eX_jAKIVZ2roiwrXRXKaHiY_xEa9FtgkCjBoFEtzaq9VMdRvHG5tibE9LM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUfvTv7ygng9f6B9kwFqNbVWZdJQa7gvMl7FNnOO0ImQ&oe=6B05D7DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex by NeuroFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# **ReFlex by NeuroFlex**\n\n**ReFlex** is a VR platform engineered to train, restore and improve oculo-motor skills through immersive, guided exercises. Designed for individuals, athletes, therapists, and clinics, **ReFlex** combines real-time eye-tracking with structured training protocols to help users track, understand, and improve their visual and perceptual performance.\n\n---\n# Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **16+ Training Protocols:** Targets specific deficits with exercises for saccades, smooth pursuit, fixation, and binocular coordination.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n# Wellness & Performance Applications\n* **Neurocognitive & Motor Training:** Interactive activities designed to support cognitive, motor, and perceptual skills.\n\n* **Visual & Spatial Training:** Activities targeting visual tracking, gaze control, spatial awareness, and related perceptual skills.\n\n* **Research & Assessment:** Standardized, repeatable activities suitable for wellness, performance, and research settings.\n\n---\n\n**ReFlex** makes visual performance measurable and trainable, helping users sharpen their skills and unlock their full potential.", "short_description": "ReFlex is a VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://neuroflex.io/reflex-training-platform/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "reco
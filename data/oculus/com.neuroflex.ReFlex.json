V_IF4ooaQ8lJh11QFgZBiQHdA5Fhp-UzmA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYGgMUtaQXBRQ0bH2ARCl60wY6mXWZ1c-ojV9XVWk4qw&oe=6B085FA3"}, {"file_name": "Thumbnail-6_2560x1440.png", "id": "1387497513280010", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827585_1387497516613343_9056393096351138892_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXt69lDb61QQ7kNvwHdE34b&_nc_oc=AdoOA7izZsuD-cXxv9YrbByly6_x_vRyOYtCOcdJFRoxNmYH3Ggl7QM3U4J9bx2FCTk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYmnDuB1dVfHdbdsuQyf2vI37LddIr7_v8d-BjH5pZYg&oe=6B0872F9"}, {"file_name": "Thumbnail-7_2560x1440.png", "id": "1034080216268297", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_1034080219601630_4365945137870084943_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlPT6s0-VeEQ7kNvwG3T_Kp&_nc_oc=AdrKM6qyv4s6ILLFZ6JCMbOR_a8_gd1WbmL4u4_CmQuK0PkLGcRayO2vVo1k482Dyl0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY8X1pYVgelBQNqJnZHRYEZNzysAfqEz61z67j9uMBXg&oe=6B085CB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# ReFlex: Ocular Motor VR Rehab\n\n**ReFlex** is a clinically inspired VR platform engineered to train and restore ocular motor skills through immersive, guided exercises. Designed for therapists, clinics, and neuro-rehab programs, ReFlex pairs precise real-time eye-tracking analytics with structured protocols to deliver objective, data-driven outcomes.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **24+ Therapeutic Protocols:** Targets specific deficits with exercises for **saccades**, **smooth pursuit**, **fixation**, and **binocular coordination**.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n\n## Clinical Applications\n\n* **Neuro-Rehabilitation:** Post-stroke recovery, concussion management, and TBI rehab.\n* **Vision & Vestibular Therapy:** Gaze stability, pursuit deficits, and binocular dysfunctions.\n* **Clinical Research:** Standardized testing for observational and interventional studies.\n\n---\n\nReFlex modernizes visual rehabilitation by combining VR immersion, sub-degree eye-tracking precision, and actionable analytics in one seamless workflow.", "short_description": "ReFlex is a clinically inspired VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://www.neuroflex.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
71-25/491827960_1064541956105866_4075938217591861525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuR2fQRDu78Q7kNvwH-Zx2r&_nc_oc=AdolF5LHphxTt1G1uTPcTAHy8DJq4ijmXkj6kFnVBEqKqlNw7Hv1s1rwKp7Pe6g755I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa_9GfDpzd6AhXiS4hskgvvyKIveaaLGRRPdLsM_bbMQ&oe=6AD0D373"}, {"file_name": "Thumbnail-4_2560x1440.png", "id": "1239511388224322", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/625941762_1239511391557655_8053012925311120747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obMDMMLN6uIQ7kNvwE0Tq91&_nc_oc=Adq-RAQ6KYyD0TTZbcABF7entHvxZyeuKGjIN3xlpiC0f9rLWtqx7FHk2AbcnVNlhAc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6I8Nq60Vdz21Uvy0j0BLYKcTucq59-V8Qn9ih6L3QiA&oe=6AD100A3"}, {"file_name": "Thumbnail-6_2560x1440.png", "id": "1387497513280010", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827585_1387497516613343_9056393096351138892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOQLt0N7fUgQ7kNvwFg5EBh&_nc_oc=AdpPfEDIbkOvdkt_iJ6vQiARUGU611p93EsuZ18hkYj4D0fgzCMvFZaohGJmJUfnuaw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmIATES4KbAHrc1H1z_zNCckYEATw738FI5kLmRm148Q&oe=6AD0DBB9"}, {"file_name": "Thumbnail-7_2560x1440.png", "id": "1034080216268297", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1034080219601630_4365945137870084943_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3un-Nmwyx1wQ7kNvwHvaxyJ&_nc_oc=AdqauIQwe03FN9RoxGVVisWbLBKc3frJAcKfBo-FWY26X2okdULEp5yyYfIJdMU5D0E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGN_s6NiliIri8x4QVoZ670fkaWkwHQiTN75joxuqeVg&oe=6AD0FDB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# ReFlex: Ocular Motor VR Rehab\n\n**ReFlex** is a clinically inspired VR platform engineered to train and restore ocular motor skills through immersive, guided exercises. Designed for therapists, clinics, and neuro-rehab programs, ReFlex pairs precise real-time eye-tracking analytics with structured protocols to deliver objective, data-driven outcomes.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **24+ Therapeutic Protocols:** Targets specific deficits with exercises for **saccades**, **smooth pursuit**, **fixation**, and **binocular coordination**.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n\n## Clinical Applications\n\n* **Neuro-Rehabilitation:** Post-stroke recovery, concussion management, and TBI rehab.\n* **Vision & Vestibular Therapy:** Gaze stability, pursuit deficits, and binocular dysfunctions.\n* **Clinical Research:** Standardized testing for observational and interventional studies.\n\n---\n\nReFlex modernizes visual rehabilitation by combining VR immersion, sub-degree eye-tracking precision, and actionable analytics in one seamless workflow.", "short_description": "ReFlex is a clinically inspired VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analy
t=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjQAqRA_eaQet7wbLd5mO2RRYop0x7L_PJ3Z9Ge0l-4w&oe=6B0B3AE3"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=311A8W6QU3cQ7kNvwF_V8Vt&_nc_oc=AdpWNxABVpBjpu1z6YIc8l6Gy2MaBMQTRRm6YC3gc4kzUNZbfURgkkvhXmwQv7lcs9A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZ5hLJz49M94edPW8J4QW4swIICuUBbs3FrsGsgK47Wg&oe=6B0B345C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilyl0goPOJAQ7kNvwEVHSN8&_nc_oc=AdqwQhXYzuk1k7P2zvapIKSpBKsREG5cVxLzvpZ3rC-98ceeWpgO-lYcrVylWmPK1Ik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-taEn-ZeTf7W914550z6AboDNA2i_ExQQDsFvAIuYtQ&oe=6B0B1DDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex by NeuroFlex", "keywords": ["rehab", "training", "brain", "eyes", "performance"], "long_description": "# **ReFlex by NeuroFlex**\n\n**Train your eyes, sharpen your mind, and accelerate your reflexes in VR.** \n\nDesigned for rehabilitation and peak visual-cognitive performance, ReFlex turns eye-movement training into immersive VR exercises. Using real-time eye tracking, it measures gaze accuracy, peripheral awareness, memory, and reaction speed\u2014delivering objective scores to track session-by-session progress.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Measures gaze accuracy, peripheral awareness, and reaction speed during exercises to generate immediate, objective performance scores.\n* **16+ Training Protocols:** Targets specific visual-cognitive skills with structured exercises for saccades, smooth pursuit, fixation, memory, and binocular coordination.\n* **Immersive VR Design:** Keeps users engaged and consistent with their training while maintaining strict clinical and performance standards.\n\n---\n\n## Wellness & Performance Applications\n\n* **Rehabilitation & Recovery:** Interactive, repeatable exercises designed to support neurocognitive, visual, and oculo-motor restoration.\n* **Peak Visual-Cognitive Performance:** Targeted drills for athletes and individuals looking to sharpen gaze control, spatial awareness, and reaction timing.\n* **Research & Assessment:** Standardized protocols built for consistent tracking across clinical, wellness, and research environments.\n\n---\n\n**ReFlex** makes visual and cognitive performance measurable and trainable, helping you sharpen your reflexes and unlock your full potential.", "short_description": "Train your eyes, sharpen your mind, and accelerate your reflexes in VR. Designed for both rehabilitation programs and individuals seeking peak visual-cognitive performance, ReFlex turns eye-movement training into immersive, guided exercises. Using real-time eye tracking, it measures gaze accuracy, peripheral awareness, memory, and reaction speed\u2014delivering objective performance scores to track your progress session by session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://neuroflex.io/reflex-training-platform/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
ame": "Thumbnail-1-1_3000x900.png", "id": "906844049141844", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_906844052475177_3323101462426581538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmAkOHKOTXQQ7kNvwELzQnT&_nc_oc=Adq_GLpZqr_QqBRacq90vgDsGMRX5DhFOTBOGmnVpWzq_xGxw_yqLbqKmiBH3Oh1Weo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMagtwOSVXSLFuIFpxoGmTBuHisspn9ntlWlZxSMejxMw&oe=6ACBBA42"}]}, "id": "855158254287573", "locale": "en_US", "screenshots": [{"file_name": "Thumbnail-2_2560x1440.png", "id": "2489896371508122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2489896374841455_6076984004476811092_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2rcG9Wbe54Q7kNvwFcb4m4&_nc_oc=AdpbctR-duVrAIK5HHK9CoVceozxLftSORecx4jSKGY3AcQH982UqvunhkQuk5VLfhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbewfXt8wotrRm_cG0JritJyh30KYKiZzYjkiMr-i1hA&oe=6ACBBEC5"}, {"file_name": "Thumbnail-5_2560x1440.png", "id": "1064541946105867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1064541956105866_4075938217591861525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uVsaAoOYMAQ7kNvwGO0rBv&_nc_oc=Adq10LudGjXOxXEcueB6UF7LcgJGbFTnHsii_WZ6UK4zLNtP1P_lUh6vd9rZBjNM5F8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe73njAUk-y-T7O0T8bAs1Yptaa87qo7wnmG0rdpBuGg&oe=6ACB8D73"}, {"file_name": "Thumbnail-4_2560x1440.png", "id": "1239511388224322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/625941762_1239511391557655_8053012925311120747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95Uk50XALYoQ7kNvwE6R1ON&_nc_oc=AdrIfHbCKWGlz_ihUJjxaTAmwrrfHI3MfAAzoVmxJsBywp1S4YZb2rUtXGIhZSe8sDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhQWylrAdaxbS49lrhrhAxkQ8kJD6ld8csxqrxoI2iPw&oe=6ACBBAA3"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjwVY5LsUcMQ7kNvwGH9uf-&_nc_oc=AdpeB5fvh_POiBwWmuOHHAe7rZTXIGz-pbWDCqVnVJmZpkJqyvHb5IQAeEk3UPHRWdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC9TSl8BI5imvH4aOukPWhrUN_TVPxxdMHqAg8-Wh3HQ&oe=6ACBB41C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4vVzbgNv5IQ7kNvwGjM45l&_nc_oc=AdoAsQ5m912p53KD_ADTyW6edZcA13JyQTWdg705YDoE9jVjMlRiFn4tAqitIJ2Qrc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA-JLLNfzLoWRli2y_rUwMFlh0-z5dPu8n_1_nxpPmiA&oe=6ACB9D9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# ReFlex: Ocular Motor VR Rehab\n\n**ReFlex** is a clinically inspired VR platform engineered to train and restore ocular motor skills through immersive, guided exercises. Designed for therapists, clinics, and neuro-rehab programs, ReFlex pairs precise real-time eye-tracking analytics with structured protocols to deliver objective, data-driven outcomes.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **16+ Training Protocols:** Targets specific deficits with exercises for **saccades**, **smooth pursuit**, **fixation**, and **binocular coordination**.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n\n## Clinical Applications\n\n* **Neuro-Rehabilitation:** Post-stroke recovery, concussion management, and TBI rehab.\n* **Vision & Vestibular Therapy:** Gaze stability, pursuit deficits, and binocular dysfunctions.\n* **Clinical Research:** Standardized testing for observational and interventional studies.\n\n---\n\nReFlex modernizes visual rehabilitation by combining VR immersion, sub-degree eye-tracking precision, and actionable analytics in one seamless workflow.", "short_description": "ReFlex is a clinically inspired VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://www.neuroflex.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28543910641967001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.577
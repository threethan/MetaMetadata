scdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lRBlMxC53cQ7kNvwFN3yN_&_nc_oc=AdopcGxfEgGglj_wkpa0TtxXJikc7_Vlqy-UdnQwhLSsGyeKczHqLWOtMfgnRN_NpXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKjy6VR41JTlujdXE-vU-r-SU6sBabAmo4vHMUQwid7A&oe=6AC66E1C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVPltwERK7AQ7kNvwECqCL4&_nc_oc=Adph_5kLJOCHohlEpaHDN_k0g0LE_xmwrwoiZYmsWYP6ej0PVC0pRhfAw093ymPFcmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKQiybL6ui6rOnecd-x5Dx_eI1s_bx5ZXVzrjaGGBKvQ&oe=6AC6579B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# ReFlex: Ocular Motor VR Rehab\n\n**ReFlex** is a clinically inspired VR platform engineered to train and restore ocular motor skills through immersive, guided exercises. Designed for therapists, clinics, and neuro-rehab programs, ReFlex pairs precise real-time eye-tracking analytics with structured protocols to deliver objective, data-driven outcomes.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **16+ Training Protocols:** Targets specific deficits with exercises for **saccades**, **smooth pursuit**, **fixation**, and **binocular coordination**.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n\n## Clinical Applications\n\n* **Neuro-Rehabilitation:** Post-stroke recovery, concussion management, and TBI rehab.\n* **Vision & Vestibular Therapy:** Gaze stability, pursuit deficits, and binocular dysfunctions.\n* **Clinical Research:** Standardized testing for observational and interventional studies.\n\n---\n\nReFlex modernizes visual rehabilitation by combining VR immersion, sub-degree eye-tracking precision, and actionable analytics in one seamless workflow.", "short_description": "ReFlex is a clinically inspired VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://www.neuroflex.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28543910641967001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.577
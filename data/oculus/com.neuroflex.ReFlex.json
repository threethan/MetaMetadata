t=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYGgMUtaQXBRQ0bH2ARCl60wY6mXWZ1c-ojV9XVWk4qw&oe=6B085FA3"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=311A8W6QU3cQ7kNvwHEjSNe&_nc_oc=AdqVElUcsEOFKxOW6-IvW9eTEY1pudN3e9yRei0SIYY6wtxfLfmVZ-EEf88zuYCbmjI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGRq1qrB3ZihujAWPlwcq1psFBK2Cdw05DgN9jabasXg&oe=6B08591C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePt3M2ZZ8F8Q7kNvwGLd4lh&_nc_oc=AdqhMbbX6JNAdWb_GscQtiaw5MFRPQvsg9aCrn4hi3wG1RVj12lUbj0VQomP6kbelb0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIyfLeJ5TdQd0grpUbBSjC5dsYHKTd-x-vpQGIgdHOFw&oe=6B08429B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex by NeuroFlex", "keywords": ["rehab", "training", "brain", "eyes", "performance"], "long_description": "# **ReFlex by NeuroFlex**\n\n**Train your eyes, sharpen your mind, and accelerate your reflexes in VR.** \n\nDesigned for rehabilitation and peak visual-cognitive performance, ReFlex turns eye-movement training into immersive VR exercises. Using real-time eye tracking, it measures gaze accuracy, peripheral awareness, memory, and reaction speed\u2014delivering objective scores to track session-by-session progress.\n\n---\n\n## Core Capabilities\n\n* **Real-Time Eye-Tracking:** Measures gaze accuracy, peripheral awareness, and reaction speed during exercises to generate immediate, objective performance scores.\n* **16+ Training Protocols:** Targets specific visual-cognitive skills with structured exercises for saccades, smooth pursuit, fixation, memory, and binocular coordination.\n* **Immersive VR Design:** Keeps users engaged and consistent with their training while maintaining strict clinical and performance standards.\n\n---\n\n## Wellness & Performance Applications\n\n* **Rehabilitation & Recovery:** Interactive, repeatable exercises designed to support neurocognitive, visual, and oculo-motor restoration.\n* **Peak Visual-Cognitive Performance:** Targeted drills for athletes and individuals looking to sharpen gaze control, spatial awareness, and reaction timing.\n* **Research & Assessment:** Standardized protocols built for consistent tracking across clinical, wellness, and research environments.\n\n---\n\n**ReFlex** makes visual and cognitive performance measurable and trainable, helping you sharpen your reflexes and unlock your full potential.", "short_description": "Train your eyes, sharpen your mind, and accelerate your reflexes in VR. Designed for both rehabilitation programs and individuals seeking peak visual-cognitive performance, ReFlex turns eye-movement training into immersive, guided exercises. Using real-time eye tracking, it measures gaze accuracy, peripheral awareness, memory, and reaction speed\u2014delivering objective performance scores to track your progress session by session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://neuroflex.io/reflex-training-platform/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29191844857173573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622919_918944643831799_8229408657928798372_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbm2NqwdV7sQ7kNvwHxw7W3&_nc_oc=AdqrxSopDI0z1r7Mh-k4LMoW11H_EwAek_N_7hTNCsYJ_kzfvR4SvYVxVJ7KNcVog8o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBCbYHDQav4wx2XVYC6WL7L9RKIYDRAMsSZ14F8FP1zA&oe=6B0848C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ReFlex by NeuroFlex", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1790604000, "lastRevision": {"nodes": [{"id": "25854084500949642", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25854084470949645", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1104514305234974"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo-round_512x512.png", "id": "2293503504808821", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827646_2293503508142154_297959769221556859_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmE7xpABMoMQ7kNvwGRyWHv&_nc_oc=Adoy2rZlj9ZFbqPlaP91_eBJWPRBAQEySszDkHb0u19YYEleTasnur4iQHWnhgIbCfY&_nc_zt=3&_nc_ht=scontent-dfw
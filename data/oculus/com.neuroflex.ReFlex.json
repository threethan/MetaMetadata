ame": "Thumbnail-1-1_3000x900.png", "id": "906844049141844", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_906844052475177_3323101462426581538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt29BD1-SMUQ7kNvwGVDg7M&_nc_oc=AdrhRon3N1aq9CNGaSWfOgYXz4A9n-R7_xiWkeZSijhlsWLqyn-hLPw9JaqFHIAK0hc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3c_yzrYJoUF2HpONREVIvfyRFs664wmX4zsH0QEbEmw&oe=6ADDF702"}]}, "id": "2616001838918416", "locale": "en_US", "screenshots": [{"file_name": "Thumbnail-2_2560x1440.png", "id": "2489896371508122", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_2489896374841455_6076984004476811092_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxhlr7-fB0YQ7kNvwGz6k3H&_nc_oc=AdqeRZPDyUq4S5R-wSY0i8hajMfkdUm1Lonc4dYMzFbVfdPHTbsONU3nkx33V0sv26A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9-gB7fa6zDy1M-OqIuuTx1wRZDL_EX2QkqtAB8QXx1g&oe=6ADDFB85"}, {"file_name": "Thumbnail-5_2560x1440.png", "id": "1064541946105867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_1064541956105866_4075938217591861525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiK9QdvWlQ4Q7kNvwG0O4us&_nc_oc=AdqTVEcByRy1HtTH6egS8to7Eo5HaZL42mo3ptRqLJNj37uNpXR3lVyM_YyJfMQi07c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpkC3eCH5fhrBu4r6lHz4mnTzP97ghISJ5aoEM0G-DAQ&oe=6ADE0273"}, {"file_name": "Thumbnail-4_2560x1440.png", "id": "1239511388224322", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/625941762_1239511391557655_8053012925311120747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDhkOID4lp4Q7kNvwGXy8EA&_nc_oc=AdrhvdxeSLwX6pF0L3_5gJOrFAM0JDSgTrf8R2-z4GYRzHq2I6GxyYe6nkaCYwz9mKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM5btEtodhxCSl9w-aseAbjbc9rfNVfQ5YOvyrMj5Ifg&oe=6ADDF763"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT0rlzzOj-cQ7kNvwHn9m3z&_nc_oc=Adqs1DIrpA32TFIq1mLgxcTBjYvTdMsthOGaw3zCgLfBFglTvIeyb-PieOtMRKoi0mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3GWQuX_XEQ9SBDIIp_OfSQouS8aycMRCeDaHMx2gPVQ&oe=6ADE291C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53VpQy56F6wQ7kNvwH8SU9_&_nc_oc=AdohOEDsPZanF8OmaoJb3z8VaS6MOjLPJOcZtOOiSYt1cvCahhUR8H_snsCVfUlySBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPCU3nN1qzeWFATfZcove6Nb3fu0C7W4-mQntWl7QyEw&oe=6ADE129B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex by NeuroFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# **ReFlex by NeuroFlex**\n\n**ReFlex** is a VR platform engineered to train, restore and improve oculo-motor skills through immersive, guided exercises. Designed for individuals, athletes, therapists, and clinics, **ReFlex** combines real-time eye-tracking with structured training protocols to help users track, understand, and improve their visual and perceptual performance.\n\n---\n# Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **16+ Training Protocols:** Targets specific deficits with exercises for saccades, smooth pursuit, fixation, and binocular coordination.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n# Wellness & Performance Applications\n* **Neurocognitive & Motor Training:** Interactive activities designed to support cognitive, motor, and perceptual skills.\n\n* **Visual & Spatial Training:** Activities targeting visual tracking, gaze control, spatial awareness, and related perceptual skills.\n\n* **Research & Assessment:** Standardized, repeatable activities suitable for wellness, performance, and research settings.\n\n---\n\n**ReFlex** makes visual performance measurable and trainable, helping users sharpen their skills and unlock their full potential.", "short_description": "ReFlex is a VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://neuroflex.io/reflex-training-platform/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
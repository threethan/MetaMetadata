ame": "Thumbnail-1-1_3000x900.png", "id": "906844049141844", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_906844052475177_3323101462426581538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGVPn8evxDAQ7kNvwEp5zFR&_nc_oc=AdpVHIrYevh1hMN1fk_ozEQ0VJbwEcC8JLUi39dsVyqBb6bHcqlTokvoQkW0uyXxE5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsbcyX6506AcqKhNri3TSwcasJ3lRlnth20uJ1ITSYUQ&oe=6AE1EB82"}]}, "id": "2616001838918416", "locale": "en_US", "screenshots": [{"file_name": "Thumbnail-2_2560x1440.png", "id": "2489896371508122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_2489896374841455_6076984004476811092_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4mLNCQtwX0Q7kNvwG6nquL&_nc_oc=Adqhis78cNfj_tQ6PN-AHK__DecM3swNiCI0ui9E-TCNAeNfTKDPjHGvqDR7xni2hzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1RBaVAn_qfL_VukZHP25m7o_VrzLcCFYdMA9ghl0bxQ&oe=6AE1F005"}, {"file_name": "Thumbnail-5_2560x1440.png", "id": "1064541946105867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_1064541956105866_4075938217591861525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xYBD1ad6KEQ7kNvwHogZWX&_nc_oc=AdquGS3ViyZYTzvy0d96afgkTih-FVnpsNKyQTU7tVncS4sMWpgC85y94AKrlizgbrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNizpkM4dbKaFUx6wAiqlJyFsvramqipPZ87zxrn-E1Lw&oe=6AE1F6F3"}, {"file_name": "Thumbnail-4_2560x1440.png", "id": "1239511388224322", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/625941762_1239511391557655_8053012925311120747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3jOOF_fXKgQ7kNvwFJrIpX&_nc_oc=AdqO0jwPOHyTwbVfXWlL5Z8469Q77TO2zUN5lyB0Vk4eb_CoYslXqYPeOy4VJ5P_ziE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDbVTwrzoARm_viGUhF5a3QoWT3jEEZx8_YNqddPX0WA&oe=6AE1EBE3"}, {"file_name": "Screenshot 2026-09-30 105110.png", "id": "1519673059967367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312454_1519673063300700_6215188261767685263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmcOiBcDb7IQ7kNvwGF0xJp&_nc_oc=AdqDaUlzqhKOYP5TndCH89AHWtcio6lYm03iOdwQzgWO7vJpFqhgR0OaSYK0nLwFQ7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODAIL6UgS_d9MyFQH0BKHpSAU2qOgJPFVPKrtm-xZCYw&oe=6AE1E55C"}, {"file_name": "Screenshot 2026-09-30 104955.png", "id": "2206090676954325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307352_2206090680287658_3484942246438818406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Boz6NUulsC0Q7kNvwHE_Yxr&_nc_oc=AdphFZp_-dJqLLFW4A_GADkQYn0dTWX1uYOA41PoWyGphOYxCb4zxQVRFwb0hai8KLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNPkFTocc4o0bHCElthasTLiCGHYrM5kiG0UyspvrqcA&oe=6AE2071B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReFlex by NeuroFlex", "keywords": ["rehab", "concussion", "training", "eye"], "long_description": "# **ReFlex by NeuroFlex**\n\n**ReFlex** is a VR platform engineered to train, restore and improve oculo-motor skills through immersive, guided exercises. Designed for individuals, athletes, therapists, and clinics, **ReFlex** combines real-time eye-tracking with structured training protocols to help users track, understand, and improve their visual and perceptual performance.\n\n---\n# Core Capabilities\n\n* **Real-Time Eye-Tracking:** Evaluates spatial accuracy, response timing, and motor control during exercises to generate immediate, quantifiable performance scores.\n* **16+ Training Protocols:** Targets specific deficits with exercises for saccades, smooth pursuit, fixation, and binocular coordination.\n* **Progress Dashboard:** Syncs session data to a secure platform to monitor long-term recovery trends, adjust treatment plans, and validate outcomes.\n* **Immersive VR Design:** Maximizes patient engagement and therapy compliance while maintaining strict clinical rigor.\n\n---\n# Wellness & Performance Applications\n* **Neurocognitive & Motor Training:** Interactive activities designed to support cognitive, motor, and perceptual skills.\n\n* **Visual & Spatial Training:** Activities targeting visual tracking, gaze control, spatial awareness, and related perceptual skills.\n\n* **Research & Assessment:** Standardized, repeatable activities suitable for wellness, performance, and research settings.\n\n---\n\n**ReFlex** makes visual performance measurable and trainable, helping users sharpen their skills and unlock their full potential.", "short_description": "ReFlex is a VR rehabilitation app designed to train and improve ocular motor skills through immersive, guided exercises. Built for therapists, clinics, and research-driven rehab programs, ReFlex combines precise eye-tracking analytics with engaging VR protocols to deliver measurable results.\n\nUsing real-time eye tracking, ReFlex evaluates how users perform during each exercise\u2014capturing accuracy, timing, and control\u2014to generate objective performance scores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://neuroflex.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saccade Analytics Inc. ", "support_website_url": null, "website_url": "https://neuroflex.io/reflex-training-platform/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
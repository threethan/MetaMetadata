123003_2859120775970605318_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjATIGj61rEQ7kNvwE8v1XQ&_nc_oc=AdpeWUerRlJtZ9KsXnI7sIxDb55D5urk4r7ZDh_UwVxhcATYCM-S3rhD_-7Le1O_3Jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb_6Nm237ZO3ISAs9Ei1DjSnWAtK1s1tAHg3I1sohYnw&oe=6B09C808"}, {"file_name": "4.png", "id": "882514715795760", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982445_882514719129093_820657523598789086_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5wO-twm-R8Q7kNvwFUPwE0&_nc_oc=AdoZL4kYfbLYfltiEF_ZBRDkjDySr5kX18uWiaqPfAk2w2RpKE6zpcReAMIdblooV-4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJakWGluabBLI1vBoKinndkb21kpCopMwKph0Kj50mWw&oe=6B09BB9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Applab - Trailer Cover (2).png", "id": "570868000876641", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_570868004209974_5278141677104412579_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGnOthTiVUgQ7kNvwHBGO6w&_nc_oc=Adqn88OQYa0rGFxi8sXTDmFgggsZ5TtuHn8CWi7JA5qb_kgd660OFGC9NIFT00a1TAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdNDnc6nMTeGQbN_IvFZYrYzrauSp0l6VhPz7ZCTurlg&oe=6B09B74E"}, "display_name": "Cyber Defense 2088", "keywords": [], "long_description": "Its the 80s again, the 2080s, and your mainframe is under attack from rival factions who want to take our city and all we have achieved. Multiple generations of people have settled here since 1986 and called this place their home. They are in trouble and you decide the best defense is a good offence and allow yourself to be transformed into pure energy. You leave behind the physical world and enter this new virtual reality called cyberspace! Your first priority is New Zylon, save it from these attacks, capture the enemy's code and use it unlock more weapons, turrets, and powerful AI bots in this epic tower defense shooter!\n\nTake a journey into one of the first VR tower defense game that puts you into the action as a first person shooter with full 6 DOF flying. Use the parts of destroyed enemies to build turrets and unlock upgrades. Enjoy dozens of cyberpunk music tracks as you defend your city!", "short_description": "Cyber Defense 2088 is a fully immersive, full flying, tower defense shooter. You will fly around in this cyberspace world of the 80s to stop attacks with many weapons, turrets, and defenses. 32+ levels and over a dozen cyberpunk music tracks to enjoy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cttrc.com/?page_id=3", "developer_terms_of_service_url": null, "publisher_name": "Calming Winds Productions", "support_website_url": "https://cttrc.com/?page_id=1139", "website_url": "https://www.facebook.com/CalmingWindsProductions", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "304602928356921"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1059723975537381"}, {"status": "PUBLISHED", "id": "617640355995458"}]}, "baseline_offer": {"id": "617640355995458"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729789200, "status": "PUBLISHED", "id": "1059723975537381"}]}, "liveChannel": {"nodes": [{"l
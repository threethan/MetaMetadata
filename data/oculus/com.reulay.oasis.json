3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwDLqs7Phe3voIoWGwlJz2wxZjrYst-waYGgKgdwdg-Q&oe=6AA94C7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "987014768853953", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75223478_987014772187286_2916297901549302433_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OtusJE0IIYQ7kNvwEWtIZQ&_nc_oc=AdpKPcGJZocdOJfFCm3l_4d_A6imb14fdt8tX0L6_Bx3DStyCDp86ErFuIQoYLyX3OQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5EMR48ORSFCxADQ3ZCDR6Z-HxE2n2htwn9ISbHmDW7Q&oe=6AA93B98"}, "display_name": "Reulay Inc", "keywords": [], "long_description": "Founded by leading psychiatrists and neuroscientists, REULAY\u2019s Virtual therapeutic platform reduces stress and anxiety, while increasing resilience, focus, and mental wellbeing.\n\nReulay\u2019s AI recommendation engine leverages artificial intelligence to match survey data to evidence based experiences targeting 7 parts of your brain\u2019s anxiety circuitry.\n\nUsing Reulay 3x a week has shown statistical reductions in state-anxiety, emotional destress, and increased focus. The more you use the platform, the better you can feel. \n\nReady to Reulay?", "short_description": "Reulay's research-backed mental health platform uses AI to match a user's mental state to targeted brain-based interventions to reduce anxiety & stress, while increasing mental focus & wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reulay.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Reulay Inc", "support_website_url": null, "website_url": "https://www.reulay.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "inte
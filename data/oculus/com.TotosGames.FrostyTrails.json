-v3opZFiiCE_jwl4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMD2XH2s5j47gI9E5DnMtjFKRdUj_BGoaz_ZlFEH4Hpg&oe=6AA01935"}, {"file_name": "Screenshot2560x1440-3.png", "id": "555894587275334", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974741_555894590608667_8956984659636462669_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq9can0q0eQQ7kNvwFPBjs8&_nc_oc=Adq_80by11dpOF-fflCwOILAIYYhWbgf5dn_qYg7B_SGJ_P-4EVAvuOV_nUgBz0eHQI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJq-tby_xK0pNVRhYJeNl2C9oiKmaeXAa_y2lg4V7yfw&oe=6A9FFDC0"}, {"file_name": "Screenshot2560x1440-4.png", "id": "1322220345445928", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974741_1322220348779261_4355208930212705271_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIAy9lbBk-MQ7kNvwH4F8Xn&_nc_oc=AdqgEFc8acqCNtC9bgDC5APl2yg5gJW0geWAvYY_UnuxWh1WTnxeV571oWYd0cdvfqE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRwuJxNbwg6MK42MtR3zcyah8gvqaFgcnCZIFO47jHYA&oe=6AA023F4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4tFF7JtEd0Q7kNvwFWqBaN&_nc_oc=Adr2g28Hzd77kfcuekv4NYvMA91pkjpAw2-cCz_tfKo21_Jnre4rfBECCsy6wp5DZEg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxslqYEguREOJdHy5S5G4fjxDoSA4yuRR15d9S6gSelg&oe=6AA016E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqcqlryiEfQQ7kNvwHZpI70&_nc_oc=AdozeP01pgRxUQ7xN6fAb4mLu0AHgP9nXBhHpv9py0WOnc69JdSOZY1wvfWiH54yinM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHN2CVBQK600egm6W1XbYFO1IQHoTGxeJKuyTApHyhdw&oe=6A9FFF42"}, "display_name": "Frosty Trails", "keywords": ["Winter", "Snow", "Snowman", "Game", "Fun"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9065624733496757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348041_609286071499368_5865550229225138353_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0
yf7p7emszhTxMBqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNg67-0unyNq-K8vkSzQMKxcFTeCRJfu68JV_YJusMtg&oe=69CA8635"}, {"file_name": "Screenshot2560x1440-3.png", "id": "555894587275334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_555894590608667_8956984659636462669_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_65DB_OGjTMQ7kNvwE87Xwc&_nc_oc=AdoPRgBide0Rs1StNjaZEd5mfMpDSAaZUy9x75WOyJia_-GTCSmBKmY7hU4Kc_CPuvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylGMnM-ZqmqZml-CbJqlGgFKW2fkMhcRzQDi2ux-pW_w&oe=69CA6AC0"}, {"file_name": "Screenshot2560x1440-4.png", "id": "1322220345445928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974741_1322220348779261_4355208930212705271_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6ddiTREH9EQ7kNvwEZCVMU&_nc_oc=AdpFCL3fHS5YB_cdWphtWjUu--hvzhp6eT_4AUgSy7D_Bk8ispnADWk_IliXi5X1p4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV5E1XzRP1bVespMsCiBivvP17DZBMfVTmYq4WXx-igw&oe=69CA58B4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgW_dI8BgaAQ7kNvwGZ9K4S&_nc_oc=AdreCZLe5k6so1rg9u4jMU6-ERNaYJi1KqoePA7r7czqTBZw4hXSkOFlqb7UWlkQAjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkLHTCZTPur2Ah40hBLv6SRMHitoqBUUrAVGBBLoShBw&oe=69CA83E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCnFbXT3HQQQ7kNvwHQGb4N&_nc_oc=AdocRF8v3oV9Nzw_2N4r3t5RjOMb3wi1gR8sd2K5geDJknDQEiuAD2ULAnKxT-zYZKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk_b9yfwpLPnMhGjjdmfB2CJtv77SEa6ydVkJ6IL4Vog&oe=69CA6C42"}, "display_name": "Frosty Trails", "keywords": ["Winter", "Snow", "Snowman", "Game", "Fun"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9065624733496757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348041_609286071499368_5865550229225138353_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0
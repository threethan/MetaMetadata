034"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLjHW04ux3EQ7kNvwF-1nJY&_nc_oc=AdnKYGhnfhY9Ql-cmmfKM9AYRmLduIeCeljYM7zLe5_SI7jvOuepTW9vZ46z1yS8NeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftV3C6cdctZzCerTyADT5KPHy7CVqPg6_a02dTUweb3KQ&oe=69A6EB67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWd67dYthSAQ7kNvwGBdjYI&_nc_oc=AdmOoGVzarbfMovdedGIJFlunFWhMjeHLnZikzPFXEUre9GT6OcfybbIiP1O7m8f1qE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUZrUet7vama6NS4wg23sYEVy8L2atiAyQgomDQ0Xf3A&oe=69A6D3C2"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "categ
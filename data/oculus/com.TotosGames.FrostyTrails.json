ZNQcoABXed0u_1sCNSOHmLrzyeZqK1E1Fw&oe=6ACBA574"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3I7xX30T2UQ7kNvwEDqQUO&_nc_oc=AdoEjFywgorwTcYTSpmYlWcxGjEoxkkDiKIKc6Li2KtDnw5K3wHqw3AdfHH2YCzXNtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBDHcvca1iFl5wL-lWkkEFeaC0tWcGpxDTVm7cWFT9KQ&oe=6ACB9867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3B4L8dlyyoQ7kNvwH6Oi3l&_nc_oc=AdomvStpJpLBUEDZeWrTrxcKbIYIUc_EDm0Fiudz_4RBhBrqr3_9hHChx4Ebh3q2eW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB6VLt26aRlDpCzdkDPmpu8i_bCz7nO1CZ1ssp9gn6mA&oe=6ACBB902"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_
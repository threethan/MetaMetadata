64.5771-25/38974741_1322220348779261_4355208930212705271_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVbJufFeo3QQ7kNvwEiLRX7&_nc_oc=AdrB33i7OLGaO3O-MMKd6H4x-D0CaO7ApwQ81UrCjp_WP59DuOw7EDxinjOEpsUfjMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47EqXW_4rvD3XP6XVl6wZQEd_IlT3B3H3o1B8hH7d7MA&oe=6A088774"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni9YpU0scx8Q7kNvwFjh52b&_nc_oc=Ado5Bb9xOFsVTUMu6qxirEsrvN55_OrDJpMrOaRYagi20ySPgKkhCwYxEJdV30zMsD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZFKug87ZvtuUVr52dSH-7PIaEzecnEr3zrQcQ6zKcEA&oe=6A087A67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BzygGivhNEQ7kNvwGrVWQa&_nc_oc=AdoRtrM7FDu1eGkX_mP1nzIGgYp0LrSxYwF3FnCaWllJ4JpiWFUUy1pf9knctjKxKss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ghKDakf5k6MLx72PRvT2Z7LFPA8fktBRtmxySvb9r5A&oe=6A0862C2"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9034060379986526"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1130491321988722"}]}, "baseline_offer": {"id": "1130491321988722"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735702380, "status": "PUBLISHED", "id": "1130491321988722"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9010201482372416", "version": "1.0"}, "id": "1124360171990605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9004947882897776", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9010201482372416"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "
-AubemeM-lF7rI6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CRS1ytFR4qxlyKU-3vyyrbIP7thiiSQ26Saj7KnhLLg&oe=6A33FE35"}, {"file_name": "Screenshot2560x1440-3.png", "id": "555894587275334", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974741_555894590608667_8956984659636462669_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVg9-tGHDm0Q7kNvwGa-9fw&_nc_oc=AdqbbKKvHRXgutIAdnGcXdXtw1s1FK3U_N-xXDE0oWtfINeSnMd7GWLX5kRxAyzYS8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90uUwvn1E829v6zAk7VZRS1ugEXxFzqTbJNx-DQqCEUw&oe=6A341B00"}, {"file_name": "Screenshot2560x1440-4.png", "id": "1322220345445928", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974741_1322220348779261_4355208930212705271_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3J31u-6BwEQ7kNvwFzEqFo&_nc_oc=AdpaSSC6GRMJSdtRd0wJVfRRGmfU5cL1OK6GxG73UXEJbuYEWWyIEv_t9YVWSSRRbTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kxW0uoYWzV513FRqt-PUpZanx4eZt903qzfbGLhONoA&oe=6A3408F4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmgsyAcitkoQ7kNvwEJprEZ&_nc_oc=AdqSwzLdLG7QUlqGdBEcbTVBVy1k9Gkjp_YLCB529G_AF5hS0yDtGOWRhpvkr9vL_7I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RFJyFej7U_8xzWsS44UOTxb5sImfaI57khQN4JCUlFg&oe=6A33FBE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAa1_FjFvPkQ7kNvwGA97tL&_nc_oc=Adohmvn-5vUkzg4XPRYg3ZTGtlRPP7jF3MpHRnVWNjNa6ci9yIFG5Pi1P3IkSSx6Qco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IB96ETAEdPM9nm7ws3RhYomTdre91MCWcjKnlkmjTOA&oe=6A341C82"}, "display_name": "Frosty Trails", "keywords": ["Winter", "Snow", "Snowman", "Game", "Fun"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9065624733496757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348041_609286071499368_5865550229225138353_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0
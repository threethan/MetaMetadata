.com&_nc_ss=7f20f&oh=00_AQOxRLD2O4hryEJT-K4WLkGXFNBFTAqAOQElBNsR9lDaGA&oe=6AD23CF4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lATyTLO9MbMQ7kNvwFc61z1&_nc_oc=AdpAVEQFLx3VjkYm5CM3cJ9GpatR-QV690UNE25tsNluzI1-OA6wB797uJuoVYSmJHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ8No0m9cuAkmmVqn39hGB2nAvXMHR3zQoh7uL6xjGKQ&oe=6AD22FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-KgAwN5EvkQ7kNvwGbgH10&_nc_oc=Ado0ArWzLd1v_hdCkD6B_zkVjKuinij_eHrrugL6jDROzzNdMgDsMZzw361azbtRPeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO21SMNT-8_nK4zoWhgOJ4VsqN7P7fkezAF6xZN3y8r4w&oe=6AD25082"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publis
64.5771-25/38974741_1322220348779261_4355208930212705271_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu5jRazQjNcQ7kNvwH1tIzS&_nc_oc=Adqt97AbnoGYCuiDwELmGJrYvUXARxKcfrnYhbNNtIVLY2AqqMeNNSsHbweXLtwtesw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoI3-RWVQLBvOpX-mnqUNj7gvsDBNznq5rWdUinYQJqA&oe=6ABA81F4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRQ5iSRMNFQQ7kNvwHbXM--&_nc_oc=AdpqcWDrpRJAv4lwf3fsjQqSJo3fIulRZ0yVGDcoOsDhw6i7Q9GpT_RYmyg0Y6u7Y_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_910ktHqgis26cj7uteHsteeXD_IN4OL6kZTqgSs7bA&oe=6ABA74E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KO4KNBfQ5YQ7kNvwFR_HEz&_nc_oc=Adp5d0G5DtEM6FMy45tsxnC301yMaCp7xSdTpW-iaO86Q99-Dx0Jf58HC07YCNgRVCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3htzzQ_81S26HeaEguhtpSq_2wwkhZaztLRGMGt5jw&oe=6ABA5D42"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9034060379986526"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9010201482372416", "version": "1.0"}, "id": "1124360171990605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9004947882897776", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9010201482372416"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1124360171990605"}]}, "change_log": null, "created_date": 1735242349, "id": "9010201482372416", "version": "1.0", "version_code": 1, "releas
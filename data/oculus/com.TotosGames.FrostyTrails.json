.com&_nc_ss=7f20f&oh=00_AQPXcyaf6lAKjYuoSsfWLfrRNayRAWLT-TYJNPMcA35J3Q&oe=6AD0EB74"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lATyTLO9MbMQ7kNvwGwNtqU&_nc_oc=Adp2OfSv11SmvRAkSQWy2v3d9d6Em6ZkwGHqEzJldsAroiVZe-TxhbveqGWEtEaXw8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOfvJNgAloPbNw4cjQRO00puteile4MWjbRILVQAMQkA&oe=6AD0DE67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-KgAwN5EvkQ7kNvwFQ5GNT&_nc_oc=Adpov7p6rDxeLwLf90WWwa_8K0bI1sDPac6H3-GZvW0LnjmFisHmTjyFyUFiHw0CG4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyQgh7p2cNQbOufEUDqiXM6gkpjMmkRnXh-HEU8P35Zw&oe=6AD0FF02"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publis
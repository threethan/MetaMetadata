GOIeN2Thbth53eR7-etyoDgR3Qk7w1krd8qPythRInb01pfEYXyJts8kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgq7WGRZX0QZEyA9URNq_LzZw6QsuAyem3iXjurGN9Zw&oe=6B072427"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_bl2Gv776oQ7kNvwHmfQY9&_nc_oc=AdqMWj9XjwbgTuPwN36RNEUqKwis4n29YMDbUcJ9MQxMtqvj5uMMCTx0HpDRDgVlmKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-fdODtGKh4z29ZD6_oaurNLtVvtRONS9v2mNwrzEOGQ&oe=6B070C82"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968
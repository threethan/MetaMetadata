5ej7OjHQii5cRdldqAPh-eA4IwTu0kw42w&oe=6ACCF6F4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3I7xX30T2UQ7kNvwFKy-RF&_nc_oc=Adpny8AsIWHixlqEkMscyGx1GL2O_BaflnoBT8a2o7nAr_K0Of0an8icX7-_1v96Kms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLtbWYn6aZBR5Y6UtZLioI_DTkMT9UM8nNPKbzF3z0FA&oe=6ACCE9E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMEiaUz7KpMQ7kNvwH1XAyA&_nc_oc=Adojj08VxFagc0h11Ghh4qC-4Ymx0h0FTwDvV_pM5cOrly_fHzEoyyIhbmC4tBYuQQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi0iSQtKRUVJ4ChNU1HNJ9QBpvddwZ0mUeX-f3fAe_Yw&oe=6ACD0A82"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_
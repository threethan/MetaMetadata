?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0xDt09YH2sQ7kNvwEE2PYt&_nc_oc=AdrQCyt_rTiCL3Eql1ageXfN6m2fCXfUG_czUa2W_QsngrmgdXVXwSgUKso5uavqK3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRchdAGtTE15rqai9gbh410y-k80YQyFhRY-w-ObbG6sQ&oe=6B01DE27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP_asRtvdQAQ7kNvwF6X2FT&_nc_oc=Adpbp3HpDa0FvYynLm2wZTcBvdQ2pV4tWi57dVbqQqNwXHZfan7wNJ2kzlfQ39WNE6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQlq4yNp1O0tbIHtOG9r8tC8luTK8bS6KP6Km3cDi8Aw&oe=6B01C682"}, "display_name": "Frosty Trails", "keywords": ["Winter", "Snow", "Snowman", "Game", "Fun"], "long_description": "Frosty Trails is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trails is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
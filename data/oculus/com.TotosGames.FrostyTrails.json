EB4"}, {"file_name": "Screenshot2560x1440-2.png", "id": "483161571456607", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210896_483161574789940_6139196803644246882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z74mIycljJ8Q7kNvwE89ghH&_nc_oc=AdmYNcEYCZVDt7JlHca8YqVZtzsTtryQJg2EBxJD9QgpMD-z-8TDbz6NQ7ZRB7Qa9JI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvBwImsWGSlQkPp9QVUeEO3nO3GutN_TmHRcCt0c1D7NQ&oe=69A599E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frosty_logo (2).png", "id": "2861940993967514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974581_2861940997300847_2758401840301453355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWd67dYthSAQ7kNvwFpSThw&_nc_oc=Adn1gHWXQ82o1I-M9n_boNV_HIzHY6lj2vAcI43WUZp3n7L1hpB-J8OyeEdDw9dEF1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuOe1cUNR2AkidRq7sNeew4xPxnSbS9uUt3S9oe8gVdMw&oe=69A58242"}, "display_name": "Frosty Trails", "keywords": ["Christmas", "Runner", "Endless", "Winter", "Snow"], "long_description": "Frosty Trials is an action-packed endless runner VR game that immerses you in a snowy wonderland. Navigate snowy trails by moving left, right, or staying centered while your character runs automatically. Perform epic jumps and flips to avoid obstacles, and collect snowballs to unleash powerful skill-based projectile attacks. The enchanting snowy environment, filled with scary snowmen, delivers an engaging and immersive experience. Frosty Trials is the ultimate blend of endless running, strategy, and VR adventure, offering hours of fun.\n\n", "short_description": "An endless runner VR game in a snowy world, thrilling jumps, flips, and skill-based snowball projectile attacks.\n\n"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "categ
35\u043b\u0435\u0439\u043d\u044b\u043c\u0438 \u043c\u043e\u0440\u0434\u0430\u0448\u043a\u0430\u043c\u0438 FaceZap \u2014 \u043a\u0440\u0430\u0441\u043e\u0447\u043d\u043e\u0439 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u043e\u0439 \u0441 \u0431\u043b\u043e\u043a\u0430\u043c\u0438 \u0434\u043b\u044f Meta Quest. \u0420\u0430\u0437\u043c\u0435\u0449\u0430\u0439\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u044b, \u0437\u0430\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u0440\u044f\u0434\u044b \u0438 \u0441\u0442\u043e\u043b\u0431\u0446\u044b \u0438 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u044f\u0440\u043a\u0438\u0435 \u043a\u043e\u043c\u0431\u043e. \u0417\u0430\u0440\u044f\u0436\u0430\u0439\u0442\u0435 \u0431\u043e\u043d\u0443\u0441 ZAP, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u043d\u0430 \u043f\u043e\u043b\u0435. \u0418\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u043c \u043c\u0438\u0440\u0435 \u0438\u043b\u0438 \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0435 \u0443 \u0441\u0435\u0431\u044f \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u044b \u0438\u043b\u0438 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0440\u0443\u043a, \u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044f \u0438 \u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0441\u0438\u0434\u044f \u0438\u043b\u0438 \u0441\u0442\u043e\u044f.", "short_description": "\u041a\u0440\u0430\u0441\u043e\u0447\u043d\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430 \u0441 \u0436\u0435\u043b\u0435\u0439\u043d\u044b\u043c\u0438 \u043c\u043e\u0440\u0434\u0430\u0448\u043a\u0430\u043c\u0438, \u043a\u043e\u043c\u0431\u043e \u0438 \u0440\u0435\u0436\u0438\u043c\u0430\u043c\u0438 VR \u0438 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438."}, {"images": {"nodes": []}, "id": "3327402580981563", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["blok", "bulmaca", "jelibon", "kombolar", "karmager\u00e7eklik"], "long_description": "FaceZap, sevimli jelibon suratlar\u0131 Meta Quest i\u00e7in renkli bir blok bulmacas\u0131nda bulu\u015fturuyor. Ta\u015flar\u0131 tahtaya yerle\u015ftir, sat\u0131r ve s\u00fctunlar\u0131 tamamla, e\u011flenceli kombolar olu\u015ftur. Tahta doldu\u011funda yeni hamlelere alan a\u00e7mak i\u00e7in ZAP bonusunu doldur. Canl\u0131 bir sanal ortamda oyna veya karma ger\u00e7eklikle oyun tahtas\u0131n\u0131 odana ta\u015f\u0131. Kontrolc\u00fcleri ya da el takibini kullan; tahtay\u0131 yeniden konumland\u0131r ve oturarak veya ayakta oyna.", "short_description": "Jelibon suratl\u0131 ta\u015flarla renkli blok bulmacas\u0131! VR ve karma ger\u00e7eklikte kombolar yap."}, {"images": {"nodes": []}, "id": "2311883679353030", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["\u65b9\u5757", "\u62fc\u56fe", "\u679c\u51bb", "\u8fde\u51fb", "VR"], "long_description": "FaceZap \u662f\u4e00\u6b3e\u4e13\u4e3a Meta Quest \u6253\u9020\u7684\u5f69\u8272\u65b9\u5757\u62fc\u56fe\u6e38\u620f\uff0c\u5145\u6ee1\u8868\u60c5\u751f\u52a8\u7684\u679c\u51bb\u4f19\u4f34\u3002\u653e\u7f6e\u65b9\u5757\u3001\u586b\u6ee1\u6574\u884c\u6216\u6574\u5217\uff0c\u6253\u51fa\u7545\u5feb\u8fde\u51fb\u3002\u68cb\u76d8\u5feb\u6ee1\u65f6\uff0c\u79ef\u6512 ZAP \u80fd\u91cf\uff0c\u4e3a\u4e0b\u4e00\u6b65\u817e\u51fa\u7a7a\u95f4\u3002\u4f60\u53ef\u4ee5\u5728\u7eda\u4e3d\u7684\u865a\u62df\u4e16\u754c\u4e2d\u6e38\u73a9\uff0c\u4e5f\u53ef\u4ee5\u901a\u8fc7\u6df7\u5408\u73b0\u5b9e\u628a\u68cb\u76d8\u653e\u8fdb\u81ea\u5df1\u7684\u623f\u95f4\u3002\u4f7f\u7528\u624b\u67c4\u6216\u624b\u90e8\u8ffd\u8e2a\u64cd\u4f5c\uff0c\u81ea\u7531\u8c03\u6574\u68cb\u76d8\u4f4d\u7f6e\uff0c\u5750\u7740\u6216\u7ad9\u7740\u90fd\u80fd\u73a9\u3002", "short_description": "\u548c\u53ef\u7231\u7684\u679c\u51bb\u7b11\u8138\u4e00\u8d77\u73a9\u5f69\u8272\u65b9\u5757\u62fc\u56fe\uff0c\u5728 VR \u6216\u6df7\u5408\u73b0\u5b9e\u4e2d\u6253\u51fa\u7cbe\u5f69\u8fde\u51fb\u3002"}, {"images": {"nodes": []}, "id": "1802799130941384", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["blokken", "puzzel", "jelly", "casual", "mixedreality"], "long_description": "Ontmoet de jellygezichtjes van FaceZap, een kleurrijke blokkenpuzzel voor Meta Quest. Plaats stukken, maak rijen en kolommen vol en bouw leuke combo's op. Laad de ZAP-bonus op om ruimte te maken als het bord vol raakt. Speel in een virtuele wereld of haal het bord met mixed reality je kamer binnen. Gebruik controllers of handtracking, verplaats het bord en speel zittend of staand.", "short_description": "Een kleurrijke blokkenpuzzel met jellygezichtjes, combo's en VR of mixed reality."}, {"images": {"nodes": []}, "id": "1785864012703244", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["blocchi", "puzzle", "gelatina", "casual", "realt\u00e0mista"], "long_description": "Scopri le faccine gelatinose di FaceZap, un colorato puzzle a blocchi per Meta Quest. Posiziona i pezzi, completa righe e colonne e crea combo soddisfacenti. Carica il bonus ZAP per fare spazio quando la griglia si riempie. Gioca in un mondo virtuale o porta la griglia nella tua stanza con la realt\u00e0 mista. Usa i controller o il tracciamento delle mani, sposta la griglia e gioca da seduto o in piedi.", "short_description": "Un puzzle a blocchi con faccine gelatinose, combo e modalit\u00e0 VR o realt\u00e0 mista."}, {"images": {"nodes": []}, "id": "1636262361507214", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["blocos", "gelatina", "casual"], "long_description": "Conhe\u00e7a as carinhas de gelatina de FaceZap, um quebra-cabe\u00e7a de blocos colorido para Meta Quest. Posicione as pe\u00e7as, complete linhas e colunas e crie combos divertidos. Carregue o b\u00f4nus ZAP para abrir espa\u00e7o quando o tabuleiro ficar cheio. Jogue em um mundo virtual vibrante ou leve o tabuleiro para o seu ambiente com realidade mista. Use os controles ou o rastreamento das m\u00e3os, reposicione o tabuleiro e jogue sentado ou em p\u00e9.", "short_description": "Um quebra-cabe\u00e7a de blocos com carinhas de gelatina, combos e modos VR ou realidade mista."}, {"images": {"nodes": []}, "id": "1505800334708409", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["blocs", "puzzle", "gel\u00e9e", "casual", "r\u00e9\u94f0alit\u00e9mixte"], "long_description": "Retrouvez les petites bouilles g\u00e9lifi\u00e9es de FaceZap, un puzzle de blocs color\u00e9 pour Meta Quest. Placez les pi\u00e8ces, compl\u00e9tez des lignes et des colonnes, puis encha\u00eenez les combos. Chargez le bonus ZAP pour lib\u00e9rer de la place quand le plateau se remplit. Jouez dans un univers virtuel ou installez le plateau dans votre pi\u00e8ce en r\u00e9alit\u00e9 mixte. Utilisez les manettes ou le suivi des mains, d\u00e9placez le plateau et jouez assis ou debout.", "short_description": "Un puzzle de blocs aux visages g\u00e9lifi\u00e9s, avec des combos \u00e0 jouer en VR ou en r\u00e9alit\u00e9 mixte."}, {"images": {"nodes": []}, "id": "1489779162992173", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["bloques", "puzle", "gelatina", "casual", "realidadmixta"], "long_description": "Conoce las caritas de gelatina de FaceZap, un colorido puzle de bloques para Meta Quest. Coloca piezas, completa filas y columnas y encadena divertidos combos. Carga el bonus ZAP para abrir espacio cuando el tablero se llene. Juega en un mundo virtual o lleva el tablero a tu habitaci\u00f3n con realidad mixta. Usa los mandos o el seguimiento de manos, cambia la posici\u00f3n del tablero y juega sentado o de pie.", "short_description": "Un puzle de bloques con caritas de gelatina, combos y juego en VR o realidad mixta."}, {"images": {"nodes": []}, "id": "1417934890318343", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FaceZap", "keywords": ["bloki", "uk\u0142adanka", "galaretka", "logiczna", "VR"], "long_description": "Poznaj galaretkowe bu\u017aki w FaceZap, kolorowej uk\u0142adance blokowej na Meta Quest. Uk\u0142adaj elementy, zape\u0142niaj rz\u0119dy i kolumny oraz tw\u00f3rz satysfakcjonuj\u0105ce kombinacje. Na\u0142aduj bonus ZAP, by zwolni\u0107 miejsce na planszy. Graj w wirtualnym \u015bwiecie lub umie\u015b\u0107 plansz\u0119 w swoim pokoju dzi\u0119ki rzeczywisto\u015bci mieszanej. Korzystaj z kontroler\u00f3w lub \u015bledzenia d\u0142oni, przesuwaj plansz\u0119 i graj na siedz\u0105co albo stoj\u0105co.", "short_description": "Kolorowa uk\u0142adanka z galaretkowymi bu\u017akami, kombinacjami oraz trybem VR i rzeczywisto\u015bci mieszanej."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1807378543727295", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1807378547060628_3445939346238823938_n.png?_nc_cat=110&_nc_map=urlgen_bucketless
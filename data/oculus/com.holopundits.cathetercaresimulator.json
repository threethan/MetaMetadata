bGXLyVSaOYh3LRflf71UB4AA2czCcy9A&oe=6A5B77B8"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NttHZEUV_4UQ7kNvwG2ymGc&_nc_oc=Adr5WmPKSZ-4cEhWy6pOH5nv5dn8iN7uVpGwT-sBed0ZJAReXQEzBtCL-TSPhROYtIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBks5RiRwnq-QTDL3BlXP9x4ONiFvnle4rzImzAovJBqA&oe=6A5B8A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjtTnJIEoYQ7kNvwF7c7jz&_nc_oc=AdqIoVDDjPEMVqu1AOmA7rx_M_0DGbnqN3_Mgqpe3BOeHNyzR7NxqeCVNFnQ4ULnLhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZPqZtYw2no4i3HtNVevwz6kFqKUIekHo9exaLMcO3eQ&oe=6A5B80DD"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
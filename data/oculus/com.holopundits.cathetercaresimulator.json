2i3O-O_aMnU-REtPLGk1SgaxHlRygMaQ&oe=6AE8C078"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Z58ggFc7WsQ7kNvwHf8ckz&_nc_oc=AdqSHG-gLlk0tlyUN-zb_CH2SwtuhGgFGFO8mP7tb-YtiIuyUoAZc0wbuHTUUPMw1WY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqupecC6kYrMeoYljS7AYt3iBOGpk17xEPjDmgBwGHGA&oe=6AE89A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-Z1fZfvJ7IQ7kNvwGu97cp&_nc_oc=AdqdTGnk1Tr51VBqmOWI3FAf5jKDfyUxQRTsFktm-5ZYWfVAJkoJgpbwj16XW_obbZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxzPCwu9thIfLo8G22VpSx8kd_UNpZp6KZWnMOlwdCHw&oe=6AE8915D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
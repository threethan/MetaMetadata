HWhWXihZCjBwHdn5R9OWcz9wLQLilH5Q&oe=69DB9638"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVNEzKNoSgkQ7kNvwEAeg7u&_nc_oc=AdqWuwIfFly3BsRsaL4P6N8HvX4nnYHvpnaxwPe7d5ElOCMTf2o3Sw9To4gjVq2zd6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12EtFYjFdFWPndD3yDhppFsf2KpEI8VtW3BVsCym6hig&oe=69DBA880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4PDhLnCLeYQ7kNvwHK0z_k&_nc_oc=AdpBQwZTe8MBMrc-AMWpazolbqdn6lxSzw8X4gEdP1fIg4omwBa2ExODuY2Ja8JI7s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zy_zlkFkJx9mUWjf0n_2qtoTsXle02MyY6Zhxc3F4AA&oe=69DB9F5D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
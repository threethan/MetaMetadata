mN4hXMCY4qcoex0yCRTI08nFcYfOW7lQ&oe=6A58D4B8"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2_f9QoDQRgQ7kNvwEihqoC&_nc_oc=AdrhiiFSkTtB6aUZEH76QJ3zen6YJi0yT9fqM5SNyMdqTeaB_o8CHe1kj4R5j0aM6R0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeAqsr2jJAw271dEsNHITOZxu2eCITCIFBuB7qtG51pQ&oe=6A58E700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjtTnJIEoYQ7kNvwEY3Hl2&_nc_oc=AdrF1q5t5LdNaLm4zrfXyd7zps8s-mjWv4S5FnJuwjiMWwstLSsFv5SH4hatTSzCWJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnJVpaeYSM5CCe7AXytLaNgBjoHh3e2ncUEBAF96MjMA&oe=6A58DDDD"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
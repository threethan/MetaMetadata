RJAPVilxhOsaqE_ZtXFP2z1JdLGuINeg&oe=6A1446B8"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-2QMDFURz0Q7kNvwH9Yff6&_nc_oc=AdpBHvyEVYkMzoOZ1wRrzPeZ-PsXikVa6tndCHyzZEPhccUGwM1V1hQhME3U0Ji_av8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tDAu_6IXUpmJ6OrJUOWITznFstExSNBse4VMDZ6dt4Q&oe=6A145900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyR4GEHKshkQ7kNvwHz9Ha0&_nc_oc=Adr77yhuB8uyXiccejluxkprjuimlARRokQ1FTqeaD3U3ji7i0-5mp2mTZ_0lJoFM_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52t3k3rjZR-gFJ4AF5pagpOjd6qxWPsy7jyQB4RoUhSw&oe=6A144FDD"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
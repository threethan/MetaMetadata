xcOwy7ZU0LkWPF2tzC2A3rXTrrfYhqgg&oe=69E62238"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gibCfjDFig8Q7kNvwHrXc5H&_nc_oc=AdqW_rtd-ISKwpICkv1oJ4onjUX7G3s4DJXYfjylgI9358yUxGGZozlj99QvXB5n3iw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qHnRszDgM3ciOoIT7FuqjwB2IpnKfWOiBsTTp-QXhvQ&oe=69E63480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpVhhkYVymUQ7kNvwGfCkAg&_nc_oc=AdrRDaJnvzpx0TUFO0jbKWd0ZagTDr4crb-SJY-nUvSyY3J86N51BaCX7e4fq4E8SGU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z12svMv9FgwMIcSxeM2fSprFWByAvTsGCNfVVavYyxg&oe=69E62B5D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
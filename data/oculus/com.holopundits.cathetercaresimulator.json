apI3cC9iaaQKmrQ_sMurCKN8P_F9US5w&oe=69FB3A38"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQW8QiGulSMQ7kNvwFnD_pg&_nc_oc=AdocsfuwSd_CStKG3u1D4DqqWRv_ondft5_fdPoKvszur5sHQde_SNiMqKbdMwBZgv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KW5EPo_SMVe1EWNhV-9vRFtiYLfz9LQwjr1VEzR53sg&oe=69FB4C80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW2PRgYL788Q7kNvwFsIQMS&_nc_oc=AdrAo0R9h6eHaXmzu0RpqZz2P5pEjqPadf6Q8xGS2pwz6b82wlLFkvQ-hSUerMTPhLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C_YJUqaBlZXOzFza1fPp5LSS5Q56mFz-AJn42K4iY1w&oe=69FB435D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
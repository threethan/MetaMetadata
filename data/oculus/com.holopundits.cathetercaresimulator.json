OMNsAwOtTUJpZrAGiuplGWCwn19eEmOQ&oe=69C3DB38"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHwoZMGRcXkQ7kNvwHf4Pr-&_nc_oc=Adoxirz6su1yeZJBGN5mtKDY-nQ01yAARqXmbWsGk5Z5cHkwqQkoZu2uE6wNY6HZoO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCBJprZOpy15UsZLrgauxfCAIsUhBsDqXe-vcfzJ2CqQ&oe=69C3ED80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6wJJl6xnWYQ7kNvwFm8CcV&_nc_oc=AdojduSlVzMhsrsrGs_i7cNmc84cArSvanjl4qSRLM88U-TMbcgvvNLxbBQORDa3L_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4OCV_BkgcCp5hnz6W01mPzqGpqldJTI2xyQRE1NKmLA&oe=69C3E45D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
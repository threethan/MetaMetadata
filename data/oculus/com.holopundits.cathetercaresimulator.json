TR7VpgGat61-HaaIDa1nyhQ6_cxPT9Yg&oe=6A9854F8"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8WpRZ-3JXkQ7kNvwEKe_5o&_nc_oc=AdpLG1z7r74NfRFkEtKc93Ja7Vz2iKfnfvHsjhAxduUo6KWlodwInZ8m_87QhOEcO6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrWtA0mmjfcXGD9zI76HVopK1DBqQdPFfseLW9Z535zg&oe=6A986740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CswACRZoytIQ7kNvwHifSpL&_nc_oc=AdrG1aNXNUY9IRypu8w18TSRoUO-b8upbvwa6qJVTPa5NrS_wkQQsSQX5yuHZ3e4FNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb7SBRghMNiL3pTRUQ6gdcnucL4HWeiYUQF94rYHKZ3A&oe=6A985E1D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
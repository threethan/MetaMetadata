t-ord5-3.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAA6_w7GBW0Q7kNvwEEFNKc&_nc_oc=AdmKLm1pXlUUjMoggenRjOnZU-_iDT_ShlGiNESmAt6-ruTlqlnIjXp49jFPneqrMjw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftc3GuTa3UkP3wwHJo7LN2NqQA0nUP3YAIrOkLv1kzo1A&oe=69A44980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn9EsNTyRkEQ7kNvwFFOzyz&_nc_oc=AdnUFsvRL62hze0W7LHlrmuGUfON3QQIVuiJbfLRmGukVOJ_6XkHDpn1v3f2RHgKAUE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyBpvxfcE1-aCG-vlqsEwQwNtpEIpB8eEWw1J2Z6Z-HA&oe=69A4405D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url"
trmfrEiryJC5C5yyWFkX1M0_JsfWPt8Q&oe=6A942838"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpj8GjA4vDgQ7kNvwEOnoYI&_nc_oc=AdrJo6a8wJBua63KIT5XmebEOAQL_78ZuncVbvQcJVwxxsFuL3Uca-O7c86hhjpft3U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV4LrThw2_rLOrtIwMmVVswQJGfLGFuNmvjQpH1Y1_BA&oe=6A940240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTovn36Jc54Q7kNvwHTyx6P&_nc_oc=AdpfjPnudJG-LQLlSEDFrBON9mLvh0NSL2S0T9HBpl7rNpppnyrpAoQxTWOX6EkfcMI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbFy_cBVi52hq2WL8MTZWcS4eSBbE3_gCrzKRrCaCIVA&oe=6A94315D"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
12eRMXXas-m8ZH2CWzSxtJTk52jRxJgA&oe=6A33EAB8"}, {"file_name": "Catheter Care Simulator_Screenshot_05.png", "id": "1218610852630773", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974442_1218610859297439_7276268863997603101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUkR8Qd5CI4Q7kNvwEFvh86&_nc_oc=Adps2Eof9JHZpsLQfdHRwZTxspSE3Slye5hPHWoSLsK1V8iMJb1u_uW00iMH73T9h-Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HdGU31fZfW9EDTbXecuTza1MWco6428_Roi3fFPOCDA&oe=6A33FD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "852688946319416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974759_852688949652749_8601314881693222300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EkcLSQTr0MQ7kNvwH2zjsB&_nc_oc=Adr6zmvTfxM9R7yIvd6LhxQWuZLniqgWes_ck7iCxNmudSQ58t_jbCcURb_EkiYSXGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JjBZ-joCO-MUdeZ8i_EhasRgycIFUEes5vwGrbFIfpQ&oe=6A33F3DD"}, "display_name": "Catheter Care Simulator", "keywords": [], "long_description": "The Catheter Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper catheter care. This application guides users through the steps of maintaining hygiene, preventing infections, and handling catheter equipment correctly. \n\n#  Learning Objectives:  \n- Remembering the protocols for catheter care \n- Understanding the importance of preventing infections and ensuring patient comfort \n- Applying the correct techniques for cleaning and handling catheters \n- Evaluating the effectiveness of the care provided  \n\nThis thorough approach ensures CNAs are well-prepared to perform catheter care competently and confidently in clinical settings.", "short_description": "Designed to train CNAs in providing proper catheter care through interactive, hands-on practice. "}]}, "developer_name": nu
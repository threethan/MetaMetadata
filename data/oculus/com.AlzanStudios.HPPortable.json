863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zI4EHUZjoEQ7kNvwF0Y5np&_nc_oc=AdqpyfgiSE69M7-gxQB6qPFsYUiDJzAoVjQX2PEDMRBhZNFslyPIT09y7lstdbCbhzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOZu9g_Hm_VcRUUbAxmILyDqEBPuKGSs-YZQXLUnfInA&oe=6AE5F706"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJL4tvp1sQcQ7kNvwEIm9BP&_nc_oc=AdqjaycTA-78bcFJit3s14n1eSAB6o3hQ8NtnmbTYdM57uPUytak21XLXr6hzlUxvho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFLvw2OhGAUXS9XF3qftGXJ4TIY6JVPakOvMqE5RGQgg&oe=6AE5E152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ahMaO3auXQQ7kNvwGVrg7o&_nc_oc=AdrKUwVhLewp6YwjdwqkuM92aUmWtqzp0CnZCPWBv3vXT06nctzizv1xZO7_-txZFJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWjiglakZblBIKT6szZv5b02lQvdMF9mR5OoeEj8TWrg&oe=6AE5FF66"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSNGdUKkUvwQ7kNvwFpQcpt&_nc_oc=AdoUAwEdxwRWlKWIpA-GNz9MX1lq1RD0usgHZzZXNLQXsYiq8u7ripEBOSUNn9UTJsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-BP2hI8wHivKC5PwV5OKWSk60Vjt1wzTCmd51GOZQDw&oe=6AEB3D06"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5ypF3IE2mIQ7kNvwEs76st&_nc_oc=Adrl4ThwrFO32b50SNIIUnroAnPo1g-YZ0-9w5yg-2EMSkI7HkI6vKUL46hEYirabpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqXMHO_HsaCShZ0W2YFKaURbquhewABcE36LZBxtDLEA&oe=6AEB5F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIMVzXBfGbwQ7kNvwHxD9sd&_nc_oc=AdpnH35LdUx4J2bT28NcB6dlDTOMUOYlZfCXe7cpSDGfkjrMFWCyCsH6plrqm6D6MMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLP6xKter0WjRwQZpiK4cm4J6grU7sFlTvWTJ-U4xzpw&oe=6AEB4566"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
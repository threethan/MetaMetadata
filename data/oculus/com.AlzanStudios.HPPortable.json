863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjpp-HWx85oQ7kNvwG7xAey&_nc_oc=AdpCJOvnk9rD5BFRTS45HXbygEVt4hbuVxI9N1534zzJDOk6Vm_SZn8E0yXczPP7iOE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3FVc1pQb4SKmnLDeZGMIfcWrteWDzyKd3KoPP6dNQ_g&oe=6AF32606"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z_Pm-PNWPIQ7kNvwEGGPh-&_nc_oc=AdqK4bY1q9WU3g5ZnLHa8NQD8giCS673AGBLWpmcXiW7DE9hARKY67WvqnTn8m26Qiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgPuQ3dQwWgNKrEknnStq6Buq97snRf6KU2iDeYTOAWw&oe=6AF34892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKLhfi0j0aUQ7kNvwH-IoUf&_nc_oc=AdoyttlWT2Kxy-qpe0ktn0S4QmqpcZ4paLR7URgPGrAgeR3tVuIDnCUoK5Jpz0bfUxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe89atNRsajFXenZNrjQgfIudJRLri5V3qvK14t4TAmQ&oe=6AF32E66"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
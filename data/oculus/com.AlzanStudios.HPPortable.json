dn.com/v/t64.5771-25/75203624_741935076366159_1346622421496653553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfG6h29XVlEQ7kNvwHESiwK&_nc_oc=AdokIVOKNCtW0CQVisHs9F6tvc-oPncartawgrMW9UnGvlTApQWITl1mFsKFF2WjcZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzfhMBGQsW1dS8gpdhQn1sRtnN3b2U9nkcZWhfpscTQ&oe=6AF5F6E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "633850310589484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031457_633850313922817_752894717263523968_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F26Nr40na-wQ7kNvwGwATJq&_nc_oc=AdoPAl9CUmrOJwe5_f4YeMOP2RHTfPWEQJdTe6r22fGItS5QOwsZ0XS83ZQ5roNIqAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqsJMO0oTKY_Lna_Afqpjp-uLka3cn9mIg1Rn8fmvn6w&oe=6AF5E05E"}, "display_name": "Holopoint: Oculus Edition", "keywords": ["Archery", "Hologram", "Wave", "Arrow", "Quiver"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATHE AND TAKE BREAKS.", "short_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alzanstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alzan Studios, LLC",
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2V6tQNqoLcQ7kNvwEikfdH&_nc_oc=AdpwJvKKXP-ZvO6ihFI0dQs7ENiIDbg3myyNolIXQOLdFa2LT-K8LwISQatBaH4FMN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS40jY5xXyYPfBUXCZ-fgrq7kPhiV2UK_3jeAIZTZvDsw&oe=6AF8A446"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA_p3pzMgKsQ7kNvwFOqwHK&_nc_oc=Adqe9cNqOLWXpbyI2W0JP8o9WDq9N5ZTuy6wHwcYueRoez1zshJiOxr-rr9DCzTFKbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMbq_bBH1ZwH4qRt_BiPeQRKPo7HJrWHZ3sRqjlNYJ0g&oe=6AF88E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji38PeIMqlwQ7kNvwGSHLsI&_nc_oc=Adr1wF2kOA-NQ26sAyH_M15Nt6VROPbD7tiFn-Qoo-rO1bu_PMuTNCDftdgB_y5h7sk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTreMLLr0dBQq9A2-_oNvrpdYJk6JDjvt5uHSc5S_RMkQ&oe=6AF8ACA6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2V6tQNqoLcQ7kNvwH5i3_B&_nc_oc=AdoRvHfOFmhnubtTRZ-78Yw6Bx2qQjNfGXxT5Gtfcq-Ks5xACJ2nQW1ADiQEKr2Q980&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCe3htX-eXDwOuwGs1M-KiIdgQbGhxBwW3SRJAXC2gHw&oe=6AF9BD86"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA_p3pzMgKsQ7kNvwGCTaK5&_nc_oc=AdpDOfQ2wIFOE551UnLaAhxzQ4K5x9vLdRDFE4BhftzbCefz0uSJleJshmsCKvoPIZ0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSYp3YqIyaaq6FCdSdx-LYyV9Rgx0ybpVNhmjmLliHXA&oe=6AF9E012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWRx4yk3JFEQ7kNvwHNO1LD&_nc_oc=Adq1kMbT47ZVpczA_fMNoMVBzGKtfrUI0OzcHtODn2tNuKgAclNX0IBbeLIT2zDipeg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVTOJWjByt5HmIqYHjSztpck0bM5xAYeKLuLzkMyoe7A&oe=6AF9C5E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
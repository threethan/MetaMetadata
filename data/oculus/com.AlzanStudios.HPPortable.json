863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVndxwXI-lIQ7kNvwFsKwTH&_nc_oc=AdpoGe_0twzNBXoMwcoxxJ2jETWaz0RhoZ4zJKD3rXQINIx7BVBMTdcLRg3-AN2uqQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ5Ao5tJpFYZ6CkVNXiFHklN_hSiheud-qPlmRfaLPfQ&oe=6AEF3186"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI9OHa3ebysQ7kNvwHQ9UsP&_nc_oc=Adosz45Slr7zUAVnR8Z3HHL78OIlpCBvuJLEoc55SfLlQ_Jh92XXT1yqUy80c5PZOBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgDO21YSMWXJJkJ-5uJaLLBgcsKRz9FVJi-3ibn-GhvQ&oe=6AEF5412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHwtGSPmK3EQ7kNvwHqk28O&_nc_oc=AdpDxOUcWup_huFjmJ0wbhCy8N6b0RIP-rvIntLyNovqu8Itv2yeQp0X6ipVwLBFDrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2lWm09nl5NkpheKmHCgx962UBh_kPHGn01UyAbmmw9Q&oe=6AEF39E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
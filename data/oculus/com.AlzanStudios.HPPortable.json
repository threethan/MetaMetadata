863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVndxwXI-lIQ7kNvwEq-P3I&_nc_oc=AdrgB5hESWGLeNahZ0hQNsjTQeN7WL9-ggUad2Scu00vs-J1WswBRL0_Oy_ZcfeVMJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcj8m6jSqkBN200fVFvUOoUEYUIrigOW6fkcjD3fVevA&oe=6AEDE006"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5ypF3IE2mIQ7kNvwEjzao4&_nc_oc=AdpRG8CcZXMnFraXP2ojRtBuNk6OIMuP9eTcOjPfSiOHMaeWkBF-HGypa7-4LWg09ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMgF-uSkqAdbn3r_ipE5xzqPPMiVXBmbQniwlLL75veA&oe=6AEE0292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHwtGSPmK3EQ7kNvwGO-WwK&_nc_oc=Ado4vSohk6KLFUntIOsDWM_wFC324bdHFb7Jx8exv9nPCFhZKwlWt3HWo2K3zrA7G3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfHT-WsNnz8o3V61xtgl5U0P_7EalQ842hOTQe7pCDUw&oe=6AEDE866"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
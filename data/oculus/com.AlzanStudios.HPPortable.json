863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zI4EHUZjoEQ7kNvwF3nYir&_nc_oc=AdqLjF3Qu8bBuUZRsIOzCTB_BQeZw4B4qAS_aLLBCyY9CBM41j4u0hrLXVm6oZfefIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7qylLyj-VmY-B60l8ol9_O3ZWQ4Wqdk8vBzLaFnxmEw&oe=6AE74886"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMds5Pv04fMQ7kNvwHqU9WM&_nc_oc=AdoMdl4cpJxzZw-lDU1yF49SbCA6ofFLS4upgn9kwvtacRRMUfx1RWQtO2RLB0LmR8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2myRBvrCJsQwOnh12J3Z3GUsS1aHF3HpWILKgjyR4BQ&oe=6AE76B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ahMaO3auXQQ7kNvwEnifgm&_nc_oc=Adr3JRBaRLF15xELPxQgOSbwiAl4e2bcbDyhdnBtIB5pg2-ddP8jUThTFi9YvrTLlcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTosYuqJTlU66JSVd66Iu6t8cLZYD1xNrBWb2WxH_xycw&oe=6AE750E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVndxwXI-lIQ7kNvwG25nXN&_nc_oc=AdpmFyHym7kIWBbtFPNMpxSzuDxQoSczHF6Zzwz5j5DxvbLXRU2CsCHtC-NtQwBGXZI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxFioZEDg7ZupyQXeejAfyTN8Bvoi_3mSYKrRJ8C60Og&oe=6AEC8E86"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5ypF3IE2mIQ7kNvwH27ut2&_nc_oc=Adp4dhnlOsbUFrW4Bk7fywSJ42TtwxZ2AkVkTn8LciHk2RX-bPUe-eTB5o97253zhB0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-OwVeZTnq2bKHoWPlgB2PbDAw2eRYLiktd4wggba3w&oe=6AECB112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIMVzXBfGbwQ7kNvwFxRINM&_nc_oc=AdoW40gucpZkNOS8JaIw7jU2imomuYJDDMEuLZ6ICYZdD9I51ZxGy6sOa09S7C-S0j0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXpM1-R_ACTII4JCXLKbhxgIXjs761mH5Jn62XX6itdw&oe=6AEC96E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
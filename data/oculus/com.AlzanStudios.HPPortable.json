863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjpp-HWx85oQ7kNvwGlzVUy&_nc_oc=AdrrIQi_rpZ6rdC28ejSAVZ8g-GftNFLxMqa38uGJG-Oa6ZobjWmL8M0XvZWBvX_CMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM_rFPA2lb7GwPQAoxjPrrziDpAG1pEit4vfvUKAovNA&oe=6AF1D486"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI9OHa3ebysQ7kNvwGS50if&_nc_oc=Adp7rSFQUo0q-opPFb1o-FMYvPQeuoDGJ6geUX8GaV2LP-GbPB_5ZSLH5q9zRVFET4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGkiUK9QesW39dy8ik1ZAnIXwnZKnOYci4rldt2S2ZIw&oe=6AF1F712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKLhfi0j0aUQ7kNvwEodnaR&_nc_oc=AdoYKx_z1igrFER7ilItGh0AqxuqN5jo0CEiRPQ2UlcxYbdS30rlg3XERZOxkswH5YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXQGiwTP2dbNFJGWcmVforBTKqnWx9OiAVxwePGarhUg&oe=6AF1DCE6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
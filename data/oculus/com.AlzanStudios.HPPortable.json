863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLRMwVI2rZ0Q7kNvwFVaywo&_nc_oc=AdrLgApFtpa0EbD1dqAbbp0AW6juJAV5-jd7-Sxe70VSVwi-vjbcIgxcvImqbyzmoX8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEwdVX2hVn3-4ockxc5jIJUIsoFqDxBAWDn7VOwb-3NQ&oe=6AE35406"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJL4tvp1sQcQ7kNvwEc22nQ&_nc_oc=Adq-3GYxVPulGiyeS_D_kMLtPAdHO9wnBkpKpLuM_UNrPglL-k0AOoFVuDnTYQaDyZA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe1JgL5oh3icNxXuZPHkb8mgl_laicpZp7PS6xxMjqXw&oe=6AE33E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFEaIeUYDSYQ7kNvwGBN0Fw&_nc_oc=AdpVwbjO3ng-3-1GDV6UEN4hrVA-cf-oMGev0C_YLAtbza4eUiqXW-6xogLVCRr24mM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM10NKvUUwyPyjnbwU4l-xmyweOgmrAkbK5pkPleScfug&oe=6AE35C66"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
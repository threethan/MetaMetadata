863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjpp-HWx85oQ7kNvwHRwbPd&_nc_oc=AdrdPs--5DgWLlLmNpPHA0JYUmvuJ96ZRBs0rCLgzWAT6_pz_9VOtZnp5xewCBDosc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT_5crmuXhfHQ-8xf8X5pwDMPFqs9gvFK36kSof4iG1Q&oe=6AF08306"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI9OHa3ebysQ7kNvwGlG0lN&_nc_oc=AdqpVony9xaRNnjVKRNYSdmCkKiB64mMijZXezuFCltRegksknUFgt_GI4IR2mUzhtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtvnnDQm7uKWezF7rFkTrH34GdDHOF0GrwuIjFx5cQow&oe=6AF0A592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHwtGSPmK3EQ7kNvwHsRp6i&_nc_oc=AdqU1pY_gNjbe-iloM09R7ZDfWWcKFrTEVuvfeG9aUn7ImuW2y4O4WKTP0ZMPpI6jXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkfzE3E6PNBE6pt6iB1WJdxEwMwgsmpNEGkqUK0OYl1Q&oe=6AF08B66"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
29472", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2202354219893697", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28424822997220128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793160538, "id": "28477651721937255", "version": "R10", "version_code": 147, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2202354219893697", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28424822997220128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2474496075929472"}]}, "change_log": "  - New location, the Courtyard: a moonlit night setting with a sakura tree and swinging lanterns. It has 30 new waves in both Waves and Time Trial modes.\n  - New bow to earn: finish the Courtyard to unlock Daburu, the Double Bow.\n  - Energized arrows are now earned by accuracy and pace. Keep up a pace of 30 enemies in 40 seconds with perfect accuracy to ignite your arrows and increase their contact area. Defeating more than one enemy with a single arrow can push accuracy over 100%.\n  - Arrows react to what they hit: they stick in wood and dirt and bounce off stone, and each surface sounds different.\n  - Seasonal secrets:\n    - In autumn, a secret in the Courtyard pumpkin patch temporarily rewards Minori, the Harvest Bow.\n    - In winter, snow falls on the Garden and the Courtyard. Find Yukidama, the Winter Bow hiding among the Yukidaruma (snowmen)\n  - Bow lock: during a match your bow stays in your hand when you let go of the grip.\n  - Update UX for Time Trial and How to Play screens.\n  - New layered music that changes and builds through the Courtyard waves.\n  - Smoother performance and new visuals: better foliage, lighting and frame rate.\n  - New unlock order: the Courtyard opens at Dojo wave 5 and the Garden at Courtyard wave 10. If you already have the Garden pre-update, it will remain unlocked for you.\n  - Stay in the play area: going more than 10 ft up or 20 ft from the centre now ends your run.\n  - Play area guardian auto-centering: The guardian boundary now auto-centers and aligns with the world direction for an optimal experience.\n  - Additional bug fixes and improvements", "created_date": 1792814298, "id": "28424822997220128", "version": "R10", "version_code": 146, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2202354219893697", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28424822997220128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792792364, "id": "28421643844204710", "version": "R10", "version_code": 145, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2202354219893697", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28424822997220128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792787699, "id": "28420968330938928", "version": "R10", "version_code": 144, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2202354219893697", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28424822997220128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792775416, "id": "28418863074482787", "version": "R10", "version_code": 143, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
dn.com/v/t64.5771-25/75203624_741935076366159_1346622421496653553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HKCI5gox5IQ7kNvwHJF1NW&_nc_oc=AdqnC8gvOr-zt3oKGavypp2ACaes3Xq1YITpT3kcKB-ffIvtCZXWdBkzLsmMSzfEPyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSH34uFO6Oq0vEATlYlmJZubJOFjUUar2f_u_BwDT6yw&oe=6AE49B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "633850310589484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031457_633850313922817_752894717263523968_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf5AU6UxFVoQ7kNvwGFnsct&_nc_oc=AdpOdCn9KQQpM0qHl1dJP520Sej-tWZ-664jkMV6GM89i3-MYlsbUcap9EB0V-0UfA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRwVfJnRLQ_1jSNq79UXMNVV1opXN2Y84AxAJCLD4mNA&oe=6AE4BCDE"}, "display_name": "Holopoint: Oculus Edition", "keywords": ["Archery", "Hologram", "Wave", "Arrow", "Quiver"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATHE AND TAKE BREAKS.", "short_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alzanstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alzan Studios, LLC",
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y288qPi_zZAQ7kNvwFnBOXJ&_nc_oc=AdqRy2thaH7G0HK1DAw709bNLZcg_VHYfn0x6uwK_qRUJ205P80NjfLCrvcuf-HOYQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhFnsNhLm8ihxST_xaIUOAGPsvKjPhb-mwnNssf7o4_w&oe=6AF5C906"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z_Pm-PNWPIQ7kNvwE5r4UK&_nc_oc=AdobUBeu5HgCWDz3bGnAevdwW96q_YqmyL9FHzQzaGl8sCxm4ci1wLySLOQbAxRjJ7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpRhPetqHPhMGwZGJcbkytbRloD3uKHhJEWRp6n32fJw&oe=6AF5EB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji38PeIMqlwQ7kNvwEpgqns&_nc_oc=Adooa4QWIVBHDuXp1b7WhGyh5bx0TeFx_kh5MW7p1E79vJN1_woUSrmN-8Bt3dUCcjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxJo8MavjyRF9dMfoxmXBOQc2KKZEsuS7uR_RX6LFcUQ&oe=6AF5D166"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
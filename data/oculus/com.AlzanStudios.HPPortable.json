863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSNGdUKkUvwQ7kNvwGMjMkC&_nc_oc=Adqxl0phMaVIxehMM3t571w_Ie61F3S0SieY7Ae1UuBCShilbUsLxJ4Q6EVveOYbNgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf4-Gw57shOj3ZLc-6OsRXH7f4wo3K8FeLKYvefTAxRg&oe=6AE9EB86"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMds5Pv04fMQ7kNvwElMQ4K&_nc_oc=AdoYIO9XUlQhFJckoNpK_G2sH0-wn-gGOfXoA8dQXZB0_1IJpQA44aCVIgKWhsiBo_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn3xNOn76C85ZzLt6YWknnfnkM00BHxV4feucSVSZPbw&oe=6AEA0E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIMVzXBfGbwQ7kNvwGq-01w&_nc_oc=AdqYthG4uRA9qJlJ7wk4_cE9dcaG6N2WIC1u21sGi79DurVzxOaxpQqcQZpDVCjs3o8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9XDIkR743VmTZfWDbSOzhcs42M_wu-XA-iI137Kd0_A&oe=6AE9F3E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
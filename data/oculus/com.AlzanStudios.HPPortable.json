863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y288qPi_zZAQ7kNvwF5LoYS&_nc_oc=Adptd_XeIqLwAlHFgXRYJs5kAVncC6txyJ20zwhD_YnqacZbwXhyrx75tbiwpuD8LBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvKU-ag1XkmklWcmz4b72Z7jok6P7uK9l3apWxU9Si-g&oe=6AF47786"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z_Pm-PNWPIQ7kNvwE6w5A0&_nc_oc=AdofL0ovjvV13hA0tznDo0dVbumi7XpsUwNwIhi0jsN9O9cZuLpzYIzeavbUjUSXEmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_SFJdbjdeNEzgiULK2n0GSEp94ddXaWnShI6ZIsp3Qg&oe=6AF49A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKLhfi0j0aUQ7kNvwGpnFmv&_nc_oc=AdqQZem6y8dGWd1u3DC9SCNfL9c4WPm7FT2pw9LprioBeOlful1YxI_GgVPAYpZwyUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdUYLgjCjVNp9f4f7l8Tn4bmrwoG-4TSOWEU5PVgi9Yw&oe=6AF47FE6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
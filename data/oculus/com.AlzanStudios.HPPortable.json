863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y288qPi_zZAQ7kNvwFOl9Tu&_nc_oc=AdpfOJDYHgNZiHhfi-bp17KJ4P3uUUlgOvh3LPgXC3X66pcBa6KPeBiETZ3Y2lxvLJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJT4ijUOyKmXiI3HYBXzkoqKBvdaJEvE6RKXXd6hQlwA&oe=6AF71A86"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA_p3pzMgKsQ7kNvwFrEtGn&_nc_oc=Adqhb-fPdGAnxW0qDHrbs3qm53b6nhiyMOMwSZMLhKUPcG2X4FOA6vs1rf2Slfag5Co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmpIXSnK9WLG0SFjnIAris8GWc2oeQQsv2DjkbV3CKXQ&oe=6AF73D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji38PeIMqlwQ7kNvwGPxSBq&_nc_oc=Ado87VluMKT31J3MYySG2IxMMX1BNTN155zMl4OG-YoME6V87pFL1Vi9M_Oc2HGyyVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVbtwvCXlFkxNWgwebW2-JYvzU8eHnFNBLId7Qg8G-iA&oe=6AF722E6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
863777_3417887216312392951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zI4EHUZjoEQ7kNvwEsyf_F&_nc_oc=AdoM0bdlCd48whRHDgxcEiC3TbwBktIoNKFNl1PMEJUHSP_2A4prnBl2gb10CqFcOaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQK1uwkk0WpE-XBEay7iJN12FOuvXddEsSIKHtK8lOHQ&oe=6AE4A586"}, {"file_name": "Holopoint Quest 131 A.png", "id": "1773273320571879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673625994_1773273323905212_5291317074947976367_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJL4tvp1sQcQ7kNvwETirFC&_nc_oc=AdrxhvMQaq0mpQjNVrdgmE_eiHKXlgNtM5xgBn4ddXevh9fW1nJ5MPsbLuk9tZzFa4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlhWGt7iulivExe7ufv10sj-cftU_pbKitgS1iPw6Ovw&oe=6AE48FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1735390780856030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1735390784189363_421930983540835202_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFEaIeUYDSYQ7kNvwEl7zLP&_nc_oc=AdpE4CJP7_OhClv9jL8IXQxjfSKwq-s4UNNpxSUK3ku3VGeNQK00I7l77HY6eu-RO10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVyKDjNTU_mMI-dRX9L77MtZdmn7eJBGesVJvp1o5qkQ&oe=6AE4ADE6"}, "display_name": "Holopoint", "keywords": ["Archery", "Wave", "Arrow", "Fitness", "Arcade"], "long_description": "Holopoint is pure archery madness. Fight your way through waves of responsive targets, samurai, and highly dangerous ninjas - all while drawing, nocking, and shooting your arrows as quickly as possible. \n\nHolopoint is a skill based game where progression is based on player skill and training rather than unlocks. Like many arcade style games, personal progress and a high score is the goal. This game quickly becomes difficult and requires an active mindset. Holopoint is designed so that only a few determined archers will reach the last wave.\n\nWARNING: THIS GAME GETS INTENSE. REMEMBER TO BREATH AND TAKE BREAKS.", "short_description"
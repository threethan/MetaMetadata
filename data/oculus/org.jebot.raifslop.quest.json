PKn4jd8NevyWy7Lb8ZbeKsMgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE8DqHOEaiD9orgcEntvOp5FyjKww0Io2Ldub4e3uIew&oe=6AFDADFC"}, {"file_name": "screenshot-04-glacier_run.png", "id": "1410180367430125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1410180370763458_3188392769574318298_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiakrfcGW7MQ7kNvwGKKcUu&_nc_oc=AdoK_1cT5cAYE_XzLWTWDBvOSpuOBFpWEaBSS7hvKLotJ6aAIh19a4NaAFKvv8EdbKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTsw2vhmH-Xmp9wDWqrITh4D5G_psreL5qCQqX90GdRg&oe=6AFDD2B4"}, {"file_name": "screenshot-01-lake_pier.png", "id": "1161832133040343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828583_1161832136373676_3153556268275155456_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twnEu6TzVt8Q7kNvwHsuSz9&_nc_oc=AdqrQJpbqeMsRjIjIEgVLLZa1ybVoYUn10k89IchV6NJVE5oroz2Iowx6Xb0-7ZiUVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0iGirLMytTfX0XNN3tT0WAFs1_NSprnb1lBH2Q-uPLA&oe=6AFDD5D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "course_blouberg_sunrise_2.png", "id": "1689409465971827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1689409469305160_4596464142299327281_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVc0UDByivwQ7kNvwH90B_O&_nc_oc=Ado1yifiuxcVt8BNVWm2UiFmTSIw-YJ0b6uVTLEKa5YBRma2WbZEucwcVSQ_W_qHiLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp-V08HyWyhDZxFIDiq5CmnTzaPqhTeAahXzHpQt5A2w&oe=6AFDB0F1"}, "display_name": "Ultimate Boomer Simulator", "keywords": ["fishing", "bbq"], "long_description": "Cast a line and fire up the grill. Ultimate Boomer Simulator brings fishing and waterside BBQs together in VR.\n\nFIND YOUR WATER\nExplore twelve lake, river and coastal locations with photographic scenery, natural shorelines and atmospheric lighting. Choose float, feeder, lure or fly fishing, cast with tracked controllers and work the reel as fish run and your line comes under tension. Record your catches and spend earned in-game rewards on new tackle.\n\nTAKE A BBQ BREAK\nVisit the shared waterside grill, turn the food with tongs and serve a meal. Toss food and cans to friends; dropped items return after a short wait.\n\nSHARE THE SHORE\nPlay solo or meet up in sessions for up to eight players with positional voice. Bring a custom VRM avatar, take photographs and compare fishing achievements and leaderboards. Friends can keep fishing while you cook at the same water.\n\nFree to play, with no real-money purchases. Supports online lobbies and direct connections to a host or dedicated server. Clients and servers must use compatible versions.", "short_description": "Fish, grill and unwind in VR. Explore twelve lake, river and coastal waters, master fly, float, feeder and lure fishing, and share your favourite spot with up to eight players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jebot-git.github.io/raifslop/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PLdot", "support_website_url": null, "website_url": "https://github.com/jebot-git/raifslop", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_U
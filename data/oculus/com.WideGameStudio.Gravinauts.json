4Y5M6k_dALA&oe=6AB7CFD9"}, {"file_name": "5.png", "id": "2228460124278217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300589_2228460130944883_3720705366748009608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy2PaUPydJAQ7kNvwEMWAdJ&_nc_oc=Adr0lYUeEoIqYHNYnP5Sg4OfU1yGt0GLgFSGwARSKwIHarNSA5dtBr0dVBoyrRiRxJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPCoYCk55_TxY_8F9TjDRCXc1SPVyeirtgtulfBfKeYg&oe=6AB7CEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "24038796889077505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301429_24038796892410838_3506390355920277896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulqFrNIhTzoQ7kNvwG8SGBO&_nc_oc=Adp4a4Xmy2ovxnwM4OgmJX07wCvYsC3hBjzzXuVo9eOAzeG_IqKOie-cyieW6W87dGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3vYl_hlkgOEpPcCI79gzv8ICGqdtbHLm66HPgl6UEA&oe=6AB7CE88"}, "display_name": "Gravi", "keywords": ["social", "action", "multiplayer", "adventure", "space"], "long_description": "Welcome to **Gravi** \u2014 where the chaos of zero-gravity combines with creative fun and lots of freedom to move! Go through different maps, swing and use your gadget skills to join in loads of community chaos.\n{1434708587560446}\n**Join our Discord server to earn exclusive rewards and be the first to hear all the latest news!**\n\n# \ud83c\udf00 Gravity? Optional. \n\nRun sideways, fly through low-gravity zones, attach to spheres, or explore space using gadgets like the Grappling Hook, Iron Hand, Soda, and more. You are free to move and decide the way you want to play the game.\n\n# \ud83c\udfae Gravi-style Multiplayer Chaos\n\nHop into crazy game lobbies with friends or make new friends, have fun playing around with gadgets or compete against each other in challenges like speedruns and gadget battles. \n\n{1422618652420153}\n\n# \u26cf\ufe0fMining\u2026 Could it be your secret weapon?\n\nMining in space\u2026 Is that how you become rich in Gravi? Hunt down those shiny green crystals on the planets, mine them, and find out if that's the way to conquer space ;)\n\n{714902404415410}\n\n # \ud83d\udecd\ufe0f Leaderboards and Special Badges \n\nComplete daily missions, master speedrun tracks, and climb up high on the leaderboards. Unlock badges after securing your place in the first place and grab your badge! \n\n# \ud83c\udf89 It\u2019s Not Just a Game \u2014 It\u2019s a Community \n\nWhether you're playing with friends, or just chilling in The Nexus with your astro-squad, Gravi is built for you to explore, have fun, and connect.\n\n\n", "short_description": "Gravi is a gravity-defying multiplayer tag game where players chase, dodge, and outmaneuver each other using gadgets and wild gravitational zones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/gravi/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9304296159639153"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1035873035345713"}]}, "baseline_offer": {"id": "1035873035345713"}, "is_approved": true, "firstOffer": {"nodes": [
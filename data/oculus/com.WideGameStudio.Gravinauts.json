=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDcnTdxtIpwQ7kNvwFlkYgs&_nc_oc=AdqHnhXjvammD-VLnE4jDrJqKEhvMov-OXJm6frhcTGEDuj0368qRcHwpbPp4anNROs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhpwv_UzzN3bQKBf98cT2f1rTbXo_WB-DiGZ7ASJDWUg&oe=6AFB466C"}, {"file_name": "Untitled-2.png", "id": "2481120528911275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828899_2481120538911274_3929015243642525319_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krGEt4bQR6wQ7kNvwEC4RzI&_nc_oc=AdrnC_t0cKi5HtbPkhmTlqvp6KfnldZLVHB76gabmyN61COh3LK2oZsKtBIDKgJfb0o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJDbNGVnWfMtASsOVKoLqoGfxdEA2xRzcq1fLy8FU5bw&oe=6AFB4AFB"}, {"file_name": "Untitled-3.png", "id": "1299916788394440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823447_1299916791727773_278607732279324506_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mowDb4-WBp4Q7kNvwFkj_8O&_nc_oc=Adq99DWCB8_QPE3KheHJTGX956mojDbV4PI1iKgnTshe5OtLEO9wjXOOA7nNZXju-v4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDQ8X_p58lXens6nkpEBHyAnJXrZmqtQlEBmMvULlWKQ&oe=6AFB33DC"}, {"file_name": "Untitled-1.png", "id": "763206442924804", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825050_763206446258137_3263868633223908710_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSDR2vdFJ1EQ7kNvwHYOKg3&_nc_oc=AdofvspHapFvuT3PTsA-li4Bt7QrqAtdcAXeAu5e6K8UOdevTWVdYKRgw8H3PP-3HIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqMjzNwyfk1tXO_Ig6YZpwJ7oqUxc4VM78wwng88Agrg&oe=6AFB29C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gravi", "keywords": ["social", "action", "multiplayer", "adventure", "space"], "long_description": "**Join our Discord server to earn exclusive rewards and be the first to hear all the latest news!**\n\n# Discord.gg/gravi\n\n# Gravity broke, lost two letters, and Gravi was born.\n\nGravity died, and instead of mourning we threw a party. Now you can run on walls, slap your friends with gadgets, and mine glowing space junk like it\u2019s your retirement plan. System Infection? That is something even we cannot figure out \ud83e\udd14", "short_description": "Gravity broke, lost two letters, and Gravi was born.\n\nThen\u2026 Gravi started changing. Strange entities started appearing, things started to get lost and now it looks\u2026 different. \n\nIt is still the same Gravi that you used to hangout with your friends. Just with a few missing textures, an old Gravit lurking in the Asteroid City, and strange noises coming from the pipes in the Nexus. \n\nStill super fun though\u2026 Hoping that we share the same sense of fun \ud83e\udd2b"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/gravi/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28364248449883971"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819982_1172680711654284_3944159
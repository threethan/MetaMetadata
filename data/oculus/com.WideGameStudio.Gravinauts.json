OBh2aWkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKQQFCZ13Wmy6hTYbe_IH78zoQXGO5gzy_HmqXGxqB_A&oe=6AFF06DC"}, {"file_name": "4.png", "id": "1443014256892326", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499310667_1443014260225659_8209977145453885533_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv_tjuoIcVYQ7kNvwHmQqO7&_nc_oc=AdoYvVM9J14unCKa6zk_Bus7YqhOUGlu1E-V-vz48fcWe_wIAcoozkskGnJrznZAjAE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKHCwQgx12aAakKHheKSVMBSVMXdR8ByYfA2uE5Mrhtw&oe=6AFF00D9"}, {"file_name": "5.png", "id": "2228460124278217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300589_2228460130944883_3720705366748009608_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_mK-tp_nVYQ7kNvwG3-fkY&_nc_oc=AdrQLluDrWEQ48Hxw4cByEXptQfwd8F2g4L0JvtrDbc-1Jb9eGK4S20P_vQwFA0kzPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC0p1Wp83CoodVgZLoF9hXCO3gUJEYOkAFreP1ss3hpg&oe=6AFEFFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "24038796889077505", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499301429_24038796892410838_3506390355920277896_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCqLKd0XpTMQ7kNvwHPa_nh&_nc_oc=Adqp5NliSpwsqYPPFuPRNTnY7aUoFcT15s25H5ETsE-M4dMmFetXSZ8fSOTi7gavM40&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvl1gtyJhow8M48iqq8AXfYb6Y12X9hfC_IQ9XNssAMA&oe=6AFEFF88"}, "display_name": "Gravi", "keywords": ["social", "action", "multiplayer", "adventure", "space"], "long_description": "Welcome to **Gravi** \u2014 where the chaos of zero-gravity combines with creative fun and lots of freedom to move! Go through different maps, swing and use your gadget skills to join in loads of community chaos.\n{1434708587560446}\n**Join our Discord server to earn exclusive rewards and be the first to hear all the latest news!**\n\n# \ud83c\udf00 Gravity? Optional. \n\nRun sideways, fly through low-gravity zones, attach to spheres, or explore space using gadgets like the Grappling Hook, Iron Hand, Soda, and more. You are free to move and decide the way you want to play the game.\n\n# \ud83c\udfae Gravi-style Multiplayer Chaos\n\nHop into crazy game lobbies with friends or make new friends, have fun playing around with gadgets or compete against each other in challenges like speedruns and gadget battles. \n\n{1422618652420153}\n\n# \u26cf\ufe0fMining\u2026 Could it be your secret weapon?\n\nMining in space\u2026 Is that how you become rich in Gravi? Hunt down those shiny green crystals on the planets, mine them, and find out if that's the way to conquer space ;)\n\n{714902404415410}\n\n # \ud83d\udecd\ufe0f Leaderboards and Special Badges \n\nComplete daily missions, master speedrun tracks, and climb up high on the leaderboards. Unlock badges after securing your place in the first place and grab your badge! \n\n# \ud83c\udf89 It\u2019s Not Just a Game \u2014 It\u2019s a Community \n\nWhether you're playing with friends, or just chilling in The Nexus with your astro-squad, Gravi is built for you to explore, have fun, and connect.\n\n\n", "short_description": "Gravi is a gravity-defying multiplayer tag game where players chase, dodge, and outmaneuver each other using gadgets and wild gravitational zones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/gravi/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
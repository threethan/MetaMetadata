5/491831279_1635889214829960_7062622115518800293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChLyid0Wi_0Q7kNvwFMumfI&_nc_oc=AdpPFuxkrWGIBARFObv9R8VTOKyhzlP_I8Pyh9zXxJVnwApAtDFILa1NEydGl0iVC_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMPscQRyRiu8z8k84GpLIdKcHawxAryujAOPrrnb2bRg&oe=6AF73B66"}, {"file_name": "4.png", "id": "964859952602705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673745728_964859955936038_9068175334214539843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGNywkNY--8Q7kNvwGU17Tw&_nc_oc=AdrDcNQbce1hK9liXfaxHi1geaJ2J7u5YMV6_iWGK9B2XG1X4Oukrhl681T9Zp3oCRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmaBdr1TxlpHTQ28mTARSyXhUj80az-6tjarh9CPTsBg&oe=6AF7345C"}, {"file_name": "5.png", "id": "1087075573910647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/753032404_1087075577243980_8177815287739334873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFf1wTSeJ3AQ7kNvwHFCO5A&_nc_oc=AdpJsRyY8V-rA-fYThbC-pNXnLIo86ThxgT3ZhEmIFEJTY2p4bdQMVvIbOLlUI02sAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSGJjoIyECubuV6G_DJC7feP7xQVMIGAOwQTl36nptsQ&oe=6AF71E81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "First Kick VR Soccer", "keywords": ["Soccer", "Football", "Simulator", "Multiplayer", "Goalkeeper"], "long_description": "Step onto the pitch and experience the pressure of every shot in Firstkick VR Soccer, the most immersive VR soccer game built for Meta Quest and Meta Quest 3.\n\nChoose how you want to play:\n\nShootout Mode puts you behind the ball in this fast-paced VR soccer simulator. Pick your target, line up the shot, and try to beat the goalkeeper. Improve your aim, timing, and finishing as you chase cleaner, more accurate strikes.\n\nGoalkeeper Mode puts you between the posts. Read the shot, react quickly, and make the save. Test your reflexes and positioning as you defend the goal against incoming attempts in this realistic Meta Quest soccer experience.\n\nWhether you prefer scoring goals or stopping them, Firstkick VR Soccer delivers quick, easy-to-jump-into VR football action from both sides of the penalty area. Practice your shooting, sharpen your goalkeeping reactions, and enjoy the feeling of being on the pitch in virtual reality soccer.\n\nFeatures:\n\n\u25cf Realistic VR soccer gameplay built for Meta Quest\n\u25cf Free kick shootout-style shooting action\n\u25cf Goalkeeper mode with reaction-based saves\n\u25cf Skill-focused aiming, timing, accuracy, and reflexes\n\u25cf Play as both the shooter and the goalkeeper\n\u25cf Optimized VR football experience for Meta Quest 3\n\nTake your first kick, defend your goal, and see how you perform under pressure in the ultimate VR soccer game.", "short_description": "Step onto the pitch in Firstkick VR Soccer, the most immersive VR soccer game built for fast, skill-based action on Meta Quest. Take the shot in Shootout Mode, aim for the corners, and beat the keeper\u2014or switch sides in Goalkeeper Mode and make match-saving stops. Test your shooting, reflexes, timing, and accuracy in this realistic VR football simulator, designed exclusively for Meta Quest 3 and Meta Quest headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "http://momentixgames.blog/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Momentix Games", "support_website_url": null, "website_url": "https://momentixgames.blog/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
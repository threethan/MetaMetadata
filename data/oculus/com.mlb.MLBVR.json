8512146_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zan-ifhpBW0Q7kNvwF1lSfI&_nc_oc=AdrtwMEzWMqJQiLmZkgClhZvI4uEFuQ_tSU4iinXVqDtkra4Xz_HfYhrAGn9WFOfvOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJohdutNqKuPOIue806QrUNxxw162uBNVoJOXqoVUF1eQ&oe=6AA2ACE6"}, {"file_name": "objectleft_400x700_v2.png", "id": "1077178107433579", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_LEFT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_1077178110766912_4869919232145129616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ4sIyQEw9wQ7kNvwEonjZR&_nc_oc=Adrdu53sXJiqg4VoAzeRdn2rkzR2RP-CyFGGsX_WKfUUjN44-49N1Kt4zUo8G1pEU70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_DEEG_hEB3mwFp2sfT2oYhT_D-4xoqtluiy4b7QHjjQ&oe=6AA2B6B0"}, {"file_name": "backdrop.png", "id": "518080264158943", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_518080267492276_4140542256483047254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJhiVbBtc-0Q7kNvwGbso_q&_nc_oc=AdqO-RF4bvSxb8jiO2USdUeuVxlZrntDARlpVIxymeKKk3XW9vxrFpZtpkE3MZG61DI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbYWpoHp04LdLamDvLEXPvGKAFJldFx_mp6d5bPryuMg&oe=6AA29FD6"}, {"file_name": "objectright_400x700_v2.png", "id": "492551786953225", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003232_492551790286558_1459115795341554271_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roUD57LMxfEQ7kNvwH3xMWG&_nc_oc=AdpSgzOgE6r92-oQQDcJdVwWtUA8rokISjfQpWUWgKbMqvczX83mQIYm8whAT8LU_Ho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMpSy8VXozApXPRYgo0Xx5vJI8OjfVMJb3AHcpqHWlDA&oe=6AA2B37C"}]}, "id": "959032096675579", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MLB", "keywords": ["B\u00e9isbol", "Deportes", "MLB", "Broadcasting", "Streaming"], "long_description": "Ven a batear con la totalmente nueva MLB App en Meta Quest. La MLB App es el destino #1 para b\u00e9isbol en vivo, mejores momentos y mucho m\u00e1s.\n\nAc\u00e9rcate al juego con estadios de sumersi\u00f3n y visualizaci\u00f3n de informaci\u00f3n en 3D. Podr\u00e1s ver cada jugado cobrar vida con datos y posiciones de los jugadores en tiempo real.\n\n- **Partidos de MLB En Vivo:** Ver partidos en vivo o cuando prefieras con visualizaci\u00f3n de datos en 3D.\n- **Gameday 3D:** Sigue el partido desde cada \u00e1ngulo con modelos de jugadores en 3D y din\u00e1micas opciones de c\u00e1mara.\n- **Ambientes de Sumersi\u00f3n:** Lleva el estadio donde est\u00e9s con 30 parques de MLB detallados.\n- **Streaming de Partidos M\u00faltiples:** Sigue hasta cinco partidos de toda la liga a la vez.\n- **MLB en 3D:** Puedes ver los mejores momentos en Video Espacial.\n- **Integraci\u00f3n Profunda de Estad\u00edsticas:** \u00c1reas de m\u00e9tricas en vivo para anal\u00edtica y mejor comprensi\u00f3n del juego.\n- **MLB en Espacio Compartido:** Video y audio al instante te mantiene en el juego durante otras actividades.\n\n# M\u00e1s Para los Suscriptores\n- Acceso a la suscripci\u00f3n de la P\u00e1gina Oficial de MLB para ver cada juego fuera de mercado.\n- Transmisiones radiales del local o visitante y en espa\u00f1ol (donde est\u00e9 disponible) con MLB At Bat.\n- Datos de jugadores 3D y respaldo de audio universal para Suscriptores de MLB At Bat.\n\n*MLB App es una experiencia de sumersi\u00f3n, no un juego.\n\nPol\u00edtica de Privacidad: mlb.com/privacy\nT\u00e9rminos de Uso: mlb.com/tou\n\u00a9 2026 MLB Advanced Media, L.P.", "short_description": "\u00a1Prep\u00e1rate para vivir Major League Baseball como nunca lo has hecho, en vivo y cuando prefieras! La MLB App es el destino #1 para video y audio de b\u00e9isbol en vivo, mejores momentos y mucho m\u00e1s.\n\nConsigue un asiento en primera fila con visualizaci\u00f3n de datos en 3D en tiempo real y estadios inmersivos. \u00a1Sigue a tus jugadores, equipos y rivalidades favoritos como nunca antes con la app de la MLB para Meta Quest!"}, {"images": {"nodes": [{"file_name": "mlbApp_wordmark.png", "id": "34408212288824772", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_34408212298824771_6430825936202616920_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2upOne5FXVAQ7kNvwH-MgSK&_nc_oc=Ado_VcudJ_xS6Ig2lisWgy2TD-JAgjWGpr0h33SObXgSEbrab9v0QNc7lm_h3OWRfyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBAEflSE7TBnFW1fF_pk__my99L3o8ht8CKJGm163iKQ&oe=6AA2A5C9"}, {"file_name": "mlbApp_Meta_Hero.png", "id": "26237404442592368", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_26237404449259034_2249578599517708748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REy5IdFDl3sQ7kNvwF8NdMy&_nc_oc=AdqFU-mk6bTvmRtggcVUaWCz_lU5LBMttVdEk1Lo6p1ijpxnXSe5Si8jo4EP0X9ppBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEGokbjRPdMxPKB40I07RI7lndtyzgaymG2iEL5K6RAA&oe=6AA29F77"}, {"file_name": "objectright_400x700_v2.png", "id": "2127100584329578", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569472_2127100587662911_3775854410436073768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfv9uwCUCMMQ7kNvwFwe_sO&_nc_oc=Adrt8fWHT3dlIfSMS8H3DhTYiCKoY-W8lwGmJMh7u00ZBfJSBCr2eJ3sibRQAyh9t5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpKyhr-wzhLArJFXTeL9EE84as05lCwDyOcfRhh21Mqg&oe=6AA2AF11"}, {"file_name": "mlbApp_Meta_Landscape.png", "id": "2004378067097393", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_2004378070430726_5801368042752783447_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IyeG4pavbQQ7kNvwG1wA7A&_nc_oc=AdrkNIHooOx2DXJBkrX9ZnXahN4Vw3uh_RSyX8rjzGEzbYTtFK4cIuQDDEsmgDxnGrw&_nc_z
_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAp7e9dSj5EHKt2NGn4SrFUfJm0g31cAfnQeN5TFydyg&oe=6AA54782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-02-12 024655.png", "id": "1335146637521247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1335146640854580_2044014799724712856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tB6iGyPsXkQ7kNvwH6LKSE&_nc_oc=AdrWnG1akhZ5g57wNC5HZ-e_kY9zJlT7NeehEuox_7NkXWRFlu6Ga-cQU7SLzt7orTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH-_fKOkrVDQyyND7-VZJAy_Up_PueIAbId5OGgCcz7w&oe=6AA562AA"}, "display_name": "Market Tycoon", "keywords": ["ArcadeIdle", "Idle", "Tycoon", "Comfort", "Casual"], "long_description": "Welcome to Market Tycoon VR, the ultimate virtual reality shopping and management simulation! Experience the thrill of running your own retail store, stocking up on stylish clothes, and keeping your customers happy. Design and customize your shop, manage inventory, and grow your business into a thriving shopping paradise.\n\nInteract with customers, arrange clothing racks, and keep your shelves fully stocked to maximize profits. Every decision matters\u2014choose which products to sell, optimize store layout, and create special promotions to attract more buyers. As you progress, unlock new clothing brands, expand your shop space, and introduce new sales strategies.\n\nWith vibrant graphics, interactive gameplay, and immersive VR controls, Market Tycoon VR provides a fun and strategic retail experience for players of all ages. Whether you're a business enthusiast or just love shopping, this game will challenge your management skills and creativity.\n\nCan you rise to the top and create the best virtual shopping empire? Play Market Tycoon VR and start your journey today!", "short_description": "Step into the world of Market Tycoon VR, where you can build and manage your dream retail empire! Organize shelves, stock up on trendy clothes, and serve customers in a fun and immersive VR shopping experience. Expand your store, manage inventory, and create the ultimate shopping destination. With colorful visuals and interactive mechanics, Market Tycoon VR delivers an engaging and strategic business adventure. Are you ready to become the ultimate market mogul?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8439990276102039"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1505037864233450"}, {"status": "PUBLISHED", "id": "1678673936459936"}, {"status": "PUBLISHED", "id": "863713613317354"}, {"status": "PUBLISHED", "id": "1335598631476831"}, {"status": "PUBLISHED", "id": "1215647930032481"}, {"status": "PUBLISHED", "id": "1365729214475294"}, {"status": "PUBLISHED", "id": "1015949333786453"}, {"status": "PUBLISHED", "id": "1136015071014049"}]}, "baseline_offer": {"id": "1015949333786453"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "150503
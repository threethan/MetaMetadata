oe=6B0DB968"}, {"file_name": "Island0_Portal.png", "id": "6558929100848344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_6558929104181677_5418274915147333596_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut_5NjsUzEsQ7kNvwEJ_PpT&_nc_oc=AdqNHXhOxyTphglLZCk7JbIkTQtnSgo5SVM3lkUE9giaEZLVmGYxa2RNif3ionYWUZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfCc6WXsisvmo-ZOqRjsVZZk6jt5QyBFuI3HZKW-iExA&oe=6B0DA132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "393667872444075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_393667875777408_5553983612877516545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGlLNHmIV4Q7kNvwElcHMU&_nc_oc=AdpdFHG63dXpje7nIih3Xh5Iu7HUvHsSi4zEAiiOfegde4RyZgy4ERaY4JxT2V_Fp6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRK53KSscqC2YUT6rgdcynRYhWs1CAmahRrPP29XJbXqQ&oe=6B0DAB10"}, "display_name": "Vault of Stars", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nGet a discounted price if you buy during Early Access!", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight, created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": null, "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8341204609257373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974458_1605582556966729_5799072507928200002_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZycW7BKToYQ7kNvwGehY1z&_nc_oc=AdpuKr2hOSyu4xc8Oyz-pju9hHHF72MxJPRXqog6VTneK6cMgQedwE30D_4J1zAVSaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2PWHIFn_YHC9tp3uLQTmdULmE5kQCj2v_AkGp1OfKEA&oe=6B0DCAA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vault of Stars", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1624899654, "lastRevision": {"nodes": [{"id": "2915846092033665", "release_type": "SCHEDULED
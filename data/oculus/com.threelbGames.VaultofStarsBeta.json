me": "38974750_290505962473279_3371293286254020546_n.png", "id": "1096866620781575", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974781_1096866624114908_9197052989511705833_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTcR2m7DqJMQ7kNvwFuw4sA&_nc_oc=AdpBsZ8qGcKfJrRliVhdzGJpvAJ5DfQ0XIVSnVpx1eo9difoEhofFNhvrqToJEZK74k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKD0J7SIp3MaHIqv-WXcfcvoK31FmG3K-Fd3GSwPV-WA&oe=6B085A45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "1675943195926988", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974446_1675943199260321_5624544967155300383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMErLQ1WmTsQ7kNvwGSttpQ&_nc_oc=AdrF8p59PlGNG_YO2stx10SBxC9blqmtsYyqXbDCNNKW9Oxz3Aa8g8Nkqh101kUAD0c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzKfPrIuEk-2JAFE5ksZ2ck4cqbeE1u7pxOymjen2yBA&oe=6B084C74"}, "display_name": "Vault of Stars", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into night. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Star Child, can choose: Will you bring new life to the World Tree or let its light fade forever?", "short_description": "Vault of Stars is a puzzle-adventure that explores human nature and the power of choice. You are a being of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636554757577722"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "496824976413423"}, {"status": "PUBLISHED", "id": "173829441354426"}, {"status": "PUBLISHED", "id": "418481679926053"}]}, "baseline_offer": {"id": "418481679926053"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "496824976413423"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4917909271586941", "version": "12.14.21"}, "id": "270333874536683", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4069262429784967", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4917909271586941"}, "releas
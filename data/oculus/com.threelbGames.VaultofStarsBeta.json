9001688_291328335756046_7651323310451543747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJfmhJQ2i18Q7kNvwE4hkxM&_nc_oc=AdlqvC4D2AYSq9J_-lL_K3Vc6cemY4qJZk77oZFjbx6WEy619JzlAt_XiF5SNrQDH0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs-qwXJWBU_tlWmWRFObJ9W5TxS9TtturAHf7FPIHcRHw&oe=699D9919"}, {"file_name": "39036687_139209304778909_5121050349963733514_n.png", "id": "488247245674591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974684_488247249007924_7253440177962839717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLoSgih50YQQ7kNvwGdds2_&_nc_oc=Adl__LYfTVey85IW2aFYYBDWtt2AKQbtbc_T-VdV3XFxGedz6SnkhBE15vz8SBeCH4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsN6MpRbe6PVxW7pDbf6r8Vc6QCyMfX6grzfItui1RPdg&oe=699DAF21"}, {"file_name": "38974750_290505962473279_3371293286254020546_n.png", "id": "1096866620781575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974781_1096866624114908_9197052989511705833_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2czHBApCoAQ7kNvwGEYiVx&_nc_oc=AdkygnVG-srZPk_InQWzQAZ0q805esrUWk1N7i6u5kyVNLJkBzLmb7LWJyLApcIZH3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvwqp9AGUy9ajGUDCW74AH6EPu_jWhJP9dq_8cHZiI_9A&oe=699D9585"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "1675943195926988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974446_1675943199260321_5624544967155300383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D1uHm_0a68Q7kNvwHWNYXh&_nc_oc=Admh2lJHZ9C9QXmJgo8lt0roBZTbg6OJYYoiI4DTFnXp50mMwI2TDBN55QupsXdBM8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhKQ4_dTQWbX-1NYkM8A4ty4KcEhZcXOIsMvPD_HjJTQ&oe=699D87B4"}, "display_name": "Vault of Stars", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into night. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Star Child, can choose: Will you bring new life to the World Tree or let its light fade forever?", "short_description": "Vault of Stars is a puzzle-adventure that explores human nature and the power of choice. You are a being of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636554757577722"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "496824976413423"}, {"status": "PUBLISHED", "id": "173829441354426"}, {"status": "PUBLISHED", "id": "418481679926053"}]}, "baseline
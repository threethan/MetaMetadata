589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daJ8yTQgyocQ7kNvwEF5X--&_nc_oc=Adlk12H7tLQulG2HV3IrZTaZ20ca6NGck-u-ybBNWJmVDQh4bb6QmoBcCsxY4R9-Tv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvod3uRnkaMFFWlLStcYA8gToqmSp1WBgNcPTW1XqxZfQ&oe=69A5A041"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqPyR5P__hwQ7kNvwGujPlG&_nc_oc=Adk7HXuEUL6D8ZgoamwbvVHPPsCAgiyi-sO9qUuzupuIhpCvE3e-O-ySTExgL1C2nJM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfucL-rdPbd6_QJcMZsJ9NF8oBDRUU5gILtsd6dw42QaHA&oe=69A56BFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmYw3LNwEYAQ7kNvwH-QN_4&_nc_oc=AdlXiQyLEvhE-DKfGRZHZwXxWWmuvApY1IfG9qklNSAVgEnPzzTptujvq0twZh-hPWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftJ6hiU0QDLfGr42R4dkk9Nib2giIN5wikrySX7PguHDA&oe=69A5A08B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\nDuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\nPunchPads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches while enjoying a fun, energetic workout!\n\nCompete on the leaderboards and secure your place in the Hall of Fame!\n\nIf you enjoy the game and want the developer to keep updating it with new minigames, please leave a review!\n\nJoin our Discord to suggest new minigames and features:\nhttps://boxing-minigames.com/discord", "short_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\n\ud83d\udca3 DuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\n\ud83e\udd4a Punch Pads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches.\n\n\ud83c\udfc6 Compete on the leaderboards and secure your place in the Hall of Fame!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32742952751987109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOMJ-fxbdt8Q7kNvwFxYoIx&_nc_oc=Adk7SSYc5lv3Gvmpj8U5YDvB2-2FGH26FrtEnkhukbQHnufIAqI3xlE_J0d7JuZ6Svs&_nc_z
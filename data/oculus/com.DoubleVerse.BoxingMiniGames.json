589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJkotgEokTEQ7kNvwEaSZt_&_nc_oc=AdmNa85tr1pqGtm-H6xGmFJs-VVXuayfmiS4vhYVJxfKiI3e5IX9EJtUIROjdZZkfGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftL2YdPHtvwswjI188BgLNhpambPbOU25FHzPeXL_HRgw&oe=699B1441"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfevjIoHExIQ7kNvwEZyIJ_&_nc_oc=AdkVH5bWNJamRToEFFpPujwzR-eQ412bqS7I2PQI4ElsbT8QL7KZCQ4_TmN-QvGw-hM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs4zQmh20fVL8YKHgiSHcvz-kWPXw_6rqibFIHA92ECWg&oe=699ADFFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8USBJkO0oUYQ7kNvwFs64QT&_nc_oc=AdnS0uNBwr11acnPPMr9lUgPAvOvgaciJDSzbBiNT0a-BpmdnKnFiq25wcRyBKSxIz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsupjlfMpOAndZnunr_uO3s95a_mM9fTr2CLMS6Riyl2w&oe=699B148B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\nDuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\nPunchPads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches while enjoying a fun, energetic workout!\n\nCompete on the leaderboards and secure your place in the Hall of Fame!\n\nIf you enjoy the game and want the developer to keep updating it with new minigames, please leave a review!\n\nJoin our Discord to suggest new minigames and features:\nhttps://boxing-minigames.com/discord", "short_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\n\ud83d\udca3 DuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\n\ud83e\udd4a Punch Pads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches.\n\n\ud83c\udfc6 Compete on the leaderboards and secure your place in the Hall of Fame!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32742952751987109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQjw-Ng4OigQ7kNvwHoiJCj&_nc_oc=AdlTJkJgNDJ52iX0QF8phWl-mOeGYIQ-2_EL7KFaRu_ptQmQvRmzpyk_eQpYMA152JU&_nc_z
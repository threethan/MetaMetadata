25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX9kV1gD3L4Q7kNvwEjfh9e&_nc_oc=AdkTMNLznz2B8sZkI8UuNi3Zf82Pg4eu58dMfmgqWbiu7qK-Mw3GNF1pO_7L5VAUXOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsiROjj4nnUcFApjmJB3jJhbvxeBYoG0OSq8F6zmrnvCA&oe=69A6BBBD"}, {"file_name": "screen_1.png", "id": "3351625561657667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_3351625564991000_7741959412393589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daJ8yTQgyocQ7kNvwFLQ_Jg&_nc_oc=AdnhF7Y7hQRW3928X5knOecFH26CkaF6b2Lt_1bhV45mMQXPFbNLiTtX6EZVxqj9QXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuESDIjvuE-gSPm1WbGLmuqCUbMg23hASHfF8eDkDw7kA&oe=69A6F1C1"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqPyR5P__hwQ7kNvwGTa0CV&_nc_oc=Adnq4LRyvpi-WaAnVyVCCnW_63Sgg2jlpqavjMaHxkuTq9HOTNePkYvY5j8SMflulMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaKpayvLxlfRu41QmS_ui8_FaJYKq4HNzVLecOpqqgog&oe=69A6BD7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmYw3LNwEYAQ7kNvwERwn2z&_nc_oc=AdlufBYWFGEVJT0DVRaI9zaLqVLyB8RsGLVMm01ht63qazaE5WK0vvwqDDPrEZAvF0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEif_CG38DK_pkVGavfBLZCHrEN8AA1Hr0f5XJ3BKpIQ&oe=69A6F20B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "# Simple. Fast. Addictive. Fun.\n\nMore fun than a workout. More sweat than a game.\n\nPlay **four** boxing-inspired minigames in Mixed Reality. Punch, dodge, and fight for your spot on the leaderboard.\n\n\n# \ud83c\udfaf PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n{1576377066914893}\n\n\n# \ud83e\udd4a DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n{4395219167382469}\n\n\n# \ud83c\udfb5 PUNCH PADS! RHYTHM *(New)*\nHit pads to the beat. Three tracks, three difficulty levels. Nail your timing and chase a perfect score.\n{920369430693308}\n\n# \ud83e\udd86 DUCK STREAM *(New)*\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n{1643136693522638}\n\n\n# \ud83d\udd25 THE 7\u2011DAY DUCKERS CHALLENGE\nConsistency is everything. Survive for **2 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**. Do you have the iron will to earn them?\n\n\n# FEATURES:\n1. Four minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n\n# \ud83d\udc51 UPGRADE TO SUPPORTER STATUS\n\nThe game is **free to play** (Punch Pads and Duck Or Die). \n\nBuy **Supporter Gloves** to unlock Rhythm and Duck Stream \u2014 with more exclusive games on the way.\n\n{1975239106428167}\n\nJoin our growing community and suggest new minigames:\n\nhttps://boxing-minigames.com/discord\n\nWrite a review if you like the game!\n\n\n", "short_description": "Punch. Dodge. Sweat. Repeat.\n\nPlay four fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34089968433952194"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOMJ-fxbdt8Q7kNvwGwOmbW&_nc_oc=Adnsf_5m--eqImnuTEczQ6gt2is3SbLiuz5hdDRypm2HapJ9f9_uYrCwAfBQ7opWm2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpfUsYygx1V_SCG_F9JHNGwXWTmRLMI0y14kwGKwl85w&oe=69A6BD2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1745047920, "lastRevision": {"nodes": [{"id": "29005942969021458", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_loca
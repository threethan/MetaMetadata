589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlvBzIZKLS0Q7kNvwH-HFur&_nc_oc=AdnedOT5Nn7H8Eb_rMhj96_gas9KWQ1skQr5sUvvC4b3H2xXf4GvOZLhyizpM1PtpgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqHhR8nZNsnEdrWG8eO5h1xd3rADbd5QS6JUpFnE76IQ&oe=69A05A41"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvr8trNzRJUQ7kNvwFX1PTm&_nc_oc=Adkor-DOkBZCu_NlrUqLADTNbh3xRtXnFl3IrZlRThTHPrYf1tDUxncJWv9Lw-3ES5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9dwTm4rlRhJAEu6Yr_8mED1kt05gtREVF3ccK5I9GTw&oe=69A025FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAih6ETJtQQ7kNvwFbSgqU&_nc_oc=AdlMcTSeeQUXa0qCb-RLNPrbm3ANZUlWkpU8j-mb9u1-n-2llNv2XSU8nhh8AcOTZy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJj5IXcd-MQcOF0qm8J7eHudODDkqe1gPRM_8lFklG-g&oe=69A05A8B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\nDuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\nPunchPads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches while enjoying a fun, energetic workout!\n\nCompete on the leaderboards and secure your place in the Hall of Fame!\n\nIf you enjoy the game and want the developer to keep updating it with new minigames, please leave a review!\n\nJoin our Discord to suggest new minigames and features:\nhttps://boxing-minigames.com/discord", "short_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\n\ud83d\udca3 DuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\n\ud83e\udd4a Punch Pads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches.\n\n\ud83c\udfc6 Compete on the leaderboards and secure your place in the Hall of Fame!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32742952751987109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epZ6o0D7QU0Q7kNvwEYmQ5Y&_nc_oc=Adl94C2_-i5NTxrDWymoiEvJtoIcSRfXUlGal7gDXisHL8K_p2PjdFtJD6o1qd1v-BA&_nc_z
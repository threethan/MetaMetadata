-IKBvyO96P6L60kbMyOxqOE8hqJ_UKtW0MoD_fSkvA&oe=6A394ED6"}, {"file_name": "screen_4.png", "id": "1412833807215995", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QrOObemHdMQ7kNvwHh918e&_nc_oc=Adr9g8BD_HJpZEGo0qQlDs16-EOUWOPR1LIZRcvejiDd3PPtgnc81J9MrfbvKkR4G8g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TbKmBcdKdFMdwW1mcb7APEKPNTc9uNkiLnLhDn_VV6g&oe=6A394A7D"}, {"file_name": "duck_screen_no-logo.png", "id": "1737972544037986", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499624983_1737972547371319_4358276449395228273_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYtMJ0c0Q6gQ7kNvwFCbj30&_nc_oc=Adq1m_euHmDck7aDPKkcjSFrhvM3hNkdElgB2BdjnbMPdVN2g7zMb436XHwSOFxoM2c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hL2ig2trFPwGHQrqGnsesBAqG1AfttQKyiPXaghp7Pg&oe=6A394319"}, {"file_name": "match_attack_boxball_logo.png", "id": "1312480817482174", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491818885_1312480820815507_8671253183299078978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzjVz8RTuxkQ7kNvwGocCEE&_nc_oc=AdrFwKCftpRbtNdRD7mB8AJyDBS6CvFvc-gApw5utJBh1gTNBjrvOLSk4KqWm_XNcKI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sVO2bzU8lAjPzFTT24Fb7rTS9b7UYC5uouTo90iczqg&oe=6A39446B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9vjQPMeIgcQ7kNvwHvYb9n&_nc_oc=AdpdbN4ayK2_QaeFWZoPqgaYQnFlLU8Ze5fyV-kbWcHxhDKn7pDbd-F1c0xXwtnHWdY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l2vtbmfUQPyNer8sgpp2HENAiuGbQ6R99oSxN_ZQfdw&oe=6A39488B"}, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "keywords": ["boxing", "fight", "fitness", "training", "rhythm"], "long_description": "# Real boxing workout. Disguised as a game.\n\nPlay **five** fast-paced boxing minigames in Mixed Reality \u2014 plus multiplayer.  \n\nReal combos, real dodging, real sweat \u2014 no complicated setup. Just punch and go.\n\n\ud83c\udd95 Latest Update: Rhythm Content Drop\n\n\n{1576377066914893}\n# PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n\n\n{4395219167382469}\n#  DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n\n\n{920369430693308}\n#  PUNCHPADS RHYTHM\nHit pads to the beat. Five tracks, three difficulty levels. Nail your timing and chase a perfect score.\n\n{1643136693522638}\n# DUCK STREAM\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n\n{1386073566587568}\n# BOXBALL VR (Multiplayer)\nPunch the ball at everyone in the arena. They punch it back \u2014 or they're knocked out. Fast, loud, and competitive.\n\n\n#  THE 7\u2011DAY DUCKERS CHALLENGE\n Survive for **1 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**.\n\n# FEATURES:\n1. Five minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n{1975239106428167}\n#  UPGRADE TO SUPPORTER or PRO STATUS\n\nFree to play with **three** full minigames. Upgrade to Supporter or PRO to unlock all modes, training tools, and exclusive gloves.\n\nWrite a review if you like the game!\n\nhttps://boxing-minigames.com/discord", "short_description": "Real boxing workout. Disguised as a game.\n\nPunch. Dodge. Sweat. Repeat.\n\nPlay five fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n- BoxBall VR (Multiplayer)\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36256288643986818"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3ubk5A6rk4Q7kNvwFX0Xt0&_nc_oc=AdpQa4ZQK1F4PAlZyHMaFh9yqdi5cxluHolf3tZFJnuYvbE6hQdqkSRE-eLKeLtQoOU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8baM2_NgARkG52E8leqpvCB6aXENtJ5CAkfteRNpJoBg&oe=6A394BED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "co
VMxyLH8AM96ayb7iYQn8hfuN0HXtdbSnMg&oe=6A7C5316"}, {"file_name": "screen_4.png", "id": "1412833807215995", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0FMN9ag-UcQ7kNvwHv3Mnv&_nc_oc=AdoIncPFYBSFqCBXAALQQBnA9nhGvdgVrC7kHiuwKb5Rr4yqSkBqaM_8iPwGsxlWiQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEScroKgrS-0Jn9CDrC3cRuylmXwC_HFy9l5vcvgjjV3Q&oe=6A7C4EBD"}, {"file_name": "duck_screen_no-logo.png", "id": "1737972544037986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1737972547371319_4358276449395228273_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmdY45VKUd8Q7kNvwGi3O15&_nc_oc=Adr_7148M1nT8aWPFQYNgVH49hzsMmvLy8d_KO5ZkJPpuXkX6pJdDU66bswAvUcLMu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf-Vmsisz8H3D20936gmy9c6NWxK1jG6WrN_7CwacE2w&oe=6A7C4759"}, {"file_name": "match_attack_boxball_logo.png", "id": "1312480817482174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1312480820815507_8671253183299078978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FB5OfjP71EgQ7kNvwEroB_3&_nc_oc=AdqyX_OIY8oeY1urQhMaYH1wYf06_d-No86yKy4X-b7E2l-bQVXFiODHXWuQw-NZEGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvBIQJqmBxCaxe8gSEkQIvXZPQiufS-7-JRF5lDJuJaA&oe=6A7C48AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNedo5VmxAkQ7kNvwHgG9-o&_nc_oc=AdpasrmZP5b7P_9i4YMrxD1gxZHMEi1GUGaP1UTRykAVaZ09M7K2ONPMrV58XgrkVi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXRA322gTpCOGUUgj3AGjzI0B6HFlbjyQ-3D1HA36TVQ&oe=6A7C4CCB"}, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "keywords": ["boxing", "fight", "fitness", "training", "rhythm"], "long_description": "# Real boxing workout. Disguised as a game.\n\nPlay **five** fast-paced boxing minigames in Mixed Reality \u2014 plus multiplayer.  \n\nReal combos, real dodging, real sweat \u2014 no complicated setup. Just punch and go.\n\n\ud83c\udd95 Latest Update: Rhythm Content Drop\n\n\n{1576377066914893}\n# PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n\n\n{4395219167382469}\n#  DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n\n\n{920369430693308}\n#  PUNCHPADS RHYTHM\nHit pads to the beat. Five tracks, three difficulty levels. Nail your timing and chase a perfect score.\n\n{1643136693522638}\n# DUCK STREAM\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n\n{1386073566587568}\n# BOXBALL VR (Multiplayer)\nPunch the ball at everyone in the arena. They punch it back \u2014 or they're knocked out. Fast, loud, and competitive.\n\n\n#  THE 7\u2011DAY DUCKERS CHALLENGE\n Survive for **1 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**.\n\n# FEATURES:\n1. Five minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n{1975239106428167}\n#  UPGRADE TO SUPPORTER or PRO STATUS\n\nFree to play with **three** full minigames. Upgrade to Supporter or PRO to unlock all modes, training tools, and exclusive gloves.\n\nWrite a review if you like the game!\n\nhttps://boxing-minigames.com/discord", "short_description": "Real boxing workout. Disguised as a game.\n\nPunch. Dodge. Sweat. Repeat.\n\nPlay five fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n- BoxBall VR (Multiplayer)\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36256288643986818"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmcI7bhdYVYQ7kNvwFmnyls&_nc_oc=AdoSoOytGRByh7Tj4QtlPAog-_uOPnM9KXrKkedpcG3dFBvesxN1xgR8kECvcd-GaY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaMtVCagtWCqH0wWhHA4M4ILWa6YAZvCfdWGeAEjtW3g&oe=6A7C502D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
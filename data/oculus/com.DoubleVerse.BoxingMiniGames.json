u1sNuovYhNGl5LAVtBTgZHN6XwNmVqaBlA&oe=6A088756"}, {"file_name": "duck_screen.png", "id": "809652825267797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_809652828601130_7252622020468766824_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvagfToipRYQ7kNvwGdLun8&_nc_oc=Adq3NB4OcIQCMCC8ycsK-1imqQ8tM8Pog1tfIBxrsAo1vze-sbCd4zQUiEl3IQEYL7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BeXkBDsIs5DWXLTn0GeR_Je-MzdkigBNNE3UcnJoEug&oe=6A088E16"}, {"file_name": "match_attack_boxball_logo.png", "id": "1312480817482174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1312480820815507_8671253183299078978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MOCt6lJASsQ7kNvwELoUCv&_nc_oc=AdqV5HRncG9AGvN8yM6JEduBcKg7SXU2Oe4udPu3DGMNRqA_Br39AnPRn0r9KPmS70Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VNGBiw_dennhCUTxwmkGizBUYQ7SCAFnXG6MNKaf2sg&oe=6A087CEB"}, {"file_name": "screen_4.png", "id": "1412833807215995", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-1eaQnkBIwQ7kNvwHgjFAH&_nc_oc=Ado3YHF27Psagl4VVVo3rSK9L_JMW4gQUbcS8F_lnwz-DxdmF0xVEYUa1Oh60leGKlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54tvGjgSTfmIIpFS9zIarMuO8gGeT0qqHyv-dGr5PNpQ&oe=6A0882FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLmxFDXd6F8Q7kNvwEQY0i0&_nc_oc=AdqXXFLIQ3NVM2D1kfvm_ebQuTLi_FXxN8BbZADfqbZbk3s7ZwsxYyDFNgalgG2SBkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JEW2ytuVFmrK35lJSIYmJIfPaAp2Bh7wgRocBi9q_wQ&oe=6A08810B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "Play **five** boxing-inspired minigames in Mixed Reality and VR. Punch, dodge, sweat, and fight for your spot on the leaderboard.\n\nNow with **multiplayer** \u2014 punch it out with friends in BoxBall VR. \n\nhttps://boxing-minigames.com/discord\n\n{1576377066914893}\n# PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n\n\n{4395219167382469}\n#  DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n\n\n{920369430693308}\n#  PUNCH PADS! *(New)*\nHit pads to the beat. Three tracks, three difficulty levels. Nail your timing and chase a perfect score.\n\n{1643136693522638}\n# DUCK STREAM\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n\n{1386073566587568}\n# BOXBALL VR\nDodgeball meets Boxing. Punch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins.\n\n\n#  THE 7\u2011DAY DUCKERS CHALLENGE\n Survive for **2 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**.\n\n# FEATURES:\n1. Four minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n{1975239106428167}\n#  UPGRADE TO SUPPORTER or PRO STATUS\n\nThe game is **free to play** (Punch Pads and Duck Or Die). \n\nBuy **Supporter Gloves** or **PRO** to unlock Rhythm and Duck Stream \u2014 with more exclusive games on the way.\n\nWrite a review if you like the game!", "short_description": "Punch. Dodge. Sweat. Repeat.\n\nPlay five fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n- BoxBall VR\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35468922719390085"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6gPhCsRDwgQ7kNvwE12_Lx&_nc_oc=AdoMa8rVJnQvtkdpYGqNchH1Uygtz5GvDUxQo2iBLKttHDjVqbCwTe8fydWmz_3MRS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JjnQLRDleGRLNNMumutnFhkNcSdd-DOdtspNl44_qNw&oe=6A08846D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": 
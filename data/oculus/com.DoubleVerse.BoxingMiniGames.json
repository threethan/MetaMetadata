-kDllQM9BCgS8cMC6_VRc10K7PgjMfF2g&oe=6A204256"}, {"file_name": "screen_4.png", "id": "1412833807215995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EYH4gYBx7MQ7kNvwFpVYpy&_nc_oc=Ado5mqRmFYlWO4WK7M9oDZIqICw7MknOOuUZ-OU7w4VqOdrQc2xlShineSa34p2Yqk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QhifBxMD1c7bgSJtbMyVvtn9hrerBfmHjOq6pkq4Y-w&oe=6A203DFD"}, {"file_name": "duck_screen_no-logo.png", "id": "1737972544037986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1737972547371319_4358276449395228273_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBRMTb3HjoMQ7kNvwEzpt-J&_nc_oc=AdqJqaPlIZMsbrDWe53CToLYcYv3236jJOtRkiVvwWuzpIrfiCAWmQuFGnnN1SWDBwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pHerkYYP3oZvZ_YOTE_Niq8vKwu-xfMy9fn3cSd3TDA&oe=6A203699"}, {"file_name": "match_attack_boxball_logo.png", "id": "1312480817482174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1312480820815507_8671253183299078978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAq6kJ_gHdgQ7kNvwE2zj6P&_nc_oc=Adp2N9uM3W6wDhhhfK8jgU30P1T9YiscJQXv3BW6_x1Jucom31Csu7aSfCTe8y0A8N4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66QYovkykRfGReT_SrRwq50T8j64h0kd8zxNoqxTGuuw&oe=6A2037EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBgEn3ZzAh0Q7kNvwF3BKgl&_nc_oc=AdoXDd6Kv7ht_5FCEvbnbTrcGesHHABrdsp1AVAFvfu5EGQHNDZ5_WTQesbNtx4Adlo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-qMlMBjyewyn1lk2tApWNn_zPNHqZ-UbT8ClfsheJ_w&oe=6A203C0B"}, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "keywords": ["boxing", "fight", "fitness", "training", "rhythm"], "long_description": "Play **five** boxing-inspired minigames in Mixed Reality and VR. Punch, dodge, sweat, and fight for your spot on the leaderboard.\n\nNow with **multiplayer** \u2014 punch it out with friends in BoxBall VR. \n\nhttps://boxing-minigames.com/discord\n\n{1576377066914893}\n# PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n\n\n{4395219167382469}\n#  DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n\n\n{920369430693308}\n#  PUNCH PADS! *(New)*\nHit pads to the beat. Three tracks, three difficulty levels. Nail your timing and chase a perfect score.\n\n{1643136693522638}\n# DUCK STREAM\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n\n{1386073566587568}\n# BOXBALL VR\nDodgeball meets Boxing. Punch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins.\n\n\n#  THE 7\u2011DAY DUCKERS CHALLENGE\n Survive for **2 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**.\n\n# FEATURES:\n1. Four minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n{1975239106428167}\n#  UPGRADE TO SUPPORTER or PRO STATUS\n\nThe game is **free to play** (Punch Pads and Duck Or Die). \n\nBuy **Supporter Gloves** or **PRO** to unlock Rhythm and Duck Stream \u2014 with more exclusive games on the way.\n\nWrite a review if you like the game!", "short_description": "Punch. Dodge. Sweat. Repeat.\n\nPlay five fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n- BoxBall VR\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35824425283839825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaRhf50jdHIQ7kNvwG6K7wk&_nc_oc=Adq6bjBbEnpcQKN5FK_o8GOhdejb_9L0tyMRWCUPFm1CFPJUF_Tzfkzg-oFLVKJpoZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qRroaN_oqmcQfvfpcNd2YyqR_YCGiQB6EHVc8O-prcA&oe=6A203F6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Fitness Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name
4.png", "id": "1412833807215995", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819859_1412833810549328_1496343074408179760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pMUY2pD0poQ7kNvwGkUTTM&_nc_oc=AdpayHIGF-VzGiR6IhpNJGfHD1WJZ8x9DADO2fzzaMZ-WQV-gxJSN2MbFpU5vp6J0c8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1H7tOoBvrEf4OPVY01HpdzHWOEQtMAFPlqMRsA-OegBw&oe=69F2197D"}, {"file_name": "screen_1.png", "id": "3351625561657667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_3351625564991000_7741959412393589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KPxJ6nJx84Q7kNvwFTRpC-&_nc_oc=AdrFIl34FdJqYTDBDm3V4RBFFnkCkfqQLwHBbvAqOthEuJMeVTOrk3STyJWUAfEzW6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1hkfyxBS8K7-x59UxEogJUsxjOj7Hj4RONp53db65lyg&oe=69F21741"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGrNJV2yp7gQ7kNvwFZgAzA&_nc_oc=AdpkWvNJJoNpaWOsK2STQQMo2RuO_YXSiTxL-lGuOQ_wTrAIxk8IcTPpA_HkVJU0vpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3KkKm1zCNPnHwqDX6V0OR7iY0SE5X0K9oWu9AqHO1Pgw&oe=69F21B3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Jtw4dNkBcQ7kNvwEP-5TB&_nc_oc=AdqFD6JO1XsZQul10KGd8SHDu0tGQURslQfXsSKVIrmXFSGaeyovSejRubkSlGsdlDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1pa73IbcvBWlx7ezuaOspSb2221cxwDMyPUle4kAeNwA&oe=69F2178B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "# Simple. Fast. Addictive. Fun.\n\nMore fun than a workout. More sweat than a game.\n\nNow with **multiplayer** \u2014 punch it out with friends in BoxBall VR. \n\nPlay **five** boxing-inspired minigames in Mixed Reality and VR. Punch, dodge, and fight for your spot on the leaderboard.\n\n{1576377066914893}\n# PUNCH PADS!\nThrow real combos \u2014 jabs, crosses, hooks, uppercuts, slips, and ducks. Classic pad work, just like real boxers train.\n\n\n{4395219167382469}\n#  DUCK OR DIE\nDodge bombs. Smash spheres. Survive as long as you can as the speed keeps climbing.\n\n\n{920369430693308}\n#  PUNCH PADS! RHYTHM *(New)*\nHit pads to the beat. Three tracks, three difficulty levels. Nail your timing and chase a perfect score.\n\n{1643136693522638}\n# DUCK STREAM *(New)*\nDodge everything. Train your head movement, slips, and ducks. No punching \u2014 pure defensive skill.\n\n\n\n#  THE 7\u2011DAY DUCKERS CHALLENGE\nConsistency is everything. Survive for **2 minutes** in any minigame for **7 days straight** to forge the exclusive **Duckers Gloves**. Do you have the iron will to earn them?\n\n\n# FEATURES:\n1. Four minigames\n2. Monthly leaderboards & Hall of Fame\n3. Mixed Reality \u2014 play in your own space\n4. Works great on Quest 2, Quest 3, and Quest 3S\n5. No complicated setup. No loading screens. Just punch and go.\n\n{1975239106428167}\n#  UPGRADE TO SUPPORTER or PRO STATUS\n\nThe game is **free to play** (Punch Pads and Duck Or Die). \n\nBuy **Supporter Gloves** or **PRO** to unlock Rhythm and Duck Stream \u2014 with more exclusive games on the way.\n\nJoin our growing community and suggest new minigames:\n\nhttps://boxing-minigames.com/discord\n\nWrite a review if you like the game!\n\n\n", "short_description": "Punch. Dodge. Sweat. Repeat.\n\nPlay five fast-paced boxing minigames in Mixed Reality:\n- DuckOrDie\n- PunchPads\n- PunchPads Rhythm\n- DuckStream\n- BoxBall VR\n\nSmash spheres, throw real combos on pads, hit to the beat, and dodge your way to the top of the leaderboard. \n\nSimple to learn, hard to master, impossible to put down. \n\nTrain your reflexes and get a real workout \u2014 without it feeling like one. \n\nFree to play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34806085702340460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTWtlUyfN1QQ7kNvwHodszw&_nc_oc=AdqiDqsi-54RChA9J7lfOU-IIxnyqUDaKZxsDHj4Vcs90jSLcUcf5Wtywp8OmliD0aY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Xvdz0cRZrVugWpOHqVs3ifHrWAMT3FUVY39bo8CTMuA&oe=69F21AED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DuckOrDie \u2013 Boxing Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1745047920, "lastRevisio
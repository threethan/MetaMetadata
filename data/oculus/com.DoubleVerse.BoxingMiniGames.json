589368_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HyX0qh0apEQ7kNvwHu9BHs&_nc_oc=Adnon-1KvxklGgL4BAo2VEjQP5OQLUT-b7AinowhEUqVsw5U7xrK4zZ5amiBCT_mvTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvrb_mA5-hCft3ssyrwLcqhcuuWfrbjBKSpYRSSNfXTjg&oe=699F08C1"}, {"file_name": "screen_5.png", "id": "2359998501084857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_2359998504418190_7742829918217758872_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s27pOinGfHYQ7kNvwGaIHyS&_nc_oc=AdkCuorYjsJXcxt3WxsJhmcEPLdVb5TgGiDdJ1pMuVgajpRB1WnkH94O3HYIfT7A19Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftLjG9qvEeTKtHn34godC-SoXmHJJJqLPn5ktj-kOXmeQ&oe=699ED47A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckordie_happy.png", "id": "1005876471155759", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820077_1005876474489092_8944112902303556821_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAih6ETJtQQ7kNvwH3DXqU&_nc_oc=AdmqkvgKK9VZGPIB_plX-ceIe11Y-cyVMrMgPNgntMGuyPtfNIs7XuKT0Zs_y-he0a4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfssJHjxVAJBrKjEiT7Ve1Bc6YmYT5ynhWnCyU5mYxpi-g&oe=699F090B"}, "display_name": "DuckOrDie \u2013 Boxing Minigames", "keywords": ["boxing", "punch", "fight", "fitness", "training"], "long_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\nDuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\nPunchPads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches while enjoying a fun, energetic workout!\n\nCompete on the leaderboards and secure your place in the Hall of Fame!\n\nIf you enjoy the game and want the developer to keep updating it with new minigames, please leave a review!\n\nJoin our Discord to suggest new minigames and features:\nhttps://boxing-minigames.com/discord", "short_description": "Play two fast-paced, boxing-inspired minigames\u2014with more to come!\n\n\ud83d\udca3 DuckOrDie:\n\n- Dodge bombs to stay alive\n- Punch yellow spheres to earn points\n\nThe longer you survive and the more spheres you break, the higher your score will be.\n\nTrain your reflexes while enjoying a fun workout!\n\n\ud83e\udd4a Punch Pads:\n\n- Punch boxing pads to get points\n- Dodge obstacles to keep going\n\nSharpen your coordination, dodges, and punches.\n\n\ud83c\udfc6 Compete on the leaderboards and secure your place in the Hall of Fame!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": "https://boxing-minigames.com/discord", "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32742952751987109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819449_1694478841499060_2740102024474464453_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epZ6o0D7QU0Q7kNvwFBH9F5&_nc_oc=AdkrFAZkRMgf2KZTpUfub98yRfUv3HfEIHrKUd94oDGIPONh_EZ4EwcoiqWpYKtoopQ&_nc_z
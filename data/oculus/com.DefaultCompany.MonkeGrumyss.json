6_21-12-36.png", "id": "1278950500273095", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821725_1278950503606428_6528155568162701408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JIMH2f3C2cQ7kNvwHnM7Ij&_nc_oc=AdqpAJVmdacT8Hr_gjcegcoXxhYDvcNw2DS4BwbsbSLuH1GSne3hKzlb9JhWOUkfaXA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeYnQ6tzj34pQ1h4lWyt8JBeIRwGYNTtJTXoYM3aPtSw&oe=6AB678F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_1032.png", "id": "1626151225382373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_1626151228715706_3323382020696544340_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG2MqdbWcW4Q7kNvwHCRmgU&_nc_oc=AdpsQdjVic8mAbft5-RQOhMfArFGnGRRoYZgi5dpnKYC-kUKocQpUHdAnfHuNS4F3Vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI45LMedRoCz-5qMCOypj5OCumghjdeNoYEfcRRH2KXxA&oe=6AB69DAF"}, "display_name": "Monke Grumy", "keywords": ["Monkey", "Monke", "Monkeys", "Gorilla", "Vr"], "long_description": "Monke Grumy is a super chill and fun social VR experience where players can hang out, chat, and connect with others in a lively virtual world. With seamless voice chat, you can talk, joke, and vibe with friends or new people from around the globe. But it\u2019s not just about talking \u2013 the game also offers a variety of mini-games that keep the action fresh and exciting. Whether you\u2019re competing in challenges, exploring cool environments, or just chilling with the community, Excuse Monke Grumy is the perfect place to relax, laugh, and make new memories.", "short_description": "Monke Grumy is a chill game where you can talk to people with the voice chat and play mini games !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkeygrumyprivacypolicy/accueil", "developer_terms_of_service_url": null, "publisher_name": "PylouVr", "support_website_url": null, "website_url": "https://sites.google.com/view/monkegrumy
6_21-12-36.png", "id": "1278950500273095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821725_1278950503606428_6528155568162701408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm8JhxHoa7YQ7kNvwEgGh_H&_nc_oc=AdpztdarL1oyYICFdOPswggXXJXzkCnu2x5JjTfOCBFfkgn837EBeO-JIkJRUcqsnAE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ7ZBSGXepsQbq7eq96Dn38E6eHZ6tzbD_tnMgCMNS5g&oe=6A5A2FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_1032.png", "id": "1626151225382373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821702_1626151228715706_3323382020696544340_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWBirQ9lQaYQ7kNvwHBSR0c&_nc_oc=Adqz4H2-ol5Vqs9_2fWfx16xUQ-X9itpBojPagPtGyPeKcx1fEftctZ1qTUivEJSdHI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw5VS0Y0C1-tELtlNmxaa3m5BYBgUZ4o0k1AxF45ZDQQ&oe=6A5A1C6F"}, "display_name": "Monke Grumy", "keywords": ["Monkey", "Monke", "Monkeys", "Gorilla", "Vr"], "long_description": "Monke Grumy is a super chill and fun social VR experience where players can hang out, chat, and connect with others in a lively virtual world. With seamless voice chat, you can talk, joke, and vibe with friends or new people from around the globe. But it\u2019s not just about talking \u2013 the game also offers a variety of mini-games that keep the action fresh and exciting. Whether you\u2019re competing in challenges, exploring cool environments, or just chilling with the community, Excuse Monke Grumy is the perfect place to relax, laugh, and make new memories.", "short_description": "Monke Grumy is a chill game where you can talk to people with the voice chat and play mini games !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkeygrumyprivacypolicy/accueil", "developer_terms_of_service_url": null, "publisher_name": "PylouVr", "support_website_url": null, "website_url": "https://sites.google.com/view/monkegrumy
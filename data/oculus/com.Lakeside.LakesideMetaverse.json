ots": [{"file_name": "Cimage1.png", "id": "955117373902549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619096_955117377235882_8813625646500796333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNCI9tWxWEYQ7kNvwEaAt5V&_nc_oc=AdqRoikXJUxFGdS-NMqNSZPqZYXNpYmD_nuJDPITSKj-6Aj1f1L6PlWeYgsdyqeK068&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJDIHSeSWQCh-dgtUTOshkmXNv5sf_C1JBrvQVKKufxQ&oe=6AB54CCC"}, {"file_name": "Cimage2.png", "id": "1782235816077745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1782235819411078_7332215240690903367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s39wakh5E1oQ7kNvwEos47-&_nc_oc=AdqXnhPaSKDM6lavRGqVWK3LO_b43wQs9OFhHuy5bWnrL_FAsI5YzdqHxs2jaTIhQBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoPgTJXcfBSqAFtQMttvyNve3g9rolCisQyQPisjuObg&oe=6AB52552"}, {"file_name": "Cimage4.png", "id": "741466928989441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_741466932322774_4904255573677700743_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26a3z9ds88cQ7kNvwGH1MEG&_nc_oc=AdoHWRc8MrI_xGOqBhiZTy3TmrnKBw5xQRQvn9_ylWQQYgG7Bfpzzl6AF8mJZzbOJ5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9-P58AfnQE7WCiwVn9547qRTSGNl0alGGtz7sCFRj3Q&oe=6AB53492"}, {"file_name": "Cimage3.png", "id": "1799013811484614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1799013814817947_7852841783241659314_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8NJwlnZfG8Q7kNvwED1i9a&_nc_oc=Adr8zKULM05kkqR9jc13TYChYumUutXinVDaO2kEGZzEFzkoUD_Sfg4jAcschEvUsHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKAJ-Cjkbts8mUafv4FCboLoTy0EY6ynVACyGlaI4Cag&oe=6AB53665"}, {"file_name": "Cimage5.png", "id": "998592305949932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_998592309283265_3648473963416612966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjDHMY505E8Q7kNvwGmWUtk&_nc_oc=AdrEtdy0MCRKpLJ1V2QM_aNMKIhum5wGbtEJCCSQwRkYo8aOcVqMohwvuwjOFuPDgkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsgy7mq00SRJDb0J_7OaPRAbFpgX98huJY4SuP4p1vVg&oe=6AB53766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LMVR4.png", "id": "1140678394880318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1140678398213651_4701365951539421001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q-EToZF47kQ7kNvwENpxw_&_nc_oc=AdojJiR_Bhu8d3YNcJejaw88_rodwmBsKVRBhrnrgnkLf7LIYcbokGylmZ8evKqJe3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyHdf2LUHuzmp7WLStPnTKQrmPLbPtEouRjOP1vVFPDQ&oe=6AB51D55"}, "display_name": "Lakeside Metaverse", "keywords": ["Trauma", "Wellness", "Mindfulness", "Learning", "Brain"], "long_description": "## Welcome to Lakeside Metaverse\n\n**Trauma touches nearly everyone \u2014 yet most of us struggle to recognize or understand it in ourselves and others.** Lakeside Metaverse, the immersive learning platform of LakeCloud.ai, brings it into perspective through 3D stories, expert presentations, and powerful hands-on interactives.\n\nStart with our **free LakeCloud - Intro to Trauma course** to build the foundation.\n\n### Step Into Four Lives\nImmersive theater stories that bring trauma into focus:\n* A **Veteran's** hopeful journey of recovery\n* An **Educator** facing trauma in the classroom\n* A **Child** supported by a trauma-informed caregiver\n* A **Business Executive** navigating trauma at work\n\n### Interactive 3D Experiences\nLearn by doing, not just watching:\n* **Playdoh Experience** \u2014 shape trauma's impact with your hands\n* **Exploring the Brain** \u2014 step inside a 3D brain and see how trauma rewires it\n* **Iceberg Interactive** \u2014 uncover what's beneath behavior\n* **Interactive Regulation Room** \u2014 two hands-on exercises to calm body and mind\n\n### Talk with DIANE AI\nHave a real voice conversation with **DIANE** \u2014 an AI expert trained on 40 years of trauma-informed work by **Diane Wagenhals**, Director Emeritus of Lakeside Global Institute and author of 35+ trauma courses.\n\n### The Course\n* 19 modules of 2D and 3D experiences, self-test quizzes, and feedback forms\n* Self-paced, ~2 hours\n* Ideal for anyone 13+\n* Complete the course and continue your learning journey with the LakeCloud Community\n\n**Learn more and create a free account at LakeCloud.ai to get your login details.**\n{1500984124695067}", "short_description": "Trauma touches nearly everyone. Lakeside Metaverse, the immersive learning platform of **LakeCloud.ai**, helps you understand it through 2D and 3D stories, presentations, and interactive experiences. Our free LakeCloud - Intro to Trauma course includes the Brain Exploration, Iceberg, and Play-Doh Interactives. Chat with DIANE AI, trained on 40 years of trauma expertise. Practice brain and body regulation in the Immersive Regulation Room. Join free at LakeCloud.ai to access the course. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://lakecloud.ai/privacy-policy", "developer_terms_of_service_url": "https://lakecloud.ai/terms-and-conditions", "publisher_name": "Lakeside Metaverse LLC", "support_website_url": "https://lakecloud.ai/contact", "website_url": "https://www.lakecloud.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
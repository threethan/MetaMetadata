cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_5Su4IHoWUQ7kNvwHQeOs9&_nc_oc=AdpxkH4K-S7kSrgP7gttU7EFykvlmqwDVTxHdB4Q8ErAJKtsBlVsTXvvIfyIDjueGaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR54-JmLaRCtQ-1MLQmHvKWDpyioDQz1gOkP1N04y2Cyg&oe=6B01C336"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPnkEh-qsjAQ7kNvwHKQGKc&_nc_oc=AdqyIwzLlrtJrdMu43QfloL-N7WSQh1CmZVInTzr70U6qDOzTyojrtuqlwSHt5XYeOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB1zpYCg2V2CnRCS9yuslSCy4WgokQ32GquG33iGO99Q&oe=6B01CB12"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU4H75DtCwUQ7kNvwESul5F&_nc_oc=AdpDqA3opv-gC8zwMyynQx1CKtPW09B18StrTiBmk7aGvflNdtpi06ISNdGIzs2rugA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4zlixTZ8UAh_XhIbyuD6-1NCMY42L7miqhCYu5U-C3A&oe=6B01E9AA"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1yDy9suCSkQ7kNvwEWb3H_&_nc_oc=AdpfSdI2qdNwLxjLky9E8ehxRps5CkjB_0uz23Emqui-re_qkBEFoS8WwM7y3CNm0gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRExCDDfbeQP4mfCOS3DEsYQBOL5oCimhLLZc4BQlsJPQ&oe=6B01EB59"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtU9uI4G52sQ7kNvwFZpfm_&_nc_oc=Adr2fsrhtK8w-gsEVXyzijDCOgl2Utp5bi3NQ9ODBv5gerCvmeNf_5p5yjPGOAtc8GM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7t3YiQYnbG52pvN9kbNsEHeeJrrMkfGZfDvAOHjlX7w&oe=6B01C653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
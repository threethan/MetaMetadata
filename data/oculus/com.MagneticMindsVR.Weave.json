cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhOkVsUPWMYQ7kNvwEgDKZC&_nc_oc=Adpw1mUZ7fk9-auF19LkxV4NmiRjkNAZdyyn6NUlz8-_sM4HPxFd-TBydvktWRo1JsI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9SEy-vQV9ugrW0cIhznrOEwCVqX5CACD5EZyeXHSqYQ&oe=6AFB2BB6"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auylrnlw9VwQ7kNvwFhY1Ym&_nc_oc=Adrsy5JpXYrErozXS_kYxziyo2jIXsDCpk4Vfzdfy6QiA1Ooh6MKq1asFhQ2a--RUL8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThXLFiatx7oUBgG-rs-q9HFxYsLs3KIaaW0w5q7BZ8Bw&oe=6AFB3392"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m572p9Bd5GkQ7kNvwEruCe4&_nc_oc=Adozfp5xWGdXw50U6vDHqjz5RS6evRvaj6cLsx0Er7y1-4kppVh5I8O6zNMtcZiAU2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9Lr40StuTxEkQLoVyaLI8gnr_OQXLAMIehUprhan4pA&oe=6AFB19EA"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEECKawijMEQ7kNvwFZc_Zl&_nc_oc=Adq0jJ_Zs_iB6WTT0lYoxe6Mthq1N5FMLdgaComvszV8kj5wcqlHhMY1OPVL9Indl2U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0QDJFM5BE2_I_khvLrh_g_K7Kg8YmzcKdLiy16O23-A&oe=6AFB1B99"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egKy4FaSolAQ7kNvwE-nK9C&_nc_oc=AdqBIXc9Xiw7ZKylUlU1Isv_5HDeVFtGlMBhHiBVMeHEaQzo3IUfkWZDa1J7zhbACuU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKt1vm8j2pKTsU_efr5IknPWum6qAHPV5Aldh_fo0tVw&oe=6AFB2ED3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
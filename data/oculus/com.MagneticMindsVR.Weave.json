culuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP2mD03zgDUQ7kNvwFfaZx6&_nc_oc=AdpjBJwXwTYytVcXY4zHUO79FUukcZKVEDQBt4XRZysDF6CH_kXVj4vn3DRTOKgbcF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvNBwIeQF4GTkI-tsuzon5BAtAn5Lmx0_JZAQmaeia7w&oe=6B0DC8D9"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLMm-Y3c9qkQ7kNvwH8KdOT&_nc_oc=AdoUYEvGran8vKjM_BBGUBDePrgnCA8gJJGE_WA9LttmmbaNZNq8OmEBXCk1_HjbRsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScHwLbNsit_iwVBW9QVRR7LlKjsZo0aL1sGo2YA6Wi6Q&oe=6B0DA3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "weave-landscape-ranked-2560x1440-235302.png", "id": "1081649737967041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654961355_1081649741300374_5166123167637932712_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9Qg-CIS23QQ7kNvwFJWXm_&_nc_oc=AdqvnPzpx6pHyGLln7QqSHwE2S9zqfTzchk0S5MVvrt6v1Sw7h47decb2y8VEWsB-Qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAUgguw5zMYk8-0vcd9t6gYPx1uNgbTPnF_cdBAnXklA&oe=6B0DAAE0"}, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mason_Dev", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61576309949772", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_in
&oe=6AF5E58F"}]}, "id": "1635073104830598", "locale": "en_US", "screenshots": [{"file_name": "studio-city-pose-double-3840x2160-185109.png", "id": "1759351651989948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312236_1759351655323281_1314896026855027049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj3-WDyeGgsQ7kNvwGlMUZG&_nc_oc=Adq12V_e0R72lD8gefmkhiwVb3fVP6TWoUa8edQZDyjR6QsbMQhsUXaUZ9DmAoTGGQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQEu3k0KRhEgVyb83MczwXg5IjtpGFmAjTHMENQZD2FQ&oe=6AF5E5B6"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye1hs-Bk1a0Q7kNvwHsW1ee&_nc_oc=AdraLwnhCUCMzfXa3VtI4DjwAlTq_Onx9D-Yu3yT7KFcCa8wmoLM1047PBgW4TRtgII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzk9evWPYA3b4gXsRnRnc3Hv35zriLWPwBbskmCUpY_w&oe=6AF5ED92"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t2eVcG-zKoQ7kNvwE2VvdV&_nc_oc=Ado_egaTMM_CpiuSJqjjmYaf_3gyHs9IV7znc8VrrM0DLxV0QHO1W3NcLAAz6ygWT_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5agRt47s_WR9VWhIMFNrsVZS7s6kkei0ET-F4vUBlug&oe=6AF5D3EA"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvYW0ODtUCwQ7kNvwF5FGaf&_nc_oc=AdrjTplM_n9UGUS-TSWCldpjbZ4oWq0046y2AboBv2QF_hq3w93VqOhTmQ1vIgiFL-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbkA3Pbf1e7tEUJLx_qoafjvkQX44Xv03szf4PGL2HAg&oe=6AF5D599"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXkH21XPPyYQ7kNvwG3pYYg&_nc_oc=AdoFRvRN04QNbWzRn4HCQgcT4Neybi7wLVzxJ5GFQjWct220yUYy3b9AKE-ikapSw_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-lhJmUP-_tnkHNkbastyTp2jl5TJPxk_wArErEnSHJA&oe=6AF5E8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "weave-landscape-ranked-2560x1440-235302.png", "id": "1081649737967041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654961355_1081649741300374_5166123167637932712_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKRdJ6c-RLsQ7kNvwGJChz4&_nc_oc=Adok2-hIGW9zAZ_R_ZEJeNQgJ7ZK1H_LeuBCi6kyz-qoGpZSVnrtmQCC_oWbjhTkMGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjhSWqshQTVFJhY-T0hnH6WrQKJZUUW27oWb_4ucFGbQ&oe=6AF5EFE0"}, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mason_Dev", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61576309949772", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1396322980233903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/618715053_2162418877820003_8775586978671745711_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MH22HCZE3YQ7kNvwFbGDtX&_nc_oc=AdpJBJoFSN49I2nWMHyppjNDzxKYqgjae_K_2KkNhrnr3ARTesLmxGtkvO5o8Lf0yr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7
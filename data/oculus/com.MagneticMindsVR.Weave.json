&oe=6AF3428F"}]}, "id": "1635073104830598", "locale": "en_US", "screenshots": [{"file_name": "studio-city-pose-double-3840x2160-185109.png", "id": "1759351651989948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1759351655323281_1314896026855027049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6u47BT349sQ7kNvwHuGGA2&_nc_oc=AdocSyX-ZUxeMK_AeVN4NXsBzPTkjtLFbRPDtNIW-Q_ZgHEq0RPcb1meybJaK9o-yU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZMv5Ta7zU3kCEdMpFATXPXPhknSLgsrXTq7rC5AREvw&oe=6AF342B6"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW0Ee00i33wQ7kNvwHRf2lQ&_nc_oc=AdoxblXNXxq1763Q7M0JUxqDmoJY4QyvZXy8y_MZXV1mHd_2CSGGqxcd1NuVGIiJj0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQQ3g9hJuqtwQCMQPHrZvo6OjPz9wB3Wmk2tbWPEo5sA&oe=6AF34A92"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgryzhhgJXwQ7kNvwFc65--&_nc_oc=AdrQ08AHxMskloZbf0IiiVH5gXY4-KSP-iejqrLduOhwoUvGD_y3gFHaXPEmh3fY_0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6NDFAk_njERtVbPTtChJA0j1PUnLJ-pJJT7FygeshBg&oe=6AF330EA"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvYW0ODtUCwQ7kNvwEeSX4d&_nc_oc=AdoX5ZoWCafX2fRTY9ZneehHFJO8wtA8ZZCCwB7kF9TmhvkEXpGPb35sNtOkt60yD1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSURyFt9qxsOk_9hptsgErKBJ2QwnCRgItRwTldn0p0nA&oe=6AF33299"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMh8vczYSV0Q7kNvwEMFZ4n&_nc_oc=Adqdf38ui3y02VlUdpbESsKhiy9ZezYNAk-M6rRLQdM4feDWA5ejlAhX8fwkCljkwiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv4viIvwYTASeB3mRi7GjDO1IWeTRzHZ5IFQSEclrq1w&oe=6AF345D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "weave-landscape-ranked-2560x1440-235302.png", "id": "1081649737967041", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654961355_1081649741300374_5166123167637932712_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GToXaYjJE4wQ7kNvwElNLz6&_nc_oc=AdrtfwSpnBtq3jCfnziaigWbFJQR4xkE6xdbMPaFPCwA5xHYvTLJ7076ta0FnmbfTP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuCfvysE03kU8nqoXyE2mUW2-NrJI9c3oVArmt7dsHjg&oe=6AF34CE0"}, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mason_Dev", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61576309949772", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1396322980233903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/618715053_2162418877820003_8775586978671745711_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeSm7yqHtRoQ7kNvwEcp09m&_nc_oc=AdpOb71e1F8r9yZYoyJEmabuyLT2ZIfKyOj9Ra2h2sbmTIwLQodvWgXXIj9SQxN8-tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rrXWY9iXdIQ7kNvwGqH23M&_nc_oc=AdquN_sXG4XmKBhNh_kmpQkMjxg8Oh-p31it7ASCVamgBsL9f9eddC9zKYjuvq_CSjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1QNFMkOsdzEVRfDs7xXNKPmlir-JHNaTGazt73fuycA&oe=6B070936"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQr2B0gJOL4Q7kNvwE1J6ow&_nc_oc=Adrky3c1nldPxkE0dT_GC1sIpJtiQN56sxYnrTLZDDQBFpGm7rHkg8pVtVZaJsnib7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2ejl8jSn15FGlRPelvApaE8zDzb7ZHE2qSAIwOwDCWQ&oe=6B071112"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDPNDmn48VUQ7kNvwGAx-nH&_nc_oc=Ado_OnrrajO5K5AQzM-ftmFEDax9GtMgYTbaioJw2T_vSvT7i2A1PyVyo8GKA61bisU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgRrG1f451Q2Ro7SWHVW-EkUED4sgn7LZxITJPLpTTwg&oe=6B06F76A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcMrjMtwvGcQ7kNvwFmneZ4&_nc_oc=AdoiLVxXrAONxuZU7cVXICvt0Y8QZihqb9-Um0qIZtCx88kTJouUhQAmzdZdI8LklPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTur-lBtR93Si5wlftbtW5D-Qmk1AmHuT2oJZlAHjJyIA&oe=6B06F919"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eap_r-4PcQ7kNvwHLZwgc&_nc_oc=AdrD3jit1X4jHNA6RQ-EzC5FeSXx3bM-6_kYMRJaHq5-AZajPDSoTqI_Jb2LnhCACHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSihlUAzxitjZvePH4BnxxxXbZsBF2LYPz1ZKRmVGsayw&oe=6B070C53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
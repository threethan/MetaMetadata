tps://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m572p9Bd5GkQ7kNvwFqeDJE&_nc_oc=Adpw-k6djp5wFu7EPDW_0HEVLwndlSuLQr2eJ20ZmIj4TI-L9A7jx29-M73Kdnzq4Ek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTcBp_aMROPQlONSSEskEmQAplGAOW-pZ1fgaoLlAyEA&oe=6AF9C86A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDRmlqG5QYkQ7kNvwE7kq8o&_nc_oc=Adqv68qYz1maUAQTeooa6siQKPXyI12I6TDw91xGy52wLgtoQAbvmLg67Acxm3m63Ds&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9KmMl8CbivB7ZE8FBajetVbE7esrzJM6JaErwwZN7SA&oe=6AF9CA19"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egKy4FaSolAQ7kNvwHz2kqG&_nc_oc=Adr2A75Z8diYl6dBHpr5-NDJt3c__vzOuVeEgw84Yx7Z2c-8-gwuz8TWJgsvd2fQnWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGap-BXirVFbbq8ao2siF8UmGlovSEk7R8_a7kAz4x0g&oe=6AF9DD53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mason_Dev", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61576309949772", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER",
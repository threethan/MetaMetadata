cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-L2qzjsEzEQ7kNvwEw4Lxa&_nc_oc=AdpT9yLNZ7mOZtNJaXWt8PB6pqoaWCrLydo6LxiWsObWjnMyZMrFU69gdJN4Kk0jgWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeg7b8LJmaDdNsm7kl3qfVe0cKZXn99WbuomqL8e75tQ&oe=6B1043B6"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSL0Uty1sskQ7kNvwHoDQZc&_nc_oc=AdoNHyXh07se2Y_EAv0FERvuJwohcbzRC5hfiUrvD4W0HFKmN7YhO3NQ-2cbneRi_T4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4u-HYVnwBHluM7uVHQ4XV1TY73Se8lxHXySHJf4bVCQ&oe=6B104B92"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNbUWxGo7cEQ7kNvwGB0OIk&_nc_oc=Adp92V29YkxmZecSIp7YfgaYJ_8bqJ_SvypFe9q1EI6oeZ7irrj9Hf_dHCCmo9IhSkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVY-7OWlOATb-_8zM56MhAfgxi821aPaXcv-DCBFIm_cw&oe=6B106A2A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atBdYw-iM38Q7kNvwHi5S80&_nc_oc=AdpgB84098HPG4zZM6ApRuezKrjkj2tahl9l01MVO-sJmx46s84jmvHUkj01irzeGYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEOwmVW1d1PYLD6lbgJCMzL9grkrJP6sQoCdig7fXtvw&oe=6B106BD9"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtQ3JPweAcEQ7kNvwHL8lqb&_nc_oc=AdrP6wO1yMUCy1vLdQjgeqs7ce3soFYpb2_kTdkc5vBd7OmBPItRGZA-1r8PzXiYzDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTgEg2HnF6EypgbkGUH1fLBZdbpKG01owKx9AnYECBGQ&oe=6B1046D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
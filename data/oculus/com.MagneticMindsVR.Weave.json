cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYiaGoVUxCAQ7kNvwFqAAYs&_nc_oc=Adq8nm0Kj_LMsHZkHb4A__q8NoJnOcMafuScL7NeLxh21UOqCz2CUb5JC23Cp7CB584&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzASyRPupD1fNckgJijmYvd5tJthtboRSwmr8gqBQ5Fw&oe=6B0B35F6"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SkVY5oaqnoQ7kNvwHSvldK&_nc_oc=AdrqemZtJUkgRo7-1TYmhWhYF7ELjJycg2TJIkxqjVDtuFdPiPlSEtORHsDmwkptkqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ92gJFDmYym2VOLIl0RnzMGtlI6bGQzWwIvEIJDt_dOw&oe=6B0B3DD2"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KofGAp7X0OcQ7kNvwHAXxAZ&_nc_oc=AdqQFe7y5lQsQ6uXPB4oz92lqvO_3ShrtTX5hcWSWoCS36KgE1mnpqswwf6QArauR8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRmC59wauBlProqcrj1CB99IO4-pv_XCzJP0zG-Tkovcg&oe=6B0B242A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP2mD03zgDUQ7kNvwFb6iqM&_nc_oc=AdrdBYsagOPeD1p809BllA-c1egszacrLc4trGqIMW0t9FK2urbpNHRuVv4a9KbygWI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmsI5JGBzNDl8oezbTm3YjUGzP6oJm7YqKieR0Xc2woQ&oe=6B0B25D9"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP5LVIY5RqsQ7kNvwHenSFM&_nc_oc=Adphdzrisa6WJA1OLRUBDbEU4e8R5Q66-XbIGz8Je_4GW_kOA6ncIdKRU-mAuptPpQI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-eYqWbaSmSSHv14XJfMSXlD-t5GZSSmT-7JRcKuESew&oe=6B0B3913"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgryzhhgJXwQ7kNvwF_3xLN&_nc_oc=AdoXyXSYskxwco4-UxAs-h5hdTDSkBuxc1RALywsYWvRSOXOGBPd3kyB1nAWh2Ih7yU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVNxQ3WIQ-j_Rl8oDHGYCQGiYYvvhSqlLREIyKN2_uDw&oe=6AF4826A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvYW0ODtUCwQ7kNvwEIetac&_nc_oc=AdqIetmXXexn7f1zZnfA4RvhDUsoOjnq63tmWZHjtIU751KP_4Ec2ltfQrJkbY_CbhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTCP9K_WdSYr4bbuaZ_Wb5RvOGoTs5YzL4kQehiSmpsA&oe=6AF48419"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXkH21XPPyYQ7kNvwE_9lAV&_nc_oc=Adr3ntPpxpgkRlHU0zEAF1mXKxlaCB56mAYo0U8cdxy7U9-C0GqsgW09GW8sNDNlSEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReIr5XMwdKoazGBQd4DoLGcluBV_bIJY3m9rTrbmdiSQ&oe=6AF49753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-policy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mason_Dev", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61576309949772", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER",
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaDQBWXW_qgQ7kNvwG61oDX&_nc_oc=AdoOlwFoaUsLdMH4tEOPm1WZUTxntxdcThnAV0zNW_mlj_J4iqC-ezLi9Z2nM4nmXxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqIYe0-L1KwBsEAzvZQYlvNed696Xr-jyagV4Kt443QA&oe=6AFC7D36"}, {"file_name": "studio-city-pose-wave-3840x2160-184952.png", "id": "1749059899538974", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654854429_1749059902872307_7573521759687084721_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Zm8MXi9V4Q7kNvwEASb1Y&_nc_oc=AdosOsyOdpWWMKV3sJTmFvyoi37NiFHztJNHktEb9xsSYfjkWVpONp5E9juBn_xZ36g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY79NCrCOwTNxw0w7z_Wu2krvL71620QsAxcgNpnDJ1g&oe=6AFC8512"}, {"file_name": "studio-forest-pose-fire-3840x2160-185538.png", "id": "1907673230211756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308043_1907673233545089_60110272832888287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m572p9Bd5GkQ7kNvwG9b3I0&_nc_oc=AdpwIDOZT1OuOvziN3rzxXP8aVisZCrsVNujbiukDCOKRNbgg79HmhWHJSOLd-JjiO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRVCcTUFOp_LAOhYIIE1vcsQtHXsYSrBRzb7VlBaLiyQ&oe=6AFC6B6A"}, {"file_name": "studio-forest-pose-portrait-3840x2160-185722.png", "id": "2131130627533913", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499298221_2131130630867246_3745142585246708396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEECKawijMEQ7kNvwFJYcRD&_nc_oc=AdqVizBgVtAlWMdRicGEi6bZgb9tfc_6oga6UjWRszbiZFEaWCT8oCQovyb7q4uyaPM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkLHXmSILMXdpJJWlmPGJ9kLVpoS4Sv9NkIL_8JVz3eg&oe=6AFC6D19"}, {"file_name": "studio-grab-184318-16x9-2228x1253.png", "id": "1012598434654718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654975915_1012598437988051_2368679280903125139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlnF13yI0CIQ7kNvwHHc1pk&_nc_oc=Adpxt8M8bt2xxyMbW2dfEXDNgAyM3VlCIrPu2OpNmNiwow-VC8nWK0bpheXvfMnJZU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxxLYNyHcGj_FrADpW-SC7aGaXV0nFcf5kkAD8VVOmIQ&oe=6AFC8053"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weave", "keywords": ["action", "adventure"], "long_description": "Weave is a VR game about web-swinging, and about the people you swing with.\n\nYour hands are your web shooters. Fire a web at a rooftop or a tree trunk, let go of the ground, and swing. Build up speed, chain your swings together, and see how far you can get without ever touching the ground.\n\nJump in with other players in the City or the Forest and play infection, or just hang out and mess around. Voice chat lets you talk to whoever is nearby.\n\nPlaying solo? There's plenty to do:\n\u2022 Time trials with a ghost of your best run and a leaderboard to climb\n\u2022 Hidden coins to find around each map\n\u2022 Daily challenges that change every day\n\nMake your gorilla your own. Spend coins on hats, faces, body gear, and different cosmetics in the shop, and check yourself out in the mirror. There are also optional mod packs that change how you move, like extra speed and stronger swings. They work in casual lobbies and are switched off in infection, so everyone plays fair.\n\nWeave is in Early Access. We're still adding maps, game modes, cosmetics, and more, and we'd love to hear what you want to see next!", "short_description": "Swing through the City and the Forest on your own webs. Weave is a multiplayer VR game where you swing, climb, and play tag with friend, using nothing but your arms. Race time trials against your friends, hunt for hidden coins, take on daily challenges, and dress up your gorilla with different cosmetics. In Early Access, with new maps and modes on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/weave-privacy-poli
Dq&_nc_oc=AdlmMbFxDnx886v5F6-IcdaMMcwUs31wGBRuZ1cd0z1Y8d-qVbSrVzC3PniSIy86zug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsyg_NsoCmNXuPg0iJx64dkFmzEE640cvM2Ij6QoH3ywA&oe=69A02CA9"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP-plwlcxBAQ7kNvwEDWDQU&_nc_oc=AdkEQwJIhNj6mBdFAmOzm2b1waDSuN7dHf6HcxaZQeGzC_JIV3pED77xV4fhpQZ1EOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumIwyT-_12VOHGJQbDs4nBPPSlZnv8d7cae99xEe6A3A&oe=69A04380"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUqRC4_50y0Q7kNvwG2qZ-K&_nc_oc=Adnf0ZgXwfAw4WtvTL7EAFuI8j6CxaO1SeqdDCwdkcylP_BajJ8hLRIwTYoiCwNYBqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDdqtL0m5b2KTyDlGeV6JkFEv_qBACqt6_wuEvA_HSbA&oe=69A024A4"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9_RVTeBQ2AQ7kNvwFjUmlf&_nc_oc=AdkvMzgFnY-wd9JyuwtSVi24rQBRRXPBPUmWuWxWnZms-pRoJIxaDaostcr0k7jOMIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnYrf3yCD9zQO0UuEfZxqSzsxa1OI3IrWRlLwCxi4Itw&oe=69A0486A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL_Qk_e990AQ7kNvwF-3N6g&_nc_oc=AdlbVhEwu2Ob_zYkRCylpzZa6sVZqhcp0gYFiSS_CygHO5t-ccPp55DTdyzTIe0sKrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvy1Vt3umbAa9tBcZkYbU2sluC9dQhr-3j2GbndkxVAUw&oe=69A05A78"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nazar Korinnyi", "support_website_url": "https://sites.google.com/view/hellfire-rampage/contact", "website_url": "https://sites.google.com/view/hellfire-rampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9541893689193081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392069_1851233962345261_3644710619455498931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z-F0EeSE6oQ7kNvwFVqbyD&_nc_oc=Adn7TAqHbymb2UKbhY-SkEI15o6Z_Wz9RiaDck0UoyyIx7wf_rbPpfh-Hvba8rgJuHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_Z3IomjNFpjpzutHsBo1Ero-jeiSiEIJYZypnDy0t6A&oe=69A050AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hellfire Rampage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1741185720, "lastRevision": {"nodes": [{"id": "9509681595747624", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9509681562414294", "is_first_party": false, "enables_in_
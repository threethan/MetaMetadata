id=6e7a0a&_nc_ohc=YJd7CEwyCJQQ7kNvwHVlgxa&_nc_oc=AdoWT-CCCf5KwaaU8j3JUUEzKhS01baEy1xl2UeSAX402sh89tjLZG8hJJD4KsQCyng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3XbQPtJjjSAw1b5xQKdYIYEmna3Cck8Azz9ExKWqE6bQ&oe=69F1E9A9"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WODyvLh2oDEQ7kNvwFREUWb&_nc_oc=Adqlm9RLOtXa6rxWiWc5JjFHzY0brz701iS87wwwsDm6UVLgQzMBM7ft0g5Jc36dc50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0x36S2etsEuvyU_fur4I4vEIJmsAVGVBhsV2uIUqw4bw&oe=69F20080"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yi4sDcQ-WsQ7kNvwF47L5C&_nc_oc=AdrlIm1qwSlQgHhO4I4RmaVvjw85W2h6jvsUxhw8ln5JTWThQW2aMXOLD366h_qOGVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1sntBHEOr20AHVtOODztMkYyyLp7Pk3RXMuCl4sL4e8g&oe=69F219E4"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l6PIPGmIz4Q7kNvwHuiIt4&_nc_oc=AdrgVwIPKJ_5oKgH9sJ51by1L_gluzrfkvu7uqsRVoEh-7AVZ6sKzkgSPL2ekEWDfEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0yE3eINqvc2ADU0713Fi8z-SSmXJA60SsNX_zz35gG3w&oe=69F2056A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLm9HP2R000Q7kNvwGnRx38&_nc_oc=Ado2peteJFvdGnznjSFVSBNUMqcTxOLizSrKeKJwAhMbMAEa7MeN4SyuOTqit8i0oeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jvmZAxQN_JNr49zxNPTfv6Vpm345-8odUp12jwSxicw&oe=69F21778"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_
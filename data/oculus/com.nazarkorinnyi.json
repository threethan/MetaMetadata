2791841535994_6381591123241693989_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY6BI1rjZMQQ7kNvwHw4d5u&_nc_oc=AdqXJC7ylAK39F4t_oRZAQ_XY7luyRtHcW7XHFQHigiJwUD49KVwaJdQsCoZjSKBcgE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7DzRAp-v6kNxjFCDwaAYHy3PHCoM73CCOkXi32nx3uw&oe=6A9AE1E9"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R6M8u-wgvoQ7kNvwFJSU_5&_nc_oc=Adqr7PPDLaLQPVbc9RE_bxg6zPvgvlllugEcjro470u5cKJXQ2TzThd-GoWh7mk7OGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL2l4HJzxg47q6VhKxegrgUDi2071bUigdre_9-yAYqQ&oe=6A9AC080"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejlc_HaFcyQQ7kNvwHC_R7b&_nc_oc=Adr661eSYRwLfUhIZ98ieAp39pvhW_MbTg9W3LSK2PT0Z4Nn-PT2fKUpgoVCjhvgH1Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2igT1gl7YxaBOTuCG3NgpQQ8pf0kp7xJD-5D5PkQTlQ&oe=6A9AD9E4"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAexYZLkyf0Q7kNvwHvF7L0&_nc_oc=AdpDAUqLxP8rUo0e5Rc5WQtTepG8go0hQDRuYAnQz-rJvM8NzY4gGb-RZN9ElbAdXA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQdkQYmAbFixO8WjGCjGzmnOLcwOE_hUJ82KzLnQCD3Q&oe=6A9AC56A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7osGV0KCIEAQ7kNvwFpbBYy&_nc_oc=Adr8SZoKnp-djAYMo26fizUuo2DZY_eMc8U8Cgd9IGUv3a8x0wtt3PwGR7byGzJY9S0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInrlbn0SVikWNU_KxeoB6CANLS2RBFBChMyi8noVSr4A&oe=6A9AD778"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nazar Korinnyi", "support_website_url": "https://sites.google.com/view/hellfire-rampage/contact", "website_url": "https://sites.google.com/view/hellfire-rampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9541893689193081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392069_1851233962345261_3644710619455498931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3umD6BPIFzMQ7kNvwEFQYdK&_nc_oc=AdpJ4YvQ8GwA1IDBgvBdo377BEFRXLXjiaNSJdzNPZHsf_S3izmdW1YyzNWqInqJWM8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAykzr1zfzlVyCSgaEhYx2VOnrpPYQldDHRV6Hu1HLKA&oe=6A9ACDAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hellfire Rampage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1741185720, "lastRevision": {"nodes": [{"id": "9509681595747624", "releas
9_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49RLhuAHb6MQ7kNvwFWTOax&_nc_oc=Adp08ymM4cs1kRG8NaEdTK5beF0TujCvilK6yNszuLAswr8ELPxtj7LMtTi50RJGYyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxu6mLhzG5WIKXvnvwFUsLPwi_r0EfSnmJNn2YRQCp7kw&oe=69C12229"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PckoYxLA1c8Q7kNvwHKTIo4&_nc_oc=AdrkahGQGQWGyrraMJATP4x05bYlJDVVU6xTGQHtzALPQtmk278F48d2dHf9LxxiqqU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFefinDtgd-JeMF2O_FSinUhCObPIYj-4jsP8Ji0Tnzw&oe=69C13900"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmoyEhlYCfkQ7kNvwFtGKpB&_nc_oc=Adp-ElR9aTA-b9AM3DOp-wjjKY2b-BA2VnGxPbUy_1hxS13K5rm7gLnj6eQRquzhop4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQNE7YSHqgDYtTBZ8SF6pR8f6JDyyp5gO1XsnDDBYmeg&oe=69C15264"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fLORG1kD6UQ7kNvwF4w2mv&_nc_oc=AdrSMykafWoHUfOo9oNVhUR7XmSlss4BKliOwl7TdCKQ1kssxhkPtuVMq4QUbdJU2Pg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbrGda9n-jWB0LmeItI8dyNWXdVlITfPSagyvxU_5qeg&oe=69C13DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk6TTyEcJXsQ7kNvwEujIuI&_nc_oc=Ado9Ce1XqiE4Wc-GC_TAqamDvhs5AAFZGrxjviWbHWJUzIphifQbJ99FOG7YYCB-NTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRJQKmBotRZ7flcbVCde3k8lpy0dtfj0zMVOQUqyyEbg&oe=69C14FF8"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://si
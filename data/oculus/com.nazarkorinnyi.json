9_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoqheRfKJ20Q7kNvwHezsfq&_nc_oc=AdklClochSv_hm9ddCVv3yYa5jt0VlG4dOTtd92nvNuDbLFh9bDCg2np7K4c5JbNn7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl0gZobgHzG-nqllcWUaNvUBadXKTG0wre5mmfDbXCvQ&oe=69AD5BA9"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gccI6UbS-EIQ7kNvwEd3nzW&_nc_oc=AdkUhqv41iAVlcyFmv1lKQAxJht8i3D97IraPJVLikXWm-9kffXo29GAvj8Jlib0wz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3R_7PNxIuKsSiycFDMgj7vf4mBf6IE5YFi0qGALfMCw&oe=69AD7280"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHhRM6_MCFgQ7kNvwHFreAh&_nc_oc=AdmUvaXuHDoEp8P4uv6A9mGkWV707lJ601RfV-nyXl0fQxf1cE9R6n9RWio25XSFVwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD2P3SwOP3PAbVBi15pcgSn_5pMvi8GiqDeAlZoJ5Wwg&oe=69AD53A4"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvIfoLP9X4IQ7kNvwFJ0F82&_nc_oc=AdneQfOIVf2i_OcUIPQrCO62qAkXcLZtmsmQ9cFEPSK1Z4yO2YVKq_JQr01ioVAnT3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKqgr8aOduHjW48KMqXMCbojseISNCZmqVJTXqWoaBZg&oe=69AD776A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUHF5tlbiCUQ7kNvwHpJCqT&_nc_oc=Adl7fmj8F0vPE5O5Q6viksyDzm3dDlEtvEgYC7tkNkkMHXU3L727wA8F1z5br1OFMIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIRgWeRrrlD86dRKC3raWyCA2CGcGy8DS-fdWFSzJZCA&oe=69AD5138"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nazar Korinnyi", "support_website_url": "https://sites.google.com/view/hellfire-rampage/contact", "website_url": "https://sites.google.com/view/hellfire-rampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9541893689193081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392069_1851233962345261_3644710619455498931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2wduAXN74QQ7kNvwEVrTwV&_nc_oc=AdlcvRmZt43T09JplgJHbrtEx1VMbStnZf-VZCG7sX3dCCk7sDDUFxzm_w_l_sxwr3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfpAHpENJaOKp2VTR8R7sVeVKil7EThAP8XqbVAk96jw&oe=69AD7FAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hellfire Rampage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1741185720, "lastRevision": {"nodes": [{"id": "9509681595747624", "release_type": "SCHEDULED", "administration_status": "APPROVED
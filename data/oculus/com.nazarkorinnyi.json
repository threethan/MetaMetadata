9_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kilmXVINmFUQ7kNvwH80iwO&_nc_oc=AdkKlMZwE_Zy3pnkOyodedJIN_NIiZJB8oosyDm20jpZeT6zQHA8igT-dGyx3M98MFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfubND9d01xyCSrqkHfrmQtoucA1iw4iquqeYpAslfntGw&oe=69A815A9"}, {"file_name": "1.png", "id": "650141244188879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391716_650141250855545_8040660470448703299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JA9Y-qfkv8gQ7kNvwGIWnTG&_nc_oc=AdkzIC6JQM2HfzkS9-Edc7SpSz5oLL9smeSb8kdXbVIxJTqQl2eYPqFJstGweNKAqQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7PlC19z5eqXGnFizuCW6l3FH__o7gi_V4ZxFRh2OnwA&oe=69A82C80"}, {"file_name": "2.png", "id": "659135163455703", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393463_659135170122369_7227157406125140691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i39g_3pZwQAQ7kNvwHNWkGj&_nc_oc=Adl3IQiKhtE0VdjrYc7SutIleanYvpAdLY1n_b1EsLfxMVdeJiXRu-mHTKPLpevUwEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQmKMy3ZkHjLPWatzWVuG81bet57_r689FbqNGMYEZtw&oe=69A80DA4"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7undl5yRrwQ7kNvwH5EfOe&_nc_oc=AdkirWlh6rekoP0TTWgqfHS6Oz33b5v6UoSTeQ-pbdBjIWaRrF-uEejQXQdUNVw9w00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7WtNjKZrFHdk2oC-XRPavHS1qnjoa5gCrnY7iboMrNg&oe=69A8316A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUzKMBGsp5EQ7kNvwFWU4p6&_nc_oc=AdmR4Jh_-zN8CfJ87L__xXkCVgvhc7lujPv5uII_yhazwKWXVyeZdGsewiRN_hmiwLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvW8sJe9GoUbk4y4U6wMjGM0kTOtCyOr2L227O-2Xt7DQ&oe=69A80B38"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nazar Korinnyi", "support_website_url": "https://sites.google.com/view/hellfire-rampage/contact", "website_url": "https://sites.google.com/view/hellfire-rampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9541893689193081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392069_1851233962345261_3644710619455498931_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKH-yR7HBFYQ7kNvwEdq49S&_nc_oc=Adms975dH5LfW5s3Oty2dm1AvTTxxCoelKGzbszOfq_OUs-Huyfb8ReWNpEjX01KM20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1NZ43mAvFC-6Wc02JIZuKUX4vwow75or-HWuIFSm83w&oe=69A839AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hellfire Rampage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1741185720, "lastRevision": {"nodes": [{"id": "9509681595747624", "release_type": "SCHEDULED", "administration_status": "APPROVED
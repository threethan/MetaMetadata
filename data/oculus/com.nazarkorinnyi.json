&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV2iK96unOZ7MCW1g_TjbOlYQMUEhJACwPDLPYSjNrEA&oe=6B048A24"}, {"file_name": "5.png", "id": "1303847337568193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1303847340901526_2938449234628070226_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtY3xtOpKwsQ7kNvwGTVJ_n&_nc_oc=AdrzNZry4MkZxbQlUn9BzjCb2GdjeHgiX4jKmfxTfKeWQGMGjasBOcPHA6fHlg4i_go&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHO-T-8xFdwx091qqIri-mea_0uMOedWgna5499VW-4g&oe=6B0475AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterVideoTriler.png", "id": "2298977923791758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_2298977927125091_343536883905062208_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3EWZDtTp-UQ7kNvwFgrPuU&_nc_oc=AdoGjMHuavKiHStbFYN8srISP8XYoIRtdu7wtYSa3--6Fra8unGrUDtBH-GJlX1ejwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxESk-fgBevrw6l41vFCAOU05VfNdK7rGA_54gywx8zw&oe=6B0487B8"}, "display_name": "Hellfire Rampage", "keywords": ["Fighting", "shooter", "Action", "demons", "combat"], "long_description": "HELLFIRE RAMPAGE VR is an action-based combat game that blends shooting and melee fighting mechanics.\n\nYou are a genius portal inventor who has detected an abnormal signal from another world.\nAfter investigating, you discover that hellish creatures are collecting magical crystal essences and preparing to invade the HUMANITY\n\n-> YOUR MISSION IS TO STOP THEIR INVASION AND COLLECT THE CRYSTALS !\n\nUse your ability to slow time and take on powerful enemies in intense battles.\n[BULLET TIME + DASH] is a toxic combination for tactical movements and survival.\n\n-> REFLECT BULLETS BACK BY RICOCHET WITH ANY WEAPON\n\nCombine a magic wand with a talisman or a shotgun with a sickle.\nLaunch fireballs, swing a lightsaber, throw shurikens, or even play a demonic kalimba.\nThe arsenal is packed with epic gear, from chainsaws to crossbows and beyond!\nGet ready to test around 30+ non-trivial guns!\n\n\nFace dangerous hordes and destroy their source.\nPrepare to meet skeletons, imps, demons, hellhounds and mad ravens,\nundead summon kings, skull queens, giant devils, toxic moths and others...\n\n-> HELL CREATURES WILL NOT LET YOU TO GET BORED!\n\nThe most thrilling and intense fights are waiting for you.\n\nAround 70+ challenges from different mysterious locations\n\n-> GET READY TO SWEAT IN MORTAL CHALLENGES\n\n\ud83c\udfc6 Are you brave enough to challenge the HELL?", "short_description": "Hellfire Rampage VR - true and hot battle against hordes of demons!\n\n- Find magical essences to boost your power.\n- Use slow-motion and dash jumps to destroy enemies.\n- Try over 30 epic and unique weapons.\n- Face terrifying hellish creatures with their own combat mechanics.\n\nYou are humanity\u2019s last hope - defeat the undead army and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hellfire-rampage/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nazar Korinnyi", "support_website_url": "https://sites.google.com/view/hellfire-rampage/contact", "website_url": "https://sites.google.com/view/hellfire-rampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking
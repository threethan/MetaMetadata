://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_1442992540016363_6471058980423298503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYNmZwPytksQ7kNvwFjJmjf&_nc_oc=AdpEnzd7CqTterRmyQFWbHFeePrQDlbuj3yQRMhzr5Zuozh80vqzqZi7RDagSCNiUnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3EkWJe0qrWiw-oXiUpe_hSfAoYkuwNRzEZJfN5IMU-A&oe=6AA2B93B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UVVT6H2-mYQ7kNvwHbfzHj&_nc_oc=Adpcb7GwmKmRHKKKOQF4oj9W0Pxr09Q5YjMeP0cEn2aoCsHqNEMzNyWG3K1MPdXh0tM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcRiakXxyHY-rRZ-OjwQtX1dS4DlcBlsmap_6ZNOjsBQ&oe=6AA2B01B"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n# - Collect delivery from the restaurant or store and deliver it to the customer by hand\n{540510922084383}\n# - Enter/exit from the bike using the Right Thumbstick down and roam around the city and collect and deliver the bag.\n{1052017513498461}\n# - You change the POV from Third person to VR Basic to Extreme VR Controller and various customizations and settings\n{1863864004360704}\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.\n\n\n\n", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25740415172249820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392170_1913998082737733_3903395021308709436_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCIokz5PiMQ7kNvwF5JoEI&_nc_oc=AdqAEXmawmFX82Qe_metV-4jzRPirm6gmiBYZuyEe3yUKwb8G1rnP8HF-HUuLZlr2pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH2OUIAmYli3Jcf9yHGa6w7od9j6xUotVhClrS3hTI7Q&oe=6AA2A4AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Food Delivery Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1744822800, "lastRevision
d5-3.oculuscdn.com/v/t64.5771-25/473391991_1442992540016363_6471058980423298503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3IIctVCpCoQ7kNvwHe2zmA&_nc_oc=AdoTwUxXIyTdAuexk_hT_wUMlgj6IWCQz0EoTBG1Q67BfwKmURRdEbmT_Nvtwt05r5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DEoqohK0YublFh8ymdOALrucrbU64wqrFlJE26juRMA&oe=6A47C1BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Zyi5_RkcoQ7kNvwHF5PXZ&_nc_oc=AdquRD_h0LzB9wWcTCvJMz65dCzX0cVLsAy7CtSKAHUI3w30mebQnJDzpb_CYdzlKP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nRGcMgeSdYRAYk0vrkfCG70Ig6RjibvSNuAfjXjD-eg&oe=6A47B89B"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n{962421746051293}\n\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimi
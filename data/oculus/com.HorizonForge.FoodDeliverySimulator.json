deo_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmZy-9WGZkMQ7kNvwHOn4U_&_nc_oc=AdlsqM7nuxG9kA58ceXX8XJXHauzE_2eOPt1BDiEehCpXFscjY19dBCzeopxogotvt8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwua2qYLK_gxKmrEffte19obvwwY78-MlreVhroXYgttw&oe=69BD4B1B"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n{962421746051293}\n\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/fooddeliverysimulator-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
ohc=401jvnuuQPwQ7kNvwEBQFyB&_nc_oc=Ado97B_l8zRBWNHvfYEj0GLtD58aALWfu0VOMynKNMtZnTJEG5-6il4gI3zBaysD1bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uUybvZF4LSLRyRf3DSR_IO7oK4q532ANBLhhK30ByOw&oe=6A257ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw_WmmNJflQQ7kNvwEItzL_&_nc_oc=AdpIeMN-iDZOJLUmexT_mI3Iz4x1CVCYmVaOP6dkxbh-cdRSg8yK4qIcroDvEWQZK14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1xBc4ArBfIfvWtgC7bDPscsf-mEsaSsimqgzwG-fEWg&oe=6A25719B"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n{962421746051293}\n\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/fooddeliverysimulator-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge L
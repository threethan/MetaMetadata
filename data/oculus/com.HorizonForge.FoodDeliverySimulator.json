ZAy0oebHfXG-M1IaLBZANUUcz1A&oe=6AF5F20F"}, {"file_name": "scrn_1.png", "id": "1442992536683030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391991_1442992540016363_6471058980423298503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tJrYk-ZwewQ7kNvwEtWC9D&_nc_oc=Adq8tw2NBNmh9vsdUq_OebArx1Qb3iQAIAhpT3MfnMkaH6O5yhvYIqSJLeWEdT-poMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqdDgZGJL0wX4i8sHw70gPHn6N-6CxWuGIUkddwtAl_w&oe=6AF5C7BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXMSlcu2SToQ7kNvwG3pqyP&_nc_oc=AdpOJYtDQLXpBTS0Xq9ph3GhtvFWV8-R_UigL0_n_S-ITaM8uGazkVJv8y2RuRJ5xGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJNI1P8K3BzsbpmeREKlxoyz5MU7tuQG7oM6ysEX4nLA&oe=6AF5F6DB"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n{962421746051293}\n\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimited.com/fooddeliverysimulator-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Horizon Forge Limited", "support_website_url": null, "website_url": "https://horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549013505149911"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2636896716824420"}, {"status": "PUBLISHED", "id": "1102382516073821"}, {"status": "PUBLISHED", "id": "1004784622586699"}, {"status": "PUBLISHED", "id": "1634299260967217"}, {"status": "PUBLISHED", "id": "2623829398014864"}, {"status": "PUBLISHED", "id": "865420873257330"}, {"status": "PUBLISHED", "id": "837797582686538"}, {"status": "PUBLISHED", "id": "1249377126663628"}, {"status": "PUBLISHED", "id": "1226516598902654"}, {"status": "PUBLISHED", "id": "2332216097215010"}, {"status": "PUBLISHED", "id": "1793444368715564"}, {"status": "PUBLISHED", "id": "666610025833877"}, {"status": "PUBLISHED", "id": "1270309048082923"}, {"status": "PUBLISHED", "id": "1964539544081652"}, {"status": "PUBLISHED", "id": "700421565750880"}, {"status": "PUBLISHED", "id": "1662354954649018"}, {"status": "PUBLISHED", "id": "964029062433981"}]}, "baseline_offer": {"id": "700421565750880"}, "is_approved": true, "firstOffer": {"no
l3-3.oculuscdn.com/v/t64.5771-25/473391991_1442992540016363_6471058980423298503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTs9kU6bFasQ7kNvwGSWY0C&_nc_oc=AdrL-mc9gyolijgI8PKi27ugDmdT0fZQ8FGxmeIVFEzo0U5FZ-V6NM0GlFCHXjj1Ppo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_ZsrdQsYBvuAv-5zf7FWkNYCC5asas81MAL4mGsJAEA&oe=6A3006BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrnsht_.png", "id": "668829052326646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392132_668829055659979_4272894858137170391_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhaS8rU51VsQ7kNvwEb6q4L&_nc_oc=AdqSBKq7vQgi1YEvzppfN8Thv3jNQn5WMVrHp4FjGRq-c1xu3-cX1ErnvO-dlrAzxH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WQCKU99E0f1ncbR4_Sou-B61hWK67HZMJ-1n4zPhicA&oe=6A2FFD9B"}, "display_name": "Food Delivery Simulator", "keywords": ["food", "delivery", "simulator", "racing", "bike"], "long_description": "# Hop onto your motorcycle and take on the role of a food delivery rider\n\n- Deliver food to happy customers and enjoy the journey\n- Climb the global leaderboard or simply relax and explore\n- Use your tablet for seamless navigation and order details\n- Explore a vibrant city at your own pace on a trusty motorcycle\n\n{962421746051293}\n\nUse your tablet for navigation and order details, and deliver food at your own pace. Compete on the global leaderboard or simply explore the charming cityscape, there\u2019s no rush, just the satisfaction of a job well done. Food Delivery Simulator offers a soothing and engaging experience for those seeking a cozy escape in VR.", "short_description": "You'll play the role of a food delivery rider in a busy city. Navigate on your tablet, zip around on your motorbike and climb the global leaderboard by completing orders quickly and precisely & enjoy the simple pleasures of a cozy delivery life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonforgelimi
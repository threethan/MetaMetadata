dn.com/v/t64.5771-25/499298248_1290211423136064_8966647072129897427_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDTsnltr4FwQ7kNvwEfHveO&_nc_oc=AdokqBpdY7ypJnYhhnOqHaC4Qlz4Nqvr2I0k9WOY-ol2Q4ghLQA_bkBxuJbLtiRZdW0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcsY8kuaOGljZC1b5PWDL9IWzSiK0I3ASulDhlhRsd5Q&oe=6AC4F84C"}, {"file_name": "2-marketplace.png", "id": "3099711750228419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302344_3099711753561752_8842050857664202754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5uf3vchPiEQ7kNvwGMXIdm&_nc_oc=Adpv3ZBxnlDTLKdlOQ-zhpTLI2ObxacxhantXEpRDPhOhqpPT9o5OlcnIawf0OBToKw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPING8fxZHAR3fY7m9w9B8C5iZCF7KhCPZelb1THz7Jzg&oe=6AC5289E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1063442436679206", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299745_1063442440012539_3956759715982324678_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q4033xCTd0Q7kNvwFKo7cJ&_nc_oc=AdpEwApcGtFNadecgNqalr4ErfzqkSjOCJvnF5ee_oWZXHERSZfUtmoRPHJuXPzvu3I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdlF-483zv-mXAP4Oi54f9t-hX34AttN6_E_JIpTlVdQ&oe=6AC515E4"}, "display_name": "Eclipse Direct", "keywords": ["music", "streaming", "indie", "creators", "artists"], "long_description": "Eclipse Direct is the direct-to-fan music platform. Discover independent artists, follow the creators you love, and stream their releases in a 2D panel anywhere in Horizon.\n\n- Discover trending creators and new releases\n- Stream free tracks and everything in your Library\n- Follow artists to see their posts, videos and updates\n- Chat with AI versions of artists\n- Browse the marketplace of music, merch and tickets\n\nYour Library syncs across devices: anything you own in the Eclipse Direct mobile app or on the web plays here. Purchases are made in the mobile app or on the web. A free Eclipse Direct account is required to listen.", "short_description": "Stream independent artists, follow the creators you love and listen to the music you own \u2014 anywhere in Horizon. Discover trending creators and new releases, chat with AI versions of artists, and browse the marketplace of music, merch and tickets. Anything you own in the Eclipse Direct mobile app or on the web plays here. A free Eclipse Direct account is required to listen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eclipsedirect.app/privacy", "developer_terms_of_service_url": "https://eclipsedirect.app/terms", "publisher_name": "Eclipse Direct", "support_website_url": "https://eclipsedirect.app/support", "website_url": "https://eclipsedirect.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366615866527187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303707_28173252912357361_4334482247127041112_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22eUCcrgWH8Q7kNvwFZADn6&_nc_oc=AdogEibxpscJWxLuSOIPXuKUgWkbmGxwAJnNF3NOKKfrq-qvi0zVw_DvgUedKNV3a0U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDGEucxDdyzTBT59cMp_q8vfSPs-032DFGGJJV5QLoMQ&oe=6AC5062B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fal
, "long_description": "Eclipse Direct is the direct-to-fan music platform. Discover independent artists, follow the creators you love, and stream their releases in a 2D panel anywhere in Horizon.\n\n- Discover trending creators and new releases\n- Stream free tracks and everything in your Library\n- Follow artists to see their posts, videos and updates\n- Chat with AI versions of artists\n- Browse the marketplace of music, merch and tickets\n\nYour Library syncs across devices: anything you own in the Eclipse Direct mobile app or on the web plays here. Purchases are made in the mobile app or on the web. A free Eclipse Direct account is required to listen.", "short_description": "Stream independent artists, follow the creators you love and listen to the music you own \u2014 anywhere in Horizon. Discover trending creators and new releases, chat with AI versions of artists, and browse the marketplace of music, merch and tickets. Anything you own in the Eclipse Direct mobile app or on the web plays here. A free Eclipse Direct account is required to listen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eclipsedirect.app/privacy", "developer_terms_of_service_url": "https://eclipsedirect.app/terms", "publisher_name": "Eclipse Direct", "support_website_url": "https://eclipsedirect.app/support", "website_url": "https://eclipsedirect.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_
xs9D0QHpXIdYsROcV9f_XP_hBZnV7c3XEMVYYwwU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPedWtmiJoPhf9_Mx9xjrCQYf0QII5kzFXUni6CJ_hMjQ&oe=6AE0C294"}, {"file_name": "screen2.png", "id": "2830771743959969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_2830771747293302_874843514912277862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em299OLjZPMQ7kNvwHkoGuj&_nc_oc=AdqLUHab8sgHO_ePhS_88wPsA2VT7PwJZ89vJwSnTVPJK3v_n7WelQWFDvcNxib3Ffw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO91t5gOByeJ8v_zH7ys4P2tF3AsfFa5rScMs5YekqL9A&oe=6AE0A542"}, {"file_name": "screen1.png", "id": "2332027624231458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298587_2332027627564791_5227356769521676192_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcJMQOx2jrAQ7kNvwHigxtt&_nc_oc=Adr9XfKjvEf3wnS791TmwPPS1mL955QHRNPsGH4ox2FaBo6SWtw5tJKXslcIGJ7WRak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXwZ6WXWf4dOvi4EKhFv7gPHJmTVTpkf1o5rKK7ZvfcQ&oe=6AE0ADB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "game-logo-no-flame-4096-enhanced-trailer.png", "id": "980411098281475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_980411101614808_6334369493184119110_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0Q3mZaGlYsQ7kNvwHa-OOZ&_nc_oc=Adq6NHio40o0i3zcGFii0VP4qE7JRiuxODfcYU_2K32RSyf09qsul6BXZS0RKlh-sPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmMYDB4l8pVqIbBrFPA6HZqytBfGSkWLDU782SvWtKkg&oe=6AE0C55C"}, "display_name": "Interstitial Traveler", "keywords": ["Battle", "Multiplayer", "SciFi", "Space", "PvP"], "long_description": "# Welcome to Interstitial Traveler!\n\nHumanity has asked many great questions. \"Is there life beyond Earth? What is the meaning of existence? Are we alone in the universe?\"\n\nWrong. The greatest question is: \"what would it be like to launch cannonballs at your friends... in space?\"\n\nWe finally have an answer. You're welcome.\n\nInterstitial Traveler is a 2-player (or solo, we don't judge) space combat game where strategy, chaos, and mild psychological damage collide. Choose your mode:\n\n- 2-Player Elimination \u2014 Mine resources, build your arsenal, and systematically destroy your friendship.\n- Turn-Based Combat \u2014 Think carefully. Plan your next move. Or don't, and suffer the consequences. Your call.\n\nAnd oh, the weapons. With 30+ ways to ruin someone's day, you can send a UFO to harass your enemies, drop a supernova on their head, or if it's been that kind of week, just gift them a nuke. So thoughtful....\n\nBut you're not just blowing things up. Defense matters too. Throw up a bouncy wall. Hide behind a diamond wall. Let a wind wall mess with everyone's plans equally. Slap on a personal shield and feel smug about it. \n\nFight dirty. Fight smart. Just fight.\n\nOh, and somewhere in the depths of the galaxy, our narrator is slowly losing his mind. Will he be okay?\n\nProbably not. But that's not on you \u2014 that's on Wally, his alien overlord.\n\n(Wally has no comment at this time.)\n\n", "short_description": "Launch cannonballs, umbrellas, bees, and the occasional atomic at your friends, or enemies, we don't judge. Interstitial Traveler is a 2-player (single player supported as well) space combat game with 30+ weapons, bouncy walls, personal shields, and a narrator slowly losing his mind.\n\nStrategy meets chaos. An alien named Wally is likely to blame."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interstitialtraveler.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wynand Studios", "support_website_url": null, "website_url": "https://www.interstitialtraveler.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}]
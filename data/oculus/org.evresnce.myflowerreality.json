cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2MLH-LB-ygQ7kNvwG3eKXu&_nc_oc=Adqqy2Gx99zZ0xD8SePvWtIs5Ulqxx06WGe50OzQCtluIz2WC-XY3JbmJoHZp-KMeBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuzQP_2yFIWLHtHlg-yd78hVB3BQswxvRKZNWePYBd-Q&oe=6AEF3395"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6jZ3aOKUBwQ7kNvwF1CrGf&_nc_oc=AdrK26q8UYtNJKk7sxB8jsI-u2g7S_ZpTXONxmELPc3ZY7Hr5XJ9ZYqo_zzZMvZ4hbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCOarYKdtMIAZFJJjrpxF-jj1RtrwL_SUvAqR_7XLWwA&oe=6AEF5A11"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7HRWtVIGOIQ7kNvwEbbAPZ&_nc_oc=Adp2Fcv6PCqTcO755jsqcbI2sNwd0lYA4ZOffqM7XrMikpwO3a8x6qHodYw9hufG1h4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe3
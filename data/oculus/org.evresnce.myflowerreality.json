cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8UonNSWph8Q7kNvwH0XLGs&_nc_oc=Adrn0v5912yE0hCemnMTvrRjLxOuUWc5DzhNtVI9NeSCdIJRaxFuMwcEM8y9c8FF6VU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBCSHTxrXgCh5R1OqNF__izheNcmBTZUhNpCkJED5HEQ&oe=6A803D55"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o29uGVJcf-kQ7kNvwF54kOe&_nc_oc=AdpLxyeAAcej3Q2Zzo0Pn5voFmoq58v5fQ4k3Q72_tLpK0mKWQNgBtpHDJqibWev4sw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn_FHWBML_wGgvPa1Qyh2vx_GpKU95Gemb55e56JdhYg&oe=6A8063D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jcekge7c9oQ7kNvwFNdqmh&_nc_oc=AdqTI7VbuQx5Z9pggPap85AjWFPMNen5vuVRc9bzq8m3n8HaPUEPo5H6zKbEu_PDpHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV8
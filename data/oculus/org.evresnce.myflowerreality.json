cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phrqDDg6nfUQ7kNvwEZjq4L&_nc_oc=Adr50A9IklsP_4ED70hODCdN0A8HKjKPrUh-0127hQYwlIwRNjCh8ywv0PHSqST7Arc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa4GaQHVAGSI-0djK9cwBcDxE15wV-OGdegJkVdWCoIQ&oe=6ABA7795"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uEf2x10jVwQ7kNvwGJoeFD&_nc_oc=AdoX-3ttmD8NbbgRG_vgLEveA0LUyo2P96gorpCxOhMzuMex9m1LQrmgDJ0qztMsdyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeUeuxj_1KHtydYGJxuzQRO10CGrbCIZaNARdlTgNUAA&oe=6ABA65D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ysHR5jxtyQQ7kNvwHGPk_6&_nc_oc=AdqS_WaYiIT9m15cBF3JF1gQY1FXoDIbqjolmiRcYNETvkJe2-i_VNCowNhPfEHgiGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyj
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By4QkL4v1KUQ7kNvwGNZXG3&_nc_oc=AdrhJCbzoBfva1UjLxWG5k7OCTst5JIbPc_e_LTpjvO_5zI_JCBEo64_RBMEArU2IUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6q0Xt0Dw4mz8T413e4VVzVwGkC7Ha0HhiRcF1OD6IVA&oe=6AEB3F15"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_pA7WVV_TkQ7kNvwHl36FJ&_nc_oc=Adrqu8klieAP7nVb5NOsrsJ_3APIpgBakink5-Mn-QPK14A5p5ThXsGydTh91Sw5LHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Ccb0IFQptS1TcwkzgNVUCl3uDPZ9T6-at_A1skcMtQ&oe=6AEB2D51"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNTMdS0FBpEQ7kNvwEwBVDj&_nc_oc=AdqKlgo1TtaWuGu0YHXK5W2y0iBdK9J0HufxljE_Ag7q6BZvMeaei0t8xZDEhGi1dAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTve
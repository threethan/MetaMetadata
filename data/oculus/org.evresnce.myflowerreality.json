cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4a21dVNh-4Q7kNvwEUc7ZA&_nc_oc=AdqX2fjCbmK3367rLpWCzBJQTL9pgEno78R1mk5vAWjtevcYZO57Tp8u1taEd38-eHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_OQ36UrN2X-Q2FjeFRavZVzixODM3_1wRhosWFjIUMQ&oe=6ADF6195"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUEQ3P9umikQ7kNvwG2ELby&_nc_oc=AdqRJcgISSVPYq2jFXvLcC9YLF4Xh12uOZ7MoC2SmzJa2heHoR9QjtNiCdXmRpNDjpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5L-oKioHPrMyBOfeqX7g4tRX31N5OrIZ203zwFU7FWQ&oe=6ADF4FD1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfJ45IhjECwQ7kNvwE037gS&_nc_oc=AdpUKpTXNkP-5U_WHf7dsWVUegg_k5W6l6_JW4bSjv4ZGE2BxTlk8h1WQPkTdi7MF28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxx
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6b4ln64oVkQ7kNvwEWnwPw&_nc_oc=AdrdFTSxc6Z3j9yWZ4wS3TS3qlnKF49L6lH-sxMR4UcitfPwjH1lo8X-SeRTJsQfQ2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_a5v1kAmeNKbNRNW6Vum950RdpzBm4XUbD8jStb11WA&oe=6A9C2515"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acjw1f1ImeYQ7kNvwHECjxD&_nc_oc=AdrXPfVDxSwHiDXxv_hxEFg4LAH2FEKr6xwC4A8Sn34z7syl5kuGhNKuUYyM5nl01Kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj3BjMd1oJ_mHk7RbVFH1d9Y1eoihrxEYsxWMJEORchA&oe=6A9C1351"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E6vsgHt2YgQ7kNvwGvWneO&_nc_oc=AdrBPWz8oVuJq-xs5illG8vwodJkl4Z5GNqxuPwkkqF_W4gFtSVSjM6sxlxAZcL7Vlw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEw
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWXEO9mCGPIQ7kNvwFgKYjy&_nc_oc=Ado3Fsd1tsnPii3WgRHbKWPsZhFYhXBw_8dEOEDV_RGU4LUOm1J59mxb-_UZk-Og0NY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLccFJeMhWcWB2tv0huMmhIcPf1gPTAUtQ1ztzCsglw3w&oe=6AA80295"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSRNY6eT9QQQ7kNvwEyS2Ao&_nc_oc=AdrQRWhcdDB3T76g2017Zmfx7hOifFDi7uTvrI3fdo5xUyD5d7lZzb3uyQ7CkHOp3Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYMAA39YSBEkKZ5veb3aVv0Gk6k_gy6XuMZuyhn_nJsA&oe=6AA7F0D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjCw8aVRtmQQ7kNvwG0O12z&_nc_oc=AdpZAo76xYz92MLkJukShiGl9TuHnEhVOD2POf302lreSPf_OeNOC1uK4yeXN-qBSXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa1
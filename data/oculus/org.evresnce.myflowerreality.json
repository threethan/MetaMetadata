cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V6U7-LagyoQ7kNvwFyURY_&_nc_oc=Adrv1AMny9KknwMAsaLzeLUqd-x12UyOPlAXpX4dUsWdDJ27P_fh_wyFRragAsW_FSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6VtCMgNQ773BgTTYmU7efUecDJ2vtrmyvI9UcLCTRJA&oe=6A5E2E95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_bX8lWft_MQ7kNvwGqU94-&_nc_oc=AdoDa3Fkj45Lgd5RuKdN1gOqLccLj_rVx1Y08TVu86yQrzP79ZzpUCBmGfiogW3zCaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVJ71L4FnmXeaP_oT9vQAJANc499JKhMfXqJJOJHLJ9A&oe=6A5E1CD1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thdvZgX-sO8Q7kNvwHt8wYm&_nc_oc=Adq0kLJR8Z0We4ZPUz90CAZco4yrRlQjQ6i3GvfLldZmKVKkbhY1FQ7YaeLDAEdyv2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_8
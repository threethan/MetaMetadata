cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZNwEmCWlkcQ7kNvwHp516-&_nc_oc=AdrXynjaB0icJRKx6GAbAHyAPpyNfgejjAm4w6JrJc1ZSBYbF3PvwtfF4lzH3tmkDCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIFYpuQO-zto7gClEwySsvaPnf9rmRnh4bGoQd0syxuQ&oe=6A7F2415"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o29uGVJcf-kQ7kNvwFtxLMJ&_nc_oc=Adpw2FXJHFRx4g-CJp344GWN18Zdc7ka6Rw6ASG9FuRCEok_3IwNqjOk060vB3J-cDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH0OcGHtRGNmC6HIM46-CZWgua6JX3hjJRmLNvMVgWDw&oe=6A7F1251"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jcekge7c9oQ7kNvwEhJU2K&_nc_oc=Adq8pAKetPD1aCF1mH5dxr-j4qDV1-9noyk9yA7rcptOlV3SbnF1x5A4CyckqRJXjBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFe
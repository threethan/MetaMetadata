69460_1134319718249557_3680214396722662276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt-YrWlQeCsQ7kNvwFaKi1w&_nc_oc=AdplLciXWUZJ-SnD1pDzeWvePqkexc5sCAnkLioK91mkfB_gTLKWxlPOMvgyJ4cLgNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvQ3o4IIXspo1K4-eC2jWYQ43ljMOEu9NpNohAnsslFA&oe=6B0455DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flowers_new_A.png", "id": "1522754232725570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_--rwhIEvoQ7kNvwEFnvew&_nc_oc=Adpx4xNqWrKUEXtAXgJzimFZEOEYuAQsCyy4yvHVl8TazKcXMibybbcxDbQkGjFQuZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnbtEw7CTzmgyLW1jR9RIZR1xJAEz3KemnRQ88W6VQcA&oe=6B0483D5"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge20mkx7efwQ7kNvwGHxDVA&_nc_oc=Adpfem8K3_CQ6Gw7yqoIZ3VOGOo_z3ClAGwWtpoWPZLA2tzw3S_9YEfIfPv6edj8exY&_nc_zt=3&_nc_ht=scont
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omGO_I8Gx4cQ7kNvwEkSCnS&_nc_oc=AdpMfChdz9S6-8Awp6kX4Fz_4R3o5L7TCrpd8HU9uq1TpozoCiLRJ7P5cwEtaT8xJ9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUOviV3yyiPIfluHUHJ7Er40F9iNgu0HirIrDvYDCMUQ&oe=6A92B255"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Kv5ZTxt-0Q7kNvwE0hQHd&_nc_oc=Adrl23I_-flcwbAe7MQ7hpziSgyTZawHGPeV5GPTDkfx3nPcqFUmKoJBCuDPs1t_9ZA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBqsIQTDShSf5DsNogNFBTadevlYUECZZLOMh8N2Lazg&oe=6A92D8D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxnDa-b6MPoQ7kNvwGUpHTq&_nc_oc=Adr-hf0lmU3-ssAF8qjTlaAlmMmwTu7S4QuvYvroaQND2jZOm-4HFLBsxrlMUy3gWDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr8
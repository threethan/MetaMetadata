cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-agdbXskhoQ7kNvwEGEInp&_nc_oc=Adp5VetcTyoQa0SeTLQNbIP2sDYl7GpGEpifSZn76XAL2kzm2yO3HquDz8NE14vU0VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCSwHsqhj4gcfLOXzG-ovg7yO-YNKy589W_IrGpVu3yA&oe=6ABD1A95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uEf2x10jVwQ7kNvwEU3C1f&_nc_oc=AdoHGekov5KJsWd20jztO2F2loXcMR4ZucRRheDDz7e5ULFFawjHSnZiwjgSh5VHI4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4g6J9YZa76RqEY5ERQBHhl8LBTFUQkAoEe_PDCnxZ2A&oe=6ABD08D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ysHR5jxtyQQ7kNvwGx3hzi&_nc_oc=AdpGS67KaTjJmkVSF7JMm0Q2xqbfa8yGgH2UaifKaaAhDL3JvPXJLfFk8Dp3vHEJ_sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIg
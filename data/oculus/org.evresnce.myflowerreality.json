cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0PT-MqyfuUQ7kNvwH2tL_z&_nc_oc=AdqZjUma6vCPjUe5noHGd1G7e8x2a-b9arDU6Czd15anSvlG_YEK3Sx3EhwxMNPpnGE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPQHK1T47WRyvBetD9J01bnMw7I_GPgwy1ShciK_hCyg&oe=6AA01995"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxROWUD-IoQ7kNvwF5OBg5&_nc_oc=AdqbdtCS4-oEaE4BFmFdCTROE-io5Hk3D0X-DUZYa7awmeMfPc3dDb-bUhE5HJrKNM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCFhqoCqZA29PIkZtBwQYFPTuHx6KxrLBp92wcWLhuCg&oe=6AA007D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AMAGHyXQ1IQ7kNvwE9zmV2&_nc_oc=Adox8sMM1yZKTFTalRzmTwOLU7rec6MTX-NAVFH41rQ7cEsnKNsvzRnGlvpF8L0s830&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfC
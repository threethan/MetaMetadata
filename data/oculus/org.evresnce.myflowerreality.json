cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5iowl8s-goQ7kNvwGzNU5d&_nc_oc=Adrx3-QMfiMqmpmMhNJ1IshYBJiQe4EcKgYJGd7aNME74-3fuIfQIvJuBInMuWxLjXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLREW3D40FEXP-_aiWf66ms8LCWcq_z4gtpTV5qRcc9wg&oe=6AB28E95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbP8nibTnZwQ7kNvwERJjFi&_nc_oc=Adq7JjB2haSVHBa-5-hNfD9R6z6WKajcHALaPgD-SxQuJnzJFZ4BbmyM3sSeOI3AVlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1_xJEPwhNxoFqbvLsAT000P5bd5sRrCyt29L9UwngUw&oe=6AB27CD1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj6yOHjOIAoQ7kNvwHOuQZV&_nc_oc=AdpDaC13WEfw0yoyI0z185WnRCbQohA16H84_vbdq6ze_QLoa32SI1DTcBOX7_Sh02w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7R
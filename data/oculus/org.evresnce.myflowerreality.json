cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCYljOs7Ho8Q7kNvwGSAqnD&_nc_oc=AdpLszR1eB5XQ2IAW-vmmih4qxiIAHS1fl_isReFvbpM5mPDnOS1hjhZLEOMz85xyQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA3HLVwQPvaYuJ77qZh7jGxityG2hGj53A0y0LKke3HA&oe=6AF71C95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4eAjT7ZE3wQ7kNvwEvnrOh&_nc_oc=AdoRbfxjCTv8ZyZ9reaxbj7iyZ0U3RSkVyGOuVybBJsRSbAvQiWbsTFVBmkPryhwjhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaTqKPmWw07cj5ft-974q69tpOP0WL5bbEzvoWwKFg8A&oe=6AF74311"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJC8M7TNTN8Q7kNvwFKe7g4&_nc_oc=AdqHF0FLIsvDEfhgNj3efYIhow02dk-Moz9Tcj7hEF-tnTOZXKGHrsmyH_cWLi1dk_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeD
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG3auNBuzdsQ7kNvwEPRWr0&_nc_oc=AdqYRg30Z0qFcEY_5Tx2tKQTdkZoWEYO3-HtcGoZh80qiXGGS_5KPWc_d1NXkYip9zY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5xNcANA1O2dPpcAdkE4CAXfasZQqVVMESdQTmb5i_Jw&oe=6A64C615"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTIW-HnLlWIQ7kNvwGLtORr&_nc_oc=AdqMjpusYSD1r-yibBVpShTImHdr0vzuupViDGSGIOKGw6pzlNkAg4e49Koph2wtXew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsk-B6cZC-umazuK-dXj9w5_G1UHqxSCmF6tY7J5a4jQ&oe=6A64B451"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfYQrMp7C5UQ7kNvwHqQgha&_nc_oc=AdoP1gvdnx2tZFfXPLb-psVTDr41T_EwxtmjvFhxKsjTnFPhk0CFBqd_x9i1U860DEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCns
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCYljOs7Ho8Q7kNvwEXAREB&_nc_oc=AdpZ0Mb86Hv9BFlJoeMj-oC2spkINdhiQM4MtWvaa6xxVAa0vzqeg0B_Q2lu5OwxNYQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKPJJ2BrLBjjCYtmIpK2ItVmJ2DbDo8MJyBmLIo4BGLQ&oe=6AF9BF95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTDGpHcfRskQ7kNvwFo2QAW&_nc_oc=AdqtE6eLtswcMdgRONRzgMlwAuDTkUjf8nmvr7wHxTj8BN9ED2iqR8vGUXuNakGulEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAl0MWMhXS_fUawL9opsM-kAZlFwnj5wvH2ZM366EgNA&oe=6AF9E611"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XVhKmbskqgQ7kNvwEV7zgT&_nc_oc=Adq3dxy_dXKmpjYoih_VafTh6FzOuyWvbze6SwoSeAbHoagl6Q59dr4O04s6nFezJMQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoC
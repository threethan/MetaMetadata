cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6b4ln64oVkQ7kNvwHRAvWI&_nc_oc=AdqjYrqfq7HufPs6n-t8d9p0jJbXb--tTVXpii3rdQ7K6o184VN-_aZmklxEH5YUyGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9k1_FctpASsS8esJVlD4FTLxM4jHpjoeF-lJSmJC9mA&oe=6A9D7695"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acjw1f1ImeYQ7kNvwEGxZWZ&_nc_oc=Adr5pP9_FiZYjAW-AuUejmCuwvAQnpNaA6qdZ3FZocvdQNeZdHZZbYnT9PPbGJUATkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8kRX8wD0z5OMKTs8FoX3p4NQN-CtPAg01py0AIHuuxQ&oe=6A9D64D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E6vsgHt2YgQ7kNvwFIlXgi&_nc_oc=AdoC4Z-KjkVzvFfSg9xMeR4CFgnBi0fn7P-YzYy_0VP6PIsvtQDKjOqZMinc4Xe6fNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9V
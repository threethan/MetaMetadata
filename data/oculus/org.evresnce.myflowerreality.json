69460_1134319718249557_3680214396722662276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeaKfYTDfDMQ7kNvwEXB1Zh&_nc_oc=AdrQC5-tHL43w7WUmJ6Ztkw_gNSoLvuHwP4U1oGxkGPBQ0-LspwQfaEmYPtgK2Sm9fY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKSbfy8pK9m6cZbs3u8TeeYJm-yICi_z83ZTowt6mZ_w&oe=6B0C771A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flowers_new_A.png", "id": "1522754232725570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9sgrqeVZUEQ7kNvwH3HPIv&_nc_oc=AdoC2wQ9J3KTWvjqL4vTz0QGx-faEQMKu-be5iRJQ56qH5VobrIJn2-LWDlMCCKLOkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQnUohuumqkNDQwRhWGWWr7G3thujobblnCAjIOsEoLQ&oe=6B0C6CD5"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuN7vV_AwiIQ7kNvwEszctp&_nc_oc=AdrYh5mPsd5xXMYhkg3vo25RHKbOzTi5LKWo2LA37rtwGMl3ItyTtfcfJGU4zn6fHfA&_nc_zt=3&_nc_ht=scont
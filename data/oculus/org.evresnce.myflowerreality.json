cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpe_oulcJQgQ7kNvwEqsEtP&_nc_oc=AdpLoeuZaGd5cOkA9UZoRe0qqglzV4uK6vZtDnjApDjn-K-EkPTUZ0SStWQKw1it8Ts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-KzucgnAu1jIgQ1I5wEbdtvvEpQZGT3JUDuPtukBmRg&oe=6A8977D5"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVaqPuZGpL4Q7kNvwG01CI_&_nc_oc=Adrh_vtuXiV0NSKI58f_pcT1vwaQI0btXK8pp0_ue5EZ-jpSmiAE8IVUdAk_g2fbOMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQovwi2fxFOM0xS_v8sUVwQsVMKd-LgZoSC4J9zyMWQw&oe=6A899E51"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHMuKEgGY_cQ7kNvwG6xEBS&_nc_oc=AdqD51zcv_qQsbvxTssbRvo1ob6s-DWT24Ax3lUuO_ct6EodbDExfyKPmznQPkIHAlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCi
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBrnag2NvFQQ7kNvwFB1XF_&_nc_oc=AdpwJA0skIrQblWnyapRtqjEqzeFfEcFVklEVxJ9z3lGjUO19vZ-T15BUpyY_PluYo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu5RtZgHEAW9h6LRq28qp_THa704LuNhsxTMZtJmZaGw&oe=6A579715"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_idUUbUTrsQ7kNvwHnogHd&_nc_oc=Adr2Gm_2fM3rEcoY6EL4BCwfxO-0uRRTL6cicKKY97371XKJ6ku6CR0skYXmbAtjKaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAydz1S1LmRenT5SjwOR9kQiWBSzKhWfxI45lXn3s9HYA&oe=6A578551"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVPbpccj2m0Q7kNvwGQHUNa&_nc_oc=AdqQIsjqfeN2W5RC5WlprqN8mnoQybtf8W3g2R938GOQpR2_0FSn2ehiY9ZO0Q049q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6x
5_286551357724006_7928019977495469041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SETWHbjmBMQ7kNvwGFDHKt&_nc_oc=AdnCje_9Y6rFPpjwlRiwWWlBm0CAT5l4_6ssovnbqfQBR0T4omHbSTQxu3xq-An3eKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlwTfezXUZLA5iQX8JTJk7RcR7EeSxg-GgrK6yjeiTZA&oe=69B14985"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyFlowerReality_Trailer_Cover.png", "id": "965112025136130", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_965112028469463_7445828599088349131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdwPrbvhqkQQ7kNvwFOiAcj&_nc_oc=AdmhfHo9mXcwHreKlPIKkxsaO4LNTr9uTLdMci_BiL8GO0tbQR-QLqYJrWOVSeTwmmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF6cQrby7ggBw6sfV7FlneN1Btmtuu8iEgBrsFT0Ieqw&oe=69B162C4"}, "display_name": "My Flower Reality", "keywords": [], "long_description": "My Flower Reality is a mixed reality app designed to immerse you in floral beauty. Escape into a realm of relaxation and create amazing flower arrangements with a variety of items.\n\nUSER INTERFACE\nAccess the entire menu by pressing on the bracelet attached to your right hand and close it anytime you want by pressing it again. \n\nADDONS\nAddons with fresh flower packs coming soon.\n\nDEVELOPEMENT UPDATES\nStay tuned for new features currently in development, including Saving, more customisation and innovative creative tools like the flower brush.", "short_description": "Create and explore floral beauty in mixed reality."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/myflowerreality-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/myflowerreality", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104
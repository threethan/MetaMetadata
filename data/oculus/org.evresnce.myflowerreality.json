5_286551357724006_7928019977495469041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFtxHg2VcrIQ7kNvwHXbYj5&_nc_oc=Adlbeto7Tl4VHYSe4cl4NE3U9BGtBByMewgr3E50WwyzyGgSm3noDLBEZfd0EG__H30&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5ACHX2rjR7YYBhhr2QsGd-Jcx4QOeNj1kSvCCQJs6gA&oe=69BD5F45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyFlowerReality_Trailer_Cover.png", "id": "965112025136130", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_965112028469463_7445828599088349131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc-RMFqYc9cQ7kNvwFM0wwj&_nc_oc=AdnAU1PLcTyYNdorEt7djZzeVTIXeOvdZD0OjGjpBHhPcS74EPhKAaig4g4hpJAa3ho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9tpODTSuL7amotnYy4I09hk0GT96UQaJZFIapasKv7w&oe=69BD4044"}, "display_name": "My Flower Reality", "keywords": [], "long_description": "My Flower Reality is a mixed reality app designed to immerse you in floral beauty. Escape into a realm of relaxation and create amazing flower arrangements with a variety of items.\n\nUSER INTERFACE\nAccess the entire menu by pressing on the bracelet attached to your right hand and close it anytime you want by pressing it again. \n\nADDONS\nAddons with fresh flower packs coming soon.\n\nDEVELOPEMENT UPDATES\nStay tuned for new features currently in development, including Saving, more customisation and innovative creative tools like the flower brush.", "short_description": "Create and explore floral beauty in mixed reality."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/myflowerreality-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/myflowerreality", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104
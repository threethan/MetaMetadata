cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By4QkL4v1KUQ7kNvwGl1qxv&_nc_oc=Adpm3uBnEMfCKqGGVHGxtmp7XnPKsjvYjh3tiX--mcw6LoUrXuZ250k-tfpAvFyltGU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWdbBTVdSNTybM1T8zI7aX_zRyArrQ2Iag19cPfKRrlg&oe=6AEC9095"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_pA7WVV_TkQ7kNvwGwISf_&_nc_oc=Adr5kgECLK1IlOgP3SLQnp_N30BwsZmcIHhhoLgo1x-UZRgs69pL4ewnpgXMQfbqBWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSkrZb9fKUJmO2bKwzvTIuVri270154PZRa_kO9W47og&oe=6AECB711"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNTMdS0FBpEQ7kNvwE6MavC&_nc_oc=AdqPFutDlUk2iJztCb5nckEDXA_Qm_9TJCBtbise8nbQGhaE6FA_2-UKms3dDtuZgQw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSx
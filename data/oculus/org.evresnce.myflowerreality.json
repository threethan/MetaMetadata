cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4a21dVNh-4Q7kNvwHxXrfm&_nc_oc=Ado5DUEo_s4QZXAs3k8Hkowpsn5lzEorWW3YysLBnWMzdzUd5Xd7ovLrPyjBDDrE8Y4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVsmVWwASkry9DjM8DDzxXcgdL6yrbzSpFKMfe3428Mw&oe=6AE20495"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukgEfdMECKkQ7kNvwGn1z-H&_nc_oc=Adq7U_nIunnuL_K4UpuWeCutR4Kspm72OYt4AFLg_leEMts0CZLS-Rp6eqHepFMgoOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkVsPUHxJMYxudJL73B1043tdSxOmlRsSNHT8JXnw0CA&oe=6AE1F2D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OluvKIWhTKIQ7kNvwFV0ozp&_nc_oc=Adr6EnWFdDAWPwCKkonEn4ubdQv7G1PsNqLxSIGDMqOgJjFF7YXcpV0DYtRQOypIBWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSG
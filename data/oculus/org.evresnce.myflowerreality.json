69460_1134319718249557_3680214396722662276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvpa8DxeHQsQ7kNvwHbJKd-&_nc_oc=Ado_YuktPihHsla9GBQsShhhGrpAPPcrYTBvWj-yoQgXvMIcArfOljpEAGSZW4n3ag0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4JP2a8w1-nKuhfrVxIOowHg7HVf-M6E1rekgZ8A5PjA&oe=6B0DC89A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flowers_new_A.png", "id": "1522754232725570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9sgrqeVZUEQ7kNvwHqWNzL&_nc_oc=AdoYhgU6WJnclAJ6iAimfOzCzT_TvZC4-2wBcV6rRqbII_MVE9HJdHaFWB-HIw0O9Ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTfDmuAB-6iv1A_c6edq6LBCp01cRMTLMXYmOFrqHJJw&oe=6B0DBE55"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxVT4PyL3yYQ7kNvwFlRE8A&_nc_oc=AdqACqIEahRbQ_YobmcJLZh3Kj2PeiKvq43i4ZvVdrX0kKj-BF06MFQF0gO54wIl9IE&_nc_zt=3&_nc_ht=scont
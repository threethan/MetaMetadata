69460_1134319718249557_3680214396722662276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pQjIt-TwYcQ7kNvwGQYhQm&_nc_oc=AdphoYwbrim3TtNY6zYfOBMx3yF5ZjpsGtXpslpv4lUWYel3PEyUMOM0_hf7Z1pAi-s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGGtAbuAbdsStdFwVtxI6sRGXiUNDu03Zr7AfC2YaR4g&oe=6B084A5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flowers_new_A.png", "id": "1522754232725570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loGzDYgPB6oQ7kNvwH0zhdG&_nc_oc=Adp1u7gSzbaVsXk4HRQUpCEeRgBXc_--R99A3umpK7PVB5qzYxM4PiGSyNsp8lO19I0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRti9jDu-UYbzc1iiJqzKlHAWGRoJbjLX9yQaf0ULSRlg&oe=6B084015"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDuLSjUfGRwQ7kNvwGuezYF&_nc_oc=AdpGxN_94feK8lJ8osI0umwZIqzycqLkOFwnTJG6sSOZ5Ub28wqIOUfVEzD3E5xms5E&_nc_zt=3&_nc_ht=scont
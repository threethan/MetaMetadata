cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_ipg2x7ecAQ7kNvwGQS1h6&_nc_oc=Adr0cOZRy6Yg0RLtT-bEnYp3nb4lboZagvvqTGVOKxfljV51DNvSpUY7iRGtVILSk24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFbP99QOAa_GH4x9avfXRs2zC_MmO5bPDA-QuMiuq0_g&oe=6AB53195"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbP8nibTnZwQ7kNvwFq-TGM&_nc_oc=Ado0qTjcqHjUQS7TjvZJItzqyyAIihLn6sI0QqGfDCCduec_GKlLPwUVao1AD1fL6CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKDwKSyRI7qEReF2mDvyVywNOhhYeva1IzlZt-1PswAg&oe=6AB51FD1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj6yOHjOIAoQ7kNvwGv4D4q&_nc_oc=Adp5OxgSFJ9j3zX8GW6r2uUFRX3pJp-ZNUSKrnQhSPM724UaieqY8bHgXKT6OvPLcZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLk
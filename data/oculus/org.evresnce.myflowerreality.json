cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2MLH-LB-ygQ7kNvwGK3tEU&_nc_oc=Adpco29sYVGQhZV3Ul7xNoRoQ1hJM24MVxtBvuQ4t5GhY_sz2p0Iyaj6CyuvRYoiKA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5k-IyDmHu_xb3S0O2I8Q9Zv_tv4zpfSy48grZ1PoZ0A&oe=6AF1D695"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QfZ4U6iQlMQ7kNvwFP1hVu&_nc_oc=AdpZkVjtuMH9i4l6m_O6dbavHe6npMhlA3rOWi2hXqEkfcbUHpxWcSOCDQQ5siMI4rE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-gKACD04MdmnT7B_EeoY16mtRU1l7d3upSBvcJGKQA&oe=6AF1FD11"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPdoE0LDhf0Q7kNvwGf2NaH&_nc_oc=AdoYE9UeL-Sr8zhkH1NVG45znzrzvGP4zHKNtYsrX8d9Xddhmm0icQev1FMI3J6nQ5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROv
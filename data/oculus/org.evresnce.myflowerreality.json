cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V6U7-LagyoQ7kNvwFaHd6b&_nc_oc=AdpfRDpZftGdY2KEte5x-6PlDzZjv_6XvCQSApgx2wxUMGSK5n0c5iLNse9ztxZ3Hjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMK3Q4Sw9WQ-KENFIGzAVcJsPWq7_t8zlFQFvUYhVrJA&oe=6A5CDD15"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_bX8lWft_MQ7kNvwFFWqTw&_nc_oc=AdojAaMy2yQBBNxXqcCkrf7ViK-TD4g2jSxxyVkQDcESYDmymLxDfvgEmY92lRwN9Pg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFEbQauTG8HR6DU_ZHHdCesqbjXJovu4VwsgNfPu_RCQ&oe=6A5CCB51"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thdvZgX-sO8Q7kNvwGH4GLG&_nc_oc=AdrPHyI4GfglXC3IOh_c8gxOWu96cs3EibFpkDLbQxHev_ussI6y3AZ9yhOHZxWeRrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVz
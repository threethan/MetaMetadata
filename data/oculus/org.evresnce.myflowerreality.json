cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf04zmYCJrMQ7kNvwGUD8jg&_nc_oc=AdoTsi-c1x2zkro4FUORVgQcOHz9YaOFrI-_9B3WNIXyt4EZI_XR9g_4hsCPbk-4W-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGhDGiaG5avelO_FAsCS_6f9Y32q7-tM3JN-riT9a_xA&oe=6A6B5D95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9lnB-kmEpwQ7kNvwFvP8i2&_nc_oc=Adpv34VakSs_gMPSj2A6YeeB6iba2FIdkdy-vfSI97j1LWDSFcAMNhQEi5umiZEOSLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhKVxl06ZnZcx-VTpquxXVHUDFoBLkwShEXz2CLJ1lOg&oe=6A6B4BD1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YWb-JU590kQ7kNvwGoIsUc&_nc_oc=AdrCJaiVTLjCpCDBEQVjINJKeeeGx3OvoKqx58FXo40KFhS_uuBVmY1NGDtRbeh9s2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Z
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf04zmYCJrMQ7kNvwHOQ1iL&_nc_oc=AdoR8xhGQTx4CBorv2ifoC_5Vf6Q_frgVgtZhlRFCPp_hBH4OQO-78Yv__v7uTtvV6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWVTRVggQQubzQGmoCcL3NMMuRQk90ahU7VlmGNwIDnA&oe=6A68BA95"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyHKT-ovn3YQ7kNvwE4QKhf&_nc_oc=AdojwvyQqw6pIETYAFJEeCwd-4qBx1tqXeVP6IkMdLalK3jlQWJsrB4vA8yHAM4zNpA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBz9d8g5H0RbvCMtZaYIKLl46uuT9_seDDaekGRraIsg&oe=6A68A8D1"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQkCzlqTYaIQ7kNvwGPDmGS&_nc_oc=AdpmquGXI7gnydNSkL2jdfc9AgZy8rY8ZX7m-Dh6uVzzlEt3s3n4AEZzOkbr2_K2W7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe6
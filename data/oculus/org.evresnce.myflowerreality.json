cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbf1T42gUi0Q7kNvwFqCF4k&_nc_oc=AdqIT0k4bfMEacVIISaJG_8FH-HWU3E4CXD2-bf6KsNODuzzpY_qN5IjzJB7dLAFIwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8MXXxqySe67527Ai9WL1_Ej0OwoAb_NfWJY4XuWYPxQ&oe=6AC26095"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTC6uqj9dUwQ7kNvwFTICEk&_nc_oc=AdpHe1NewYlKaJ8BZ_axJK97Z7Sl4CaxdP3yXi7E6zmJWdyphKvh6KQaVzU7SyzTvas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMESKl7ZtEJZln74NPvEvpk4KSssnxkIdaE7C0Mu-O0Dg&oe=6AC28711"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf6EBu0LbyUQ7kNvwGJj5rQ&_nc_oc=AdoPK4XiORNgaXGtO1BnBG8wznVg2EMhtqAbilBv4hCwebRb-ur_KujiSjTlDCKjw6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTu
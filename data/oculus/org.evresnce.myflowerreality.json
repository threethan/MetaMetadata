cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAMxWi76LE8Q7kNvwHvcLAD&_nc_oc=Ado0-Fg7tQbEQQi7CinvD-j0WZ33koPK8iioz85QReTckAzb438kXWPRBk3d6vdUteQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXH_olXN7MwhEpEtIoyW46rabxGDzB2Lk2DhmpuLQpJg&oe=6ACB9B15"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgtWhK46pjQQ7kNvwHff6Ta&_nc_oc=Adp3k2Yk6v1fUVhScLsWGc_AVx6bmlewlGZPp_gURJDHJV4qDiqKN6g7teWAoudqjtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNd1uWnsSrhadaLNtXxLjexkWWa6XxMCZXp5J8OZgB6g&oe=6ACBC191"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dFyYrsxad0Q7kNvwFlzElj&_nc_oc=AdpgdfSahxQuTMPSQQIzx80AvfTP8Kzllb0wiDKZ2XTpyFPJamdaPHqMA3jya4AliF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN43
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9X1VD0qIGQQ7kNvwGYyys2&_nc_oc=AdpZL27Q6Jw8p2FbnOmO7xQ-Z05tOwkeW_uN55AGJZ-q3HK5v8P9s7tfrSdpZnXVWCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_uBeID2UUwev35coUb301jvxMgylatwd6e2dZc12oZA&oe=6A79DE15"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2yP-xO3GcgQ7kNvwEBLvwj&_nc_oc=AdoYbhex1C18w6pCS8p2kBwlxf8t61t4O8Zd8EYNBN-E-eb6b6HBp6wP-KxHcXSOofI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEvDgH1Z5JcdunWL7FUjKcl13BW6Hmwkje9GdklaTO6g&oe=6A79CC51"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVJW1mSTzE0Q7kNvwHjr2Az&_nc_oc=AdpvAfm4EluaL4LHvI_X1LYlepNerxqchy-ln-qcR9LfNt1JgOovUvpAIFsD6ov3Bcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2-
cdn.com/v/t64.5771-25/491823905_1522754239392236_143623926378188494_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S-w-8z4K2wQ7kNvwFJ64MF&_nc_oc=AdqL3dwGLIJWlxzlNoajL8XY8vOTvgCeeRPQt0aU6rbxA32xvcZVoaXUoWT1VfXjuH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmMbQS4von-TMWVcKEpQEU9qdHoybOhk62ghAMae-7vw&oe=6AA6B115"}, "display_name": "World of Flowers", "keywords": ["flower", "simulator", "game", "flowers", "world"], "long_description": "You can live your dream to be a florist or simply enjoy a touch of colorful nature right at your fingertips.\n\nAs you create beautiful floral arrangements, you can listen to interesting facts about each flower to expand and test your knowledge. Challenge yourself to identify the different species and learn more about each flower as you interact with them. This unique feature adds a fun and educational element to the experience, combining creativity with learning.", "short_description": "A calming VR experience with real flowers replicas and pristine landscapes."}, {"images": {"nodes": [{"file_name": "MFR_Portrait_Korean (0-00-00-00).png", "id": "2736029986584544", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54770914_2736029989917877_5602742206897707747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSRNY6eT9QQQ7kNvwHnmaCA&_nc_oc=AdoxYInYHcFrlDLbiQbOtoWZT3K7K10wZdLFNkBSrUoUfIi0Wa9yjptI8r-WzWGoqbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJba5dUuPBZjb_ilQIP6B7WvT0wi-56cXOpCbUbIJRxSQ&oe=6AA69F51"}, {"file_name": "MFR_Square_Korean (0-00-00-00).png", "id": "1310692803276288", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1310692806609621_1777501217923213910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjCw8aVRtmQQ7kNvwGyWeh-&_nc_oc=AdpyKo4a-yO4_B0kgH7d73CySoh9Jiyq2y538l-2-Kn3K5pqBsD6crrx5ORDtwiPOHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiV
101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5AZkM6S9ygQ7kNvwFvf-Kj&_nc_oc=AdqFF6dY6lUludsT4sIcUOvKlKCy16yOYHDRNymonPVKKEZOfvJcwJ73qAs0VISNONs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuDo3827-4RzSncp2enPkW_ofnzg5j68VZFmz4hjT2Jg&oe=6A4BA85A"}, {"file_name": "screenshot_3.png", "id": "1917393115404691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361355_1917393118738024_1747989377535003578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH8ANC06jwoQ7kNvwFt91yL&_nc_oc=AdranR2ejjAuZh7eotdCkGZJQ77-OFDFmhRihs6ZLHg54W_dFBz2df-Kn7rQtylwhi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGMroM6KKQiTON2q5a5xxtLUEbMlGUBEYigGAMLdPUxQ&oe=6A4BD393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poster_2560x1440.png", "id": "525569860054728", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439594_525569863388061_9021439797343727162_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP6PvwGA7QAQ7kNvwGpi4Ym&_nc_oc=AdpGUKGG8_l6fu6AjLli2x6JKtdMA_QxSOKzL4wxhLIZeOVso8ebKAr9koJufGJsEYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwtbOCCHH3AdKVUMDpN_yTbC0DmlcgiZNQN06UxN2Q8A&oe=6A4BB804"}, "display_name": "Plumber", "keywords": ["puzzle", "retro", "clasic", "logic", "pipe"], "long_description": "Plumber is a captivating VR puzzle game that brings the classic pipe puzzle experience into a fully immersive 3D world. As a player, you take on the role of a skilled plumber tasked with fixing complex plumbing systems. Using intuitive VR controls, pick up, rotate, and place pipes in the correct order to restore the flow of water and complete each level.\n\nWith a variety of puzzles ranging from simple connections to intricate networks, you'll need to think critically and act quickly as the difficulty ramps up. Each level is a new challenge, requiring precision, logic, and spatial awareness to ensure all the pieces fit together just right.\n\nKey Features:\n- Immersive VR Gameplay: Use both hands to manipulate pipes and solve puzzles in a fully interactive 3D environment.\n- Challenging Levels: Test your problem-solving skills with a wide range of pipe puzzles, from beginner-friendly to advanced.\n- Interactive Environments: Experience dynamic, hands-on gameplay as you rotate, connect, and lock pipes into place.\n- Relaxing and Engaging: Perfect for casual play while offering enough depth to satisfy puzzle enthusiasts.\n\nCan you master the art of plumbing and restore the flow in time? Dive into Plumber and put your skills to the test!", "short_description": "Enter Plumber, a VR puzzle game that brings a retro favorite to life. Use both hands to grab, rotate, and connect pipes to solving classic pipe puzzles in a fully immersive 3D world. Relive the nostalgia with a modern twist as you keep the water flowing!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tan-digital.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan Digital Ltd", "support_website_url": null, "website_url": "http://www.tan-digital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26914742551502843"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "996577842749121"}, {"status": "PUBLISHED", "id": "4329262047323527"}, {"status": "PUBLISHED", "id": "873417978535231"}, {"s
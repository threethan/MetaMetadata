=7f20f&oh=00_AQSrp7HT38unxBa7HIoBFP7cgoIWAFVuSRMc1LUI3x_1bg&oe=6B031B77"}, "display_name": "Surgery Prep", "keywords": ["surgery", "medical", "simulation", "operate", "hospital"], "long_description": "Help the narwhal get ready for surgery. Accompany them from the pre-op to the operating room. Earn stars by completing activities. It\u2019s like a game. It also helps pediatric patients [10+] understand what surgery will be like to feel better about it and has been used in a hospital. A parent suggested that Surgery Prep should be available to all patients [10+]. Now it is. This is the first release with updates to follow. We welcome suggestions.", "short_description": "Help the narwhal get ready for surgery. Accompany them from the pre-op to the operating room. Earn stars by completing activities. It\u2019s like a game. It also helps pediatric patients [10+] understand what surgery will be like to feel better about it and has been used in a hospital. A parent suggested that Surgery Prep should be available to all patients [10+]. Now it is. This is the first release with updates to follow. We welcome suggestions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://before-inc.com/privacy-policy", "developer_terms_of_service_url": "https://before-inc.com/products", "publisher_name": "Before Inc", "support_website_url": null, "website_url": "https://before-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
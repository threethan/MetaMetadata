c_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwmljtdZL9gQ7kNvwH5W9hU&_nc_oc=AdrbpBjJtJ010N5-hVIESTFYGbuS26NT_2DYvIquSq7Pcd_B2eGdN1hB3wL3IAnJC3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPg2tLgRpqSEG4WbOkYKPGxmJ3nyLTUP3LoELpPp6vKg&oe=6B0DBB13"}, {"file_name": "04.png", "id": "1116865640717674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1116865644051007_8259805426657153245_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zo9hs0_79kQ7kNvwEGKSrY&_nc_oc=Adqphi_5jqZKLH9FGhJdIwvGgnd4gB3B_AO7GsZpYm2bkEU5Csxoo7nYbbZ0RADeoW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTADI4csZ2UIZ4XGKEqZAfhoXQVMs5Qr2NeXpv-wm7Ihg&oe=6B0DAC40"}, {"file_name": "02.png", "id": "1664029151779335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1664029155112668_4028850526321104676_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JmdY-PcTAIQ7kNvwFzVkW1&_nc_oc=Ado-m6vLlkPWmkLi5947p0P1mO3E8mxBicWysPLudu4P-QrHnEAGtow6LXa4iU37NEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9QRb2-VW8IJq07pZgT_vuhFPRuoBrnpcjmhJeNy1PWw&oe=6B0DC807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "People_Parade_Trailer_Cover.png", "id": "1760148125209408", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593868733_1760148128542741_6832838137075261824_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNfJo1p1nc8Q7kNvwFVM4bu&_nc_oc=Adph4gprh26jLVbiUJyKrL738NkPIKyMuSmDhSkieTO1VXQnu8xXlv82ycOGdIhsjnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRywSvAEPLLCmwqrtdDzbSxbMFeG68iGdgjiV0Sxu8Xdg&oe=6B0DAE31"}, "display_name": "People Parade: Color Sort Puzzle", "keywords": ["sorting", "people", "color", "puzzle", "tabletop"], "long_description": "# Small people. Big sorting decisions.\n\n**People Parade: Color Sort Puzzle** turns colorful crowds into a miniature tabletop VR challenge. Match people by color, choose which group moves next, and find the order that clears the puzzle.\n\n**MATCH COLORS. PLAN THE FLOW**\n\nThe next matching color may look obvious, but space is limited. Think ahead before releasing another group. A smart sequence keeps people moving; the wrong order can leave you with nowhere to go.\n\n**SEE YOUR STRATEGY IN 3D**\n\nStudy the tabletop in front of you, follow the movement of each group, and watch a busy little crowd become an organized flow. People sorting becomes a spatial puzzle you can explore from your VR viewpoint.\n\n**SIMPLE IDEA. SATISFYING CHALLENGE**\n\nEasy-to-understand color matching meets careful planning. Look beyond the next move, make room for the colors you need, and enjoy the payoff as your choices fall into place.\n\n- **Color-based people sorting**\n- **Miniature 3D tabletop puzzles**\n- **Limited-space strategy and sequencing**\n- **Clear goals: match the colors and clear the crowd.**\n\n**One crowd. Many colors. Which group goes next?**", "short_description": "Tiny people. Limited space. Which color goes next? Sort colorful crowds, choose the right sequence, and clear miniature tabletop VR puzzles. Match the colors, make room for the next group, and turn a busy crowd into a satisfying flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
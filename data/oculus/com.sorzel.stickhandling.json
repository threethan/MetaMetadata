t-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXtBdpFPohFLdtrXIpkVYT4p0ZbND9AC6QmrhllfciBEQ&oe=6B10660F"}]}, "id": "1292767313046885", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1.png", "id": "1823289615972015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771244_1823289619305348_6709576951111368534_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yzJNmq6hK0Q7kNvwF3vuDi&_nc_oc=Adr2RangIbfU7eEu45Ka5Opnlpol72u6gNu9P-4wv6LHXQ3LgAqOkywd5dA8yjJI1l8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSwK0rsSY4_Qm3FvOYoEQtypbwvsAGU0vF8dZj4x266w&oe=6B104A86"}, {"file_name": "screenshot-2.png", "id": "1570550465103395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771248_1570550468436728_7755217331664577961_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sowmjbVyuhQQ7kNvwFIu6VL&_nc_oc=AdrFYH7Q48Ux-k5E91UQB-oCWQX-ASAb9p50QOQL2mbLiR1sjZ8iXSOloDHGDtn3_H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuPog7ghwEFFrupfOa03dnoo_Yubc5S5N0dB6kGW0c5w&oe=6B1066F5"}, {"file_name": "screenshot-3.png", "id": "2006595040036784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771306_2006595043370117_7089578276065117607_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oneGyP0w54EQ7kNvwE7sAbm&_nc_oc=AdrFsQHkl231BZH2yInoChTM-QfBaA8Tlia1dgTeGmqhm_xpMm3Ys5yHcXre0VlhfOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAVHcja3o7cbwv-AF-ounWMXO6BelNAvwwKUx_Z0M2Bw&oe=6B104C47"}, {"file_name": "screenshot-5.png", "id": "1123489890596013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771256_1123489893929346_1234988768798445097_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADjYd-XDzRkQ7kNvwFZbA3X&_nc_oc=Adq-ey0DZq0OB2vSMGBshjSNKXl0Kkv8Fz7pBDYFYtu4VaW-CrK_5JjtbWm9xrJjhEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8nE1NQhg1kiVDbUFHH4mfnP0kJKyA00Mifs9mu2UdYQ&oe=6B105356"}, {"file_name": "screenshot-6.png", "id": "1769103480860959", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771262_1769103484194292_2229035161962674520_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctL1yMx899MQ7kNvwFSvVlY&_nc_oc=AdrnjbdMg-vOeEHBLLn8ysJdYN4_5xctBGSIwqslO74tb9pgcWQqetadQ4pp0kmnyMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWsNaWpeOOucjLXuAJCwEmOvDCdrGFiRWf2q236uncWQ&oe=6B104357"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mitts: Hockey Stickhandling", "keywords": ["hockey", "stickhandling", "puck", "training", "dangle"], "long_description": "Mitts turns the floor of your room into a hockey stickhandling gym: off-ice training with your real stick and a real puck. Put the puck on the floor, pick up your stick, and the headset watches the puck through passthrough while gates, targets and pucks to dodge appear around it. Drills: Random Gates, Figure Eight, Dodge, Weave and Dribble. Moves, Chip and Tight Space are coming soon. Every drill has its own options (size, direction, which hand) and a difficulty from 1 to 10. Heads-up, average puck speed and top puck speed are measured on every run and never change your score, so there is always something to beat. Menus work with your controllers or your bare hands. You need a real puck, a stick and clear floor. Clear a stick's length around you before you play. Camera images are processed on the headset and never stored or sent anywhere. No account, no ads, no analytics.", "short_description": "Hockey stickhandling drills on your own floor, with your real stick and a real puck. Mitts watches the puck through the headset camera and fills the room with gates, pucks to dodge and lines to dribble across. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kardashevcatalyst.com/mitts/privacy", "developer_terms_of_service_url": null, "publisher
kl231BZH2yInoChTM-QfBaA8Tlia1dgTeGmqhm_xpMm3Ys5yHcXre0VlhfOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAVHcja3o7cbwv-AF-ounWMXO6BelNAvwwKUx_Z0M2Bw&oe=6B104C47"}, {"file_name": "screenshot-5.png", "id": "1123489890596013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771256_1123489893929346_1234988768798445097_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADjYd-XDzRkQ7kNvwFZbA3X&_nc_oc=Adq-ey0DZq0OB2vSMGBshjSNKXl0Kkv8Fz7pBDYFYtu4VaW-CrK_5JjtbWm9xrJjhEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8nE1NQhg1kiVDbUFHH4mfnP0kJKyA00Mifs9mu2UdYQ&oe=6B105356"}, {"file_name": "screenshot-6.png", "id": "1769103480860959", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771262_1769103484194292_2229035161962674520_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctL1yMx899MQ7kNvwFSvVlY&_nc_oc=AdrnjbdMg-vOeEHBLLn8ysJdYN4_5xctBGSIwqslO74tb9pgcWQqetadQ4pp0kmnyMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWsNaWpeOOucjLXuAJCwEmOvDCdrGFiRWf2q236uncWQ&oe=6B104357"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mitts", "keywords": [], "long_description": "Mitts turns the floor of your room into a stickhandling gym. Put a real puck on the floor, pick up your stick, and the headset watches the puck through passthrough while gates, targets and pucks to dodge appear around it. Drills: Random Gates, Figure Eight, Dodge, Weave and Dribble. Moves, Chip and Tight Space are coming soon. Every drill has its own options (size, direction, which hand) and a difficulty from 1 to 10. Heads-up, average puck speed and top puck speed are measured on every run and never change your score, so there is always something to beat. You need a real puck, a stick and clear floor. Clear a stick's length around you before you play. Camera images are processed on the headset and never stored or sent anywhere. No account, no ads, no analytics.", "short_description": "Stickhandling drills on your own floor. Mitts watches your real puck through the headset camera and fills the room with gates, pucks to dodge and lines to dribble across. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kardashevcatalyst.com/mitts/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kardashev Catalyst UG", "support_website_url": null, "website_url": "https://kardashevcatalyst.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1350816688126073"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1155673986924860"}]}, "baseline_offer": {"id": "1155673986924860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795447920, "status": "PUBLISHED", "id": "1155673986924860"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1370981086109633", "version": "0.1.0"}, "id": "1182370347600500", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350816681459407", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "13
t-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1-_IdYgca8zxE5JXems7VyFYOMVuc8AK-whN8J18IOw&oe=6B0F148F"}]}, "id": "1292767313046885", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1.png", "id": "1823289615972015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771244_1823289619305348_6709576951111368534_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yzJNmq6hK0Q7kNvwEa6eZv&_nc_oc=AdrWMLP34lpJL8n-VVr8isX-zN6kiLJuo9RYZP9Vx6PA6alVj4It1SWMHnTPm2mlyRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBg1BKvu6WMAIgVfw0XA4QugoG_b_1CBUpFvrU8Ch86g&oe=6B0EF906"}, {"file_name": "screenshot-2.png", "id": "1570550465103395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771248_1570550468436728_7755217331664577961_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sowmjbVyuhQQ7kNvwFHLqjb&_nc_oc=AdqB-CBJW6lC_YCHhIPGsLWLYgu0-BFZKjXcPSX0xLvOpYWmDDTVg0O1hrA-_sy95XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbK6UtuJmUE0Dr1m9Lml7dYmYF4kzzoKh1_lLV6VSmBQ&oe=6B0F1575"}, {"file_name": "screenshot-3.png", "id": "2006595040036784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771306_2006595043370117_7089578276065117607_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oneGyP0w54EQ7kNvwGFoex5&_nc_oc=Ado8-EyFuAGD_0x7WCZ4F3_tOv5E2pcCEvCAkKJa1oqO_B_4P93tyxeuwQiz4C_akr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZvXsHvkOG_D8B1DRt-xG8Nxa9wC_xccY6YrAYT01oHA&oe=6B0EFAC7"}, {"file_name": "screenshot-5.png", "id": "1123489890596013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771256_1123489893929346_1234988768798445097_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADjYd-XDzRkQ7kNvwFzMPUq&_nc_oc=AdodKpwoqF8cvbm7IfVSZ4oTO4FFB4pJDhOBjBJxVBRSsxCHhjvLN8tKpC3B6swrMbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpFYCqA6jqyxTvv8ol689SWROAb5DFWQX-2N-t2TLXmg&oe=6B0F01D6"}, {"file_name": "screenshot-6.png", "id": "1769103480860959", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771262_1769103484194292_2229035161962674520_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awiL5m-ujOgQ7kNvwE1yWRC&_nc_oc=Adrfrpx7U1n7o5aGiaTxj_eVvNzlA_0mK1_K-VJ26yaYZw-3ghRRfK6Okp6adZPyoAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgkNah-276ZixxBOuGumHv93kZ12b4s7pT0j_zBmjjRw&oe=6B0EF1D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mitts: Hockey Stickhandling", "keywords": ["hockey", "stickhandling", "puck", "training", "dangle"], "long_description": "Mitts turns the floor of your room into a hockey stickhandling gym: off-ice training with your real stick and a real puck. Put the puck on the floor, pick up your stick, and the headset watches the puck through passthrough while gates, targets and pucks to dodge appear around it. Drills: Random Gates, Figure Eight, Dodge, Weave and Dribble. Moves, Chip and Tight Space are coming soon. Every drill has its own options (size, direction, which hand) and a difficulty from 1 to 10. Heads-up, average puck speed and top puck speed are measured on every run and never change your score, so there is always something to beat. Menus work with your controllers or your bare hands. You need a real puck, a stick and clear floor. Clear a stick's length around you before you play. Camera images are processed on the headset and never stored or sent anywhere. No account, no ads, no analytics.", "short_description": "Hockey stickhandling drills on your own floor, with your real stick and a real puck. Mitts watches the puck through the headset camera and fills the room with gates, pucks to dodge and lines to dribble across. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kardashevcatalyst.com/mitts/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kardashev Catalyst UG (haftungsbeschr\u00e4nkt)", "support_website_url": null, "website_url": "https://mitts.kardashevcatalyst.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382115794996162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842262_1753805796544284_5975791851047034478_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xCPdUzSBIsQ7kNvwF0T9n8&_nc_oc=AdpHbkJKdvacSbm5fgTu7YV9eVZE9VAN2gQCb381Vmn9YlEsVp1hv4bkpVHHpXLKslQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUs3WbBacu5fXKmJBwpGk2TMWl42jGTicoWT1qlJK7KNA&oe=6B0F0763"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mitts: Hockey Stickhandling", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1795447920, "lastRevision": {"nodes": [{"id": "1350816694792739", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1350816681459407", "is_first_party": false, "enables_in_app_ads": false, "is_concep
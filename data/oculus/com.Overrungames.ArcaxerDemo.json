dn.com&_nc_ss=7f20f&oh=00_AQLuv24MvVRI5h_KoCCTBaKoHChUuA5FJJKygrpFe5hoHQ&oe=6AA3FF5F"}, {"file_name": "SS1.png", "id": "4344124318948199", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003251_4344124322281532_7105253711288332397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46gIp7I1ZK8Q7kNvwFAVhd_&_nc_oc=AdqrJkEX0GKUGdUieIEHOKKsuDjZ0ne0UZL4JgbCdXfyG8MMUGFQgveWIdovBgXDdSc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_idrP0iaGVaTPhmap4AiScfpfimm_W3X1l7b3VppU2g&oe=6AA4140F"}, {"file_name": "SS6.png", "id": "2871459893090934", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031363_2871459896424267_7441636783260230032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrKgpWmY0hUQ7kNvwGB_k8H&_nc_oc=Adqx1mxYlnWEvTDLZLf-kqcTm-Qjvv5qOE91HPIkq4o-12dJCkemEqwuguYLpuMTCM0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsjm1U1cB1YtLXXfmoC0xUmDsLODYmHPfM3p_YNnG3AA&oe=6AA3FF77"}, {"file_name": "SS4.png", "id": "1116946478732474", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974469_1116946482065807_226491929828730572_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsPfUz7uVn8Q7kNvwG-Wk4N&_nc_oc=AdrKq5qsHacoEFaK1hYfnkJEfqd6_yPDTdjCFxwS4TlTp7jyRD8VvNrw3dQsFGcg7T0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-imbYTDAg8Nn5uzwZ8OcO1T-NVLzv2jIHWHSiXgsaAA&oe=6AA3FBD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT THumb 2.png", "id": "1351146998595502", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974917_1351147001928835_2921937393540943747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4nRSiflg84Q7kNvwFy_PGu&_nc_oc=Adq6yzOGBw0AzcpwPlijsJlW3SgiMiyY1jaLZLcYfdqmC7wYZp3etjleKL3t_cJZ758&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6ZELVWoCnRpJhSmjHSkLVtpEApsM-XZUFxlp8kWm-YQ&oe=6AA404F6"}, "display_name": "Arcaxer Demo", "keywords": [], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "http://arcaxer.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "http://arcaxer.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
 "id": "4344124318948199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003251_4344124322281532_7105253711288332397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc5d1z8t4l0Q7kNvwGg1XPs&_nc_oc=AdqPqMgmRFS55tuDStD8rGdmvBCf9H_88E2qBhmYzPPQnnThmP5BgUTnUYwSshRF-Hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwoanc3DBLCxBDMmVahh7HyauKSUn4jPUO_M8bTIKfZvQ&oe=69C1520F"}, {"file_name": "SS6.png", "id": "2871459893090934", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031363_2871459896424267_7441636783260230032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmDhZK-j7tcQ7kNvwFMtwBB&_nc_oc=AdoPeW8uyb4-DlH5iPlaG-BBFsSpxfx5e14U7I2MTdVjcn6wJN5EOVTsJBw2mtMHGUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKu_cjNCtKCvk7FrO3aY5GH_rkVlZT6iR9NAqqZdtYKw&oe=69C13D77"}, {"file_name": "SS4.png", "id": "1116946478732474", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974469_1116946482065807_226491929828730572_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHmggdkOTnoQ7kNvwGYhAqn&_nc_oc=AdoRiSPc26xEcI08VsfVqicmEL8e1IhdANXKAzoxR6MJZYXsJF_R_4HisJmPlIt9cNo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyg5bX-CALtxvFyBKTA2zEKLIbfeTGmJ_OCWiAlDVLqdQ&oe=69C139D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT THumb 2.png", "id": "1351146998595502", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974917_1351147001928835_2921937393540943747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDpDWT0KC-8Q7kNvwEVH3GU&_nc_oc=AdoTWBtBFRwy6MjdaNQ3w2LWyGjl3zARxSn6ymRXLueOegAgeOPgjxsZy8K5bR5XI9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_eoIFpOSbBu0_MYGsU4VuILZynveEFFsN7vVJBHlSSA&oe=69C142F6"}, "display_name": "Arcaxer Demo", "keywords": [], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "http://arcaxer.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "http://arcaxer.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "665301847940509"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer
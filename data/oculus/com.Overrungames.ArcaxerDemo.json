dn.com&_nc_ss=7f20f&oh=00_Af9E1qgY2UJ-pfcbPlXeEDXBc-NX7pGEThWL25mDM2AYbw&oe=6A4664DF"}, {"file_name": "SS1.png", "id": "4344124318948199", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003251_4344124322281532_7105253711288332397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfrr7ocptJcQ7kNvwGAEQzm&_nc_oc=AdrxEg9B1NY6ND6rRNfOGXMd7Gu0pFrIhp2Dj49XWzjCNnaU-FjD5T_2Dy5QhC7piew&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMnDx19P3C0LjIwubz8Val7CqFYK6_mYdQTH7K5yxAQ&oe=6A46798F"}, {"file_name": "SS6.png", "id": "2871459893090934", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031363_2871459896424267_7441636783260230032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oinhq0jaVzcQ7kNvwGABcHI&_nc_oc=AdoQOtGznZCQGVPWs3O-jFXhfIgyOklIgFBkc2IJuDdlyOAfvsE-PF-8s96Rav78m6A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yx4DUtMIn3BUs1-NcTYy8DNV3agK_foCAjoqOJPgdgw&oe=6A4664F7"}, {"file_name": "SS4.png", "id": "1116946478732474", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974469_1116946482065807_226491929828730572_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWZz_YmMQ9MQ7kNvwFF72ho&_nc_oc=AdqSh4G79gdeQD_v25hI9ws4v3Z_5HPfA2B0RVLzAgNQbObCsV7QZN5NqayDz-J1hwk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Dwm2FsFBuhYGARZDGgjLD0wimG1tQg_ktcVt1OyQGQ&oe=6A466154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT THumb 2.png", "id": "1351146998595502", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974917_1351147001928835_2921937393540943747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra5cdN7H1zQQ7kNvwHgGfEb&_nc_oc=AdoBCa-H5AFNFPDfnpsLCoEIuzwUqH6FIZM6f3MAUKICc63UuF3SSZGL7EU326iL5TE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eq3-5rgF533vhNP8-6_rOvjEqkn6AqmsLbFrB8o7g5g&oe=6A466A76"}, "display_name": "Arcaxer Demo", "keywords": [], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "http://arcaxer.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "http://arcaxer.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
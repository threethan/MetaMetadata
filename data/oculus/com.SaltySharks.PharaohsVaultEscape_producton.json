com/v/t64.5771-25/499622334_1241012297956793_1792263426158548163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNXeZILTUlUQ7kNvwFMOkHC&_nc_oc=AdpPfbfj9YUQJYN7Q-vwdSRUoT_gFh7aWs-sGPbaJWOflmCSqqAXzwOQtzD5SJ32Zx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInAquv4JbPekiDJENeiDOEjC_a42G_gqsC7OrCd65nSg&oe=6AB2739F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image_4.png", "id": "2511012899333896", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_2511012902667229_7194161919909211217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA1o_8FJTA8Q7kNvwECK-hD&_nc_oc=AdpOIj3N0QzHLFY844jel_0voVf0lfvIYN1M9vuvY3GZcgH3_JVfcDAWSUQJAMfzb2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvp6BUrUYdUL8UUPnztOsziuartXVGrYOKBIiD9tU6xw&oe=6AB28A42"}, "display_name": "Pharaoh's Vault Escape Room", "keywords": ["hieroglyphics", "pyramid", "WebXR", "multiplayer", "mummy"], "long_description": "The flood gates are open. The Nile rises. You have 45 minutes.  Pharaoh's Vault Escape is a multiplayer VR escape room set deep beneath the Pyramids of Giza. Gather your team, enter the tomb, and solve 7 ancient puzzles before the chamber floods. Play co-op in VR \u2014 or join from any device via WebXR cross-platform multiplayer.  \nPUZZLES INCLUDE: \u2022 Scarab Compass \u2014 Identify which sacred beetles face East \u2022 Hieroglyphic Cipher \u2014 Decode a Rosetta Stone message to find the Eye of Horus \u2022 Scales of Ma'at \u2014 Balance hearts and feathers in Anubis's judgment ritual \u2022 Pyramid Builder's Math Tablet \u2014 Solve ancient calculations using Giza's real stone data \u2022 Orion Star Map \u2014 Navigate the Old Kingdom night sky to find the soul of Osiris \u2022 Canopic Jar Sequence \u2014 Arrange burial jars in the embalmer's sacred order \u2022 The Final Cartouche \u2014 Spell the word of eternal life to unlock the vault door  FEATURES: \u2022 Co-op multiplayer \u2014 VR headset + WebXR browser players in the same session \u2022 AI Mummy hint system \u2014 ask the Mummy if your team gets stuck \u2022 Rising water visual + audio pressure mechanic \u2022 Curriculum-aligned: History, Math, Science, Archaeology, Astronomy \u2022 Ambient Egyptian soundtrack, voice narration, and escalating sound design \u2022 45-minute single-session experience \u2014 ideal for groups, schools, and team events  Prove yourself worthy to the Pharaoh. Escape the Vault.", "short_description": "Crack ancient puzzles before the Nile floods the tomb. Pharaoh's Vault Escape is a multiplayer VR escape room set beneath the Pyramids of Giza \u2014 7 hand-crafted puzzles, 45-minute gameplay, and a rising-water timer that never lets you relax. Decode hieroglyphs, balance the Scales of Ma'at, and map Orion's stars. Play in VR or join directly from any browser via WebXR cross-platform co-op."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saltysharks.io/terms-and-conditions", "developer_terms_of_service_url": "https://saltysharks.io/terms-and-conditions", "publisher_name": "Aquatic Metaverse", "support_website_url": null, "website_url": "https://www.saltysharks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1154902944379249"}, "review_messages": []}]}, "cover_square_image": {"uri": "http
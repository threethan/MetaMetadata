er_Art.png", "id": "1500218658523626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620965_1500218671856958_5004099419543032690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koHHJF1pBt4Q7kNvwHL3s8i&_nc_oc=AdroAZ3huX3goOy-alwm28uHse3q_LjrfbIreyai-PLxM_kmIVSf92TDj5o0YJFf51g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfd1vv9sy4dqVDXij2dcAxUPo32ORnn7M4Kkqgh1CCYA&oe=6AB28113"}, "display_name": "Pharaoh's Vault Escape Room", "keywords": ["hieroglyphics", "pyramid", "WebXR", "multiplayer", "mummy"], "long_description": "The flood gates are open. The Nile rises. You have 45 minutes.  Pharaoh's Vault Escape is a multiplayer VR escape room set deep beneath the Pyramids of Giza. Gather your team, enter the tomb, and solve 7 ancient puzzles before the chamber floods. Play co-op in VR \u2014 or join from any device via WebXR cross-platform multiplayer.  \nPUZZLES INCLUDE: \u2022 Scarab Compass \u2014 Identify which sacred beetles face East \u2022 Hieroglyphic Cipher \u2014 Decode a Rosetta Stone message to find the Eye of Horus \u2022 Scales of Ma'at \u2014 Balance hearts and feathers in Anubis's judgment ritual \u2022 Pyramid Builder's Math Tablet \u2014 Solve ancient calculations using Giza's real stone data \u2022 Orion Star Map \u2014 Navigate the Old Kingdom night sky to find the soul of Osiris \u2022 Canopic Jar Sequence \u2014 Arrange burial jars in the embalmer's sacred order \u2022 The Final Cartouche \u2014 Spell the word of eternal life to unlock the vault door  FEATURES: \u2022 Co-op multiplayer \u2014 VR headset + WebXR browser players in the same session \u2022 AI Mummy hint system \u2014 ask the Mummy if your team gets stuck \u2022 Rising water visual + audio pressure mechanic \u2022 Curriculum-aligned: History, Math, Science, Archaeology, Astronomy \u2022 Ambient Egyptian soundtrack, voice narration, and escalating sound design \u2022 45-minute single-session experience \u2014 ideal for groups, schools, and team events  Prove yourself worthy to the Pharaoh. Escape the Vault.", "short_description": "Crack ancient puzzles before the Nile floods the tomb. Pharaoh's Vault Escape is a multiplayer VR escape room set beneath the Pyramids of Giza \u2014 7 hand-crafted puzzles, 45-minute gameplay, and a rising-water timer that never lets you relax. Decode hieroglyphs, balance the Scales of Ma'at, and map Orion's stars. Play in VR or join directly from any browser via WebXR cross-platform co-op."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saltysharks.io/terms-and-conditions", "developer_terms_of_service_url": "https://saltysharks.io/terms-and-conditions", "publisher_name": "Aquatic Metaverse", "support_website_url": null, "website_url": "https://www.saltysharks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1129026533633557"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1051855490745606"}]}, "baseline_offer": {"id": "1051855490745606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782131700, "status": "PUBLISHED", "id": "1051855490745606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1138203689382508", "version": "0.2"}, "id": "2188284305329065", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1129026526966891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1138203689382508"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2188284305329065"}]}, "change_log": "What's New\\n\\nCharacter Customization\\n- Added a new character customization system - pick your look before you join a room.\\n\\nMultiplayer\\n- Added voice chat.\\n- Added in-game text chat.\\n- Added room creation so you can host your own session and invite others.\\n\\nVisuals\\n- Improved lighting across all environments.\\n\\nUsability\\n- Redesigned UI - cleaner, easier to read and navigate in VR.\\n- Added an in-game User Guide with how-to-play instructions.\\n- General quality-of-life improvements throughout.\\n\\nFixes\\n- Various bug fixes and stability improvements.", "created_date": 1789675155, "id": "1293388507197358", "version": "0.5", "version_code": 4, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1129026526966891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1138203689382508"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2188284305329065"}]}, "change_log": "We\u2019ve successfully resolved the ending issue and corrected the lighting, ensuring a cleaner final presentation.", "created_date": 1781271429, "id": "1138203689382508", "version": "0.2", "version_code": 3, "release_status": "RELEASE
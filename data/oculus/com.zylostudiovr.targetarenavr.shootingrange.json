zNcQ7kNvwHgVipq&_nc_oc=AdqQdgdqhvK3BSFj26AJvETl_oEzpC7L_MaLA8PrILCFpOpocQdRNJQ-3x-8_HPAxoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYpmU9KxqnuRMyNAr-7ZYkAptVSTCJwR5QhUmz-PD9EA&oe=6AC2542E"}, {"file_name": "2.png", "id": "2882946298713353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2882946302046686_1267364629195423527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtNllYMgqx8Q7kNvwEja-ZQ&_nc_oc=AdqVtjm8r6qK6PjRFEXhiJTzTzLbJCJpTuf79D819s9F6OQlOKFwLpyqhE4icbqGov8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA2AdMj1seuYN8PYJ8KA2ZWIKhcw4VFrCHVuMoI7txoQ&oe=6AC26D5E"}, {"file_name": "4.png", "id": "1374151311271956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1374151314605289_7837437344959925776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWUbQ_5GXlcQ7kNvwFqmYxH&_nc_oc=AdojracddS3jaC_p71bt8vWy8XOQJmz97oyAzpap4E1or3T6wRizKQ51vRi3UR6w2DE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNLN7zKidDE60ZnwD0yz03DA7qRIUW9IuVnaO90epZzA&oe=6AC25924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Target Arena VR: Shooting Range", "keywords": ["shootingrangevr", "shootinggame\t", "targetshooting\t", "vrshooting\t", "shootingsimulator\t"], "long_description": "Target Arena VR: Shooting Range delivers an immersive virtual reality target shooting experience designed for players who enjoy precision, accuracy, and skill-based challenges.\n\nStep into a realistic shooting range where you can practice with a variety of firearms, test your reflexes, and improve your aim across multiple target challenges. Whether you're a beginner or an experienced marksman, every session offers a fun and rewarding shooting experience.\n\nFeatures:\n\ud83c\udfaf Realistic VR shooting range\n\ud83d\udd2b Multiple weapons, including pistols and rifles\n\ud83c\udfaf Static and moving target challenges\n\ud83c\udfc6 Score-based gameplay to improve your accuracy\n\u26a1 Smooth and intuitive VR controls\n\ud83c\udf1f Realistic shooting mechanics and sound effects\n\ud83c\udfae Easy to learn, challenging to master\n\ud83d\udc64 Designed for single-player VR gameplay\n\nTrain your precision, compete for higher scores, and become the ultimate marksman in Target Arena VR: Shooting Range!", "short_description": "Master your aim in an immersive VR shooting range. Practice with realistic weapons, hit challenging targets, and improve your shooting skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1181122458421913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654886437_992264570080983_4034889505104314125_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLyF5MYK1t4Q7kNvwHcXrw8&_nc_oc=Adqmq6NQB8P0dxIS1z5AyqgyDcuYdsLnGeTerFPDKxp6jjwieLxTi8DXkRWQSNBXFuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f
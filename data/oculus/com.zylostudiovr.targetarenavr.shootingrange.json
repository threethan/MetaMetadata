fun and rewarding shooting experience.\n\nFeatures:\n\ud83c\udfaf Realistic VR shooting range\n\ud83d\udd2b Multiple weapons, including pistols and rifles\n\ud83c\udfaf Static and moving target challenges\n\ud83c\udfc6 Score-based gameplay to improve your accuracy\n\u26a1 Smooth and intuitive VR controls\n\ud83c\udf1f Realistic shooting mechanics and sound effects\n\ud83c\udfae Easy to learn, challenging to master\n\ud83d\udc64 Designed for single-player VR gameplay\n\nTrain your precision, compete for higher scores, and become the ultimate marksman in Target Arena VR: Shooting Range!", "short_description": "Master your aim in an immersive VR shooting range. Practice with realistic weapons, hit challenging targets, and improve your shooting skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1181122458421913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/654886437_992
racy\n\u26a1 Smooth and intuitive VR controls\n\ud83c\udf1f Realistic shooting mechanics and sound effects\n\ud83c\udfae Easy to learn, challenging to master\n\ud83d\udc64 Designed for single-player VR gameplay\n\nTrain your precision, compete for higher scores, and become the ultimate marksman in Target Arena VR: Shooting Range!", "short_description": "Master your aim in an immersive VR shooting range. Practice with realistic weapons, hit challenging targets, and improve your shooting skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1181122458421913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654886437_992264570080983_4034889505104314125_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWsx7gNiGOQQ7kNvwH0LvZv&_nc_oc=AdqvqruwpX7BNVhUXepx8zZH9ddcupF16k21i-EY4x2t0lgOaZTAgX2D4uU9WHO-QIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f
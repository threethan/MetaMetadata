zNcQ7kNvwH1jsps&_nc_oc=AdoIcgPiP9_518ww-5os_kfFtVruAZL3URML9qehTCCSIIxS_2DUtRnwjR5wDoq-Es0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9dPTH3sitBnRecaAoh2JYVYEogOVDWzqHq0BPNnvZPA&oe=6AC102AE"}, {"file_name": "2.png", "id": "2882946298713353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_2882946302046686_1267364629195423527_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IACdYBVjNaMQ7kNvwEmOUqj&_nc_oc=AdpoaR0eglFYmXXxLRltR6RdKDv3f4MWSGUOsq4BShfUg292RiPz9f3XMdMKx5_MxWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTbe5NsJAKLqH7DlB0GaGaz1AeoXWkYmZVm18_JQAAmQ&oe=6AC11BDE"}, {"file_name": "4.png", "id": "1374151311271956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1374151314605289_7837437344959925776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWU4h5juLXIQ7kNvwEfh6ca&_nc_oc=Adr6nDU3ZlkDbIhvuJ8gIDEA-C_KeQ6erqoGDxJwZk-DSPODD0Frmu8Dp9FKFLESnAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWni9bB0DeL8E6mDW_3-diobAF49Eq3DPCwnwePNIaxA&oe=6AC107A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Target Arena VR: Shooting Range", "keywords": ["shootingrangevr", "shootinggame\t", "targetshooting\t", "vrshooting\t", "shootingsimulator\t"], "long_description": "Target Arena VR: Shooting Range delivers an immersive virtual reality target shooting experience designed for players who enjoy precision, accuracy, and skill-based challenges.\n\nStep into a realistic shooting range where you can practice with a variety of firearms, test your reflexes, and improve your aim across multiple target challenges. Whether you're a beginner or an experienced marksman, every session offers a fun and rewarding shooting experience.\n\nFeatures:\n\ud83c\udfaf Realistic VR shooting range\n\ud83d\udd2b Multiple weapons, including pistols and rifles\n\ud83c\udfaf Static and moving target challenges\n\ud83c\udfc6 Score-based gameplay to improve your accuracy\n\u26a1 Smooth and intuitive VR controls\n\ud83c\udf1f Realistic shooting mechanics and sound effects\n\ud83c\udfae Easy to learn, challenging to master\n\ud83d\udc64 Designed for single-player VR gameplay\n\nTrain your precision, compete for higher scores, and become the ultimate marksman in Target Arena VR: Shooting Range!", "short_description": "Master your aim in an immersive VR shooting range. Practice with realistic weapons, hit challenging targets, and improve your shooting skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1181122458421913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654886437_992264570080983_4034889505104314125_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLyF5MYK1t4Q7kNvwGGEtoo&_nc_oc=Ado80qC475iWqolK36TfMWEQupt8Sc9vg6oOb--FwG4yKqydPJYBK6hQdL2kHTNWrmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f
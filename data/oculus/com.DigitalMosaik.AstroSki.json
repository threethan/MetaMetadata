/491821682_913251341310619_2050532695683171355_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exx8j7i_c0EQ7kNvwGItyh6&_nc_oc=AdovC9UYEvSadt2gTiBCd6qz0DG7uIslX7yRJTMT2PjNU_Ku_GdRZ8LlqYgtO4qtVCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCBhcGLwJOAtsdDUX47OXpk8VpDZff1w78WiMvTpQmaA&oe=6AC1029E"}, "display_name": "Astroski", "keywords": ["ski", "Fast", "VRarcade", "Race", "Olympics"], "long_description": "Astro Ski is a VR Arcade game that takes players to race on skis in different planetary environments, with unique features for each planet.\n\nKey Features: \nFast-paced ski racing mechanics\nMultiple modes and planet specific obstacles\nVibrant, unique and energetic visuals in toon style", "short_description": "Astro Ski is a VR arcade game where you race on skis across different planets, each with its own challenges and unique features!"}, {"images": {"nodes": []}, "id": "1619807885923611", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Astroski", "keywords": ["Ski", "pianeti", "corsa", "neve"], "long_description": "Astro Ski \u00e8 un gioco arcade in VR che porta il giocatore a gareggiare sugli sci in diversi ambienti planetari, con caratteristiche uniche per ogni pianeta.\n\nCaratteristiche principali:\nMeccaniche di sci veloci e frenetiche\nMolteplici modalit\u00e0 e ostacoli specifici per ogni pianeta\nVisual vivaci, unici ed energetici in stile cartoo", "short_description": "Astro Ski \u00e8 un gioco arcade in VR dove ti lanci sugli sci tra pianeti diversi, ognuno con sfide e caratteristiche tutte da scoprire!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/privacy-policy-astroski/", "developer_terms_of_service_url": null, "publisher_name": "Lagzilla", "support_website_url": null, "website_url": "https://lab.digitalmosaik.com/en/astroski-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "contex
91_5393899440325387803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxePxwQ3ZrIQ7kNvwFRoUtI&_nc_oc=AdqOJpnCnPgY0RtBZAM5iwQoVPhC5OsHD2rZECERIe0GxYmIiFjtuvuz-ZG0Sjli9VM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJV2QLLA8qYqwKPyoww8uMSHlEQfjorKU-KfrwPJ7Kxg&oe=6AD0D58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suLm7I8wDQwQ7kNvwH9YpDm&_nc_oc=AdoKpsS65CjwNklgSy22I-lXHtfvyKLIrnK3udx4EKq0jYpVUiuBk0-H_qvV8wbuDiY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOETp3MTNKckj8IlEhBNs2rm_75tPr5mDkjiIFJM-es-w&oe=6AD0F753"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
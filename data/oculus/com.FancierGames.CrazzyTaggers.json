91_5393899440325387803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arfeYLENs9sQ7kNvwGj14ym&_nc_oc=Adq_a5Ns826vdsmaEwwMpoHdaYZtGWWm1fZpRDPMXvnTvpsiO7mY_pGo75_b-qkEDck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHToVypkBB0jb_H-XdO67S41wfr2emXWvetcGgSXe8dA&oe=6AB2830F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOH0WGJer3wQ7kNvwHG2d9C&_nc_oc=AdrUBFstox7AZY-6NQjhr6KeBwhNSoCdUebIS-gzLQ6PmOkpCL_Ac6W0cRACXGwP11Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd_xob5FvYXu5RYv2qzOcuT3UZe8pxnObHLO3JujB5MQ&oe=6AB2A4D3"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
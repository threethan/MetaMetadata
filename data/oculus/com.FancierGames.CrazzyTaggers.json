=1-7&_nc_sid=6e7a0a&_nc_ohc=B0dqpCUykdsQ7kNvwHfms6r&_nc_oc=AdlCXthWbG4RR-qLdvR9CdQtVPUt1CW7p-ysX8eyOa9zuXPb7jCOD5kzUr85t1878Qw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOnW7VRD-uZ2NQZF8qKv_VdZKDN_QYoQg6ElBIkhDMbA&oe=69BD4C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQzuQgQScX4Q7kNvwE_iklk&_nc_oc=AdmSLE1-QMVcnRnpXTKzgjcqjTnu_WvhRj139Ubxi_bcZiNUDPffBJqc991AwCMpMiw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxezYh-m2SoyMaZuodE9dZ9d5u6zxGLIX_WNSZUhfUj9g&oe=69BD3593"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504
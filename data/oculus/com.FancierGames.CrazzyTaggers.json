91_5393899440325387803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arfeYLENs9sQ7kNvwGPXBma&_nc_oc=AdqW0YQO7MvgfE5N94dOzZjRhydzlUNZ7RJgGDFJlPcsRFVfhVGJ3BO-umiZRaNLxZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtmx1O6CpYNbDK4voTEBxC3vmOWjTLt00ETaLf2f0Tcg&oe=6AB1318F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLJYG8CtwvEQ7kNvwHeJmAP&_nc_oc=AdpMZHi9huLKUAjjPf8yxFO2obZWUcl6yBEjAtDnnSdxQ9wA1futYkAH52yTDBWzeLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd7cb0O-XUK4J5jSOygU5lUEgxn58Yvi1kMc8R7OjaMQ&oe=6AB15353"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
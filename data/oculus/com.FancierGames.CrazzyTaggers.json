7803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEfzbb9P_5UQ7kNvwHtzQ2b&_nc_oc=AdmOIGYSUF4G8MB7IRwG_BeAhEuhSWKRe8HRLsKL5tIHX4H3cuZFSXzb82a2uzJuhRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurDUnxmoeRkybtZk4-j0h2BQA2eYRRWpNbD6gtebalFQ&oe=6999B38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgzDT4lf29gQ7kNvwGepsjA&_nc_oc=AdkMbMiW3lfgpgPHMnPK5x3-3fl73n06KxR-NSIDSkGvjkDevsC52Aaxz0ISRZ368A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUevf6TeEN9nccstgT5nQn-uBIxW5nsETuSfuT-vjqiw&oe=69999D13"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
7803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDnh5YOSn3UQ7kNvwFawZ4A&_nc_oc=AdmjMF64K-RVF8G9f4hUCnnWiIxujjT-cAMP3x2FmWUs1dh0a0Ir_XwvIyCsVQ5NpVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWT1wN0OEfaWG1GBgqND2ePp8C1U7SOYyo30ePBoYu3Q&oe=69A6E28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAQtbdG46-sQ7kNvwFlB5gv&_nc_oc=AdkZbbCSr-J6CmaWC7IJ2-sB2CiKNrAAfFEoULP08sxzW5I0QVD6OifCTnitvAD2RPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqtX--9pcX2B0Ntl13xaJ58gaPck55yJ_IWXETTW851w&oe=69A6CC13"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
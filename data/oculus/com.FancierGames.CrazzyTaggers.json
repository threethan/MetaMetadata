91_5393899440325387803_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOcnISwu3MMQ7kNvwELrCPW&_nc_oc=AdrJOXRORMiytSCGUP7Yyox1tT4tLzex0Q9i7UAq7Y1VKR5cJft49JHWDpUFfalhJdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66d9aZiUSiutX115pV6nnahT2qct4PcsB4Uq2uwwDg_A&oe=6A05CE8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOuJN4LLyK8Q7kNvwG80wKI&_nc_oc=AdpkQBGZXeLCuzaP_fKyIydcjdOvWjPK1VaGWAEc6xjXDmTVocAxbmA_hzwylxp87Fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cfTBW_fRAiR_0vSIDnJtkJGx6VNSqeHPEe4qIO7oiWg&oe=6A05B813"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
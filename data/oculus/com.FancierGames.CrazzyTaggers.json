=1-7&_nc_sid=6e7a0a&_nc_ohc=qe8KNleGIIMQ7kNvwHzhiau&_nc_oc=Adlzvd2vHXUa0YsUmWDtzh3D60rcoBsoL3CZRfKqCWkw4BFgKN5hWdx6e_-Q8cThyqE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUfbyTZ4_iw-ZoKk2ezFXyIW0AfQMFaNG22Zgwbp0BNw&oe=69BAA90F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fancy Tag Placeholder Screenshot HI-RES.png", "id": "328369166823341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001704_328369170156674_4839512043415295040_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGndNYMseSsQ7kNvwH2Npmf&_nc_oc=AdmP58j5-D6YeqGKuPsha2hvnx2NLGbRnsr_1W6OdKXVfB1d1cfHFGPhZiEqL09AIYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_I2774W8qtExGp8-EiM9BwGBkKGhXceHn2mFQ0dEPVQ&oe=69BA9293"}, "display_name": "Fancy Tag", "keywords": [], "long_description": "Run into a awesome online experience with Fancy Tag, where you can team up with friends or challenge random players. You'll seek a variety of fun and unique game modes designed to keep you entertained. Utilizing the incredible locomotion system inspired by Gorilla Tag, you'll enjoy smooth, intuitive movement as you navigate through dynamic environments. Whether you're strategizing with friends or making new connections in the heat of the moment, Fancy Tag promises endless excitement and action-packed gameplay.", "short_description": "A fun online game where you can play with friends or play with random people with fun and unique game modes, this game uses the incredible locomotion system from Gorilla Tag."}]}, "developer_name": "Fancier", "developer_privacy_policy_url": "https://sites.google.com/view/ft-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/ft-privacy-policy", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504
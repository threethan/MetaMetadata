SubmX477krqy7QQJ1cyqCxu80Dr_i28jLAuA14EFbCA&oe=69B14A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_DrumsRock.png", "id": "459277995861974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003267_459277999195307_6484786918122057217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF2jqbgdbzcQ7kNvwEQv2HW&_nc_oc=AdlUvYa1Z41pub3W1peRgIQSRCpzgDQgSY4osSqIGS5vEKNjxKet-gq-vkBVtuQNVvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypdGe3i9RAvpQfUIJAvDqlBDFQVHo9OzhdVr8xTZvElQ&oe=69B17536"}, "display_name": "Drums Rock", "keywords": [], "long_description": "Get on stage and discover a variety of fantastic worlds. On Drums rock you will live a complete experience with:\n\n\u00b7 15 ORIGINAL rock songs, based on the history of rock\u2026. and some surprises.\n\u00b7 An inside game store with more than 50 items, and some of them are crazy!\n\u00b7 Differents environment designed specifically for VR with 3d sound effects and more\n\u00b7 Online worldwide ranking to show your skills to the world!\n\u00b7 A complete campaign with more than 5h of duration! \n\u00b7 A lot of special modes and trials, final stages with bosses and more!\n\u00b7 Difficulty for every kind of player, an easy start for everyone and a Hard mode for the ones experienced on the music games. \n\nDrums Rock is born with the intention to reminisce the great ROCK music games, move away from techno music, and make a tribute to classic and modern rock history, to make rock great again!. We have combined music games with arcade/hordes games to integrate it into a fantastic and punk world, where you feel like a real rocker in VR", "short_description": "Drums Rock is an arcade drum game, follow the rock rhythm with your drums and crush demons. Play a completed campaign mode with a lot of trials and songs, or play the challenge mode to reach the top score and show to your friends who is the drums king in the world rankings.\n\nYou\u2019ll destroy all types of the demons in different worlds, you will be able to buy more than 50 customizable items for your drummer, special songs and more, and everything will be 100% reachable inside the game! Let\u2019s ROCK!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage51.es/drumsrock/privacy_policy.html", "developer_terms_of_service_url": "http://www.garage51.es/drumsrock/terms_and_conditions.html", "publisher_name": "Garage51", "support_website_url": null, "website_url": "http://garage51.es/drumsrock/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "en_AU", "es", "en_GB", "es_PR", "en_US", "en_CA", "es_CL", "es_MX", "es_CO", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "941296373425636"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "914952161434854"}, {"status": "PUBLISHED", "id": "1201468638636101"}, {"status": "PUBLISHED", "id": "884235874003039"}, {"status": "PUBLISHED", "id": "1344190180261854"}, {"status": "PUBLISHED", "id": "25086463247680758"}, {"status": "PUBLISHED", "id": "747001298166103"}, {"status": "PUBLISHED", "id": "2219633971888488"}, {"status": "PUBLISHED", "id": "1700207577252670"}, {"status": "PUBLISHED", "id": "647793271165841"}, {"status": "PUBLISHED", "id": "1117993006184113"}, {"status": "PUBLISHED", "id": "543418918409021"}, {"status": "PUBLISHED", "id": "9
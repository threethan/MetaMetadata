8D931A"}, {"file_name": "HeartlandsStoreScreenshot002.png", "id": "392851332824489", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiFgEa_Hk4IQ7kNvwHLn9hO&_nc_oc=Adrwm-gk1NwK0ASpGV2HMlgch_XxHmbRdEabOWDWlbbm8vlhkxqKC7D5IjyrkIKAwMM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXoOtNSNxbwPy2hsvfHnZ2CqHbrIENEql2k3AKpiD-Pw&oe=6A8D910E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hWGpFZEkswQ7kNvwFZ4P3F&_nc_oc=AdpnJxP-DVQU5hpArlEnRPTfxV36xsStI_NvaM53XtIs3ujstyOdBNWdMRyH0GYbsXM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQMsSyWaSV8T72AtbpgNBnJH9CU4SqRFscpsv08KOedA&oe=6A8D63C3"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_EImraqveIQ7kNvwETR4uG&_nc_oc=Adp6n_CnMVQvcD61MZ2xwFpG1Nr2SYKrjx5fps2dWTKQTPdoCZ5u2EsSfkxGkL1P0v8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY-QU2PrT73lyMgvmvwtlpLT4wvWg3lfB8gk86zrExBg&oe=6A8D8F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUjSpsbc548Q7kNvwFsqRle&_nc_oc=AdqmLvs1_SByDqOZoIRS_b9KBnlpHRf1T80ookZZsu-BrfbvpF62gEfLgVApRiP4BlI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK3-zCM-J0aG95bP5m1Ss4QtW01-ui9XLnW6n-hJBJvw&oe=6A8D6547"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7619901031359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031634_1705287596530377_4156436473361489332_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid
v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEzS-etlxBwQ7kNvwHq6m4r&_nc_oc=AdmI5pddHDOb9w5HPvsJr7XucHjoe7_hyhG9S6gx-mCVXpJRZ487GbAvTQrqIbHe97M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7aVR4HUIQ6u347JxnQPZm6YamdW0hLh3b26BD5d--Fw&oe=699DA00E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEaEKtUtDEEQ7kNvwEA6NWb&_nc_oc=Adn1Xm0qQBCR6zWONrr4X46K9sAnY-OuMzjc6xYtEk5MPrjlNG3MXJWVGh6Hk_uTtYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvU-j8n58NC11TjRNDscRzwTLr7ZmTUQivWpLcBpkHaTQ&oe=699DAB03"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KwH0GJWtrIQ7kNvwFlfwRB&_nc_oc=AdkEj8Wc8ecVWufVzRbwzVZO3Dp-xuEqxM9cbhMhKc5nKDm7tfCHtVBAvuOH_0PK4lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE2tVVCruQwkCUon1HV85PeGgjQOny_fjcEwa3jYalaA&oe=699D9E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZtQg5VS04wQ7kNvwF6S1bG&_nc_oc=AdlDzssXTEfEMQgHBW7oDFNGBI1Jpb02E5ZpySGxRiTfRO83yq_AafVz3Iu-GTPwk70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVoNZKu_HbA-dn7SFUohFwjAXWFwAjhDI4boFoQXE2eg&oe=699DAC87"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7619901031359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031634_1705287596530377_4156436473361489332_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rklH8efLWcsQ7kNvwGL9vx1&_nc_oc=AdkVy7-w3VFfXxb1dmcvpOo2AIgTf4UrlbG3N16CNlJR3FfPm8O7sNc1PvvZZVUAn-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftxyia1lExeaBtM3K_
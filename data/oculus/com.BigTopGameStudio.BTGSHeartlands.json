v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEzS-etlxBwQ7kNvwHsy3ex&_nc_oc=Adk6skdMfeHN6lr5S4EZwxqsfZv2JsEMSBSt2GBY2iEIqhtWKftnK7iSpOLy53uCcG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEOx7MqGgI_7SbePSsR8nQUOKq3xEBrzOKd4s4xI96eQ&oe=699C4E8E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEaEKtUtDEEQ7kNvwH_3SjH&_nc_oc=Adl6YK7w6awFlOdrqoswuM1gbqSrqzP9oKNJHABtTcjm_-albqZ_b3B8ZARlzb_gMGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aful6R79zGnnIEsEO2x8UXQ6aWbK5VKurFxVHizZ5COWtQ&oe=699C5983"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KwH0GJWtrIQ7kNvwEj0_Tt&_nc_oc=AdncgVuH54BlDoKQfXO3_28ZwuxrpgAp9_Ck8FpDk9Bp44Xur1oe8t3Pti702Ac93Pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvE0xOQrRAmWt_uh3hmAjfJA5XiSh1gSvVs8c6gjTY4fg&oe=699C4CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvloo4CMTWoQ7kNvwGKQNoV&_nc_oc=Adn25tsV5PtkLOQ-TC5bLsZdFGT4isW7mxfa7mbCJa2BSHdxtQ6NO2IAlfNJQvbZUgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsTxa7hCeHPo_uvoOokgnoZIhyupxfuZShbZ2dIG-HPng&oe=699C5B07"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7619901031359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031634_1705287596530377_4156436473361489332_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YljOPnlNhGoQ7kNvwHAr_YH&_nc_oc=AdlZYRTeIGqdW9Q6870ncBP9GXK8ilHd2d0Xz-UA45LFIGhJV6tTgHSpR2EjkUzPfSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afva8qwbBxUQwqh0TLa
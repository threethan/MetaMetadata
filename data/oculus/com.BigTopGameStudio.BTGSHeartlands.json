ontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pT4ANpCwCQQ7kNvwF4CvvH&_nc_oc=AdoK3YxFVplLO8556dJBsrrjpboSr-R3gftiShSXk21LvmVz9FLfjbfFb2GVHQC1rGI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMe1NcwgBKaAOLTSG8V2jMzGd3a4gn1o8hlBq67roKug&oe=6A857AC3"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvlaF_m5hv8Q7kNvwGyqFFl&_nc_oc=AdqowsiOQdG7OUGeSsBhSn6i4r3OkVwUOkMm4Tqcd4ciyxJUrN5gkNyCgO3Aw_8IQSM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGs_Qj53Lwf1UxWC8tHU7Ow0zOzlGGYaQJmGpOFN-DOg&oe=6A85A679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g35tvUGWfxEQ7kNvwFv_DIV&_nc_oc=AdoSnaSWxRMne8ogUFcGHyXr8XLcq8W3NXDHBm3o3JUcoIIF3cYuopmnd91tGyt99Bk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-hitV5Vv8RAXSxlo2TemMVAXZhYR78774o5viTp9vqw&oe=6A857C47"}, "display_name": "Heartlands", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131660654082467"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "390051216558409"}]}, "baseline_offer": {"id": "390051216558409"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658516220, "status": "PUBLISHED", "id": "390051216558409"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6358202584196281", "version": "0.0.2.168"}, "id": "5305633359552248", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6014260795257130", "is_concept": false, "latest_released_binary": {"__typename
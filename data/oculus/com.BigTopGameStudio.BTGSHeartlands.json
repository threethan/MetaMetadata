v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLuXEs5raN0Q7kNvwGhNIKp&_nc_oc=AdnuxpyymQi-jk-dXEcriy5TVep_OI8XOETOzVb4S8aAFxeub9VNiA14AfFmcuRGp-g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsvcuhGR7BM7dLSdENWWWabdo6h44Kmfz7IxnhynDiADg&oe=69A5890E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbTbF6OjGL4Q7kNvwH4wDSE&_nc_oc=Adnb581BLZTL06bOwM2hHl8dim4DTnAHbvvdEW9dErspl4reAeSEj--tqAN81XFxh6A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfudWk8TeKbQiWN_grib5ccVheevcRWgmkSxPmZzyxDw7g&oe=69A59403"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r1WX3ZxpsgQ7kNvwFgmtmg&_nc_oc=Adkq_y2tokje3u_DuMM2ED0ctvd9fs7JfSqXxuEgecwYRpxvQ7VqV0Ve0pdx-1qOYDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsttoxapA0LwO-EKyoUgO8HXGLP1PgKW64rvtHjZfKkNQ&oe=69A58779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hREGYx2PRWkQ7kNvwHk2BAa&_nc_oc=Adl9QdCUGaLkaiKXgWZo_dazeUaToWqA4HgXurfR7_7AWlRgiI4wbE0dglavog9hi6k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs70VQrbDRrT4-oRU7Et2s9CvpXjXYydEZBVePLIylZDQ&oe=69A59587"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7619901031359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031634_1705287596530377_4156436473361489332_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUmAyVwrA1AQ7kNvwF2faai&_nc_oc=AdkENKK_MPMXM-_ByCCp0UJLAfYvGXHIk_39uSEa9PIhLCmBdqjavlmkdvJ-gs7Mz1Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs6Wc6UMbCOSEBv0x-
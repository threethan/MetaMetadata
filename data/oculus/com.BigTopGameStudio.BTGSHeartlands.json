ohc=EPl2mxxqYcQQ7kNvwEQCHop&_nc_oc=Adoi8pJhcL2cMXYEM2yl02nZHZgSf5l5Mte6vF5oQVGeXBI0HB4O7IuuG2Hs8CzZayw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7walu4bqBpM-T_Jwc9qKiAHrKAyW7P5QNrTZekUdbig&oe=6B01CF5A"}, {"file_name": "HeartlandsStoreScreenshot002.png", "id": "392851332824489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvtiLbzyEz4Q7kNvwFDj96w&_nc_oc=AdrjthnPKeAlJdaTvGKGI1Zz0QvMSASiNwAtNcTHmZeEXnFpDuylqN2BMxMCn3idZ0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXH-I2tX0T1Ss9D8wdn5RX-xfIlYvq7C3X2j5dd2E7zA&oe=6B01CD4E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNpzt8m5npEQ7kNvwGl5_Xr&_nc_oc=Ador9Vck3u5COgJAtezJQBXqOVWn1MGXkZTMn6SzejETBLHl-BLxhBIKZjaQHkCKk7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhfl7JNGdjWWEtIUWAsRk6QI4TFTm38fXfOw4nmhbtNQ&oe=6B01D843"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlNaHl4tt5cQ7kNvwHhIL7t&_nc_oc=AdpbD9Oq1NsLRpnneJJa5klrJKPI2zKtiFr4BSCpvMyfFcxgL1U6Tgd7FtrgvfWmf3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmZ-uS5IfBjDkkugr7qdFX1GQBl6eWqEShKBIhaHubFg&oe=6B01CBB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7fq6uAfJ5cQ7kNvwHkPTHY&_nc_oc=Adq23pKWzy06EIhrC2OKG1Jv3fozifYnuh8xEtQ2AjSWdj4dK-x5F-0vwC4RqNMAtFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlenfvklS6E8yjTIrTEMXZ3DbgiqBLbsg8DwpNuDaQrQ&oe=6B01D9C7"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
002.png", "id": "392851332824489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031481_392851336157822_267756083555673757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3YSAXQEfO4Q7kNvwGeUYp0&_nc_oc=AdnGy_ANKG4EDLfv-0vX1IC02X816jD2y4Qs9SAgc5XOGKCJnTfyAQ0vctrAasd0VQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoZ4Y4NgP7dLWQmVnsFOibCMx3iByt5k-8HNilGYaWKg&oe=69BE958E"}, {"file_name": "StoreDungeonScreenShot002.png", "id": "2853698854932514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982484_2853698858265847_6502571490572033276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F2_9q_3Uf0Q7kNvwGotRJo&_nc_oc=Admx9Z2_y11mJX6k1gsk0R-nFWwBtouMfiHCioVGl8OoQ0sKGNVajjdiTu1I43nZaDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjWIsXP0A_31vzQY8Fm4JbhbgvTG7PGREI69Hb2kGSxw&oe=69BEA083"}, {"file_name": "HeartlandsStoreScreenshot003.png", "id": "587644992985375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974748_587644996318708_1438854026265771963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCDdA65eyvsQ7kNvwF8pLvz&_nc_oc=AdmUBIBUL_XZHE0mjHGXnTdcfc8v_dznWUISwG5W1UPAmS9tTiU5irXDRkVHLMU_BK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYanE6HexfzSpydoYr9PK576jLF5xfos3RZWVMSf9bFw&oe=69BE93F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeartlandsLogoWholeMod2560x1440.png", "id": "1029682097742683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_1029682101076016_2142578198082104180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3hPqw0qT98Q7kNvwGjQPk8&_nc_oc=AdkAUsegFqJuAhq_wOLddEu4zusDvjb53hCyl1eOS0WzhrfNtAa9VosZ0GCgUtJgX5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr-BXGt0DMhRjpD5HysVJv0uEpk082WKcO-tkiFOEqQA&oe=69BEA207"}, "display_name": "Heartlands Demo", "keywords": [], "long_description": "Features for the full game include.\n\nFully voiced NPCs\n\nSkill and attributes system\n\nMelee and magic combat\n\nFull quest system\n\nGiant city named Rustfall\n\nHand crafted dungeons\n\nHand crafted interiors for every building in the city. (120 at the time of writing)\n\nCustom lighting system including a day/night system specifically built to take advantage of the quest hardware.\n\nWeather\n\nFactions\n\nPlayer Home\n\nItem repair at benches\n\nPotion crafting with over 44k possibilities\n\nIntelligent interior system that changes based on the NPC living there.\n\nFull NPC schedules that make them feel like living breathing people.\n\nInnovative inventory system\n\nWeapon smithing\n\nCharacter creation with 7 playable races.\n\nBuying and selling gear", "short_description": "\nHeartlands is a full single player VR RPG."}]}, "developer_name": "Big Top Game Studio", "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy-heartlands", "developer_terms_of_service_url": null, "publisher_name": "Medieval Interactive", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RPG", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7619901031359757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031634_1705287596530377_4156436473361489332_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcXP20nqLWgQ7kNvwHW-qh9&_nc_oc=AdkgAX6L7N0vVfW6x_Yi8p
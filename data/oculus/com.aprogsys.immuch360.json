9oArLethkR0QdWALVwcu-U-J_3czsV2xls23BPff5GR2gzMpdP8j77xYwR9QB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSwmLzLiurjQ6-FlVf1dDgxvq6dLqshhkQzM0MtmveLg&oe=6ADF591B"}, {"file_name": "immuch360_02.png", "id": "1652601786497275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1652601793163941_1074964103630961921_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeGaMlqeMMwQ7kNvwEu1CnF&_nc_oc=AdpezY0jB5te6wsqycpk9mAbEKQaEH9XVBP4e_P4eIf-HzWGHqu0Y5fUdUallSLS8AY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfE0yhwIGofqfmyjTSL1rvhRbS09U2QGoJio-4YfP4RQ&oe=6ADF4BFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immuch360", "keywords": ["360", "photo", "video", "VR180", "Immich"], "long_description": "Immuch360 is the Immich mobile app with the missing parts for 360\u00b0 media, built for the Quest 3 and 3S. Press the 360\u00b0 button on a 360\u00b0 photo or video and look around by turning your head. Stereoscopic files (top and bottom, side by side) are shown in true 3D, and VR180 files are drawn on a half sphere.\n\nIt is also a free media player. Flat, 360\u00b0, 3D and VR180 photos and videos play from three sources: your Immich server, the headset's own media (Use without a server on the login page, no account needed), and a NAS or a computer over Samba (SMB) or WebDAV, read live, nothing copied. In the immersive view, the info panel and the controllers give you a time bar with 10 second skips, previous and next media without leaving the view, play and pause, the 3D layout, 360\u00b0 or 180\u00b0, and a Turn button.\n\nEverything else is Immich, unchanged: timeline, albums, search, sharing, and the backup of the headset's captures to your server.\n\nControls: B or Y goes back to the app window; the trigger plays or pauses; A, X or the grip shows or hides the panel; thumbstick left or right goes to the previous or next media; up or down skips 10 seconds in a video or turns a photo by 90 degrees.\n\nImmuch360 is an unofficial, open source fork of the Immich mobile app, not affiliated with Immich or FUTO. Only stitched equirectangular files are shown as spheres (exports of the Insta360 app or Studio, GoPro Player, Ricoh Theta, phone photo spheres); raw camera files still show flat.", "short_description": "360\u00b0 photos and videos from your Immich server, your headset or a NAS share, in true 3D and VR180. A free media player for flat, 360\u00b0, 3D and VR180 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/freeKC/Immuch360/blob/immuch360/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "APROGSYS", "support_website_url": "https://github.com/freeKC/Immuch360/issues", "website_url": "https://github.com/freeKC/Immuch360", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "pt_BR", "pt", "nl", "ja", "ko", "ru", "pl", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1384208444774043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1144048694950627"}]}, "baseline_offer": {"id": "1144048694950627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791386880, "status": "PUBLISHED", "id": "1144048694950627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
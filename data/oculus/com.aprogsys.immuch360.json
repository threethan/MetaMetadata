 "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508955872299299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 52. Photos and videos sent from a phone open in the window, names stay readable over thumbnails, the settings file has its card, ratings are asked with a line that fades. Site: immuch360.com. Builds 50 and 51 are included.", "created_date": 1795603051, "id": "1508955872299299", "version": "3.4.7-immuch360", "version_code": 3030050, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508955872299299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 50. While a video plays in the app's window, the window redraws at the rate of the display (72 frames a second measured on a Quest 3, build 48 drew about 10). The app's site is immuch360.com. Everything of build 49 is included.", "created_date": 1795287198, "id": "1501916503003236", "version": "3.4.5-immuch360", "version_code": 3030048, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508955872299299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 48. IP cameras of other brands live over ONVIF or RTSP, raw Osmo 360 II and GoPro MAX 2 videos stabilised, Plex films read off the main thread, Tapo logins updated. The app's site is immuch360.com. Everything of build 47 is included.", "created_date": 1795063193, "id": "1497021070159446", "version": "3.4.3-immuch360", "version_code": 3030046, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1508955872299299"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 47. Plex films: mpv, a playable audio track, versions, clearer messages. A settings file, Sign in with Plex, stabilised 360\u00b0 camera videos, battery Tapo cameras. The app's site is immuch360.com. Everything of build 46 is included.", "created_date": 1794619686, "id": "1487236034471283", "version": "3.4.2-immuch360", "version_code": 3030045, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CNb7XQqwokQ7kNvwFSc93w&_nc_oc=AdpsDs9RpAUMwPPxnLGf3FAN5xxJ2dXGirr1luFb8U8XMcIcENDAsu2eRN56ey18Hs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJXb-8qEzXmRFLpmaELqZ4oYNbK6shHvvrqhx189uxlw&oe=6AE7580D"}, {"file_name": "immuch360_08.png", "id": "1742851700100364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829120_1742851706767030_5664910117266848483_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZofxNP1cGREQ7kNvwEWJjZg&_nc_oc=AdpMu43Xr4iFc7_MHKHxsO68s7U_NsnhlF2b7ZYZh2554W7TQKxuhC4p-tE58SRIglo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXEkM0qZBqi7486Mqjd4ojsIdxcgW0R6QgNrWVvcSq-g&oe=6AE74EA1"}, {"file_name": "immuch360_11.png", "id": "1612725050499944", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_1612725060499943_6240200173643163428_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMHmWrs3F3cQ7kNvwEMaR0V&_nc_oc=AdrXu6WCCqF_0gtiDOvloZvHXhL6vadg5V3B8ouNMvBK2t6_jHZlfYTc4D1129YKGJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu7cTPZF3GMWf08gqn9zkQDVzHkyU0Pbk-N0H1j4KEvg&oe=6AE7508C"}, {"file_name": "immuch360_04.png", "id": "1638280761253739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1638280767920405_5866046994056952494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg9iYNrdtbcQ7kNvwF6c9rf&_nc_oc=AdpIbN-v2IikOryFxCtUsOD4wWgB8R-1J34FNJq7kr0Kn4aB-Hkh6kI_OyEh5cTVPsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8x_9y4X4y4vCyCa6DTmV4Zu_l5OEtomChp55J7Hb70Q&oe=6AE7421B"}, {"file_name": "immuch360_02.png", "id": "1652601786497275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1652601793163941_1074964103630961921_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjYkXMkeSpIQ7kNvwHjbaMa&_nc_oc=AdrZlOi7PRqw60F5RxLEfq1JPy04qEOKarW-0x8W9pfNP3GDO2l2VUUNPwz_lWuTggQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfi1Bp8cy0uxJfmwIkS2WlAO2bk2odSjrKie1K8sgYvQ&oe=6AE76D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immuch360", "keywords": ["360", "photo", "video", "VR180", "Immich"], "long_description": "Immuch360 is the Immich mobile app with the missing parts for 360\u00b0 media, built for the Quest 3 and 3S. Press the 360\u00b0 button on a 360\u00b0 photo or video and look around by turning your head. Stereoscopic files (top and bottom, side by side) are shown in true 3D, and VR180 files are drawn on a half sphere.\n\nIt is also a free media player. Flat, 360\u00b0, 3D and VR180 photos and videos play from three sources: your Immich server, the headset's own media (Use without a server on the login page, no account needed), and a NAS or a computer over Samba (SMB) or WebDAV, read live, nothing copied. In the immersive view, the info panel and the controllers give you a time bar with 10 second skips, previous and next media without leaving the view, play and pause, the 3D layout, 360\u00b0 or 180\u00b0, and a Turn button.\n\nEverything else is Immich, unchanged: timeline, albums, search, sharing, and the backup of the headset's captures to your server.\n\nControls: B or Y goes back to the app window; the trigger plays or pauses; A, X or the grip shows or hides the panel; thumbstick left or right goes to the previous or next media; up or down skips 10 seconds in a video or turns a photo by 90 degrees.\n\nImmuch360 is an unofficial, open source fork of the Immich mobile app, not affiliated with Immich or FUTO. Only stitched equirectangular files are shown as spheres (exports of the Insta360 app or Studio, GoPro Player, Ricoh Theta, phone photo spheres); raw camera files still show flat.", "short_description": "360\u00b0 photos and videos from your Immich server, your headset or a NAS share, in true 3D and VR180. A free media player for flat, 360\u00b0, 3D and VR180 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/freeKC/Immuch360/blob/immuch360/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "APROGSYS", "support_website_url": "https://github.com/freeKC/Immuch360/issues", "website_url": "https://github.com/freeKC/Immuch360", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "pt_BR", "pt", "nl", "ja", "ko", "ru", "pl", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1384208444774043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1144048694950627"}]}, "baseline_offer": {"id": "1144048694950627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791386880, "status": "PUBLISHED", "id": "1144048694950627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431200003408220", "version": "3.3.0-rc.0-immuch360"}, "id": "1117305917438653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431200003408220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 31. Library, Drone: watch the live video of a DJI drone that an Android phone with Immuch360 receives from its RC-N3 remote, on the same Wi-Fi. Pick the phone and type its code once. The picture shows in a window, and \"Open the flight view\" puts it large in front of you, with battery, height, speeds and distance below beside it and a translucent circle glowing toward a close obstacle. The phone gives the headset a key picture when it joins, so the picture no longer stays on \"No picture yet\"; checked on a Quest 3 with a test program, not yet with the drone. If the middle of the video goes dark in the flight view, choose \"Frame at the edges\" in the window menu. Notes over the picture fade after five seconds; any button brings them back. These pages follow the app's language. Watching only: nothing in the headset can move the drone, and its values are not compared with DJI Fly yet.", "created_date": 1793043473, "id": "1440712595790294", "version": "3.3.0-rc.0-immuch360", "version_code": 3030029, "release_status": "PENDING", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431200003408220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792789952, "id": "1433315096530044", "version": "3.3.0-rc.0-immuch360", "version_code": 3030027, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431200003408220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Sign in with your phone: the headset shows a code; type it in Immuch360 on your phone (Settings, Connect a TV or computer, Enter a code instead), check that both show the same number, and Sign in opens your library in the headset. The code works once, on your home network. Rotate, in the photo viewer, turns a flat photo by 90\u00b0 (a long press turns it the other way): through the server for your own photos on Immich 2.6 or later, on the headset for the others. 360\u00b0, 180\u00b0 and 3D photos never turn. Network share videos hide their name and controls after 5 seconds of play; a click brings them back. A video that cannot play now says why instead of loading forever. Experimental: a DJI link page in Network shares reads a DJI remote controller plugged in with a USB cable, receive only. The Licenses page lists libsmb2 and the libraries of the phone sign in.", "created_date": 1792707847, "id": "1431200003408220", "version": "3.3.0-rc.0-immuch360", "version_code": 3030026, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431200003408220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 27: Rotate turns a flat photo by 90\u00b0 (long press: the other way); 360\u00b0, 180\u00b0 and 3D photos never turn. Network share videos hide their name and controls after 5 s of play. A video that cannot play says why. The Licenses page lists libsmb2.", "created_date": 1792671231, "id": "1430192316842322", "version": "3.3.0-rc.0-immuch360", "version_code": 3030025, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431200003408220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Immuch360 build 25 (3030023): the app opens on a welcome page. Use without a server shows the headset's own photos and videos, Add a network share or a media server opens the network shares, and Connect to an Immich server opens the login page; Back returns to the welcome page, and signing out leads there too.", "created_date": 1792328484, "id": "1422575844270636", "version": "3.3.0-rc.0-immuch360", "version_code": 3030023, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
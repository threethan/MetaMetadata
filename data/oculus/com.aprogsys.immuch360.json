G5GwEbz6YEqKqnzb28DU2nPn03C-bizb2XcLd3Q&oe=6AF72A1A"}, {"file_name": "image.png", "id": "1093306143605557", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1093306150272223_2245350156710606234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIWvEoKmk0QQ7kNvwHuZ-nf&_nc_oc=AdrtfxpTxq0PspCA9pPAeA06fKpbCloO65AHUCrQTCtEKuL7R2qxclHatYDJvFAol8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8uvs3jxeandHVWjigZtJPafojpgx7b_wQXiRjMtXY8g&oe=6AF71944"}, {"file_name": "icon_v2.png", "id": "1074903662027114", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_1074903665360447_5184646207098498388_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_wOq0VhmWMQ7kNvwHWDpXs&_nc_oc=AdpC2mUNrMJy4p4WyYB5I66mdZd_F4BmVDkDFDEO3xvEvvuTpP7MsifqmRBywe-Zz_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLpAsWpzyIomPaoVc9z9VUwsLABa3KxSMoYXQj1fIDKQ&oe=6AF71689"}]}, "id": "2405673586907601", "locale": "en_US", "screenshots": [{"file_name": "immuch360_09.png", "id": "3038810526469555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_3038810529802888_876632702843814760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5PTVNQwm-wQ7kNvwHZT8Qh&_nc_oc=Adp4LmrfgBBgxxoNRFY4vKXWADPUUy3UYnfoVisg6zYN1Q-76SUZoqOee_5slD4qYCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4LXrVBi-LpGngpEQvGeoc1A1nj-_sgwu_6WLIF6HVlw&oe=6AF72A0D"}, {"file_name": "immuch360_08.png", "id": "1742851700100364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1742851706767030_5664910117266848483_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-FzGtUtAAQQ7kNvwEGfLwP&_nc_oc=AdrNEK4bXoFmdAb-mUJgpk5cGIpALy1jTehN3VduVQps7qsMOZrfvqXv3Dw5UAkQNSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM-UcN-4xHTBpFbG29lPjH9jLAM2n1w0ioaBBd8wlaWA&oe=6AF720A1"}, {"file_name": "immuch360_11.png", "id": "1612725050499944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1612725060499943_6240200173643163428_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bjZ05i34J0Q7kNvwEuPxMQ&_nc_oc=AdqwZvEIAJkA0hebgcqBfsUpsuXYA5gAehvDzTTdMwDaZ_2Aknxtrd1_zqhA7c23a8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_p0MDPNZx__1yKT3Rf5CCqjlOEermR3YBXhV9Y4PX2g&oe=6AF7228C"}, {"file_name": "immuch360_04.png", "id": "1638280761253739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1638280767920405_5866046994056952494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzlPRvtN4AQ7kNvwHD4FtT&_nc_oc=AdoqetBHkNNE7CIztfkZwQ0A0BdXCfYyLgrkP9opOBeW50eDHoKyPiroU_TAF3bL6Hs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7hTgqGGJm08BvrGoMu_NKixYAd9r6VE7AHSNopBdWOw&oe=6AF74C5B"}, {"file_name": "immuch360_02.png", "id": "1652601786497275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1652601793163941_1074964103630961921_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH64uqlH7z4Q7kNvwFmrc6g&_nc_oc=AdrvJDfAkbCY7jAf3fsbiKmveszLw8LqVljMWFAOwhTSqz-TlGOy3-ct_1LeFAdgITg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkI1WUMTRkLV_rMjvKOXcOcfMLR-84hv8aiQ82cdqEyA&oe=6AF73F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immuch360", "keywords": ["360", "photo", "video", "VR180", "Immich"], "long_description": "Immuch360 is the Immich mobile app with the missing parts for 360\u00b0 media, built for the Quest 3 and 3S. Press the 360\u00b0 button on a 360\u00b0 photo or video and look around by turning your head. Stereoscopic files (top and bottom, side by side) are shown in true 3D, and VR180 files are drawn on a half sphere.\n\nIt is also a free media player. Flat, 360\u00b0, 3D and VR180 photos and videos play from three sources: your Immich server, the headset's own media (Use without a server on the login page, no account needed), and a NAS or a computer over Samba (SMB) or WebDAV, read live, nothing copied. In the immersive view, the info panel and the controllers give you a time bar with 10 second skips, previous and next media without leaving the view, play and pause, the 3D layout, 360\u00b0 or 180\u00b0, and a Turn button.\n\nEverything else is Immich, unchanged: timeline, albums, search, sharing, and the backup of the headset's captures to your server.\n\nControls: B or Y goes back to the app window; the trigger plays or pauses; A, X or the grip shows or hides the panel; thumbstick left or right goes to the previous or next media; up or down skips 10 seconds in a video or turns a photo by 90 degrees.\n\nImmuch360 is an unofficial, open source fork of the Immich mobile app, not affiliated with Immich or FUTO. Only stitched equirectangular files are shown as spheres (exports of the Insta360 app or Studio, GoPro Player, Ricoh Theta, phone photo spheres); raw camera files still show flat.", "short_description": "360\u00b0 photos and videos from your Immich server, your headset or a NAS share, in true 3D and VR180. A free media player for flat, 360\u00b0, 3D and VR180 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/freeKC/Immuch360/blob/immuch360/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "APROGSYS", "support_website_url": "https://github.com/freeKC/Immuch360/issues", "website_url": "https://github.com/freeKC/Immuch360", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "pt_BR", "pt", "nl", "ja", "ko", "ru", "pl", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1384208444774043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1144048694950627"}]}, "baseline_offer": {"id": "1144048694950627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791386880, "status": "PUBLISHED", "id": "1144048694950627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1467614183100135", "version": "3.3.0-rc.0-immuch360"}, "id": "1117305917438653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1467614183100135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 42. Splat scenes made on a computer in the Detailed or Maximum quality (experimental) come with a copy for the headset, which opens as any splat file. 360\u00b0 panoramas are made on 8 GB graphics cards too. Fixes.", "created_date": 1794039714, "id": "1472812599246960", "version": "3.3.0-rc.0-immuch360", "version_code": 3030040, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1467614183100135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 41. Gaussian splats on Meta Quest 3 and 3S (experimental): a splat photo of your Immich timeline opens as a splat file does, Save to Immich keeps a scene there, and the splat scenes Immuch360 makes on a computer open too.", "created_date": 1793852743, "id": "1467614183100135", "version": "3.3.0-rc.0-immuch360", "version_code": 3030039, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1467614183100135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Gaussian splats on Meta Quest 3 and 3S (experimental), turned with the right thumbstick. Films pick up where you stopped. Browse a folder. TIFF photos. Videos start sooner and say why they wait. Kiosk mode and flat 3D screens (experimental).", "created_date": 1793554364, "id": "1459164257278461", "version": "3.3.0-rc.0-immuch360", "version_code": 3030038, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1467614183100135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 32. AI relief: on a Quest 3 or 3S, the \"AI relief\" button of a flat photo has the headset estimate its relief and show it in 3D; the model (99.5 MB) downloads the first time you press it. \"Open AI reliefs in 2.5D (experimental)\" moves near objects in front of the background as you move your head. Quest 2 and Quest Pro: greyed until \"AI relief on Quest 2 and Quest Pro (untested)\" is on. 3D scenes made by Immuch360 on a computer open in your room: left thumbstick to glide, a thumbstick click to reset, B or Y to go back. Generated 360\u00b0 panoramas open facing the original photo, with \"Generated by AI beyond the photo's edges\". Every AI version says what is estimated or invented. These pages follow the app's language.", "created_date": 1793274450, "id": "1448432825018271", "version": "3.3.0-rc.0-immuch360", "version_code": 3030030, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1467614183100135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 31. Library, Drone: watch the live video of a DJI drone that an Android phone with Immuch360 receives from its RC-N3 remote, on the same Wi-Fi. Pick the phone and type its code once. The picture shows in a window, and \"Open the flight view\" puts it large in front of you, with battery, height, speeds and distance below beside it and a translucent circle glowing toward a close obstacle. The phone gives the headset a key picture when it joins, so the picture no longer stays on \"No picture yet\"; checked on a Quest 3 with a test program, not yet with the drone. If the middle of the video goes dark in the flight view, choose \"Frame at the edges\" in the window menu. Notes over the picture fade after five seconds; any button brings them back. These pages follow the app's language. Watching only: nothing in the headset can move the drone, and its values are not compared with DJI Fly yet.", "created_date": 1793043473, "id": "1440712595790294", "version": "3.3.0-rc.0-immuch360", "version_code": 3030029, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
07&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5PTVNQwm-wQ7kNvwG9CYH6&_nc_oc=AdqHBiqvOhnRdmUTCYDiyUhtF-pSNp4YHclnD0c3wRPVsTQBQacf-wwhLQpKSL-Sq_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROVDQiREK6pU_aS0rWoD5My0cpbzNieBMo91_iDMAKYg&oe=6AF87B8D"}, {"file_name": "immuch360_08.png", "id": "1742851700100364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1742851706767030_5664910117266848483_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-FzGtUtAAQQ7kNvwFQiR_y&_nc_oc=AdqpOjgyqHWf7GLqjzFy-Z5M63cARgv2NFJfAF4KZHnbh-przRvGpZvUZarf52uUOEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLi8BFBiYKBXDUhAW2tgXECmvSN5WGyQv8sF9KO4XX-Q&oe=6AF8AA61"}, {"file_name": "immuch360_11.png", "id": "1612725050499944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1612725060499943_6240200173643163428_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bjZ05i34J0Q7kNvwGSomra&_nc_oc=Adqs-2Wbl07cbkkxW4lVqKaaFqbjrTcgPqL1lEOXV_JdP2WiqfS7YaJC9iDUOTWX1Ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk8T1SDDfw7lDYdAg4Y3J1OiHvjO1zgLP5_Y2xb2y2tQ&oe=6AF8AC4C"}, {"file_name": "immuch360_04.png", "id": "1638280761253739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1638280767920405_5866046994056952494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf3Z9rp4CgoQ7kNvwH5NqO_&_nc_oc=AdrWUw9V6zv-57f7PLZ0t61_QiXUuV2YaoBTahGFXGg3CL894C_zjG2DC4DQO4vTIOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVD-5dHigPS7gc4y9uyiQwZMgNddy4hflElUmwOfFrSg&oe=6AF89DDB"}, {"file_name": "immuch360_02.png", "id": "1652601786497275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1652601793163941_1074964103630961921_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH64uqlH7z4Q7kNvwGOPq_V&_nc_oc=AdoAskM0GMlCXzGNpA-NjaV2EYLYfRxI_2sN5O48JNL7KwbuE7PMCRvmvd4EDDGMTMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRehhahxHxqrFgiywrn7FdctXHuT2J6GlENysO2vG-XXA&oe=6AF890BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immuch360", "keywords": ["360", "photo", "video", "VR180", "Immich"], "long_description": "Immuch360 is the Immich mobile app with the missing parts for 360\u00b0 media, built for the Quest 3 and 3S. Press the 360\u00b0 button on a 360\u00b0 photo or video and look around by turning your head. Stereoscopic files (top and bottom, side by side) are shown in true 3D, and VR180 files are drawn on a half sphere.\n\nIt is also a free media player. Flat, 360\u00b0, 3D and VR180 photos and videos play from three sources: your Immich server, the headset's own media (Use without a server on the login page, no account needed), and a NAS or a computer over Samba (SMB) or WebDAV, read live, nothing copied. In the immersive view, the info panel and the controllers give you a time bar with 10 second skips, previous and next media without leaving the view, play and pause, the 3D layout, 360\u00b0 or 180\u00b0, and a Turn button.\n\nEverything else is Immich, unchanged: timeline, albums, search, sharing, and the backup of the headset's captures to your server.\n\nControls: B or Y goes back to the app window; the trigger plays or pauses; A, X or the grip shows or hides the panel; thumbstick left or right goes to the previous or next media; up or down skips 10 seconds in a video or turns a photo by 90 degrees.\n\nImmuch360 is an unofficial, open source fork of the Immich mobile app, not affiliated with Immich or FUTO. Only stitched equirectangular files are shown as spheres (exports of the Insta360 app or Studio, GoPro Player, Ricoh Theta, phone photo spheres); raw camera files still show flat.", "short_description": "360\u00b0 photos and videos from your Immich server, your headset or a NAS share, in true 3D and VR180. A free media player for flat, 360\u00b0, 3D and VR180 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/freeKC/Immuch360/blob/immuch360/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "APROGSYS", "support_website_url": "https://github.com/freeKC/Immuch360/issues", "website_url": "https://github.com/freeKC/Immuch360", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "pt_BR", "pt", "nl", "ja", "ko", "ru", "pl", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1384208444774043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1144048694950627"}]}, "baseline_offer": {"id": "1144048694950627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791386880, "status": "PUBLISHED", "id": "1144048694950627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1472812599246960", "version": "3.3.0-rc.0-immuch360"}, "id": "1117305917438653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472812599246960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 44. Splats of up to 300,000 gaussians, 1,000,000 with Large splats. The Update button opens this store page. Changes against reported crashes. The app's site is immuch360.com. Everything of build 43 is included.", "created_date": 1794258745, "id": "1478145088713711", "version": "3.3.0-rc.0-immuch360", "version_code": 3030042, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472812599246960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 42. Splat scenes made on a computer in the Detailed or Maximum quality (experimental) come with a copy for the headset, which opens as any splat file. 360\u00b0 panoramas are made on 8 GB graphics cards too. Fixes.", "created_date": 1794039714, "id": "1472812599246960", "version": "3.3.0-rc.0-immuch360", "version_code": 3030040, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472812599246960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 41. Gaussian splats on Meta Quest 3 and 3S (experimental): a splat photo of your Immich timeline opens as a splat file does, Save to Immich keeps a scene there, and the splat scenes Immuch360 makes on a computer open too.", "created_date": 1793852743, "id": "1467614183100135", "version": "3.3.0-rc.0-immuch360", "version_code": 3030039, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472812599246960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Gaussian splats on Meta Quest 3 and 3S (experimental), turned with the right thumbstick. Films pick up where you stopped. Browse a folder. TIFF photos. Videos start sooner and say why they wait. Kiosk mode and flat 3D screens (experimental).", "created_date": 1793554364, "id": "1459164257278461", "version": "3.3.0-rc.0-immuch360", "version_code": 3030038, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1384208401440714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472812599246960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117305917438653"}]}, "change_log": "Build 32. AI relief: on a Quest 3 or 3S, the \"AI relief\" button of a flat photo has the headset estimate its relief and show it in 3D; the model (99.5 MB) downloads the first time you press it. \"Open AI reliefs in 2.5D (experimental)\" moves near objects in front of the background as you move your head. Quest 2 and Quest Pro: greyed until \"AI relief on Quest 2 and Quest Pro (untested)\" is on. 3D scenes made by Immuch360 on a computer open in your room: left thumbstick to glide, a thumbstick click to reset, B or Y to go back. Generated 360\u00b0 panoramas open facing the original photo, with \"Generated by AI beyond the photo's edges\". Every AI version says what is estimated or invented. These pages follow the app's language.", "created_date": 1793274450, "id": "1448432825018271", "version": "3.3.0-rc.0-immuch360", "version_code": 3030030, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
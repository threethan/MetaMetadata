&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc0uzVWvQwUQ7kNvwED1m-2&_nc_oc=AdrorMG1y7jvUMcmQk4Z7n56bs2tBy2K41c2OVvLV2nzk1m7FqvUT0FnvP7f_diMCQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKJ0u8ubHoYu0j-2vfCesxgcDmX49KWgHZO4P-9Ox54g&oe=6B106561"}, {"file_name": "immuch360_11.png", "id": "1612725050499944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1612725060499943_6240200173643163428_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlO5MTZLMI0Q7kNvwGjj0UR&_nc_oc=AdogHMmsrLWnhWUGG8bBjG3AI3wzR4fWrTok2Jz86C5ZhOmx5RDqJe3jpHj7nnbnv9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXE4oPabwluDk-NjfsoOF5EmESQjx38I-LBMQoNyRnkZA&oe=6B10674C"}, {"file_name": "immuch360_04.png", "id": "1638280761253739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1638280767920405_5866046994056952494_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XsBL-fTxHkQ7kNvwGA9zKg&_nc_oc=AdoiX_f6mVU476ElmnwQzRRQ_daV-14YvZ4vcsWObY4friipytaPdGxQqt7AilH66p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWssVeLwPKSk4iAjW-3x0G6BKkfr1ZUfsMPfx7Gm7YLgw&oe=6B1058DB"}, {"file_name": "immuch360_02.png", "id": "1652601786497275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1652601793163941_1074964103630961921_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlSb3Lomc1YQ7kNvwE0l-02&_nc_oc=AdpFkCYCH85bnEEri8lOMXsY_wnamD9eBPWoMe176JeYbGfLqGaZTUIExKhIX60V7yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWh3w3sd-uD8cSUVGef7RvWbLCLogHGOeHHMrKSJU8ljw&oe=6B104BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immuch360", "keywords": ["360", "photo", "video", "VR180", "Immich"], "long_description": "Immuch360 is the Immich mobile app with the missing parts for 360\u00b0 media, built for the Quest 3 and 3S. Press the 360\u00b0 button on a 360\u00b0 photo or video and look around by turning your head. Stereoscopic files (top and bottom, side by side) are shown in true 3D, and VR180 files are drawn on a half sphere.\n\nIt is also a free media player. Flat, 360\u00b0, 3D and VR180 photos and videos play from three sources: your Immich server, the headset's own media (Use without a server on the login page, no account needed), and a NAS or a computer over Samba (SMB) or WebDAV, read live, nothing copied. In the immersive view, the info panel and the controllers give you a time bar with 10 second skips, previous and next media without leaving the view, play and pause, the 3D layout, 360\u00b0 or 180\u00b0, and a Turn button.\n\nEverything else is Immich, unchanged: timeline, albums, search, sharing, and the backup of the headset's captures to your server.\n\nControls: B or Y goes back to the app window; the trigger plays or pauses; A, X or the grip shows or hides the panel; thumbstick left or right goes to the previous or next media; up or down skips 10 seconds in a video or turns a photo by 90 degrees.\n\nImmuch360 is an unofficial, open source fork of the Immich mobile app, not affiliated with Immich or FUTO. Only stitched equirectangular files are shown as spheres (exports of the Insta360 app or Studio, GoPro Player, Ricoh Theta, phone photo spheres); raw camera files still show flat.", "short_description": "360\u00b0 photos and videos from your Immich server, your headset or a NAS share, in true 3D and VR180. A free media player for flat, 360\u00b0, 3D and VR180 files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/freeKC/Immuch360/blob/immuch360/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "APROGSYS", "support_website_url": "https://github.com/freeKC/Immuch360/issues", "website_url": "https://github.com/freeKC/Immuch360", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619078_2555978644842931_3186955565688146739_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxjzBukn0PIQ7kNvwGpRF79&_nc_oc=AdpEiCyb2jJM8IIaBgnsKBz4sDEIEzAQr39g4VqVCN2F67b_7tBeMCEo4UIYSiwJDKM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyGKCiZOIwZ0iIlTnsSDm2WerAqBquEX1djSfd89yFUg&oe=6AA02B19"}, {"file_name": "891d42701c1e437aa16b879ddc5f4c56.png", "id": "1661058571661568", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_1661058574994901_7164276685776265064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJwdS7pduCwQ7kNvwGau319&_nc_oc=Ado54JcgAeyDujL9ffxTJdASaTpp6YUB_f_iUrWr7WasmOXXT65K4VLp2NpwEgFAI3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOfJrb1P2fpCCqjMlHSsTX7tHZlpGV_b58stCVUM8Lzg&oe=6AA0137B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2211767243088065", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619382_2211767249754731_2914085213285845645_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe-P3hlqSbcQ7kNvwHnb8Li&_nc_oc=Adp5S6Ku4YrXWyOgR4gccEHIjPF2qm93qAFp5XHiuMPDPylpt6OUuwTCx6TNFZi31z8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIYf6nBX8pnlkAOrSsDS_r-Pkk1wYMWcPYIzh9bw76Sg&oe=6AA028D6"}, "display_name": "Uchi, Kuru?", "keywords": ["vroid", "girl", "youtube", "Othello", "mahjong"], "long_description": "\"Uchi, Kuru?\" (Wanna Come Over?) brings VRoid Hub characters into your real room in mixed reality.\n\nThrough passthrough your everyday room stays visible \u2014 and a character walks in, sits on your furniture, and chats with you. Let her wander, offer her a stool, or just relax side by side. Sign in to VRoid Hub and summon your own models or any model you've hearted (subject to each model's usage conditions).\n\n- 3 bundled characters: meet them right after install\n- VRoid Hub integration: summon your own or available hearted models\n- Watch YouTube together: float a TV in your room and watch side by side\n- Close enough to touch: pat her head, hold hands, offer her a seat\n\nAdd-ons (in-app purchases):\n- Remote Desktop: float your Mac's screen in the room and work while she keeps you company (free Mac server app)\n- Mahjong: full four-player riichi mahjong with calls, kan, riichi and ura dora\n- Game Set: Reversi, Old Maid and chess, with the characters as your opponents\n- Full Pack: everything above\n\nThe app supports Japanese and English. Character dialogue follows your language setting.\n\nCredits: Character animation: VRoid Project, pixiv Inc. / Animations: Adobe Mixamo", "short_description": "Your VRoid characters, living in your room. Through passthrough they walk your actual room, sit on a stool, and chat with you. Pat their heads, hold hands, watch YouTube and play board games together. Summon your own VRoid Hub models or hearted ones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sticker.github.io/uchikuru/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nice Sticker", "support_website_url": "https://sticker.github.io/uchikuru/#contact", "website_url": "https://sticker.github.io/uchikuru/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1640026131025991"}, "review_mes
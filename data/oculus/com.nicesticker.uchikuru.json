1d42701c1e437aa16b879ddc5f4c56.png", "id": "1661058571661568", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620817_1661058574994901_7164276685776265064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwJP9eulmbsQ7kNvwHyZOyY&_nc_oc=Adr8n8y2523xODyEJXxhvWRinbjHbZbtdOmNrDNwL-nEZm8H5CRPacAmmJnoiKSt7j4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOkNDsUxZ645aIozvDOTzb3HqQAccca0iV8LMbXi-0aQ&oe=6A97497B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2211767243088065", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619382_2211767249754731_2914085213285845645_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4siGz6AoqQQ7kNvwGcE76r&_nc_oc=AdpAlvoWEaX1_OIGEHh9U0j0h5jLZwQ094YQihIXeo86xAq-P4ScZqshu6nEUUjT7Yc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHgSTMde9nfT0wcpUqiKY87neszCEweLhWZtTpWC6NSA&oe=6A972696"}, "display_name": "Uchi, Kuru?", "keywords": ["vroid", "girl", "youtube", "Othello", "mahjong"], "long_description": "\"Uchi, Kuru?\" (Wanna Come Over?) brings VRoid Hub characters into your real room in mixed reality.\n\nThrough passthrough your everyday room stays visible \u2014 and a character walks in, sits on your furniture, and chats with you. Let her wander, offer her a stool, or just relax side by side. Sign in to VRoid Hub and summon your own models or any model you've hearted (subject to each model's usage conditions).\n\n- 3 bundled characters: meet them right after install\n- VRoid Hub integration: summon your own or available hearted models\n- Watch YouTube together: float a TV in your room and watch side by side\n- Close enough to touch: pat her head, hold hands, offer her a seat\n\nAdd-ons (in-app purchases):\n- Remote Desktop: float your Mac's screen in the room and work while she keeps you company (free Mac server app)\n- Mahjong: full four-player riichi mahjong with calls, kan, riichi and ura dora\n- Game Set: Reversi, Old Maid and chess, with the characters as your opponents\n- Full Pack: everything above\n\nThe app supports Japanese and English. Character dialogue follows your language setting.\n\nCredits: Character animation: VRoid Project, pixiv Inc. / Animations: Adobe Mixamo", "short_description": "Your VRoid characters, living in your room. Through passthrough they walk your actual room, sit on a stool, and chat with you. Pat their heads, hold hands, watch YouTube and play board games together. Summon your own VRoid Hub models or hearted ones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sticker.github.io/uchikuru/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nice Sticker", "support_website_url": "https://sticker.github.io/uchikuru/#contact", "website_url": "https://sticker.github.io/uchikuru/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1630153608679910"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499624583_914083481755045_8402468153738246956_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8O0ZxVj57QQ7kNvwE6LL6F&_nc_oc=AdpRTPvrcneg5bYYVirTGb9Moy7bPf6Eba6JeCNS2hey4q5LBhP4GaEJiUaMFVE_axA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXqawiAabBV
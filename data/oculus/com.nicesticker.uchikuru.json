Ic38p9XnUahjRxULF4xisG6h9P1YDTLXMAr2LyH-2fLg&oe=6A9EC1FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1492691399209822", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1492691402543155_5815018219687080262_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9yC4Zn5zDwQ7kNvwErnrQr&_nc_oc=AdoBQXlqHGOjA05IW7IyZxngeosivuDjlT_jOAvpvfPQotsHyBAefzbZtt1lK1xYAiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz6IZp9uoT26Tn-C1pWI7P7aqlvlumYBfm-U6PJcXvig&oe=6A9EBD38"}, "display_name": "Uchi, Kuru?", "keywords": [], "long_description": "\"Uchi, Kuru?\" (Wanna Come Over?) brings VRoid Hub characters into your real room in mixed reality.\n\nThrough passthrough your everyday room stays visible \u2014 and a character walks in, sits on your furniture, and chats with you. Let her wander, offer her a stool, or just relax side by side. Sign in to VRoid Hub and summon your own models or any model you've hearted (subject to each model's usage conditions).\n\n- 3 bundled characters: meet them right after install\n- VRoid Hub integration: summon your own or available hearted models\n- Watch YouTube together: float a TV in your room and watch side by side\n- Close enough to touch: pat her head, hold hands, offer her a seat\n\nAdd-ons (in-app purchases):\n- Remote Desktop: float your Mac's screen in the room and work while she keeps you company (free Mac server app)\n- Mahjong: full four-player riichi mahjong with calls, kan, riichi and ura dora\n- Game Set: Reversi, Old Maid and chess, with the characters as your opponents\n- Full Pack: everything above\n\nThe app supports Japanese and English. Character dialogue follows your language setting.\n\nCredits: Character animation: VRoid Project, pixiv Inc. / Animations: Adobe Mixamo", "short_description": "Your VRoid characters, living in your room. Through passthrough they walk your actual room, sit on a stool, and chat with you. Pat their heads, hold hands, watch YouTube and play board games together. Summon your own VRoid Hub models or hearted ones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sticker.github.io/uchikuru/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nice Sticker", "support_website_url": "https://sticker.github.io/uchikuru/#contact", "website_url": "https://sticker.github.io/uchikuru/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1601758808186057"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "27554958504175109"}]}, "baseline_offer": {"id": "27554958504175109"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787288820, "status": "PUBLISHED", "id": "27554958504175109"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1640014931027111", "version": "1.2"}, "id": "2102245777833216", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1601758804852724", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1640014931027111"}, "release_status": "RELEASED"}, "binary_rel
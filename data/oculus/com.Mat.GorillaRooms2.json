2coZNe-mw&oe=6ABA8E8C"}, {"file_name": "Main_Scene_Custom..._12.09.2026_11-13-58.png", "id": "1334868635387683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604385997_1334868638721016_2383374324668696343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZz0o6j6J-UQ7kNvwGoQyOj&_nc_oc=AdomB_pwelmISqIh1hfIL4dNdULYItKNpN9b0y0-CihN7EX-O-HMoKR3rZnpatSjES8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1PDh2aqNIO422U9OjLKPHuSspZUXKvoFMz9JGlx1O4Q&oe=6ABA6F68"}, {"file_name": "Main_Scene_Custom..._12.09.2026_11-21-58.png", "id": "1956335489027579", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596068480_1956335492360912_1124545892435771756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSTMWWpuRaIQ7kNvwGSOgDu&_nc_oc=AdrnWX5HNTFxqayJe6lzfVavD5kg74ZXJbyTMyb-Te9Lxe1DI353MYZmu9L8WJpHuDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjYfc8eBxlKR1xOujn-ks8J_xdpdaCxFSYInjCtjlMqA&oe=6ABA756B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Huss Rooms", "keywords": ["Rooms", "Backrooms", "Huss", "VR"], "long_description": "# Huss Rooms\n\nAn action packed gorilla movement fangame set in the Backrooms universe.\n\n**Huss Rooms** takes the gorilla movement you know and drops you into the Backrooms \u2014 an endless network of shifting levels, from the buzzing fluorescent halls of the Lobby to the Poolrooms and beyond. Explore with friends, find your way between levels, and watch out for what's lurking in the walls.\n\n# Features\n\n- **Multiple levels** \u2014 explore different Backrooms areas, including the iconic Level 0, Poolrooms, and Train Station\n- **Gorilla-style movement** \u2014 climb, swing, and move using the same physical mechanics you already know\n- **Multiplayer co-op** \u2014 team up with friends to explore and survive together\n- **Level transitions** \u2014 find hidden ways to move between levels as you go\n\n# The Rules Are Simple...\n\nStick together. Watch your step. Keep exploring.\n\nHow deep into the Huss Rooms can you go?", "short_description": "Huss Rooms is a action packed fangame that takes the movement and multiplayer spirit you know and drops it into the Backrooms \u2014 an endless, shifting maze of levels. Start in the buzzing fluorescent halls of Level 0, then find your way into the Poolrooms, the Train Station, and beyond. Using the same climbing and swinging movement mechanics you already know, team up with friends to explore each level, uncover hidden transitions, and see how deep into the Huss Rooms you can go together."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillagamesinc-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "Mat", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillagamesinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28755737907397971"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673645340_2293281777872252_6804103900457812061_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMSajBE27ugQ7kNvwE9oo06&_nc_oc=AdqQuEfmJ5s-lvaV98MMBmSFj-MLoyPuvhkRUKx5Ced5NSYTsk5_0IreMwtefWpIMH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&
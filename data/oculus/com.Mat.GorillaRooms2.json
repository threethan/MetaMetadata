-UXFShysLe_gLkT4QbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9_FOZ5sTqFxSseW3666WlKgLdftqNUq791Q4c_VVgwA&oe=6B09BDCA"}, {"file_name": "Main_Scene_Custom..._22.10.2026_14-45-45.png", "id": "1617369623265744", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830822_1617369626599077_6321874863820869131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jj9uPWr_OwQ7kNvwF7JBfi&_nc_oc=Adq8gtEeUzpWcmLNVGE4SzSWwYRUZl7nQLCrD2MaVyl3SCQmJ9L1mBq90yRlDJiU92A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVgoG8RndJGt-Dgmi3igMcCzEDqdLu9wk-fmEODLB7PQ&oe=6B09C4D7"}, {"file_name": "Main_Scene_Custom..._22.10.2026_14-44-05.png", "id": "2386725105474715", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673652249_2386725112141381_7970903915709867677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaApjcXTbuQQ7kNvwHPu6k3&_nc_oc=Adrf_Ay7ggpfMdoz48y5Q7bIXmvi1X2V4xqFGSKAnCZs4OFhOrefqYfySAY5D8L09VQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnDC4qaeXzzuI9L2tknO8caMLmgH6yZvulgV1cluGAUA&oe=6B09CDA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUSSROOMS (2).png", "id": "1668849724672757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1668849728006090_453452789531090341_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4UlFoA9uJ8Q7kNvwFfr_b5&_nc_oc=AdpPhs4ig_wcPt1VqsAIV7JedBawCjmQHZQsyI910n2D2BdXNC7CMhtTV9P0moC7UjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrAQBDUieACPpiFTzbGNpNj1IsZmQx5PSQ_s1Mo6rRYg&oe=6B099B82"}, "display_name": "Huss Rooms", "keywords": ["Backrooms", "Huss", "VR", "Gorilla", "Rooms"], "long_description": "# Huss Rooms\n\nAn action packed gorilla movement fangame set in the Backrooms universe.\n\n**Huss Rooms VR** takes the gorilla movement you know and drops you into the Backrooms \u2014 an endless network of shifting levels, from the buzzing fluorescent halls of the Lobby to the Poolrooms and beyond. Explore with friends, find your way between levels, and watch out for what's lurking in the walls.\n\n# Features\n\n- **Multiple levels** \u2014 explore different Backrooms areas, including the iconic Level 0, Poolrooms, and Train Station\n- **Gorilla-style movement** \u2014 climb, swing, and move using the same physical mechanics you already know\n- **Multiplayer co-op** \u2014 team up with friends to explore and survive together\n- **Level transitions** \u2014 find hidden ways to move between levels as you go\n\n# The Rules Are Simple...\n\nStick together. Watch your step. Keep exploring.\n\nHow deep into the Huss Rooms can you go?", "short_description": "Huss Rooms VR is a action packed fangame that takes the movement and multiplayer spirit you know and drops it into the Backrooms \u2014 an endless, shifting maze of levels. Start in the buzzing fluorescent halls of Level 0, then find your way into the Poolrooms, the Train Station, and beyond. Using the same climbing and swinging movement mechanics you already know, team up with friends to explore each level, uncover hidden transitions, and see how deep into the Huss Rooms you can go together."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillagamesinc-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "Mat", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillagamesinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
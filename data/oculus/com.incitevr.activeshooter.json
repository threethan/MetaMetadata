0sQ7kNvwHUJnDl&_nc_oc=AdqvDqTdtNXCr6xOhg_FrrE4Kk--bcgiQfOx9qgdHpNdKqRzZA0XsxrMPDQe3DbNKjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJpyxJLrDDHiJmyxh7GXgOGq3j-nxSrie1GCVZ1kA_RA&oe=69C912DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "469272317826733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_469272321160066_7786037700896032275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk3Po_HlQC4Q7kNvwEd-wrz&_nc_oc=AdoD9Hb0cPsDrwa8movy8O6mgPquNJnpLqWqKzGfZQHedNeZzWzT_L4owJlT8BYEc9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBIc1ziNDJMeF0ozcVuMbEq2E_hzScOw8hpFMD8AfH1w&oe=69C91A17"}, "display_name": "Active Shooter Survival", "keywords": [], "long_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation. Active Shooter Survival delivers the closest approximation to real-life situations in which multiple highly realistic immersive learning (VR) scenarios trigger the emotions needed to create behavioral change. The human instinct to freeze or follow\u2014exactly the wrong instinct in an active shooter situation\u2014is replaced with response-ready reactions that are then second-nature in a time of crisis.", "short_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://incitevr.com/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "inciteVR", "support_website_url": null, "website_url": "https://www.incitevr.com/more/active-shooter", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_sub
fsBVauv5cHhZGCldML68ZeQI2Iu27VEvy1QJk_8UkCXbQ&oe=69A2D75F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "469272317826733", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974873_469272321160066_7786037700896032275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBNbHa6pXRgQ7kNvwHEmcMP&_nc_oc=AdkoxnOSRdXlsqzC2UEXzVl6fgAd4SLGH8jIwhFGk52aXSrPhIVTBuCntP44QusMrX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXsC3lF6Ssqh_LmORX0tUodxaMhhi3Aw_pWWIxdfTsfQ&oe=69A2DE97"}, "display_name": "Active Shooter Survival", "keywords": [], "long_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation. Active Shooter Survival delivers the closest approximation to real-life situations in which multiple highly realistic immersive learning (VR) scenarios trigger the emotions needed to create behavioral change. The human instinct to freeze or follow\u2014exactly the wrong instinct in an active shooter situation\u2014is replaced with response-ready reactions that are then second-nature in a time of crisis.", "short_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://incitevr.com/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "inciteVR", "support_website_url": null, "website_url": "https://www.incitevr.com/more/active-shooter", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommende
hoQ7kNvwFU3bLT&_nc_oc=AdqxfAygBPcWnaZNy6rtgVy-ll-rP_wnSoNfr6dieOSIYTSAVHNtdWYLicqeYid_T_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2ilLc7SXAA97QLRCBz8v5g8baY56ftWpqsqf6l8cfAw&oe=6A7C5EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "469272317826733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_469272321160066_7786037700896032275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqS78eqaDoYQ7kNvwHJbjQt&_nc_oc=AdoGGKvH0GTWdW8Vrr4-x3B_4bNOacm3AcYqfCBWqDUlegCwTI5DxyFxAJrXn3S2Me4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqSMREMjxzpe0_AZKlc_V-4J34eh20z9VdFbGUmgxpKA&oe=6A7C6617"}, "display_name": "Active Shooter Survival", "keywords": [], "long_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation. Active Shooter Survival delivers the closest approximation to real-life situations in which multiple highly realistic immersive learning (VR) scenarios trigger the emotions needed to create behavioral change. The human instinct to freeze or follow\u2014exactly the wrong instinct in an active shooter situation\u2014is replaced with response-ready reactions that are then second-nature in a time of crisis.", "short_description": "Active Shooter Survival is an Immersive Training for users to practice how to protect themselves in the event of an active shooter situation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://incitevr.com/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "inciteVR", "support_website_url": null, "website_url": "https://www.incitevr.com/more/active-shooter", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_sub
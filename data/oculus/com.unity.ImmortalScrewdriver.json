F5pShT&_nc_oc=AdleFRe5zESbcTsEQ2qmJUFz9JHd12VXA65oKEHSvX9WrWtrymxZRsmVn9vaQztrhHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOKLnnHG76KpniwucLIOfbFPP-tzH-Vwk3sgSnnSS00g&oe=69B95A2F"}, {"file_name": "Blasters.png", "id": "1517708718921380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984458_1517708722254713_6437726061758495295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRuOs1CdSiUQ7kNvwG3rN4p&_nc_oc=AdnV_Fwb6i_pz_SvkJfy25nNqLn6kLj4egZbo-rFn4wSwRpU3hr-KNNtVxnc-K60TrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBioWr1R-dsN7XrsYVH8JNpzJu0vJ1GBzQ2ZkrKJL7nw&oe=69B9344F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScrewdriverCoverImage.png", "id": "1022431369640043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035469_1022431372973376_1294702831192715919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae84wgztedsQ7kNvwF8-OAF&_nc_oc=Adku5hHr3mpRzDgjPbiGUGkD3qleHq247DsHnfNE4OIqr-xakvm9hydThZCdkDjWR6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxA3RscElYkO3ropjp08Okw6Q7ljbMeSjyxbpNo5ottig&oe=69B95456"}, "display_name": "Immortal Screwdriver", "keywords": ["Space", "Horror", "Screwdriver", "Indie", "ARG"], "long_description": "The Home Station lies in ruin, a ghost of its former glory orbiting eternally in the void. As the last hope of survival, you must delve into its secrets, repair its systems, and escape its desolation. But not all is as it seems. Look beyond the station walls\u2014real ANSWERS may lie elsewhere.", "short_description": "Trapped on a crumbling space station, your only goal is to escape. Piece together the remnants of Home Station\u2019s history, solve puzzles, and navigate its haunting halls to find your way to freedom. \n\nTrust your instincts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_u
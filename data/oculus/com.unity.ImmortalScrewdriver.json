F9I82z&_nc_oc=AdnkyY8e1IXudBRqYEbuHnqX3-K3CZGtngeD35Nm_im5JeyVV245_K5P9LEwITV5Opg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-q4uu6_fk3JbY0g_uHuSbCA84YViCRZyM2gFdcru88Q&oe=69BFF1AF"}, {"file_name": "Blasters.png", "id": "1517708718921380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984458_1517708722254713_6437726061758495295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDrdLaENuqQQ7kNvwHVm1Sq&_nc_oc=AdlIM6rZEN4NA-yVi6l0d66lQAIhvLhy-5uPZkY2BiZPRnVJqtQM_MKOp7diAkedQc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlLfwY2RHyW_5GsdTp7klE2gPh_H2fF4L-0TkCtgbolg&oe=69BFCBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScrewdriverCoverImage.png", "id": "1022431369640043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035469_1022431372973376_1294702831192715919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNQX01WYwKYQ7kNvwFAZ1s5&_nc_oc=Adl-_B_Sn7mzkUZroRREYMmWkVGxX7_s58szVvsZxC9s3ZOMImRSVjd_1-kVqcTwHZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvNB3as5LKbYeNnwrV0YzZm0Akx-_vh52QxDcS7iTQwQ&oe=69BFEBD6"}, "display_name": "Immortal Screwdriver", "keywords": ["Space", "Horror", "Screwdriver", "Indie", "ARG"], "long_description": "The Home Station lies in ruin, a ghost of its former glory orbiting eternally in the void. As the last hope of survival, you must delve into its secrets, repair its systems, and escape its desolation. But not all is as it seems. Look beyond the station walls\u2014real ANSWERS may lie elsewhere.", "short_description": "Trapped on a crumbling space station, your only goal is to escape. Piece together the remnants of Home Station\u2019s history, solve puzzles, and navigate its haunting halls to find your way to freedom. \n\nTrust your instincts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_u
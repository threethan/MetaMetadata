Q7kNvwGcDOiS&_nc_oc=Adm3FuKYd_kpiLnFotH9_5b6DdCP0xzvgih87b3UMNlq6z--MIfILgoCBCjWJrUWb-w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYaIhUA3tK7l9VhWl14sU_3HXSU7w0CuM-ZLQWAE9Izw&oe=69AAD9AF"}, {"file_name": "Blasters.png", "id": "1517708718921380", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984458_1517708722254713_6437726061758495295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cceQHWpN1t4Q7kNvwGQjj1K&_nc_oc=AdkAOfkZlgcd8356XToHNY6zO8tTIZEVUOmAeylEtNQNl23mPr6NLknFP_RZ0V80Y38&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwawudR5WrSemVpkKy9eI1-Z5uCFdY--TvYKyNJUx6dbA&oe=69AAB3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScrewdriverCoverImage.png", "id": "1022431369640043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035469_1022431372973376_1294702831192715919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwRINdGysSQQ7kNvwEczpjg&_nc_oc=AdmV1ZPFn5rIIUHJ0w4vkL5TRo8_tnEL_L2B9airU7Ruuu8P2HWL7T6kFnvBPL8j1Rw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFW5Pc5rj2evDH16e40HpEus7sHVeIJ3Rv1PExoji2mA&oe=69AAD3D6"}, "display_name": "Immortal Screwdriver", "keywords": ["Space", "Horror", "Screwdriver", "Indie", "ARG"], "long_description": "The Home Station lies in ruin, a ghost of its former glory orbiting eternally in the void. As the last hope of survival, you must delve into its secrets, repair its systems, and escape its desolation. But not all is as it seems. Look beyond the station walls\u2014real ANSWERS may lie elsewhere.", "short_description": "Trapped on a crumbling space station, your only goal is to escape. Piece together the remnants of Home Station\u2019s history, solve puzzles, and navigate its haunting halls to find your way to freedom. \n\nTrust your instincts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_web
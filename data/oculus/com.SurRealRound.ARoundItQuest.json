109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-3V1c1wPjIQ7kNvwG1Juy3&_nc_oc=Adr9XpGWNksdgPrztW9vNWCNSPTWujV-nRtZO62Xjr1umxW2DBLOZ55WWTp5m5Ry70k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRf-KUDvVhH0DJYbvekkyMjELTc17Gpi8f0YJ62M_epkw&oe=6B0DC5B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "596199056307117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_596199059640450_5513978562842346331_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY7LD4pit3oQ7kNvwGtOqdx&_nc_oc=AdqEQRYotrCrsomkmzg9OOIh5veFYBzuEes1O1uKqvwGWiChSkdEYxxRRkg2_HNj3-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjUboqx10ZvOrwbLItuDYctPe_tw91f9uNkPe7ysKPyg&oe=6B0D9946"}, "display_name": "ARound'It", "keywords": ["Travel", "Social", "Restaurant", "Local"], "long_description": "Record restaurant reviews, local information, and small daily life on AR sticky notes,\nShare it in the AR space.\nGet away from the pressure of small phone screens and scrolling.\nFind useful information in real space.\nNothing special to do. Just take out your phone and scan the space with your camera and you're done!\nIt's even better because ARound'It automatically translates other users' memos even when you're in a foreign country where you don't understand the language.\nBe sure to leave tips about local information or places that only you know for others.\n\nTo use this app, please download and connect the mobile app. Currently, you can view notes in Meta Quest, but creating notes is not yet supported.", "short_description": "Record and share restaurant reviews, local tips, and daily moments on AR sticky notes. Scan spaces with your phone's camera to discover helpful info in real-world locations, free from small screens and scrolling. ARound'It translates memos automatically, making it easy to access insights even abroad. Share hidden gems and enhance your AR experience!\n\nTo use this app, please download and connect the mobile app. Currently, you can view notes in Meta Quest, but creating notes is not yet supported.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.surrealround.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SurReal Round", "support_website_url": null, "website_url": "https://www.surrealround.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "zh_CN", "zh_TW", "fr", "de", "el", "hi", "ja", "ms", "th", "tr", "uk", "vi", "sv", "es", "ru", "pt"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8877739672280382"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974912_2003739643472855_1601018382788034713_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAbl-8vn9OoQ7kNvwEONPV4&_nc_oc=AdrCdRP6Nf6Ayd-nT0nc3wG81kK54sSg0PPgOfgkwpdOxQcaF4EkKCw7GxTeFm7LLI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTutQ9n52GrSAir7JJCvmU-lV5mwZNiFUWbtD2o41YCVw&oe=6B0DAE53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARound'It", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1738076400, "lastRevision":
video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "596199056307117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_596199059640450_5513978562842346331_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rgtHv3nz5UQ7kNvwGqtQW5&_nc_oc=Adq6X7ObxQaR71g6sGQCzjC92ohnMAkxEn1_Padh5fmX3-i85TMZo5TUa38qdbvInFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo1hFhxVYCCqrQwnTrNHDi2z_U7HSXASfZdxHdzwC64g&oe=6AF33B46"}, "display_name": "ARound'It", "keywords": ["Travel", "Social", "Restaurant", "Local"], "long_description": "Record restaurant reviews, local information, and small daily life on AR sticky notes,\nShare it in the AR space.\nGet away from the pressure of small phone screens and scrolling.\nFind useful information in real space.\nNothing special to do. Just take out your phone and scan the space with your camera and you're done!\nIt's even better because ARound'It automatically translates other users' memos even when you're in a foreign country where you don't understand the language.\nBe sure to leave tips about local information or places that only you know for others.\n\nTo use this app, please download and connect the mobile app. Currently, you can view notes in Meta Quest, but creating notes is not yet supported.", "short_description": "Record and share restaurant reviews, local tips, and daily moments on AR sticky notes. Scan spaces with your phone's camera to discover helpful info in real-world locations, free from small screens and scrolling. ARound'It translates memos automatically, making it easy to access insights even abroad. Share hidden gems and enhance your AR experience!\n\nTo use this app, please download and connect the mobile app. Currently, you can view notes in Meta Quest, but creating notes is not yet supported.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.surrealround.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SurReal Round", "
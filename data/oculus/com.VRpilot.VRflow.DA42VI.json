g", "id": "9162680420441087", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974830_9162680423774420_4972795067052384814_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wstQBL3ZN6oQ7kNvwGw9jDW&_nc_oc=AdrROShjrgpklwhYczO7x4d0mb75Gr-kmk0Zj6oYbKOKLiVG47y5kXZJ-rHiwkdXmsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGfxahjMIurpr2XFGjBZ2QZcyie5kptXu6VbQkPNM8tQ&oe=6B0DAC61"}, {"file_name": "Screenshot 7.png", "id": "823940095524213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330717_823940098857546_7791151959385957458_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXSXJDwxTHoQ7kNvwEOQtd0&_nc_oc=Adp8nsOFy2kZazauZWlbL7gkfBAJXqoNepDabN-4H-Efpg4plv8fthMTKIPmc_xuEm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTW4-UUaWjPcLS_DR_FPhV-ZhbeECO29hYZGU3_-DtmNQ&oe=6B0D9F97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-16h56m04s620.png", "id": "817308249358705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982542_817308252692038_7947218515003401446_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_l7ZZRfiRgQ7kNvwEUPJh-&_nc_oc=AdqYANXdIO05dH5uI8SN-P7eZWi8Wy7UwGFnJyCJKbrrktKp4Zasax86llioN-sZVU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA_rTi11zQc7BaW99cyw5RhydhIWoI6W6J3kFLS5iS2g&oe=6B0DB5E0"}, "display_name": "VRflow DA42", "keywords": ["da42", "diamond"], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots flying and training on the DA42-VI. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n8 normal procedures and 6 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26285779314351447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236134_1548804715566838_8090280558061391696_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=
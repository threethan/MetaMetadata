Q7kNvwHBanI0&_nc_oc=AdryRPGuP91g_9hgvLp5oe82l8gNL6-Tt7e0ArzHCmUCKQrkKg5Amd9if3pDi-7cyzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR83Oh4SJaZfLcXT0cRvM3vh6aG53UNXNVPo1sXF_FzGQ&oe=6B0475E2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYiKKCAbjD0Q7kNvwFapNa0&_nc_oc=AdpASdnM9g4cFmfMIfuKpGwoIG7I0AWiPOHc9Yc8jK0nw2fsp34M63wxhSqCoG8qMFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRa2z8r5pf_TQHhyaH_cA9NmxMslmsvy5jdlMer1_YEg&oe=6B048250"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QuLnpWA8soQ7kNvwHDw-nH&_nc_oc=AdpEQCJyqw7I4Yg12tP6npT_KCkHFFJ4uuIFCtOlzKzP9N40eYeA4S6W__YrBMltAvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXE1Srk8lTSEdFkammeLiZRuCfSLCdqTr75y2ww0Ndzw&oe=6B0464A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohgLuj1Dv5AQ7kNvwFRe-Pp&_nc_oc=Adpw4YKo_SlNUstdMZvZocIbyv0UE5ne4FnzejRJQidxG6-FTP28epaMMSoY5LU7Dts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQFGd7Y6-PZ4pKEqZ9MPrr1smhMx1p_7XpIiP5Wg60CA&oe=6B048880"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-JonxPNuaoQ7kNvwF5qycE&_nc_oc=Adq9TcKLxl6t4Kjp64dNMCgEKFTCT9vUPHVkLGaUKEgaWmTAjbqwXH4MFHgRSSGDQmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzIvd6wu1OvJzhkQZTqhotiF32DH0abHWdzRDt9Jkq7A&oe=6B046EF3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t6
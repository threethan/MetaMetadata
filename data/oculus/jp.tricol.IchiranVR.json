0a&_nc_ohc=qNDWzaWHGs4Q7kNvwGtGZU1&_nc_oc=AdqKP110NWoAnon6dblSAhi19DlQtUfixj1GhORWBGAcB7pmpDmMZQlSmrivEO6WVcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtLwxYPqJ7SL3WBq7H-DKb81cXL0PXYwX9pDQmRwBtqQ&oe=6AC64722"}, {"file_name": "ss1.png", "id": "900672037137096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569452_900672040470429_3602208668542724751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMAy7nsoDSwQ7kNvwHDZTSV&_nc_oc=AdrdriZtXtOeZACJaUeplwsAYwKH8pgJpYBermEsAnLIcgdjdglgCU0TDha9oeh6-Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ2jzk3rbomtSocBUsdDgmhVZto_yu1yIku98Q2EL-lQ&oe=6AC666B6"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fKmWoVsphcQ7kNvwGquD8y&_nc_oc=Adq4D3q3gN4weXh7DVFyCJ4Z2apBicDClvHp82oLE2hhlSjE_F47BSk8OieFIVNBAhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN24OTSojmV5bgD2PRTqa3yHk3F7RRv17V5RnmNCrfIyA&oe=6AC66E24"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULDszzsf-kMQ7kNvwHpqA2q&_nc_oc=Adp4SFbHqFXC_446G6aYxk38Q3H7JfhAAdFgJqfliz3hMlOXW_tztfnvyEwT3ycs2Dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6hcZDOB8fx5zc22_rfsQe8N9MoCFzPkurH22vobr-CA&oe=6AC65390"}, {"file_name": "ss7.png", "id": "512472986379303", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_512472989712636_7638735751378089066_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2zgpORbjgUQ7kNvwEqfZnI&_nc_oc=Adq6aHRFrKs0bq4GRRfhwhSx_LDUDEVGyp2X1gljiEvHctY5ikmNJO_yDT8S1EshsBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSI1DeKVMa5Wo6FPhX_m2ugLfiTygdwxDYk8PbtbaJug&oe=6AC64E21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIRAN", "CounterFight", "JobSimulator", "Ramen", "cooking"], "long_description": "Make some mouth-watering ramen!\n\n\"Counter Fight ICHIRAN\" is an all-new cooking game created with input from popular ramen store, ICHIRAN.\n\nICHIRAN is a famous tonkotsu ramen chain with 85 outlets in Japan. Established over 60 years ago, it's been perfecting its hit specialty tonkotsu ramen for a long time, which is why ICHIRAN's ramen is the best in the land. In fact, it's often touted in the media as a \"must-try cuisine\" for foreign visitors.\n\nGame Features:\n\u30fbFulfill orders to get a high score! \nImmersive kitchen-based gameplay lets you experience life as a real ICHIRAN employee, racking up points for your ramen preparation skills and speedy delivery.\n\n\u30fbClimb the ranks in store management mode! \nYour score in store management mode is entered into a world ranking. Boost your profits to employ more staff and increase seating capacity as you try to hit the high scores with your own unique store!\n\n*In-game kitchen layout may differ from actual restaurants.", "short_description": "Cook some knockout noodles!\n\n\"Counter Fight ICHIRAN\" is an all-new cooking game made with input from popular ramen store, ICHIRAN.\n\nICHIRAN is a famous organic tonkotsu ramen chain with 85 outlets in Japan, often touted as a \"must-try cuisine\" for tourists. It has outlets in NY, Hong Kong, and Taiwan, too.\n\nFeatures:\n\u30fbFulfill orders to get a high score!\n\u30fbTake top place in store management mode!\n\u30fbBoost profits, employ more staff, up capacity, and hit the high scores with your own unique store!"}, {"images": {"nodes": [{"file_name": "MiniLandscape.png", "id": "3838591046231584", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_3838591052898250_5002299579482394963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_6kNa8sbxIQ7kNvwFyC
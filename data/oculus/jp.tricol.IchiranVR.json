Q7kNvwF-FGEQ&_nc_oc=AdrT3Kah4xy6iMjPgvlZcXMfkX-Vs9BihmwzENKlKc1RhLk7Y0AaKMwa5qJtDlgcQ_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmv4mNpU8l1hvK9UuOCbHHJicV_j64CTKEUaFckEW56g&oe=6B09BBE2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaBMi9YK5MIQ7kNvwFLFv5N&_nc_oc=AdpVRYcW8b0bCYMQvV4X1m0EretsnWSN-vdpnZSx7fs_hXN3KKPLoxrTcOj_IsGlCag&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtSsUHmQ5BYfxZsd_BaqjTt2Drrf7S0I5tMAQ1PWaMiQ&oe=6B09C850"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP7UYFJby14Q7kNvwHL1fvj&_nc_oc=AdoJDZhJEHnzpi8iZ-sGLyk_XIpmY5VM-9y1z22UNey069Elw78A7_O1qbjyLbvV9fE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMH2enGGxy5B0Zo_qRqsybKsjbIKadhI5I5qyFeuuS3Q&oe=6B09AAA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPni5qBc4hsQ7kNvwFOZg6a&_nc_oc=AdrMGyIZg8fpfqfQpDQF7f4GN96dnjqWoq2M3YtM_15r8IdwolmwI0JIGE6kbeRhzL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRL-xmhtgssOKqgJfBpH4BNVWhUjfjJ0ng5KL6mWGtww&oe=6B09CE80"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azswAuZG7x4Q7kNvwFnrKYV&_nc_oc=AdouMG-MW6CY1gH6LF-h3xg9Ia3KSrq1Zxt1-PyddrV4YI5v7EYZTvGsZlYyO4eZLtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBz6GPioe98g7ASRsibq2ZpvOkvt18FLrp4u0sdxe_Uw&oe=6B09B4F3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t6
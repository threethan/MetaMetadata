5\u30a1\u30a4\u30c8", "\u30b8\u30e7\u30d6\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc", "CounterFight", "ICHIRAN"], "long_description": "\u6700\u9ad8\u306e\u4e00\u676f\u3092\u5c4a\u3051\u3088\u3046\uff01\n\n\u300c\u30ab\u30a6\u30f3\u30bf\u30fc\u30d5\u30a1\u30a4\u30c8 \u4e00\u862d\u300d\u306f\u3001VR\u30ef\u30fc\u30af\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u300c\u30ab\u30a6\u30f3\u30bf\u30fc\u30d5\u30a1\u30a4\u30c8\u300d\u3068\u3001\u5927\u4eba\u6c17\u306e\u5929\u7136\u3068\u3093\u3053\u3064\u30e9\u30fc\u30e1\u30f3\u5c02\u9580\u5e97\u300c\u4e00\u862d\u300d\u76e3\u4fee\u306e\u3082\u3068\u65b0\u305f\u306b\u4f5c\u308a\u4e0a\u3052\u305f\u3001\u5168\u304f\u65b0\u3057\u3044\u30af\u30c3\u30ad\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u300c\u4e00\u862d\u300d\u306f\u65e5\u672c\u56fd\u5185\u5916\u306b85\u5e97\u8217\u3092\u5c55\u958b\u3057\u3066\u3044\u308b\u3001\u65e5\u672c\u3067\u306f\u5927\u5909\u6709\u540d\u306a\u5929\u7136\u8c5a\u9aa8\u30e9\u30fc\u30e1\u30f3\u5c02\u9580\u5e97\u3067\u3059\u3002\u5275\u696d\u304b\u308960\u5e74\u4ee5\u4e0a\u306b\u6e21\u308a\u3001\u3068\u3093\u3053\u3064\u30e9\u30fc\u30e1\u30f3\u3092\u7814\u7a76\u3057\u7d9a\u3051\u308b\u4eba\u6c17\u30e9\u30fc\u30e1\u30f3\u5e97\u3002\u30e1\u30cb\u30e5\u30fc\u3092\u591a\u69d8\u5316\u305b\u305a\u300c\u5929\u7136\u3068\u3093\u3053\u3064\u30e9\u30fc\u30e1\u30f3\u300d\u4e00\u672c\u306b\u7d5e\u308a\u3053\u307f\u300140\u4eba\u4ee5\u4e0a\u3082\u306e\u5c02\u5c5e\u8077\u4eba\u304c\u65e5\u591c\u3068\u3093\u3053\u3064\u30e9\u30fc\u30e1\u30f3\u306e\u7814\u7a76\u3092\u884c\u3063\u3066\u3044\u307e\u3059\u3002\u4e00\u862d\u306e\u30e9\u30fc\u30e1\u30f3\u306f\u65e5\u672c\u5168\u56fd\u306e\u9eba\u696d\u754c\u306e\u4e2d\u3067\u7b2c1\u4f4d\u3092\u7372\u5f97\u3057\u3001\u300c\u65e5\u672c\u306b\u884c\u3063\u305f\u3089\u5fc5\u305a\u5473\u308f\u3046\u3079\u304d\u98df\u3079\u7269\u300d\u3068\u30e1\u30c7\u30a3\u30a2\u3067\u591a\u6570\u7d39\u4ecb\u3055\u308c\u3066\u3044\u308b\u3002\n\n\u30b2\u30fc\u30e0\
Q7kNvwGbhP6_&_nc_oc=Adq2hllhLyi-M40BvPL8szK3Ps9z9d19NUk1YngL97wHEug9n8d-PM3-iRgeW55j5Bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpWfr-W2QDLTpX1oFVdPaSmgia8wMfpellg9kT1zVexQ&oe=6B105362"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeiNHYRGSNUQ7kNvwE0ap0a&_nc_oc=AdqNUTVwdeHYNLNeo14QySBghsfLCtDVYMQW1tyP4P17VTsusT0eJXAI2s-GZzwWa7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1fLMSh_OOO2TeeL4LmvULYpfdlzou9YkB7XCvRaRAuQ&oe=6B105FD0"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw64YJJwLOAQ7kNvwFA_gQR&_nc_oc=AdqU2yrMgrOzrIxvk_WL2Smx3eoSXgi_dE1CmOtBJnwLahlCFRxZUZd188OZmqvE_QA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmvRaggQSa-2noa1bSshriDo3PFpbgD_tVs9xHnukIwg&oe=6B104224"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbFNubHgdY8Q7kNvwHzW73J&_nc_oc=AdrmUejuDRrFqVlAnH2z3lt9GbJcgS1rcRC_8BSRziVy1GOXeRa41tgT_Xe5zEmID9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMiL91zTUCyHXARRXYDQO7jlL_rUb02tZeYLxQmZA_kQ&oe=6B106600"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP_kxM1mykEQ7kNvwEyxLV6&_nc_oc=AdqimvLuAZFGaNgzFwGsGVVksY7x5RUJLM50EZyX6N_XjbeuPr53UFndnR-pZJ9rfB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURi9j-AuOrzjnX_q2m3UNnQY-HAbR2bwMnNbpeaMaI9w&oe=6B104C73"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t6
Q7kNvwHu3flM&_nc_oc=AdoBhHHQqW5LQsfK2kNOJqX-d2xIgTjZNK6QYRe02retsh8ivXNS5LhJNsXx77d34v4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR9flUmm4bqwfJ1pZ-ot_8-gEdmP0vevTRt8irKQUuNg&oe=6B05C762"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuK737fW9rQQ7kNvwFClCLV&_nc_oc=AdpkGYYBjQwTou_bNE4VSviFKkb3T0TCBlXiafY2oK1BA4a6qopJOxwYFD233OkbStQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUy4UqHMQnRbVVCZ4feRiSGqtUwNf_M1SRK0LOUIJRnw&oe=6B05D3D0"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QuLnpWA8soQ7kNvwHBR3gO&_nc_oc=AdoalXnBfbczTpED9gt5R5AQFrtgBCokwQDc2ZYjU4tte7w73P-WX7U-vPbin99rydA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPqd5OWRPUAjXornilvOhUHziw3VirQcoXEEujgYyYng&oe=6B05B624"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS0DyOkblGsQ7kNvwHVSVhx&_nc_oc=AdoIuS4FqRML1XoxOpDW-T3W2guM8-6ERIk0AHfzNOOC5lw9R6x0CrCmuQ6oJiONbXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAn1CcB8qoy9bzwidRo8EAYh_qQYhY3fh48Rdo2kRfag&oe=6B05DA00"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-JonxPNuaoQ7kNvwHShMv0&_nc_oc=AdqmpBLkuXg1yxJm1lA3Sk3OyLsO4oEsxFeYFm2KPMIgM_nPY2HWWKR7sUV0nHsDSSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfammrXPirFj2WaGTPuVBK1PgCFf4rQHkUDyOLZCvP2w&oe=6B05C073"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t6
_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfubPAFVi76MbwTOEGJ7NAx0OWOapKZ8AmM5z-82AjX6rw&oe=699C6090"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VByKXeImqrMQ7kNvwFHDrQM&_nc_oc=AdmKDpd3b-rM4qgJO0JQQTNy4fO517ay0Q-60i17-rUDrKRD0IAB7Dv8P40Fh-rtBeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu3QYzZAKxjwV60ge65hHuZfdZcbfOL1UT92Jai2fRv3A&oe=699C42E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_Horizontal.png", "id": "375191540435674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375082_375191543769007_2543150386744462971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42Luu-8KHSEQ7kNvwEEXUAE&_nc_oc=Adn9Jr23QndDTehRAa54K1rYowTV7Oi5W5sZA8Ajfiav5DvyEug_v9_ukqpOXICO8Ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv57oJ7pgXuzJPdyPiPNKPt4KnNzzQPTgb9r1fUNMAusA&oe=699C40C6"}, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onQcLxZWHxcQ7kNvwFvmOSm&_nc_oc=AdlSgAjhyCtP1FRl5hnXmoqpjRgUktivQI-cybXuF2lhMDQ0e-RqrZk9kI4ciJIUO-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftMovxhQvBOG6WIFjogSOk_4svii5S7ep-1Wg90i9tWFA&oe=699C66C0"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVCJ0aUkx3EQ7kNvwGQShFL&_nc_oc=Adl0lAnTXz_rU7FuMW95kPZFHXPmQ-qrifg-LPUfeBmj8Mg5xSDQ5CDf3rcrBiByXwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvzWXYqefy7uc1SyVbU1OzBqK8emF8ksVB2YGuZGSWijA&oe=699C4D33"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282165_805830129965042_8641739740128532803_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RI2ADYh5y0Q7kNvwF3_oBb&_nc_oc=AdmpncJB5kJoif89q0VNWISND_jOiQBfXisEnnGlFeK5ofSYxDmkkkPBYnVQ__7Cpr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=0
Q7kNvwH9Lqhk&_nc_oc=AdrX3NwpgGT2Yuhe1wJsU0HxixTlbV3RwMRS3du_a2mUkwIvD51pbiVZznYa9eSkTbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1mODjOCkk-SFd2WYwNpmqDuop8Yl92wC7q5Szvkk9uA&oe=6AFF2FE2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7UySAtiuVkQ7kNvwHGYRtI&_nc_oc=AdoDyV8GjSznEZ75mxZFpwhAUnkqIkeFOKSbsYwpTFevfsptmj_SKxUZkQCWquMbxsA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaJZw6y16H1QB2DW9YhROJ935F3Psx8dk5z3BJlXC53Q&oe=6AFF0410"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By4pE5kha3oQ7kNvwH7FGbJ&_nc_oc=AdpDMvSlcEL1XeIdOreXrWswdeo1MR1I4uPBiNry9Q28QnTG2teapByvnmQFVuJSzBI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSQb3iYw20Cm0iuO4V2gXuuPtmVqGKuOWqqhzWSID3bA&oe=6AFF1EA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-Q8OZY950QQ7kNvwHsAZUi&_nc_oc=Adr7SznvKv-R10AaJlASY4SE8lo7_-uBo9wfNAU-Uu0I35FhAragFvDe3JnnPkYU5Nk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiHnbxQSkHYqXy54RSfPfdWNNIxQOIg0DYPB0vzHlrfA&oe=6AFF0A40"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmcaNAqMlSYQ7kNvwG9oog_&_nc_oc=AdoeD87t7yGGesPFFV6wzJS7rnRGvuTAY29naHxV6N_qDsDMl9elLc76Y97aD27SJ_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbGDflHZ5dn3d2rI5FrzR8a_ZlicJVxLR6ueTc3KfhDQ&oe=6AFF28F3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t6
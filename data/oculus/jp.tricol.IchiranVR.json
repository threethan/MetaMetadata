Q7kNvwHD2GZB&_nc_oc=AdqlGlKLtreoLA_a-MO85-bYGCdkr7vjzNf6ZmYlSMsPBnwlKTR6ku9wZRGTPlGKCJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKWQQE2EOzzipDRlA1uoe6cgOU58AIOsY0vFMlLtDp0w&oe=6B0718E2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuK737fW9rQQ7kNvwGXEr8o&_nc_oc=AdoanDCC2PdFzbr3-rcOwallIl9pbbZHhh82nKr2XvlEw5Bc4xdYqr2TVWo1g-TNmZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnxxanc3LgXyeqPy_JS86n9j5AD84GBwdTQG03Wnadog&oe=6B072550"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QuLnpWA8soQ7kNvwHyLE1r&_nc_oc=Ado5_HQ4DrxoJOE8gwv4Hsjus1kXmTcy-L6ODjc59caguTTC-ZQohMB1NGQRJATvZVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNoqtEexZOclnRoSxAzfNi6ViwzLkTBF8F7pF56r0mFg&oe=6B0707A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS0DyOkblGsQ7kNvwFvLZAI&_nc_oc=AdoE33Pl-LlBVHbUc0tOoLEshzWX4pZ1OgZiynaf0v8lBaRyqWMBTVmX_ayg225vvL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSojo0G0OfXgTp421wQJwmM-J6qVT7OCb3uFwUzidxaHw&oe=6B06F340"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-JonxPNuaoQ7kNvwF6Jm6q&_nc_oc=Adp4cX-PJ_msJAxmKZk2KwX81CF8B8AkpSzMCh-a-AwQkefZKm36cyXAi2ToKe89KjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpHIWISAtIkYSpIETH6uRed466zOvOEmfb9bExIXR-Ww&oe=6B0711F3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t6
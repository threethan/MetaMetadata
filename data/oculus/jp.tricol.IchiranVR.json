_Afx2ugTclTfxZ-OEoGB7nc8fBqjjbMFN_UEB9NI2vRkzgw&oe=69AAD4A2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMp4jiOvp14Q7kNvwE5qvkT&_nc_oc=AdlW0XxEhW_ANByzEEcEDFP-upsMrRoxbi5DFPhZBBU9fg1q_TtLmxUYkesys6Udqqo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaeJy8wxtsEpDNQ9b2S35-iyEuUEoIgpvJ3cfy5gca2g&oe=69AAE110"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kplFM3yAaGAQ7kNvwF8rgL2&_nc_oc=AdlX6Yux7C_6urfMSSV-uK6m_LRUGwvSeA_ExUVsq4caRlhLWneUV78LrdIf4kWNWgA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT9aWfzfuEaNPb0f4vFUdqV3kmFNXsaMzI8zulgn7SGQ&oe=69AAC364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_Horizontal.png", "id": "375191540435674", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375082_375191543769007_2543150386744462971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tRytNDX5noQ7kNvwE4wEWl&_nc_oc=AdkSzJ69CxLJBk_zuSAZasDg_XHEp1gV78teUPHoQe7ic3ZZ7hlnpEsHBSGTnmG-oXA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxcKTvMSgBJwRnskPWWEq8FnOMbC1WGAo4yOYukqIBtcA&oe=69AAC146"}, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX9JsWZ8owoQ7kNvwFbqBUU&_nc_oc=AdmRWhEq4VbdAboMXRin47Q1Kpf8oSOT0ENPX8CgWItaCvbC64mmyvUrUUfI3c5Z1E8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxfoFcLfWzSvrLxmrhNQHuSKxi3f1r31TstnC94NHfIQ&oe=69AAE740"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyZPH_0o6A4Q7kNvwF6ROPK&_nc_oc=AdnVJZyYDPuIb8jV1687xCkckSQO2Qp_Qsx2resX3J47Y8iKmapHx8qqy1zK8k4BYPk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfVCOYK36JIjafw6L2qF1Gn6QnCRVv2LVLzp7muPAA8w&o
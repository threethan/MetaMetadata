Q7kNvwGhhMuX&_nc_oc=Adp_LYaSpTgOj-vD5k3ggfmK0ES8HC-SUpcHeoyq3twywiGc1NgrJVbHzPMPhobgAWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFNB2zSJ2gUwSZf_n8lHd3UYVIHxuZE_CHz8kc767Ekw&oe=6B0B0D62"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaBMi9YK5MIQ7kNvwGrg4zE&_nc_oc=AdrzM1RLu_B6KCOFFUcYcPowmOKGE1HaeMIPUNGfnBKy3KQAXFfrhl7k6ALsFp1Yrw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbK9whOEYihHyzJl9yaaq8a0qD8_cSiDvhxYqmsHBZ9A&oe=6B0B19D0"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP7UYFJby14Q7kNvwEkV26i&_nc_oc=AdrJm63pqRVA86IpN2zeQeN-pI2xXPAdfrm0TyDcbefNmq-aY7oQMkksBL32KOssAno&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRILFj1IYxgdydrzgZmFPmdIf5tv7XO_svKp2VDxQX98A&oe=6B0B3464"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPni5qBc4hsQ7kNvwFX8lOR&_nc_oc=AdoGYV02XJI-ZfF4uJt82EmUYeqrEJnOYZnr8aXFlj33b0vuZeTs-4ezqAiSD0wCm_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzu8MdGKZBAgGscAFtx1YTpGARMhiKwFsUePBm0UZAjA&oe=6B0B2000"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azswAuZG7x4Q7kNvwHvBtRw&_nc_oc=AdoNuEnW2zoDgJfgIvCkylto2NiJCIp57sSTXloYdA6e54wbCmGUIgFS8wt3rZ1TDpo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRVcLtlv-Lazcq6Z85dTZaOrWj-oSrZkt24Nen8awQJg&oe=6B0B3EB3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t6
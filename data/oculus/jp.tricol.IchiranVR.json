Q7kNvwG3owLm&_nc_oc=AdrLvdhmzprjiP8MLsnqm63nrJTAUaa2r2HjgcAkPPvGunLu-GFwUB6kc_VjPlaYqxI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjV9rr5PagIy5ZO8UJy9MSnQ88doqe4wJwRIbZdBt-Ew&oe=6B086A62"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuK737fW9rQQ7kNvwHxzlo6&_nc_oc=Adq6OZ3s3IVru7Aov9XvXLBVu7EXEjJ-u6_ig9dWQe3hiBJCnlyzGYJKJanRu1CNDV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNpdPPNHUACnrwvaDvbz9_CxzWQgXgUfj69-6-g4CGLQ&oe=6B083E90"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP7UYFJby14Q7kNvwEoE9JH&_nc_oc=Adr0i2UN1bEFzJ2tq9LupBHDN5mQJCF1v0XeB_TDUCcV1ICgPEeEPXXX_7_pKQ2BDIo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7LaB_dIhyqyiIDGCu31eYWgpsbQWtYisvmm7NO7JaeQ&oe=6B085924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS0DyOkblGsQ7kNvwGYH00Y&_nc_oc=AdrMBxHXZ-T0GgU6PYAXriaKAmBaxavvnC1gd9OmS9U7ZpaGThxJDe-Gt0DoeCR7Ems&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShpw7-6lIoxTnkMdHKmGin5mnFtr2h_sWktc0UdILkFg&oe=6B0844C0"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azswAuZG7x4Q7kNvwEA8WBM&_nc_oc=Adpx0-vyivEWJ0h7F_jEdli2e3PP_39ftIS5aMdzAq20srrkkY65MV3aNSEWjuztIBs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsHCQwvNHeWxQj3rI3_NqnebTdK2bZmCN-3xXCCnIHUA&oe=6B086373"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t6
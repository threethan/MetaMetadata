Q7kNvwEyhIwT&_nc_oc=AdqzfGNybxYx52s4_lWq92LLyDQjP1ycgmZWwUuOQgQw8gRfb54-azyZtTMt-moSxnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3SgwhXjEWap-Hhqg1TlX9AOxihG5-ydpXBdW8QPjxRw&oe=6B032462"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYiKKCAbjD0Q7kNvwHy6b5n&_nc_oc=AdrOen2qM-4zYVR9NShahfxxJIe4WHGQxJfWg3SZ51aNdpeiz5TxzCFrp3gc7c_X5nU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLI8idjmmYiUUZgKxdKha4yJjkafsAE3SLh6V1_l0Ekg&oe=6B0330D0"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbvdjPVE5AsQ7kNvwHN4Jgs&_nc_oc=AdpI6aHrJBC1ep8huHhPSrZE89_oLprHmqSQzf61BVqBDH1UskEwwuEnnJxRdu4YkTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLcyDLC5sKFwJ6ptHUi2rt0f6Jl3UIHjw-i0XOXk8E4w&oe=6B031324"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohgLuj1Dv5AQ7kNvwEssTPi&_nc_oc=Adq-Bm12pMbK8SJSbdLIKzO2lWfPTIPbZ3ptJdrghV0x1HY4w-vECntmz49--vBf5y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCbw4ktWrBlkTy1B-Z3DUWSZWTbAAY1V8k8FaMmP14hw&oe=6B033700"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg3O6YR-vmkQ7kNvwEWhWZC&_nc_oc=Ado2Dv_lQyYD0yS5qrEPAw0Lf-FORC-XZgtdZPQi8ud96vzgrGkzF1UaDL2aQVtukfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlznVm9bqgfCz5aU8AaOXiW8e_r8tsEATSBczQWF3tZA&oe=6B031D73"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t6
Q7kNvwGeHRyi&_nc_oc=Ado3fPxhG9Xa8rhWEH9DrxBRSXvSqMo0R9xVyTMel9EBYM98uujF6o3xItA-oiRePkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDfFk7rizwCyGyZrEOIyZOK1Pk1FfHXEJCvneaPcpXjg&oe=6B0C5EE2"}, {"file_name": "ss4.png", "id": "416146802772950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982521_416146806106283_7161111592696257607_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaBMi9YK5MIQ7kNvwHM33kD&_nc_oc=AdqIZBVQUNRuNzZZHvfcqFz76lIZsVhk4NAeTROXz24hRTLwss2j9fA8SulSXV2W1wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHjebbokolX8TF4CoYRVOgR5wvO9Nmh5ndKr-2zs664w&oe=6B0C6B50"}, {"file_name": "ss5.png", "id": "215595850179052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036702_215595853512385_1516722769013058759_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc0JfCd_C8kQ7kNvwG-P0Li&_nc_oc=AdobmkWyfD10WhsaQG7MbBxbXXzFtqD8ECeeHA0PhQ3gXRrzf8gAuM6k62vbOGbMpT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEj6ufwGGrJ4oFjoReAWrFUq7DjuujYiHdw0I0RKlTXg&oe=6B0C4DA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Counter Fight ICHIRAN", "keywords": ["ICHIARN", "CounterFight", "JobSimurator", "Ramen", "cooking"], "long_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\nGame features\n\nBecome an employee of ICHIRAN and cook ramen!\n\nOptimized for VR games, the kitchen has intuitive gameplay that makes you feel like an ICHIRAN's employee.\n\nAim for a high score in response to customer orders!\n\nNot only cook ramen, also reproduce in-game the particulars of ICHIRAN, such as judging the beauty of presentation and the \"15 second standard\" to maintain the freshness of ramen.\n\nYou can enjoy the atmosphere of ICHIRAN anywhere!\n\nMany familiar items such as Kaedama plate and Order sheets that can only be seen at shops, Original spicy red sauce, and Arita porcelain original donburi bowls will appear.\n\nThe sound is faithfully reproduced!\n\nThe background music and sound effects of the Kaedama that flow in the store are faithfully ", "short_description": "Let's make the best ramen for customers!\n\n\"Counter Fight ICHIRAN\" is a completely new cooking game that combines the experience of the VR work simulator game \"Counter Fight\" and the popular natural tonkotsu ramen specialty store \"ICHIRAN\".\n\n*Game features*\nBecome an employee of ICHIRAN and cook ramen!\nAim for a high score in response to customer orders!\nYou can enjoy the atmosphere of ICHIRAN anywhere!\nThe sound is faithfully reproduced!"}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2929472120610209", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210390_2929472123943542_324928563406628709_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPni5qBc4hsQ7kNvwFsuUzz&_nc_oc=Adr29pQuENCdPkkr0r7U4Pb8cbiwiVk_5Jswo8vFyk2G8RIZ1zy5X3zg9g1h6Weo87U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6WsmYTKkbVZtWVG_8gcvo9Q76L-FSl9uZMvzr5CCNng&oe=6B0C7180"}, {"file_name": "logo.png", "id": "933341957200091", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422372_933341960533424_4859949339304657620_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjK6SqxThVcQ7kNvwEN4MKp&_nc_oc=AdrKzN03iwkAeLcziFP48q6O0q2eYKqKvz2ITMNcH934882N-UjJpGgOhL8b1c_6n7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJXwHKUISwV5cz3aVvz3takvuEl8PvNRrEcaoJsIejUg&oe=6B0C57F3"}, {"file_name": "MiniLandscape.png", "id": "805830126631709", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t6
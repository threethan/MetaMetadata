995369303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfT56mXX_jsQ7kNvwHSE4iR&_nc_oc=Adr_hyPxNx1LGRmXkQ9b63A2x1EuCqomV37sztDRXdd16IlmGDh9qX6f3jZuITSfo7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1dBJe1CsB3SD4tOYIjo20m2fous1aWgxwOAZiL8K7PA&oe=6A9EC29E"}, {"file_name": "screenshot.png", "id": "606329465659295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_606329468992628_8346371957676797649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q79T0pNTzKsQ7kNvwFu2Fj9&_nc_oc=Adoj6uUCtAuNZ58k4n2bka2VwCvkV__2oaXQvyD-rBeZvnGGYQ_hzgb3FP2ubBj4Pmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbimaKmQQ_dr_223xOQnOUC_EjoDRIfIEZWGGb7S8nGg&oe=6A9EE0D3"}, {"file_name": "screenshot1.png", "id": "1460316745170605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1460316748503938_3292300042834351776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsIHcsBv5BcQ7kNvwGq6DcU&_nc_oc=Adou6Kme5bP0t8raeZwMR53GXJ6vQk7t8NELr0vZxCU77BJHxHfI9nvjfZ7baQPA54Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy-YjzzXBTED1B1SW5Ylej-gJG11NMg3YaNG8l0v1OWg&oe=6A9EE496"}, {"file_name": "screenshot4.png", "id": "1455540008824715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf327pzo3WYQ7kNvwFY_vKQ&_nc_oc=Adp0dkaO1poAaxIlxBcwWjseHSYVdjg1dn7FDLI1DLl3angrg_AD66XYPmE2yR6EEFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTZpj1BYzcWKwmmRVC10dnSwNZBMvkV1luv9jiSfvUkg&oe=6A9EC153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLHnafrI5h4Q7kNvwHNop0v&_nc_oc=AdpH17_D6_4Kh8bOpwBAZgyLtMnMF7rLZ_hg-v4zGJ1zVfVOYqSn8pHc70XvNfirl3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4B4FNEk_h-mfWvWqB-RSt5R98qUaeTzBqRIKNChacsA&oe=6A9EDB7B"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "web
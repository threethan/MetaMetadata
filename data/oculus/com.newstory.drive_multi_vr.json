995369303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtW7KORdSqIQ7kNvwE0sVjy&_nc_oc=AdoNySooF8bgZIxEeEVhmenWK8yAfqyxuMaVR3gg3YYOKqb9Y2fd9ol_8t78PsuCJRs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUoa9Vc14ZzmjOiqV5Vtr0MNjbhB-jcxG6xJK-7qofFg&oe=6A92ACDE"}, {"file_name": "screenshot.png", "id": "606329465659295", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618102_606329468992628_8346371957676797649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IklpJEi6gYgQ7kNvwGQ9Q4E&_nc_oc=Adpl2hnO2vvLWuJquaK_252lTjzsN2PqeDyK3EB4J30Rurgk8Ow0Mlvo9EyYs1ZQnas&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj-IWVmrRzKsPD-8nQ6yrwba0bq4ZHZUZDBL4XgBjKUA&oe=6A92CB13"}, {"file_name": "screenshot1.png", "id": "1460316745170605", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617847_1460316748503938_3292300042834351776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgCnUxIK50oQ7kNvwHndroh&_nc_oc=Adpm7O9WCYb2PVsoD3afbI145cr8mFioaOekl1bA5kfy1UR0w0AhJoyBUpfZjPIdpvc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiP841ShNV6wnHz4Aho3Seglkagh_WVR8CE8D7ImxJAA&oe=6A92CED6"}, {"file_name": "screenshot4.png", "id": "1455540008824715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf6xYx8Uh3IQ7kNvwGCHl0k&_nc_oc=AdpjIPHysqAWqKhqLyUeDSI8SSOVg2vo5rZO5y9IXd_cacHQJdAlCgWPQxM1K3daVfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKOPCqDfZszJAyJSjJ6DjX1lmyuWcwXZJs9AaYvJGXIA&oe=6A92AB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivyeLzfSmqEQ7kNvwH1tmO0&_nc_oc=AdqInkWl3VT8CP3K-1NgXL9TVoKEpbMauIuCL7qTATk0CzUa_OImSaiFzaO15M3Nkmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0jaEt_EgX_xJnQIeNJFOjpqfXnn7TzN3KhOXRhSGvCA&oe=6A92C5BB"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "web
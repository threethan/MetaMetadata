7cVvnAIxXOn69wAyVFp_EAu3d4VBhn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJg79Bgp9_EUlc7nKxcvukaO5PpHkrS1_9vXumBzRVnw&oe=6A8AC3DE"}, {"file_name": "screenshot.png", "id": "606329465659295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_606329468992628_8346371957676797649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z-we4PG-lEQ7kNvwEjOAOf&_nc_oc=AdqsyuaZTCag7rS9Iuxtyy0x_VfcUyBfdgj_zP8xj4o3xWGfy6DoTGNORKJVLiR4xaI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpZ1DqApAHlHiTaq0ijI14jggCTpPVoxUnsRfwS3he_Q&oe=6A8AE213"}, {"file_name": "screenshot1.png", "id": "1460316745170605", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617847_1460316748503938_3292300042834351776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU_obx7qyAcQ7kNvwF2XgKz&_nc_oc=AdoUPYVqW2NAa5R1AdBYnyZNvwnjYBFold7tbLU-J9VdYlUAg2lonNz-U363erMoPLY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzbl56Fdci08P0iTMXyynpZBdEAiWUaz5iUFN6dmMydA&oe=6A8AE5D6"}, {"file_name": "screenshot4.png", "id": "1455540008824715", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaSrjxvqUY8Q7kNvwGyC4nE&_nc_oc=AdrMbgNx9_b1vOVYgRmivJas7LGuddzz92ASqohmjwd_ZURdMeraI-PtwID-frRSBmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0tBiTIxGlLQ6XVNs6LGVmYkVIqKDm-om2J6qdtCWDAw&oe=6A8AC293"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm2nubHAO4oQ7kNvwHYz7eH&_nc_oc=AdpGxxf30VIiu9cZjx5OXD7fwIB3eqgB22444XxFdbA4bnnP9PftYaQpnbIGsvGkImg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYW_9aRa9vomjxao2idD0o7t-FhN3WB4PWuaS3aVFLew&oe=6A8ADCBB"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "conte
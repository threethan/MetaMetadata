dDcWcide6om0lX_eA&oe=6A78871E"}, {"file_name": "screenshot.png", "id": "606329465659295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618102_606329468992628_8346371957676797649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFYKAD2z_NQQ7kNvwG78q4a&_nc_oc=AdoopJPDUpgok1hg_QGwjnfIV_U54Ytv68VTG0jydTmKMWH6_7f4PewxgCHai0D--t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ6tiPqTlhk9Q81phsc6oEuYqj-0PUbePpYOkkOHpFRA&oe=6A786D13"}, {"file_name": "screenshot1.png", "id": "1460316745170605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1460316748503938_3292300042834351776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtdtMJE00QUQ7kNvwEN3ATF&_nc_oc=Adoq9jXTGrleeRqW-ruuARtrvDxN5vy7QNPQEN-qfp3Aq14ooVFKbZC50ldl6VEU08w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW-FxkuX5kvmGN6XtONmfhhLiENKYlIea-IwqUH6lbMA&oe=6A7870D6"}, {"file_name": "screenshot4.png", "id": "1455540008824715", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GbmDVkBtwUQ7kNvwENVD-T&_nc_oc=AdqAD3gO6YD79eycZCE1mP-Lrj4qYib9WVpgyNmLchNjC_8DB22Vbx22Lswvd1IxZJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5eGoSEP3e79W5yKvVSrx81f2u5gR8Dv6P1eJKojKMtQ&oe=6A7885D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmxXDf80kLsQ7kNvwEK_WJq&_nc_oc=Adr4QE4oZfgf5j6scZAwOoN-x7GqBW0le5h7xpEYyPAb6v86EA78WJjJv5esu5_VA1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY8NDJqmw44fjGYgLy6oDgCDX54i_ksabHkxKNbvKKRA&oe=6A7867BB"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "6
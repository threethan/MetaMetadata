jQQIgoukD4g5uQtPg&oe=6A80701E"}, {"file_name": "screenshot.png", "id": "606329465659295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618102_606329468992628_8346371957676797649_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4Dmst6UVmYQ7kNvwE7DYC8&_nc_oc=AdpXrEFd4cYGQbHVIcOALJC639RgOiH1uLOL1OOX-c5UHDGTMoyJzwx_OK3Aq9Hxgp4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKdDfFTgiX9lt71LkkrghiebWugQGq_bs49aV4CHsuvA&oe=6A805613"}, {"file_name": "screenshot1.png", "id": "1460316745170605", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617847_1460316748503938_3292300042834351776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ4uafAgSNcQ7kNvwHhqm3j&_nc_oc=AdoB0LIMCvbpaD7VcFUbWaff1JAhkCvnvGgmG5g-C2V3lvlY61uH940T6Y10Y35sWLg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeBg7fHbPnQCF9T1x48_TVxEncUiatgER-Jv8vhT_NYw&oe=6A8059D6"}, {"file_name": "screenshot4.png", "id": "1455540008824715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfctZpB2GWcQ7kNvwHhDjMw&_nc_oc=AdrWU7GV5kCyG9BFhELlLnAu8nPuc5w_Hk8I1Qwpb1u1AN0cCn5nEtiq337jPgh74io&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3LXZExMpv8ZS5YtSus1aalDB7FjpIOKEPCNRXlGUL2w&oe=6A806ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbIqT6nLeFsQ7kNvwH_z0kh&_nc_oc=AdqPRpI4zPA_AHbt2wdk0gaKx_elo8Wnrykqut11I6sGZksBAFn4Kjd0eZHqd1gFAYk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6cMbsi2ohQmKrob79KO-Kaq3uYtUhEZQy21vYfrB5bg&oe=6A8050BB"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "6
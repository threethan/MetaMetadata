scdn.com/v/t64.5771-25/499618440_1455540012158048_1649248167125430766_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyzVO4csPAMQ7kNvwFn9Lj1&_nc_oc=Adoc-4e2knzkbJI9pmHyrkTaFaFvJRxHRmBYTYip1rL5GZsw_9nwOq1Ucm6qPf-YPLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t7g74ECWjY9TF73MWZRt2k-0CWzEDdH3Pvky_CaJVEg&oe=69DCF4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "4038756736363000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_4038756739696333_2834424856108332602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV9vMV7nxrUQ7kNvwEiPaEP&_nc_oc=AdpaIOIuq2Oi4G9BJqytjTFM0FaumBGuxHqBguuNmLnwaDapsn8kHWSmqHYIOhn6fDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_tiItf7qY5TaRBxeuXFTw-wpwrQfkc6LXg7lffaA3ng&oe=69DCD6BB"}, "display_name": "The Endless Drive", "keywords": ["Survival", "Car", "Action", "Driving", "Zombie"], "long_description": "**SURVIVE THE APOCALYPSE ON FOUR WHEELS!\ud83d\ude97\ud83d\udca8**\n\nGrab the wheel and drive to survive in the ultimate post-apocalyptic road trip. This is your story. Your journey. Your rules of survival.\n## **\ud83e\udd1d TEAM UP OR GO SOLO**\n\n Survive with friends in up to 4-player co-op, or brave the desolate roads alone. When you're solo, all the loot is yours, but so are all the dangers. The choice is yours.\n## **\ud83d\udd27 BUILD YOUR ROLLING FORTRESS**\n\n Your car is more than a vehicle\u2014it's your lifeline. Scavenge for parts, bolt on armor, mount powerful weapons, and turn your ride into a zombie-shredding machine.\n## **\u2694\ufe0f FIGHT THE DEAD AND THE LIVING**\n\n The undead are predictable, but the living are far more dangerous. Battle relentless zombie hordes and outsmart cunning human gangs who want your car, your supplies, and your life.\n## **\ud83d\udca5 CREATE YOUR OWN MAYHEM**\n\n This world is your chaotic playground. Use physics to your advantage\u2014send zombies flying with a reinforced bumper, or create explosive traps for unsuspecting gangs. If you can see it, you can probably break it.\n## **\ud83c\udf54 SURVIVE BEYOND THE BASICS**\n\n This isn't just about fighting. Scavenge for food and water, and yes, even find a safe place to answer nature's call. Neglect your needs, and become just another corpse on the road.\n", "short_description": "Grab the wheel, trust your friends, and survive the apocalypse together. Your ultimate road trip through a world of zombies and gangs begins now! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "29931026213209062"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_4036198269975863_5393173283416142954_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoLU3vS9wmIQ7kNvwHlmGc_&_nc_oc=AdqtO0V6dEtEbWvjTCB2Jsu1vDX2CgwStfErnHSLgZMPbK1GGp13r8zk5UBMwogiFh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K3TdYyjzinY9uOZjNRD_Uld4AFPOV78mOAPu70Ir9
.com&_nc_ss=7f20f&oh=00_Af7aICnSVUcDOhCIenyFCnbIHcCa-aLFbppLkDzP0wPilw&oe=6A1C589E"}, {"file_name": "Screen_2560x1440_9-24-2025 11.05.11 AM.png", "id": "790566450380377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308349_790566453713710_2438215409909978035_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30sSzXqNUTcQ7kNvwG0DPBr&_nc_oc=AdqbIxq2vLTDgd-Ow9nUmQ3teE4N9f7wbtYktrsJ3mfNejK3ql0oJe3aOMwoRl9NKGs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63bK4DoW-73s8ISfvVURM2_mXIPMQ5SrxUkh3XFzsZSw&oe=6A1C3EBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crew Together XR", "keywords": ["Teamentwicklung", "Teambuilding", "Communication", "Spielerlebnis", "Challenges"], "long_description": "Tauche ein in immersive XR-Missionen, die Kommunikation, Vertrauen und Zusammenarbeit st\u00e4rken. Crew Together XR verbindet den Nervenkitzel eines Spielerlebnisses mit erprobten Methoden der Teamentwicklung \u2013 mit Cross-Play auf Tablets, Smartphones und VR-Headsets.\n\n**Teste jetzt das XR-Tutorial und die kostenlose Demo.**\n\n**Das erwartet euch**\n- Mehr als ein Spiel: Gef\u00fchrte Team-Missionen mit strukturierten Reflexionen erleben, analysieren und gemeinsam wachsen.\n- Lernen durch Erleben: Herausforderungen machen sichtbar, wie euer Team kommuniziert, Entscheidungen trifft und unter Druck reagiert.\n- Vier immersive Missionen: Themen wie Vertrauen, Stress, Perspektivwechsel und Konfliktbew\u00e4ltigung in unterschiedlichen Szenarien.\n- Vielseitig einsetzbar: Ideal f\u00fcr Projektstarts, Onboarding, Leadership-Programme oder Ausbildungsformate.\n- Nachweisbare Wirkung: Entwickelt mit professionellen Coaches und erprobt mit Teams, F\u00fchrungskr\u00e4ften und Nachwuchstalenten.\n\nCrew Together XR ist euer Einstieg in die Teamentwicklung der n\u00e4chsten Generation. Ob in der Rolle als F\u00fchrungskraft, Lernender oder Coach \u2013 dieses Erlebnis vermittelt die Kompetenzen, die wirklich z\u00e4hlen.\n\n**Ladet Crew Together XR noch heute herunter und startet mit Demo und Tutorial.**\n", "short_description": "Crew Together XR verbindet immersive Spielerlebnisse mit Reflexion, um Kommunikation, Vertrauen und Zusammenarbeit im Team zu st\u00e4rken. \n\nJetzt Demo & Tutorial testen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crewtogether.io/privacy-policy-crew-together-app", "developer_terms_of_service_url": null, "publisher_name": "Polycular GmbH", "support_website_url": "https://crewtogether.io/contact-and-newsletter/", "website_url": "https://crewtogether.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "25631940443064958"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "684855847775426"}]}, "baseline_offer": {"id": "684855847775426"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763965080, "status": "PUBLISHED", "id": "684855847775426"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26089792497279748", "version": "1.7.8"}, "id": "2501251203587874", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Ap
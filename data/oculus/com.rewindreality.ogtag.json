", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1207111341485265_1520308077597903412_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AexZSpTZG8QQ7kNvwHKMlCD&_nc_oc=Ado5VSdpEs5FYJe-gJylQ807g8EEX834Kg4T6OwLJCYavWLHgJIgZ3_j0Po1sE3e-uM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW4uxzD5UlD4tKTexE3v3GAqh8HvjZ5H3Jjd2C3TxD6g&oe=6B03356D"}, {"file_name": "{88F905A4-0E98-4637-8338-FE7E58C9143B}.png", "id": "1404444494529153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585741071_1404444501195819_4043621806861777879_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1tCQSyln30Q7kNvwFEx3h7&_nc_oc=AdrZ3V3xOlAZmvux3ZAWEC-9VNPpj9DDlvMLFYnumRTQCPlsZuHyyBbyLggi7fS3OqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdb5YWZzaGzfJDtr8772Q7O3C6KEoeLxDbynNR-dfMEA&oe=6B033801"}, {"file_name": "{D0846925-7872-449A-9865-B33D1C610294}.png", "id": "1806499693333324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1806499696666657_3250870243995080416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSzoqWaE94MQ7kNvwFkUXLo&_nc_oc=AdpwlEAWvU05MbL04L7RCqTB1eqUjyK4jQtJAyoTjwAgkwk8-f6PQognMWIo2l341p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWhiXlg3bXEaoRf4mSZZAdJj-8LkQhDfZR0xaLORazeg&oe=6B0329C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OG TAG", "keywords": [], "long_description": "OG TAG is a movement-based VR game inspired by the earliest versions of Gorilla Tag, built for players who want to experience how the game felt in its original days. The focus is on simple mechanics, raw movement, and skill-based tagging\u2014no extras, just pure momentum and parkour.\n\nPlayers move using only their arms, climbing, launching, and tagging others in classic maps inspired by old-school layouts. OG TAG is designed as a throwback experience, giving both new and players a chance to try an older-style version of the gameplay that started it all.", "short_description": "OG TAG is a throwback VR tag game inspired by early Gorilla Tag movement, bringing back the classic maps, physics, and fast-paced fun from the original days."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillashadow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Reece_C2", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillashadow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26281706794805323"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26394008333575168", "version": "9"}, "id": "2788660758003204", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25382073161435362", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26394008333575168"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log":
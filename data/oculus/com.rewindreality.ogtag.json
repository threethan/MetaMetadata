A4-0E98-4637-8338-FE7E58C9143B}.png", "id": "1404444494529153", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/585741071_1404444501195819_4043621806861777879_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1J7M_CoW8MQ7kNvwGIDVuM&_nc_oc=AdpL2kegsvoGfnWXfffjm3pC1Yzh3Q63isA-N87k9GHy6A8xQTh5ackySkvLptIvJHo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOGeEBCn3c0xqarklRWgwD5WSn9JmxEX3SuOrqr4kt3g&oe=6A58EE41"}, {"file_name": "{D0846925-7872-449A-9865-B33D1C610294}.png", "id": "1806499693333324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823279_1806499696666657_3250870243995080416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzrkJtbjBFsQ7kNvwGoN398&_nc_oc=AdodLHl4myUvnNDeGVFWJymTNP144rXPuSOOZAR2acxu6ItI-7V7fLW9NdUXieJFskw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC06bexptrlwhaTqMVcadk2vuaWG1PkkoH8Ge0aGoB2Qw&oe=6A58E005"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OG TAG", "keywords": [], "long_description": "OG TAG is a movement-based VR game inspired by the earliest versions of Gorilla Tag, built for players who want to experience how the game felt in its original days. The focus is on simple mechanics, raw movement, and skill-based tagging\u2014no extras, just pure momentum and parkour.\n\nPlayers move using only their arms, climbing, launching, and tagging others in classic maps inspired by old-school layouts. OG TAG is designed as a throwback experience, giving both new and players a chance to try an older-style version of the gameplay that started it all.", "short_description": "OG TAG is a throwback VR tag game inspired by early Gorilla Tag movement, bringing back the classic maps, physics, and fast-paced fun from the original days."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillashadow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Reece_C2", "support_website_url": null,
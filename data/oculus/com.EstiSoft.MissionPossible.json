om&_nc_ss=7f20f&oh=00_AQR8EkxNYPCvkDlWxbDKUGX5kSHrmwcXxB9fMIBwEpidbQ&oe=6AF9DFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-02-10 002438.png", "id": "1302143274339771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391785_1302143277673104_2902824972908524744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGT8_uGsYCIQ7kNvwF4vpeD&_nc_oc=AdqHiKExkQWzOX6RMi1FDrbAyF_mDY0OfbfrH3IXbBzR3SaczDRqMq4S4ezuZRgKc6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ5WYrwCBwiPYwNsCW1jxaRgkQsU09X6q-Dc6o5j8K8w&oe=6AF9DE33"}, "display_name": "Mission Possible", "keywords": ["Casual", "Comfort", "Fun", "Advanture", "Toon"], "long_description": "Get ready for a thrilling descent in Mission Possible, the ultimate action-packed spy adventure! Step into the shoes of a fearless agent tasked with navigating high-rise buildings and completing daring missions. Using your trusty rope, rappel down floors while dodging deadly traps, avoiding obstacles, and overcoming intricate challenges. Every level tests your reflexes, precision, and quick thinking.\n\nThe game's immersive gameplay, combined with a dynamic spy-themed environment, keeps the tension high as you maneuver through diverse scenarios. Whether it\u2019s sliding past laser beams, evading moving barriers, or timing your descent perfectly to avoid hazards, every move counts in this high-stakes journey.\n\nWith stunning visuals, intuitive controls, and escalating difficulty, Mission Possible delivers an action-packed experience suitable for gamers of all skill levels. Whether you're a casual player seeking quick excitement or an adrenaline junkie looking for a challenge, this game has it all.\n\nYour mission, should you choose to accept it, awaits. Can you prove your skills and complete the ultimate spy adventure? It\u2019s time to find out in Mission Possible!", "short_description": "Embark on an adrenaline-filled adventure with Mission Possible! As a daring agent, descend from high floors using your rope skills, dodging obstacles and tackling thrilling challenges along the way. Precision and timing are key as you maneuver through each level to complete your mission. With immersive gameplay, dynamic levels, and a spy-themed atmosphere, Mission Possible will keep you on the edge of your seat. Are you ready to accept the mission and prove your skills?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9135329716582755"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1600055688220563"}, {"status": "PUBLISHED", "id": "847126594464581"}, {"status": "PUBLISHED", "id": "885107170777166"}, {"status": "PUBLISHED", "id": "1084966260467999"}, {"status": "PUBLISHED", "id": "1464111904777466"}, {"status": "PUBLISHED", "id": "1166288571851119"}, {"status": "PUBLISHED", "id": "1817932639064165"}, {"status": "PUBLISHED", "id": "4021310214781058"}]}, "baseline_offer": {"id": "1817932639064165"}, "is_approved": true, "firstOffer":
b=1-7&_nc_sid=6e7a0a&_nc_ohc=8JsdW94eTMUQ7kNvwH09j4u&_nc_oc=AdrhaJ6mM-xuAHZ_c049rXwcti7TQh9WtqEJ0efTVZkLi_vGxYaDzdywymk1QD-yXcA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs2OW39XZDdDcF56jqf3qcuLW-5kmnENKLgHu70kSirA&oe=6A81B13D"}, {"file_name": "Screenshot_4.png", "id": "940810561298393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982729_940810564631726_5871410139956718312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMo9Pnro2y0Q7kNvwE7D4Dc&_nc_oc=AdpmDHi5sXTMi4eksC21IDHC1kOV4FcYGVOkjrBSlXyoCn0G2f__RCib54jhw2gbgHc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPkHYl6oGVd90XSo_Fs6g0WH3LyFHvib8ILIcW4SAd1g&oe=6A81C5F8"}, {"file_name": "Screenshot_6.png", "id": "1075981230837664", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031529_1075981234170997_2586027347069846803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=385bdnC8r8AQ7kNvwE3k0AH&_nc_oc=AdogSnPJu0v5-31YEiSx-eZdrCHKGaTebn6Xn33v1C85LNl-5icK3XCsdaAq9jRMN6U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuNNUIPc5gJe8ajYUCNkr0witI3b8-a8Tz4InPa9t4Fg&oe=6A81AAFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_v4-thumb.png", "id": "1083369979987276", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982614_1083369983320609_6693418688544452232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_Y3rOmSAYQ7kNvwGIHLLz&_nc_oc=AdpRFyz6TzntmWVhKh0pf1zuO9L2YZgmJsP7M2551OjKEU-4F9JJGHzSlEhd0OZorCM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFJfa_fewqp7oLsQLHqM1sNpthzUQxMJ93RBE6sc-mmA&oe=6A81B63C"}, "display_name": "Path of Fury - Episode I: Tetsuo's Tower", "keywords": ["fitness", "arcade", "fighting", "combat", "martialarts"], "long_description": "In Path of Fury: Episode I \u2013 Tetsuo\u2019s Tower, you\u2019re thrust into a relentless gauntlet, armed with nothing but your fists and raw willpower. Tetsuo\u2019s fortress rises above you, each floor crawling with enemies that are ready to end you. Your only option? Punch your way through every last one of them.\n\nPrecision and speed are everything. Each enemy has a weakness\u2014you\u2019ll have to find it and strike before they swarm. As the floors stack higher, so do the odds. The action doesn\u2019t let up, and neither can you. This is pure, high-stakes combat where every punch counts, and hesitation could be fatal.\n\nPath of Fury doesn\u2019t just test your skill\u2014it tests your endurance.\n\nThe question is: how far can you go?", "short_description": "In Path of Fury: Episode I \u2013 Tetsuo's Tower, you're launched into an unforgiving journey\u2014a VR adventure set in the midst of a merciless city. Starting at the foot of Tetsuo\u2019s towering fortress, each strike echoes in the storm of violence. In this desolate world of lost souls and neon-soaked exiles, fight floor by floor, leveraging techniques honed for close-quarters combat, as you carry the weight of retribution to the summit."}]}, "developer_name": "Leonard Menchiari", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/85d951c5-8438-41a8-a0ba-9796bc2d6d29", "developer_terms_of_service_url": null, "publisher_name": "ABONICO GAME WORKS", "support_website_url": null, "website_url": "https://www.pathoffury.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoEjgJkbr5uxl2EQJDy110cdO_C6_BUVw6szK8sXd1ow&oe=6B0B3524"}, {"file_name": "Screenshot_7.png", "id": "419878027611892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974485_419878030945225_3411227010233150423_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tTV--krB9QQ7kNvwHEu-dE&_nc_oc=AdpHqWWCUa_-3ybQHWHZ6cp5ZRlw1D4jMhsUXjjGLpOo5Qb-S5xwcGmr60ZC3rvAQA0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTD6jXYQBX6KeS5FCjgWTh9KVhw0ENvAl99Ev4k0gjE3Q&oe=6B0B3DBD"}, {"file_name": "Screenshot_4.png", "id": "940810561298393", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982729_940810564631726_5871410139956718312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EKAjUFKlAsQ7kNvwGAeFt5&_nc_oc=Adq3DOZKQouO5dxSmPUqrhyyrfpTVByGk4i8hvdleRHYRlyYX1c7u94Mjn3lbbNZo_k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaunwcJu4_W931HYt2yJFcoB5u8VVb5bCeDsWeY54iew&oe=6B0B1A38"}, {"file_name": "Screenshot_6.png", "id": "1075981230837664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031529_1075981234170997_2586027347069846803_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrq_ukgfJ3kQ7kNvwGNMy5p&_nc_oc=AdpUZDVikW4jfjb5NO8QqFbFt0XbkgEHOZxqHCbBCi9CV_fhFdxGMr9BicFPioSS384&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXHZCO68QqvWHIh3NoW6yKv1b7stdnfaThksyNQ05Z-g&oe=6B0B377E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_v4-thumb.png", "id": "1083369979987276", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982614_1083369983320609_6693418688544452232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dr1Niqg-h0Q7kNvwHt5tds&_nc_oc=AdrUWfHmV7iHTIgRIXo5xxqOvskqXO2hQRG5Sg6wpjnphBIRkwIGq-ErgALXOKaJ_T4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTm9oe9J-YVgtxKT2WmW4WJqIiVUmJM6vZ0pkbKIAbxZg&oe=6B0B42BC"}, "display_name": "Path of Fury - Episode I: Tetsuo's Tower", "keywords": ["fitness", "arcade", "fighting", "combat", "martialarts"], "long_description": "In Path of Fury: Episode I \u2013 Tetsuo\u2019s Tower, you\u2019re thrust into a relentless gauntlet, armed with nothing but your fists and raw willpower. Tetsuo\u2019s fortress rises above you, each floor crawling with enemies that are ready to end you. Your only option? Punch your way through every last one of them.\n\nPrecision and speed are everything. Each enemy has a weakness\u2014you\u2019ll have to find it and strike before they swarm. As the floors stack higher, so do the odds. The action doesn\u2019t let up, and neither can you. This is pure, high-stakes combat where every punch counts, and hesitation could be fatal.\n\nPath of Fury doesn\u2019t just test your skill\u2014it tests your endurance.\n\nThe question is: how far can you go?", "short_description": "In Path of Fury: Episode I \u2013 Tetsuo's Tower, you're launched into an unforgiving journey\u2014a VR adventure set in the midst of a merciless city. Starting at the foot of Tetsuo\u2019s towering fortress, each strike echoes in the storm of violence. In this desolate world of lost souls and neon-soaked exiles, fight floor by floor, leveraging techniques honed for close-quarters combat, as you carry the weight of retribution to the summit."}]}, "developer_name": "Leonard Menchiari", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/85d951c5-8438-41a8-a0ba-9796bc2d6d29", "developer_terms_of_service_url": null, "publisher_name": "ABONICO GAME WORKS", "support_website_url": null, "website_url": "https://www.pathoffury.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "gen
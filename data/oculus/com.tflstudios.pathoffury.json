iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvAQeOBLoYwxpGvEOAMLorAsyuC70aVgapN1575YjCQ&oe=6B046564"}, {"file_name": "Screenshot_7.png", "id": "419878027611892", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974485_419878030945225_3411227010233150423_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5XhZrZMt8EQ7kNvwE-Z-Ay&_nc_oc=AdpLc_ROBpO38lHo0bCQynlrdfz3QCJBDYJ6t6PMEE9kaPEwV6wZiv7Gu8L_NdU0UP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT1c8mlyLTp6sF7qDOwH7PxBXGmX-WOPU8VOquT2XEQw&oe=6B046DFD"}, {"file_name": "Screenshot_4.png", "id": "940810561298393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982729_940810564631726_5871410139956718312_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l17Z6PLdhNkQ7kNvwGKMeFP&_nc_oc=AdpHWGV4qWERHT0ocLm2cbQYErhLnscvBiEA8rcRGSeGmXD137DUsJ0emaiaKmm3HnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiYJKP8OBfKEjAA0ZRYXTws-zOBGUTFIHPclRkuY9esQ&oe=6B0482B8"}, {"file_name": "Screenshot_6.png", "id": "1075981230837664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_1075981234170997_2586027347069846803_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krdsU8NQWIsQ7kNvwHhqQKM&_nc_oc=AdrK0i7fPgw637ynBa7bg5leGRYY2MEoIbQLeujvsGESrdZA2J_z-9B91mN7U1yANfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRLTcQZbuINKKXeg44o9XiCtHIqFO31-irOkVBwbLp6w&oe=6B0467BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_v4-thumb.png", "id": "1083369979987276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982614_1083369983320609_6693418688544452232_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1m93zse2jsQ7kNvwH9QYum&_nc_oc=AdrheDusnZ89fUXLwzuGVyWg35V9mFvmhgHpFh786GwcOrq03-q3yuy1XRI_xxBJKtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2uW8ejOxb92Yq3m-xM3FUpaT3-yl8ahegtgR13EZl4Q&oe=6B0472FC"}, "display_name": "Path of Fury - Episode I: Tetsuo's Tower", "keywords": ["fitness", "arcade", "fighting", "combat", "martialarts"], "long_description": "In Path of Fury: Episode I \u2013 Tetsuo\u2019s Tower, you\u2019re thrust into a relentless gauntlet, armed with nothing but your fists and raw willpower. Tetsuo\u2019s fortress rises above you, each floor crawling with enemies that are ready to end you. Your only option? Punch your way through every last one of them.\n\nPrecision and speed are everything. Each enemy has a weakness\u2014you\u2019ll have to find it and strike before they swarm. As the floors stack higher, so do the odds. The action doesn\u2019t let up, and neither can you. This is pure, high-stakes combat where every punch counts, and hesitation could be fatal.\n\nPath of Fury doesn\u2019t just test your skill\u2014it tests your endurance.\n\nThe question is: how far can you go?", "short_description": "In Path of Fury: Episode I \u2013 Tetsuo's Tower, you're launched into an unforgiving journey\u2014a VR adventure set in the midst of a merciless city. Starting at the foot of Tetsuo\u2019s towering fortress, each strike echoes in the storm of violence. In this desolate world of lost souls and neon-soaked exiles, fight floor by floor, leveraging techniques honed for close-quarters combat, as you carry the weight of retribution to the summit."}]}, "developer_name": "Leonard Menchiari", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/85d951c5-8438-41a8-a0ba-9796bc2d6d29", "developer_terms_of_service_url": null, "publisher_name": "ABONICO GAME WORKS", "support_website_url": null, "website_url": "https://www.pathoffury.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "gen
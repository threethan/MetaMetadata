scontent-ord5-2.oculuscdn.com&oh=00_Afvrq4ZqvV4ybTuV2NC0s3QAZoR9gYkwkV0S7Bf9bVd3lA&oe=699AFABD"}, {"file_name": "Screenshot_4.png", "id": "940810561298393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982729_940810564631726_5871410139956718312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo_a040C2DoQ7kNvwHSUetc&_nc_oc=Adl7IuRtvThQFBPMZfEvHLB_EiZ-o_arUHILDq3tDW_mEoPvV3gN000uiZbycQw-h2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsWEpF7TGUx9ZkyMC2oxSIiROxWwf-6G2ifmPiAo5y8BQ&oe=699B0F78"}, {"file_name": "Screenshot_6.png", "id": "1075981230837664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_1075981234170997_2586027347069846803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTv1qHDCKOUQ7kNvwGH6M0N&_nc_oc=AdlZcJGbvvklJdZr1ze6g4dB4xrHmWqpCco9_hboNqXSYUR2D9NPJjnmiFJ6KCMVr5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuCaGr5zZdx7Z37RLZwtJiRb016Q0bOEl21oCXOoO1kQQ&oe=699AF47E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_v4-thumb.png", "id": "1083369979987276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1083369983320609_6693418688544452232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGQGKJYopGYQ7kNvwF__m2h&_nc_oc=AdmMZmHzuDjcIgFUK96nZ6UuuBjl2lHroReJVgtgplh6KfSEW_08Md6X5Q37Yokb5gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuEKk239Nf-jtu_xZXBPa--cjRJF5MWnVeVuUAr3anzeQ&oe=699AFFBC"}, "display_name": "Path of Fury - Episode I: Tetsuo's Tower", "keywords": ["fitness", "arcade", "fighting", "combat", "martialarts"], "long_description": "In Path of Fury: Episode I \u2013 Tetsuo\u2019s Tower, you\u2019re thrust into a relentless gauntlet, armed with nothing but your fists and raw willpower. Tetsuo\u2019s fortress rises above you, each floor crawling with enemies that are ready to end you. Your only option? Punch your way through every last one of them.\n\nPrecision and speed are everything. Each enemy has a weakness\u2014you\u2019ll have to find it and strike before they swarm. As the floors stack higher, so do the odds. The action doesn\u2019t let up, and neither can you. This is pure, high-stakes combat where every punch counts, and hesitation could be fatal.\n\nPath of Fury doesn\u2019t just test your skill\u2014it tests your endurance.\n\nThe question is: how far can you go?", "short_description": "In Path of Fury: Episode I \u2013 Tetsuo's Tower, you're launched into an unforgiving journey\u2014a VR adventure set in the midst of a merciless city. Starting at the foot of Tetsuo\u2019s towering fortress, each strike echoes in the storm of violence. In this desolate world of lost souls and neon-soaked exiles, fight floor by floor, leveraging techniques honed for close-quarters combat, as you carry the weight of retribution to the summit."}]}, "developer_name": "Leonard Menchiari", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/85d951c5-8438-41a8-a0ba-9796bc2d6d29", "developer_terms_of_service_url": null, "publisher_name": "ABONICO GAME WORKS", "support_website_url": null, "website_url": "https://www.pathoffury.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9033912306654312"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1431628971825275"}, {"status": "PUBLISHED", "id": "2353252541746779"}, {"status": "PUBLISHE
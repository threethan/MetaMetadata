b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDu80s0wagEQ7kNvwHAvLvH&_nc_oc=Adrh__0G5erbOcYRVqwov9PxFlaegLdutYKwhrMJ7KgF6AgoN8yKuDE9SfzZsVa-NnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i2to3c5SSFifK81x-nM9lJgP_nkwYHdj_XNl27BSc_A&oe=6A3FC63D"}, {"file_name": "Screenshot_4.png", "id": "940810561298393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982729_940810564631726_5871410139956718312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC3sMtNEHjIQ7kNvwFklhct&_nc_oc=AdrbXphHDc-4l9rcAtKc3q1qSxUj0V0_6uXllyOQ5gESIohzk6xrCJoH0mDuMq07s9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IHBjfIDyhabHGJ4xSnk0vW1dqdqRO6KQ--LVNE77YHg&oe=6A3FDAF8"}, {"file_name": "Screenshot_6.png", "id": "1075981230837664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_1075981234170997_2586027347069846803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLAduCqFodcQ7kNvwHwuwct&_nc_oc=AdrYfO6MgpMSkuApBn9BzWEOauDbQz5amPqMl1zjhkkwkYc4mihlgwe87pt81IAnrxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yz_-GA5yth2LmZrw1kNxO3xVMEhgtNzvrGipSUFnGWg&oe=6A3FBFFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440_v4-thumb.png", "id": "1083369979987276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982614_1083369983320609_6693418688544452232_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WCOkrOkBpQQ7kNvwF4Efyt&_nc_oc=AdqYlX7UshKn-184vtNZyNFm4z2gwdgDglN66Awdhpns4m96W9wK3QqiLZCnfOkRQYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p66V8fqK5-8i87YBE0UUD7qj4-iJV5fCSC4TJNSk7uw&oe=6A3FCB3C"}, "display_name": "Path of Fury - Episode I: Tetsuo's Tower", "keywords": ["fitness", "arcade", "fighting", "combat", "martialarts"], "long_description": "In Path of Fury: Episode I \u2013 Tetsuo\u2019s Tower, you\u2019re thrust into a relentless gauntlet, armed with nothing but your fists and raw willpower. Tetsuo\u2019s fortress rises above you, each floor crawling with enemies that are ready to end you. Your only option? Punch your way through every last one of them.\n\nPrecision and speed are everything. Each enemy has a weakness\u2014you\u2019ll have to find it and strike before they swarm. As the floors stack higher, so do the odds. The action doesn\u2019t let up, and neither can you. This is pure, high-stakes combat where every punch counts, and hesitation could be fatal.\n\nPath of Fury doesn\u2019t just test your skill\u2014it tests your endurance.\n\nThe question is: how far can you go?", "short_description": "In Path of Fury: Episode I \u2013 Tetsuo's Tower, you're launched into an unforgiving journey\u2014a VR adventure set in the midst of a merciless city. Starting at the foot of Tetsuo\u2019s towering fortress, each strike echoes in the storm of violence. In this desolate world of lost souls and neon-soaked exiles, fight floor by floor, leveraging techniques honed for close-quarters combat, as you carry the weight of retribution to the summit."}]}, "developer_name": "Leonard Menchiari", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/85d951c5-8438-41a8-a0ba-9796bc2d6d29", "developer_terms_of_service_url": null, "publisher_name": "ABONICO GAME WORKS", "support_website_url": null, "website_url": "https://www.pathoffury.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
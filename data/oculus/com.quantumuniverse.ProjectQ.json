&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acmbqsNjQHsQ7kNvwF9V73g&_nc_oc=AdqxiuQztw-gED6CYVToHm6hRs0NVDyHX8x0WvOdd2R5HvaBJ4sGca2kM_FL76GR1SM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QGd4ssaU6B38tXJngbpZ60gVwZj_pl2bUHmpVBL9q9g&oe=6A33EDA3"}]}, "id": "941127277989911", "locale": "en_US", "screenshots": [{"file_name": "CKD_Screenshots_1.png", "id": "1141291077558620", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031417_1141291080891953_5144409985231830379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLiDWgPe2lcQ7kNvwFZ9gIc&_nc_oc=Adp-SR25IwEHiscFCD-ORzV4biSfDNOea8i7yT2PUw0QNdei135Rk9tEKIIJncxGIn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-upn4twEI1w3Uk2E7PUzh51R2-UBVIhe7T8N3JxSDYFg&oe=6A33EBF3"}, {"file_name": "CKD_Screenshots_2.png", "id": "9037165476321542", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982563_9037165482988208_1151831248099588153_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVwERO9CNtAQ7kNvwHkJh69&_nc_oc=AdoVW0u7RG91xdaP5BoHFY5VYsuAkVCjEjg4BmsWjXCXEgTdUS7lvI8KG9bI5eqAy_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-noRcDnkscA00TXPwvmTtSCvtQ_3eb-ms7yO76by9iJg&oe=6A3408E2"}, {"file_name": "CKD_Screenshots_3.png", "id": "898863585793670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_898863595793669_1305649271311713198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYnDwDHh6qQQ7kNvwHtrwAW&_nc_oc=AdpYWTmY3IobFH8y5Ud1KbwsqKyLC28UwVU8Gg-8kn1g9b_eJKkCgtHOafmqKAmdNbo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dYoWcVO6FbRXNtC4XRlJsJc_czSvw6jFMn8EvqOCEbg&oe=6A341184"}, {"file_name": "CKD_Screenshots_4.png", "id": "604580268631969", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982477_604580275298635_5064479993432018264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tP1tuhfMj8Q7kNvwFaGSyB&_nc_oc=AdoUBUnBQ97UiVNtzaq8l7svniWOJdV1x1C7S3fMtpJtVFFCTEOtbI6aVEBNPvvqtl8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XMuBS_I6YC_4YMvVvYsof5354zCjcr8WAd0wBCZnNtQ&oe=6A33F812"}, {"file_name": "CKD_Screenshots_5.png", "id": "1722305365278616", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75500287_1722305368611949_4332690201771954895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGwD058CTfoQ7kNvwGY7PdU&_nc_oc=Adq_qJnjriSMQC-AYkkxRf4wxWqC8j5OdfuyxoYyA_HrqSaijS5_A4T7Td3CbknvI08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GPPB64qZsV4Ule2yL-VpV7u7y5j6G_QiQnQQ9dpXW7w&oe=6A3414B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "the ChicKing Dead", "keywords": ["Locomotion", "Zombie", "Tag", "Socialplay", "socialgame"], "long_description": "Welcome to The ChicKing Dead! \ud83d\udc14\ud83e\udddf\u200d\u2642\ufe0f\n\nDive into a dystopian chicken world like no other, where creativity and chaos collide. As a heroic chicken, you must face a zombie virus outbreak while unraveling the sinister plans of a giant corporation. Survival isn't just about fighting\u2014it's about strategy, skill, and a dash of absurd fun.\n\nKey Features:\n\n- Unorthodox Gameplay: Soar through the skies with advanced locomotion, pulling off tricks and outsmarting your foes with unconventional tactics.\n\n- Customizable Characters: Express your unique style with an array of wild costumes and cosmetic items.\n- Thrilling Tag-Style Battles: Engage in fast-paced, heart-pounding matches filled with action and creativity.\n- Dynamic Social Interaction: Connect with other players in a lively multi-lobby, share user-generated content, and display your in-game achievements.\n- Expansive Community Focus: Your feedback shapes the future\u2014help us build the ultimate VR experience!\n\nJoin the flock, outwit the undead, and unleash your creativity in this one-of-a-kind VR adventure. The Chicking Dead is more than a game; it\u2019s a community-driven experience that evolves with its players. Are you ready to take flight and turn the tide?", "short_description": "Step into a dystopian chicken world where creativity meets chaos! \nFight to survive against a zombie virus outbreak and the schemes of a giant corporation. \nGlide through the air, master advanced locomotion skills, and turn the tide with unorthodox strategies. \nCustomize unique costumes, compete in thrilling tag-style battles, and showcase your achievements in personal spaces. \nWith a mix of social interaction, user-generated content, and high-paced gameplay, this is a VR adventure like no other"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chickingdead.com/privavy-policy", "developer_terms_of_service_url": "https://www.chickingdead.com/terms-conditions", "publisher_name": "none", "support_website_url": "https://www.chickingdead.com/", "website_url": "https://www.chickingdead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9115883498488836"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1001564501436662"}]}, "baseline_offer": {"id": "1001564501436662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744304400, "status": "PUBLISHED", "id": "1001564501436662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27289952033988705", "version": "2.2.2.202606141248"}, "i
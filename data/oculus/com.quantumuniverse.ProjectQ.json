-TYoUqYQy-YBp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2xg8NpEF23Two_ILGjRPNcpxYjb64Swl4uEw3xHTk9g&oe=69C3C812"}, {"file_name": "Screenshot_05.png", "id": "1418632406076517", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618938_1418632409409850_1222903700897137026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wfEa97fJsQQ7kNvwG_h4Va&_nc_oc=AdqJNMFVxroQH5sY4pJEdrifxWlH6-5fQhaxXOH9FgpYHZDO91tZQLcyzHnt4lm9l3o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLEoPdYXMGNhGieOdhwQUbnWzqbm2Gs6WzLfMiT6S3ig&oe=69C3BD35"}, {"file_name": "Screenshot_04.png", "id": "1955674918687542", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618938_1955674922020875_8863028235691011534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzP8OLTr_hMQ7kNvwE3M5fE&_nc_oc=AdowsQ7dGLMBqZtH1xy5ck-rP9EEa7KEnGZONGpM2xF0-O6iQ6CA6toVIVCO7WCwUCs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHWuPgrF_8MTYN80S_RI0E3ss7lQLTEeceaXAaHv5CkQ&oe=69C3E8AC"}, {"file_name": "Screenshot_03.png", "id": "943506624863801", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_943506628197134_2000984985910046935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCKVOc9Mt4QQ7kNvwEdMdlL&_nc_oc=AdqUaWwJMos5495cctk2RC9Y_vMFSm8H9fA_uNrHKAuJjx3zBIDKpkc5rKO8HGadbtE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqPQjZ0v_whCfwa4ZKSuMm7dJJF1bfLjimkdeTvgUtEg&oe=69C3C1BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CKD_Cover_Art_Landscape_01.png", "id": "1586321245792503", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620875_1586321249125836_9105348278106641901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjvhF_fbO6YQ7kNvwEIFUB8&_nc_oc=Adr_bdp-OTstI4iFgI_G_SV4mixVD26JhL3QnfzX3Yp8e3u1BDVXnXTkfqPQYUwBrls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOIr3III3jFaIDbG_-ayBWHMTi81mmc2GvcV82PgsEuQ&oe=69C3C990"}, "display_name": "the ChicKing Dead", "keywords": ["Zombie", "Adventure", "Mech", "Shooting", "Gun"], "long_description": "# WHAT THE...?! A GIANT FREAKIN' ZOMBIE! \n\nThe inevitable has happened. A massive, hideous Boss Zombie has finally crawled out of the apocalypse. Just how much nastier can this virus get? Deep underground, where no soul dares to go... Seriously, don\u2019t go in there alone.\n{3446968245460435}\n\n# Nightmarish Creatures Everywhere\n\nThe world is crawling with mutated freaks. From bloated giants to winged horrors diving from the sky\u2014think you can take them all down?\n{1401055841308395}\n\n# Meet 'BUST': Your Metal Beast \n\nGoing in naked? That\u2019s a suicide mission. Hop into BUST, a massive mecha with overwhelming size and raw destructive power. We've got the heavy artillery ready\u2014get in, and start stomping those freaks into the dirt.\n{4364008010481057}\n\n# Friends or Foes? \n\nZombies aren't your only problem. In this world, other players are part of the chaos. Will they be your squadmates or your next target? Kill or be killed\u2014it\u2019s time to prove who's the real boss.\n\n{1567503271017619}\n\n# The Endless Apocalypse \n\nFrom barren deserts and lava fields to toxic gas zones\u2014this viral hellscape is only getting bigger. New zones are constantly unfolding. Are you ready to explore?\n{1505697607566437}\n\n# More Fun News and Events on Discord!\n\n \ud83d\udc49 discord.gg/chickingdead\n\n", "short_description": "Welcome to the craziest chicken apocalypse ever. \ud83d\udc14\ud83d\udca5\nFly with your Gearwing, face off against players, and hunt down zombie chickens in wild, fast-paced battles.\nMix and match over 100 high-quality cosmetics to flex your ultimate chicken style and show it off to your friends.\nThis is your fight for fun, chaos, and the crown.\nJoin the community now and get the latest drops, events, and updates. \ud83d\udc51\nThe ChicKing Dead \u2014 where style meets survival."}]}, "developer_name": "QU", "developer_privacy_p
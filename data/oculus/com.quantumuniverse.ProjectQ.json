nt-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73VvyD5C3YnzFmckGG2uRK-isOCSIAKrSu8bI1xeZ2MQ&oe=6A0B1992"}, {"file_name": "CKD_Screenshots_5.png", "id": "1722305365278616", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75500287_1722305368611949_4332690201771954895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvTPlzeHyO4Q7kNvwGT7A14&_nc_oc=AdoF45p38u8ZERcjlr1fTBd5_feOddqLXbY4gKcpUyQ2yJQEB253g0UgjSSUakAj3QY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QXupm2kVK-F2rKpYRI0GcjTxqssrFE2x-EnidRSCTeg&oe=6A0B3631"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "the ChicKing Dead", "keywords": ["Locomotion", "Zombie", "Tag", "Socialplay", "socialgame"], "long_description": "Welcome to The ChicKing Dead! \ud83d\udc14\ud83e\udddf\u200d\u2642\ufe0f\n\nDive into a dystopian chicken world like no other, where creativity and chaos collide. As a heroic chicken, you must face a zombie virus outbreak while unraveling the sinister plans of a giant corporation. Survival isn't just about fighting\u2014it's about strategy, skill, and a dash of absurd fun.\n\nKey Features:\n\n- Unorthodox Gameplay: Soar through the skies with advanced locomotion, pulling off tricks and outsmarting your foes with unconventional tactics.\n\n- Customizable Characters: Express your unique style with an array of wild costumes and cosmetic items.\n- Thrilling Tag-Style Battles: Engage in fast-paced, heart-pounding matches filled with action and creativity.\n- Dynamic Social Interaction: Connect with other players in a lively multi-lobby, share user-generated content, and display your in-game achievements.\n- Expansive Community Focus: Your feedback shapes the future\u2014help us build the ultimate VR experience!\n\nJoin the flock, outwit the undead, and unleash your creativity in this one-of-a-kind VR adventure. The Chicking Dead is more than a game; it\u2019s a community-driven experience that evolves with its players. Are you ready to take flight and turn the tide?", "short_description": "Step into a dystopian chicken world where creativity meets chaos! \nFight to survive against a zombie virus outbreak and the schemes of a giant corporation. \nGlide through the air, master advanced locomotion skills, and turn the tide with unorthodox strategies. \nCustomize unique costumes, compete in thrilling tag-style battles, and showcase your achievements in personal spaces. \nWith a mix of social interaction, user-generated content, and high-paced gameplay, this is a VR adventure like no other"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chickingdead.com/privavy-policy", "developer_terms_of_service_url": "https://www.chickingdead.com/terms-conditions", "publisher_name": "none", "support_website_url": "https://www.chickingdead.com/", "website_url": "https://www.chickingdead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9115883498488836"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1001564501436662"}]}, "baseline_offer": {"id": "1001564501436662"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744304400, "status": "PUBLISHED", "id": "1001564501436662"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26811596545157592", "version": "2.0.1.202605071411"
, "id": "2230328380672744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035460_2230328384006077_4388260490720253078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5_EHG1RGE0Q7kNvwGdrsaX&_nc_oc=AdoVzM3ln0LbkpSBNyjx9h-TZuebbvN1bK-XhXfCVRS8yZblDa_vrYwTOkHmVNWUlcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8quLz64eU9ePEflSYKH3PrC3rXjZ92oWA9cUQXCCLKw&oe=6AC66D73"}, {"file_name": "460984283_1263548744893207_552607483476233797_n.png", "id": "554146580600301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_554146583933634_8922189201419226019_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvHGeNTfE8UQ7kNvwFw7LqU&_nc_oc=Adq0eBbfrSu40XZNd_FnAeyn_wVcNfhSa82SyNiMKp-oH5iELk8fc9c-zH3Swx1Mv-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB_F3ONaRz0VrRmBw1WDbeAI3U63kxke6QSsfeD0b4iA&oe=6AC65089"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "media view.001.png", "id": "2782662775434166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_2782662778767499_6846118493809904984_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYECUzjRcqoQ7kNvwFFVVwW&_nc_oc=AdpUGtlmJjtE5KQeuPslZY8JpEogLpdCddWIRxcJNn55L8m1EX4rnxARWtQyT2fgl1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2K1gh3GErfG7lN-vx-GyGsNszW13nD0ooXX2Ggarvzw&oe=6AC6712C"}, "display_name": "Media View", "keywords": ["video", "player", "media", "gallery", "360"], "long_description": "# Media View brings all digital media into mixed reality.\n\nWe are building a streamlined utility to let you step out of the confines of a traditional screen and view your content using the space around you.\n\n**Please note: Media View is in active development. Critical updates are coming soon.**\n\nWhat it does today:\n\n- Multi-Panel Workspace: View multiple (currently limited to 3) 2D photos, panoramas, and 360\u00b0 videos simultaneously around your space. \n\n- Immersive Mode: Instantly toggle from your multi-panel layout to step inside 360\u00b0 and panoramic content with full room-scale immersion.\n\n**Known Issues & What\u2019s Next:**\n\nWe hear the community: getting your own custom content into the app is currently frustrating. We are actively rebuilding the file upload workflow. Please be patient with us as we iron out these bugs and push critical updates over the coming weeks.\n\nWe are building this tool for the VR community, and your input drives our roadmap. To submit feature requests, report bugs, or connect with our team, please visit: mediaviewxr.com", "short_description": "Media View is an in-development media viewer & content player for mixed reality. Surround yourself with your personal media by viewing 2D photos, panoramas, and 360\u00b0 videos around your space, or step inside them in immersive mode. Please note: We are actively fixing known issues with custom file uploads. Critical updates are coming soon, so please bear with us! Submit feedback at mediaviewxr.com."}]}, "developer_name": "L+R", "developer_privacy_policy_url": "https://mediaviewxr.com/privacy-policy", "developer_terms_of_service_url": "https://mediaviewxr.com/terms", "publisher_name": "L+R", "support_website_url": "https://mediaviewxr.com/", "website_url": "https://mediaviewxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_
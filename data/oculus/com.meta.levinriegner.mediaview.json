.com&_nc_ss=7f20f&oh=00_AQMJOHta8H0-eVbdQYMjHlOATmD6iSy8_pRcBeFFr571lw&oe=6AC6514C"}, {"file_name": "Dashboard [360].png", "id": "8194934723888943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221322_8194934727222276_7198132996073805409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDxSFEcvRGsQ7kNvwEDPWN1&_nc_oc=AdrY6u0I64d5-CEUuVRuS5H4x6lS8amuWeyUQFxx4Nm0-XiBjgijTFs89DHcOusEe7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc7x45YWwnJne6_it4TYhy0Bz-UwLfDYgJfRnH1A69cQ&oe=6AC65BFF"}, {"file_name": "Dashboard [Ray-Ban].png", "id": "1532366430739995", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86627634_1532366434073328_4454899938512176946_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubpZF-_vFzgQ7kNvwFah5js&_nc_oc=AdpdyIrPhNFOwdU9B-ig0tOJzbfstXYUNYKH7xkNPNquA20kLuKwQE1UUOPQzynIByc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwLlc90zeTy_7ghNRU4CoutSvqamojv7XlcZgfMkNG3A&oe=6AC65F8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Media View", "keywords": ["media", "immersive", "spatial", "panorama"], "long_description": "Experience your photos and videos in a mixed reality environment. Whether for personal projects, professional use, or simply exploring media in a new way, Media View provides an intuitive experience, offering a fresh perspective on an important utility application in a spatial setting.\n\n**Media Compatibility**\n\nWith a continually expanding range of media types, Media View currently supports viewing standard photos and videos, 360\u00b0 media, and panoramas. New formats, like content captured with Ray-Ban Meta, are also being integrated, with more on the way.\n\n**Multi-Panel Viewing**\n\nExperience a fully immersive environment by surrounding yourself with selections of your photos and videos in an immersive floating collage. It\u2019s unlike anything you\u2019ve seen before! View and interact with all media types simultaneously in a spatial environment, creating a dynamic and interactive experience that surrounds you in every direction.\n\n**Immersive Viewing**\n\nToggle between viewing your media around you (with Multi-Panel Viewing) to fully immersing yourself in your space with individual photos or videos in \u201cImmersive View\u201d. Whether it's a 360-degree image, a panorama, or a standard video, Media View allows you to dive deep into immersive views, letting you explore every detail as if you were inside the media itself.\n\n**Current media types supported:**\n- Standard Photos & Videos\n- 360 Photos & Videos\n- Panoramas\n- Ray-Ban Meta Photos & Videos\n", "short_description": "Interact with standard and immersive photos and videos in a mixed reality environment. Media View supports a growing range of media types including standard photos and videos, 360\u00b0 media, panoramas, and Ray-Ban Meta content. Surround yourself with media in an immersive collage or fully dive into individual views. Built with the Meta Spatial SDK for Quest, Media View offers a dynamic, intuitive experience for exploring your media in new ways."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://meta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
D3Zppz0W_MdqyPDdfQ86RS7cWdqg-dmCZcTz2qQ&oe=6A09DA13"}, {"file_name": "CivVIIVR_MR_Commander_2560x1440.png", "id": "1281694239554695", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392005_1281694242888028_8950602080941954138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezMM94QBycQ7kNvwECgQ6m&_nc_oc=AdrZ7kRph6QjtvIJrIAq-AJfUaWn2SYjCdcq4QfqEUmnt4r-R08kdkmzeZDvqJETGTQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PgFDgmVewuc8T3iMbiyvS9Wvyo7Eb2juFM8DJAjTTXQ&oe=6A09C50B"}, {"file_name": "CivVIIVR_MR_Leader_2560x1440.png", "id": "1132124945065525", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391871_1132124948398858_9179803926541652209_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSusISiIlQcQ7kNvwE5t0Ct&_nc_oc=AdoWnY17IfgMqMEc2jLepgc1tJJmLZhGGozOHGsLgkEjR8vFe2fnIJfhCjY-264qPic&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bxj1ronnxmRBRWFoY4-un8wZqV3bARPGCWiKE4TJ9cA&oe=6A09B745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CivVII-VR-Thumbnail-Wide-MQ3.png", "id": "924938593002096", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394097_924938596335429_6306348634871891396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INYv4WMo0yQQ7kNvwF3qshA&_nc_oc=AdrlIPYicfs3pCajiPlFIEIdchJs3Gy9cqSDsiDavXQZV0YJEtkt1wwZkDPCOTHxc7U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46l1XjKrazuVrYzFdqLpb3HOSK_Gt_GFmXa72uo7ZNfA&oe=6A09ADAD"}, "display_name": "Sid Meier's Civilization\u00ae VII - VR", "keywords": [], "long_description": "# SID MEIER'S CIVILIZATION\u00ae VII - VR\n\nThe award-winning Civilization strategy series comes to virtual and mixed reality for the first time in franchise history. Experience a revolutionary new chapter from Firaxis Games with Sid Meier's Civilization\u00ae VII - VR, only on Meta Quest 3 and 3S. Take your place at the Command Table and immerse yourself as you build an empire to stand the test of time.\n \nChart a course for your people, engage with other leaders, research technological breakthroughs, and conquer or cooperate with rival civilizations as you explore the far reaches of the unknown world.\n\n**A TRUE CIVILIZATION EXPERIENCE IN VR/MR**\n\nEnjoy Civilization from a unique perspective, whether you're peering down from high above the map or leaning all the way in to appreciate the finer details of every building and unit.\n \n**MEET VISIONARY LEADERS FACE-TO-FACE**\n\nIconic world leaders surround the Command Table, reacting whenever you forge alliances or declare war.\n \n**YOUR EMPIRE ENTERS YOUR REALITY**\n\n\nReach out and take control with the new interface designed for Meta Quest 3 and 3S, letting you change viewpoints at will and bring the Command Table into your surroundings with dynamic mixed reality.\n\n**CONQUER OR COOPERATE**\n\n\nPlay solo or compete in online multiplayer matches with up to three other Meta Quest 3 and 3S players.*\n\n*Online multiplayer requires an Internet connection, a 2K Account (minimum age varies), and a Meta account.\n\nSoftware Terms of Service (ToS) in game and at www.take2games.com/legal.", "short_description": "The award-winning Civilization strategy series comes to virtual and mixed reality for the first time in franchise history. Experience a evolutionary new chapter from Firaxis Games with Sid Meier's Civilization\u00ae VII - VR, only on Meta Quest 3 and 3S. Immerse yourself as you build an empire to stand the test of time, research technological breakthroughs, and conquer or cooperate with rival civilizations as you explore the far reaches of the unknown world."}]}, "developer_name": "Firaxis Games, PlaySide Studios", "developer_privacy_policy_url": "https://www.take2games.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "2K Games", "support_website_url": null, "website_url": "https://civilization.2k.com/civ-vii/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
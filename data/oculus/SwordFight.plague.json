ord in the castle grounds before fighting your way through an army of undead out in the city! Be part of the action, save your homeland from invasion and fight on the frontlines of the battle!"}]}, "developer_name": "Neil Lawson", "developer_privacy_policy_url": "https://plague-studios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Plague Studios", "support_website_url": "https://www.plague-studios.com/contact", "website_url": "http://www.plague-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464307275134276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974908_2175337256062060_1168713914670645248_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzVW7KfEDD0Q7kNvwH7_dpY&_nc_oc=AdmQYfYLCaIR-P7oUShBpD6RdfKA2u3JINFsA8atAPWumfs94EnQ_oLKxr3QtYfeHyQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8IQpK6u-sOtSe2OPDwQgHNgO5Ja2aYu8sJFMN8fs6-Q&oe=69AAB973"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SwordFight!", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1549472400, "lastRevision": {"nodes": [{"id": "202919047065042", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2321213081230191", "is_first_party": false, "enables_in_
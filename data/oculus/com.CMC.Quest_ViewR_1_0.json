7&_nc_sid=6e7a0a&_nc_ohc=UuKM5mka05cQ7kNvwEf3EwO&_nc_oc=AdrBr6NdVOoYGuOoPmLE7YZ2sFkp1O5XtrEbM-WEFbhvXAMvH_mmzdYs98bUY5G_Pqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpY0vj6GAEeFyKI6h28poEVUH-Totmgt3Z4hEabOqZyw&oe=6AE76279"}, {"file_name": "image_06_scaled.png", "id": "1530989168370249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1530989171703582_641748503021390444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxEMNdxaWQkQ7kNvwG9Zn6P&_nc_oc=AdoT0nlCSbJ2IOb8tig1Auqx_fzEi4F2tgc99mQe-wBVBKRb4hV_SuXlw0kIUEo26UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBcNkwRxbvd7G2HEyJhbZRcnTfBf_LdU41RcVT6SDIyg&oe=6AE75A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_Image.png", "id": "3613837282193747", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575362_3613837285527080_5192729747536336340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k4DoAWgZc4Q7kNvwEoiI7z&_nc_oc=AdqdFCDmSlZZNZljuoHlrZPDlBpJ7lFbOWtp8i2P_1vce9JDOa5dC1Tj8a4dqpn6PsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUqgGlKwWYnp7uecATwTVNX5m5zP_-oEawLemxVdESlw&oe=6AE7489B"}, "display_name": "ViewR CONNECT", "keywords": ["viewr", "viewrconnect", "cmc"], "long_description": "Seamless cloud integration: Effortlessly transfer 3D/CAT data from the cloud to your mobile HMD. No tangled cables, no delays - instantly immerse yourself in immersive 3D visualizations.\n\nFull CMC ViewR functionality: Experience the full range of proven CMC ViewR features on the go. Examine, analyze and share your 3D models conveniently on the go.\n\nIntuitive user interface: Whether you are a VR expert or a beginner, the user-friendly interface allows you to seamlessly navigate and interact with your 3D data.\n\nFast data processing: Thanks to state-of-the-art technology, data processing takes place at top speed. No waiting times, but immediate immersion in the VR world.\n\nHigh data security: Protect your sensitive 3D data with reliable security mechanisms and enjoy a secure transfer into virtual reality.", "short_description": "Go to www.connect.cmc-viewr.de for your free license request!\n\nReady for the future of CAD-data visualization? ViewR Connect opens up a whole new dimension for you! The powerful VR app allows you to effortlessly transfer 3D/CAD data to your mobile head-mounted display (HMD) via the cloud at lightning speed. Whether you're a professional designer, an engineer, or a passionate 3D enthusiast, ViewR Connect brings the immersive world of virtual reality right into the palm of your hand!"}, {"images": {"nodes": []}, "id": "927956956948065", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ViewR CONNECT", "keywords": [], "long_description": "Nahtlose Cloud-Integration: \u00dcbertragen Sie 3D/CAT-Daten m\u00fchelos von der Cloud auf Ihr mobiles HMD. Kein Kabelsalat, keine Verz\u00f6gerungen - tauchen Sie sofort in immersive 3D-Visualisierungen ein.\n\nVollst\u00e4ndige CMC ViewR-Funktionalit\u00e4t: Erleben Sie die volle Bandbreite der bew\u00e4hrten CMC ViewR-Funktionen auch mobil. Untersuchen, analysieren und teilen Sie Ihre 3D-Modelle bequem von unterwegs.\n\nIntuitive Benutzeroberfl\u00e4che: Egal ob VR-Experte oder Einsteiger - die benutzerfreundliche Oberfl\u00e4che erm\u00f6glicht Ihnen ein nahtloses Navigieren und Interagieren mit Ihren 3D-Daten.\n\nSchnelle Datenverarbeitung: Dank modernster Technologie erfolgt die Datenverarbeitung in H\u00f6chstgeschwindigkeit. Keine Wartezeiten, sondern sofortiges Eintauchen in die VR-Welt.\n\nHohe Datensicherheit: Sch\u00fctzen Sie Ihre sensiblen 3D-Daten mit zuverl\u00e4ssigen Sicherheitsmechanismen und genie\u00dfen Sie eine sichere \u00dcbertragung in die virtuelle Realit\u00e4t.\n", "short_description": "Bereit f\u00fcr die Zukunft der 3D-Visualisierung? Mit ViewR Connect \u00f6ffnen sich Ihnen ganz neue Dimensionen! Die leistungsstarke VR-App erm\u00f6glicht es Ihnen, m\u00fchelos und blitzschnell 3D/CAT-Daten \u00fcber die Cloud auf Ihr mobiles Head-Mounted Display (HMD) zu \u00fcbertragen. Ganz gleich, ob Sie ein professioneller Designer, ein Ingenieur oder ein leidenschaftlicher 3D-Enthusiast sind - ViewR Connect bringt die beeindruckende Welt der Virtual Reality direkt in Ihre Handfl\u00e4che!"}]}, "developer_name": "CMC-Kiesel GmbH", "developer_privacy_policy_url": "https://www.team-cmc.de/en/viewr-privacy", "developer_terms_of_service_url": "https://www.team-cmc.de/en/viewr-imprint", "publisher_name": "CMC Engineers GmbH", "support_website_url": "https://www.cmc-viewr.de/de#kontakt", "website_url": "https://www.cmc-viewr.de/de", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36338970762383253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974500_601024152143316_2463448664993486727_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vXXQdMSMtAQ7kNvwFiKJX1&_nc_oc=AdqvqM0JT91HzcxQyBCJpP5yLYqoIPHqvAV1N5JjArbp1CiB_nMITY_55ewNytct-bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0CWdsZ9aVp_2lGE827njdrhTPSnQSSEyOP17fDZd2xA&oe=6AE751DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ViewR CONNECT", "platform": "ANDROID_6DOF", "
fJsTUi0BuLxd-7JI7S0gQUmujfatjItkZ8Juvh_Cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu_bpowsldYOPU3QspLXjDkH1EakK06BPXGBnSsNaVudg&oe=69A59EFE"}, "display_name": "Amid Evil VR", "keywords": ["fps", "retro", "amid", "evil", "shooter"], "long_description": "A retro FPS for the ages! Completely rebuilt from the ground up for VR! Once branded a HERETIC. Now YOU have been chosen as our champion! Reclaim our sacred weapons. Take back our ancient lands. If you can stand... AMID EVIL.\n\nSEVEN distinct episodes each featuring a completely different setting and enemies\n\nLUDICROUS magical weaponry that can be overcharged with the souls of the dead and used in either hand\n\nBRUTAL and adaptive enemy AI that will hunt you down on land, sea and air\n\nSPRAWLING non-linear levels filled with secrets and ancient lore\n\nMULTITUDES of in-game options + cheat codes for a truly golden PC age experience\n\nEPIC original & dynamic soundtrack composed by Andrew Hulshult\n\nBUILT in Unreal Engine 4 for cutting edge visuals (even if they are a bit retro)\n", "short_description": "A retro FPS for the ages! Completely rebuilt from the ground up for VR! \n\nOnce branded a HERETIC. Now YOU have been chosen as our champion! Reclaim our sacred weapons. Take back our ancient lands. If you can stand... AMID EVIL."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.generateprivacypolicy.com/live.php?token=LC4UIkFE7ZzKHqTYo4kRhS9Y1vPqFyt9", "developer_terms_of_service_url": null, "publisher_name": "New Blood Interactive", "support_website_url": null, "website_url": "http://NewBlood.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
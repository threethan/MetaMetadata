6_577468504325020_3404596672138950381_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJHy9ZnsSmgQ7kNvwFXspHx&_nc_oc=AdklV25KGaUSaGfyxJ9vFjayir7af3r20RWXBpsFDfsPE69b-6qU7AX89K0mCAYwsDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwp-QxuG2EiNA66dIaNLbP3-NNRRw7nUqsncrdpBjrYvg&oe=69BFFCFE"}, "display_name": "Amid Evil VR", "keywords": ["fps", "retro", "amid", "evil", "shooter"], "long_description": "A retro FPS for the ages! Completely rebuilt from the ground up for VR! Once branded a HERETIC. Now YOU have been chosen as our champion! Reclaim our sacred weapons. Take back our ancient lands. If you can stand... AMID EVIL.\n\nSEVEN distinct episodes each featuring a completely different setting and enemies\n\nLUDICROUS magical weaponry that can be overcharged with the souls of the dead and used in either hand\n\nBRUTAL and adaptive enemy AI that will hunt you down on land, sea and air\n\nSPRAWLING non-linear levels filled with secrets and ancient lore\n\nMULTITUDES of in-game options + cheat codes for a truly golden PC age experience\n\nEPIC original & dynamic soundtrack composed by Andrew Hulshult\n\nBUILT in Unreal Engine 4 for cutting edge visuals (even if they are a bit retro)\n", "short_description": "A retro FPS for the ages! Completely rebuilt from the ground up for VR! \n\nOnce branded a HERETIC. Now YOU have been chosen as our champion! Reclaim our sacred weapons. Take back our ancient lands. If you can stand... AMID EVIL."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.generateprivacypolicy.com/live.php?token=LC4UIkFE7ZzKHqTYo4kRhS9Y1vPqFyt9", "developer_terms_of_service_url": null, "publisher_name": "New Blood Interactive", "support_website_url": null, "website_url": "http://NewBlood.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465
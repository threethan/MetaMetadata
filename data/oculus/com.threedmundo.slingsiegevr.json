WEHDqe7blHb4odoNA&oe=6AFC608D"}, {"file_name": "screenshot_09_warlords_keep_2560x1440.png", "id": "4568828520038912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314643_4568828523372245_3395077059343105385_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX9aL4YeTYUQ7kNvwEo3OJw&_nc_oc=AdqQGNE1-eOJKwjGqtGSUqkpglTsW2bmPDdOTSymQRSNSxNq-jD_7m6Nv9_kXPIIjyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9xD0kQuYSMTn48gPXQ2vHXGBigHk35vWouUH3Nxz0cg&oe=6AFC8388"}, {"file_name": "screenshot_03_detonators_2560x1440.png", "id": "956337936935642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_956337940268975_1129673173558936386_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4_6nF67E4Q7kNvwGevbEz&_nc_oc=AdodfOi_Li8nKEnmTo0RLEId3wb3ZuX642Ma3ZJY396xq5p6VeRc1MlfOQIQs7Mc7_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQb651HiMV4u0yyDz0aAKl3K5vYoZkG4VuUqTIfW1F0g&oe=6AFC63D9"}, {"file_name": "screenshot_01_aim_fire_orb_2560x1440.png", "id": "1115378237809924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1115378241143257_670113379856784511_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3E40YEAzEQQ7kNvwHJRZO2&_nc_oc=AdriEPJsmz6BTZz0RHhfKUR592M-wK3N_A29VURaVOSVnM5DFkApYHhtV37YcIp6grM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGEV4Xygmgn4z6poKbhHAPsbVFiefVVgLC0ahT5urcVw&oe=6AFC7ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1802557087563240", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299789_1802557090896573_1145538624164069838_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSQKjkDbG4AQ7kNvwF6pc_Z&_nc_oc=Adq8YTpS-6P3nzGQnCQAltiqusPkHatYjD6Nw-ZL0jbpsKh0DeMN2L0G7jg-2PSR3RA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt9VUgrZ__k_GTuZQ7UuGUhjuaFsxOvvHdunc6ZR5fKw&oe=6AFC8A5B"}, "display_name": "Sling Siege", "keywords": ["puzzle", "sling", "slingshot", "destruction"], "long_description": "Don't shoot the enemy. Shoot the structure.\\n\\nSling Siege puts a giant medieval engineering puzzle in front of you. Walk around your siege platform, lean in, study how each fortress is built, then grab your slingshot with both hands, pull back against the tension and let fly. Break the right beam and the whole tower comes down.\\n\\nFEATURES\\n- A fully physical two-handed slingshot: the farther you pull, the stronger the shot, with haptic tension you feel in your hands.\\n- Six projectiles: Stone, Heavy Core, Cluster Shot, Fire Orb, Bomb Orb and the Hook Shot, a tether you grab and pull to rip supports out.\\n- Real structural physics: supports, joints and chain reactions decide what falls.\\n- TNT with ticking fuses, detonators and coloured wires, iron chains, hanging cages, seesaws, ice that shatters or melts, oil trails, rotating mills and deep water.\\n- 60 handcrafted levels across two campaigns and ten themed chapters, from sunny training ruins to the storm-lit Warlord's Keep.\\n- Rescue captives, collect hidden treasure and earn up to three Siege Medals per level for the most efficient solution", "short_description": "Every fortress has a weak point. Find it, pull back your slingshot and bring the whole thing down with a single shot. Sling Siege is a physics siege puzzle for Meta Quest: study wood, stone, iron and ice structures, pick the right projectile and trigger spectacular chain reactions that topple towers, crush raiders and keep captives safe. 60 handcrafted levels, two campaigns, one satisfying CRACK."}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/NSUFwQs9qZaz3YSd7xGVqU", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/NSUFwQs9qZaz3YSd7x
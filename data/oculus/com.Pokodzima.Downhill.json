_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVsHB5-7m8gQ7kNvwG4IX9f&_nc_oc=AdqDI7jFg32s4XFgQELtn2g3foGIc8USAMMbug0ehp6WL6quPdlM-LGqn7VPvVl1qpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoIwLR1huDNWSk9OwOt8Rvqnbec9laOvrwj5FFQnZgow&oe=6AE09B31"}, {"file_name": "BTH_Screenshot 5.png", "id": "2068457647366424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295512_2068457650699757_1189660373171246036_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY0Br-n07gUQ7kNvwHMKlQe&_nc_oc=AdoRPBzgn32hNKqXq-jaVhp8IxcAa3t8LwAZx2_r25SEZpIbJ6kNMXqDl6rH1DK6dRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSor0_CL3ftvkw9Sx_P6laXnZu9FaV_L1m-6OPvsCyxQ&oe=6AE0A796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 out.png", "id": "1775223370394387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824700_1775223377061053_5989004636394930429_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr9yccgP48oQ7kNvwEk7r9L&_nc_oc=AdqD9jwDgxPRJDuwLuWSzZ0p1ZsOuVBBT-_6uX205AGecB4IDhMMYxTJWOTBkRZ1J8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKJzGXY5bAtWWMEX-fmK4kRfkoajC_a5Iz6OlpHmNP5Q&oe=6AE0C463"}, "display_name": "BOMB THE HILL: Extreme Skateboarding", "keywords": ["skateboarding", "downhill", "longboard", "racing", "skate"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\nJoin our Discord \u2192 discord.com/invite/tpCGpqC6Ne\n\n{1460915105858728}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.", "short_description": "Downhill skateboarding at 70+ MPH. Master skate racing in traffic and high-speed freeride. Realistic physics, massive open tracks, skill-based immersive controls, and a 1970s-inspired skateboarding narrative."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39014925558121638"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_2464555120702693_7708112293949001402_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj-3MBb
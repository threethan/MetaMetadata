20f&oh=00_AQTEexwi8KSkPaJocdNigSZ_1EB5u8N29LCE5wvkcktLcw&oe=6B0320CC"}, {"file_name": "sc4_enhanced (Custom).png", "id": "1928065964838837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1928065978172169_4235757327823789388_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i27dln4aEo0Q7kNvwFrK-JK&_nc_oc=AdrgJYbnlqh3GpIM67M8bCwzvKuJpBmyh8Anpam7fujkdz0HeBLhu9H7lml3y1asJqM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgay4bIbmklIKhv0Qrwgz_fZos0QGWbjZvFHTZertbiw&oe=6B0312FE"}, {"file_name": "sc5_enhanced (Custom).png", "id": "2450984765305204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_2450984768638537_7027812065702306648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BCh4euy7P0Q7kNvwE8FCYM&_nc_oc=AdqJPZF7t_VjC-EFOAFjdlumJDOdntgZCQf90HxODkFu9RuEumka6RvP91FR27SFiRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDXeRukPqSSYBA6kujVR40iTK_bZmS7Ui10XWbiZhp1A&oe=6B0312D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 out.png", "id": "1775223370394387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824700_1775223377061053_5989004636394930429_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEhWpbl17HsQ7kNvwEcMntn&_nc_oc=AdpMRV4Ht71ch3b1jj0df---eXyPbWPjd2G7tA2a-7jZOttMjCN7pyISDPvQ9aezIok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7kTgotxV9NeGTBHzk_E10Sut68fhZU6ZWa4McCyIKQg&oe=6B030B63"}, "display_name": "BOMB THE HILL: Extreme Skateboarding", "keywords": ["skateboarding", "downhill", "longboard", "racing", "skate"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\nJoin our Discord \u2192 discord.com/invite/tpCGpqC6Ne\n\n{1460915105858728}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.", "short_description": "Downhill skateboarding at 70+ MPH. Master skate racing in traffic and high-speed freeride. Realistic physics, massive open tracks, skill-based immersive controls, and a 1970s-inspired skateboarding narrative."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
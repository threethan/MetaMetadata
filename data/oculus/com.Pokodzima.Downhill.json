.png", "id": "829888890112208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_829888896778874_4739366444855034444_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XInrN2EQOw8Q7kNvwEfNBMQ&_nc_oc=AdoU3Y95b9nTbnmyhPGo4wJ5oGzzlPcsEP1dexx_8v32_LjyfLCOJSfXalipb0HqR2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDGyjIZv9h9rUdTrec8onrVscxR4KTOlEIadIAFiYihw&oe=6AE4B5D5"}]}, "id": "1631594371346372", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "1300905772101377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1300905775434710_4589734178859005154_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzxpS5-RYMYQ7kNvwFTuvjs&_nc_oc=AdoS-K-MiinXVPQn8odt-Wdiv0fpu8NXsTGsWCrZv2IFX4Uy4u9MqIfZ4xaWDpD8W7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbRh0kqVcM2yMiehzLrozL8g8C0yZUWXQ3HLQrSRRa5Q&oe=6AE48ED8"}, {"file_name": "s2.png", "id": "26094260823528808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_26094260836862140_6267938910728529714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQ9KZOfhbKQQ7kNvwG6WCDc&_nc_oc=AdoUNIG_qhA1Ll58Bn41AfLUoeoVv70x2khDwhhvdAF_6Ae-EgOkQMXo7vrtoXQGpjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0JXkvIqxkuyO3KXxtab8bZr2Fgjt5P3-lsuyOrlYkZA&oe=6AE4B342"}, {"file_name": "s3.png", "id": "1620489605956004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1620489609289337_3585947321465557125_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftzHLhYechEQ7kNvwGUsQ5L&_nc_oc=AdpoFPeRTrisFOn2SUlpIPVHUtshdYokNm0Pmy0_qyz8iw67cghvRIt429eMs3Fj2s8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLIVSi6TFTIaFxEcqQ4J2UiS5QAcXBrB9uucLHQr7xEw&oe=6AE4BE74"}, {"file_name": "s4.png", "id": "2150763205666970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2150763209000303_3485418650054766772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=5o3AWsPLxsQQ7kNvwHSAKS_&_nc_oc=Adr8FmrOPQ6xEvDMQ66eYr9_WjqIZAjrWgwc-d9silXA8dt_yVq0W2K8-eBYiCzhzY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsudY1eJ59aeeN5_5Cnd7WG2X-eDI7V3CPvx2APXKhsA&oe=6AE4AD02"}, {"file_name": "s5.png", "id": "2759074291125066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2759074294458399_6163695925161502704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psBzyRe3zqkQ7kNvwEWKL8q&_nc_oc=AdqraRtXdwvnoQXCedE51tNnKKCdTl3-6HlXePD9BvrZTB763gAJiptXwHf2NMgU3ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHX4UQCFV4mwKMJClZKFYBLgoxp_OSkF7fA3D-L68KHg&oe=6AE4B330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail meta.png", "id": "1272704051419976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1272704054753309_6107471402065931183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKoDnMUVrAUQ7kNvwGgHYRM&_nc_oc=AdrVrR2dxXWP-LTSOeDgwkzRuPllaxesh-KMwxGpw_vnfCKRwAzbgADL7QjzTr3_fOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT9CQbT77votCcLfc6p8oemaFESaxS_9dTjYxx6cag0Q&oe=6AE489BA"}, "display_name": "BOMB THE HILL: Downhill Skate Adventure", "keywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34595241436756761"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2208552949718555"}, {"status": "PUBLISHED", "id": "1631225931691407"}]}, "baseline_offer": {"id": "1631225931691407"}, "is_approved": true, "firstOffer": {"nodes": [{"start_
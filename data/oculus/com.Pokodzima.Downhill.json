.png", "id": "829888890112208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_829888896778874_4739366444855034444_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XInrN2EQOw8Q7kNvwEAoZYv&_nc_oc=AdrpzZSBlTjoByKjMArF9T8NehtG4EKcm5043CKlnEd1NRFOvMnilKrs-3Gjvcix1A8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1fauRBwhT1Mq2Fde5hFmp9WxQ6N5RrzW7jKsrt5ujuA&oe=6AE758D5"}]}, "id": "1631594371346372", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "1300905772101377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1300905775434710_4589734178859005154_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSLVLAOJCFAQ7kNvwE2dRdH&_nc_oc=AdrIqsly1h6XCNaMzhsZaSxyh_pK1SnAOPudVA8uZHBZjdeGOUpjQHdFAVmnksjdMPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZvpZX0oD4xmFy2w_spg7AYvXpQTk_oIBcAz_y67vqCA&oe=6AE76A18"}, {"file_name": "s2.png", "id": "26094260823528808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_26094260836862140_6267938910728529714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAeZxMjM3SAQ7kNvwE19uwf&_nc_oc=AdpttrtjrRrk0KJvsJAlch0YwITxWPkw66wI3dWdVxKBhDXrNcnmXNuA0OrfcqcRco4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-h580vo-ibq33fdwPNOVXWHCyLjM7X_0z9SHNvF3KBw&oe=6AE75642"}, {"file_name": "s3.png", "id": "1620489605956004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1620489609289337_3585947321465557125_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeYKkvvI1VAQ7kNvwFarAvl&_nc_oc=Adp7B43Y1UQbvnZhQRVX6Y1HCpgHsHHLSVT8bw-ODMWQ8VGTLjSWLuVg-P5Tj_A-0tA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeMm-0SQGwWG7yM2jNaiQ7kczS-nwA_4LCaORUavJ33g&oe=6AE76174"}, {"file_name": "s4.png", "id": "2150763205666970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2150763209000303_3485418650054766772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=OjQR09uaNc0Q7kNvwFedR0v&_nc_oc=Adr-JvsII2fw3eTfsPxbKyxqx-XxK2RJgMclxPiNrBs9lFl8iS30eJ4FYyBWJoILM68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzDpK_LlYE6kbTCX9Gjt7f87eukkF_t4FaGSvKdhOEOg&oe=6AE75002"}, {"file_name": "s5.png", "id": "2759074291125066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2759074294458399_6163695925161502704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC9Ur1ff3RMQ7kNvwGlI-26&_nc_oc=Adp6XnQ3raEtR9P0CFt2MVOkZqcnK9ggNtniS_Fl_PUph1rnsMm_HLbPYKnoKN6GBXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxTn3TWHbTxoQgKySB1vEeaj02vw2wUMQ8Bhc0AoDnwg&oe=6AE75630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail meta.png", "id": "1272704051419976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1272704054753309_6107471402065931183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6CyFPNUN8QQ7kNvwF-1LJE&_nc_oc=AdpeZccSbrI8XmRzCjXJT2VVx-50J1zckLnKzyI021zFC8vu8tyO5HC5L54P9rc8jBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLrRozq62HWPJlQ86bWnCod7KzLVO2N1F4h7PR6CJjmw&oe=6AE764FA"}, "display_name": "BOMB THE HILL: Downhill Skate Adventure", "keywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34595241436756761"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2208552949718555"}, {"status": "PUBLISHED", "id": "1631225931691407"}]}, "baseline_offer": {"id": "1631225931691407"}, "is_approved": true, "firstOffer": {"nodes": [{"start_
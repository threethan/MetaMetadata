ywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id
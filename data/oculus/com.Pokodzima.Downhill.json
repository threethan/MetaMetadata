25/491819859_2150763209000303_3485418650054766772_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=5lQJ4-E-GQwQ7kNvwEsUyzo&_nc_oc=AdqXlXZYve6N0IER3n9BREaiceD2ac-U5VWE4Kindgq90fVY2rK-QEumTfd_K7UCPts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRQX31yFhGYIEdTb4kC21iw0TpYlQAilDTjKJ2WLllyQ&oe=6AF5D082"}, {"file_name": "s5.png", "id": "2759074291125066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2759074294458399_6163695925161502704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N8ZSLcmmYsQ7kNvwFUS8A8&_nc_oc=AdqxLCiA6jQrClOw6VNH4Am29PE1Q9b5-EHGnhxPA3_mCTKhXJqJD9BRjdUjB5w1D88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR16afzx-z0OlZpn_Xw4lF-L9zbzXg3ZhgoDEJYVOvjWA&oe=6AF5D6B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail meta.png", "id": "1272704051419976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1272704054753309_6107471402065931183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh9OoRfKI8wQ7kNvwEgiMJL&_nc_oc=AdoIjr22u3UspynlSuu9mHaVk_wVX1efSI9DQT7M0_4nfoQRjKPWvlPVy9paOZbpwxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_3AblqJ4XwCoeMAyBw2z3qNKhv99rAYHt3pKWnyIUZQ&oe=6AF5E57A"}, "display_name": "BOMB THE HILL: Downhill Skate Adventure", "keywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34595241436756761"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1799094901342259"}, {"status": "PUBLISHED", "id": "978719474823538"}, {"status": "PUBLISHED", "
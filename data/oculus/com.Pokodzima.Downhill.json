aF0am65sBRa_7wtmg&oe=6AFB1CC2"}, {"file_name": "s3.png", "id": "1620489605956004", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1620489609289337_3585947321465557125_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SagFzXRbRccQ7kNvwFc5Xtb&_nc_oc=AdobBobmBFsQCLenz-Wssedo7Z8jJBLvF0eQNDEYJlgTNFufmzCpz48kccrcJL5Z5ik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlQIzCbPSN4YqVFDAdNLGv1yoedm63ftAfySprwqgtqA&oe=6AFB27F4"}, {"file_name": "s4.png", "id": "2150763205666970", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819859_2150763209000303_3485418650054766772_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=nX2jln3iDJAQ7kNvwE5hCIT&_nc_oc=Adrs5FN-IunNv5C09FFV0Ks1YSYE2mnB7rjiT_8bkegIiMBMHrvStiKDm0gat6knAus&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7-07Puy3TGMMIYuSv9ng6WTW2YJ5dbhX8_drX4izxrQ&oe=6AFB1682"}, {"file_name": "s5.png", "id": "2759074291125066", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_2759074294458399_6163695925161502704_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYNv0K3UjIAQ7kNvwGzavpF&_nc_oc=AdqXohuFFSFToqWAttvtCE-b3hVOq8np4MZVHIVaydv5WpjcO_gIYp4XkPO5cjFeQeU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJJ_hDZS08mdAGuosvzByk3yEFtJe51erdOjrUXRyIpw&oe=6AFB1CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail meta.png", "id": "1272704051419976", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820855_1272704054753309_6107471402065931183_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlvB34q36mEQ7kNvwE-mcXk&_nc_oc=Adrt_P3k5VcUItXigEKXWHvLgXgxzK-ZNKxEpxPfGqAVdiRAnZQ3jRmB4Yk8vu0cmhg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXoyZ-8-KO507fbrjjqf8RwtC13P86yQH7mpq7QSUlaA&oe=6AFB2B7A"}, "display_name": "BOMB THE HILL: Downhill Skate Adventure", "keywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id
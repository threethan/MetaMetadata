_miNYKn3IYU8sTx7Q&oe=6B045742"}, {"file_name": "s3.png", "id": "1620489605956004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1620489609289337_3585947321465557125_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rToF-6j3DukQ7kNvwHlyaob&_nc_oc=AdqAZx5O2GCZLp57wEtmZpAvaMtlCHdsbxc-TvsrkCwMgJPmC7URjsIuss3DIUQH_YI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcgiSZ0Sz0v7cmQP1r_SxV2KtU2yq9NRxOJ0YMXb2nqA&oe=6B046274"}, {"file_name": "s4.png", "id": "2150763205666970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_2150763209000303_3485418650054766772_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=O5UO1V96SsUQ7kNvwE6tV1v&_nc_oc=AdoX-xaolpZTKdsLh1mZQj5HQt6aELA8ldse0pQUW2twESi9PJaon31fPSzSAYJ-5KE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROmQXlVeg8dFVtrHBjm3KqrUv7aY_URZcY6Z1rI1QG8Q&oe=6B048942"}, {"file_name": "s5.png", "id": "2759074291125066", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2759074294458399_6163695925161502704_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkEzeFixX7oQ7kNvwHhd4UK&_nc_oc=AdrxXq4sEQEC-8afhwpRP8WSkiJnLqC_gi6m4qERw1urmjB8sPPFnjKjFaGoqWOe9MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwtkgdHl_UhwYvw4l_KOUK0ZC-TJsLBSMb7LUPhCM1IQ&oe=6B045730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail meta.png", "id": "1272704051419976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1272704054753309_6107471402065931183_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzcNVp0QIFIQ7kNvwEeyzcP&_nc_oc=AdqvkzkijxXYEZvSZHhfoSCN2FAWi5ITJi-6tAUdXWDbCVe4A2revjOPXUjKgnD1rrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMXzUZZUVJipTC1yLqzYxZ3h1a8-UiKw8g5ob6RRJIiQ&oe=6B0465FA"}, "display_name": "BOMB THE HILL: Downhill Skate Adventure", "keywords": ["skateboarding", "downhill", "longboard", "racing", "extreme"], "long_description": "Race downhill at 70+ MPH on a skateboard through live traffic, mountain passes, and desert roads. Hold your line at extreme speeds where small mistakes matter and every split-second can change more than just your path down the hill.\n\n{867479239677186}\n\n# \ud83d\udef9 True Downhill Experience\nDeveloped with professional downhill riders, featuring aerodynamic tucks, precision slides, jumps, and 360\u00b0 spins that feel intuitive and fluid.\n\n# \ud83c\udf04 15 Massive Tracks\nVast locations spanning 10+ square miles each. Every descent offers new lines to master and new risks to take.\n\n# \ud83c\udfc1 Diverse Gameplay Modes\nCompete in a secret championship, freeride for style, take on high-speed chases, and master distinct board types.\n\n# \ud83d\udcfc Legacy of Skateboarding\nMore than just racing \u2014 a story about skateboarding pioneers unfolds during the ride, connecting past and present on the same roads.\n\n# \u2699\ufe0f Tuned for Comfort\nExtreme speed with precise control, validated through 100+ playtests for a smooth VR experience.\n\n**Add it to your wishlist and get ready to drop in.**\n", "short_description": "Adrenaline-fueled downhill skateboarding at 70+ MPH across massive open tracks. Face rival riders, master diverse gameplay modes, and uncover a story rooted in skateboarding heritage."}]}, "developer_name": "Pokodzima Studio", "developer_privacy_policy_url": "https://www.pokodzima.com/bth-privacy-policy", "developer_terms_of_service_url": "https://www.pokodzima.com/bth-terms", "publisher_name": "Pokodzima Studio", "support_website_url": null, "website_url": "https://www.pokodzima.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id
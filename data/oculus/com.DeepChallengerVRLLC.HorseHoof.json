c_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx700eXjb9kQ7kNvwGjSbYr&_nc_oc=AdoaQeY1lTniJzVckqIT71E5k-TGiMsAAUrzc-KlTJj4maFuZkG_6C6mu9vIMc_AyWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3hC1UNkYk4TqTDyllrf4AV8-urBzk5Ekw7nCUQyA-iA&oe=6AFF0EDA"}, "display_name": "Horse & Hoof", "keywords": ["horse", "hoof", "pet", "explore", "relax"], "long_description": "\ud83d\udc34Care for your horse\nBrush, pet, wash, feed, cleanup, and pick hooves. \n\n\ud83c\udfc7Ride your horse\nSaddle up to explore the desert ranch and the vibrant tropical cliffside on horseback.\n\n\ud83d\udc34Personalize your horse\nCustomize your horse with bows, earrings, hats, and more. Spray paint unique designs on your horse!\n\n\ud83d\udcacGive feedback\nHorse & Hoof is in Early Access and we welcome your feedback! We\u2019re excited to further develop the game to be the best horse simulator and experience there is.\n", "short_description": "\ud83d\udc34Care for your horse\nBrush, pet, wash, feed, cleanup, and pick hooves. \n\n\ud83c\udfc7Ride your horse\nSaddle up to explore the desert ranch and the vibrant tropical cliffside on horseback.\n\n\ud83d\udc34Personalize your horse\nCustomize your horse with bows, earrings, hats, and more. Spray paint unique designs on your horse!\n\n\ud83d\udcacGive feedback\nHorse & Hoof is in Early Access and we welcome your feedback! We\u2019re excited to further develop the game to be the best horse simulator and experience there is.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deepchallengervr.com/", "developer_terms_of_service_url": null, "publisher_name": "Deep Challenger VR LLC", "support_website_url": null, "website_url": "https://www.deepchallengervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}],
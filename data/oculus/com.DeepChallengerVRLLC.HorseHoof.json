. \n\n\ud83c\udfc7Ride your horse\nSaddle up to explore the desert ranch and the vibrant tropical cliffside on horseback.\n\n\ud83d\udc34Personalize your horse\nCustomize your horse with bows, earrings, hats, and more. Spray paint unique designs on your horse!\n\n\ud83d\udcacGive feedback\nHorse & Hoof is in Early Access and we welcome your feedback! We\u2019re excited to further develop the game to be the best horse simulator and experience there is.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deepchallengervr.com/", "developer_terms_of_service_url": null, "publisher_name": "Deep Challenger VR LLC", "support_website_url": null, "website_url": "https://www.deepchallengervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8462163353912005"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1643228179909255"}, {"status": "PUBLISHED", "id": "1682509472531004"}]}, "baseline_offer": {"id": "1682509472531004"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737396000, "status": "PUBLISHED", "id": "1643228179909255"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8813185102143160", "version": "1.12"}, "id": "8494198394011217", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only
=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Me_42FOFsYHbjQVOgSXyjZvAjvdij_CiwMWq1H2q93A&oe=6A0C6697"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3a2Y7SwF1IQ7kNvwGe2gqT&_nc_oc=AdozBNtYbhMY_SCWW7Tml_bL4ga3JuXVZtfsL8OQMHpxCMwuHc4bzUPxkvYY07XE2Q8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6prgVWriitREo0R6NEZ5TWoFr9iNCM8l943z8ge4DWGA&oe=6A0C625D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5erDVBuEZEQ7kNvwHlMPId&_nc_oc=AdrZZmQikEl32Q7TlJqZNeG1VpmM-Y6fjdhT9PqfwUoe3wmOBIPFRiTqfAvNEles7sY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u5giVAlFL7bAlj4FkF0GjVnrUF0e5lj3-B1UZhcFOJQ&oe=6A0C54F0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhO5lPmTwsYQ7kNvwFCVBBy&_nc_oc=AdpTpIJJfhEJoPs0wPJ9G_tsSh_qnED9IGSVX4KOGAFA527K9NjZ5GGt-gorVZWEaK0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LXvP4XWH-POe01RPkYYRrKBXybmUfeBKDPCoyJ0S-Zg&oe=6A0C692B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4f0FNYKPK8Q7kNvwHhiWSl&_nc_oc=AdpygWMHn8muw1GBRBPERMUKBUXgO52H_kzSSVMRW-paO7Gjsg7u4QH6z2XCfRySqvM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67z_s7DPjemaIDV7Drs0U0z3e50tN1R26V4zQ-p6U_3g&oe=6A0C7325"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9sQz7GR1NkQ7kNvwGk-KGj&_nc_oc=AdrC57SV4AzL8mqAUmzvsZV_SJ5Ti-5PTm9DsCMLz9x64CqaUAO1oYV-rlqS-bjRi5s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5tGaWzWG8nGxEvEwWpwOSpnQ1_5FQvLK6fxVtdnENQA&oe=6A68AB5D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eECrmO-8J0wQ7kNvwGJ5lR4&_nc_oc=AdpN19GmJIR5MbJq9vOpffrnrDJiYABstm4UBhMUV74OAPa8P6TyLX6YcgN2TBydbNQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe1SZQSYPao2guU6a0f0PIgUTDzSx4m_KO-IM579q2jQ&oe=6A689DF0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ougC_fLIuMoQ7kNvwGArxs0&_nc_oc=AdqhPBMlzIpgw3JvSSgsGUxGG24G3ZOGSqo9WOXQKOFbpct5helQt07BcmCWa-22-7c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWBnYSi2Ca0qRJuuSrDiJIB9MnuYkt5nsxMkX6Et1Lkw&oe=6A68B22B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apxzw2dBqKAQ7kNvwHiTq4s&_nc_oc=Adq7-YoYjCfDtGHRkWOcRDzn4HcOVxS9aFjmQZtssekIv6HtsHMGH9DFPHrkA5NoFjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCadfy8C0Grv6fOU1wT-RDoVl5Jozrp_psQqnDt3yuZtQ&oe=6A68BC25"}, "display_name": "Whaacky Walls!", "keywords": [], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://salinasmark.notion.site/Privacy-Policy-d95161091c844dc0a1997c8ba62143c7?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
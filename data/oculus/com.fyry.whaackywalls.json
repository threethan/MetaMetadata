scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFPtxGnNljQQ7kNvwGs7iON&_nc_oc=AdqsCltA3h0BnJbe4k9VWG7z72RCpY136VjhRu7OkqyoQBds720W1cIvRTMdHemg94k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85OTjVe0elQq-XKv68BfWqfkW2A85JswQsm5rHBtyb0A&oe=6A329DDD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iLoKJ-LKAQQ7kNvwEOq7uR&_nc_oc=AdpiE_Z6sQmRnZivklzweQm_NR8EcwIiL9XBog5RQIDyNHQa_KPa28JLommjnfycVNA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lHN_YujklGgp4RTmdkDOwkRgr51MT7d4TWeI-NsLfVg&oe=6A329070"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw63B7MGoTsQ7kNvwEg1Y_9&_nc_oc=AdpCjQlYx4Z38KKcFgNz1u2-gS27aT5aSMWVrWFuneajmk6Yj8AXIdLoY3owckVHJwo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lP-B7zONMuohzzlFILYxI7s8WgUD6plHzRq1ucrFnRA&oe=6A32A4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knv-yJ9cXM4Q7kNvwHG0rYc&_nc_oc=AdoEOXbC-lEkDVQ5aekNxyDV89iLr9w10LPIj8X-vmqwTdvNdFIvwlqkMPqs_MF0-hg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-stNeN952FsM86nH04qkvLSq-PICtU50eXkuROOYyx1Q&oe=6A32AEA5"}, "display_name": "Whaacky Walls!", "keywords": [], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://salinasmark.notion.site/Privacy-Policy-d95161091c844dc0a1997c8ba62143c7?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
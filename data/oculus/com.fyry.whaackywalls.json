=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDXFLMrhckQ_aMwLb2lT9xJuEvij-wr6PK7yv-SDTPiA&oe=6A896CD7"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmqa02XHa1sQ7kNvwFeAqn0&_nc_oc=AdpIhAEaxtb6ggk8gyR-xHtVxk14O6QmPjCgtO9284iyvbllihk9QcKOHxJaoyTGHlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGve2nN2F_wt2TSqrSI2IGelWGsSTF-UaTskbi0bWSWCQ&oe=6A89A0DD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6hZ4HJtPSAQ7kNvwFPijY5&_nc_oc=Adra7PR7hW4pKMO7t3fn5e8zPXIiiFmtwEgWcALmDGg28iVn9mrqlZhAqg8FdPEwZPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnXY-AVTRq6fbSJKaaAdz-AOR6IzI3qCwH2OO9rjQzuA&oe=6A899370"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRjTtv-mLWwQ7kNvwFdCKuY&_nc_oc=AdqHYjdNYTJDa_bMlT7A5B6cqjgkGxed5m-TpAZiwRtL0hA7hrmPlDXSs7zyA8G2bVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN2PQn9u6GdViiPii-DBbKLyjSEFzFw4DmHN8kZFvyQQ&oe=6A896F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGkFTVUlBqsQ7kNvwG8-Wgd&_nc_oc=Adqd2I58nRnHRGQBUKf4DoVxY9GybkOjMxjgiapOBiwrJHhMcb3FTQspJb_Azgp1dL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxWXplq3x2xueEyJz-UQfKWG0V6QUmVV-U_59PQmVU7A&oe=6A897965"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
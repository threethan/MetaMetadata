=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_b4dW2XnVkCgIlXJ8nb1LSIJXSoZDJfHALxnr0BJI9Q&oe=6A199597"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sCTGohsf2YQ7kNvwEhPa28&_nc_oc=AdpTNWdL7kYM31j5BJN7Aswo5cc6II1I_siho1NQarLzF8Ei5eWL0Dz_vyy0axSWmRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55OIwObxwnEo5n0tyl2A-GjOyi82UEqerBqGkfTtdVfw&oe=6A19915D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-KXH10GOU4Q7kNvwFt6jPb&_nc_oc=AdoZowP1tX4uQwoa7EVUpMvzCs976hYfYfvNOsxiNbDY6yiwXg8raWsz2R9KnMB_Nw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55allqfnaGZZ5VTNckLdL0KKVYo_c2HYi9aBtg7bW9HA&oe=6A19BC30"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVYsA1aoAQQ7kNvwH2ufAC&_nc_oc=AdpGco59_Qf04RM14e21UrjOf2ZROMK9-bY88GqAqPECRpRz2gERzAp-qfNpHLCmeSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dsz3MrtQtd1hRzwwJ2bvbvKAgK3oHNmHotQ9cbCP0hw&oe=6A19982B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyD_AHaaGrkQ7kNvwHxOTY2&_nc_oc=Adr69YPbJrWfHB-TKdBGWxG31QhawdbdA13E445KmRIwvgx08K0k19i1BBSPIEEhKaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NPmX2lKRqr3EkedIgPcb5831PMLwqrRe7f2LOw6Ve8A&oe=6A19A225"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
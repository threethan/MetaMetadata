=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w1n19DKyTFtVUxDuzWJ9n6m0ki6mY6_ZgusCscI8R8A&oe=69E23697"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8S656E710UQ7kNvwF8IgQk&_nc_oc=Ado_jlmoOFA4mg96rjbmMWujhlkxe8gvbI0q2fePzmRc4tc8414cvKcPr9PPkDphLJg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0US6P7m93Y9yavxJre6sDyonI6sy0Jniy8610pGCvLBQ&oe=69E2325D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_g4CNWJ6cwQ7kNvwEow4zf&_nc_oc=Adp-iV_vuoPEZkc8piYOSE6bUQnzS0QnHkD8cBE_bAy8Tw8M7qAe3NMPO1Z_SXIryd4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ka6uWU3FQxt3Sfgg855xJ6nzlY7QPK28wPxGgoWd9CQ&oe=69E224F0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBnJGgBy9oYQ7kNvwF6ipeE&_nc_oc=AdpK2tWUGR4TyyJAFGC-UQVp6CcHUBan0-KyDeuIHCo6Qsr7hOIaKYNwV0atWhJSWOc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36jSK7XkoE1E1LqhLF2sMhoE5GF97qy9GbeYF79PppVA&oe=69E2392B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zuu-Yo3hFmEQ7kNvwF01pTB&_nc_oc=AdoL1OJuRvyGjypb-vLi6prhPAtGFUXc5hE-uZrOKTYgZ9VKaHO440TsWxokZKdEzl0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jjgcqf7999faFSrwqoYQW84SNK-jJkiPnYxSVLPQEqA&oe=69E24325"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
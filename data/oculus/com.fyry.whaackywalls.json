=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmfdsZUB-LXL8Ok2XbHLgZYqUmgShceoww_Pk391AUQw&oe=6A50F497"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GCdSa7B_poQ7kNvwENN16Q&_nc_oc=AdrvIZEkA5EO7wy_2_6TLbYWQFIO7EqXhdhZcaNkFrM1s7I3NOXV90auWz02on81Gzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv50m_uuUdBb4UF6JXwfglzSpEEGogcPgD8g_8Io3VPg&oe=6A50F05D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lncwUeFfOYQ7kNvwFBWV9g&_nc_oc=AdryS1tir2BYYGaThoMtsf57TBcVrdL3VIxPXkT173drDkGP3Vg0aIjDoLBl8BrCbI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABFXGvQHaBw_UvnBt7_5nOhGIUElP530R2Fku22iUDHg&oe=6A50E2F0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhpBDrm4GN0Q7kNvwGdAQYy&_nc_oc=AdruIXtKbHwStZAjhZp_rlZYbGfFpymSYlhijaOVk81lHjNzDsw1RNwN8T-FYaUTrPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD13mGWRQkr6A5VY_OtKv_dZdXozwALccBLDBiRXBUCCQ&oe=6A50F72B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTgSVJfUIrwQ7kNvwF3X2DN&_nc_oc=AdqzH2EEC6W1KFKoScP8vFu8jc49bpgCGV56s9F-sO9VfGVemduc_lV6SapZm0eHIc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMHFqrM7I34AiGvfVaZT2Pdry6Nh1UD0asFBKd1txVWA&oe=6A510125"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
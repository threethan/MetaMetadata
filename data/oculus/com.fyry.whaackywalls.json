=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0K0W5uVFjxFBc0_UFBw2-nB1fvYrJAWG2ddVnE2sz1w&oe=6A6DF597"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IghWkzmkFC0Q7kNvwFvpJJJ&_nc_oc=AdqWO0_8qbXES-6Sft_h81j0rW4ar6iYc8mPvXYXSC7Xfv6l_RIkK44CyHk3JrBJ3PA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEmr4oa4wVUcayryElf1r5yqRJFro1eglkiJDyCrNOZQ&oe=6A6DF15D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzNfQCYU11gQ7kNvwFi6Iv1&_nc_oc=Adp8GrrRW83oAl3JHLWCUC54OncErTKqSLMLoR6MHl_ldSDjdXC9UwfzVTK5hR0CGoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXHACxCT0Mlk87wHcyD_Z8zBDCKNlGUxXvdraMFbSBcw&oe=6A6DE3F0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXL2E9X27cgQ7kNvwHddSod&_nc_oc=AdqlEHjW0kWTRdpKlOBnwqxbiJdoxXa7vSMtiZrSWXkZxBRXru86vb6YNrsAYQbfRF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANKNpa2OlxgppF32BQOvfNGABmx3vIo6zAAdfBuUpJOg&oe=6A6DF82B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79cVIpdOzvUQ7kNvwFHkRAB&_nc_oc=AdrcBnFsFkhf4TADf1Fw_cDdh2-EOGQ2tlqaxFapHKOzsY6BOKslSxj5x8o1I5BmXek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR1BRzcv4A1uL0vSpPgj2vT_9Hb8oPbqIw_zYhimIetw&oe=6A6E0225"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
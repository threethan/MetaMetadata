_sid=6e7a0a&_nc_ohc=bYKDnNGUrY8Q7kNvwGIUw3r&_nc_oc=AdopzaHCaP261KlIxRc3oHoZlB-y--4O5ilXcg2SVkH27wBLuW7O_S_2ycPeiMIijh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7842gAwalSJZL7FcxgDc-2IvrKY1eaB3FeHpaBvCG4A&oe=6AF89B57"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxue1jijIXsQ7kNvwH0crMY&_nc_oc=Adp__3uyY0ccv55dwPkBKZT3k3q2EssbR0Pznw128jFFpSE9c8DYpP5J-CocHRt83tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmFnIofB6-1s5fXh8C3EgRgzE0t4_C9LZxQDjoW35fNw&oe=6AF8971D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr1HTuHqV2YQ7kNvwFMs2SD&_nc_oc=AdoKsG5f8dOQqQAGeKQT5yhvwFkVvS_mcDN5bBT69vUCNYIHeYJd0CK8R6HIVdfVM6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAjoaMnKfNDZVdFIHxexjfTgJHalQuQ4gtQ-fmTjBQNA&oe=6AF889B0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSEqwcO4xRUQ7kNvwHFhExV&_nc_oc=AdqtcG9yQ4pYZyJ_4UJ1pq1D1SVnf5z1ujiGDyWGPBuo3HimejCZEerB8KUrl4ZlajM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkYTLmLgVKZBjMNwn06Djqvt10QdMl725BjWPjFz-Z4w&oe=6AF89DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLtM0KjecKYQ7kNvwGQadEc&_nc_oc=AdqVZ_GaPJLd4KHlPBsIEC6Hk9sgMopwD_DBpBLLxc1aturXFw9H4Rh_qwOQDgQfdtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP8xOekXu7yGnSDXbpwkl7jbkybec9J83iHLs4dyhlIQ&oe=6AF8A7E5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRE
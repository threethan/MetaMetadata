=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-004uzl5d9f4J06N7uCP9nGSCcJ-vzU0NTVHk_mEPQg&oe=6A2D5C17"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pl6ZoDZNZIQ7kNvwG4d1Sg&_nc_oc=AdqpkbRpvpFLKpSUQvJIEW84tGmghkNfWGIR4Sxs0yCCzl3xXAbpSCBJlmPaTHZziLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TrVeDYGWitNPp9G5iymZ8YHDz4QJiVtDVet8THD5NMg&oe=6A2D57DD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9elyrPpUDEQ7kNvwFe2HLK&_nc_oc=AdqE-Z-RWN5qHf-PbQ7Me1GMcggYLliQXwUc52twLBo_0kegWVz6zr4TYPyVAJ0ZTMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tK6e1SZaePXIDskCjCFrs18zVL0ZllJmqnqG6PKuvug&oe=6A2D4A70"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g0cCtPpilsQ7kNvwFzmkul&_nc_oc=AdqJjo4MfRE6GhWSjAno9a82cIi36nk1JUUGh2lPt91D8R8QBLzqc8SELZXUDKKL9FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SeEJdhwE2PxuTp_cStgjkdM7aNy2UbRM17lJof0qmYg&oe=6A2D5EAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5GTcD7YxJYQ7kNvwGLIAGJ&_nc_oc=AdpK7YrwsJYaGwvgPaZjLaDKFo2Uz17_lgHlqtxHOWhDIjWwS4-PmxtsEjgHogq49yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yDBemEKEXBCLJeVXuTRvc0dUrV68cRJAr3dSHVqkjVA&oe=6A2D68A5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
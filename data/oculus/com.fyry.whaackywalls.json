=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L3X2dbnOxC1Oh1kucf0m4lTRpSDciOIupvlCIKSnquQ&oe=69EE1417"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE2FM6afgG4Q7kNvwHN6Oyu&_nc_oc=AdojQJkPoapcPxdW_La6vPyFUkGEPqT9fnR-r_NrFD-JKKtJMlTBe1zZnf0XGprreJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af382la7CGlFMX_33Nn9rnPGaHHE3zzxZB0WOpMRpn9Uxw&oe=69EE0FDD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yo9fdK5BqsQ7kNvwGauGKT&_nc_oc=Adq-NAK9vTDi5sTi6kJhfxBMfG6f4HTqIaEhq5IeFL4nmY2ymceodvMvawIItRS3lAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lUOpKK0pigzYkweabw55ikJPZA6dWAO-xoXJX6oTAZA&oe=69EE0270"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY1FYNck9igQ7kNvwFq0gxM&_nc_oc=Adr4BkC0A91-MrEJy1w83NRdBsvt9ETeGDo5GX5gWMn61qpmcV_zpTUkGibhRtBYnPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kH0UxfuHWAyIoAOEZAG9scd-JEsJ0_kvQs8To8D9WUA&oe=69EE16AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJNeXtI0Sp4Q7kNvwH--JVB&_nc_oc=AdptLdRzn7-EQijX6zHE7_1XVLcwwt54yxejDcNIqI7KqN8w41DUoyumzLNcnEHTp9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T0a2Lm0vA3lS4rDqJXd0xj4zcYolcc1lRF5dMOl9M0g&oe=69EE20A5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
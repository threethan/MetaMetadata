=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fjXGo9SwZEblL0yCHD5lYSt-94BWMb7qhlRKnfHK7og&oe=69F35A17"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzb2srfSgzUQ7kNvwE0--Xw&_nc_oc=AdpdyzhT4xIeb525u3EXS1ztJTDGvd1sJpw_YTuN5iV3-dmm0JzKGZSR4QUfMRYEB34&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ew6Pgw6L8xUuvca9Hu43XsLAPv7NFTVkMoRPTSaTJ7A&oe=69F355DD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-5Cf0SYpM8Q7kNvwEQdH0P&_nc_oc=AdqY7U-wKCGubbp6pogYcASOwl-O9Oomp3iADEu9CBIqG4dtz6fHB-_9yFNpWURe9DU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DT9LbMuk-gin_5Zo6uUjdG9c05u_dvZ90UBw6oAVbiw&oe=69F34870"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSOA_uWfifsQ7kNvwF4eeAg&_nc_oc=AdqFdW-LPu0nEYf4pVqwWMkw42WBO9G_KFYN0ldo-sEk3vdbpRXtemCw8RUmTri0aRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RCRQwflUwwMWqYMxx5BxjflxR2Nk3uNp6o5wq1imbGQ&oe=69F35CAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBValYjKHOAQ7kNvwFdTsvZ&_nc_oc=AdqMMY4HRqacwWz4mKrC47_vJbF9ItARi_avxEwnkhCxHpZC0zNIPYUbGcz4QJ1GZZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YFyBRuQjX7F0NzR52lXQCIrk6tN57i3sZ9rRbzEtFEA&oe=69F366A5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
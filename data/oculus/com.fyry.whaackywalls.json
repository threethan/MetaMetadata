=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W0DDKmRg3k69A0rexxSMDBSrg-nd8n6gVfxRNqJQ1Cg&oe=6A1AE717"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sCTGohsf2YQ7kNvwG0s2PE&_nc_oc=AdrdKkHvf8iXFMJoY84hasPMOFyCDiJ8ix0IzK_FBcRX4Notrh7vw5epQYHe6YhjrRM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b3xEFK8cOUBkhWV1bTU3wBrh_vg3PVVEcFPZk6spcrg&oe=6A1AE2DD"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-KXH10GOU4Q7kNvwG3kuQJ&_nc_oc=AdpdwgoMilF0cqX7MdQTCKL1r01exiSZBodUF_LuwVRNsiSHwc90GStIcz1io7AfS1E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bfRhl-uqZlpQs7ynj4IA9MAHBbjRyouGfAHQkrjYPfA&oe=6A1AD570"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVYsA1aoAQQ7kNvwE_sypZ&_nc_oc=AdrsMZaYqI2ICZqQHeuxx_UbJa9vQntG_OPZmvah27HSQbl6Z8g5Blr60UIAOxKQjbI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MkfRA4EFkPODDljLL5YoMuwKayh2CpDqzvMUl5S8isA&oe=6A1AE9AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyD_AHaaGrkQ7kNvwHaXenU&_nc_oc=AdphXsAesA4MG3AMWa-0Bg3cC8Yol0a2o96kEeFS8daGei8DsuECuTgrp_RGPFFaRl0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af404EJj99A388NDXmpwAECSu7IOHDd90OL0Eh5w96nf_Q&oe=6A1AF3A5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
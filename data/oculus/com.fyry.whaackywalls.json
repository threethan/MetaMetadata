": "SCREENSHOT_3.png", "id": "839403514505455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75608429_839403517838788_2976649699004990067_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gVdlzV7cVAQ7kNvwGnL3Mz&_nc_oc=Ado_ysLnTISfGLQ77TyhbFkcQnR2Qz2MCFe8XwMKOOzyd2R8sAFrmBU8Vg-xpL8v8BU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTu3F6KPHE7OPL5aDpZoi1bnY6Vtu1N1eV3hyN2-knzQ&oe=6AFDE157"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHp5V-lwSZ4Q7kNvwEGGOLg&_nc_oc=AdoDc83Cvgl3TPrbM9v_oy72AUD-PWqxsNfIEL9r2jMEDgHAlG3U_s2aa_rR6jfwRa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRob0c5ByyEiFqMLyf3Fk0A1nudGf5cx4QKtveEnpucmQ&oe=6AFDDD1D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19SMP6qD4tkQ7kNvwGZdFYT&_nc_oc=AdqMcP8w7R0h2l2HbQxTuBMpYjNkNKsvrZRqZlTeFgjBwvvGtbMenJfJT1vddNmr5V8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT23Pj4ikIFmyFo09SXg196MDjYF_omJKSbGeUeYwgmGw&oe=6AFDCFB0"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwrsnVGvHq8Q7kNvwHnhN-n&_nc_oc=AdpPvOuFpkG_coAcJCvYvZW53BOSJEA9keJ1LYXuOyek2vMzCTHrNfNdn_0XZ-gJDnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIW7XGZ4bB1NsGWAhNOMtOJKDkEDTIEJ1TDTFsUFHTbA&oe=6AFDE3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-nwln3WGgAQ7kNvwE7m1ml&_nc_oc=Adph4I0ksPsuWc7OfJEHuY_pl4ViNxTuNwTBcjRtRfw9fud9J_75A05edCZbk9XsV70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5-9DfkZBtAiHVhx_fODOs6g6n_-yhlV3RHJ5VeKQUkw&oe=6AFDB5A5"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25648851001377083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_1001181844359088_8156807275316184455_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kljod_uYesYQ7kNvwFwxx7Z&_nc_oc=AdrF9lx_uiwIGzlUOtkT-fADGBuPhXCKhwrgj1HcjZ2Vnry-TbSWx_3KEKuwOaYL_Cc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-PDH28zP7RxrYG9dGDJn9fIzJjay3cJ3n3zzs6Oz4dQ&oe=6AFDB493"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Whaacky Walls!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1695312418, "lastRevision": {"nodes": [{"id": "6715799381775530", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6715799361775532", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1087091068948290"}, "iarc_email
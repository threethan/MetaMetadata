_sid=6e7a0a&_nc_ohc=bYKDnNGUrY8Q7kNvwGHA491&_nc_oc=AdoKMc9KeTXvZyzZpC0YNe1q_KTWdoLVGqH6nu5HRBo0v2OcAXBW3BpPCyk-e05yfww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfVUsWKJMreSt7Ym3Klfa3fb-a6xTkVPoMBQ_lgssHxA&oe=6AF9B497"}, {"file_name": "SCREENSHOT_5.png", "id": "147910161671362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982563_147910165004695_3355321221623987071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTavi1xOcrkQ7kNvwEfB1ax&_nc_oc=AdoLVEIXu8IQYENR65OIIBqrTs4WcqieZdiI8KV_yf2ZJR8aLelHcDzSPGJRMwtJ44s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaqXF0wv8git0NmKeK9-9EVJei2tGDtHZi2pGNgM8zkA&oe=6AF9E89D"}, {"file_name": "SCREENSHOT_6.png", "id": "968683680900559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982600_968683684233892_2979833369247611478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr1HTuHqV2YQ7kNvwGAPAMb&_nc_oc=Adrp0iVuPttEl-fGTQCEZExHN-LsQVfu5QGJwMwSexWLsdOkkPGuZBAngSHvEFyhq84&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK4w0OG5MjsdsXtl3Z1cOAssIG1uVufIzbiCgDoiQLrw&oe=6AF9DB30"}, {"file_name": "SCREENSHOT_4.png", "id": "839850507721335", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036696_839850511054668_3222620783953275710_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogw4UlYXf8AQ7kNvwFgVnZo&_nc_oc=Adrtnwn2onD96MVzNo_n1W2xnkqYrtzTGUwL-ULEffmAUU4UV-6YgfzEvdxzSZESZbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnXkRDHP-Eum5POkVcsflmIqIi47REW_VqxUjTn3xkpg&oe=6AF9B72B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEO_COVER.png", "id": "295573229876206", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974746_295573233209539_7113496281751529081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLtM0KjecKYQ7kNvwGOKbyS&_nc_oc=AdqrnZl83HDa_tu_fJIkvLicGuc5k31_dK0s6VIIJlZcZGuf8Rz8O0Rn68IVH-jr4vY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Q2dhqcx1hfML8WVNMZJLvamPs5qlv8LFeRc2WCvFcA&oe=6AF9C125"}, "display_name": "Whaacky Walls!", "keywords": ["casual", "arcade", "show", "movement", "active"], "long_description": "Welcome to the world of Whaacky Walls!, the ultimate virtual reality game show experience that will challenge your wits and agility like never before. Step into our immersive virtual arena, where you'll face a series of mind-bending walls hurtling towards you, each with a unique twist and obstacle that demands split-second decisions.\n\nIn Whaacky Walls!, you're not just a player; you're the star of the show! Our charismatic virtual host, Whacky Willy, will be your guide and cheerleader as you navigate through this whirlwind of challenges. With his outrageous humor and boundless energy, Whacky Willy adds a whole new dimension to your gaming adventure.\n\nThe premise is simple: walls are coming at you, and you must contort your body in real-time to squeeze through the ever-narrowing gaps. It's a race against time and your own reflexes, and with each wall, the challenge intensifies. Will you bend, stretch, and twist your way to victory, or will you find yourself in a comical tangle of limbs?", "short_description": "Whaacky Walls! is a challenging and fun virtual reality game where players must quickly position their body to fit into the gaps of moving walls, all under the guidance of the virtual host, Whacky Willy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-61c47aad7f11454e9f16baf70831e4cd?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Syry", "support_website_url": null, "website_url": "https://syry.addpotion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRE
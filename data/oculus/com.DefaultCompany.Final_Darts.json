uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_2105537020187485_7269757817005678874_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaX5cOEZly8Q7kNvwHsgfLq&_nc_oc=AdpCWdX_xl_fKEcexADlSciFDN16SKY-9gthT7lB6Nw94ZNoewXtenjkbK3HC9c0X9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTcIRpweZArTt2IhFx0uX8qZ0iPR-YgCHWrXx5Qg2H2A&oe=6AFF14ED"}, {"file_name": "5.png", "id": "4067231110206891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827585_4067231113540224_6903185149894612197_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQbH1xkQIvEQ7kNvwG-oK-q&_nc_oc=Adp30CyDTAr187aQJENO7bw70DoorAw96Rg_dCAXxsuyWZe2KspIWkDofsrJECScJos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTrp2c35OBujAu2jPrJcT4xpXYjbIjLETRJPCMFNtRYA&oe=6AFF1F8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cosmic Darts", "keywords": ["3DDART", "THROWINGGAME", "DART", "VRSpaceDart", "VRDART"], "long_description": "\nThis is an adrenaline-filled VR Dart Throwing game that teleports you directly into the depths of the universe. The breathtaking vacuum of space replaces traditional dart halls; this is your new playground.\n\nYour mission might seem simple at first glance: Your goal is to achieve the highest possible score within an intense 30-second period.\n\nWhen you look through your virtual reality headset, a massive planet stands right in front of you. Next to this planet, there is also a satellite moving independently of it.\n\nAll this action takes place within a captivating space atmosphere that surrounds you. Thanks to VR technology, you truly feel the dart in your hand, and you completely control the angle and power of your throw. This is more than just aiming; it is a VR Cosmic Dart game in 3D spac\n{1347636427090392}\n\n{1173115774998935}\n\n{1156744719245845}", "short_description": "This is a VR Dart Throwing game set in space. Your goal is to get the highest score within 30 seconds. You play the game in a captivating space atmosphere, accompanied by a planet rotating on its axis and a moving satellite."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cosmic-dart-privacy-policy/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Mustafa \u00d6ZCAN ", "support_website_url": null, "website_url": "https://sites.google.com/view/cosmic-dart-privacy-policy/ana-sayfa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25332107453074030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1868204794071393_6298448713877176914_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2m66KPKmLIQ7kNvwFvHtYH&_nc_oc=AdpnY4zW83BkeK4s72PZt3J-xhxll0xBgyRRSjeW_7gRF1TwFpkGiyuvMESg1qCSH7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0LGES5uCiNDVsGo5C4_e9JhQRuzqxbiGG87LdsEWeDg&oe=6AFF0CD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cosmic Darts", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603
n.com&_nc_ss=7f20f&oh=00_AQFsBEnj_9Qr38fRww8ymk0EPOVvROvu02D8MEPixAlCsg&oe=6A8592AD"}, {"file_name": "5.png", "id": "4067231110206891", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827585_4067231113540224_6903185149894612197_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeGTokMKSjwQ7kNvwFRpsNu&_nc_oc=AdqX8R4MDh09fEHucEN95BkioH1uaAfVlULv-IMAnZYsf5fGmPHTqdfghrp0N0y2-_U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIADfN3Btb1JpRh8Cw7zVXiSDYt2eXpZohRg7IIt0Wgw&oe=6A859D4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cosmic Darts", "keywords": ["3DDART", "THROWINGGAME", "DART", "VRSpaceDart", "VRDART"], "long_description": "\nThis is an adrenaline-filled VR Dart Throwing game that teleports you directly into the depths of the universe. The breathtaking vacuum of space replaces traditional dart halls; this is your new playground.\n\nYour mission might seem simple at first glance: Your goal is to achieve the highest possible score within an intense 30-second period.\n\nWhen you look through your virtual reality headset, a massive planet stands right in front of you. Next to this planet, there is also a satellite moving independently of it.\n\nAll this action takes place within a captivating space atmosphere that surrounds you. Thanks to VR technology, you truly feel the dart in your hand, and you completely control the angle and power of your throw. This is more than just aiming; it is a VR Cosmic Dart game in 3D spac\n{1347636427090392}\n\n{1173115774998935}\n\n{1156744719245845}", "short_description": "This is a VR Dart Throwing game set in space. Your goal is to get the highest score within 30 seconds. You play the game in a captivating space atmosphere, accompanied by a planet rotating on its axis and a moving satellite."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cosmic-dart-privacy-policy/ana-sayfa", "developer_terms_of_service_url": null, "publis
20187485_7269757817005678874_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSo44CvDZJ8Q7kNvwHTFD5T&_nc_oc=Adp_fWxOdJRDz0gE8n7Ksi6TeXgZxiexWh4csSQbJ_lVCS6d9t8qW4HnNKqRis-v6ow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RPL0WtN-kH6fd5TzFmhS4-EIHS9O2Evy7QogG5Ga0gA&oe=69FB5D6D"}, {"file_name": "5.png", "id": "4067231110206891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827585_4067231113540224_6903185149894612197_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ0On-mbI9kQ7kNvwGgZ3B4&_nc_oc=AdqQuSxMtEe1Jty_pZhPs4VZ8sIRV1rW98vUaR0yLxEHt0qX61KqkMKch16aTAlkLS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50qlX-Evj_vgzV4y3kg-TO4p5Z-7TAI3Df1PmhubNJ_g&oe=69FB2FCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cosmic Darts", "keywords": ["3DDART", "THROWINGGAME", "DART", "VRSpaceDart", "VRDART"], "long_description": "\nThis is an adrenaline-filled VR Dart Throwing game that teleports you directly into the depths of the universe. The breathtaking vacuum of space replaces traditional dart halls; this is your new playground.\n\nYour mission might seem simple at first glance: Your goal is to achieve the highest possible score within an intense 30-second period.\n\nWhen you look through your virtual reality headset, a massive planet stands right in front of you. Next to this planet, there is also a satellite moving independently of it.\n\nAll this action takes place within a captivating space atmosphere that surrounds you. Thanks to VR technology, you truly feel the dart in your hand, and you completely control the angle and power of your throw. This is more than just aiming; it is a VR Cosmic Dart game in 3D spac\n{1347636427090392}\n\n{1173115774998935}\n\n{1156744719245845}", "short_description": "This is a VR Dart Throwing game set in space. Your goal is to get the highest score within 30 seconds. You play the game in a captivating space atmosphere, accompanied by a planet rotating on its axis and a moving satellite."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cosmic-dart-privacy-policy/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Mustafa \u00d6ZCAN ", "support_website_url": null, "website_url": "https://sites.google.com/view/cosmic-dart-privacy-policy/ana-sayfa", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25332107453074030"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2853956684789002"}]}, "baseline_offer": {"id": "2853956684789002"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761929040, "status": "PUBLISHED", "id": "2853956684789002"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25332413663043409", "version": "0.1"}, "id": "1610092306621331", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25332107426407366", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25332413663043409"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"
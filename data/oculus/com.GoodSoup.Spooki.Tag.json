cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4szna-GoZoQ7kNvwHYfFgS&_nc_oc=Adpp_2ASfy0-RGwBajsL2YbYV0fKmblwd5H08HQVURF0Vg1riPn0JchBWgr_aghkzIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hYo9g2Q8nwygejUhPi1oiVgAdMh_pww2HEbqjE-1kmg&oe=69F9E093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8DBY-7MPuIQ7kNvwEwpwf6&_nc_oc=AdqKkZfizI7lg8G9MGRTjuwUTjvJi6xvBKMBUdFzuJO1cTmHqZ5gSvTQbDpnjQqCkEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v8MABequPxcGII9mr7bNMfNGGVDSGnPbDAkXKPLTrSQ&oe=69F9FA9E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
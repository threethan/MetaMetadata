9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCi2dhx9ZVYQ7kNvwHl--W_&_nc_oc=AdrIq9Nx3Agx-tkEyqfg7NjCfbHnKk_FtyCFDnsur3YYWUU9muwVUIM79IeTes8b5o4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74zpqEPK9DAFSfz6YjyYE5pA8ARpsMz7klLS-AxdqWlQ&oe=6A203F65"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owiXWTAgNCIQ7kNvwHLC-G2&_nc_oc=AdqDUaFy6oA7CeDjdo_5EN5U10jPPq_D2_rr5zqcZWGKio7fmXXRROw6ABNPUcJFJVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I4TxdqybGoVrEvqKqc5szwtaS8bEz5lterUvYa0Q_Tw&oe=6A201C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY6G1oLj5dUQ7kNvwHffYD4&_nc_oc=AdpAXm1XVXdjS9yzw0i4FJosJ-0UHryJy-fkhPaohTc7NG-Fg2-t9e0yNiU_CPD-2os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k31RR7cgU9U8FBtkcpW6wvYzCsNprBTVdpLRXcB261g&oe=6A20361E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
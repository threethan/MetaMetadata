9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iknQW-h_hE0Q7kNvwEd0IMg&_nc_oc=AdrnGYdpFe5wjP7jwsud8ip1-KN7O-a1w-icOk_lnDX99nk0j3h2K298cB0KwNxEIj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX9EAmFIfqALdGAeyiQ5Xql2GJYzlsFzK85tYGWDUEcg&oe=6AAAACE5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--sVOQ7FqEQQ7kNvwHgYw_D&_nc_oc=AdrFlqqQwvKB8kiqwdQfdiNyRoz41Xqs04fbUz6i8YIW37J4G3I0Nh93kAIqC5JKEKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNMIvREN9P08WXjFYzWiUS_YoIdk0bOO8OhDXPkMt0CQ&oe=6AAA8993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58kYE-friasQ7kNvwFbxxi7&_nc_oc=Adq4iM2p_2trGmJiN96nlFbAWEQLrWL1OtAWPm3bwpN4HAMkzLDHZSquSqXTKhGeVzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8AbRksq56XPhWu5eeTPS8TqvvyW1mMRCllfl9vVmT1w&oe=6AAAA39E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
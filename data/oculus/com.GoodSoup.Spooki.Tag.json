cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_z2Y39C-oIQ7kNvwFrN7iy&_nc_oc=AdoNMqV0eyqcfgFiYC-mmKEg6WH69zc_KbAL9WtmYbteGNffkzcBrjxIcfMyogqQnsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X67djC5Gv1mTcUssIOrXjdY0iIxusv17fzFC-QhDAnQ&oe=69E4C893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7agTkfKiN80Q7kNvwFXA804&_nc_oc=Adpm6hLYgeeCH8eMwoQ5oUF4mLNNU-qvvl7Px0y1djwPy6mWLcI9XY0ISYYBfb6gmVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mj3IrJ7Up_P0nrJpuIAy_81kK4_uo3z_SNepwP3JWLg&oe=69E4E29E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
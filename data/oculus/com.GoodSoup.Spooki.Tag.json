9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkPDQgQ-MHEQ7kNvwGZUDGP&_nc_oc=AdqIkQIR-HCV9UCd0b1H9hkV0ZmB0bUcwztFitZH8U9gHV-5yM1v9tSXOkYugfY1TFg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDtCBXoYZPLZI5Sspn2VJzu1vr2D3tT-LeBRfUP4hLCg&oe=6A971EA5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07GpidFBvE8Q7kNvwGvNa9a&_nc_oc=Adq0GR6hGoJ2hqQQxjSsLeA-w6VhbEtsrGS-lQ9EqWq3ZkZ6gf3H_8wQBC6fJ1b7i3Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5KKsdAFoVXa3pI7wTd6JSxqj8okAjlNLf-mVckP_blw&oe=6A973393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53NoQu5GF8YQ7kNvwF06Fzh&_nc_oc=AdpgYIt4omP7qZLH6RRMGlP9HcFnvbIg4cV7D_vd6CU9bVRZavoeAzv6WnBaZSZEz3Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELM6M663eIducUA3_oTqxV74l_XZcY04NkJUW5b2JPaQ&oe=6A974D9E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP-ukX85IdYQ7kNvwGqVP5h&_nc_oc=Adr_ZHl8UHP9Zyt5x6GAAZpDNUxLCg0Kez-TJOmcGLMp42n3OX_JxF7GhQDfq6a6Hwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHSiaIs4qtkYqZbcAy2WFg7itwx2VoHltRifLep49BdA&oe=6ACBA265"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk8bOOEIheUQ7kNvwFoIMaD&_nc_oc=AdoD1ezKmKaQ8i175dzbIhdlNBPDPs4m4j-pAUZsqf1ztI9Z7wqDhhqmo3gNFU000S4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9XI0zDFezmwhWDPF6bM-gl7P4PyHUNW5_O3Wtx18VmQ&oe=6ACBB753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84qOlJlw_DQQ7kNvwHB4v5S&_nc_oc=AdqPmqgHlH8z4cmspeozbC7Vo7QTeB5PztHsRWOTF7G7ytHI13pUMixbSSu35W0mtWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0rM13juyUyDf1KQISqvTcqcbLuNy1raVBOJG_h1roNA&oe=6ACB991E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
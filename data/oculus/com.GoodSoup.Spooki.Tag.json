9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=go1MOBKvAMoQ7kNvwGjEDTb&_nc_oc=AdqsSb6KgViurEssWkmVJiFSgJG8dxAE_MpTT7ewZ3aWkUa-Y83nd4DVtIjrHPvND2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbTR2rwAhcZICsbxn59CF_cteiv_YFBN5xMeMxTa-w5w&oe=6A6E07E5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mxBGWmJtwUQ7kNvwFg1E9p&_nc_oc=Adr142ILbO0V0E_6yfJCtmQogDFoNG5UZM9i0oSt_k43oxcAQTkafZvGlay0D7aBXJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwuceqa1i8p0pn7ceaLobL40oukNd0KKW39zDaa5twvg&oe=6A6DE493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr_Y_5GLEdAQ7kNvwHyP0nU&_nc_oc=Adr3YekpuxZz56tLZPjPswS7lT-n62lK2zE52FNtfxznuuG9AQdzeYmrt2ayyr8a1VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcAc19vzu6mCMoXnEWnyrJjKJztQ_UDUP49gI74DFvbQ&oe=6A6DFE9E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
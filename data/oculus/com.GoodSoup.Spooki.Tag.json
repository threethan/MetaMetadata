27749587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BGXc7TJ4X8Q7kNvwFinCKw&_nc_oc=AdrYwhedsT9x8rKZdCWxm5TlVUm_Seiw6xiJPswqwWhjvaeU0Eu8gXBXVonbqYRzdx4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F5qA1w-DOE2ouvhQesD_bRMC6r5mOlrr4bqENHmnVDA&oe=6A36A8E5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFUqsZVwvFUQ7kNvwFMYwXO&_nc_oc=AdoJK6K5VblY1eR-ZEENWDIWVWZ4X54eMTlytSpWDj4RukHQ2fn9I-5wQnjYZH0lSU8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KyqD8JLIqcIWsRMnPlo_2THAsd2KmxzIUeKDw4ddS_w&oe=6A36BDD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy-9PAb473wQ7kNvwFUr4Ns&_nc_oc=AdqvziSvUT7MBEz_ugtIMDrqaAPi3rT-_wAvOPCB3LO6tDjlbgtc9rStC9tnUKN15gg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tdTzAT-AeJA0w4LTxnyfCP-HFAD0rdAUxy_iLFRT0cA&oe=6A369F9E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities
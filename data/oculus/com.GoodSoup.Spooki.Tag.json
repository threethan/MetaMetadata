9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vDU8oP0qsUQ7kNvwFEqD2M&_nc_oc=AdpL2lbsoy_eVIx-4a9ugSpceXT7MuRJwpqqU0U2aUeh8VXV742QWnVWn2TX-1ELGZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGLLZiGxgxOSOkdQwlj1-rEs-Z9gC4Mddnf_AOuKhrGA&oe=6AC8FF65"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk8bOOEIheUQ7kNvwFlyOIn&_nc_oc=AdqfOPJIrDnU8CXuP0JVYIL29Gh3Mkd-9R1jLRU5BAaZDJGI4qEKD42i0YU_x42Qc2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7qfofbQ37f6mRS46cZi_9AK9B8vOfO6Gk2c75GVo0qw&oe=6AC91453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlDXfMTXwyoQ7kNvwHaoJAj&_nc_oc=AdoXtraTq-yz-O6Fopx5F6zUoOGZgHAfIilobGWbjaPiVeDQjVR7QPE4n6sNXTmFU6Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdq-oZy_jwkq2DNfx8LZDGrgPi9UQZgHXLO0UBbPkGCQ&oe=6AC8F61E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
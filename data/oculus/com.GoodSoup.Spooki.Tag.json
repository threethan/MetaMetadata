cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Varb5hwM3HwQ7kNvwGin2fw&_nc_oc=Adpf13jO_lkL75ZYpyViEiyZ4O_ucvy6fVah3LAbv0jg7d6Qd6ReUk-54QF3k8fkFf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D0_ByyWno9zsc9E6u4rIBUGsi7CdhuwDOxJDrmBayVQ&oe=69D64813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=en_Lc1sru28Q7kNvwEEmC9z&_nc_oc=Ado7oiaiOA62tP7YhS5wm-lqb-uCWSotVAjIFVeQxYm_-uu0hiWypWocxIsEr8ptsR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cm-WZhEHcKUq57tyMJW9pIJR2hvmhXeycTR6_LREjgg&oe=69D6621E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L0wQqbo6qUQ7kNvwHeNs0K&_nc_oc=AdrfC8rSlzuD-MMxoZVXY4ALJCqMFbVlVa2DSvK-jl_IWaBKsaWSg-EJJ8dUBWeR8yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2awwGPwJzKso9CaCkkvIlD0Q3bAhDt9llddjl5DcqhmA&oe=69DE3113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrOGUZM3RDkQ7kNvwGltdZI&_nc_oc=Adq7C8h_mEspCrMvJqTr1XjbfoflLKGrm3vpTpqtahMRAHlJEemn9Qw6W99t87MKhio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eyMmfyr7vw1NN7WX7etZvCVcudntnxnmBZFcPbua86Q&oe=69DE4B1E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy963aFQN0oQ7kNvwGJJ7RF&_nc_oc=Adq1YnO0brMCuQvXN-bO23ShVqHEeNj43ctbGsC56zuxB7IiA_7Jul3Ly7orF9Ir3JA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbHvfcy-8eNF2TGCE700Hdr9G9gwnnkYnrfZM_m3f2cg&oe=69C67613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWyv8clN0nkQ7kNvwFbVFN4&_nc_oc=AdqUxxpjYJaroRNA9wLQwNR5D7JntuU54EIX-vuZD4Xwu7_DPcl2ilLKzy5RxWG_XDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjDtq1hXBn0_PLEGs0L2AIju3M-gC8QYiTXGWQ220TTA&oe=69C6901E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
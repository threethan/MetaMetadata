9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFVZlm1zzR4Q7kNvwHmYeUP&_nc_oc=AdpdeWDPqkxqLJddS2CpNBKGaxxlcocj0ea5n55sdE3CjtWukL7y2Zyy8MBJJlIZ-cY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOzaAUY98665eUmgbl6zz2tjogwEQE1BKuh9947avl5g&oe=6A60D8E5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjAsieDJ7lgQ7kNvwEry6B0&_nc_oc=AdpFc0RAkpybIDLN3xMF_3Anmh325BbPD1ba3AfJzMFKa2QS25zcszSF90Fm0PS96z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAkvKjN8oySlQX0wwfnb4wX3wAmZAsW20LjsB2OYNXKA&oe=6A60B593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRiAMr4fSRYQ7kNvwHNctf5&_nc_oc=Adorq-anA1ACQWonyAvyxv_Fudk-h4vQZTaSkmdWDXEWWHqfJGCSmeEZW8_ew2shDBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYKZbf7fd26ZBy8TVRP5-IeTt2R_UD4D147tpi6n-2cA&oe=6A60CF9E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
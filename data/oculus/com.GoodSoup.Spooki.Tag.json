mkQ7kNvwEmY1wf&_nc_oc=AdnlDMg3JxJbrJcuSC-DVBIgiMibYTBBRYBZPcUqaEXGZF9bP7kqVZKHMzqOHRYiZ9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzq8noFYKdl72xXhuDzvOROY736Z2yfrlXmQ2dl8J5pKw&oe=69B94713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWYn3fn9-EAQ7kNvwGQFPdW&_nc_oc=AdnMFvfn8G5DPyU7vFyOHLRaKfizQclDtAUnB1UzDXEIbXL8E9KhITIbr7ETUCWnLZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_k0aVWk71SqRQeGRLZXF0q2ADjXUHdzAG3zaXfuz2tw&oe=69B9611E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_website_url": null, "website_url": "https://sites.google.c
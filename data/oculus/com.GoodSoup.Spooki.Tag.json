9587843215_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iknQW-h_hE0Q7kNvwFcEh_A&_nc_oc=AdoaCMST1WSr7U4ZtNOraeOVj2OqusWa-GlZ5URDZ9RnX01c892WsMdzqNm0mDkMXT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHfFiPg6HNKp9feO81IEYZCWEOjjWeGq--sECA1sR5ng&oe=6AABFE65"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--sVOQ7FqEQQ7kNvwEJjNRL&_nc_oc=AdrdkfhPMWArFpsfx8nu09bZJGNuZoXlIdwEeOT41F14GpaXTzeJPAF2_8UoGoc7v1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJkAqDPKDjHoNi-ISXbFzQLgutPF1Nw488ijec-AGIAw&oe=6AABDB13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7mgW7vLtGUQ7kNvwGZzky-&_nc_oc=AdoC6BKsENuOFILiwpnewqQBO-fm3Ys-iR3ZugdFqlfCh3kt95xEBx1xHOZJk62yAw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7EF71Ciu4sw3wP9uwkB1OoAcP1i1LJ57jswpSE0z9jw&oe=6AABF51E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurki
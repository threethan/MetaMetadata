cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3V5N2Kp_FgQ7kNvwEBdpyL&_nc_oc=AdqxE4oPh9ldtViGhgMkEWzWs71u7JavBDb8IGREVvwkZ24p934wXlY0YxPebG0ahQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hrddADaRp5L-KomEGUQlgJPFIRHRztmIpQjCS6QiSBA&oe=69EE0313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGOlq5dkGiEQ7kNvwEgaWeY&_nc_oc=AdrmpJRFpfd4DzdyAWEr3sVSIuj1tGYzVzCP20vvXE5FLPSzzYZyc9N8SaP2iJXeqcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ej4od-sd3uToBp2agz-tkQr2WiCSLSIFRxnL-N4b0Ew&oe=69EE1D1E"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_we
jyrDOpb0meo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBPxdHyJYn4s1TXKM1GIrD10RzzYph9N4YBrdWO4YKZQ&oe=6B07062A"}, {"file_name": "PbbvSS.png", "id": "436244476079297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036662_436244479412630_5112527749587843215_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrhkHVqYIqMQ7kNvwFwxhvI&_nc_oc=AdqCvrSPFMWvgTzoKRP_u5fsTLsoGgs_aMbZy9N7uOOICGMbszs5DCYBmzXFf0WJ8cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTui6Zkxk9Geq2a9ZHbr6ej3ZpbgU0TIRTH83K2BWvyTA&oe=6B06F5E5"}, {"file_name": "WardrobeSS.png", "id": "1727063364734812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974856_1727063368068145_6092962011821609742_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAoOcgtD6woQ7kNvwFpXt3N&_nc_oc=Adp6bDPvxwFW7dBAU5_9OkJqPVaFxR0nxGSyIG1iTqqeEFnXs2fy8ZdEEOnYzsg68ak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrBMNkOXZEXrXG6RuOXgs2z1hnAaPIuFJpBPFOrLlW2w&oe=6B070AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpookiTagLogoNoText.png", "id": "1197538434610872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001676_1197538437944205_3100403394699496241_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-kcBYmSNLMQ7kNvwH89oob&_nc_oc=AdowLsuKiayaKhRbxdH_P24lnX6b6HYuq5tRWZLnS9VDjBrjxErmYkTAYr0OjydH-JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhNv-QTyDu5H0eghrz4PB2B7hoCebOV2IL1GNx4KIhJw&oe=6B0724DE"}, "display_name": "Spooki Tag", "keywords": [], "long_description": "Spooki Tag is a thrilling fan-made homage to the popular game Gorilla Tag, reimagined with a chilling horror twist. Dive into an eerie environment where every shadow and sound keeps you on edge. In Spooki Tag, players must navigate haunted maps, using their wits and agility to avoid terrifying entities lurking in the darkness. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays tribute to the original game while delivering heart-pounding horror. Are you brave enough to join the chase?", "short_description": "Spooki Tag is a thrilling fan-made horror twist on the popular game Gorilla Tag. Navigate eerie maps and avoid terrifying entities lurking in the shadows. With unique mechanics and original assets, Spooki Tag offers a spine-tingling multiplayer experience that pays homage to the original while delivering heart-pounding horror. Are you brave enough to join the chase?"}]}, "developer_name": "Aero Monk Studios", "developer_privacy_policy_url": "https://sites.google.com/view/spooki-tag/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GoodSoup", "support_website_url": null, "website_url": "https://sites.google.com/view/spooki-tag/home?authuser=0", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25995772826733410"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26376766885300667", "version": "1.1.0"}, "id": "351020221384192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
ZclBtAL4ZhuWbnzX7dxDFzwPC4Og&oe=6AF7133A"}, {"file_name": "screenshot_1.png", "id": "1558139159334888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/789889603_1558139162668221_1014609554868838505_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpECiYbe8_8Q7kNvwHnWFUb&_nc_oc=AdqO8IjvcEF6IJcEJiy6hGl3G_SqXkbmB_yWZ7DVS86280u206MXFoq3uAfP-BQ0bVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1JqC9w3FqAo1N9KoJSVFPMt2y6UXkoCg3CR3Pjp5LFg&oe=6AF71D5E"}, {"file_name": "screenshot_3.png", "id": "1429311952492054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1429311955825387_9078059224289372388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F_9cS9YUP8Q7kNvwELwxeD&_nc_oc=AdpszmKptbvkwj4xv2sdIDJjW0_ATdIbQh-W08RSfUYtwT4BWJIJlfVrOFnNDc86his&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE38wA1eBNEupFidK6X1JOKQx_qSsgFM95_qEuVEWXXw&oe=6AF71C7D"}, {"file_name": "screenshot_4.png", "id": "1028815236884339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585799753_1028815240217672_614555812321435249_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0EPcxj56SAQ7kNvwHoyGLQ&_nc_oc=AdrZng5x7WSoxJPSOwqJG9s3GmPrIG0E0HNwBbvz76yEcVe3NTM7nDN7o8oGXEp6Erc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQezv_OaOETvBBcJuZxujD4ah4kwJaXDa1XshFDeMD5fg&oe=6AF73E1B"}, {"file_name": "screenshot_5.png", "id": "2000492533990197", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_2000492540656863_1502097990448607638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBuo2fzhNeQQ7kNvwFnFBMQ&_nc_oc=AdpAl-bWoCrNxDKAY8q93tbXx9EYuKbNxEZKs7lqPSExHCZIS1E2axMi6fzIgPtQrIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf0ST7VO70NUI8MpgT-77r4ydJqxC2T0yVqAbqdWlxiA&oe=6AF72AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1113885917771123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_1113885921104456_6194378865101498517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuKM3lUe370Q7kNvwESIuah&_nc_oc=AdqaeBfi28HnoXmdn2bYgBB6yXtqY7v8XQ3J77C-nWLCoGBt7gaQuF6ttEAfXN-aNWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLpR2tqgKLfhQ2eXDloSoFnVeuoxs2vLVwWBBX6ZvDrg&oe=6AF72393"}, "display_name": "Flight Simulator Tokyo", "keywords": ["flight", "simulator", "tokyo", "jet", "pilot"], "long_description": "Flight Simulator Tokyo puts you in the captain's seat over the real Tokyo.\n\nTHE REAL TOKYO\nReal satellite, elevation and map data: Tokyo Tower, the 634 m Skytree, Shinjuku, Shibuya, Ginza, Senso-ji, Tokyo Station, Odaiba, Yokohama, five bay bridges and Mt Fuji on the horizon. Two airports: Haneda and Narita.\n\nA LIVING CITY\nShinkansen bullet trains, the green Yamanote line, thousands of cars, water buses, ships, airliners in the sky. At night the neon of Shibuya and Shinjuku comes alive, cherry blossoms in the parks.\n\nAIR TRAFFIC CONTROL\nA real-sounding radio: taxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the bay, the Rainbow Bridge and Tokyo Tower out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the Haneda city approach, Narita, a bay run, a skyline run into Shinjuku, the Gate Bridge, a fighter scramble, neon nights and a Tokyo tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Tokyo, built from real satellite and map data: Tokyo Tower, the Skytree, the Rainbow Bridge, Shinjuku's towers, bullet trains on their viaducts, Mt Fuji on the horizon and two airports. Start in your own glass hangar on Tokyo Bay, talk to live air traffic control, and take out private jets or a fighter. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatortokyo/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatortokyo/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366967353162794"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1421559943463233"}]}, "baseline_offer": {"id": "1421559943463233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791817500, "status": "PUBLISHED", "id": "1421559943463233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1377555858770610", "version": "1.0.1"}, "id": "1654818876350545", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1366967339829462", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1377555858770610"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "16548
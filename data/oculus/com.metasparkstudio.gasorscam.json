cPYYjOEnzTT1LlEGRE3jalJ0-GUk1HFKw&oe=6AFDBE01"}, {"file_name": "Screenshot_1.png", "id": "1763363181535221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_1763363184868554_6354689901973082019_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daWrJyphmCIQ7kNvwHvzQfG&_nc_oc=AdqMedR8nZ_ZnsZNh57IsQ_GEMFKBgizY6NOeT3YRrTroN7Bil7U5BA3jk_Jff09a4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo3Ozw6p7J94gi70FbkMNjiedXYoxxIpNTD49Yp3EiLA&oe=6AFDE019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image (2560-1440).png", "id": "1118859453806905", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1118859460473571_4826306801579968898_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0QRC0jDEOMQ7kNvwE3FeRh&_nc_oc=Adoa2dhd8oAk0iwDxWcFmcThsRdj5nZW0knFmnThhCI4gJqSOAxvzazMCkc83Hlc4rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9a_uPsZ8FQb2sedrVP-9dznDF-PclnoTitohF4QP4LQ&oe=6AFDDE45"}, "display_name": "Gas or Scam", "keywords": ["GasStation", "Chaos", "GasNChaos", "Gas", "FuelStation"], "long_description": "You're the owner of a rundown roadside Gas Station, and the line of customers never stops. Some just want a quick fill-up. Others need their car scrubbed, patched up, or rebuilt from a wreck. How you treat them \u2014 and their vehicles \u2014 is entirely up to you.\n\n**\ud83d\ude97 Serve the Line, Your Way**\n\nHandle the nozzle, top off tanks, collect payment, and keep traffic moving. Smooth, honest service earns trust, tips, and repeat customers. Or skip all that and let the fuel fly wherever it lands.\n\n**\ud83d\udee0\ufe0f Fix It Up or Tear It Apart**\n\nWash away the grime, swap in new parts, and get engines running like new \u2014 solid repair work builds your reputation and opens the door to bigger jobs. Prefer chaos? Rip parts off, shatter glass, and turn every vehicle into scrap.\n\n**\ud83c\udfae A Full Physics Playground**\n\nNothing is scripted. Every prank, every mess, every \"oops\" moment plays out with real physics \u2014 because in this game, Gas or Scam isn't just a name, it's a philosophy.\n\n**\u26fd Manage Your Fuel Supply**\n\nTanks run dry as you work. Call the fuel truck and pay for a refill out of your own pocket when supplies run low \u2014 spend wisely, because no fuel means no business.\n\n**\ud83e\uddf0 Grow Your Station**\n\nReinvest your earnings into new tools, upgrades, and unlockable equipment from deliveries. Every new gadget adds a fresh way to work \u2014 or wreck.\n\n**\ud83d\udea8 Catch the Wanted**\n\nWatch the queue closely \u2014 some drivers are on the sheriff's watchlist. Recognize them, stop them, and collect the bounty.", "short_description": "Step into Gas or Scam, a physics-driven VR Game where every shift at the pump is a choice between honest work and pure mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metasparkstudio.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MetaSpark Studio", "support_website_url": null, "website_url": "https://metasparkstudio.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1357401580789213"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "i
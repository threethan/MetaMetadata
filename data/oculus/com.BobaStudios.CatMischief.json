0_Afui-tGQ66VSjV1fM-rmafnwSLroMcZnTRWMDxstxD2rdA&oe=699D8D0A"}, {"file_name": "Untitled131_20250406232222.png", "id": "631445516396364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393444_631445519729697_7684691035594400617_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A77rG-zQOo8Q7kNvwGLVD0G&_nc_oc=AdnZcEO-6qhkZN9dCEiwyz8p0-KxMSGfWfgoJBGDvzG3ShQ5vhkYTABTE9DFxr-BoMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_EdWswPEOTY9O_97TV1MMeB_5Q1J8n4iXVI-1KE1B3w&oe=699D9366"}, {"file_name": "Untitled131_20250406232150.png", "id": "1016255889900394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1016255893233727_4585806074858216213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ir4tMFGyPoQ7kNvwHDi_0Y&_nc_oc=AdmCRbxBypqpnVBBxsb5lk_ili-EP_Itlz8UXM9Ky0w2tL7AFK39RjLz4IcJuN7eYoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGiCTdp8vR-4d1QfxRniV5JyKL6UBNWNUe4vKCcytwbQ&oe=699DA4F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Mischief", "keywords": ["cat", "mischief"], "long_description": "Welcome to Cat Mischief!\ud83d\udc31 This is a game where you move with your hands.\n\nIn this game, you traverse to different game modes, horror levels and so much more!\n\nShop - Customize yourself to look unique and stylish!\n\nGame modes:\n\ud83c\udf6aCookie Clicker - Click a Cookie and see how much you can get!\n\ud83d\ude31Horror - Explore through several sectors of a facility and don't get caught\n\ud83d\udd0dGlass Bridge - Find the REAL glass and not the weak one and reach the end!\n\ud83c\udfc3Chase - Practice chases for future levels for horror as it goes deeper and deeper!\n\ud83d\udc4dHangout - Chill with friends and rest on clouds!\n\nThere is so much more things to do in this game. And we are adding even more in the future! Get ready to dive into Cat Mischief!\ud83d\ude80", "short_description": "Welcome to Cat Mischief!"}]}, "developer_name": "Boba Studios", "developer_privacy_polic
35734397544_7676785183411930685_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x5XxNRulCYQ7kNvwGbT1yP&_nc_oc=AdrBu-XlA0YrGdVbqamD80f4ycmkFe3EuWepTS-WhWGGwSn8A0K077MCI05YoGlwqQM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwqoAX-wqbE4S-NHWSoUceOtOq7CajZQS1VFC6txfpfQ&oe=6A92C40A"}, {"file_name": "Untitled131_20250406232222.png", "id": "631445516396364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393444_631445519729697_7684691035594400617_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXxd3jmLqR8Q7kNvwEEjSA_&_nc_oc=AdoO7qahMdl3_gVkZD2F7d9UYQtxYeYYKnRMh4mS9TmWOeHErWQsVo2HQKY-m-iDMxo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAQIP-MC1nQttbJSEeqw02fRd5-vGJ0Erur_LpweOyrQ&oe=6A92CA66"}, {"file_name": "Untitled131_20250406232150.png", "id": "1016255889900394", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391911_1016255893233727_4585806074858216213_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIxqE1uM7nwQ7kNvwGkGtJN&_nc_oc=AdqSzesdDjTb8dUA8YgY8RlKY8692Imav1apQc2O9z7sKVNijyzifK0ZVpUmyFk2WlQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI03mJK2sUOetkDHn3dgSG8AxaHAUZqZPvsFh2Fkqz0w&oe=6A92DBF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Mischief", "keywords": ["cat", "mischief"], "long_description": "Welcome to Cat Mischief!\ud83d\udc31 This is a game where you move with your hands.\n\nIn this game, you traverse to different game modes, horror levels and so much more!\n\nShop - Customize yourself to look unique and stylish!\n\nGame modes:\n\ud83c\udf6aCookie Clicker - Click a Cookie and see how much you can get!\n\ud83d\ude31Horror - Explore through several sectors of a facility and don't get caught\n\ud83d\udd0dGlass Bridge - Find the REAL glass and not the weak one and reach the end!\n\ud83c\udfc3Chase - Practice chases for future levels for horror as it goes deeper and deeper!\n\ud83d\udc4dHangout - Chill with friends and rest on clouds!\n\nThere is so much more things to do in this game. And we are adding even more in the future! Get ready to dive into Cat Mischief!\ud83d\ude80", "short_description": "Welcome to Cat Mischief!"}]}, "developer_name": "Boba Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/12irfvU1SL10yRC7tw3F0vubHFnitZpF-i_oIppihtPY", "developer_terms_of_service_url": null, "publisher_name": "Spot The Cat", "support_website_url": null, "website_url": "https://sites.google.com/view/cat-mischief/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24531245789813207"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393444_974790524737653_2562369352824406683_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMNIVQ3EQOEQ7kNvwGpxZoP&_nc_oc=AdqNE-48rVAh9Ai7nvTNeUVOFGJIQu6X0BOICVT11TcvExpJLZurhElNPZVtLLcvpbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNcydhy4Qk_15DeSjLt2rvOvXIBYStSWm4RA3o-45yiw&oe=6A92B722"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat Mischief", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1748890140, "lastRevision": {"nodes": [{"id
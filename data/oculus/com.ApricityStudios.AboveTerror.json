YwoSDn_H4VN8teeG_tiBV2xkybxEvO2Ta9b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMc1dpNeOIZZGsDWiwBAAipodL7GHbZxGIChha5-dauQ&oe=6AFDC0C4"}, {"file_name": "New Project (25).png", "id": "2632641960402657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617671_2632641963735990_1999627420994076938_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieI_jks0LqAQ7kNvwH5YeB6&_nc_oc=AdqFcHIVHECY5TMczJue7_QVMMqU8hF0fP-_-6OZ29_HpwtQpR1T458dR17zN_qnFwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWwvtW-hfDv-8bXm6z98rZYSc4YU1eIHt0gB6iYmIvsQ&oe=6AFDD736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Above Terror", "keywords": [], "long_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror game that pushes your instincts, agility, and courage to the limit. Set in a dark, unsettling world high above the ground, you must climb, swing, and leap your way through towering structures and narrow pathways while something hunts you in the shadows.\n\nRely on your parkour skills and quick reflexes as you navigate treacherous environments where every sound you make could seal your fate. The monsters are fast, relentless, and smarter than you think \u2014 they\u2019ll stalk you, corner you, and wait for the perfect moment to strike.", "short_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror experience where speed is survival and silence is death. Climb, swing, and leap your way through eerie environments as you\u2019re hunted by relentless monsters lurking in the shadows. Every creak, every breath, every movement could give you away \u2014 can you escape what's stalking you above?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aboveterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Apricity", "support_website_url": null, "website_url": "https://sites.google.com/view/aboveterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24606769185618751"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25517288954566765", "version": "1.35"}, "id": "723689747240123", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24090694983892843", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25517288954566765"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1768790116, "id": "25579672251661768", "version": "1.37", "version_code": 26, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24090694983892843", "is_concept": false, "latest_released_binary": {"__typename": "
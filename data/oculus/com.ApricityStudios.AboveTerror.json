oh=00_AQGLl4RUc95PvcGUfRPEv2ng2aQjOVCDVohw0DvgX-c2cw&oe=6A8D8F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Above Terror", "keywords": [], "long_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror game that pushes your instincts, agility, and courage to the limit. Set in a dark, unsettling world high above the ground, you must climb, swing, and leap your way through towering structures and narrow pathways while something hunts you in the shadows.\n\nRely on your parkour skills and quick reflexes as you navigate treacherous environments where every sound you make could seal your fate. The monsters are fast, relentless, and smarter than you think \u2014 they\u2019ll stalk you, corner you, and wait for the perfect moment to strike.", "short_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror experience where speed is survival and silence is death. Climb, swing, and leap your way through eerie environments as you\u2019re hunted by relentless monsters lurking in the shadows. Every creak, every breath, every movement could give you away \u2014 can you escape what's stalking you above?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aboveterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Apricity", "support_website_url": null, "website_url": "https://sites.google.com/view/aboveterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"]
u2014 they\u2019ll stalk you, corner you, and wait for the perfect moment to strike.", "short_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror experience where speed is survival and silence is death. Climb, swing, and leap your way through eerie environments as you\u2019re hunted by relentless monsters lurking in the shadows. Every creak, every breath, every movement could give you away \u2014 can you escape what's stalking you above?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aboveterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sonder", "support_website_url": null, "website_url": "https://sites.google.com/view/aboveterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25430360419926286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_2330622920717168_7363717102224890994_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wMz3i626noQ7kNvwHF3sSk&_nc_oc=AdmM_BphRoQ4mZd2taCEWpNVttwIp5SifAmDxHxdjsIIn2kjGKQM1Lm2_yLp3jGhJlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftswCww4eq9vm-zjTlEcCZNOmHavJzv_LG1LmRR6nO1cQ&oe=69A6D271"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Above Te
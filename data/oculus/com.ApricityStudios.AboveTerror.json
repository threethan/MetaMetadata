IL4PQNVFDQRTNtt07uwm4PuVtHGFFmuFpXFOmfEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgRCWtRvukTftzBNVVOQKJo4yTdW00nFTOClZJO9oWeQ&oe=6AC27ECC"}, {"file_name": "New Project (23).png", "id": "1339355681048918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_1339355684382251_1291793614868351037_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG91XgnKY30Q7kNvwGPqz1M&_nc_oc=AdqGJ2zEmp15oMiYfgCdtN0O9fJ74yl5LJnjSv14QuKqT-t-iSsQ8wSr96qkFx5FF9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwVF7i8v_ZfCizeYvfJ6cBQl69AnL_JBWCfb3JG24Vjg&oe=6AC27066"}, {"file_name": "New Project (24).png", "id": "1425899555182961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_1425899558516294_3195214709032956837_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6m2CQh8EEwQ7kNvwGQiQ3g&_nc_oc=AdpDc-udciX87QyEjm9MmVJMdF6icdZZh-w8Ob9WsPlwKt57R-2Bdus893C0i8WFqNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmuL_cqznIttIjGDVeF5EAOwMHUFea2F-ZwRYg2ZtP8w&oe=6AC26D44"}, {"file_name": "New Project (25).png", "id": "2632641960402657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617671_2632641963735990_1999627420994076938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnLjcQfPZ7UQ7kNvwFlNo9y&_nc_oc=AdqZ9zKHBogaa_D3zc_wosJC4ShXGaTOX9rdqk5biAlxAvDIrj_RYWlPzwKeh9MzbUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfygz4fcZBseL7nMiWvkKH8kt9awXTK99gsRaYXUDs8Q&oe=6AC283B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Above Terror", "keywords": [], "long_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror game that pushes your instincts, agility, and courage to the limit. Set in a dark, unsettling world high above the ground, you must climb, swing, and leap your way through towering structures and narrow pathways while something hunts you in the shadows.\n\nRely on your parkour skills and quick reflexes as you navigate treacherous environments where every sound you make could seal your fate. The monsters are fast, relentless, and smarter than you think \u2014 they\u2019ll stalk you, corner you, and wait for the perfect moment to strike.", "short_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror experience where speed is survival and silence is death. Climb, swing, and leap your way through eerie environments as you\u2019re hunted by relentless monsters lurking in the shadows. Every creak, every breath, every movement could give you away \u2014 can you escape what's stalking you above?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aboveterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sonder", "support_website_url": null, "website_url": "https://sites.google.com/view/aboveterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25430360419926286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_2330622920717168_7363717102224890994_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCq_G1qFXzEQ7kNvwGhhWKq&_nc_oc=AdqhyICYwal8AuxTs2zWPqHEqsfb13YEDpH6YP8ly19rvEpf-KxbNQ2TdFOTZZ2Tqdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_A
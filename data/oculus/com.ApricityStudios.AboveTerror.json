JpDe5GUCGjOI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxehcElXWOE0nbPIQnVKzyEdGCVT8Q5pxb8Ia6dgUgUaQ&oe=69BA9A8C"}, {"file_name": "New Project (23).png", "id": "1339355681048918", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822737_1339355684382251_1291793614868351037_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-lglijhzocQ7kNvwG6aVR-&_nc_oc=AdlJlSoIkeJfD4ZI4Oxv5TSfPlmAmiVbCj9Z6ZUjCjklblVoRwmQVC1CKqQJGHLV-m4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdoCcuG8zgdjK7vemG7lg4XddxXmQ3chwGw9M5D1g0mA&oe=69BA8C26"}, {"file_name": "New Project (24).png", "id": "1425899555182961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622153_1425899558516294_3195214709032956837_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW-tI0iGXEQQ7kNvwH5484z&_nc_oc=Adknaqei4DwwjKzRBrlkaaT1F_AlpMfjoVwby703FfQa5jfEeiFizcO7bvStpg3lVHQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTID1xRRFGCyBkp99uSttWng8xq2dozQ5oGpnlN3GULA&oe=69BA8904"}, {"file_name": "New Project (25).png", "id": "2632641960402657", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617671_2632641963735990_1999627420994076938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGWJnwniDwUQ7kNvwGgK9Kn&_nc_oc=AdlSnnLNQtYrng45SFLbs09us0zKFUZ8r80E0Yh6mj2-e-7mvwBPwLyD55n9zOF_qwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJND2PDB_eo5RQBqZtP7qrFNGpjW-Wu0vNkO_pUzF5vQ&oe=69BA9F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Above Terror", "keywords": [], "long_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror game that pushes your instincts, agility, and courage to the limit. Set in a dark, unsettling world high above the ground, you must climb, swing, and leap your way through towering structures and narrow pathways while something hunts you in the shadows.\n\nRely on your parkour skills and quick reflexes as you navigate treacherous environments where every sound you make could seal your fate. The monsters are fast, relentless, and smarter than you think \u2014 they\u2019ll stalk you, corner you, and wait for the perfect moment to strike.", "short_description": "Above Terror is a VR Gorilla Tag\u2013inspired horror experience where speed is survival and silence is death. Climb, swing, and leap your way through eerie environments as you\u2019re hunted by relentless monsters lurking in the shadows. Every creak, every breath, every movement could give you away \u2014 can you escape what's stalking you above?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aboveterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sonder", "support_website_url": null, "website_url": "https://sites.google.com/view/aboveterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25430360419926286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618910_2330622920717168_7363717102224890994_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymDvOEYlLogQ7kNvwHiTjxM&_nc_oc=AdmrVIRXl8nrlZcrFrZmuzFYZoY9dEjObv0vJfkjOfILT2xwt7ctSrgVoVtLEXYg3X8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5ucRYH2N1GDCSpxXWltonCidrHoRQ8k4cXRnUR-Gp-g&oe
f\u306b\u30d4\u30c3\u30bf\u30ea\u306a\u30b2\u30fc\u30e0\u304c\u3053\u306e\u300cAIRSOFT VR\u300d\u3067\u3059\u3002\n\n\u3053\u306e\u30b2\u30fc\u30e0\u306e\u30e1\u30ea\u30c3\u30c8\u306f\u4ed6\u306b\u3082\u3001\n\u30fb\u72ed\u3044\u7a7a\u9593\u3067\u3082\u30d7\u30ec\u30a4\u53ef\u80fd\n\u30fbBB\u5f3e\u306e\u6383\u9664\u306e\u624b\u9593\u304c\u7701\u3051\u308b\n\u30fb\u8272\u3093\u306a\u7af6\u6280\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u624b\u8efd\u306b\u904a\u3079\u308b\n\u30fb\u57fa\u672c\u56fa\u5b9a\u4f4d\u7f6e\u306e\u305f\u3081VR\u9154\u3044\u3057\u306b\u304f\u3044\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\n\u30fb\u30c7\u30fc\u30bf\u5bb9\u91cf\u306f50MB\u524d\u5f8c\u3068\u8efd\u304f\u3001\u51e6\u7406\u843d\u3061\u3082\u3057\u306a\u3044\n\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\n\u65e5\u3005\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306e\u30c4\u30fc\u30eb\u3068\u3057\u3066\u30b7\u30f3\u30d7\u30eb\u306b\u4ed5\u4e0a\u3052\u307e\u3057\u305f\u3002\n\u300c\u30aa\u30fc\u30d7\u30f3\u30b5\u30a4\u30c8\u300d\u3068\u300c\u30c9\u30c3\u30c8\u30b5\u30a4\u30c8\u300d\u306e\u4e21\u65b9\u3067\u30d7\u30ec\u30a4\u53ef\u80fd\u3067\u3059\uff01\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\n\u3010\u64cd\u4f5c\u65b9\u6cd5\u3011\n\u30fb\u4eba\u5dee\u3057\u6307\u30c8\u30ea\u30ac\u30fc\uff1a\u767a\u7832(\u30ea\u30b3\u30a4\u30eb\u5927)\n\u30fb\u30b0\u30ea\u30c3\u30d7\u30c8\u30ea\u30ac\u30fc(\u62bc\u3057\u306a\u304c\u3089)\uff0b\u4eba\u5dee\u3057\u6307\u30c8\u30ea\u30ac\u30fc\uff1a\u767a\u7832(\u30ea\u30b3\u30a4\u30eb\u5c0f)\n\u30fb\u30a2\u30ca\u30ed\u30b0\u30b9\u30c6\u30a3\u30c3\u30af\u4e0a\u4e0b\uff1a\u9283\u3068\u30bf\u30a4\u30de\u30fc\u5207\u308a\u66ff\u3048\n\u30fb\u30a2\u30ca\u30ed\u30b0\u30b9\u30c6\u30a3\u30c3\u30af\u5de6\u53f3\uff1b\u30b9\u30c6\u30fc\u30b8\u5207\u308a\u66ff\u3048\n\u30fbY/B\u30dc\u30bf\u30f3\uff1a\u30ea\u30ed\u30fc\u30c9(\u30bf\u3
2\u3093\u306a\u7af6\u6280\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u624b\u8efd\u306b\u904a\u3079\u308b\n\u30fb\u57fa\u672c\u56fa\u5b9a\u4f4d\u7f6e\u306e\u305f\u3081VR\u9154\u3044\u3057\u306b\u304f\u3044\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\n\u30fb\u30c7\u30fc\u30bf\u5bb9\u91cf\u304c\u8efd\u3044\u3060\u3051\u3067\u306a\u304f\u51e6\u7406\u843d\u3061\u3082\u3057\u306a\u3044\n\n\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\n\u65e5\u3005\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306e\u30c4\u30fc\u30eb\u3068\u3057\u3066\u30b7\u30f3\u30d7\u30eb\u306b\u4ed5\u4e0a\u3052\u307e\u3057\u305f\u3002\n\n\u30b2\u30fc\u30e0\u4e2d\u306bBGM\u306f\u6d41\u308c\u306a\u3044\u305f\u3081\u3001\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u597d\u304d\u306a\u97f3\u697d\u3092\u8074\u304d\u306a\u304c\u3089\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3088\u308a\u697d\u3057\u3081\u307e\u3059\u3002\n\n\u3010\u64cd\u4f5c\u65b9\u6cd5\u3011\n\u30fb\u4eba\u5dee\u3057\u6307\u30c8\u30ea\u30ac\u30fc\uff1a\u767a\u7832(\u30ea\u30b3\u30a4\u30eb\u5927)\n\u30fb\u30b0\u30ea\u30c3\u30d7\u30c8\u30ea\u30ac\u30fc(\u62bc\u3057\u306a\u304c\u3089)\uff0b\u4eba\u5dee\u3057\u6307\u30c8\u30ea\u30ac\u30fc\uff1a\u767a\u7832(\u30ea\u30b3\u30a4\u30eb\u5c0f)\n\u30fbA/B\u30dc\u30bf\u30f3\uff1a\u30ea\u30ed\u30fc\u30c9(\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u8d77\u304d\u4e0a\u304c\u308a)\n\u30fbX/A\u30dc\u30bf\u30f3\uff1a\u30ab\u30a6\u30f3\u30c8(\u7af6\u6280\u958b\u59cb\u306e\u5408\u56f3)\n\u30fbOculus\u30dc\u30bf\u30f3(\u9577\u62bc\u3057)\uff1a\u4f4d\u7f6e\u306e\u30ea\u30bb\u30c3\u30c8\n\n\u3010\u904a\u3073\u65b9\u3011\n\u2460\u8d77\u52d5\u5f8c\u3001\u300c\u30b9\u30c6\u30fc\u30b8\u9078\u629e\u90e8\u5c4b\u300d\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\u3002\n\n\u30b9\u30c6\u30fc\u30b8\u306f\u4ee5\u4e0b\u306e5\u3064\u306b\u5206\u985e\u3055\u308c\u307e\u3059\u3002\n\n\u30fbJTSA(Japan Toygun Shooting Association)\n\u30fbJSC(JAPAN STEEL CHALLENGE)\n\u30fbPPS(Practice Postal Steel)\n\u30fbAPS(Air Precision Shooting)\n\u30fbOTHERS(\u30b5\u30d0
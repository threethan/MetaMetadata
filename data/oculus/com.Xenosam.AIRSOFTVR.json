0ac\u30fc(\u62bc\u3057\u306a\u304c\u3089)\uff0b\u4eba\u5dee\u3057\u6307\u30c8\u30ea\u30ac\u30fc\uff1a\u767a\u7832(\u30ea\u30b3\u30a4\u30eb\u5c0f)\n\u30fb\u30a2\u30ca\u30ed\u30b0\u30b9\u30c6\u30a3\u30c3\u30af\u4e0a\u4e0b\uff1a\u9283\u3068\u30bf\u30a4\u30de\u30fc\u5207\u308a\u66ff\u3048\n\u30fb\u30a2\u30ca\u30ed\u30b0\u30b9\u30c6\u30a3\u30c3\u30af\u5de6\u53f3\uff1b\u30b9\u30c6\u30fc\u30b8\u5207\u308a\u66ff\u3048\n\u30fbY/B\u30dc\u30bf\u30f3\uff1a\u30ea\u30ed\u30fc\u30c9(\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u8d77\u304d\u4e0a\u304c\u308a)\n\u30fbX/A\u30dc\u30bf\u30f3\uff1a\u30ab\u30a6\u30f3\u30c8(\u7af6\u6280\u958b\u59cb\u306e\u5408\u56f3)\n\u30fbOculus\u30dc\u30bf\u30f3(\u9577\u62bc\u3057)\uff1a\u4f4d\u7f6e\u306e\u30ea\u30bb\u30c3\u30c8\u3000\n\n\u300c\u30b9\u30d4\u30fc\u30c9\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u7af6\u6280\u30b9\u30c6\u30fc\u30b8\u3067\u306e\u30bf\u30a4\u30de\u30fc\u4ed5\u69d8\u8a73\u7d30\u300d\n\u30fb6\u56de\u76ee\u306e\u8a18\u9332\u306f1\u56de\u76ee\u306e\u8a18\u9332\u306b\u4e0a\u66f8\u304d(\u30eb\u30fc\u30d7\u65b9\u5f0f)\n\u30fb\u5225\u306e\u30b9\u30c6\u30fc\u30b8\u306b\u79fb\u52d5\u3057\u305f\u969b\u306b\u306f1\u56de\u76ee\u306e\u8a18\u9332\u306b\u4e0a\u66f8\u304d\n\u30fbA\u307e\u305f\u306fX\u30dc\u30bf\u30f3\u3092\u3001\n\u3000\u24600\u79d2\u4ee5\u4e0a0.5\u79d2\u672a\u6e80\u306e\u9593\u62bc\u3057\u7d9a\u3051\u3066\u96e2\u3059\u3068\u3001\u30ab\u30a6\u30f3\u30c8\u30b3\u30fc\u30eb\u958b\u59cb\n\u3000\u24610.5\u79d2\u62bc\u3057\u7d9a\u3051\u308b\u3068\u3001\u5168\u3066\u306e\u30bf\u30a4\u30e0\u304c0.00\u306b\u30ea\u30bb\u30c3\u30c8(\u305d\u306e\u30b9\u30c6\u30fc\u30b8\u306b\u304a\u3051\u308b1\u56de\u76ee\u306e\u8a18\u9332\u306b\u623b\u308b)\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\n\u3010\u904a\u3073\u65b9\u3011\n\u2460\u30a2\u30d7\u30ea\u8d77\u52d5\u5f8c\u3001\u300c\u30b9\u30c6\u30fc\u30b8\u9078\u629e\u
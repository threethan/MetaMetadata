=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxLVaekTepk5b5DR-X52rlzQ6GuOdbSPjuZNtd122PtQ&oe=69AAE066"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=459ut0KUyhoQ7kNvwF05nlI&_nc_oc=AdmFnu005dubBCNK4x3dkMJ6atqI7JPydx0Rv5vOAqW355ijH1UtGcdPXldWvdCz96s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzswbZe8hTme2u-dCypVWSxWztmkNy-eUUSX_zEqiT8sw&oe=69AABD3C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdpgHTsRdiEQ7kNvwFIgYB6&_nc_oc=AdnvKGt5pTJQ7I024hbzkx8rhc8ycIwuMBirbj9qB5bKh8K7rv3pMYAczPBaaCMpR9w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwvByba2KiBTBUN6hIOPjYDOhdQmwmvYjfaOFT6EmMrA&oe=69AABF4E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDvRHZUK2PkQ7kNvwEvxOOt&_nc_oc=AdlZgU8pp0mbOq4pY8XE1xTdbF-cMXLbbSeONFP-UImetEIKY_1BNI_qCY9Xuyca_3k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5geByy86UovCs6YOFeW58DSmtvbY9wKyGkTTW9cpykQ&oe=69AAD701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz0HW8a9k9EQ7kNvwHpmMan&_nc_oc=AdmE85Ric9TZ5HH-3b6Qu3UX2ZDCpvQH-iuoTlWW4V2V-TjkJNHMQ9PevPyYcg4INY0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwK34Ikxc8s7jOZDd40MDOGRkIC2PZ6NwrzyQWGThTHqg&oe=69AABD75"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
zlxf_ncvH8FsfCSOzzVGzDpKjYaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpws903NCeJGW0QFVzWPg03_F9M7DghBg4EdK6Myyu-Q&oe=6A9C22E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GecFmrpSab4Q7kNvwEM1GmW&_nc_oc=AdonNwoQAlVPLaLeop7zedJeL3_n4PLzYMi_MRKYsJQkvSgVMU1yNjlUBxgUKRD2Wc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5zE2YEQHl8AaJ6f51ylcDbVOdlEmNWT5cCB2G-v9Bxg&oe=6A9C37FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo8BS4VsAfUQ7kNvwEjkM9t&_nc_oc=AdpBxQ0DannlM1hvxSY0Yu9yljneUJtr-NbLE-z899C0ihQ_BUMygp0WTRKZNYEoOtA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2Hnuy5fsKeIbq8fQPFq0MiGrbsjvF4azoCwMXvDAHqw&oe=6A9C3A0E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tS-JLBCslAQ7kNvwGXKMvz&_nc_oc=AdqO_b8fJl2Ayyj-RQqnqt5vFheCYQce34rKzx-y5eBJ5jkdcZcMRsnr4kRrg-gXkPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoMuUir3UWn6KX5OtVbw9daj0qp7iDco8o1n5AKRwG7Q&oe=6A9C1981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EaK5Bo371UQ7kNvwFg8idt&_nc_oc=Adr9Lpplm0SiFoE5qV1tv7QI199INtuBLGaF1URLsGIPOfgnlHh_P2V3_eX7iAfaEO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVOyd7MtUjfiZxmQ1cILg9kp6coFx4UPnr5qQKGPTAhw&oe=6A9C3835"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
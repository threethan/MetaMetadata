DY3TNs4JHe6RHLQ_MbwNIs850HpU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB6gXiv-EZSiEOa_Ye9mDwvWupVyPvcqPGQ45Q5kqYEQ&oe=6A915EA6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmedxH-knLwQ7kNvwHDEJ1k&_nc_oc=AdpqxDKjca0F_AKxIF9EaNM-qyGeSCEiUBIfIW_y8hQc6FQjgGu5osb4CIbOEG3vM34&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEMXvfJNWIF0S8j74d82Cz4rbjkaZkyqjPuxHXY8ZeYg&oe=6A9173BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu22XVdhjkMQ7kNvwH97M8J&_nc_oc=AdruydhfUPSOcDi96p0ZyjH2aGpvs4t-hnAYVI91Y8MF0LX6z80OkHaQa05V2kdFTZU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNRKpfeBxbRpdzErErWbvLrzFlL-yygzh929A4OTvCQg&oe=6A9175CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsX3qpdbAXUQ7kNvwETOd26&_nc_oc=Adr2TAzJiSwyZeiYjtZNL2wGdl1p-nWvzrYTv3uCaWkN8C9a0vFxAs_6qjRYLPhdnxI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOR-DM_ZMqAT4aDu14H66Pex60rNarJ1CCRsKuo57HGQ&oe=6A918D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if6Fnhouv9oQ7kNvwGWh7-J&_nc_oc=AdrfiBnIGz1x_TTKiXmS2zXoUqffrU2BKnHyVAP1aoc5Ek-YXbajZjTskryC7ZfLUZ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoOQ0KYyTGzhg6XG0peHw7mHE9tReR9Np0wFqxT0ywlw&oe=6A9173F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
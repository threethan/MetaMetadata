PZdY-kmxfV6lfzduUqs6rbsTafXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8XzTA-SRC1iUW-_iCiYGZasEN-b7iAHeWSD_7PnDudQ&oe=6AA6AEE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEDJpS_zQuIQ7kNvwHQYoJ6&_nc_oc=Adr9IE0u92c4XSBM4oclOCesl3WknHGrF38yx9UCeAtZNgnwfAOCQ1bC-CBoz4ct7-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjpYGnnk_ZxbouMKHacYLasLFfRLL2wDZIlWCFrUdrEA&oe=6AA6C3FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoQq2U53hNIQ7kNvwFC_F7U&_nc_oc=AdoBT1fNmMqZ-4CeG_ae9qmFuz-WJnaVj48hRujA07Ay5tDc1goZ2VcmRwfacb5OpDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRzp0BpOW7tEwvU9O0zPUTITKpWOkF12vgOak-mKFlqQ&oe=6AA6C60E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTq6yGM3x3AQ7kNvwF5okKn&_nc_oc=Adrmn2Z4zGfO_cQI5_ZS9mYPovTLmC2XOUsIjAf4-qgc7oI89bHyx50CcMnBbedc3Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlwT2wa29R8fpsk9Go3OlWcIB1KHQG-xqAyIQ6W1zHPA&oe=6AA6A581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WC5JIVge78Q7kNvwH6Pbe8&_nc_oc=AdroKHDfqIQpjN636WIxRAP6_Jfje90dI-2jaSPJ_Abf86qPyI-FlvBAc7qLwrwWATg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc5n-Jnhg-JKHIEuiXDkDMkGa5bGzfHCr2zeZ1n07TOQ&oe=6AA6C435"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
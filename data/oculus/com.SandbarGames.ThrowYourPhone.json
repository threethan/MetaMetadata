EgIfaLj-SY64n_Wb5uPy0Xy8rIpk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o4G21vNKBGIHzfYNSf861Ys5vJD4OxOrdkLB7MenQDQ&oe=6A3FD9E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNBis3-8x9EQ7kNvwFWggMr&_nc_oc=AdqJ4toRcRxIHxn-esRMfN2Y7ODByeaDPnGcybTS9OOKbRy9rMbp5PrXZ9gOvRkE6CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pwj5DJG5i9-Vg1pnV13UqKtLUveG_5UX1IrjNjZ486Q&oe=6A3FEEFC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu_dnLbxlqoQ7kNvwFcO10x&_nc_oc=AdqiHmJts7NgPGVOgwOFvQfD1OA-0j-06fgmpxqy_J7oNc2FRXRPwaGlu-vi3g-i_Pg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XH5eE0ycJwQjl84_XXryD8V40RNwQos12Ay8sMXbGnQ&oe=6A3FF10E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j7BTbWFCnoQ7kNvwG9sEwq&_nc_oc=Adr19Eg_I8ny8SmvxuSY5q2bkMmxqFtcgJR4teKm3Y4kqPQSCZYN-fdQQHpAyZIVy8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XeC8R-uWOFnqTx7hSUvYSKZhuDOOo8o5jzVd_1rPp5g&oe=6A3FD081"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQMfinOThjQQ7kNvwG9ba4i&_nc_oc=AdqZDoGvmnhqDdcq18KM4v0zGWySHLwj0YKKhtPcw6ZUVTDfwkOdV22IgJJWfngt97I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GTivs_ev1b7P57QDAF7SM6hPyW5n4DBpDO5F9f1lkzA&oe=6A3FEF35"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
thKIr78GzRmx4XI-UkuDqWpeeDuM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fS85vUfjC0hl_AJuHByosM2PWpLLu-xpfaLGC3jMmZA&oe=69E78566"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86dyViWA_3IQ7kNvwFnFCDA&_nc_oc=AdqJM4JCY-luikBPHV6ZeLfy9XjVWKhwjnw-RQmuodzP7NuzqquoMvk4z0UetyqrK_M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xvxiyeQsa8T7ousSOSQhBn8QKkn0r3P6C4jxe1SGdbg&oe=69E7623C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkjRqKVFig4Q7kNvwHlR19J&_nc_oc=AdpLvzaYf1KnxXZSO3CTtq74DXBiCE5z2GnEC6T1oLp2yFABt3jvJccdBEXD51E-Y-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sQlmQINr6ankdzHR9W3pUohuOA_uaJOBIX2Ahato6_Q&oe=69E7644E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyUv-GFz4ZgQ7kNvwEOuVRL&_nc_oc=AdqTr0sFAcUtkBxDPqQG_FqT5qC03UurMDeAiZskEBYCqj5EofOUog-ERt_hq9iSEHs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GaviS2Zz0qNzALGBEyPbq7HNtf0D4s_HsBQO2lIqQeQ&oe=69E77C01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvgJq7urCXIQ7kNvwHZekuK&_nc_oc=AdoRz5CixjkFCCZLISniPJTk3P-u1gwy6Lls5cxzNBmn-sasptoOgWDOhNFAXLNt4UQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DnhjSsqutFofOxXl_FqdIjnh4k7edjb2LcrnN9LQIvA&oe=69E76275"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
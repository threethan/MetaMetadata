enTirrKfP-rJBOX-hqZ3ffO2MfhU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SRsrq6QUVuDDiiaGMfmqrJj3c0AzMW76j_-I9awAQ0w&oe=6A412B66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNBis3-8x9EQ7kNvwF1YuIY&_nc_oc=AdqUigB8FWXmzC3l7kW14fNz8QCihev2jRI0gtrXZ-X6ZMeU1ENw4dFrMCvtCTEy_Qc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-21SFAiuJ4aTILWxsDS4WcCLRHCZFWoLqxEom_g6Hkkw&oe=6A41407C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu_dnLbxlqoQ7kNvwECbA-L&_nc_oc=Adp27qUsO8mfuZbTb5wAHcWNheBFGrzcm9kayIZtrBmx1QAKIBAhX7sna2J-ppVThZM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VxUVtI85GAW9XNp3lTh1V-165XuTw4m47O7n7njwHKQ&oe=6A41428E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j7BTbWFCnoQ7kNvwH8z8Ns&_nc_oc=AdpN40tRDQdmBidIvHTXoKB8ushfUuborReW7LlIRFhtavgw0ubFdOmoAABB2_Qp7sc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EDlwIEZyq_6fEoRvj5A5oZQK8SNb9Z1r9JCAbo8vw1A&oe=6A412201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQMfinOThjQQ7kNvwF1zZ6I&_nc_oc=AdrnFIzIuB24mQwWQh6R6ElkV8lDg9LFetY9OjYZUL3o-qk-QDhpymVbb55p3w6whd4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VO7-NzGhcXtxIPCvZ8Y929SF_24iNH36repRbwFyF9w&oe=6A4140B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
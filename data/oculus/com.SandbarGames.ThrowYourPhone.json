ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6TtwWAyB9gQ7kNvwGcxCMt&_nc_oc=AdrDTVoXesBpKE3iiGfvZhGfrO5RgowiUGfEi_rzwJu-byAP5N-oQ295MLko-Oibk-A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af506o1vNo7FuusAMhKNOPedYLCoWbaTnEFdALIErTzN9Q&oe=69FDEEE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpBaANZKjR8Q7kNvwHxo781&_nc_oc=AdrCTREe4WPj66kGgTsMRijAWVHFHGdh3Po-7RJ8asSrKdXRI2wHLCXgGrf8ZSDFcc4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JBjRREtwlmafaqC0X9PbHvHdtrLlSqUHzE4RRAYUh7w&oe=69FE03FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfaDTNF70bIQ7kNvwF8ImHe&_nc_oc=AdqgGkOwiJYKBJlQcuzUTXYbNM4pXA_WSUN7GHEOVABxInoNfyyq5IwkEcfleO63xiY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DtVCy7cPXmBiAjs1y03Q0HQncc_ACV8lVYkcEzhRhoA&oe=69FDCDCE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx6OX4ajP_sQ7kNvwE6NCwg&_nc_oc=Adp2cns90tKLrAwBlFAGPyYoyGx6Mh7PiUebO2qlAmngAcyr8NJeKmQtbg3oW82DRo0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gEUQkezPjuViwkken6gjJskaPP0QoeptUsk0Itk3l-g&oe=69FDE581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGwtBNdjUMcQ7kNvwE3E5ms&_nc_oc=AdrUSwBJki5b00sY6HL6aSGxeXLVe5-54xzymyN-7dEjaETaAhR0t_GilzkTGFGeHxI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IXBvtNLEXAMxfHck7pN3fzAuZMoOgFYN_1QYiH6j2UQ&oe=69FE0435"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
aJVX-fSYRBlVqBkwdSt_CawSrP3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ggWMJOMFI9kR7ESDS2mg9k2IzmwPjj3VC-J1yVnbPw&oe=6A5CDAE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNQzZDTsiWIQ7kNvwE3nrTU&_nc_oc=Adr87nZlFRj6zD89WTHHb_bFkp4wDIKPEDivJ7MDU0HdWj3PN_vgLfS5FIPC4ySizT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPBqvKCJX4_r6c0QkeqO0zKqYqpmp4WYq5yYrSZlfKjQ&oe=6A5CB7BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bib-88daGsQ7kNvwGQXm2U&_nc_oc=Adr9QKjch7734nwnrLOM8nTLamnkbdnp8MKF4qt6ZACrV2k04h5gcZ9jF-eDnCcY_kU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1VhTtxyHbCZ-L6OFhUXVmn7bKmRogrwcI3aWKowV4yQ&oe=6A5CB9CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL6jJSxc870Q7kNvwEQ7FPM&_nc_oc=Adq1pgKTrIeAOmT0JZbh68om-1u_L62LVP5yJSZXfZLiVqN1Ahk5CVGh6Kf6giiQwvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv47ICOFU6BvrR5JmWaGG6QH7lx7SjNmYJgisD3Ub9bw&oe=6A5CD181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK-wg3SQ9HIQ7kNvwEOL83I&_nc_oc=Adphne5yAfEGXZLD9UkQwVXA6Y4orlkPoHLcHvdWMPHrFI6G7y_1ReT9qaq-H3e5G4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4-IJ-nGQmmbuKog9y9KuxqxtY1ZuydiZ0olu4C9xv6w&oe=6A5CB7F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
GjYIifwcnY_Z3hcIm1RMcuKcE6x8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwqtafUc9KiEXMdc1jQIVBNWs5PQ_jV9vijNbRs9ddtw&oe=6A54F1E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPkmUXJXOBYQ7kNvwH74Xmi&_nc_oc=Adolc-lA6kYtE0HwtSl_Ax0GwaPZqeiXukmBIAmYh2nz8v_ijvpV1B6I8d8a8efa2C4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArEYQ6vzfSEmScqqT6Nlr_BGZjsDfQnWeDziJZXQOcLA&oe=6A5506FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKgwPI5mEqUQ7kNvwFEdp3k&_nc_oc=Adp0Pf2-ynE7fgJEpBSJY5hB19MSB9ZN1kwXnZ0G0Ek18K54a-3NFFlckCRv7YYxUBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl36jDre2JEx3HPvgaLMByVFP6NMxHN7gZE97hKLWdlA&oe=6A54D0CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8zOhBj16RwQ7kNvwGwjhIn&_nc_oc=AdozaAAVAsG640cvc9ykR4CMcaqzToVCwzcQ8373go8BVcpITAx3R7yftOzoccxLB4I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhAf702fSaFq7yId7bc1QZut-E_q8cRJIz2pGQSBvCqA&oe=6A54E881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79d5znvIJ_YQ7kNvwE5_S_P&_nc_oc=Adqdcdr3BiRyOWRMl9CYSBwc6IOqRu7zs42_OxSRyVmtMXOQbWJ4U5qbCQuDiZWmoyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMNNcQbqsg1wXFylw96bNNR_ozuKaAI8VLG7dchuSQSA&oe=6A550735"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
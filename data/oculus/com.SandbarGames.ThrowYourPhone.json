ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnzdkE2VdY4Q7kNvwGw14oR&_nc_oc=AdpeGHtao7qjbT1U2s8NlF4wyA7mbByz7g_Vkukku1bEGgZxq8xqei--49-OTANRpr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-dOw8Zewije_G-gqWGNkxtcpL9HuaZjMU_Y3_ih5Ngg&oe=6A199E66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JSs279EAYUQ7kNvwEQ8cbu&_nc_oc=Adpimf5glmnU1HGqXcsJHXMCHDt3n59vbyx38zHZEAvJvLCg_bULK5X7UNV-vY10gOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gc-3U9ZsvQamIp1IewEZZoANpiXnM75amAAhnEZJwmA&oe=6A19B37C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHNHMhSq-CUQ7kNvwFQQ1fl&_nc_oc=Adooo2oAcUysv1-6M4o9ewXw9M05Zv3IH5ObrxPU1bYd9su3153JQ8bfw3Pm7_nXH9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e4kthd-eeLxM-OR4dsjE6b4zBo9dGnPOURglUaAnUkg&oe=6A19B58E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXPsDZEhzw0Q7kNvwEyD5Oe&_nc_oc=AdpcE7uPoE9Nzrn9L3HWe_1dGj5Z2iCWlIOJ4pv5_j4RYHtoVAd0vG5kw3ypO4mVizI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mw5ufgjbYK3EkJBtcCaXLFVSeHI1T0dASXnzb5EQLAQ&oe=6A199501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wRsZM3kfMkQ7kNvwE5Be1v&_nc_oc=AdqpigbdBszpqPzphDvPsKLaQZ8uLzzoESn473eoH2ShE8EpRAOKjqxhgBf2-kUh_0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TEW8lGsoK2Gj5_CVc-kKnwF6L9GS9EAvilacKwlB-3Q&oe=6A19B3B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
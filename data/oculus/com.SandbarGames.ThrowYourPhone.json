Vm0SUOYU8hFqaOKB8HiSWqTt2q5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9xyJMcdOC71-nyS9iqLdJJVRxmwzHImNVaK0gjrXyOA&oe=6AEF69A6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0d-gIkZgQMQ7kNvwG8bHrI&_nc_oc=Adp6-5C03ouHzbgnPVo7PgApM3Saxl2tSMzztMENZxoHlZ56Hi7eVN6nLUJ-gZ9hnJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6kypOsnXrn-36LqD4g08UbxQGnzRT2JYM-mvUy3-ljg&oe=6AEF467C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX-fVnYnlS8Q7kNvwEWCzXl&_nc_oc=AdrQ2OaIM4-0u0r2Oi3HLFrax6N8j0ah6cvYHgWVgBKmHnEAujTRrQWQYWApF53wjQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP6IMyQnryEO3iFC27P8CB_mX80UTA9ZSnZG9BxpWczA&oe=6AEF488E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ble-TF-BRr4Q7kNvwF6GsvB&_nc_oc=AdrqWpc-gsUnJhpNgt5-3QQGEZJjVicpw_TqmGfaoMrNMmy69ppOnPYl3YOqJRE60nE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPuIqQPMwfjcqpBKcgmEWfwWtaDj4Cr6XZyZgooBVNzw&oe=6AEF6041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0QDRfQhx1QQ7kNvwEyVPSA&_nc_oc=AdrQfeB2EDKig1RakZkh2q7pQ0JDeQ3R1wCV3tF1Z4KOHA6QJV5FCgrjy5uT5Sy1EMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxIHOqNWgGCBp5Mfm7DTIFJ-ppqcT04OJAPDDYVvmuOA&oe=6AEF46B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
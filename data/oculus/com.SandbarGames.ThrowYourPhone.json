g5QFn4t36ZXW8dqW0sDDZ-JsGpsM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEEOx8Ak2Xq6LCgVGu6W6QdGXVG2ta-9ZiERLwzwKhWA&oe=6AC50166"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc8efVlNe2UQ7kNvwGR3WOi&_nc_oc=Ado5kt_Qr2qii5JdC_-gHAQgIDXyCHTFIOkL9DAm6iGhIEg8QYERofYxrK2q6N10WyI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn7KpWMYZXsMPpq84YS3W4tanI2EvIamxA5l3XDMV98Q&oe=6AC5167C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoUHB1-3N7UQ7kNvwF1NiYA&_nc_oc=AdrdSt02rGtpcecQR2C_uJyl9aghkxZ-wzYMVQw8qzyXv-L8wIW36dANQ9-moIn3ucA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYG8AymZghlLxqC15dDBBoQRtXCyD2dcVfdMzwk10VAw&oe=6AC5188E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLpzztPSkioQ7kNvwFvmp_E&_nc_oc=Adrw5DLNq7A65U3QN3FmNFTVojmQ5Vfny6XwLk4lJJk2wgYvVVZuxeSjFdLU_s0mrhM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx9DTfoWdVmSXikGld3xtYNS7vsmSqrLppRVmSEee-6A&oe=6AC4F801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcDnj2sXM6cQ7kNvwHrQgXi&_nc_oc=AdoNum-x0HoChqn0W4vPtRd2Zsop_8Cqobhe607saFgzFzXkHWwtzWHx0btAUA9SR-w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjf-rRsHHws7NFAbnjvWqXQSURL9YKC5yg5eKZU8ygmA&oe=6AC516B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
oVQbuituY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQt_bWhDLlf7ePrCgSCieN8LZ0V7mXPUW2nq_vMpPfCg&oe=69B56C66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMKXWq_O8QwQ7kNvwFuOFLZ&_nc_oc=AdnW-7IZ4KCx1zP_R3gRSEBNYKDGUbbosTGjPYklAs32aF3iN6WXwVsp0xDIMzKJirw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-iX-W0Uh3RbeVvxMAiswQvLm-rBBKJS6zWxSy9qCfDg&oe=69B5493C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-5GEU88R0IQ7kNvwHMKOxQ&_nc_oc=AdnHQT6Ue4qn27TrfO6Cy3gjRyZTniatXV83fQqD6pRSj6ZM3Vyngl0VU34E5rcLZ28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO3wF9StD23pspyeCCPQmeMMffbbiSE6LtXE4aNO3wsA&oe=69B54B4E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wTcXkouznsQ7kNvwH7jk95&_nc_oc=AdlPZMhC0G9kmTx83eCYRYBSgu_HYbsVCtNXXcKYzgBaCpMy2hoZFYxlNjgUbP2c88A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNLNtYeFv0h12d_osy7V6cih3H7bs4xuGsyYTZ_WwoIA&oe=69B56301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU6lbn5QOU0Q7kNvwFXZ5Vx&_nc_oc=Adl4yZCH4nCp_l_cnR98MQ7ka37nTGyq6c8zh90H9NS52WSXsO2uUN8Upfuszi0ipog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2KhmPtt75c6RnyFexUSLz9ACDctHIkGNQUNTQ2X_AUw&oe=69B54975"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
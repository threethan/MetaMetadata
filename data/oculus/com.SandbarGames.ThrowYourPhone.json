cNF2_syG-BI0P4YBehDDTp5JbKGw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxOyScBxAQjC2SS0ne_k_Rd3pxlNvpRI0NwXwGjPoykQ&oe=69C7E166"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT8NKYOEw5gQ7kNvwEd0QqI&_nc_oc=AdoUk62Xs2Qd96fA--OGGN1pA-MwG66HdxHeJLRCghW7pS7G5E5q6PCxfx8BNEK1f68&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTx7s7TSgpOFEYv4-7hrJIVRrSBY6L45M8taTqAZJOtA&oe=69C7BE3C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2EjmHwqOvYQ7kNvwEeplvE&_nc_oc=Ado6mhxXRvieCFGO5RM4Zjgc-_-jqrTTQuK4KlwLjX1LPQVZ6_glcp10rWeSUpQz-dw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBI4PCzwdLjObZl1dVEtMgFojRA2qCfp5J_LrdK_QG5A&oe=69C7C04E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga4o0kll1B8Q7kNvwFDom7B&_nc_oc=AdrpSlO8Uaievb_w_8k32FMwTSXEPLZzVkjR7gmQUXgb-Bu8o9HgQghGPDpY9w7UP6Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHaMOoVcH0joYDXl3HXJAniM_gocw2GxkeifgRUAultw&oe=69C7D801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFnjm4zZuqAQ7kNvwFugRAR&_nc_oc=AdrEuRtH_3hFkbEziJbcZrU16xekrLh8zAvfHvIeIVOiw_cZ2gKQ0JGToYgpt4R818M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGmHf-WcH0_dgL-nfQqLzJ8iz3XHQJNtquRfBaACdJ2g&oe=69C7BE75"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
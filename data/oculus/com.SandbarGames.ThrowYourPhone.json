ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkk_We_uYYAQ7kNvwE9I3P4&_nc_oc=AdoxTJ6ZlrSfF99V1kPKrwAdDBVHzrU915UXPlM0fhdJJ4S98e6okAtfPIzYohnsrG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y-C7OBpl7wBtnY9GpiJbtLJvbdgoECWGHFDS7Sj8-AA&oe=6A257BE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o4CTJVOwuQQ7kNvwGRP_2t&_nc_oc=AdplUA8QPtxom3_BWZw16IffSOPYJ8a2dMr8tMf_vqSR2x3-B1vxFtJJSbd5OgLrWLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bwYqgfF72Oz4OxtK44Ziy0Hfy8zms2XH-SNYAe6-Q-w&oe=6A2590FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41_X_z45DvQQ7kNvwGq-bqF&_nc_oc=AdoieQfRhUtOI8ZtPZF5zbHE4ETLDbgnU06h0NefBl5Zj5T_p8ejai1PXvSfpT58kII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94_KlXpFujcfb5YPMxCz5rRF2nHxoI39ir3avimngJYw&oe=6A25930E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fXT7paAguYQ7kNvwFTV1DX&_nc_oc=AdoNaAXTVfAGiMO_4HT9QIaS80r5v5mBqklZCI-XT0NaMwc1IPdWUBuwGVPg_GLjUX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dMbgR7OzUs1c6fW1N9ykHv1JCG-_xRFyjJu5_MGBcYw&oe=6A257281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbXte7VL0KMQ7kNvwEneTFF&_nc_oc=Adp5TJbjrqG05WEwfSvkYSLFOKfQ5p8p2CiO0ZWRWF8N9EyV9mXqjU17wrx2Vl80Qyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LaIpDxp7q33Jpt2UJLCrCR-SvDdDSQLNXB14KJn2-bw&oe=6A259135"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
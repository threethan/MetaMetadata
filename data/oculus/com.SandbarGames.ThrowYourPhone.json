w13GfSBhG73l9vhe4Gv0EK0PAfeY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNyTjkIGaKRIJsBXNTkd2fvhiL8pDG6Cw4-cpaEBsIyQ&oe=6AF9BD66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcOgAbqm_PYQ7kNvwGSIkcj&_nc_oc=AdpMbraVpUxhidMt4s7R4gIV_d8YezJ2G1zE_pgYNhXYKOcq1qeRHH1mIiujqis7YwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYhWvXnzZhi53pMDuh-Q0o94is9KXWEOtUSO6MMh1v_g&oe=6AF9D27C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOCJfZ2bENMQ7kNvwHGI-Pe&_nc_oc=AdqzFSe4LdlyI9Ll5fdjF5CKk8wf-9qL5DMbkNKJ699CgKpF12-V6taI0BozZeAMqII&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkiLetuWdhDg8zFPjHg_VK3tD1bpYiYTNk98_iUayM6g&oe=6AF9D48E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzP57D-oxe4Q7kNvwEZEI5l&_nc_oc=AdodSewFWjjUl_rHg1GdIrnKs9irfHjsLhu6tJVcCt70SA9bAc6fJ52wrGgnue3-jYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Ep-ct9w00SUpaZJbfQgv9am6ayl9hNxZ6Bwk9K0xUQ&oe=6AF9EC41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSw2XPE70YoQ7kNvwEqBDNI&_nc_oc=AdrLgwWYvfFpJsJthidmOSQPwKu6U3nyrFmtJE4eJtzbbhhOE33mk5iv10ArLhIqfAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYWfBPDxSA0Fxhq37HZweqVeQavt_uczzHnVp7NSo0_A&oe=6AF9D2B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
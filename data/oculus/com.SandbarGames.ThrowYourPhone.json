ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkk_We_uYYAQ7kNvwFMG-p5&_nc_oc=AdqTnDX-UotENPKCA70-2zX_Iwf7H7bQO4EFkJrDK_vZURsSnFDX4WiSU72fik8Bql8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RXb0_jJwcLR4i0VcgeEyDoFhH_w2othh1CTwPiZmH5g&oe=6A242A66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o4CTJVOwuQQ7kNvwGeLZX8&_nc_oc=AdqRULuD18Ycx9rfRyjdOBCKid3a9pEgTX9n2RvQ0hdigEXMhbckORP0ghxCpx9RC8Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QF2MsEW6gpKEgsogY2_jfTi_UWVA9BxGjP6ObI0u25g&oe=6A243F7C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41_X_z45DvQQ7kNvwESJntG&_nc_oc=Adr222dWR05WuQ3SjToTxJ0K3ecsEkm5eyiXHoZPnoHvciPWDGjzN6By8qkIS2gwjwY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a-JHUHDPKCjFgy78idk0EyRIn6ZDNJs1pTzXYkU_pOQ&oe=6A24418E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fXT7paAguYQ7kNvwFdbBQT&_nc_oc=AdpnOatY3rVQs2u7H2Rygo8dNO0viEvVxZOXt_eWZNMDBtuf7OHt22on4sJQzMXS5OM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j29UWAnr3Rawl9D92rtDUAEjbhf-umiug5fTcX3ygaA&oe=6A242101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbXte7VL0KMQ7kNvwGiQoa5&_nc_oc=AdomB6HvgqgviQt_eXPKXyXn861UGWQHyjkACZ27MxU6F5gVaIReju22rUaP2GT-8UM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yFrjVj8Qj5TqvSvP-8a_kqlnDOgcf1VvIK1oxiUKDfA&oe=6A243FB5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
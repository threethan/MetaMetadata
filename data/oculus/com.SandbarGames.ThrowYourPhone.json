ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1c2qsObiK8Q7kNvwHiX0YL&_nc_oc=Adq56-wIz1gvN2StRN_bkTFwIelMiYZ83KIyfgVrs4qAE8m1TKrsAB42CtaxFm0Wo_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdAxgVMdTzATp0KYunog0FlIU8k0r2Twag1E4PD3QbOg&oe=6ACCEA66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuSUHGWorCcQ7kNvwGsryxV&_nc_oc=AdpQoz_ePue4sGGUFyAQ3BFLuKMylC6nD5l7Dbl9vobPFdXST2S-AHlsAv7h3lHYgyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPCiqtQh5TII7d5u2CE7v_D0UJhjreXh0s4eLjlytaew&oe=6ACCFF7C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo8_58RJO1QQ7kNvwEIQ6iJ&_nc_oc=AdrublgSJ92xlbNWiU_MMFVYBmasUln89wmetIZjqykVpWjdUfT67QQumvG4EJrgWXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsWbb4VQHEn2ld-GHKaD7yDn0NXLhYBpMenjYGaxCp3g&oe=6ACD018E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-KsIgQ2BJAQ7kNvwE_ynx8&_nc_oc=AdpW5i2KLw8oaeORa8Dy16zpUvNRuE2Odw_piUiSHZ_EjYpga-K2O-EuGaFGl24Y74w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDbBHvJO637S2EieQ8L7FjB0yqNiwQW0KDDZWU8khAvA&oe=6ACCE101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDg744EoTqAQ7kNvwHLJcSf&_nc_oc=AdoKPLVoXWdz_AwASmWBBGkAKM0lvASb_LqY2vcZFKb8liBTwz4WuIxG3hDrMqOYzHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS3RwAGSkEWexVrzUQQSoJQYLEFDaEgJr9kmYqCmu1sQ&oe=6ACCFFB5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
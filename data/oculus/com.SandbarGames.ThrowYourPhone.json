c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ek3Hb_AqUgQ7kNvwGw_h2h&_nc_oc=AdopauwQ91DX3zqsB4Mpv2OanrSsoZsGBDzghTmdj27tDdWQoQKJe9995RKv-YQTIo8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR0ERqFXG7Zi0YjQe4qAmr5XE6TVxRCkZh1hF3qG6G9Q&oe=6A7DD066"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhi-z4-vc18Q7kNvwFkcthF&_nc_oc=AdqeicdKSWUAackMMxTPxzrjPX2a4ixI7pCs1jvzQ-9UaqMNfpgTXmKsR6JeXHCRh-M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlX-nIEQMEqW5IRZKDw_I5ZPWoKCs8RcKreDDjbGvB1g&oe=6A7DAD3C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vHBtEt6_lAQ7kNvwFy8nDX&_nc_oc=Ado0K7ZqPEaqGNS2qCvPkXIIk0vkjEBcTmaS4hSA3l3jnKiI-C5S7TnZ3H6sfsGncJ8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEulWnhVxpuucPbLthUAFJlblr5KT7pZhw1aZGGDSA23Q&oe=6A7DAF4E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3iZoK4wpBIQ7kNvwGzhA_O&_nc_oc=AdoJm93rvKaIzNrp3-Xj_vgR_27Qv-IlIuQTk6FQMKcKhuxWhFFuYZR-_SaenchholM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBIktjX68aLdVFB_8LEorC60JlONtzlJHuKcfuE4di2w&oe=6A7DC701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7GJsRCFtUEQ7kNvwE7OIFP&_nc_oc=AdqT4IQyu5zb8Uo5-6a4Ri89Bb1kzqHAQiyFk3KiFOPVWu9pjrLH2DDCrldtgFdNNRw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLCPCDzKNu9LHfO7TgGKr-E-3HzzPBnJj47HSBZKI9vQ&oe=6A7DAD75"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studi
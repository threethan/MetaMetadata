x1jgcn0r2Gbk_QmwdCBQuEhSpum4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwNLBxebCtEim4_u4zRpo0-Kt-x0nNG1luT8NO5nFTIg&oe=6ABBC6E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PymFetcyHpAQ7kNvwFEsU9M&_nc_oc=AdrL2f8GZUeRQdahcDAS7sC_9VSRc_wiOgZ2zyRTzUr3b1sj1-YUdaEoN35OOXrrQp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_RE-Z8o-XoQdGubMs1k936cj3AXdADPNz9o0P8RvrA&oe=6ABBDBFC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Na3owV-KooQ7kNvwHDZi8Y&_nc_oc=AdoiMknkDc8Dui9c0LAgrpAd-n_DX160UtU2I2j5sGCSbHyMzPZC2rHxDtPe4ohbukg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5e4-PbAQunjonGkKPly8q0-1Ei5Xnhs71InmQ9Son2w&oe=6ABBDE0E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfCLxtsh62cQ7kNvwFML_6q&_nc_oc=Adp0UgFXvlGaGYZmBybJ19fvVZq7OQHn949t1gt8agM3JOXOQnaXYCZ8vH3RHUhRKB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpixymH4pcqXMYf6zCDrPijdyMeMAh5KdxoWVVgw5kXQ&oe=6ABBBD81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZPwb3uRWbMQ7kNvwF1-NmN&_nc_oc=AdqBonJfbJR3nf0igXuel1AKLLis97LMlwri3NQ8cyPaGIRvtukzu8YvWE4DobC4NdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS-Inb5oMZbZqIgboeJXGHk7knUfCs2lR54oY9SHw4HA&oe=6ABBDC35"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdJtZvGpFhgQ7kNvwGrObEL&_nc_oc=AdqK9_o_AMByc1NRUh-xRQuwrTUdjh0aT89gXKqYs5Sn2vAVxNDiNcW82A4oQC7JY8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo3dIEmIg39eDajcEqXZfDmxbuTHyFWiUuizZokzRCUg&oe=6AAFE966"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5VKXX1iEkkQ7kNvwGGvZcZ&_nc_oc=AdrUJj31sZ5INdID0R-oGzpMeqf7r9re_9R0D284jzAGtuw5jXW2qTG6FXOzqLtNdu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRzl5O4nv75MufaCHxJW63enjhH_ztUrLTe9Z528fglg&oe=6AAFFE7C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEe8yCA6AioQ7kNvwE6pN6x&_nc_oc=AdpZDcxheabl7c1r5s-mP23THDdUM317wSgyj2hKaA-II9eQBF7Q1pEg561XMaA25uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDCHuLkoTkWu5oJo1Z9xGRndLMaA8KuJfbGvNbuKUwQw&oe=6AB0008E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjO_LjuamQQ7kNvwGimlkx&_nc_oc=AdoMlSyxGr1qV-ceR4n2ZJH-rrGUzeaz_jMiuwZ3wrtvFFhaVrjjag4jBc4Oz1quzZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcR7ws75V22w1F9on6KqNVSAjNqc83hpNyfOijMi8gzA&oe=6AAFE001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ynEa_EPcTsQ7kNvwEwZhGM&_nc_oc=AdoSdo7gtfdSH1UkMIpokoK7Uud5lF6CqQoX1rpqhYeq5I1_gJbXhKK0v--I_4gUsUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCxpzUzgTCpi1Q7bCy4mFJUma6y-qCu0RjNlyykoYqKA&oe=6AAFFEB5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
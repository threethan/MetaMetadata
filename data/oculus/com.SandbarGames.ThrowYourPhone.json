9x18vAT04sHt9tbG7flWP01jkvh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtDegQ8AbGvG_aqFW-mWryuG3wxRu7B-Jf7XSDQzHP0w&oe=6AC25E66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc8efVlNe2UQ7kNvwFmXIIp&_nc_oc=AdoYc6q0zHMOLyfULjzWVimnx8kLWbPR4Tg-8p_SIm6ODwaG-UMmoddVN0jSYk-XqyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGFPA644aWEuF1hD7uSCvl6MaV5iEnjKd4F8tzSyUw8A&oe=6AC2737C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoUHB1-3N7UQ7kNvwEdiOR6&_nc_oc=AdqXfL2TZ0LiIvwZbOSSboP3z7pSBMvsejZhyAh3NyRh_l18n65NELt-ZPIMfan7_J8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdiC5qbxiz8URCuoXZv-XVB7FIG6xTj-eprL7ulNU83w&oe=6AC2758E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUPttbcGFBkQ7kNvwEofHhe&_nc_oc=AdpCgarIemi5bb97JSSQvtu3Nt9fvvYo-QijiuwpGMDy6jPltXQPUs2xA2RRFwd2Bb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzgP_utnX_qXCCi7OoNf-6lIDsDGNVdgdTzy3XYZt0kw&oe=6AC25501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcDnj2sXM6cQ7kNvwHHBa0m&_nc_oc=AdocFOO2LOiKOKvYxppFH4h-vXvM02PQJLNYrMwKkgmdf-O4irBTmboUl-7tKa_altE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUJ3n31Qu5A0ZGxKIZ42smcAHSFRlfEeslVOrLd8r09w&oe=6AC273B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
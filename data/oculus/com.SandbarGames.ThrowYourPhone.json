ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR1oxy4lFKgQ7kNvwE0faJk&_nc_oc=AdpQpfxqPcnphiX49l2VsM06Xv9zHNqUi3vRNsJXlnOMkYwP_lN_sBVPbD59cKYQbOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB94iGpm88idgzseEctG7f4Zd8LejthilHyjDhQBaMYlg&oe=6A5E2C66"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNQzZDTsiWIQ7kNvwHWoY8C&_nc_oc=AdqSlYQkLFI1-P5XUfgAL-RAFn7LQqK2N6DVBh9cMUsdndM9oh1PslnOJErUUOgZBbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYj6udG8T_-PIEPus0c-YIOx7trQjEf3xLGcnbRF9tVA&oe=6A5E093C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bib-88daGsQ7kNvwEo-KVe&_nc_oc=Ado3M6UG3vuDvLUBVHfh5ZYtQ1K3I2Gz2xDJhfRuJYHDxDaQCsmv7Ysy5yoWZmqPRbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHzihk35bh6N3fyc3AyKqhhC4Q35mlCKVR0qLCIu7inA&oe=6A5E0B4E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHUfZaQHmTUQ7kNvwF7YABb&_nc_oc=Adqi5HXzHtOKQfV1PaTdtXlqfT7FxbjKKlVg1cts2153WNAg39bLQ_Jqc6Cv1xoIhhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_WRYju_JojlN0JaVGhd-6XG94Aj7atsA91wMBjhhIRw&oe=6A5E2301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK-wg3SQ9HIQ7kNvwG1LhhM&_nc_oc=AdqXfktY4KrW3xFBZaDa_6LSuQZId_yToO40cnznQnTfEneDNBKGR75U9dYyACLJ5GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ1lsTNVZRx18mhwMb3wXHuW9kgfnyue_rwL2GQuC5VQ&oe=6A5E0975"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
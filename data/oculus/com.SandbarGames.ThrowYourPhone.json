ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuyTG4kXGiMQ7kNvwG7MZhf&_nc_oc=Adoe93VOqSbS0e7P1DBo7YehuVpo4CclLu6e2-5Y5CJLkGOUDW4EaxATA7j2K016dCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrA4IF_7hj6_QsrA2EX8_fitF56mjdG6rQfier9F9QYA&oe=6AF8A426"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKas_3DiU7AQ7kNvwEJ-4u0&_nc_oc=AdrhyaBc8krHBEbGwNjiCDkgqcuTz7t-82LFAssq7wIzO0ZXmvHQs-ELsl170Xr47y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSraikElribHoAG-PRhF9mDu6bM47WoOl_vFaWTGmheaQ&oe=6AF880FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFCWqDlhWH0Q7kNvwFKdZzw&_nc_oc=AdoSF5R5mY4gsjNIjM8Q4WnfjRyPHdHhIhudi9W98uonxpNpwogFddEo5hlrj_071RU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbnrjyEdgh2GB0pjNspFCv4LyfGWaB6T5q8l5cfIQu1Q&oe=6AF8830E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzP57D-oxe4Q7kNvwFFW61T&_nc_oc=Ado4wQ-aeSHGYb8PGSRM-60DiNIpnBotTICOlno8v8zuCyojqafOLEa4DDcnqpGkJxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGMVCfP8w2x-y6ZLMsCbgMstYKLXNPOPTIRb6kG54XoA&oe=6AF89AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbeMsOpXo9MQ7kNvwEqubOZ&_nc_oc=Adp0UfTLv7Zp7yARNEDR785aTEeMOnOKLiPvCOzr7mS1-DssKls2q3Apy9atJp5s6_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzqemgsNLFvRPhFUiZqYxwvHIuj3asl7no0JxpzJcQYQ&oe=6AF88135"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
m4Uo87Ekqt4vOrmncd3QLpa6hEd0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oN-v5Jj_NwPYU3Q6NHvROMDP6M6GW3aAwEakPU3ck7g&oe=6A3007E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzkuGZHMI9YQ7kNvwEsJ_np&_nc_oc=Adq-cs5813zAQm3_58y1y_MOZMyaaohuti34zOfvxA5vzn2F7dbBcYI6RSTNM81xuRE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98bR9cEfUryLH8U_-OEts7bmyVmrdgmyV_w8LBsae0Kg&oe=6A301CFC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78yLshdsiX8Q7kNvwH6iJXR&_nc_oc=AdrLQyZgemqDlzE5X5EAQDopwdvFpe-zYZzNtBt4c9lNqvATd-8-0CteOePlcUGFi50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Adj7b9UWtYEtfcvg7mVASc0ViEQZV2u66CBofNkyGdQ&oe=6A301F0E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnCDIg5AYsQ7kNvwHAn_B2&_nc_oc=Adogvc6hd5PSXbgWQHv3NHHy4eUpt4gPcTIwmcIaq979CqEhoZGg3kWOeVGSrCJN5Kg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ltjjh_Ja6BbgdLNyvSF53lqZaJjkH7g7hOdC7djXJyg&oe=6A2FFE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZXEdTQJU5QQ7kNvwG-_N1e&_nc_oc=AdrCHc6BOjSHQwzwY6DWO4bEr91cagPuRpUI9y_FHsQwlwrvmap8pS0_6m8m_YMxnSM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rGVuK0Xh-RIXrqb9H80bcXuY4f_Vmon9PJ6uXBrlREg&oe=6A301D35"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
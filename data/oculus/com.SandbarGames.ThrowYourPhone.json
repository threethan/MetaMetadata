ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj1rjRDFGDIQ7kNvwE2wEo4&_nc_oc=Adrh_uYQ_phkggsj-64wVkFln_VbPDzkfhbooFDhjVorfKjVlwh-Jy9l7MQOCkWJ6PQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U77yD2NKC1vMcrHzAPmw2UvUtunWWL77ctwZra07sPQ&oe=6A354DE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2mcJmglZpwQ7kNvwEp4C3m&_nc_oc=AdpC7HoLDCR8VoSFBgnDlaVWJTrYZ1rFWoK1JoGf6DR88XHiJDrS_OlVUSGqxMX5Ve8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wRnkD9m8clk5ldF5MzLRcs148HQ_Zed7jUBeS6efJlA&oe=6A3562FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kYXex3Yv8wQ7kNvwFkFjAM&_nc_oc=AdrvD5CgFjW69YTuwxHWECiT15dXP7QjQe4Vm6eI-o1ORSy9vdSHncWLM9AUG3Nsyho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iPfAbFfobmlJa7_v54k-Jsdjr9PuPpGC4HLZFtX9hWA&oe=6A35650E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFpuOe3vXDkQ7kNvwGk1RMF&_nc_oc=AdonrQ5vkYc8mqIOBTAvm-rd3xz9oTQUriZUAlhuBe8WSw3wt_sOmMFvCNGL2YzbaG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oM1c5vpQqJ8M2OvFGZWS_jQyHRjvm1C1kMyNxbinppA&oe=6A354481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmKkoBFiURIQ7kNvwEmiA3i&_nc_oc=Adp_d3yo8y-rHEtWCPXAaz-3RRcYrNaY09eun-mZDHvFBSyS5Jw3LGFS6RNY_czVKc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TajPKqPKBRqlFHXfNe2nzmNiUCS7qn5vajb29ltPW7w&oe=6A356335"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
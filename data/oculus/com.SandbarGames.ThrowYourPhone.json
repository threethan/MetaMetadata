ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiXHUieW7rkQ7kNvwEd4p8t&_nc_oc=AdpdHs8eFNa2SRZpcfDI-93oOqjwKQjA4HUjhDTrIbaz-RdEj1Fv93yDRogYAYsUKLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3OJ8YvDXAG1cljxxQUjnCKxQHBf_k8zM2hD5ZZJ758Q&oe=6A7495E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hf1pOtZy0eAQ7kNvwHLFjD9&_nc_oc=Adq47sSYFM1UITVEKfCqJ8TbK3isX4cEiYmouytTg_upMXZ2DxSRdv-dv4aXOlPB5Nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDXaXTn8WufD_l2WSuhXyh63I_Y84Gv4cGi1tDNJ0kwQ&oe=6A7472BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a-z_G8lrwAQ7kNvwEbpWG7&_nc_oc=AdpwHlDldSw7weZLvy6lbuaGOV2IV3RvLDiTY9ERP684VCYS1LfdS-yoUOl0FbQuOw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjrddHjrDoln6H-4Uj6PKZokIr8m6ueFJR-7ultpjo3g&oe=6A7474CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSVAjyxX-eQQ7kNvwG3z2gA&_nc_oc=AdrPwfQ1KmvZ3BYtPR1g0mEjPfAA2UgOiBfiDxWXOL9ZP9IGWm5kxZGVwxNMqGsMuTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtnrv2WAF4ip6L0CkzZ2wqftjkrjIuvAJJ-K1V9Td3cA&oe=6A748C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZSE_O-_wXIQ7kNvwF6C9vj&_nc_oc=Adr5vFCMF02HGcIZ-q_Q6vqhBwIL7YImEArcpswwYAGVEQV8jhpz1EQ-P80WaLMQSDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh4HOJm0qoDr1GEVDKqsMzNr0EQGv7mAln_tfa-4XuKQ&oe=6A7472F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
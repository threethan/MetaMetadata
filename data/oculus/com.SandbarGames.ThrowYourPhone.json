ntent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcvADg8GvDAGfZfavmT6tAjviZ-DjfG7YHEDoQ4f0pBA&oe=69AED4E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjeXMH9Ct2kQ7kNvwHSeeMx&_nc_oc=AdklCG6zB2BZMpSpYn3H1-GHyjNFwsT9X27-H7cVAFIG5VlQyEM-mMFZ3ivGYh0ABDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6naPhCVEXvk_rFF6XftRYL0R4QqAdadmV_vTYkcv7GA&oe=69AEB1BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWR4SsZzwh8Q7kNvwEspVYY&_nc_oc=AdkbA8VI9LdhjkmsS1zqAiMexCzeR4Enl_EDqm7ootD6iRyTqqDAjefCTei_qIp9L3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWgzaAhINXVZpwrEPdtd0FqyAvrPuN9H8MxY78BdfywQ&oe=69AEB3CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe0reuNw2EYQ7kNvwHs2fpE&_nc_oc=AdmDc55Lb1YBFIkvcHuAcS6Dz-sF0AYEfKWyEBs4GxifaG2VFwnGzGUJ1anHdD5wI70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZGWz5aV8ZoSCdnfE1dDuyGdOpRsERUHtCE8rCzILndQ&oe=69AECB81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxLMFFc9SNwQ7kNvwEFGXFh&_nc_oc=AdmOF91GDV7hmX1a16ShiVBG89kr_GbkGi79aZPjtN_tncGl-gV5SJTC9QDOzSKxAeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGeIfkAEZzDC_oiFdsLi--4WarY5C4dLNA9ZBdaO0aUQ&oe=69AEB1F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": 
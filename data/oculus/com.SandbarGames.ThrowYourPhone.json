e8MdJv9HZnCq9XwKQcsZ2lY71leo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnRCYDts83lqK-cUWkcJ1C8rfwanJUvQpxiI0Mz58bKg&oe=6A8AC726"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRtj-UAsOh4Q7kNvwFAQP1w&_nc_oc=AdqIMtcwDTVNzICZAqm-qp68JdE7xaGV48rYwAKzExKbN54KI1zAJebOPLICYyaLsCA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIYcTilttUjRtINAZpwm_CbS922jgtoHG5xKKcr8wv0g&oe=6A8ADC3C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y33XXbPl4EQ7kNvwGM9MNt&_nc_oc=Adq0UzFMJKyshui_i86mYssT_ubwTHCAxLSd0hnnoAfv6kzXQVbzB9u95j9Us1VHDC0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBJfqSCTDDs7g4gxEQJyYXNNtki_swqoMC2gA_Lxs3aw&oe=6A8ADE4E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa6EYuuYZx4Q7kNvwHfCBFs&_nc_oc=AdoGJ-9rIA65G6H-_B-silKwHOVc848DcG2ii2iC4j9qVUmLNH-A88BPjDuFhodzb4E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAi5DEyukx2Wr8FP_8oMgj1j2_4KcrbNA_AEvRw2N9Ow&oe=6A8AF601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5mHra8_CXAQ7kNvwFvLRaE&_nc_oc=AdpZ9aWn4fwAbocGgbvE6oNV3wGVeEXhVdC4w4LXBq95AxBu9q0IDJMlwFWIGnsRYUs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT-PUSjxOH5lRHGm_WYvB3FHBa9ZIU_PTBopmorYakSg&oe=6A8ADC75"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
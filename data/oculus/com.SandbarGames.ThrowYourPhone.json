ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnzdkE2VdY4Q7kNvwG3xlkt&_nc_oc=AdrkmZGZSVUsdjilQ5TUMBdVGsY2u7z2gPyGiN_JVAOvl-OkrPkXcyQ5QQwfL84yTA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e71CwKE8kfjeda8qDQIPJn8JSmpJRU1JPNJmKlaXb0A&oe=6A184CE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JSs279EAYUQ7kNvwFt3JTA&_nc_oc=Adq3mM4Z1w9vywridYAxsCJ0emUmpS7RUi8-AGat2VVeXPk7E0OpJm1B7TAmGBQYyD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w94luI8mG7EMtnwSBHV3EjgUO_WeOIl1i0X2KoUsD-w&oe=6A1861FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHNHMhSq-CUQ7kNvwEo0OQJ&_nc_oc=AdqlTo7pBaFWfbMOnAewKLThKKaPIzs-0kUzIJQBvNHaVx6g_lnsqeHrciLWdrHbEM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tNgECPZmJTqVXY9BHcWkn03gzIZyc5ywRrOtTIHweBw&oe=6A18640E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXPsDZEhzw0Q7kNvwEeAzVd&_nc_oc=AdqLmljy5IY0Yb0__K_Lc5Ht5nZ3DJjAdwPzf4LbMtBeh3nsF3FY7XhT9sKtzchh5H4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s4AId5ncLsHbD7FmaO9YHFtt2L-BS6o7OFzgDU-F3lA&oe=6A184381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wRsZM3kfMkQ7kNvwHmAj9B&_nc_oc=AdoYgCxlFIDvBDuvs4Aok2_gxR_SzGXd11LYaWMagMYnNqb7adfYkIUb0LY9monsGmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AKFCRucC9tUeoPlqCSCp4Alz31-QhtMuQTyMP_gw7yA&oe=6A186235"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
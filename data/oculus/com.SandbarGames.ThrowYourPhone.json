ntent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3ol6DigOFSVFqcpexYdmJqbbCV3vy3-VwciquSMX9cA&oe=69BFF866"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWRnPETkNBYQ7kNvwGbcmdw&_nc_oc=Adl-X3REeao7cCAIIgYj40hRavY5xT9w9ncM_OU4UDz86ql2lO-z5tWsqdXDRFAelp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhtZ5ybt8fS_7U7tLWoP3EF69i1EMxLnFqA3tB4qCS6g&oe=69BFD53C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kor3uDhUhLcQ7kNvwGWN1jf&_nc_oc=Adl00-GeCR3qPUbN6Sg8bW21VItCIC86xFae14Wbam9YagXznL6ACULqdVx-YnZQJ1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpp_ogG_QpnYry60jotMyLucJ9p3-iZUWbmfTbGQ3tuA&oe=69BFD74E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yocKeAW6BUQ7kNvwELTnFH&_nc_oc=AdkJT_BmNl0TwYd_6Hxxaxb9bbCDUCMv1yy4BnAPGRXFqB3o5hjh5007DWSAbPyGqOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnGv0_N1pU3OHkY5IqoP9IuVNM112mtrIBQHzuTHGynQ&oe=69BFEF01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXAD0ASBsmsQ7kNvwETaMl5&_nc_oc=AdlPi2K5U2PjmIC9_r2FOS4WcG_cT_ME4m1EmcN289EouUIxR8ZfizXp4Pz8S9S2YDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB6MktPBYFCo7rbdBqYJHMdB6QWROyp-7KhXXiTAOGAw&oe=69BFD575"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": 
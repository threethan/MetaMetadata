u6Riyhkfg1SKQ_MpxD6chHGFnPSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pa_9_xV5Ah_qM_EbfRa0NDgQ18JVgIjYvnX_zI0zorw&oe=69E0EDE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4wgSCuWyYQQ7kNvwGKlAf8&_nc_oc=Adqxn0kmPMY6Mr64coyN9VkUydqy0QkGQLCypjychJeK1zRwJtA2m1GKt58lRT9dFiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uLdQcn6DZDoiiObwt2CR_DFn0p4x-fV6BLWq-0gpZrg&oe=69E0CABC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ekMC7cwXpsQ7kNvwEIBP8C&_nc_oc=AdqYmI1UJaFdY_vE6JvZhnVp4NfB5sI8QJ9iMPsCQ2ozF4zRfF3CDc3dqSakf7yRrnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_L_MgXHb_243MUX3CegxpiWaGeqNO_qp3aLVpmr2q9Q&oe=69E0CCCE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XONuyTPScNIQ7kNvwFFiuAC&_nc_oc=AdqnumO-U-zk0Mhu9aQq7OcYzbVOOMldzThyFr3hTTpw1G9O0v_OPt8JCJX39R7KwzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bl9BmOtWNrjExJhEQDRKiwvPkOdzpwgaHK6Sq4OQxiw&oe=69E0E481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7GFcOwUf-8Q7kNvwE100C1&_nc_oc=AdqV3mWsa2D4ggW67GGLWd9qFXJKoj5zNo8qJTQuFtEQ07PKtwV1kFZUHN81TIJRQuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af061t_ZQOTaQIR6pw6KfvYZyfqrJBsjd7W-VfhpUqET7A&oe=69E0CAF5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
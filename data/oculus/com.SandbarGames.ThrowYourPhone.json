1FXT0PhfK2hyE_aLQbqa3bbkkl-M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4bvBnAeMXHTOcOSOFnubBwcrnw6cxacBgsAbRKSy8bA&oe=6AE353E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K9phJ3MFH0Q7kNvwH4AtUd&_nc_oc=AdpPK0qoc6gIUhw40Bjwb07DOeidI4qOqRwR4yJzQP5OfYoB0D2IYUA61wxMpCUXwdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdbLZdT2rDp5--sK8bTfo2oXiMLLpiLaUfYmPSRdt1Og&oe=6AE368FC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzAn211L4cQ7kNvwGGI9TS&_nc_oc=AdpMqqrXBojth3R0W4MDNM_sWJDl6yCEMsoOkiU-BRGhKG9F2STyvOO_pW_-7YDRtIo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Fw2U8-Lq4dFO-0y3huAup0Deodk1TatER0QQKyk4Fw&oe=6AE36B0E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwCg88FVD_MQ7kNvwEts5jp&_nc_oc=AdqLXjWfUGhRJhIaOp4oLDYEp_1jE1LsfjrZtm35v0Z3ML2QPCu2RV__SZEMOMazGLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFPubGxnUMn-qPSYfP-wNM_dXdwKbXT4jSvqfdx57NgA&oe=6AE34A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6iglY2GJwAQ7kNvwHIKbU4&_nc_oc=AdoDHdNMo2X1JqVObJlSFbRIVtPn2ThcO10jhp4UXHK8odaN4_f5iKW2nXgf9a6fomg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORxuInyAh-oU7bFSvdn57MV5rdTQT6e5o8mW8tqLJjcA&oe=6AE36935"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
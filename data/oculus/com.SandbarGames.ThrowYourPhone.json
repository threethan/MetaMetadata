ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMhgffspp28Q7kNvwHztUky&_nc_oc=Adq9R42Ym8lPNOQzZM8j_3r9BvBP86DH-dHcxZ2Qf5L3mz1RZQ-jasM_mzgcIl4uUbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H7x_zsYg0VJczYDAauS_KKIWdfDiK00iURk2U4QUl0A&oe=6A3BE566"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC5puaNnuP0Q7kNvwHUCaDo&_nc_oc=AdrACdRB6kUpjahjTKPGzOL09-0El4FxXFw8PJVq_tM53OAH7uwHxDdGn51J6-h78Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hYfT37lxjPEL2pqBOSnqPz_4XSgY2r2o-HetTUmqmmQ&oe=6A3BFA7C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK-xPugOe2AQ7kNvwEL0GOh&_nc_oc=AdrDCNmk_bDpuj4KVqRNHI6KgXgnzB5IjbFPb-gXGVyMP5MuLP6LZo6vu5z5aIiVZE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fs5vqxMZwonicA8CK8jZTtqxg9udeHQQON2gMxVC1-Q&oe=6A3BFC8E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-QzCEuoL5gQ7kNvwGjSG-j&_nc_oc=AdqaGq2BAvstyBX_yKJmmDwE0ft2KQ9n0u5ojm_P4aptdmMLHKFMyswApM0JgXpU1iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-Guln9uQqG3xtvkbMRT6FkHA9fC4sFYRIGKgRA8geCA&oe=6A3BDC01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Vd1p8GAR8Q7kNvwHuOAe_&_nc_oc=AdpnePrEmc3yxCBJb4IA6RTwyX9OGgMdvR1RoNDitnbJ3uOhdL21qUVcXuT6j-_Gu_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AGIzB-jOaid5VsiyVtHJTub2P6E6vggQp28Yk-TOrlw&oe=6A3BFAB5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
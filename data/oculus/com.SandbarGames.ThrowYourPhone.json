osJ4x23k_ve6PKzzQeYiYPgfg7Zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af111bK7r47DDvUu187gq60DyKA6z8FVqTBhd3jz-RShGg&oe=69E390E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4wgSCuWyYQQ7kNvwG5cd0w&_nc_oc=AdocRnLIaASDuexHd2VjBK5YJwbzXfcaS1Z7EQrpK3slA3rare3SrO1VdrwxOpRpmWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NLBHq3A5CODhuu-3zxJYrR1B4TJ7b7zkgWLRpZgBh-A&oe=69E36DBC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ekMC7cwXpsQ7kNvwG-efZH&_nc_oc=Adqa_SyHgg6oa5_l-tsR0rKkSw-5ZdvQLA6urU5NpxZNEorFlW68w1Nlpzb8wkpki_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3559ECWhmHaWJ1pC56Rc4hs9XINkMQ8r9n1eoFmUcEUQ&oe=69E36FCE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntSyNPMbf4Q7kNvwHlmmAi&_nc_oc=AdoynBUIcwQ7ZoPx1S4sOyXR5Om5kQ2G-K4Yl-Nb6FZm10kJphsr3FZnQ_o-SwFHpHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tGIQ0Ie7YyNWK4-8Fs1mRqoz8vc90Of-jZ4KbC9m8rw&oe=69E38781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7GFcOwUf-8Q7kNvwGMHlci&_nc_oc=AdpAV5KA1LLUOYJIfA8PTNXJsQIZgvh0icBB7Vfnf7Pgzj4sgJyjbhuh_UnAFChY2so&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MlDm_9oHwedf7uPTzk4UY-7UvQSpZ2S2VF-sNR8CLog&oe=69E36DF5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
i2n2sw1L_GE8ee-_OkDqU-AvRbfk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrQd80q1WH8oe_yWvXAjB1I_ErCxwr0cKhuRlObH5CiA&oe=6A807366"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igZtzDOUlsQQ7kNvwFhihzi&_nc_oc=AdrfiGj6GqcR-MTXq3ENYb6nswqUoXgIGRZBrLA3WylO2NY_uxszKx1VVs5u0D1bdv0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-0c8ukapuWttzM49DnVJ5wHmJHVh7CewaSJ_NXm9big&oe=6A80503C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwOsU5LcTWUQ7kNvwHEHWr1&_nc_oc=AdruAkXtdjXkTfS_kjglmo91gfKAaQKGEo4tfkMiffqtb3Bm_LmEiAr7DMkfezOnfbw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2CRC8c1FiOQAZ-FqrMPIvi07lVUniB_ib5LJ3VyPWcw&oe=6A80524E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3iZoK4wpBIQ7kNvwFJoa1y&_nc_oc=Adrj-KUokGy419N_hwCARLzFLfK7F8xVty42ZANnwb80meEkoFb91wGdnICzlRnRByA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8-zhREPPJC9Z-v_SJMlQPR2zrLVjWLl4hWlpOqvE2vg&oe=6A806A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-iupg_ZfeEQ7kNvwGesLWs&_nc_oc=AdqHFlAacrhlr5FRzihsFbwccZonFkGnvvizpJ1FDEe91gxPpNgYf2mQE9gh7Vwy2oo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeG-1FiKhCBOvjX8L-2D_7W9TLpsuf6tedYS6C5eGPjg&oe=6A805075"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
kIQh335yIjpO-foCHYzTI01ojkGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eLnGwUnrUfdeiIPXQYMUicXpWMaFq9lWUzyTFKHRmMQ&oe=69F8A8E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFrK0N-6y84Q7kNvwERv5Mc&_nc_oc=AdriXzo7lobE1Esf2dHyUc-8BFvOaSKyNMmLQPqnXB3oVhGAQyK3p3f0h0sazHRlga0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05eRc1uZ-6aSNQCfJBT_ttFIeqcEwVGanhQmurnyon8A&oe=69F8BDFC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tNKOr4KbO8Q7kNvwHK74hp&_nc_oc=AdpvM7ltgqNulybGF62CbFItDzTTp3iZx9ZYWl7k6gyZftBxkuImKTMfPte8P7zU0nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gAjF2b94aY98FQ909k03Ijn95VPIH52Ou3ol-Ge5Yug&oe=69F887CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvq-xlsSj_UQ7kNvwFBlE_K&_nc_oc=AdpnOcbJ0YIbEwkP1GTiWaxGt4y1YcbSDCgr-XWR754yS6UHCcnFQygY3bPvK8fZ7Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11qkMdriw5XqfGQvg_ZdIV7SWDNOE6Yg64ZOjmjWNClg&oe=69F89F81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flTXxjXBsWoQ7kNvwHz4kXS&_nc_oc=Adpzbs90sncg2g9KBFABsiEW7Zm4wUhCjr_sl5o5nlEf2FJQe4EQgjhT4QoAT4UVbNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LIYChwfFBoxj_ZtGxcijwyStNB_INI6ZP40NaDH2gSA&oe=69F8BE35"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
dQpgRyJrXDkoxvtLTHiTMOQ5K5nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12mCw_50apGlk6lWeZOfIYSByDLr3ZhRDdZZoxapOZhQ&oe=69DE4AE6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZtjxX5e0WAQ7kNvwEipJ6X&_nc_oc=AdoiwfgJdczxtgTrBbR86ygHRfnEufcxpT054isj87qYZqByYG8Svjtdw023Uu9vRsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FoG9id5-HBib-8DtIrO0WTCw0PSunlrXn0yUCocjDwA&oe=69DE27BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGLUBnrHBk0Q7kNvwEmsSLU&_nc_oc=AdqNn-oqPXGmiRPnV8rCow2DaxbnVp3_5g4BIUHX6eWLNpl3nBgmGo7pnnyxYHpiprU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qhOwFFXhi703bHI0Rhv8w8To12AIkip0bJpA_0dLNWg&oe=69DE29CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUNaFBOKTt0Q7kNvwF0_xgy&_nc_oc=Adqbilojcwoh0MMviE3HkoAzwePL9q8x_-m_EzxBspOtKL9Ay0LosVdAXwmLvWx8kgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VLThGFsHx64vNxoshSvMbmthmMekeIecgRgGJSVTyag&oe=69DE4181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDnnp29XmB4Q7kNvwEMOHQ0&_nc_oc=AdrX_FFux3V_h37ne39E9X3LQrR53Njc0HffZTh-Zljc0cAwn0NVjKY0ojAWNh3PBRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u3kyPVA9V2j8WiWBuckn36TGjigRwmKM8syfDcNM6sg&oe=69DE27F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
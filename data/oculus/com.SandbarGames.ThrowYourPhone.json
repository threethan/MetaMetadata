1TfbMZmiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwop1ekNPnLyXlTI7ECaZEQ8eG_zcLuIK1nV7kJ1ri5ZA&oe=69B2C966"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoUPUlq23VAQ7kNvwGHJyq8&_nc_oc=AdkJA5lcdHV-N20hgxgdu9U25YF76oUJKCjvnrHwi1V6vWJa3cuN7FqRzqfsYUHCJUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz96tjMctsYxuBu5tS0wqNezDdwlSg0grkkwxNwkJp-qQ&oe=69B2A63C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXRoZjXnnNQQ7kNvwHkbeQw&_nc_oc=AdnUSsJVASZp1R30YMI8Cgue6b5QpsWGY0GTLvWy8YEGWOWVwAeKI3ZgVLU9NXHh1uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwh9W6Jwltlb2HGN7Z0mASvMY54YGMID8Ypx91va-2UIg&oe=69B2A84E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODC1Ou66vL4Q7kNvwEjwk9u&_nc_oc=AdlIWH4GXJklQY5IKr9cbizncpR598rjWkqpYtIBE1vdi1Ci_7zMU5bYBvptHQSq5ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXp88OOkWrsI-6-N0XNnW39lNo06_JKc4cN8r9MEp2jA&oe=69B2C001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtqKXTsHiPYQ7kNvwEmMMhA&_nc_oc=AdmZVsqxmXUMlVa9-WHh0-qw7CWvlCK7xGFziBIGS06HCBIHjNU_RB6MQc4RZidNQZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZcGHJx8I5HhbUo3czrfSdgFC6RkGp2eIG-6MRIdCyng&oe=69B2A675"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
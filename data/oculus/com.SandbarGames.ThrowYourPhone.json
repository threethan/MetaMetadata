VUbrwOAfRYigG1gt9QPCzPPPBXwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTLzgbFknWZptjoohPxPVzIYR0W6jRMAjHLTbkaS3_yQ&oe=6A9D7466"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GecFmrpSab4Q7kNvwEX1nKR&_nc_oc=AdrW1G3L3sItGws2IOvl7iPQyNSl6bwrV5uX5PAWIIqiRcGWxe7tKYyun0wrXndKPEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn1Uzon43c2byN-qpZMMPV68qEsBQx-w_F54tsEIyc2A&oe=6A9D897C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo8BS4VsAfUQ7kNvwEVt1QM&_nc_oc=AdrMcVfx6tvZcsoh0QX6VuZxiM8YX0vJeT1LipmhR1NuJ-T_20D2WkA27sj6ctmYa5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN2S_vf2Ym_Awmr480fx8IG6dEF9AG0RbgLzcrFax-AQ&oe=6A9D8B8E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a6QOnBn4UIQ7kNvwE96SZq&_nc_oc=AdrUsyZOy0eBHULnGss2Ti3L7vgBaqHmO159UaOiBFiIJULE5BOGxlLz6_klgIQZVX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrJmVBcxmj9phG3lDaLq9sIsUWkYCYO0KvMpqYzto34Q&oe=6A9D6B01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EaK5Bo371UQ7kNvwHOCza9&_nc_oc=AdpizTrbHoDPA_dlSIw9Ele664kC356tNJYRCj14T8kz8sa-klXFBShQNUMexU0H2Mk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXlKN0jxRghzdYF8DjPYbEuo54gu4n2whk12X3xtsEHw&oe=6A9D89B5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "support_website_url": null, "website_url": "https://sandbar.studio/", "category": null, "comfort_ratin
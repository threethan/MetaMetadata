ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALHtzhqs-OUQ7kNvwHr63s5&_nc_oc=AdrvUP1Yl34_reBSf0lXfPI__DUMnkub29WIRT4tAN5lndRKvwwH_aMrE2wW0syqdhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PZPV6R7jIHWX4JnVfWtZ9r1EbkfdLBZbnenb0oWV3WA&oe=69DBA7E6"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxHD63K1h5YQ7kNvwHC7TCg&_nc_oc=AdqBcDuFJnkqVG87kPBNErQGjvSUKDJD6RyoGsafBR1tBOfs3MG6RXuXSHDy3KhLI_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PQQ7_eymcVrDbnFj3FMg38KqaRZBCDMyLYhTJMC1OQg&oe=69DB84BC"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuXXKORH1jAQ7kNvwFUbnjS&_nc_oc=AdrShIk6uSyi81F6M_H0WHaXfgocY2HXg-f8AajKcSStt6daSTJ2aXgIprE8D6xs21k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12T71iwnp9lO64PCk8h6N5Xndhp7m2e6SDuwU75Y08LA&oe=69DB86CE"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUNaFBOKTt0Q7kNvwEbUCB-&_nc_oc=AdrKGZ34f54bvGgaQnLP789fmAqv554QisCCvEjhmScF9Ef1fWAMqTo-OpQQUPEGZC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zBykHo1OX6lVqjcrDFgTuC6bU5n6WMFRf2ldTlMk4PA&oe=69DB9E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb6RL0qVFp8Q7kNvwGsYozv&_nc_oc=AdpxT4ilt_4XUmmICyCDOedme2r87TFvQf_xfbF_DuF57Oq-xGuDqUGesrLnQQT6PE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uM3_LGaX0D7HgiuYp4DaXxC6asSLp1gBhTsf0m41xvw&oe=69DB84F5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZnniNoQezgQ7kNvwG76icY&_nc_oc=AdobZoTQDG_tBvkcGF3gcv77S8ZAaremDZCaM1qg7h-1jWtPh3PZeKorySOVyWjSJIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-tHDV2Eotg8LRc3o3K1xvxxyfx3C8rjRAecPDAahRVA&oe=6ABA7566"}, {"file_name": "Screen_5.png", "id": "1232593224941425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819375_1232593228274758_7493893171448592001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PymFetcyHpAQ7kNvwEvtVEx&_nc_oc=AdqfzLZCueCHvyFMBjQPrTxkGaWazuXxTxAmCvHOu8L1jpUCWcitTP8uGGifPKQaaFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrxZZXyDInaKEFbDLKax_kRnpVxiRHl3IMYlrU29hktA&oe=6ABA8A7C"}, {"file_name": "Screen_2.png", "id": "1048723017350990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821028_1048723024017656_554074277256702573_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Na3owV-KooQ7kNvwFNvjIT&_nc_oc=AdrnJbGO8Jvr1O4wFiAS-nd7HzI750vgv46XnFocJj-R9CxlaTdH1Y8G94RUSGsULo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpQxDFSTq2-F2i-1b0UxYqSvpCExkD8Z1c_eX8WjUFnw&oe=6ABA8C8E"}, {"file_name": "Screen_3.png", "id": "24193664213559600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_24193664223559599_4340287473507923001_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfCLxtsh62cQ7kNvwFkcLsQ&_nc_oc=Adp89MWu33pmslKNuEb9qXNh4lBQS70igYFaBcytGCB_6wwfOZBeHQmJNVM2cZ3w4Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJHuS0ldSnwgvH2FBEnBn2HmMVYSlhS4ZYJFLaO_08dw&oe=6ABA6C01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1751197792168277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819511_1751197795501610_8257165802965328582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZPwb3uRWbMQ7kNvwE9Fw6V&_nc_oc=AdqXIjrfiJ82yhpAErPFaU5wnrKcD3ppW3LXxVrRVm_YcOtjw012lbw4H95Tn_iue2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUcuvW-7WOLl_GdM02JYp94GoJAl5yEmAI422QWHfEoA&oe=6ABA8AB5"}, "display_name": "Throw Your Phone (Into The Ocean)", "keywords": ["Ocean", "Throw", "Phone", "Zen", "Water"], "long_description": "No weapons, no leveling up, no loot, no drama. Escapism for the modern age. Throw Your Phone (Into The Ocean) is a simple game where you can live out your secret fantasy of throwing a series of phones into a series of beautiful bodies of water. A meditative experience and cathartic way to deal with our attachment to technology.\n\n \n{1432708491191065}\n\n# Arcade\nArcade Mode has a simple scoring system and allows you to get competitive with friends. Toss your phones into a series of objectives as they float down the river, drift by your sea-scape or play some strange carnival games. Featuring a local leaderboard, so you can challenge your friends or get competitive with yourself.\n\n\n{1394733298410408}\n\n# Zen\nZen Mode is the ultimate escape. With no objectives or time limit, take a walk through the palm trees on a moonlit tropical shoreline or witness the northern lights among the pines.\n\n\n{1761583444569874}\n\n\n# Experience...\nExperience the thrill of your rebellious acts in a series of beautiful environments. With none of the environmental hazards of throwing your real phone into real nature! Throw Your Phone is the responsible choice, and the ultimate simple satire simulator.\n\nFeaturing realistic water as the centerpiece around a series of stylized tranquil environments, this game is a digital vacation.\n{728414019531017}", "short_description": "As simple and as satisfying as it sounds, Throw your Phone! (Into the Ocean) A relaxing and meditative experience designed to calm your wild mind. With scored 'Arcade' mode and open-ended 'Zen' mode among multiple immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandbar.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SandBar Studios, LLC", "s
27_3776123756725666650_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1IGqOpO6gwQ7kNvwHMqYsZ&_nc_oc=Adp567rzm6pIt-_tEzFnNv9UV4x8Q0ol1bjRLmQ0DIpeCkWxUWVQC3IRIPoV4-joLw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvq02jzFAU3QSIaN_nhDwxTc1uufPgXt7G2tzbkhyYnA&oe=6AFB4117"}, {"file_name": "screenshot_3.png", "id": "1783542762694805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604375581_1783542766028138_5507937418808999747_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drzlszS4slMQ7kNvwHQPq3q&_nc_oc=Ado_FkklzCXrYn3I59Ki61dRFyp3ggrpwk9EZa0Xgw3-kYMJrr1LC3tFwSnP7UvL1B4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVws0A44L3povHcW2hSUyemU2XKpjgN91Efu7yt58Q5w&oe=6AFB24D9"}, {"file_name": "screenshot_4.png", "id": "2985750858437657", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604360590_2985750861770990_8698036038339986067_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvHSm_cA0csQ7kNvwFffdUu&_nc_oc=Adot40BQAHVnphV92jIM6Es2wC5v-B_nka3VZEa4NKLNB8h_W9gBz6zeLJDzCBt9nYE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoLEzcUEZa-LrcNrovhPdvd0bZu3omcKI6r-Ggn2nY8A&oe=6AFB1B0B"}, {"file_name": "screenshot_5.png", "id": "1100540646100020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_1100540649433353_7003575331671331883_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oifngQzXYS0Q7kNvwHEYG41&_nc_oc=Adq1YSGPIqxsrWjR--SKwMgxo6m-5OMqMBLDl2XKIWviY57l3RTl8yKslYbSEmqWjfM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzue2cZdKXUNu2j_0_G9HuWy-bKxsIikxq4lDiaG1P9A&oe=6AFB23C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1071578702151822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831299_1071578705485155_1147939677992522011_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsm33PoA4zIQ7kNvwE2p-ja&_nc_oc=AdrfaWGKMu2WJP2L49FUH7rW_0VzG6laG1U76kcUlN0pRqmEpRcQ78FaXQHWzKtBTNg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoLTr_eOktH7YFvbGNjbLfY8aRYATwnvPwDKvKzr2htQ&oe=6AFB4099"}, "display_name": "Graffiti Birmingham", "keywords": ["graffiti", "birmingham", "painting", "art", "sandbox"], "long_description": "Graffiti Birmingham takes your spray cans to the walls every writer in Brum knows.\n\nFOUR BIRMINGHAM PLACES\n- DIGBETH: under the blue-brick railway viaduct on a spring afternoon. Bricked-up arches, a passage under the tracks, an old pen factory gable, bunting over the yard and trains rolling over the top.\n- GAS STREET BASIN: the canal basin at blue hour. The wharf warehouse, the little toll house and the Broad Street tunnel, narrowboats lit up on the water and the library glowing gold across the basin.\n- SPAGHETTI JUNCTION: underneath the great interchange on a drizzly morning. Giant concrete piers and retaining walls, three levels of motorway deck overhead and the canal sliding through beneath.\n- JEWELLERY QUARTER: a cobbled workshop yard off Vyse Street at golden hour. Brick walls and roller shutters, festoon lights, the tram gliding past and the green clock on its island.\n\nTHE CITY IS ALIVE\nPeople stroll the towpath, chat under the arches, wait for the tram and stop to photograph your work. Trains, narrowboats, trams and the motorway overhead keep Birmingham moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of Birmingham red brick, blue engineering brick, motorway concrete and steel roller shutters. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Birmingham. Bomb the railway arches of Digbeth, the canal wharf at Gas Street Basin at blue hour, the giant piers under Spaghetti Junction in the rain and a Jewellery Quarter workshop yard at golden hour. Four real Birmingham places, alive with people."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitibirmingham/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/graffitibirmingham/", "website_url": "https://citiview-games.pages.dev/graffitibirmingham/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1287905197748786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830576_1744529346838382_2870935752552348731_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSBKwtJW03MQ7kNvwEVTvCe&_nc_oc=Adri2rHahjkCkEi_4_BbNy-rWWWHYkYoSRy0TMRAHw3A1fx6BLRSoGjpBM0fiWibvj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgjHD1f2svlIT99ovcT6Mi9ulUp7l6H_Zt-SGWTcsXww&oe=6AFB3C1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti Birmingham", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1791915720, 
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_2814147388933948_2169423957123160996_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTgRN9ff9FMQ7kNvwEPqcbk&_nc_oc=Ado8eY-QT62jyh7GEX5eyz2LjvuC_HOZaR7B5npZ8YNHz2LMGCCkXIaxdQbOg7WeN1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAc93GhvwAZFttZPhWtft_QBxHelcnHo0H3MwlOllEmA&oe=6AB92E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_Cover.png", "id": "26523951153906166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_26523951157239499_5115594874941569709_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIDPfi6TqZsQ7kNvwE2Vtrk&_nc_oc=Adq8L7GW9hstUa_oQbQjyJk9GrXLfKaDzaBnzsLP9e3fU1OHSplnLTgiXk0MJFVGLeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_Ddr42hoa-GXsmx6_msmnaYNFpRTYOiX366osl3HV-Q&oe=6AB930C9"}, "display_name": "TimeFall: Rift Hunters", "keywords": ["mixed", "reality", "hidden", "travel", "collect"], "long_description": "Step into a mixed reality adventure where time is breaking apart inside your real-world space.\n\nExplore fragments of lost eras, uncover hidden artifacts, and repair unstable timelines as history spills into your room. Each session brings new objects to discover, collections to complete, stars to earn, and anomalies to fix. \n\nBuild your own Time Museum and fill it with treasures recovered from across the ages. Ancient relics, futuristic devices, mysterious crystals, and forgotten objects all become part of your growing collection.\n\nThe adventure continues beyond solo play. Visit the social room to meet other players, compare progress, collect stars together, and take part in special events like Crystal Rush. Climb the leaderboards, unlock achievements, and compete for rewards as the world of TimeFall expands.\n\nBlending hidden-object discovery, collection progression, social events, and mixed reality immersion, TimeFall transforms your space into a living portal through time.\n\nFeatures:\n\n- Explore time-broken scenes in mixed reality\n- Find hidden objects and recover rare artifacts\n- Repair anomalies and restore unstable timelines\n- Build and grow your personal Time Museum\n- Complete themed collections from different eras\n- Visit the social room and interact with other players\n- Collect stars in social events\n- Compete on leaderboards\n- Take part in Crystal Rush\n- Unlock achievements and earn rewards\n- Progress through an expanding Early Access journey\n", "short_description": "Turn your real room into a mixed reality time-travel adventure. Explore lost eras, find hidden artifacts, repair time anomalies, and build your own Time Museum. Play solo or join friends in social events to collect stars, compete for rewards, and unlock new historical worlds. Free-to-play, evolving through Early Access with new eras, challenges, and discoveries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mess-works.com/privacy-policy", "developer_terms_of_service_url": "https://mess-works.com/terms-of-use", "publisher_name": "Messworks", "support_website_url": null, "website_url": "https://mess-works.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28028540786816323"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sconte
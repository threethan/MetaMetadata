c_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbYmlkjhf_wQ7kNvwHemZC7&_nc_oc=AdqnqTrFttshYqBhUTFBoCMQmnPABjktouSYcqzZHzHnAmpH8_qEus9L6sY3TNINTPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp6H7tbvDngg485gVZL6zgU2vafRXuwuXRcaprKYl2UA&oe=69CE7BD5"}, {"file_name": "preScreens2.png", "id": "744854757965853", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507828918_744854761299186_7654076904204056432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aZAyo2w-ycQ7kNvwGXq3rN&_nc_oc=AdqLxSUu-or4Qi16T_Tbj3d5iKPyiMHpXI2dn8lLfv4Q3QH9sfQK4g9Cvv6IWXMlksw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxoRBTvsA2E7ni3E12qV2ilDM_oT-DSzThQ17K-0CeOg&oe=69CE54B6"}, {"file_name": "preScreens1.png", "id": "1886822962072059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823854_1886822965405392_629895779391567465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei6qhRCdMwsQ7kNvwHW8IjY&_nc_oc=AdoNDl4WYN7RP66kuWCLYkwrMClXD4jyka-9HoQcU6B4KI5slY4QAYc5Cpu7YYblpGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjUZeanRpFBG_cNLY0e9bleVwqTpKWV2HTE4ynPylWzw&oe=69CE5D0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Animal Guys", "keywords": ["runner", "friends", "gorilla", "company", "stumble"], "long_description": "\ud83d\udd25\ud83d\udd25 **YOU BESTIE, READY OR WHAT?!** \ud83d\udd25\ud83d\udd25\n\n\n\n\ud83d\udca1\ud83d\udca5 **Sabotage your rivals with power-ups!** \ud83d\udd2b\ud83e\udd3c\n\nKnock them off the track in style. Freeze your opponents, launch them down slides, push them far, far away! Swing those arms and clear the path with wild weapons.\n\n\n\n**Make alliances \u2014 or go solo** \ud83c\udfc3\n\nTeam up \u2014 or don\u2019t \u2014 but always play smart. Only the 5 fastest (and smartest) will reach the top of the leaderboard.\n\n\n\n**Customize your avatar to show you\u2019re unstoppable**  \ud83e\udd81\ud83c\udfc1\ud83e\udd47\n\nUnleash your wild side in this fast-paced, physics-based multiplayer game where up to 30 players compete in real time.\n\n\n\n\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\uddb8\u200d\u2640\ufe0f  **Swing, climb, and launch yourself using arm-powered locomotion**\n\nPush off walls, grab ledges, and race through chaotic obstacle courses as fast as you can.\n\n\n\n\u26a0\ufe0f **But there's a twist:**\n\nEach round is an elimination round. Beat the timer or you're out.\n\nAs the game progresses, the obstacles get harder \u2014 testing your speed, agility, and strategy.\n\n\n\n\ud83d\udd25\ud83d\udd25 **Only the real beasties survive. You in?** \ud83d\udd25\ud83d\udd25\n", "short_description": "**PUSH, SHOVE, AND RACE TO THE TOP!**\n\nSmash through chaos, sabotage your rivals, and knock them off the track in style.\nTeam up \u2014 or go solo \u2014 swing your arms and blast through with wild weapons.\nCustomize your avatar and unleash your fiercest self.\n30 enter. Only 5 reach glory.\n\n**You beastie, ready or what?!**\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "245
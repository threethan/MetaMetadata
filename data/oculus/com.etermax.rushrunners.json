n.com&_nc_ss=8&oh=00_AfyvHWJ8WVsPcv3fTwAz9jjYnsDKh555gWy537BYr4nO3w&oe=69BD3607"}, {"file_name": "barbarians_6.png", "id": "914702717967498", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821178_914702721300831_2099597177216149039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcOk8kVfBlAQ7kNvwGIiayd&_nc_oc=AdnnLS5XG1wYkNkHCN9fyRpqzgogFvZFwnp5wIglEU5I-CgSiOiiRYON_B-XlFYt19U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy580I8JwAVh7MxP2j2gOMClcaM03DB-8Zaft-9mKqq6A&oe=69BD34E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AG_2560x1440_DragonV3.png", "id": "1626088662017657", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300897_1626088665350990_5509966284567400807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Z8f681mzsQ7kNvwGtjHbd&_nc_oc=AdkLl4oGIeNtc5mOdJCVjqRdPI02lpQquKkrxiDg6uly3SlgLpaoJTpx8rdO_SS6TqM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwR0_bK_j27FEeBgbia3iIACu5y-WnLGFdLcuAGwvgiYg&oe=69BD3A19"}, "display_name": "Animal Guys", "keywords": ["gorilla", "explore", "pets", "dragon", "viking"], "long_description": "                                                                                                                                                                      \n#  Enter the age of Savage Evolution\n\n{25773951658933972}\n\n The world of Animal Guys just got wilder. Transform into **primal new skins** \u2014 **Cavemen and Monkeys** \u2014 and unleash your untamed side as you charge through dangerous landscapes, cause hilarious chaos with friends, and explore like never before.\n\n{2359547311189609}\n\nJourney across the lush **Valley** \ud83c\udf3f, push your survival instincts on the frozen** Ice Mountain** \u2744\ufe0f, and brave the molten dangers of the **Volcano** \ud83c\udf0b. Each world grows more intense as you advance, rewarding bold explorers who dare to go further.\n\nYou won\u2019t face the wild alone. Team up with **loyal Wolves \ud83d\udc3a, powerful Bears \ud83d\udc3b, fierce Tigers \ud83d\udc2f, and legendary Dragons \ud83d\udc09**. Wander together, level up your companions, and create unforgettable moments as you run, clash, and laugh your way through unpredictable encounters.\n\n{1591983862037956}\n\nWhether you\u2019re racing across terrain, stirring up multiplayer mayhem, or forging your own primal legend, **Savage Evolution brings a louder, funnier, and more chaotic energy to every adventure.**\n\nThe wild is calling \u2014 gather your crew, embrace the chaos, and evolve.\n\n\n", "short_description": "Go primal in the Savage Evolution update \u2014 become a Caveman or Monkey, conquer dangerous worlds, and explore alongside Wolves, Bears, Tigers, and legendary Dragons \ud83d\udc09."}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26923580837228596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307315_786688731171003_5733219749321756081_n.png?stp=dst-png_s360x
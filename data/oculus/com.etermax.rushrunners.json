 "screenshots": [{"file_name": "preScreens4.png", "id": "537310652675616", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827725_537310656008949_442978712644403369_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBMBxbIOLj8Q7kNvwGbigQe&_nc_oc=Adlwojo9bl5n3U50v4hE22b5Ea1blhfW4RNWWaAaQFtLXFRcC1MyZXLLi5XZ5x9Fkz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpsPDNbKzzzRzD1918zI0BHBYFyvwvCyfeb8ViSIGcsQ&oe=69B549E3"}, {"file_name": "preScreens5.png", "id": "1122890959673186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_1122890963006519_3969070105122260874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6uBlMfv7iMQ7kNvwEIs_4g&_nc_oc=AdnomDnBaZrQTDJkAMyMdY8fCnYNlN6UKLJmfpm0Cfkrdm0-41TXd0KzRze4IiDcoRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCOQDbK8jNPSrdxaIQHMagJjQUoclBTFRn0Pbzg7T_rg&oe=69B570D0"}, {"file_name": "preScreens3.png", "id": "1404672933917325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_1404672937250658_5202986209141233429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMgCwXsgZxQQ7kNvwH9CzF6&_nc_oc=AdnNRaLaftn4PWz5LJqsSKgaShaL1pE_CkM5rw8Y8J6mu3g0miB2sFZL88rwMDo10RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTwBoBKOJJZKdtyXT8-cREO8NmILQyDOxGSQ-_Q2a4Jw&oe=69B56F55"}, {"file_name": "preScreens2.png", "id": "744854757965853", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507828918_744854761299186_7654076904204056432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXqjWycYo90Q7kNvwH2xcfw&_nc_oc=Adms4_vMtCk-Z3FaGfSwHnseFHjcwck5xbPteyfUrdDkQU6bO0MsAZ9CoFq3_48oru4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFcbrdPCJEmcuekQydR8LSEI5qlxRY7u0JvaVUT10kGQ&oe=69B54836"}, {"file_name": "preScreens1.png", "id": "1886822962072059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823854_1886822965405392_629895779391567465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adWSvSMdzOQQ7kNvwGUjws9&_nc_oc=AdkZ9oTecR5y9TnvFM0rbzC2HUJ8sWEuYNryiHBQz4n6mQgRoFnNIC64i85cEvbqA6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjcM1hVsdl5yqiQkOa5OBiI3JGOegUrQn6FWSvrOPh0Q&oe=69B5508D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Animal Guys", "keywords": ["runner", "friends", "gorilla", "company", "stumble"], "long_description": "\ud83d\udd25\ud83d\udd25 **YOU BESTIE, READY OR WHAT?!** \ud83d\udd25\ud83d\udd25\n\n\n\n\ud83d\udca1\ud83d\udca5 **Sabotage your rivals with power-ups!** \ud83d\udd2b\ud83e\udd3c\n\nKnock them off the track in style. Freeze your opponents, launch them down slides, push them far, far away! Swing those arms and clear the path with wild weapons.\n\n\n\n**Make alliances \u2014 or go solo** \ud83c\udfc3\n\nTeam up \u2014 or don\u2019t \u2014 but always play smart. Only the 5 fastest (and smartest) will reach the top of the leaderboard.\n\n\n\n**Customize your avatar to show you\u2019re unstoppable**  \ud83e\udd81\ud83c\udfc1\ud83e\udd47\n\nUnleash your wild side in this fast-paced, physics-based multiplayer game where up to 30 players compete in real time.\n\n\n\n\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\uddb8\u200d\u2640\ufe0f  **Swing, climb, and launch yourself using arm-powered locomotion**\n\nPush off walls, grab ledges, and race through chaotic obstacle courses as fast as you can.\n\n\n\n\u26a0\ufe0f **But there's a twist:**\n\nEach round is an elimination round. Beat the timer or you're out.\n\nAs the game progresses, the obstacles get harder \u2014 testing your speed, agility, and strategy.\n\n\n\n\ud83d\udd25\ud83d\udd25 **Only the real beasties survive. You in?** \ud83d\udd25\ud83d\udd25\n", "short_description": "**PUSH, SHOVE, AND RACE TO THE TOP!**\n\nSmash through chaos, sabotage your rivals, and knock them off the track in style.\nTeam up \u2014 or go solo \u2014 swing your arms and blast through with wild weapons.\nCustomize your avatar and unleash your fiercest self.\n30 enter. Only 5 reach glory.\n\n**You beastie, ready or what?!**\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24590974377155932"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "786090473982870"}]}, "baseline_offer": {"id": "786090473982870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755715680, "status": "PUBLISHED", "id": "786090473982870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26856225443964136", "version": "0.25.4"}, "id": "1035260441834969", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24012525575000818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26856225443964136"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035260441834969"}]},
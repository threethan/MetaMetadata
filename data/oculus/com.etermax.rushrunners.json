nc_oc=AdrkJNecCtFdnKvYr73VwUhy5ZJPDVact6KNPim6iJzNgiiAXyphI4tBtnvqnb780Go&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50DrtydiILxcuys3UFY53ScRMtUMqwlyBkqfsMWM_Kxg&oe=69FDF350"}, {"file_name": "preScreens3.png", "id": "1404672933917325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828806_1404672937250658_5202986209141233429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bw98PFXSPoQ7kNvwEgWDUN&_nc_oc=Adq9zLj4EXB5jc-VlhUtdXpBO8CfwRaDYTppVJaxMS1yrwaCKJYMjfrzOwCW3-RbhLY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SM8PEjymfJmdW1irP1sdluWgh6OJU_LZmKanBcPb_Nw&oe=69FDF1D5"}, {"file_name": "preScreens2.png", "id": "744854757965853", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/507828918_744854761299186_7654076904204056432_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B65PlvdrQlEQ7kNvwFY7nU0&_nc_oc=AdqXMzcjf2qL4wgJVLewNd3vkpds9F2eENjUqWRNj7Ui-4pnrKnFFQTydVcIyQCgKe4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af485wUU-8qj8o5nsE8DOpnQc_5_MXE-QNxawWv3CX4KOw&oe=69FE02F6"}, {"file_name": "preScreens1.png", "id": "1886822962072059", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507823854_1886822965405392_629895779391567465_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irwB4YaZEvYQ7kNvwEdkhO4&_nc_oc=AdqT6KS5JWDSK9QPyVR-BAIFVUr4XoGTjrNhysZNH-v0jyPr3616-S_tVHwAQZkHi7U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75o39N6rhaF3hPbA5W5N5BPzXdnGFltKKxVUEGdbYmOQ&oe=69FDD30D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Animal Guys", "keywords": ["runner", "friends", "gorilla", "company", "stumble"], "long_description": "\ud83d\udd25\ud83d\udd25 **YOU BESTIE, READY OR WHAT?!** \ud83d\udd25\ud83d\udd25\n\n\n\n\ud83d\udca1\ud83d\udca5 **Sabotage your rivals with power-ups!** \ud83d\udd2b\ud83e\udd3c\n\nKnock them off the track in style. Freeze your opponents, launch them down slides, push them far, far away! Swing those arms and clear the path with wild weapons.\n\n\n\n**Make alliances \u2014 or go solo** \ud83c\udfc3\n\nTeam up \u2014 or don\u2019t \u2014 but always play smart. Only the 5 fastest (and smartest) will reach the top of the leaderboard.\n\n\n\n**Customize your avatar to show you\u2019re unstoppable**  \ud83e\udd81\ud83c\udfc1\ud83e\udd47\n\nUnleash your wild side in this fast-paced, physics-based multiplayer game where up to 30 players compete in real time.\n\n\n\n\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\uddb8\u200d\u2640\ufe0f  **Swing, climb, and launch yourself using arm-powered locomotion**\n\nPush off walls, grab ledges, and race through chaotic obstacle courses as fast as you can.\n\n\n\n\u26a0\ufe0f **But there's a twist:**\n\nEach round is an elimination round. Beat the timer or you're out.\n\nAs the game progresses, the obstacles get harder \u2014 testing your speed, agility, and strategy.\n\n\n\n\ud83d\udd25\ud83d\udd25 **Only the real beasties survive. You in?** \ud83d\udd25\ud83d\udd25\n", "short_description": "**PUSH, SHOVE, AND RACE TO THE TOP!**\n\nSmash through chaos, sabotage your rivals, and knock them off the track in style.\nTeam up \u2014 or go solo \u2014 swing your arms and blast through with wild weapons.\nCustomize your avatar and unleash your fiercest self.\n30 enter. Only 5 reach glory.\n\n**You beastie, ready or what?!**\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
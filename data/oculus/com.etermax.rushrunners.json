s=8&oh=00_Afx-V3JNuhwfQkEdCmggKSqcx3WRsqdKCUL7_oHwJrhR1w&oe=69B3EF4C"}, {"file_name": "barbarians_8.png", "id": "1211884831016038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303672_1211884837682704_843776680751302360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr9cl9a-GYQQ7kNvwHWGBR0&_nc_oc=Admn7Sl9ZWGgkSr9N6I6qbFoPcC6mOl9mjlEi_tFBSrlWiCMBGMFyCxF58v09Ntuqzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnXzZrxacp7wO9A9hHW4x5E5dJX893RJYn348nl3Aepw&oe=69B3FA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AG_2560x1440_NewLogo.png", "id": "2659242307808770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_2659242311142103_523147830571058024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZM1yQRnYiwQ7kNvwGjFf-z&_nc_oc=AdkRiLm4pPXNJcOatBoj25GLnEHnaK1U37E7hSIFmGD4cSIYNBre4DL9-gIZdp1UAyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOQCrpMXZdA2lQ4lA8Im-MCj_hNT_Amadntjcu4Z7EUg&oe=69B3FEF4"}, "display_name": "Animal Guys", "keywords": ["gorilla", "explore", "pets", "dragon", "viking"], "long_description": "                                                                                                                                                                      \n#  Enter the age of Savage Evolution\n\n{25773951658933972}\n\n The world of Animal Guys just got wilder. Transform into **primal new skins** \u2014 **Cavemen and Monkeys** \u2014 and unleash your untamed side as you charge through dangerous landscapes, cause hilarious chaos with friends, and explore like never before.\n\n{2359547311189609}\n\nJourney across the lush **Valley** \ud83c\udf3f, push your survival instincts on the frozen** Ice Mountain** \u2744\ufe0f, and brave the molten dangers of the **Volcano** \ud83c\udf0b. Each world grows more intense as you advance, rewarding bold explorers who dare to go further.\n\nYou won\u2019t face the wild alone. Team up with **loyal Wolves \ud83d\udc3a, powerful Bears \ud83d\udc3b, fierce Tigers \ud83d\udc2f, and legendary Dragons \ud83d\udc09**. Wander together, level up your companions, and create unforgettable moments as you run, clash, and laugh your way through unpredictable encounters.\n\n{1591983862037956}\n\nWhether you\u2019re racing across terrain, stirring up multiplayer mayhem, or forging your own primal legend, **Savage Evolution brings a louder, funnier, and more chaotic energy to every adventure.**\n\nThe wild is calling \u2014 gather your crew, embrace the chaos, and evolve.\n\n\n", "short_description": "Go primal in the Savage Evolution update \u2014 become a Caveman or Monkey, conquer dangerous worlds, and explore alongside Wolves, Bears, Tigers, and legendary Dragons \ud83d\udc09."}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26738177515768930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_2647682145593186_7329195234322471389_n.png?stp=dst-png_s360x360&_nc_cat
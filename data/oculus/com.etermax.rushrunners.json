5Ryx1Qw&oe=6A411194"}, {"file_name": "2.png", "id": "1670955880811834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619485_1670955884145167_4593256903439124927_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03UQ5XcfD98Q7kNvwEIK4z0&_nc_oc=AdojIkrgYnzqLVSbcKoEJ5w61Tans68iZgfgZeDt1PjkjO4IJFuv4lx4-q0yQwpihUo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i_7tzM0Nojocnoq0z-q66foGa9aMT4oDlVnY9caYCRg&oe=6A413695"}, {"file_name": "5.png", "id": "964268966401412", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619704_964268969734745_7746632932196553829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFWsVwXZFgYQ7kNvwFcZglZ&_nc_oc=AdpAAy54UkqAjsxnjAvk5J1EPNVByOJojRGqFZVJQGTGQmB5KcnehlLFAF8bh3DPmR8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k24L_g1YEnCb4j5JH5K8EbIXiBIn6_H9EKym7a-WbFQ&oe=6A4118FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AG_New_2560x1440 (1).png", "id": "4256285161278539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619685_4256285164611872_2027858225920969042_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSnQ78ZB8gwQ7kNvwFIeT1x&_nc_oc=AdriYkMbnEqGIBT4pW-266sAtZ3NqtMyrRLP3bVX1wBS4KKZ9JeJelHvFaC6k-PTgxI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IsTHOb7kZwisNJda73PNS_tNqOnrqEMhGIzLnvwMv5g&oe=6A4146B2"}, "display_name": "Animal Guys", "keywords": ["gorilla", "pets", "dragon", "viking", "medieval"], "long_description": "                                                                                                                                                                          \n                                                                                                                                                                         \n\n{2714159052280259}\n# A new era begins\u2026 and your legend is waiting to be forged \ud83d\udc12\u2694\ufe0f\n\nEnter a vibrant medieval world where every player starts as a **monkey**\u2014and rises through powerful evolutions to become a **Caveman**, a **Viking**, and ultimately a **Knight**. Each step forward unlocks **new identity, new power, and new ways to stand out.**\n\nAt the center of it all is the **Medieval Villa \ud83c\udff0**\u2014a living hub where players gather, prepare, and show off their progress. Customize your house, unlock perks, and build your presence as you climb toward greatness.\n\n# \ud83d\udc3e RAISE YOUR PET ARMY\nCollect Wolves \ud83d\udc3a, Bears \ud83d\udc3b, Tigers \ud83d\udc2f, and Dragons \ud83d\udc09\u2014each one ready to grow alongside you. Strengthen them by exploring three distinct worlds:\n\n\ud83c\udf3f **Valley** \u2013 Begin your journey and gather essential resources  \n\u2744\ufe0f **Ice Mountain** \u2013 Face tougher enemies and harsher conditions  \n\ud83c\udf0b **Volcano** \u2013 Conquer extreme challenges to unlock peak power  \n\nFeed your pets, level them up, and turn them into unstoppable companions.\n\n{1429856902501107}\n\n# \u2694\ufe0f EVOLVE YOUR HERO\nFrom primal beginnings to armored mastery, each evolution transforms how you look, feel, and play. Stand out in the Villa and on the battlefield.\n\nThis isn\u2019t just a race\u2014it\u2019s **your journey of evolution, power, and prestige.**\n\n\ud83d\udc49 Enter the medieval world, grow your army, and rise to legend and don't miss the #wild-talk in our Discord channel >> **https://discord.gg/qaKVMFDnv**\n\n", "short_description": "Step into a living medieval world \ud83c\udff0 and forge your legend from the ground up.\n\n Start as a monkey and evolve into Cavemen, Vikings, and Knights \u2694\ufe0f while building your ultimate pet army \ud83d\udc3a\ud83d\udc3b\ud83d\udc2f\ud83d\udc09. \n\nExplore Valley, Ice Mountain \u2744\ufe0f and Volcano \ud83c\udf0b to level up your companions, then gather in the Villa to show off your progress, unlock perks, and prepare for epic races. Your evolution starts now\u2014ho
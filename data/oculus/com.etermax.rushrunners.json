_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqtrMpl_H8YQ7kNvwEn8CIb&_nc_oc=AdqI4WNavl0g1lMBIvtZaWPZybbSs5qRirOxTFsK52VRx6LeCize_zR3LetoGjygWyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kFOuJFLOQz0e411YJ8XhHd1fvQ4AUviZvAHojy-92Jg&oe=69E37187"}, {"file_name": "barbarians_6.png", "id": "914702717967498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_914702721300831_2099597177216149039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JDt3VgsOUEQ7kNvwFl9kyz&_nc_oc=AdqnfUpdaoAu1fdgcxJNPFYIB2fmhRtaM31MSmx2m91XUd7ZDbyEzspHwQxtZTjsNSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30KDbnnJgqbNxZUDDCIRw6GY4-gSqKM5GNHGK23lBiOA&oe=69E37060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AG_2560x1440_DragonV3.png", "id": "1626088662017657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300897_1626088665350990_5509966284567400807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0qHI3stdfYQ7kNvwG-rwXA&_nc_oc=Adp0mN4PGFAzxHlHymfAVoHC-yDDQBbexe0BvceXsl-ihWbBxOdZhhF15GDDDO_2R88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aqTJ1dWxMlrCAlHNOhUaJ8g7ukL4twZBV9S8BTR-85A&oe=69E37599"}, "display_name": "Animal Guys", "keywords": ["gorilla", "explore", "pets", "dragon", "viking"], "long_description": "                                                                                                                                                                                       \n                                                                                                                                                                                   \n{1211805520763804}\n\n# A new hero enters the wild. \u2694\ufe0f\nStep into the armor of the Knight, a fearless new skin ready to charge into chaos, explore dangerous worlds, and take on every challenge with style.                                                                                                                                                    \n\n{25773951658933972}\n\n#  Enter the age of Savage Evolution\n\n\n\n The world of Animal Guys just got wilder. Transform into **primal new skins** \u2014 **Cavemen and Monkeys** \u2014 and unleash your untamed side as you charge through dangerous landscapes, cause hilarious chaos with friends, and explore like never before.\n\n{2359547311189609}\n\nJourney across the lush **Valley** \ud83c\udf3f, push your survival instincts on the frozen** Ice Mountain** \u2744\ufe0f, and brave the molten dangers of the **Volcano** \ud83c\udf0b. Each world grows more intense as you advance, rewarding bold explorers who dare to go further.\n\nYou won\u2019t face the wild alone. Team up with **loyal Wolves \ud83d\udc3a, powerful Bears \ud83d\udc3b, fierce Tigers \ud83d\udc2f, and legendary Dragons \ud83d\udc09**. Wander together, level up your companions, and create unforgettable moments as you run, clash, and laugh your way through unpredictable encounters.\n\n{1591983862037956}\n\nWhether you\u2019re racing across terrain, stirring up multiplayer mayhem, or forging your own primal legend, **Savage Evolution brings a louder, funnier, and more chaotic energy to every adventure.**\n\nThe wild is calling \u2014 gather your crew, embrace the chaos, and evolve.\n\nAnd don't miss the #wild-talk in our Discord channel >> **https://discord.com/channels/1014620047827804281/1386750138390941776**\n\n", "short_description": "Go primal in the Savage Evolution update \u2014 become a Caveman or Monkey, conquer dangerous worlds, and explore alongside Wolves, Bears, Tigers, and legendary Dragons \ud83d\udc09."}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "com
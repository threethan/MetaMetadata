png", "id": "1233527158770913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302770_1233527162104246_876943794141386533_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57KFOoCJ2IYQ7kNvwGZnoNI&_nc_oc=AdpBsinJWeeBm3l9NJt0pbswQuvUQjqyblLsDD2bFgozgJV1Q9suygzwVsNKpPEvUFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpPsy1CJH7TOtiRCQKzXFF2fSujMZMdYPCjgPMXffv4A&oe=6AA01D2F"}]}, "id": "1625708851809439", "locale": "en_US", "screenshots": [{"file_name": "Screenshot #3.png", "id": "3118501148321416", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304019_3118501151654749_3178351825681840290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsLO8JQqboEQ7kNvwFD92QD&_nc_oc=AdpAChMX0m709p299KOXaD4tbGYnKipapzufZ3oHJB1Z7uX19yYNXSdkncF694cgbOM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW3vSpJDS8Bja7WbvzTjUXwxqZm5_n_fQyPmFIjRL_uA&oe=6A9FFE37"}, {"file_name": "Screenshot #4.png", "id": "948722331375503", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304131_948722334708836_7403193376756683138_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VyoaX-sBVEQ7kNvwENllxE&_nc_oc=Adpp05OCqplw547Zze6hMjAuKHy1HKzcxFat-JXqYinR9SEmwuHKJfn4rGEPMKygVDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbxirgmbIzc-YkU2bZqSXH7oGNxhnFl5N8sS2TBYDJug&oe=6A9FFFC3"}, {"file_name": "Screenshot #1.png", "id": "1974534969855439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308103_1974534973188772_7249116196791979189_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBAaduD68N4Q7kNvwEk5CaR&_nc_oc=AdoR6rTo99sQQ8FVXBFvesvCYSEgl0CjrGAV6DQPNOBJs_8z0Ny5sBoWoElzO2z6Zko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoOjsgdo79FKMngeUK-PCBlgf1lkFvPw-1DA_qTadNZg&oe=6AA02B71"}, {"file_name": "Screenshot #2.png", "id": "1824456481558648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821989_1824456484891981_635331845205401707_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTiC8eIwUqAQ7kNvwHoZ_Yz&_nc_oc=AdrZZi9YwbukBvlVDBHxYjsEDWVKDXAe0fAubz6lIZ3paS8U9pupcsJ1gqA7PCrHyWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5ZqHZyqbhMsbtflgHTszGF7PkvKBqJph_fRYVFXyfKg&oe=6A9FFCBD"}, {"file_name": "Screenshot #5.png", "id": "935373822573682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307602_935373825907015_5927202056535961384_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBQYY6Jisw0Q7kNvwHFKyVW&_nc_oc=Adp_D1ekJAKRE4WzRQvcZQGe1unszr7-F1hHthBsIGLHDbddBvpe-mz2k7HOdaKtdtg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUInWrDdTA50IzL8_kjPN3yZcxh_AaclppqjMykhhQQA&oe=6AA015DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nostalgia Swingers", "keywords": ["Tag", "Tagging", "Swingers", "Taggers", "Nostalgia"], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.\n\nAt the core of the experience is a custom-designed parkour map built to challenge players of all skill levels. Whether you're a beginner learning the basics of movement or an experienced player looking to perfect advanced techniques, the map offers a wide variety of obstacles and paths to explore. From precise jumps to complex traversal routes, each section is designed to test your timing, coordination, and creativity. The environment encourages experimentation, allowing players to discover new ways to move and optimize their runs.\n\nBeyond the gameplay itself, our app also includes a cosmetic system that allows players to personalize their in-game appearance. These cosmetics give players the freedom to express their style and stand out while playing. Whether you prefer a clean and simple look or something bold and unique, there are options to match your personality. Customization adds an extra layer of enjoyment, making your experience feel more personal and engaging.\n", "short_description": "Our app uses Gorilla Tag\u2013style locomotion to create a fun and immersive experience centered around movement and creativity. Players can explore a custom-built parkour map designed to challenge their agility, timing, and skill. The unique locomotion system allows for fluid climbing, jumping, and traversal, making every movement feel engaging and rewarding. In addition to gameplay, the app features a variety of cosmetics that let players customize their appearance and stand out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://html.cafe/x43ed6e14#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "fate", "support_website_url": null, "website_url": "https://html.cafe/x43ed6e14#", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26643402938622439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25
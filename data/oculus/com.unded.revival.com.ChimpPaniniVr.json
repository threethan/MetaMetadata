CnXmu3ZDIesaClwfLk5sItIObWe3TV0R4ZFT-O5O4L27U93xP6-g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInjYlqShDt-B2ftEDe18Dmlr2prD4JRWrBQqzronvexw&oe=6AAD5AC4"}, {"file_name": "SampleScene_Custom..._26.07.2026_14-40-50.png", "id": "1517611740141096", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299922_1517611743474429_1532089928475788624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I0Bdn4nN4AQ7kNvwFWQDBq&_nc_oc=Ado2pUK_EgcB0O1g5LfrZ7xkRRV7T7ClyegiNT_07OkK-aUsvevGLFVmAt4i7bRBBDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn668RqEarIrwMgzmRPYUgcgcGtSBCEaYWZhdQkie9qA&oe=6AAD3E32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Panini Vr", "keywords": ["Chimp", "chimpaninivr", "vrgame", "chimpvr"], "long_description": "\ud83e\udd6a Welcome to Chimp Panini! \ud83e\udd6a\n\nThink you\u2019ve got the speed to handle the press? Chimp Panini takes the classic VR physics-movement formula and turns up the heat!\n\nJump into lobbies with friends, master crazy momentum leaps, and swing through custom-built maps built for competitive tag and chill hangout sessions alike. We\u2019re constantly updating the game with new cosmetics, feature drops, and map expansions.\n\nWhat to expect:\n\ud83c\udfc3 Fluid Mechanics: Tight, responsive hand-movement physics.\n\n\ud83c\udfa8 Cosmetics & Customization: Show off your style in the city center.\n\n\ud83d\udc12 Community Driven: Regular updates, events, and bug fixes based on community feedback.\n\nGrab your headset, jump in, and don't get toasted!", "short_description": "\ud83e\udd6a Welcome to Chimp Panini! \ud83e\udd6a\n\nThink you\u2019ve got the speed to handle the press? Chimp Panini takes the classic VR physics-movement formula and turns up the heat!\n\nJump into lobbies with friends, master crazy momentum leaps, and swing through custom-built maps built for competitive tag and chill hangout sessions alike. We\u2019re constantly updating the game with new cosmetics, feature drops, and map expansions.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQ16FhqSaHUikP6RuR1achPZtKcNs8fJoxOtbXmNwHQqxXr63Y3Q4HmVE0On8ljMAB2TfPbbFgDp60Z/pub", "developer_terms_of_service_url": null, "publisher_name": "Unded Studios ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vQF502n4riDEVaKRafSAYIL2Q4Aq4O6QVrCzoCn5sYJ-JVjEBdgr1l9srl_Ko4m1VumAD9CSWM-ngB1/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249245594934606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299093_1083379804258062_6016857472509804695_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yVBuW0O3jsQ7kNvwHC9rmI&_nc_oc=Adr3aQajuZegm4nFmuXij5xJrqHsdmwusyV2yVDTV8xjk6VaRvLaQsiYKYMFcT2H5w0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxTh6UWTDmFZuSQzDRVl-gUH5XKV5bEne0eknX1hpnZw&oe=6AAD3E0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Panini Vr", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_
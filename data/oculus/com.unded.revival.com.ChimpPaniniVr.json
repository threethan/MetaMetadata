mA5WO9oPKyePXgyoqVQ37wBRZ3uXEjnOz7XaOAQ7JTynhJglWbbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT2XefDrR807xz7nCWqPnX8iqdckoJ_innNWCm32rPCw&oe=6A9EDA44"}, {"file_name": "SampleScene_Custom..._26.07.2026_14-40-50.png", "id": "1517611740141096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299922_1517611743474429_1532089928475788624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ71I2Btbq0Q7kNvwE4BCLt&_nc_oc=AdqmhbRVICi3w1OT8lK1mloGRvVPcmaty7FJUEB-Zlkorxsx_3F02FoYxqQdEy2fLMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi92dc_63HYbLStqNU1hD9AEzePxlHDEREhPknmTmo7g&oe=6A9EBDB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Panini Vr", "keywords": ["Chimp", "chimpaninivr", "vrgame", "chimpvr"], "long_description": "\ud83e\udd6a Welcome to Chimp Panini! \ud83e\udd6a\n\nThink you\u2019ve got the speed to handle the press? Chimp Panini takes the classic VR physics-movement formula and turns up the heat!\n\nJump into lobbies with friends, master crazy momentum leaps, and swing through custom-built maps built for competitive tag and chill hangout sessions alike. We\u2019re constantly updating the game with new cosmetics, feature drops, and map expansions.\n\nWhat to expect:\n\ud83c\udfc3 Fluid Mechanics: Tight, responsive hand-movement physics.\n\n\ud83c\udfa8 Cosmetics & Customization: Show off your style in the city center.\n\n\ud83d\udc12 Community Driven: Regular updates, events, and bug fixes based on community feedback.\n\nGrab your headset, jump in, and don't get toasted!", "short_description": "\ud83e\udd6a Welcome to Chimp Panini! \ud83e\udd6a\n\nThink you\u2019ve got the speed to handle the press? Chimp Panini takes the classic VR physics-movement formula and turns up the heat!\n\nJump into lobbies with friends, master crazy momentum leaps, and swing through custom-built maps built for competitive tag and chill hangout sessions alike. We\u2019re constantly updatin
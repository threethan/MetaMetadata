ine before it\u2019s too late.\n\nThis is a thrilling VR adventure where every choice counts and survival is your only goal.\n\nCan you escape, or will the infection get you?", "short_description": "Survive a virus-infected village swarming with aggressive zombies. Complete thrilling missions, find the vaccine, and escape before it\u2019s too late in this intense VR zombie experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dead-zone-survivor.blogspot.com/p/dead-zone-survivor-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "mugiwara developper", "support_website_url": null, "website_url": "https://mugiwaradeveloppervr2.blogspot.com/2024/05/welcome-to-mugiwara-studio.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31519249084389165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1682969889326055_4215184086486954274_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcZS1sJjdV8Q7kNvwGCo--t&_nc_oc=Adnk-h9DFmr0ZZjjOdgxLB5v9zowFTb8BlG2NufRWUQi8kngAniXJ9fkKYqEmZlvmjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2aO2CSdenV2KDIscpnii5UipQFvF4Qf9KXH5dP8tFbA&oe=69B16538"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
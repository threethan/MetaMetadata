6121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brlgn2A4srEQ7kNvwFCEmzK&_nc_oc=AdowwCQZVHgLBHXctDAGtdQSmw1Rsl9US1vJydPK7Jaun1V0hElSdBOJAoIHhKQQFa0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZguhf40LAxwPglApeCy_ROPDXbLvmj9Sln2o-vY-7FQ&oe=6AD0FF60"}, {"file_name": "screenshot_2_cosmic_bonus.png", "id": "2889459538075045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623601_2889459541408378_27470634086670177_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56lpyA8tsMYQ7kNvwFZKiZT&_nc_oc=Adqmd9zXyD4Aa3IxvEFU0fo2kFV4B3LzYqC6r8JXVkUHgskAbB0RGYHDvTO9iEr04hI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuh9YJw2UT6qbubo1wNHeTMnwOP4F4_SkLJFl77dxrpw&oe=6AD0D54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kaba-.png", "id": "1017087634269916", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_1017087637603249_7789973402206879076_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78dyCMMGNvEQ7kNvwFAxBmW&_nc_oc=AdpBwXKL8EoAe7EAm4ESnZSPw9Y_olETXa8XzhmwY7eCA1G7ujTZn0pu8mtlf6OukUg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVKoElJm-RG-MnCBis0D_zTtEGLpLDxRXJg2LS7Z4SKw&oe=6AD10581"}, "display_name": "Sock Cactus \u2014 Rhythm Ritual", "keywords": ["rhythm", "shooter", "music", "surrealism", "psychedelic"], "long_description": "A sweet fusion of surrealism, Buddhism, and rhythm shooting.\n\nEnter the zone and relive your life flashing before your eyes \u2014 on a roller coaster!\n\nTo the beat, capture the sock-fruits ripening on cacti with a dual-wielding, healing cyber-mokugyo (wooden fish)!\n\nPeek at fragments of memory hidden inside each sock-fruit \u2014 and revisit the ones you've found in the encyclopedia!\n\nVR trip packed with vaporwave, surrealism, Japanese local culture, and a homage to American Surrealism\u2026", "short_description": "A surreal Buddhist rhythm rail-shooter. To the beat, blast the sock-fruits ripening on cacti with dual-wielding healing cyber-mokugyo, while a roller coaster carries you through your life flashing before your eyes. Vaporwave, surrealism, Japanese local culture, and a homage to American Surrealism \u2014 a strangely addictive VR trip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/meta-quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ChihuahuaGames", "support_website_url": null, "website_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/meta-quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1149358244930747"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1650276099377413"}]}, "baseline_offer": {"id": "1650276099377413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783761840, "status": "PUBLISHED", "id": "1650276099377413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1157309307468974", "version": "1.0.1"}, "id": "1946798912666040", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "114935824159741
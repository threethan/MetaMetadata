ealism, Japanese local culture, and a homage to American Surrealism \u2014 a strangely addictive VR trip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/meta-quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ChihuahuaGames", "support_website_url": null, "website_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/meta-quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1149358244930747"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1650276099377413"}]}, "baseline_offer": {"id": "1650276099377413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783761840, "status": "PUBLISHED", "id": "1650276099377413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1157309307468974", "version": "1.0.1"}, "id": "1946798912666040", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1149358241597414", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1157309307468974"}, "release_status
nE7kV0lViUSXEePzRvRDQg&oe=69C53DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.coverImage.png", "id": "394862783501752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57575348_394862786835085_5600026916114298015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7HsfwkGUQgQ7kNvwFY8w2R&_nc_oc=Adof9sM35OMRZIAjDWU_MNhWU4HZHRvkC1N80opPpNeacO_Oo4MQMVVInMmiecFAG2w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8Owvrz3kSxWMAnarHU06XSHmUazcJizbZD1W6Mdi-nQ&oe=69C5197E"}, "display_name": "ContentsDa Basketball", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It is a cognitive game for cognitive rehabilitation training to help rehabilitate people with cognitive decline and mild cognitive impairment, and is designed to provide two or more cognitive experiences and training in the game. Cognitive basketball game designed to allow people with severe disabilities who have difficulty using controllers to play through hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "con
REG11Rh39y9191o21MlW_Zx3G9WL2S9XhmgI1Th6D-6SZ8K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgmXWpcuWp2MHOOyqGl06rvr0jtxZIZTVo8XysJ0pVJA&oe=6B0DC8FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wyyxc3_eKAQ7kNvwGXBiXq&_nc_oc=AdolSAAWEkutC9rx8b14jYsF0KgC8VeCGd4asZLvD3g6FlCZEuh4EhKCX5DGj5OZ2C0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKdREgQo6EaFKq2bNUDDdnseTaXLRbYHBhlbFhFhGqBw&oe=6B0DA7B4"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "642913854428617"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3477327115817103"}]}, "baseline_offer": {"id": "3477327115817103"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1688400448, "status": "PUBLISHED", "id": "3477327115817103"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28004148539258536", "version": "2026.3.3"}, "id": "1042622476555624", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3934083563358370", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28004148539258536"}, "relea
bpH-HZUXdemgTKQ-3VLbe0aIyuuGB2fP10J87-5wauovZhh9Ee0E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Xan-AgbAk33GzK-CEc10KyolRcpyesD0yl68HsNMCg&oe=6A5A4790"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrhsNovoM6kQ7kNvwGc0P_6&_nc_oc=Adqrtvm-SB3HsozY1WBIwOINx75ugKXzpuJveq1AdFTUj8gMk5ryuvsi2HETFmj-QJM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7qnRdBegRZiTsFFFj3dnIUHAtKu8hzc_e3GQJHwADMA&oe=6A5A3951"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jJjbtj67kwQ7kNvwETMcWO&_nc_oc=AdrdpQtBeNhhWJA_EMCthbcf_VPG5MEj5sebODQdBz5QvGtCEZO06Y20PmUO2OEe-hk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAB5y-yRCPY6VUq9AuW-G1hyrUJsOnlNGpAEFlhjgqng&oe=6A5A421A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiuBXlDyqaoQ7kNvwFiTXo4&_nc_oc=Adol6UziUGNkb0YmLw194XKrvtV0kqcjsCdgZe-s47oviNfmsiPXyaQBYyVa7NO9tKs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJfZFaNAkQa06LNoxUzJLrHCAv_KUmnvRsnsXBpzb33A&oe=6A5A44BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us92SFESB4gQ7kNvwG9-nKk&_nc_oc=AdqxhyNgErvWp3nks0b08mVOrMbNCgYoNKDVyWME4MDkKZQA2fglrA7LUBM_0XjyNuk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1iST3t7Yku1cnD1iA7oI1N-0Z6i9ekev-uAHAgIKKgA&oe=6A5A2374"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_ty
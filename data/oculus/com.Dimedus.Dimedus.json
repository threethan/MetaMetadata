wLPtWsooucW2ytGxAOz-RKHZzJblzSMbQBBzVrYpO8XfljblQR48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7giKaqMih7wpXMnLsBDLbC3vSuOt6TxceVE22HpRTY3w&oe=6A0B2D90"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db-T8t6SpqAQ7kNvwFyvd7O&_nc_oc=Adrf3XwKA74Hsd7xklTDaWp4EVmrO6eOS_oFd49rM3sxnKAxB_uknWHdcDPjInbtd5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PT9A4oqLU1eI5Xj6S5MXLuhcz3OdZjGQg6czNMUXqRw&oe=6A0B1F51"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaf1ZAG4N0cQ7kNvwHBtFem&_nc_oc=Ado01bO0S9IFXSdVNWoomaMoQKkDrrcqfbwZWUgNQ1n1B8FAS_QMP_WmbsQ3iK6Zb4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TDj7t5pSPLo_7UmWLXQKaccO-sU6i6QhyAd1FCvLEKg&oe=6A0B281A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmP3ogbu9QQ7kNvwFQ3BOY&_nc_oc=AdoCH9u5a7BNhQEOjyRsxf5h2CJkYlCyAHBe06ZAHpqa-KZtHgAJP6LvXrnWeFlnDZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gxi7Vx9-aT__qh3YYHgPaE6T9x0cEB1jcneGzwaglRA&oe=6A0B2ABC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wgsjsvTuDgQ7kNvwHv-X0T&_nc_oc=Adrgnuo3McvsqK5ORn0WHHdwu0TZE69gJSKJ8k57z5Gnv4IclAkfafVP4TPIM9OxUqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ExJfXTkBmmFja0O7IwfBT66CVwrglcBnnhAs_JYArEA&oe=6A0B0974"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_ty
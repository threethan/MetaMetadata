_A-cuTZhh_xcGtOxr1Vbhz92dwYlDrJJUMYRPvQ7dreL0FERCPrk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pJNx5pT8aHvVWizhY9hy8lab-P0Inl02mkni_tzc3kw&oe=6A301790"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwcyojlBkIAQ7kNvwFFtX6D&_nc_oc=AdrmC-Ps_9v3SZ84AZbf_m4A84o70CXq4--ZuNk7REwXGUblGwOfO5-y4Oublg8x-AE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JG37wL5plVIzdvhod0JEboThf-r18eXvRerBuka-_GQ&oe=6A300951"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPn02KVupnsQ7kNvwFlWsGX&_nc_oc=Adq-KM2HW4jFxEcsFZwpSbPsccmdarWZnk2fBsPNdvpSrpSEiiNXaS6nLzfag6re8CQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kS-15mgZV_Jzb9hHZU04jUfRNBro9keLS-G3W3uYkKg&oe=6A30121A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA68JFnzGWsQ7kNvwH2hh_u&_nc_oc=AdqdwQ5tcjPlJOv9m58Nr0bIUmeBLObFa_pZAiIWgiKcsgsr4_Mu1b-GNUCtN9j9Bpo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NvVlY4jnx9tofOE2BYc_xU3BS-zJulWYHBhjGdPCByg&oe=6A3014BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QDQDkT3yuQQ7kNvwGDife5&_nc_oc=Adq0DaMGaQwfPtZaeJL2ak2SB2bxUEnHZ8z6YaLjNFqOPbOIvsHoQxePPpLIXm0IfLk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dMzWW4iBJGVosu2ysoIQwlHKLeDtqnbNuPgSQODTDOQ&oe=6A2FF374"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_ty
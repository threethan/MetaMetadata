20f&oh=00_Af5TbQlPob9XyCGUCyDIdUEzXYA_RzneEDPTX5CNRL8QzQ&oe=6A11C510"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59cs7GVY5R4Q7kNvwH0HC8B&_nc_oc=Adrn0cERZPc47uHeb9M0Vdmh0RHE4rYZZBGQ4DSfFBebRk23vOQ0FjVv7oGc8JBWZng&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EuLOmUKc0uyaXnWXnwL8lwW1Xs1BcNHR3p3dlvnSC-w&oe=6A11B6D1"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYutdNgDj8oQ7kNvwHv3fAR&_nc_oc=Adq2r8qXw9pqiw4T8Df9g1dG2RW6ZkJRkwJHh5KwTxqIjxCzP2LQlyg89P5MK9YVGyY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HwcldQhOo6Axz__cWHyBQ1aMTxcini0J35Ma3x0GXBg&oe=6A11BF9A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zDgt4qrea0Q7kNvwFd9kCs&_nc_oc=AdreYHhk9q4-AN36p9DdBoB_tRBQjrF8ITdGSkZGjTBqduHcYMkS4jw-5QkQGfx2Rws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ffLxjLLFM0dRLIfVb99tR7qZuWnjFwOETidq3M-mnZw&oe=6A11C23C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aw2PhkGascQ7kNvwHEHGUP&_nc_oc=AdppqTYfS7W-cSv4T-WGwi8PzHn1as8PgcNa-Il00AfHlBh1XdzGQISv9Ey8dabWGAU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-Lo6rUcniULbBdBACEUo1_J-u_GmYSrefsS-7ClP4w&oe=6A11A0F4"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
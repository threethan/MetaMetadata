m4EHepwk2urY4MaI03VIuBfqZvCiNiFn1Fv26eZ4fdXZ9AVtSRS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLah_tSZ2MZxuM7TLqSJdPVALmY9h1adUTLGhhZ8kP5Q&oe=6AB93390"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65lZcdrJrFAQ7kNvwGME7Pz&_nc_oc=Ado8Wswtd15xbAkmZJPnrkQsLIvgzZgeQsAG78P2vLyRIQ921hIMF9QNmc8cfobb_y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcAKAiFPRg0PjAS5aHBKv7S1FFmq3fTGN780n5E2N_ug&oe=6AB92551"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlmyQtZZho4Q7kNvwGSpMrF&_nc_oc=Adpcz_zqRGryUpErm9wkKOrXJBuDU22BZKxb-a4n3RT_4NFRIswAwVqUpCRKcC0z5xY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITR4gmEhNIoACuJAYnirdIR0cA-uBB9jXmLCYMpKOzXQ&oe=6AB92E1A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6HRtpK6fiAQ7kNvwG9Kp4F&_nc_oc=Adq8Vhq9cAGfAVO1glmiTA9Vvb_j3_rKGV6mQCMLs3V_oUhn4LEE_A9zpsRMsp7saTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX1WaLI11fDugNeERBdhq4ecCZx6LWaIsYQm0q8Y3_Ow&oe=6AB930BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI59j2UXSKQQ7kNvwF6kW0N&_nc_oc=AdossNsfI3jZkhBUO_m8CGxS_xIzbbOJjdhlKAyY9vW2-kwL663adiiFyj_11fNDqfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHGlUR1etw_aJ-5MG6J7vhZhjNNC7hXgSBEzPGagufXg&oe=6AB90F74"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_ty
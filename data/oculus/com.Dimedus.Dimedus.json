vwFp7Pl2&_nc_oc=AdrU0ZAnC-yafcOCnvjAJ4JpUTKVB9R2tfVEGwS2T959-2AF21v22iJsqWUmGHyYLeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW8RnbwqlEDtsbuIyDe8XdyFT64ekmS5sZ7iTvLO93rw&oe=6AFDD5B4"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", 
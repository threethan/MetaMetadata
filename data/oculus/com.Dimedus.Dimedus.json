20f&oh=00_Af-tJeWI1o5xCbl4BzIsLjN6aBshD3jEnAizYDUZ5m9cUA&oe=6A36AF10"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uddpOb6vLSQQ7kNvwGMgaT5&_nc_oc=AdrmQ_Y-0oEQP-SxCLnGAlYeg-bFkTH9ajzraDbWGZkOMOg0okNDvIfbPisOxq7Wg4c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v_PguUqgeGYIEn21EjCSxoxnmuQq5A-eLyGTAjEQCuw&oe=6A36A0D1"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFYb1MJPnjIQ7kNvwHSnOxq&_nc_oc=AdrZOwr3l5bZ18IeBtFPByUWK_wpXu_C7FKmjnDjFOkPvD5bVaqnfa7ZzHeDDlbSRwo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u5aJZ7ZhZoXMokoscdXKJTOxyYPPi-PWwPtCU62SYog&oe=6A36A99A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QrTQlxYKbwQ7kNvwF1RtwF&_nc_oc=AdpATHE6HxGrqmCf2AnTyommuGM-FyAKh3rqYFnHDOv9y1gxKW4bcxRZRJbMHrbAmwk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fhf_XpBuAHkta3l5yeDd11ZSuOFr4j2Qkhs3nEfyBCA&oe=6A36AC3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m66GPthUEFwQ7kNvwE5XY0h&_nc_oc=AdpSViKwTSwItYRF2G6XZC4vSUXnMAHsmyBuxRWGvAPSfXzXY0kp_nTB2PQnjCjrW_g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pdJuAUa48uNUtTJqzvh-uRRwJYCfGTaAFxMKfFVKuHw&oe=6A36C334"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
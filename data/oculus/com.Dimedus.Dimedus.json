0_Af7BB7m_3p6HbVa3FdYOwvablb2OmLwkGPv7lqRah_WCUA&oe=6A09DC10"}, {"file_name": "Rectangle 29.png", "id": "1629447950910999", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db-T8t6SpqAQ7kNvwGzrjFD&_nc_oc=Adrcy1eUGUzhIjeUwaGXOLuo3NaG5vKvHlR5GV5e8JzK1Z2InwP4GTu5iGozUMcCb9g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H09D8R2-qfbayGQhK6OqqvbWqErak6ebjQORURwnRnA&oe=6A09CDD1"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaf1ZAG4N0cQ7kNvwHvsxOI&_nc_oc=AdqcqqeqDDORrya4b9vYEA-Uho7i-EsUiX1UkL0ihZ1KSDjUBSqPwfr2MeijQ2ZYyvU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ywmfBqtJpi49WmLPaORERYGILYYoX-dswde7_JepTTg&oe=6A09D69A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmP3ogbu9QQ7kNvwFLsjVN&_nc_oc=AdqkyGfPfWu8CCJ4ISZDDSxHDnNijGjP1PfEQjN6hCvPvc0sWGkhOzJGHsdrO4Ty9RI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZZibXu7KvrXiqL5IDX74pn2cKEUyR7SgoA6zztEflXA&oe=6A09D93C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wgsjsvTuDgQ7kNvwE9rtdS&_nc_oc=AdqUQVU6M6Kk6jhLhpu-_UhqtH9jywaOGRbgzCTylWYLgLz52kaXAXiYTlWB4hQBsd0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6snfySR_0LLDswDGEj_Taq1k3jFOt9FXX0AEmh-Zu0Cw&oe=6A09B7F4"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOA
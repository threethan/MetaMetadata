/38982640_1629447954244332_815608654992398205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQe_5MC8SLsQ7kNvwGsd-Im&_nc_oc=AdqRcie-Ydm8e9D50aTL6OEscXL7ndLIff_PftG-byW_cS-tpcZmVPCvG59c4N8HKys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3dPMyuSgtAhShRTdGlUwHMwSGNS25Chb-hAI6rvoCWnw&oe=69F0C151"}, {"file_name": "Rectangle 26.png", "id": "584029563771573", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_584029567104906_1664583833852374916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR1xLs_g3x4Q7kNvwGWnHA4&_nc_oc=AdpHr8QtcWSJKKE0HzUMzsDS3F0ZrxSORJ6gOyh_X4h1FA1S-CuUTAnry6gTxnpuNRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3BEsotak2Dwm2dSM9X-69yLmezK7elwjlfJyzmKGJCgg&oe=69F0CA1A"}, {"file_name": "Rectangle 28.png", "id": "8964316793643206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035391_8964316796976539_8355370545949568879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9DSQfp7Do8Q7kNvwHJ0Qk_&_nc_oc=AdqSRrYnot9WALsMYGqTQt1btDKTFRj5f6aX2aoT5IvAYNMEMIp-ZkvR72zDfRrCMRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0eIqqzBdOs9XyOIsMLg6xXHur543Uy9Q64CsExh7RMsA&oe=69F0CCBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rectangle 25.png", "id": "110249335349102", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_110249338682435_458687763337376707_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7-bRJ1mAKgQ7kNvwGOCe74&_nc_oc=AdpisqpKcs7lsY396ljdIYGXIs5Q19FvkoB2I3UHNAMWx4RcBpLeMR76Ay7gWCGh4X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3S6mVWBAZkBZKyxPU6GpJe2BtisVA6q8LuZ8bzKVDydg&oe=69F0AB74"}, "display_name": "DIMEDUS", "keywords": [], "long_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. \n\nThe system features scenarios based on accreditation passports, surgical interventions, and different scenario execution modes such as \"learning\", \"perform\" and \"exam\".  It provides objective assessments with detailed reports and virtual assistants for guidance. \n\nThe platform covers various medical specialties such as\n\n-  Anesthesiology and Resuscitation,\n-  Cardiology,\n-  Emergency,\n-  Endocrinology,\n-  Gastroenterology,\n-  General Medicine,\n-  Hematology,\n-  Nephrology and Urology,\n-  Oncology,\n-  Pediatrics,\n-  Pulmonology,\n-  Rheumatology,\n-  Nursing.", "short_description": "DIMEDUS is a digital platform for distance and classroom learning in the health profession that offers virtual simulations for clinical skills and reasoning development. Users can simulate being a doctor or nurse and carry out tasks such as interviewing patients, physical examination, laboratory tests, making diagnoses, providing emergency care, and performing medical manipulations. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PAKf36NSOCgyIl8oM85w1K3OUiEqMNEl/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dimedus, inc", "support_website_url": null, "website_url": "http://dimedus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
tent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CBhrAawokrym8qMRPbhOv6_0mkMwLt_N7JVOxlITdSA&oe=6A341599"}, {"file_name": "Screenshot1.png", "id": "605237032322053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391986_605237035655386_5455887932129701771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXg1LmWnRdsQ7kNvwEa07yR&_nc_oc=Adpv4gaa1YrS4fZEqbk6LCLZdQJpWCX2cqN2siaw52-Kf4iBaTkSOpK1dNbN-Byznho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZwjEhsg1T07hwYocWRNAXqQ3IWT17xBmOaMrjdbyJBw&oe=6A34016C"}, {"file_name": "Screenshot4.png", "id": "677289298006843", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393511_677289301340176_5138477567484064578_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVP9Y6ZoSVcQ7kNvwEnbfy7&_nc_oc=AdqIYBWefy8hVR6MlLIyYQSPy8v8A-wwDOcG4MbvuSfdaycdxchbi9r2KP4pNYrFJpU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86yAiH_EWr7gomV6NPbqGBcjGgHwrnR_a5K7ETI2cWCQ&oe=6A34058C"}, {"file_name": "Screenshot8.png", "id": "969780188087885", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_969780191421218_930074630064869216_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNmhyzT1axQQ7kNvwEpIF4y&_nc_oc=Adp6lx6PSWlmZE98wTiBxCYmx7qcGygDbhw6yfJj18nbHx-FSmaMpZ25I9vqUucnKW0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hl2UOyEHCCSdX7dLge_EpOe-k4LCK6_nA-JK5Kd2UKA&oe=6A341367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtualSkateCoverArtFinal.png", "id": "1052994420079135", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393984_1052994423412468_5089288617585547634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLSc3-X4Y7MQ7kNvwHrgAiW&_nc_oc=AdrQyfdPqMEAVn30OmnyAkKoDct5eQWsvS8wx_bGL1ZgGtpxoVxX0-YsdkItJzC9PdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QzdIlAGPrrh33r18ukDdDHMaJc2FfqLxbWiCjK2E8rQ&oe=6A341DAC"}, "display_name": "Virtual Skate", "keywords": [], "long_description": "The closest to actual skateboarding you'll get. Virtual Skate is the **newest evolution of skateboarding games**. Skate with friends, customize your skater, grab a camera and film your tricks, or test your skills with challenging obstacle courses.  \n{1000907262138770}\nVirtual Skate let's you control the board in all new dimensions. Each hand controls a foot directly, like hand boarding. Instead of having a 2D axis to control each foot, you now have full **3D control** over your feet. Virtual Skate opens up a whole new world of board control and let's you style your tricks in ways that aren't possible with canned animations. \n{865976518957921}\n{1147787716634396}\nGrab a camera and **actually film your tricks**. The fully interactive replay mode allows you to follow skaters to film lines with ease, zoom in and out, and play back your favorite clips.\n{1172019664456080}\n{688483483507385}\nSkate with up to **3 of your friends** online! Hang out or get some clips with the homies. Join a Quick Skate game to skate and socialize with new people or find your friends via the Sessions browser.\n{616729441203513}\n{616689661191632}\n**Express your style** with a myriad of customization options for both your skater and your board. Make your look stand out just as much as your skating. \n{1163802218723094}\n{2090201441462224}\nLooking to challenge yourself? **Test your skills** on a variety of obstacle courses, get medals for beating time limits, or push yourself to beat your own time record.\n{1142863067484066}\nVirtual Skate puts you on the board and lets you feel every pop, grind, and impact\u2014without the broken bones and rolled ankles.", "short_description": "The closest to actual skateboarding you'll get, without the broken bones and rolled ankles.  Virtual Skate is the newest evolution of skateboarding games.  Your hands control your feet giving you intuitive and next level board control. Skate with friends, customize your skater, grab a camera and film your tricks, 
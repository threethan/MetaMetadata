78344668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307451_911815681678001_9190930118462396640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH7-zJoexagQ7kNvwH9I9CN&_nc_oc=AdreATgCuXla-EEbhPTrafDojPyMizbOw2qpJeR70iQVD4C1thkkA6gcP7tz3MK1yR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70aRWYcbBA5Xs6XzCgQprkmGuFjuTlo5OrCt2zUQzuvA&oe=69FA01A1"}, {"file_name": "Image1.png", "id": "949238521356903", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304131_949238524690236_5356969597924238045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBKgA7CCW3kQ7kNvwE-todp&_nc_oc=Adr7Chy_0YrOpGqPWm86ktSDkKd2Wj83xtIt92VzPU_I_RedVB8HO8flC3GNs812Fa4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YpJYgoSfg-KTGXfm7JfHVXOIJwUKsUTSPF7--ocpSYg&oe=69F9E362"}, {"file_name": "Image2.png", "id": "986541204056207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303679_986541207389540_7587751231883329865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxEqdxgAtOEQ7kNvwHj-53j&_nc_oc=AdoU_tA06zJiB4EMvSiTEdcxy4OipiAam2OilToCnr04Juz14jGpmqK33IIA4DqjjVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A16yHttuA1xmm6ql8pXmRMDr9Tz5fh7uc6kXZtCplwA&oe=69F9E4B8"}, {"file_name": "Image3.png", "id": "2418464305232847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_2418464308566180_5082644557642245643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv1J5ej_MxcQ7kNvwFngB_B&_nc_oc=Adqk4dp3PfoRdA6XMiLGF7OuXs06y8EgfZrn4WZVGaIDYnjzVTSeUXbLA1goSrSwVTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wDb8OzYBMckJrrC4E6UA5EYbpQCueJ2CtAkc1bUx7Vg&oe=69F9EE37"}, {"file_name": "Image5.png", "id": "26572687049088451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_26572687052421784_7567241142969738520_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tG5ImuTm3sQ7kNvwGKZBvv&_nc_oc=Ado2CqsFZ4_70yIa3evOJdBb4IMekLjqelJKYsP8ne_5xC4Ctid51n24Q03Qlmo2S64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X63FJK86Y_BaTKbfMQ6aBQbgvu05BvcWr8lAqQcCx8A&oe=69FA0265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Header Image.png", "id": "1328704592404180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294643_1328704595737513_6930709268195748482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvACp7irbhkQ7kNvwFlw852&_nc_oc=AdpGH_XX1hfv4qFmI7F-J5bs_Z1yytHV-aXI-e6W5x5FVhl1-OFiHvX8fxqsUpwsjCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52-E0E2E95Gqj3QHkb8ScGDB2Fzw0eDZBfuJhdHI5xMA&oe=69F9EC11"}, "display_name": "Virtual Skate", "keywords": ["skaterxl", "skate", "virtualskate", "vrskater", "session"], "long_description": "\n\n\nThe closest to actual skateboarding you'll get. Virtual Skate is the **newest evolution of skateboarding games**. Skate with friends, grab a camera and film your tricks, test your skills with challenging obstacle courses, or customize your skater and skate dozens of community made mod maps powered by mod.io.  {877611711425548}{1000907262138770}{1345106420632034}\nVirtual Skate let's you control the board in all new dimensions. Each hand controls a foot directly, like hand boarding. Instead of having a 2D axis to control each foot, you now have full **3D control** over your feet.  Pump to go faster by throwing your hands down when going up or down ramps.\n\n{1147787716634396}{1981019552447410}\nGrab a camera and **actually film your tricks**. The fully interactive replay mode allows you to follow skaters to film lines with ease, zoom in and out, and play back your favorite clips.\n{688483483507385}{1250228993828091}\nSkate with up to **3 of your friends** online! Hang out or get some clips with the homies. Join a Quick Skate game to skate and socialize with new people or find your friends via the Sessions browser.\n\n{616689661191632}{1922799848586699}**Express your style** with a potentially unlimited customization options with new Gear Mod support. Make your look stand out just as much as your skating. \n\n{2090201441462224}\nLooking to challenge yourself? **Test your skills** on a variety of obstacle courses, get medals for beating time limits, or push yourself to beat your own time record. Or skate dozens of maps with day 1 mod map support powered by mod.io.\n\nVirtual Skate puts you on the board and lets you feel every pop, grind, and impact, without the broken bones and rolled ankles.\n\n\n\n", "short_description": "The closest to actual skateboarding you'll get, without the broken bones and rolled ankles.  Virtual Skate is the newest evolution of skateboarding games.  Your hands control your feet giving you intuitive and next level board control. Skate with friends, customize your skater, grab a camera and film your tricks, or test your skills with challenging obstacle courses. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualskategame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Flip Axis Studios", "support_website_url": null, "website_url": "https://www.virtualskategame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26898487809756194"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
tent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jo_yXnGVusxcV24jVSuQbnvZIkL1RVetrzMGjbS5o9A&oe=69FA1399"}, {"file_name": "Screenshot1.png", "id": "605237032322053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_605237035655386_5455887932129701771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4GkDSXYfrEQ7kNvwE70BDS&_nc_oc=Adp-0lswvINy_Q9PngvRXWuHKGO13d1VL5iyDv2wEYZXw0QFhsl8xhuo1i7nPgu5EZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZZg2AFVLRc3Hw4Wy44LEPfTi_GUB5LtYJbN40HNJfrw&oe=69F9FF6C"}, {"file_name": "Screenshot4.png", "id": "677289298006843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_677289301340176_5138477567484064578_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXwAU62qLAkQ7kNvwHgr8QD&_nc_oc=AdraWy_ZE9MmCPQo_KPqoV9IiiSaYb1TOHu5Ha95kvyIV89paLmOnFAtCHodcbtMV2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R6vDgF8PmSV2EA-GYHcDsVoA5cctkSbMcSpgGh47lYg&oe=69FA038C"}, {"file_name": "Screenshot8.png", "id": "969780188087885", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_969780191421218_930074630064869216_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzfdDLsTSroQ7kNvwHnxkzk&_nc_oc=AdqwZRc3oSm2XqD-X8krvhn05QrHKBDWjq-Z-asE_65XjdMI3J4S4X_5a22L6zoapVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Z755VVOU5qx1fdHRduR0m1o4u1aGr5rXL0mskMJT3A&oe=69FA1167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtualSkateCoverArtFinal.png", "id": "1052994420079135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393984_1052994423412468_5089288617585547634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YtuZlFqogMQ7kNvwFDRI8V&_nc_oc=AdoQvubZAS2JycoUq5tPqWCqRbuUqYzQpyZ_YPwbNLsc2xbx_Xe07dqdg4x-liGjCcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GUkjPfnY1eZ_LAaYis7LXQ6zJDyew5rx3ydWuj8fz1A&oe=69F9E36C"}, "display_name": "Virtual Skate", "keywords": [], "long_description": "The closest to actual skateboarding you'll get. Virtual Skate is the **newest evolution of skateboarding games**. Skate with friends, customize your skater, grab a camera and film your tricks, or test your skills with challenging obstacle courses.  \n{1000907262138770}\nVirtual Skate let's you control the board in all new dimensions. Each hand controls a foot directly, like hand boarding. Instead of having a 2D axis to control each foot, you now have full **3D control** over your feet. Virtual Skate opens up a whole new world of board control and let's you style your tricks in ways that aren't possible with canned animations. \n{865976518957921}\n{1147787716634396}\nGrab a camera and **actually film your tricks**. The fully interactive replay mode allows you to follow skaters to film lines with ease, zoom in and out, and play back your favorite clips.\n{1172019664456080}\n{688483483507385}\nSkate with up to **3 of your friends** online! Hang out or get some clips with the homies. Join a Quick Skate game to skate and socialize with new people or find your friends via the Sessions browser.\n{616729441203513}\n{616689661191632}\n**Express your style** with a myriad of customization options for both your skater and your board. Make your look stand out just as much as your skating. \n{1163802218723094}\n{2090201441462224}\nLooking to challenge yourself? **Test your skills** on a variety of obstacle courses, get medals for beating time limits, or push yourself to beat your own time record.\n{1142863067484066}\nVirtual Skate puts you on the board and lets you feel every pop, grind, and impact\u2014without the broken bones and rolled ankles.", "short_description": "The closest to actual skateboarding you'll get, without the broken bones and rolled ankles.  Virtual Skate is the newest evolution of skateboarding games.  Your hands control your feet giving you intuitive and next level board control. Skate with friends, customize your skater, grab a camera and film your tricks, or test your skills with challenging obstacle courses. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualskategame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Flip Axis Studios", "support_website_url": null, "website_url": "https://www.virtualskategame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9960835807281326"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "805587255937278"}, {"status": "PUBLISHED", "id": "3096367544086323"}, {"status": "PUBLISHED", "id": "1398613671665942"}, {"status": "PUBLISHED", "id": "806653341901635"}, {"status": "PUBLISHED", "id": "1732851794007564"}]}, "baseline_offer": {"id": "1732851794007564"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "805587255937278"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27057947047143602", "version": "0.0.2.5.3.4"}, "id": "1481677395850076", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8978552905509626", "is_concept": false,
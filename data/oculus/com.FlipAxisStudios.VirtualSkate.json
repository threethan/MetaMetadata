__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8978552905509626", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27057947047143602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1481677395850076"}]}, "change_log": null, "created_date": 1775706306, "id": "26900232749581700", "version": "0.0.2.5.3.1", "version_code": 206, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26900227089582266"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8978552905509626", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27057947047143602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1481677395850076"}]}, "change_log": "Version 0.0.2.5.3.0 Patch Notes:\n\n- New Climbing Feature: Use the left and right triggers to climb any surface. Grab a wall or ramp and grab  your board then lift it to enable all sorts of new tricks  like handplants and inverts (note these are still experimental, but they are fun and dynamic tricks that emerged organically from the climbing system so we'll take it haha).\n- New Spring Clothing: Added a bucket hat, opened button up vacation shirt, and baggy pants!\n- New Net Code: Replaced all the networking code to support seamless host migration so you no longer get kicked when the host leaves. It also results in less lag.\n- New Voice Chat: Swapped from Dissonance to Vivox voice chat which offers better voice chat quality with less latency.\n- 6 Player Sessions: Increased the max player count in a session from 4 to 6 players. Note that Quest 2 might struggle with 5 or 6 players on heavy user created maps when in replay mode.\n- Riding Height Slider Added: This will slightly adjust your height when riding the board, can help make the player looks less crouched (or help your feet touch the board if very tall).\n- Kicker Tag Added: The new kicker tag will prevent vert code from sending you back into the ramp, allowing you to keep your momentum when popping even on steep surfaces (for mod map makers).\n- Replay Playback Movement Added: Players can now move and rotate during replay playback so that you aren't stuck in the ground or with the replay hidden in a wall.\n- Fixed Modio Bugs: Upgraded the modio plugin which came with a fix for the \"Waiting\" screen bug. We also fixed the search bar and filters.\n- Fixed Board Pop and Flip Physics: The pop height and physics during flips has been fixed and is now more consistent and flips respond better to controller height. The board no longer gets stuck on coping when flipping in a ramp.\n- Fixed Impact Sound: Landing sound is no longer delayed when landing out of grinds\n- Fixed Coping Grind Bug: Coping grinds had a bug that would make the board move around if there was a ramp or slope below, that's been fixed making them a bit more consistent to control, still a work in progress.\n- Fixed Private Session Button: Private session button is always private now, new sessions you create will remain private until you hit Public.\n- Fixed Grind To Manual Bug: Falling out of a grind directly to a manual works now, even if it's just a few inches.\n- Fixed Impact Bug: Fixed the bug that would stop you in place when falling out of a grind and landing.\n- Fixed Map Names: Map names now get truncated in Session List.", "created_date": 1775682208, "id": "26897567609848214", "version": "0.0.2.5.3.0", "version_code": 205, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26897563629848612"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
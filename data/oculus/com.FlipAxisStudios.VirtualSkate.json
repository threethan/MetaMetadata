78344668", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307451_911815681678001_9190930118462396640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVm9T-AISOcQ7kNvwFZG9Q4&_nc_oc=AdpHaK6WG0f1OCkSNEi3CKLd41FHVKeNoFnCdHn_6MJHO09i2P6VkCN5Dfoh0hcExqU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N_p5AYSLtBBg4kE6EbS0d46okO_-8Fhk4sEMi5kBXwA&oe=6A3403A1"}, {"file_name": "Image1.png", "id": "949238521356903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304131_949238524690236_5356969597924238045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjtQzGKbeF8Q7kNvwHRnGyH&_nc_oc=AdpAZjCYp6XsJ3nDby8YUq0ztuUF0BpVVHJJJl0OfJpmTtWaQ-wW34IAIANMmlrfpJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NZ4BQUBdP7iZC4-tARqRVQNDoYq01sUnhQTvqSff4YQ&oe=6A341DA2"}, {"file_name": "Image2.png", "id": "986541204056207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303679_986541207389540_7587751231883329865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qX3keH0ThsQ7kNvwESU0jd&_nc_oc=AdohoD8C5HfZ3L91LMRng69dyJy0pVtQIkL3EyHDOG9urzDnCZfGG4ML1QzESbb7Y-M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wCe7ZunGWhTdV8Sz77UKe9wED4BDL1x1dQrengA7kMw&oe=6A341EF8"}, {"file_name": "Image3.png", "id": "2418464305232847", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_2418464308566180_5082644557642245643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHiqqbML1S8Q7kNvwEZj6In&_nc_oc=AdrNT3-EnEYOyo5fzKdbUhxQmHtgfHRydgk5GzJsJM4n85bT8Nymhsii6cIwOJit5Ig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tJSYYETh9NQZ2FHxObZspyVt3T2wc9_DUnoUu4Wk1kQ&oe=6A33F037"}, {"file_name": "Image5.png", "id": "26572687049088451", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305194_26572687052421784_7567241142969738520_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RMo6S7b9iYQ7kNvwED-zbK&_nc_oc=AdrZDdPtrkk4awfLL6V6GRZbn3oG03p7QbnJyZuLXeyH5eGacPvLOEoLlh4feBvaKC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MDwbaMXYy_nu8jyIUtJPOEErAJYVZ-z0FFpnzPMImMA&oe=6A340465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Header Image.png", "id": "1328704592404180", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294643_1328704595737513_6930709268195748482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTLiZw15ZJcQ7kNvwFy6YxS&_nc_oc=Adogsa2gezwtqkoMti0Biq53iZHTPyxwFHUYBMFuoqNatKW607qEe3Z-mKRtuH2fjTk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RU77iZ1FQ5x9sqETP43ToqAtKhfE4mpnayZTDeIQp6g&oe=6A33EE11"}, "display_name": "Virtual Skate", "keywords": ["skaterxl", "skate", "virtualskate", "vrskater", "session"], "long_description": "\n\n\nThe closest to actual skateboarding you'll get. Virtual Skate is the **newest evolution of skateboarding games**. Skate with friends, grab a camera and film your tricks, test your skills with challenging obstacle courses, or customize your skater and skate dozens of community made mod maps powered by mod.io.  {877611711425548}{1000907262138770}{1345106420632034}\nVirtual Skate let's you control the board in all new dimensions. Each hand controls a foot directly, like hand boarding. Instead of having a 2D axis to control each foot, you now have full **3D control** over your feet.  Pump to go faster by throwing your hands down when going up or down ramps.\n\n{1147787716634396}{1981019552447410}\nGrab a camera and **actually film your tricks**. The fully interactive replay mode allows you to follow skaters to film lines with ease, zoom in and out, and play back your favorite clips.\n{688483483507385}{1250228993828091}\nSkate with up to **3 of your friends** online! Hang out or get some clips with the homies. Join a Quick Skate game to skate and socialize with new people or find your friends via the Sessions browser.\n\n{616689661191632}{1922799848586699}**Express your style** with a potentially unlimited customization options with new Gear Mod support. Make your look stand out just as much as your skating. \n\n{2090201441462224}\nLooking to challenge yourself? **Test your skills** on a variety of obstacle courses, get medals for beating time limits, or push yourself to beat your own time record. Or skate dozens of maps with day 1 mod map support powered by mod.io.\n\nVirtual Skate puts you on the board and lets you feel every pop, grind, and impact, without the broken bones and rolled ankles.\n\n\n\n", "short_description": "The closest to actual skateboarding you'll get, without the broken bones and rolled ankles.  Virtual Skate is the newest evolution of skateboarding games.  Your hands control your feet giving you intuitive and next level board control. Skate with friends, customize your skater, grab a camera and film your tricks, or test your skills with challenging obstacle courses. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualskategame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Flip Axis Studios", "support_website_url": null, "website_url": "https://www.virtualskategame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26898487809756194"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
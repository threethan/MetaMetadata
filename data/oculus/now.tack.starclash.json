scdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RoIhjNjcpIQ7kNvwETxNpM&_nc_oc=Ado2SOhHIk_DSvt-9T6RRX-ND6s7SeVszBDnHywueDQsXF6x2o1NH8s-6-USHpnW8z8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoSCYKDysU_KEv3iUGncf-qxOa84hZ-GPeCqEkiv3JbA&oe=6AC8EC64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlRhFPMApFcQ7kNvwHz6FMJ&_nc_oc=AdoedGI5_xMEp6MSOBk8EZm04ryly78S1y6Ku-XVke4T3w6O6mDXdWOpLoa8piBBavo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQbWnrg_bMgw4fN6LqvD3qbViIhnV91l57RkUnWxYsLQ&oe=6AC8EA43"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nThis time, the star is you.\n\nThis app includes a free preview experience.\nThe complete experience is available through an optional in-app purchase.\n", "short_description": "Step into the story and become the star.\nIn STARCLASH, you\u2019re not just watching the adventure \u2014 you\u2019re the main character. Sing, perform, and experience your own journey to
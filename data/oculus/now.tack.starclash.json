66789_7872707839625984584_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu1CauuBvkYQ7kNvwEzB5QC&_nc_oc=AdrG6iVIp8-fhN46QH9ICSmaMO6CskjjKjHqIg2v5tugkL2o8d1HUtCObGr8UUWMGQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7rjRIgskmV8gzJI-UrIn0j9CM34KHgupRr4UqxLDAQQ&oe=6B048923"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 12.png", "id": "1079680834608949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1079680837942282_8256587214191992557_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bq8zbS0FYoQ7kNvwGWzAgu&_nc_oc=Ado7fq0R1hfjKn2jVLJ-EWmjwq846-aLNIkFeqQB8-S42CTdr79FvUFr8VGTpZEOv7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqhwQpvXdvU2m_zz4b9h8ie50Mcq2Znws1YL7cuDaefw&oe=6B047427"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgshNf1nR2sQ7kNvwG4u7Nc&_nc_oc=Adoh8pQKKSpHu0LHflJPmMamLg2vsmpGbBv_T9rmoV1FqT79D7mG712DgIV6idOYweU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnpPFrmqmlEGHG_5vKZFqvdbgBkaOWBU-vwGscspMEuA&oe=6B047824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6gL5A-qfrAQ7kNvwHNZyQB&_nc_oc=Adowf3Go5fksDCS678kS-PaE19t-HjXEA1MsMCsM37K9b19Zdu5rTbnf1_KdgQUGFO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68C89tPh-ZuyrWgN_GQb6UNzfnV4D2zPXkQsOb9550Q&oe=6B047603"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nThis time, the star is you.\n\nThis app includes a free preview experience.\nThe complete experience is available through an optional in-app purchase.\n", "short_description": "Step into the story and become the star.\nIn STARCLASH, you\u2019re not just watching the adventure \u2014 you\u2019re the main character. Sing, perform, and experience your own journey to stardom inside an immersive animated world."}]}, "developer_name": "TACK Entertainment", "developer_privacy_policy_url": "https://tack.now/privacy", "developer_terms_of_service_url": "https://tack.now/terms", "publisher_name": "TACK Entertainment", "support_website_url": "https://tack.now/starclash", "website_url": "https://tack.now/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "u
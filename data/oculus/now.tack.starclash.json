9eqqE5LniW1FYI-dv56j7q7NXk7MWZ9oQRxGh0ODE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCWxylb1rj7x0QuT16K5OjGAJLVP7Xk6VqjA2kjlVVxg&oe=6B0868A7"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTuuEb4C2ugQ7kNvwG-YxSC&_nc_oc=AdrI34Lgug6uOw_HnESwuOaI4uA4uRiIYo2-369SuYtazmHso98CNIrVyiPIrF7qbWw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSINTYZtIvdOkTOvLUXHkUPCNb0XANkHlM0Bnf8Rwlvpw&oe=6B086CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M20TW2xyZzEQ7kNvwHee9oJ&_nc_oc=Ado-S3XoemqDl27bK6K9z4QdfYYkwOQjtPL7H-8cigtYqfu-Napk4paIW1gZWa-nMrw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScRx9MBu_QfFIv6CAj9x8LX2c-YNSDERdIA2M-hzN18g&oe=6B086A83"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nT
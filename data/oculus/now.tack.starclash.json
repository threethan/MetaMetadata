y1DiCyu82EOXu9s1vERi0hr1VrHxhIpHmWCLbL_vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo3yyrA8es6smeSLBXm7tDjBDEXXjNfUMU8-SirmBJKg&oe=6B05C5A7"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgshNf1nR2sQ7kNvwGH3Pqw&_nc_oc=Ado2esbEf_mgoarNLVln1k5kxx05TwkBGMRptp3ps2F-4OPqVqc5TSYpaXY7D0gFQ3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdkbN2Y8mva-Z-9IKeWynyNnojZnRYdBPOhcmAHYDJnQ&oe=6B05C9A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6gL5A-qfrAQ7kNvwEcTIXW&_nc_oc=Adru8PdMDHbcjMW4Ik7r0CGiUSrzeplrmozYKXZ3aBpxJBwkdxh1jM5HN6aHBVArYxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWJw-newPaVSZUEW7wjb9x6Ptpsm145UeEbmzqfRtN-Q&oe=6B05C783"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nT
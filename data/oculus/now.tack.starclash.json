scdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry-9mj1SAf0Q7kNvwEINcvF&_nc_oc=Adrp8g0eSy0zISGfJvl9DVdXd5m0DQNE4Ac3r8GvvR3Hs38rpmJBc8WB-2EDtlmlYjk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgbBiR-QUAc_5YV3nLh9P2ebnHeirjD92OO2TPZRiitg&oe=6AA00DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEkPNxNzCVMQ7kNvwF_0bl7&_nc_oc=AdoIyMbkMjzDxoU-CvyVMzrnYBfWi6tF2GyP6KvH60IeooiH_WmAHk_KOmIfcsUVgwQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5QSTUtL9kj74kTrW4QpBwNPajqIiX1zH3W_TKKqj3AA&oe=6AA00BC3"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nThis time, the star is you.\n\nThis app includes a free preview experience.\nThe complete experience is available through an optional in-app purchase.\n", "short_description": "Step into the story and become the star.\nIn STARCLASH, you\u2019re not just watching the adventure \u2014 you\u2019re the main character. Sing, perform, and experience your own journey to
yBWIy009guo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVsJ45XuwMA5i5A9vcNiogZCUs4r8QOkXe8xZjhW_3cg&oe=6AB7C4E7"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBrNJ1xEGhEQ7kNvwFTJ-zz&_nc_oc=Adp1eMIFLNZjURALKcHZr37AnxLvyghoOgABWxr6HDDE7HWvLJ6TWOhz7YNf0CRJ7SM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9qn4u9kHC4FG2SBp-QGmIo9GaQEyl5GtMtFlKtBxGAA&oe=6AB7C8E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H72hNN5YElQQ7kNvwEUPGQK&_nc_oc=AdqZkjAix9_ktCR-n3HcD4rxI-ryH8F09NEitfS790S_xY-DNJq11eMO9IJzY_jkI4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKETjp3P6oBVVKNo6uf1ijKHAZEAS77C7MOA_Jop8IxA&oe=6AB7C6C3"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nThis time, the star is you.\n\nThis app includes a free preview experience.\nThe complete experience is available through an optional in-app purchase.\n", "short_description": "Step into the story and become the star.\nIn STARCLASH, you\u2019re not just watching the adventure \u2014 you\u2019re the main character. Sing, perform, and experience your own journey to stardom inside an immersive animated world."}]}, "developer_name": "TACK Entertainment", "developer_privacy_policy_url": "https://tack.now/privacy", "developer_terms_of_service_url": "https://tack.now/terms", "publisher_name": "TACK Entertainment", "support_website_url": "https://tack.now/starclash", "website_url": "https://tack.now/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1198711473333497"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1582004466840697"}]}, "baseline_offer": {"id": "1582004466840697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788062640, "status": "PUBLISHED", "id": "1582004466840697"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1200645479806763", "version": "1.05"}, "id": "892062923606481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1198
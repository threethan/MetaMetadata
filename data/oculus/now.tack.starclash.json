EZojFdph7i_pdLdrzHkf_yrKCfBnZz0qD61l3vT8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6-Osdbdink2Ref6scbQX_QTIneHDVPBdHJkNliyilsQ&oe=6B0322A7"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJi6a7wSJ_QQ7kNvwGAW1GK&_nc_oc=Adr0sxZ3_qTheamBTTiCMpNTpVMtxa2hYJwLEb5EK5Corgn8cVC5Kikmawg2kOdsaA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShe6SdLu5eeYdSGmK4QOxZYm02PkALUilo2SD-b-zNfw&oe=6B0326A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZRnnd03cj8Q7kNvwGypTPF&_nc_oc=AdoDYIb1DQqIaJB0EawA1ti3QK2Qj6fNredZMFj5lp7duO7nG4FU3kCE4I9bG0n1NM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh6Zx_PlavI_Mnb9IhhmkCMrIilES4p7Er4gEkLByEsw&oe=6B032483"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nT
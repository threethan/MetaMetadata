5XMYvdlimh6E6Xt0hMo0ucx1l0UekW1mF7fhCNZdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRChvLtXFcm9fW_k65LHpwpHwXJhjRW9i135mquemfvag&oe=6B007FA7"}, {"file_name": "\u30a2\u30fc\u30c8\u30db\u3099\u30fc\u30c8\u3099 \u2013 11.png", "id": "1072332555241430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJi6a7wSJ_QQ7kNvwGIB9OP&_nc_oc=Adp_JhFO0ZzsJ5I1832fIn_eTOOKpTLk0LBexLv6yCaUykjY3McJ2xt12pyuxkcGV1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRitC6YWiiUoZqgUKs2D4RJ6HteB8q663X3byH8c6Mj2Q&oe=6B0083A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZRnnd03cj8Q7kNvwECLHio&_nc_oc=AdpOXfxEfMn2dBT6FlGGaY5RKE42co8H019_WbDn40A5X6woXXh_k5-dwu99J6yoUpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWp85QMdvNh7Hs6M0Lr4hecO4caxFjvE0lGtiOnsr_cQ&oe=6B008183"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nT
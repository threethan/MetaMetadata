scdn.com/v/t64.5771-25/499619680_1072332558574763_7885950489880811984_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOOBsf3EOeIQ7kNvwGIBrni&_nc_oc=AdrKkWJaFbhdGXzpN0RqnH8BtUnQMhyOTAvvVPShZmI4Mhsmdd_Q7bDqQAy4QQvZGF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYsoX18LLuvBBJsh9VJQ4hIJOpCTKFnx4dZ2Gj8mf_HQ&oe=6AF0B1A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 \u2013 5.png", "id": "1930541214292834", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_1930541217626167_4325720147036340207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8PGW9OxTkwQ7kNvwE3s_cy&_nc_oc=AdocAFgz9FW5FzBKUTC_2lmqGtXKN9YIx7vW22RpAVmPHfWScdI7VnuY_RQDW-ou4fc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuWzvOXDA0Xn7G0Yn9qC9huQSYoEQvFZhvRplCJM9MiQ&oe=6AF0AF83"}, "display_name": "STARCLASH", "keywords": ["STARCLASH", "TACK", "VR180", "Immersive", "animation"], "long_description": "Step into an animated world where you are the main character.\n\nSTARCLASH is a cinematic immersive VR experience that puts you at the center of your own journey to becoming a star.\n\nInstead of simply watching the story unfold on a screen, you step inside it. Meet colorful characters, experience dramatic moments up close, and feel the music and performances happening all around you as your story moves toward the spotlight.\n\nCreated with high-quality VR180 animation and immersive spatial audio, STARCLASH is designed to feel like stepping inside an animated musical movie.\n\nThis is not about watching someone else become the star.\n\nThis time, the star is you.\n\nThis app includes a free preview experience.\nThe complete experience is available through an optional in-app purchase.\n", "short_description": "Step into the story and become the star.\nIn STARCLASH, you\u2019re not just watching the adventure \u2014 you\u2019re the main character. Sing, perform, and experience your own journey to
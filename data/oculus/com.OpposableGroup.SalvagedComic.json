FgjXD8&_nc_oc=AdrGFwETYvMXB0n9mSyq1D8Y_Kb8zAVs20bScCy_let1C5GsAqMGWB6VdWSZSbhthI8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7v5uwhxudxKveNLhM-njFkkd3joyanA8BGAOWG3uBFw&oe=6A22FB1E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HKUycMPqywQ7kNvwHkGDHR&_nc_oc=AdpXHvnr_mtqYduGYzpVHnRvAgeCUdb03i57nStLnzzuQapEfd2GG1Bk61pN717SSdA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yqe_Bd7GB0tW-vjKK3cKKFPcoPMQn2_uGQrfw03EQnA&oe=6A22E86E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCtn9CEmq-oQ7kNvwEuEiEb&_nc_oc=AdqNCGkgr39gl5uCrWbMtC8iF6JHXmT0m0limqr13yZ-ZGwBkNZAjQ9k1wYi_fzFNEk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UNXMJzsKOz4d-SwzxVjTkB1vU6E_1CaNEqDMReu7BnA&oe=6A22DBC0"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qopHZz83q7YQ7kNvwHGsLwN&_nc_oc=AdrtRJlQNtNu6tKCqMnMCO_dN3gUZteIubFZGzZRbx8yyhv43uNrXqyZZHDQQ4_9XnA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ugy-4tvkD4oH2FBCt-uo20JBdTGNmt1nGi4jlMxIQIA&oe=6A22CE10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8NQGFOqIEYQ7kNvwEq4ZrB&_nc_oc=AdpRDmrie8lk1Yzk9ywchNq5KWv-vQXiXtMW60YUFoJdVMPBsO-0CWljzSFPVY-MUvE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FKsuXwYNTez91HCLcdcZ9zv2pPoudjOMO9UpW0DnzVw&oe=6A22F857"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platf
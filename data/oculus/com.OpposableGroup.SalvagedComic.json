 VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-I0WJH6tp8Q7kNvwFJS-Ui&_nc_oc=AdnSI2_EOV1ejaJNM_92BNfjC4xC_elg6Q_3Ng1l-muF0Lo67u9xJeDdAUE4hK7i_hQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyqIh4FJr4_xvPFENfqDOmPG3HzNn6wBCal556S8kEnw&oe=69AD6A97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform": "ANDROID", "context_category": null, "context_topics":
.png", "id": "734745030612010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139301_1248519021891719_7384092398747385856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXRkPy6UIbAQ7kNvwFYVmi3&_nc_oc=AdrqURfFe9fmqh0XVRLUc5tilcAQMMWENKOCXyR9ZQThN--FtCAp-x8aa521WJydG8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc_VslkMrPX4xxV8aCMl-MMbm1IUYiAQGd9NPQAxs3QA&oe=6AFF259E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLrru5ba2d0Q7kNvwHuvN6d&_nc_oc=Adra6ERhRk7hcXoKop7dsVTnRcpY8WG2rXbkUmv4cs3nq7CMRUsuYVMA1THN0UAkDPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz-8YlSuEfxJHKq1kV06p9QqikWyHS8UP_OK-5uSFqMg&oe=6AFF12EE"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kqqImhg5pMQ7kNvwE3b2MK&_nc_oc=AdqlBvFLAXBTPOdcB0BHkp-HlijC_kPhoM-kGLDVUYU42l9xxBh9Dry6mqep1j7r_B8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR48OX18tlCirKA34-qCjZy1UdKX-J6N_01NmRkDRylUw&oe=6AFF0640"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwLFedaKJqsQ7kNvwHHYJ6V&_nc_oc=Adq9tQjs7eEBtNCHCrcW7_lsMmM64BPghsdmaQ1oYtztEMgUVdlgV6hI7LSMITqkwhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW_xlM1UL_mT171EVx1ogjc18cGrmBJoKar0wsJcLVYQ&oe=6AFF30D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-Hp3SrLhd
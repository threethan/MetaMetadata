Qw&_nc_oc=AdrB-sQVny3uCPcs589ljRBVVpboOUt6yqryfE_WHlDfuNpW-GhdcMQrof8kPntqfdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJUiUuJDRPuozCooNhQGIPLMhzM_zeHRetPGrDk_By3w&oe=6A8997DE"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0ibOp2U4lEQ7kNvwGquNOt&_nc_oc=Adp-PocJJmCiyHvniqTt3zb722UGvJULfpCW8PYAcOjx5JxEJOHeT-khoA32yw9gL-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEReBU7mxI8Uy3qw88M3pfGQvlXdvRYjw5CkJpbIf3DcA&oe=6A89852E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RGD1AtEphoQ7kNvwFlmRhp&_nc_oc=Adp2YIic4PF2p0R_kER0I4D-x61ieCXKQJ9Ws-_1dCmnDo9P32Er_22VcKa2Jstkpik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-9fJ8im9qq-xBpxLQVFfcw-0_P3xxfPKnPlwn6hMvxQ&oe=6A897880"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlKERtn6htgQ7kNvwGsqIAh&_nc_oc=Adq3MxMYodv7LSTXXq5elJ7f219-rtG36WhA76n5RkCBEpxGbKI-WZMLtDeaHDjMNBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZXJSyCgErUpcgrxE56odbf46p5Mce-sJRkO9NDHU0oQ&oe=6A89A310"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vriyOCr-A7MQ7kNvwHiZITM&_nc_oc=AdrvaqJE9-GTTzcULr_3C2FdT2a7f5P9WmFDR0r_2TjG8FqZghLNw7-3xiahvG6sV_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk8mC91LedKT3nfsQIrCLChAyt22I85ZZiT6mMiRDUJQ&oe=6A899517"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform": "A
y3iuLnPtU8xByUmwwu9526REx4l_KpXOd9_-uPSyDlCRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPBBiFloRb7hRWRU4Xcg5uDQpo4IQeXE9r-PRSafGFTA&oe=69B94ADE"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrdmyounOGUQ7kNvwHDxcPp&_nc_oc=AdmXmklpW28RZq10bjiy1wh3FRKraoPCvu1JjBQbY9cgL-Zc34rU937Ak0KExvKExBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxjwswzag8iZohcPKt9lq_X4YHAa46R-spAkp_7EGMCaw&oe=69B9382E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7kE4-CuUQIQ7kNvwH1mgll&_nc_oc=Adk0e-USbw5K7fULklBTTZXagyoktRikdCqF_I7qb4hQu2mgQaa5djlfgB4zWdx0E_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwue-ZoNFyXnM3u3EXrs3k5GHZ0ETq2oY0AEmKltqhGJg&oe=69B963C0"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AO83fwUJI4Q7kNvwFAeHKx&_nc_oc=Adk1cqVz5G1puJ9FbHlrryqlr4Ka2OCKWywqyj4zddGAhBN5L-XJrjVvGnNTuVbKbWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7FcJSrkgseFmv_PoGQVP_mzRpi8K-5sA-r2WlK0hT7g&oe=69B95610"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiKcpDq7ocEQ7kNvwG1z9xL&_nc_oc=AdlUMD7Peoq_s7Yv4QEYvpDsAJNdf8yAmB0jrXKehsZ8EwA5prg1x8kule60S5HkyW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsS0Z89YpJWxnMTS_Qv7GhobnRjUfRn1JPUuOTsgdJ6A&oe=69B94817"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform": "ANDROID", "context_category": null, "context_topics":
.png", "id": "734745030612010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139301_1248519021891719_7384092398747385856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGnahdzogFsQ7kNvwFa2qP1&_nc_oc=Adppc0HVWFoz7t2jti_maxxlRFsFBi4vy9Ayl_akn5smaV5xUm6Zkf59nhStwT6223I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFilRHrbA-2tb75AHAc6aJDIzxrnAe9LKG9e2GMi_qBg&oe=6B01C89E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtqNNls3DCgQ7kNvwGdJPFq&_nc_oc=AdpQdBJWAGomGkEmzLxtLAjAkjcwhD5eqlgSNk86XpwM_JTNE7eEb8M8BSU15sA5xdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3XvPugPxT7T6TolAtpepQbGCXZhBUqZbVpmZq41jb2w&oe=6B01EE2E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBf_QJx6SiQQ7kNvwF7OL2-&_nc_oc=AdrgRPYqJAjdoJ4Qy_cL_Kl6bwnoHA-2LDjGQ3PAAnyU7BJq5fFI9jZXjFQbDydWTOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUohGgckJi3Bv5Sv12vxSvwqpIrWmQcc2qDGsrfDD_rw&oe=6B01E180"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ-abzkGFkcQ7kNvwFZbPQm&_nc_oc=AdqjD_Rsg6oonA_KqTUNAzKhIUai06oIMVkngT5_Rc4qBcYQE7FIX3LeGdU5VEp9YRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqJQfbtL9EUCHe7hfPT2WLHQPLu5ZmpJJx2OYilt48zA&oe=6B01D3D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Qks_QuJBM
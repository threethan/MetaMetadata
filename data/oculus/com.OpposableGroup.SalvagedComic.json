.png", "id": "734745030612010", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139301_1248519021891719_7384092398747385856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwsAtwyQ6YEQ7kNvwE8IgdA&_nc_oc=Adr97h1AYoWWCUb1EhUb_y1Iiq3qOWRnmkuxHG4cYVY4wQBYwzF4IlA0ZPuOpzLJoY8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT1IpjdrNnJkgAA0dSd32Ewj8rPPj57nSzyv-uGPOOCQ&oe=6B08601E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_BBEIhRiXkQ7kNvwHiXXUm&_nc_oc=AdrwmMqZD4t2GTtOrlOu7Ch7vYgZ5A9sTgvWslhL347FnqMLyYu7glyZvcdXAakpfwY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvGtt-1Zp_7XqehQMqRzGHyjFOU_MmA0YBY9472QZ_MQ&oe=6B084D6E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP4ImznhSmIQ7kNvwFUixgJ&_nc_oc=Adpi51-C_HH6nIhMOE1Y7wlSyeq5hT3t4IaZqbE0BZ7BUxCI-Gj6kF7NnKmdz5HK1-4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ALIDzoRdVbDRoTdxC5IuNkUpJyvRo-wGgphsCzkGNw&oe=6B0840C0"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8Ht-kdkf-sQ7kNvwEsqC31&_nc_oc=AdrCqjRPw_2VF0QzD06hwTPVuxA-NjKIsF_AgRqOVFIZDdlOSWKQr5OP9LoWdrercCs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdEiF4xlBqYSMp3jPLG91IRbj_JHdr60Q7Lc2H6fb8Ug&oe=6B086B50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Uhj3xkRc
.png", "id": "734745030612010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139301_1248519021891719_7384092398747385856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQT-U9E6DDAQ7kNvwHcIyxL&_nc_oc=AdpFDEHq1EFee2nVdjfYCxFLrZVqok0hyvoe6_3ok2zDd_CVy1YWMgIfQ4hcpzBmN-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQz1dMSXehLw2PIQJ8DTkI6Z5kUmODR_GoE86LashpKzA&oe=6B0DA61E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw6xtARJkT8Q7kNvwF64oh8&_nc_oc=AdrXtw5sqepJAQYjO9SoHFXfnvZIVWmfxXOXHBSrvliiTlawWiTyxF0t1hGQgPPlSFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXBZwkH7iOm_CXsN-vikKDJSp7rE0EFW7qDcIw3UC5uw&oe=6B0DCBAE"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwSCjPbIVdIQ7kNvwGBPOvV&_nc_oc=AdrahkAKPIunDXREKIwTQh9OWcq5muWjkYNABfLokr3APskgIU8gy2DN0yJ4Zwq5-JU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNEQRTgvObsyWJoygGGP5IzDfDGxA_EvtfwQYO3WePgw&oe=6B0DBF00"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI-nCPE2HUYQ7kNvwHl0bmv&_nc_oc=Adr5V_aMT3zu2eSyNWxTpoOyyrdL1ubIpjK1RDjSeo4BIchZjBZlQAJR4l-brOZCuHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8L76ks4oPlNImRNGiuHd99wn7wvpvpc1bXtua0WQjjw&oe=6B0DB150"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOKaA8yGrU
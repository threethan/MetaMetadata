ed, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cRhjIX3LrwQ7kNvwEoOOP5&_nc_oc=Adm6MzCRf-K-UBPDBoSjt43B-hLWJNxSS-e_Er10s1v41UQB6sbVFmHmMVWo9NN_OhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu5FwgDQvFBhdqBsSRsPj1xn302Gm3-fh2dMmNR82uKxA&oe=699AF597"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1479369600, "lastRevision": {"nodes": [{"id": "1777252812563140", "release_type": "SCHEDULED", "
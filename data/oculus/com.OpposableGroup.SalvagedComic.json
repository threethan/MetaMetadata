ad3-2.oculuscdn.com&oh=00_AfuwTKwd9lemgO-IzZMkR14lDyu9plxz3ySwPuhhn5wbzw&oe=69A2E15E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7yF23--CKUQ7kNvwFPInSx&_nc_oc=AdkbG_W1Q9NAMVm8TityZWfxybX8m1v9sjlSFGCmaQJGD12SvWL8fgTaCbK3Jl8h2Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZuGQwEI8Oj9wplMIJ0IG1RGWdlcz4Fzxc7w-MiSTLrQ&oe=69A2CEAE"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIMDSXxMXlMQ7kNvwGIVbDS&_nc_oc=Adl5_lnt2Zu1T7LAmCA_J0BGDCGwQjmYdy5inTHZphi4T6tSkFkX-56P207iPGUJ1rU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkXP40H792_OiyXZk77rjkP6-LSLqTEvqEQZ5lyvUhcg&oe=69A2FA40"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-2CtU5qB1EQ7kNvwGrWmhd&_nc_oc=Admv0_2JE5Tmrz5uyzs_nhov2BiFxqS-0eVZ3NMozJDaPgwHR_zbgX-YCkI6jJ-YZUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOgMtTDCW01i7Ww181oesVJGM3DUswIByz_-3HqNkdDw&oe=69A2EC90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUxHIVvgeZwQ7kNvwHmN9il&_nc_oc=AdkNAdIuVWud_JaizQoQG_aCqlDf8Lr_w9iJRsMmpHWfOYeY4XEdyXaQLw48IXZY6N8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufUGGcq17lrNTeO5DZV1v-47kCS6ZSept8Tp4zzDE2DA&oe=69A2DE97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1479369600, "lastRevision": {"nodes": [{"id": "1777252812563140", "release_type": "SCHEDULED", "
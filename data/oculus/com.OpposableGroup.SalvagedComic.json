.png", "id": "734745030612010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139301_1248519021891719_7384092398747385856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXRkPy6UIbAQ7kNvwESVBxd&_nc_oc=AdqO3Wtxap6RJm8QCD1ioIhTjgtt67ja0lHMtmIFUKhqfMVWgHhmXOg3zY8U8Jkqk5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD5KlfTwwST4uSKI2kIbLrh9YeOcKKoN__4E6ncy1k1w&oe=6AFDD41E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLrru5ba2d0Q7kNvwEuI57g&_nc_oc=AdrJ5ke0O3csy_EJMpllPvAugITvmgAlHqcF5lmyS5S5ZS8yyLd9ziKJbDXQs2K-zO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9eljNqoDsXsdv00o2yRPH8W2LCz9tZ1Gg7IGK7MYWeg&oe=6AFDC16E"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kqqImhg5pMQ7kNvwEhp0gr&_nc_oc=Adq5hivCVr89dmi3Grw1Wdn_mkd-wUDK5dHg_vAi1lwqq00zZfcvo7u2sRjPQN_ruNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTadXn-Vnro7TA_dXeBSBmVSNqwEiJPodG04OHpkjUevA&oe=6AFDB4C0"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwLFedaKJqsQ7kNvwHthY16&_nc_oc=AdpLcHT8zTW8WjB-gWvehLwA5YMMTNbzsSRk2r9rJOv_AAw8AQOCr54cGZ5iXhY9RnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Vih_POWnJpVr9Kjk26f54MsS9yAwojHYwDOYj8s5ig&oe=6AFDDF50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxKkzWUn6P
xhB2&_nc_oc=Adqh3Dg3bJ1zFnta0apYpe2lnTSZmZQTaJq708GTG03ll_1Q3b7ojHlv87K45DSydEY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqKyA26AyXJJ4EhCoWNX3QvGBqVLvk8nCWRIADg_9rsA&oe=6A8D8C5E"}, {"file_name": "migrated_image.png", "id": "661972447970982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12602340_207780792991463_5992999912306900992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGX5rnXPie0Q7kNvwEaxorf&_nc_oc=AdrmQ6QRxB_ENbY2BSvU1sgWPMP158eMQXwg2R6iEfFdgW87MESoJFLK480HUAj4N0o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6s3AnFHF3F_XhKbLJVj7tasUBNd_6ih0_RhfdOQ-Kcw&oe=6A8D79AE"}, {"file_name": "migrated_image.png", "id": "234753951256820", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386385_332488793788163_2228801015434444800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlpwYuWNuxYQ7kNvwED3oM-&_nc_oc=Adq6arKH73_HKIceyphKShYkNsMU36ZUN3HiF-aqe5KlERnpHz4Kdbpd_-hLgK5nXa4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEav3kNfi-LnS95EbIELPnSEp_yE4gHyXqnS-d5dfG2oQ&oe=6A8D6D00"}, {"file_name": "migrated_image.png", "id": "242123863500047", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12504644_1702852866699470_1078820932065165312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq3Wkftb-qYQ7kNvwFhzuCJ&_nc_oc=Ado1igbhSJO8sCjKHoa9LazX12OMQee9PoINkXHECNqbUE2nUjTHlnxYhWCEE50hKlk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdt7K6O-zyHhd2gA3vA8RSkKpZphHBuhARslbbvDs3Zw&oe=6A8D9790"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salvaged: VR Comic", "keywords": ["Salvaged", "Comic", "Scifi", "Story", "Opposable"], "long_description": "Follow Alex Pieterson, commander of the salvage ship Thaddeus, as she begins a new journey in the pillaged universe of Salvaged. Alex and her crew are tasked with the salvage of a distant space station named Roulette, but there's something about the task and their mysterious destination that doesn't sit well with the captain. Salvaged: VR Comic is a one-of-a-kind audio-driven virtual reality comic based on the world of PC/VR videogame Salvaged, available now on Steam Early Access. No previous knowledge of the game world is needed, as the comic is designed as an introduction to this vast, intricate universe. The free download includes the first chapter of an original story penned by Daniel Hunter-Dowsing and performed by Kate Davies. More free chapters are due to be released soon.", "short_description": "Discover the world of Salvaged in this unique audio-driven virtual reality comic."}]}, "developer_name": null, "developer_privacy_policy_url": "http://opposablevr.com/", "developer_terms_of_service_url": "http://opposablevr.com/", "publisher_name": "Opposable VR", "support_website_url": null, "website_url": "http://salvagedgame.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "321442759925974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138788_1822112381396608_6957349606472548352_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygRJBYKxWmwQ7kNvwEONthS&_nc_oc=AdqV-rFFe01fBkdaRmAloEPru6uPGZtJfUG5lDENxyns1YNz8gJ9AlyulGC-ox3aG9E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2VBnDG_5lZcDErHQW_niGCBAWbnzpghAQ7PPA7lbsBA&oe=6A8D8997"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salvaged: VR Comic", "platform"
7a0a&_nc_ohc=qdYfjShT6f8Q7kNvwH_zwL9&_nc_oc=AdnZCWHOqvWG2HDwhk6PoA7FGHNRSi84Jk_LT60XmbcjIMunEP-YfZsYKCsz_sjwTCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv5X025j9w2zxZueMTw1fNiFxhizY2vjxZt_EQDzmlBNQ&oe=69986FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1602518850165130", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036631_1602518853498463_2570334475078334683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El8hcD1_BqoQ7kNvwHrqtpX&_nc_oc=Adm-66sEnkaGh9083b_YKvs1-bM7bPbbUMlFOgOrT8EGKjoSF7HXug8rq8xs9jLXU_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvinX7RSiOJ-oTHTda_59tx1HXKHNkdAfA8d74xOYQyLg&oe=69984E39"}, "display_name": "Siren Head Horror Bunker VR", "keywords": [], "long_description": "Stuck in a terrible abandoned bunker, an unfathomable and scary beast waits for you, you'll search for items and solve puzzles to escape the horror place, the game lets you choose 3 versions of the monster Siren Head, and every single one of them will show you the horror the creature can cause, there is no way to fight back, all you can do is run and if you're lucky enough, escape.\n\nThe scenery is dark and scary, the immersive VR will let you use your hands to grab and use items to solve puzzles.\n\nUse batteries to keep your flashlight on, after all, darkness is Siren Head's companion.\n\nCourage is the most important thing to face true horror as you advance deeper into the innermost chambers of the Bunker, solving mysteries as you search for the only escape from the place.\n\nDo you have what is necessary to surpass fear and survive the horror of this bunker?", "short_description": "Siren Head Horror Bunker VR is a survival horror game with the sole objective of escaping an old abandoned bunker where the scary monster Siren Head lurks, you must explore, collect items and solve puzzles to survive and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://downgradestudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Downgrade Studios", "support_website_url": null, "website_url": "https://downgradestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "703375757338028"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "723191202286282"}]}, "baseline_offer": {"id": "723191202286282"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657039500, "status": "PUBLISHED", "id": "723191202286282"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5048947775209550", "version": "1.04"}, "id": "375881004404447", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4681119091992422", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5048947775209550"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "375881004404447"}]}, "change_log": null, "created_date": 1659309030, "id": "5048947775209550", "version": "1.04", "version_code": 5, "relea
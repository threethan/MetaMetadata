70108213555493_6988244134206848639_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnpsDdO1iPAQ7kNvwF1y9HY&_nc_oc=Adqkq0p1V2zcqrU7z3K3QLmUfHpPqNMOBbGFmAai0Q5Zbc2VjHizSR9XiITBCFkA15k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL0PmMAFFmZsBveI4CFcjWYqEiucNBm69SuG7N1mbWuw&oe=6AFB49E5"}, {"file_name": "Screenshot04.png", "id": "433275508441025", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974526_433275511774358_2915661441435043165_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V74MveN9EkQ7kNvwHyPwun&_nc_oc=AdpZqJ4pxPU9zbSNVw6iNC-55ys8ZBUR3wUvOUjM7ZmNsYGaUQvXWmunPuXLV5xqcC0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjPL5lJz_kvlsJNet5Mc9sz2EleNTu4pGPeWp4PAWZdQ&oe=6AFB2834"}, {"file_name": "Screenshot05.png", "id": "608855013677518", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_608855017010851_6438121342724099195_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP0mTPwO2YEQ7kNvwGUuW_O&_nc_oc=AdrgQqmg1xyJyHJCYuqxSZhDQq8GERTI2XFGb5JHLKgK2s5t3fh-W6jyxof58eHR-Ok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk7H73qLG1qYpLjwPsmYy-Pnp2FOMplNqYTCG-kS5pdA&oe=6AFB4BA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1602518850165130", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036631_1602518853498463_2570334475078334683_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMpZcIDdSboQ7kNvwHWR-5t&_nc_oc=AdqEuC5YY8ZqaW-gQx4FLBLfEye4DWVfE2WE0ImefX0bnXauNHH7GQxvV5bA8_WeXDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoUbDWVARgb8lfV6yNBKbgyTnsH0w3D8Yswmrif4YPbQ&oe=6AFB29F9"}, "display_name": "Siren Head Horror Bunker VR", "keywords": ["siren", "head", "horror", "fear", "puzzle"], "long_description": "Stuck in a terrible abandoned bunker, an unfathomable and scary beast waits for you, you'll search for items and solve puzzles to escape the horror place, the game lets you choose 3 versions of the monster Siren Head, and every single one of them will show you the horror the creature can cause, there is no way to fight back, all you can do is run and if you're lucky enough, escape.\n\nThe scenery is dark and scary, the immersive VR will let you use your hands to grab and use items to solve puzzles.\n\nUse batteries to keep your flashlight on, after all, darkness is Siren Head's companion.\n\nCourage is the most important thing to face true horror as you advance deeper into the innermost chambers of the Bunker, solving mysteries as you search for the only escape from the place.\n\nDo you have what is necessary to surpass fear and survive the horror of this bunker?", "short_description": "Siren Head Horror Bunker VR is a survival horror game with the sole objective of escaping an old abandoned bunker where the scary monster Siren Head lurks, you must explore, collect items and solve puzzles to survive and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://creepypixelstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Creepy Pixel Studio", "support_website_url": null, "website_url": "https://creepypixelstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking
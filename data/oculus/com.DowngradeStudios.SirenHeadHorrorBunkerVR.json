70108213555493_6988244134206848639_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5o_WKKFinQQ7kNvwEgLB-e&_nc_oc=AdrIODY6oZVQBm-o98AFafeMmSp51iLm0wDwjmgBeICxaKQH_yoJE7gmtrCU5r4noFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrkGVX5F_6AJ1rpORT2NfB8Zh5tGhWvZZTtBP2LWXRfA&oe=6B0C6D65"}, {"file_name": "Screenshot04.png", "id": "433275508441025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_433275511774358_2915661441435043165_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsGrYteWVlkQ7kNvwFWH1ge&_nc_oc=AdpuA0LMEOFt0RK51cu1wosRdgel1TwJkNzwlO-2QDb0G9CX6txIZbOYlFBvpelU61k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrdN4s6KRU6VnV2m3gR_DCb5UjKDrU1rvgkyYGiZReWw&oe=6B0C83F4"}, {"file_name": "Screenshot05.png", "id": "608855013677518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_608855017010851_6438121342724099195_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQSeZaexvuQQ7kNvwF3r9Gn&_nc_oc=AdqG4JfNCa4BAXPI__2gr3aFJ-AQEL2kqs-VAU8sRYYle6oIxbPiBvfcB2QyUYUjijk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQutCTPDcY5PiSo7LToLbZXpaY0JEoi39h5KWvqRCceIw&oe=6B0C6F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1602518850165130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036631_1602518853498463_2570334475078334683_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_kcbMbsYloQ7kNvwFYSOJO&_nc_oc=AdqacAKzKPOxDqsF752BR1WQAibcynkgL6k0UcE_mGof78ckSsfONfLLW4HGul3Ej5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5X4o-LgWvl0EawamFVYmYRyBqMFbyFfMEp3i3j1BHxQ&oe=6B0C4D79"}, "display_name": "Siren Head Horror Bunker VR", "keywords": ["siren", "head", "horror", "fear", "puzzle"], "long_description": "Stuck in a terrible abandoned bunker, an unfathomable and scary beast waits for you, you'll search for items and solve puzzles to escape the horror place, the game lets you choose 3 versions of the monster Siren Head, and every single one of them will show you the horror the creature can cause, there is no way to fight back, all you can do is run and if you're lucky enough, escape.\n\nThe scenery is dark and scary, the immersive VR will let you use your hands to grab and use items to solve puzzles.\n\nUse batteries to keep your flashlight on, after all, darkness is Siren Head's companion.\n\nCourage is the most important thing to face true horror as you advance deeper into the innermost chambers of the Bunker, solving mysteries as you search for the only escape from the place.\n\nDo you have what is necessary to surpass fear and survive the horror of this bunker?", "short_description": "Siren Head Horror Bunker VR is a survival horror game with the sole objective of escaping an old abandoned bunker where the scary monster Siren Head lurks, you must explore, collect items and solve puzzles to survive and escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://creepypixelstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Creepy Pixel Studio", "support_website_url": null, "website_url": "https://creepypixelstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8pFw9GNM9IQ7kNvwGY3cGi&_nc_oc=AdojS0R73uQBss4K-4jgU963UIszq_5BpZofiamQT_pynKvH3U4AVsRRHrfLobWmB3E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xSi4XRhfZfes-7wDMSPS1B3PzsCPTupWNmQrmq0T9Bg&oe=69F61A75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs0Ju7CjjDAQ7kNvwEAhkzc&_nc_oc=AdoVT1kpuHx5wx-JRQYvdJWjFIc7i_cMUBSmLhSjBa-rVsodWGCnj4D_1LWleVuG6rE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_1lz60ZwmMbfBlJ7EP_Z2SxvFfZ_ehjH4DXwhuHUvoQ&oe=69F602A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hin76zXkLBQQ7kNvwEAJAku&_nc_oc=Adra9piF4sOO6qekVbCqvZ2lvz6lL8YH17nNq0G8g9LgM17EgWtL9fxmeEM71WGQaqE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iRXEGrcQdPeQiVOvkhoxpG0Q-QBsMjfJHf4gbAbO0aQ&oe=69F5F71E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ff8zkUP0IQ7kNvwESTRZP&_nc_oc=AdoA8fnII2b7xEyO9IDi-Jitt9WfzpxHOuLOVF_zKXvLwf_MS4n8xS0KGV6NGQh9NSg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vDID8Zxz8Aj3yPFd62nSzhfLNOXssoOsmjyxzmu1w-w&oe=69F60D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Oaf7kCNrf8Q7kNvwHihPo3&_nc_oc=Ado_6Fz-1yvwF6a1NKKgk_O9lwITyIVOwaa4EA791sSik1bydOsdf80nkQPrKTh9_d4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pMYzhUnd2MxVFVjgmzKG6tpJHupmy8PQsXniDJmP_Xg&oe=69F60B98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
1-25/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-CzTq9psmcQ7kNvwEZzAUY&_nc_oc=AdoHK6F4EblCJ1OTzDzI3dGdNZuw9wRx8t1Q8umCSZnKN5jKhM8z-Q4vb9_noTX3_i8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rVjytlhKKhFtVv9yQvi0QZ-6T7pNZUfeQT-N0hWhspg&oe=6A3956F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L69a_34YsA8Q7kNvwEFjaum&_nc_oc=AdqDM3MWDWY1QfH1lbSWuoYo-J0gHcFY487Z2HkY4-CJY4I2O6ttdEKhS5UEyS5NZ18&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vx53ovwiN62k7-_4bPu3U5phbi7Rdrn6JaI88VXvN4Q&oe=6A393F21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd8cEDi0k8MQ7kNvwFzhD1I&_nc_oc=AdpSWpfJA3j1wJqrmO6_znGV9nfOT8vvLyZROttPxfrWnJfXhZobjOoUcXcAD3JoWBs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-onls8YLJFbAIHsazEWwHL0u8QI7pFDpGjvkGsjoB4QA&oe=6A39339E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbtAV1_DAuwQ7kNvwFewiZ6&_nc_oc=AdqITjmEw_g5R_-y_7kuiOJ3oXNBk9vYfayBaURUjnimbga9MgkxajcbbaV-VyEU3F8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZbwKQJOR4LOA0iUKuij33Y0xyMF-_MZu7c1hR59Ctog&oe=6A39499F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MghPU3rB3YQ7kNvwEqKUR5&_nc_oc=Ado_EXthY0DALghj6hi7h1x4kxUqOUEQSl8qEBUSmC548jyK8l-8KYI6phFHWE0_rtI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C7kxVejw5n0YIdrZckmQBHMuMETYK1UgwTy4kjV5BXA&oe=6A394818"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
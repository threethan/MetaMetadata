/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uaJk_2UqUsQ7kNvwG6XDHg&_nc_oc=Adps4YRtfPv9TGOV1GGOj99MhMhHGY9BfCfgA6sjF4hP2FZtpxqbOw5p3KXAWUYNHbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nKAcEaM0kVZJ7IYhzAraG0AHa-H9_sl8vfctaKuPDaw&oe=69E4BEB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D81gLEY5y4Q7kNvwHdrcSs&_nc_oc=AdpPp25p12DKVaRBYFH9GVC0vknRq3MvlaaS2zTHVFesTH2iuGKb7z8DT5JgMBr7RNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TyOTXB-dmY-N4pVnbtezpfJFPlscmFhD_46GILGo06w&oe=69E4DF21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80EnnZ4AHU8Q7kNvwG2CrpX&_nc_oc=AdoxjjdsQBFG541lqVqEkskoM5JMqf4aZPAPgv4A_ShMNRGW_-A5suvGJns1_jtbN50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KS9iOhF9IartX-9w7ao6O7P9QM4EWGh-POTHcvRH00w&oe=69E4D39E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vji74dnh1w4Q7kNvwEbrgmE&_nc_oc=Adorbl7t9akiou_Lk0hE5AFtJ3_4eEkj7zFiNeUBSYznMufUcBqtyk7eMaZ6IPrfJl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r_Zob4IyG_4TBXqVTkQHaE8pIh3vFxN5_E7N017ERrA&oe=69E4E99F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2ljFDGpKLwQ7kNvwFhho-5&_nc_oc=AdofcyF9AsB_b8NC_16kQ3XUweXoPWDuFEbAByOegaIHB94nuTmrXhZmL3p61eqU61s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SwZ5L0jh5fxtMYu2U1J_7fEmPafxi4mygGP6zeJ6fug&oe=69E4E818"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
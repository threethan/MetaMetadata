/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsx0dbuEUl0Q7kNvwEE8rfR&_nc_oc=Adr5LM5b9c1K4M2nyxxyWCPYJ5Rxk4J3VIdJvwWSvZquZP-Epb9bSyUEpWY9gg8LA7Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tgkzxDC7NRnl1G7KSwhVV6crmu1jFXYrBUY5K_p8KEg&oe=6A1B0475"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F89HgyvP82MQ7kNvwHhy2UJ&_nc_oc=Adq8gkalwdtQ4JEjj73jGXTdmnscg7SVEBuHaWb1Cy1Qk0wG0-NWgwy_xWXi7gW6YF0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aQWAxYkdtuUZOkvfS3wVHTjXG_yZzzAH3SAW2zXlkUg&oe=6A1AECA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0qLV2dVdGwQ7kNvwFDvoFc&_nc_oc=Adr-BnnnioJo-Mybw5zadzp1bVoUgxHP8JyNl-1XjCtwSMsdSBHfL_qVMIbY1HPMbYM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JJoqlMAMuhm_A0bsFTMatVACapvuAnsEJqmlSwqwljw&oe=6A1AE11E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzRrM5quETYQ7kNvwH5ouHg&_nc_oc=AdpEX3chzoUPv7K71iAQtm9ub_rG9ZdJV_Gskl4W7UF2Mbd5YIP07PorNZ6_lb-0Qiw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59RlOuDU0XjA0csIKFhrLoqM8uOH-LvWwQOz8pSLd6uw&oe=6A1AF71F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ckDtlfhZ3EQ7kNvwGv3qtQ&_nc_oc=Adr3NR4dZ3_J1VTJ6nEA01yCizYG06qCgRurCp-24t0Pd7f-e4OdMj4WTE3TMW9lGgk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dB8h2YLzVs5XcfDqYKDW0tZQ9OrgEW-LquOdmFjmOxA&oe=6A1AF598"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hwri4CjtDbsQ7kNvwGPISmT&_nc_oc=AdpdjLWGA7ZTQj2JQVsk9PyqOKD1Uqdsi6fcNdhlrbkmdjL6I6xyY36J97lO6EcyH7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b5yJgnoib60PH0vgU9ZPujXOjbh8HYKbamKEo7-_TOA&oe=6A2984F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fjG0uJWc4YQ7kNvwHEioEC&_nc_oc=AdpBQ51h1vPUutNmTcgq9cq0Gy5Bws3qt1pO-3aoKvx9caCshZeA6yMDFmLgBuI82Wc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SWZwCQhx3T0y4RAd1MyGflm9TneIIjMY4fZ5XU07ZcQ&oe=6A296D21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQrPlQXe8FoQ7kNvwEGwRFd&_nc_oc=AdqiyAzzXszBmDzZpj8b0ZywlRRkQXuoGcOxXZCPUS88lMs8JQqzfX6oa8YR02rrbaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P8ZbQVGXZg1ptdIvF37t5zgQXHiyAW-2fhZDqwUzpVw&oe=6A29619E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYFtr7IBxboQ7kNvwHClSAf&_nc_oc=AdqY4kuGO0AaqnwkiJx7qsaY3owNFImrIHjw-9yHm8pdTgn0rOSaRnITfGSQOgEySV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C_aJ--rtobH5T_l_HgXhGxsrVPiJdGZEE_nAyAA_B3Q&oe=6A29779F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT4xPjyATUcQ7kNvwGusgdS&_nc_oc=AdpavvoyA6wEZQC_X8rw033ONBBiAj29Ix21_ZHvZ9NIjxPY31iHkwUEc0zYpx1q0Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af886ugWW_abSo13els-4HFcKR5GTMy3jcca_3jhvfhG2w&oe=6A297618"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
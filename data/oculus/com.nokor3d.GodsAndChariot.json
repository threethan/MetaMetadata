/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZYvTq7THagQ7kNvwHWOTcW&_nc_oc=AdpanbzQ7lq4AmDZBiwUWuES0Cbz2EFsM5jik2vc5WJjyNhvSF5T_wBHVuAoRYjCLWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38PTYG1SGonu79ZLbey1Ib30Rt0pXOXLYagt8zQ_7UAw&oe=69EB5635"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jojBxDpFRswQ7kNvwEqzNZK&_nc_oc=AdqWWdU-OoHDHVfMlI3lLhEIo8wbux7ZP0nNurwFK4bYry2rW3P6c4QyFHoMEA1q6OI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oaiQwAHK22g7VRUDFnF9zky57Z-tU-8BjJVqFM5sdLw&oe=69EB76A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYOoMptWU4wQ7kNvwH2nEoP&_nc_oc=AdrHf8JkhgADbqRFMF8-nXWtP6Tl0atDMvRfi2GGOtebtq2ubZOajVYXB4smvgfGyjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Llxlc8uDCh6kWeQsAcmrbDv61ASndiLUhMSU_gjNppg&oe=69EB6B1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR_rsAxJvhcQ7kNvwH8HwT7&_nc_oc=AdqdzJADvBkT0DYOAXsDj1lKAvP7ifVeGy-QVG9xwpT7qUDnIOayvPDm7hm0wiHFKmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N69LliePWkWZgYFhXF5qIYW31e-XFrLcXZe1cocDKtA&oe=69EB811F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqipP0YNjXAQ7kNvwHnlmK-&_nc_oc=AdoqbmMKoqj9V7bdTtoCryuhoLmwTfu-I_LWMUmfyCMVCHg9A4MrchoQjFZY55eVh-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XLm9ItXLMO0Alx7Nk-Gy6X5UmgIlca07Iy_V7mM4_Fw&oe=69EB7F98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
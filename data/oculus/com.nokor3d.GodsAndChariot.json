/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReKO8vR8niIQ7kNvwF88mKZ&_nc_oc=AdqJxpcCzgxPQhqBmBp7dDxaGYQgWz_sNNmLQDwPPt-df3zscBD_X58CST6LHgFc0kY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOxsHVrB2f0VOMJQvYFPUQX9X5MKgJ4cKuhc6C5kv2AA&oe=6A8ADBB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o66-SdaW9NMQ7kNvwE8dHfX&_nc_oc=AdoMV9J-fGf67HgiPWGr29tZHUmSf6N3M-P-g1_qR19IwZHG9kgJCFZQ-p8bhje7lVQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1aJUhDe7HUXj8mPHucsL6CmBjUKFgT_lYYrlnhbUj8Q&oe=6A8AC3E1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-mkaNzDQA8Q7kNvwELjAS5&_nc_oc=Adpq3jmJq0YctLfa3xRhAqrgtrZz8_REnpIkna4DKQaoUl69f1ermJR7K88w5mof5hs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEARTjO9eiwWahrppt-xMgx22RpLcMgNBMPM18-wjBipw&oe=6A8AF09E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2haZq9cBvKwQ7kNvwEndjKr&_nc_oc=AdozlcJj-jjDEWqlw1CTOnhQBLu4qWgelw3UUTb8eB9QXfEMN50mb0_XRqThGGmpuqs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGit8Mu2WIlZCmiY_zr7cIskkv-c-rycfqh-pt8dcO0g&oe=6A8ACE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WauZs1MqFwoQ7kNvwF7BMAi&_nc_oc=Ado4REV7bgX6FWlBEN97tIMTCJ_NdRzMdpdy-mtDiEB6zsni0_T0bW_BtrIC0YaEVYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsX7apVqOvUuBKnd7k2R64V8uWDyQHuOD6ChpOFniVSQ&oe=6A8ACCD8"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
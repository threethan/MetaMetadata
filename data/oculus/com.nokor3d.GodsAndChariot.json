/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYpFJBcllZQQ7kNvwHU9HSb&_nc_oc=Adpjx3KmQcoXUj0dZLCOByOTFj1ekWQ41rfLtCzYa9hnHoTw6VdbGMKkl5hO5upWMTk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdC4Mj0DeoJu-SqtbJ1-MqgxjmTF__NBbs-OKOZSF0kw&oe=6A6F2C35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5gmWDt68SUQ7kNvwEsVDnh&_nc_oc=Adr6QWHJdRffbLRtiL2-YC7qzb2ybTcOpuY1IHALXFWExAq155Npv8K90vd1SIcT98w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaAw8_cishACHOpOxp2n52dnEN2XGM-XlxWbuetssAMg&oe=6A6F4CA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAxn0HRkK38Q7kNvwHVDmeY&_nc_oc=Adpe9NNkURO-DGlWNridAXtrPcNc1M0wDvdQfN69Hj9qIk_Sml3rS0xYf0j6XdaZgJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkuL0WaYVg910WTwGdcUmSNloGZTHVEYiVt_Pi0_hShw&oe=6A6F411E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OMunr5OIOIQ7kNvwHO8r-L&_nc_oc=Adp_7U1eOo1X-zy4FgXs_Dhr0ejXtSRIUBGclD5SPCVGdhBkYihpXe-FC6jlUAOoFpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDdddN8xYE-KWhiPMMsV9jm3sVr-OrjjhYcfRUxo2seQ&oe=6A6F571F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3-vJypgNl4Q7kNvwETbyRV&_nc_oc=AdpEEWyr0O0NKSYXJyOIQy3zf83Zm3amlhvaK8PEIzDBzLMdD2P0SAPUWnC4mbwh0G0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtB4xrL0VxMvyYFHp5kye5AsrlKXLPpiRJFaHGZOCCAw&oe=6A6F5598"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
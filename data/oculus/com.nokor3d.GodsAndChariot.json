/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw7aetRL-IQQ7kNvwE9ydIr&_nc_oc=AdqgjiQrgYqhzMkELqtIZXVXYbLwcqhEphGFBwO-njwFXqEDoF2O4BwdSussbgjd5LE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A_E2NN-TSfZPjXE9_OTu__gLtCsAXkj25vbx9tp9Y1A&oe=69DA32B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_WEefrQc8gQ7kNvwFNMN4V&_nc_oc=Ado1BK8fKt_Ce55J4PgxVpQmrc3xuQAboLcJUILnVwJHSl0gJKBwQ8ClP_0v7_NNcRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vDsXDhJiSTLydrk9iWBn0mx4MkXDT3p1S_3AownDzUA&oe=69DA5321"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXNJGOZviGkQ7kNvwHEZ-Ga&_nc_oc=AdoG_k9V77Add51ICGIwwlVtuDhH-PRVYxQJ51UUgLWFqKGCmQyftnqjWNluz9WWGzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vRWVpcsJe7M9dQg6j7Msg6Yflxr5vst88Y9gRywVckA&oe=69DA479E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZzdZGBkMwcQ7kNvwGVh9xK&_nc_oc=AdqqvncO7EIZN07GRN5dK6tOB8-24d2w0GDOKZqVs0Ya7eZ1B5_TfHB0qOpzEYKM6M0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1llSs_h27Swn0UoM7-5KGvQ5CVbRpBfaMWK7wg83CSwg&oe=69DA5D9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1_JFIMNGPwQ7kNvwGxBMnn&_nc_oc=AdoeQcccARd2XJTb2euxHNn2dF4OZSh_FN2RZ_UPVE5V_qnthblxRvoxV5I3uupeZzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l1bvhAvSn0w_Jelx2KmgzL0QAYArZgsOQLs2RPs8fUg&oe=69DA5C18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
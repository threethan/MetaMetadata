/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsYjjBqoLGAQ7kNvwE6PkqJ&_nc_oc=AdrbnwB4TmcYNVB5QhHy-XSfryZBwTzD9MRNhqeJFz8SVGS2OiUZDXnElUZNILsxjoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gcs5m5GgdBaxrzu7BdI2cIyXrLTUoVwbOtEi3mRPIuw&oe=6A3E9CF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHb5LS0I9XgQ7kNvwGmCR4F&_nc_oc=Adra9kzAC2f3ca8uWIJoLZXI7_ILSymEq39es7pWnmBTNI4kbePs0cr2EKAenv4QxmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AbtZ-jxj-s8YpcbBL0jl-eHPX9rqlXvFaJPLRSRT5vA&oe=6A3E8521"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP7Bl2XRogUQ7kNvwF6x1O0&_nc_oc=Ado2K_7Bv4IwW3ssmJlv-MJXkS-fAPaAm7rd6wfUaXT5WC8vZbIJJMkt-Z_Nt6pob2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GJ2K6ip0yK7JKLh6Q3UZ4yGZN82SuPcbxpzyRDnVcnw&oe=6A3E799E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzfO8Z3jFTsQ7kNvwEYMCRd&_nc_oc=AdpGV7QhN4Ii6z_tX2QgM4G03SH_P6STeGxoOr-gjlBly53HyFCetWIhjTbqPtMfMGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8lfr8T1T5yY7BDwTwO9jUV8kHZQIT9YINkq2qqMzRuA&oe=6A3E8F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myg2WJR3g4UQ7kNvwG7EFev&_nc_oc=AdouQhISJKQOX38rAYJWX6SLatsM9GxDYB4HESe7WCr8zSF-guTLuf9KymnHS04S16c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98bw7eGhO6IWvEJiUX8Q47izZUyXrrdiX9BnszpJkY4g&oe=6A3E8E18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-G10T0stGoQ7kNvwFYWaQO&_nc_oc=Adpo95FsKXNwHUHsXCYWIQwc6Upc2utxSTTswa_k7wZS14tdBgM616agZETtMHWsEmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxC65fPMTl4OVMJk2v24UzRGdJVsYt7VrpS8O-bi2ARBg&oe=69C3C935"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHOFKLzdmJsQ7kNvwHeseMw&_nc_oc=AdqTdfyUzcisJMwOnpUExS8II7ExGZBa9g2CU4TiaJYGHnu0cy82ZePmZl2o7sO-ERY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_I1sX2BOMLwy866yM0BCKXTN4neKp1Q12hY_VWFnXTA&oe=69C3E9A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxzKbuXkt1gQ7kNvwEe32-M&_nc_oc=AdpE2g6kqYS5846GFT4L3xO3oIMhdSd2EnPzErF_0D88Yjz9gjwCAwYaXiVC9GtnmuI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQH0YtFh1dspfdtmuE1OT0uEebmBMjvUoBJKDn13-kIw&oe=69C3DE1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6BOA-TtGfgQ7kNvwHsLUA3&_nc_oc=AdpXhbrH-jnW6ZgFjUnsbVk72Wu1A0vK9-L4yxxIZ7pLmDJu-42FQNbKdb0T-0CLZ7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbLd5Q-0JEygcP4zfNpK6g_yIHouy2UBh9SFauD6HMoA&oe=69C3BBDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwn4RfYqasoQ7kNvwGcqGyb&_nc_oc=AdrPfI_Z6lVP9IXOgsqRk876bY-NpTnkWQNXrZJtaFiuOym27mgTxd85PDEhjl_e7lQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnSGa2BILhWSVD003A6s2YKOS2W_X6MEW5drXEMH803w&oe=69C3BA58"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
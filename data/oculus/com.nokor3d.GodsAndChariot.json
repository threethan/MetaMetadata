/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5vxaY239ckQ7kNvwH39XnY&_nc_oc=Adq2BRG5PMJz5smfcx2jtiQhhY-s0wYlWbUXH606g_UCkRGB0UbON00VYhJtoyx6Oko&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5YApn7ivt0ZlfZqzV2MbGJGEIFT_JdlsZ0FB6323Kng&oe=6A81A135"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TMvY27NSDUQ7kNvwEgLmtV&_nc_oc=AdqfmjDGl5BcuxC3BddwEE-RjxT590IXZhb03Tq4QFMlKdjnR6OX4qlf-Bt4rSMRoJQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNcmwY7s0agbD_hsIsY6koV5jDLTW7c-yrKykDDAED5A&oe=6A81C1A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1winY8jG06oQ7kNvwEHinQC&_nc_oc=Adqz6zcHFxPEZryOcUhxb7kDA8NWwInr5NtL7Sjmes36TyX_sJepZIuI0VISyAkcxwk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaQN86ec9VEAzmVKyF2CTsQ1OALxryb9G34dPe_YR9uw&oe=6A81B61E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcCz-ymSPagQ7kNvwGyVmkp&_nc_oc=AdpyEIUkFbxjTnQrJNQTgXta6rPDkAfDyy5DX9FaKJRSRxA8mNasykm8IBGpFgSGZDA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGUSuyNeOgq1qJoeJyEFlBKtnQa-moR8ZQOU8pMTuqrw&oe=6A8193DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T0SgORbK18Q7kNvwGS1JWj&_nc_oc=Adp1N_TwCqpzS_LxSLKZBbEBPmk6Uwwr2E21wm6BqEIQshEUvuDAYgZhwqDT69hjryo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG5Gy07Eu89UVtpnXBQBNca1uNblhXgvPSMzJSdhgIIQ&oe=6A819258"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
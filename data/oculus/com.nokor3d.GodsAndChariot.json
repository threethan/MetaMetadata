1-25/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqA5qYELWnAQ7kNvwHpH-Mh&_nc_oc=AdpTsXvSSzrqR2Ob2Yl1Uqr3dcRLeCK-mQ1LoxRm_Bd443a8j5xCLDD05rkcLbvMC4U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw4ggFao5rjFVpMUxUgE_2DK8Ati17N9DekimukJo85g&oe=6AA42075"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CofrA4DsucQ7kNvwH7RcD7&_nc_oc=AdrYakKciDC2ZNqALyK76759hVXV0DeHC-ffZduIgrc1XSruewd9-gj6HYDJGotWJBc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9GGyen6Y9QeWFEL6Rm8DNd7c9aT0V4Vxala5l5qNbkg&oe=6AA408A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOJDPDII5TkQ7kNvwF-NjtJ&_nc_oc=Adr94W_fokWTstNN-5hloVxZ1_wREeeGK3FsqQfDegEjbwrMoKC_mL3walZfVcKvzKc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWgRRv8xYPdi2NeucReVXjVNtmqCuwC3w3YjDA9G5i6w&oe=6AA3FD1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBKplssMYcAQ7kNvwHtpoCd&_nc_oc=Adr58xsqns4ndYod8x1uTgPBewtt9OfFGoNrB5dwogNnqk0YSNyzBlzEgXh9d5xbvuA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwb8rRJRF99RNX0ayYURXBjnM0EzHj-09JoPTdtFrolg&oe=6AA4131F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2BEP0JWoEUQ7kNvwHmgWLq&_nc_oc=AdqbbakCU5g7aQwakvfcN2JyCDcY3kmLTl-g6MPqJgR0-yxpmsFrF0mMaxbuLZsj9Y8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUqPMnuDMm02qEhzskvQJCG7FaDNesWBJ8I2uO7FLvzw&oe=6AA41198"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTNtXBH9lmYQ7kNvwGRooXW&_nc_oc=AdoiQYR3Xbk_BAz6Kq-cY_Aynhmv5nJ6neLhmoOaqYHI-9RbvTlLZaxJ4uty7S5KLCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CTJpkpIKD_drw3sxzZDTh_4mVexWzYYilOPi_b8-a2Q&oe=6A186175"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xTUKWLUL_4Q7kNvwFRQyQa&_nc_oc=AdrOcW7Ny_t0QfaoM0p3cP07WuJzn5L7I-Gq85HEUSQCQbkgoTJcoTW6HG0bhaU1oDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vRtgl9sryMQrwLe53LTIf5fPmb5lVuNsUr2e7TOuutg&oe=6A1849A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwO6wGuNDAQQ7kNvwEGz2Rc&_nc_oc=AdrFSvCwhXq5DI-8Qq1WCW5ddNSBMbjtnigy40Faf9MOyGUXCqT0OshIcVFNWTeRNWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kFcJsF-PAvcC5cDJMl0bao2sX_PkK9Rvhde7lderWhQ&oe=6A183E1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzRrM5quETYQ7kNvwHr9gRA&_nc_oc=AdptPkppZ1OnWCHxJ61VE5uM0KDl8ZVmX309tw0L7nSZE_KGExthIT7ovoE1IwAhOfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q4jPxFFQNN8bbH2bU4q9uAU5zIedVU6iowGtr9UN0yA&oe=6A18541F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6dcjc4wlVEQ7kNvwGF0Hjw&_nc_oc=Adp7eWJjY5yLVgKSww5RWzdotVX0YDRZMvq8rzgAa_1HKEtJ2Svb6_x5Ioz1BijXaW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m3QBeEaocUcfV86HFT5eXV85FWqfxOyqr9La80i5G3w&oe=6A185298"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
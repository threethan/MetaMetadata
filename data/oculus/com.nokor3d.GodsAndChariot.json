/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwYfUGKf1IwQ7kNvwHpQULz&_nc_oc=Adrt0yas2kva78khoW812o4XJw-aSzS9LVu-A9Bqj1Q1_ySKJlL05pEnQ_eZ9xu_ruw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uZFHvfG_PV_BCQKpy-5X2X_92COs3I9jtwJImK5OjKw&oe=69E36D35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D81gLEY5y4Q7kNvwFQ3iU4&_nc_oc=Adoo4oVJd2ATCQqg7vvxtmR7XNjma3oVpd1msmpKkIwYoLGqO-FFdj0O6NMVb2wxbCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i70CskYQISTvysvj1a0zAG8mCkhg2l8cR4o7izWOaQQ&oe=69E38DA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80EnnZ4AHU8Q7kNvwGR0EZa&_nc_oc=AdrRxo2ByeT9n3Z2IRSiXbBIYGBeJ8V5vk_aY3IQAZcVVPTqgi9EpKOjP_VGre4JvvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XFjNvPlwuhq25-OF6Ke9h0fJQEoKZfGx9G8-89aWZeg&oe=69E3821E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADy7YDZuHOYQ7kNvwGwDRHc&_nc_oc=AdrLrm98m0wC3HZoRdDIgPK-PB3c8NgfWCfaYFLIRXxoD14CGBzAN6An6UQCeuP1Gm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22MOVl1TscGdbhqWtgw_VZJq5sk0xvjmNmkdRkOvR64w&oe=69E3981F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2ljFDGpKLwQ7kNvwGxqycJ&_nc_oc=AdpWjiFIPBoOjrHqlVwPTxn8ZrgTCIVc76j6i6eYGSSdSo8vFfFfyLuk1KN3GDLKqrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l68HpyqV1pyaBV4nJ7PI4yJH_L2VpR_5KZodqMLt0IQ&oe=69E39698"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
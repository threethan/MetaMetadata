/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqA5qYELWnAQ7kNvwGhl7lA&_nc_oc=Adr17Y3ekwraipub8AxVN80EcHBw9Xu1hp7OI37DAe7w0-CdDVW-HvCnhWkoRib0Gew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVc5THfIbrF8YbM79m8im42jkVE6VfT9V3NQC1sYFRfA&oe=6AA2CEF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee3rugVyL8AQ7kNvwE_W1ce&_nc_oc=AdoVUjgD3_cTFnmrX9s3ahdze7huh6x7RvOQ0gWL91IX-OXF2JOmdN3CR-9edvphnmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG3AhD87uaNnvmDG0YsyDzdRcq5fT2J9ay_V-lXrq1-A&oe=6AA2B721"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOJDPDII5TkQ7kNvwHDSnuG&_nc_oc=Adr2Sd5xIUHSmldKz0xv9SpioeLY7w5zua01VyUi0qKaLBmNn3AxhSUjXzVsv5WTenY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHmI1Vd8Aqo0YgppJ_IVeCp_BPbsCvhjl9eKpFZUozUA&oe=6AA2AB9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBKplssMYcAQ7kNvwEVDXLT&_nc_oc=AdqihhnYznjvHjIRgPmwwdnpvyZrPilYDBQjtJpmt6OQ7ScJ_L2RNMtygJsJXtOnpUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUHoiU2snXcuBXbVyFKyE9v9mH4sZ6nKVVIVQkLbAiqg&oe=6AA2C19F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2BEP0JWoEUQ7kNvwFuZkEn&_nc_oc=Ado2ldxNIEwmSoS4mWviaGw2WjkOhe_4xBtT2MIFI1T9l5sXD-R3Js4JKFJWuHAqdyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRNfuuCAgG3N59oBCTsCuNvliJK8RyD8qDKpQfUQfPDg&oe=6AA2C018"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
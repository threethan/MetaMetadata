/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ8hJcSzyi4Q7kNvwGwgn1q&_nc_oc=AdrBUNzHCR4jI9F2EJVQ6lreUd_iLdvXBiasdr0Ad0vG27NeoPmKAWbEQ_7pnfiovR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIipZr2Bl2UpNq3vjwbBzxYtk9b2wqqGwYHIFv4_cf-uA&oe=6AB3F275"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vjzggF6jpwQ7kNvwEqyEOL&_nc_oc=Adoz6ezUewLT7DODc_t6k0GYPCEWviEmiteWQUGn6c8kyllHx4Kxm-MZUeGtATdjxmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsLkKODhJAq6dFlyZK2vl_8RzXt_BJF1SZ4XpMA0Raog&oe=6AB3DAA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOsRG6fDLrwQ7kNvwFqEz3j&_nc_oc=AdrZPwUe2i7bdjSl5Tp3OxYsXszQx3bmSDL-XiUOFMU2GwW-VOJVbC2cUr32MF7iMSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbCU5x0px_fM_cUTlAbxlRLQ4DzcjMqf0q24fYNSGkxA&oe=6AB3CF1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdGJuTaSeNsQ7kNvwF6P6VI&_nc_oc=AdpgoMijqJv0FQkibATXCPhR1vK7mOxtD2wKS9Y1wtHHWSxh2MvD1RxWnMdi--kzUzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbZ3lTvGLV_mhH84In-RedKmDmOczpa3FpH_MeLMOSNg&oe=6AB3E51F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3cF7_nHEoQQ7kNvwHdCWZo&_nc_oc=AdpMXzKWcoIvfY-t7P_jdYLwjqp-Ce7r7tKXUBKwNHOVssAU2WFByjoSJs9jpXMwh5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJXxEniegB555kuXa8SR2CFSaQIythycDEAyWm8EcZMQ&oe=6AB3E398"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C0v4zqlBawQ7kNvwEkuWAv&_nc_oc=AdpzhV8_9zFla44H5aOWhCaTOKfQUFp_wDy4btT8n7SGxi2DIouHHlyxJVf4Vw9xOv0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ysq1s6N5NPScReNRt08wWUpN1WXWHFHKuWu1mO9F--g&oe=69D78FB5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kZ1Hs7C80AQ7kNvwFygOV0&_nc_oc=AdpbYMzQCj3dQCkFyiOPr1PGoNQnmEI8gZD1oibK0F8ZjbUszlWDLJWqTQS_Ijbi8BU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bovKpxOP9qErf8nBv6i29oMIY00NAu6Xj2_pB4FpyzQ&oe=69D7B021"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXNJGOZviGkQ7kNvwE1gRDC&_nc_oc=Adp3orkcAGaNRUYCd1_qiUsW022fo8u-JeB25wuvxjydmLcfWHfasE8SJs1dDCIILtY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nqnBzGViY-Yd1Q-Qws9ctDxlmmDjV6paDQiAui5yevg&oe=69D7A49E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOM-YfBHAWcQ7kNvwHncD50&_nc_oc=AdoQKHEYDhZ3292WkUKiUJR_vmx1l2Vf12HAPhXhEVPIGCMonYlv3ekX55fir2KnC5I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Sacfo4dmosyzYC72wvpCALFMKhqYmb1esmdNY_Gky7Q&oe=69D7BA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1_JFIMNGPwQ7kNvwEshw64&_nc_oc=AdokFbssbpIRxLcuI8tt6FZUjh6E44w6hyHq0H60eliIHGB1GeiOHo9K58Wd6EIpZ4s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ip6dtV8AkSlNtE0ChG4z0GcrdezaBQRUqZsQKkDY00Q&oe=69D7B918"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
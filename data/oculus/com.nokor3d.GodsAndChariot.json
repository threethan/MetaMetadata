/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1X0-h7FsWAQ7kNvwF5qppq&_nc_oc=Adq5oE57XrdPQ5CzK8Gbm-GUdDr7gRLKnvmBwNVADQtdqq1HvYT5n_vk2DYrEeh2GEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PIYmDnD0cm9pQU8gbodzv5kUh2vMRULvi1ypNv4hz2Q&oe=69FCB1F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLBczJ9-ZRAQ7kNvwGyOaVK&_nc_oc=AdpkxPQKAsyKOyafhqzs5BBCGBEG4Nn_g6jmS4iU9tSsFGCjjudp8Ab8lokbMnFrFRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uoDf0pkELtriTr2RkPCGQl0K_mdjxo11MC8oedf5KhA&oe=69FC9A21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQftVCV4nlAQ7kNvwEFqK7w&_nc_oc=AdqtbFWNNHvO3Qaf4H7lHTZZctjU0BWkolpRk5vDUYVhBiwnc7ndJIKWP-fajE5qWPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bZjYN6yVyngAaFSaH8FOqs7WUAGftInYtEL7hR-jf_A&oe=69FC8E9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl3Et5mqZmYQ7kNvwEroIvi&_nc_oc=Adru6FQjOrGwe0ONrM5J9iAFAlko8DXA1xdE5eh3VIyau5cyvuCEOCesMbtzbDZh-X0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AzgG1KYes7A0d5k0ZoUWigldFicTECBe2wIwiAQUVtA&oe=69FCA49F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25aQv3coCwcQ7kNvwGKcOzV&_nc_oc=AdoogpyHW1eF-FYvImxVbIBixajNAzhmlEnZsbpoFg1BdEumuhLDrBgSOlUFBoxONfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DdDeFNyrE4SdW8yFwH1-agGnqjuGD0hJOG2oDpSBdpg&oe=69FCA318"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
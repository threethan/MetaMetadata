RIQ7kNvwFxrIGf&_nc_oc=AdmeFjCfrVGp9WqXSSCWs1tnMQrtR2dWQOLhzIXejtQUtOvm0JVl4U_z9CNTAHgw-h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuzE-smz7x9VStr5JAO-JjZvSXfWfFkYeyob5ovBkB04w&oe=69A030B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSzxECwMKCYQ7kNvwFhsR3e&_nc_oc=AdlukGcgYEnmL23Hc0cX1MY28yt9x7vZBiymRG2wyenQrfMUIBFs9Na5qzPOJAbLLKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afteq2WiJjt2tytTTxCyBEcuMsvxKGUjJ9cG-thlUYpsFA&oe=69A05121"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h28ycQmzngYQ7kNvwH2EYmf&_nc_oc=AdluE4mQYIHh7dodUCRCq3M7QQix1UvQvnalmPo6CGO4VZY6r3LYQ8_ZzaXdfs9OknM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftsx5DYAEikuTvBXOfMnL9J4Qd5DTVyK98s50cIPUc27w&oe=69A0459E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_nA76y9llIQ7kNvwE8XQwL&_nc_oc=AdnNOMzWL6GqwhubfFN06MSqVfS5UFjmBr109B-Rrw27pCFvAkx7UZ3vTf9Ne_md-uU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoRjTKeyiwJcTapPfHAD32UyEcvMyVH1C2q6Rh60kTeg&oe=69A05B9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqH6qBNKn3wQ7kNvwGmP4jf&_nc_oc=AdmMdGIP1wBEUt1j8TpEHldAqB0DovIyMCtD8JurGGGQAkgY48vY60Dck8wfwpsnnRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLUa_x3ZkchBT-XHplObN1ReBISlyYpbzqzN17FyGSQg&oe=69A05A18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_m
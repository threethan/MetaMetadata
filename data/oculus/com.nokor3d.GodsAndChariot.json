1-25/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqRBfD_BofYQ7kNvwEB81K8&_nc_oc=Adqrwn9BqS2xbn49Kh9MO7akIdyW91Kz7E-Sk57caWv9e3DXl_Tb2BNnFmYQ4qpKGX0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz15Hp4jbkIbEMKT_Fuw-hBlJTMyrKLcxzqrOIxYU7FQ&oe=6AA96675"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDXDxiiUoT4Q7kNvwETSQ36&_nc_oc=AdoQHYiBfL3HqEC_LxRUR9WmTdZtTM-vXGyrBfTwRFPLr-r4_cNw0RtZ3BG6NTnOBfw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO7RiR2_bpZKMhL1AkLX3B4UXKC8hG7lsK4_qaw-qzsA&oe=6AA94EA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoV5Ntts7gcQ7kNvwEEpVTv&_nc_oc=AdrXo4TdxhVzYoJBNR-e4fjcToBNm1hhR8hkrlFzF3HCBLL9RETwA7MItuUpwOKbadg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdS_25OB8nGzCAJPTmg60fSO1noGrKf0QEo53sJVpAxA&oe=6AA9431E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXdaEr530jsQ7kNvwHf1Y_U&_nc_oc=AdqYfcf9TE766tlXxLO-Y8gRgKNOK9Wyg_EYMtpJmoCTHxefEztV3a78uPpD0FAujb4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR4TF3rNBIAongPZfDHdvG2IKiIUsoSIlVQyIymhhzSA&oe=6AA9591F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdzkrVzkAKgQ7kNvwF-GSjT&_nc_oc=Adq02rbXRGB-r2KAgzf-SyX5LbOmPid2a2qpnbtv6rFHMPv3IWb89arEJBhdh7hFnew&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_nJI4jnfUKirJoeCCnq5B_VzRlT7-xNhYj475IY60Uw&oe=6AA95798"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ38KRLgHx8Q7kNvwHLcKTl&_nc_oc=Adry9qlPcuVVFtvvmxNgSq8GOaBWLqq-5HZY3JjxQ1GuOLL8S0Bj9SRjCrZ2U8WwHXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfc89olP6q1g5mCCdJtR2FU7ojdcR9SZxvV0PjTnpu1w&oe=6ADF73F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEPdKjzRbIkQ7kNvwGKaqa8&_nc_oc=AdqRcy0yoKCUEm4mjyBCqGayTKFhVyGJ25wcjN8RZc6-RDZY3Mg4s6Dwmqe-V1h7uWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo2Jubg_Iw89d0r6tK8ebxmexHbFx9vqVvpoi6dHSM9A&oe=6ADF5C21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdEKSS3GXggQ7kNvwHuGANr&_nc_oc=Adp2b06mIrUmvU8A_yP0Tehe2uxuvWvkYehGgTKrK1Snkl442RLwUyYwt58iikijqp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6YnM6CjxPIeK23gKfqZSQ6nL-SislWwbXazgBmAVxGw&oe=6ADF509E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5rRE-zSlBIQ7kNvwFPj50n&_nc_oc=AdqjgHmlujZ3gLHkv2I8RT_wQQcRkmQv2DM0Xlm2ty6snpMNR7jhzQROroJbLeyNegQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtcp6K5qSi1o6HFDzkyPQcATDK00Hmi03Y_rjMmZeGrQ&oe=6ADF669F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kejn2xK2euoQ7kNvwHSodn3&_nc_oc=AdpnhiQBeHTJ4wogjVPONfUMeA0D_bhBQKg14XUFKM93wPXpRp3vLbdMc7bPDdfnDeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz3bHsGqI5Ds_NKylzHZEwci75GiqNx1KgiW-PkKHvug&oe=6ADF6518"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
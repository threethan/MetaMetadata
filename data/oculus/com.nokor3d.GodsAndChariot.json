/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUTVArD-6bsQ7kNvwFsUP_g&_nc_oc=AdrmcAMbcsI3BVFZlzc4r-L5P4Edi2Z1s35thRlfACfninXZHdZrLHhYUi_v9txuyNE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JcbaTQxVH5bmoa30G7gYZOz0jjZAXNW_Zet8CF1s00g&oe=6A2C27F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fjG0uJWc4YQ7kNvwE24l6o&_nc_oc=AdobrPAZ3rdYyl9WJgHE7yeEPYndlUyaSNgBiaORMVfnJvBxpFHVCCLmiy4jgIXI_sQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DolIQaneDL_7OOpRPZ9ttErGYMOrxNU71azF0X29j6A&oe=6A2C1021"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr-ELPhmWVoQ7kNvwE23ffY&_nc_oc=Adr9the_gWW47UJSlXRCPSdGYtP-ypGLWnejlxxZE533pYyMuHAdTfiU_vTy6UAOtAA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iRbMGi9OcdZ-_90FEKSlvP7oFowfqT5anRhDr8QbeMg&oe=6A2C049E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP0-xWmz-LgQ7kNvwF3OYFA&_nc_oc=AdponfAN7HEyS7_QmWXTQjH42WVVKbdrX_-ar5yO39y6Mjz4MEZYJi0g9u6A_BnVgcU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n--XUF7-bP2347CMaZolGpsVbkCEu1PsbBPPwCGy1gg&oe=6A2C1A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrLHe1N0ySgQ7kNvwHSiyyV&_nc_oc=AdrdLgKts7ijQ_-4W6peEipsb7cJVeVpuQ9g2YiSgUXWdym1lxajGZTFkLwBrhJ53X8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6NLjgs9XrHL6Kp8CDKKpu5gP4RqlofmhMnE5FpxOv9g&oe=6A2C1918"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8_S8M3xUq0Q7kNvwFZPyBt&_nc_oc=AdpskK_o0CqfKL8Jr3FAsAuITo8MciSNH0nE0ogFMGb7DqpYwzIwSdpQPzhh5Kgged8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMkQf5O43MF9nDjmgUJtQbipjV-7JTlh-jDPd2_bl5bQ&oe=6AC272F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFNuLcCD5e8Q7kNvwHGWawx&_nc_oc=Adr8TpJzGnJeTqA9c3wN3TvYIW2l_eMPHiAcrt15ez40n0YabMnocX-ighlEvVGdASo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjbH-LBwPrwE-ehp0jV2tYZmLKL07V2fhZZKHykAg-0A&oe=6AC25B21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuxeA1i8OfcQ7kNvwGaDtVH&_nc_oc=AdoivKYQRPr3EtdNgEVWHhExacek6T4aSdwqyfeHy09MycK0Qua3v-Qy5BUyHDU60iQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmIFKuNKZ2LQ2HuS3YEgSTmiR6ixv3W72mNUpHsmi4BQ&oe=6AC24F9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEETOJw9f4IQ7kNvwHhr5tM&_nc_oc=AdqVpp3boFWSp7TvoD8SJKK4ndbOWwneJugWqUAuVdn3aY4vpz1Jr2D10au705ruUN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeoxGxEbIqxnXcWTKekR2Ts_EteMN0HTUWvACl_WkdmA&oe=6AC2659F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqNFOc_mBf8Q7kNvwFUg0zv&_nc_oc=Adp5m-EwTu4GoiIMSOw0t0MBq29-mE3m9AtMJ7tP8VZVNpr36UsRpp5Ew9mUwr4D2zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNivkWOLhifD5-Q5dH_LH99Km1R6T6wrso8HSgQH8npwg&oe=6AC26418"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
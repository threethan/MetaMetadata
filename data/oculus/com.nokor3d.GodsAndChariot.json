/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaouSGHO3hAQ7kNvwGmkC8-&_nc_oc=Adpo70tHMVvIhjl5ToC5irvPjJvjziQaMd8R0X0J1s13LWINzxXBiYBn7AcoHM2mia0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-QQ4Zx3PGOuHHv_obkHByA_BZfkOBQspIqNVgVTNnjw&oe=6AF48BF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlfTz_lCYxMQ7kNvwHoJbu3&_nc_oc=Adq28lCxrdeiXZZMIh_j64ARcNdL5YB_Nkozy31GGl2jh63Hh5IeyBLdIv-5U7g-3-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUhCyDZXX8aUFz0U6TquCt4gmu6G-_gFZi1UD1ccG15A&oe=6AF47421"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kirj4dWIjO4Q7kNvwEqG1gY&_nc_oc=AdrM2hh0Q9BG52x7s1TfkViRXB5HYu5Aao-yFSDj-pdtPVTv5phymSm7MXt3XXgp9fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM_LdCLlRNYEavlm8Z1UijD65dFzzRComyP1ONkBGxVg&oe=6AF4A0DE"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux94A9B0hCYQ7kNvwGvUuz6&_nc_oc=Adrrf4dUQ1bbb_x-iPaFWcSiJ2iMCi86vP-2R46z6xJtzKSzfAJfQz2cbn0jUIakHzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShFgtiMYqXgxMpVUPBDbEsVJ1y9b1MS_Bzg9XHdmd10w&oe=6AF47E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szhNyUGvwtoQ7kNvwENVy0v&_nc_oc=Adr4c1S3wy6yxFObLZv1n90OpvTaZ5nshApDOVJIg_iuz6zZSq5VqjK09hEGNNQaYZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkPi-nlW31gMP_K0v-y1B1tLYdEnlhMN8o6z4hIKTm0Q&oe=6AF47D18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
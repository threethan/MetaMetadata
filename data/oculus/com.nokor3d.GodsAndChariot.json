/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcYWkYmz-pMQ7kNvwEV4WhG&_nc_oc=Adrq_F_DUcspBWFmRZiWHLvNZAlLtds_0eWDmY-EmQwu-1nK5l3YGwhRYAvnAuvnyHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TipU0NS3N_2XcseN20_2DTyCC8ViZy_aaaakR6JNwgQ&oe=69F76BF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs0Ju7CjjDAQ7kNvwHXfm-H&_nc_oc=AdqBY89iHF-CkG6Du5KekwC66i3fVpz3l7p3rR0ZzFVrtcivMfBQq_98qzG6owpuEAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lp31cytIQDSDwyK0TneOYFc9iCo0vnI3fn0Cbf856Cg&oe=69F75421"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2iCgrio6OoQ7kNvwHasUQs&_nc_oc=AdrPWPN8JUrBIGtyxrKV-cPXkoDUbu0UERqYdvrcgHIIeMST3SlCawnUDy6dtIHK43Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1no0W4DJTbyq0ZGJir8PNT2Hgnv5RBArZEUdetqPCkVQ&oe=69F7489E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ff8zkUP0IQ7kNvwHTG8Ke&_nc_oc=AdoaL4bW6qkA-X7wdBLSfx3iM7Q4OAqTbkyOlx2JDEtZ0oJEfIHOwzg7um18oYsdGac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sjtG1v_rSkeBINk8R5oQsGvCy6nwCK7W_tUvQnTCQ8A&oe=69F75E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUcdq4FvXOAQ7kNvwHzsVfe&_nc_oc=AdqUPvTt4DG7VuoFddrWa69Uj4yxj6QlGifgPRWEOcjD3ArPBxStjfudKOct4cu4klQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C5e_ARVtG03mWJ2nax1lI1cLxxaxwuvMWVVqQmB4fPQ&oe=69F75D18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
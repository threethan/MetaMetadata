/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0X2jT3y74Q7kNvwE1RAqy&_nc_oc=AdoLP0dtxWW21pyYTffmXfufvSgoZxM2W0M16HycWXwy_alcECH_giyj4NAlnidnn-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3LfM4JNnnJuVSxBp5bc4e4BLRHrcyGD_JJURazzvAOA&oe=6A5E08B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44sPTWx4j_oQ7kNvwHNGGGT&_nc_oc=Adp-pHgVCWtHYIjLymqcseshrs7KRXfsqwyXZUhp3LnT1EkPjov1KQL4eODXeHwkmzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByNGh1JdQ2mhy_uRQO0xC0J1pSbmPdgMMeGkECuuCr6g&oe=6A5E2921"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMpRJ8jzxFIQ7kNvwFhhoe_&_nc_oc=AdqTr3BXxPdzcz6FB1XHyQf33rh3aRRlWRJUwC6gJx1peYIy5YG4GlV1SzdRIYgh6cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8sCOm8o51s6r_-qe1l8ZyLoXly-pshHPNbQtYCxKWyQ&oe=6A5E1D9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f4_A-8S7SoQ7kNvwG1AHgu&_nc_oc=AdpXcJkX40AeRulqgjbcrPk4erm91ZxeB-DQncNaGQnQl-DmItUlkFfN30FOz1Trx8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFYzQaOC9vac_x0O_u--i6a_jiCx8O0Rks_atMbLLWDw&oe=6A5E339F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQWaG-EWTJMQ7kNvwHWg3z3&_nc_oc=AdpgMuL20m4uV29JMansERXEBxyvx-JHk6qkQz8-T676aP9OAd068NlWtKuCXe465js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ndSq0AsOfffm2BktwiQtl_dXRrnxGXHpLDXdslV5gA&oe=6A5E3218"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
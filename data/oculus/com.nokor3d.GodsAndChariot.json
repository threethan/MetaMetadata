/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTH9z4OQYQQQ7kNvwHtSX8s&_nc_oc=AdoTK9DDDUpkIAxzyNXUJ5WdTfQhaN74FHnRXu5MjhQZlNwBecUSpjiYWWIhOMowSb8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz-R3K4SMAtJzyTAyuMLRVeznxO89dvgZ_SMJ_jzOC3g&oe=6AD39675"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JGFkeagrKEQ7kNvwGoIkAZ&_nc_oc=AdqreEAZxFcawLNDaahOnVm0UT252iSkd50hDcqzmjIXLunvjBJCBgFoxcGFA7C22rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4L3GIY3PUzCzYgXV13YJxzRNQJ-HHKdUdLNiIB3v8IQ&oe=6AD3B6E1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELVY28N3-pkQ7kNvwEc3NWG&_nc_oc=AdrMUzp-5SgHT9-rcK1eGNEkHZVag_-zMj90IJFHrCwx8sfkFUYyGA6e-MsFs6eSZIk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6i8DIk-9vYkdLDKG_AWIqacZaK4QsY6KBF8kPJwFmTg&oe=6AD3AB5E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwtk0WUciJwQ7kNvwFoNRgb&_nc_oc=AdqqnsgLfUJb4XKeKt0AGRbOAiER4cfMGhp_d7RddS9CYj9FuXk1bRLu4Mx8qGRKnNE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhn_dleCVMjb9pcgK22nuCi6jYMj92jVpMRnmdrAvJlg&oe=6AD3891F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5W1QKutwpYQ7kNvwFKGh7l&_nc_oc=AdpYw23gWoPWU1zlsY7BJF-VAoNHgy5qr2aGe_SGQrUi9_p1WrZGzooFmV0b212r6AA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbJjGB59wyFNqZY8DRwgrIDKle9RUrqgmY7fVVUs_L6g&oe=6AD38798"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
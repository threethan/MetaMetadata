/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB51ZZBN5ygQ7kNvwFkQlGd&_nc_oc=AdpAsFukH22mIbUsMu46W_CpfL1aqCqdD6GdzlZkq3P54RxipZGZpI_8nB6vRAGzsFg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIoly7_ery2GhTo0gHS-SNgip5xMF-FiRsnUHNQp83lw&oe=6A65F1B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f84XBGXgl0wQ7kNvwFmueR-&_nc_oc=AdqMcewmphF8lxtgmCpGAEzcvC5Ca_ojNiHHyRYCzBSLuFE4sFEX6SZXvFIJiw-Wk78&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcseE-ZFTg25xam6AAdk95-V24A3_bveUIMbekTvnEPQ&oe=6A661221"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vndYjIicDlYQ7kNvwFzmai2&_nc_oc=Adp5fWyx_g5KRH8o-dXx_6M-4qAYmIluQnkCFmAkR9jgGB0pXfmLdKmYRbbpymNQB5c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS0vAUd4vVp3Ke9GCje_ighnGeELa1aa5X32o0ZIOUSg&oe=6A66069E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udlp19l68I4Q7kNvwEoxygZ&_nc_oc=Adp-e7_BhV-OO0TA0sQkMNdVU2qLIaLh0kZLG12tLPsJlx26mPNlLS8vmx_0pooutCY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvfMDxgUrplNrIjhkf8FgBJO_YlW3LnZ4bsgMK_4eThw&oe=6A661C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA8mYEOynbYQ7kNvwHoDXLD&_nc_oc=AdrvvywebxPxeD1JcmUd7gmonGSf0iT5C_oBdGrltm6dCsxq0acahOemCjZz8hqYrIE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqGEfuiEFQaGzzWQIkxE77gBKDcfWkP8XzsANgmj6CjQ&oe=6A661B18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
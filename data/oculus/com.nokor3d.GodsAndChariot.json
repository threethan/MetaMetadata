/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejg2xHKbqo4Q7kNvwG82Z6s&_nc_oc=AdoBl0YPegglIuc4t89XXZ1UJspJXsv8vkBFFdV01rqfzFx8kl4po3Zsib2gJjjOhwI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya4xBEpe_g1L6zaRRpQrv8adtSXrhTIPE1kYyixnObmg&oe=69C66C35"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWT03j6lI98Q7kNvwF-rJBU&_nc_oc=AdrdpxXnN_0bfLtf_qhveTgtjaQ_RdgDjb22DTkD_rn5K3q6WZ3HoSVSYlv89RvCIP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqlGzP_Lhy4RkDAVY1UmG5n4xgS8QbBhdPa9KjNdifGw&oe=69C68CA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxzKbuXkt1gQ7kNvwFgSt6v&_nc_oc=AdpOhL9MULaRjxkTcGxh_OUY2M2uzfmb1sKxjpePKR1l-T0tTwBtf6OUtlwoIHCu2rU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz89hr-wblYPocHU5TXh_KajE3ZHgGQjBW9GS7vZ4zImg&oe=69C6811E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_7iDL4BCWUQ7kNvwGFQ12I&_nc_oc=AdqOEvKP-OhJWFIt_la2hjzOUY5QOJ-KLkONoFvdhVl2IEUkxlUWenXSUb3T7BmPEA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKWKICAYjoDKv6Hzq9VVZSXMD3DzNEXAa1y-bSwe77hw&oe=69C6971F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwn4RfYqasoQ7kNvwHNX3WL&_nc_oc=AdrqcD_9tyeQCHo0QylGe4W_Flw9X-fjliAgLpjs8oi1-gPPXcga9VxavDMVOmAlCGM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjHdbnpKB5tZq9T_tZWIoCEbNRtLbeKtBHC3yiCs5qYg&oe=69C69598"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
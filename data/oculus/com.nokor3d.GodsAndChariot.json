/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uaJk_2UqUsQ7kNvwGCZlzh&_nc_oc=Adomti9JpQNKBEEDdbUUryS4psyk_GYQALLAW4SSQZiqQ4iq5Pcn4MmkzNWYxphvNXk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1011mRULqpuiG7RbiHfVOTLJTGv2ge97McN7vb8sRCzg&oe=69E761B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCj6E4u8rggQ7kNvwHjKTgw&_nc_oc=Adrq5YIotGP2EKtencutg9KcLdT7Qg9f6v_Kr9NK4vgNnNveKOBDGmXAC7o9uMlA85Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0chnG1vr-k1SuL-gXELie64BYJwgPYGwVOlM-uWvNOJg&oe=69E78221"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSyzXCaMUcMQ7kNvwHq7sxq&_nc_oc=AdoGZK7WDIAw_1xa2CX5QztrL7cXuyTs0_tK6_fP0-VOmCHa3eZ15w4Fd16qqZKk3d8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XIC4ZU0N-TNJfA7zrWFSzMIf_yhiSBnpmB82E1IxmZQ&oe=69E7769E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vji74dnh1w4Q7kNvwE3VP-u&_nc_oc=AdpRjNG-2cZkpLPlhGHziiUGGLlKYTZkl-xp-Fdi4d2TJV1ZL-S5zLKXQ3dWbsQGBnQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VE2VeplOjXUCNdzKbXrVV7XJXuHuccQLAmGhJG0y9SQ&oe=69E78C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM2nX4mFSY0Q7kNvwGhLkmI&_nc_oc=AdrVok8wO7Xf0gyJtMrbWGtNJUPK-B_9VMwII0nvEH_Nc38l7S2-bXzysHNhlUco_cg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1syKfKh8zEwqicRTZ24JJ1yQ8NhqCgVdw_qb1A5lNdDg&oe=69E78B18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
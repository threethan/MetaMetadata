/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNa4Z_W2-EgQ7kNvwGTdsdh&_nc_oc=AdqOH-dgUnOpis0Y3HamYyDBVfSi9B4NbAIK5jGmevgrVODAAA0jLnUIGSyer2REDOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmx-fnFgPKgpV9dv_afax5Lwe-RtiN-JQw1y8SGGKKnw&oe=6AEF45F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbjSyXogh-sQ7kNvwFoZSva&_nc_oc=AdpRuWnk5OfM7aPGQvP3xrwKqSDPgjHi2LrsiUhHr0yT1OTliY3SyF17XONFAnGquw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6IGtC2J2OuZcs-gw38KcFF7vYxph7SSXb8EFuf30uMg&oe=6AEF6661"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD9X-uIWlDoQ7kNvwFQ02V_&_nc_oc=Adr-14kTFYE9hESygs42dkUEBso3udq_y5TSedFJfU_EeFJlJGkosJPiUVeIlcRCcRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9LXX26KzzlorGmm1GTTw70lDFFNN2BnIclKQVHHmlRw&oe=6AEF5ADE"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju6KgnvUAMMQ7kNvwGNKO0L&_nc_oc=AdqgxcsMQjkinPLC44tD0ovG_xn6pPl5d4xrGxFgoj5hMSP7JLYpF4RqU2cZT_eFRak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRarPE0LuTLF7K8wiYeEvaYc6aJYYFukWATTv6ohyhp1g&oe=6AEF389F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a0ToO1PrpgQ7kNvwHfn793&_nc_oc=AdqSKIDtfITm9GNFVTDLiaPA6BL7u1u3OhaQ2O07YWE9yH4iyKTHCsBrbUgwVMWo0cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPj6bf7PcfADz5tzJVbVyum7-rtKLhdlzU_bBXuxvOSA&oe=6AEF3718"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
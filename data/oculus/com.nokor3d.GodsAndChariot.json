/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8_S8M3xUq0Q7kNvwGlKn0F&_nc_oc=Adq-f2bfD2brPUA9Z4QCuilRddaEnDsmInVgMsG03KLZKXGzcDb7tiGRzMthk1FebUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuBPzYlEoMkKtIhHVq4pRpTZWnf1hIHMJGi9FTy1NHbQ&oe=6AC12175"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFNuLcCD5e8Q7kNvwEPCqtG&_nc_oc=AdrFXffZy3ohsyMmeOPdY8HQAbcRkgoqsfMImcg1Fp5JH3IsBt45GiuaOtUH1LmkGxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODCK5LOifOOrdOzS1TMQeWF1Qgw7dkJCYMRdbS21W7nA&oe=6AC109A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuxeA1i8OfcQ7kNvwFBQxnc&_nc_oc=Ado7Bo1acdc7F1hTexpHaTAWpU4E4Kx8IfAGUr-jsLppu9sqeBN7fa92OyUpdK9DoSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlu9yQn-44Xl2Gr7v66q0oHOyJUtCxgvBHKtWTc5iJ7g&oe=6AC1365E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6WmrAxmeUQ7kNvwEpxQcS&_nc_oc=AdqS6iF7vEL98NXP2z7HQRy5TOrx8haPvzL9UJmG8JmiHIq8eMhXdVjswTJHxoU7PVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTu6QqUIAvzsYF9yGynrhtiAxoU7MQYL6-2GDVKg_vtQ&oe=6AC1141F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqNFOc_mBf8Q7kNvwHo3TfQ&_nc_oc=Ado94VmzSJ0GKScHvapu6OykrUvix5gMmltg02bIT7VDujm2Q5nlyhdIaMQlBQpeI_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3YGNXrHyZ2VxD7JBLtGH93qn3xS7z4Yj3xJ2lu5IoMA&oe=6AC11298"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
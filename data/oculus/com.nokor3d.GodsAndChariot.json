/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA3SGIi0E4gQ7kNvwHqzOr0&_nc_oc=AdoTZvPw9iwmT4UNXLzhNx7bK8H_Vtq6D3GV3xGjnuQeQx0svI1WDez4659PecmDRII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya0dt6RpCnmFyzWeLNsK70OAhFjf01XjpOtwD8f4zP1Q&oe=69CD03B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDH1VaQzTVIQ7kNvwFt-Zhw&_nc_oc=AdpiysyIjuSJLVU-6QWtKxMfkAa6wg9tMoHflsw6E350aXKBegkgvjSYjM4u8Hv9fYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsuKv_dkj5yr-Y5i4U2GtoAxQhllEFA1BEYE-izAJAmg&oe=69CD2421"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M2oCM2ULgIQ7kNvwEz72DI&_nc_oc=Adr5U7nSf4XWqysqtCegeYDg6md8ZuhDxc5sgFMeJBxNlx3O0a-yj55MkSdgfEUH9JM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZVLJ1twmQr7W9aViQMdFrGHQs3KBaN_xytQ0ph_xk6g&oe=69CD189E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj7j_9lmBlQQ7kNvwEUXTCG&_nc_oc=Adq4jJ_8UBTCoDUPTbMAAGWH7IPAZtWDAk7pnfjdAKontGkYfRMjGhJlMn0gS7P21YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymVLenaQ4Ugdg9Ms2wERIMonAsefLKawUpFC0CS5qOcw&oe=69CCF65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVtJY2dRtzQQ7kNvwHiXz9y&_nc_oc=Ado8igNMLFlP-MPyYtA9oX5aeKhwY4BhorlDuA5HNalTMAQNyngBQEsVL8micIFGdrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwlx1zWK624D7M-U7feJyIbAHuCC2zZg6Y36TW9s1POrA&oe=69CD2D18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
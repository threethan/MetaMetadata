/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVb1ypTvypMQ7kNvwG_KpYN&_nc_oc=AdoAkQkjIoa4z-Qq8g4s_avzm5kfPVv3jR3FNi_UU7GqxwEnX6NjCPTdjr1IQ2UqjXk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCScyjbBHHf5upkm-f_ReoG3xhU8kDPZfDtwXgcQu-5Cg&oe=6A58C2B5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt5zyle931AQ7kNvwHHzBrq&_nc_oc=Adq7gjhNNql2YETYQKQ4jcz9M2z_sEHkgVRgZTFHoH6hSESkUlQciXMf8xedrNWlm14&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9cwOrDvvA-d5JMtdVw_TGoHOM0bEpPqKVp5EtxilYcA&oe=6A58E321"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u8NUwOou7IQ7kNvwGgIkPZ&_nc_oc=Adp_18sZQ3Yz-GKmA6JxqdpHtOFNPieslBSJUqNLCndb_wkvbMX8dcE93NC0RoUIY8w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh3HTkMkdAMfBGq7g8_aUm6XuRJ7yGB273g16l3DmW1Q&oe=6A58D79E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EYMmQy7hJgQ7kNvwGCmmyV&_nc_oc=AdpwUs35Q66knx-scZ85ClZ-w6Asn4yamah-7mFjw3tfniR7NIYiyyeeS6ebGbPwCOA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxvrpbzrNHcY-gDQyEnArWFY-7GAjS0ZXIzdJ7oFyRsw&oe=6A58ED9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ4TdWjHJJkQ7kNvwH7L0D-&_nc_oc=AdorFrZ0GfJU1tiqBR9VheFULZ4p55VkTQ84r-urlUY4K93rowytd3Owo6tY9ilCVVA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLn7b9ApLq7z8PxBRql67XZZTUvR9jghs7HYOOstXj9A&oe=6A58EC18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
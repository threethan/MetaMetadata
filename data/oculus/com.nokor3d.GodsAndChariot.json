/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfc6zCAizSsQ7kNvwGaAK5H&_nc_oc=Adq6Mn4gUzE3SirpPfrVr6csi7WuMvD69mgYKzkS9pkTKNM8W2c1h357aTViCmmDrcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5QEOPmyWXh7J4fqp9uHNw2RACcsc8O5_IjDJ74_QJoQ&oe=6A9C3775"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fZxoJvz7pcQ7kNvwELotrC&_nc_oc=Adq7jYDPeOTCQA68h2p1F5w96uaXSn5pzcWWsgB4yg05AzSngpgXYJUMhk7crUAwPcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWrusvskjp5ES0Z_4sINyccD_rRth3ZcxHGfEjhrMXLQ&oe=6A9C1FA1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfi-TdWS0sQ7kNvwHRZ5b8&_nc_oc=AdqRN18UVjde2bMeD4OoMvix6VJiXbBnTYOVB9kIhSvUgBYScmz-zGATdwcJMcUmI1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1dm5opLAcmkc13qECbbysfMq8y71oWx_mIPy_-RlMiA&oe=6A9C141E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14ZLfvWtQGEQ7kNvwF1G23n&_nc_oc=AdoEMoGznwbpYsFVeKaPfHbh0vGZ585VG3XQhJWPpafuodHlivKuTffGprwjlxLAvZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEh8qb11VPdSpFsWMzGCqVW3UEpHkkfRDE_RWiopqLsQ&oe=6A9C2A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlHWktlYRtcQ7kNvwHfRjgi&_nc_oc=AdoO8cZeMfgVQK90Uj0dmv16qW8RFXf1RiYOS3k97ylSve3rGzpEgFilpBNO691hBLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrXE8bgogKPKM8Ftm873v_ZMpPKkeX7WUmg4aVAvD-LQ&oe=6A9C2898"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
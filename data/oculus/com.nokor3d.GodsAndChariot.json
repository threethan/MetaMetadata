/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrrRu0mGj_cQ7kNvwE5Z1zL&_nc_oc=Adpu60zmI3GRpexf2lGXazs9Uyzrn9xR37Xz0H8ik6Zm4S_ayHTN2Rf0AWXIi6bviuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo1WoGJ-Y7TRZmtiBGuNTrWmJBF9PgmOkqdG6nqdshxw&oe=6A69E635"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmkNQ-_dHFEQ7kNvwGYBJpq&_nc_oc=Adr0HJ1jxaZ_v9tIXWw0ry3PsZSxReurRSgtlzTNGkq_-Wm3Bf1Ne4opkJO1bLWu7bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBQ2FftkPNPoCeySQQ63UkKat8Zn3vr9OXnTD5r5YGrw&oe=6A6A06A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDFVDo-ZEa8Q7kNvwGKcJwH&_nc_oc=AdoYbnsWvN39K3aMVpc0SVkd45pknIhhJgHT80EBRZ0Zel_fO2yipnWVNAQ8sQ1JOKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwhM2KaOS4uCptE4hLig5T27qC7MhOatb8U66_UyHQ9Q&oe=6A69FB1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVirGW1rliIQ7kNvwE1JYQl&_nc_oc=AdoJd7B73EV5Lqn4-rBbdoUkKrQLI309lkLJLNhvpd47LLpvelMBes7r17nuHt6bnw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEzYY19mHLN18Wn4HuVB1AzgUchqHavlZkvwMaPetKiQ&oe=6A6A111F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSP0sBNbrV0Q7kNvwFqgRKK&_nc_oc=Adrf8QIh4h41AaPwzdQcrcNUaFNdh-5IWmufFMDyvsJJXFhsrPFtRjtim-EFltzS_ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTX3KY_RT8L0TY5BGNVK2eYOY5s8Pa6gGtwmu36es62A&oe=6A6A0F98"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0X2jT3y74Q7kNvwGJH409&_nc_oc=AdoIjwCmG9uN7mVNf0hp-8RDOExHJ5_KmVa-HQXx4LOkqGdMujX7d6607_00H2SvY-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrcFOYTT8etcIE4AAApyZC1UnPN0Cc7RU1bJPay503Mg&oe=6A5CB735"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44sPTWx4j_oQ7kNvwFth5YN&_nc_oc=AdpTgN-mveNIWVd-JZjFKW4xtfzic5RBVcxawLDFzIcKzAbu_6mSMeE8SsM4jgArtIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt3LdMIn1qDnyajJDUwJjSSrOeu7-d10bSsTsabawDKA&oe=6A5CD7A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBjgr2JW_yIQ7kNvwHsVDR3&_nc_oc=AdoStnJ-IGgfldTms7SPNO4P7hB0wJ_95DroOPYF_UnTZ6BUHg2mVIGUH5_4adfRyrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr3LrQ7yR4XmHKZ2scRjby4zZZxmXrWL4YNMaRA6DPIA&oe=6A5CCC1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f4_A-8S7SoQ7kNvwEBd-35&_nc_oc=AdqdILIF3mUrF2rn5dFmCTAkwQosKfRAMX411SY4Zwv37BjPklkhwjpm43ytGvQ1VwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc0sSmWbB7XLDshYKT6a4e87QR-RRb4DgN2tbx_tjJ8w&oe=6A5CE21F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr0Q9AxUrSsQ7kNvwHgjSzG&_nc_oc=AdrAqUuPbZuonPSKohNQv8fttQ2tscBYZIdQ4UUC5hS1U5iS_nz7hDdO4soK5doCeO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP76ZKqmMBlfIaO3cNGpe6rMLXeqXSl0bHLY8qASc5bQ&oe=6A5CE098"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
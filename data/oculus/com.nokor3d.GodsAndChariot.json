/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MedHqWDMy30Q7kNvwGVdb6y&_nc_oc=AdrqFbH3rMrIxIC3jnOsNie1HVthQxCxYTbji0sHeHNr4CcJdo9NZxovCm7672mbRNg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R3cftq9pY3JVHfBRVdm4pB8y8MLUY5JD-fEw0cvu9wQ&oe=69EF82F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JJtiKN-5M4Q7kNvwHnlIx9&_nc_oc=AdozH9HilwN25euCWhXL_dznqGhHzpqhUk1r9wo923d_sUd-vZfz9NoPLV2UWgX6-Z8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gmUalscEu5PveFcFzhjnXmZg5Pl0Vq3tvuQwHayHbVg&oe=69EF6B21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFI2E_yI0wEQ7kNvwGnE1gU&_nc_oc=Ado3P3aLdpJ48iBHKH_Ch6zEQ6EjM7c5miiI3a6Ula1awEVwxUdJ8g4DxnGllRVjYK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UjuxcweJfCvnaWyqmT6I9c1GBvCzIvdnDJsrRnWG9Gg&oe=69EF5F9E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5LXTP4NEwoQ7kNvwGBsNqI&_nc_oc=Adr-LX-KOZxgziKd054IC8xvoy-1e6MUpKCR82qQK4bhYaBkpKgxsvj9IpS_Sc_R-M8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04Gee7BFL6qQYAvMrdWUd7GAprjrfsDzcO8GUfkxGQ0w&oe=69EF759F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDzQtfA3abEQ7kNvwFxIGeG&_nc_oc=AdpgsxCwsjQ7K7y8ouZqVRAONmMPFCXgbMaCBcIsrQATvbG9cjPA2WrB02DtwL3t-f0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08Okg60M3RoSWg75q0_APgwq66wmuGV8iPuwUese-sWg&oe=69EF7418"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
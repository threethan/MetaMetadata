/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7T_oymt1DgQ7kNvwFp8Jfb&_nc_oc=AdqjPHIKhPuBTsFsI7XEiVkA7FEA2ornODG_Cdl5LePDzSOJCSACYH50kwjvIxjL4Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTPjKicpxNb4NdDGZn5qZ0rjUrfwkgU1nRAZWEIAx8qA&oe=6AE75CF5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nzwxvhiwb3EQ7kNvwFXLyTa&_nc_oc=AdoXtPY615UP5i6SWqs8y9830HlZhXnZnonvTUNlX1ZzcWfMZFCKVe5hFwJMnNSJEKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR91Vu7aBg4CM7XMJJqJluXxT6oIY9W8_6xQhQzxsIL0g&oe=6AE74521"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59QuEfxq5hUQ7kNvwEnlVSj&_nc_oc=AdqwfbklOzzgvulmN8eOA8Aq2Ttx0qr6xSeShYW8E5oDNQe5o7rWhupCTv2Wm8hS_I0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSha9jnYfTIpW60icP_hukGt_73T_YaU1msg-2ixyfRBQ&oe=6AE771DE"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MdFZfpAuVMQ7kNvwE7Ul__&_nc_oc=Adq4-zjMvzd5fX5iMobykABuH2AoSBf_RYIYR3FQjNQcgJrYk7te-EbYCcOCB6sx5zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLMRZUNPoA4VFn_V_IxikIGlbj_DVpfDTe7Zv6iqVXxw&oe=6AE74F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isG23q15s_oQ7kNvwHmDPjR&_nc_oc=AdqOUGpjsEEvANd4DBo_9rMGlMfBqv1AZSAec1zVCq4A4lcnp0rwJHhr7MOJrces8zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEx8IN8wCRoQTxoHt7rRsSs0eILbNuQva5pEDrdd6hIw&oe=6AE74E18"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
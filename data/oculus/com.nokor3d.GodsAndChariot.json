/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfc6zCAizSsQ7kNvwH_05SS&_nc_oc=Adql18y53V3jK_sQ9V1VFii8JjWZnXbdzp_knsln1Dx4JYBM38eTFx6qFhV_Ugotl5o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrEJNOdVi7Xlc3NhuSQhfDIx8LX0_yCNngjdMpG3gUBA&oe=6A9AE5F5"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j70LtIEM--4Q7kNvwGd4saP&_nc_oc=Adrv4S31_AV0s7LJNCiblQ4ri6OcHgjbjan0mLJv0xOJmUbsIRB9dMCZZ-pKzj1aqeU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxV1WjdCSndnBMT9CWa6TCxamudP9c2oX8Cge3Fg_-Cg&oe=6A9ACE21"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfi-TdWS0sQ7kNvwE3bfPL&_nc_oc=AdqOlljAKPv9fCyC9Rx6kRdn6Ct_4wehKbG-xVZCvy1HBhFTVl6NAMyGRpHdH5KuTXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF3JHJ537hNvRMnndF8btuCAvpiyOP-wzWdVcczqmw-A&oe=6A9AC29E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14ZLfvWtQGEQ7kNvwHf_DmJ&_nc_oc=Ado6tSwENI8tj1B9GC7AGGc4rNvRKl9uMZQjpuvEAkzzgxoPj0tzNL1RAs5DkRlq0W0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfpBzRdm8pS1gFbwDgO21Kcc0Y-h-fPUR_fgBHftY9-A&oe=6A9AD89F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlHWktlYRtcQ7kNvwG4iPhR&_nc_oc=AdoCGHbD9i_Yfk16TqJ39naRe-1B-0TLz3BHXI6HbRFiS_zLuGZ5QO1Ol3f2h6AGW4k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBo8hFQvtov210sw5ljSFZcfEDyloAIe0FEh9XSnpPeg&oe=6A9AD718"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
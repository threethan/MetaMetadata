/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ8hJcSzyi4Q7kNvwFct7B7&_nc_oc=AdpsPL8vempH9HovdlfVzz2PW_lmJaURIPzaaQGw5GEZ_Saz9LC7dRNpgKo4Ig_dRY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKznslQIybzxO3-FdwxPcsKPhRSdpimjXKK7SQeDUWHAA&oe=6AB14F75"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHLb1TwyG3cQ7kNvwHlG7ua&_nc_oc=AdqznusQPhi6syIHHg_OBfINngFBvgFgtwBDY_Hio08poL7q2TQKhDAzLuE8Mszq7F8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkibbz657vzSRVoWH6fSwYZdYW1j692hAQ1K8wHpe-oQ&oe=6AB137A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOsRG6fDLrwQ7kNvwGbWrW6&_nc_oc=AdoUI0NW5k6HwHSE79wJoT7IOl8rbVTXQ89gGpvh-qptX1VCzGXS3xCHE0BsbeVt8no&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrKIEOBHJaXJxx_8BlDMpn0gkB3g2DnIikVnFdKNhQ4A&oe=6AB12C1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxEXxXE0PJgQ7kNvwGYe5AS&_nc_oc=Adq1fT7c3GbuN8qypPKC-0tazxWjC-J_WyiwkKT_uie8oZE5wSGRC3L7WJiJigOVJYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI60oNkQtOVGX21zyJN9gZCKt8E8EQIfNYAQRyqkHEh9Q&oe=6AB1421F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3cF7_nHEoQQ7kNvwGYuGwK&_nc_oc=AdqpRNpwbqq6-daPlzcTzYR_PdKJAstKUb8DKBu6ymm4I921KJalgcmkN4aXqZuNWS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5La4yxy05PJc683Cp0R45mFACB5A3w0UnWxYKX9Ah9Q&oe=6AB14098"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
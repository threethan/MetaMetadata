/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsUWc7xq1JwQ7kNvwEf0nZ0&_nc_oc=Adqiq24OLcS9tp0_bhfeA1IgM7YwFFm2D1uwTuZTxEeDirTmr5OHjuLAjl9UuV5lA_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t_Vo1uva4yGL_ZtbQxRxG8Nb7YXclRm0Bz-4u87vMLw&oe=69DE2735"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLJ7ZyfWwdcQ7kNvwHFH_-F&_nc_oc=AdrbJP6uwe5DqE6Rq1_nVbufF4a7HmYs9_itN_T9XUwBmY4YMx5HCc7DamC8KEZL8AM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wv-h1DA3FsghgD39FiyzV8y1lJWEZwdAewVftCmWgLQ&oe=69DE47A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JFphiSfToAQ7kNvwEz2Oe1&_nc_oc=AdpDnOtP0B2ZTSXi5xEIUGMoJwdWoJUMLzczt58WP8qkrYGsSGEZROOgehkwRn7aPMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JRjWRlpfqqlMzVsXi_y5JZaFLtrhuIKuad5GmN4BmVQ&oe=69DE3C1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bs-7uPjkZcQ7kNvwGlNusZ&_nc_oc=AdqcStEfEaO6ALsOxLYJMdf7K2dXKMtcMisxUKlwcYsBhzs3S5sbAkbFPxSrNfcP66s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ql2sBUwAoCw88CXtGjpTSy9n6l1H_WaJyIqaQjdWV9w&oe=69DE521F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj3-cHmNxLcQ7kNvwErG_RW&_nc_oc=Adqq9DA3YoRF5TAjdrYeOdqBcqBwrLjLhC5XIo2mk2SjyVqr1FOGcSFPx8Sl76r9m-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LWZmNLNVc6eI95Fcusz7e8yMdP6qGZkM5GQzJzZAtkA&oe=69DE5098"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
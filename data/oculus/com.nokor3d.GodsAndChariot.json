/38974583_435842445212994_2567221793576673880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP_ihJYuwWkQ7kNvwEMYb8_&_nc_oc=AdoIMvNuHQdZ-pVgCS18MOgvbTlbqnypfwylDldWyIgQ7UPItOOTf214xVSAIGHNn2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZFn_KbdyKNvVDTyS0F9uYzJeZPEzOFCgSSOiv0IoSXg&oe=6A259075"}, {"file_name": "output-onlinepngtools (81).png", "id": "1398925717198722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1398925723865388_3381156847450346447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBnnElPM2CIQ7kNvwGYgLUg&_nc_oc=Ado3oRRzl5pTXHPXQ2WHl06n_w9IF4yTntV1fyZhtOFJrkyprWB2I2b49oCf5_1VSL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2cAITnA8nlwYqCmWHS9a1_NgS9ue2FMkAV4XI3dZ36g&oe=6A2578A1"}, {"file_name": "output-onlinepngtools (86).png", "id": "1219689675269371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1219689678602704_2437162313273701657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds7ilN04-AkQ7kNvwFQ4MMM&_nc_oc=AdpA4JmE2ODlFwcYlImUlPjMSa5pfkLNGTa5KCk2KRh_eEjg8ylZmqpU2wI9hZ37F0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3mEN1AkUHYdhMpN_lylCP7LauojX6Sm7QmYIguF3Y-g&oe=6A256D1E"}, {"file_name": "output-onlinepngtools (82).png", "id": "396093395786929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974905_396093399120262_1987173989107118684_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nuX9kehznUQ7kNvwFSWn3A&_nc_oc=Adp3NMtW9nRtwWztwi1LjY85e4gpHFq6mUadRE-qprKLTo-ng3iNKdAb9Ra5K0C4EPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IQRCUNI66tc9mn66YwXyGBACh5HhfgsD5lgd0Ca6zbg&oe=6A25831F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gods and Chariot (13)_mh1654881457720.png", "id": "3186201544969495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_3186201548302828_5950261700357957901_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMf0wQ1OuUYQ7kNvwEnWQ1q&_nc_oc=AdpRTsyNF95_SkPmfgrHkDgKpeM3mCMGvh26byddJ6CDBVeOuKsgFvFHkVPtIsKEWqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XpNvshBWNPmfkJXIlo197V5ASCYhYCpaxPd7_0RuPbQ&oe=6A258198"}, "display_name": "Gods and Chariot", "keywords": [], "long_description": "\nIn this game you will go back to mighty Egyptian Empire. Ride the chariot, crush your enemy and see them driven, or travel across the oasis. Shoot a bow, use a spear, or go to battles, fight alongside with Egyptian gods and save the land from darkness and invaders.\n\nIn bronze age Chariots were the most fearful instrument of war. Unorganized light Infantries are going to be easily destroyed by chariots. Elite troops, heavy infantries/pikemen are effective causing damage to chariot.\n\nIn the battles you will need to defeat the enemy marshal and make sure yours doesn't fall. You will also receive reinforcements, however it is going to be outnumbered by enemy.\n\nThis is a single player game. You can sit or stand when playing the game. You can always recalibrate your position/height after change posture or placements.\n\nThis game is in active development. ", "short_description": "Historical Chariot Warfare experience in Bronze Age Egypt. Crush your enemy and more!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc